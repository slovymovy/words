{
    "word_family": [
        "rubbery",
        "rubberize",
        "rubberneck"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "74948cbd-f0c5-39a2-9238-21a4b2d78772",
                    "sense_definition": "A strong, elastic substance made from the liquid of a tropical tree or produced chemically, used for making tires, boots, and other products.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "material",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soles of these shoes are made of <w>rubber</w>.",
                            "target_lang_translations": {
                                "ru": "Подошвы этих туфель сделаны из <w>резины</w>.",
                                "zh": "这些鞋的鞋底是用<w>橡胶</w>做的。"
                            }
                        },
                        {
                            "text": "Burning <w>rubber</w> produces a very strong and unpleasant smell.",
                            "target_lang_translations": {
                                "ru": "Горящая <w>резина</w> издает очень сильный и неприятный запах.",
                                "zh": "燃烧<w>橡胶</w>会产生一种非常浓烈且难闻的气味。"
                            }
                        }
                    ],
                    "synonyms": [
                        "natural rubber"
                    ],
                    "common_phrases": [
                        "foam rubber",
                        "synthetic rubber",
                        "burn rubber"
                    ],
                    "target_lang_definitions": {
                        "ru": "Прочное эластичное вещество, изготовленное из сока тропического дерева или произведенное химическим путем, используемое для изготовления шин, сапог и других изделий.",
                        "zh": "一种由热带树木汁液制成或化学合成的坚固、有弹性的物质，用于制造轮胎、靴子和其他产品。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "резина",
                                "target_lang_sense_clarification": "материал"
                            },
                            {
                                "target_lang_word": "каучук",
                                "target_lang_sense_clarification": "сырье"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "橡胶",
                                "target_lang_sense_clarification": "材料"
                            },
                            {
                                "target_lang_word": "生胶",
                                "target_lang_sense_clarification": "原材料"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9cb03f70-ffe5-3808-a545-55ae97f6033b",
                    "sense_definition": "A small piece of rubber or plastic used for removing pencil marks from paper.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "stationery",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Can I borrow your <w>rubber</w> to correct this mistake?",
                            "target_lang_translations": {
                                "ru": "Могу я одолжить твой <w>ластик</w>, чтобы исправить эту ошибку?",
                                "zh": "我能借用一下你的<w>橡皮</w>来修改这个错误吗？"
                            }
                        },
                        {
                            "text": "The student kept a pencil and a <w>rubber</w> in his case.",
                            "target_lang_translations": {
                                "ru": "Студент хранил карандаш и <w>ластик</w> в пенале.",
                                "zh": "那个学生在文具盒里放了一支铅笔和一块<w>橡皮</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "British, Australian, New Zealand"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Кусочек резины или пластика, используемый для стирания следов карандаша с бумаги.",
                        "zh": "一种用于擦除纸上铅笔痕迹的小块橡胶或塑料制品。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ластик",
                                "target_lang_sense_clarification": "канцелярская принадлежность"
                            },
                            {
                                "target_lang_word": "стирательная резинка",
                                "target_lang_sense_clarification": "разговорное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "橡皮",
                                "target_lang_sense_clarification": "文具"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4a8a977e-a13c-30b0-9ea6-2cc4cfcb1099",
                    "sense_definition": "A condom.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "contraception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He always carries a <w>rubber</w> in his wallet just in case.",
                            "target_lang_translations": {
                                "ru": "Он всегда носит <w>презерватив</w> в бумажнике на всякий случай.",
                                "zh": "他钱包里总是带着一个<w>避孕套</w>以备不时之需。"
                            }
                        },
                        {
                            "text": "Using a <w>rubber</w> is an effective way to prevent infection.",
                            "target_lang_translations": {
                                "ru": "Использование <w>презерватива</w> — эффективный способ предотвратить инфекцию.",
                                "zh": "使用<w>避孕套</w>是预防感染的有效方法。"
                            }
                        }
                    ],
                    "synonyms": [
                        "condom"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Презерватив.",
                        "zh": "避孕套。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "презерватив",
                                "target_lang_sense_clarification": "контрацептив"
                            },
                            {
                                "target_lang_word": "резинка",
                                "target_lang_sense_clarification": "слэнг"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "避孕套",
                                "target_lang_sense_clarification": "避孕工具"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a72f70a9-e06a-378f-8184-ce0cf9fa4920",
                    "sense_definition": "Waterproof boots worn over normal shoes in wet weather.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "clothing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Make sure you put on your <w>rubbers</w> before going out in the rain.",
                            "target_lang_translations": {
                                "ru": "Обязательно надень <w>галоши</w> перед выходом под дождь.",
                                "zh": "下雨出门前一定要穿上你的<w>套鞋</w>。"
                            }
                        },
                        {
                            "text": "He left his wet <w>rubbers</w> by the front door to dry.",
                            "target_lang_translations": {
                                "ru": "Он оставил мокрые <w>галоши</w> у входной двери сушиться.",
                                "zh": "他把湿漉漉的<w>套鞋</w>留在前门晾干。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": ""
                        },
                        {
                            "trait_type": "regional",
                            "comment": "North America"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Водонепроницаемые ботинки, надеваемые поверх обычной обуви в сырую погоду.",
                        "zh": "雨天套在普通鞋子外面的防水套鞋。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "галоши",
                                "target_lang_sense_clarification": "обувь"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "套鞋",
                                "target_lang_sense_clarification": "雨具"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "756e7ca0-cb57-3dcf-8566-58add7e528aa",
                    "sense_definition": "Tires, particularly those used on racing cars.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "vehicle_parts",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The driver stopped at the pit to get fresh <w>rubber</w>.",
                            "target_lang_translations": {
                                "ru": "Гонщик остановился в боксах, чтобы получить свежую <w>резину</w>.",
                                "zh": "车手在维修站停下来换上新的<w>轮胎</w>。"
                            }
                        },
                        {
                            "text": "The car needs new <w>rubber</w> to grip the track better.",
                            "target_lang_translations": {
                                "ru": "Машине нужна новая <w>резина</w> для лучшего сцепления с трассой.",
                                "zh": "这辆车需要换上新的<w>轮胎</w>以获得更好的抓地力。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "racing context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Шины, особенно используемые на гоночных автомобилях.",
                        "zh": "轮胎，特指赛车使用的轮胎。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "резина",
                                "target_lang_sense_clarification": "автомобильные шины (жаргон)"
                            },
                            {
                                "target_lang_word": "шины",
                                "target_lang_sense_clarification": "стандартный термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "轮胎",
                                "target_lang_sense_clarification": "车辆部件"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7515aa8b-20ca-3c42-bc41-d17ae7dacf84",
                    "sense_definition": "A series of games in card games like bridge or whist, usually ending when one side has won two games.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "games",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We played a <w>rubber</w> of bridge after dinner.",
                            "target_lang_translations": {
                                "ru": "Мы сыграли <w>роббер</w> в бридж после ужина.",
                                "zh": "晚饭后我们打了一<w>局</w>桥牌。"
                            }
                        },
                        {
                            "text": "Winning the first <w>rubber</w> gave the team a lot of confidence.",
                            "target_lang_translations": {
                                "ru": "Победа в первом <w>роббере</w> придала команде уверенности.",
                                "zh": "赢下第一<w>局</w>给了团队很大的信心。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "rubber bridge"
                    ],
                    "target_lang_definitions": {
                        "ru": "Серия партий в карточных играх, таких как бридж или вист, обычно заканчивающаяся, когда одна сторона выигрывает две партии.",
                        "zh": "桥牌或惠斯特等纸牌游戏中的一系列对局，通常以一方赢得两局为结束。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "роббер",
                                "target_lang_sense_clarification": "карточный термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "一局",
                                "target_lang_sense_clarification": "桥牌术语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b5b2af33-bf7b-37a5-968d-e6e1e5be5e07",
                    "sense_definition": "The rectangular pad on the pitcher's mound in baseball from which the pitcher throws the ball.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "sports",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pitcher stepped onto the <w>rubber</w> and prepared to throw.",
                            "target_lang_translations": {
                                "ru": "Питчер встал на <w>пластину</w> и приготовился к броску.",
                                "zh": "投手走上<w>投手板</w>准备投球。"
                            }
                        },
                        {
                            "text": "He toed the <w>rubber</w> and stared down the batter.",
                            "target_lang_translations": {
                                "ru": "Он коснулся носком <w>пластины</w> и уставился на отбивающего.",
                                "zh": "他用脚尖抵住<w>投手板</w>，盯着击球手。"
                            }
                        }
                    ],
                    "synonyms": [
                        "pitcher's plate"
                    ],
                    "target_lang_definitions": {
                        "ru": "Прямоугольная пластина на питчерской горке в бейсболе, с которой питчер бросает мяч.",
                        "zh": "棒球投手丘上的长方形板，投手投球时需站在上面。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пластина",
                                "target_lang_sense_clarification": "бейсбол"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "投手板",
                                "target_lang_sense_clarification": "棒球术语"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "91716665-bb8a-3cee-85cc-8641d2a7d52d",
                    "sense_definition": "Describing a check that is returned by the bank because there are insufficient funds in the account.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was arrested for writing a <w>rubber</w> check at the grocery store.",
                            "target_lang_translations": {
                                "ru": "Его арестовали за выписку <w>необеспеченного</w> чека в продуктовом магазине.",
                                "zh": "他因在杂货店开具<w>空头</w>支票而被捕。"
                            }
                        },
                        {
                            "text": "The shop does not accept personal checks because too many of them are <w>rubber</w>.",
                            "target_lang_translations": {
                                "ru": "Магазин не принимает личные чеки, так как слишком многие из них <w>необеспеченные</w>.",
                                "zh": "这家店不接受个人支票，因为其中太多是<w>空头</w>支票。"
                            }
                        }
                    ],
                    "synonyms": [
                        "bad"
                    ],
                    "common_phrases": [
                        "rubber check"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Описывает чек, который возвращается банком из-за недостатка средств на счете.",
                        "zh": "指因账户余额不足而被银行退回的支票。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "необеспеченный",
                                "target_lang_sense_clarification": "о чеке"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "空头",
                                "target_lang_sense_clarification": "指支票"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9f86dcdb-fa15-3162-9534-5fa1cc835c66",
                    "sense_definition": "To look about or stare with excessive curiosity.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "observation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Drivers slowed down to <w>rubber</w> at the accident on the highway.",
                            "target_lang_translations": {
                                "ru": "Водители притормаживали, чтобы <w>поглазеть</w> на аварию на шоссе.",
                                "zh": "司机们减速去<w>围观</w>高速公路上的事故。"
                            }
                        },
                        {
                            "text": "Stop <w>rubbering</w> at the neighbors and come back inside.",
                            "target_lang_translations": {
                                "ru": "Перестань <w>пялиться</w> на соседей и возвращайся в дом.",
                                "zh": "别再<w>盯着</w>邻居看了，快回屋里来。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Смотреть по сторонам или пялиться с чрезмерным любопытством.",
                        "zh": "因过度好奇而四处张望或盯着看。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "глазеть",
                                "target_lang_sense_clarification": "разговорное"
                            },
                            {
                                "target_lang_word": "пялиться",
                                "target_lang_sense_clarification": "просторечное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "围观",
                                "target_lang_sense_clarification": "好奇地看"
                            },
                            {
                                "target_lang_word": "盯着看",
                                "target_lang_sense_clarification": "直视"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}