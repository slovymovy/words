        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "5f9d39ac-3dc6-3729-ad16-555643691e19",
                "word": "inframedian",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "0d00e8f8-1051-3959-a9e8-3290f3d2610d",
                        "entry_id": "5f9d39ac-3dc6-3729-ad16-555643691e19",
                        "glosses": [
                            "Of or relating to the interval or zone along the sea bottom, at the depth of between fifty and one hundred fathoms."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "d3fddc13-4762-4826-8d89-ac4c84629aa2",
                                "sense_id": "0d00e8f8-1051-3959-a9e8-3290f3d2610d",
                                "text": "The inframedian zone ranges from fifty fathoms to a hundred."
                            },
                            {
                                "example_id": "c5f4eec0-53db-4f25-a962-dee1a5d55fd3",
                                "sense_id": "0d00e8f8-1051-3959-a9e8-3290f3d2610d",
                                "text": "Thus, in the British seas naturalists speak of a littoral, laminarian, coralline, and coral zone; an in the ocean genrally, of a littoral, circum-littoral, median, inframedian, and abyssal or deep-sea zone."
                            }
                        ]
                    },
                    {
                        "sense_id": "addf847f-99a8-37e6-8e8b-b2d319c4a3f7",
                        "entry_id": "5f9d39ac-3dc6-3729-ad16-555643691e19",
                        "glosses": [
                            "Below the middle."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "f4f160a5-a583-4554-b2aa-fbec677d4f2b",
                                "sense_id": "addf847f-99a8-37e6-8e8b-b2d319c4a3f7",
                                "text": "Thus the upper, inframedian and carinal laterals have three layers, but the rostrum and rostro-laterals, which appear at a later stage, have only two."
                            },
                            {
                                "example_id": "95159e0e-81f0-4890-b83d-cbb3a9312c83",
                                "sense_id": "addf847f-99a8-37e6-8e8b-b2d319c4a3f7",
                                "text": "Gl. oculatum is easily distinguished from these by the fact that it bears no spines and by the median rather than inframedian girdle."
                            },
                            {
                                "example_id": "cb9e1e2e-21f4-4abc-a5df-9dde0279c8bc",
                                "sense_id": "addf847f-99a8-37e6-8e8b-b2d319c4a3f7",
                                "text": "From the ventral apices of the two lateral cartilages, the two inframedian radular tensors run upwards and slightly forwards."
                            },
                            {
                                "example_id": "a28de9f5-71da-49bf-9169-7a8cabd53054",
                                "sense_id": "addf847f-99a8-37e6-8e8b-b2d319c4a3f7",
                                "text": "Oogonium with projections or lateral pleating of the wall (flange ) ; circumcision supramedian , median , submedian or distinctly inframedian, sometimes resembling a hinged pore."
                            }
                        ]
                    }
                ],
