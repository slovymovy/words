                                "target_senses": [
                                    {
                                        "sense_id": "4a719e17-3d2e-330e-aa76-7c51876f4b80",
                                        "entry_id": "72f0e9b2-8434-3b03-b1d5-719f624efdaa",
                                        "glosses": [
                                            "das durch Krankheit oder Unfall hervorgerufene Unvermögen, der Erwerbstätigkeit nachzugehen"
                                        ],
                                        "tags": [
                                            "Arbeitsrecht"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "27a63e5c-f760-40d7-89b3-fa8d9385b025",
                                                "sense_id": "4a719e17-3d2e-330e-aa76-7c51876f4b80",
                                                "text": "Im § 22 (1) TV-L (Entgelt im Krankheitsfall) ist formuliert: „Werden Beschäftigte durch Arbeitsunfähigkeit infolge Krankheit an der Arbeitsleistung verhindert, ohne dass sie ein Verschulden trifft, erhalten sie bis zur Dauer von 6 Wochen das Entgelt nach § 21 TV-L“."
                                            },
                                            {
                                                "example_id": "82d6f596-27c8-4bf8-a251-94d1ae8f0491",
                                                "sense_id": "4a719e17-3d2e-330e-aa76-7c51876f4b80",
                                                "text": "Die Versicherung deckt Heilungskosten ab und bietet Taggeld, eine Invalidenrente bei Arbeitsunfähigkeit sowie eine Hinterlassenenrente im Todesfall."
                                            },
                                            {
                                                "example_id": "4924f670-a912-4939-9883-d7e379bcb229",
                                                "sense_id": "4a719e17-3d2e-330e-aa76-7c51876f4b80",
                                                "text": "„Zur Leistung des Erstattungsbetrages ist der Krankenversicherungsträger zuständig, bei dem der Arbeitnehmer auf Grund des Beschäftigungsverhältnisses, aus dem der Anspruch auf Entgeltfortzahlung besteht, zum Zeitpunkt des Eintrittes der Arbeitsunfähigkeit versichert war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
