                        ]
                    },
                    {
                        "translation_id": "f42d3d88-03df-44f5-8670-49b0809098e9",
                        "source_entry_id": "ddb07aff-ba9e-37c8-b957-2a906dbb6188",
                        "source_sense_id": "002beed9-fd3a-3afe-9205-ef0324605ea9",
