                    {
                        "translation_id": "c2a3dfdc-fcc5-4e84-a7b3-841bee2717aa",
                        "source_entry_id": "23494d17-f058-3553-8327-057af5615c1a",
                        "source_sense_id": "b5ef9ccf-eda4-3a29-b61b-f692c4cf5a0c",
