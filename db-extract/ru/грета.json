                        "examples": [
                            {
                                "example_id": "8530f61e-4876-4cbe-9fa4-0043be646eb7",
                                "sense_id": "484d1c08-f8ae-3033-ba84-e1bd570819d8",
                                "text": "Весь род Груббе вымер, усадьба срыта, и на месте её стоит теперь нарядный птичник с вызолоченными флюгерами, а в нём сидит птичница Грета. Как она радуется своему прелестному жилищу!"
                            }
                        ]
                    }
