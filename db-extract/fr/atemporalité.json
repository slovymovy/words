                                    {
                                        "sense_id": "f76c6f41-381b-37ec-b27a-ec0016301a76",
                                        "entry_id": "9fc05229-ed20-3314-b603-3dcc452fe655",
                                        "glosses": [
                                            "The quality of being atemporal."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2b2216cc-24f9-40d9-909f-c679c608e2c1",
                                                "sense_id": "f76c6f41-381b-37ec-b27a-ec0016301a76",
                                                "text": "With unprecedented access to the Internet, the flattened desert where past, present, and future comingle, we find ourselves living in a state of atemporality, yearning for a time before the present. In the West, the time for which we pine is one before the twenty-first century, which arrived violently on September 11, 2001, and before the rise of the Internet."
                                            }
                                        ]
                                    }
                                ]
