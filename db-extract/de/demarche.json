                "senses": [
                    {
                        "sense_id": "4a6706b2-ce22-3985-8307-7fddf9669a73",
                        "entry_id": "30f6cfa1-4885-3144-91ab-aa953233b925",
                        "glosses": [
                            "diplomatischer Akt des (meist deutlichen) Einspruchs oder der Erklärung eines Staates gegenüber einem anderen Staat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "97a6369f-1bec-4587-8add-4211c81db0fc",
                                "sense_id": "4a6706b2-ce22-3985-8307-7fddf9669a73",
                                "text": "Der Botschafter wurde mit einer Demarche vorstellig."
                            },
                            {
                                "example_id": "8accf45f-1c9a-4b34-b0f7-f50b661083ea",
                                "sense_id": "4a6706b2-ce22-3985-8307-7fddf9669a73",
                                "text": "„Tarent tat denn auch gleich den nächsten Schritt und zwang durch eine militärische Demarche die Römer, sich aus Thurioi zurückzuziehen (281 v. Chr.).“"
                            },
                            {
                                "example_id": "af067241-ae79-40e2-bcc4-895290c138ef",
                                "sense_id": "4a6706b2-ce22-3985-8307-7fddf9669a73",
                                "text": "„Urheber der Demarche waren ein Italiener namens Fermi; zwei Ungarn, Szilard und Wigner; und Einstein, ein Deutscher.“"
                            },
                            {
                                "example_id": "3b7d75c0-7a06-4993-b7a5-4087cf6ed281",
                                "sense_id": "4a6706b2-ce22-3985-8307-7fddf9669a73",
                                "text": "„Tatsächlich war die Demarche von vornherein so formuliert, dass sie unannehmbar sein sollte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "69948dee-e789-4961-bf98-aec157b0a2d8",
                        "source_entry_id": "30f6cfa1-4885-3144-91ab-aa953233b925",
                        "source_sense_id": "4a6706b2-ce22-3985-8307-7fddf9669a73",
                        "source_sense_description": "diplomatischer Akt des Einspruchs oder der Erklärung eines Staates gegenüber einem anderen Staat",
                        "target_lang_word": "démarche",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "démarche",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "40a2f807-f8fb-32e2-802b-9c7a203fd728",
                                        "entry_id": "5ac8a3ff-228c-301d-a478-94f25b42cf92",
                                        "glosses": [
                                            "A diplomatic maneuver; one handled with finesse."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "624aea99-0588-3187-9a51-e70e5de46c32",
                                        "entry_id": "5ac8a3ff-228c-301d-a478-94f25b42cf92",
                                        "glosses": [
                                            "A diplomatic note without a personal attribution conveying an official protest or request for support, less formal than a bout de papier or a note verbale but of similar status to an aide-mémoire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91a26c4d-096b-48d5-9851-b2856d68e4f4",
                                                "sense_id": "624aea99-0588-3187-9a51-e70e5de46c32",
                                                "text": "A less formal way of making diplomatic representations or protests is called a démarche. The following from the US Department of State handbook sets out the typical procedures and purposes of a démarche."
                                            },
                                            {
                                                "example_id": "9bb11ecc-43f8-4711-8ae6-8c7422764856",
                                                "sense_id": "624aea99-0588-3187-9a51-e70e5de46c32",
                                                "text": "He did not question the Communist Party's conformity to Moscow, but he thought that the impact of a démarche would be limited since the Portuguese Communists could not afford to tone down their policies lest they be outflanked from the left."
                                            },
                                            {
                                                "example_id": "4e18afa5-41b5-48a2-996b-21790f0c35be",
                                                "sense_id": "624aea99-0588-3187-9a51-e70e5de46c32",
                                                "text": "The EU made a démarche on 16 April 2003 calling for the continuation of discussions regarding this so-called “follow-up mechanism”, but beyond the one-off meeting, the mechanism never took off and was soon forgotten due to staff changes within the EU bureaucracy."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "079215db-4b14-4d4e-8e74-c37ea158d561",
                        "source_entry_id": "30f6cfa1-4885-3144-91ab-aa953233b925",
                        "source_sense_id": "4a6706b2-ce22-3985-8307-7fddf9669a73",
                        "source_sense_description": "diplomatischer Akt des Einspruchs oder der Erklärung eines Staates gegenüber einem anderen Staat",
                        "target_lang_word": "démarche",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "démarche",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "292a5f96-6adc-39c5-9489-988d8833c45a",
                                        "entry_id": "e582e65b-a502-351d-aeb8-ce8da337331b",
                                        "glosses": [
                                            "Manière de marcher."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae519ed6-fbf5-430d-b5f4-1d35bb5c7ddd",
                                                "sense_id": "292a5f96-6adc-39c5-9489-988d8833c45a",
                                                "text": "Elle vous regarde et d’une lente démarche s’en va au doué, portant sur l’os pointu de son épaule le linge à laver."
                                            },
                                            {
                                                "example_id": "b60f9a21-e53b-4643-b53b-ccc41f5a8047",
                                                "sense_id": "292a5f96-6adc-39c5-9489-988d8833c45a",
                                                "text": "La voilà qui s'avance vers moi dans la lumière. Sa démarche prend source à la chute des reins, descend en ondes alternées une jambe après l'autre ; ses seins bougent, que la rivière a polis ; ils mettent au jour une beauté sans faille."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8cbcd3e1-ef0d-323a-a37e-3560b1f1ea95",
                                        "entry_id": "e582e65b-a502-351d-aeb8-ce8da337331b",
                                        "glosses": [
                                            "Allées et venues, efforts plus ou moins actifs, en vue de la réussite d’une entreprise, d’une affaire."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bb50beb6-f3c6-4f12-ad64-daccff244a39",
                                                "sense_id": "8cbcd3e1-ef0d-323a-a37e-3560b1f1ea95",
                                                "text": "Ces messieurs me catalogueraient définitivement et toute démarche de ma part afin de me justifier ne servirait qu'à aggraver la situation."
                                            },
                                            {
                                                "example_id": "e6f6043c-0ab7-4254-948d-ee8e7a685cb8",
                                                "sense_id": "8cbcd3e1-ef0d-323a-a37e-3560b1f1ea95",
                                                "text": "\"Je n’avais pas du tout vu ce nouveau système à l’aller, je ne l’ai remarqué qu’au retour\", poursuit-il, rageant de \"devoir faire la démarche\" lui-même pour payer l’autoroute, faute de borne et de barrière."
                                            },
                                            {
                                                "example_id": "0648f387-ac4a-44ef-8f8f-9158a4fae8c4",
                                                "sense_id": "8cbcd3e1-ef0d-323a-a37e-3560b1f1ea95",
                                                "text": "On observe toutes ses démarches."
                                            },
                                            {
                                                "example_id": "bebfaf4c-1815-47f0-bdfd-3d7b1fe36d60",
                                                "sense_id": "8cbcd3e1-ef0d-323a-a37e-3560b1f1ea95",
                                                "text": "Il a fait une fausse démarche."
                                            },
                                            {
                                                "example_id": "22d0cb25-34f5-4f4b-9a23-ef572add64c9",
                                                "sense_id": "8cbcd3e1-ef0d-323a-a37e-3560b1f1ea95",
                                                "text": "On jugera de toute sa conduite par sa première démarche."
                                            },
                                            {
                                                "example_id": "1adf4e73-ab63-4f23-8add-7a6cfa986bc3",
                                                "sense_id": "8cbcd3e1-ef0d-323a-a37e-3560b1f1ea95",
                                                "text": "Faire des démarches pour obtenir une place, pour arriver à un but."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8db86db9-7352-3d4c-9871-ccf574099b2c",
                                        "entry_id": "e582e65b-a502-351d-aeb8-ce8da337331b",
                                        "glosses": [
                                            "Tentative faite auprès de quelqu'un pour mener à bien une entreprise."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa5a62e5-edb8-4a46-871b-c61185de38f8",
                                                "sense_id": "8db86db9-7352-3d4c-9871-ccf574099b2c",
                                                "text": "C'est donc finalement l'épicier qui appela les secours ; ou comment transformer une visite indésirable destinée à me dépouiller de mes derniers centimes en une démarche salvatrice."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5cec54f9-e5cb-32fb-8aeb-d551da1c2a59",
                                        "entry_id": "e582e65b-a502-351d-aeb8-ce8da337331b",
                                        "glosses": [
                                            "Proposition artistique d'un artiste à travers ses différents travaux et supports."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2bbbd2e4-a491-3626-bba3-e1c02042697d",
                                        "entry_id": "e582e65b-a502-351d-aeb8-ce8da337331b",
                                        "glosses": [
                                            "Attitude et procédure d'une personne ou d’une organisation, impliquant une orientation, des objectifs et des buts."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe0a0906-9c87-4816-bf6a-3d4c796e7c29",
                                                "sense_id": "2bbbd2e4-a491-3626-bba3-e1c02042697d",
                                                "text": "À l’heure de profondes mutations du secteur de la santé, Sanofi a naturellement initié une démarche ayant comme objectif de renforcer la place du pharmacien d’officine dans le parcours de soin en tant qu’acteur clé de santé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c57d7758-ad5a-330b-8107-eab8b1652923",
                                        "entry_id": "e582e65b-a502-351d-aeb8-ce8da337331b",
                                        "glosses": [
                                            "Plaidoirie remise par une ambassade aux autorités du pays dans lequel elle se trouve, à la demande de ses autorités nationales. Cette plaidoirie prend la forme d’une note ou d'un aide-mémoire et vise à obtenir un soutien, à lever des mesures de rétorsion, etc."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
