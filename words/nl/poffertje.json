                {
                    "sense_id": "b834b072-2802-311d-8741-0ec5bbf88af6",
                    "sense_definition": "Een klein, luchtig Nederlands pannenkoekje.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "voedsel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Op de kermis eten wij altijd warme <w>poffertjes</w> met poedersuiker.",
                            "target_lang_translations": {
                                "zh": "在集市上，我们总是吃撒了糖粉的热<w>荷兰小煎饼</w>。"
                            }
                        },
                        {
                            "text": "De kinderen vinden <w>poffertjes</w> met een klontje boter erg lekker.",
                            "target_lang_translations": {
                                "zh": "孩子们觉得加了一小块黄油的<w>荷兰小煎饼</w>非常好吃。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "warme poffertjes",
                        "portie poffertjes"
                    ],
                    "target_lang_definitions": {
                        "zh": "一种小而蓬松的荷兰煎饼。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "荷兰小煎饼",
                                "target_lang_sense_clarification": "指代这种特定的荷兰传统甜点"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bbb5e8e4-77a8-3091-9cb5-b796abeeabc7",
                    "sense_definition": "Het verkleinwoord van het zelfstandig naamwoord <w>poffer</w>.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het woord <w>poffertje</w> is taalkundig gezien de verkleinvorm van <w>poffer</w>.",
                            "target_lang_translations": {
                                "zh": "从语言学角度来看，poffertje 一词是 poffer 的<w>指小词</w>。"
                            }
                        },
                        {
                            "text": "In deze context is <w>poffertje</w> simpelweg het verkleinwoord van <w>poffer</w>.",
                            "target_lang_translations": {
                                "zh": "在这种语境下，poffertje 仅仅是 poffer 的<w>指小词</w>。"
                            }
