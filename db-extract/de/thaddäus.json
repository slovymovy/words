                                        "sense_id": "afc8f9bc-80a5-397b-a287-166602f4de80",
                                        "entry_id": "a955b3cb-1668-3d47-b819-da1de0aa3854",
                                        "glosses": [
                                            "A male given name from Ancient Greek, of common usage, variant of Thaddaeus."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a7f5a01-6907-4c5e-91a5-a9c6840c9fed",
                                                "sense_id": "afc8f9bc-80a5-397b-a287-166602f4de80",
                                                "text": "\"You must call me 'Thaddeus,' Hazel Jones. Better yet, 'Thad'. 'Mr. Gallagher' is for servants and other hirelings.\"\nWhen Hazel made no reply, Thaddeus learned toward her suggestively: \"Will you call me 'Thad'? It's very like 'Chet', - eh? Almost no one calls me 'Thad' any longer, my old friends are falling away - every season, like dying leaves.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
