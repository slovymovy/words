                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "357ca713-de06-4bc7-816a-0a24ecdb82e5",
                                                "sense_id": "56a4f0b5-19dc-3192-8c6c-27187981a3de",
                                                "text": "the restitution of an elastic body"
                                            },
                                            {
                                                "example_id": "075516ff-db29-47b2-a020-8f1d7cb25ca2",
                                                "sense_id": "56a4f0b5-19dc-3192-8c6c-27187981a3de",
                                                "text": "The force–displacement curve of perfectly plastic contact partners does not show elastic restitution."
