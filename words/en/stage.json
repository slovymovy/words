    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "af8feb6a-4a9e-3841-934f-0b0cb2443baa",
                    "sense_definition": "A raised floor or platform in a theatre, hall, or auditorium where actors, musicians, or speakers perform.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "platform_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The band walked onto the <w>stage</w> and started playing their hit song.",
                            "target_lang_translations": {
                                "ru": "Группа вышла на <w>сцену</w> и начала играть свой хит.",
                                "tr": "Grup <w>sahneye</w> çıktı ve hit şarkılarını çalmaya başladı.",
                                "zh": "乐队走上<w>舞台</w>，开始演奏他们的热门歌曲。"
                            }
                        },
                        {
                            "text": "She felt nervous standing on <w>stage</w> in front of so many people.",
                            "target_lang_translations": {
                                "ru": "Она нервничала, стоя на <w>сцене</w> перед таким количеством людей.",
                                "tr": "Bu kadar çok insanın önünde <w>sahneye</w> çıkıp durmaktan heyecan duyuyordu.",
                                "zh": "站在那么多人面前的<w>舞台</w>上，她感到很紧张。"
                            }
                        }
                    ],
                    "synonyms": [
                        "platform"
                    ],
                    "common_phrases": [
                        "on stage",
                        "take the stage",
                        "center stage",
                        "off stage"
                    ],
                    "target_lang_definitions": {
                        "ru": "Возвышение или площадка в театре, зале или аудитории, где выступают актеры, музыканты или ораторы.",
                        "tr": "Tiyatro, salon veya tiyatro salonunda oyuncuların, müzisyenlerin veya konuşmacıların performans sergilediği yükseltilmiş zemin veya platform.",
                        "zh": "剧院、大厅或礼堂中供演员、音乐家或演讲者表演的凸起地板或平台。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сце́на",
                                "target_lang_sense_clarification": "площадка для выступлений"
                            },
                            {
                                "target_lang_word": "подмо́стки",
                                "target_lang_sense_clarification": "театральные"
                            },
                            {
                                "target_lang_word": "эстра́да",
                                "target_lang_sense_clarification": "концертная площадка"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "sahne",
                                "target_lang_sense_clarification": "gösteri platformu"
                            },
                            {
                                "target_lang_word": "podyum",
                                "target_lang_sense_clarification": "yükseltilmiş platform"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "舞台",
                                "target_lang_sense_clarification": "表演平台"
                            },
                            {
                                "target_lang_word": "台",
                                "target_lang_sense_clarification": "舞台的简称"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0d3d40ee-2e92-3f40-a6ec-ababe4b22677",
                    "sense_definition": "A distinct period, step, or point in a process, development, or series of events.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "phase_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The project is currently in its final <w>stage</w> of development.",
                            "target_lang_translations": {
                                "ru": "Проект в настоящее время находится на завершающей <w>стадии</w> разработки.",
                                "tr": "Proje şu anda geliştirmenin son <w>aşamasında</w>.",
                                "zh": "该项目目前处于开发的最后<w>阶段</w>。"
                            }
                        },
                        {
                            "text": "Children go through many different <w>stages</w> as they grow up.",
                            "target_lang_translations": {
                                "ru": "Дети проходят через множество различных <w>этапов</w> по мере взросления.",
                                "tr": "Çocuklar büyürken birçok farklı <w>evreden</w> geçerler.",
                                "zh": "孩子们在成长过程中会经历许多不同的<w>阶段</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "phase",
                        "level",
                        "step",
                        "point"
                    ],
                    "common_phrases": [
                        "early stage",
                        "final stage",
                        "at this stage",
                        "stage by stage"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отдельный период, шаг или момент в процессе, развитии или ряде событий.",
                        "tr": "Bir süreç, gelişme veya olaylar dizisindeki belirli bir dönem, adım veya aşama.",
                        "zh": "过程、发展或一系列事件中的特定时期、步骤或阶段。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "эта́п",
                                "target_lang_sense_clarification": "период процесса"
                            },
                            {
                                "target_lang_word": "ста́дия",
                                "target_lang_sense_clarification": "фаза развития"
                            },
                            {
                                "target_lang_word": "фа́за",
                                "target_lang_sense_clarification": "ступень развития"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "aşama",
                                "target_lang_sense_clarification": "süreç adımı"
                            },
                            {
                                "target_lang_word": "evre",
                                "target_lang_sense_clarification": "gelişim dönemi"
                            },
                            {
                                "target_lang_word": "safha",
                                "target_lang_sense_clarification": "süreç boyutu"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "阶段",
