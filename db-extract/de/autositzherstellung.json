                "senses": [
                    {
                        "sense_id": "1bf604bb-947d-3a1e-ac99-906a098a0eb1",
                        "entry_id": "1c686e6b-0c25-347c-a0cd-086f4daf736c",
                        "glosses": [
                            "Produktion von Sitzen für Autos"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ea6387a-9558-40de-aa67-23121b710552",
                                "sense_id": "1bf604bb-947d-3a1e-ac99-906a098a0eb1",
                                "text": "„Das Verfahren, es wird speziell für vermischte Kunststoffabfälle entwickelt, die bei der Autositzherstellung anfallen, kann also nur spezifische Abfälle verwerten.“"
                            },
                            {
                                "example_id": "611455ac-c691-4e34-b189-11dddf90881d",
                                "sense_id": "1bf604bb-947d-3a1e-ac99-906a098a0eb1",
                                "text": "„Da das für die Autositzherstellung benötigte Wissen nicht vollständig im Produkt Autositz eingebettet ist, fehlt dem Autohersteller (implizites) Wissen zur optimalen Integration des Sitzes in sein Fahrzeug.“"
                            },
                            {
                                "example_id": "38997e6a-b8df-48a5-b7ed-e0df70b4d413",
                                "sense_id": "1bf604bb-947d-3a1e-ac99-906a098a0eb1",
                                "text": "„Als er im Oktober 1992 einer jungen Gefangenen, die in der Autositzherstellung arbeitet, etwas Fisch zusteckt, gefährdet er damit die eigene Zukunft.“"
                            },
                            {
                                "example_id": "8d35b32e-370b-46d4-a38d-4228e2f594f1",
                                "sense_id": "1bf604bb-947d-3a1e-ac99-906a098a0eb1",
                                "text": "„Diese Untersuchungen werden speziell für bei der Autositzherstellung anfallende vermischte Kunststoffabfälle durchgeführt.“"
                            },
                            {
                                "example_id": "1fd65f02-d4bc-4ba2-a9be-2ce8b9f6a84a",
                                "sense_id": "1bf604bb-947d-3a1e-ac99-906a098a0eb1",
                                "text": "„Als er im Oktober 1992 einer jungen Gefangenen, die in der Autositzherstellung arbeitet, etwas Fisch zusteckt, gefährdet er damit die eigene Zukunft.“"
                            }
