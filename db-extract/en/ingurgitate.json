                "senses": [
                    {
                        "sense_id": "e5d1454b-64e2-358b-905b-7b759ca33f3a",
                        "entry_id": "f341e4ea-91da-360b-ab5a-70f3dfdbb08b",
                        "glosses": [
                            "verschlingen, hinunterschlingen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e629ed5d-9907-4b6c-aee8-6be4127ebc27",
                                "sense_id": "e5d1454b-64e2-358b-905b-7b759ca33f3a",
                                "text": "In order to catch the 9 o'clock train we had to ingurgitate our breakfast.",
                                "translation": "Um den Zug um 9 Uhr zu erreichen, mussten wir unser Frühstück hinunterschlingen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "93e5baf1-aec5-4278-9f4c-c9023767ba86",
                        "source_entry_id": "f341e4ea-91da-360b-ab5a-70f3dfdbb08b",
                        "source_sense_id": "e5d1454b-64e2-358b-905b-7b759ca33f3a",
                        "source_sense_description": "verschlingen, hinunterschlingen",
                        "target_lang_word": "verschlingen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verschlingen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ecb3eab8-3137-393d-9bce-82802033dc13",
                                        "entry_id": "d6bb92a2-6d46-3b70-94e3-2b8f1ce4dd68",
                                        "glosses": [
                                            "(auch übertragen) gierig oder hastig in sich aufnehmen, essen, fressen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f0a7c18-407e-4f01-909b-84f90992d580",
                                                "sense_id": "ecb3eab8-3137-393d-9bce-82802033dc13",
                                                "text": "„Sie umschlingen ihre Beute und ersticken sie, um sie dann als Ganzes zu verschlingen.“"
                                            },
                                            {
                                                "example_id": "723db111-95d6-4cde-a2f5-517f4c51d74e",
                                                "sense_id": "ecb3eab8-3137-393d-9bce-82802033dc13",
                                                "text": "„Der Wolf verschlang die Großmutter unzerkaut.“"
                                            },
                                            {
                                                "example_id": "58d03256-3226-4bf4-846f-f3b2813220a3",
                                                "sense_id": "ecb3eab8-3137-393d-9bce-82802033dc13",
                                                "text": "Ich glaube, die Wellen verschlingen,",
                                                "translation": "Am Ende Schiffer und Kahn. (Heinrich Heines Lied von der Lore-Ley)"
                                            },
                                            {
                                                "example_id": "03cea2d6-cdaf-4765-b026-8aeaff837fbf",
                                                "sense_id": "ecb3eab8-3137-393d-9bce-82802033dc13",
                                                "text": "Die Revolution verschlang ihre Kinder."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "fd7175cc-11e1-3e8e-b9c1-c103068d4677",
                                        "entry_id": "d6bb92a2-6d46-3b70-94e3-2b8f1ce4dd68",
                                        "glosses": [
                                            "gierig, hingabevoll, ausdauernd mit den Sinnen wahrnehmen, erfassen, lesen"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "374e9829-e8f3-4298-8c63-7fc866b6d8af",
                                                "sense_id": "fd7175cc-11e1-3e8e-b9c1-c103068d4677",
                                                "text": "„Als Kind verschlang ich alle Bücher, die ich in die Hände bekam und las oft bis spätabends mit der Taschenlampe in der Hand eine spannende Abenteuergeschichte. “"
                                            },
                                            {
                                                "example_id": "f430a9b7-7cb4-4f1d-b1c0-46e659650819",
                                                "sense_id": "fd7175cc-11e1-3e8e-b9c1-c103068d4677",
                                                "text": "„Und wir genossen des Anblick des anderen und ebenso, vom anderen mit Blicken verschlungen zu werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c6facd11-df87-4afd-b64f-c498fb83cfcf",
                        "source_entry_id": "f341e4ea-91da-360b-ab5a-70f3dfdbb08b",
                        "source_sense_id": "e5d1454b-64e2-358b-905b-7b759ca33f3a",
                        "source_sense_description": "verschlingen, hinunterschlingen",
                        "target_lang_word": "hinunterschlingen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hinunterschlingen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "652eba93-6aff-3369-bf7a-06d8ffe47740",
                                        "entry_id": "9402cab6-5283-3fb7-a477-b50ae15629ea",
                                        "glosses": [
                                            "schnell, gierig in sich aufnehmen, essen, fressen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7cb63f7e-5205-4027-b56c-f278faea5e33",
                                                "sense_id": "652eba93-6aff-3369-bf7a-06d8ffe47740",
                                                "text": "„Beide hatten in der regulären Zeit von zehn Minuten jeweils 59 Würstchen samt Brötchen hinuntergeschlungen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
