                        "cross_references": [
                            {
                                "target_word": "снайпер",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "4f5aed1d-f0ba-325e-9123-6965ab77da50",
                                        "entry_id": "cbf1c03d-20f8-360f-a879-99a0a41e0062",
                                        "glosses": [
                                            "человек, обладающий исключительной меткостью"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e24ed1e-fabf-4cc7-ad90-ba45d6d78bee",
                                                "sense_id": "4f5aed1d-f0ba-325e-9123-6965ab77da50",
                                                "text": "В после́дний раз когда́ са́мый выдаю́щийся сна́йпер сбо́рной Чехии вы́ступил на чемпиона́те ми́ра в 1994 году́, кома́нда заняла́ седьмо́е ме́сто, вы́играв всего́ оди́н матч."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "590bec0f-d8a6-3755-9f49-bfe2fb01fe1a",
                                        "entry_id": "cbf1c03d-20f8-360f-a879-99a0a41e0062",
                                        "glosses": [
                                            "воен. специально обученный стрелок, снайпер [1], вооружённый снайперской винтовкой и уничтожающий важные одиночные цели"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0feb14e-3b58-4ac5-89df-ea8f7299d0e8",
                                                "sense_id": "590bec0f-d8a6-3755-9f49-bfe2fb01fe1a",
                                                "text": "Во время англо-бурской войны английские солдаты в дозорах стояли по трое, и пока прикуривали первый и второй, бурский снайпер успевал перезарядить свое ружьё и уложить как раз третьего."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c2a67ad3-7a78-48ae-a029-4dfdac30531c",
                        "source_entry_id": "eac7205f-bd59-3d83-ace7-d25941afbc5d",
