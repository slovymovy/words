                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "state_change",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мой отец недавно <вышел> на пенсию и теперь много отдыхает.",
                            "target_lang_translations": {
