                        "source_sense_id": "4adf5409-6e56-3ad7-9dae-050d50ba5a40",
                        "source_sense_description": "eiweißreiches vegetarisches Lebensmittel, das anstelle von Fleisch eingesetzt wird",
                        "target_lang_word": "meat substitute",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "6bf20d5e-8b51-4670-8f84-e159ce71c929",
                        "source_entry_id": "5cfb6d29-b2d2-3315-b25e-71e38f6f48b5",
                        "source_sense_id": "4adf5409-6e56-3ad7-9dae-050d50ba5a40",
                        "source_sense_description": "eiweißreiches vegetarisches Lebensmittel, das anstelle von Fleisch eingesetzt wird",
                        "target_lang_word": "mock meat",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mock meat",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8a3e7ffc-e216-386a-9201-9bab3c485b9a",
                                        "entry_id": "f9249fbe-7753-304e-a7e1-fe4458b0e818",
                                        "glosses": [
                                            "A type of vegetarian processed food, often containing soy, gluten, and vegetables, shaped and coloured to resemble real meat."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "daa886cf-7291-4d66-9f8e-f5a83297d202",
                                                "sense_id": "8a3e7ffc-e216-386a-9201-9bab3c485b9a",
                                                "text": "Giving tofu taste and seitan sizzle is a daunting task, but this casual vegan cafe usually succeeds nicely with a flavorful series of mock meat dishes that have exotic inspirations and attractive presentations."
                                            },
                                            {
                                                "example_id": "879121d3-7307-462c-ba20-b4fc62842678",
                                                "sense_id": "8a3e7ffc-e216-386a-9201-9bab3c485b9a",
                                                "text": "I've nothing against tofu or falafel, however, since they don't exactly taste like meat, and were never intended to serve as mock meat."
                                            },
                                            {
                                                "example_id": "b2799c8a-26ee-4414-a391-304aa18930b0",
                                                "sense_id": "8a3e7ffc-e216-386a-9201-9bab3c485b9a",
                                                "text": "She satisfies carnivorous cravings with guilt-free mock meat at the Still Thoughts Vegetarian Restaurant, located near the National Arts Museum.."
                                            },
                                            {
                                                "example_id": "7a7671d1-b304-4641-8d91-613a9cd42bdc",
                                                "sense_id": "8a3e7ffc-e216-386a-9201-9bab3c485b9a",
                                                "text": "I saw this brand of mock meat highlighted by another member in FairPrice."
                                            },
                                            {
                                                "example_id": "2b5a2151-527d-46f2-9260-af768ef1fbf2",
                                                "sense_id": "8a3e7ffc-e216-386a-9201-9bab3c485b9a",
                                                "text": "At FairPrice, demand for mock meats like mock duck and chicken has risen by 5 per cent in the past year."
                                            },
                                            {
                                                "example_id": "6d7c45c1-20cc-4deb-9534-606e6c300bef",
                                                "sense_id": "8a3e7ffc-e216-386a-9201-9bab3c485b9a",
                                                "text": "Mock meats made from vegetable sources, purportedly first created by Buddhist vegetarians, are especially important to Chinese vegetarian cuisine, although they are now eaten worldwide."
                                            },
                                            {
                                                "example_id": "c9eda58e-b36b-4769-a3b6-8c0daaa44a73",
                                                "sense_id": "8a3e7ffc-e216-386a-9201-9bab3c485b9a",
                                                "text": "That feeling when you eat mock meat and for a moment aren’t sure it’s fake meat. #VeganProblems"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
