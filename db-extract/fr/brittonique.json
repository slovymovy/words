                        "sense_id": "907f464d-3bd9-36a2-adcf-94fdd2f1783a",
                        "entry_id": "b4bf6f2c-1e4a-3b7b-a0e2-8a4a2b58d13e",
                        "glosses": [
                            "Relatif aux premiers peuplements celtiques de la Grande-Bretagne, les Britons ou Bretons insulaires."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "9fe8c7c8-fbd1-3702-932d-bfbd49387d0d",
                        "entry_id": "b4bf6f2c-1e4a-3b7b-a0e2-8a4a2b58d13e",
                        "glosses": [
                            "Relatif à un groupe de langues celtiques qui comprend le breton, le cornique, le gallois et le cambrien (langue aujourd’hui éteinte)."
                        ],
                        "tags": [
                            "Plus courant"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "7e2aa246-d4e6-3a59-9132-bc5a78a0fc8a",
                        "entry_id": "b4bf6f2c-1e4a-3b7b-a0e2-8a4a2b58d13e",
                        "glosses": [
                            "Relatif au brittonique, la langue celtique parlée autrefois en Grande-Bretagne."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8af31171-3cf6-4125-8aed-8c451ef4f6bc",
                        "source_entry_id": "b4bf6f2c-1e4a-3b7b-a0e2-8a4a2b58d13e",
                        "target_lang_word": "britannisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "britannisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a58a6e3d-7396-31b9-9488-fc96ec9378de",
                                        "entry_id": "83df5349-9061-348f-94f8-b441b16ac018",
                                        "glosses": [
                                            "auf die östliche der beiden inselkeltischen Sprachgruppen bezogen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03c5b667-839f-455d-9c9b-99bb3673157d",
                                                "sense_id": "a58a6e3d-7396-31b9-9488-fc96ec9378de",
                                                "text": "„Bei den inselkeltischen Sprachen wiederum unterscheidet man die goidelische Sprachgruppe mit den Sprachen Irisch, Gälisch und Manx und die britannische Sprachgruppe mit den Sprachen Kymrisch, Kumbrisch, Kornisch und Bretonisch.“"
                                            },
                                            {
                                                "example_id": "b8fa66ea-691e-4cec-8d93-4d2fc9dbba37",
                                                "sense_id": "a58a6e3d-7396-31b9-9488-fc96ec9378de",
                                                "text": "„Sie verteilen sich auf zwei stark unterschiedliche Gruppen: britannische Sprachen (Kymrisch, Kornisch, Bretonisch) und goidelische Sprachen beziehungsweise Gälisch (Irisch, Schottisch-Gälisch und Manx);…“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "43683c4f-10f1-3378-8ff3-64e7301bb915",
                                        "entry_id": "83df5349-9061-348f-94f8-b441b16ac018",
                                        "glosses": [
                                            "auf Britannien bezogen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b754be27-7332-41b7-a105-a5771e1b6556",
                                                "sense_id": "43683c4f-10f1-3378-8ff3-64e7301bb915",
                                                "text": "Rudubras hieß der britannische König, der Canterbury erbauen ließ."
                                            },
                                            {
                                                "example_id": "b2d1ac09-4fd6-4ad3-b814-c721c50bdaec",
                                                "sense_id": "43683c4f-10f1-3378-8ff3-64e7301bb915",
                                                "text": "„Sie überquerten die Themse, unterwarfen mehrerer britannische Stämme und erzwangen die Kapitulation des britannischen Oberbefehlshabers Cassivellaunus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9bdbb713-7fe9-4c40-a3dc-353742bf302d",
