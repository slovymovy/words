                                        "glosses": [
                                            "экон. снижение курса национальной валюты по отношению к золоту либо твёрдым валютам в системах с фиксированным курсом валюты, устанавливаемым денежными властями"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
