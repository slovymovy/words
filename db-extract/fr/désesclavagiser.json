                "senses": [
                    {
                        "sense_id": "4578f7a7-b824-3e79-9f23-9c3cd321c9ab",
                        "entry_id": "04637858-9db0-3bb5-821b-e996f9f74311",
                        "glosses": [
                            "Débarrasser de son caractère lié à l’esclavage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f9a1a0aa-12eb-4d5d-ae69-c585f94916a1",
                                "sense_id": "4578f7a7-b824-3e79-9f23-9c3cd321c9ab",
                                "text": "À la suite de ce mouvement, des luttes destinées à décoloniser et désesclavagiser l’espace public se sont diffusées partout en Europe et aux Amériques."
                            },
                            {
                                "example_id": "f4743d21-12a8-4c61-a835-74954a6e0235",
                                "sense_id": "4578f7a7-b824-3e79-9f23-9c3cd321c9ab",
                                "text": "Parce que le Panafricanisme vise à désesclavagiser les Cultures et Civilisations Négro-Africaines qui ont été attaquées par cette agression, cette prédation proto-capitaliste."
                            }
                        ]
                    },
                    {
                        "sense_id": "fee0a952-a7e8-3d69-955e-be3a8e3b7ec9",
                        "entry_id": "04637858-9db0-3bb5-821b-e996f9f74311",
                        "glosses": [
                            "Se libérer d’un esclavage."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "778ed8d8-3ddd-40c6-a077-9b122504600a",
                                "sense_id": "fee0a952-a7e8-3d69-955e-be3a8e3b7ec9",
                                "text": "Mesdames, vous avec cru vous désesclavagiser du foyer alors que maintenant vous parler d'exploiter, d'enrichissements sans fin…"
                            }
                        ]
                    }
                ],
