                ],
                "senses": [
                    {
                        "sense_id": "3fc4ce57-0ad5-3e26-99ee-a2381e6738b3",
                        "entry_id": "605c802d-f859-3b11-b9d4-f638aafb45d5",
                        "glosses": [
                            "Herrscher in einer Tetrarchie, Herrscher über einen von vier Teilen eines Landes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "72a608d3-19be-4bac-b26c-8a8bd1d8368b",
                                "sense_id": "3fc4ce57-0ad5-3e26-99ee-a2381e6738b3",
                                "text": "„Die Tetrarchen mussten immer ihre militärische Befähigung unter Beweis stellen, um sich in kritischen Situationen auf die Loyalität der Soldaten stützen zu können.“"
                            },
                            {
                                "example_id": "3ca59f78-4271-41bd-bdbd-b1914f97e26d",
                                "sense_id": "3fc4ce57-0ad5-3e26-99ee-a2381e6738b3",
                                "text": "„Jeder der drei Stämme der Galater teilte sich jeweils in vier Gruppen auf und jede dieser Gruppen wurde von einem Tetrarchen regiert.“"
                            },
                            {
                                "example_id": "fa775816-8e5a-43a6-ad09-d62993de1912",
                                "sense_id": "3fc4ce57-0ad5-3e26-99ee-a2381e6738b3",
                                "text": "„Die Tetrarchen sind in Form von Inschriften bezeugt, allerdings erst für das 1. Jahrhundert v. Chr.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
