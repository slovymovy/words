                    "sense_id": "b68fb090-57d3-3981-8833-287d0ace0842",
                    "sense_definition": "ни в каком месте, ни в одном из мест",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я искал свои ключи, но их <w>нигде</w> нет.",
                            "target_lang_translations": {
                                "en": "I looked for my keys, but they are <w>nowhere</w>.",
                                "nl": "Ik zocht mijn sleutels, maar ze zijn <w>nergens</w> te vinden.",
                                "pl": "Szukałem swoich kluczy, ale <w>nigdzie</w> ich nie ma.",
                                "de": "Ich habe meine Schlüssel gesucht, aber sie sind <w>nirgendwo</w> zu finden.",
                                "fr": "J'ai cherché mes clés, mais elles ne sont <w>nulle part</w>.",
                                "it": "Ho cercato le mie chiavi, ma non sono <w>da nessuna parte</w>.",
                                "cs": "Hledal jsem své klíče, ale <w>nikde</w> nejsou.",
                                "tr": "Anahtarlarımı aradım ama onları <w>hiçbir yerde</w> bulamadım.",
                                "es": "Busqué mis llaves, pero no están <w>en ninguna parte</w>.",
                                "zh": "我找了我的钥匙，但<w>哪儿都</w>没有。"
                            }
                        },
                        {
                            "text": "Мы <w>нигде</w> не могли купить свежий хлеб.",
                            "target_lang_translations": {
                                "en": "We couldn't buy fresh bread <w>anywhere</w>.",
                                "nl": "We konden <w>nergens</w> vers brood kopen.",
                                "pl": "Nie mogliśmy <w>nigdzie</w> kupić świeżego chleba.",
                                "de": "Wir konnten <w>nirgends</w> frisches Brot kaufen.",
                                "fr": "Nous ne pouvions acheter du pain frais <w>nulle part</w>.",
                                "it": "Non siamo riusciti a comprare pane fresco <w>da nessuna parte</w>.",
                                "cs": "Čerstvý chléb jsme <w>nikde</w> nemohli koupit.",
                                "tr": "Taze ekmeği <w>hiçbir yerde</w> satın alamadık.",
                                "es": "No pudimos comprar pan fresco <w>en ningún sitio</w>.",
                                "zh": "我们<w>哪儿都</w>买不到新鲜面包。"
                            }
                        }
                    ],
