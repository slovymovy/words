                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "4168857c-5502-3094-bc96-071994e35789",
                        "entry_id": "baf7f39f-7ee1-3a6d-9868-4a23fc0637f0",
                        "glosses": [
                            "как свойственно человеку, как характерно для него"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "0def7be4-2441-3e8d-987a-31fc7103b444",
                        "entry_id": "baf7f39f-7ee1-3a6d-9868-4a23fc0637f0",
                        "glosses": [
                            "перен., разг. человечно, гуманно"
                        ],
                        "tags": [],
