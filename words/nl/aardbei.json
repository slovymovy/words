                    "sense_id": "bbfa6e97-87a3-3a99-a375-ac3d4a700801",
                    "sense_definition": "De eetbare, rode en zoete schijnvrucht van de aardbeienplant.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "vrucht",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In de zomer eet ik graag een verse <w>aardbei</w> met een beetje suiker.",
                            "target_lang_translations": {
                                "en": "In the summer, I like to eat a fresh <w>strawberry</w> with a little sugar."
                            }
                        },
                        {
                            "text": "Zij versierde de taart met slagroom en een grote, rode <w>aardbei</w>.",
                            "target_lang_translations": {
                                "en": "She decorated the cake with whipped cream and a large, red <w>strawberry</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "aardbezie",
                        "zomerkoninkje"
                    ],
                    "common_phrases": [
                        "verse aardbei",
                        "aardbeien met slagroom"
                    ],
                    "target_lang_definitions": {
                        "en": "The edible, red, and sweet accessory fruit of the strawberry plant."
                    },
                    "translations": {
