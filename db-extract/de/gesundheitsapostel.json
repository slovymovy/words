                                "example_id": "3cbbc950-178a-4944-9f46-7b2bbf2eaf41",
                                "sense_id": "673ecc21-37d8-3456-b01e-0f137114b79f",
                                "text": "„Seit Wochen diskutieren Ärzte, aber auch selbsternannte Gesundheitsapostel, ob Vitamin D Ansteckungen verhindern und bei Covid-19 helfen könnte.“"
                            },
                            {
                                "example_id": "9b09697e-fee4-4207-a467-a9b7c6e04768",
                                "sense_id": "673ecc21-37d8-3456-b01e-0f137114b79f",
                                "text": "„Langhaarige Jünglinge und Gesundheitsapostel waren es, Naturapologeten, Vegetarier und etwas skurrile Anhänger der Rechtschreibreform.“"
                            }
