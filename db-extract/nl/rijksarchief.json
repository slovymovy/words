                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b8b62e2a-4d7f-480f-8862-607edb2f50df",
                                "sense_id": "c06bf257-79d5-3de1-b09f-df120347b962",
                                "text": "Een Belgische amateurhistoricus heeft bij toeval een testament teruggevonden van de moeder van schilder Peter Paul Rubens. De 73-jarige Willy Stevens vond het document van Maria Pypelinckx in het Rijksarchief van Gent."
                            },
                            {
                                "example_id": "332606be-8253-4697-9af5-f39d625c3ee0",
                                "sense_id": "c06bf257-79d5-3de1-b09f-df120347b962",
                                "text": "Grote delen van het rapport zijn voor de komende 60 jaar geheim en worden opgeborgen in het Noorse rijksarchief."
                            },
                            {
                                "example_id": "20bb70a8-cf2e-4a77-ae51-2a1300639b0f",
                                "sense_id": "c06bf257-79d5-3de1-b09f-df120347b962",
                                "text": "Vandaag komt Van Hattem er in het Rijksarchief van Rijkswaterstaat achter dat het te maken heeft met de Tweede Wereldoorlog. De brug werd in WOII opgeblazen, door de Duitsers, werd altijd gedacht. Nu blijkt volgens Van Hattem dat de Duitsers wel springstof onder de brug hebben gelegd, maar dat de Engelsen hem opbliezen, om te voorkomen dat de Duitsers verder het land in zouden trekken."
                            }
                        ]
                    }
