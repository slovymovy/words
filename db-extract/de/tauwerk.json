                                "target_senses": [
                                    {
                                        "sense_id": "7ffeedf6-90fd-30c3-9972-6b1be76954d2",
                                        "entry_id": "cbc52b67-792f-376e-bafd-377dfad8cb37",
                                        "glosses": [
                                            "Cord (of any type) when viewed as a mass or commodity."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "43909ea5-0d7d-3b02-850a-87ba68c39139",
                                        "entry_id": "cbc52b67-792f-376e-bafd-377dfad8cb37",
                                        "glosses": [
                                            "A set of ropes and cords, especially that used for a ship's rigging."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "016768cb-4adb-436a-8138-bbc2b085b46d",
                                                "sense_id": "43909ea5-0d7d-3b02-850a-87ba68c39139",
                                                "text": "So Juan stood, bewildered on the deck: / The wind sung, cordage strained, and sailors swore […]"
                                            },
                                            {
                                                "example_id": "7585a263-55a1-4948-a4fe-01b2513971c8",
                                                "sense_id": "43909ea5-0d7d-3b02-850a-87ba68c39139",
                                                "text": "[…] as the old craft deep dived into the green seas, and sent the shivering frost all over her, and the winds howled, and the cordage rang […]"
                                            },
                                            {
                                                "example_id": "f066496c-aa8d-48b0-a6c6-fc5ffd3fee3c",
                                                "sense_id": "43909ea5-0d7d-3b02-850a-87ba68c39139",
                                                "text": "A lone river wind sighed in the cordage of the ship."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c8dbf101-2a55-343a-8b08-76e5c9369a2f",
                                        "entry_id": "cbc52b67-792f-376e-bafd-377dfad8cb37",
                                        "glosses": [
                                            "An amount of wood measured in cords."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e94da9b0-a7c0-46f4-9f0e-5676a3b2aa26",
                        "source_entry_id": "5bcc2c5e-5dc8-3e65-9e8c-2bb643c8848d",
                        "source_sense_id": "6a5c441c-1c06-3007-9978-4dbbdd369efd",
                        "source_sense_description": "in der Seefahrt verwendete Taue",
                        "target_lang_word": "cordage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cordage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2b5dd0e2-3560-3453-80d9-bd53843b8535",
                                        "entry_id": "3fdced96-ab29-373b-ac96-8558cd359326",
                                        "glosses": [
                                            "Corde de dimension plus ou moins grande qui sert au gréement et à la manœuvre d’un navire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f30fad4c-03da-41bf-9684-d7c5ccf0c5cc",
                                                "sense_id": "2b5dd0e2-3560-3453-80d9-bd53843b8535",
                                                "text": "… le matelot siffla ses hommes, sur un ordre qu’il leur donna, ils sautèrent tous sur le Saint-Ferdinand, grimpèrent dans les cordages, et se mirent à le dépouiller de ses vergues, de ses voiles, de ses agrès, […]."
                                            },
                                            {
                                                "example_id": "d021df4d-bb56-40e2-932b-3629e149981a",
                                                "sense_id": "2b5dd0e2-3560-3453-80d9-bd53843b8535",
                                                "text": "De la fibre qui entoure la noix on fabrique de robustes cordages imputrescibles, […]."
                                            },
                                            {
                                                "example_id": "99209eb7-5f7c-4f7b-b513-dc1e9a301b51",
                                                "sense_id": "2b5dd0e2-3560-3453-80d9-bd53843b8535",
                                                "text": "Sur un navire, la seule corde est celle de la cloche. Tous les autres cordages ont des noms spécifiques : drisse, amure, écoute, hauban, bastaque, aussière, amarre, …"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f2eddb62-0db0-3c64-b505-9008f374d931",
                                        "entry_id": "3fdced96-ab29-373b-ac96-8558cd359326",
                                        "glosses": [
                                            "Ensemble de toute sorte de corde."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1226c836-4a69-461b-8a00-3b0113d38eac",
                                                "sense_id": "f2eddb62-0db0-3c64-b505-9008f374d931",
                                                "text": "Ils se tenaient rassemblés autour d'une arène délimitée par du cordage où se poutraient deux insectes hargneux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "46c9f399-12d4-3b0e-ae6c-a9e6d640311a",
                                        "entry_id": "3fdced96-ab29-373b-ac96-8558cd359326",
                                        "glosses": [
                                            "Ensemble des cordes d’une raquette de tennis."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "647b085a-d30e-31d1-b15f-6cedb1ceee67",
                                        "entry_id": "3fdced96-ab29-373b-ac96-8558cd359326",
                                        "glosses": [
                                            "Action de corder une raquette de tennis."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "48b0f1fc-a540-3d0b-9b10-3c2540121abd",
                                        "entry_id": "3fdced96-ab29-373b-ac96-8558cd359326",
                                        "glosses": [
                                            "Manière de mesurer le bois qu’on appelle bois de corde."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a434707b-10c6-4089-aec3-083cfac0948a",
                                                "sense_id": "48b0f1fc-a540-3d0b-9b10-3c2540121abd",
                                                "text": "Le bois est bon, mais on vous a trompé au cordage."
                                            }
                                        ]
                                    }
                                ]
