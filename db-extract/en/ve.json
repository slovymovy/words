                "senses": [
                    {
                        "sense_id": "03e8f149-3739-3346-99c0-f6bee0c5cf50",
                        "entry_id": "24e6f200-8d76-327e-97ea-13eca7543f48",
                        "glosses": [
                            "Pronunciation spelling of we."
                        ],
                        "tags": [
                            "alt-of",
                            "pronunciation-spelling"
                        ],
                        "examples": [
                            {
                                "example_id": "38657585-c88d-4754-ae53-7865e2b67b14",
                                "sense_id": "03e8f149-3739-3346-99c0-f6bee0c5cf50",
                                "text": "Ve vill go to de Sheafen Farm, and ve vill stay at de Sheafen Farm, is it not?"
                            },
                            {
                                "example_id": "8b68ad51-d0fd-406f-accd-ccf58cfc2b19",
                                "sense_id": "03e8f149-3739-3346-99c0-f6bee0c5cf50",
                                "text": "But ve have grounds larger even than these – though in vinter, ve have very little daylight, so ve are not enjoying them."
                            },
                            {
                                "example_id": "dd587185-1648-4672-8d74-1afd1526d0ea",
                                "sense_id": "03e8f149-3739-3346-99c0-f6bee0c5cf50",
                                "text": "“My calculations predict another day or so. Ve vill be docking in Liverpool.”"
                            },
                            {
                                "example_id": "c2e70bdb-0648-4306-90d3-fc265ef78553",
                                "sense_id": "03e8f149-3739-3346-99c0-f6bee0c5cf50",
                                "text": "In Johnny Canuck, a Nazi guard says: “Look, gentlemen of der turd reich. Ve haf captured Johnny Canuck and all his friends.”"
                            }
                        ]
                    }
                ],
