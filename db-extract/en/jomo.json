                        "examples": [
                            {
                                "example_id": "ca63cf1d-0eb2-43c0-b5f4-c2e8652bb2b8",
                                "sense_id": "c19a3cda-9dfe-38e6-9647-076afcfe36e6",
                                "text": "c'''1882, Sarat Chandra Das, Journey to Lhasa and Central Tibet, John Murray (1902), page 71,\nDecember 26.—The Deba has a dozen jomo and cows yielding plenty of milk. A jomo yields four times the quantity of milk which a cow or female yak gives. […] the Tibetans value very highly the jo, which is, besides a good milker, most useful in husbandry."
                            }
                        ]
