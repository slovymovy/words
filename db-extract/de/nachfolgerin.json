                "senses": [
                    {
                        "sense_id": "7f927dfb-b46c-3320-a481-26e870ff0aba",
                        "entry_id": "beb12cf2-91bd-3410-9a47-a4d7c2268a6a",
                        "glosses": [
                            "weibliche Person, welche künftig die Position einer bestimmten Person einnimmt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b18d0089-6bed-4029-8480-c9d06a19132c",
                                "sense_id": "7f927dfb-b46c-3320-a481-26e870ff0aba",
                                "text": "Er begrüßte seine Nachfolgerin mit herzlichen Worten."
                            },
                            {
                                "example_id": "75522915-99dd-40ce-b884-406193641f35",
                                "sense_id": "7f927dfb-b46c-3320-a481-26e870ff0aba",
                                "text": "Die Suche nach einer Nachfolgerin gestaltete sich schwieriger als gedacht."
                            },
                            {
                                "example_id": "0bea1bd2-cb42-4d6e-9b52-e2f04542c9bd",
                                "sense_id": "7f927dfb-b46c-3320-a481-26e870ff0aba",
                                "text": "„Erst Verteidigungsministerin, demnächst wahrscheinlich Kommissionspräsidentin der EU: Ursula von der Leyen soll Nachfolgerin von Jean-Claude Juncker werden.“"
                            },
                            {
                                "example_id": "4508f86e-ae56-4bb1-ba04-28bf497895ec",
                                "sense_id": "7f927dfb-b46c-3320-a481-26e870ff0aba",
                                "text": "„Der Nachfolger Heinrichs VIII., König Eduard VI., ist gestorben, Heinrichs Testament verfügt, auf Eduard solle im Todesfalle Maria, die Katholische, folgen, aber Eduard, so sagt man, habe auf dem Totenbett seine Schwester Johanna zur Nachfolgerin bestimmt.“"
                            },
                            {
                                "example_id": "7b2e09d9-4073-4e01-8213-698d0813129a",
                                "sense_id": "7f927dfb-b46c-3320-a481-26e870ff0aba",
                                "text": "„Auch die Beziehung zu ihrer Nachfolgerin Lisa Matthias ist zerbrochen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "071ad389-eaeb-4570-8f8a-e50ea861644e",
                        "source_entry_id": "beb12cf2-91bd-3410-9a47-a4d7c2268a6a",
                        "source_sense_id": "7f927dfb-b46c-3320-a481-26e870ff0aba",
                        "source_sense_description": "weibliche Person, welche künftig die Position einer bestimmten Person einnimmt",
                        "target_lang_word": "successeur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "successeur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f5447c16-d0d2-3148-9bc5-883100ea4e4a",
                                        "entry_id": "340a41aa-3758-365a-9459-8bd8f5059e92",
                                        "glosses": [
                                            "Personne qui succède à une autre dans une fonction, un titre, un rôle ou une institution."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "35228d8f-405a-4290-9220-380d0bbf6ab5",
                                                "sense_id": "f5447c16-d0d2-3148-9bc5-883100ea4e4a",
                                                "text": "Le Curé, en mourant, devait laisser à son successeur, un lit garni, un pot de cuivre , un crémail, quelques petits meubles de bois et une poêle à frire."
                                            },
                                            {
                                                "example_id": "efa3e8d1-6344-4bbc-92fe-5c0fa2d3bc98",
                                                "sense_id": "f5447c16-d0d2-3148-9bc5-883100ea4e4a",
                                                "text": "Les successeurs de Descartes nient l'efficace des causes secondes."
                                            },
                                            {
                                                "example_id": "a0f33bb9-0172-4af6-9299-976ac5549791",
                                                "sense_id": "f5447c16-d0d2-3148-9bc5-883100ea4e4a",
                                                "text": "En combinant avec les observations si précises de M. Edwards celles de ses devanciers et de ses successeurs, nous pouvons en tirer une conclusion générale."
                                            },
                                            {
                                                "example_id": "691c00bd-7e6f-40a3-8a6f-d18145579505",
                                                "sense_id": "f5447c16-d0d2-3148-9bc5-883100ea4e4a",
                                                "text": "L’évêque de Chartres venait de mourir et son successeur était l’un des plus vieux amis de Gévresin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "17f47750-7862-3d29-9568-774d26cd7b81",
                                        "entry_id": "340a41aa-3758-365a-9459-8bd8f5059e92",
                                        "glosses": [
                                            "Nombre ou point qui suit un autre."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ebe4aa39-8086-35e5-ab0b-9f42f8e5c40e",
                                        "entry_id": "340a41aa-3758-365a-9459-8bd8f5059e92",
                                        "glosses": [
                                            "Pour un sommet donné, autre sommet qui se situe à la fin d'un arc incident vers l’extérieur du premier."
                                        ],
                                        "tags": [
                                            "Théorie des graphes"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a8a2937b-33e6-4100-ae46-89d14802945d",
                        "source_entry_id": "beb12cf2-91bd-3410-9a47-a4d7c2268a6a",
                        "source_sense_id": "7f927dfb-b46c-3320-a481-26e870ff0aba",
