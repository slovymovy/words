                "senses": [
                    {
                        "sense_id": "140d6849-9cc5-3744-ae35-cb9fb10e3682",
                        "entry_id": "82a93625-dd9e-3b8a-8dbb-0b4560e1ef8d",
                        "glosses": [
                            "zusammenfassende Bezeichnung für die Gebetszeiten, die in verschiedenen Konfessionen zu bestimmten Zeiten im Laufe des Tages gebetet werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a78eb3fd-df38-447b-9772-5e398834fda5",
                                "sense_id": "140d6849-9cc5-3744-ae35-cb9fb10e3682",
                                "text": "Das Stundengebet umfasst sieben Gebetszeiten."
                            },
                            {
                                "example_id": "9122da5c-06fd-49b0-8c39-088a3c579ec3",
                                "sense_id": "140d6849-9cc5-3744-ae35-cb9fb10e3682",
                                "text": "„Nach dem Stundengebet, dem Komplet, setzte ich mich um 21.30 Uhr erwartungsvoll vor den Fernseher, um zusammen mit meinen Ordensbrüdern das WM-Finale zwischen Italien und Brasilien anzusehen.“"
                            },
                            {
                                "example_id": "1f1c6fbb-ecc9-4988-a1ba-df70456f0145",
                                "sense_id": "140d6849-9cc5-3744-ae35-cb9fb10e3682",
                                "text": "„Die täglich sich wiederholenden liturgischen Verrichtungen wie Messe und Stundengebet und die für die Geistlichen aus der Seelsorge resultierenden Aufgaben und geistlichen Verpflichtungen setzten zwingend voraus, dass an Pfarrkirchen ein Grundbestand an liturgischen Büchern vorhanden sein musste.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
