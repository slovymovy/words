                ],
                "senses": [
                    {
                        "sense_id": "d3f7f3f4-f064-3264-a3fa-acbe896cbbf0",
                        "entry_id": "a31966f5-6bb0-3d8c-bb12-afd05f050503",
                        "glosses": [
                            "Le second mois du calendrier républicain ; il allait du 23 octobre au 21 novembre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e056c858-f958-4313-98d1-57d5b1f320f9",
                                "sense_id": "d3f7f3f4-f064-3264-a3fa-acbe896cbbf0",
                                "text": "Trois semaines plus tard, le 4 brumaire an IV (26 décembre 1795), la Convention nationale tint sa dernière séance et se sépara aux cris prolongés de Vive la République."
                            },
                            {
                                "example_id": "e0636276-0e54-45f4-ada1-72b179b056b9",
                                "sense_id": "d3f7f3f4-f064-3264-a3fa-acbe896cbbf0",
                                "text": "Sous le code de brumaire an IV, cette institution s’appelait le jury d’accusation par opposition au jury de jugement."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "004bcc31-bd04-4428-ac0b-71314833e3eb",
                        "source_entry_id": "a31966f5-6bb0-3d8c-bb12-afd05f050503",
