                        "examples": [
                            {
                                "example_id": "e22c5edd-7276-493b-b5a6-7efaebfa8013",
                                "sense_id": "5681379b-25d9-3e8d-a40c-820f9877b6f5",
                                "text": "Un zooïâtre, du nom de Périnetti, me fit visiter, il y a deux ans, une vache qui avait été déclarée atteinte de typhose puerpérale par Molino, médecin vétérinaire à Chieri ; […]"
                            },
                            {
                                "example_id": "2d7770a0-4b32-4635-b623-9867eb2a7ff2",
                                "sense_id": "5681379b-25d9-3e8d-a40c-820f9877b6f5",
                                "text": "En effet, ces derniers, — tout en n’étant pas non plus dans une situation fastueuse, bien s’en faut, — sont encore les enfants gâtés du corps sanitaire relativement à leurs frères zooïâtres."
                            }
                        ]
