                "senses": [
                    {
                        "sense_id": "1094d5ef-5b89-3ffd-bbab-29d9a7746198",
                        "entry_id": "6e6170c3-78c3-3487-92ab-c28c1ffba083",
                        "glosses": [
                            "Eigenschaft, die in deutlichem Maße Erregbarkeit des Gemütes, Ansprechbarkeit der Gefühle zeigt; Neigung mit starken Gefühlen zu reagieren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "65e32172-cb91-4b56-b500-fb16a90f1ff3",
                                "sense_id": "1094d5ef-5b89-3ffd-bbab-29d9a7746198",
                                "text": "„Ein Mann mit labilem Gemüt macht auf ein Weib nur wenig Eindruck; ein Weib mit dürftiger Emotivität lässt den Mann kalt.“"
                            },
                            {
                                "example_id": "3b4cdf59-0780-4554-bd05-75067012471d",
                                "sense_id": "1094d5ef-5b89-3ffd-bbab-29d9a7746198",
                                "text": "„Klein unterscheidet zwischen gewöhnlichem und kreativem Denken, zwischen funktionalem Denken und psychischem Gedächtnis und zwischen Emotivität (erhöhter Gemütserregbarkeit) und Emotion.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
