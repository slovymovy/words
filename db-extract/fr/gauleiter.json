                        "sense_id": "4b2d3ca4-1d4b-3679-9f69-17655706207b",
                        "entry_id": "e0d706a0-4f69-3810-8cc3-49838f3327f1",
                        "glosses": [
                            "Responsable régional politique du parti nazi et responsable administratif d'une subdivision territoriale dans l'Allemagne nazie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8044878a-dc9d-4f90-9659-2d0a22af10b6",
                                "sense_id": "4b2d3ca4-1d4b-3679-9f69-17655706207b",
                                "text": "Le 16 mars, dans un nouveau message aux Gauleiters, Hitler commanda de détruire, d'anéantir , de raser tout ce qui pouvait, tombant aux mains de l'ennemi, lui être utile : les centrales électriques et les usines à gaz, les manufactures de toutes sortes, les mines, les voies ferrées, les canaux, […]."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "75b9efa6-a1e7-489a-bb82-d9d9c47b9c54",
                        "source_entry_id": "e0d706a0-4f69-3810-8cc3-49838f3327f1",
                        "source_sense_id": "4b2d3ca4-1d4b-3679-9f69-17655706207b",
                        "target_lang_word": "Gauleiter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gauleiter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "62263a21-b7b1-321e-8b84-5e964ae1fb05",
                                        "entry_id": "53337c20-aa45-3343-8c49-909d8e2d27b2",
                                        "glosses": [
                                            "für einen Gau verantwortliches Parteimitglied der NSDAP"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9bfba16-0c52-4d7b-8c8b-50194bb93f96",
                                                "sense_id": "62263a21-b7b1-321e-8b84-5e964ae1fb05",
                                                "text": "„In seiner zweistündigen Ansprache an die in Rastenburg versammelten Reichsleiter und Gauleiter vom 7. Februar 1943 wiederholte Hitler erneut, das Judentum müsse aus dem Reich und aus ganz Europa entfernt werden.“"
                                            },
                                            {
                                                "example_id": "cde90eb5-4f08-4dca-add3-9c51fa52572f",
                                                "sense_id": "62263a21-b7b1-321e-8b84-5e964ae1fb05",
                                                "text": "„Auch diese Berichte waren dem Gauleiter Hofer nicht verborgen geblieben.“"
                                            },
                                            {
                                                "example_id": "72fc1c0c-bdcb-4c2f-a5e0-2d307a5566ff",
                                                "sense_id": "62263a21-b7b1-321e-8b84-5e964ae1fb05",
                                                "text": "„Nachdem er Hitlers Gauleiter geworden war, ließ er den Mädchennamen seiner Mutter germanisieren.“"
                                            },
                                            {
                                                "example_id": "1b5f2360-9d79-44e7-8623-775c06cceb4d",
                                                "sense_id": "62263a21-b7b1-321e-8b84-5e964ae1fb05",
                                                "text": "„Das Etablissement hatte ein großdeutscher Gauleiter für sie im Krieg erworben und eingerichtet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
