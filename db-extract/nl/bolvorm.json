                        "glosses": [
                            "de vorm hebbend van een bol"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e06d1973-bbba-413e-ba44-6c958c46feb5",
                                "sense_id": "7ba6a16e-f5a7-3519-bf41-143552e943f1",
                                "text": "Voor zover bekend gaat het nog om enkele gevallen. Die hebben niet geleid tot explosies of branden, maar de batterij ziet er op foto’s extreem bolvormig uit."
                            },
                            {
                                "example_id": "0cb21949-72a9-484d-ba08-bb44d46de99d",
                                "sense_id": "7ba6a16e-f5a7-3519-bf41-143552e943f1",
                                "text": "De allernieuwste aanwinst is het Voletarium. Deze attractie is een vliegend theater waarbij de bezoekers zittend in een brede stoeltjeslift, hangend voor een gigantisch bolvormig scherm, een film beleven. De gondel beweegt met het scherm mee, waardoor je het gevoel hebt daadwerkelijk te vliegen. Wind, water en geur maken de beleving nog intenser."
                            }
                        ]
                    }
