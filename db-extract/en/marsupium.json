                        "entry_id": "ec98fae5-224b-372b-a858-7fabdd70f830",
                        "glosses": [
                            "The external pouch in which female marsupials rear and feed the young."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "2c844751-353c-3631-a32c-ca36bf74d5b1",
                        "entry_id": "ec98fae5-224b-372b-a858-7fabdd70f830",
                        "glosses": [
                            "A brood pouch in some fishes, crustaceans and insects in the family Monophlebidae."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "22c0b0c4-61c1-4e05-9e1e-36b7bd1d9e4d",
                        "source_entry_id": "ec98fae5-224b-372b-a858-7fabdd70f830",
