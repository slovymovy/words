                "senses": [
                    {
                        "sense_id": "e803706b-8de6-33c2-b984-b303361870e4",
                        "entry_id": "9d53e05d-741a-3a40-a423-013d4595fc6e",
                        "glosses": [
                            "Geschäftszweig der Informationstechnologie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2f26b9ff-8d35-4f81-8a0b-ccf7aba5c821",
                                "sense_id": "e803706b-8de6-33c2-b984-b303361870e4",
                                "text": "„Die von Möller erwähnte IT-Branche ist eine der am schnellsten wachsenden überhaupt.“"
                            },
                            {
                                "example_id": "87ab3c3a-b934-4bec-b84f-a6ae1d4a4439",
                                "sense_id": "e803706b-8de6-33c2-b984-b303361870e4",
                                "text": "„Die rasante Entwicklung der IT-Branche gepaart mit dem unaufhaltsamen technologischen Fortschritt verändert das Investitionsverhalten der Unternehmen in Richtung neuer Technologien.“"
                            },
                            {
                                "example_id": "93ade58f-0478-4ee5-a87b-ad17e598ace7",
                                "sense_id": "e803706b-8de6-33c2-b984-b303361870e4",
                                "text": "„Der Computerkonzern rühmt seine Entwicklung als entscheidend für die gesamte IT-Branche.“"
                            },
                            {
                                "example_id": "82720828-dcf5-441d-969d-7df79e771863",
                                "sense_id": "e803706b-8de6-33c2-b984-b303361870e4",
                                "text": "„Nach Angaben von Andreas Wiese, der in der Gewerkschaft Verdi für die IT-Branche zuständig ist, existiert eine Vereinbarung, wonach die Beschäftigten im Falle eines Umzugs ihren Arbeitsplatz behalten.“"
                            },
                            {
                                "example_id": "756f752a-d862-4519-81b3-2c6b0688ad90",
                                "sense_id": "e803706b-8de6-33c2-b984-b303361870e4",
                                "text": "„Beide beraten auf Augenhöhe und, was in der IT-Branche gerne vorkommt, nicht von oben herab.“"
                            },
                            {
                                "example_id": "cefa1e76-127d-4720-a5b2-0776294d83eb",
                                "sense_id": "e803706b-8de6-33c2-b984-b303361870e4",
                                "text": "„Der Softwareingenieur beim amerikanischen Konzern Oracle bezeichnet sich als ‚Programmier-Bauer‘, ein Spitzname für chinesische Nerds aus den unteren Hierarchiestufen der IT-Branche.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
