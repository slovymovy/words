                    {
                        "translation_id": "14ac63e9-5261-44a7-825b-56936d8b9ff1",
                        "source_entry_id": "90a0f105-6006-36db-a002-f762dbd0a657",
                        "source_sense_id": "c368c263-44a6-3bfb-bef4-d11a1f43d8ec",
                        "source_sense_description": "Invraisemblable, incroyable",
                        "target_lang_word": "unglaublich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unglaublich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1db944e2-a3b7-3386-8788-34eb4d8fd595",
                                        "entry_id": "d1438e18-12c7-3f98-94d5-5bddf3897777",
                                        "glosses": [
                                            "nicht zu glauben, unwahrscheinlich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9674b591-442a-4ecd-9f58-8b483cf583cd",
                                                "sense_id": "1db944e2-a3b7-3386-8788-34eb4d8fd595",
                                                "text": "Er erzählt gerne unglaubliche Geschichten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "cf82d810-2b14-3c57-bed3-c9b398335901",
                                        "entry_id": "d1438e18-12c7-3f98-94d5-5bddf3897777",
                                        "glosses": [
                                            "von außergewöhnlicher Größe, Intensität, Zahl"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "24da32c2-2128-42d3-bde3-509a38910011",
                                                "sense_id": "cf82d810-2b14-3c57-bed3-c9b398335901",
                                                "text": "Der Urlaub war unglaublich schnell vorbei."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "f6a58f13-3d48-3076-9219-609321350ded",
                                        "entry_id": "d1438e18-12c7-3f98-94d5-5bddf3897777",
                                        "glosses": [
                                            "Ärger, Empörung verursachend, nicht angemessen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b0ea6e56-e596-401a-b779-14af5a9c9b5a",
                                                "sense_id": "f6a58f13-3d48-3076-9219-609321350ded",
                                                "text": "Das war eine unglaubliche Frechheit!"
                                            },
                                            {
                                                "example_id": "a8678369-7f7f-4d35-b33c-0fb39b3cf4f6",
                                                "sense_id": "f6a58f13-3d48-3076-9219-609321350ded",
                                                "text": "„Von der Öffentlichkeit unbemerkt, läuft gerade ein unglaubliches Bubenstück in der EU-Gesetzgebung betreffs europaweiter Dienstzeitregelungen für Piloten ab.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5001489f-1613-4797-88e1-a02b8eeefbe4",
                        "source_entry_id": "90a0f105-6006-36db-a002-f762dbd0a657",
                        "source_sense_id": "c368c263-44a6-3bfb-bef4-d11a1f43d8ec",
                        "source_sense_description": "Invraisemblable, incroyable",
                        "target_lang_word": "incredible",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "incredible",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4cca64e2-1479-387b-a8fa-94a9d921d53f",
                                        "entry_id": "f7f50bdf-3776-3a5c-b033-6d7bdce29951",
                                        "glosses": [
                                            "Too implausible to be credible; beyond belief."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b0a5ecd2-f821-471d-8162-8b52d6109a5a",
                                                "sense_id": "4cca64e2-1479-387b-a8fa-94a9d921d53f",
                                                "text": "The extinction of a species once so numerous seemed incredible."
                                            },
                                            {
                                                "example_id": "d03ad86b-c1b2-4d8c-b822-1e837d50cc07",
                                                "sense_id": "4cca64e2-1479-387b-a8fa-94a9d921d53f",
                                                "text": "I get lost in what is credible and not credible. This whole thing gets so incredible when you consider wiping out whole nations, it is difficult to establish credibility."
                                            },
                                            {
                                                "example_id": "d1b96d16-b6e2-4cf5-a0e4-2ede0d13a81f",
                                                "sense_id": "4cca64e2-1479-387b-a8fa-94a9d921d53f",
                                                "text": "The other may be that they sincerely believed it to be true, demonstrating an almost incredible lack of communication between themselves and their working engineers."
                                            },
                                            {
                                                "example_id": "fe31cbe5-6bc6-49df-9e4b-359a2010ad21",
                                                "sense_id": "4cca64e2-1479-387b-a8fa-94a9d921d53f",
                                                "text": "He therefore found revealed religion incredible in a literal sense, and, as Bayle had done before him, he radically separated morality from the practice of organized religion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f5cab61d-23a0-333e-b760-a2e9848df86b",
                                        "entry_id": "f7f50bdf-3776-3a5c-b033-6d7bdce29951",
                                        "glosses": [
                                            "Amazing; astonishing; awe-inspiring."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4fadff51-fd4a-486e-8c6d-f78c433371e7",
                                                "sense_id": "f5cab61d-23a0-333e-b760-a2e9848df86b",
                                                "text": "He was so wrapped up in watching the incredible special effects that he couldn't keep track of the story."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0b2a5f6b-0ce3-3cfa-b757-89b21a62fbd3",
                                        "entry_id": "f7f50bdf-3776-3a5c-b033-6d7bdce29951",
                                        "glosses": [
                                            "Marvellous; profoundly affecting; wonderful; excellent."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f6c5d02a-1c80-476f-a7bc-6720cda25eab",
                                                "sense_id": "0b2a5f6b-0ce3-3cfa-b757-89b21a62fbd3",
                                                "text": "I had such an incredible slice of pizza last night that I simply can't think about anything else."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "745d1ee2-e688-4458-bc76-01fa6c421364",
                        "source_entry_id": "90a0f105-6006-36db-a002-f762dbd0a657",
