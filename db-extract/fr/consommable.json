                    {
                        "translation_id": "6fcf802a-e9e2-4942-91db-b1c34b5786b5",
                        "source_entry_id": "8e79e3c5-5625-37cc-b34a-b4445ca893da",
                        "target_lang_word": "verbruiksartikel",
