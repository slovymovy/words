{
    "word_family": [
        "blind",
        "blindheid",
        "verblinden"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "0954c12c-3163-3ac2-af45-8ce3ee8eae29",
                    "sense_definition": "zonder te kijken of te kunnen zien",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "visuele waarneming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij wist de weg zo goed dat hij <w>blindelings</w> de weg kon vinden.",
                            "target_lang_translations": {
                                "en": "He knew the way so well that he could find his way <w>blindly</w>.",
                                "fr": "Il connaissait si bien le chemin qu'il pouvait le trouver <w>les yeux fermés</w>."
                            }
                        },
                        {
                            "text": "Zij kan <w>blindelings</w> typen op haar nieuwe toetsenbord.",
                            "target_lang_translations": {
                                "en": "She can type <w>blindly</w> on her new keyboard.",
                                "fr": "Elle peut taper <w>à l'aveugle</w> sur son nouveau clavier."
                            }
                        }
                    ],
                    "synonyms": [
                        "geblinddoekt"
                    ],
                    "common_phrases": [
                        "blindelings typen",
                        "blindelings de weg vinden"
                    ],
                    "target_lang_definitions": {
                        "en": "without looking or being able to see",
                        "fr": "sans regarder ou sans être capable de voir"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "blindly",
                                "target_lang_sense_clarification": "without visual guidance"
                            },
                            {
                                "target_lang_word": "blindfolded",
                                "target_lang_sense_clarification": "as if wearing a blindfold"
                            },
                            {
                                "target_lang_word": "by touch",
                                "target_lang_sense_clarification": "using only the sense of touch"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "à l'aveugle",
                                "target_lang_sense_clarification": "sans aide visuelle"
                            },
                            {
                                "target_lang_word": "les yeux fermés",
                                "target_lang_sense_clarification": "sans utiliser la vue"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "83013022-1195-3805-9808-8a3748a02544",
                    "sense_definition": "zonder na te denken of kritisch te zijn",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "vertrouwen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij volgde <w>blindelings</w> zijn partijleider zonder vragen te stellen.",
                            "target_lang_translations": {
                                "en": "He <w>blindly</w> followed his party leader without asking questions.",
                                "fr": "Il suivait <w>aveuglément</w> son chef de parti sans poser de questions."
                            }
                        },
                        {
                            "text": "Je moet nooit <w>blindelings</w> vertrouwen op wat je op internet leest.",
                            "target_lang_translations": {
                                "en": "You should never <w>blindly</w> trust what you read on the internet.",
                                "fr": "Il ne faut jamais faire confiance <w>aveuglément</w> à ce que vous lisez sur Internet."
                            }
                        }
                    ],
                    "synonyms": [
                        "blindweg"
                    ],
                    "common_phrases": [
                        "blindelings vertrouwen",
                        "blindelings volgen"
                    ],
                    "target_lang_definitions": {
                        "en": "without thinking or being critical",
                        "fr": "sans réfléchir ou sans esprit critique"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "blindly",
                                "target_lang_sense_clarification": "without questioning or reasoning"
                            },
                            {
                                "target_lang_word": "implicitly",
                                "target_lang_sense_clarification": "with absolute trust"
                            },
                            {
                                "target_lang_word": "unquestioningly",
                                "target_lang_sense_clarification": "without asking questions"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "aveuglément",
                                "target_lang_sense_clarification": "sans réflexion ni examen"
                            },
                            {
                                "target_lang_word": "sans réserve",
                                "target_lang_sense_clarification": "avec une confiance absolue"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0d97f535-cb5e-3b3d-8b3e-679d4e11cf7c",
                    "sense_definition": "zonder overleg of plan op goed geluk",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "onbezonnenheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij probeerde door <w>blindelings</w> op een paar knoppen te drukken de lift weer in beweging te krijgen.",
                            "target_lang_translations": {
                                "en": "He tried to get the elevator moving again by <w>blindly</w> pressing a few buttons.",
                                "fr": "Il a essayé de remettre l'ascenseur en marche en appuyant <w>au hasard</w> sur quelques boutons."
                            }
                        },
                        {
                            "text": "Zonder plan begon de toerist <w>blindelings</w> door de stad te dwalen.",
                            "target_lang_translations": {
                                "en": "Without a plan, the tourist began to wander <w>aimlessly</w> through the city.",
                                "fr": "Sans plan, le touriste a commencé à errer <w>à l'aveuglette</w> dans la ville."
                            }
                        }
                    ],
                    "synonyms": [
                        "in den blinde"
                    ],
                    "common_phrases": [
                        "blindelings op knoppen drukken"
                    ],
                    "target_lang_definitions": {
                        "en": "without consultation or a plan, relying on luck",
                        "fr": "sans concertation ni plan, en s'en remettant au hasard"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "at random",
                                "target_lang_sense_clarification": "without a specific pattern or plan"
                            },
                            {
                                "target_lang_word": "haphazardly",
                                "target_lang_sense_clarification": "in a disorganized or careless manner"
                            },
                            {
                                "target_lang_word": "blindly",
                                "target_lang_sense_clarification": "without knowing the outcome"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "au hasard",
                                "target_lang_sense_clarification": "sans plan précis"
                            },
                            {
                                "target_lang_word": "à l'aveuglette",
                                "target_lang_sense_clarification": "de manière désorganisée ou imprudente"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "fd30c30e-0aad-3ef1-96da-2a2869661829",
                    "sense_definition": "gebeurend zonder te kijken of zonder na te denken",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zijn <w>blindelingse</w> gehoorzaamheid aan de kapitein was bewonderenswaardig.",
                            "target_lang_translations": {
                                "en": "His <w>blind</w> obedience to the captain was admirable.",
                                "fr": "Son obéissance <w>aveugle</w> au capitaine était admirable."
                            }
                        },
                        {
                            "text": "Zij heeft een <w>blindelings</w> vertrouwen in de goede afloop van het project.",
                            "target_lang_translations": {
                                "en": "She has <w>implicit</w> trust in the successful outcome of the project.",
                                "fr": "Elle a une confiance <w>aveugle</w> dans la réussite du projet."
                            }
                        }
                    ],
                    "common_phrases": [
                        "blindelings vertrouwen",
                        "blindelingse gehoorzaamheid"
                    ],
                    "target_lang_definitions": {
                        "en": "happening without looking or without thinking",
                        "fr": "qui se produit sans regarder ou sans réfléchir"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "blind",
                                "target_lang_sense_clarification": "absolute and unthinking"
                            },
                            {
                                "target_lang_word": "implicit",
                                "target_lang_sense_clarification": "complete and without doubt"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "aveugle",
                                "target_lang_sense_clarification": "absolu et sans réflexion"
                            },
                            {
                                "target_lang_word": "implicite",
                                "target_lang_sense_clarification": "complet et sans doute"
                            }
                        ]
                    }
                }
            ]
        }
    ]
