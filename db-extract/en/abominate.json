                    {
                        "translation_id": "13b09934-2bcb-4fb4-acf9-f51c010bdaf2",
                        "source_entry_id": "5f162215-093c-304a-8d62-13700448f3d8",
                        "source_sense_description": "to feel disgust towards, to hate in the highest degree",
                        "target_lang_word": "ненави́деть",
