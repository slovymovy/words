                "translations": [
                    {
                        "translation_id": "8af74bb4-0b2b-44d9-86d7-3204b08b141c",
                        "source_entry_id": "1281fd4f-1416-332a-b614-79e538bf05d4",
                        "source_sense_id": "526536c9-31fe-36a5-8c24-667c8798f931",
                        "target_lang_word": "Viehbestand",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Viehbestand",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1314495b-2c1a-38c4-b1aa-a0cd3d809c24",
                                        "entry_id": "6e2ef933-8ab0-37ae-97f4-cd22c22a42a4",
                                        "glosses": [
                                            "Bestand an Vieh"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9313a868-1e35-4a19-84ee-024759e61b4a",
                                                "sense_id": "1314495b-2c1a-38c4-b1aa-a0cd3d809c24",
                                                "text": "„Für gewöhnlich sorgt auf einem Hof der Viehbestand für einen zumindest gedämpften Geräuschpegel, aber hier fehlten alle Geräusche des Lebens.“"
                                            },
                                            {
                                                "example_id": "4181f4d7-3ac7-4ee9-b8ec-68362acb270c",
                                                "sense_id": "1314495b-2c1a-38c4-b1aa-a0cd3d809c24",
                                                "text": "„Es hatte Missernten gegeben, und oft musste der Viehbestand vorzeitig geschlachtet werden, um zu verhindern, dass er an Unterernährung einging.“"
                                            },
                                            {
                                                "example_id": "dd868456-25af-45e4-a409-78f46d08a699",
                                                "sense_id": "1314495b-2c1a-38c4-b1aa-a0cd3d809c24",
                                                "text": "„Mir wurde klar, dass die Liebe der Bauern zu ihren Kindern genauso unkontrollierbar war wie ein Ausbruch von Maul- und Klauenseuche im Viehbestand.“"
                                            },
                                            {
                                                "example_id": "e546f6f5-140a-4eb9-939a-c714d8068faa",
                                                "sense_id": "1314495b-2c1a-38c4-b1aa-a0cd3d809c24",
                                                "text": "„Wir haben an die hundert Schafe, gibt sie Auskunft, als ich nach dem Viehbestand frage.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "86e9d8d4-e795-42cc-af1c-b91182f0262b",
                        "source_entry_id": "1281fd4f-1416-332a-b614-79e538bf05d4",
                        "source_sense_id": "526536c9-31fe-36a5-8c24-667c8798f931",
                        "target_lang_word": "livestock",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "livestock",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b35d9c06-0ba5-3e90-ae6e-3b282df0c2e6",
                                        "entry_id": "643e6b28-ec64-3f57-8db2-4a18b3238bae",
                                        "glosses": [
                                            "Farm animals; animals domesticated for cultivation."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9c0dba18-b4cc-4285-b06f-3d63db57dd33",
                                                "sense_id": "b35d9c06-0ba5-3e90-ae6e-3b282df0c2e6",
                                                "text": "The livestock were poisoned by what they grazed on."
                                            },
                                            {
                                                "example_id": "962f56d8-8f22-4ce5-bbac-d99b0b5fff89",
                                                "sense_id": "b35d9c06-0ba5-3e90-ae6e-3b282df0c2e6",
                                                "text": "Livestock is bought and sold at an auction market."
                                            },
                                            {
                                                "example_id": "3a5fd7aa-8841-48dc-a51b-db829e08bd61",
                                                "sense_id": "b35d9c06-0ba5-3e90-ae6e-3b282df0c2e6",
                                                "text": "Much livestock was slaughtered due to high feed prices."
                                            },
                                            {
                                                "example_id": "85ff9944-e53a-42bf-839c-2820fcaf2033",
                                                "sense_id": "b35d9c06-0ba5-3e90-ae6e-3b282df0c2e6",
                                                "text": "In the West there are local areas with too many livestock."
                                            },
                                            {
                                                "example_id": "61184b9b-64be-448b-8567-b212b66bd95d",
                                                "sense_id": "b35d9c06-0ba5-3e90-ae6e-3b282df0c2e6",
                                                "text": "Women herded small livestocks such as goats and sheep."
                                            },
                                            {
                                                "example_id": "4dedb8d4-3a39-4353-ae84-d2c5b177d0db",
                                                "sense_id": "b35d9c06-0ba5-3e90-ae6e-3b282df0c2e6",
                                                "text": "These spearings were not related to livestock killed but to young boys trying to prove their bravery."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dda4864c-06de-477d-bebf-a52e24bf15a5",
                        "source_entry_id": "1281fd4f-1416-332a-b614-79e538bf05d4",
                        "source_sense_id": "526536c9-31fe-36a5-8c24-667c8798f931",
                        "target_lang_word": "cheptel",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cheptel",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a1bc6aab-3993-3e1f-8120-81e10709b2d9",
                                        "entry_id": "34043532-3fd1-3a9b-8f38-72bad2eca06d",
                                        "glosses": [
                                            "Ensemble des troupeaux, hardes, du bétail d’une propriété rurale, d’un pays."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b7635764-eee1-46f7-8716-af0787a4d8ba",
                                                "sense_id": "a1bc6aab-3993-3e1f-8120-81e10709b2d9",
                                                "text": "En Inde, le traitement du cheptel au diclofénac est dévastateur pour les vautours."
                                            },
                                            {
                                                "example_id": "279d1ac0-3d36-4358-8100-3012db8cfec8",
                                                "sense_id": "a1bc6aab-3993-3e1f-8120-81e10709b2d9",
                                                "text": "Sur les 45 vêlages annuels, il garde une quinzaine de velles, « les meilleures » pour assurer le renouvellement du cheptel."
                                            },
                                            {
                                                "example_id": "fa77030b-ab4b-4bb1-8eb6-d6d6321d0c93",
                                                "sense_id": "a1bc6aab-3993-3e1f-8120-81e10709b2d9",
                                                "text": "Bien qu'il soit impossible de faire un inventaire aérien précis et simultané à l'échelle provinciale, on estime qu'il y a environ 240,000 chevreuils dans la forêt québécoise, et ce, sans compter le cheptel d'Anticosti."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "39dda9f7-7a68-3e49-8a18-921563ebc110",
                                        "entry_id": "34043532-3fd1-3a9b-8f38-72bad2eca06d",
                                        "glosses": [
                                            "Groupe humain."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a0f894a9-9dcb-4574-a8da-c9cf4583cf3d",
                                                "sense_id": "39dda9f7-7a68-3e49-8a18-921563ebc110",
                                                "text": "L'U.R.S.S. est assez prolifique pour permettre sans qu'il y paraisse des coupes sombres parmi le cheptel humain."
                                            },
                                            {
                                                "example_id": "fa2a251d-1187-42aa-a6ac-cc7661989b59",
                                                "sense_id": "39dda9f7-7a68-3e49-8a18-921563ebc110",
                                                "text": "Jusqu'en 1929, date à laquelle la dernière caravane d'esclaves traversa le désert pour se rendre en Libye, le réseau transsaharien servit de principal moyen d'acheminement des esclaves du Soudan vers le Maghreb. Mais on ne peut évaluer sérieusement ce cheptel humain qu'à partir du XIXe siècle, époque où l'on commença à disposer de chiffres fiables sur ce trafic."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d62cdea8-d2b3-3398-9906-2169d61e6348",
                                        "entry_id": "34043532-3fd1-3a9b-8f38-72bad2eca06d",
                                        "glosses": [
                                            "Bail de bétail, ou contrat par lequel l’une des parties donne à l’autre des bestiaux pour les garder, les nourrir et les soigner, sous les conditions convenues entre elles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c757f2b3-0976-4d33-b46e-88bf44248f58",
                                                "sense_id": "d62cdea8-d2b3-3398-9906-2169d61e6348",
                                                "text": "Bail à cheptel. Cheptel simple. Cheptel à moitié. Donner des bestiaux à cheptel. L’expiration du cheptel."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
