                "senses": [
                    {
                        "sense_id": "213fb867-6552-37ab-b1aa-d4d49d58a5c9",
                        "entry_id": "d7297b87-3ae2-38e2-b0d4-88ac37b06436",
                        "glosses": [
                            "Gruppe von Personen, die mit einer bestimmten Handlung (Information, Werbung…) erreicht werden soll"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c8206b84-0186-46e2-83ee-501eff1dc8c7",
                                "sense_id": "213fb867-6552-37ab-b1aa-d4d49d58a5c9",
                                "text": "Die Zielgruppe von Werbung sind meistens die bis zu 49 Jahre alten Personen."
                            },
                            {
                                "example_id": "8c8ccacd-cc17-422f-a382-b5fd97940cb3",
                                "sense_id": "213fb867-6552-37ab-b1aa-d4d49d58a5c9",
                                "text": "„Die krisengeplagte Tourismusbranche in den Alpen braucht nicht nur jeden zahlenden Gast, sondern hat gerade abenteuerlustige Bergsportler als lohnende Zielgruppe wiederentdeckt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
