                                "target_senses": [
                                    {
                                        "sense_id": "6f5748ce-d2e9-3fa5-96ad-8ba80e971f96",
                                        "entry_id": "972dcefe-4622-34f7-8341-d1e5976893ed",
                                        "glosses": [
                                            "con riferimento al fato, è colui che in un istante concentra parecchi elementi provvidenziali e/o di previsione"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9aaf12b3-918a-37fc-ae38-a601f0842682",
                                        "entry_id": "972dcefe-4622-34f7-8341-d1e5976893ed",
                                        "glosses": [
                                            "chi ritiene che ogni cosa che è già accaduta non potesse avvenire in altro modo, negando così la libertà di scelta dell'essere umano"
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d572b516-99c7-4af5-aa6c-8592214a4733",
                                                "sense_id": "9aaf12b3-918a-37fc-ae38-a601f0842682",
                                                "text": "è un fatalista: non riesce a credere nella punizione né nel merito"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0c8be4b8-ed24-4bf7-a6ba-e7df3dd48ae9",
                        "source_entry_id": "fb0b9940-6c76-3dbd-8803-bb00d384771f",
                        "target_lang_word": "фаталист",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "фаталист",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "1b62712a-72e6-35ef-9921-a323ebb7ac53",
                                        "entry_id": "4072c0bf-4a28-3289-a8f6-cc6eb557ba3b",
                                        "glosses": [
                                            "человек, верящий в неотвратимость судьбы, предопределение"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a540b124-1227-4b54-9601-cd078924590c",
                                                "sense_id": "1b62712a-72e6-35ef-9921-a323ebb7ac53",
                                                "text": "А может, нет в этом никакого лукавства, ведь Лев Александрович — фаталист и считает вполне применимым к себе старое правило: делай что должно и пусть будет что будет."
                                            },
                                            {
                                                "example_id": "18b9a97c-67b0-4974-90d4-0893c7a57cdb",
                                                "sense_id": "1b62712a-72e6-35ef-9921-a323ebb7ac53",
                                                "text": "А я, неисправимый фаталист, процитирую великую мудрость, провозглашенную Кораном: «Всё будет так, как должно быть, даже если будет наоборот!»"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
