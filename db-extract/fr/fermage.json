                ],
                "senses": [
                    {
                        "sense_id": "bcc24ea2-3f2a-3010-8964-460ed1577977",
                        "entry_id": "622fd1d5-4366-3f87-85bb-48045e39f5df",
                        "glosses": [
                            "Mode d’exploitation agricole louant un domaine rural à un fermier qui cultive les terres en échange d’une rente payable en argent et invariable pour toute la durée du bail."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "6a2ded41-6069-3c5d-8ac9-cb75a0a283d4",
                        "entry_id": "622fd1d5-4366-3f87-85bb-48045e39f5df",
                        "glosses": [
                            "Redevance convenue pour un bail à ferme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "28fc3af0-ecee-4867-ba9b-e9d57f567aa7",
                                "sense_id": "6a2ded41-6069-3c5d-8ac9-cb75a0a283d4",
                                "text": "Le 3 avril 1567, par exemple, ces gazons sont laissés, pour une durée de neuf années et moyennant un fermage de 30 livres, à deux habitants de Clefcy, qui pourront y nourrir soixante-six vaches, trois chevaux et deux poulains."
                            },
                            {
                                "example_id": "62deda2d-488a-46dd-8845-f7acc689754c",
                                "sense_id": "6a2ded41-6069-3c5d-8ac9-cb75a0a283d4",
                                "text": "Il me doit beaucoup de fermages."
                            },
                            {
                                "example_id": "a99ddcf2-0b86-4ed0-9b3d-b79a8cd6c5e0",
                                "sense_id": "6a2ded41-6069-3c5d-8ac9-cb75a0a283d4",
                                "text": "À l’époque où s’accomplit la révolution sociale en Écosse, grand nombre de vassaux furent chassés, qui ne pouvaient payer de gros fermages aux anciens chefs de clans."
                            }
                        ]
                    }
                ],
