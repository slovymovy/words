                    {
                        "translation_id": "19af313f-3a41-4db3-8a36-aba73815b54d",
                        "source_entry_id": "fe404baf-f2fc-3231-8d48-acbda3efae47",
                        "source_sense_description": "having an increased state of activity",
                        "target_lang_word": "hyperactif",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hyperactif",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cb95b7b7-5a2a-3b5c-b32f-22062677aa40",
                                        "entry_id": "96df603e-d052-3f8b-9275-61b69d98135d",
                                        "glosses": [
                                            "Qui est très actif, qui agit beaucoup, qui travaille beaucoup (en parlant des personnes ou des groupes de personnes)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "09f82c4d-6d82-4888-ba6f-ec330d0a1a79",
                                                "sense_id": "cb95b7b7-5a2a-3b5c-b32f-22062677aa40",
                                                "text": "Nous sommes des transitionnistes hyperactifs. Le « Virtuosa » fonctionne au fuel mais ce n’est pas le même qu’avant. Il est équipé de pots catalytiques qui transforment 97 % des oxydes d’azote."
                                            },
                                            {
                                                "example_id": "676f495f-ea62-474a-b64e-ffc6982b01d8",
                                                "sense_id": "cb95b7b7-5a2a-3b5c-b32f-22062677aa40",
                                                "text": "Il estime que le syndicat Alliance a été « hyperactif » et « a fait évoluer le projet »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "73998ed3-2b95-3750-81dd-96a2aae4b732",
                                        "entry_id": "96df603e-d052-3f8b-9275-61b69d98135d",
                                        "glosses": [
                                            "Qui est très actif (en parlant des choses)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d1319d0f-74b6-4a71-8a64-4446cd3674a5",
                                                "sense_id": "73998ed3-2b95-3750-81dd-96a2aae4b732",
                                                "text": "Un médicament, un traitement hyperactif, une réaction hyperactive."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b6b4226a-9869-39eb-9373-788b4286750f",
                                        "entry_id": "96df603e-d052-3f8b-9275-61b69d98135d",
                                        "glosses": [
                                            "Qui manifeste de l’hyperactivité."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "hyperactif",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "19e35dd5-d706-3c8b-8c33-32661edcf335",
                                        "entry_id": "a7c0cf8d-d22f-320d-8912-5c49c3135b5a",
                                        "glosses": [
                                            "Personne qui est très active, qui agit beaucoup, qui travaille beaucoup."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8bc17389-b943-4b5f-b88c-b42272eefb74",
                                                "sense_id": "19e35dd5-d706-3c8b-8c33-32661edcf335",
                                                "text": "Cet hyperactif, grand brasseur d'affaires, se donne à fond à sa société."
                                            },
                                            {
                                                "example_id": "fde3f9fd-ad0e-4eb1-b038-3170e8c1408d",
                                                "sense_id": "19e35dd5-d706-3c8b-8c33-32661edcf335",
                                                "text": "Ce père est un hyperactif dont les multiples activités l’éloigneront de sa fille, qui se sentira toujours délaissée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fcc7b7e6-553b-3bbf-87e0-ed0f1329f5cc",
                                        "entry_id": "a7c0cf8d-d22f-320d-8912-5c49c3135b5a",
                                        "glosses": [
                                            "Personne manifestant de l’hyperactivité."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "41aebcb8-3f6c-4dfa-ae04-190c52fc7e08",
                        "source_entry_id": "fe404baf-f2fc-3231-8d48-acbda3efae47",
                        "source_sense_description": "having an increased state of activity",
                        "target_lang_word": "überaktiv",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "überaktiv",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5a955567-0cff-3e52-9475-94e0a7edb2c1",
                                        "entry_id": "3a2326f4-fffd-3f86-9845-2e1a55d8ac2b",
                                        "glosses": [
                                            "übermäßig aktiv seiend; einen starken Drang zur Tätigkeit habend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "05d96807-3c3d-4c61-9674-8220ce990692",
                                                "sense_id": "5a955567-0cff-3e52-9475-94e0a7edb2c1",
                                                "text": "„Ich konnte Kinder im Prinzip nicht ertragen, vor allem dann nicht, wenn sie so lebendig und überaktiv waren.“"
                                            },
                                            {
                                                "example_id": "ae9ed7c8-802c-4ef6-81d0-077511546eae",
                                                "sense_id": "5a955567-0cff-3e52-9475-94e0a7edb2c1",
                                                "text": "„Geh den Leuten, die dir sagen, du seist überaktiv und solltest mal ein bisschen langsamer machen, freundlich aus dem Weg.“"
                                            },
                                            {
                                                "example_id": "2108000e-3e47-4b06-b853-6917fb90b2af",
                                                "sense_id": "5a955567-0cff-3e52-9475-94e0a7edb2c1",
                                                "text": "„Das Immunsystem im Verdauungstrakt reagiert bei den chronischentzündlichen Darmerkrankungen überaktiv.“"
                                            },
                                            {
                                                "example_id": "22c6569d-fbf6-4fbc-bbff-794dbb0fb55d",
                                                "sense_id": "5a955567-0cff-3e52-9475-94e0a7edb2c1",
                                                "text": "„Gelegentlich kommt es zu Muskelreaktionen, um Schaden vom Körper abzuwenden oder Schmerzen zu vermindern, mit dem Ergebnis, dass bestimmte Muskelgruppen überaktiv sind, während andere gehemmt werden.“"
                                            },
                                            {
                                                "example_id": "8a8ed50c-f6d8-4b31-96ec-338bb9aa2223",
                                                "sense_id": "5a955567-0cff-3e52-9475-94e0a7edb2c1",
                                                "text": "„Traumatisierte Menschen sind unmittelbar nach dem Trauma entweder passiv und niedergeschlagen oder sie werden hektisch und überaktiv.“"
                                            },
                                            {
                                                "example_id": "e4727e08-7b2a-4945-8fe0-71b53976728f",
                                                "sense_id": "5a955567-0cff-3e52-9475-94e0a7edb2c1",
                                                "text": "„Zu einem so differenzierten Sozialverhalten sind überaktive Hunde oft nicht fähig.“"
                                            },
                                            {
                                                "example_id": "76ac7568-f39b-40a9-a1c7-3e0b022c9884",
                                                "sense_id": "5a955567-0cff-3e52-9475-94e0a7edb2c1",
                                                "text": "„Die überaktive Blase kennzeichnet sich durch einen vermehrten Harndrang.“"
                                            },
                                            {
                                                "example_id": "a696ad88-5b20-4e7d-b4cb-4ec07a24fd41",
                                                "sense_id": "5a955567-0cff-3e52-9475-94e0a7edb2c1",
                                                "text": "„Die Impulse pflanzen sich bis zur Milz fort, einem Organ im Oberbauch, in dem B- und T-Zellen vermehrt werden, und regeln so das überaktive Immunsystem herunter.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cf1a5770-e066-4808-a526-f4d57b881e48",
                        "source_entry_id": "fe404baf-f2fc-3231-8d48-acbda3efae47",
                        "source_sense_description": "having an increased state of activity",
                        "target_lang_word": "hyperaktiv",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hyperaktiv",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0af911f5-524b-3e5b-8928-bbf7c68ff2c4",
                                        "entry_id": "315516a7-1d03-37ee-823b-db9ac0041a7e",
                                        "glosses": [
                                            "übermäßig aktiv seiend; einen starken Drang zur Bewegung habend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f5cbfd44-9375-4025-9e47-ef161ac554b0",
                                                "sense_id": "0af911f5-524b-3e5b-8928-bbf7c68ff2c4",
                                                "text": "„Ich bin nun wirklich kein hyperaktiver Mensch, doch gönne ich mir nur selten Phasen der Entspannung.“"
                                            },
                                            {
                                                "example_id": "599aaad0-a818-4f6d-bfc6-7872ee251360",
                                                "sense_id": "0af911f5-524b-3e5b-8928-bbf7c68ff2c4",
                                                "text": "„Mein Vater ist einfach ein hyperaktiver Mensch, er schläft nachts nur dreieinhalb Stunden, daher kann er ein enormes Arbeitspensum absolvieren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b124bf97-8e33-34c3-a6ac-2896c9b77755",
                                        "entry_id": "315516a7-1d03-37ee-823b-db9ac0041a7e",
                                        "glosses": [
                                            "an der Krankheit Hyperaktivität leidend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15844912-47f6-4fa9-84e6-c8070d9f18e0",
                                                "sense_id": "b124bf97-8e33-34c3-a6ac-2896c9b77755",
                                                "text": "„Die Bundesregierung will den Missbrauch mit dem Medikament Ritalin eindämmen, das zur Behandlung so genannter hyperaktiver Kinder eingesetzt wird.“"
                                            },
                                            {
                                                "example_id": "e241c353-4e50-46aa-8d7e-3b0527fa0bbb",
                                                "sense_id": "b124bf97-8e33-34c3-a6ac-2896c9b77755",
                                                "text": "„Eine große Langzeitstudie zeigt, dass viele hyperaktive Kinder im Erwachsenenalter mit schweren Folgen kämpfen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
