                "senses": [
                    {
                        "sense_id": "5c8dcd84-5f0b-3247-845c-ff36c83b15e0",
                        "entry_id": "3c680d71-85a6-3f00-bb6e-e6fd7daad3e7",
                        "glosses": [
                            "To rejoice; to be very happy, especially in triumph; to triumph (over)."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "4dd46d90-06ec-415b-919c-45d130c3c930",
                                "sense_id": "5c8dcd84-5f0b-3247-845c-ff36c83b15e0",
                                "text": "I took a deep breath; a locomotive howled across-the darkness, Mobile-bound. So were we. I took off my shirt and exulted."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7efd1604-a077-4256-aff1-ec317fe14cbc",
                        "source_entry_id": "3c680d71-85a6-3f00-bb6e-e6fd7daad3e7",
                        "source_sense_id": "5c8dcd84-5f0b-3247-845c-ff36c83b15e0",
                        "source_sense_description": "rejoice",
                        "target_lang_word": "jásat",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jásat",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "e0a37881-1907-3651-bd33-491bdeb2ba3e",
                                        "entry_id": "2e8bfd62-176a-38d8-82b7-72bdf7ba033c",
                                        "glosses": [
                                            "bouřlivě se radovat, být velmi veselý, vyzařovat triumf"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "97fccb99-cfb6-4774-ab0c-6d8fed0cf63e",
                                                "sense_id": "e0a37881-1907-3651-bd33-491bdeb2ba3e",
                                                "text": "Po obou stranách té role stáli v řadách dvořané a služebníci, jásali radostí a obdivovali císaře."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f92debec-7fd3-4537-99e1-e726b8d81354",
                        "source_entry_id": "3c680d71-85a6-3f00-bb6e-e6fd7daad3e7",
                        "source_sense_id": "5c8dcd84-5f0b-3247-845c-ff36c83b15e0",
                        "source_sense_description": "rejoice",
                        "target_lang_word": "jubelen",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jubelen",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "f4229872-1b72-39e0-b49e-424d3d44b97f",
                                        "entry_id": "4e62e7a3-f28c-340b-82d5-f3fecceef97d",
                                        "glosses": [
                                            "juichen"
                                        ],
                                        "tags": [
                                            "unergative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0cbf71c6-c12e-43bb-9f67-5027fdbab4ea",
                                                "sense_id": "f4229872-1b72-39e0-b49e-424d3d44b97f",
                                                "text": "Het hele publiek jubelde voor de spelers."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "20ec556d-f030-4104-bf48-2e4320803751",
                        "source_entry_id": "3c680d71-85a6-3f00-bb6e-e6fd7daad3e7",
                        "source_sense_id": "5c8dcd84-5f0b-3247-845c-ff36c83b15e0",
                        "source_sense_description": "rejoice",
                        "target_lang_word": "exulter",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "exulter",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "837d2dde-9168-3bd3-99ae-df2034ee7c0a",
                                        "entry_id": "242f0c46-3b2b-34fe-8405-e49ab74df29e",
                                        "glosses": [
                                            "Se réjouir extrêmement ; éprouver une grande joie dont on donne des signes manifestes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1c54023-f205-4956-b0c3-a6d01dbef162",
                                                "sense_id": "837d2dde-9168-3bd3-99ae-df2034ee7c0a",
                                                "text": "Autour de nous tout exulte : les libellules étincellent, les abeilles s’enfoncent au cœur des roses penchées, les soucis tendent leurs rondelles d’or et les branches fécondes des pommiers se courbent, appesanties dans la chaleur."
                                            },
                                            {
                                                "example_id": "637ccb7e-dfb9-4b90-b226-a7e3e99cf84f",
                                                "sense_id": "837d2dde-9168-3bd3-99ae-df2034ee7c0a",
                                                "text": "[…], et le bellâtre à tête plus ou moins simiesque, bovine, équine, porcine, corvidée ou batracienne, — toute la lyre esthétique ! — exulte devant son miroir, se tient pour la copie la plus parfaite de l’Antinoüs, et se fait a lui-même les yeux doux."
                                            },
                                            {
                                                "example_id": "26746284-a225-493f-be43-fa34a6ffe0d6",
                                                "sense_id": "837d2dde-9168-3bd3-99ae-df2034ee7c0a",
                                                "text": "Jean-Louis exultait, s'exaltait au point de convergence de ses tendresses essentielles : son naturisme et son christianisme."
                                            },
                                            {
                                                "example_id": "090cfb72-62c2-40be-b9e6-584e4b986d65",
                                                "sense_id": "837d2dde-9168-3bd3-99ae-df2034ee7c0a",
                                                "text": "Le gars venait de passer 15 ans en prison pour le meurtre de sa conjointe, il avait un lourd passé de violence envers les femmes...\n Et on l’a laissé voir des prostituées ?\n Sous prétexte qu’il faut bien « que le corps exulte », comme chantait Brel ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4522d725-07c8-4706-9d7a-87fb34be13e9",
                        "source_entry_id": "3c680d71-85a6-3f00-bb6e-e6fd7daad3e7",
                        "source_sense_id": "5c8dcd84-5f0b-3247-845c-ff36c83b15e0",
                        "source_sense_description": "rejoice",
                        "target_lang_word": "jubeln",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jubeln",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "11d1175f-4f07-31e9-b0f0-b5cabbc429ab",
                                        "entry_id": "bdae9f0c-43d3-36ee-908b-bfd983a54372",
                                        "glosses": [
                                            "lautstark Freude ausdrücken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "24824135-d3db-4271-9cd6-9b0136e731cf",
                                                "sense_id": "11d1175f-4f07-31e9-b0f0-b5cabbc429ab",
                                                "text": "„Die rund 45.000 Zuschauer jubelten dem 90-jährigen ehemaligen Präsidenten Südafrikas bei seiner Rede zu […].“"
                                            },
                                            {
                                                "example_id": "7c86be0c-4e93-4dfc-aca1-a1a06ba42cd4",
                                                "sense_id": "11d1175f-4f07-31e9-b0f0-b5cabbc429ab",
                                                "text": "„‚Ich habe aus Respekt für Polen nicht gejubelt‘, sagte der zweimalige Torschütze (20. und 72. Minute) später, der bei all den Emotionen beinahe den Pokal für den „besten Spieler der Partie“ im Stadion hatte stehen lassen.“"
                                            },
                                            {
                                                "example_id": "13e628f3-bfc1-4b38-b37e-397ec9736a5e",
                                                "sense_id": "11d1175f-4f07-31e9-b0f0-b5cabbc429ab",
                                                "text": "„Rafaela Silva sank auf die Knie, und ein ganzes Land jubelte mit ihr: Brasiliens Star-Judoka hat ihre Mission mit Bravour erfüllt. ‚Möge die Medaille den Kindern in der 'Cidade de Deus' als Ansporn dienen. […]‘“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "62a83786-f739-4893-8778-0113ecc198c7",
                        "source_entry_id": "3c680d71-85a6-3f00-bb6e-e6fd7daad3e7",
