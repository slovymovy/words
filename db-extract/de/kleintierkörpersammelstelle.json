                "senses": [
                    {
                        "sense_id": "4d954892-7ff5-3e2f-b5e3-27edc1cf1485",
                        "entry_id": "1c7d0818-021d-38cd-813f-407f21b182fd",
                        "glosses": [
                            "Ort, Stelle, Gebäude, an beziehungsweise in dem verendete, tote Tiere oder Teile davon eingesammelt und gemeinschaftlich entsorgt, verwertet werden"
                        ],
                        "tags": [
                            "Fachsprachlich"
                        ],
                        "examples": [
                            {
                                "example_id": "0b4d5b91-025b-45a2-b9e6-ef28423b0b57",
                                "sense_id": "4d954892-7ff5-3e2f-b5e3-27edc1cf1485",
                                "text": "„Die Kleintierkörpersammelstelle wird ab 2. Mai auf dem Betriebsgelände Westst. 11 des Amtes für Stadtreinigung und Abfallwirtschaft ihren neuen Standort haben.“"
                            },
                            {
                                "example_id": "1435773b-af1e-411e-8e9e-4d9aada3b5e4",
                                "sense_id": "4d954892-7ff5-3e2f-b5e3-27edc1cf1485",
                                "text": "„Nach dem Neubau ist die Kleintierkörpersammelstelle an der Kläranlage Nürtingen wieder geöffnet.“"
                            },
                            {
                                "example_id": "e8406368-6242-4bb6-8c64-40668913ec95",
                                "sense_id": "4d954892-7ff5-3e2f-b5e3-27edc1cf1485",
                                "text": "„Verstorbene Haustiere (zum Beispiel Hunde, Katzen, Heimtiere und Vögel) werden in der Kleintierkörpersammelstelle im städtischen Tierheim angenommen.“"
                            },
                            {
                                "example_id": "34586690-a003-4c76-a2f4-84fb9699a7bc",
                                "sense_id": "4d954892-7ff5-3e2f-b5e3-27edc1cf1485",
                                "text": "„Die Gebühren, die an den Kleintierkörpersammelstellen erhoben werden, müssen aufgrund neuer betriebswirtschaftlicher Daten der Tierkörperbeseitigungsanstalt differenziert werden, um die Stadtgemeinde Bremen nicht zusätzlich zu belasten.“"
                            },
                            {
                                "example_id": "cacefb58-b8ab-417b-86aa-b848ed07e933",
                                "sense_id": "4d954892-7ff5-3e2f-b5e3-27edc1cf1485",
                                "text": "„Die Verantwortung und Betreuung der Kleintierkörpersammelstelle in der Stadt gehört ebenso wie die Besetzung eines Rettungswagens und das Reservefahrzeugmanagement zum Alltag der Feuerwehrmänner.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
