                "translations": [
                    {
                        "translation_id": "64ca2ea8-748c-48e3-89d2-035f4073f81b",
                        "source_entry_id": "95d05e5d-874d-3077-a006-43abb9c58d88",
                        "source_sense_id": "6c3070fb-9be6-3692-b301-76de03b5f195",
                        "source_sense_description": "Stadt in der pakistanischen Provinz Punjab",
                        "target_lang_word": "Jhang",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Jhang",
