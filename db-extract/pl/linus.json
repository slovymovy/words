                                "example_id": "99502c7d-cac7-4446-98b0-5be04066daa0",
                                "sense_id": "924452fc-2155-3443-b710-f931cc0d9193",
                                "text": "Czasy, kiedy Linus obejmował rządy w Kościele Chrystusa, były niełatwe."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
