                        "translation_id": "fc4db835-5034-4c7b-b2bd-4aa35cd1a0a3",
                        "source_entry_id": "61e8f9a5-e8a2-3ea4-99d7-956c60e34bd6",
                        "source_sense_id": "ff062b82-5237-387d-b9b4-522900f126d0",
