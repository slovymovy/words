                                "sense_id": "da90f161-915b-34e1-a84c-f43bd209eda4",
                                "text": "Douché, habillé, scooterisé, j’étais à Bordagain en moins de deux."
                            }
                        ]
                    },
                    {
                        "sense_id": "f24b05a8-5149-3a83-89c1-cf6a8abd2d55",
                        "entry_id": "fb862edf-b083-33bc-bf8f-9c174f6ec36d",
                        "glosses": [
                            "Utiliser un scooter."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c55e3bcb-b55a-4e84-8469-4e604c2640cc",
                                "sense_id": "f24b05a8-5149-3a83-89c1-cf6a8abd2d55",
                                "text": "Le mieux est d'y monter en marchant, mais pour les plus pressés, il est aussi possible de \"scooteriser\"."
                            },
                            {
                                "example_id": "e2786215-f402-4a09-8721-6ec1c66a05bd",
                                "sense_id": "f24b05a8-5149-3a83-89c1-cf6a8abd2d55",
                                "text": "A force de scooteriser à qui mieux-mieux … je redécouvre le plaisir de voyager en voiture."
                            }
                        ]
                    }
