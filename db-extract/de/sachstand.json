                "senses": [
                    {
                        "sense_id": "1c84ec15-cfa1-3619-80d6-c4d6b920d623",
                        "entry_id": "3802506b-bb88-3df3-84d4-d81954ba9c51",
                        "glosses": [
                            "aktuelle Lage der Dinge"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "29a74b9d-5e97-4782-8a05-a1697b159496",
                                "sense_id": "1c84ec15-cfa1-3619-80d6-c4d6b920d623",
                                "text": "„Themen sind der aktuelle Sachstand, der Status des Bürgerbegehrens und die Frage, weshalb die Angelegenheit ganz Freising betrifft.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5670fb63-3fbb-4538-8566-8a741c37d008",
                        "source_entry_id": "3802506b-bb88-3df3-84d4-d81954ba9c51",
                        "source_sense_id": "1c84ec15-cfa1-3619-80d6-c4d6b920d623",
                        "source_sense_description": "aktuelle Lage der Dinge",
                        "target_lang_word": "état des lieux",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "état des lieux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "31504c17-6762-3cf4-84f7-300e3d1e8f0a",
                                        "entry_id": "2bef3c85-a175-32da-8201-d54f0c297ff4",
                                        "glosses": [
                                            "Inventaire des meubles et immeubles d’un lieu."
                                        ],
                                        "tags": [
                                            "literally"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f66f170a-a488-312f-bce8-5894d3d79592",
                                        "entry_id": "2bef3c85-a175-32da-8201-d54f0c297ff4",
                                        "glosses": [
                                            "Relevé contradictoire, entre locataire et propriétaire, de l’état d'un immeuble loué."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ddd89626-a44e-3650-9efd-b413a884e2b6",
                                        "entry_id": "2bef3c85-a175-32da-8201-d54f0c297ff4",
                                        "glosses": [
                                            "Inventaire, relevé."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "10ace5e3-43d6-465e-b554-8e1b067bced2",
                                                "sense_id": "ddd89626-a44e-3650-9efd-b413a884e2b6",
                                                "text": "Herbaut, 42 ans, traque l’oubli partout, sans cesse. Souvent posées, toujours intranquilles, ses images dressent un état des lieux térébrant, une fois le pire advenu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e1b77da-370d-322e-96db-80e9ba11aa51",
                                        "entry_id": "2bef3c85-a175-32da-8201-d54f0c297ff4",
                                        "glosses": [
                                            "Description d’une situation donnant lieu éventuellement à une comparaison avec un cahier des charges."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e15dbfe8-6b23-4290-8da5-4e39e283be50",
                                                "sense_id": "1e1b77da-370d-322e-96db-80e9ba11aa51",
                                                "text": "Il y a quelques jours, sortait le 6ᵉ observatoire des réseaux d’initiative publique, devenu l’observatoire du très haut débit. Exit la focalisation sur les réseaux d’initiative publique, qui doivent couvrir les 43 % de population délaissées par les opérateurs nationaux. Bonjour à un état des lieux plus global, qui va de l’investissement à la « tension » sur la fibre optique, en passant par les perspectives à l’étranger."
                                            },
                                            {
                                                "example_id": "c2d4f136-7d58-4126-9c11-e5468cebb137",
                                                "sense_id": "1e1b77da-370d-322e-96db-80e9ba11aa51",
                                                "text": "Chaque réunion était structurée avec le même ordre du jour : état des lieux de l’avancée des travaux et des projets, audition d’expert ou d’institution, discussion et perspectives."
                                            },
                                            {
                                                "example_id": "e5d083df-73a0-4fdb-9122-610b8ceef142",
                                                "sense_id": "1e1b77da-370d-322e-96db-80e9ba11aa51",
                                                "text": "Le ministre de l’Éducation, Jean-François Roberge, se défend d’avoir été négligent. Dès le 29 juin, il a demandé un état des lieux aux centres de services, il leur a rappelé leurs devoirs en septembre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6446f058-86f5-32a2-b137-fb4a3a74e11b",
                                        "entry_id": "2bef3c85-a175-32da-8201-d54f0c297ff4",
                                        "glosses": [
                                            "Constatation d’une situation à un moment donné."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ad945b40-8883-4db0-9452-62bb0b154f0c",
                                                "sense_id": "6446f058-86f5-32a2-b137-fb4a3a74e11b",
                                                "text": "Si l’état des lieux du commerce et de la consommation mondiale se maintient, le monde passera sous domination économique, technologique et militaire chinoise."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
