                        "entry_id": "2a6645c2-e2d8-394f-bf01-22209ce3b855",
                        "glosses": [
                            "Ce remède lui-même."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "4f3d5f9f-3aa0-48e0-9717-1861626d630e",
                                "sense_id": "39012657-7664-30c6-83f2-a6a09436715d",
                                "text": "De plus, il paraîtrait logique, puisqu’on étudie un anthelmintique, de le faire agir sur un ver intestinal et de déterminer sur celui-ci les variations de la chronaxie."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d92ae506-9e20-4aa6-990e-8345e8eb166e",
                        "source_entry_id": "2a6645c2-e2d8-394f-bf01-22209ce3b855",
                        "source_sense_id": "39012657-7664-30c6-83f2-a6a09436715d",
