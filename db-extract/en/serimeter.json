                        "glosses": [
                            "A device used for testing the strength of thread or yarn, especially of silk."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "82cc4f4b-3640-4512-bf23-88bfcda6695c",
                                "sense_id": "7b28d034-e4e7-3ca9-bda7-894dff47ddff",
                                "text": "The elasticity and the tenacity of raw silk are determined by the use of the serimeter."
                            },
                            {
                                "example_id": "a60ac881-0854-4e48-98e2-d43f8308671a",
                                "sense_id": "7b28d034-e4e7-3ca9-bda7-894dff47ddff",
                                "text": "The serimeters (Fig. 7) are of both the Henry Baer and Milan Conditioning House type and are mounted in a laboratory having humidity control."
                            },
                            {
                                "example_id": "9b5d6dad-6111-492c-8f17-16746a1fb2a6",
                                "sense_id": "7b28d034-e4e7-3ca9-bda7-894dff47ddff",
                                "text": "A serimeter is a machine used for breaking yarn in order to determine its strength and elongation."
                            }
