                    "sense_id": "c9964a6b-1667-351f-b0a0-d521d941bc8f",
                    "sense_definition": "Not occurring at a regular interval; not often.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "frequency",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We <w>rarely</w> go to the theatre.",
                            "target_lang_translations": {
                                "ru": "Мы <w>редко</w> ходим в театр.",
                                "zh": "我们<w>很少</w>去剧院。",
                                "nl": "Wij gaan <w>zelden</w> naar het theater.",
                                "pl": "My <w>rzadko</w> chodzimy do teatru.",
                                "de": "Wir gehen <w>selten</w> ins Theater.",
                                "fr": "Nous allons <w>rarement</w> au théâtre.",
                                "it": "Andiamo <w>raramente</w> a teatro.",
                                "cs": "Do divadla chodíme <w>zřídka</w>.",
                                "tr": "Tiyatroya <w>nadiren</w> gideriz.",
                                "es": "Nosotros <w>rara vez</w> vamos al teatro."
                            }
                        },
                        {
                            "text": "<w>Rarely</w> do you ever find an eagle this far up the river.",
                            "target_lang_translations": {
                                "ru": "<w>Редко</w> встретишь орла так далеко вверх по реке.",
                                "zh": "你<w>很少</w>能在河流上游这么远的地方见到老鹰。",
                                "nl": "<w>Zelden</w> vind je een adelaar zo ver stroomopwaarts in de rivier.",
                                "pl": "<w>Rzadko</w> można spotkać orła tak daleko w górę rzeki.",
                                "de": "<w>Selten</w> findet man einen Adler so weit oben am Fluss.",
                                "fr": "<w>Rarement</w> on trouve un aigle aussi loin en amont de la rivière.",
                                "it": "<w>Di rado</w> si trova un'aquila così lontano lungo il fiume.",
                                "cs": "<w>Málokdy</w> najdete orla tak vysoko proti proudu řeky.",
                                "tr": "Nehrin bu kadar yukarısında bir kartala <w>nadiren</w> rastlarsınız.",
                                "es": "<w>Raramente</w> encuentras un águila tan arriba en el río."
                            }
                        }
                    ],
                    "synonyms": [
                        "seldom",
                        "infrequently",
                        "uncommonly",
                        "sporadically",
                        "once in a while",
                        "hardly ever",
                        "not often"
