                    {
                        "sense_id": "57583bde-b183-305a-9f59-40f744f9c5ff",
                        "entry_id": "5709e5b8-bd02-3bc8-97c7-e0c5215866d8",
                        "glosses": [
                            "dat wat in een (rang)ordening met 63 is aangeduid"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "41629c4f-cff5-4812-b2e5-4af1bd8b257a",
                                "sense_id": "57583bde-b183-305a-9f59-40f744f9c5ff",
                                "text": "Het is weer de drieënzestig die het niet doet, kunnen we die niet simpel vervangen?"
                            },
                            {
                                "example_id": "b1a5a6d0-ed3d-47fc-ae04-d3b8b9f1a34d",
                                "sense_id": "57583bde-b183-305a-9f59-40f744f9c5ff",
                                "text": "Haar vierenzestigste verjaardag was een belangrijk moment, want haar leven werd heel anders toen ze de drieënzestig eenmaal voorbij was."
                            }
                        ]
                    },
                    {
                        "sense_id": "5202d2e6-83c4-3f71-b1cc-1270a0e0ed3b",
                        "entry_id": "5709e5b8-bd02-3bc8-97c7-e0c5215866d8",
                        "glosses": [
                            "groep van 63 eenheden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "31ac76be-a0d7-483f-9f21-c8749df48200",
                                "sense_id": "5202d2e6-83c4-3f71-b1cc-1270a0e0ed3b",
                                "text": "De drieënzestig zijn natuurlijk blij, maar laten we ook denken aan het verdriet van de vier die zijn afgewezen."
                            }
                        ]
                    }
                ],
