                        "entry_id": "944fdd79-b3b2-3459-bd41-ea3e7124e1ab",
                        "glosses": [
                            "Maßeinheit der Datenmenge, 1 Gibibyte = 1024 Mebibyte = 2³⁰ Byte = 1 073 741 824 Byte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5cafc700-8a10-4c6d-9b70-ec4c771c62c3",
                                "sense_id": "5022963c-0f3e-3abd-b54c-242d402d6155",
                                "text": "Ein Gibibyte umfasst 7,4 % mehr Bits als ein Gigabyte."
                            },
                            {
                                "example_id": "ebb02c2e-fbd2-439c-a320-8a06e2838be8",
                                "sense_id": "5022963c-0f3e-3abd-b54c-242d402d6155",
                                "text": "Festplatten werden oft mit ihrer Kapazität in Gigabyte beworben, denn eine 500-Gigabyte-Festplatte lässt sich besser verkaufen als eine 465-Gibibyte-Festplatte."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
