                                        "sense_id": "0dc772b9-7644-3b2e-96b7-d86e2cb3bd4a",
                                        "entry_id": "b0e237dd-dd1f-39dd-8389-46193fc4b511",
                                        "glosses": [
                                            "gebied in het oosten van Rusland (in Azië). Het beslaat ongeveer 59% van het totale grondgebied van Rusland en ongeveer 23% van geheel Azië"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bbb78960-58c0-4abb-b2ea-f2b629715816",
                                                "sense_id": "0dc772b9-7644-3b2e-96b7-d86e2cb3bd4a",
                                                "text": "Toen Aleksandr Solzjenitsyn zijn \"Goelag Archipel\" schreef, had hij het over een geografisch eilandenrijk van werkkampen in de moerassen van Siberië"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9d0f4b93-d431-4272-984b-5d6b5fdbaed3",
                        "source_entry_id": "4aec328a-9174-35c5-affa-b7303222ed91",
                        "source_sense_id": "7792d68a-9953-3248-a6b4-c01119c250c1",
                        "source_sense_description": "region of Russia",
                        "target_lang_word": "Sibérie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sibérie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a22c5fc8-1ca0-363c-90db-bb1e3fef0608",
                                        "entry_id": "01c80011-d33a-3ece-a4f3-a69bf0c98734",
                                        "glosses": [
                                            "Immense région de la fédération de Russie, qui s’étend de l’Oural à l’océan Pacifique et jusqu'à l’océan Arctique au nord."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd702adf-f17f-4c58-b075-99394e60e922",
                                                "sense_id": "a22c5fc8-1ca0-363c-90db-bb1e3fef0608",
                                                "text": "On pouvait alors déterminer la marche des races dites rouges. Parti des steppes mongoles, un courant humain déferlait en Sibérie, gagnait l’Alaska, envahissait peu à peu l’Amérique du Nord."
                                            },
                                            {
                                                "example_id": "12249273-75f1-4fb0-8f8c-6ea23592c094",
                                                "sense_id": "a22c5fc8-1ca0-363c-90db-bb1e3fef0608",
                                                "text": "À nous deux nous avions vu l’Égypte, la Syrie, l’Espagne, la Russie, la Hollande, l’Allemagne, l’Italie, la Dalmatie, l’Angleterre, la Chine, la Tatarie et la Sibérie. Il ne nous manquait que d’être allé dans les Indes et en Amérique !"
                                            },
                                            {
                                                "example_id": "25dfe701-0d07-4088-bdcd-6d5ef0a73f61",
                                                "sense_id": "a22c5fc8-1ca0-363c-90db-bb1e3fef0608",
                                                "text": "Après avoir gravi pendant deux heures, nous atteignons vers midi le plateau terminal, du haut duquel on domine un paysage effroyable. Un océan de neige! C’est la Sibérie au cœur de l’hiver."
                                            },
                                            {
                                                "example_id": "9dc3e7b7-4c79-4e07-9e74-2b83311ac78e",
                                                "sense_id": "a22c5fc8-1ca0-363c-90db-bb1e3fef0608",
                                                "text": "À présent voici les bazars avec les mille produits de la Perse, de la Chine, de la Turquie, de la Sibérie, de la Mongolie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0dc64484-e7f9-364b-ab85-ffb6a535e95d",
                                        "entry_id": "01c80011-d33a-3ece-a4f3-a69bf0c98734",
                                        "glosses": [
                                            "Endroit où il fait particulièrement froid."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "hyperbole"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7692812b-83fb-444f-9eb5-3b94f0234458",
                                                "sense_id": "0dc64484-e7f9-364b-ab85-ffb6a535e95d",
                                                "text": "Le commissaire, se levant. —-— Ce feu ne va pas ! C’est une Sibérie, ici !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cc0d4292-8102-419a-8b4c-6743a130eb34",
                        "source_entry_id": "4aec328a-9174-35c5-affa-b7303222ed91",
                        "source_sense_id": "7792d68a-9953-3248-a6b4-c01119c250c1",
                        "source_sense_description": "region of Russia",
                        "target_lang_word": "Sibirien",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sibirien",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "67b2f4d4-778b-321e-a705-4c24e8a51a2a",
                                        "entry_id": "e0d53cad-0d01-34c9-8434-0e6ef3f45116",
                                        "glosses": [
                                            "der Großteil des asiatischen Teils von Russland"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71f03bc1-3722-43e9-addf-492601eef707",
                                                "sense_id": "67b2f4d4-778b-321e-a705-4c24e8a51a2a",
                                                "text": "In Sibirien sind die Winter kalt."
                                            },
                                            {
                                                "example_id": "30ce10c2-070e-4abf-b869-2972b5612595",
                                                "sense_id": "67b2f4d4-778b-321e-a705-4c24e8a51a2a",
                                                "text": "„Die erste Durchquerung Sibiriens durch die Kosaken erfolgte seinerzeit relativ weit im Norden.“"
                                            },
                                            {
                                                "example_id": "6b329e3f-1680-41b4-b4a5-de38bf9e6fd6",
                                                "sense_id": "67b2f4d4-778b-321e-a705-4c24e8a51a2a",
                                                "text": "„Für viele wird Sibirien zum Synonym der Trennung von den verbliebenen Angehörigen, meist der Mutter oder den Geschwistern.“"
                                            },
                                            {
                                                "example_id": "e49c81d5-fca0-43bc-acc4-00d271e58637",
                                                "sense_id": "67b2f4d4-778b-321e-a705-4c24e8a51a2a",
                                                "text": "„Ihnen folgte vor circa 31000 Jahren eine zweite Gruppe, die im nördlichen Sibirien gesiedelt hatte'.“"
                                            },
                                            {
                                                "example_id": "ed8a3507-a9b2-4279-ba46-b3fec6815daf",
                                                "sense_id": "67b2f4d4-778b-321e-a705-4c24e8a51a2a",
                                                "text": "„Vermutlich hat sie das Lager überlebt, denn sie berichtet vom Schicksal mehrerer Deportierter aus Kukehnen, darunter Kutscher Großmann, der in Sibirien verstorben sei.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
