                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "dc4a5a38-66ec-4342-bcdb-9d43012309ae",
                                "sense_id": "eb70aaca-1fab-3279-b7ef-8427c91fd06a",
                                "text": "I must now let you know what sort of a personage this same First President is; you imagine that he is a disagreeable snuffy old fellow"
                            },
                            {
                                "example_id": "32d76d47-ab38-49a8-bb4f-f6832ea055f6",
                                "sense_id": "eb70aaca-1fab-3279-b7ef-8427c91fd06a",
                                "text": "The postchaise contained a snuffy old dowager of seventy, with a maid, her contemporary."
                            }
                        ]
                    },
                    {
                        "sense_id": "941e9aa8-a77d-3e6b-ab61-944d4559a89b",
                        "entry_id": "aac0378e-6795-3700-a156-f592476c3786",
                        "glosses": [
                            "Drunk."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "76662b82-b994-4a04-a6aa-9e9506446089",
                                "sense_id": "941e9aa8-a77d-3e6b-ab61-944d4559a89b",
                                "text": "She could fight, too, when I got snuffy. […] Once I come home from elk camp so drunk I couldn't hardly sit my horse, and Sylvie near to kilt me, she fought me so hard."
                            }
                        ]
                    },
                    {
                        "sense_id": "cf313ae0-e9e9-319f-b7ad-ad4775626898",
                        "entry_id": "aac0378e-6795-3700-a156-f592476c3786",
                        "glosses": [
                            "That causes sniffing and nasal irritation due to dust."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "00bdb039-7cc2-4058-9e26-233f3748f4dc",
                                "sense_id": "cf313ae0-e9e9-319f-b7ad-ad4775626898",
                                "text": "Giving that up, she took a broom and a duster and went upstairs to housemaid Mrs Dibble's bedroom, with her head tied up in a coloured scarf. It was a dusty, snuffy job, for penuriousness in Mrs Dibble refused to throw anything away, including dirt, and if anything fell on the floor it remained there."
                            }
                        ]
