                                        "entry_id": "64ee3042-ec85-3145-8a80-34bb8ca4176b",
                                        "glosses": [
                                            "The emission of light (or other electromagnetic radiation) by a material when stimulated by the absorption of radiation or of a subatomic particle."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9c1b1d87-ca34-44a5-9d6d-3e3f0f9843f4",
                                                "sense_id": "c4d7ef82-7d6e-3162-9427-2e5742b465d9",
                                                "text": "A multi-institution US research team has combined some creative chemistry, fluorescence microscopy and laser-driven microballistics to gain a clearer view of just what happens in a high-strain-rate impact, and to tease out the relative contribution of different kinds of energy dissipation within the target (Nat. Commun., doi: 10.1038/s41467-024-52663-1)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cc025b5f-ce1d-3b55-8541-d4d4d6adf79a",
                                        "entry_id": "64ee3042-ec85-3145-8a80-34bb8ca4176b",
                                        "glosses": [
                                            "The light so emitted."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
