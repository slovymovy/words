                                "sense_id": "523de119-0903-3c6e-b7a2-bffe6d0c3d92",
                                "text": "Le papillon de nuit (hétérocère) suivant se nourrit de brachypode :",
                                "translation": "soyeuse, Rivula sericealis (Noctuidae)."
                            },
                            {
                                "example_id": "4156356d-96d7-4464-876a-f031a0220213",
                                "sense_id": "523de119-0903-3c6e-b7a2-bffe6d0c3d92",
                                "text": "Le papillon de jour (rhopalocère) suivant se nourrit de brachypode :",
                                "translation": "échiquier de l’Occitanie, Melanargia occitanica (Nymphalidae)."
                            }
                        ]
