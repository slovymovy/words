{
    "word_family": [
        "conclude",
        "conclusive",
        "conclusively",
        "inconclusive"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a89bb15d-3a2c-3823-87c0-883769a7c99b",
                    "sense_definition": "A decision or judgment reached after careful thought and consideration.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "decision_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After analyzing all the evidence, the jury came to a <w>conclusion</w>.",
                            "target_lang_translations": {
                                "ru": "Проанализировав все улики, присяжные пришли к <w>заключению</w>.",
                                "zh": "在分析了所有证据后，陪审团得出了<w>结论</w>。"
                            }
                        },
                        {
                            "text": "It is a foregone <w>conclusion</w> that the team will win the championship.",
                            "target_lang_translations": {
                                "ru": "То, что команда выиграет чемпионат, — это предрешённый <w>исход</w>.",
                                "zh": "这支队伍赢得冠军已是板上钉钉的<w>定论</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "come to a conclusion",
                        "jump to conclusions",
                        "draw a conclusion",
                        "foregone conclusion"
                    ],
                    "target_lang_definitions": {
                        "ru": "Решение или суждение, принятое после тщательного обдумывания и анализа фактов.",
                        "zh": "经过仔细思考和考虑后得出的决定或判断。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вывод",
                                "target_lang_sense_clarification": "логическое умозаключение"
                            },
                            {
                                "target_lang_word": "заключение",
                                "target_lang_sense_clarification": "официальное решение или мнение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "结论",
                                "target_lang_sense_clarification": "逻辑推论或判断"
                            },
                            {
                                "target_lang_word": "定论",
                                "target_lang_sense_clarification": "最终的判断"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "09b6865d-2421-3055-ad70-3d3d9a5fa292",
                    "sense_definition": "The end, finish, or last part of an event, speech, or piece of writing.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "end_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In <w>conclusion</w>, I would like to thank everyone for their hard work.",
                            "target_lang_translations": {
                                "ru": "В <w>заключение</w> я хотел бы поблагодарить всех за усердную работу.",
                                "zh": "在<w>结尾</w>处，我想感谢大家的辛勤工作。"
                            }
                        },
                        {
                            "text": "The audience applauded loudly at the <w>conclusion</w> of the concert.",
                            "target_lang_translations": {
                                "ru": "Зрители громко аплодировали по <w>окончании</w> концерта.",
                                "zh": "音乐会<w>结束</w>时，观众们热烈鼓掌。"
                            }
                        }
                    ],
                    "synonyms": [
                        "finish",
                        "endpoint",
                        "terminus",
                        "epilogue"
                    ],
                    "antonyms": [
                        "beginning",
                        "start",
                        "initiation"
                    ],
                    "common_phrases": [
                        "in conclusion",
                        "at the conclusion of",
                        "bring to a conclusion"
                    ],
                    "target_lang_definitions": {
                        "ru": "Конец, завершение или последняя часть события, выступления или текста.",
                        "zh": "事件、演讲或文章的结尾、终点或最后部分。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заключение",
                                "target_lang_sense_clarification": "речи, текста"
                            },
                            {
                                "target_lang_word": "окончание",
                                "target_lang_sense_clarification": "события, действия"
                            },
                            {
                                "target_lang_word": "завершение",
                                "target_lang_sense_clarification": "процесса"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "结尾",
                                "target_lang_sense_clarification": "文章或演讲的末尾"
                            },
                            {
                                "target_lang_word": "结束",
                                "target_lang_sense_clarification": "事件或过程的终结"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7f9efc76-87ae-30e3-bc7b-4f0dffabecc6",
                    "sense_definition": "The outcome, result, or consequence of a process or action.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "outcome_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The natural <w>conclusion</w> of his reckless spending was bankruptcy.",
                            "target_lang_translations": {
                                "ru": "Закономерным <w>результатом</w> его безрассудных трат стало банкротство.",
                                "zh": "他挥霍无度的自然<w>结果</w>就是破产。"
                            }
                        },
                        {
                            "text": "We are waiting to see the <w>conclusion</w> of the ongoing investigation.",
                            "target_lang_translations": {
                                "ru": "Мы ждём <w>завершения</w> текущего расследования.",
                                "zh": "我们正在等待当前调查的<w>结局</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "logical conclusion"
                    ],
                    "target_lang_definitions": {
                        "ru": "Итог, результат или последствие какого-либо процесса или действия.",
                        "zh": "过程或行动的结果、产物或后果。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "результат",
                                "target_lang_sense_clarification": "следствие действия"
                            },
                            {
                                "target_lang_word": "исход",
                                "target_lang_sense_clarification": "финальный результат, развязка"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "结果",
                                "target_lang_sense_clarification": "行动产生的后果"
                            },
                            {
                                "target_lang_word": "结局",
                                "target_lang_sense_clarification": "最终的境况或下场"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fb9b56fd-407a-3319-87d7-8dd8458f837d",
                    "sense_definition": "The formal finalization or settlement of an official agreement or treaty.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "end_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>conclusion</w> of the peace treaty brought stability to the region.",
                            "target_lang_translations": {
                                "ru": "<w>Заключение</w> мирного договора принесло стабильность в регион.",
                                "zh": "<w>缔结</w>和平条约给该地区带来了稳定。"
                            }
                        },
                        {
                            "text": "Negotiators are working hard towards the successful <w>conclusion</w> of the trade deal.",
                            "target_lang_translations": {
                                "ru": "Переговорщики усердно работают над успешным <w>заключением</w> торговой сделки.",
                                "zh": "谈判代表们正努力促成贸易协议的成功<w>达成</w>。"
                            }
                        }
                    ],
                    "antonyms": [
                        "initiation"
                    ],
                    "common_phrases": [
                        "successful conclusion"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официальное оформление, подписание или достижение соглашения или договора.",
                        "zh": "正式完成或达成一项官方协议或条约。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заключение",
                                "target_lang_sense_clarification": "договора, сделки"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "缔结",
                                "target_lang_sense_clarification": "正式签订条约或协议"
                            },
                            {
                                "target_lang_word": "达成",
                                "target_lang_sense_clarification": "协议的最终完成"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "529f0919-1098-3fb7-b28f-c6c3c892be74",
                    "sense_definition": "A proposition in logic that follows necessarily from the given premises.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "logic_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "If the premises of the argument are true, then the <w>conclusion</w> must also be true.",
                            "target_lang_translations": {
                                "ru": "Если предпосылки аргумента истинны, то и <w>вывод</w> должен быть истинным.",
                                "zh": "如果论证的前提为真，那么<w>结论</w>也必然为真。"
                            }
                        },
                        {
                            "text": "He accepted the minor premise but rejected the <w>conclusion</w>.",
                            "target_lang_translations": {
                                "ru": "Он принял малую посылку, но отверг <w>вывод</w>.",
                                "zh": "他接受了小前提，但拒绝了该<w>推论</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "logic"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Логическое суждение, которое с необходимостью следует из данных предпосылок.",
                        "zh": "逻辑学中从给定前提必然推导出的命题。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вывод",
                                "target_lang_sense_clarification": "логическое следствие"
                            },
                            {
                                "target_lang_word": "умозаключение",
                                "target_lang_sense_clarification": "логический термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "结论",
                                "target_lang_sense_clarification": "逻辑推论"
                            },
                            {
                                "target_lang_word": "推论",
                                "target_lang_sense_clarification": "逻辑上的推导结果"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}