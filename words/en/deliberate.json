{
    "word_family": [
        "deliberation",
        "deliberately",
        "deliberative"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "0a0d7575-111c-3580-b04f-5ceb9e6e7f5b",
                    "sense_definition": "Done on purpose; intentional.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "intentional",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It was a <w>deliberate</w> attempt to hide the truth from the public.",
                            "target_lang_translations": {
                                "ru": "Это была <w>преднамеренная</w> попытка скрыть правду от общественности.",
                                "nl": "Het was een <w>opzettelijke</w> poging om de waarheid voor het publiek te verbergen."
                            }
                        },
                        {
                            "text": "She made a <w>deliberate</w> choice to ignore the warning signs.",
                            "target_lang_translations": {
                                "ru": "Она сделала <w>осознанный</w> выбор игнорировать предупреждающие знаки.",
                                "nl": "Ze maakte een <w>bewuste</w> keuze om de waarschuwingssignalen te negeren."
                            }
                        }
                    ],
                    "synonyms": [
                        "intentional",
                        "purposeful",
                        "voluntary",
                        "wilful",
                        "conscious"
                    ],
                    "antonyms": [
                        "unintentional",
                        "unwitting"
                    ],
                    "common_phrases": [
                        "deliberate attempt",
                        "deliberate act",
                        "deliberate choice",
                        "deliberate mistake"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сделанный специально, с определенной целью; намеренный.",
                        "nl": "Iets wat bewust en met een specifiek doel is gedaan; niet per ongeluk."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "преднамеренный",
                                "target_lang_sense_clarification": "сделанный с заранее обдуманным намерением"
                            },
                            {
                                "target_lang_word": "умышленный",
                                "target_lang_sense_clarification": "совершённый с умыслом (часто о проступках)"
                            },
                            {
                                "target_lang_word": "намеренный",
                                "target_lang_sense_clarification": "сделанный сознательно, не случайно"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "opzettelijk",
                                "target_lang_sense_clarification": "bewust en met een bedoeling gedaan"
                            },
                            {
                                "target_lang_word": "bewust",
                                "target_lang_sense_clarification": "met volledige kennis van zaken en intentie"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6726ddf5-de61-3cce-89ef-f822cdf2fd94",
                    "sense_definition": "Not hasty or sudden; slow and steady in movement or speech.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "slow_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He walked with <w>deliberate</w> steps across the quiet room.",
                            "target_lang_translations": {
                                "ru": "Он шёл через тихую комнату <w>размеренными</w> шагами.",
                                "nl": "Hij liep met <w>bedaarde</w> stappen door de stille kamer."
                            }
                        },
                        {
                            "text": "Her speech was slow and <w>deliberate</w> to ensure everyone understood.",
                            "target_lang_translations": {
                                "ru": "Её речь была медленной и <w>размеренной</w>, чтобы все её поняли.",
                                "nl": "Haar spraak was langzaam en <w>beheerst</w> om ervoor te zorgen dat iedereen het begreep."
                            }
                        }
                    ],
                    "synonyms": [
                        "slow",
                        "careful",
                        "unhurried"
                    ],
                    "common_phrases": [
                        "deliberate pace",
                        "deliberate movements",
                        "deliberate steps"
                    ],
                    "target_lang_definitions": {
                        "ru": "Неторопливый, осторожный и ровный (о движениях или речи).",
                        "nl": "Niet gehaast of plotseling; rustig en beheerst in beweging of spraak."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "размеренный",
                                "target_lang_sense_clarification": "ритмичный, спокойный и неторопливый"
                            },
                            {
                                "target_lang_word": "неспешный",
                                "target_lang_sense_clarification": "медленный, совершаемый без суеты"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "bedaard",
                                "target_lang_sense_clarification": "rustig en kalm in gedrag of beweging"
                            },
                            {
                                "target_lang_word": "beheerst",
                                "target_lang_sense_clarification": "gecontroleerd en niet gehaast"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ca3c0f87-94a9-3ebd-9ca4-d1e0c5c41307",
                    "sense_definition": "Formed with careful consideration; not sudden or rash.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "careful_thought",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We need a <w>deliberate</w> plan to solve this complex problem.",
                            "target_lang_translations": {
                                "ru": "Нам нужен <w>продуманный</w> план для решения этой сложной проблемы.",
                                "nl": "We hebben een <w>doordacht</w> plan nodig om dit complexe probleem op te lossen."
                            }
                        },
                        {
                            "text": "The committee adopted a <w>deliberate</w> approach to the negotiations.",
                            "target_lang_translations": {
                                "ru": "Комитет выбрал <w>взвешенный</w> подход к переговорам.",
                                "nl": "De commissie hanteerde een <w>weloverwogen</w> aanpak bij de onderhandelingen."
                            }
                        }
                    ],
                    "synonyms": [
                        "careful",
                        "thoughtful",
                        "cautious",
                        "circumspect",
                        "prudent"
                    ],
                    "common_phrases": [
                        "deliberate policy",
                        "deliberate strategy",
                        "deliberate approach"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сформированный после тщательного рассмотрения; не поспешный.",
                        "nl": "Vormgegeven na zorgvuldige afweging; niet overhaast of onbezonnen."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обдуманный",
                                "target_lang_sense_clarification": "основанный на предварительном размышлении"
                            },
                            {
                                "target_lang_word": "взвешенный",
                                "target_lang_sense_clarification": "хорошо продуманный, с учётом всех обстоятельств"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "doordacht",
                                "target_lang_sense_clarification": "waarbij goed is nagedacht over de gevolgen"
                            },
                            {
                                "target_lang_word": "weloverwogen",
                                "target_lang_sense_clarification": "na rijp beraad en afweging van voor- en nadelen"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5db343be-8e43-3710-b639-9bb31440ad7c",
                    "sense_definition": "To consider carefully; to weigh well in the mind.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "thinking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The jury will <w>deliberate</w> for several hours before reaching a verdict.",
                            "target_lang_translations": {
                                "ru": "Присяжные будут <w>совещаться</w> несколько часов перед вынесением вердикта.",
                                "nl": "De jury zal enkele uren <w>beraadslagen</w> voordat ze tot een uitspraak komen."
                            }
                        },
                        {
                            "text": "We need time to <w>deliberate</w> on the proposal before voting.",
                            "target_lang_translations": {
                                "ru": "Нам нужно время, чтобы <w>обдумать</w> предложение перед голосованием.",
                                "nl": "We hebben tijd nodig om het voorstel te <w>overwegen</w> voordat we stemmen."
                            }
                        }
                    ],
                    "synonyms": [
                        "consider",
                        "ponder",
                        "reflect",
                        "think"
                    ],
                    "common_phrases": [
                        "deliberate on",
                        "deliberate over",
                        "jury deliberates"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тщательно взвешивать в уме или обсуждать перед принятием решения.",
                        "nl": "Zorgvuldig overwegen of bespreken voordat een besluit wordt genomen."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обдумывать",
                                "target_lang_sense_clarification": "всесторонне рассматривать в мыслях"
                            },
                            {
                                "target_lang_word": "совещаться",
                                "target_lang_sense_clarification": "обсуждать сообща (например, присяжные)"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "overwegen",
                                "target_lang_sense_clarification": "de voor- en nadelen tegen elkaar afwegen"
                            },
                            {
                                "target_lang_word": "beraadslagen",
                                "target_lang_sense_clarification": "gezamenlijk overleggen over een besluit"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}