                ],
                "senses": [
                    {
                        "sense_id": "9fb9f220-ce87-313c-af4b-efc582e1c214",
                        "entry_id": "81f16bac-d234-355d-872d-be18466f099b",
                        "glosses": [
                            "ein Soldat, der innerhalb der Hierarchie seiner Armee mehr oder weniger gut funktioniert, im zivilen Leben jedoch nicht zurechtkommt und der dort keine beruflichen Chancen hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "376c879c-a939-4213-a040-687807bd47f3",
                                "sense_id": "9fb9f220-ce87-313c-af4b-efc582e1c214",
                                "text": "Der Obergefreite Müller ist ein totaler Zivilversager."
                            },
                            {
                                "example_id": "86b323ca-53ba-4f31-ac1b-27386f44d30c",
                                "sense_id": "9fb9f220-ce87-313c-af4b-efc582e1c214",
                                "text": "Du bist und bleibst ein Zivilversager, sonst wärst du nicht hier."
                            },
                            {
                                "example_id": "b2aafc16-b09b-4495-852b-862e1ddf6a29",
                                "sense_id": "9fb9f220-ce87-313c-af4b-efc582e1c214",
                                "text": "Du hast Glück, dass du den Job beim Bund hast, außerhalb würde dich niemand einstellen, du Zivilversager!"
                            },
                            {
                                "example_id": "313127ca-79aa-4d23-a85b-df3a91d6d119",
                                "sense_id": "9fb9f220-ce87-313c-af4b-efc582e1c214",
                                "text": "„Der deutsche Soldat – nach damals noch gängiger Interpretation des Grundgesetzes beschränkt auf das Sandkastenspiel im heimischen Militärsperrbezirk – galt eher als Zivilversager denn als heldenhaftes Idol.“"
                            },
                            {
                                "example_id": "06db87fb-a2e2-4486-916d-b01540eaed7b",
                                "sense_id": "9fb9f220-ce87-313c-af4b-efc582e1c214",
                                "text": "„Der Unterschied zwischen Künstlern und Militärdienern ist nicht so viel anders. Meistens sind beide Zivilversager.“"
                            },
                            {
                                "example_id": "b42ce20a-e836-47d7-b5e4-7202aae535bb",
                                "sense_id": "9fb9f220-ce87-313c-af4b-efc582e1c214",
                                "text": "„Was willst du denn als Zivilversager weiter in diesem Scheißladen abhängen? Du solltest studieren, Mann, fertig.“"
                            },
                            {
                                "example_id": "d037feb5-f3cb-453c-b07f-75a3410ca121",
                                "sense_id": "9fb9f220-ce87-313c-af4b-efc582e1c214",
                                "text": "„Was soll’s? Jede Armee dieser Welt ist Zufluchtsort für den einen oder anderen Zivilversager …“"
                            },
                            {
                                "example_id": "6d66076d-a8aa-4f08-9e7f-6453dd95f470",
                                "sense_id": "9fb9f220-ce87-313c-af4b-efc582e1c214",
                                "text": "„Die Bundeswehr will kein Auffangbecken für Gescheiterte sein. Wir nennen sie auch \"Zivilversager\".“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
