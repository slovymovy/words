                                        "sense_id": "15b2d4ef-4f9e-3ee0-85d2-5c3ae6ba8cdf",
                                        "entry_id": "3c1d5119-1b7f-31c6-866e-a991eac75f2e",
                                        "glosses": [
                                            "größeres Gefäß für Flüssigkeiten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e315f8b-6dff-4b27-8bf4-0414a405c318",
                                                "sense_id": "15b2d4ef-4f9e-3ee0-85d2-5c3ae6ba8cdf",
                                                "text": "In diese Kanne passen 1,8 Liter."
                                            },
                                            {
                                                "example_id": "3a285f67-ff00-44f0-8adf-c10ce7100f58",
                                                "sense_id": "15b2d4ef-4f9e-3ee0-85d2-5c3ae6ba8cdf",
                                                "text": "„Lenzfreude holte nun die Kanne hervor und brachte sie nach den hinteren Räumen.“"
                                            },
                                            {
                                                "example_id": "706056a1-237a-484c-bba4-e6cd520088ae",
                                                "sense_id": "15b2d4ef-4f9e-3ee0-85d2-5c3ae6ba8cdf",
                                                "text": "„Der Kaffee war in einer Kanne und der Zucker daneben.“"
                                            },
                                            {
                                                "example_id": "8263fa93-6791-4cad-9edf-3868e352bf6e",
                                                "sense_id": "15b2d4ef-4f9e-3ee0-85d2-5c3ae6ba8cdf",
                                                "text": "„Ich starrte die Kanne in der Kaffeemaschine an.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "35291e8a-fec6-48cb-8077-d44a7b62d05f",
                        "source_entry_id": "abd38aad-8bfe-3e2b-ad34-5df305ab715a",
                        "source_sense_id": "8edcbff6-3b94-330e-8565-45aeabe06c5e",
                        "target_lang_word": "Trinkgefäß",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Trinkgefäß",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bdf426ba-e216-3f74-a9e6-c3d63fae23d0",
                                        "entry_id": "76abd2a2-4bb1-3a17-ac87-8ee3b2d2c5c4",
                                        "glosses": [
                                            "Behältnis (typischerweise mit Stiel oder Henkel), aus dem man trinkt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3beba4ae-7e50-4ac3-bcf2-003363124554",
                                                "sense_id": "bdf426ba-e216-3f74-a9e6-c3d63fae23d0",
                                                "text": "Für unsere große Grillparty werden wir uns bei einem Geschirrverleih die Trinkgefäße und Teller besorgen."
                                            },
                                            {
                                                "example_id": "7d3cf67d-23ca-418d-8512-131722f7562d",
                                                "sense_id": "bdf426ba-e216-3f74-a9e6-c3d63fae23d0",
                                                "text": "„Eine Gesellschaft, die nur noch mit der Limodose in der Hand durch die Straßen schlurft, die den Pappbecher als Trinkgefäß akzeptiert und die Mikrowelle für Fortschritt hält – diese manipulierte Masse hat auf dem Weg in die Globalisierung ihre Geschmackskriterien längst aufgegeben.“"
                                            },
                                            {
                                                "example_id": "5bbf9606-4fb0-4112-91b1-c60d425a0265",
                                                "sense_id": "bdf426ba-e216-3f74-a9e6-c3d63fae23d0",
                                                "text": "„Die Schädel besiegter Feinde pflegten die Kelten in Mauernischen oder auf Holzpfählen zur Schau zu stellen oder als Trinkgefäße zu nutzen.“"
                                            },
                                            {
                                                "example_id": "f96fd5dc-60f0-4cff-a490-dbfa130dc518",
                                                "sense_id": "bdf426ba-e216-3f74-a9e6-c3d63fae23d0",
                                                "text": "„Hier in Südafrika verwendeten die einheimischen Khoisan die großen Eierschalen der Strauße als Trinkgefäße sowie in kleinen, geschliffenen Stücken als Schmuck für einfache Armbänder und Halsketten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
