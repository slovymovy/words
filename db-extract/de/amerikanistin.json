                ],
                "senses": [
                    {
                        "sense_id": "29d7217d-641b-32af-8f93-b1a8d5b41c05",
                        "entry_id": "5b08362f-b05e-391a-82f7-12e2861b8a19",
                        "glosses": [
                            "Wissenschaftlerin auf dem Gebiet der Amerikanistik"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "46b34af5-1651-473a-948e-e516296f085b",
                                "sense_id": "29d7217d-641b-32af-8f93-b1a8d5b41c05",
                                "text": "Eine Bekannte von mir ein Amerikanistin."
                            },
                            {
                                "example_id": "18555382-ae05-43b8-8719-dcc046aa9546",
                                "sense_id": "29d7217d-641b-32af-8f93-b1a8d5b41c05",
                                "text": "„Nicht zufällig ist sie promovierte Amerikanistin und hat bei Gastaufenthalten schätzen gelernt, dass die meisten amerikanischen Unis ‚writing labs‘ oder ‚writing centers‘ haben.“"
                            },
                            {
                                "example_id": "b62c7eee-8e0b-4b8d-8995-398eb7bd8cbf",
                                "sense_id": "29d7217d-641b-32af-8f93-b1a8d5b41c05",
                                "text": "„‚Viele benutzen diese Wörter, um sich ein kosmopolitisches Flair zu geben‘, sagt die Germanistin und Amerikanistin Ulrike Wagner aus New York.“"
                            },
                            {
                                "example_id": "9b9db8e3-ad9f-4f02-9ed6-331e1bf872d1",
                                "sense_id": "29d7217d-641b-32af-8f93-b1a8d5b41c05",
                                "text": "„Auch die Journalistin und Amerikanistin Eva C. Schweitzer nimmt sich des Trump-Komplexes an. Sie geht der Frage nach, wie seine Politik die transatlantischen Beziehungen beeinträchtigt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
