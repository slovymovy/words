                                    {
                                        "sense_id": "c32a489f-ad1a-3774-b2bd-951c6ec507e6",
                                        "entry_id": "ed9078fc-29d0-338a-ba20-fa0655ba057c",
                                        "glosses": [
                                            "Sport de lutte japonais, consistant à faire sortir l’adversaire hors d’un cercle marquant la zone de lutte ou à le faire tomber."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dac0b11b-b0cc-34db-af7d-ee5aade290fe",
                                        "entry_id": "ed9078fc-29d0-338a-ba20-fa0655ba057c",
                                        "glosses": [
                                            "Sumotori."
