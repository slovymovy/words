                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lupus",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "71d6949a-19d0-3315-843d-df8e4bee981c",
                                        "entry_id": "32c56d7d-2afd-333a-ad71-edb221077436",
                                        "glosses": [
                                            "Any of a number of autoimmune diseases, the most common of which is systemic lupus erythematosus."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3ac47ff4-11e2-4a5f-ac96-c772312b6f4a",
                                                "sense_id": "71d6949a-19d0-3315-843d-df8e4bee981c",
                                                "text": "You like the name quesalupa? That is a little like \"case of lupus\". I just keep thinking about that."
                                            },
                                            {
                                                "example_id": "76b58eb3-ba2d-45d0-ad0f-3b88775d444c",
                                                "sense_id": "71d6949a-19d0-3315-843d-df8e4bee981c",
                                                "text": "Iberdomide, a cereblon modulator promoting degradation of the transcription factors Ikaros and Aiolos, which affect leukocyte development and autoimmunity, is being evaluated for the treatment of systemic lupus erythematosus (SLE)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b2f255fa-e687-4735-91a0-1f2d26fa778f",
                        "source_entry_id": "80e67a63-1688-3195-b3b4-aad2e2ce872d",
                        "source_sense_id": "37454462-a661-342d-8661-055943f2ce76",
                        "source_sense_description": "Autoimmunerkrankung der Haut",
                        "target_lang_word": "lupus",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lupus",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ec8c3f13-e493-354e-b5b9-d5b4390a173a",
                                        "entry_id": "36e940f0-f5ae-33a2-941d-3a7eb6dd0046",
                                        "glosses": [
                                            "Lupus érythémateux (maladie auto-immune)."
                                        ],
                                        "tags": [
                                            "Nosologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c05b5593-e9de-4899-8778-6f2c760f7ffb",
                                                "sense_id": "ec8c3f13-e493-354e-b5b9-d5b4390a173a",
                                                "text": "En 2001, une équipe du CNRS découvre qu’un peptide (un fragment de protéine) pourrait soigner le lupus, pathologie frappant le système immunitaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b34a6142-03d1-3069-8305-44e639f653f9",
                                        "entry_id": "36e940f0-f5ae-33a2-941d-3a7eb6dd0046",
                                        "glosses": [
                                            "Lupus vulgaris (Ulcère tuberculeux)"
                                        ],
                                        "tags": [
                                            "Nosologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a666e455-d51d-4982-b3aa-2880d0527529",
                                                "sense_id": "b34a6142-03d1-3069-8305-44e639f653f9",
                                                "text": "Le lupus peut être considéré comme une tuberculose primitive, et par suite différer de la tuberculose secondaire de la peau."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
