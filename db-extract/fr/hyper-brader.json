                ],
                "senses": [
                    {
                        "sense_id": "22f5445e-3539-3855-9862-6943a18e2aa6",
                        "entry_id": "918b0707-e48c-30f2-ba67-38c4ac92d19f",
                        "glosses": [
                            "Brader à un prix extrêmement faible."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b66e71d0-0fef-4ea7-a231-fdd6251642b3",
                                "sense_id": "22f5445e-3539-3855-9862-6943a18e2aa6",
                                "text": "Alors voilà, tous vos comics à vendre qui n'ont quasiment plus de valeur marchande réelle, pourquoi ne pas les hyper-brader, les proposer aux échanges directs entre lecteurs, quitte même à faire des échanges pas très égaux en quantités ou valeur, l'important c'est de se débarrasser de numéros que nous ne pouvons de toutes manières pas vendre plus que quelques menus euros, et en retour de récupérer deux trois trucs sympas qui nous intéressent, sans rien débourser."
                            },
                            {
                                "example_id": "556afe65-a851-4e94-9eab-e6c2cdff7280",
                                "sense_id": "22f5445e-3539-3855-9862-6943a18e2aa6",
                                "text": "Il n'a pas tort... mais faut pas se baser sur Gameiro qui a été hyper bradé."
                            }
                        ]
                    }
