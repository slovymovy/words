                "senses": [
                    {
                        "sense_id": "2814852a-f090-3aba-9ffd-bace8c2a75e9",
                        "entry_id": "a62cde0f-9438-3b29-9ffe-600be2e3dea2",
                        "glosses": [
                            "een gebonden morfeem dat aan een ander morfeem wordt vastgehecht om zo een nieuw woord te vormen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52cf98c2-59ce-4aa8-a2b6-067ea97a3dee",
                                "sense_id": "2814852a-f090-3aba-9ffd-bace8c2a75e9",
                                "text": "De rol van het affix in de afleiding of samenstelling wordt weergegeven door een verticale streep."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cfd28c7d-24cc-469a-8a25-8dd580d31971",
                        "source_entry_id": "a62cde0f-9438-3b29-9ffe-600be2e3dea2",
                        "source_sense_id": "2814852a-f090-3aba-9ffd-bace8c2a75e9",
                        "source_sense_description": "een gebonden morfeem dat aan een ander morfeem wordt toegevoegd om zo een nieuw woord te vormen",
                        "target_lang_word": "Affix",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Affix",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "863a02f5-4dde-36c8-aefc-5f7b48983888",
                                        "entry_id": "c05d0621-2379-3534-a381-c7521ca39219",
                                        "glosses": [
                                            "ein grammatisches Morphem (= Wortteil), das nicht allein für sich als Lexem/Wort vorkommt, sondern nur in Kombination mit einem anderen Morphem, das den Wortstamm bildet. Das Affix kann vor, nach, in dem oder um den Wortstamm stehen."
                                        ],
                                        "tags": [
                                            "Einheiten"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5e4388bf-139f-44cc-b2b6-8d260d5af68c",
                                                "sense_id": "863a02f5-4dde-36c8-aefc-5f7b48983888",
                                                "text": "Synthetische Sprachen drücken syntaktische Verhältnisse im Satz zumindest teilweise durch Affixe aus. Häufige Affixe im Deutschen sind die Präfixe „be-“, „ver-“, die Suffixe „-ling“, „-ung“ und das Zirkumfix „ge- + -e“ (zum Beispiel in „Ge-red-e“)."
                                            },
                                            {
                                                "example_id": "93f592b1-53c6-4a2d-8a1d-a314d3fa3692",
                                                "sense_id": "863a02f5-4dde-36c8-aefc-5f7b48983888",
                                                "text": "Affixe werden in der Flexion und in der Wortbildung verwendet."
                                            },
                                            {
                                                "example_id": "4196254a-1839-4d8c-877e-9210e5f9920f",
                                                "sense_id": "863a02f5-4dde-36c8-aefc-5f7b48983888",
                                                "text": "Konfixe sind keine Affixe."
                                            },
                                            {
                                                "example_id": "223573f0-644d-4389-a785-078bb7f8c0d4",
                                                "sense_id": "863a02f5-4dde-36c8-aefc-5f7b48983888",
                                                "text": "„Einige Affixe treten nur an sehr wenige Basen, unterliegen starken Selektionsbeschränkungen.“"
                                            },
                                            {
                                                "example_id": "769a3c93-912d-4fb3-b0aa-f419733a2ee0",
                                                "sense_id": "863a02f5-4dde-36c8-aefc-5f7b48983888",
                                                "text": "„Vertreter der zweiten Position nehmen ein Wurzellexikon an, in dem einzelne Morpheme, das heißt Wortstämme und Affixe, sowie Wortbildungsregeln gespeichert sind.“"
                                            },
                                            {
                                                "example_id": "4f21d01e-9273-4aaa-b317-10fb655b2663",
                                                "sense_id": "863a02f5-4dde-36c8-aefc-5f7b48983888",
                                                "text": "„Das mag für die Übernahme von Einheiten wie Affixen (morphologisch) und Lauten (phonologisch) gelten.“"
                                            },
                                            {
                                                "example_id": "06d24f35-67c9-408e-aa27-c07b75025448",
                                                "sense_id": "863a02f5-4dde-36c8-aefc-5f7b48983888",
                                                "text": "„Offenbar sind manche Affixe enger als andere mit dem freien Morphem verbunden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a6e64a5e-5779-4aea-b71d-dd2adc1de885",
                        "source_entry_id": "a62cde0f-9438-3b29-9ffe-600be2e3dea2",
