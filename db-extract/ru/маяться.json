                        ],
                        "form": "ма́явшийся"
                    },
                    {
                        "form_id": "c12e4046-cd7e-4c6f-bbba-968240986463",
                        "entry_id": "0ba90755-f051-3a89-8cb4-74b57cb0c497",
                        "tags": [
                            "adverbial",
                            "participle",
