                "senses": [
                    {
                        "sense_id": "d723ef4a-a05a-3540-91ec-11a873457a87",
                        "entry_id": "713f18e2-28c4-3a68-9781-bbad8ed2d3b9",
                        "glosses": [
                            "fachmännische, verantwortliche Leitung eines Bauvorhabens (zumeist durch Ingenieure); ergebnisorientierte Beaufsichtigung, Betreuung, Verwaltung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "898ce402-2ac3-40cd-9936-21521b47a956",
                                "sense_id": "d723ef4a-a05a-3540-91ec-11a873457a87",
                                "text": "„Die erfolgreiche Bewältigung dieser Situation durch die Bauleitung gehört zu den wichtigsten Aufgaben im Bauunternehmen, denn sie besitzt eine Schlüsselfunktion für Arbeitsbedingungen und Arbeitsschutz auf der Baustelle sowie für Produktivität, Qualität, Termintreue und das wirtschaftliche Ergebnis der Firma.“"
                            },
                            {
                                "example_id": "81a293cd-28e3-457c-b15a-c0be61ea9f7a",
                                "sense_id": "d723ef4a-a05a-3540-91ec-11a873457a87",
                                "text": "„Die Bauleitung umfasst die Kontrolle vor Ort, Aufmaße und umfangreiche Bauleitung mit detaillierter Abrechnung (Rechnungsprüfungen und Kostenüberwachung) gehören zur umfassenden Leistung dazu.“"
                            },
                            {
                                "example_id": "8f96f2c0-87f6-48f0-ac0a-1884979b8571",
                                "sense_id": "d723ef4a-a05a-3540-91ec-11a873457a87",
                                "text": "„Die Bauleitung ist für die Koordination sämtlicher am Bau Beteiligten zuständig und bildet somit die Schnittstelle zwischen dem Bauherren und dem Handwerker.“"
                            },
                            {
                                "example_id": "69425536-3c5d-400c-8c2b-b382d6e0b22d",
                                "sense_id": "d723ef4a-a05a-3540-91ec-11a873457a87",
                                "text": "„Eine zentrale Aufgabe der Bauleitung ist die Planung, Durchführung und Umsetzung der Baumaßname sowie die Koordination aller Handwerker.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
