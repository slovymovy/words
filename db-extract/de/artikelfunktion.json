                "senses": [
                    {
                        "sense_id": "b2b67038-931c-3ae7-9005-7aa640d1e53d",
                        "entry_id": "920ddf98-b228-31d0-a5ec-09bef4cb97d8",
                        "glosses": [
                            "syntaktische und semantische Funktionen der beiden Artikel, die im Hinblick auf die Mitteilungsabsicht und für die Textkonstitution und die Kohärenz/Kohäsion bedeutsam sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0203986e-357f-4a86-9318-2c6e50296f5b",
                                "sense_id": "b2b67038-931c-3ae7-9005-7aa640d1e53d",
                                "text": "Die Artikelfunktion trägt dazu bei, den Zusammenhang zwischen den Sätzen eines Textes deutlich zu machen."
                            },
                            {
                                "example_id": "20b32b1e-2670-4518-acda-20b9deadd7ed",
                                "sense_id": "b2b67038-931c-3ae7-9005-7aa640d1e53d",
                                "text": "Wörter, die an sich keine Artikel sind, aber bisweilen Artikelfunktionen übernehmen, werden dann Artikelwörter genannt."
                            },
                            {
                                "example_id": "36ce039b-bb00-4708-a331-7cedf74754e6",
                                "sense_id": "b2b67038-931c-3ae7-9005-7aa640d1e53d",
                                "text": "„Eine besonders umfangreiche Liste von sieben Artikelfunktionen von Peter von Polenz werden wir weiter unten kennenlernen.“"
                            },
                            {
                                "example_id": "e17199dc-1ca5-4e9c-b9cb-6ac9d9e88d29",
                                "sense_id": "b2b67038-931c-3ae7-9005-7aa640d1e53d",
                                "text": "Flämig stellt in einem eigenen Kapitel Artikelfunktionen dar, welche Leistungen die Artikel im Deutschen erbringen."
                            },
                            {
                                "example_id": "65e2a8f5-78af-457a-9432-2d13644a87e1",
                                "sense_id": "b2b67038-931c-3ae7-9005-7aa640d1e53d",
                                "text": "Lewandowski führt in seinem Stichwort „Artikelgebrauch“ die Artikelfunktionen als Synonym ein."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
