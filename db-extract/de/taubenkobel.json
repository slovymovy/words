                                        "sense_id": "dfa720fc-cfa0-3bc6-b3c1-c5ac1c725c47",
                                        "entry_id": "2937dcf4-a52c-326d-a957-75f0f16b0dfc",
                                        "glosses": [
                                            "Alternative spelling of dovecote."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "65054958-ee21-40a4-bc6c-ca56e01e9490",
                                                "sense_id": "dfa720fc-cfa0-3bc6-b3c1-c5ac1c725c47",
                                                "text": "In 1430 King's College, Cambridge, sells the pigeon's dung from its dovecot for 2s. 8d., in 1461 for 3s., in 1537 for 4s."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "77ab45a6-0dc2-4b19-bb06-21c2f93a66d5",
                        "source_entry_id": "343c192a-a8cc-30c9-b734-a3b364417be7",
                        "source_sense_id": "df0da112-eb68-3e57-878c-8a28d1c3c009",
                        "source_sense_description": "süddeutsch, österreichisch: der Taubenschlag",
                        "target_lang_word": "pigeonnier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pigeonnier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9ca9c9bf-75b7-3a1a-a98a-0ef6c6886c2a",
                                        "entry_id": "4649eca8-925e-3c21-821f-8129920db15a",
                                        "glosses": [
                                            "Construction destinée à loger les pigeons domestiques."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bbfd6977-b19d-4dd3-b578-8748806258c1",
                                                "sense_id": "9ca9c9bf-75b7-3a1a-a98a-0ef6c6886c2a",
                                                "text": "Confondu dans le pays avec le four à chanvre qui lui ressemble étrangement, le pigeonnier est souvent plus soigné dans sa construction. C'est un élément plus rare du décor architectural car il provient, pour l'essentiel, d'anciens domaines."
                                            },
                                            {
                                                "example_id": "a88c384d-1192-4c43-b8a8-177adc57edff",
                                                "sense_id": "9ca9c9bf-75b7-3a1a-a98a-0ef6c6886c2a",
                                                "text": "Le Gers n'est certainement pas le département le plus fourni en pigeonniers mais il n'est pas rare d'en croiser au détour des petites routes de campagne et ce sur tout le territoire. Ces petites bâtisses d'ornement sont parfois surprenantes par leur forme, leur emplacement, leur décor."
                                            },
                                            {
                                                "example_id": "e796db29-b152-4fc5-aa66-cca7a69710b5",
                                                "sense_id": "9ca9c9bf-75b7-3a1a-a98a-0ef6c6886c2a",
                                                "text": "Après un contact téléphonique et une vérification nocturne dans son pigeonnier par le propriétaire, il s’est avéré qu’il lui manquait 26 pigeons de compétition."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "32cd4f3c-1a66-35fe-bbfd-9d25dab2a825",
                                        "entry_id": "4649eca8-925e-3c21-821f-8129920db15a",
                                        "glosses": [
                                            "Habitation élevée."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "47b756fe-b941-4c25-b7f5-7a99c2d952c3",
                                                "sense_id": "32cd4f3c-1a66-35fe-bbfd-9d25dab2a825",
                                                "text": "Je le trouve ailleurs , ne vous déplaise , repartit Boisrobert: M. de Balzac ne reste confiné dans son pigeonnier depuis plus de quinze ans , que pour faire pièce à Votre Éminence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0c49f8d9-2455-3b8f-bcd8-4db65aa4cbc6",
                                        "entry_id": "4649eca8-925e-3c21-821f-8129920db15a",
                                        "glosses": [
                                            "Boîte aux lettres ou un système de boîtes aux lettres collectif souvent utilisé dans un milieu administratif ou scolaire."
                                        ],
                                        "tags": [
                                            "Québec"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "86ba23d4-6445-488c-8862-3f7c62d409d3",
                                                "sense_id": "0c49f8d9-2455-3b8f-bcd8-4db65aa4cbc6",
                                                "text": "En allant chercher mon courrier dans le pigeonnier, je croise Jean-Pierre, un prof de physique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
