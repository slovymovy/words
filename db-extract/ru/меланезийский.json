                        "cross_references": [
                            {
                                "target_word": "Melanesian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1118ad7b-e76f-3b78-8842-68fc4e9ccfff",
                                        "entry_id": "b73c834b-4534-3751-93b9-0a336c44ee0b",
                                        "glosses": [
                                            "Of or relating to Melanesia."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "30731646-3fa9-4a79-9a3b-d3e857fad815",
                                                "sense_id": "1118ad7b-e76f-3b78-8842-68fc4e9ccfff",
                                                "text": "While Melanesian cannibals make \"long pig,\" barbecuing enemies, legal and political cannibals in San Francisco put a beautiful wealthy woman, Penny Penny Hill, on trial for murder […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Melanesian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1afb7cab-9f38-31ca-a1a9-b63816332cac",
                                        "entry_id": "66976ce3-7e56-3133-b4d5-0239045afafc",
                                        "glosses": [
                                            "A Melanesian person."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e60d4a5-574c-45d5-992e-96fe0fe88c9d",
                                                "sense_id": "1afb7cab-9f38-31ca-a1a9-b63816332cac",
                                                "text": "Blackbirding was the euphemism given to the slave-trading that occurred in the Pacific from the mid-1800s through to the early-1900s. According to one study, blackbirding, [as] “the practice of luring Melanesians and Polynesians to toil for next to nothing was called”, involved upwards of 60,000 people between 1863 and 1904 (Horne, 2007, p. 2)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
