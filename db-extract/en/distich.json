                    }
                ],
                "translations": [
                    {
                        "translation_id": "521f11ae-6bfe-404c-8d60-8eea3b10ea29",
                        "source_entry_id": "ec99ee80-2179-38c0-8872-bc1dc16cb6e2",
                        "source_sense_description": "a two line stanza making complete sense",
                        "target_lang_word": "distique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "distique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c15a9ffd-3b82-3b72-9642-52008a4ca5a4",
                                        "entry_id": "c10b91ba-e713-38f3-a4f6-81051ad2e60d",
                                        "glosses": [
                                            "Qualifie les parties qui, sur un même plan, sont rangées en deux séries opposées."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa05c3da-eae2-48da-8308-87d42e228a1c",
                                                "sense_id": "c15a9ffd-3b82-3b72-9642-52008a4ca5a4",
                                                "text": "[J]eunes rameaux fins, distiques, glabres ou velus, parfois munis de crêtes liégeuses […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c6a63d02-18a2-3464-949d-0d391bf8c64b",
                                        "entry_id": "c10b91ba-e713-38f3-a4f6-81051ad2e60d",
                                        "glosses": [
                                            "Qui a deux rangées de facettes autour de chaque base."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "524165ed-61cd-4b0e-84a3-c0a6d38566cd",
                                                "sense_id": "c6a63d02-18a2-3464-949d-0d391bf8c64b",
                                                "text": "Cristal distique."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "distique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "10266d9f-bcb7-3d8c-98cf-93e64d1e972d",
                                        "entry_id": "949a6664-5fba-30e6-8f00-e2f95d384b32",
                                        "glosses": [
                                            "Groupe de deux vers de nature différente qui renferment un sens complet."
                                        ],
                                        "tags": [
                                            "Versification"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5b07b043-1d70-4a93-9ccc-46210c252f69",
                                                "sense_id": "10266d9f-bcb7-3d8c-98cf-93e64d1e972d",
                                                "text": "Que de colonnades, d’arcades, de fresques, d’obélisques, de temples grecs, de propylées, de distiques en lettres d’or sur les frontons !"
                                            },
                                            {
                                                "example_id": "5977784e-d34f-41f0-9267-c14c696ad7ad",
                                                "sense_id": "10266d9f-bcb7-3d8c-98cf-93e64d1e972d",
                                                "text": "— Il fait bon, ici, dit Cintra.\"La trépidation excitante des trains nous glisse des désirs dans la moelle des reins\" — (Distique d'Alphonse Allais cité par Apollinaire dans \"Les Onze mille verges\")/>— Et il y a du linge.\n— C’est vrai ; c’est comme dans le distique.\n— Quel distique ? interrogea poliment le macrobe.\n— Vous ne savez que ça ; ce qu’on lit l’été, sur les devantures :\nVu l’élévation de la température,\nAujourd’hui la volaille est à l’intérieur."
                                            },
                                            {
                                                "example_id": "af5587ff-f6ca-415b-ba8d-11745fe507bc",
                                                "sense_id": "10266d9f-bcb7-3d8c-98cf-93e64d1e972d",
                                                "text": "Un commerçant en cartes postales licencieuses l’engagea pour quelques sous. Le jeune homme devait fournir tout un stock de distiques appropriés à la marchandise."
                                            },
                                            {
                                                "example_id": "c6bff6da-d232-49fd-a21c-bbf0a5ce59d8",
                                                "sense_id": "10266d9f-bcb7-3d8c-98cf-93e64d1e972d",
                                                "text": "[…] ; un boucher, fervent pétainiste et amateur de poésie mirlitonnesque, devait d'être là à un policier qui n'avait pas apprécié le distique\n« Vive le Maréchal !\nÇa c'est pas mal »\nque le bonhomme avait affiché en grosses majuscules sur la façade de sa boutique."
                                            },
                                            {
                                                "example_id": "7895a953-48ed-4310-a00b-cb73e765fab2",
                                                "sense_id": "10266d9f-bcb7-3d8c-98cf-93e64d1e972d",
                                                "text": "Il s'agit d'un texte relativement court qui fonctionne, comme la plupart des cantiques, en distique, soit deux phrases qui se répondent, par exemple: « Il renverse les puissants de leurs trônes, il élève les humbles », « Il comble de biens les affamés, renvoie les riches les mains vides », etc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5b8f6677-4eff-3732-b380-d80a8f5df71d",
                                        "entry_id": "949a6664-5fba-30e6-8f00-e2f95d384b32",
                                        "glosses": [
                                            "Succession régulière d’un hexamètre et d’un pentamètre, dans la versification grecque et latine."
                                        ],
                                        "tags": [
                                            "Versification"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "78789dcf-3086-4cfc-8713-dca0a488c069",
                                                "sense_id": "5b8f6677-4eff-3732-b380-d80a8f5df71d",
                                                "text": "Le distique élégiaque…"
                                            },
                                            {
                                                "example_id": "48995fe7-a52e-4a9d-84e2-776c4a87a2e1",
                                                "sense_id": "5b8f6677-4eff-3732-b380-d80a8f5df71d",
                                                "text": "Le désir de m’échapper ne m’entraînait pas bien loin. Et moi aussi j’avais lu dans les Tristes des distiques que je disais tout bas, en pensant à Villeneuve, le seul pays que je connusse et qui me laissât des regrets cuisants."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0d71079d-d8be-4fed-a292-612d64790301",
