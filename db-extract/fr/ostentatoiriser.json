                "senses": [
                    {
                        "sense_id": "a0897b17-1611-355c-a256-71120a015655",
                        "entry_id": "68dcad41-48b9-3cae-8fa7-461b9eb593f6",
                        "glosses": [
                            "Rendre ostentatoire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f037dd27-3132-4cca-9a51-6ad20394164b",
                                "sense_id": "a0897b17-1611-355c-a256-71120a015655",
                                "text": "Aveu de total-droitisme-hiérarchologique putanisé en pseudo-gauchisme bien-agit-pensé-ostentatoirisé."
                            },
                            {
                                "example_id": "ffd07358-72da-4c58-b448-fb33e5286ff0",
                                "sense_id": "a0897b17-1611-355c-a256-71120a015655",
                                "text": "On ne permet pas \"d'ostentatoiriser\" la politique dans le secteur public."
                            },
                            {
                                "example_id": "d40491d4-8329-4596-858b-1f640e4b16fb",
                                "sense_id": "a0897b17-1611-355c-a256-71120a015655",
                                "text": "Alors cette année, je fais un peu de sélection génétique: un des trois géants s'est vu ostentatoirisé et porte maintenant, à défaut d’un voile ou d’un autre symbole, un filet tissé assez serré pour retenir ses graines."
                            }
                        ]
                    }
