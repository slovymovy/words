                {
                    "sense_id": "a05a3702-62e4-3c16-8391-b1c92326468a",
                    "sense_definition": "In a correct, suitable, or appropriate manner.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The machine is not working <w>properly</w> today.",
                            "target_lang_translations": {
                                "ru": "Машина сегодня не работает <w>должным образом</w>.",
                                "zh": "这台机器今天没法<w>正常</w>运转。"
                            }
                        },
                        {
                            "text": "You must close the door <w>properly</w> to lock it.",
                            "target_lang_translations": {
                                "ru": "Вы должны закрыть дверь <w>как следует</w>, чтобы запереть её.",
                                "zh": "你必须把门<w>关好</w>才能锁上。"
                            }
