            "pos": "verb",
            "senses": [
                {
                    "sense_id": "180b3f00-ca32-3af8-9845-d46f851b7818",
                    "sense_definition": "Administrer le sacrement de l'eau pour faire entrer une personne dans la communauté chrétienne.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le prêtre va <w>baptiser</w> le bébé dimanche matin devant toute la famille."
                        },
                        {
                            "text": "Les parents ont décidé de faire <w>baptiser</w> leur fille dans l'église du village."
                        }
                    ],
                    "synonyms": [
                        "ondoyer"
                    ],
                    "common_phrases": [
                        "faire baptiser un enfant"
                    ]
                },
                {
                    "sense_id": "6476836c-6ab5-3c89-9d3d-b82baf297bef",
                    "sense_definition": "Donner un nom, un surnom ou une appellation spécifique à quelqu'un ou à quelque chose.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "nomination",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les scientifiques ont choisi de <w>baptiser</w> cette nouvelle planète du nom d'une déesse."
                        },
                        {
                            "text": "Ses camarades de classe l'ont rapidement <w>baptisé</w> le professeur à cause de ses lunettes."
                        }
                    ],
                    "antonyms": [
                        "débaptiser"
                    ],
                    "common_phrases": [
                        "baptiser du nom de"
                    ]
                },
                {
                    "sense_id": "31b6c34f-f5b9-347c-823d-7a01c2c191ff",
                    "sense_definition": "Donner solennellement un nom à un bateau, une cloche ou un édifice lors d'une cérémonie inaugurale.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "nomination",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La tradition veut qu'on brise une bouteille de champagne pour <w>baptiser</w> un navire."
                        },
                        {
                            "text": "L'évêque est venu spécialement dans la paroisse pour bénir et <w>baptiser</w> la nouvelle cloche."
                        }
                    ],
                    "common_phrases": [
                        "baptiser un navire",
                        "baptiser une cloche"
                    ]
                },
                {
                    "sense_id": "50e6013b-1290-37d8-a16a-ef81b8abe132",
                    "sense_definition": "Utiliser, étrenner ou tacher un objet neuf pour la toute première fois.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a profité du beau week-end pour enfin <w>baptiser</w> son nouveau vélo de course."
                        },
                        {
                            "text": "J'ai malheureusement <w>baptisé</w> ma chemise blanche avec une tache de café dès le premier jour."
                        }
                    ],
                    "common_phrases": [
