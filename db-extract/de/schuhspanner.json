                "senses": [
                    {
                        "sense_id": "c29ab50d-7ffe-30df-9a50-e3d818b11a1a",
                        "entry_id": "8857d34a-993b-38cc-9eae-da631f9573f8",
                        "glosses": [
                            "Gerät, das nach dem Tragen in den Schuh geklemmt wird, damit dieser seine Form behält"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f10f3519-cf74-4c3a-9d88-9b8d9e1bc933",
                                "sense_id": "c29ab50d-7ffe-30df-9a50-e3d818b11a1a",
                                "text": "„Wenn die Schuhe naß werden, sollte man ihnen sogar 48 Stunden Ruhe gönnen - mit einem hölzernen Schuhspanner ausgeleistet, versteht sich.“"
                            },
                            {
                                "example_id": "4982a87a-a4ff-405f-9e2e-31df039e8a5e",
                                "sense_id": "c29ab50d-7ffe-30df-9a50-e3d818b11a1a",
                                "text": "„Ich riß die Tür des Kleiderschranks schnell auf, um dem Spiegel zu entgehen: Nichts mehr von Marie im Schrank, nichts mehr, nicht einmal mehr ein Schuhspanner oder ein Gürtel, wie ihn Frauen manchmal hängen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "37ff4660-225d-4897-afd6-5bc63c2dc7fa",
                        "source_entry_id": "8857d34a-993b-38cc-9eae-da631f9573f8",
                        "source_sense_id": "c29ab50d-7ffe-30df-9a50-e3d818b11a1a",
                        "source_sense_description": "Gerät, das nach dem Tragen in den Schuh geklemmt wird, damit dieser seine Form behält",
                        "target_lang_word": "embauchoir",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "embauchoir",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "23dd3605-c79b-3299-8248-8918ccf738e9",
                                        "entry_id": "40baf353-a79c-3dcc-91e1-247800abbff7",
                                        "glosses": [
                                            "Instrument de bois ou de plastique en forme de pied dont on se sert pour élargir les chaussures ou pour empêcher qu’elles ne se déforment."
                                        ],
                                        "tags": [
                                            "Cordonnerie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fb9861b3-5a12-4352-94de-cfd482f2e06b",
                                                "sense_id": "23dd3605-c79b-3299-8248-8918ccf738e9",
                                                "text": "Ah ! Le bel embauchoir !"
                                            },
                                            {
                                                "example_id": "8a73bba3-823a-42d3-91b7-e7e8c145310e",
                                                "sense_id": "23dd3605-c79b-3299-8248-8918ccf738e9",
                                                "text": "Pour conserver à vos chaussures leur aspect neuf, mettez des embauchoirs à l’intérieur quand vous ne les portez pas."
                                            },
                                            {
                                                "example_id": "bd865715-ce2f-4ac2-9161-83d700f2003e",
                                                "sense_id": "23dd3605-c79b-3299-8248-8918ccf738e9",
                                                "text": "... au sol une exposition de chaussures avec des embauchoirs et des brosses immaculées..."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
