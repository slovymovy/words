                "senses": [
                    {
                        "sense_id": "3dc0aac7-19d0-3a31-a289-98a62308ae4e",
                        "entry_id": "f3fac5c0-f2b5-3bb6-a4fe-4ba9ef5e8f85",
                        "glosses": [
                            "Faire perdre son caractère bizarre à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0898ad24-1c7e-4e1c-a295-476dae1957af",
                                "sense_id": "3dc0aac7-19d0-3a31-a289-98a62308ae4e",
                                "text": "Ils ne font rien comme les autres au grand découragement de la fillette, qui tente en vain de les \"débizarriser\"."
                            },
                            {
                                "example_id": "7e16dbd7-ad57-4543-90e6-e4192fd65f6d",
                                "sense_id": "3dc0aac7-19d0-3a31-a289-98a62308ae4e",
                                "text": "Une application pour téléphone intelligent décrète que Sierra a une personnalité bizarre : Mélanie entreprend donc de débizarriser son amie!"
                            },
                            {
                                "example_id": "476526c8-54af-4e4a-9810-2dd090649777",
                                "sense_id": "3dc0aac7-19d0-3a31-a289-98a62308ae4e",
                                "text": "Et encore, t'as débizarrisé ton pseudo…"
                            }
                        ]
                    }
