                    {
                        "sense_id": "562d48a4-9c5e-3f9e-b285-89196d604360",
                        "entry_id": "5ae7284e-c563-33a6-9676-969b517c6d2e",
                        "glosses": [
                            "de lucht met de eigenschappen die horen bij het voorjaar"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b6c4ce36-5070-4570-93ec-f05ac4d78816",
                                "sense_id": "562d48a4-9c5e-3f9e-b285-89196d604360",
                                "text": "Door het open ventilatieraampje kwam de lentelucht naar binnen zetten, geurend naar een Frans wittebroodje waar zojuist in was gehapt."
                            },
                            {
                                "example_id": "7076c962-c6be-4903-a82a-4116d34df172",
                                "sense_id": "562d48a4-9c5e-3f9e-b285-89196d604360",
                                "text": "Resteert altijd nog het Slingebos aan de andere kant van het complex. Wie 's winters denkt dat het bos nog volop groen is, moet nodig in het voorjaar terugkomen als dan ook loofbomen en struiken ad krijgen. Wie hardloopt, ervaart het bos nadrukkelijker dan een toevallige wandelaar. Al was het maar omdat je de lentelucht met liters tegelijk inademt."
                            }
                        ]
                    }
