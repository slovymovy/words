                        "source_entry_id": "d6b567c1-5f99-3991-b5f8-4eb95ddb0ef7",
                        "source_sense_id": "db057de2-d632-3993-84a0-84d0865e3df5",
                        "source_sense_description": "Berechnung, um Kosten für Produkte oder Dienstleistungen zu ermitteln",
                        "target_lang_word": "calculation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "calculation",
