                                        "glosses": [
                                            "Matériau qui présente des propriétés de supraconduction dans au moins certaines conditions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c345da8-bbd0-4f6c-89bc-2eae27883a43",
                                                "sense_id": "1573e76f-6379-315c-85bd-b835d596b8ea",
                                                "text": "Un grand nombre de cuprates sont des supraconducteurs à haute température critique."
                                            },
                                            {
                                                "example_id": "90bb4c23-bca3-451d-a24a-bea505b78691",
                                                "sense_id": "1573e76f-6379-315c-85bd-b835d596b8ea",
                                                "text": "Bien que se repoussant, les électrons situés dans un supraconducteur présentent une faible attraction mutuelle."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "supraconducteur",
