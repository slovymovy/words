                    {
                        "form_id": "63852d50-30eb-40f4-9217-f5eb680ad77f",
                        "entry_id": "54dba2f8-503b-3a9f-9790-2d2e1b72d84d",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most seasonable"
