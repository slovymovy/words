                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "58829af7-0109-4d8f-bc9a-06ab7eb94aba",
                                "sense_id": "991438db-a7d6-37a8-81b9-29c4d8831c7c",
                                "text": "Puis-je auto-configurer un deuxième point d’accès sans fil ?"
                            }
                        ]
                    },
                    {
                        "sense_id": "7f36c942-e058-30e4-8c05-85e0197033a3",
                        "entry_id": "c16c4d1a-c595-318c-a300-fa22bfc7b544",
                        "glosses": [
                            "Se configurer soi-même."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "80f1a2fa-9ac0-4248-adcb-d83767bb478c",
                                "sense_id": "7f36c942-e058-30e4-8c05-85e0197033a3",
                                "text": "Quand tu partages la connexion, la carte va s’auto-configurer avec une adresse IP du genre 192.168.x.x."
                            },
                            {
                                "example_id": "0cd58d66-6ba2-4f5b-9466-045f696616bc",
                                "sense_id": "7f36c942-e058-30e4-8c05-85e0197033a3",
                                "text": "Le problème est qu’un navigateur en mode détection automatique des paramètres tel que Firefox est incapable de s’auto-configurer."
                            }
                        ]
                    }
