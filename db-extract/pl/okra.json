                    },
                    {
                        "translation_id": "10662f17-afa7-43c4-b6da-1bbc84e37e73",
                        "source_entry_id": "f9cd1b31-013d-36be-bd43-37ae83866d5d",
                        "source_sense_id": "825d946a-c4dc-3ab3-b5af-279c41db3712",
                        "target_lang_word": "Okra",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Okra",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2fc04c10-badc-3903-939c-8afc68ae5a21",
                                        "entry_id": "59a40c79-8870-3e13-9fa3-e1e7e5c8c7f6",
                                        "glosses": [
                                            "Pflanzenart aus der Familie der Malvengewächse"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82c46d9d-49e4-46c8-9f2e-8137b109ecfe",
                                                "sense_id": "2fc04c10-badc-3903-939c-8afc68ae5a21",
                                                "text": "„Andere Früchte, wie Getreide, Taro, Okra, Reis, Erdnüsse, Melonen, Pfeffer, Flaschenkürbisse, Bohnen und andere Gemüsesorten, wurden ausschließlich von Frauen angepflanzt und geerntet; sie gehörten ihnen, selbst wenn sie damit ihren Mann und die Kinder versorgen mussten.“"
                                            },
                                            {
                                                "example_id": "3850a5ee-930f-4b41-8876-538bd47133eb",
                                                "sense_id": "2fc04c10-badc-3903-939c-8afc68ae5a21",
                                                "text": "„Er durchquerte den Raum, nahm eines in die Hand und pustete den Staub herunter. Grüne Bohnen. In den ordentlichen Reihen außerdem rote Paprikastücke. Tomaten. Mais. Neue Kartoffeln. Okra.“"
                                            },
                                            {
                                                "example_id": "c68b5d8b-aeae-41a3-82c0-99ec39b6d6e2",
                                                "sense_id": "2fc04c10-badc-3903-939c-8afc68ae5a21",
                                                "text": "„Mani saß, ein Knie unters Kinn hochgezogen, neben ihnen, stocherte in einem Berg Okra und formte ihn zu einem Kreis.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
