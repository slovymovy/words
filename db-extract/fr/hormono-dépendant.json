                "senses": [
                    {
                        "sense_id": "f55f4dae-9512-381e-a85c-73769d54232e",
                        "entry_id": "69e1eef0-1937-3334-8ac8-4c888899dd36",
                        "glosses": [
                            "Qualifie une pathologie dont le développement subit l’influence de la production d’hormones sexuelles par le patient."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c261bb1-3144-4abe-9571-e1ab4b9d2f9d",
                                "sense_id": "f55f4dae-9512-381e-a85c-73769d54232e",
                                "text": "Certains cancers du sein sont hormono-dépendants, ce qui signifie que les hormones produites naturellement par la femme nourrissent la tumeur et facilitent sa croissance."
                            },
                            {
                                "example_id": "017c7c2d-d33e-4769-b7eb-104b1c2b89aa",
                                "sense_id": "f55f4dae-9512-381e-a85c-73769d54232e",
                                "text": "On considère qu’un cancer du sein est hormono-dépendant lorsque les récepteurs hormonaux, que ce soit aux estrogènes (ER) ou à la progestérone (PR+), sont présents sur plus de 10 % des cellules cancéreuses (mesure en histochimie)."
                            }
                        ]
                    }
                ],
