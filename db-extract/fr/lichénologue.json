                                        "entry_id": "3bbf5521-b715-3206-bdeb-a6d2366f1d96",
                                        "glosses": [
                                            "An expert in lichenology."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e473b48d-103a-4fd1-9f4d-c575ba0bf558",
                                                "sense_id": "f373f11e-5f64-3d8e-923f-ed295752aba9",
                                                "text": "To witness some queer, shy, misshapen, greyheaded, self-important, little discoverer of great discoveries, ridiculously adorned with the wide ribbon of some order of chivalry and holding a reception of his fellow-men, or to read the anguish of Nature at the “neglect of science” when the angel of the birthday honours passes the Royal Society by, or to listen to one indefatigable lichenologist commenting on the work of another indefatigable lichenologist, such things force one to realise the unfaltering littleness of men."
                                            },
                                            {
                                                "example_id": "e38eb8b5-74d7-42ec-bbf5-bd935e3c02e1",
                                                "sense_id": "f373f11e-5f64-3d8e-923f-ed295752aba9",
                                                "text": "Schwendener's suggestion was vehemently opposed by his fellow lichenologists."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
