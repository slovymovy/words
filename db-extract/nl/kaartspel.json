                    }
                ],
                "senses": [
                    {
                        "sense_id": "5011caff-43e7-31f7-98e8-da9141866bc8",
                        "entry_id": "b0a70bb4-8243-333d-b1f1-95f52289f349",
                        "glosses": [
                            "een spel met speelkaarten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa684c85-135e-4172-8a2b-ba863b0dcdf2",
                                "sense_id": "5011caff-43e7-31f7-98e8-da9141866bc8",
                                "text": "Het schijnt dat veel mensen dat Amerikaanse kaartspel erg leuk vinden."
                            }
                        ]
                    },
                    {
                        "sense_id": "6c84d2ac-15f1-3aa9-ab37-b8c851d2da7f",
                        "entry_id": "b0a70bb4-8243-333d-b1f1-95f52289f349",
                        "glosses": [
                            "een spel kaarten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10bc2bc0-c55a-49de-8025-0ec0ac1b61dc",
                                "sense_id": "6c84d2ac-15f1-3aa9-ab37-b8c851d2da7f",
                                "text": "Heb je het kaartspel meegenomen?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "04ce7906-acfd-4248-8878-2c598419f876",
                        "source_entry_id": "b0a70bb4-8243-333d-b1f1-95f52289f349",
                        "source_sense_id": "5011caff-43e7-31f7-98e8-da9141866bc8",
                        "source_sense_description": "een spel met speelkaarten",
                        "target_lang_word": "Kartenspiel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kartenspiel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5092595e-9a71-3737-b61d-5241ae2336ae",
                                        "entry_id": "883d178c-f8f2-39ac-8735-aaf6fa2cf8ca",
                                        "glosses": [
                                            "Art und Weise, mit Karten zu spielen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43aebceb-5b8e-4d3f-925e-7dff40b263dc",
                                                "sense_id": "5092595e-9a71-3737-b61d-5241ae2336ae",
                                                "text": "Es gibt eine Reihe von Kartenspielen, die bekanntesten sind in der Rubrik Unterbegriffe subsumiert."
                                            },
                                            {
                                                "example_id": "36e2d335-55c8-477e-9a86-04779497ecaa",
                                                "sense_id": "5092595e-9a71-3737-b61d-5241ae2336ae",
                                                "text": "„Aufgeweckt durch fernes Gewehrfeuer, verkürzten wir uns manchmal die endlose Nacht mit Kartenspielen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d427c252-d95f-3f8f-aa36-617fb6388f66",
                                        "entry_id": "883d178c-f8f2-39ac-8735-aaf6fa2cf8ca",
                                        "glosses": [
                                            "ein durchgeführtes Spiel von [1]"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e9b4ce9-0b49-4452-85f9-e7c1ffd7fe21",
                                                "sense_id": "d427c252-d95f-3f8f-aa36-617fb6388f66",
                                                "text": "Fritz hatte bei dem letzten Kartenspiel viel Geld verloren, seitdem spielt er Roulette."
                                            },
                                            {
                                                "example_id": "e235592d-818b-4cf6-9021-a928afab3ebd",
                                                "sense_id": "d427c252-d95f-3f8f-aa36-617fb6388f66",
                                                "text": "„Sie will ihm ein Kartenspiel beibringen.“"
                                            },
                                            {
                                                "example_id": "983c26da-9974-4a6a-ac37-28925c1afe31",
                                                "sense_id": "d427c252-d95f-3f8f-aa36-617fb6388f66",
                                                "text": "„Bess hatte Freude daran, so viele nette jüdische Jungen zu füttern, und Herman beteiligte sich an Kartenspielen und erzählte Witze.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "f171c0b0-ab16-38f7-8eb8-754962452d14",
                                        "entry_id": "883d178c-f8f2-39ac-8735-aaf6fa2cf8ca",
                                        "glosses": [
                                            "Spielen mit Karten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "31677c17-8036-4723-bfed-ff94f1805bef",
                                                "sense_id": "f171c0b0-ab16-38f7-8eb8-754962452d14",
                                                "text": "Das Kartenspiel ist in diesem Cafe untersagt."
                                            },
                                            {
                                                "example_id": "2f0c85fc-2e56-4a6c-95b7-c90a9974b244",
                                                "sense_id": "f171c0b0-ab16-38f7-8eb8-754962452d14",
                                                "text": "„Ich weiß, was man vom Kartenspiel hat.“"
                                            },
                                            {
                                                "example_id": "c98e8f60-1913-4df7-b7c1-f86584be9cf0",
                                                "sense_id": "f171c0b0-ab16-38f7-8eb8-754962452d14",
                                                "text": "„Doch zurück zum Kartenspiel.“"
                                            },
                                            {
                                                "example_id": "dda800ab-cd38-4a4a-81e1-2578b180a6f4",
                                                "sense_id": "f171c0b0-ab16-38f7-8eb8-754962452d14",
                                                "text": "„Alles war geschlossen, und seine Eltern hatten ihm eingeschärft, dass noch nicht einmal ein Kartenspiel angemessen sei.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "2e662707-afc8-3a81-a097-83697334b4a8",
                                        "entry_id": "883d178c-f8f2-39ac-8735-aaf6fa2cf8ca",
                                        "glosses": [
                                            "Gesamtheit aller zu einem Spiel gehörigen Karten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e4fa37f-547a-45c0-abb1-e42a4583317f",
                                                "sense_id": "2e662707-afc8-3a81-a097-83697334b4a8",
                                                "text": "Für den Skatabend braucht man ein Kartenspiel."
                                            },
                                            {
                                                "example_id": "9742deb5-d10c-4964-b549-07dddabf8270",
                                                "sense_id": "2e662707-afc8-3a81-a097-83697334b4a8",
                                                "text": "„Es ist, als mischte jemand ein riesiges Kartenspiel aus Bildern.“"
                                            },
                                            {
                                                "example_id": "8a6cc4ee-99d9-41a3-b0ab-b2fd7df0ea0f",
                                                "sense_id": "2e662707-afc8-3a81-a097-83697334b4a8",
                                                "text": "„Frau Glück besitzt ein Kartenspiel.“"
                                            },
                                            {
                                                "example_id": "a7a30649-37a7-4e17-b63e-58a5963fd47d",
                                                "sense_id": "2e662707-afc8-3a81-a097-83697334b4a8",
                                                "text": "„Sie duldete nicht, daß ein neues Kartenspiel gekauft wurde, und ich nehme an, daß die angesengte Herzsieben immer noch im Spiel ist und meine Mutter sich nichts dabei denkt, wenn sie ihr beim Patiencelegen in die Hand kommt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "87ca6b42-fdd8-34cc-8465-e3278031ccc5",
                                        "entry_id": "883d178c-f8f2-39ac-8735-aaf6fa2cf8ca",
                                        "glosses": [
                                            "Strategie bei [2]"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eee929d1-0b31-448d-b650-c660fc24eb08",
                                                "sense_id": "87ca6b42-fdd8-34cc-8465-e3278031ccc5",
                                                "text": "Sein ungeschicktes Kartenspiel irritierte seine Gegner."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b84df325-6db3-4267-b089-723b6e7fb1e6",
