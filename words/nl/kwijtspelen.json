{
    "word_family": [
        "kwijtraken",
        "spelen",
        "spel"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c0245892-37cb-360c-8711-6eb5f101336d",
                    "sense_definition": "iets of iemand per ongeluk verliezen of niet meer kunnen vinden",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "verlies",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik ben gisteren helaas mijn sleutels <w>kwijtgespeeld</w> op het station.",
                            "target_lang_translations": {
                                "en": "Unfortunately, I <w>lost</w> my keys at the station yesterday."
                            }
                        },
                        {
                            "text": "Hij <w>speelde</w> zijn vrienden <w>kwijt</w> in de drukke menigte op de markt.",
                            "target_lang_translations": {
                                "en": "He <w>lost</w> his friends in the busy crowd at the market."
                            }
                        }
                    ],
                    "common_phrases": [
                        "sleutels kwijtspelen",
                        "elkaar kwijtspelen"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "vooral in België gebruikt"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to accidentally lose something or be unable to find someone or something"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to lose",
                                "target_lang_sense_clarification": "to misplace or become separated from someone or something"
                            },
                            {
                                "target_lang_word": "to misplace",
                                "target_lang_sense_clarification": "to put something in an unknown place accidentally"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ef9ec1d9-9ab2-30d6-8a39-9a52d7a5a12d",
                    "sense_definition": "door dom, onverstandig of roekeloos gedrag iets waardevols verliezen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "verlies",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Door die foute beslissing <w>speelde</w> hij zijn baan <w>kwijt</w>.",
                            "target_lang_translations": {
                                "en": "Because of that bad decision, he <w>lost</w> his job."
                            }
                        },
                        {
                            "text": "Zij <w>speelde</w> het vertrouwen van haar collega's volledig <w>kwijt</w>.",
                            "target_lang_translations": {
                                "en": "She completely <w>lost</w> the trust of her colleagues."
                            }
                        }
                    ],
                    "synonyms": [
                        "verspelen"
                    ],
                    "common_phrases": [
                        "vertrouwen kwijtspelen",
                        "baan kwijtspelen"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "vooral in België gebruikt"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to lose something valuable through foolish, unwise, or reckless behavior"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to lose",
                                "target_lang_sense_clarification": "to be deprived of something like a job or trust due to one's actions"
                            },
                            {
                                "target_lang_word": "to forfeit",
                                "target_lang_sense_clarification": "to lose something as a consequence of wrong behavior or error"
                            },
                            {
                                "target_lang_word": "to squander",
                                "target_lang_sense_clarification": "to waste or lose foolishly"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}