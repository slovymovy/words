                        "тосковать",
                        "горевать"
                    ],
                    "common_phrases": [
                        "радоваться за друга",
                        "радоваться жизни",
                        "радоваться успехам"
                    ],
                    "target_lang_definitions": {
                        "en": "To experience a feeling of joy, pleasure, or satisfaction; to be happy or pleased with something or someone."
                    },
