                ],
                "senses": [
                    {
                        "sense_id": "45ef50eb-eb01-3483-b194-17ebecc0b18b",
                        "entry_id": "44cb2686-7019-31ac-99ee-41921cedfe3d",
                        "glosses": [
                            "einfaches, nicht abgeleitetes Wort; sehr altes, ursprüngliches Wort, aus dem heraus sich spätere Formen entwickelt haben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d70f216-3797-4c88-9b86-eeab679fc7d3",
                                "sense_id": "45ef50eb-eb01-3483-b194-17ebecc0b18b",
                                "text": "„Danach zerfallen alle »Namen«, das heißt die Wörter der Sprachen überhaupt, in Urwörter und abgeleitete Wörter.“"
                            },
                            {
                                "example_id": "8359ffb8-9fc9-4444-9992-af92739865c4",
                                "sense_id": "45ef50eb-eb01-3483-b194-17ebecc0b18b",
                                "text": "„Die Frage nach den allerersten Wörtern (Urworten) wird in der Sprachgeschichte durchaus gestellt, und auch für einige Sprachgruppen, etwa die indogermanischen Sprachen, versuchsweise beantwortet.“"
                            },
                            {
                                "example_id": "5ed75df7-635c-4819-a2ea-6548d30cc3db",
                                "sense_id": "45ef50eb-eb01-3483-b194-17ebecc0b18b",
                                "text": "Das Grimmsche Wörterbuch stellt Goethes Verständnis von Urwort im Zusammenhang mit beiden Bedeutungen dar."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "82165761-86cf-361e-97e4-e830fa81f532",
                        "entry_id": "44cb2686-7019-31ac-99ee-41921cedfe3d",
                        "glosses": [
                            "Wort, das einen Aspekt der Weltanschauung repräsentiert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "033b2992-fc80-463c-a3bb-ce937c58fc1e",
                                "sense_id": "82165761-86cf-361e-97e4-e830fa81f532",
                                "text": "Das Grimmsche Wörterbuch stellt Goethes Verständnis von Urwort im Zusammenhang mit beiden Bedeutungen dar."
                            },
                            {
                                "example_id": "a9780ea0-46e7-4747-bf90-0482d7a02c69",
                                "sense_id": "82165761-86cf-361e-97e4-e830fa81f532",
                                "text": "„Die Urworte bezeichnen nicht verschiedene Offenbarungsarten des Schicksals, sondern, in der Einheit eines Schicksalszusammenhanges, eine Folge von vier Stufen von der Geburt bis zum Alter, die aufeinander und ineinander wirken und sich aneinander steigern.“"
                            },
                            {
                                "example_id": "033b5eba-ccb9-4410-bd31-d282e127460b",
                                "sense_id": "82165761-86cf-361e-97e4-e830fa81f532",
                                "text": "„Gerade weil sein Gegenstand empirischer Beobachtung entzogen ist, erhebt ein „Urwort“ das, was es bezeichnet, in den Rang eines Elementaren, aus dem alles Weitere und Spätere sich ableitet; es lässt eine Einheit und womöglich Reinheit imaginieren, die sich im historischen Verlauf differenzieren und verlieren.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
