                    {
                        "form_id": "bfbda0eb-307d-485c-bd57-487c00524428",
                        "entry_id": "2b5d365b-532f-3fd6-9203-24c807896cf4",
                        "tags": [],
                        "form": "lare"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "995a6179-f8f7-3133-b817-33ba935ba482",
                        "entry_id": "2b5d365b-532f-3fd6-9203-24c807896cf4",
                        "glosses": [
                            "een open plek in een bos"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ffb9f095-0975-42a5-9782-51952bbf0855",
                                "sense_id": "995a6179-f8f7-3133-b817-33ba935ba482",
                                "text": "Het laar was van bovenaf mooi te bezichtigen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2a6b6298-4759-499c-808c-2983d2a2d7f7",
                        "source_entry_id": "2b5d365b-532f-3fd6-9203-24c807896cf4",
                        "source_sense_id": "995a6179-f8f7-3133-b817-33ba935ba482",
                        "source_sense_description": "een open plek in een bos",
                        "target_lang_word": "Waldlichtung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Waldlichtung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d6f9e847-330c-3f0e-b650-d9d4396c9500",
                                        "entry_id": "1e26b8e5-2d58-3722-a96c-1d3965c134b8",
                                        "glosses": [
                                            "eine nicht mit Bäumen bewachsene Fläche in einem Wald"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e12d9c4-3c52-45c3-b842-abe540463329",
                                                "sense_id": "d6f9e847-330c-3f0e-b650-d9d4396c9500",
                                                "text": "„Wir saßen auf der Waldlichtung.“"
                                            },
                                            {
                                                "example_id": "aed83b7a-db16-4ad2-97ab-a0958a8a3d6a",
                                                "sense_id": "d6f9e847-330c-3f0e-b650-d9d4396c9500",
                                                "text": "„Dann nehme ich mir etwas zu essen mit und mache irgendwo auf einer lauschigen Waldlichtung ein Picknick.“"
                                            },
                                            {
                                                "example_id": "c9b7fd8c-67ee-4938-897c-764eb3f67d2d",
                                                "sense_id": "d6f9e847-330c-3f0e-b650-d9d4396c9500",
                                                "text": "„Darum tappe ich eines Tages geradewegs unter drei Russen, die auf einer Waldlichtung im Grase liegen und die Flaschen kreisen lassen.“"
                                            },
                                            {
                                                "example_id": "a12ee1a6-eb0d-459b-9633-2012c2bc2e58",
                                                "sense_id": "d6f9e847-330c-3f0e-b650-d9d4396c9500",
                                                "text": "„Pat und ich saßen am Rande einer Waldlichtung und frühstückten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bd85273d-2cf9-48e7-a672-80dc3cd39d98",
                        "source_entry_id": "2b5d365b-532f-3fd6-9203-24c807896cf4",
                        "source_sense_id": "995a6179-f8f7-3133-b817-33ba935ba482",
                        "source_sense_description": "een open plek in een bos",
                        "target_lang_word": "Lichtung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lichtung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "71615e3e-0e82-38bb-8083-5a9fa377644e",
                                        "entry_id": "63192385-c86c-32cd-9575-d7f03f4b55f3",
                                        "glosses": [
                                            "eine nicht mit Bäumen bewachsene Fläche in einem Wald"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa365447-0ee6-47e6-ab1a-b4372c5cc1cb",
                                                "sense_id": "71615e3e-0e82-38bb-8083-5a9fa377644e",
                                                "text": "Als sie die Lichtung betrat, wurde sie sofort von der Sonne geblendet."
                                            },
                                            {
                                                "example_id": "76dcad85-c71b-4f74-b413-a42e3fb848a7",
                                                "sense_id": "71615e3e-0e82-38bb-8083-5a9fa377644e",
                                                "text": "„Nachdem ich so die wertvollen Papiere sicher verwahrt hatte, rannte ich über die Lichtung weiter auf eine Stelle zu, wo ein Pfad abzugehen schien.“"
                                            },
                                            {
                                                "example_id": "1572cf64-3ef5-4120-92ac-a4fe58c7f338",
                                                "sense_id": "71615e3e-0e82-38bb-8083-5a9fa377644e",
                                                "text": "„Der Höhepunkt wurde von mehreren kleinen, separat stehenden Wäldern eingerahmt, die in ihrer Mitte eine Lichtung frei ließen, von der aus man die gesamte Umgebung überblicken konnte.“"
                                            },
                                            {
                                                "example_id": "fb0a90f8-7ba1-44a4-a108-4bd7f84597d3",
                                                "sense_id": "71615e3e-0e82-38bb-8083-5a9fa377644e",
                                                "text": "„Zwei Werst weit ritt man durch den Wald, dann gelangte man auf eine Lichtung.“"
                                            },
                                            {
                                                "example_id": "5ebe3b05-a5ef-44da-b874-87579f5e43bb",
                                                "sense_id": "71615e3e-0e82-38bb-8083-5a9fa377644e",
                                                "text": "„An manchen Tagen bekamst du das Land so gut hin, dass du zwischen den Holzstapeln hindurch auf die Lichtung und die Anhöhe gelangtest und die Hügel jenseits des Seitenarms des Sees sehen konntest.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d66ffffe-42cf-4476-8965-6a252ca000f8",
                        "source_entry_id": "2b5d365b-532f-3fd6-9203-24c807896cf4",
