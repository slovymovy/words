                        "glosses": [
                            "Celui, celle qui raille ; railleur, railleuse."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "530221be-fe09-4b98-9f1a-4b8b1a77dc4c",
                                "sense_id": "3e1a20b1-5ea1-38bb-8f44-d94363c96764",
                                "text": "— Mauvais raillard et faiseur de gausseries que vous êtes, dit Léandre, vous poussez ma modestie à bout."
                            },
                            {
                                "example_id": "5d0f4262-f5bb-4f73-882f-4f6e49035d8c",
                                "sense_id": "3e1a20b1-5ea1-38bb-8f44-d94363c96764",
                                "text": "C'est ainsi que les choses vont\nEt que les raillards fieffés font."
                            }
                        ]
                    }
