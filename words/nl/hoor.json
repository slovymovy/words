        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "dfaf5f91-e7d8-3f54-86d4-c8faac871180",
                    "sense_definition": "Een modaal partikel dat een uitspraak verzacht, geruststellend werkt of beleefdheid uitdrukt, vaak gebruikt bij ontkenningen of instemmingen",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "modal_particle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nee <w>hoor</w>, je hoeft je daar echt geen zorgen over te maken.",
                            "target_lang_translations": {
                                "en": "No <w>really</w>, you don't have to worry about that at all.",
                                "ru": "Нет, <w>правда</w>, тебе совсем не нужно об этом беспокоиться.",
                                "it": "No <w>davvero</w>, non devi affatto preoccuparti per questo."
                            }
                        },
                        {
                            "text": "Je mag mijn fiets vanmiddag wel even lenen <w>hoor</w>.",
                            "target_lang_translations": {
                                "en": "You can borrow my bike this afternoon, <w>sure</w>.",
                                "ru": "Ты можешь одолжить мой велосипед сегодня днем, <w>конечно</w>.",
                                "it": "Puoi prendere in prestito la mia bici questo pomeriggio, <w>tranquillo</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "nee hoor",
                        "ja hoor",
                        "kom maar hoor"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "typical for spoken language"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Modal particle used to soften a statement, reassure, or express politeness",
                        "ru": "Модальная частица, используемая для смягчения высказывания, успокоения или выражения вежливости",
                        "it": "Particella modale usata per attenuare un'affermazione, rassicurare o esprimere cortesia"
