                ],
                "translations": [
                    {
                        "translation_id": "21b4853c-c417-4f83-aad4-0b26b2f75247",
                        "source_entry_id": "612e9bbe-a669-3578-a937-0f1b5bde9210",
                        "source_sense_id": "f804475e-0ae5-3fa4-9d84-fb32221cb38c",
                        "target_lang_word": "Wissenschaftlerin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wissenschaftlerin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a6e11190-5e39-30b2-8595-09168fefb05e",
                                        "entry_id": "f9b2dca4-f459-3e1a-80a5-06ad87a7e1c9",
                                        "glosses": [
                                            "weibliche Person, die sich mit der Wissenschaft befasst"
                                        ],
                                        "tags": [
                                            "Beruf",
                                            "Forschung",
                                            "Wissenschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ce12ac04-7bec-4fb3-890a-c2ce74dba3ac",
                                                "sense_id": "a6e11190-5e39-30b2-8595-09168fefb05e",
                                                "text": "„«Solche Untersuchungen seien unter anderem wichtig für die Überwachung von genmodifizierten Pflanzen. Insgesamt kennen wir heute über 100 000 Arten von Pilzen», erläuterte Wissenschaftlerin Janine Fröhlich von der Uni Mainz. Hochrechnungen gingen aber davon aus, dass es mehr als 1,5 Millionen Arten gibt.“"
                                            },
                                            {
                                                "example_id": "aed03e3a-9715-451d-b491-07392fc75ef0",
                                                "sense_id": "a6e11190-5e39-30b2-8595-09168fefb05e",
                                                "text": "„Die Wissenschaftlerin macht immer wieder auch vor Ort die Erfahrung, dass Menschen sehr unterschiedlich auf Risiken reagieren.“"
                                            },
                                            {
                                                "example_id": "c9108e17-8cae-416a-877c-77766e82dbfb",
                                                "sense_id": "a6e11190-5e39-30b2-8595-09168fefb05e",
                                                "text": "„Einige Tage zuvor sollte eine junge Wissenschaftlerin in der Bergwelt der Anden eine weitreichende Entdeckung machen.“"
                                            },
                                            {
                                                "example_id": "c1b1b63a-b682-4548-b0da-a086f1391bbe",
                                                "sense_id": "a6e11190-5e39-30b2-8595-09168fefb05e",
                                                "text": "„Denn wenn wir unsere Institutionen durch vermehrten Austausch bereichern, so können wir in Zukunft die Studierenden und jungen Wissenschaftlerinnen und Wissenschaftler weniger fachbegrenzt ausbilden und eine Öffnung in verschiedene Wissensfelder fördern, die mit unterschiedlichen Inhalten und Methoden arbeiten, aber immer eine Bereicherung darstellen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
