                        "chuter à vélo"
                    ]
                },
                {
                    "sense_id": "bfb5cd81-fd10-33ff-add3-d4f9c94af350",
                    "sense_definition": "Diminuer brusquement et fortement en valeur, en nombre ou en intensité.",
