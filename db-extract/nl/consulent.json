                "translations": [
                    {
                        "translation_id": "4a2c5120-8d58-400d-aa33-01c295f1deff",
                        "source_entry_id": "9d2bd45d-f634-329f-ab7c-e78eda5fa4cb",
                        "source_sense_id": "b03264d5-57ac-3ecf-8bfe-6f2733add937",
                        "source_sense_description": "een deskundige raadgever",
                        "target_lang_word": "Berater",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Berater",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dc25f2c1-1014-3129-b5f1-37a8005bab66",
                                        "entry_id": "55813e13-6489-3ead-9d94-5df92a7da5a1",
                                        "glosses": [
                                            "nachweislich qualifizierte, fachkompetente oder beauftragte (männliche^☆) Person, die themenspezifisch und vertrauensvoll Rat suchende Personen berät"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e096ddeb-94a6-4b08-a2b0-ae2b46a4ec67",
                                                "sense_id": "dc25f2c1-1014-3129-b5f1-37a8005bab66",
                                                "text": "Hans ist Spezialist auf seinem Fachgebiet und mein persönlicher Berater, wenn es um die Rosen im Garten geht."
                                            },
                                            {
                                                "example_id": "9eeb4210-520d-4804-a615-9c09170c27c2",
                                                "sense_id": "dc25f2c1-1014-3129-b5f1-37a8005bab66",
                                                "text": "Für externe Firmenberater muss es – im Interesse des zu beratenden Unternehmers – so geregelt sein, dass vertrauliche Informationen zum Unternehmen nicht durch einen Berater anderweitig verwertet werden."
                                            },
                                            {
                                                "example_id": "214dea7c-0d80-4539-8f73-7bda75f353aa",
                                                "sense_id": "dc25f2c1-1014-3129-b5f1-37a8005bab66",
                                                "text": "„Man wird hier zugeben müssen, daß meine Position als Berater wieder äußerst prekär zu werden begann.“"
                                            },
                                            {
                                                "example_id": "ef9751ab-de79-450f-abf0-4780229bd5eb",
                                                "sense_id": "dc25f2c1-1014-3129-b5f1-37a8005bab66",
                                                "text": "„Doch Afrika wird von Beratern aus dem Ausland heimgesucht.“"
                                            },
                                            {
                                                "example_id": "29d224bb-608a-497d-8645-a0b96abe997f",
                                                "sense_id": "dc25f2c1-1014-3129-b5f1-37a8005bab66",
                                                "text": "„Manche Berater Trumans rieten von der Anwendung der Bombe ab.“"
                                            },
                                            {
                                                "example_id": "cfb131cd-d7bb-420a-9521-fe562b596612",
                                                "sense_id": "dc25f2c1-1014-3129-b5f1-37a8005bab66",
                                                "text": "„In Carl Augusts Fall müssen Erzieher und Berater den Vater ersetzen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
