                "senses": [
                    {
                        "sense_id": "5d78c281-95a3-3eed-9c86-e00e9aae7b3c",
                        "entry_id": "207c2415-1819-38af-80dd-20cf45e85ad7",
                        "glosses": [
                            "das T-förmige Kreuz des heiligen Einsiedlers Antonius"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d569011-b3ed-4080-bf43-c41a1434b683",
                                "sense_id": "5d78c281-95a3-3eed-9c86-e00e9aae7b3c",
                                "text": "Auf unserer Abbildung hält Antonius einen langen Stab mit einem Taukreuz, oder, wie es auch genannt wurde, einem Antoniuskreuz (T)."
                            },
                            {
                                "example_id": "ab2965fc-f958-462c-a67b-a4637238bf36",
                                "sense_id": "5d78c281-95a3-3eed-9c86-e00e9aae7b3c",
                                "text": "Das TAU ist der Anfangsbuchstabe der Thora, dem Mosaischen Gesetz der Juden und das TAU-Kreuz, wie das T genannt wird, gilt auch heute noch in der jüdischen und in der christlichen Symbolik als Erkennungszeichen Gottes."
                            },
                            {
                                "example_id": "41c5effa-98cd-4644-ac65-9068fb239e0e",
                                "sense_id": "5d78c281-95a3-3eed-9c86-e00e9aae7b3c",
                                "text": "Eine Siegeskrone über dem Taukreuz, eine im frühen Christentum übliche Kombination, legt den Vergleich mit dem Ankhzeichen nahe."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
