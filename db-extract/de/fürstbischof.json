                                        "sense_id": "2c8237ac-0c9f-32da-9f18-5a6b826c2b09",
                                        "entry_id": "a252d63a-6b6a-37ef-9fda-e5e58e8a8d4b",
                                        "glosses": [
                                            "christelijke geestelijke die naast de geestelijke macht over een bisdom, ook wereldlijke macht heeft over een bepaald territorium"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
