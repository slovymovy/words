                    {
                        "form_id": "c92aa15f-2354-4bb8-a364-1bdfd1d5d57b",
                        "entry_id": "7fa532c5-7eb3-3969-ae75-202cd49c3992",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Dreckslöcher"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e278b1aa-762c-3d02-9b6f-27a149319ee6",
                        "entry_id": "7fa532c5-7eb3-3969-ae75-202cd49c3992",
                        "glosses": [
                            "sehr schmutziger meist ärmlicher Ort, an dem man lebt, beispielsweise ein Zimmer, eine Wohnung, ein Stadtviertel, eine Stadt"
                        ],
                        "tags": [
                            "colloquial",
                            "derogatory",
                            "impolite"
                        ],
                        "examples": [
                            {
                                "example_id": "a294f248-4c48-4d95-8d0b-8a7d6dcca274",
                                "sense_id": "e278b1aa-762c-3d02-9b6f-27a149319ee6",
                                "text": "„Viele Menschen sind von dem Müllproblem regelrecht angewidert: »Der Müll ekelt mich an. Es wird von Jahr zu Jahr schlimmer. Unser einstmals so schönes Kinshasa ist zu einem großen Drecksloch verkommen«, sagt eine Frau zur DW.“"
                            },
                            {
                                "example_id": "003cbb2d-3fa4-4b3d-9d2a-6ff15d360c27",
                                "sense_id": "e278b1aa-762c-3d02-9b6f-27a149319ee6",
                                "text": "[Luanda:] „»Doch der größte Teil dieser Stadt ist ein einziges Drecksloch, um es krass zu formulieren.«“"
                            },
                            {
                                "example_id": "2b16fd7d-ff41-44a1-badc-d73fb84473ae",
                                "sense_id": "e278b1aa-762c-3d02-9b6f-27a149319ee6",
                                "text": "„Sie findet es spannend zu sehen, dass das heute so lebenswerte Wien »vor weniger als hundert Jahren ein Drecksloch war mit Null Lebensqualität«.“"
                            },
                            {
                                "example_id": "9c4e6035-ab84-4d07-938e-f1e032b623f2",
                                "sense_id": "e278b1aa-762c-3d02-9b6f-27a149319ee6",
                                "text": "„Ich will raus aus diesem Drecksloch.“"
                            },
                            {
                                "example_id": "1347534f-9862-4c87-9d6a-508ae4a90ec0",
                                "sense_id": "e278b1aa-762c-3d02-9b6f-27a149319ee6",
                                "text": "„Gleichzeitig wird Trump Rassismus vorgeworfen. Zuletzt attackierte er auch mehrfach afroamerikanische Politiker, Politikerinnen und Geistliche und nannte den mehrheitlich von Schwarzen bewohnten Wahlkreis Baltimore »ein von Ratten und Nagetieren befallenes Drecksloch«.“"
                            },
                            {
                                "example_id": "ff86d317-26a8-45ed-b1c1-8a78e6365a69",
                                "sense_id": "e278b1aa-762c-3d02-9b6f-27a149319ee6",
                                "text": "„In der chaotisch gewachsenen Stadt grassierten Gewalt, Prostitution und Frauenhandel. «Wir machen wirklich mit jedem Drecksloch Geschäfte», kommentiert er die Tatsache, dass Gold aus «La Rinconada» auch in der Schweiz verarbeitet wird.“"
                            },
                            {
                                "example_id": "59e20a07-2637-4c37-ae2e-1fbd47f0d0e4",
                                "sense_id": "e278b1aa-762c-3d02-9b6f-27a149319ee6",
                                "text": "„Uxbal (Javier Bardem) lebt mit seinen beiden Kindern in einem heruntergekommenen Viertel von Barcelona in einem «Drecksloch» von Wohnung.“"
                            },
                            {
                                "example_id": "09d32b12-da3a-46db-910e-5d1bfebd754a",
                                "sense_id": "e278b1aa-762c-3d02-9b6f-27a149319ee6",
                                "text": "„Frances’ alkoholkranker Vater wohnt allein in einem Drecksloch und vergisst immer wieder, seiner Tochter Geld zu überweisen.“"
                            },
                            {
                                "example_id": "7a55ca59-3dc1-41eb-b6a1-de8264d55136",
                                "sense_id": "e278b1aa-762c-3d02-9b6f-27a149319ee6",
                                "text": "„Nebenan logieren die afghanischen Polizisten. Es ist ein Drecksloch ohne fließend Wasser und Strom, mit sechs Dixie- Klos für 160 Mann. Ratten und Mäuse nagen an den Vorräten. Der Schimmel blüht an den Decken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0505bab5-32c8-4d3f-b292-307ad9a43dfe",
                        "source_entry_id": "7fa532c5-7eb3-3969-ae75-202cd49c3992",
                        "source_sense_id": "e278b1aa-762c-3d02-9b6f-27a149319ee6",
                        "source_sense_description": "sehr schmutziger meist ärmlicher Ort, an dem man lebt",
                        "target_lang_word": "hellhole",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hellhole",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f966296c-f9b0-3fc7-b6b9-d9a6afe8bff5",
                                        "entry_id": "e62c801b-dd30-3274-a8ca-e4353b331aa0",
                                        "glosses": [
                                            "A place of intense hatred, misery, or turmoil."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "idiomatic",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9160c209-8a4d-46f4-b9f7-9d28a1470f8b",
                                                "sense_id": "f966296c-f9b0-3fc7-b6b9-d9a6afe8bff5",
                                                "text": "Once the Old Nichol had been razed, the search was on for London's new hell hole."
                                            },
                                            {
                                                "example_id": "3dfe9afb-37c3-4682-95d4-d0176141f225",
                                                "sense_id": "f966296c-f9b0-3fc7-b6b9-d9a6afe8bff5",
                                                "text": "Despite prolonged exposure to harsh conditions, medics say Nora Tallis returned to the Nexus in stable condition. In a statement to HNS, Tallis did not mince words. \"Never send me to that hellhole again.\""
                                            },
                                            {
                                                "example_id": "fa7d1202-bd90-4d2e-b5d2-05f82a3bd4b5",
                                                "sense_id": "f966296c-f9b0-3fc7-b6b9-d9a6afe8bff5",
                                                "text": "Indeed, we happily condemn damaged children—at enormous expense—to hellholes like Feltham, where they are more likely to be assaulted or killed than to find an escape from the revolving doors of courts, prisons and addiction."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "968be382-0fee-4f08-8522-a142e28f2745",
                        "source_entry_id": "7fa532c5-7eb3-3969-ae75-202cd49c3992",
                        "source_sense_id": "e278b1aa-762c-3d02-9b6f-27a149319ee6",
                        "source_sense_description": "sehr schmutziger meist ärmlicher Ort, an dem man lebt",
                        "target_lang_word": "shithole",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "shithole",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c6f729bd-074e-3ec7-9c80-65236df0eb68",
                                        "entry_id": "9cce2dda-01ab-361c-8c3a-5308354364d9",
                                        "glosses": [
                                            "The anus."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "literally",
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bcf2eec5-184c-464a-a2d9-275f4c45a3fe",
                                                "sense_id": "c6f729bd-074e-3ec7-9c80-65236df0eb68",
                                                "text": "\"You know,\" he said at last, \"I wish you'd just look how that little dog's shithole opens up every time he barks.\""
                                            },
                                            {
                                                "example_id": "73540d70-59ca-4b3d-b6d7-ce0eb45b3bb7",
                                                "sense_id": "c6f729bd-074e-3ec7-9c80-65236df0eb68",
                                                "text": "“When it come,” Jamal said, “we just gotta pray suckas don't go mad dog—tearin' each other whole new shitholes.”"
                                            },
                                            {
                                                "example_id": "21765a59-ec4f-4ecb-b159-fc3c2d587ac7",
                                                "sense_id": "c6f729bd-074e-3ec7-9c80-65236df0eb68",
                                                "text": ". In 'The Shit Sermon', where a drunk delivers a philippic against Bombay, shit pervades the text, and is in fact irreverently correlated with God: God is great, he says. He has given all his creatures, great and small, two holes: a feedhole and a shithole, and he will provide ."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e85f9270-82ad-378c-8fc8-97032c954b21",
                                        "entry_id": "9cce2dda-01ab-361c-8c3a-5308354364d9",
                                        "glosses": [
                                            "The anus.",
                                            "A wretched or despicable person."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "literally",
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba9dd885-619e-48a7-833f-cce9f7d3ba73",
                                                "sense_id": "e85f9270-82ad-378c-8fc8-97032c954b21",
                                                "text": ". \"What a sorry-looking son-of-a-bitch,\" said one of the officers. \"We aren't going to win this war with shitholes like this out there.\""
                                            },
                                            {
                                                "example_id": "00ed336e-c6c6-4dbe-bb62-bc37cdf8308f",
                                                "sense_id": "e85f9270-82ad-378c-8fc8-97032c954b21",
                                                "text": "That girl, I've known her since we were teenagers, a sweeter, more innocent decent girl you couldn't wish to find .And you've dirtied her, you shithole."
                                            },
                                            {
                                                "example_id": "61b0ccb9-21f0-4b77-aa1b-bbe09fb10381",
                                                "sense_id": "e85f9270-82ad-378c-8fc8-97032c954b21",
                                                "text": "He did it by finding the best. The players that other teams had forgotten, ignored or dismissed as past their best. Then I would scream, kick their arses, motivate the shitholes and care for them in equal measures."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b953d6d-9541-3770-95f9-14d8fb5e99d3",
                                        "entry_id": "9cce2dda-01ab-361c-8c3a-5308354364d9",
                                        "glosses": [
                                            "A hole into which one defecates or dumps excrement."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "literally",
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "66523169-2d12-43a7-bea5-52361936bcb0",
                                                "sense_id": "4b953d6d-9541-3770-95f9-14d8fb5e99d3",
                                                "text": "Two of them were dragging a new member of the dead towards the cart by the shithole."
                                            },
                                            {
                                                "example_id": "26a46d60-15cc-4e3d-a805-541976b33d10",
                                                "sense_id": "4b953d6d-9541-3770-95f9-14d8fb5e99d3",
                                                "text": "Too tired to run anymore. Hungry for the end. His feet scrambled. Like a cat digging a shithole."
                                            },
                                            {
                                                "example_id": "c1813359-6642-4a91-9740-370a9b8abf89",
                                                "sense_id": "4b953d6d-9541-3770-95f9-14d8fb5e99d3",
                                                "text": "Perhaps Derrida is recalling Rembrandt's drawing Abraham's Sacrifice. If this is the work of art, why \"tear it to pieces\" (dechirer) and ram it down the shithole? Is Abraham, father of the Jewish faith, a shit, perhaps the shit that the System proper must flush away?"
                                            },
                                            {
                                                "example_id": "409761f4-0f38-4c6e-a773-bfb9beae23d3",
                                                "sense_id": "4b953d6d-9541-3770-95f9-14d8fb5e99d3",
                                                "text": "Two Roman soldiers digging latrines joke about later recounting the experience to their children back home, the ritual of having 'dug a shithole on the edge of the world'."
                                            },
                                            {
                                                "example_id": "028638ca-1127-4841-a21d-4cd55485666f",
                                                "sense_id": "4b953d6d-9541-3770-95f9-14d8fb5e99d3",
                                                "text": "The latrine is bright white and clean to a fault, an almost garish contrast to the dark, hardscrabble forward operating base just beyond the metal doors. The two young soldiers are shaving at the long line of sinks and mirrors. One says, \"Man, I had a dream last night I was in the shithole.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "39de8948-54f4-3aad-8aa7-a23a49874713",
                                        "entry_id": "9cce2dda-01ab-361c-8c3a-5308354364d9",
                                        "glosses": [
                                            "A hole into which one defecates or dumps excrement.",
                                            "A very dirty, poor, and unpleasant place."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "figuratively",
                                            "literally",
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "552bf7e9-b50a-481f-a6a3-42ec4bc64eb4",
                                                "sense_id": "39de8948-54f4-3aad-8aa7-a23a49874713",
                                                "text": "Isn't it enough I sit in this shithole week after week?— wanting to go home and knowing there's not a damn thing to go home to?"
                                            },
                                            {
                                                "example_id": "792cf3ef-dfbd-4a65-b052-8de2b5839627",
                                                "sense_id": "39de8948-54f4-3aad-8aa7-a23a49874713",
                                                "text": "“What is this shithole?” General Villa was disgusted with his accommodations."
                                            },
                                            {
                                                "example_id": "a2051eec-fc01-4078-9921-7b06823591ee",
                                                "sense_id": "39de8948-54f4-3aad-8aa7-a23a49874713",
                                                "text": "Why are we having all these people from shithole countries come here?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d5e1f61b-5bdd-3c45-8668-2d693a7c990e",
                                        "entry_id": "9cce2dda-01ab-361c-8c3a-5308354364d9",
                                        "glosses": [
                                            "A hole into which one defecates or dumps excrement.",
                                            "A dysfunctional state."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "figuratively",
                                            "literally",
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c315a6b1-9e24-4267-8dc8-1a34c9ba5cd4",
                                                "sense_id": "d5e1f61b-5bdd-3c45-8668-2d693a7c990e",
                                                "text": "God is pulling me up and up and away from this shithole of a life, and as I get pulled up through the water I think, Mum and Dad, I'll miss you."
                                            },
                                            {
                                                "example_id": "ec1c3982-a72a-4dde-b223-0790efe6d78b",
                                                "sense_id": "d5e1f61b-5bdd-3c45-8668-2d693a7c990e",
                                                "text": "The economy is in the shithole, unemployment is 30-something %, I have no savings, no alternate plan . . . and I'rn going to quit my job. And you know what? It's going to feel damned good."
                                            },
                                            {
                                                "example_id": "f428e89a-2ac3-4a78-97d7-06299c0abb78",
                                                "sense_id": "d5e1f61b-5bdd-3c45-8668-2d693a7c990e",
                                                "text": "Once your two weeks are over, you will soon be back at that shithole of a job, mixing with all the lowlife sheep of this earth."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
