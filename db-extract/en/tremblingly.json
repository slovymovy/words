                            {
                                "example_id": "9842990a-6b33-4f00-9547-facae7ca4197",
                                "sense_id": "6c716072-f0be-368f-9813-4089c56899b7",
                                "text": "[T]he sailors tremblingly / Call on the Twins of Jove with prayer and vow, / Gathered in fear upon the lofty prow, / And sacrifice with snow-white lambs, […]"
                            },
                            {
                                "example_id": "9fff878a-ce03-43bd-8b35-5140f0881f8e",
                                "sense_id": "6c716072-f0be-368f-9813-4089c56899b7",
                                "text": "Andrew, he said, was coming soon. Tremblingly she wondered when, and went to reread Palmer's letter, but though she had hidden it with her father's unread will, both were gone."
                            }
                        ]
                    }
