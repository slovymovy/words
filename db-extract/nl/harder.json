                "forms": [],
                "senses": [
                    {
                        "sense_id": "14ce9db4-6b7f-397f-95a5-5d4da474f3b9",
                        "entry_id": "ef2f83fd-0f04-3ab8-9971-698d6c0c56f6",
                        "glosses": [
                            "met steeds grotere snelheid"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c294a861-a116-4fee-a4a9-54a23ff06125",
                                "sense_id": "14ce9db4-6b7f-397f-95a5-5d4da474f3b9",
                                "text": "Studenten en promovendi met veel kennis van onder meer kritieke grondstoffen zijn hard nodig voor de energietransitie, zegt men ook buiten de muren van de VU. De ongeveer tachtig bachelor- en masterstudenten die de studie in Amsterdam jaarlijks trekt, zijn harder nodig dan ooit, klinkt het. Ook bijvoorbeeld voor de opslag van CO2 onder de grond en kustbescherming is hun kennis nodig."
                            },
                            {
                                "example_id": "8cd19528-daf6-4806-b8e5-d1120404adaf",
                                "sense_id": "14ce9db4-6b7f-397f-95a5-5d4da474f3b9",
                                "text": "Doordat de wind steeds harder begon te waaien, stak ik om de paar minuten mijn hoofd uit mijn tent om te zien of de wolken groter werden of juist niet."
                            }
                        ]
                    },
                    {
                        "sense_id": "2a9b5bb3-250c-3734-adff-9078a39d61ba",
                        "entry_id": "ef2f83fd-0f04-3ab8-9971-698d6c0c56f6",
                        "glosses": [
                            "met een toenemende geluidssterkte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a385d7f-2f17-4b93-a5a8-0405c216aa8f",
                                "sense_id": "2a9b5bb3-250c-3734-adff-9078a39d61ba",
                                "text": "Zij moest steeds harder praten om boven de herrie uit te komen."
                            }
                        ]
                    },
                    {
                        "sense_id": "b1f7b1c9-2aac-3c0f-a020-4b4c0403b24b",
                        "entry_id": "ef2f83fd-0f04-3ab8-9971-698d6c0c56f6",
                        "glosses": [
