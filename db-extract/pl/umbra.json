                        ],
                        "examples": [
                            {
                                "example_id": "b7552a60-1fa3-44e4-9836-3eb051f93462",
                                "sense_id": "aca3711f-7945-3550-b4ce-504d0148174e",
                                "text": "Starcie kurzu ze starych umbr zajęło jej pół godziny."
                            }
                        ],
                        "sense_index_json": "\"1.7\""
                    }
