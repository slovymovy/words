                "senses": [
                    {
                        "sense_id": "a41a22e4-c0c2-3dea-983e-3b9bf23a5cf6",
                        "entry_id": "d06a32d2-e241-36f3-9857-730a6519abb4",
                        "glosses": [
                            "geometrische Figur mit dreizehn Ecken"
                        ],
                        "tags": [
                            "geometry"
                        ],
                        "examples": [
                            {
                                "example_id": "8d5a6519-b19f-4dac-94f3-a0a4c9f30c42",
                                "sense_id": "a41a22e4-c0c2-3dea-983e-3b9bf23a5cf6",
                                "text": "Das regelmäßige Dreizehneck ist kein konstruierbares Polygon."
                            },
                            {
                                "example_id": "65f1794d-0735-4d78-bcc4-ce4ff199d4f2",
                                "sense_id": "a41a22e4-c0c2-3dea-983e-3b9bf23a5cf6",
                                "text": "„Ausgangspunkt seiner Arbeiten sind gleichmäßige Vielecke, vom Dreieck bis zum Dreizehneck.“"
                            },
                            {
                                "example_id": "f64cb008-848e-44e4-8487-8c58ca67afe7",
                                "sense_id": "a41a22e4-c0c2-3dea-983e-3b9bf23a5cf6",
                                "text": "„Das Büdinger Schloss (Oberhessen) wäre ein wichtiges Beispiel aus romanischer Zeit, ein schon annähernd kreisähnliches Dreizehneck, von Wasser umgeben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
