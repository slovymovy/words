                                    {
                                        "sense_id": "07095216-18f7-3754-91e1-3d660c86692c",
                                        "entry_id": "f2898750-9b3e-32a4-901e-8ef9542230f9",
                                        "glosses": [
                                            "Supresión de una letra o sílaba entre dos palabras o dentro de una palabra; a veces se marca con un apóstrofo."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "582bb14b-ae92-4d10-b247-3148504ca7d7",
                                                "sense_id": "07095216-18f7-3754-91e1-3d660c86692c",
                                                "text": "En la secuencia \"de el\" en español, hay elisión de la primera \"e\" para crear la contracción \"del."
                                            }
                                        ],
