                            {
                                "target_lang_word": "трахнуться",
                                "target_lang_sense_clarification": "разг., с силой"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9073e7ba-8b6a-3250-b0e2-7879e556e6b8",
                    "sense_definition": "To have sexual intercourse with someone.",
