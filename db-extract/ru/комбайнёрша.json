                "senses": [
                    {
                        "sense_id": "19005ad3-6604-31b8-a48b-7bfcbac99742",
                        "entry_id": "3f0c5589-bcb6-3ac2-8ed6-c5f3028f5415",
                        "glosses": [
                            "разг. женщина водитель сельскохозяйственного уборочного комбайна, то же что комбайнерка"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d17ef3f-bcd9-4a57-a7a7-1300779b08f9",
                                "sense_id": "19005ad3-6604-31b8-a48b-7bfcbac99742",
                                "text": "А ежели дояркой не хотите — мы вас комбайнёршей устроим!"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6eb072a9-fb33-4390-9330-926cdd738f29",
                        "source_entry_id": "3f0c5589-bcb6-3ac2-8ed6-c5f3028f5415",
                        "source_sense_id": "19005ad3-6604-31b8-a48b-7bfcbac99742",
                        "target_lang_word": "combine",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "combine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d731bc01-dd85-361c-9e80-855268c0971a",
                                        "entry_id": "318cc14e-041d-3898-8c3a-cf32bf3c8f2f",
                                        "glosses": [
                                            "To bring (two or more things or activities) together; to unite."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "711b9600-9265-4f7a-b2e4-ea8f12ea00db",
                                                "sense_id": "d731bc01-dd85-361c-9e80-855268c0971a",
                                                "text": "Combine the milk and the hot water in a large bowl."
                                            },
                                            {
                                                "example_id": "b11ff1cf-80f6-4361-83e4-99b1b26152f0",
                                                "sense_id": "d731bc01-dd85-361c-9e80-855268c0971a",
                                                "text": "I'm combining business and pleasure on this trip."
                                            },
                                            {
                                                "example_id": "f5fa3578-8b44-42b3-a2a8-998c93f943a3",
                                                "sense_id": "d731bc01-dd85-361c-9e80-855268c0971a",
                                                "text": "Conditions were horrendous aboard most British naval vessels at the time. Scurvy and other diseases ran rampant, killing more seamen each year than all other causes combined, including combat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2286c623-13b1-324f-8e2c-4faed473fbc2",
                                        "entry_id": "318cc14e-041d-3898-8c3a-cf32bf3c8f2f",
                                        "glosses": [
                                            "To have two or more things or properties that function together."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eaf96ecc-4578-43d7-8585-e30286006b90",
                                                "sense_id": "2286c623-13b1-324f-8e2c-4faed473fbc2",
                                                "text": "Joe combines the intelligence of a rock with the honesty of a politician."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2cd7f16d-d668-3d30-a07a-7cd27d71512e",
                                        "entry_id": "318cc14e-041d-3898-8c3a-cf32bf3c8f2f",
                                        "glosses": [
                                            "To come together; to unite."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e44def1b-103c-45e9-8f1f-6bb4ecb49e85",
                                                "sense_id": "2cd7f16d-d668-3d30-a07a-7cd27d71512e",
                                                "text": "two substances that easily combine"
                                            },
                                            {
                                                "example_id": "2c86334a-e630-4ee1-a7ce-2cf5c19434fb",
                                                "sense_id": "2cd7f16d-d668-3d30-a07a-7cd27d71512e",
                                                "text": "You with your foes combine, / And seem your own destruction to design."
                                            },
                                            {
                                                "example_id": "8c321e81-993e-45b5-9d4e-c6bf6fb6413b",
                                                "sense_id": "2cd7f16d-d668-3d30-a07a-7cd27d71512e",
                                                "text": "So sweet did harp and voice combine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5af3fdfc-8ba9-3e33-9cd7-6b757da4bd23",
                                        "entry_id": "318cc14e-041d-3898-8c3a-cf32bf3c8f2f",
                                        "glosses": [
                                            "In the game of casino, to play a card which will take two or more cards whose aggregate number of pips equals those of the card played."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b325c78a-673c-32bd-ae38-a38d1a61d51f",
                                        "entry_id": "318cc14e-041d-3898-8c3a-cf32bf3c8f2f",
                                        "glosses": [
                                            "To bind; to hold by a moral tie."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6e395ff8-975e-4af7-8534-4544bac2659f",
                                                "sense_id": "b325c78a-673c-32bd-ae38-a38d1a61d51f",
                                                "text": "I am combined by a sacred vow."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "combine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7c69fec6-489e-3c8c-beec-ed43ba03ff9f",
                                        "entry_id": "55574eed-2918-391d-89ed-ecbcf0ea762d",
                                        "glosses": [
                                            "Ellipsis of combine harvester."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e37f25df-7280-4932-ac09-69bc49bd31f4",
                                                "sense_id": "7c69fec6-489e-3c8c-beec-ed43ba03ff9f",
                                                "text": "We can't finish harvesting because our combine is stuck in the mud."
                                            },
                                            {
                                                "example_id": "ca29bf01-720f-4496-a93f-fd1c3d88428c",
                                                "sense_id": "7c69fec6-489e-3c8c-beec-ed43ba03ff9f",
                                                "text": "When those combine wheels stops turnin'\nAnd the hard days work is done\nTheres a pub around the corner\nIt's the place we 'ave our fun"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2f33dcfa-7197-38eb-9e7a-b02142a431de",
                                        "entry_id": "55574eed-2918-391d-89ed-ecbcf0ea762d",
                                        "glosses": [
                                            "A combination.",
                                            "Especially, a joint enterprise of whatever legal form for a purpose of business or in any way promoting the interests of the participants, sometimes with monopolistic or fraudulent intentions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ac7504a-a631-4ca1-9c16-bd53228b099d",
                                                "sense_id": "2f33dcfa-7197-38eb-9e7a-b02142a431de",
                                                "text": "The telecom companies were accused of having formed an illegal combine in order to hike up the network charges."
                                            },
                                            {
                                                "example_id": "984844a0-2bea-4357-9532-b1c32994a91e",
                                                "sense_id": "2f33dcfa-7197-38eb-9e7a-b02142a431de",
                                                "text": "[In the decades before the First World War] In the USA and Germany in particular, huge manufacturing combines were being created and were developing a very powerful economic and increasingly political presence at home and on international markets."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9d5ea4ba-1588-379b-8c9e-1fdd1d97c057",
                                        "entry_id": "55574eed-2918-391d-89ed-ecbcf0ea762d",
                                        "glosses": [
                                            "A combination.",
                                            "An industrial conglomeration in a socialist country, particularly in the former Soviet bloc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "39603426-b894-4e36-9442-80bf5975fdce",
                                                "sense_id": "9d5ea4ba-1588-379b-8c9e-1fdd1d97c057",
                                                "text": "His grandmother worked in the stamping plant of the sheet and tin combine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f7b4d99b-a37b-350f-90f0-4fb99426ec21",
                                        "entry_id": "55574eed-2918-391d-89ed-ecbcf0ea762d",
                                        "glosses": [
                                            "A combination.",
                                            "An artwork falling between painting and sculpture, having objects embedded into a painted surface."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "43717a1d-17cd-3336-9de0-f6237b7466bb",
                                        "entry_id": "55574eed-2918-391d-89ed-ecbcf0ea762d",
                                        "glosses": [
                                            "Ellipsis of combine car, a type of railway car that combines passenger and freight functions."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "ellipsis"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "02027e5b-b536-3bfb-944f-a91d30564791",
                                        "entry_id": "55574eed-2918-391d-89ed-ecbcf0ea762d",
                                        "glosses": [
                                            "A test match in which applicants play in the hope of earning a position on a professional football team."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8af24b88-7f09-4cc1-9115-4d28d74a47d4",
                                                "sense_id": "02027e5b-b536-3bfb-944f-a91d30564791",
                                                "text": "If you purchased this book chances are that you are planning on participating in a football combine or pro-day test."
                                            },
                                            {
                                                "example_id": "10cfee79-c194-4948-9f6a-48908b591ab7",
                                                "sense_id": "02027e5b-b536-3bfb-944f-a91d30564791",
                                                "text": "In 2008, a study was published that examined the ability of the NFL combine to predict football playing performance in the NFL (Kuzmits and Adams, 2008)."
                                            },
                                            {
                                                "example_id": "7a05aea4-6b06-4857-87ff-822b3e9e9314",
                                                "sense_id": "02027e5b-b536-3bfb-944f-a91d30564791",
                                                "text": "At the combine, Reagor compared himself to the 49ers’ Deebo Samuel or Chiefs’ Tyreek Hill — whom he said he watched “every day”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
