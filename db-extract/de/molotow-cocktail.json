                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c7c094f9-555e-4834-91f3-ff77dd543360",
                                "sense_id": "58829083-95f3-39af-bfe6-be9d3c53ab4e",
                                "text": "„Hunderttausende kamen ins Kiewer Zentrum nicht nur, um zu demonstrieren. Sie schmierten Schmalzbrote, schenkten Tee aus, hielten in der Nacht Wache, warfen Molotow-Cocktails und machten Musik - und das alles freiwillig.“"
                            },
                            {
                                "example_id": "af9f7714-b6f2-401c-965c-566532e3417d",
                                "sense_id": "58829083-95f3-39af-bfe6-be9d3c53ab4e",
                                "text": "„Aber diese Geisteshaltung steckt genauso hinter Genfeldzerstörungen, Hausbesetzungen, Molotow-Cocktails und jahrzehntelanger Fernsehfolter durch »Das Wort zum Sonntag«.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
