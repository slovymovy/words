                "translations": [
                    {
                        "translation_id": "943fbfcd-0c43-4113-9ce3-1876f5c2f756",
                        "source_entry_id": "70adde9c-0c05-3d90-b97b-197aab0efc4d",
                        "source_sense_id": "d17e172f-bd2a-3488-8bb1-29785dfb0a4c",
                        "source_sense_description": "Palermo",
                        "target_lang_word": "Palermo",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Palermo",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "346cb7e1-4406-32ea-b10f-a46229ba8de5",
                                        "entry_id": "7257f043-b2af-385d-9015-5e95d9f05326",
                                        "glosses": [
                                            "Hauptstadt der italienischen Region Sizilien und der Provinz Palermo"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a787a96-fdd9-4436-afcc-39025e262550",
                                                "sense_id": "346cb7e1-4406-32ea-b10f-a46229ba8de5",
                                                "text": "Die Phönizier gründeten Palermo im 8. Jh. v.Chr., von Mauern umgeben wurde es im 5. Jh. v. Chr., doch Bedeutung erlangte die Stadt erst, nachdem die Araber sie 831 zur Hauptstadt ihres sizilischen Reichs gemacht hatten."
                                            },
                                            {
                                                "example_id": "9213cd6c-7411-444a-b4ba-dd4d8479450e",
                                                "sense_id": "346cb7e1-4406-32ea-b10f-a46229ba8de5",
                                                "text": "Einst hatte Palermo unter den normannischen Königen ebenfalls eine fein ausziselierte Hofkultur besessen. … Mit Konstanze und ihrem Gefolge erhielt der Hof in Palermo nun neue kulturelle Impulse."
                                            },
                                            {
                                                "example_id": "99f63472-25a1-4f7c-a89f-90cfa3817d9e",
                                                "sense_id": "346cb7e1-4406-32ea-b10f-a46229ba8de5",
                                                "text": "Ein leichter Wind kräuselte die Wellen des Meeres bei Palermo, streichelte die silbergrauen Blätter der Olivenbäume an der Autobahn, die an der Küste entlang den Flughafen mit der Stadt verbindet."
                                            },
                                            {
                                                "example_id": "df37180f-6018-4298-a226-1273bcdba235",
                                                "sense_id": "346cb7e1-4406-32ea-b10f-a46229ba8de5",
                                                "text": "Wir haben Richard-Strauss-Jahr und ausgerechnet Palermo profiliert sich frühzeitig mit einer Ausgrabung: dem weitgehend unbekannten Frühwerk \"Feuersnot\"."
                                            },
                                            {
                                                "example_id": "d42eac85-3504-48d2-bfd2-5ec2c63999e1",
                                                "sense_id": "346cb7e1-4406-32ea-b10f-a46229ba8de5",
                                                "text": "Denn pünktlich zu Ostern fallen die Studienreisenden, die deutschen zumal, im chaotischen Palermo ein, einer Stadt, die langsam vor sich hinzusterben scheint und doch lebendiger wird von Tag zu Tag."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
