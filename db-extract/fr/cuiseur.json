                "senses": [
                    {
                        "sense_id": "364e8517-2f1b-308f-9723-2ec6910f7fae",
                        "entry_id": "d9b1ab97-e602-37ef-b9d3-27a1abca8a8c",
                        "glosses": [
                            "Ustensile pour cuire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "853809ba-e04d-4141-bfec-39454910a088",
                                "sense_id": "364e8517-2f1b-308f-9723-2ec6910f7fae",
                                "text": "…riz garnis, spaghettis, pudding, polentas, céréales, soupes, il ne reste qu'à bien choisir le cuiseur à riz qui s'adaptera au mieux à ses besoins, certaines machines ne pouvant pas être ouvertes en cours de cuisson (pour ajouter, par exemple, des garnitures au riz), d'autres sont plus adaptées à des cuissons multiusages."
                            },
                            {
                                "example_id": "489298d2-3ea0-4e54-a967-208ca4951ee6",
                                "sense_id": "364e8517-2f1b-308f-9723-2ec6910f7fae",
                                "text": "Les détenteurs de robots cuiseurs multifonction forment une drôle de tribu enjouée, bavarde et prosélyte dont les membres se reconnaissent à leurs propos extatiques : « Ça change la vie, honnêtement, je ne m’en passerais plus. » De cette addiction électroménagère, le marché français témoigne, année après année."
                            }
                        ]
                    },
                    {
                        "sense_id": "3f73b41a-907f-3aee-a74b-7cc72b714d3b",
                        "entry_id": "d9b1ab97-e602-37ef-b9d3-27a1abca8a8c",
                        "glosses": [
                            "Personne qui cuit."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "147b753a-28f9-419c-a164-e34d1ab47461",
                                "sense_id": "3f73b41a-907f-3aee-a74b-7cc72b714d3b",
                                "text": "Plus loin, Stéphanie Lepera, 40 ans, pompier au Sdis 91 et syndiquée à la confédération, fait le même constat : « C’est fini cette image ringarde de “cuiseurs de saucisses” »."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5d996e24-1b34-4d4f-aad0-166f66c98151",
                        "source_entry_id": "d9b1ab97-e602-37ef-b9d3-27a1abca8a8c",
                        "target_lang_word": "cooker",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cooker",
