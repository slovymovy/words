                ],
                "senses": [
                    {
                        "sense_id": "41eeca76-b092-33bc-8d31-6a2aae824d4a",
                        "entry_id": "5fb22571-d2d5-3260-bff0-7657f5f2bcba",
                        "glosses": [
                            "Action de lester, d’ajouter du lest."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c905da99-bb9a-491f-95f8-7248ddd4af92",
                                "sense_id": "41eeca76-b092-33bc-8d31-6a2aae824d4a",
                                "text": "On exporte une assez grande quantité de céréales et de boissons et une masse énorme de galets qui servent au lestage des bateaux charbonniers et constituent pour eux un très bon fret de retour."
                            }
                        ]
                    },
                    {
                        "sense_id": "000ba20d-a000-3b0c-8065-2dc1804f27d7",
                        "entry_id": "5fb22571-d2d5-3260-bff0-7657f5f2bcba",
                        "glosses": [
                            "En plongée sous-marine, fait de lester sa combinaison afin de contrebalancer la flottabilité naturelle du corps humain, généralement à l’aide de blocs de plomb fixés à la ceinture ou au baudrier."
                        ],
                        "tags": [
                            "specifically"
                        ],
                        "examples": [
                            {
                                "example_id": "6fbc587b-b5c1-499b-a510-69aded675db5",
                                "sense_id": "000ba20d-a000-3b0c-8065-2dc1804f27d7",
                                "text": "Des essais seront réalisés pour atteindre le lestage optimal qui permet de descendre à la profondeur voulue, mais maintient le nageur en flottabilité positive dans les derniers mètres de la remontée."
                            },
                            {
                                "example_id": "49ae5abc-a5c9-4207-8331-85d33a680f47",
                                "sense_id": "000ba20d-a000-3b0c-8065-2dc1804f27d7",
                                "text": "Un plongeur lesté pour la mer et désirant s’immerger dans un lac devra donc modifier son lestage en retirant 3 Kilogrammes environ de sa ceinture."
                            }
                        ]
                    }
                ],
