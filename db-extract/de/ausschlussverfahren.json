                ],
                "senses": [
                    {
                        "sense_id": "0295c91f-ed9d-3198-a799-41309919829c",
                        "entry_id": "d56ab7aa-96be-3c47-bdb2-be00ec7b0cda",
                        "glosses": [
                            "Methode nach der man etwas aussucht, indem man ungeeignet erscheinende Wahlmöglichkeiten eliminiert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8bf81f31-083d-484e-bf90-a54c6e195d46",
                                "sense_id": "0295c91f-ed9d-3198-a799-41309919829c",
                                "text": "Die richtige Antwort zu manchen Multiple-Choice-Fragen lässt sich auch mit Hilfe des Ausschlussverfahrens ermitteln."
                            },
                            {
                                "example_id": "94cc18cc-69aa-4a8a-a666-7e7d68404dc4",
                                "sense_id": "0295c91f-ed9d-3198-a799-41309919829c",
                                "text": "„Es hilft nur das Ausschlussverfahren: Pro Lauf eine Variable verändern (neue gegen alte Schuhe; mit Einlagen/ohne Einlagen und so weiter) und gucken, was passiert.“"
                            },
                            {
                                "example_id": "64bb3991-5389-4946-8b9b-be4dc4c9d440",
                                "sense_id": "0295c91f-ed9d-3198-a799-41309919829c",
                                "text": "„Zunächst wird durch ein Ausschlussverfahren eine Grundgesamtheit an möglichen Finanzierungsalternativen für eine spezifische Erneuerungsmaßnahme im Wohnungsbau ermittelt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "d672b2aa-133a-3499-8e68-f5348901e5f6",
                        "entry_id": "d56ab7aa-96be-3c47-bdb2-be00ec7b0cda",
                        "glosses": [
                            "Rechtshandlungen zur Verbannung eines Mitglieds aus einer Vereinigung, Institution oder von einer Veranstaltung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9fb10ee3-e608-4d17-a963-5147e3f9f697",
                                "sense_id": "d672b2aa-133a-3499-8e68-f5348901e5f6",
                                "text": "Der Hamburger Tierschutzverein (HTV) hat gegen sein langjähriges Mitglied Hannelore H. ein Ausschlussverfahren eingeleitet. Sie habe mehrfach gegen die Satzung des Vereins verstoßen."
                            },
                            {
                                "example_id": "683bb1d7-dd12-4a2b-adaa-e08cd478133e",
                                "sense_id": "d672b2aa-133a-3499-8e68-f5348901e5f6",
                                "text": "„Hände weg vom Ausschlussverfahren! Die vier Abweichler, die Ypsilantis Wahl verhindert haben, dürfen nicht aus der SPD geworfen werden.“"
                            },
                            {
                                "example_id": "47e6c833-bb54-47dd-9edd-0c36d0efd29b",
                                "sense_id": "d672b2aa-133a-3499-8e68-f5348901e5f6",
                                "text": "„\"Unser Ziel ist es, Herrn Voigt loszuwerden\", sagte Verbandschef Ulrich Kirsch. Der Vorstand werde nun klären, ob vor einem Ausschlussverfahren noch eine Revision abgewartet werde.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
