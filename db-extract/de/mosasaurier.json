                    {
                        "sense_id": "5687815a-d10d-3ebd-92d0-333a77b3dd97",
                        "entry_id": "5685b545-0b9c-3385-9343-3f441a742135",
                        "glosses": [
                            "im Meer lebendes Reptil, das in der Oberkreide weltweit verbreitet war"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10be9c65-a0e6-4fa7-a4a4-1c1b7773cd3c",
                                "sense_id": "5687815a-d10d-3ebd-92d0-333a77b3dd97",
                                "text": "„Trotz ihrer Sauerstoffarmut waren die Ozeane bereits von zahlreichen Lebensformen bewohnt. Dazu zählten Knochenfische, Meeresschildkröten sowie die bis zu 18 Meter langen Mosasaurier.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0a513777-202b-4e43-9d86-48e94c45f5de",
                        "source_entry_id": "5685b545-0b9c-3385-9343-3f441a742135",
                        "source_sense_id": "5687815a-d10d-3ebd-92d0-333a77b3dd97",
                        "source_sense_description": "im Meer lebendes Reptil, das in der Oberkreide weltweit verbreitet war",
                        "target_lang_word": "mosasaur",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mosasaur",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e7dbd161-750b-3121-afef-11cd551af0ad",
                                        "entry_id": "fbfef0cc-a922-356c-8eff-20e9d835c0c2",
                                        "glosses": [
                                            "A large extinct marine reptile in the family †Mosasauridae, dominant marine predator of the Cretaceous. Mosasaurs are considered to belong to Squamata, the same group that includes lizards and snakes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "714a5204-5525-4cce-a22c-3670a7f954b0",
                                                "sense_id": "e7dbd161-750b-3121-afef-11cd551af0ad",
                                                "text": "What I find deeply disturbing, however, is that Mr. Ross could believe that the earth was created 10,000 years ago, but nevertheless write in his dissertation that mosasaurs, or marine reptiles, existed more than 65 million years ago."
                                            },
                                            {
                                                "example_id": "fcdea111-8ce7-4ba5-b408-bc385613f22a",
                                                "sense_id": "e7dbd161-750b-3121-afef-11cd551af0ad",
                                                "text": "Mosasaurs could reach lengths of up to 17m and lived mainly in offshore waters of the Late Cretaceous."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "52ef7f48-0167-4f4c-b53d-4e8b8c7d8391",
                        "source_entry_id": "5685b545-0b9c-3385-9343-3f441a742135",
