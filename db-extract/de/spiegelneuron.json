                    {
                        "sense_id": "a1b0c357-879e-3fa9-89ff-03988f77b37d",
                        "entry_id": "691e3118-e82a-3499-bcf8-9fe1e49c9971",
                        "glosses": [
                            "Hirnzelle, die sowohl bei der Beobachtung einer Handlung als auch bei deren eigener Ausführung feuert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8a170895-c4e7-4382-8155-552679f23e4e",
                                "sense_id": "a1b0c357-879e-3fa9-89ff-03988f77b37d",
                                "text": "„Ergebnisse der Forschung über Spiegelneuronen weisen darauf hin, dass sie an dem Prozess des Gähnens zumindest beteiligt sind.“"
                            },
                            {
                                "example_id": "1bfb1f34-7cd2-49c8-a7f1-dec9f395e732",
                                "sense_id": "a1b0c357-879e-3fa9-89ff-03988f77b37d",
                                "text": "„Durch die Spiegelneuronen werden wir buchstäblich zu Mit-Gefühl fähig.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
