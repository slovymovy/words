        "nl-extract.jsonl": [
            {
                "entry_id": "c8bb6ce3-1360-339e-94dd-af227bd8116e",
                "word": "springtij",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "fe59e402-19eb-46c2-9bef-bb719d8a59c1",
                        "entry_id": "c8bb6ce3-1360-339e-94dd-af227bd8116e",
                        "tags": [
