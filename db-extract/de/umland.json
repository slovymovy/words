                "senses": [
                    {
                        "sense_id": "349e847d-1922-3289-8d76-9cdc25542075",
                        "entry_id": "6b6cb654-9f61-341b-8f42-1ecee9fc1885",
                        "glosses": [
                            "Umgebung einer Stadt, eines Gewässers oder sonstigem"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d1f8660-8adb-4929-b38a-4dfb8d9335c7",
                                "sense_id": "349e847d-1922-3289-8d76-9cdc25542075",
                                "text": "„Das gilt vor allem in Starnberg - die Stadt ist und bleibt das teuerste Pflaster im Münchner Umland.“"
                            },
                            {
                                "example_id": "cabc4d2e-ded6-4ead-8e4a-6dacb5e9b563",
                                "sense_id": "349e847d-1922-3289-8d76-9cdc25542075",
                                "text": "„In der Bayerischen Residenz und im Umland erkannten am 30. Juli 1914 viele Ladenbesitzer die günstige Gelegenheit und setzten, getreu dem Prinzip von Angebot und Nachfrage, die Preise herauf.“"
                            },
                            {
                                "example_id": "b99c1501-0349-46ca-a0e8-f283ce5368af",
                                "sense_id": "349e847d-1922-3289-8d76-9cdc25542075",
                                "text": "„Ab 1943 wurden Teile der Rüstungsproduktion dezentral in das Umland von Friedrichshafen verlagert.“"
                            },
                            {
                                "example_id": "76f86732-b9f6-4ed5-9015-1bd2948e4456",
                                "sense_id": "349e847d-1922-3289-8d76-9cdc25542075",
                                "text": "„Etwa drei Millionen Menschen leben im fruchtbaren Umland des Vulkans Merapi in Zentraljava.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "16a8a2e2-78f1-477f-a885-4fc19a802b6c",
