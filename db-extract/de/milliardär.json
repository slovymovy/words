                        "entry_id": "a90c9fa1-cfd8-3ceb-8f94-f92134f847b1",
                        "glosses": [
                            "jemand, der ein Vermögen von mindestens einer Milliarde (1 000 000 000) einer Währungseinheit hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "77ca5520-9e3f-4f50-b3b5-bd52671a3b2f",
                                "sense_id": "6e3f92a3-6c41-3d9b-ac41-927150ff0668",
                                "text": "Milliardär ist, wer ein Milliardenvermögen besitzt."
                            },
                            {
                                "example_id": "0951b076-9cdc-4888-9640-4baeced634d5",
                                "sense_id": "6e3f92a3-6c41-3d9b-ac41-927150ff0668",
                                "text": "„Trotz der weltweiten Finanz- und Wirtschaftskrise gibt es in diesem Jahr 1.011 Milliardäre. Im vergangenen Jahr waren es nur 793.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
