                "senses": [
                    {
                        "sense_id": "e4905480-128f-38d1-a468-67351c228351",
                        "entry_id": "df843cbb-63dc-34d8-82c7-c7c680b4497c",
                        "glosses": [
                            "Proposition scientifique démontrée, assertion établie comme vraie au travers d’un raisonnement logique construit à partir d’axiomes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa259e98-b139-4033-b7c9-d6e05b87b671",
                                "sense_id": "e4905480-128f-38d1-a468-67351c228351",
                                "text": "Fermat a laissé plusieurs théorèmes curieux sur les nombres premiers; voici le principal : si n est un nombre premier et x un nombre quelconque non divisible par n, la quantité xⁿ⁻¹-1 sera divisible par n."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9ad6d1d6-31d6-40a5-97aa-865aa51716a7",
                        "source_entry_id": "df843cbb-63dc-34d8-82c7-c7c680b4497c",
                        "source_sense_id": "e4905480-128f-38d1-a468-67351c228351",
                        "source_sense_description": "Assertion démontrée comme vraie",
                        "target_lang_word": "Theorem",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Theorem",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "64ddbd8e-2a1e-31df-bb56-7757159dafd6",
                                        "entry_id": "9fc15cde-decb-3dba-aeb2-b875a1ed3600",
                                        "glosses": [
                                            "eine Aussage innerhalb einer wissenschaftlichen Theorie, die deren Kern bildet und von den Vertretern der Theorie als wahr betrachtet wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6aceb34a-36d7-4463-9d24-a326d113b4f3",
                                                "sense_id": "64ddbd8e-2a1e-31df-bb56-7757159dafd6",
                                                "text": "„Das Modigliani-Miller-Theorem besagt, daß die durchschnittlichen Kapitalkosten einer Unternehmung unabhängig vom Verschuldungsgrad immer gleich groß sind.“"
                                            },
                                            {
                                                "example_id": "429d5de2-42b6-49e8-942f-ed9d4ac811cf",
                                                "sense_id": "64ddbd8e-2a1e-31df-bb56-7757159dafd6",
                                                "text": "„Ich entwerfe heute folgendes Theorem: Alle Wissenschaften, die sich mit dem Menschen befassen, gehorchen denselben Prinzipien und sind einander in ihrer Struktur identisch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "247d2c6a-699a-4024-b719-83e5509af606",
                        "source_entry_id": "df843cbb-63dc-34d8-82c7-c7c680b4497c",
                        "source_sense_id": "e4905480-128f-38d1-a468-67351c228351",
