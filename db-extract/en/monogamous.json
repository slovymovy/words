                "senses": [
                    {
                        "sense_id": "51fd041f-e163-3bab-afa8-a91cbb33e1f2",
                        "entry_id": "3b586ecd-4034-3b93-88a0-5aeb03cdfc07",
                        "glosses": [
                            "Being married to one person at a time."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "f89ce76f-4a45-4121-b30d-bae2db711d9e",
                                "sense_id": "51fd041f-e163-3bab-afa8-a91cbb33e1f2",
                                "text": "Suppose, for example, that if polygamy were legal, 10 percent of adult men would take an average of three wives apiece and that all remaining marriages would be monogamous."
                            }
                        ]
                    },
                    {
                        "sense_id": "0387d00b-3e4d-3573-a3b1-22c9ec1d706d",
                        "entry_id": "3b586ecd-4034-3b93-88a0-5aeb03cdfc07",
                        "glosses": [
                            "Being exclusively committed to one significant other at a time."
                        ],
                        "tags": [
                            "broadly",
                            "not-comparable"
                        ],
                        "examples": []
                    },
