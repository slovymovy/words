{
    "word_family": [
        "batsman",
        "batter",
        "batting",
        "batty"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "af96914d-bb5c-3cf3-a52c-3d237399efed",
                    "sense_definition": "A small mammal that flies at night and typically eats insects or fruit.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "animal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>bat</w> flew silently out of the cave at dusk.",
                            "target_lang_translations": {
                                "ru": "<w>Летучая мышь</w> бесшумно вылетела из пещеры в сумерках.",
                                "zh": "黄昏时分，一只<w>蝙蝠</w>悄无声息地飞出了洞穴。"
                            }
                        },
                        {
                            "text": "<w>Bats</w> use echolocation to find their way in the dark.",
                            "target_lang_translations": {
                                "ru": "<w>Летучие мыши</w> используют эхолокацию, чтобы ориентироваться в темноте.",
                                "zh": "<w>蝙蝠</w>利用回声定位在黑暗中辨别方向。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшое млекопитающее, которое летает по ночам и обычно питается насекомыми или фруктами.",
                        "zh": "一种夜间飞行、通常以昆虫或水果为食的小型哺乳动物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "летучая мышь",
                                "target_lang_sense_clarification": "животное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "蝙蝠",
                                "target_lang_sense_clarification": "动物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6a99265c-b83e-33c1-838d-07ae5a459021",
                    "sense_definition": "A long stick made of wood or metal used to hit the ball in sports like baseball or cricket.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "sports_equipment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He swung the <w>bat</w> and hit the ball over the fence.",
                            "target_lang_translations": {
                                "ru": "Он размахнулся <w>битой</w> и выбил мяч за ограждение.",
                                "zh": "他挥动<w>球棒</w>，将球击过了围栏。"
                            }
                        },
                        {
                            "text": "You need a helmet and a <w>bat</w> to play this game.",
                            "target_lang_translations": {
                                "ru": "Для этой игры тебе понадобятся шлем и <w>бита</w>.",
                                "zh": "玩这个游戏你需要戴上头盔并准备一根<w>球棒</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "stick"
                    ],
                    "common_phrases": [
                        "baseball-bat",
                        "cricket-bat"
                    ],
                    "target_lang_definitions": {
                        "ru": "Длинная палка из дерева или металла, используемая для удара по мячу в таких видах спорта, как бейсбол или крикет.",
                        "zh": "在棒球或板球等运动中，用于击球的木制或金属制长棒。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бита",
                                "target_lang_sense_clarification": "спортивный инвентарь"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "球棒",
                                "target_lang_sense_clarification": "体育器材"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "edcc58a4-5cca-3312-b3c3-872844a1e1fd",
                    "sense_definition": "A turn to hit the ball in a game.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sports_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is your <w>bat</w> now, so please get ready.",
                            "target_lang_translations": {
                                "ru": "Сейчас твоя <w>очередь отбивать</w>, так что приготовься.",
                                "zh": "现在轮到你<w>击球</w>了，请准备好。"
                            }
                        },
                        {
                            "text": "He had a long <w>bat</w> and scored many runs for the team.",
                            "target_lang_translations": {
                                "ru": "Он долго <w>отбивал</w> и принес команде много очков.",
                                "zh": "他有很长的<w>击球</w>时间，为球队赢得了许多分。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Очередь отбивать мяч в игре.",
                        "zh": "在比赛中轮到某人击球的机会。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "очередь отбивать",
                                "target_lang_sense_clarification": "игровой момент"
                            },
                            {
                                "target_lang_word": "ход",
                                "target_lang_sense_clarification": "очередь в игре"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "击球机会",
                                "target_lang_sense_clarification": "比赛中的轮次"
                            },
                            {
                                "target_lang_word": "轮次",
                                "target_lang_sense_clarification": "比赛中的顺序"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ce02ba58-013a-338f-a673-34e08421db5f",
                    "sense_definition": "An insulting word for an old woman who is considered silly or annoying.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "person_slang",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Don't listen to that silly old <w>bat</w>.",
                            "target_lang_translations": {
                                "ru": "Не слушай эту глупую старую <w>каргу</w>.",
                                "zh": "别听那个愚蠢的<w>老太婆</w>胡说。"
                            }
                        },
                        {
                            "text": "She can be a bit of a <w>bat</w> when she is in a bad mood.",
                            "target_lang_translations": {
                                "ru": "Она бывает той еще <w>ведьмой</w>, когда у нее плохое настроение.",
                                "zh": "她心情不好时，有时会像个<w>泼妇</w>一样。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "old-bat"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "derogatory"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Оскорбительное слово для пожилой женщины, которую считают глупой или надоедливой.",
                        "zh": "对被认为愚蠢或烦人的老年女性的侮辱性称呼。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "карга",
                                "target_lang_sense_clarification": "ругательство"
                            },
                            {
                                "target_lang_word": "ведьма",
                                "target_lang_sense_clarification": "злая женщина"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "老太婆",
                                "target_lang_sense_clarification": "贬义称呼"
                            },
                            {
                                "target_lang_word": "泼妇",
                                "target_lang_sense_clarification": "贬义称呼"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d2009cef-a63c-3ff2-8bee-be2c513e75d3",
                    "sense_definition": "To take a turn at hitting a ball with a bat in sports.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "sports_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>batted</w> first and scored a home run.",
                            "target_lang_translations": {
                                "ru": "Он <w>отбивал</w> первым и сделал хоум-ран.",
                                "zh": "他第一个上场<w>击球</w>并打出了全垒打。"
                            }
                        },
                        {
                            "text": "The team <w>batted</w> poorly and lost the match.",
                            "target_lang_translations": {
                                "ru": "Команда плохо <w>отбивала</w> и проиграла матч.",
                                "zh": "球队<w>击球</w>表现不佳，输掉了比赛。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Отбивать мяч битой в спортивной игре.",
                        "zh": "在体育比赛中轮到击球。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отбивать",
                                "target_lang_sense_clarification": "в спорте"
                            },
                            {
                                "target_lang_word": "бить",
                                "target_lang_sense_clarification": "наносить удар"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "击球",
                                "target_lang_sense_clarification": "体育动作"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8af8f499-ee8b-3345-baa8-03f67400f7b0",
                    "sense_definition": "To hit or swipe at something quickly with a hand or object.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cat <w>batted</w> at the toy mouse on the floor.",
                            "target_lang_translations": {
                                "ru": "Кошка <w>шлепала</w> лапой по игрушечной мыши на полу.",
                                "zh": "猫用爪子<w>拍打</w>着地板上的玩具老鼠。"
                            }
                        },
                        {
                            "text": "She <w>batted</w> the balloon away to keep it in the air.",
                            "target_lang_translations": {
                                "ru": "Она <w>отбила</w> воздушный шар, чтобы он не упал.",
                                "zh": "她把气球<w>拍打</w>开，让它保持在空中。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Быстро ударить или махнуть рукой (или предметом) по чему-либо.",
                        "zh": "用手或物体快速拍打某物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шлепать",
                                "target_lang_sense_clarification": "бить ладонью или лапой"
                            },
                            {
                                "target_lang_word": "отмахиваться",
                                "target_lang_sense_clarification": "отгонять"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "拍打",
                                "target_lang_sense_clarification": "动作"
                            },
                            {
                                "target_lang_word": "挥击",
                                "target_lang_sense_clarification": "动作"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "01faceea-135c-3fcd-9db1-c5bca31c8886",
                    "sense_definition": "To open and close the eyes quickly and lightly.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "facial_expression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>batted</w> her eyelashes to look innocent.",
                            "target_lang_translations": {
                                "ru": "Она <w>захлопала</w> ресницами, чтобы выглядеть невинно.",
                                "zh": "她<w>扑闪</w>着睫毛，装出一副无辜的样子。"
                            }
                        },
                        {
                            "text": "He did not <w>bat</w> an eyelid when he heard the strange news.",
                            "target_lang_translations": {
                                "ru": "Он и глазом не <w>моргнул</w>, когда услышал странную новость.",
                                "zh": "听到那个奇怪的消息时，他连眼皮都没<w>眨</w>一下。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "bat-an-eyelid",
                        "bat-one's-eyelashes"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быстро и легко открывать и закрывать глаза (хлопать ресницами).",
                        "zh": "快速且轻微地开合眼睛。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хлопать",
                                "target_lang_sense_clarification": "ресницами"
                            },
                            {
                                "target_lang_word": "моргнуть",
                                "target_lang_sense_clarification": "веком"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "眨眼",
                                "target_lang_sense_clarification": "动作"
                            },
                            {
                                "target_lang_word": "扑闪",
                                "target_lang_sense_clarification": "形容睫毛动作"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}