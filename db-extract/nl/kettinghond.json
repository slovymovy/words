                            {
                                "example_id": "ccbc4d01-bd84-4ae7-b2d6-ba1f61f7e8ef",
                                "sense_id": "8d16f1d1-b17d-398f-b6aa-b49162cf37ae",
                                "text": "Een valse kettinghond rende om het huis langs het draadhek."
                            },
                            {
                                "example_id": "555c27c8-d11e-457c-8a41-db6fcaa46614",
                                "sense_id": "8d16f1d1-b17d-398f-b6aa-b49162cf37ae",
                                "text": "Met die opmerkingen stimuleert hij het debat over de bevoegdheden en de werkwijze van de raad. De opvattingen daarover lopen sterk uiteen. Zo sprak NVJ-voorzitter Kees Schaepman bij de presentatie van het boek van een „tandeloze kettinghond.” „Toch zou ik me schamen voor een veroordeling”, aldus Schaepman, die meent dat gepubliceerde uitspraken bindend moeten worden en dat de raad in eigen kring moet werken aan meer naamsbekendheid en professionalisering."
                            }
                        ]
                    },
