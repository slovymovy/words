                                "target_lang_sense_clarification": "звука, голоса"
                            },
                            {
                                "target_lang_word": "чёткость",
                                "target_lang_sense_clarification": "звучания"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "czystość",
                                "target_lang_sense_clarification": "jakość brzmienia głosu lub dźwięku"
                            },
                            {
                                "target_lang_word": "wyrazistość",
                                "target_lang_sense_clarification": "łatwość rozróżnienia dźwięków"
