                ],
                "senses": [
                    {
                        "sense_id": "54f63e56-aee3-30fe-b816-7c93b681017c",
                        "entry_id": "8dc6e1c4-5e6c-3d29-b8e5-f38f83b59966",
                        "glosses": [
                            "een vel papier dat het boekblok beschut, de ene kant zit vast aan de kaft van het boek de andere kant aan het boekblok zelf"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "157d4101-d3be-4390-9df1-e1335450defd",
                                "sense_id": "54f63e56-aee3-30fe-b816-7c93b681017c",
                                "text": "AFdH heeft van dit bundeltje over verzamelaars een collector’s item gemaakt. Zelden heb ik een boekje gezien waarbij inhoud en vorm mekaar zo mooi discreet versterken. Boekverzorging is hier geen loos modewoord. Het kleine formaat, de harde kaft, de Dürer en de Rembrandt op de schutbladen, het spel van zwart en rood, de letter, de foto’s van Maria Austria die zo mysterieus doorschemeren door het rood van de vorige of de volgende bladzijde, het papier... Het klopt allemaal."
                            },
                            {
                                "example_id": "cd872a78-6452-4623-9bfd-0e20f95cf133",
                                "sense_id": "54f63e56-aee3-30fe-b816-7c93b681017c",
                                "text": "De namen van Anne en haar zus Margot prijken op het schutblad. Het boek is in 1925 in Wenen gepubliceerd. Volgens veilinghuis Swann Galleries gaven de sprookjes Anne de inspiratie voor haar eigen korte verhalen."
                            }
                        ]
                    },
                    {
                        "sense_id": "299c9398-fa89-3d25-9d7f-29782e7e5f87",
                        "entry_id": "8dc6e1c4-5e6c-3d29-b8e5-f38f83b59966",
                        "glosses": [
                            "een blad dat in de oksel van een bloem of bloeiwijze onmiddellijk daaronder staat"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6701f623-4aec-4d4e-a84f-22464b02cbbc",
                        "source_entry_id": "8dc6e1c4-5e6c-3d29-b8e5-f38f83b59966",
                        "source_sense_id": "54f63e56-aee3-30fe-b816-7c93b681017c",
                        "source_sense_description": "een vel papier dat het boekblok beschut",
                        "target_lang_word": "flyleaf",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "flyleaf",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3ad9dbf9-eaad-3967-8008-591f085c42e4",
                                        "entry_id": "2f8879f1-8bb8-3c92-b5be-ea1f419698c0",
                                        "glosses": [
                                            "A blank leaf at the front or back of a book."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "78ffcd5e-8a1a-4c82-93c7-033fb2979c24",
                                                "sense_id": "3ad9dbf9-eaad-3967-8008-591f085c42e4",
                                                "text": "The flyleaf of Alice Walker's The Color Purple calls the book \"honest, poignant, laughing, defiant...a story about heroic lives, love, and the nature of god.... It breaks new ground in fiction with its portrayal of women.\""
                                            },
                                            {
                                                "example_id": "76b116e7-fbd2-4d8b-ae1d-f439c8cf55b3",
                                                "sense_id": "3ad9dbf9-eaad-3967-8008-591f085c42e4",
                                                "text": "The scribbles on the margins, the occasional date on the flyleaf, the faded bus ticket marking a page for a reason today mysterious, all try to remind me of who I was then."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c2bf9384-080a-304b-8f49-29a16dc5a044",
                                        "entry_id": "2f8879f1-8bb8-3c92-b5be-ea1f419698c0",
                                        "glosses": [
                                            "A blank leaf at the front or back of a book.",
                                            "Especially, the free portion of an endpaper."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7900fb1f-e44c-48e2-ae95-193ad6be09a4",
                                                "sense_id": "c2bf9384-080a-304b-8f49-29a16dc5a044",
                                                "text": "Holonym: endpaper"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ea87e7fc-eec3-48c3-8dc8-e70ffd9c3085",
                        "source_entry_id": "8dc6e1c4-5e6c-3d29-b8e5-f38f83b59966",
                        "source_sense_id": "299c9398-fa89-3d25-9d7f-29782e7e5f87",
                        "source_sense_description": "een blad dat in de oksel van een bloem of bloeiwijze onmiddellijk daaronder staat",
                        "target_lang_word": "bract",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bract",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3f981514-9095-3c9a-b6f6-3ad67d7efcf4",
                                        "entry_id": "9df41224-a892-3b87-bcbb-ad202c0d51fc",
                                        "glosses": [
                                            "A leaf or leaf-like structure from the axil out of which a stalk of a flower or an inflorescence arises."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c649e254-e80f-486d-bcf6-5c586a1f27ca",
                                                "sense_id": "3f981514-9095-3c9a-b6f6-3ad67d7efcf4",
                                                "text": "In this vegetable monster the bractes, or divisions of the spike, become wonderfully enlarged; and are converted into leaves."
                                            },
                                            {
                                                "example_id": "2c80fe39-1a82-4f39-85f2-af5e293d37f9",
                                                "sense_id": "3f981514-9095-3c9a-b6f6-3ad67d7efcf4",
                                                "text": "A Verticil or Whirl may be[…]Naked; that is without involucre, bracte or brittle. Bracted - or Involucred"
                                            },
                                            {
                                                "example_id": "486514a7-55fc-404d-8163-aaac6c90d095",
                                                "sense_id": "3f981514-9095-3c9a-b6f6-3ad67d7efcf4",
                                                "text": "Great dense patches of them grew, four and five and six feet deep, impenetrable swathes of dark green bracts that advertised their danger."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
