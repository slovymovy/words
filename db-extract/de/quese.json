                        "entry_id": "6f29738d-a56b-399d-b888-1d7e87bd30bd",
                        "glosses": [
                            "(blutunterlaufene) Blase, die nach einer Quetschung entsteht, Hautverdickung"
                        ],
                        "tags": [
                            "North German"
                        ],
                        "examples": [
                            {
                                "example_id": "5f1818d5-8e89-4a5a-abc5-016d012b0007",
                                "sense_id": "009031fd-a2c6-3e86-9938-a0f4b2979a01",
                                "text": "„Als sie nach drei Tagen vom Schreiben eine Quese am Finger hatte, verlangte sie zurück in die Produktionshalle, zu anderem wäre sie nicht geboren.“"
                            }
                        ],
