    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "b3f69914-4305-3d07-a5a1-c4e9c2cab4be",
                "word": "catecholamine",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "9b9cc6b8-0e05-416b-90c2-2966689610fc",
                        "entry_id": "b3f69914-4305-3d07-a5a1-c4e9c2cab4be",
                        "tags": [
                            "plural"
                        ],
                        "form": "catecholamines"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5504a6aa-ca24-3b00-afe2-c694ecfbd87a",
                        "entry_id": "b3f69914-4305-3d07-a5a1-c4e9c2cab4be",
                        "glosses": [
                            "Any of a class of aromatic amines derived from pyrocatechol that are hormones produced by the adrenal gland."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5730139b-89e7-4173-9cce-9bfa8b9c03e7",
                                "sense_id": "5504a6aa-ca24-3b00-afe2-c694ecfbd87a",
                                "text": "Epinephrine and dopamine are two other catecholamine transmitters."
                            },
                            {
                                "example_id": "f1d708fc-5811-4739-a9be-3e39047aa6cb",
                                "sense_id": "5504a6aa-ca24-3b00-afe2-c694ecfbd87a",
                                "text": "The catecholamines are used in several motivational and emotional systems of the brain, and their concentration is regulated by proteins that break them down or recycle them."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "43589f2a-f906-40d0-8932-35f242509d44",
                        "source_entry_id": "b3f69914-4305-3d07-a5a1-c4e9c2cab4be",
                        "source_sense_id": "5504a6aa-ca24-3b00-afe2-c694ecfbd87a",
                        "source_sense_description": "any of a class of aromatic amines",
                        "target_lang_word": "catécholamine",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "catécholamine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "431d8a4c-ceb6-3cc6-b274-0d2f9c44afcc",
                                        "entry_id": "e3eee677-4570-3ecd-9fab-c6755942de9c",
                                        "glosses": [
                                            "Famille de composés organiques synthétisés à partir de la tyrosine et jouant le rôle d’hormone ou de neurotransmetteur."
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0d97856b-2ad7-4877-be55-a500694f4fde",
                                                "sense_id": "431d8a4c-ceb6-3cc6-b274-0d2f9c44afcc",
                                                "text": "Chez des méditants avancés, au frein parasympathique de la réponse de relaxation viendrait se superposer la libération centrale de catécholamine."
                                            },
                                            {
                                                "example_id": "9b8d1fad-26a4-4c70-ba23-9b80f97612cc",
                                                "sense_id": "431d8a4c-ceb6-3cc6-b274-0d2f9c44afcc",
                                                "text": "Contrairement aux benzodiazépines classiques et aux antidépresseurs tricycliques qui se substituent aux catécholamines et aux biamines, ce médicament stimule le système catécholaminergique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
