                    {
                        "translation_id": "8d96b89f-b062-489b-bb69-1234ea436078",
                        "source_entry_id": "f47b4217-d9ab-33bf-acd9-99e8b53a0485",
                        "source_sense_description": "in Greek mythology",
                        "target_lang_word": "Kallisto",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kallisto",
