                        "form": "sanitarium"
                    },
                    {
                        "form_id": "7e39a9ce-3e92-4db8-9324-208714d52a4f",
                        "entry_id": "a43229d2-4f8b-368f-b856-42e27f852400",
                        "tags": [],
                        "form": "sana"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9cf2cc39-5967-3218-bfc9-ec3d7ab535b0",
                        "entry_id": "a43229d2-4f8b-368f-b856-42e27f852400",
                        "glosses": [
                            "Maison de santé où l’on soigne au grand air certains malades, plus spécialement ceux atteints de tuberculose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed41ce3d-612f-4969-91b2-92bd918dec31",
                                "sense_id": "9cf2cc39-5967-3218-bfc9-ec3d7ab535b0",
                                "text": "Il était trop tard pour parler de campagne, de régime doux, de petit voyage : tout de suite, j’ai deviné, sur des lèvres réticentes de médecins, le mot de sanatorium…"
                            },
                            {
                                "example_id": "e9b973a1-8ff7-4e8b-aa0d-36b5bb10341d",
                                "sense_id": "9cf2cc39-5967-3218-bfc9-ec3d7ab535b0",
                                "text": "Jean-Louis, qui a obtenu l’autorisation de correspondre avec elle, m’écrit de son sanatorium qu’elle est une grande âme, faite pour le plus haut amour."
                            },
                            {
                                "example_id": "96b03e28-e5d8-4db0-bf00-c874a9b48e6b",
                                "sense_id": "9cf2cc39-5967-3218-bfc9-ec3d7ab535b0",
                                "text": "Thorsavn possède un hôpital moderne que lui envieraient bien des arrondissements de Paris et un Sanatorium pour les tuberculeux."
                            },
                            {
                                "example_id": "a84dc25d-5817-4653-ae7e-a4a9cedf0e02",
                                "sense_id": "9cf2cc39-5967-3218-bfc9-ec3d7ab535b0",
                                "text": "Le département fait de louables efforts pour créer un dispensaire antituberculeux. Il organise l’inspection des écoles. Quant à un sanatorium, n’en parlons pas pour l’instant."
                            },
                            {
                                "example_id": "7cc91961-a2ed-4cdd-aef6-a2ec95d7fea5",
                                "sense_id": "9cf2cc39-5967-3218-bfc9-ec3d7ab535b0",
                                "text": "Après tout, si l’affaire avait marché, Judas aurait probablement subventionné des sanatoria, des hôpitaux, des bibliothèques ou des laboratoires."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "58914b2b-7a2a-4bca-8275-6d6958dcf385",
                        "source_entry_id": "a43229d2-4f8b-368f-b856-42e27f852400",
                        "source_sense_id": "9cf2cc39-5967-3218-bfc9-ec3d7ab535b0",
                        "target_lang_word": "Sanatorium",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sanatorium",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1f95f48f-a51e-3ed3-9904-75fa2aed0a56",
                                        "entry_id": "593e343a-0cc1-3057-b86f-a11ee4ad6075",
                                        "glosses": [
                                            "Einrichtung zur Verbesserung der Gesundheit chronisch/ernsthaft Kranker oder Genesender"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7242d07c-e8ec-4e18-8a8f-28bc944fa8bd",
                                                "sense_id": "1f95f48f-a51e-3ed3-9904-75fa2aed0a56",
                                                "text": "„Man teilt ihr mit, dass ihr Vater im Sanatorium Saint-Paul in Dallas an einer Lungenentzündung gestorben ist.“"
                                            },
                                            {
                                                "example_id": "8f188ee8-611f-47b7-826c-14c0b4f64fa5",
                                                "sense_id": "1f95f48f-a51e-3ed3-9904-75fa2aed0a56",
                                                "text": "Sie besuchten ihren Großvater im Sanatorium, doch er erkannte sie nicht einmal."
                                            },
                                            {
                                                "example_id": "bc320f9e-dac9-4c6c-9aae-cb0180b13ec0",
                                                "sense_id": "1f95f48f-a51e-3ed3-9904-75fa2aed0a56",
                                                "text": "„Kurz vor seiner Entlassung aus dem Sanatorium hatte eine Frau Laverino aus Bad Harzburg Isolde telefonisch mitgeteilt, dass sie ein Päckchen aufbewahre, das für ihn bestimmt sei.“"
                                            },
                                            {
                                                "example_id": "e62945bc-2d50-414c-a455-c7fb3664951f",
                                                "sense_id": "1f95f48f-a51e-3ed3-9904-75fa2aed0a56",
                                                "text": "„Als die Krankheit der Tante entdeckt wurde und sie in ein Sanatorium kam, mußte ich den Herzlein beaufsichtigen.“"
                                            },
                                            {
                                                "example_id": "99070ae0-8f26-4bdf-8d06-b618b5661759",
                                                "sense_id": "1f95f48f-a51e-3ed3-9904-75fa2aed0a56",
                                                "text": "„Pat stirbt in einem Sanatorium an Tuberkulose.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e6982273-2f49-4010-aa4e-e4e001492ee5",
                        "source_entry_id": "a43229d2-4f8b-368f-b856-42e27f852400",
