                                            {
                                                "example_id": "2890fae1-cf35-4733-a73b-ab774b818032",
                                                "sense_id": "11947963-9b72-3474-91df-c5356cbb20e9",
                                                "text": "Wody zalewu niespodziewanie zaczęły występować z brzegów."
                                            },
                                            {
                                                "example_id": "8674cdfa-866a-496c-ac42-93bd4690b0c2",
                                                "sense_id": "11947963-9b72-3474-91df-c5356cbb20e9",
                                                "text": "Niespodziewanie położyła rękę na jego udzie."
                                            }
                                        ],
