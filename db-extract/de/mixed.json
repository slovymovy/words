                        "entry_id": "bb9cf86d-9133-347a-ba22-6392031cda76",
                        "glosses": [
                            "Spielvariante, bei der jeweils mindestens ein Mann und eine Frau als Mannschaft gemeinsam gegen eine andere Mannschaft spielen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab558d32-46d4-4280-ba6f-d469ed3f118f",
                                "sense_id": "e480c679-11f9-3e38-84ce-7c0a924247a3",
                                "text": "„Das Rückspiel wurde nach zwei Herrendoppel, einem Damendoppel und einem Mixed nach vier Siegen für die Berliner abgebrochen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
