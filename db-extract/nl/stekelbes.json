                                                "example_id": "753c76bb-bea1-4f29-9dbb-d22a2b7e2755",
                                                "sense_id": "26e3fe16-83a9-3bab-9198-1bcff71ec23b",
                                                "text": "Robert and Susan were so in love with each other that nobody could go near them without feeling like a gooseberry."
                                            },
                                            {
                                                "example_id": "b4dcd7ec-2172-444d-b1ab-00045c3a962f",
                                                "sense_id": "26e3fe16-83a9-3bab-9198-1bcff71ec23b",
                                                "text": "\"But,\" said Philippa dolefully, \"if I go I'll have to be gooseberry, and that will be a new experience for Philippa Gordon.\""
                                            },
                                            {
                                                "example_id": "940e3ac2-2ec5-4ce0-92ac-64e06e34fa91",
                                                "sense_id": "26e3fe16-83a9-3bab-9198-1bcff71ec23b",
                                                "text": "Kryten, you are a total gooseberry. Next time I play on the AR machine I'm going to give you some money and send you to the pictures."
