                "senses": [
                    {
                        "sense_id": "c541e9b3-b4e5-318f-a4c0-039559d09cb4",
                        "entry_id": "17e33377-b2f5-321a-8dc4-123ae66de58d",
                        "glosses": [
                            "erster Tag im Jahr"
                        ],
                        "tags": [
                            "Plural selten"
                        ],
                        "examples": [
                            {
                                "example_id": "03d437a8-3f8b-4565-bf00-fc63301e7562",
                                "sense_id": "c541e9b3-b4e5-318f-a4c0-039559d09cb4",
                                "text": "„Am Neujahrestag fuhren wir dann mit den Ringen im Gepäck wieder nach Kronach zurück und wollten unsere Verlobung feiern.“"
                            },
                            {
                                "example_id": "0eaf4b90-134b-45c1-bb3b-9483e0ed5284",
                                "sense_id": "c541e9b3-b4e5-318f-a4c0-039559d09cb4",
                                "text": "„In ein paar Tagen ist außerdem Weihnachten und am Neujahrestag werde ich bereits Königin sein.“"
                            },
                            {
                                "example_id": "3f8ebbd0-c5cb-405c-b880-9877a03dc650",
                                "sense_id": "c541e9b3-b4e5-318f-a4c0-039559d09cb4",
                                "text": "„Am Neujahrestag 1984 wurde in Deutschland erstmalig eine Sendung eines Privatfernanbieters ausgestrahlt.“"
                            },
                            {
                                "example_id": "2da03b65-9447-4810-9440-daf90a95a5c5",
                                "sense_id": "c541e9b3-b4e5-318f-a4c0-039559d09cb4",
                                "text": "„Am Neujahrestag, nach dem Frühstück, brachte ich sie zum Bahnhof, damit sie zurück nach Würzburg fahren konnte.“"
                            },
                            {
                                "example_id": "6ffa221a-697b-44a5-92ee-5af4293be262",
                                "sense_id": "c541e9b3-b4e5-318f-a4c0-039559d09cb4",
                                "text": "„Verdienstvolle Beamte erhielten an Neujahrestagen goldene Ketten, Goldfliegen – Zeichen für Tapferkeit – und andere Geschenke […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
