            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5efb483a-7802-3850-8485-db3a8625ee16",
                    "sense_definition": "Das plötzliche und unkontrollierte Fallen zu Boden oder in die Tiefe.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "fallen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Bei einem schweren <w>Sturz</w> vom Fahrrad brach er sich den linken Arm."
                        },
                        {
                            "text": "Nach dem plötzlichen <w>Sturz</w> auf der vereisten Treppe musste sie ins Krankenhaus gebracht werden."
                        }
                    ],
                    "common_phrases": [
                        "ein schwerer Sturz",
                        "Sturz vom Fahrrad"
                    ],
                    "synonyms": [
                        "Fall"
                    ]
                },
                {
                    "sense_id": "4e5a76fc-ea39-30d1-aa2d-9778664b3290",
                    "sense_definition": "Der gewaltsame oder erzwungene Verlust der Macht oder das unfreiwillige Ausscheiden aus einem hohen Amt.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "machtverlust",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nach monatelangen Protesten der Bevölkerung kam es schließlich zum <w>Sturz</w> der Regierung."
                        },
                        {
                            "text": "Der schwere finanzielle Skandal führte unausweichlich zum raschen <w>Sturz</w> des Ministers."
                        }
                    ],
                    "synonyms": [
                        "Entmachtung"
                    ],
                    "common_phrases": [
                        "der Sturz der Regierung",
                        "Sturz des Regimes"
                    ]
                },
                {
                    "sense_id": "036f1013-64f9-358b-8bbf-b34a2f2c28c2",
                    "sense_definition": "Ein plötzlicher, drastischer Rückgang von Zahlen, Kursen oder Messwerten.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "abnahme",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der unerwartete <w>Sturz</w> der Aktienkurse löste an den internationalen Börsen große Panik aus."
                        },
                        {
                            "text": "Ein abrupter <w>Sturz</w> der Temperaturen kündigte den plötzlichen Beginn des Winters an."
                        }
                    ],
                    "common_phrases": [
                        "ein plötzlicher Sturz"
                    ],
                    "synonyms": [
                        "Einbruch",
                        "Absturz"
                    ]
                },
                {
                    "sense_id": "87b5f284-fec8-398a-a42f-4e9726aa7f2c",
                    "sense_definition": "Ein waagerechtes, tragendes Bauteil zur Überbrückung von Öffnungen in Wänden wie Türen oder Fenstern.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "architektur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Beim Umbau der Außenwand musste der alte <w>Sturz</w> über dem Fenster komplett ersetzt werden."
                        },
                        {
                            "text": "Die Handwerker bauten einen tragfähigen <w>Sturz</w> aus Beton über der neuen Tür ein."
                        }
                    ],
                    "common_phrases": [
                        "tragender Sturz"
                    ]
                }
            ]
        }
    ]
