                            {
                                "example_id": "9b17db82-a928-42c2-b49e-c8bff0f4890e",
                                "sense_id": "5d9b7add-6de6-3394-a34d-d4243587c506",
                                "text": "Veel opiniepeilers zeggen hun rekenmethodes te hebben verbeterd."
                            },
                            {
                                "example_id": "86e67d61-ed23-492c-b5f3-925907e0cfc7",
                                "sense_id": "5d9b7add-6de6-3394-a34d-d4243587c506",
                                "text": "De Rijksoverheid moet binnen een half jaar haar rekenmethode voor de stikstofuitstoot bij snelwegen beter onderbouwen. De huidige rekensom neemt de stikstofneerslag tot vijf kilometer van de weg mee."
                            }
                        ]
                    },
