{
    "word_family": [
        "ultimately",
        "ultimatum"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "94b16878-c3ef-3b97-82be-87605e1373a9",
                    "sense_definition": "Being the best, most extreme, or greatest possible.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "extreme_best",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Climbing Mount Everest is considered the <w>ultimate</w> challenge for many mountaineers.",
                            "target_lang_translations": {
                                "ru": "Восхождение на Эверест считается <w>величайшим</w> испытанием для многих альпинистов.",
                                "tr": "Everest Dağı'na tırmanmak, birçok dağcı için <w>en üstün</w> sınav olarak kabul edilir.",
                                "zh": "对许多登山者来说，攀登珠穆朗玛峰被认为是<w>终极</w>挑战。"
                            }
                        },
                        {
                            "text": "The soldier made the <w>ultimate</w> sacrifice for his country.",
                            "target_lang_translations": {
                                "ru": "Солдат принес <w>высшую</w> жертву за свою страну.",
                                "tr": "Asker, ülkesi için <w>en büyük</w> fedakarlığı yaptı.",
                                "zh": "这位士兵为国家做出了<w>最高</w>的牺牲。"
                            }
                        }
                    ],
                    "synonyms": [
                        "supreme",
                        "utmost",
                        "uttermost"
                    ],
                    "common_phrases": [
                        "ultimate challenge",
                        "ultimate sacrifice",
                        "ultimate goal",
                        "ultimate luxury"
                    ],
                    "target_lang_definitions": {
                        "ru": "Самый лучший, величайший или крайний; не имеющий себе равных.",
                        "tr": "En iyi, en uç veya mümkün olan en büyük.",
                        "zh": "指最好的、最极端的或可能达到的最高程度。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наивысший",
                                "target_lang_sense_clarification": "самый высокий по степени или качеству"
                            },
                            {
                                "target_lang_word": "величайший",
                                "target_lang_sense_clarification": "самый значительный или грандиозный"
                            },
                            {
                                "target_lang_word": "предельный",
                                "target_lang_sense_clarification": "крайний, максимальный"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "en üstün",
                                "target_lang_sense_clarification": "derece veya kalite bakımından en yüksek"
                            },
                            {
                                "target_lang_word": "nihai",
                                "target_lang_sense_clarification": "en uç noktada olan"
                            },
                            {
                                "target_lang_word": "en büyük",
                                "target_lang_sense_clarification": "en önemli veya en kapsamlı"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "终极",
