                                "tr": "İki <w>kız kardeşim</w> ve bir erkek kardeşim var.",
                                "es": "Tengo dos <w>hermanas</w> y un hermano."
                            }
                        },
                        {
                            "text": "Mijn <w>zus</w> komt morgen bij ons op bezoek.",
                            "target_lang_translations": {
