                        "examples": [
                            {
                                "example_id": "4e5d14e5-d252-4b06-a63e-5ff78ef78e8e",
                                "sense_id": "86590664-acfb-350e-b1e0-046e7d2eb49f",
                                "text": "I use data from several recent academic national surveys: the 2013 Austrian Election Study (AES), British Election Study Panel Survey (BES) conducted in January 2014 (from which I include respondents living in England), and the German Longitudinal Election Study (GLES) wave conducted in May 2013. […] These questions measuring RWA (or what I would term “authoritarian values”) are available in the BES data."
                            }
                        ]
