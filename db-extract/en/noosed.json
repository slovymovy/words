                                "example_id": "c2f5c367-8429-46bc-9816-73f05a1eab39",
                                "sense_id": "707d1c95-2bf2-3779-b60f-42189e0334f5",
                                "text": "Having strung a length of noosed cord to a light pole, Constans threw himself flat along the string-piece of the pier and began angling for the prize."
