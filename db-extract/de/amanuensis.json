                                "target_senses": [
                                    {
                                        "sense_id": "6ba288c0-4d4c-3387-8fc4-1f9f60a8e11f",
                                        "entry_id": "ff58c74c-d1b2-3ac4-b5d3-9cf3d3fdf0d6",
                                        "glosses": [
                                            "A person who keeps records, takes notes and handles general clerical work."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c638763d-1331-4102-8815-6c5b721636eb",
                                                "sense_id": "6ba288c0-4d4c-3387-8fc4-1f9f60a8e11f",
                                                "text": "I have a personal secretary to help me organize my clients."
                                            },
                                            {
                                                "example_id": "997c76d7-7504-4feb-8f27-60f4c31da019",
                                                "sense_id": "6ba288c0-4d4c-3387-8fc4-1f9f60a8e11f",
                                                "text": "The secretary at the school is in charge of communication between parents, students, and staff."
                                            },
                                            {
                                                "example_id": "489c633d-29f7-4d1a-ad90-66b074887abc",
                                                "sense_id": "6ba288c0-4d4c-3387-8fc4-1f9f60a8e11f",
                                                "text": "None of us can type, Minister. Mrs. McKay types (laugh track). She's the secretary (laugh track)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1d71f62d-4295-330f-ae66-26f199184a09",
                                        "entry_id": "ff58c74c-d1b2-3ac4-b5d3-9cf3d3fdf0d6",
                                        "glosses": [
                                            "The head of a department of government."
                                        ],
                                        "tags": [
                                            "capitalized",
                                            "often"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4ab95fdc-9a1e-4c35-98b6-9fb8721e983d",
                                                "sense_id": "1d71f62d-4295-330f-ae66-26f199184a09",
                                                "text": "Well briefly, sir, I am the Permanent Under Secretary of State, known as the Permanent Secretary."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6a4ec4a0-5e59-3616-b2d7-6d83622301e6",
                                        "entry_id": "ff58c74c-d1b2-3ac4-b5d3-9cf3d3fdf0d6",
                                        "glosses": [
                                            "A managerial or leading position in certain non-profit organizations, such as political parties, trade unions, international organizations."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b78a3d9d-015f-46d2-b33a-a372371d6200",
                                                "sense_id": "6a4ec4a0-5e59-3616-b2d7-6d83622301e6",
                                                "text": "Ban Ki-Moon was a secretary general of the United Nations."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b3dd2e03-b9c1-35e6-a96d-58bbbc50ace7",
                                        "entry_id": "ff58c74c-d1b2-3ac4-b5d3-9cf3d3fdf0d6",
                                        "glosses": [
                                            "A type of desk, secretary desk; a secretaire."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "34a8cff7-9155-304a-a710-4f6046157012",
                                        "entry_id": "ff58c74c-d1b2-3ac4-b5d3-9cf3d3fdf0d6",
                                        "glosses": [
                                            "A secretary bird, a bird of the species Sagittarius serpentarius."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f95bbe9b-ca48-3d36-ba7c-01855dc6bd58",
                                        "entry_id": "ff58c74c-d1b2-3ac4-b5d3-9cf3d3fdf0d6",
                                        "glosses": [
                                            "Someone entrusted with a secret; a confidant."
                                        ],
                                        "tags": [
