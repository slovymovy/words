                    {
                        "translation_id": "0195463e-ce90-4e9a-9c6f-ddda63ae5a38",
                        "source_entry_id": "64f46792-139f-3085-a6a8-65281282ee7c",
                        "source_sense_id": "a10ad79d-0cca-3fb1-a686-16c9c2836126",
                        "source_sense_description": "lacking respect or seriousness",
                        "target_lang_word": "ehrfurchtslos",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ehrfurchtslos",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "71c7f977-86cb-365a-ad4d-ee33d8b9e913",
                                        "entry_id": "810e809a-ca8a-3bd2-842e-126b462d828a",
                                        "glosses": [
                                            "ohne Achtung/Respekt gegenüber der Würde/Erhabenheit von jemandem oder etwas; keine Ehrfurcht zeigend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7739a51-ff4f-449a-a96c-58dfba68d371",
                                                "sense_id": "71c7f977-86cb-365a-ad4d-ee33d8b9e913",
                                                "text": "Gegenüber dem König verhielt er sich ehrfurchtslos."
                                            },
                                            {
                                                "example_id": "cf1f5dbd-625a-4a54-a823-74237d9dda38",
                                                "sense_id": "71c7f977-86cb-365a-ad4d-ee33d8b9e913",
                                                "text": "„Es mag komisch, für manch einen vielleicht auf den ersten Blick verwerflich, despektierlich oder ehrfurchtslos klingen.“"
                                            },
                                            {
                                                "example_id": "2fa153a2-6ca8-4e85-a377-ae34511cd42b",
                                                "sense_id": "71c7f977-86cb-365a-ad4d-ee33d8b9e913",
                                                "text": "„Wer aber so ehrfurchtslos ist und das Gesetz des Blutes zu leugnen vermag, der ist der gottloseste Mensch, der sich auf diesem Erdball bewegt.“"
                                            },
                                            {
                                                "example_id": "daab19a9-9eaa-474a-8a66-e1771c7f4bdb",
                                                "sense_id": "71c7f977-86cb-365a-ad4d-ee33d8b9e913",
                                                "text": "„Die Freude daran folgt nicht nur aus ihrer Illegalität, sondern aus dem schöpferischen Spiel und dem ehrfurchtslosen Humor der Täterinnen und Täter und daraus, dass ihre Bedeutung als anarchistischer Widerstand bekräftigt wird.“"
                                            },
                                            {
                                                "example_id": "edcc7249-9616-472c-9ce5-adc16af39f17",
                                                "sense_id": "71c7f977-86cb-365a-ad4d-ee33d8b9e913",
                                                "text": "„Der Kleine erbte wenig, aber doch die Einstellung zur Welt und zum Leben - »seinen ehrfurchtslosen, exzentrischen Individualismus«.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "93aac0e0-b095-46b1-8c1a-de1d2aebcd81",
                        "source_entry_id": "64f46792-139f-3085-a6a8-65281282ee7c",
                        "source_sense_id": "a10ad79d-0cca-3fb1-a686-16c9c2836126",
