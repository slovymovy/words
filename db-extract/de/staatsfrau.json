                        "examples": [
                            {
                                "example_id": "2e833bd3-b923-4f59-99e3-a43e048a68fc",
                                "sense_id": "b96297ed-b96b-3dc4-8113-1bbaa292a10f",
                                "text": "Sie war eine große Staatsfrau."
                            },
                            {
                                "example_id": "978d0c31-de56-4fba-bac6-1de23bb32f6b",
                                "sense_id": "b96297ed-b96b-3dc4-8113-1bbaa292a10f",
                                "text": "„»Frau Merkel wird als große europäische Staatsfrau in Erinnerung bleiben«, ist sich Francois Hollande sicher.“"
                            },
                            {
                                "example_id": "4f390af5-c5af-4020-ac85-5f9cec088ed2",
                                "sense_id": "b96297ed-b96b-3dc4-8113-1bbaa292a10f",
                                "text": "[Ellen Johnson-Sirleaf:] „Dennoch: ganz unumstritten ist die jetzt geehrte afrikanische Staatsfrau nicht.“"
                            },
                            {
                                "example_id": "843dcae7-4ba9-4632-8e33-dae6150c7d78",
                                "sense_id": "b96297ed-b96b-3dc4-8113-1bbaa292a10f",
                                "text": "„Ein Staatsmann oder eine Staatsfrau dürfen die Wahrheit verschweigen, aber sie dürfen nicht dreist lügen.“"
                            }
                        ],
