                "senses": [
                    {
                        "sense_id": "42aec4cd-0043-3f89-9a5b-9683417c3c7d",
                        "entry_id": "183cd0f3-afbc-3dab-9b69-515b22614511",
                        "glosses": [
                            "die Plätze, auf denen die Minister einer Regierung sitzen, die Minister in ihrer Gesamtheit"
                        ],
                        "tags": [
                            "und damit auch übertragen für"
                        ],
                        "examples": [
                            {
                                "example_id": "ac91a467-d8ff-405d-aa62-02f1f8b503cc",
                                "sense_id": "42aec4cd-0043-3f89-9a5b-9683417c3c7d",
                                "text": "Beifall auf mehreren Puncten; Murren auf der Ministerbank. (1845) wörtlich, auf dieser Bank sitzend"
                            },
                            {
                                "example_id": "e7eb4277-104d-4d9e-b682-a5d16e3692d4",
                                "sense_id": "42aec4cd-0043-3f89-9a5b-9683417c3c7d",
                                "text": "Freilich erheben die Herren den Anspruch, daß nur dasjenige, was von der Ministerbank kommt, Anspruch am Glanbwürdigkeit habe. (1911)"
                            },
                            {
                                "example_id": "839a6007-ebf3-481c-ac38-4704d6daeb78",
                                "sense_id": "42aec4cd-0043-3f89-9a5b-9683417c3c7d",
                                "text": "Auf der Ministerbank im Magdeburger Landtag knisterte es - und zwar nicht aus Zuneigung. (2014)"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
