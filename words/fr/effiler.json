    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "13606813-b84d-386b-ae2a-fdd1fd898efe",
                    "sense_definition": "Défaire fil à fil la trame d'un tissu, ou s'user en perdant ses fils.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "textile",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "À force d'être lavé en machine, le bas de ce jean commence à s'<w>effiler</w>."
                        },
                        {
                            "text": "La couturière a délicatement tiré sur la bordure pour <w>effiler</w> le tissu et créer des franges régulières."
                        }
                    ],
                    "synonyms": [
                        "effilocher"
                    ],
                    "antonyms": [
                        "tisser"
                    ],
                    "common_phrases": [
                        "effiler un tissu",
                        "effiler une étoffe"
                    ]
                },
                {
                    "sense_id": "65716b69-0908-37f9-b507-490a205d53fa",
                    "sense_definition": "Rendre plus mince vers la pointe ou tailler pour réduire l'épaisseur, notamment en coiffure.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "amincir",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le coiffeur a proposé d'<w>effiler</w> ses cheveux très épais afin de donner plus de légèreté à la coupe."
                        },
                        {
                            "text": "Avec les années, les traits fins de son visage semblaient s'<w>effiler</w> sous la lumière du matin."
                        }
                    ],
                    "synonyms": [
                        "amincir",
                        "désépaissir"
                    ],
                    "antonyms": [
                        "épaissir"
                    ],
                    "common_phrases": [
                        "effiler les cheveux",
                        "effiler une mèche"
                    ]
                },
                {
                    "sense_id": "a784cad4-3dae-3810-8f1d-87a5913e0097",
                    "sense_definition": "Retirer les fibres longitudinales dures de certains légumes avant de les préparer.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "cuisine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les enfants aidaient leur grand-mère à <w>effiler</w> les haricots verts fraîchement cueillis dans le potager."
                        },
                        {
                            "text": "Avant de plonger ces légumes dans l'eau bouillante, il faut absolument les équeuter et les <w>effiler</w>."
                        }
                    ],
                    "common_phrases": [
                        "effiler des haricots",
                        "effiler des haricots verts"
                    ]
                },
                {
                    "sense_id": "5cfa3324-7743-31cb-afc7-6d7e726c5bcd",
                    "sense_definition": "Épuiser ou énerver un chien de chasse en le faisant courir trop longtemps après le gibier.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "chasse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le piqueur craignait d'<w>effiler</w> sa meute en poursuivant un cerf insaisissable à travers les marais."
                        },
                        {
                            "text": "Faire courir ces jeunes chiens sur une fausse piste risque de les <w>effiler</w> avant la battue."
                        }
                    ],
                    "synonyms": [
                        "fatiguer",
                        "énerver"
                    ]
                }
            ]
        }
    ]
}