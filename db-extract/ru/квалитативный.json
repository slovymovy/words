                "translations": [
                    {
                        "translation_id": "21046cf9-4361-43ac-9314-0c2fd2e07797",
                        "source_entry_id": "23075deb-3734-3f92-ab30-947de4e72d9b",
                        "target_lang_word": "qualitative",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "qualitative",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "63945e67-6f9a-34b9-9af6-6b0749adaede",
                                        "entry_id": "977359a3-0446-3f5b-bf46-e94f3df0de42",
                                        "glosses": [
                                            "Of descriptions or distinctions based on some quality rather than on some quantity."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "22522bf0-c1e5-4388-a765-d9dc13d1bec3",
                                                "sense_id": "63945e67-6f9a-34b9-9af6-6b0749adaede",
                                                "text": "You may recall that I made a qualitative post about our level 100 talents a little more than a month ago. Now let’s look at them qualitatively."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f2bdb29c-8a64-3d9a-b94d-815506cfb4ba",
                                        "entry_id": "977359a3-0446-3f5b-bf46-e94f3df0de42",
                                        "glosses": [
                                            "Of a form of analysis that yields the identity of a compound."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a41b9ccf-ba93-3599-8042-e62c21d59af8",
                                        "entry_id": "977359a3-0446-3f5b-bf46-e94f3df0de42",
                                        "glosses": [
                                            "high-quality"
                                        ],
                                        "tags": [
                                            "Nigeria"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "qualitative",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7d52497c-0d5d-311a-b299-49621bdb1756",
                                        "entry_id": "b09b2a5c-b79a-3b73-b355-dc9f8aa1a67a",
                                        "glosses": [
                                            "Something qualitative."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "15907fdb-d968-40ae-b13d-3fc44eb7c0cd",
                        "source_entry_id": "23075deb-3734-3f92-ab30-947de4e72d9b",
                        "target_lang_word": "qualitatif",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "qualitatif",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "57ce828c-de58-3613-be33-b9012351fed0",
                                        "entry_id": "f114114d-7641-34c9-9b2c-f052c2ddedde",
                                        "glosses": [
                                            "Qui concerne la qualité (souvent par opposition à quantitatif)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89f8a04b-ae3b-4032-a537-4aa2cbc8956c",
                                                "sense_id": "57ce828c-de58-3613-be33-b9012351fed0",
                                                "text": "Les éléments qualitatifs d’une sensation sont ceux qui ne peuvent être exprimés par des nombres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2b4158be-816d-31a9-a61c-ed40159023aa",
                                        "entry_id": "f114114d-7641-34c9-9b2c-f052c2ddedde",
                                        "glosses": [
                                            "De qualité."
                                        ],
                                        "tags": [
                                            "neologism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f9d0fdf-214a-4505-a8dd-1947973ff494",
                                                "sense_id": "2b4158be-816d-31a9-a61c-ed40159023aa",
                                                "text": "Je les ai toutes et tous vus, tous traités, et je puis dire, sans vanité, que j’ai fait faire à la carrière de certains un saut qualitatif."
                                            },
                                            {
                                                "example_id": "7958dec3-01a5-4aa8-964a-2faa70a7c698",
                                                "sense_id": "2b4158be-816d-31a9-a61c-ed40159023aa",
                                                "text": "J’entreprenais là un véritable saut qualitatif dans l’escalade du mensonge."
                                            },
                                            {
                                                "example_id": "e807fd7b-d789-49cd-9640-787b8f8fa468",
                                                "sense_id": "2b4158be-816d-31a9-a61c-ed40159023aa",
                                                "text": "Pour parler de son produit qualitatif, il faut le magnifier !"
                                            },
                                            {
                                                "example_id": "e43c48ec-e458-46ca-8e71-17b3d0fb8879",
                                                "sense_id": "2b4158be-816d-31a9-a61c-ed40159023aa",
                                                "text": "Pour autant, ce partenariat, signé en mars 2016 pour cinq ans, va nous permettre de développer et de proposer un produit qualitatif."
                                            },
                                            {
                                                "example_id": "8ed9b4d3-1f9d-4dd1-9243-43070a9cc0eb",
                                                "sense_id": "2b4158be-816d-31a9-a61c-ed40159023aa",
                                                "text": "Utilisée en entretien, la cire d’abeille est un produit qualitatif réputé haut de gamme !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
