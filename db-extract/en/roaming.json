                "senses": [
                    {
                        "sense_id": "d2baba5e-c897-320c-b517-b7fd6f79a35f",
                        "entry_id": "2213a705-7f8e-3c72-9eb9-22e890fbbf03",
                        "glosses": [
                            "An instance of wandering."
