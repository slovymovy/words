                    {
                        "sense_id": "dcab3e5e-9738-3cc4-afcf-2a2af057da5a",
                        "entry_id": "66482d23-a766-300e-a0e5-ca736ecc50a5",
                        "glosses": [
                            "Vollversammlung einer Institution/Organisation"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a54f9bf5-5e40-4d44-a0d4-a43ce5a843e3",
                                "sense_id": "dcab3e5e-9738-3cc4-afcf-2a2af057da5a",
                                "text": "„Ich wollte von ihm wissen, wie das denn sei, wenn man das erste Mal im Plenum eine Rede halten müsse.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c894b87c-f503-45af-8730-372a366f6d8e",
                        "source_entry_id": "66482d23-a766-300e-a0e5-ca736ecc50a5",
                        "source_sense_id": "dcab3e5e-9738-3cc4-afcf-2a2af057da5a",
                        "source_sense_description": "Vollversammlung einer Institution/Organisation",
                        "target_lang_word": "plenum",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "plenum",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b05330dd-a7b0-391b-b203-95e82cf9ff4a",
                                        "entry_id": "5a3b1db3-d303-3bb5-8d05-61c81d6e3abf",
                                        "glosses": [
                                            "A space that is completely filled with matter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "92c19f28-502b-4b86-8e61-908e1e9a5a40",
                                                "sense_id": "b05330dd-a7b0-391b-b203-95e82cf9ff4a",
                                                "text": "The idea was that a thing could only move into an empty place, and that, in a plenum, there are no empty places."
                                            },
                                            {
                                                "example_id": "265cce1d-703b-43ed-850d-13fda4268ea9",
                                                "sense_id": "b05330dd-a7b0-391b-b203-95e82cf9ff4a",
                                                "text": "The key to understanding medieval interpretations of motion in hypothetically void space is to realize that medieval natural philosophers analyzed the same bodies in the void that they discussed in the plenum of their ordinary world."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "522ef952-ae26-3049-8221-500329e9f959",
                                        "entry_id": "5a3b1db3-d303-3bb5-8d05-61c81d6e3abf",
                                        "glosses": [
                                            "A state of fullness, a great quantity (of something)."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "22ec0962-d8d4-4ba5-b049-308a746b12b0",
                                                "sense_id": "522ef952-ae26-3049-8221-500329e9f959",
                                                "text": "He lay on the long stone slant down to the slapping waves, his denim shorts, sneakers, and socks under his head for a pillow, feeling the splendour of distance in all directions, the liquid silence, the plenum of aloneness."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "48e6b077-8942-34f5-ac76-fe807e5b4645",
                                        "entry_id": "5a3b1db3-d303-3bb5-8d05-61c81d6e3abf",
                                        "glosses": [
                                            "A legislative meeting (especially of the Communist Party) in which all members are present."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "451c0fc7-d487-3c91-ba14-19273cdff5cc",
                                        "entry_id": "5a3b1db3-d303-3bb5-8d05-61c81d6e3abf",
                                        "glosses": [
                                            "An enclosed space having greater than atmospheric pressure."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c3fa8e73-4d00-3e34-9486-23f64f21a255",
                                        "entry_id": "5a3b1db3-d303-3bb5-8d05-61c81d6e3abf",
                                        "glosses": [
                                            "The space above a false ceiling used for cables, ducts etc."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6f6be2f1-3fbf-3dd1-89e9-82cdada1111a",
                                        "entry_id": "5a3b1db3-d303-3bb5-8d05-61c81d6e3abf",
