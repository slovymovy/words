                    {
                        "sense_id": "cb90154f-fd4a-3aa6-b8e6-742aed0dfa7e",
                        "entry_id": "42f2dccd-4270-321e-8085-cd742573f8c1",
                        "glosses": [
                            "Montparnasse"
                        ],
                        "tags": [
                            "dated",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "f04d6da2-4ad8-4602-8edb-c19487cbef0e",
                                "sense_id": "cb90154f-fd4a-3aa6-b8e6-742aed0dfa7e",
                                "text": "Elle avait roulé sa bosse de la Butte à Montparno, en brûlant les pavés glissants du quartier Latin où l’on ne rencontre plus que pouillerie, débutantes sans astuces, bourriques pourchassant la prime et toute une métèquerie crasseuse, décharnée et ambitieuse."
                            },
                            {
                                "example_id": "4c09cb61-c0b2-43a5-be61-7aed8673dee9",
                                "sense_id": "cb90154f-fd4a-3aa6-b8e6-742aed0dfa7e",
                                "text": "Des p’tits bistros, de Montparno, ou de Grenelle"
                            }
                        ]
                    }
                ],
