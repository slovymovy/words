    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "418f3ef3-aabf-3914-b7e7-b2922c88658c",
                    "sense_definition": "To inspire with intense, unreasoning love or enthusiasm.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "influence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The young man was <w>infatuated</w> by her charm and followed her everywhere."
                        },
                        {
                            "text": "Her beauty seemed to <w>infatuate</w> everyone who met her at the party."
                        }
                    ],
                    "synonyms": [
                        "captivate",
                        "enamor",
                        "bewitch"
                    ]
                },
                {
                    "sense_id": "46bfa42e-c3b2-3674-a652-903f9c41020e",
                    "sense_definition": "To cause someone to act in a foolish or irrational manner.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "influence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Greed had <w>infatuated</w> him to the point where he ignored all logical advice."
                        },
                        {
                            "text": "The desire for power often <w>infatuates</w> leaders and leads to poor decisions."
                        }
                    ],
                    "synonyms": [
                        "befool",
                        "stupefy"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This usage is largely literary or dated."
                        }
                    ]
                }
            ]
        },
        {
