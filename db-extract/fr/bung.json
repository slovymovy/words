                                "sense_id": "2fe99ce3-134c-37fe-aa29-fa849e752435",
                                "text": "Des témoins ont affirmé devant la Haute Cour que Clough aimait recevoir un bung lorsqu’il achetait ou vendait un joueur à Nottingham Forest."
                            }
                        ]
                    },
                    {
                        "sense_id": "ae27d3a6-8868-3a94-b1ef-220f8fdea59b",
                        "entry_id": "8e1fa6b5-2ca5-3264-a3c9-f25dee198d7d",
                        "glosses": [
                            "Grosse mouche flottante pour la pêche à la mouche, servant de bouchon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0cd35ef-5cbc-4d96-b774-74983263e500",
                                "sense_id": "ae27d3a6-8868-3a94-b1ef-220f8fdea59b",
                                "text": "Sélection de 6 mouches pour découvrir la pêche en réservoir avec un bung, cette grosse mouche flottante que l'on monte sur une potence et qui sert littéralement d'indicateur."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d86012fc-da59-4848-b9f4-f3d52e1bcdf7",
                        "source_entry_id": "8e1fa6b5-2ca5-3264-a3c9-f25dee198d7d",
