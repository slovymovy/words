    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "686a3fc6-6e24-338f-b24b-d9f20a11e92d",
                    "sense_definition": "zmiana formy wyrazu w zależności od jego funkcji gramatycznej, np. przez przypadki lub osoby",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "językoznawstwo",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Odmiana</w> czasownika „być” w języku polskim jest nieregularna, więc trzeba się jej nauczyć na pamięć.",
                            "target_lang_translations": {
                                "ru": "<w>Спряжение</w> глагола «być» в польском языке неправильное, поэтому его нужно выучить наизусть."
                            }
                        },
                        {
                            "text": "Na dzisiejszej lekcji języka polskiego poznaliśmy reguły rządzące poprawną <w>odmianą</w> rzeczowników przez przypadki.",
                            "target_lang_translations": {
                                "ru": "На сегодняшнем уроке польского языка мы узнали правила, определяющие правильное <w>склонение</w> существительных по падежам."
                            }
                        }
                    ],
                    "synonyms": [
                        "fleksja"
                    ],
                    "common_phrases": [
                        "odmiana przez przypadki",
                        "odmiana przez osoby",
                        "odmiana czasownika"
                    ],
                    "target_lang_definitions": {
                        "ru": "изменение формы слова в зависимости от его грамматической функции (склонение, спряжение)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "словоизменение",
                                "target_lang_sense_clarification": "грамматическое изменение формы слова"
                            },
                            {
                                "target_lang_word": "склонение",
                                "target_lang_sense_clarification": "изменение по падежам (odmiana przez przypadki)"
                            },
                            {
                                "target_lang_word": "спряжение",
                                "target_lang_sense_clarification": "изменение глаголов по лицам и временам (odmiana przez osoby)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6eb5c4e8-00ea-3c00-9798-ad625b08e021",
                    "sense_definition": "zmiana dotychczasowego stanu rzeczy, urozmaicenie lub inna postać czegoś",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "zmiana",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zamiast codziennej herbaty wypiję dla <w>odmiany</w> filiżankę gorącej kawy z mlekiem.",
                            "target_lang_translations": {
                                "ru": "Вместо привычного чая я выпью для <w>разнообразия</w> чашку горячего кофе с молоком."
                            }
                        },
                        {
                            "text": "Taki krótki wyjazd za miasto to dla nas bardzo miła i potrzebna <w>odmiana</w>.",
                            "target_lang_translations": {
                                "ru": "Такая короткая поездка за город — это для нас очень приятная и нужная <w>перемена обстановки</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "dla odmiany",
                        "miła odmiana"
                    ],
                    "target_lang_definitions": {
                        "ru": "изменение привычного положения дел, разнообразие или непривычный вариант чего-либо"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перемена",
                                "target_lang_sense_clarification": "изменение ситуации, новизна"
                            },
                            {
                                "target_lang_word": "изменение",
                                "target_lang_sense_clarification": "переход в другое состояние"
                            },
                            {
                                "target_lang_word": "разнообразие",
                                "target_lang_sense_clarification": "новшество для смены обстановки"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e86d45f9-9102-3344-9506-04063b1e5644",
                    "sense_definition": "jednostka systematyczna niższa od gatunku, specyficzny typ lub wariant rośliny, zwierzęcia bądź zjawiska",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "klasyfikacja",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wyhodowana przez nas nowa <w>odmiana</w> pszenicy okazała się wyjątkowo odporna na mróz i suszę.",
                            "target_lang_translations": {
                                "ru": "Выведенный нами новый <w>сорт</w> пшеницы оказался исключительно устойчивым к морозу и засухе."
                            }
                        },
                        {
                            "text": "W przydomowym sadzie posadziliśmy rzadkie <w>odmiany</w> jabłoni, które owocują dopiero późną jesienią.",
                            "target_lang_translations": {
                                "ru": "В саду возле дома мы посадили редкие <w>сорта</w> яблонь, которые плодоносят только поздней осенью."
                            }
                        }
                    ],
                    "common_phrases": [
                        "odmiana jabłek",
                        "odmiana winorośli",
                        "odmiana regionalna"
                    ],
                    "target_lang_definitions": {
                        "ru": "таксономическая единица ниже вида; особый тип, сорт растения или разновидность явления"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сорт",
                                "target_lang_sense_clarification": "культурных растений"
                            },
                            {
                                "target_lang_word": "разновидность",
                                "target_lang_sense_clarification": "ботаническая или общая форма чего-либо"
                            },
                            {
                                "target_lang_word": "вариант",
                                "target_lang_sense_clarification": "модификация, версия явления"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}