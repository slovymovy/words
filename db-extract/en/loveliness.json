{
    "word": "loveliness",
    "lang_code": "en",
    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "a6f070eb-3af2-33fc-8520-c28cc6089da3",
                "word": "loveliness",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "5952b723-3d9a-41d2-9f9a-54a50d3afbd4",
                        "entry_id": "a6f070eb-3af2-33fc-8520-c28cc6089da3",
                        "tags": [
                            "plural"
                        ],
                        "form": "lovelinesses"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "118cc8ff-0411-3b66-97fa-50d12b7aafe5",
                        "entry_id": "a6f070eb-3af2-33fc-8520-c28cc6089da3",
                        "glosses": [
                            "The property of being lovely, of attractiveness, beauty, appearing to be lovable."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "8807f9bc-e287-473a-81ac-0bcee62ca7bd",
                                "sense_id": "118cc8ff-0411-3b66-97fa-50d12b7aafe5",
                                "text": "A thing of beauty is a joy for ever: / Its loveliness increases; it will never / Pass into nothingness; but still will keep / A bower quiet for us, and a sleep / Full of sweet dreams, and health, and quiet breathing."
                            },
                            {
                                "example_id": "a5e842d6-4283-4a4e-a37f-53b0e8567b20",
                                "sense_id": "118cc8ff-0411-3b66-97fa-50d12b7aafe5",
                                "text": "Then, seated in her barbaric chair above them all, with myself at her feet, was the veiled white woman, whose loveliness and awesome power seemed to visibly shine about her like a halo, or rather like the glow from some unseen light."
                            }
                        ]
                    },
                    {
                        "sense_id": "96b276b8-508c-32a8-aa4c-de2c3f343f7f",
                        "entry_id": "a6f070eb-3af2-33fc-8520-c28cc6089da3",
                        "glosses": [
                            "The result of being lovely."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "95862c73-0df2-3e0f-8b33-28b38529813d",
                        "entry_id": "a6f070eb-3af2-33fc-8520-c28cc6089da3",
                        "glosses": [
                            "A group of ladybirds."
                        ],
                        "tags": [
                            "collective",
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "7e1cb516-c56f-4643-be5b-fa02d6fbbc9e",
                                "sense_id": "95862c73-0df2-3e0f-8b33-28b38529813d",
                                "text": "'A loveliness of ladybirds,' whispers Roisin to her sleeping child, and looks at her husband proudly. He grins back. 'Aye, the plague of last summer. Couldn't pick up a glass of lemonade without finding a hundred ladybirds using it as a bubble-bath.'"
                            },
                            {
                                "example_id": "a8106b83-d899-40cd-ae50-33882cff7a1b",
                                "sense_id": "95862c73-0df2-3e0f-8b33-28b38529813d",
                                "text": "A loveliness of ladybugs is enjoying lunch - little aphids that pepper a crop of soybeans."
                            },
                            {
                                "example_id": "43f14290-be4c-45d1-9691-710e74803ae1",
                                "sense_id": "95862c73-0df2-3e0f-8b33-28b38529813d",
                                "text": "Sparks of sunlight caught on a loveliness of ladybirds that had floated into the waiting room through an open door."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c7046dbb-5c7b-4845-9489-0efcbf87365f",
                        "source_entry_id": "a6f070eb-3af2-33fc-8520-c28cc6089da3",
                        "source_sense_description": "property of being lovely",
                        "target_lang_word": "beauté",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "beauté",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "41bd0bec-fb50-3a0d-87f2-442439855cb9",
                                        "entry_id": "ecc68f6c-11b5-393b-9291-109ebe769597",
                                        "glosses": [
                                            "Qualité de ce qui est beau, de ce qui est esthétique à la perception."
                                        ],
                                        "tags": [],
                                        "note": "Se dit en général de ce qui touche et charme les sens, l’esprit, l’âme, de ce qui est excellent en son genre",
                                        "examples": [
                                            {
                                                "example_id": "e7580062-0968-4ed9-89cb-de643c854b1b",
                                                "sense_id": "41bd0bec-fb50-3a0d-87f2-442439855cb9",
                                                "text": "Nous arrêtons nos regards sur une femme seulement pour satisfaire le plaisir des yeux et pour contempler ce que les hommes appellent la beauté."
                                            },
                                            {
                                                "example_id": "c3e6932a-58f5-4538-a8ed-6f560219099d",
                                                "sense_id": "41bd0bec-fb50-3a0d-87f2-442439855cb9",
                                                "text": "Mais si la beauté impressionne les sens, elle ne saurait obtenir d’empire durable et puissant qu’autant qu’elle les subjugue."
                                            },
                                            {
                                                "example_id": "dc32718b-4e9f-47d0-b0d3-138a05b3f068",
                                                "sense_id": "41bd0bec-fb50-3a0d-87f2-442439855cb9",
                                                "text": "Deux pages parurent, portant des flambeaux et éclairant une femme d’une taille imposante, d’un maintien majestueux, et surtout d’une admirable beauté."
                                            },
                                            {
                                                "example_id": "15636aba-e04d-4b4f-a523-ea5c98105ea4",
                                                "sense_id": "41bd0bec-fb50-3a0d-87f2-442439855cb9",
                                                "text": "Qu’ai-je besoin de demander aux choses d’autres jouissances que celle de leur présence, c’est-à-dire leur beauté et leur parfum ?"
                                            },
                                            {
                                                "example_id": "d3a9cc10-41d1-4564-aed7-fa383da52746",
                                                "sense_id": "41bd0bec-fb50-3a0d-87f2-442439855cb9",
                                                "text": "— La beauté, pour une femme, c’est la plus grande richesse. La beauté suffit."
                                            },
                                            {
                                                "example_id": "7a057f7c-2609-4502-98c3-eb20cbd63a1e",
                                                "sense_id": "41bd0bec-fb50-3a0d-87f2-442439855cb9",
                                                "text": "Elle découvre des gestes de coquetterie qui, comme les gestes de pudeur, revêtent une sorte de beauté austère d’être accomplis dans la solitude."
                                            },
                                            {
                                                "example_id": "ea365cdf-2f78-4cdb-98be-106553e712f8",
                                                "sense_id": "41bd0bec-fb50-3a0d-87f2-442439855cb9",
                                                "text": "Il s’émerveille des beautés de la nature; des vergers riches d’arbres fruitiers, des vignes étagées sur les pentes situées au midi, des forêts verdoyantes qui drapent les pentes, douces d’abord puis abruptes, des vallées dominées par les massifs rocheux couronnés, encore à cette saison, par les sommets neigeux."
                                            },
                                            {
                                                "example_id": "e556266b-4125-4581-8949-f04ddae5b666",
                                                "sense_id": "41bd0bec-fb50-3a0d-87f2-442439855cb9",
                                                "text": "La stylique ou design est la valorisation esthétique d’un produit. Elle allie fonctionnalité et beauté. C’est un aspect fondamental lors de la mise en marché du produit."
                                            },
                                            {
                                                "example_id": "0d6ceb3f-dbb5-435a-98e4-fd0ec590f38a",
                                                "sense_id": "41bd0bec-fb50-3a0d-87f2-442439855cb9",
                                                "text": "C’était une femme de trente-deux à trente-trois ans, qui avait dû être d’une merveilleuse beauté avant que ses joues e fussent creusées, avant que son teint eût pâli."
                                            },
                                            {
                                                "example_id": "0d167e06-5672-4185-ac8a-9320961732ba",
                                                "sense_id": "41bd0bec-fb50-3a0d-87f2-442439855cb9",
                                                "text": "Quand je la menai à l’autel, j’étais bien convaincu que ma femme l’emportait en beauté sur toutes les femmes belles de la terre."
                                            },
                                            {
                                                "example_id": "f8f0d2d1-c4a0-4a69-9771-262d044b03ed",
                                                "sense_id": "41bd0bec-fb50-3a0d-87f2-442439855cb9",
                                                "text": "C’était à cette époque une femme de cinquante-deux à cinquante-trois ans à peu près, qui conservait, grâce à son embonpoint plein de fraîcheur, les traits de sa première beauté."
                                            },
                                            {
                                                "example_id": "4b6e8ba7-c210-442d-879a-85455e52aeca",
                                                "sense_id": "41bd0bec-fb50-3a0d-87f2-442439855cb9",
                                                "text": "Je vis que sa beauté, comme son caractère, était absolument sans fard. Ni rouge aux lèvres, ni fer aux cheveux ; rien aux cils ni aux paupières."
                                            },
                                            {
                                                "example_id": "88bce79f-dee1-4252-bf53-89e8982c7402",
                                                "sense_id": "41bd0bec-fb50-3a0d-87f2-442439855cb9",
                                                "text": "Elle est d’une beauté ravissante, de la plus grande beauté."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7d1543bc-f10e-379b-8819-2420944fce92",
                                        "entry_id": "ecc68f6c-11b5-393b-9291-109ebe769597",
                                        "glosses": [
                                            "Qualité, état de ce qui est bon en raison de sa valeur intellectuelle ou morale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "630953be-f2f6-4fb3-9a17-d65b08af7f37",
                                                "sense_id": "7d1543bc-f10e-379b-8819-2420944fce92",
                                                "text": "La beauté de l'âme."
                                            },
                                            {
                                                "example_id": "397d9f38-6c91-4fd5-9ae8-b8d617211aa5",
                                                "sense_id": "7d1543bc-f10e-379b-8819-2420944fce92",
                                                "text": "Les beautés de cet ouvrage en effacent, à mes yeux, les défauts."
                                            },
                                            {
                                                "example_id": "0f49475e-c917-4aed-8762-8b6f64be1966",
                                                "sense_id": "7d1543bc-f10e-379b-8819-2420944fce92",
                                                "text": "On a travaillé dur. Essayons de conclure en beauté."
                                            },
                                            {
                                                "example_id": "bb7c5923-5369-45fb-9b59-d2dee4b752e2",
                                                "sense_id": "7d1543bc-f10e-379b-8819-2420944fce92",
                                                "text": "Nous ne voyons pas de cause à la préférence que l’on accorde à la beauté morale sur la beauté physique, en admettant que le mépris pour la dernière soit véritable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "97612627-164b-3645-8859-34f1e9958902",
                                        "entry_id": "ecc68f6c-11b5-393b-9291-109ebe769597",
                                        "glosses": [
                                            "Jolie fille ou belle femme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c89d473-2bfd-4529-a629-2c87ba3ae8d8",
                                                "sense_id": "97612627-164b-3645-8859-34f1e9958902",
                                                "text": "[…], il a constaté que la guerre en Mandchourie manquait de récréations galantes, alors il a chargé ses hommes de confiance de lui recruter pour Moukden un lot de jeunes beautés dont la mission serait de chanter en petit comité pour distraire ses camarades de l'état-major, entre deux combats."
                                            },
                                            {
                                                "example_id": "b314de13-c0de-4e1c-b164-5ecef40a8c1d",
                                                "sense_id": "97612627-164b-3645-8859-34f1e9958902",
                                                "text": "Une beauté dédaigneuse, fière, célèbre. — Toutes les beautés de la ville étaient à cette fête."
                                            },
                                            {
                                                "example_id": "08414ae9-4c9e-4b96-8947-e7d8df10f60f",
                                                "sense_id": "97612627-164b-3645-8859-34f1e9958902",
                                                "text": "Beauté grecque et beauté romaine se disent des femmes dont la beauté rappelle le caractère des têtes que l’on voit dans les statues et dans les médailles antiques de la Grèce et de Rome."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7dd3892a-41f3-3c20-a219-81c3235d0d9a",
                                        "entry_id": "ecc68f6c-11b5-393b-9291-109ebe769597",
                                        "glosses": [
                                            "Belles choses."
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "69d8da25-1848-4b04-9414-5a542e522e42",
                                                "sense_id": "7dd3892a-41f3-3c20-a219-81c3235d0d9a",
                                                "text": "L’amour qui nous attache aux beautés éternelles\nN’étouffe pas en nous l’amour des temporelles ;\nNos sens facilement peuvent être charmés\nDes ouvrages parfaits que le Ciel a formés."
                                            },
                                            {
                                                "example_id": "91d03fe3-d2d4-4be7-9573-bc153ceb251f",
                                                "sense_id": "7dd3892a-41f3-3c20-a219-81c3235d0d9a",
                                                "text": "La vraie question : comment accorder la durée des beautés musicales avec la mutabilité du langage musical ?"
                                            },
                                            {
                                                "example_id": "cfc24167-6aa6-44a9-b30f-14951d4be308",
                                                "sense_id": "7dd3892a-41f3-3c20-a219-81c3235d0d9a",
                                                "text": "Oh ! le participe, présent et passé, voilà un trésor ! En sentez-vous bien, au moins, toutes les beautés ? Avez-vous mesuré le rôle qu’elles jouent et la place qu’elles tiennent dans cette savante évolution de notre idiome national ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9675ca19-3fe1-4316-85cc-9c286ba88f70",
                        "source_entry_id": "a6f070eb-3af2-33fc-8520-c28cc6089da3",
                        "source_sense_description": "property of being lovely",
                        "target_lang_word": "charme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "charme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "077d8cfc-ccc6-37ef-b19b-6ab97d610e03",
                                        "entry_id": "74cfe1a2-1300-37a9-80e9-872836b3142e",
                                        "glosses": [
                                            "Qualités aimables, attraits, séduction ou ascendant qu’exercent sur l’imagination les objets qui la frappent vivement et qui produisent sur elle l’admiration, l’enthousiasme."
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "34ac2556-f5dd-4e80-8a83-523e1af859f9",
                                                "sense_id": "077d8cfc-ccc6-37ef-b19b-6ab97d610e03",
                                                "text": "Belle Rowena, répondit de Bracy sur le même ton, c’est à vous, à vos propres charmes, qu’il faut attribuer tout ce que j’ai fait, […]."
                                            },
                                            {
                                                "example_id": "b1796849-dbf6-4f69-9350-e59e94fa4cbe",
                                                "sense_id": "077d8cfc-ccc6-37ef-b19b-6ab97d610e03",
                                                "text": "François se dévoyait auprès des filles publiques, […]. On dit que ces professionnelles ont des charmes secrets, des recettes magiques pour exaspérer la volupté de leurs clients et leur procurer des extases sans pareilles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4d54eb1b-f210-3ab8-9ea2-1bb8efcb2904",
                                        "entry_id": "74cfe1a2-1300-37a9-80e9-872836b3142e",
                                        "glosses": [
                                            "Pouvoir de séduction ; talent de charmer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df4895a2-e5ba-4e6f-b53f-6fea368f6209",
                                                "sense_id": "4d54eb1b-f210-3ab8-9ea2-1bb8efcb2904",
                                                "text": "Son plus grand charme venait d’une physionomie dont le calme trahissait une étonnante profondeur dans l’âme."
                                            },
                                            {
                                                "example_id": "8d01842c-f2f6-439b-9fe4-2f285f2f1bff",
                                                "sense_id": "4d54eb1b-f210-3ab8-9ea2-1bb8efcb2904",
                                                "text": "Les Liméniennes ont toutes de belles couleurs, […], des yeux noirs d’une expression indéfinissable d’esprit, de fierté et de langueur ; c’est dans cette expression qu’est tout le charme de leur personne."
                                            },
                                            {
                                                "example_id": "882033e9-9357-48f4-b9bf-b43645fa8d4d",
                                                "sense_id": "4d54eb1b-f210-3ab8-9ea2-1bb8efcb2904",
                                                "text": "Comme tous ceux qui écrivent beaucoup, Balzac parlait peu... Mais, dès qu'il parlait, le charme opérait. Il y avait, dans sa parole, une telle autorité, une telle séduction, qu'on oubliait très vite ses disgrâces physiques."
                                            },
                                            {
                                                "example_id": "d8b57b78-8826-4d33-b6b1-6ae5a1732e06",
                                                "sense_id": "4d54eb1b-f210-3ab8-9ea2-1bb8efcb2904",
                                                "text": "Un air vieux, languissant et funèbre\nqui pour moi seul a des charmes secrets."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "62aa070e-3508-3d29-96f9-0dbcdb3d8bbd",
                                        "entry_id": "74cfe1a2-1300-37a9-80e9-872836b3142e",
                                        "glosses": [
                                            "Attraits sexuels d’une fille ou d’une femme."
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a34d718f-e216-4ed2-854f-c1de0d15195f",
                                                "sense_id": "62aa070e-3508-3d29-96f9-0dbcdb3d8bbd",
                                                "text": "Et cependant les sabots garnis de dentelles découvraient admirablement ses bras nus, la gorge s’encadrait dans le pur corsage aux tulles jaunis, aux rubans passés, qui n’avait serré que bien peu les charmes évanouis de la tante."
                                            },
                                            {
                                                "example_id": "47179e8d-3b7d-4ff5-8773-1bcfe7291d6d",
                                                "sense_id": "62aa070e-3508-3d29-96f9-0dbcdb3d8bbd",
                                                "text": "Les charmes quelque peu fanés de la descendante des Pignon-Mouillet n’étaient plus tels qu’ils attirassent encore irrésistiblement le mâle impétueux qu’était resté le vieux militaire."
                                            },
                                            {
                                                "example_id": "c86234b4-0d74-4f92-ad44-a005aa246f41",
                                                "sense_id": "62aa070e-3508-3d29-96f9-0dbcdb3d8bbd",
                                                "text": "La bergère, après bien des larmes,\nPour se consoler prit un mari,\nEt ne dévoila plus ses charmes\nQue pour lui…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e1e06811-6998-3872-992e-825981bc1ee1",
                                        "entry_id": "74cfe1a2-1300-37a9-80e9-872836b3142e",
                                        "glosses": [
                                            "Sentiment délicieux que fait éprouver ce qui intéresse le cœur, ce qui fait naître de douces sensations."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f0bf458-7e34-4a13-aba1-73e0b6aa9701",
                                                "sense_id": "e1e06811-6998-3872-992e-825981bc1ee1",
                                                "text": "Quand on traverse pour la première fois une rivière islandaise, on ne peut se défendre de la crainte; mais on s’accoutume vite à ce genre d’émotion, et l'on finit même par y trouver un certain charme."
                                            },
                                            {
                                                "example_id": "2b3a0e59-22b4-4a0c-a65d-1ee4a1d70ad6",
                                                "sense_id": "e1e06811-6998-3872-992e-825981bc1ee1",
                                                "text": "Par exemple arriver chez sa nouvelle blonde avec un tétrapack de vin rouge… ça brise le charme d'un souper en tête à tête."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b34cb51-844a-32b9-8987-ddfb1d47277e",
                                        "entry_id": "74cfe1a2-1300-37a9-80e9-872836b3142e",
                                        "glosses": [
                                            "Sort lancé sur une personne ; sortilège, enchantement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70f50c74-c944-407a-9a0b-2cbf651f559e",
                                                "sense_id": "1b34cb51-844a-32b9-8987-ddfb1d47277e",
                                                "text": "Par la messe ! je crois que le vieux Lucas de Beaumanoir a bien deviné juste, quand il affirme qu’elle a jeté un charme sur vous."
                                            },
                                            {
                                                "example_id": "7322b665-a95d-4c0f-8732-41f6bdf23c50",
                                                "sense_id": "1b34cb51-844a-32b9-8987-ddfb1d47277e",
                                                "text": "Mon fils, mon cher fils ! […] c'est Dieu qui nous a envoyé cette jeune fille pour détruire l'horrible charme dont vous étiez environné, et vous venger du mal qui vous a été fait, à vous et à votre mère."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "charme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d349394f-0581-3828-8647-5c2f0f96acd3",
                                        "entry_id": "497d1abd-9b2d-3ebe-a3da-9822a4946027",
                                        "glosses": [
                                            "Genre d'arbres et d'arbustes de la famille des bétulacées des régions tempérées de l'hémisphère nord, d'Asie Mineure et d'Europe qui sont des arbres pouvant mesurer jusqu'à 25 mètres, à feuilles caduques, alternes, petites (de 3 à 10 cm de long), simples, avec le bord du limbe finement denté, aux fleurs regroupées en inflorescences, en forme de chatons pendants, pollinisées par le vent et dont les fruits sont des akènes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "324d8480-8ca8-4a72-ae7a-41af302c881b",
                                                "sense_id": "d349394f-0581-3828-8647-5c2f0f96acd3",
                                                "text": "Le Charme très abondant forme parfois avec la Clématite des fourrés obscurs presque impénétrables."
                                            },
                                            {
                                                "example_id": "6807ca0b-d579-4963-8e6d-bd912ce65c28",
                                                "sense_id": "d349394f-0581-3828-8647-5c2f0f96acd3",
                                                "text": "Le domaine médio-européen est caractérisé par quelques arbres qui y trouvent leur aire essentielle : le Charme, l’Érable plane, le Mélèze."
                                            },
                                            {
                                                "example_id": "155465e2-fc58-4d87-984f-497cf2f3f536",
                                                "sense_id": "d349394f-0581-3828-8647-5c2f0f96acd3",
                                                "text": "Le charme perdit quelques branches mais ses racines étaient si profondes qu'il arrivait à puiser de l'eau dans les couches les plus lointaines de la terre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e76c3062-98e3-384f-a9cd-99086aa15671",
                                        "entry_id": "497d1abd-9b2d-3ebe-a3da-9822a4946027",
                                        "glosses": [
                                            "Bois du même arbre."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "68c03370-7dab-40a0-890b-38ec237ff8fb",
                                                "sense_id": "e76c3062-98e3-384f-a9cd-99086aa15671",
                                                "text": "Le charme s'emploie beaucoup dans le charronnage."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "charme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d89b40a9-1dcf-340a-ac1c-7f647c30bbb2",
                                        "entry_id": "11f223a6-327b-350e-99d8-13830b674757",
                                        "glosses": [
