                "forms": [
                    {
                        "form_id": "4d2e6839-feae-47e8-98e5-933774221262",
                        "entry_id": "21943bc4-75ed-3b11-9a7a-7ef567079cf2",
                        "tags": [
                            "plural"
                        ],
                        "form": "magnétiseurs"
                    },
                    {
                        "form_id": "cdb8f0dd-211c-42f3-8870-d02a924d7d07",
                        "entry_id": "21943bc4-75ed-3b11-9a7a-7ef567079cf2",
                        "tags": [
                            "feminine"
                        ],
                        "form": "magnétiseuse"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a3c8ee2d-d0b8-3397-8334-601783bb53cf",
                        "entry_id": "21943bc4-75ed-3b11-9a7a-7ef567079cf2",
                        "glosses": [
                            "Personne qui pratique les procédés du magnétisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e177b41-b2c7-479b-bb31-e9f0395ecf5e",
                                "sense_id": "a3c8ee2d-d0b8-3397-8334-601783bb53cf",
                                "text": "Il s'agit, en effet, par un effort intense du magnétiseur, de parvenir à l'état de dédoublement mental, puis d'agir par télépsychie."
                            },
                            {
                                "example_id": "907f17fa-7072-4948-a7ce-b06071d6deca",
                                "sense_id": "a3c8ee2d-d0b8-3397-8334-601783bb53cf",
                                "text": "Une ouvreuse […] vous offre un programme qui est une merveille d’art tout à la fois spiritualiste et positiviste : Indien qui maquille les cartes, dame qui s’intitule chiromancienne et graphologue, magnétiseur, somnambules."
                            },
                            {
                                "example_id": "b56dfe51-6a95-47e6-9582-be124573e66e",
                                "sense_id": "a3c8ee2d-d0b8-3397-8334-601783bb53cf",
                                "text": "Cette aura si particulière, ce sont ses détracteurs, ignorants et jaloux de ses possibilités, qui la lui ont donnée, au fil du temps : conformément au proverbe « Qui veut noyer son chien, l'accuse de la rage », les autorités académiques ont, pour défendre leur position dominante de rigide certitude, calomnié la pratique des magnétiseurs et, plus tard, caricaturé celle des médecins hypnotiseurs."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c4a30647-a43e-4d9a-aa44-229a8d268538",
                        "source_entry_id": "21943bc4-75ed-3b11-9a7a-7ef567079cf2",
                        "source_sense_id": "a3c8ee2d-d0b8-3397-8334-601783bb53cf",
                        "target_lang_word": "mesmerist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mesmerist",
