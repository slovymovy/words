                ],
                "senses": [
                    {
                        "sense_id": "f9b3008a-90f4-3d2b-b05c-d435f6dc7c9f",
                        "entry_id": "3e2e7004-039e-3bb8-ae70-7bdb38d9df10",
                        "glosses": [
                            "ogrodzony teren, na którym hoduje się bażanty"
                        ],
                        "tags": [
                            "zootechn."
                        ],
                        "examples": [
                            {
                                "example_id": "0ee7c4b4-11bb-4681-9f4f-e57ccec659da",
                                "sense_id": "f9b3008a-90f4-3d2b-b05c-d435f6dc7c9f",
                                "text": "Oskar Rudziński rozbudował gospodarstwo: przebudował stawy, w których hodowano ryby, odwodnił ziemię, zbudował cegielnię i gorzelnię, założył bażantarnię."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d4d693f9-0e10-49be-a541-63a8b7711f92",
                        "source_entry_id": "3e2e7004-039e-3bb8-ae70-7bdb38d9df10",
                        "source_sense_id": "f9b3008a-90f4-3d2b-b05c-d435f6dc7c9f",
                        "target_lang_word": "faisanderie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "faisanderie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "46484f49-b9f7-3b30-aba2-f810a986e6e2",
                                        "entry_id": "dee935ac-b07e-33e8-89b2-a1a5a6aa2438",
                                        "glosses": [
                                            "Lieu où l’on élève des faisans."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "42f25953-e65b-4c63-8ef8-72f0d390a9f2",
                                                "sense_id": "46484f49-b9f7-3b30-aba2-f810a986e6e2",
                                                "text": "La basse-cour, les écuries, l’étable reportées dans les bâtiments de la faisanderie et cachées par des massifs, au lieu d’attrister le regard par leurs inconvénients, mêlaient au continuel bruissement particulier aux forêts ces murmures, ces roucoulements, ces battements d’ailes, l’un des plus délicieux accompagnements de la continuelle mélodie que chante la nature."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a605c8f-dde5-3317-8357-bb2f1f3dc9c5",
                                        "entry_id": "dee935ac-b07e-33e8-89b2-a1a5a6aa2438",
                                        "glosses": [
                                            "Ensemble des escrocs, maîtres-chanteurs, voleurs, etc."
                                        ],
                                        "tags": [
                                            "pejorative",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a38b05c6-cb29-4b76-95ac-0a7a7ad2df71",
                                                "sense_id": "0a605c8f-dde5-3317-8357-bb2f1f3dc9c5",
                                                "text": "Mieux vaut […] m’évader de ce milieu de faisans et rejoindre les miens, les pauvres bougres de travailleurs […]. Reprends ta plume, Henri Fagerolle, celle du poète et du romancier, et mets-toi à la besogne. Il ne te restera de ton court passage dans la faisanderie qu’un invincible dégoût et beaucoup d’amère expérience."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "984d8c0c-767b-4c4b-a6e5-3dcd3b1ee243",
                        "source_entry_id": "3e2e7004-039e-3bb8-ae70-7bdb38d9df10",
                        "source_sense_id": "f9b3008a-90f4-3d2b-b05c-d435f6dc7c9f",
                        "target_lang_word": "фаза́нья",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "c5995a91-1dc4-474e-b5ac-a736f242926c",
                        "source_entry_id": "3e2e7004-039e-3bb8-ae70-7bdb38d9df10",
                        "source_sense_id": "f9b3008a-90f4-3d2b-b05c-d435f6dc7c9f",
                        "target_lang_word": "фе́рма",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "фе́рма",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "4dd8c4f0-ae2c-33fd-9f90-35daddbe93ab",
                                        "entry_id": "dfeacd6e-3b0f-3259-8a24-5a6f7e0a6021",
                                        "glosses": [
                                            "с.-х. частное сельскохозяйственное предприятие на собственном или арендуемом участке"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b786567b-b220-49b9-8249-e32790a78e75",
                                                "sense_id": "4dd8c4f0-ae2c-33fd-9f90-35daddbe93ab",
                                                "text": "У нас скотоводческая ферма в Баварии, и выгоднее кормить несколько лишних голов скота, чем лишних рабочих."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c4df91e0-f9bc-3026-8e8a-034e7bb6047a",
                                        "entry_id": "dfeacd6e-3b0f-3259-8a24-5a6f7e0a6021",
                                        "glosses": [
                                            "истор. специализированное животноводческое подразделение сельскохозяйственного предприятия"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e997753-699f-4733-88b8-5d477d747bc6",
                                                "sense_id": "c4df91e0-f9bc-3026-8e8a-034e7bb6047a",
                                                "text": "Наконец, под Детским Селом построена молочная ферма ЛСПО на 1200 голов скота."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "732b3df7-e56a-3866-9d25-ae7ab0c6b651",
                                        "entry_id": "dfeacd6e-3b0f-3259-8a24-5a6f7e0a6021",
                                        "glosses": [
                                            "комп. группа серверов"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d0ebac2-00e5-472d-8a81-da3f7954b06a",
                                                "sense_id": "732b3df7-e56a-3866-9d25-ae7ab0c6b651",
                                                "text": "Для каждого узла фермы серверов можно отдельно выполнять резервное копирование и восстановление, а также устанавливать квоты для дискового пространства, занимаемого узлом и автоматически отправлять владельцу узла уведомления при достижении предельного размера узла."
                                            },
                                            {
                                                "example_id": "c3e41a04-ea2a-40e6-8422-4f6a7b843621",
                                                "sense_id": "732b3df7-e56a-3866-9d25-ae7ab0c6b651",
                                                "text": "Во время параллельной миграции определяются и конфигурируются новые фермы серверов приложений параллельно существующему окружению. В определённый момент времени они заменяют старые фермы и работают параллельно с другими фермами, не имея с ними общих точек соприкосновения."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "фе́рма",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "f73289ef-819f-3354-8b13-1f64e10b4802",
                                        "entry_id": "0e51ecb7-1b13-38f4-891d-932deb30b754",
                                        "glosses": [
                                            "строит. сооружение из скреплённых концами стержней, брусьев и т. п."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b0d50b6-7ce2-4fb8-aba2-8ac6a31e7740",
                                                "sense_id": "f73289ef-819f-3354-8b13-1f64e10b4802",
                                                "text": "Ферма весом не менее четырёхсот тонн была поднята нами за три месяца на высоту двенадцати метров над водой очень простыми приёмами."
                                            },
                                            {
                                                "example_id": "299db982-2457-448e-b196-0f66a539f472",
                                                "sense_id": "f73289ef-819f-3354-8b13-1f64e10b4802",
                                                "text": "Здесь, между кирпичными быками, торчит рухнувшая в реку ферма взорванного моста."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
