                        "cross_references": [
                            {
                                "target_word": "polyester",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0f1bd118-5755-3db3-be51-9c284e233b22",
                                        "entry_id": "3264a8a4-7f77-3fc6-8d29-d8be35c2901b",
                                        "glosses": [
                                            "Polymère dont le squelette macromoléculaire contient la répétition de la fonction chimique ester."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64fdd669-2531-4737-a146-f11cc32a4c73",
                                                "sense_id": "0f1bd118-5755-3db3-be51-9c284e233b22",
                                                "text": "Les éléments longitudinaux sont également continus; les quilles, contre-quilles et lisses sont en acajou; les élongis très largement dimensionnés sont en polyester renforcé de structure mixte mat-roving."
                                            },
                                            {
                                                "example_id": "7851694e-38a0-455f-af1d-a7da558c7ae8",
                                                "sense_id": "0f1bd118-5755-3db3-be51-9c284e233b22",
                                                "text": "C'est le cas par exemple de la réaction d'un diacide sur un dialcool qui donne naissance à un polyester et à de l'eau qui doit être éliminée si on souhaite que la réaction conduise effectivement à des grandes molécules."
                                            },
                                            {
                                                "example_id": "4f00661b-21f6-4694-9f09-0c210c5a5048",
                                                "sense_id": "0f1bd118-5755-3db3-be51-9c284e233b22",
                                                "text": "« Les prélèvements ont montrés des quantités significatives de fibres de polyester, d'acrylique, de nylon et de prolypropylène », écrit dans un communiqué Imogen Napper, chercheuse à l'université britannique de Plymouth et qui fait partie des explorateurs."
                                            },
                                            {
                                                "example_id": "6434190e-1e66-48ea-9440-5445e796afdc",
                                                "sense_id": "0f1bd118-5755-3db3-be51-9c284e233b22",
                                                "text": "Fabriquées en polyester, une matière dérivée du pétrole, importées de Chine, colorées en France, destinées à engranger du profit et à faire des selfies, une chose est claire : avec ces fleurs, on est nous aussi au bord de l’écoterrorisme."
                                            },
                                            {
                                                "example_id": "9f202038-8ce4-4d8a-9fa2-fa2ce2137019",
                                                "sense_id": "0f1bd118-5755-3db3-be51-9c284e233b22",
                                                "text": "Outre sa proximité avec les quais de la Pallice et leurs moyens de grutage, le Chantier de l’arsenal bénéficiera aussi du déménagement à proximité de l’un de ses principaux fournisseurs, la société Jedo qui découpe les panneaux de polyester à assembler pour les Day 1."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "98e90ddd-3caa-3729-b2f2-19593ee0a810",
                                        "entry_id": "3264a8a4-7f77-3fc6-8d29-d8be35c2901b",
                                        "glosses": [
                                            "Tissus réalisé avec des fils constitués de fibres de polyester."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
