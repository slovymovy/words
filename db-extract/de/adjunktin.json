                "translations": [
                    {
                        "translation_id": "969ae296-c6c6-4299-8a16-303a8a663432",
                        "source_entry_id": "1f0f63f2-09c5-3f97-b6f5-bf3e3ce76795",
                        "source_sense_id": "97e58b33-6923-3560-b239-81be45cb6843",
                        "source_sense_description": "Beamtin oder veraltet: Gehilfin eines Beamten/einer Beamtin",
                        "target_lang_word": "adjunct",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "adjunct",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c2afdfda-5b1d-3a85-8849-1601d02bdb4b",
                                        "entry_id": "71a3b75a-1b79-32c4-a975-ed0688945dd0",
                                        "glosses": [
                                            "An appendage; something attached to something else in a subordinate capacity."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f0713290-3b17-4291-bd7d-34a14904c607",
                                                "sense_id": "c2afdfda-5b1d-3a85-8849-1601d02bdb4b",
                                                "text": "Lie here ye weedes that I diſdaine to weare,\nThis compleat armor, and this curtle-axe / Are adiuncts more beſeeming Tamburlaine."
                                            },
                                            {
                                                "example_id": "5e44cfda-c2d8-41a6-a57e-f3c22fcd005e",
                                                "sense_id": "c2afdfda-5b1d-3a85-8849-1601d02bdb4b",
                                                "text": "Learning is but an adiunct to our ſelfe,\nAnd where we are, our Learning likewiſe is."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8469fff7-ad41-3b15-bd99-115beb1b0b41",
                                        "entry_id": "71a3b75a-1b79-32c4-a975-ed0688945dd0",
                                        "glosses": [
                                            "A person associated with another, usually in a subordinate position; a colleague."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9af2af49-6824-47d8-b408-56c67a66f1dd",
                                                "sense_id": "8469fff7-ad41-3b15-bd99-115beb1b0b41",
                                                "text": "[H]e made him the aſſociate of his Heir apparant, together vvith the nevv Lord Cottington (as an adjunct of ſingular experience and truſt) in forraine travailes, and in a buſineſſe of Love, and of no equall hazzard […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "362e3668-b508-358d-a159-3378505293fe",
                                        "entry_id": "71a3b75a-1b79-32c4-a975-ed0688945dd0",
                                        "glosses": [
                                            "Ellipsis of adjunct professor."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "06faa8b7-d9a5-4bd4-8c7b-65014604f5b4",
                                                "sense_id": "362e3668-b508-358d-a159-3378505293fe",
                                                "text": "I've been given the chance to do this through my own department and through university programmes that don't have tenure-track lines and are therefore more likely to seek assistance from adjuncts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b29988b4-5943-3020-b94e-40bc3b2fef76",
                                        "entry_id": "71a3b75a-1b79-32c4-a975-ed0688945dd0",
                                        "glosses": [
                                            "An unmalted grain or grain product that supplements the main mash ingredient."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4b9d4ded-854f-394b-a1fb-368191dd1faa",
                                        "entry_id": "71a3b75a-1b79-32c4-a975-ed0688945dd0",
                                        "glosses": [
                                            "A quality or property of the body or mind, whether natural or acquired, such as colour in the body or judgement in the mind."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8da00995-5224-337b-abfd-a579b2efc416",
                                        "entry_id": "71a3b75a-1b79-32c4-a975-ed0688945dd0",
                                        "glosses": [
                                            "A key or scale closely related to another as principal; a relative or attendant key."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "44ccb009-4248-3e80-9057-7013bce638f6",
                                        "entry_id": "71a3b75a-1b79-32c4-a975-ed0688945dd0",
                                        "glosses": [
                                            "A phrase within a clause or sentence that is grammatically dispensable but not semantically so, modifying the meaning."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b0a7d51a-9b9b-433b-b880-24587a5f8e91",
                                                "sense_id": "44ccb009-4248-3e80-9057-7013bce638f6",
                                                "text": "When a female enters the profession, she is generally not referred to as doctor but as a lady doctor or woman doctor. The use of \"feminizing\" adjuncts designates a deviation from the norm, doctor, and does not carry the weight of the term unmodified."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9509d7a1-f9ce-3eca-8319-0914771656ec",
                                        "entry_id": "71a3b75a-1b79-32c4-a975-ed0688945dd0",
                                        "glosses": [
                                            "A graphic element that modifies another, such as (in Linear B script) a small syllabogram that is attached to a logogram as an abbreviation of an adjective that modifies that logogram (rather than as a phonetic complement that disambiguates the logogram)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b59b5151-17b0-3781-a63a-61ce7c9eb3de",
                                        "entry_id": "71a3b75a-1b79-32c4-a975-ed0688945dd0",
                                        "glosses": [
                                            "A constituent which is both the daughter and the sister of an X-bar."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12d69d5e-6956-4ec3-b40a-556a75398085",
                                                "sense_id": "b59b5151-17b0-3781-a63a-61ce7c9eb3de",
                                                "text": "We can see from (34) that Determiners are sisters of N-bar and daughters of N-double-bar; Adjuncts are both sisters and daughters of N-bar; and Complements are sisters of N and daughters of N-bar. This means that Adjuncts resemble Complements in that both are daughters of N-bar; but they differ from Complements in that Adjuncts are sisters of N-bar, whereas Complements are sisters of N. Likewise, it means that Adjuncts resemble Determiners in that both are sisters of N-bar, but they differ from Determiners in that Adjuncts are daughters of N-bar, whereas Determiners are daughters of N-double-bar."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dc68039a-2e04-3478-83ad-cb56a1cbca33",
                                        "entry_id": "71a3b75a-1b79-32c4-a975-ed0688945dd0",
                                        "glosses": [
                                            "Symploce."
                                        ],
                                        "tags": [
                                            "rhetoric"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8dbdcab2-e13f-3703-9945-04f439a75792",
                                        "entry_id": "71a3b75a-1b79-32c4-a975-ed0688945dd0",
                                        "glosses": [
                                            "One of a pair of morphisms which relate to each other through a pair of adjoint functors."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "adjunct",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8a12e91a-1c0e-379e-8117-b3101fc17e58",
                                        "entry_id": "b1563057-9cc8-3a16-a4e1-c0beb6005e6d",
                                        "glosses": [
                                            "Connected in a subordinate function."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93ef3ad1-3163-4e28-84cd-7d14470db55e",
                                                "sense_id": "8a12e91a-1c0e-379e-8117-b3101fc17e58",
                                                "text": "Though that my death were adiunct to my Act,\nBy heauen I would doe it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e81e068-cbea-3c6a-871f-b4b34c01df92",
                                        "entry_id": "b1563057-9cc8-3a16-a4e1-c0beb6005e6d",
                                        "glosses": [
                                            "Added to a faculty or staff in a secondary position."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "adjunct",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1676684c-f35f-3487-9467-693f68b1ab6e",
                                        "entry_id": "3c307b81-a1c9-3f7e-ab2a-8e316428edb5",
                                        "glosses": [
                                            "To work as an adjunct professor."
                                        ],
                                        "tags": [
                                            "informal",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f68e0450-d962-4f92-9d5d-613b82c47438",
                                                "sense_id": "1676684c-f35f-3487-9467-693f68b1ab6e",
                                                "text": "I also nannied through the first part of graduate school. I had friends who bartended or worked at a wine store and also adjuncted. A lot of people would package these jobs together."
                                            },
                                            {
                                                "example_id": "10c7c39b-2c52-498a-9ace-c86c59385066",
                                                "sense_id": "1676684c-f35f-3487-9467-693f68b1ab6e",
                                                "text": "A sudden fantasy emerges of Adam adjuncting at Hannah's college, a sweet Mr. Mom to Paul-Louis' (Riz Ahmed) baby while Hannah becomes a professor slash internet celeb -- but there I go writing fanfiction."
                                            },
                                            {
                                                "example_id": "d2494360-b993-4ca0-9904-10dd7ff23f13",
                                                "sense_id": "1676684c-f35f-3487-9467-693f68b1ab6e",
                                                "text": "In Want, out this month, Strong homes in on those themes. In this novel, her second, narrator Elizabeth is raising two small children with her husband, a carpenter, in New York City, while going through a bankruptcy and teaching low-income students at a charter school and adjuncting at a prestigious university."
                                            },
                                            {
                                                "example_id": "277e136a-4ba4-48f2-bd3e-6b694ba09338",
                                                "sense_id": "1676684c-f35f-3487-9467-693f68b1ab6e",
                                                "text": "I wish I had a cut and dry answer to this question. When I adjunct at the University of Baltimore, I get asked a similar question by my students every semester."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
