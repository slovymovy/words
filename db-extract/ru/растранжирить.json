                        "source_sense_id": "cb26b3cf-d2c9-3bdc-8765-e077e6ddd1dc",
                        "target_lang_word": "verjubeln",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verjubeln",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3d284c25-2288-3330-bf92-215ff134f10b",
                                        "entry_id": "a3983d11-c710-3bc6-b997-d81d1eb362dc",
                                        "glosses": [
                                            "sein Geld, Vermögen, Erbe oder Ähnliches leichtsinnig, planlos, in großem Stil zum eigenen Vergnügen aufbrauchen"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "869502a5-c11f-4e26-901c-0b91ca85ad58",
                                                "sense_id": "3d284c25-2288-3330-bf92-215ff134f10b",
                                                "text": "„Zwei Jugendliche haben im Darknet falsche 50-Euro-Scheine bestellt und diese in Münchner Diskotheken und Restaurants verjubelt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "480fbea1-b43c-46ee-85a5-3f157376b3b5",
                        "source_entry_id": "8ce920d7-208d-315e-97c8-5f019813e241",
                        "source_sense_id": "cb26b3cf-d2c9-3bdc-8765-e077e6ddd1dc",
                        "target_lang_word": "verprassen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verprassen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8dcb9f70-6473-34a9-a340-898ef051bd88",
                                        "entry_id": "f84e69d0-f7ca-37cc-a486-6a5421d7a91a",
                                        "glosses": [
                                            "eine Ressource (besonders Geld) nicht sachgerecht, aber zum eigenen Vergnügen, verbrauchen"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "derogatory",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f4e98177-2fb2-48ca-9403-fdd01cae6e8f",
                                                "sense_id": "8dcb9f70-6473-34a9-a340-898ef051bd88",
                                                "text": "Klaus hat das ganze Geld im Kasino verprasst."
                                            },
                                            {
                                                "example_id": "3f88e4e2-0fb0-4616-a933-2119f778d935",
                                                "sense_id": "8dcb9f70-6473-34a9-a340-898ef051bd88",
                                                "text": "[Der nordirische Fußballer George Best:] „[Ich habe viel Geld] für Alkohol, Frauen und schnelle Autos ausgegeben, […] den Rest habe ich einfach verprasst.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0929f907-200e-407d-8a06-1451e3a5f52a",
                        "source_entry_id": "8ce920d7-208d-315e-97c8-5f019813e241",
                        "source_sense_id": "cb26b3cf-d2c9-3bdc-8765-e077e6ddd1dc",
                        "target_lang_word": "veruntreuen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "veruntreuen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "de7c10d4-8788-31c2-b0ce-58e4f6c5a88c",
                                        "entry_id": "1bf7a5b4-e56e-3736-9280-b4e6794f205f",
                                        "glosses": [
                                            "fremdes Geld (seltener auch Waren), auf die eine Person rechtmäßig Zugriff hat, für einen anderen Zweck als erlaubte Zwecke einsetzen (ganz besonders, wenn der andere Zweck die persönliche Bereicherung ist)"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f432fdf7-29bb-4dd6-b90b-36f5273f3b12",
                                                "sense_id": "de7c10d4-8788-31c2-b0ce-58e4f6c5a88c",
                                                "text": "Er hatte ihm anvertraute Gelder veruntreut."
                                            },
                                            {
                                                "example_id": "d7b0f811-9fb3-490b-83d1-c7d2111ba49e",
                                                "sense_id": "de7c10d4-8788-31c2-b0ce-58e4f6c5a88c",
                                                "text": "Er hatte die ihm anvertrauten Gelder veruntreut."
                                            },
                                            {
                                                "example_id": "e5979375-ea58-4020-9b33-cc9239d89321",
                                                "sense_id": "de7c10d4-8788-31c2-b0ce-58e4f6c5a88c",
                                                "text": "„Wegen Teilnehmung am Diebstahl oder an einer Veruntreuung sollte bestraft werden, wer gestohlenes oder veruntreutes Gut verhehlte, an sich brachte oder verhandelte.“"
                                            },
                                            {
