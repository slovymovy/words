            "senses": [
                {
                    "sense_id": "29fef52c-9b5b-3487-a7bc-8b162b359dea",
                    "sense_definition": "niezdyscyplinowana grupa ludzi, tłum, hołota",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "grupa_ludzi",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wściekły <w>motłoch</w> wtargnął na rynek, niszcząc wszystko na swojej drodze.",
                            "target_lang_translations": {
                                "ru": "Разъяренный <w>сброд</w> ворвался на площадь, уничтожая всё на своем пути."
                            }
                        },
                        {
                            "text": "Policja próbowała opanować <w>motłoch</w> zgromadzony przed budynkiem sądu.",
                            "target_lang_translations": {
                                "ru": "Полиция пыталась усмирить <w>толпу</w>, собравшуюся перед зданием суда."
                            }
                        }
                    ],
                    "synonyms": [
                        "hołota",
                        "tłuszcza",
                        "hałastra"
                    ],
                    "common_phrases": [
                        "wściekły motłoch"
                    ],
                    "target_lang_definitions": {
                        "ru": "недисциплинированная группа людей, толпа, сброд"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сброд",
                                "target_lang_sense_clarification": "презрительное обозначение неорганизованной, шумной толпы"
                            },
                            {
                                "target_lang_word": "чернь",
                                "target_lang_sense_clarification": "необразованная, грубая масса людей"
                            },
                            {
                                "target_lang_word": "толпа",
                                "target_lang_sense_clarification": "большое скопление людей (нейтральное, но в контексте может иметь негативный оттенок)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6df25d54-103e-33e6-8a28-2efd1aaad441",
                    "sense_definition": "pogardliwe określenie zwykłych ludzi, przeciwieństwo elit",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "grupa_ludzi",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Arystokracja patrzyła na <w>motłoch</w> z wyższością i pogardą.",
                            "target_lang_translations": {
                                "ru": "Аристократия смотрела на <w>чернь</w> с высокомерием и презрением."
                            }
                        },
                        {
                            "text": "Politycy często zapominają, że to <w>motłoch</w> wybiera ich do władzy.",
                            "target_lang_translations": {
                                "ru": "Политики часто забывают, что именно <w>чернь</w> выбирает их во власть."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "презрительное обозначение простых людей, противопоставление элитам"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чернь",
                                "target_lang_sense_clarification": "презрительное отношение высших слоев к простому народу"
                            },
                            {
                                "target_lang_word": "быдло",
                                "target_lang_sense_clarification": "грубое, оскорбительное обозначение людей, лишенных культуры"
                            }
                        ]
                    }
                }
            ]
        },
