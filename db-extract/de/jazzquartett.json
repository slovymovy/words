                "senses": [
                    {
                        "sense_id": "63b576bc-788e-3dbb-b67d-2c8aebadfae1",
                        "entry_id": "cba16e7a-73d6-3250-a01c-e089118f5ee9",
                        "glosses": [
                            "ein Ensemble von vier Jazzern"
                        ],
                        "tags": [
                            "Musik"
                        ],
                        "examples": [
                            {
                                "example_id": "8b8ae30b-fc88-4622-8c06-1b0550046d8d",
                                "sense_id": "63b576bc-788e-3dbb-b67d-2c8aebadfae1",
                                "text": "„Ich kann mich gut erinnern, dass ich mich danach gesehnt habe, ein eigenes Jazzquartett zu führen.“"
                            },
                            {
                                "example_id": "6b07725b-1a5c-481e-b5ac-5b8e29081dec",
                                "sense_id": "63b576bc-788e-3dbb-b67d-2c8aebadfae1",
                                "text": "„James Farm heißt das akustische Jazzquartett, das sich nicht nur von der eigenen Genregeschichte, sondern auch von Funk, Soul, Folk, Klassik und Rock inspirieren lässt.“"
                            },
                            {
                                "example_id": "a0e66988-fd5b-4d59-b97e-734990657270",
                                "sense_id": "63b576bc-788e-3dbb-b67d-2c8aebadfae1",
                                "text": "„Neben meiner Professur am Konservatorium Klagenfurt habe ich etwa mit meinem Jazzquartett, der Organ Band, und im Duo mit Matthias Bublath verschiedene Projekte am Laufen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
