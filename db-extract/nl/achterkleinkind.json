                ],
                "senses": [
                    {
                        "sense_id": "88bd365e-5d51-3fb9-9335-719d970fab77",
                        "entry_id": "5068ef2e-3c92-3b9f-95ae-c03024918cb1",
                        "glosses": [
                            "het kind van iemands kleinkind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd8f0ef2-e74c-4177-acf9-1602c1947ef7",
                                "sense_id": "88bd365e-5d51-3fb9-9335-719d970fab77",
                                "text": "Ik heb geen contact met mijn achterkleinkind."
                            },
                            {
                                "example_id": "0aac8df3-6a3f-4da8-bb1f-8119d65ae1f9",
                                "sense_id": "88bd365e-5d51-3fb9-9335-719d970fab77",
                                "text": "En zoals dat gaat op een camping wordt ook iedereen uitgenodigd om langs te komen voor een kop koffie. Als kinderen, kleinkinderen of achterkleinkinderen een nachtje willen komen slapen, wordt dat ook geregeld."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "854408de-8796-4db1-9e23-2759abde004b",
                        "source_entry_id": "5068ef2e-3c92-3b9f-95ae-c03024918cb1",
                        "source_sense_id": "88bd365e-5d51-3fb9-9335-719d970fab77",
                        "source_sense_description": "het kind van iemands kleinkind",
                        "target_lang_word": "Urenkel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Urenkel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e0c68104-57e4-33ff-80a0-c66f3752847b",
                                        "entry_id": "5b75b056-ba9a-380b-a668-3efe399c07ee",
                                        "glosses": [
                                            "(männliches^☆) Kind von Enkel/Enkelin oder (männlicher^☆) Nachfahre der dritten Generation"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa5cf57e-b708-46ad-884e-2a3957d2b48f",
                                                "sense_id": "e0c68104-57e4-33ff-80a0-c66f3752847b",
                                                "text": "Ich lebe weiter in den Genen meiner Enkel und Urenkel."
                                            },
                                            {
                                                "example_id": "7641b7ed-9430-487b-b556-58587d9573b4",
                                                "sense_id": "e0c68104-57e4-33ff-80a0-c66f3752847b",
                                                "text": "„Jetzt lebten sechs von seinen sieben Kindern, Enkelkindern und Urenkeln ebenfalls hier.“"
                                            },
                                            {
                                                "example_id": "aee4eddf-5365-40de-ba10-cbcaa9048bf4",
                                                "sense_id": "e0c68104-57e4-33ff-80a0-c66f3752847b",
                                                "text": "„Nik Wallenda, Urenkel eines deutschen Zirkusakrobaten, hat als erster Mensch die Niagarafälle an ihrer schönsten und gefährlichsten Stelle überquert.“"
                                            },
                                            {
                                                "example_id": "9f768183-0c7f-45ee-b549-fa957a19701f",
                                                "sense_id": "e0c68104-57e4-33ff-80a0-c66f3752847b",
                                                "text": "„Dann und wann schliefen die Urenkel bei den Alten.“"
                                            },
                                            {
                                                "example_id": "7a87a4a7-36de-44ca-8d1a-c0d92b62c374",
                                                "sense_id": "e0c68104-57e4-33ff-80a0-c66f3752847b",
                                                "text": "„Möglicherweise werden unsere Urenkel ähnlich belustigt reagieren, wenn sie erfahren, dass wir uns Anfang des 21. Jahrhunderts Sorgen über unsere Erdölvorräte gemacht haben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5d3b2362-6c67-3920-b83d-39b49fe3723d",
                                        "entry_id": "5b75b056-ba9a-380b-a668-3efe399c07ee",
                                        "glosses": [
                                            "später Nachkomme"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac078915-1717-4b0f-a96f-c7e4ad693dd8",
                                                "sense_id": "5d3b2362-6c67-3920-b83d-39b49fe3723d",
                                                "text": "„Möglicherweise werden unsere Urenkel ähnlich belustigt reagieren, wenn sie erfahren, dass wir uns Anfang des 21. Jahrhunderts Sorgen über unsere Erdölvorräte gemacht haben.“"
                                            },
                                            {
                                                "example_id": "e329dbd4-fbf9-4a80-9340-c5697d9695d1",
                                                "sense_id": "5d3b2362-6c67-3920-b83d-39b49fe3723d",
                                                "text": "„Wie sollten sie sich auch begeistern für Ereignisse, die erst zu Lebzeiten der Urenkel ihrer Urenkel eintreten würden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "efa710dd-454e-4456-98ae-3ece03efbccb",
                        "source_entry_id": "5068ef2e-3c92-3b9f-95ae-c03024918cb1",
                        "source_sense_id": "88bd365e-5d51-3fb9-9335-719d970fab77",
                        "source_sense_description": "het kind van iemands kleinkind",
                        "target_lang_word": "Urenkelin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Urenkelin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ad7ebac4-df9b-3135-88a6-15a913432064",
                                        "entry_id": "936386e9-b56a-3da0-8e51-0fe3e6f74a44",
                                        "glosses": [
                                            "weibliches Kind von Enkel oder Enkelin oder weibliche Nachfahrin der dritten Generation"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "94b35c08-c906-43e4-a914-3faf54cb8962",
                                                "sense_id": "ad7ebac4-df9b-3135-88a6-15a913432064",
                                                "text": "Unsere Urenkelin wird auch schon bald 6 Jahre alt."
                                            },
                                            {
                                                "example_id": "e37c4e70-8d05-435e-87c4-b31f7f8c23ee",
                                                "sense_id": "ad7ebac4-df9b-3135-88a6-15a913432064",
                                                "text": "„Im Laufe der Analysen kristallisierte sich allerdings heraus, dass auch unbearbeitete Themen aus der Familienvergangenheit bei den Enkelinnen und Urenkelinnen ihren Niederschlag fanden.“"
                                            },
                                            {
                                                "example_id": "03b0b3e3-7a76-491c-8876-4ba8ec359616",
                                                "sense_id": "ad7ebac4-df9b-3135-88a6-15a913432064",
                                                "text": "„Auch Helenes Mutter ist auf dem Bild zu sehen: Die mondän aussehende Dame hält die Hand ihrer kleinen Urenkelin.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4ceed622-fe60-45d0-88c7-34271714b9cc",
                        "source_entry_id": "5068ef2e-3c92-3b9f-95ae-c03024918cb1",
                        "source_sense_id": "88bd365e-5d51-3fb9-9335-719d970fab77",
