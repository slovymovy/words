                        "glosses": [
                            "D’où sortent des bourgeons ; chargé de bourgeons ; qui bourgeonne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b9e8062-d498-403e-a138-d40eb8d05ffb",
                                "sense_id": "8a8b822b-9436-3a40-aca0-1afdacfd6e89",
                                "text": "Mais une couronne aussi a été faite, une mystérieuse couronne.\n Une couronne, un couronnement éternel.\n Toute faite, mon enfant, toute faite de souples rameaux sans épines.\n De rameaux bourgeonneux, de rameaux de fin mars.\n De rameaux d’avril et de mai."
                            }
                        ]
                    },
                    {
                        "sense_id": "375c700c-509a-3662-af5a-098cf54eeded",
                        "entry_id": "9c93ccf7-a274-3f84-86fb-da52497ccb32",
                        "glosses": [
                            "Boutonneux, acnéique."
                        ],
