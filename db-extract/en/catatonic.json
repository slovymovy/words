                                        "entry_id": "34afe616-45d7-31f0-ae66-8deacf2c04f9",
                                        "glosses": [
                                            "die Katatonie betreffend; durch unnatürliche und stark verkrampfte Haltungen des ganzen Körpers gekennzeichnet; bewegungs- und emotionslos"
                                        ],
                                        "tags": [
                                            "Psychopathologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "42f01d50-e7cc-4235-bf2f-6791e23b8d0c",
                                                "sense_id": "05a69ab4-ca33-37a1-9a95-0f5328769c8b",
                                                "text": "Katatonisch hockte er im Halbdunkel vor dem offenen Kamin."
                                            },
                                            {
                                                "example_id": "5109849b-7dd7-451a-a904-f91e2c975352",
                                                "sense_id": "05a69ab4-ca33-37a1-9a95-0f5328769c8b",
                                                "text": "„So ganz und gar entspricht die katatonische ängstliche Erregung dieser Form jedoch nicht; sie ist vielmehr als in der Mitte stehend zwischen dieser Form und der von Kraepelin als erregte Depression bezeichneten Mischform aufzufassen. Diese Mittelstellung wird bedingt durch die der katatonischen Erregung eigene Neigung zu Stereotypien.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
