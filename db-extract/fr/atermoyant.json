                    {
                        "sense_id": "6f9d3ecc-768a-3a59-835a-8eaf75e0f153",
                        "entry_id": "5bce4c8b-f6e3-3393-a1c8-ce28597800ed",
                        "glosses": [
                            "Qui atermoie, qui remet à plus tard."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f3448aa-c5f2-4697-a0f5-6d8687806c55",
                                "sense_id": "6f9d3ecc-768a-3a59-835a-8eaf75e0f153",
                                "text": "L’affaire n’en fut pas moins remise à quatre semaines, car, pour laisser sans doute aux biles échauffées le temps de se refroidir, Thémis impose à ceux qui l’implorent de calmantes lenteurs et d’atermoyants délais."
                            },
                            {
                                "example_id": "1e67f06e-1757-4b27-9f9a-e5a3a70c871a",
                                "sense_id": "6f9d3ecc-768a-3a59-835a-8eaf75e0f153",
                                "text": "Son attitude atermoyante n’indique pas un désir bien vif d'arriver à une prompte et définitive solution."
                            },
                            {
                                "example_id": "986233d4-3a4d-4155-b0d7-db34d333a0b7",
                                "sense_id": "6f9d3ecc-768a-3a59-835a-8eaf75e0f153",
                                "text": "Pour mon propre compte, las de sa politique molle, pusillanime et atermoyante, je cesse dès aujourd’hui d’être un de ses lecteurs."
                            }
                        ]
                    }
