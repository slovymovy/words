    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7619e782-ff9f-3ff5-8306-75dca3673759",
                    "sense_definition": "Réaliser, accomplir une action, une tâche ou une activité.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tous les soirs après le dîner, mon frère <w>fait</w> la vaisselle dans la cuisine."
                        },
                        {
                            "text": "Les enfants <w>font</w> beaucoup de bruit lorsqu'ils jouent ensemble dans le jardin."
                        }
                    ],
                    "common_phrases": [
                        "faire la vaisselle",
                        "faire du bruit",
                        "faire attention",
                        "faire ses devoirs"
                    ]
                },
                {
                    "sense_id": "7ef59a27-49ee-3928-89a5-4ee36ff2af12",
                    "sense_definition": "Créer, fabriquer ou produire un objet matériel.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "creation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pour l'anniversaire de ma sœur, nous <w>faisons</w> un grand gâteau au chocolat."
                        },
                        {
                            "text": "Au début du printemps, chaque oiseau <w>fait</w> son nid dans les arbres du parc."
                        }
                    ],
                    "common_phrases": [
                        "faire un gâteau",
                        "faire son nid",
                        "faire une table"
                    ]
                },
                {
                    "sense_id": "bbd2d94f-44f4-310e-a1ee-c7b433252e82",
                    "sense_definition": "Indiquer un état du temps ou une condition météorologique.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "meteo",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Aujourd'hui, il <w>fait</w> très beau et nous pouvons aller nous promener au parc."
                        },
                        {
                            "text": "En hiver, il <w>fait</w> souvent froid dans cette vieille maison mal isolée."
                        }
                    ],
                    "common_phrases": [
                        "faire beau",
                        "faire froid",
                        "faire chaud",
                        "faire nuit"
                    ]
                },
                {
                    "sense_id": "909af59d-a815-3a71-b48b-945a49e96eb8",
                    "sense_definition": "Être la cause d'une action ou d'un état en parlant d'un verbe suivi d'un infinitif.",
