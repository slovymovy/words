                    "sense_id": "97f55217-84ad-3047-8c99-1b86192d302a",
                    "sense_definition": "Iemand of iets beschermen tegen een aanval of gevaar.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De soldaten <w>verdedigden</w> de stad tot de laatste man.",
                            "target_lang_translations": {
                                "en": "The soldiers <w>defended</w> the city to the last man.",
                                "ru": "Солдаты <w>защищали</w> город до последнего человека.",
                                "de": "Die Soldaten <w>verteidigten</w> die Stadt bis zum letzten Mann.",
                                "pl": "Żołnierze <w>bronili</w> miasta do ostatniego człowieka.",
                                "fr": "Les soldats <w>défendirent</w> la ville jusqu'au dernier homme.",
                                "it": "I soldati <w>difesero</w> la città fino all'ultimo uomo.",
                                "cs": "Vojáci <w>bránili</w> město do posledního muže.",
                                "tr": "Askerler şehri son adama kadar <w>savundular</w>.",
                                "es": "Los soldados <w>defendieron</w> la ciudad hasta el último hombre."
                            }
                        },
                        {
                            "text": "Het dier <w>verdedigde</w> zich fel tegen de jager.",
                            "target_lang_translations": {
                                "en": "The animal <w>defended</w> itself fiercely against the hunter.",
                                "ru": "Животное яростно <w>защищалось</w> от охотника.",
                                "de": "Das Tier <w>verteidigte</w> sich heftig gegen den Jäger.",
                                "pl": "Zwierzę zaciekle <w>broniło się</w> przed myśliwym.",
                                "fr": "L'animal se <w>défendit</w> farouchement contre le chasseur.",
                                "it": "L'animale si <w>difese</w> ferocemente dal cacciatore.",
                                "cs": "Zvíře se divoce <w>bránilo</w> proti lovci.",
                                "tr": "Hayvan, avcıya karşı kendini sert bir şekilde <w>savundu</w>.",
                                "es": "El animal se <w>defendió</w> ferozmente del cazador."
                            }
                        }
