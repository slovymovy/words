                                        "sense_id": "8455e634-46a7-3b98-9c14-ad840a4d9959",
                                        "entry_id": "5df95c2b-645d-342d-a7a5-632e96d4af9d",
                                        "glosses": [
                                            "Any large carnivorous dinosaur, of the genus Tyrannosaurus, found in North America during the late Cretaceous period."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4c1bdca3-7ae2-4cd4-9c4b-1b898e342a75",
                        "source_entry_id": "8c798987-c980-3d47-a076-f258c34e9663",
                        "source_sense_id": "e70b7c62-c0be-3c27-a281-b9c7b1af5571",
                        "target_lang_word": "tyrannosaur",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tyrannosaur",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3b3e47fa-8214-3c0d-9e08-e3f8f6968e92",
                                        "entry_id": "84312858-4e67-38cd-b3dd-6ed2614ddb23",
                                        "glosses": [
                                            "Any large bipedal carnivorous dinosaur, of the family Tyrannosauridae, that lived in North America during the Cretaceous period."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "66266577-9bd8-48ad-8492-1c521775425c",
                                                "sense_id": "3b3e47fa-8214-3c0d-9e08-e3f8f6968e92",
                                                "text": "So far, Druckenmiller and his team have dug up species from seven different dino families: from big duck-billed dinos, ceretopsians, and tyrannosaurs to smaller thescelosaurs, leptoceratops, dromaeosaurs, and troodontids."
                                            },
                                            {
                                                "example_id": "4f2fb942-d8a9-4d8b-bac2-429dc82916a4",
                                                "sense_id": "3b3e47fa-8214-3c0d-9e08-e3f8f6968e92",
                                                "text": "Instead it belongs to a new species of tyrannosaur, which the researchers have dubbed Tyrannosaurus mcraeensis in a paper published on January 11 in Scientific Reports."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "37deef04-6f74-406a-8d79-8ec75053734e",
                        "source_entry_id": "8c798987-c980-3d47-a076-f258c34e9663",
                        "source_sense_id": "e70b7c62-c0be-3c27-a281-b9c7b1af5571",
                        "target_lang_word": "tiranosaurio",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tiranosaurio",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "35195ad6-5db5-37bc-9f95-01f2ddaf2f86",
                                        "entry_id": "02052105-1f06-3359-9b0f-9b327f694faf",
                                        "glosses": [
                                            "(Tyrannosaurus rex) Dinosaurio carnívoro de grandes dimensiones que vivió a fines del Cretácico. Medía catorce metros de largo, por seis de alto y pesaba unas siete toneladas. Tenía una cabeza pesada con poderosas mandíbulas, patas traseras enormes con afiladas garras y pequeñas patas delanteras con dos dedos. Algunos paleontólogos suponen que era un animal carroñero, porque piensan que era lento. Otros paleontólogos creen que era un cazador que podía desarrollar velocidades de 60 km por hora en cortas distancias."
                                        ],
                                        "tags": [
                                            "Dinosaurios"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
