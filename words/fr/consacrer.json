{
    "word_family": [
        "consécration",
        "déconsacrer"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "565f341f-5cc2-3418-8d98-a28f7388d1ff",
                    "sense_definition": "Employer son temps, son énergie ou ses ressources à une activité, une cause ou une personne.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "devouement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle a décidé de <w>consacrer</w> du temps à l'apprentissage d'une langue étrangère."
                        },
                        {
                            "text": "Le médecin a choisi de <w>consacrer</w> sa vie à soigner les personnes démunies."
                        }
                    ],
                    "synonyms": [
                        "dédier",
                        "vouer"
                    ],
                    "common_phrases": [
                        "consacrer du temps",
                        "consacrer sa vie",
                        "consacrer des efforts"
                    ]
                },
                {
                    "sense_id": "e84e3cb3-0069-384f-b86b-5701e50f69de",
                    "sense_definition": "Reconnaître officiellement, sanctionner ou rendre durable une règle, un principe ou un statut.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "reconnaissance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La nouvelle constitution est venue <w>consacrer</w> ce principe fondamental de liberté."
                        },
                        {
                            "text": "Cette récompense prestigieuse a permis de <w>consacrer</w> sa victoire après des années de travail."
                        }
                    ],
                    "synonyms": [
                        "entériner",
                        "confirmer",
                        "sanctionner"
                    ],
                    "common_phrases": [
                        "consacrer un principe",
                        "consacrer une victoire"
                    ]
                },
                {
                    "sense_id": "e53c2043-e4b4-32c1-af6c-1f31f296d011",
                    "sense_definition": "Dédier à Dieu ou au culte religieux par une cérémonie liturgique appropriée.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "religion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'évêque s'est déplacé en personne pour <w>consacrer</w> une église nouvellement bâtie."
                        },
                        {
                            "text": "Les fidèles ont voulu <w>consacrer</w> cet autel en mémoire de leur saint patron."
                        }
                    ],
                    "synonyms": [
                        "bénir"
                    ],
                    "antonyms": [
                        "déconsacrer"
                    ],
                    "common_phrases": [
                        "consacrer une église",
                        "consacrer un autel"
                    ]
                },
                {
                    "sense_id": "6c5352ff-b402-336f-bb0a-124bdb0d6bcf",
                    "sense_definition": "Rendre habituel ou incontestable par un long usage, particulièrement pour des termes ou des expressions.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "reconnaissance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'usage quotidien finit souvent par <w>consacrer</w> un terme d'abord jugé familier."
                        },
                        {
                            "text": "Le journaliste a employé une formule <w>consacrée</w> pour ouvrir son discours officiel."
                        }
                    ],
                    "synonyms": [
                        "valider"
                    ],
                    "common_phrases": [
                        "formule consacrée",
                        "terme consacré",
                        "usage consacré"
                    ]
                }
            ]
        }
    ]
}