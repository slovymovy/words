                    {
                        "sense_id": "0e735044-934c-3114-8f19-411e2bc5fc2d",
                        "entry_id": "ef5e0b68-d340-336f-a2f4-13dcd9e0ef7d",
                        "glosses": [
                            "een kleine metalen klem waarmee enkele velletjes papier bijeen gehouden kunnen worden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d6b2f803-56a0-4e2e-946e-f838d8b3ce14",
                                "sense_id": "0e735044-934c-3114-8f19-411e2bc5fc2d",
                                "text": "De paperclip was in de loop van de tijd roestig geworden."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d1707976-b469-4a72-b0c7-15bb6bcfb347",
                        "source_entry_id": "ef5e0b68-d340-336f-a2f4-13dcd9e0ef7d",
                        "source_sense_id": "0e735044-934c-3114-8f19-411e2bc5fc2d",
                        "target_lang_word": "Büroklammer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Büroklammer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b8a47043-c0ec-3b84-8ce1-83bd87d08b52",
                                        "entry_id": "0fe223ef-4e52-3ca8-b281-50a9d5944316",
                                        "glosses": [
                                            "Klammer aus Metalldraht oder Kunststoff, die Papierblätter zusammenhält"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "07ff83e9-6ecc-4c66-8cce-ac97e86414f1",
                                                "sense_id": "b8a47043-c0ec-3b84-8ce1-83bd87d08b52",
                                                "text": "Ich hefte die Blätter mit der Hilfe der Büroklammer zusammen."
                                            },
                                            {
                                                "example_id": "e331c023-c052-446f-b48c-2ac0fad97d67",
                                                "sense_id": "b8a47043-c0ec-3b84-8ce1-83bd87d08b52",
                                                "text": "„Er trug sie flach hinaus, in dem steifen Bündel aus Zehnern, das an einer Ecke mit einer Büroklammer zusammengehalten wurde.“"
                                            },
                                            {
                                                "example_id": "9728276d-e6b3-4220-be46-066bfe9ae067",
                                                "sense_id": "b8a47043-c0ec-3b84-8ce1-83bd87d08b52",
                                                "text": "„Ich bog eine Büroklammer auseinander und legte damit auf sie an.“"
                                            },
                                            {
                                                "example_id": "4f6821e5-dfaa-4683-a5d9-681957463c76",
                                                "sense_id": "b8a47043-c0ec-3b84-8ce1-83bd87d08b52",
                                                "text": "„Er zeigt auf die Büroklammer und schüttelt den pomadetriefenden Kopf.“"
                                            },
                                            {
                                                "example_id": "41b27fc1-b820-40d8-b680-51513d83172c",
                                                "sense_id": "b8a47043-c0ec-3b84-8ce1-83bd87d08b52",
                                                "text": "„Er besteht nur aus einer Zeile auf einem Blatt Papier mit Wasserzeichen, das, wie ich weiß, pro Blatt fünf Kronen kostet, und aus einem Bündel fotokopierter Zeitungsausschnitte, das von einer Büroklammer zusammengehalten wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5d4f06e9-67b0-43d7-85a8-32ca0c87b9a0",
                        "source_entry_id": "ef5e0b68-d340-336f-a2f4-13dcd9e0ef7d",
