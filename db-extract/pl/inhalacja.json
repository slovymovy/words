                        ]
                    },
                    {
                        "translation_id": "5b4b542c-df41-4674-8d93-27eeb996d887",
                        "source_entry_id": "c62df316-b8d5-3cbc-8d4e-bd3a5c2a2677",
                        "source_sense_id": "e4c89c57-6471-3e8e-832e-f8cb7cf81919",
                        "target_lang_word": "ингаляция",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ингаляция",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "7165f5c0-0003-3f90-b099-b9051c6fb94d",
                                        "entry_id": "3113b6d9-a0c0-313e-8fdb-c3310c6460f7",
                                        "glosses": [
                                            "метод введения лекарственных средств на основе вдыхания газа, пара или дыма (газообразных и летучих веществ, жидкостных аэрозолей и порошков определенного размера частиц) для уменьшения времени всасывания, обеспечения избирательного действия введенного вещества на дыхательную систему, оказания как местного лечебного воздействия на дыхательные пути при их заболеваниях, так и системного эффекта на весь организм"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cfda9119-f9bf-4880-9eae-70c5f1a177c1",
                                                "sense_id": "7165f5c0-0003-3f90-b099-b9051c6fb94d",
                                                "text": "Ингаляции являются одним из старейших и традиционных методов лечения дыхательных путей, будь то пребывание в условиях морского климата, соляных пещер, паровой сауны или ингаляции с помощью небулайзеров."
                                            },
                                            {
                                                "example_id": "c5ffe3f5-2119-498e-bf16-4502854aa059",
                                                "sense_id": "7165f5c0-0003-3f90-b099-b9051c6fb94d",
                                                "text": "Один из самых эффективных способов борьбы с заложенным носом — паровые ингаляции. Добавьте в кипяток несколько капель эфирного масла ментола или эвкалипта, накройте голову полотенцем и подышите над миской с кипятком. Эвкалипт и ментол обладают противовоспалительными свойствами и заметно облегчают дыхание."
                                            }
