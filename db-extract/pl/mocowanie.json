                                                "sense_id": "371738af-0d8b-33ff-8db2-a23b831c7faf",
                                                "text": "Die Fixierung war mit Lammfell gepolstert."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "383c3223-7c4a-31d3-99d9-68d0ca7ab3be",
                                        "entry_id": "0296329b-7514-37c1-a10e-39867bf1d891",
