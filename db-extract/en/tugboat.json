                    {
                        "translation_id": "b12bcce0-ef91-4fa4-8264-9bb589b42b16",
                        "source_entry_id": "a0e3a0b2-195f-321b-b6da-9d8e8c1ed3b3",
                        "source_sense_id": "92da1c32-9171-3409-b817-7040ebfdd579",
                        "source_sense_description": "small, powerful boat",
                        "target_lang_word": "sleper",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sleper",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "18505d16-b811-3c2f-b635-b4e9965eaf92",
                                        "entry_id": "0902747a-a90c-3de8-a760-7511638d7a5c",
                                        "glosses": [
                                            "een soort sleepboot"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ba4a763-6525-44d8-8088-39b815e5d2ec",
                                                "sense_id": "18505d16-b811-3c2f-b635-b4e9965eaf92",
                                                "text": ",Twee ton schade aan mijn boot en twee ton schade aan de andere boot. We zijn nu bezig met de verzekering, laat hij weten vanuit Noorwegen. Huibers vertelt dat het ongeluk gebeurde toen een van de twee slepers losschoot van zijn ark. ,,Die boot kon het niet meer houden, aldus Huibers. Daarna knalde de ark vol op de patrouilleboot. Daarvan raakte een kraan ernstig beschadigd."
                                            },
                                            {
                                                "example_id": "c0e7e386-6fb3-46e2-932e-3a464e81895a",
                                                "sense_id": "18505d16-b811-3c2f-b635-b4e9965eaf92",
                                                "text": "Een luid geruis trok haar aandacht naar het noorden. Er kwam een boot, een soort sleper, op haar af. Aan de hand van de witte en rode lichten op het dak van de stuurhut concludeerde Mae dat het een patrouille moest zijn, waarschijnlijk de kustwacht, dichtbij genoeg om haar te kunnen zien. Als ze rechtop bleef zitten, zou haar silhouet haar direct verraden."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4e163a0c-9ff6-3706-82c9-ffb68c59d687",
                                        "entry_id": "0902747a-a90c-3de8-a760-7511638d7a5c",
                                        "glosses": [
                                            "iemand die goederen van de ene naar de andere plaats vervoert met een handgetrokken kar of wagen, het is ruw volk"
                                        ],
                                        "tags": [
                                            "beroep"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f73fa9fb-0001-47c3-a182-42c014dd611f",
                                                "sense_id": "4e163a0c-9ff6-3706-82c9-ffb68c59d687",
                                                "text": "'Help me!' riep ze. 'Help me!' Bijna onmiddellijk vormde zich een kring van nieuwsgierigen om haar heen. Vertwijfeld keek ze langs talloze benen omhoog naar de gezichten die haar aanstaarden. Agnes kreunde. ' Hela, idioten!' gromde een sleper. 'We moeten erlangs met onze lading. Breng die vrouw weg, dan kan ze ook weer ademhalen.'"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2da25ced-4b85-38f8-a7e8-06bebaf7d1f4",
                                        "entry_id": "0902747a-a90c-3de8-a760-7511638d7a5c",
                                        "glosses": [
                                            "de wagen die vracht vervoert"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
