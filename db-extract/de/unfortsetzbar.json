                    {
                        "form_id": "f8e86780-ac90-407c-b49c-6c4a4f82f020",
                        "entry_id": "87f95ce8-bba5-3977-ba46-a39daa4a0261",
                        "tags": [
                            "positive",
                            "predicative",
                            "plural"
                        ],
                        "form": "sie sind unfortsetzbar"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2a3436f4-a535-37f2-9931-843b53b02fc7",
                        "entry_id": "87f95ce8-bba5-3977-ba46-a39daa4a0261",
                        "glosses": [
                            "so, dass es nicht fortgesetzt werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "63d008a7-2bf2-48ca-b1fd-c7e57748b56e",
                                "sense_id": "2a3436f4-a535-37f2-9931-843b53b02fc7",
                                "text": "„… weil sich überhaupt nichts mehr fortsetzen läßt, unfortsetzbar das Getane und Ungetane, unforrsetzbar das Gedachte und Ungedachte, das Ausgesprochene und das Unausgesprochene, das Gedichtete und Ungedichtete …“"
                            },
                            {
                                "example_id": "225fe7ec-9e29-4cf2-976d-420ef25f9b8a",
                                "sense_id": "2a3436f4-a535-37f2-9931-843b53b02fc7",
                                "text": "„Die Funktion der kritischen Historie sah [Friedrich Nietzsche] in der radikalen Verwerfung und Abkehr von einer unfortsetzbar gewordenen Vergangenheit …“"
                            },
                            {
                                "example_id": "ec0fac8b-f975-4075-9034-e2d7a1f1eed1",
                                "sense_id": "2a3436f4-a535-37f2-9931-843b53b02fc7",
                                "text": "„Andererseits werden wir zeigen, daß jeder unstetige Operator A (auch wenn er im gewöhnlichen Sinne unfortsetzbar, d.h. maximal ist), echte metrische Fortsetzungen besitzt. Hier gibt es also keine Maximalität!“"
                            },
                            {
                                "example_id": "42f34a45-473d-46a6-8321-b85bb8b622ff",
                                "sense_id": "2a3436f4-a535-37f2-9931-843b53b02fc7",
                                "text": "„Digitale Mittel der Archivierung gab es mangels Digitalisierung nicht, und ich erhielt meine Versuche mit Schere, Uhu-Stick, Mappen und Karteikarten noch jahrelang aufrecht, bis sie sich als zwar nicht unfruchtbar, aber unfortsetzbar erwiesen und der Krempel bei einem Umzug im Mist landete.“"
                            },
                            {
                                "example_id": "c9042a9c-8e05-4ba1-9b6a-469a65e579e6",
                                "sense_id": "2a3436f4-a535-37f2-9931-843b53b02fc7",
                                "text": "„Das gegenwärtige Leben ist unfortsetzbar und unersetzbar, deshalb auch nicht durch einen Kurzschluss zu ergänzen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
