{
    "word_family": [
        "support",
        "supportable",
        "insupportable",
        "supporteur"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d906f56c-0788-3857-bc3e-515dddf0e0c9",
                    "sense_definition": "Tolérer, endurer quelque chose de pénible, ou accepter avec patience une situation ou une personne difficile.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "endurer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je ne <w>supporte</w> plus ce bruit incessant depuis ce matin."
                        },
                        {
                            "text": "Elle a appris à <w>supporter</w> la douleur avec beaucoup de courage."
                        }
                    ],
                    "common_phrases": [
                        "ne plus supporter",
                        "supporter la douleur",
                        "difficile à supporter"
                    ]
                },
                {
                    "sense_id": "f547f1d2-e7b6-3395-94b7-279d17144892",
                    "sense_definition": "Encourager ou soutenir activement une équipe, un club ou un sportif.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "encourager",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Toute la famille <w>supporte</w> l'équipe locale de football chaque week-end."
                        },
                        {
                            "text": "Ils vont au stade ensemble pour <w>supporter</w> leur club préféré."
                        }
                    ],
                    "common_phrases": [
                        "supporter une équipe",
                        "supporter son club"
                    ]
                },
                {
                    "sense_id": "c884a155-5c38-3c63-9058-0c1a14b63199",
                    "sense_definition": "Porter, soutenir matériellement un poids ou une charge physique.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "soutien_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les vieilles poutres en bois <w>supportent</w> tout le poids du toit."
                        },
                        {
                            "text": "Ce pont en pierre peut <w>supporter</w> une charge très lourde."
                        }
                    ],
                    "common_phrases": [
                        "supporter le poids",
                        "supporter la charge"
                    ]
                },
                {
                    "sense_id": "52905906-df51-30cc-a5a1-a2ecc548f0cf",
                    "sense_definition": "Résister à des conditions extrêmes, à une épreuve ou à une critique sans faiblir ni se détériorer.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "resistance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Certaines plantes méditerranéennes peuvent parfaitement <w>supporter</w> la chaleur estivale."
                        },
                        {
                            "text": "Ce matériau robuste <w>supporte</w> de grands écarts de température sans s'abîmer."
                        }
                    ],
                    "common_phrases": [
                        "supporter la chaleur",
                        "supporter le froid"
                    ]
                },
                {
                    "sense_id": "50eda212-d44a-38f1-89bf-d637cf1bf879",
                    "sense_definition": "Prendre à sa charge, assumer une dépense financière, une obligation ou des conséquences.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "prise_en_charge",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'entreprise devra <w>supporter</w> tous les frais liés à cet accident."
                        },
                        {
                            "text": "Chacun doit <w>supporter</w> les conséquences de ses propres décisions."
                        }
                    ],
                    "common_phrases": [
                        "supporter les conséquences",
                        "supporter les frais",
                        "supporter les coûts"
                    ]
                },
                {
                    "sense_id": "132c7c55-3b43-31d0-977d-05c5a487b774",
                    "sense_definition": "Être compatible avec un matériel, un système d'exploitation ou un format numérique.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "compatibilite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce nouveau navigateur <w>supporte</w> la plupart des technologies modernes du web."
                        },
                        {
                            "text": "L'application ne <w>supporte</w> pas cette ancienne version du système d'exploitation."
                        }
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8ca23c68-fb9a-3167-9d92-dc27fc91d47e",
                    "sense_definition": "Personne passionnée qui encourage et soutient un sportif, un club ou une équipe sportive.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "adherent_sportif",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les <w>supporters</w> chantaient avec enthousiasme pour encourager les joueurs sur le terrain."
                        },
                        {
                            "text": "C'est un grand <w>supporter</w> de l'équipe de rugby de sa ville natale."
                        }
                    ],
                    "synonyms": [
                        "supporteur"
                    ],
                    "common_phrases": [
                        "supporters enthousiastes",
                        "tribune des supporters"
                    ]
                },
                {
                    "sense_id": "c3282dac-b97d-3102-82e4-d7b8092d1c51",
                    "sense_definition": "Personne qui soutient une cause, un candidat ou un parti lors d'une compétition ou d'une élection.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "adherent_politique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les <w>supporters</w> de ce parti politique se sont réunis lors du meeting électoral."
                        },
                        {
                            "text": "Elle compte de nombreux <w>supporters</w> parmi les étudiants de son université."
                        }
                    ],
                    "synonyms": [
                        "supporteur"
                    ],
                    "common_phrases": [
                        "supporters d'un parti",
                        "supporters d'un candidat"
                    ]
                }
            ]
        }
    ]
}