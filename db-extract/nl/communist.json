                            {
                                "target_word": "communist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ee11a25d-eb22-3564-a828-e13f0bfec256",
                                        "entry_id": "d6dd5f2f-1075-335a-a624-e7782f9d1ef0",
                                        "glosses": [
                                            "An advocate of a society based on the common ownership of property; a proponent of communism."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c5229870-a249-3247-bb93-1db528c4011a",
