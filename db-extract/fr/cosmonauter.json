                "senses": [
                    {
                        "sense_id": "7cbf3930-7e88-331f-95dd-e2db2587a742",
                        "entry_id": "07509f00-93d4-3312-8446-6ccf6c30fcd4",
                        "glosses": [
                            "Aller dans l’espace comme un cosmonaute."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4b79804f-1823-45c0-a246-642afb51a9b4",
                                "sense_id": "7cbf3930-7e88-331f-95dd-e2db2587a742",
                                "text": "Elle cosmonaute un moment et redescend parmi nous."
                            },
                            {
                                "example_id": "a4103a77-cff0-4c03-af05-12edd7233424",
                                "sense_id": "7cbf3930-7e88-331f-95dd-e2db2587a742",
                                "text": "Pour la faire péter, on a deux solutions : ou on prend des cosmonautes et on leur apprend à péter ou on prend des péteurs et on leur apprend à cosmonauter."
                            },
                            {
                                "example_id": "c1b0ffc5-c98e-49d6-b4b0-61d0eaaaa368",
                                "sense_id": "7cbf3930-7e88-331f-95dd-e2db2587a742",
                                "text": "Si c'est comme ça que tu pensais cosmonauter, c'était pas gagné!"
                            }
                        ]
                    }
