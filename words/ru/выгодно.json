                                "target_lang_sense_clarification": "bir özelliği güzelce ortaya çıkaracak şekilde"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "ventajosamente",
                                "target_lang_sense_clarification": "de forma conveniente o favorable"
                            },
