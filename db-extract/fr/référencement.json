                        "entry_id": "ea4c13e6-181c-33f8-99ae-100fc98ef5fc",
                        "glosses": [
                            "Action de référencer, de mentionner quelque chose."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "f75c0ff4-baf5-3d2e-b911-cc762298a7d3",
                        "entry_id": "ea4c13e6-181c-33f8-99ae-100fc98ef5fc",
                        "glosses": [
                            "Faire un lien vers une ressource, y faire référence."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "c2c46c85-a387-37c5-969e-1b7823219ea7",
                        "entry_id": "ea4c13e6-181c-33f8-99ae-100fc98ef5fc",
                        "glosses": [
                            "Action d’inscrire un site internet dans un moteur de recherche."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "b50d8ad2-55a5-40d5-96da-b15e44023286",
                                "sense_id": "c2c46c85-a387-37c5-969e-1b7823219ea7",
                                "text": "Le référencement des sites web est axé aujourd’hui sur les outils de recherche, plus particulièrement les moteurs et des annuaires de recherche."
                            },
                            {
                                "example_id": "2eea6f36-7288-457f-82e1-3d9ac9923ca6",
                                "sense_id": "c2c46c85-a387-37c5-969e-1b7823219ea7",
                                "text": "Les mots valent de l’argent, des gens se disputent aux enchères le référencement de « restaurant » et « Champs-Elysées » pour être sûrs de sortir en tête des listings sur le moteur de recherche..."
                            }
                        ]
                    },
                    {
                        "sense_id": "b7504154-3887-34b4-868c-e298f7e51113",
                        "entry_id": "ea4c13e6-181c-33f8-99ae-100fc98ef5fc",
                        "glosses": [
                            "Classement au sein des résultats donnés par un moteur de recherche."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "f21bbaf2-c2e7-47f7-8947-7edf7307f89d",
                                "sense_id": "b7504154-3887-34b4-868c-e298f7e51113",
                                "text": "Améliorer le référencement de son site internet."
                            },
                            {
                                "example_id": "363e74ec-da52-4ad1-a43a-937d3e93bdc8",
                                "sense_id": "b7504154-3887-34b4-868c-e298f7e51113",
                                "text": "Les résultats de recherche générés par IA réécrivent les règles. Et l’optimisation du référencement pour les moteurs – ou SEO – ne suffit plus."
                            }
                        ]
                    }
                ],
