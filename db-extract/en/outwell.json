                        "glosses": [
                            "To well outward; to issue forth."
                        ],
                        "tags": [
                            "ambitransitive",
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "38ecec25-8c8f-4d60-82df-e329405b5ed4",
                                "sense_id": "28a98f6f-06a0-36c6-b9ff-126b3430f393",
                                "text": "[…] when old father Nilus gins to swell\nWith timely pride aboue the Aegyptian vale,\nHis fattie waues doe fertile slime outwell,\nAnd ouerflow each plaine and lowly dale:"
                            },
                            {
                                "example_id": "c59ff282-fe26-4870-a7d0-adb65ed7fe8f",
                                "sense_id": "28a98f6f-06a0-36c6-b9ff-126b3430f393",
                                "text": "[…] Religion that rebuketh prophane lamentation, drinkes in the riuers of those dispaireful teares, which languorous ruth hath outwelled […]"
                            }
                        ]
                    }
