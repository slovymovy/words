                ],
                "translations": [
                    {
                        "translation_id": "7062c316-b8bb-4004-86f3-2248218442a5",
                        "source_entry_id": "6eff7302-f942-35ff-85ce-66a766b9e7b3",
                        "target_lang_word": "élargir",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "élargir",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1e376a56-b568-3491-b86a-c4ed4cc6f9ad",
                                        "entry_id": "8c184bab-5148-3619-8281-c6811ef0830d",
                                        "glosses": [
                                            "Rendre plus large."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3fa4a4e2-d8d5-46ac-b3b4-1487023f7ae0",
                                                "sense_id": "1e376a56-b568-3491-b86a-c4ed4cc6f9ad",
                                                "text": "Tous étaient à cheval, mais Dieu sait comment; Mazeppa aussi était à cheval ! Les uns élargissaient les jambes en cerceau, et ne se maintenaient ainsi que par la force du poignet; les autres n'étaient pas assis, mais couchés."
                                            },
                                            {
                                                "example_id": "122d6344-add6-4863-98cd-49796d52507d",
                                                "sense_id": "1e376a56-b568-3491-b86a-c4ed4cc6f9ad",
                                                "text": "Élargissez votre champ d’action."
                                            },
                                            {
                                                "example_id": "92716aa2-e0b0-4e80-aa7f-d30d7b448580",
                                                "sense_id": "1e376a56-b568-3491-b86a-c4ed4cc6f9ad",
                                                "text": "[…] ; elles s'y frayèrent un passage et donnèrent naissance à un nouveau cours d'eau souterrain. Les eaux s’étant ainsi écoulées, élargirent peu à peu leur passage et finirent par absorber toutes les autres fontaines ou sources de ces localités."
                                            },
                                            {
                                                "example_id": "87b754ad-889d-4406-a485-62493ca13ede",
                                                "sense_id": "1e376a56-b568-3491-b86a-c4ed4cc6f9ad",
                                                "text": "— Rappeler les travaux de Maillot, de Haspel, de Worms, de Dutroulau, de Colin et de bien d'autres, c'est signaler à la reconnaissance publique des confrères qui, par leur savoir et leur esprit d'observation, redressèrent ou élargirent nos idées pour le plus grand honneur de la science française et le bien de l'humanité."
                                            },
                                            {
                                                "example_id": "976c23a2-fbe5-4106-878e-c0e353e278fe",
                                                "sense_id": "1e376a56-b568-3491-b86a-c4ed4cc6f9ad",
                                                "text": "Pour élargir nos horizons, nous lisions beaucoup et nous discutions entre nous."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c100a5f7-824d-3e40-ae58-20e2f43b4963",
                                        "entry_id": "8c184bab-5148-3619-8281-c6811ef0830d",
                                        "glosses": [
                                            "Libérer de prison."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43db33d3-35a4-4f8a-ba5d-78880c457bb5",
                                                "sense_id": "c100a5f7-824d-3e40-ae58-20e2f43b4963",
                                                "text": "Il avait été mis en prison par erreur, on l’a élargi immédiatement."
                                            },
                                            {
                                                "example_id": "4f9a20d5-b8b8-4f16-8b2a-3f01f48ac244",
                                                "sense_id": "c100a5f7-824d-3e40-ae58-20e2f43b4963",
                                                "text": "Vous observerez aussi qu’il ne suffirait pas que la partie publique et la partie civile donnassent leur consentement à la liberté provisoire de l’accusé, si le juge lui-même ne la prononçait; car l’art. 23 de l’ordonnance citée dit formellement que « les prisonniers pour crime ne pourront être élargis, s’il n’est ordonné par le juge, encore que les procureurs du roi, ou ceux des seigneurs et les parties civiles y consentent »."
                                            },
                                            {
                                                "example_id": "49a4b92f-c456-4e89-a17e-e2f7abfb45c6",
                                                "sense_id": "c100a5f7-824d-3e40-ae58-20e2f43b4963",
                                                "text": "Je ne fus pas plus tôt acquitté, réhabilité et élargi, que je courus auprès d'Edmée; j'arrive pour assister aux derniers moments de mon grand-oncle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b00f0ef9-6687-3193-a140-4b10b52782c4",
                                        "entry_id": "8c184bab-5148-3619-8281-c6811ef0830d",
                                        "glosses": [
                                            "…"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38fd8d25-d7d6-4bd8-b9ae-8074e83eb878",
                                                "sense_id": "b00f0ef9-6687-3193-a140-4b10b52782c4",
                                                "text": "Élargir les tailles : Rendre plus larges les espaces qui sont entre les tailles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bcd37ee0-b33b-3064-bfaa-3ab1b5f883eb",
                                        "entry_id": "8c184bab-5148-3619-8281-c6811ef0830d",
                                        "glosses": [
                                            "Devenir plus large."
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "78f00fc8-cb7f-4a3c-9c06-9e3ccc67dc68",
                                                "sense_id": "bcd37ee0-b33b-3064-bfaa-3ab1b5f883eb",
                                                "text": "Les individus qui forment le tronc, ont de 4 à 7 mm de long. Généralement, les tubes, relativement étroits, s’élargissent subitement en cornet à leur ouverture."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d7f0ae29-ed82-3331-bef2-003b661cf122",
                                        "entry_id": "8c184bab-5148-3619-8281-c6811ef0830d",
                                        "glosses": [
                                            "Augmenter le nombre de bits de représentation, surtout pour les entiers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "54079ab9-59f9-4bdf-a944-3b03c4dd030a",
                                                "sense_id": "d7f0ae29-ed82-3331-bef2-003b661cf122",
                                                "text": "Si l'un des deux opérandes a 64 bits, l’autre est élargi de 32 à 64 bits avant de résoudre l’opérateur."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
