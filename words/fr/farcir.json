    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c80f9408-4901-31b3-b0f9-4b32031b7ce1",
                    "sense_definition": "Remplir un aliment avec une farce ou une préparation culinaire.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "cuisine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pour le repas du dimanche, nous voulons <w>farcir</w> des tomates avec de la viande hachée."
                        },
                        {
                            "text": "Le chef cuisinier apprend aux apprentis à <w>farcir</w> une dinde pour les fêtes de fin d'année."
                        }
                    ],
                    "common_phrases": [
                        "farcir des tomates",
                        "farcir une dinde"
                    ]
                },
                {
                    "sense_id": "b58c97d4-fc2d-3562-8399-fffa328ecffa",
                    "sense_definition": "Supporter une tâche pénible, une corvée ou une personne désagréable.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "subir",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je dois me <w>farcir</w> toute la vaisselle parce que mon colocataire refuse d'aider."
                        },
                        {
                            "text": "Il a dû se <w>farcir</w> trois heures de réunion interminable ce matin au bureau."
                        }
                    ],
                    "synonyms": [
                        "se taper"
                    ],
                    "common_phrases": [
                        "se farcir la corvée",
                        "se farcir le trajet"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "registre familier"
                        }
                    ]
                },
                {
                    "sense_id": "17653958-7cf2-317b-ac98-7de9018d8995",
                    "sense_definition": "Remplir ou encombrer excessivement l'esprit, un texte ou un discours.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "encombrer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'orateur a choisi de <w>farcir</w> son discours de citations latines pour impressionner l'assemblée."
                        },
                        {
                            "text": "Arrête de te <w>farcir</w> la tête de pensées négatives avant cet examen important."
                        }
                    ],
                    "common_phrases": [
                        "farcir la tête",
                        "farcir de citations"
                    ]
                },
                {
                    "sense_id": "73ba13ac-7d35-362c-aff8-7ffce74f8ced",
                    "sense_definition": "S'accorder ou consommer quelque chose avec grand plaisir ou en quantité.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
