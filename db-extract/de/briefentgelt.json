                "senses": [
                    {
                        "sense_id": "c75cfdad-2d08-34a5-ba29-085685ccdf13",
                        "entry_id": "09109dea-f5e6-3115-8e07-d4630ecdc81f",
                        "glosses": [
                            "für das Versenden eines Briefes zu zahlender Betrag"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4707fc88-1980-4a3f-a95b-8af18d18217e",
                                "sense_id": "c75cfdad-2d08-34a5-ba29-085685ccdf13",
                                "text": "„Das Briefentgelt bei ‚Werbeantwort international‘ beträgt 120 Cent (unabhängig vom gewählten Format).“"
                            },
                            {
                                "example_id": "152b6c7a-f9b6-40c4-92cf-b9510b9fffe8",
                                "sense_id": "c75cfdad-2d08-34a5-ba29-085685ccdf13",
                                "text": "„Durch Kosteneinsparungen von USPS im zweistelligen Milliardenbereich (US$) konnten die Briefentgelte deutlich gesenkt werden.“"
                            },
                            {
                                "example_id": "38879061-50ae-4cec-95c8-a4ecd1d2b64a",
                                "sense_id": "c75cfdad-2d08-34a5-ba29-085685ccdf13",
                                "text": "„Bitte fügen Sie Ihrem schriftlichen Antrag Postwertzeichen in Höhe des Entgelts für einen gewöhnlichen Standardbrief bei, weil andernfalls ein Nachentgelt (Briefentgelt und Einziehungsentgelt) erhoben werden muss.“"
                            },
                            {
                                "example_id": "7443152b-84d6-4eb3-95f7-b71668d56942",
                                "sense_id": "c75cfdad-2d08-34a5-ba29-085685ccdf13",
                                "text": "„In beiden Punkten ist bis heute noch kein nennenswerter Fortschritt erzielt worden, da einzelne Postverwaltungen (vor allem Dänemark und Niederlande) wegen des niedrigen Briefentgelts von dem System des Remailings profitieren.“"
                            },
                            {
                                "example_id": "0af5ad59-a1f1-4f95-bbf6-7dd17b2e371e",
                                "sense_id": "c75cfdad-2d08-34a5-ba29-085685ccdf13",
                                "text": "„Am Anfang soll die Organisation des Lübecker Botenwesens im allgemeinen dargestellt werden Dann werden besondere Verordnungen bezüglich der Entrichtung des hansischen Briefentgeltes herausgearbeitet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
