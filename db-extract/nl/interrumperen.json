        "nl-extract.jsonl": [
            {
                "entry_id": "934df864-e921-3d05-85c1-0600f10f2f91",
                "word": "interrumperen",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "e80d055b-e86a-3edb-b3f5-36d67826c1b0",
                        "entry_id": "934df864-e921-3d05-85c1-0600f10f2f91",
                        "glosses": [
                            "iemand in de rede vallen die een betoog aan het houden is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0529d4cf-1215-4dc6-82e2-3867d8bb6131",
                                "sense_id": "e80d055b-e86a-3edb-b3f5-36d67826c1b0",
                                "text": "Denk blijft hiertegen bezwaar hebben, omdat deze partij als enige van de dertien Kamerfracties niet aan het gangpad zit. „Dat maakt het lastig om te interrumperen en om scherp te zijn in het debat”, aldus fractievoorzitter Tunahan Kuzu. Hij beraadt zich op een volgende stap, als dat procedureel al mogelijk is: het presidium is als dagelijks bestuur het hoogste orgaan van de Tweede Kamer. Wellicht zullen de drie fractieleden bij plenaire debatten opnieuw achter hun blauwe stoel blijven staan, zoals zij ook al even deden bij de installatie van de nieuwe Kamer op 23 maart."
                            },
                            {
                                "example_id": "f2bde0f0-8a83-4868-9eb6-8ea7392d9469",
                                "sense_id": "e80d055b-e86a-3edb-b3f5-36d67826c1b0",
                                "text": "Verrassing/schrikmoment 1: Op het grote videoscherm lezen we niet alleen de gebruikelijke verbodsbepalingen over geluid- en beeldopnamen, maar ook dat 'texting, tweeting, talking and heckling' (het luidruchtig interrumperen van de komiek) redenen zijn om uit de zaal te worden gezet."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cc97fcd9-4369-4009-a0ce-a275d87fcba2",
                        "source_entry_id": "934df864-e921-3d05-85c1-0600f10f2f91",
                        "source_sense_id": "e80d055b-e86a-3edb-b3f5-36d67826c1b0",
                        "source_sense_description": "(politiek) iemand in de rede vallen die een betoog aan het houden is",
                        "target_lang_word": "interrupt",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "interrupt",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "23b6d70e-10b0-3b8d-a379-12f2c9e3d8d2",
                                        "entry_id": "394d72fe-c840-373e-9a68-41d3fa8eb8c9",
                                        "glosses": [
                                            "To disturb or halt (an ongoing process or action, or the person performing it) by interfering suddenly, especially by speaking."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0700eb68-b050-4658-a02f-871b73a37ccf",
                                                "sense_id": "23b6d70e-10b0-3b8d-a379-12f2c9e3d8d2",
                                                "text": "A maverick politician repeatedly interrupted the debate by shouting."
                                            },
                                            {
                                                "example_id": "69dc349b-e150-4892-a7fb-6172df806a08",
                                                "sense_id": "23b6d70e-10b0-3b8d-a379-12f2c9e3d8d2",
                                                "text": "Do not interrupt me in my course."
                                            },
                                            {
                                                "example_id": "20a3d3f1-d931-40c7-8f13-8020f3662665",
                                                "sense_id": "23b6d70e-10b0-3b8d-a379-12f2c9e3d8d2",
                                                "text": "One saint's day in mid-term a certain newly appointed suffragan-bishop came to the school chapel, and there preached on “The Inner Life.” He at once secured attention by his informal method, and when presently the coughing of Jarvis […] interrupted the sermon, he altogether captivated his audience with a remark about cough lozenges being cheap and easily procurable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d468404c-1edc-3b3a-a709-57448ae910c4",
                                        "entry_id": "394d72fe-c840-373e-9a68-41d3fa8eb8c9",
                                        "glosses": [
                                            "To divide; to separate; to break the monotony of."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b1873379-e9fe-4564-b6a4-643559790fb4",
                                                "sense_id": "d468404c-1edc-3b3a-a709-57448ae910c4",
                                                "text": "The evenness of the road was not interrupted by a single hill."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b805da7c-ffdc-3e1d-8304-d611092dd7a0",
                                        "entry_id": "394d72fe-c840-373e-9a68-41d3fa8eb8c9",
                                        "glosses": [
                                            "To assert to (a computer) that an exceptional condition must be handled."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "44176ee0-f712-4054-9673-9a87fc4697c1",
                                                "sense_id": "b805da7c-ffdc-3e1d-8304-d611092dd7a0",
                                                "text": "The packet receiver circuit interrupted the microprocessor."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "interrupt",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7463fd4f-0d94-3542-8d61-806a13953868",
                                        "entry_id": "7ca7dc94-4bad-3d42-bc4a-e5850bb3df25",
                                        "glosses": [
                                            "An event that causes a computer or other device to temporarily cease what it was doing and attend to a condition."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e5cb88a-d95b-4c39-963e-61edeed3a5e8",
                                                "sense_id": "7463fd4f-0d94-3542-8d61-806a13953868",
                                                "text": "The interrupt caused the packet handler routine to run."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
