        "fr-extract.jsonl": [
            {
                "entry_id": "bf084bee-5dd5-375a-8594-cf16b991a51c",
                "word": "indisposition",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "459e2d50-113d-45bf-83c5-d33a7ab6b074",
                        "entry_id": "bf084bee-5dd5-375a-8594-cf16b991a51c",
                        "tags": [
                            "plural"
                        ],
