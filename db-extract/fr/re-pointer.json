                        "tags": [],
                        "examples": [
                            {
                                "example_id": "14869198-f4a5-487a-9ffe-bd6faac370e2",
                                "sense_id": "0b9ec655-8499-342d-abe4-3b2de7851f0d",
                                "text": "Et justement, j’attendrai que la maman soit de retour au bercail avant que de m’y re-pointer moi même."
                            },
                            {
                                "example_id": "e8cd4ef0-22f2-4b10-a912-510f18fd2db4",
                                "sense_id": "0b9ec655-8499-342d-abe4-3b2de7851f0d",
                                "text": "Il faut que tu gères, quand même, parce qu’elle risque de se re-pointer."
