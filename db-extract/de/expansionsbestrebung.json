                        "examples": [
                            {
                                "example_id": "4008fe44-a5d0-4917-aff1-a71019565705",
                                "sense_id": "f19b14c4-88b3-3bdc-93cc-e58d8d0ca40e",
                                "text": "„Das Land wurde zum «Frontstaat» im Kampf gegen die Expansionsbestrebungen der Sowjetunion und 2001 zum wichtigen Alliierten der NATO im «Krieg gegen den Terrorismus» (War on Terror).“"
                            },
                            {
                                "example_id": "1a763ca4-d67e-4a70-b5b2-e53ad990e20d",
                                "sense_id": "f19b14c4-88b3-3bdc-93cc-e58d8d0ca40e",
                                "text": "„Im Westen herrschte dagegen die Meinung vor, dass die Ursache für die Besetzung in der sowjetischen Expansionsbestrebung lag, die noch von der zaristischen Südpolitik herrührte.“"
                            },
                            {
                                "example_id": "8d4a65b0-74b4-45e4-b7e4-1e2763f1f0eb",
                                "sense_id": "f19b14c4-88b3-3bdc-93cc-e58d8d0ca40e",
                                "text": "„Die christlichen Expansionsbestrebungen waren auf die kolonialen angewiesen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
