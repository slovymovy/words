                "senses": [
                    {
                        "sense_id": "fc603911-ffa4-324e-9afe-f75338d40930",
                        "entry_id": "54ad34d0-345f-3e59-8e4f-2cfee89007cc",
                        "glosses": [
                            "Bedarf an Holz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "feca2627-1dd1-4ef2-993b-245832f666c8",
                                "sense_id": "fc603911-ffa4-324e-9afe-f75338d40930",
                                "text": "„In Kenia ließ sich durch Förderung von Agroforsten erreichen, daß der Holzbedarf heute zu 47 Prozent von landwirtschaftlichen Nutzflächen und zu 25 Prozent von naturnahem Weideland gedeckt wird; aus dem Wald stammen nur noch 28 Prozent.“"
                            },
                            {
                                "example_id": "2d1c814d-508f-4d68-833d-7b2fc6b56ec6",
                                "sense_id": "fc603911-ffa4-324e-9afe-f75338d40930",
                                "text": "„Immer mehr weidende Hirsche und der Holzbedarf des Menschen haben dazu geführt, dass Biber immer wenig Baumaterial finden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
