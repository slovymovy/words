                "senses": [
                    {
                        "sense_id": "d2e86c52-0e6a-3f37-80bd-2eb5e6c22d5d",
                        "entry_id": "cde43a04-a698-315b-aa3b-c55bfbd56b8d",
                        "glosses": [
                            "A close but nonsexual relationship between two or more men."
                        ],
                        "tags": [
                            "countable",
                            "slang",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "604ac946-2485-4564-b418-700ca274201d",
                                "sense_id": "d2e86c52-0e6a-3f37-80bd-2eb5e6c22d5d",
                                "text": "Bromance—Romance between bros. Example: ‘It looks like there's a bit of bromance between Ryan and Matt.’"
                            },
                            {
                                "example_id": "bdcc1a4f-6e6a-4b7a-b388-9fd8c7a079eb",
                                "sense_id": "d2e86c52-0e6a-3f37-80bd-2eb5e6c22d5d",
                                "text": "The letter was pure puffery, probably written by some clerk in North Korea's agitprop bureau, but Trump loved it. This was the beginning of the Trump-Kim bromance."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cbad839c-5e70-4051-8a98-eb8b9a1b43e6",
                        "source_entry_id": "cde43a04-a698-315b-aa3b-c55bfbd56b8d",
                        "source_sense_id": "d2e86c52-0e6a-3f37-80bd-2eb5e6c22d5d",
                        "source_sense_description": "close but non-sexual relationship between two or more men",
                        "target_lang_word": "bromance",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bromance",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f91125ab-537d-3234-95f0-0de2b9d3a677",
                                        "entry_id": "61eab227-ea02-3f2b-ab8b-adb3fad222b2",
                                        "glosses": [
                                            "Relation proche entre deux hommes, sans caractère sexuel ; comportement et attitude de bienveillance incluant des gestes d’affection amicale entre deux hommes."
                                        ],
                                        "tags": [
                                            "Anglicism",
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "77e08844-bb17-4a89-a985-c012f3310a07",
                                                "sense_id": "f91125ab-537d-3234-95f0-0de2b9d3a677",
                                                "text": "Je sais ce que c’est qu’une bromance, Jonah. Là, c’est pas ça. Il s’est passé beaucoup plus entre nous. On s'est roulé une pelle pendant plus d’une demi-heure, bordel."
                                            },
                                            {
                                                "example_id": "79cadbd6-391d-4057-8dfc-0ce62526e02c",
                                                "sense_id": "f91125ab-537d-3234-95f0-0de2b9d3a677",
                                                "text": "[Titre] « Bromance » embarrassante entre Donald Trump et Kanye West à la Maison Blanche"
                                            },
                                            {
                                                "example_id": "6d7d3cf7-8b2d-49ea-be56-48e89db2b801",
                                                "sense_id": "f91125ab-537d-3234-95f0-0de2b9d3a677",
                                                "text": "[…] malgré deux personnages masculins fragiles qui ne trouvent rien de mieux à faire que de zigouiller la femme de l’un pour vivre pleinement une bromance composée principalement de parties d’échecs, de silence et de sourires de connivence - […]."
                                            },
                                            {
                                                "example_id": "d383dac4-079a-4fac-b360-d8eec8b3c486",
                                                "sense_id": "f91125ab-537d-3234-95f0-0de2b9d3a677",
                                                "text": "— Ça changerait quelque chose si je te disais qu’une bromance est une mauvaise idée ?\n— Une bromance n’est jamais une mauvaise idée."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "82aafa9f-4505-4356-8291-6e94e2c6912e",
                        "source_entry_id": "cde43a04-a698-315b-aa3b-c55bfbd56b8d",
