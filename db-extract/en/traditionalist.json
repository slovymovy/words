                        "form": "more traditionalist"
                    },
                    {
                        "form_id": "ecfc34a5-ac28-43d9-a543-a444aaccff13",
                        "entry_id": "d36667a5-11d8-3902-84fa-34cb6c0f7897",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most traditionalist"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "307c433d-8631-392c-aede-40313a9fdd34",
                        "entry_id": "d36667a5-11d8-3902-84fa-34cb6c0f7897",
                        "glosses": [
                            "Adhering to tradition, especially in religious practices."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c0177a5-5ebd-4d79-8c79-a16496cfcedf",
                                "sense_id": "307c433d-8631-392c-aede-40313a9fdd34",
                                "text": "The day before, Cardinal Burke and other traditionalist prelates made public an exchange of letters with Francis in which they aired grave doubts about the legitimacy of a major assembly of the world’s bishops and laypeople that will, on Wednesday, begin discussing some of the most sensitive topics in the church."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "a1ce09af-b97e-390e-9b6d-966c9e2480c9",
                "word": "traditionalist",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "889a44b8-f808-4c64-96e1-7924b9b2e69b",
                        "entry_id": "a1ce09af-b97e-390e-9b6d-966c9e2480c9",
                        "tags": [
                            "plural"
                        ],
                        "form": "traditionalists"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d37086cc-65f1-3e13-a8a6-751752b24d11",
                        "entry_id": "a1ce09af-b97e-390e-9b6d-966c9e2480c9",
                        "glosses": [
                            "A person who adheres to tradition, especially in cultural or religious practices."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2fc0dda3-24fd-4547-a7e0-737ee807e452",
                                "sense_id": "d37086cc-65f1-3e13-a8a6-751752b24d11",
                                "text": "Pullman traditionalists will no doubt maintain that the full-service-at-every-seat principle is popular with their clientele; […]."
                            },
                            {
                                "example_id": "1bdf8156-cc65-4ce2-8f03-31f78b282632",
                                "sense_id": "d37086cc-65f1-3e13-a8a6-751752b24d11",
                                "text": "He speaks at conferences across the country and posts prolifically on social media on topics ranging from the ethics of Covid-19 vaccines (which he has questioned) to the Latin Mass favored by traditionalists (and discouraged by Pope Francis) to local conflicts between priests and bishops."
                            },
                            {
                                "example_id": "285eedf9-3a82-4261-a6c2-20ce216d7bcb",
                                "sense_id": "d37086cc-65f1-3e13-a8a6-751752b24d11",
                                "text": "Among the frontrunners before the conclave began were Pietro Parolin, the Vatican’s secretary of state; Luis Antonio Tagle, a reformer from the Philippines; Péter Erdő, a traditionalist from Hungary; Robert Sarah, a cardinal from Guinea who criticised Francis’s papacy; and the moderate US cardinal Robert Prevost."
                            }
                        ]
                    },
                    {
                        "sense_id": "a3264873-4f44-30b0-9131-ca5efd350ea4",
                        "entry_id": "a1ce09af-b97e-390e-9b6d-966c9e2480c9",
                        "glosses": [
                            "A traditional climbing climber."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "55414e48-7c3a-49c4-af96-0c1f3ef9157b",
                        "source_entry_id": "a1ce09af-b97e-390e-9b6d-966c9e2480c9",
                        "source_sense_description": "one who adheres to tradition",
                        "target_lang_word": "traditionaliste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "traditionaliste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "005230c7-fdec-3197-96eb-dbb77028d666",
                                        "entry_id": "1a4f9af9-9f2b-3913-9d6a-5d5e5c495872",
                                        "glosses": [
                                            "Qui professe le traditionalisme, qui est attaché aux idées, aux coutumes transmises par la tradition."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b12ef76-1708-4875-8357-fee772e0cba7",
                                                "sense_id": "005230c7-fdec-3197-96eb-dbb77028d666",
                                                "text": "Une position qui ne satisfait ni les militants du MNR ni ceux du FN, qui rassemblent des gens de « sensibilités différentes » et mélangent des catholiques traditionalistes, des anciens de l’OAS, des royalistes, des racialistes, des paganistes."
                                            },
                                            {
                                                "example_id": "62a7ea21-ab69-41f8-8478-433dc8a05f3e",
                                                "sense_id": "005230c7-fdec-3197-96eb-dbb77028d666",
                                                "text": "Bref, les frontières entre catholiques « observants », « traditionalistes » et « intégristes » semblent poreuses dans l’entre-soi versaillais."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "traditionaliste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fbd9bf83-f6b5-3fc7-95d5-7fc50a591a5e",
                                        "entry_id": "e42914d4-35b6-361d-a2ad-8ed409f4c21f",
                                        "glosses": [
                                            "Personne attachée à la tradition, au passé, à la stabilité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4914cb3-74a4-420e-9539-df3e1f1f32f5",
                                                "sense_id": "fbd9bf83-f6b5-3fc7-95d5-7fc50a591a5e",
                                                "text": "En France, traditionalistes et modernistes se déchiraient... sur une cérémonie qu’ils n’avaient pas encore vue."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
