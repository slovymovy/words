                                    },
                                    {
                                        "sense_id": "67282858-29c5-3978-be77-cb45e83f5c85",
                                        "entry_id": "96e19841-2e38-331f-9a72-4d084e68fb78",
                                        "glosses": [
                                            "The forgiveness of sins, in a general sense."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "616d869f-4199-3f24-b631-422e66229cb7",
                                        "entry_id": "96e19841-2e38-331f-9a72-4d084e68fb78",
                                        "glosses": [
                                            "The form of words by which a penitent is absolved."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4117ee10-ea71-356f-b490-f2b01a6fc777",
                                        "entry_id": "96e19841-2e38-331f-9a72-4d084e68fb78",
                                        "glosses": [
                                            "An absolving, or setting free from guilt, sin, or penalty; forgiveness of an offense."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd7b4b74-bc99-43a9-865d-30baf4fa51c6",
                                                "sense_id": "4117ee10-ea71-356f-b490-f2b01a6fc777",
                                                "text": "Governments granting absolution to the nation."
                                            },
                                            {
                                                "example_id": "d5718ced-4a41-4e52-80ad-b7e2093b614e",
                                                "sense_id": "4117ee10-ea71-356f-b490-f2b01a6fc777",
                                                "text": "The true aim of medicine is not to make men virtuous; it is to safeguard and rescue them from the consequences of their vices. The physician does not preach repentance; he offers absolution."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "85ab4ba7-ef05-3b88-b849-7a6c65803998",
                                        "entry_id": "96e19841-2e38-331f-9a72-4d084e68fb78",
                                        "glosses": [
                                            "An acquittal, or sentence of a judge declaring an accused person innocent."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "75a20ef0-ed03-3d54-a189-7b2ff2738563",
                                        "entry_id": "96e19841-2e38-331f-9a72-4d084e68fb78",
                                        "glosses": [
                                            "Delivery, in speech."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a81fa28f-fdc6-4880-8c7e-d812ec6afb37",
                                                "sense_id": "75a20ef0-ed03-3d54-a189-7b2ff2738563",
                                                "text": "the words are chosen , their sound ample , the composition full , the absolution plenteous"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ef9570be-30f4-428b-a1c3-830770acb977",
                        "source_entry_id": "cadc3429-c1a7-3883-8912-39b2669b32bb",
                        "source_sense_id": "3ca3d424-33d3-3727-a2b6-a418241b2df2",
                        "target_lang_word": "absolution",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "absolution",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a556d71e-0370-3ca0-85be-d19fcabc88a0",
                                        "entry_id": "7a159aec-73a1-3617-811e-9da8599c5ec8",
                                        "glosses": [
                                            "Action d’absoudre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "225ecb1a-8923-48cf-8d6b-6043484f38f7",
                                                "sense_id": "a556d71e-0370-3ca0-85be-d19fcabc88a0",
                                                "text": "\"Laurence, lui demandai-je assez lâchement, vous m'en voulez donc à ce point ?\" […] \"Si je comprends bien, dit-elle, vous me demandez une absolution. Votre vertu rétamée ne suffit pas à vous rassurer, ni le pardon de votre Dieu - car il vous a sûrement pardonné, n'est-ce pas ?\""
                                            },
                                            {
                                                "example_id": "5446c130-93ad-40b1-8828-2912b3e87a7a",
                                                "sense_id": "a556d71e-0370-3ca0-85be-d19fcabc88a0",
                                                "text": "Hector fit un geste d'absolution, onctueux comme un prélat, plus dissimulé qu'un Tartuffe et soulagea Arsène André de sa présence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9abce88e-f9ba-3693-8ea9-9c94270df37d",
                                        "entry_id": "7a159aec-73a1-3617-811e-9da8599c5ec8",
                                        "glosses": [
                                            "Jugement qui renvoie de l’accusation un accusé auteur d’un fait qui n’est puni par aucune loi."
                                        ],
                                        "tags": [
                                            "Droit criminel"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "26e87bb2-703c-3496-92d5-ad7936fec6d5",
                                        "entry_id": "7a159aec-73a1-3617-811e-9da8599c5ec8",
                                        "glosses": [
                                            "Sentence passée sur un accusé reconnu coupable, en vertu de laquelle celui-ci est réputé ne pas avoir commis de crime; peut être inconditionnelle ou conditionnelle."
                                        ],
                                        "tags": [
                                            "Droit criminel",
                                            "Canada"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6aa256c9-eac1-3166-9d8b-b683dcdbbfa2",
                                        "entry_id": "7a159aec-73a1-3617-811e-9da8599c5ec8",
                                        "glosses": [
                                            "Action par laquelle le prêtre remet les péchés en vertu des paroles sacramentelles qu’il prononce."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2306c4f0-86ca-428b-b897-fa806a5a7c2d",
                                                "sense_id": "6aa256c9-eac1-3166-9d8b-b683dcdbbfa2",
                                                "text": "Son caractère libre et jovial, ainsi que la facilité avec laquelle il donnait l’absolution aux pécheurs ordinaires, en faisait le favori de la noblesse et des principaux bourgeois, […]."
                                            },
                                            {
                                                "example_id": "ad5a81d6-c202-4028-8bb7-53ed31a1ba7c",
                                                "sense_id": "6aa256c9-eac1-3166-9d8b-b683dcdbbfa2",
                                                "text": "La Marquise.– Malaspina, vous en voulez trop savoir. Refusez-moi l’absolution, si vous voulez ; je prendrai pour confesseur le premier prêtre venu, qui me la donnera."
                                            },
                                            {
                                                "example_id": "030589e9-12f5-4c49-ae8c-26b80e10b1d6",
                                                "sense_id": "6aa256c9-eac1-3166-9d8b-b683dcdbbfa2",
                                                "text": "Voyons, fit-il avec un sourire indulgent, confessez-vous à moi, ne craignez rien, je vous donnerai l’absolution, allez."
                                            },
                                            {
                                                "example_id": "b0099d3e-d491-4f95-a52d-98c962707877",
                                                "sense_id": "6aa256c9-eac1-3166-9d8b-b683dcdbbfa2",
                                                "text": "Depuis le 1ᵉʳ octobre 1879, je remplis les fonctions d'instituteur communal à Flohimont. Mon prédécesseur avait 55 élèves en hiver; en été 35 environ. Je n'ai eu que 13 élèves en hiver et 6 à 8 en été. J'attribue la désertion de mon école à la peine d'excommunication lancée par le curé, au refus d’absolution et surtout de première communion."
                                            },
                                            {
                                                "example_id": "6e3ac44b-4014-4215-97d6-0bf1e8453a5f",
                                                "sense_id": "6aa256c9-eac1-3166-9d8b-b683dcdbbfa2",
                                                "text": "Les communautés les plus reculées ne reçoivent donc parfois la visite d’un prêtre que deux à trois fois par an, voire moins encore. C’est peu quand on considère que l’Eglise catholique réserve aux hommes ordonnés certains des actes essentiels de sa vie de foi, comme l’eucharistie et l’absolution des péchés."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
