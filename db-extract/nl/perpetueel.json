                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ad69c1c3-7da3-3521-bf91-4794e1c698bf",
                                        "entry_id": "6ae20c17-f4da-35b5-ac4a-9183d836fd63",
                                        "glosses": [
                                            "Set up to be in effect or have tenure for an unlimited duration."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b0698f71-0f03-412f-a926-ce78cd0de79b",
                                                "sense_id": "ad69c1c3-7da3-3521-bf91-4794e1c698bf",
                                                "text": "perpetual copyright"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aae1f7a9-6aa1-3191-9307-f498ff819d94",
                                        "entry_id": "6ae20c17-f4da-35b5-ac4a-9183d836fd63",
                                        "glosses": [
                                            "Continuing; uninterrupted."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "52006495-1be4-4bd1-a937-dd33ae0f4dc4",
                                                "sense_id": "aae1f7a9-6aa1-3191-9307-f498ff819d94",
                                                "text": "\"And yet,\" returned Francesca, \"the secret of Arden's sufferings seems to have been in himself. From earliest youth he indulged in vain contrasts and repinings, and even his very love was selfish and cruel. Think how much happiness he lost by his perpetual exaggerations!\""
                                            },
                                            {
                                                "example_id": "e1a38777-f95b-4e2c-8161-e8f439e87c5e",
                                                "sense_id": "aae1f7a9-6aa1-3191-9307-f498ff819d94",
                                                "text": "There are perpetual requests for changes as new payloads and new demands and modifications are suggested by the users."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4a737816-8267-3e66-bf02-826765e7a5ec",
                                        "entry_id": "6ae20c17-f4da-35b5-ac4a-9183d836fd63",
                                        "glosses": [
                                            "Flowering throughout the growing season."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3ed6df6a-cc24-4bd6-9050-d25db009fbac",
                                                "sense_id": "4a737816-8267-3e66-bf02-826765e7a5ec",
                                                "text": "By means of artificial hybridization, practised for a series of years, he has succeeded in producing a race of carnations which are perpetual bloomers."
                                            },
                                            {
                                                "example_id": "de4a9293-8724-4c28-b8c7-28c7cb5ef42c",
                                                "sense_id": "4a737816-8267-3e66-bf02-826765e7a5ec",
                                                "text": "The hybrid perpetual roses as a rule require to be pruned to within 4 to 6 inches of the ground."
                                            }
                                        ]
                                    }
                                ]
                            },
