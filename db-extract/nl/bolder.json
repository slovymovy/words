                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bollard",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9ab20934-8072-3455-acf6-8daae7cad8e4",
                                        "entry_id": "222a25e4-39f8-3ce8-9dab-2cd7482d4c2a",
                                        "glosses": [
                                            "Bitte d’amarrage, élément fixe situé sur le quai pour amarrer un bateau dans les ports."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58f358f9-3b9a-4eea-8cb8-e50eb9cc366d",
                                                "sense_id": "9ab20934-8072-3455-acf6-8daae7cad8e4",
                                                "text": "Le câble peut ensuite être assujetti à un bollard d’amarrage."
                                            },
                                            {
                                                "example_id": "3f04b1ed-2674-4355-bd61-9c609f5d259a",
                                                "sense_id": "9ab20934-8072-3455-acf6-8daae7cad8e4",
                                                "text": "L’une pilote tandis que l’autre accroche prestement le cordage au bollard qui sert à tenir le bateau pendant l’éclusée."
                                            },
                                            {
                                                "example_id": "c123489b-5338-4551-9bcb-0dda02652e98",
                                                "sense_id": "9ab20934-8072-3455-acf6-8daae7cad8e4",
                                                "text": "Le sas comporte, dans chacune de ses parois latérales, six rainures verticales pour bollards flottants, servant à l’amarrage des bateaux. Ces bollards sont fixés sur un cylindre métallique qui coulisse à l’intérieur des rainures en suivant le niveau de l’eau dans le sas."
                                            },
                                            {
                                                "example_id": "9444e952-e60b-4373-9a98-677232a5f259",
                                                "sense_id": "9ab20934-8072-3455-acf6-8daae7cad8e4",
                                                "text": "Elliott coupa le moteur, sauta à terre, un cordage en main qu’il arrima autour du bollard."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8e1cdcc3-617a-3c96-a075-d37c7e593179",
                                        "entry_id": "222a25e4-39f8-3ce8-9dab-2cd7482d4c2a",
                                        "glosses": [
                                            "Élément physique marquant la séparation d’une zone piétonnière d'une voie routière. Dans ce sens, on dit aussi borne de protection, borne d’interdiction ou potelet."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5888dc5d-67f4-4aa9-8077-e81bc049591b",
                        "source_entry_id": "a323172d-bf60-3ba3-96af-4277b86593b5",
