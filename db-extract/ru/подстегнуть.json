                        "form_id": "6f6c8454-23e4-4499-8b9a-0ea08f5aac1c",
                        "entry_id": "14f3db62-c67b-3786-a565-131d39558c98",
                        "tags": [
                            "participle",
                            "passive",
                            "past"
                        ],
                        "form": "подстёгнутый"
                    },
                    {
                        "form_id": "08ff9efb-03cb-4949-8c3c-d19208393655",
                        "entry_id": "14f3db62-c67b-3786-a565-131d39558c98",
                        "tags": [
                            "adverbial",
                            "participle",
                            "past"
                        ],
                        "form": "подстегну́в"
                    },
                    {
                        "form_id": "5913955c-fe40-447e-bdaf-e7db92da77fb",
                        "entry_id": "14f3db62-c67b-3786-a565-131d39558c98",
                        "tags": [
                            "adverbial",
                            "participle",
                            "past"
                        ],
                        "form": "подстегну́вши"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ce6a1a0e-959d-3eed-8daa-b0b29e69b77f",
                        "entry_id": "14f3db62-c67b-3786-a565-131d39558c98",
                        "glosses": [
                            "стегнуть, хлестнуть, подгоняя"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf4f78d9-20e1-4639-83e7-945424931fc1",
                                "sense_id": "ce6a1a0e-959d-3eed-8daa-b0b29e69b77f",
                                "text": "Кубарем, с вытаращенными глазами, скатились вниз Фимка и Бронька, — Мишука для смеха подстегнул их по задам."
                            },
                            {
                                "example_id": "b469d521-164e-4ecb-a5d0-5dac753fa5ec",
                                "sense_id": "ce6a1a0e-959d-3eed-8daa-b0b29e69b77f",
                                "text": "— Кнутиком подстегнёшь, она и бежит, скотинка-те…"
                            },
                            {
                                "example_id": "9312e32a-a845-4949-a493-ba73b647a327",
                                "sense_id": "ce6a1a0e-959d-3eed-8daa-b0b29e69b77f",
                                "text": "Тигрица уже несколько раз собиралась прыгнуть, но почему-то медлила. Пришлось слегка подстегнуть её хлыстом."
                            }
                        ]
                    },
                    {
                        "sense_id": "9f66d31d-4688-3f25-bded-80ca8e0e3f08",
                        "entry_id": "14f3db62-c67b-3786-a565-131d39558c98",
                        "glosses": [
                            "разг. побудить кого-либо действовать быстрее"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c791100e-3944-4d51-8a07-a5fc182d503f",
                                "sense_id": "9f66d31d-4688-3f25-bded-80ca8e0e3f08",
                                "text": "Французского мастера такими словами будто подстегнуло: всю степенность потерял, забегал, засуетился, спрашивает: кто так говорил?"
                            },
                            {
                                "example_id": "25f9f5a0-3823-460c-977f-f7488a5b143d",
                                "sense_id": "9f66d31d-4688-3f25-bded-80ca8e0e3f08",
                                "text": "Это я нарочно пугал, чтобы вас, бестий, подстегнуть."
                            },
                            {
                                "example_id": "872845e4-1913-4cee-8814-874bc78dd05f",
                                "sense_id": "9f66d31d-4688-3f25-bded-80ca8e0e3f08",
                                "text": "Теперь он возмещается при сдаче здания в эксплуатацию, а сейчас поставлен вопрос о том, чтобы подстегнуть инвестиционную деятельность и возмещать его по каждому отчетному периоду, не дожидаясь завершения строительства."
                            }
                        ]
                    },
                    {
                        "sense_id": "b4597982-c321-300a-88be-58c11c406b29",
                        "entry_id": "14f3db62-c67b-3786-a565-131d39558c98",
                        "glosses": [
                            "разг. побудить к более сильному проявлению чего-либо, усилить что-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "860189a5-d1bc-40bf-b7d7-259d7e1a59d2",
                                "sense_id": "b4597982-c321-300a-88be-58c11c406b29",
                                "text": "Воображение, подстегнутое чтением книг, рисовало картины, язык фиксировал их — точно и скупо."
                            }
                        ]
                    }
                ],
