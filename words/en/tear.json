                {
                    "sense_id": "af8cbc81-b6ee-3329-965e-cc0b3e4f2302",
                    "sense_definition": "A spree of boisterous behavior or drinking.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He went on a <w>tear</w> last weekend and spent all his money.",
                            "target_lang_translations": {
                                "ru": "В прошлые выходные он ушел в <w>запой</w> и потратил все свои деньги.",
                                "fr": "Il a fait une <w>virée</w> le week-end dernier et a dépensé tout son argent.",
                                "it": "Ha fatto una <w>furia</w> lo scorso fine settimana e ha speso tutti i suoi soldi.",
                                "cs": "Minulý víkend vyrazil na <w>tah</w> a utratil všechny peníze."
                            }
                        },
                        {
                            "text": "The team has been on a <w>tear</w>, winning ten games in a row.",
                            "target_lang_translations": {
                                "ru": "Команда была <w>в ударе</w>, выиграв десять игр подряд.",
                                "fr": "L'équipe est sur une <w>série</w> incroyable, gagnant dix matchs d'affilée.",
                                "it": "La squadra è in un momento di <w>furia</w> agonistica, avendo vinto dieci partite di fila.",
                                "cs": "Tým je teď <w>v ráži</w>, vyhrál deset zápasů v řadě."
                            }
                        }
                    ],
                    "common_phrases": [
