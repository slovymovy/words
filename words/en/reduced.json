        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "c0463aa1-ad21-3b4e-bfd2-07a44c282afd",
                    "sense_definition": "Discounted in price; costing less than the original amount.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "commercial",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I bought these shoes at a <w>reduced</w> price during the sale.",
                            "target_lang_translations": {
                                "ru": "Я купил эти туфли по <w>сниженной</w> цене во время распродажи.",
                                "zh": "我在打折期间以<w>降价</w>买到了这些鞋子。"
                            }
                        },
                        {
                            "text": "You can find many <w>reduced</w> items in the clearance section.",
                            "target_lang_translations": {
                                "ru": "Вы можете найти много <w>уценённых</w> товаров в отделе распродаж.",
                                "zh": "你可以在清仓区找到许多<w>打折</w>商品。"
                            }
                        }
                    ],
                    "synonyms": [
                        "discounted",
                        "marked down",
                        "on sale",
                        "cheaper",
                        "lowered"
                    ],
                    "antonyms": [
                        "full-price",
                        "expensive"
