                        "glosses": [
                            "The rank, status, position, or dignity of a queen."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "d2dffd1b-9c94-441c-b629-47a84fededbd",
                                "sense_id": "ea9b5b1e-c2a3-37f4-8ce1-0845a289bb09",
                                "text": "Near-synonym: queendom"
                            },
                            {
                                "example_id": "20bf4c49-1ac7-4afc-b659-f9ba855e3f03",
                                "sense_id": "ea9b5b1e-c2a3-37f4-8ce1-0845a289bb09",
                                "text": "In the home-circle and among her companions, Charlotte lays aside her queenship and becomes a gentle Lottie."
                            },
                            {
                                "example_id": "8c7bfd44-c34a-484e-bd0f-7553c2a826f6",
                                "sense_id": "ea9b5b1e-c2a3-37f4-8ce1-0845a289bb09",
                                "text": "Elizabeth's queenship elicited her subjects' fantasies and fears that she was, as Shakespeare's Cleopatra puts it, “no more but e'en a woman,” and that a woman ruling over men would necessarily subject her entire realm to unbridled feminine sexual desire."
                            }
                        ]
