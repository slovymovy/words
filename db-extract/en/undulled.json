                        "glosses": [
                            "Not dulled; sharp or alert."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2acab7c8-0b94-43d4-a6b7-99f85ff00511",
                                "sense_id": "aa06f59e-6c0b-301e-83da-fc9edd2e34cb",
                                "text": "How can we help admiring that open and cheerful brow which, as yet, no care or sin has furrowed; those light and active limbs, full of health and vigour; the eye so quick; the ear so undulled; the memory so ready; the young curiosity so eager to take in new knowledge; the young feelings, not yet spoiled by over-excitement, ready to admire, ready to love?"
                            },
                            {
                                "example_id": "5714b0da-fefb-4fb4-8a73-5d6f18078dce",
                                "sense_id": "aa06f59e-6c0b-301e-83da-fc9edd2e34cb",
                                "text": "In order to keep his intellect undulled by the routine of his dreary work, Matthew Arnold was wont to write a few lines of poetry each day."
                            }
                        ]
                    }
                ],
