        "fr-extract.jsonl": [
            {
                "entry_id": "1c53bd1a-258d-3922-97d5-f2f444722aa8",
                "word": "serinette",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "d23f8746-5adb-4a82-a147-df186c7392d7",
                        "entry_id": "1c53bd1a-258d-3922-97d5-f2f444722aa8",
                        "tags": [
                            "plural"
                        ],
                        "form": "serinettes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "210471f2-a7ef-337b-a88c-b5a187f34ffe",
                        "entry_id": "1c53bd1a-258d-3922-97d5-f2f444722aa8",
                        "glosses": [
                            "Boîte à musique dont on joue par le moyen d’une manivelle, et dont le principal usage est d’instruire les serins et les autres oiseaux chanteurs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "02925c1e-757a-4b0a-bf39-e0be6e0fccfc",
                                "sense_id": "210471f2-a7ef-337b-a88c-b5a187f34ffe",
                                "text": "Noble cœur ! de toi je suis fier,\nTu pouvais, sur ta serinette,\nMe faire chanter un grand air ;\nTu t’en tiens à la chansonnette !"
                            },
                            {
                                "example_id": "005efbc0-0f31-4d9a-a509-5b2e0335e11f",
                                "sense_id": "210471f2-a7ef-337b-a88c-b5a187f34ffe",
                                "text": "Puis des détails furtifs, et si légers ! Un collet d’habit brossé, usé, qui cherche l’ombre, une serinette sans voix tournant à vide sous un porche, un ruban de velours au cou d’une bossue, cruellement noué bien droit entre les épaules contrefaites…"
                            },
                            {
                                "example_id": "9c4a2c85-9962-4613-be89-a71e5a6275a1",
                                "sense_id": "210471f2-a7ef-337b-a88c-b5a187f34ffe",
                                "text": "Son petit front étroit, qu’il aimait tant, était donc vide, vide ! Il n’y avait là-dedans que cette musique de serinette ; et les pensées qui s’y formaient par hasard étaient pareilles à cette musique."
                            },
                            {
                                "example_id": "64beeeb3-e014-474d-842a-c54240eb6743",
                                "sense_id": "210471f2-a7ef-337b-a88c-b5a187f34ffe",
                                "text": "Jusque-là, mademoiselle, amusez-vous à entendre tous les airs de cette serinette, afin que les ignobles dissonances de la contre-partie en ressortent mieux."
                            }
                        ]
                    }
                ],
