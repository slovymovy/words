                    {
                        "sense_id": "9d9a1197-7102-39c3-b744-e789acd709dd",
                        "entry_id": "c5f1bb5c-d477-305c-afb8-36d98b07d3e7",
                        "glosses": [
                            "Of the sky, weather, etc.: the state of being cloudy."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "30519cbd-558e-41c5-b723-505740e0b417",
                                "sense_id": "9d9a1197-7102-39c3-b744-e789acd709dd",
                                "text": "Expect considerable cloudiness with occasional rain showers."
                            },
                            {
                                "example_id": "d6a6ab87-f824-4a9a-9b0d-91b5342c1604",
                                "sense_id": "9d9a1197-7102-39c3-b744-e789acd709dd",
                                "text": "[W]hy vvhat's the matter? / That you haue ſuch a Februarie face, / So full of froſt, of ſtorme, and clovvdineſſe."
                            }
                        ]
                    },
                    {
                        "sense_id": "a8cff1e9-8781-35e8-bf8e-2da0d051bb63",
                        "entry_id": "c5f1bb5c-d477-305c-afb8-36d98b07d3e7",
                        "glosses": [
                            "Of a liquid: the property of being murky."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "0a84abc4-21a5-4cf0-a787-0847f938cdb4",
                                "sense_id": "a8cff1e9-8781-35e8-bf8e-2da0d051bb63",
                                "text": "Cloudiness in the water is most often caused in new aquariums by white bacteria."
                            },
                            {
                                "example_id": "856f7b03-01fb-43de-859e-3ffa2fd77ba8",
                                "sense_id": "a8cff1e9-8781-35e8-bf8e-2da0d051bb63",
                                "text": "The cloudiness of the windows on the cars, caused by the degradation of the polycarbonate material of which they are made."
                            }
                        ]
                    },
                    {
                        "sense_id": "7c5aebc2-0322-336c-82d9-2f8af1017639",
                        "entry_id": "c5f1bb5c-d477-305c-afb8-36d98b07d3e7",
                        "glosses": [
                            "Of information, a writing style, etc.: the property of being obscure."
                        ],
                        "tags": [
                            "countable",
                            "figuratively",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "18a12635-fcac-41fa-9cea-03a7c14d441f",
                                "sense_id": "7c5aebc2-0322-336c-82d9-2f8af1017639",
                                "text": "Avoid cloudiness in your essay-writing."
                            }
                        ]
                    }
