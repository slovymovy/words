                        "sense_id": "2b9db263-e1ba-311f-bec8-a871ebadd1aa",
                        "entry_id": "b7cdfe50-c3f7-3317-9ad5-81246704b443",
                        "glosses": [
                            "Qu’on peut communiquer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "86afa015-ab79-491d-8712-670e51524666",
                                "sense_id": "2b9db263-e1ba-311f-bec8-a871ebadd1aa",
                                "text": "Le dossier de cet accusé n’est pas communicable."
                            },
                            {
                                "example_id": "282de94a-90e3-44fa-8324-f3a471333fb4",
                                "sense_id": "2b9db263-e1ba-311f-bec8-a871ebadd1aa",
                                "text": "Ce travail de mentalisation aide à traduire les excitations liées au traumatisme en représentations communicables, en mettant des mots sur les éprouvés, les images et les émois ressentis, en leur conférant un sens."
                            }
                        ]
                    },
                    {
                        "sense_id": "aa872e09-292b-3bda-8bbd-d2d6ce762585",
                        "entry_id": "b7cdfe50-c3f7-3317-9ad5-81246704b443",
                        "glosses": [
                            "Qu’on peut faire communiquer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "46145bb2-583b-4960-aace-bd6fdec60407",
                                "sense_id": "aa872e09-292b-3bda-8bbd-d2d6ce762585",
                                "text": "Ces deux rivières sont communicables, elles peuvent être jointes par un canal."
                            }
                        ]
                    },
                    {
                        "sense_id": "ba5c10d8-e8b9-3b50-a610-4ad7462c1b7c",
                        "entry_id": "b7cdfe50-c3f7-3317-9ad5-81246704b443",
                        "glosses": [
                            "Qui peut se communiquer."
                        ],
                        "tags": [
