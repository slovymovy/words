                "senses": [
                    {
                        "sense_id": "814b202d-18ae-3373-8fee-5fd801c1a067",
                        "entry_id": "9220fdbd-9afa-398b-821a-0b8b9aaf07ce",
                        "glosses": [
                            "Prinzip, sich (erneut) auf etwas (bereits) Stattgefundenes/Vorgefundenes zu beziehen, zum Beispiel der Prozess der Auswertung der Auswirkung der eigenen Handlung, der dazu führt, dass diese Handlung verändert/angepasst wird"
                        ],
                        "tags": [
                            "Kybernetik"
                        ],
                        "examples": [
                            {
                                "example_id": "8ab41da3-634e-49e6-a952-6cb4622f73e6",
                                "sense_id": "814b202d-18ae-3373-8fee-5fd801c1a067",
                                "text": "„Dieser zweiten Art von Zirkularität wenden wir uns nun zu. Wir nennen sie operationale Zirkularität. Dabei ist zwischen Prozesszirkularität und Operand-Operator-Zirkularität zu unterscheiden.“"
                            },
                            {
                                "example_id": "59e24294-bf7e-478a-9dd5-890b094aadaa",
                                "sense_id": "814b202d-18ae-3373-8fee-5fd801c1a067",
                                "text": "„Die Protophysik ist eine normative Theorie mit dem Ziel, mittels operativer Definition der physikalischen Grundgrößen die Zirkularität analytisch-empirischer Wissenschaftstheorien zu vermeiden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "3f9a39bf-6cd2-324d-a4e3-96a45b6d57c5",
                        "entry_id": "9220fdbd-9afa-398b-821a-0b8b9aaf07ce",
                        "glosses": [
                            "Prinzip, sich nicht nur am Ort der Intervention auszuwirken, sondern auch an anderen Orten im System"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "68c9ad61-b8a3-469f-aa0a-21a131275f5c",
                                "sense_id": "3f9a39bf-6cd2-324d-a4e3-96a45b6d57c5",
                                "text": "„In erster Linie möchte ich verständlich machen, welche Bedeutung die Problematik der Abschließung von Systemen und der basalen Zirkularität für Interventionen in komplexe Systeme in der therapeutischen und beraterischen Arbeit hat.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
