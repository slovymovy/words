                ],
                "senses": [
                    {
                        "sense_id": "34dfa956-f0f2-37ae-b990-d78b1d631aca",
                        "entry_id": "942ee491-154e-363d-94b2-6eee00d3c497",
                        "glosses": [
                            "weibliche Person, die aufgrund ihres häufigen Auftretens und ihrer guten Reputation in ihrem sozialen Netzwerk als marktwirtschaftlich interessante Person, also als Werbeträger, in Frage kommt und so gegen Entgelt eingesetzt werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ebd7a38-c982-44c5-98ee-ed021c0a2570",
                                "sense_id": "34dfa956-f0f2-37ae-b990-d78b1d631aca",
                                "text": "„›Lana Stylz‹, murmelte Lucy andächtig, nachdem Sina und sie sich ein wenig beruhigt hatten. ›Eine der angesagtesten Influenzerinnen.‹“"
                            },
                            {
                                "example_id": "483e7526-70ef-4244-9d75-fff87c9056aa",
                                "sense_id": "34dfa956-f0f2-37ae-b990-d78b1d631aca",
                                "text": "„Seit die Influenzerin Maggy diesen Haarschnitt hat, ist er total beliebt bei allen Mädels.“"
                            },
                            {
                                "example_id": "86919df6-f2ca-4f25-8143-79f59ed0fd52",
                                "sense_id": "34dfa956-f0f2-37ae-b990-d78b1d631aca",
                                "text": "„ROSE, Lana (geb. 1989) ist ein Pseudonym für ihre Tätigkeit als Influenzerin in den Sozialen Medien.“"
                            },
                            {
                                "example_id": "69f7256e-d36d-4a37-bb36-2596c0e4ded9",
                                "sense_id": "34dfa956-f0f2-37ae-b990-d78b1d631aca",
                                "text": "„Krisitina Tolode, 24, ist Modell und Influenzerin aus Brooklyn und bevorzugt einen auffälligen Stil.“"
                            },
                            {
                                "example_id": "dabeb7ef-1b25-478f-8e7e-b1b55f1ee841",
                                "sense_id": "34dfa956-f0f2-37ae-b990-d78b1d631aca",
                                "text": "„Der Präsident war vom ‚Talent‘ der blonden Influenzerin begeistert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
