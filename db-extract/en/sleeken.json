                    {
                        "sense_id": "db1afb0f-3989-3dca-a2e0-00d928bf4b71",
                        "entry_id": "bd917ddb-9363-3ba1-9af7-e2475ac52d19",
                        "glosses": [
                            "To make or become sleek."
                        ],
                        "tags": [
                            "ambitransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "711fad27-faf9-4af7-97d1-5e17eeff545a",
                                "sense_id": "db1afb0f-3989-3dca-a2e0-00d928bf4b71",
                                "text": "Now I have had my gird at thee, my servant, I must tell thee that in sooth it is not all for nothing that thou hast had these months of rest; for verily thou hast grown more of a woman thereby, and hast sleekened and rounded much."
                            },
                            {
                                "example_id": "3e222237-9724-4f05-b06d-09f60e7b9a44",
                                "sense_id": "db1afb0f-3989-3dca-a2e0-00d928bf4b71",
                                "text": "He tried to imagine them sleekened and breasted, not just the daughters of peasants such as he had known when he was young and a peasant himself but succubi of the sort he had once resisted in the night, and he felt nothing."
                            }
                        ]
                    }
