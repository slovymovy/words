                    {
                        "translation_id": "a9d5a8a2-11e1-4803-ab7d-83a992eb6cc9",
                        "source_entry_id": "c0b283b9-b555-3248-99a5-9ad5859f2b7d",
                        "source_sense_description": "that which is immolated",
                        "target_lang_word": "Opfer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Opfer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f183a35f-9198-3503-96ba-0e24c7df930b",
                                        "entry_id": "e94978af-ebc4-307a-b536-944fe748aa4d",
                                        "glosses": [
                                            "meist rituelle Gabe an einen Gott"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c74d6e5f-5577-4fc6-8958-f9df837584e2",
                                                "sense_id": "f183a35f-9198-3503-96ba-0e24c7df930b",
                                                "text": "Die Opfer, die in der Antike den Göttern dargebracht wurden, bestanden häufig aus Lebensmitteln oder Getränken."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3a2a1186-9dc1-3ce3-93b3-d74103637a23",
                                        "entry_id": "e94978af-ebc4-307a-b536-944fe748aa4d",
                                        "glosses": [
                                            "etwas, das man abgibt oder spendet, so dass man selbst darauf verzichten muss"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2987c45e-5140-4c09-b009-78e95bbbfebf",
                                                "sense_id": "3a2a1186-9dc1-3ce3-93b3-d74103637a23",
                                                "text": "Auf die Rechte an seinen frühen Werken zu verzichten, war für den Künstler ein geringes Opfer."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "8bc39785-c514-3dd9-aaaa-6e9232115c13",
                                        "entry_id": "e94978af-ebc4-307a-b536-944fe748aa4d",
                                        "glosses": [
                                            "jemand, der durch etwas Schaden erlitten hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "978b3f24-99e7-4ece-88f3-e4f6687e1710",
                                                "sense_id": "8bc39785-c514-3dd9-aaaa-6e9232115c13",
                                                "text": "Zu den bizarren Pointen der furchtbaren Terrorserie in Frankreich zählt aber auch die Tatsache, dass Muslime nicht nur Täter und Opfer, sondern auch Helden geworden sind. Am Mittwoch war es der Polizist Ahmed Merabet, ein 42-jähriger muslimischer Familienvater, den die terroristischen Kouachi-Brüder brutal ermordeten."
                                            },
                                            {
                                                "example_id": "6bdf763e-8d2d-4a13-8488-1be61c195b89",
                                                "sense_id": "8bc39785-c514-3dd9-aaaa-6e9232115c13",
                                                "text": "Er sucht sich seine Opfer gezielt aus."
                                            },
                                            {
                                                "example_id": "83d88318-f071-43c3-bab9-f8c644b06348",
                                                "sense_id": "8bc39785-c514-3dd9-aaaa-6e9232115c13",
                                                "text": "„Meine Großeltern und meine Urgroßmutter hatten schon 1930 ihre Heimat verlassen müssen, als immer mehr Muslime Opfer der Gewalt serbischer Nationalisten wurden.“"
                                            },
                                            {
                                                "example_id": "b6ab2dd8-87c8-499d-945c-bfffbffd2f36",
                                                "sense_id": "8bc39785-c514-3dd9-aaaa-6e9232115c13",
                                                "text": "„Die sichtbare Verwüstung schließe die Opfer der radioaktiven Verstrahlung nicht ein.“"
                                            },
                                            {
                                                "example_id": "76d76632-4745-451a-a9a8-e82844fcd4e4",
                                                "sense_id": "8bc39785-c514-3dd9-aaaa-6e9232115c13",
                                                "text": "„Während eine Reihe Frauen und Mädchen Opfer von Massenvergewaltigungen werden, hat Agathe zuerst noch Glück.“"
                                            },
                                            {
                                                "example_id": "3f1a3b4e-d0fb-4546-9ea3-5da40075e0fe",
                                                "sense_id": "8bc39785-c514-3dd9-aaaa-6e9232115c13",
                                                "text": "„Ich kenne kein anderes Volk, das im täglichen Umgang miteinander so wenig großzügig ist wie sie, so überzeugt, dass man sie ständig übervorteilen will, dass es anderen immer besser geht und dass sie selbst eigentlich das Opfer sind.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "c3cfb39b-8c9a-3109-9974-b679d4390dbf",
                                        "entry_id": "e94978af-ebc4-307a-b536-944fe748aa4d",
                                        "glosses": [
                                            "die freiwillige Hergabe eines Bauern oder einer Figur in der Erwartung, dadurch einen andersartigen (eventuell größeren) Vorteil zu erreichen (Kompensation erlangen)"
                                        ],
                                        "tags": [
                                            "Schach"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8cf686e1-ec90-48ed-bafa-a9a816b310c8",
                                                "sense_id": "c3cfb39b-8c9a-3109-9974-b679d4390dbf",
                                                "text": "Nach der Inkaufnahme des Opfers konnte Weiß nur noch wenige Züge machen, dann war er matt."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "74b2635e-e11a-3777-8f6a-bb0c582eb61a",
                                        "entry_id": "e94978af-ebc4-307a-b536-944fe748aa4d",
                                        "glosses": [
                                            "angelehnt an [3], jemand, der schwach, dumm oder unterlegen ist"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d8ceedba-a77c-41d9-a29c-eb87d96a7ec8",
                                                "sense_id": "74b2635e-e11a-3777-8f6a-bb0c582eb61a",
                                                "text": "Oh, du Opfer!"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5933ce84-7b63-40fa-a2bc-edae2a718899",
                        "source_entry_id": "c0b283b9-b555-3248-99a5-9ad5859f2b7d",
                        "source_sense_description": "that which is immolated",
                        "target_lang_word": "же́ртва",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "же́ртва",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "42e6d5d2-a71c-3c24-9602-23c0b3c3beec",
                                        "entry_id": "04ef4c04-5eb9-3028-8d94-0caf7e1fb5bc",
                                        "glosses": [
                                            "истор. предмет или живое существо (как правило убиваемое), приносимое в дар божеству во время жертвоприношения в обрядах некоторых религий"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "01bfa0f8-90b4-4ddc-91f0-b0ebea5a74a1",
                                                "sense_id": "42e6d5d2-a71c-3c24-9602-23c0b3c3beec",
                                                "text": "Обыкновенно в пятой луне, по окончании полевых работ, приносят жертву духам."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9f7b5539-6d72-38fd-b136-3d036c09e4f0",
                                        "entry_id": "04ef4c04-5eb9-3028-8d94-0caf7e1fb5bc",
                                        "glosses": [
                                            "устар. добровольный вклад в виде денег или каких-либо предметов в интересах кого-либо, чего-либо; пожертвование"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b9fa21f-754b-4ea6-a5b5-2db5a08e2d14",
                                                "sense_id": "9f7b5539-6d72-38fd-b136-3d036c09e4f0",
                                                "text": "Такие жертвы происходят как епитимии, добровольно на себя почему-либо наложенные, и непременно из денег, собственным трудом добытых."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bc8fa64f-5b4d-3111-b588-8efa1ff161a8",
                                        "entry_id": "04ef4c04-5eb9-3028-8d94-0caf7e1fb5bc",
                                        "glosses": [
                                            "самопожертвование; добровольный отказ, отречение в пользу кого- или чего-нибудь"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a7d3f698-ade1-4206-a4a0-182ed9431b20",
                                                "sense_id": "bc8fa64f-5b4d-3111-b588-8efa1ff161a8",
                                                "text": "Я готов на все жертвы, кроме этой; двадцать раз жизнь свою, даже честь поставлю на карту… но свободы моей не продам."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dd0939c3-b368-3a9c-99a0-cf5cf52eb048",
                                        "entry_id": "04ef4c04-5eb9-3028-8d94-0caf7e1fb5bc",
                                        "glosses": [
                                            "одуш. человек, пострадавший или погибший от нападения кого-либо, в результате стихийного бедствия, несчастного случая, военных или преступных действий, подвергшийся насилию со стороны кого-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1dbfea93-0041-4f5e-a4d9-f631ce22a003",
                                                "sense_id": "dd0939c3-b368-3a9c-99a0-cf5cf52eb048",
                                                "text": "В городском морге проходит процедура опознания жертв ДТП."
                                            },
                                            {
                                                "example_id": "e374a13e-7457-4ae8-8fd4-413907cfc77c",
                                                "sense_id": "dd0939c3-b368-3a9c-99a0-cf5cf52eb048",
                                                "text": "Убийца хладнокровно умертвил свою жертву."
                                            },
                                            {
                                                "example_id": "ef8b262b-adee-4123-abb8-9e0c32c91eaf",
                                                "sense_id": "dd0939c3-b368-3a9c-99a0-cf5cf52eb048",
                                                "text": "Жертвы мошенников обратились в милицию."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5e9bcb69-35fc-3986-8811-5e37a2dd82bb",
                                        "entry_id": "04ef4c04-5eb9-3028-8d94-0caf7e1fb5bc",
                                        "glosses": [
                                            "одуш. особь, подвергающаяся прямому нападению со стороны хищника"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46e59594-29ba-411e-9205-b198ec4b9685",
                                                "sense_id": "5e9bcb69-35fc-3986-8811-5e37a2dd82bb",
                                                "text": "Громкий предсмертный крик бедной жертвы не спасает её от когтей хищника, который спускается тотчас же на землю и начинает терзать свою добычу."
                                            },
                                            {
                                                "example_id": "2737c603-99f9-42eb-a094-c30f7d003121",
                                                "sense_id": "5e9bcb69-35fc-3986-8811-5e37a2dd82bb",
                                                "text": "Разъярённый лев в следующую секунду набросился на свою жертву."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dab5edf5-27ae-3cfb-b530-73e318ff8092",
                                        "entry_id": "04ef4c04-5eb9-3028-8d94-0caf7e1fb5bc",
                                        "glosses": [
                                            "одуш. человек, пострадавший или погибший во имя чего-либо, вследствие преданности чему-либо, кому-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6617c8d0-b233-4feb-b490-d81a8a812e52",
                                                "sense_id": "dab5edf5-27ae-3cfb-b530-73e318ff8092",
                                                "text": "Прежде он думал, что он, русский человек, — жертва интриг, несправедливостей, притеснений, жертва людской неблагодарности, жадности, бедности, и был твёрдо уверен, что освободись он хоть на одну минуту от всех вышеупомянутых бед, так сейчас же, сию минуту, все увидят, как он добр, благороден, великодушен, вежлив, щедр, непоколебим и честен…"
                                            },
                                            {
                                                "example_id": "9b401fe2-c18e-4439-8558-9c3f1776cb62",
                                                "sense_id": "dab5edf5-27ae-3cfb-b530-73e318ff8092",
                                                "text": "Не исключаю, что он стал жертвой своего окружения."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
