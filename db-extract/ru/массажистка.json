                    {
                        "sense_id": "e5bcf8c2-7a80-366b-bc63-79ba53f80244",
                        "entry_id": "88b15d8a-2972-31f7-b48f-84536169ea86",
                        "glosses": [
                            "женск. к массажист; специалистка по массажу"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d3166c8-4978-4482-bd6f-2b6f22337079",
                                "sense_id": "e5bcf8c2-7a80-366b-bc63-79ba53f80244",
                                "text": "Массажистка посмотрела на пациента, ушла в другой кабинет, принесла банку и плюхнула ее на массажный стол перед Васиным носом."
                            },
                            {
                                "example_id": "5446f282-0628-4fc8-81ba-214e786f0647",
                                "sense_id": "e5bcf8c2-7a80-366b-bc63-79ba53f80244",
                                "text": "Я ходила на массаж с другой проблемой и как-то, к слову, сказала массажистке про аппетит."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d021a1b2-8bc2-401a-8081-10301817e0ab",
                        "source_entry_id": "88b15d8a-2972-31f7-b48f-84536169ea86",
                        "source_sense_id": "e5bcf8c2-7a80-366b-bc63-79ba53f80244",
                        "target_lang_word": "masseuse",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "masseuse",
