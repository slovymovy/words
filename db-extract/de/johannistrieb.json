                "senses": [
                    {
                        "sense_id": "aebc6176-6dae-3fa0-aaac-4d96995687d6",
                        "entry_id": "4e99728a-0883-351c-a228-24f9002cb94d",
                        "glosses": [
                            "Bezeichnung für den zweiten Trieb (Buchen, Eichen, …) im Sommer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fecc490e-8c1b-42d3-ba43-ee0d604f25c1",
                                "sense_id": "aebc6176-6dae-3fa0-aaac-4d96995687d6",
                                "text": "„Auch im Obstbau spielt der Johannistag eine Rolle: Der Johannistrieb ist der zweite Austrieb von Laubgehölzen um Mittsommer.“"
                            },
                            {
                                "example_id": "cfb8a92b-2cd2-4fda-acc1-6162fe6b8891",
                                "sense_id": "aebc6176-6dae-3fa0-aaac-4d96995687d6",
                                "text": "„Der Johannistrieb dauert bei schwach und mäßig wachsenden Bäumen nur kurze Zeit, bei stark wachsenden kann er ununterbrochen bis gegen den Herbst hin andauern.“"
                            },
                            {
                                "example_id": "5bc9a982-ecb3-4060-9935-464005ccdbad",
                                "sense_id": "aebc6176-6dae-3fa0-aaac-4d96995687d6",
                                "text": "„Mit dem »Johannistrieb« haben Sträucher wie Kirschlorbeer oder Liguster einzelne, noch einmal 10–20 cm lange Triebe entwickelt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "53f145fa-ac5e-3c80-99bb-be0a5d5731ec",
                        "entry_id": "4e99728a-0883-351c-a228-24f9002cb94d",
                        "glosses": [
                            "übersteigerter Sexualtrieb älterer Männer und Frauen"
                        ],
                        "tags": [
                            "Sexualität"
                        ],
                        "examples": [
                            {
                                "example_id": "f8495e80-971a-43f6-bf0d-6c4091493779",
                                "sense_id": "53f145fa-ac5e-3c80-99bb-be0a5d5731ec",
                                "text": "Der alte Lüstling kann nicht genug bekommen, den lässt sei Johannistrieb auch nicht in Ruhe. Kein Rock eines Dienstmädchens ist vor ihm sicher."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
