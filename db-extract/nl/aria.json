                "senses": [
                    {
                        "sense_id": "3051670d-2bd4-3b30-812d-b73772be7222",
                        "entry_id": "8885b0b5-dd13-3bef-b193-0917681c4c1a",
                        "glosses": [
                            "een solo voor een zanger of zangeres binnen een opera"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6dfa7853-0aee-4204-9d44-e34e0657548c",
                                "sense_id": "3051670d-2bd4-3b30-812d-b73772be7222",
                                "text": "Zij zong een prachtige aria."
                            },
                            {
                                "example_id": "786a8baf-afc7-49ee-b524-7aa2782d1263",
                                "sense_id": "3051670d-2bd4-3b30-812d-b73772be7222",
                                "text": "Je stem. Je stem is niet wat ik van de week hoorde. Het was prachtig. Je zong die aria.' Ik probeerde het thema te neuriën."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f537b20a-4a28-40a1-89ee-1b6fc95cb1b8",
                        "source_entry_id": "8885b0b5-dd13-3bef-b193-0917681c4c1a",
                        "source_sense_id": "3051670d-2bd4-3b30-812d-b73772be7222",
                        "target_lang_word": "Arie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Arie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b1e29878-042c-3deb-858f-eba3339030ec",
                                        "entry_id": "bd9fd323-d23e-38de-aed3-8bf47288c141",
                                        "glosses": [
                                            "solistisch vorgetragenes Gesangsstück, das üblicherweise von einem Orchester begleitet wird"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "382fcc83-c1fa-4a16-97ca-f74f80803d4a",
                                                "sense_id": "b1e29878-042c-3deb-858f-eba3339030ec",
                                                "text": "In der Regel ist eine Arie Teil eines größeren Werkes wie einer Oper, einer Kantate oder eines Oratoriums."
                                            },
                                            {
                                                "example_id": "c7856749-ba2e-4101-acb7-1ca6de6ee559",
                                                "sense_id": "b1e29878-042c-3deb-858f-eba3339030ec",
                                                "text": "„Bald fühlte sie sich versucht, selbst auf die Bühne zu stürzen und die Arie zu singen, welche die Sängerin gerade vortrug, bald hatte sie Lust, einem unweit von ihr sitzenden alten Herrn mit dem Fächer auf den Kopf zu tippen oder sich zu Hélène hinüberzubeugen und sie zu kitzeln.“"
                                            },
                                            {
                                                "example_id": "830d995c-ee4e-4cf6-b9d0-87509f043846",
                                                "sense_id": "b1e29878-042c-3deb-858f-eba3339030ec",
                                                "text": "„Sie dankte ihm für die Partitur und bat ihn, ihr noch einige andere Arien zu besorgen.“"
                                            },
                                            {
                                                "example_id": "797ba34c-85de-44c2-bc1c-6db3727bbff4",
                                                "sense_id": "b1e29878-042c-3deb-858f-eba3339030ec",
                                                "text": "„Ein Sänger singt bei einem Agenten eine Arie vor.“"
                                            },
                                            {
                                                "example_id": "c12055ea-ecdc-465a-9ef3-8abcd94df5a5",
                                                "sense_id": "b1e29878-042c-3deb-858f-eba3339030ec",
                                                "text": "„Weitere Gedanken zu Arie und Rezitativ folgen, denn auf die ist Wielands Singspielkonzept eingeschränkt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "86a7fc45-3154-478b-87d2-0fe6c45cd68c",
                        "source_entry_id": "8885b0b5-dd13-3bef-b193-0917681c4c1a",
                        "source_sense_id": "3051670d-2bd4-3b30-812d-b73772be7222",
                        "target_lang_word": "aria",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aria",
