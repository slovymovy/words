                "translations": [
                    {
                        "translation_id": "a6d09659-e9c2-4c89-9762-0f2aa7d73cea",
                        "source_entry_id": "c7734e4e-a7c3-3947-a30f-21faf40a059f",
                        "source_sense_id": "8c98e5fc-8ca6-3e9a-a334-b39526c9cda4",
                        "target_lang_word": "Ausweglosigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ausweglosigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a9a0625f-42a6-3975-8a2e-b6f1ae90729d",
                                        "entry_id": "cb3f5a9f-aaba-38c6-947d-89832ddaefac",
                                        "glosses": [
                                            "Problemsituation, in der es keine (sichtbaren) Lösungen gibt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a84bc2b4-cb4e-42c0-84ce-e56c43d5725c",
                                                "sense_id": "a9a0625f-42a6-3975-8a2e-b6f1ae90729d",
                                                "text": "Langsam wurde ihr die Ausweglosigkeit ihrer Lage bewusst."
                                            },
                                            {
                                                "example_id": "5b4f8461-fc47-4651-b7ea-2ad9ca4a79f6",
                                                "sense_id": "a9a0625f-42a6-3975-8a2e-b6f1ae90729d",
                                                "text": "„Es ist der einzige Weg aus der Ausweglosigkeit, der uns noch bleibt.“"
                                            },
                                            {
                                                "example_id": "ccafafec-6e02-46ac-b3af-219aec659389",
                                                "sense_id": "a9a0625f-42a6-3975-8a2e-b6f1ae90729d",
                                                "text": "„Der alte Mann fasst sich kurz, weil er keine Geduld hat zu langem Gerede, der Grund dafür ist jedoch weniger der mürrische Charakter, den er an den Tag legt, als die Ausweglosigkeit, in die sein gescheiterter Lebensentwurf ihn gebracht hat.“"
                                            },
                                            {
                                                "example_id": "1e402122-fd1c-4de3-a1c6-718d72da3783",
                                                "sense_id": "a9a0625f-42a6-3975-8a2e-b6f1ae90729d",
                                                "text": "„Die beiden hatten seine einsame Ausweglosigkeit beendet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
