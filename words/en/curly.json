{
    "word_family": [
        "curl",
        "curler",
        "curliness",
        "uncurled"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "aa1f4768-088e-3d90-b8b8-fd85a9904f76",
                    "sense_definition": "Having a twisted, ringlet, or spiral shape, especially referring to hair.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "physical_appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She has beautiful <w>curly</w> hair that bounces when she walks.",
                            "target_lang_translations": {
                                "ru": "У неё прекрасные <w>кудрявые</w> волосы, которые подпрыгивают при ходьбе."
                            }
                        },
                        {
                            "text": "The little girl has <w>curly</w> locks of gold hair.",
                            "target_lang_translations": {
                                "ru": "У маленькой девочки <w>кудрявые</w> золотистые локоны."
                            }
                        }
                    ],
                    "synonyms": [
                        "wavy",
                        "frizzy",
                        "coiled"
                    ],
                    "antonyms": [
                        "straight"
                    ],
                    "common_phrases": [
                        "curly hair",
                        "curly locks",
                        "naturally curly"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий форму спирали, колец или завитков, чаще всего о волосах."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кудрявый",
                                "target_lang_sense_clarification": "о волосах или человеке"
                            },
                            {
                                "target_lang_word": "вьющийся",
                                "target_lang_sense_clarification": "о волосах или растениях"
                            },
                            {
                                "target_lang_word": "курчавый",
                                "target_lang_sense_clarification": "с мелкими завитками"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ee255f10-cb84-3592-bd17-d92128454617",
                    "sense_definition": "Curved or rounded in shape rather than straight, often used to describe punctuation like quotes.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "shape",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should use <w>curly</w> quotes instead of straight ones for professional typesetting.",
                            "target_lang_translations": {
                                "ru": "Для профессиональной верстки следует использовать <w>закругленные</w> кавычки вместо прямых."
                            }
                        },
                        {
                            "text": "The programmer used <w>curly</w> brackets to define the block of code.",
                            "target_lang_translations": {
                                "ru": "Программист использовал <w>фигурные</w> скобки для определения блока кода."
                            }
                        }
                    ],
                    "synonyms": [
                        "curved",
                        "rounded"
                    ],
                    "antonyms": [
                        "straight"
                    ],
                    "common_phrases": [
                        "curly quotes",
                        "curly brackets",
                        "curly braces"
                    ],
                    "target_lang_definitions": {
                        "ru": "Изогнутый или округлый по форме, часто используется для описания знаков препинания."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фигурный",
                                "target_lang_sense_clarification": "о скобках"
                            },
                            {
                                "target_lang_word": "изогнутый",
                                "target_lang_sense_clarification": "о форме"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "864fc2e1-45d8-3356-abe3-4e40022ceafc",
                    "sense_definition": "Complicated, difficult to solve, or knotty.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "difficulty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The manager threw us a <w>curly</w> question during the meeting that no one could answer.",
                            "target_lang_translations": {
                                "ru": "Во время встречи менеджер задал нам <w>каверзный</w> вопрос, на который никто не смог ответить."
                            }
                        },
                        {
                            "text": "Often the job will throw you a <w>curly</w> problem that will cause the unprepared to fail.",
                            "target_lang_translations": {
                                "ru": "Часто работа подбрасывает <w>заковыристую</w> проблему, на которой неподготовленные терпят неудачу."
                            }
                        }
                    ],
                    "synonyms": [
                        "tricky",
                        "knotty",
                        "complex"
                    ],
                    "antonyms": [
                        "simple",
                        "straightforward"
                    ],
                    "common_phrases": [
                        "curly problem",
                        "curly question"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Mainly used in Australian and New Zealand English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сложный, каверзный или трудноразрешимый."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "каверзный",
                                "target_lang_sense_clarification": "о вопросе или проблеме"
                            },
                            {
                                "target_lang_word": "заковыристый",
                                "target_lang_sense_clarification": "сложный для понимания"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "c09b4c23-a672-33e7-b08e-71cfd38badf2",
                    "sense_definition": "A male given name or a common nickname.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "names",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Everyone in the neighborhood knows <w>Curly</w> because of his friendly nature.",
                            "target_lang_translations": {
                                "ru": "Все в округе знают <w>Кёрли</w> благодаря его дружелюбному характеру."
                            }
                        },
                        {
                            "text": "The most famous member of the comedy group was named <w>Curly</w> Howard.",
                            "target_lang_translations": {
                                "ru": "Самого известного участника комедийной группы звали <w>Кёрли</w> Ховард."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Мужское имя или распространенное прозвище."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Кёрли",
                                "target_lang_sense_clarification": "транслитерация имени"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9d6da0ad-0a9e-33db-80c1-350e0c588ac0",
                    "sense_definition": "A nickname specifically given to a person who has hair with curls.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "names",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Hey <w>Curly</w>, where did you get those amazing ringlets?",
                            "target_lang_translations": {
                                "ru": "Эй, <w>Кудряш</w>, откуда у тебя такие потрясающие локоны?"
                            }
                        },
                        {
                            "text": "His friends called him <w>Curly</w> since he was a toddler with wavy hair.",
                            "target_lang_translations": {
                                "ru": "Друзья звали его <w>Кудрявым</w> с тех пор, как он был малышом с волнистыми волосами."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used as a descriptive nickname"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прозвище, даваемое человеку с кудрявыми волосами."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Кудряш",
                                "target_lang_sense_clarification": "ласковое прозвище"
                            },
                            {
                                "target_lang_word": "Кудрявый",
                                "target_lang_sense_clarification": "описательное прозвище"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "408e0354-48e5-3699-95c9-ce9538a3fae1",
                    "sense_definition": "An ironic nickname given to a person who is bald.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "names",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "It was a joke among the sailors to call the bald captain <w>Curly</w>.",
                            "target_lang_translations": {
                                "ru": "Среди моряков было шуткой называть лысого капитана <w>Кудрявым</w>."
                            }
                        },
                        {
                            "text": "Despite having no hair at all, his mates still called him <w>Curly</w>.",
                            "target_lang_translations": {
                                "ru": "Несмотря на полное отсутствие волос, приятели всё равно звали его <w>Кудрявым</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used ironically"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ироничное прозвище, которое дают лысому человеку."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Кудрявый",
                                "target_lang_sense_clarification": "иронично о лысом"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "661f88e9-ccf8-34d8-aba0-b7bd815e3e1b",
                    "sense_definition": "A person or an animal that has hair with curls.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "beings",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The little <w>curly</w> in the front row stood up to speak.",
                            "target_lang_translations": {
                                "ru": "Маленький <w>кудряш</w> в первом ряду встал, чтобы что-то сказать."
                            }
                        },
                        {
                            "text": "That dog is a real <w>curly</w> with all those tight spirals in its fur.",
                            "target_lang_translations": {
                                "ru": "Эта собака — настоящий <w>кудряш</w> со всеми этими тугими спиральками в шерсти."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Informal way to refer to someone by their hair type"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек или животное с кудрявой шерстью или волосами."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кудряш",
                                "target_lang_sense_clarification": "о человеке"
                            },
                            {
                                "target_lang_word": "кудряшка",
                                "target_lang_sense_clarification": "о ребенке или девушке"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}