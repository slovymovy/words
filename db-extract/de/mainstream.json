                "senses": [
                    {
                        "sense_id": "884e0015-c172-3ae1-9346-58070ff2f41a",
                        "entry_id": "ab4d1d85-f7fd-3a22-b8dc-a3915cfde20d",
                        "glosses": [
                            "Courant de pensée dominant, discours ambiant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c70fa13-8072-4725-837d-825a32f32f94",
                                "sense_id": "884e0015-c172-3ae1-9346-58070ff2f41a",
                                "text": "Nachdem der Klimaschutz zwischen 2018 und 2020 erstmals im Mainstream angekommen war – in Politik und bei den Bürgerinnen und Bürgern – nimmt die Aufmerksamkeit für das Thema mittlerweile wieder spürbar ab."
                            }
                        ]
                    }
