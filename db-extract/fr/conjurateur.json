                    },
                    {
                        "form_id": "330a9b34-b7e9-4486-b022-2fbb92980563",
                        "entry_id": "07ff1c69-a098-3576-8df6-ddb36ecee346",
                        "tags": [
                            "singular",
                            "feminine"
                        ],
                        "form": "conjuratrice"
                    },
                    {
                        "form_id": "840b6000-35a9-4476-af7c-ad99bf69c027",
                        "entry_id": "07ff1c69-a098-3576-8df6-ddb36ecee346",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "conjuratrices"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5cc16b58-1a98-3450-9ceb-f09f0c8cde6a",
                        "entry_id": "07ff1c69-a098-3576-8df6-ddb36ecee346",
                        "glosses": [
                            "Qui possède ou est censé posséder le pouvoir de conjurer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5d3a280-52f4-4a23-8fa3-ebe0826d6926",
                                "sense_id": "5cc16b58-1a98-3450-9ceb-f09f0c8cde6a",
                                "text": "Voix conjuratrice."
                            },
                            {
                                "example_id": "2b01ff22-3ddb-4fc8-b911-88f74c54c953",
                                "sense_id": "5cc16b58-1a98-3450-9ceb-f09f0c8cde6a",
                                "text": "Fétiches conjurateurs."
                            },
                            {
                                "example_id": "f9cb0ae2-469e-4c80-b498-b448094f1946",
                                "sense_id": "5cc16b58-1a98-3450-9ceb-f09f0c8cde6a",
                                "text": "Elle trouvait à ces coups de baguette un air conjurateur de fort mauvais augure, elle aurait voulu les murs moins hauts, les pièces moins grandes, et n’osait questionner le jeune homme sur les effets de cette sorcellerie."
                            },
                            {
                                "example_id": "2955dfe6-f0de-45d6-9f58-11762af1e45f",
                                "sense_id": "5cc16b58-1a98-3450-9ceb-f09f0c8cde6a",
                                "text": "J’anticipe de quelques jours sur l’histoire ; j’expose une vérité dont nous tâchons en vain d’arrêter le dégagement ; j’écris le préambule de notre future constitution. Ce serait le fer conjurateur de foudre que cette définition qui nous paraît blasphématoire, la propriété, c’est le vol, si nos préoccupations nous permettaient de l’entendre ; mais que d’intérêts, que de préjugés s’y opposent !…"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "a0d9cc60-ba44-3fce-8627-467d2bd7681d",
                "word": "conjurateur",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "a271e7a5-8bf6-4616-a1cf-a02e61aefde5",
                        "entry_id": "a0d9cc60-ba44-3fce-8627-467d2bd7681d",
                        "tags": [
                            "plural"
                        ],
                        "form": "conjurateurs"
                    },
                    {
                        "form_id": "5ccdd0e0-7e0f-4232-b979-01e83b2beb67",
                        "entry_id": "a0d9cc60-ba44-3fce-8627-467d2bd7681d",
                        "tags": [
                            "feminine"
                        ],
                        "form": "conjuratrice"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "afe44487-00fa-330a-a749-a8430a8df608",
                        "entry_id": "a0d9cc60-ba44-3fce-8627-467d2bd7681d",
                        "glosses": [
                            "Celui qui attestait sous serment avec d’autres la vérité de l’allégation d’une des parties."
                        ],
                        "tags": [
                            "Sens étymologique"
                        ],
                        "examples": [
                            {
                                "example_id": "d2a1a356-bd7a-438f-ab6c-41868316ff57",
                                "sense_id": "afe44487-00fa-330a-a749-a8430a8df608",
                                "text": "Prouver, se purger par conjurateurs."
                            },
                            {
                                "example_id": "34e05f90-4b7e-429f-a67f-e477391fba2f",
                                "sense_id": "afe44487-00fa-330a-a749-a8430a8df608",
                                "text": "Il y avait habituellement douze conjurateurs."
                            }
                        ]
                    },
                    {
                        "sense_id": "2e8923da-52f9-30b0-b484-26b641392f07",
                        "entry_id": "a0d9cc60-ba44-3fce-8627-467d2bd7681d",
                        "glosses": [
                            "Magicien qui conjure les démons et les tempêtes, exorciste."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "497f1133-6935-403d-a651-a73b965e1f8f",
                                "sense_id": "2e8923da-52f9-30b0-b484-26b641392f07",
                                "text": "Dès l’heure même on vous met en preſence\nNôtre Demon & ſon Conjurateur."
                            },
                            {
                                "example_id": "88a9db4a-3944-49b4-92af-29046a5be517",
                                "sense_id": "2e8923da-52f9-30b0-b484-26b641392f07",
                                "text": "Beaucoup de derviches des ordres inférieurs gagnent leur vie en faisant des espèces d’exorcismes autour des maisons pour en écarter les serpents […] Le conjurateur prétend découvrir sans le secours de la vue s’il y a des serpents ; et lorsqu’il y en a, il affirme pouvoir les attirer à lui par la seule fascination de la voix."
                            }
                        ]
                    },
                    {
                        "sense_id": "515431b5-095b-3b0d-87f3-66575513d2a9",
                        "entry_id": "a0d9cc60-ba44-3fce-8627-467d2bd7681d",
                        "glosses": [
                            "Celui qui forme, dirige une conjuration, conjuré."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b489da58-9ef7-42b7-899e-ad8961350b1f",
                                "sense_id": "515431b5-095b-3b0d-87f3-66575513d2a9",
                                "text": "Interrompu par les approbations bruyantes de la foule au moment où du haut de l’estrade il jetait un regard écrasant de dédain sur les conjurateurs, qui, rangés en bas autour de la balustrade, avaient baissé la tête et n’osaient plus sourire de pitié."
                            },
                            {
                                "example_id": "582b1560-da11-4d88-9a93-d717a7e1c732",
                                "sense_id": "515431b5-095b-3b0d-87f3-66575513d2a9",
                                "text": "– Pas des conjurés, mais des conjurateurs. J’en ai rencontré un certain nombre. Par hasard. Personne n’en parle. Ils essaient, dans leur coin, de conjurer tout ce que des gens comme toi racontent à longueur de journée dans leur canard."
                            }
                        ]
                    },
                    {
                        "sense_id": "04ecc5a5-9907-3766-9c09-e75627e8c565",
                        "entry_id": "a0d9cc60-ba44-3fce-8627-467d2bd7681d",
                        "glosses": [
                            "Conspirateur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d2f0a967-38c0-403a-b67f-d50061c594b3",
                                "sense_id": "04ecc5a5-9907-3766-9c09-e75627e8c565",
                                "text": "Ils […] somnolaient après leur repas, ou bien dans une embrasure de fenêtre s’entretenaient à trois ou quatre avec des mines de conjurateurs."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "53cb36b9-1cf3-46f6-8a55-88b70741451c",
                        "source_entry_id": "a0d9cc60-ba44-3fce-8627-467d2bd7681d",
                        "source_sense_description": "personne qui conjure un sort",
                        "target_lang_word": "conjurer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "conjurer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "80e1c333-ff9b-32f7-af55-f2a2f5a99ab0",
                                        "entry_id": "7f4a7ba2-eb6b-36fc-9370-54dc259bb36e",
                                        "glosses": [
                                            "One who conjures, a magician."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae34c2c7-cc56-4dd5-a262-398ea8e6a0f2",
                                                "sense_id": "80e1c333-ff9b-32f7-af55-f2a2f5a99ab0",
                                                "text": "July 18 2012, Scott Tobias, AV Club The Dark Knight Riseshttp://www.avclub.com/articles/the-dark-knight-rises-review-batman,82624/\nWith his crude potato-sack mask and fear-inducing toxins, The Scarecrow, a “psychopharmacologist” at an insane asylum, acts as a conjurer of nightmares, capable of turning his patients’ most terrifying anxieties against them."
                                            },
                                            {
                                                "example_id": "6c0f4b47-49b0-40f8-9a0d-1e47a336a335",
                                                "sense_id": "80e1c333-ff9b-32f7-af55-f2a2f5a99ab0",
                                                "text": "His incivility confirms no less. Good Doctor Pinch, you are a conjurer; Establish him in his true sense again, And I will please you what you will demand."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6fbedc52-5a92-3e1d-a465-18e8be8b764b",
                                        "entry_id": "7f4a7ba2-eb6b-36fc-9370-54dc259bb36e",
                                        "glosses": [
                                            "One who performs parlor tricks, sleight of hand."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb7a7086-a353-4361-afdc-c497dd261db9",
                                                "sense_id": "6fbedc52-5a92-3e1d-a465-18e8be8b764b",
                                                "text": "1893 The man is by trade a conjurer and performer, going round the canteens after nightfall, and giving a little entertainment at each. — Arthur Conan Doyle, \"The Adventure of the Crooked Man\"."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a7585a10-90f3-311f-ac18-2b6996ca6d18",
                                        "entry_id": "7f4a7ba2-eb6b-36fc-9370-54dc259bb36e",
                                        "glosses": [
                                            "One who conjures; one who calls, entreats, or charges in a solemn manner."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "50d5803c-1ba0-33cc-a858-28f1c7dc91cb",
                                        "entry_id": "7f4a7ba2-eb6b-36fc-9370-54dc259bb36e",
                                        "glosses": [
                                            "One who conjectures shrewdly or judges wisely; a man of sagacity."
                                        ],
                                        "tags": [
                                            "ironic",
                                            "obsolete",
                                            "often"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2373d2c0-257e-4e4c-a3b0-3e64e8afa64e",
                                                "sense_id": "50d5803c-1ba0-33cc-a858-28f1c7dc91cb",
                                                "text": "Some would be apt to say, he is a Conjurer; for he has found, That a Republick[…] is composed of Men only, and not of Horses"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d10307fb-bd0f-3c74-914d-987fb6fbd7d8",
                                        "entry_id": "7f4a7ba2-eb6b-36fc-9370-54dc259bb36e",
                                        "glosses": [
                                            "A cooking appliance comprising a pot (large or small) with a gridiron wielded beneath it, like a brazier, used for cooking methods such as broiling."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
