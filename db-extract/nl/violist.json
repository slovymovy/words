                                        "glosses": [
                                            "Person, die Violine spielt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0181d6e-3d18-4229-b88d-fabdd7c4e357",
                                                "sense_id": "2b7001a2-bd7d-307c-9ead-6cd89c24e09b",
                                                "text": "„Schließlich ist der Mann ein gefeierter Violinist und Dirigent, der im zarten Alter von sieben Jahren im japanischen Fernsehen als Geigen-Wunderkind herumgereicht wurde, und obendrein Spross einer der einflussreichsten Familien Japans.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c14798f6-0e73-42c2-998c-7b97d00ca981",
                        "source_entry_id": "811397d7-1cb1-37a2-833d-934706b65fc0",
                        "source_sense_id": "d31eea36-0b0d-35d4-b906-58e34c1c8b68",
                        "source_sense_description": "musicus die een viool bespeelt",
                        "target_lang_word": "violinist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "violinist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e3588243-a7fa-3836-979f-ae8d94e2885a",
                                        "entry_id": "1e1771f9-7a89-3604-b6dc-c1f679de1a22",
                                        "glosses": [
                                            "A person who plays the violin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "941bbffa-8684-408b-8b1a-1095bd7dad44",
                                                "sense_id": "e3588243-a7fa-3836-979f-ae8d94e2885a",
                                                "text": "[…] on Sunday four more violinists, a second violist and a harpsichordist were added to give the ripieno sections of the fast movements a heftier punch than the smaller group delivered."
                                            },
                                            {
                                                "example_id": "646e586c-2003-47e5-8b38-6a39546babab",
                                                "sense_id": "e3588243-a7fa-3836-979f-ae8d94e2885a",
                                                "text": "Founded in 1975 and led by the violinist Richard Tognetti since 1989, the orchestra looks youthful and hip onstage, its players clad in varying shades of black semiformality."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e22b847a-1203-486b-8312-bdab3a436b01",
                        "source_entry_id": "811397d7-1cb1-37a2-833d-934706b65fc0",
                        "source_sense_id": "d31eea36-0b0d-35d4-b906-58e34c1c8b68",
                        "source_sense_description": "musicus die een viool bespeelt",
                        "target_lang_word": "violoniste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "violoniste",
