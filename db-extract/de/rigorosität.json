                ],
                "senses": [
                    {
                        "sense_id": "b1933f9f-d22a-3f7c-be69-2d8a017db29e",
                        "entry_id": "b6f85809-bd4c-3c09-a98b-6ee9a0605d36",
                        "glosses": [
                            "Eigenschaft/Haltung/Handlungsweise, die in deutlichem Maße strenges, hartes (rigoroses) Verhalten zeigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "40fdd6a3-1e83-4000-bb65-1cd2fe04b877",
                                "sense_id": "b1933f9f-d22a-3f7c-be69-2d8a017db29e",
                                "text": "„Es ist also kaum anzunehmen, der für seine Rigorosität gefürchtete Paul V. hätte die Angelegenheit als Bagatelle betrachtet.“"
                            },
                            {
                                "example_id": "aa845aba-565f-4c31-aad5-7eae016fa169",
                                "sense_id": "b1933f9f-d22a-3f7c-be69-2d8a017db29e",
                                "text": "„Ich habe meine Ansicht in keiner Weise geändert, und sobald mir gültiges Material gegen den Fürsten Eulenburg zur Verfügung steht, werde ich mit aller Rigorosität ohne Ansehen der Person einschreiten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "51840e19-4e72-39db-9ba0-28cd80f38249",
                        "entry_id": "b6f85809-bd4c-3c09-a98b-6ee9a0605d36",
                        "glosses": [
                            "Anspruch an ein Forschungsprojekt, wissenschaftlich akzeptierte Methoden zu verwenden sowie eine Dokumentation durchzuführen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "daacf4e5-abe8-49f6-ac2c-93936fa086b8",
                                "sense_id": "51840e19-4e72-39db-9ba0-28cd80f38249",
                                "text": "„Diese theoretische Fragestellung und Ausrichtung ermöglichte einen in den Sozialwissenschaften unwahrscheinlich hohen Rigorositätsgrad, der es den Vertretern dieser Theorie erleichterte, sich – wenn sie überhaupt methodologisch interessiert waren – an den Methoden und dem Idealbild der Mechanik und der Makrophysik zu orientieren und deren Methoden und Ansprüche an Rigorosität als den Inbegriff wissenschaftlicher Methodik schlechthin zu betrachten.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
