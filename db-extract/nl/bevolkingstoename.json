                        "examples": [
                            {
                                "example_id": "adece21a-b681-4bad-8b30-8a1e283b82a0",
                                "sense_id": "08101773-1177-37b6-961a-cf7270722297",
                                "text": "Volgens Afrika-correspondent Koert Lindijer zal de migrantenstroom naar Europa niet snel stoppen. Het grootste probleem is volgens Lindijer de enorme bevolkingstoename in Afrika. \"Er komt een leger van miljoenen jonge werkzoekenden aangemarcheerd. Dat is de uitdaging voor de toekomst. Alle migranten op weg naar Europa die ik de afgelopen jaren sprak zijn beneden de 25 jaar.\""
                            },
                            {
                                "example_id": "f4cb7a65-936f-4951-bd31-b264f1e10d5a",
                                "sense_id": "08101773-1177-37b6-961a-cf7270722297",
                                "text": "De bevolkingstoename komt vooral voor rekening van Afrika, waar vrouwen gemiddeld vijf kinderen krijgen. De groei van de wereldbevolking neemt wel af, want pas over veertien jaar wordt volgens INED het volgende miljard bereikt. Nu heeft dat twaalf jaar geduurd."
                            }
                        ]
