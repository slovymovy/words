                        "target_lang_word": "forcer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "forcer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d394510a-6269-3473-a5ed-bafa10553a85",
                                        "entry_id": "0e90288b-e877-34b1-872a-6ffff986ead9",
                                        "glosses": [
                                            "Briser, rompre, ouvrir quelque chose avec violence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9211f7d2-8a1d-44b3-8684-b04d23dfe1be",
                                                "sense_id": "d394510a-6269-3473-a5ed-bafa10553a85",
                                                "text": "Ensuite il accompagna le médecin du Zeppelin dans une rue voisine, et força la porte d’une pharmacie où le major choisit les médicaments dont il avait besoin."
                                            },
                                            {
                                                "example_id": "1e1c2ba0-b031-40ec-ab89-117cdb571043",
                                                "sense_id": "d394510a-6269-3473-a5ed-bafa10553a85",
                                                "text": "Tu seras étonnée de découvrir cette lettre dans mon coffre, sur un paquet de titres. Il eût mieux valu peut-être la confier au notaire qui te l’aurait remise après ma mort, ou bien la ranger dans le tiroir de mon bureau, le premier que les enfants forceront avant que j’aie commencé d’être froid."
                                            },
                                            {
                                                "example_id": "36dbddca-a216-4e48-842b-400eea488e06",
                                                "sense_id": "d394510a-6269-3473-a5ed-bafa10553a85",
                                                "text": "Bernot et Chavilier partirent pour s’engager après avoir forcé la caisse de leurs logeuses."
                                            },
                                            {
                                                "example_id": "144bdae0-3a46-459c-8023-e890b5311e43",
                                                "sense_id": "d394510a-6269-3473-a5ed-bafa10553a85",
                                                "text": "Forcer une porte, une serrure, un coffre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "75eea2e0-b171-351b-b862-c72cbf534bef",
                                        "entry_id": "0e90288b-e877-34b1-872a-6ffff986ead9",
                                        "glosses": [
                                            "Fausser, tordre, détériorer par une manœuvre violente."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "42b70c81-4d41-4703-8863-34d872abafee",
                                                "sense_id": "75eea2e0-b171-351b-b862-c72cbf534bef",
                                                "text": "Forcer une clef, forcer une serrure."
                                            },
                                            {
                                                "example_id": "71270458-afed-4ae0-8709-0bb57c73db5d",
                                                "sense_id": "75eea2e0-b171-351b-b862-c72cbf534bef",
                                                "text": "Forcer un muscle, une articulation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e9641534-3e62-386c-a13f-4edf9491ec94",
                                        "entry_id": "0e90288b-e877-34b1-872a-6ffff986ead9",
                                        "glosses": [
                                            "Prendre par force, enfoncer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7eb71c16-04c0-4e14-84c3-bb462bcbbf86",
                                                "sense_id": "e9641534-3e62-386c-a13f-4edf9491ec94",
                                                "text": "Forcer un retranchement, une ville, un passage."
                                            },
                                            {
                                                "example_id": "226dd7a3-be06-4494-aa49-581a179c943f",
                                                "sense_id": "e9641534-3e62-386c-a13f-4edf9491ec94",
                                                "text": "Forcer tous les obstacles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "535f60a5-c98a-35c6-8482-515347f3602a",
                                        "entry_id": "0e90288b-e877-34b1-872a-6ffff986ead9",
                                        "glosses": [
                                            "Contraindre ou obliger à quelque chose."
                                        ],
                                        "tags": [],
                                        "note": "Se dit tant au propre qu’au figuré",
                                        "examples": [
                                            {
                                                "example_id": "3d474a41-71da-4dff-b4e1-3a0a3efb49ad",
                                                "sense_id": "535f60a5-c98a-35c6-8482-515347f3602a",
                                                "text": "Quelque peu disposé que vous parussiez à accepter la place d’académicien, il a cru vraisemblablement entrevoir dans vos yeux une envie d'y être forcé, et s'est persuadé qu'au moment que vous seriez élu vous ne vous feriez plus prier pour occuper une place qu'on ne pourrait plus vous soupçonner d'avoir recherchée : il s'est trompé et vous l'avez refusée."
                                            },
                                            {
                                                "example_id": "986baadd-e1b9-44f2-8544-d0ea42e3dc88",
                                                "sense_id": "535f60a5-c98a-35c6-8482-515347f3602a",
                                                "text": "Forcer quelqu’un à faire quelque chose."
                                            },
                                            {
                                                "example_id": "009ce991-1fd2-4bcc-b978-d04c5d37b6ac",
                                                "sense_id": "535f60a5-c98a-35c6-8482-515347f3602a",
                                                "text": "Il fut forcé de partir."
                                            },
                                            {
                                                "example_id": "80964dd6-d13e-4ac4-9cea-b68ae565c3af",
                                                "sense_id": "535f60a5-c98a-35c6-8482-515347f3602a",
                                                "text": "Forcer les consciences."
                                            },
                                            {
                                                "example_id": "1a50ca0a-373b-447e-ad73-2b640cde1557",
                                                "sense_id": "535f60a5-c98a-35c6-8482-515347f3602a",
                                                "text": "Forcer les volontés."
                                            },
                                            {
                                                "example_id": "eecf8f60-c2f1-486c-8a5c-d8a9074e6cff",
                                                "sense_id": "535f60a5-c98a-35c6-8482-515347f3602a",
                                                "text": "Forcer son inclination, son humeur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "225b3a85-c9f3-3ed5-b8bf-dd6eea1aa425",
                                        "entry_id": "0e90288b-e877-34b1-872a-6ffff986ead9",
                                        "glosses": [
                                            "Obliger à donner son consentement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e8080df-c618-4093-a174-16c5aed1aa0c",
                                                "sense_id": "225b3a85-c9f3-3ed5-b8bf-dd6eea1aa425",
                                                "text": "Forcer le consentement, le vote, etc., de quelqu’un"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "84083a22-46d9-3d29-b374-074e88fbe1fb",
                                        "entry_id": "0e90288b-e877-34b1-872a-6ffff986ead9",
                                        "glosses": [
                                            "Pousser à plus, ou à trop, d'effort."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d03945de-a961-4d3f-875b-f73c899c6f35",
                                                "sense_id": "84083a22-46d9-3d29-b374-074e88fbe1fb",
                                                "text": "Forcer sa voix, Faire des efforts de voix."
                                            },
                                            {
                                                "example_id": "30408b17-37df-460f-85fd-0754e058e39e",
                                                "sense_id": "84083a22-46d9-3d29-b374-074e88fbe1fb",
                                                "text": "Forcer un cheval, Le pousser trop, le faire courir au-delà de ses forces."
                                            },
                                            {
                                                "example_id": "dacc5433-66ff-4fc6-a596-d8161eae72e9",
                                                "sense_id": "84083a22-46d9-3d29-b374-074e88fbe1fb",
                                                "text": "Forcer le pas, la marche, Presser le pas, se mettre à marcher plus vite."
                                            },
                                            {
                                                "example_id": "aef0ad0e-0832-459d-956f-131c104fab61",
                                                "sense_id": "84083a22-46d9-3d29-b374-074e88fbe1fb",
                                                "text": "De temps en temps, M. Donis, qui, dans l’ardeur de son exploration, forçait le pas, s’arrêtait pour attendre l’arrière-garde, et alors on le voyait gesticuler avec vivacité, montrer le poing à la mer pour la défier d’aller plus loin et fixer le sable de la main comme pour le solidifier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "23dc3601-610c-3b97-96a3-2f39f14413e2",
                                        "entry_id": "0e90288b-e877-34b1-872a-6ffff986ead9",
                                        "glosses": [
                                            "Pousser à trop de quantité, augmenter inconsidérément."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e8471f6d-dcaf-4890-af50-3a82c8c3d1e6",
                                                "sense_id": "23dc3601-610c-3b97-96a3-2f39f14413e2",
                                                "text": "Même quand il lui arrivait de forcer un peu trop sur la vodka, il conservait dans son ivresse une dignité qui impressionnait."
                                            },
                                            {
                                                "example_id": "6bdbd8b5-861f-4253-a608-2fdc5eb3044e",
                                                "sense_id": "23dc3601-610c-3b97-96a3-2f39f14413e2",
                                                "text": "Nous forçâmes sur le buzet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f7ee07bb-03a6-3caf-88d6-8ad749977334",
                                        "entry_id": "0e90288b-e877-34b1-872a-6ffff986ead9",
                                        "glosses": [
                                            "Prendre le gibier avec des chiens de chasse, après l’avoir courue et réduite aux abois."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "31b9f1c7-dea2-4122-b1dc-5cd2496bcf0a",
                                                "sense_id": "f7ee07bb-03a6-3caf-88d6-8ad749977334",
                                                "text": "[…]; or, on conçoit l'affectueuse et haute estime de tout veneur pour la sagacité de son limier, lorsqu'on songe que, selon cette sagacité, on chasse ou on fait buisson creux , en cela que le limier doit d'abord chercher et trouver l'animal destiné à être ensuite couru et forcé par la meute."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b92e696-4888-362e-9bfb-76c460928cee",
                                        "entry_id": "0e90288b-e877-34b1-872a-6ffff986ead9",
                                        "glosses": [
                                            "Dans certains langages de programmation, instruire le type d’une variable pour quelque chose d’autre que son type original."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "237550c5-1022-4449-a933-3de70ca34ab1",
                                                "sense_id": "1b92e696-4888-362e-9bfb-76c460928cee",
                                                "text": "En C, il est courant, voire naturel, de forcer un pointeur en un entier et vice-versa."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "48b02707-e765-35b2-b52e-0f6673d06f04",
                                        "entry_id": "0e90288b-e877-34b1-872a-6ffff986ead9",
                                        "glosses": [
                                            "Faire donner artificiellement plus ou plus tôt qu’elles n’auraient donné naturellement, en parlant des plantes."
                                        ],
                                        "tags": [
                                            "Jardinage"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9968e629-f691-4d45-b446-e17d66bd4a28",
                                                "sense_id": "48b02707-e765-35b2-b52e-0f6673d06f04",
                                                "text": "Forcer un arbre fruitier, une vigne."
                                            },
                                            {
                                                "example_id": "0611f2e6-0b03-4127-8715-9b3644f03d35",
                                                "sense_id": "48b02707-e765-35b2-b52e-0f6673d06f04",
                                                "text": "les bulbes qui ont été forcés n'ont plus grande valeur et sont habituellement jetés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1bd616c9-a19e-3817-a3f2-cc56836f1ad9",
                                        "entry_id": "0e90288b-e877-34b1-872a-6ffff986ead9",
                                        "glosses": [
                                            "Fournir un gros effort, se dépenser."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "709027e6-6de0-4aa0-87cf-155fb1437018",
                                                "sense_id": "1bd616c9-a19e-3817-a3f2-cc56836f1ad9",
                                                "text": "Il est arrivé sans forcer."
                                            },
                                            {
                                                "example_id": "e6aba8d3-d8aa-4aa3-b81a-913741e46984",
                                                "sense_id": "1bd616c9-a19e-3817-a3f2-cc56836f1ad9",
                                                "text": "Prends ton temps, ne force pas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e08e90ba-d4fc-336c-9f42-95878684cf32",
                                        "entry_id": "0e90288b-e877-34b1-872a-6ffff986ead9",
                                        "glosses": [
                                            "Monter l’enchère."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b9eea26a-729c-34cb-bbee-9cbe92d5b4a2",
                                        "entry_id": "0e90288b-e877-34b1-872a-6ffff986ead9",
                                        "glosses": [
                                            "Faire force."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5d810758-f7d4-4014-88e1-13d19c988eb9",
                                                "sense_id": "b9eea26a-729c-34cb-bbee-9cbe92d5b4a2",
                                                "text": "Forcer de voiles, forcer de rames, forcer de vapeur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a344adbd-3d80-3c35-aa4a-03f54ee2ef79",
                                        "entry_id": "0e90288b-e877-34b1-872a-6ffff986ead9",
                                        "glosses": [
                                            "Faire quelque chose avec trop de force et de véhémence."
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ee39d1e6-dfc5-4db4-b837-3837390a3fca",
                                                "sense_id": "a344adbd-3d80-3c35-aa4a-03f54ee2ef79",
                                                "text": "Ne vous forcez point, vous vous ferez mal."
                                            },
                                            {
                                                "example_id": "43f5ae98-6cd6-4bc8-ad77-da6fe80e4a17",
                                                "sense_id": "a344adbd-3d80-3c35-aa4a-03f54ee2ef79",
                                                "text": "Ne vous forcez pas tant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4e38a904-f9e4-3b86-ba55-284a398d304c",
                                        "entry_id": "0e90288b-e877-34b1-872a-6ffff986ead9",
                                        "glosses": [
                                            "Se contraindre, faire effort sur soi-même."
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fc766ee9-5410-412c-8f62-17ad01481f11",
                                                "sense_id": "4e38a904-f9e4-3b86-ba55-284a398d304c",
                                                "text": "Anastasia se força à sourire à la dérangeuse."
                                            },
                                            {
                                                "example_id": "7393a563-ae13-480a-baa3-1abba7d89553",
                                                "sense_id": "4e38a904-f9e4-3b86-ba55-284a398d304c",
                                                "text": "« Il faut se forcer, criait ma mère. Tu le fais exprès, ajoutait-elle comme toujours. »"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
