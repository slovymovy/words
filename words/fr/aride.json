    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "3778179c-21e8-35af-848a-9d0ff4d98d32",
                    "sense_definition": "Qualifie une terre, un milieu ou un climat très sec, où le manque d'eau empêche ou limite la végétation.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "sécheresse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans cette région au climat <w>aride</w>, la pluie ne tombe que quelques jours par an."
                        },
                        {
                            "text": "Les plantes locales réussissent à survivre sur un sol particulièrement <w>aride</w> et rocheux."
                        }
                    ],
                    "synonyms": [
                        "sec",
                        "désertique",
                        "stérile"
                    ],
                    "antonyms": [
                        "humide",
                        "fertile"
                    ],
                    "common_phrases": [
                        "climat aride",
                        "zone aride",
                        "sol aride"
                    ]
                },
                {
                    "sense_id": "acb24a7a-c4ca-313d-84d3-d23ccd5c7f77",
                    "sense_definition": "Qui manque d'agrément, de chaleur ou d'intérêt ; austère et difficile d'accès.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "austérité",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'apprentissage de ces règles administratives constitue un travail <w>aride</w> mais essentiel."
                        },
                        {
                            "text": "Ce conférencier a réussi à rendre accessible un sujet <w>aride</w> et complexe."
                        }
                    ],
                    "synonyms": [
                        "austère",
                        "ingrat",
                        "rébarbatif"
                    ],
                    "antonyms": [
                        "captivant",
                        "passionnant"
                    ],
                    "common_phrases": [
                        "sujet aride",
                        "travail aride"
                    ]
                },
                {
                    "sense_id": "c3569e31-48b8-3eb2-9111-87da3ce86748",
                    "sense_definition": "Qui est sec et rude au toucher, en parlant d'une surface ou de la peau.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "toucher",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le froid intense de l'hiver a rendu sa peau particulièrement <w>aride</w> et rugueuse."
                        },
                        {
                            "text": "L'artisan passait la main sur la pierre <w>aride</w> avant de commencer à la polir."
                        }
                    ],
                    "synonyms": [
                        "rêche",
                        "rugueux"
                    ],
                    "antonyms": [
                        "doux",
                        "lisse"
                    ],
                    "common_phrases": [
                        "peau aride"
                    ]
                }
            ]
        }
