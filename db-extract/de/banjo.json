                "senses": [
                    {
                        "sense_id": "d3bd04ae-a260-3458-b955-66f541f1e47a",
                        "entry_id": "0cddc1c4-8a1d-354e-bd0f-529c57263c55",
                        "glosses": [
                            "Zupfinstrument mit einem runden Resonanzkörper und vier bis sechs Saiten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "17761f15-9ac3-4747-8be1-1919a344a0ce",
                                "sense_id": "d3bd04ae-a260-3458-b955-66f541f1e47a",
                                "text": "Der Straßenmusiker spielte mit dem Banjo, um Geld zu verdienen."
                            },
                            {
                                "example_id": "a890423c-77d9-4a6d-a551-42d0d0a8bbf6",
                                "sense_id": "d3bd04ae-a260-3458-b955-66f541f1e47a",
                                "text": "„Auf sein Banjo war in Schwarz eine Szene am Palmenstrand gemalt, und innen waren rote, gelbe und grüne elektrische Birnen, die aufflackerten und erloschen, während er spielte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c85872f6-1551-4ee3-a3ac-c2d839bcd45c",
                        "source_entry_id": "0cddc1c4-8a1d-354e-bd0f-529c57263c55",
                        "source_sense_id": "d3bd04ae-a260-3458-b955-66f541f1e47a",
                        "source_sense_description": "Zupfinstrument mit einem runden Resonanzkörper und vier bis sechs Saiten",
                        "target_lang_word": "banjo",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "banjo",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a3a66a35-fc39-3b29-ac7f-e5ded459489f",
                                        "entry_id": "b1adad69-05a9-3f16-b5a4-04e17f2c1108",
                                        "glosses": [
                                            "A stringed musical instrument (chordophone), usually with a round body, a membrane-like soundboard and a fretted neck, played by plucking or strumming the strings."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "29700eb7-23ac-4a99-bdb8-a39b2ece9cd2",
                                                "sense_id": "a3a66a35-fc39-3b29-ac7f-e5ded459489f",
                                                "text": "I come from Alabama with my banjo on my knee..."
                                            },
                                            {
                                                "example_id": "418a7cc8-71e2-462a-b0c8-1fe59c2b5707",
                                                "sense_id": "a3a66a35-fc39-3b29-ac7f-e5ded459489f",
                                                "text": "For quotations using this term, see Citations:banjo."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "631e29f8-288b-32ce-8027-6598c7edb89f",
                                        "entry_id": "b1adad69-05a9-3f16-b5a4-04e17f2c1108",
                                        "glosses": [
                                            "Any of various similar musical instruments, such as the Tuvan doshpuluur, with a membrane-like soundboard."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "690c5759-ca7f-3efd-8391-cfa2cddd8019",
                                        "entry_id": "b1adad69-05a9-3f16-b5a4-04e17f2c1108",
                                        "glosses": [
                                            "An object shaped like a banjo, especially a frying pan or a shovel."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "28ed047c-daf0-330a-98d2-4e78f934455e",
                                        "entry_id": "b1adad69-05a9-3f16-b5a4-04e17f2c1108",
                                        "glosses": [
                                            "A cul-de-sac with a round end."
                                        ],
                                        "tags": [
                                            "UK"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "054547ad-4e55-4fab-82ad-b0bedf56b6d3",
                                                "sense_id": "28ed047c-daf0-330a-98d2-4e78f934455e",
                                                "text": "Billy Tower lived in the far left house in the banjo that was Dagenham's version of cul de sacs. The trouble was you could be seen from the house and, in the time it took to walk along the Banjo, drugs could be flushed away."
                                            },
                                            {
                                                "example_id": "77b75ced-61fd-47d1-b867-cc8b675b4462",
                                                "sense_id": "28ed047c-daf0-330a-98d2-4e78f934455e",
                                                "text": "They all came back here — we cleared the room and put up tables for the reception — and then we went to another house on the banjo for a \"knees-up\"."
                                            },
                                            {
                                                "example_id": "9b59afd6-0793-4f2d-85a2-97c2fcaeb028",
                                                "sense_id": "28ed047c-daf0-330a-98d2-4e78f934455e",
                                                "text": "The banjo format is not an unalloyed success these days: kids playing noisily on the quite narrow common green […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e3f45999-5c30-3f71-a224-f355ac1754cc",
                                        "entry_id": "b1adad69-05a9-3f16-b5a4-04e17f2c1108",
                                        "glosses": [
                                            "A miner's round-nosed shovel."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "70b97892-4da2-316f-bcc4-25204f18ce22",
                                        "entry_id": "b1adad69-05a9-3f16-b5a4-04e17f2c1108",
                                        "glosses": [
                                            "An egg sandwich fried on a flattop and served in a bun as would a burger, ellipsis of egg banjo."
                                        ],
                                        "tags": [
                                            "Malaysia"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "621f575e-03da-39a8-bfdb-6ab3b2c49abf",
                                        "entry_id": "b1adad69-05a9-3f16-b5a4-04e17f2c1108",
                                        "glosses": [
                                            "The frenulum of the penis."
                                        ],
                                        "tags": [
                                            "slang",
                                            "vulgar"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "banjo",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b9710412-f971-3aa2-905a-8c98776b541e",
                                        "entry_id": "1de4e392-91d3-398e-acde-c6c3c2f6999d",
                                        "glosses": [
                                            "To play a banjo."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d96e4280-41bf-3a17-9710-a0ab7d807fba",
                                        "entry_id": "1de4e392-91d3-398e-acde-c6c3c2f6999d",
                                        "glosses": [
                                            "To beat, to knock down."
                                        ],
                                        "tags": [
                                            "British",
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0a89fbf6-5c95-4371-b534-ec874b5210a0",
                                                "sense_id": "d96e4280-41bf-3a17-9710-a0ab7d807fba",
                                                "text": "Admitting the assault, the husband said that he had given her a 'banjoing' but that she had asked for it."
                                            },
                                            {
                                                "example_id": "edfc3eb6-5747-4145-a180-e2206a85726d",
                                                "sense_id": "d96e4280-41bf-3a17-9710-a0ab7d807fba",
                                                "text": "Madar was turfed out on a final misdemeanour of banjoing one of his teammates in training before a big game"
                                            },
                                            {
                                                "example_id": "36b86212-bd05-497b-b9e9-0ca2c40fa959",
                                                "sense_id": "d96e4280-41bf-3a17-9710-a0ab7d807fba",
                                                "text": "\"Me and other folk were just trying to get the boot in and some other guy banjoed [decked] him”."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "38feef85-0540-32f9-a9a0-1d6fe85e8de8",
                                        "entry_id": "1de4e392-91d3-398e-acde-c6c3c2f6999d",
                                        "glosses": [
                                            "To shell or attack (a target)."
                                        ],
                                        "tags": [
                                            "British",
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a278e6d9-46a0-40cb-8dd4-54a8285c7c33",
                                                "sense_id": "38feef85-0540-32f9-a9a0-1d6fe85e8de8",
                                                "text": "Riding reported that on the day Mayne had asked for DZ coordinates, their base had been banjoed by the Germans."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7c957d99-73b6-4f38-96c0-1f0eac7877de",
                        "source_entry_id": "0cddc1c4-8a1d-354e-bd0f-529c57263c55",
                        "source_sense_id": "d3bd04ae-a260-3458-b955-66f541f1e47a",
                        "source_sense_description": "Zupfinstrument mit einem runden Resonanzkörper und vier bis sechs Saiten",
                        "target_lang_word": "banjo",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "banjo",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c579949a-5107-3b69-8e69-f61e079cb135",
                                        "entry_id": "cbad782a-7d2b-3311-991a-f1eec48b5131",
                                        "glosses": [
                                            "Cordophone portable à cordes pincées, à touche garnie de frettes marquant les demi-tons, et à table d’harmonie en membrane de parchemin tendue sur un tambour."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad3a6c92-f04f-4078-a552-725443209c58",
                                                "sense_id": "c579949a-5107-3b69-8e69-f61e079cb135",
                                                "text": "De même nous n’étions pas de force contre les bandes de musiciens nègres qui courent les rues et que les Anglais appellent des nigger-melodits ; ces faux nègres qui s’accoutrent grotesquement avec des habits à queue de morue et d’immenses cols dans lesquels leur tête est enveloppée comme un bouquet dans une feuille de papier, étaient notre terreur plus encore que les bardes écossais : aussitôt que nous les voyions arriver, ou simplement quand nous entendions leurs banjo, nous nous taisions respectueusement et nous nous en allions loin de là dans un quartier où nous espérions ne pas rencontrer une autre de leurs bandes ; ou bien nous attendions, en les regardant, qu’ils eussent fini leur charivari."
                                            },
                                            {
                                                "example_id": "e0e69df5-1d7a-469a-887a-88c106684fda",
                                                "sense_id": "c579949a-5107-3b69-8e69-f61e079cb135",
                                                "text": "Deux escaliers, sous un maigre lumignon, plongent aussitôt vers un sous-sol d’où la musique sonore et nasillarde de l’accordéon monte avec des accords de banjo."
                                            },
                                            {
                                                "example_id": "85a40ac8-7daf-4273-9956-62ab05da95d0",
                                                "sense_id": "c579949a-5107-3b69-8e69-f61e079cb135",
                                                "text": "Pour la deuxième soirée des Mardis, le groupe The Greenings, très applaudi, a mis la place des Halles à l’heure irlandaise au son du violon, du banjo, de la guitare et du stomp, avant les Son’s of O’Flaherty et leur musique folk-punk."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
