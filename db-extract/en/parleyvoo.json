                    {
                        "sense_id": "38eeb53f-cad1-3c83-ab6a-7fd4af579445",
                        "entry_id": "4f7dc1ee-7666-3fed-96a0-555a10584ac3",
                        "glosses": [
                            "The French language, especially as understood by an English person."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "c9945938-64dc-43b9-94f6-8c28a4619bab",
                                "sense_id": "38eeb53f-cad1-3c83-ab6a-7fd4af579445",
                                "text": "Lynch. Let him alone. He's back from Paris […] Zoe. O go on! Give us some parleyvoo."
                            }
                        ]
                    },
                    {
                        "sense_id": "25c7a3e6-4745-3534-9e3c-6b5b81e90272",
                        "entry_id": "4f7dc1ee-7666-3fed-96a0-555a10584ac3",
                        "glosses": [
                            "A French person."
                        ],
                        "tags": [
                            "archaic",
                            "countable"
                        ],
                        "examples": [
                            {
                                "example_id": "8c046f4c-e587-4db1-a1a6-351226f91c69",
                                "sense_id": "25c7a3e6-4745-3534-9e3c-6b5b81e90272",
                                "text": "[O]ne of these d—d Parlivoos will go farther with some women in a day, than an Englishman in a month—all owing to their impudence; for a common man has as much impudence in France as a man-midwife has in England."
                            },
                            {
                                "example_id": "c0ea26a2-3e37-423b-a510-d80032e15f6e",
                                "sense_id": "25c7a3e6-4745-3534-9e3c-6b5b81e90272",
                                "text": "We were hardy British tars who had pity on a poor Parley-voo"
                            }
                        ]
                    }
                ],
