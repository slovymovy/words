            {
                "entry_id": "c7a72c33-0208-31ec-b91f-d09061b5b8a6",
                "word": "onverwachts",
                "pos": "adv",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "6f75e1d8-9d82-3772-8974-1544da1cc4e7",
                        "entry_id": "c7a72c33-0208-31ec-b91f-d09061b5b8a6",
                        "glosses": [
                            "tegen de verwachting in"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "35920927-2cd8-4112-96e7-548b1a4427af",
                                "sense_id": "6f75e1d8-9d82-3772-8974-1544da1cc4e7",
                                "text": "Hij kwam onverwachts op bezoek."
                            },
                            {
                                "example_id": "de64c15b-3388-41b8-aa90-0d55cf571e96",
                                "sense_id": "6f75e1d8-9d82-3772-8974-1544da1cc4e7",
                                "text": "Na een lange dag was er niks fijner dan Coppertone onverwachts tegen te komen en van zijn vreemde combinatie te genieten."
                            },
                            {
                                "example_id": "927aff10-0519-48dd-976c-ed113a4cc276",
                                "sense_id": "6f75e1d8-9d82-3772-8974-1544da1cc4e7",
                                "text": "In de Nederlandse culinaire wereld wordt geschokt gereageerd op het onverwachtse overlijden van topchef Jonnie Boer, op 60-jarige leeftijd. Veel jonge koks met wie hij werkte, hebben nu hun eigen bekende restaurants. Voor hen was hij een grote inspiratie."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ec9c9473-bcb7-402a-a9f2-4b2cd49cbfa4",
                        "source_entry_id": "c7a72c33-0208-31ec-b91f-d09061b5b8a6",
                        "source_sense_id": "6f75e1d8-9d82-3772-8974-1544da1cc4e7",
                        "target_lang_word": "unexpectedly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unexpectedly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "be8c60b4-f273-3307-9237-f464721bd60f",
                                        "entry_id": "72175067-63da-3c54-a05e-1de7d45e321c",
                                        "glosses": [
                                            "In an unexpected manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d095c36-5026-4cd2-83af-63c47a289fd5",
                                                "sense_id": "be8c60b4-f273-3307-9237-f464721bd60f",
                                                "text": "Near-synonyms: against expectations, against all odds, surprisingly"
                                            },
                                            {
                                                "example_id": "8cf6fecf-97a8-4b26-8697-bff936162838",
                                                "sense_id": "be8c60b4-f273-3307-9237-f464721bd60f",
                                                "text": "[…] she was startled by unexpectedly meeting her husband, who was coming to seek her."
                                            },
                                            {
                                                "example_id": "38b175cb-f4be-4ff2-8de1-b1e407b3dc97",
                                                "sense_id": "be8c60b4-f273-3307-9237-f464721bd60f",
                                                "text": "Other evidence of former ownerships such as notice-boards, number plates, and makers' plates, are often discovered unexpectedly."
                                            },
                                            {
                                                "example_id": "4ac4a871-d192-4892-ad79-18cc1f480fce",
                                                "sense_id": "be8c60b4-f273-3307-9237-f464721bd60f",
                                                "text": "Texas House Democrats’ historic quorum break unexpectedly ended Thursday evening when at least three new Democrats returned to the floor, paving the way for state Republicans to pass restrictive voting legislation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8fce8303-731a-42d8-9544-419f0e01fecc",
                        "source_entry_id": "c7a72c33-0208-31ec-b91f-d09061b5b8a6",
