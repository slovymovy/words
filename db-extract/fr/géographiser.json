                        "tags": [],
                        "examples": [
                            {
                                "example_id": "20e96abd-5d5e-4020-b72c-fc1a33858105",
                                "sense_id": "28ba58e4-c712-3d54-9611-fec33cb2ee40",
                                "text": "Peux-tu nous cartographier, topographier et géographiser ce continent étrange ?"
                            },
                            {
                                "example_id": "ce89fa16-cb9c-4dcd-9c5e-33c98a7ce546",
                                "sense_id": "28ba58e4-c712-3d54-9611-fec33cb2ee40",
                                "text": "Au sujet du quotidien, pour bien voir avec sa vue subtile, il faut “géographiser” le but à atteindre ou se le représenter mentalement, c'est facile."
                            },
                            {
                                "example_id": "3af78858-9915-44be-a7c3-b9e591b257c3",
                                "sense_id": "28ba58e4-c712-3d54-9611-fec33cb2ee40",
                                "text": "Comment les savoirs viennent-ils à s'enraciner, à faire lieu, à se géographiser ?"
                            }
