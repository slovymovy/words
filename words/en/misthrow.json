{
    "word_family": [
        "throw",
        "thrower",
        "throwaway"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a8da940c-a9e8-3d77-80d8-9c74d56576e0",
                    "sense_definition": "An incorrect or inaccurate throw of an object.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "throwing_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pitcher's <w>misthrow</w> allowed the runner to reach second base safely.",
                            "target_lang_translations": {
                                "zh": "投手的一次<w>投掷失误</w>让跑垒员安全到达了二垒。"
                            }
                        },
                        {
                            "text": "A costly <w>misthrow</w> in the final minute of the game changed the outcome.",
                            "target_lang_translations": {
                                "zh": "比赛最后一分钟的一次代价高昂的<w>投掷失误</w>改变了结果。"
                            }
                        }
                    ],
                    "synonyms": [
                        "bad throw",
                        "errant throw"
                    ],
                    "common_phrases": [
                        "costly misthrow"
                    ],
                    "target_lang_definitions": {
                        "zh": "投掷不准或投掷失误的行为。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "投掷失误",
                                "target_lang_sense_clarification": "指投掷动作出现偏差或错误。"
                            },
                            {
                                "target_lang_word": "传球失误",
                                "target_lang_sense_clarification": "特指在体育比赛中传球不准。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "aed54015-e525-33b4-b7f2-cefd59048c65",
                    "sense_definition": "To throw an object in an incorrect or inaccurate manner.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "throwing_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The outfielder <w>misthrew</w> the ball, missing the target completely.",
                            "target_lang_translations": {
                                "zh": "外野手<w>投掷失误</w>，球完全偏离了目标。"
                            }
                        },
                        {
                            "text": "It is easy to <w>misthrow</w> when you are under pressure during a match.",
                            "target_lang_translations": {
                                "zh": "在比赛中承受压力时，很容易出现<w>投掷失误</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "miss"
                    ],
                    "common_phrases": [
                        "misthrow the ball"
                    ],
                    "target_lang_definitions": {
                        "zh": "投掷时出现偏差或未能投中目标。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "投掷失误",
                                "target_lang_sense_clarification": "指投掷动作不准确。"
                            },
                            {
                                "target_lang_word": "传球失误",
                                "target_lang_sense_clarification": "指在比赛中传球偏离目标。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
