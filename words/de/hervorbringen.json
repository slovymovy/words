                    ]
                },
                {
                    "sense_id": "4bcd0e8f-9f93-3211-8fd9-361a0a1ae7b2",
                    "sense_definition": "mit Mühe, Anstrengung oder Ergriffenheit leise sprechen oder Worte aussprechen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sprechen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Vor lauter Aufregung konnte der Redner kaum einen verständlichen Ton <w>hervorbringen</w>."
                        },
                        {
                            "text": "Sie war so überrascht, dass sie nur ein leises Danke <w>hervorbrachte</w>."
                        }
                    ],
                    "synonyms": [
