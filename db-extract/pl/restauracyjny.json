                                        "sense_id": "5a13d368-2d4c-3f04-9afb-0fa3a21bfbf1",
                                        "entry_id": "59ef3d20-11a3-394f-988e-831de15daf28",
                                        "glosses": [
                                            "An eating establishment in which diners are served food, usually by waiters at their tables but sometimes (as in a fast food restaurant) at a counter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0a5dcdb-df04-442b-a571-dbb9ed9097fc",
                                                "sense_id": "5a13d368-2d4c-3f04-9afb-0fa3a21bfbf1",
                                                "text": "That Italian restaurant serves some of the best food I've ever had in my life."
                                            },
                                            {
                                                "example_id": "4be6e449-235e-47d4-82b4-9906c9b60255",
                                                "sense_id": "5a13d368-2d4c-3f04-9afb-0fa3a21bfbf1",
                                                "text": "By one o'clock the place was choc-a-bloc. […] The restaurant was packed, and the promenade between the two main courts and the subsidiary courts was thronged with healthy-looking youngish people, drawn to the Mecca of tennis from all parts of the country."
                                            }
                                        ]
