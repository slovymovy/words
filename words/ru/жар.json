                },
                {
                    "sense_id": "6aa53b3e-c895-39d1-a5fa-dc3f5c0eae3f",
                    "sense_definition": "Ощущение сильного тепла в теле или прилив крови к лицу от волнения или стыда.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "body_temperature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "От неожиданного вопроса меня бросило в <w>жар</w>.",
                            "target_lang_translations": {
                                "en": "The unexpected question made me feel a rush of <w>heat</w>.",
                                "de": "Die unerwartete Frage ließ mich vor <w>Hitze</w> erröten."
                            }
                        },
                        {
                            "text": "Её щёки горели <w>жаром</w> после долгой прогулки на морозе.",
                            "target_lang_translations": {
                                "en": "Her cheeks burned with <w>heat</w> after the long walk in the frost.",
                                "de": "Ihre Wangen brannten vor <w>Hitze</w> nach dem langen Spaziergang in der Kälte."
                            }
                        }
