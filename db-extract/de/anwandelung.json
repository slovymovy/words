                "senses": [
                    {
                        "sense_id": "6b83faa3-b1eb-339d-b387-1be5985ebe21",
                        "entry_id": "efe5d6e8-fde5-3d2f-855b-b86c42ba366c",
                        "glosses": [
                            "plötzliche kurzzeitige Änderung des Gemütszustandes, der Stimmung; plötzlicher (seltsamer) Einfall"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1cac6716-d180-438d-8f2c-bb6088a8da2a",
                                "sense_id": "6b83faa3-b1eb-339d-b387-1be5985ebe21",
                                "text": "„Ruhig vergingen nicht selten einige Tage in der Mitte dieser menschenleeren Wildniss, ehe ein Bewohner des Waldes sichtbar wurde, allein die Natur lieferte genugsamen Stoff zur Beschäftigung und nie wurde eine Anwandelung von Langerweile empfunden. “"
                            },
                            {
                                "example_id": "7d0b5db7-a01f-4ac1-9f2b-0d8616a966b5",
                                "sense_id": "6b83faa3-b1eb-339d-b387-1be5985ebe21",
                                "text": "„Gewöhnlich sind es indessen ganz andere Empfindungen: das Gefühl des Kriebelns, der Erstarrung oder eines lebhaften Schmerzes an den betreffenden Stellen, eine Anwandelung von Schwindel oder allgemeinem Unbehagen, welche den Anfall einleiten und als epileptische Aura bezeichnet werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
