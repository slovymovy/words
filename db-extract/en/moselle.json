                "senses": [
                    {
                        "sense_id": "c4130269-2bfc-3ae5-9b81-22a7f6324383",
                        "entry_id": "0fe1ea89-5465-3f7a-860d-59f3d45d40fc",
                        "glosses": [
                            "Moselwein"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8632a503-a563-4172-bcd1-ab48e465df4a",
                        "source_entry_id": "0fe1ea89-5465-3f7a-860d-59f3d45d40fc",
                        "source_sense_id": "c4130269-2bfc-3ae5-9b81-22a7f6324383",
                        "source_sense_description": "Moselwein",
                        "target_lang_word": "Moselwein",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Moselwein",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "970952e3-6581-3689-a2c6-ef1f8f463a77",
                                        "entry_id": "ed9d3b22-e7c6-3a4f-9a11-45fb8b3adeb4",
                                        "glosses": [
                                            "ein Wein, der im Moseltal angebaut und gewachsen ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "67f7ca8e-06e0-4222-8f65-b1826b5aa752",
                                                "sense_id": "970952e3-6581-3689-a2c6-ef1f8f463a77",
                                                "text": "Für viele ist der Riesling ein besonders guter Moselwein."
                                            },
                                            {
                                                "example_id": "c14df482-f354-4481-a9b9-a6ce516fb0bf",
                                                "sense_id": "970952e3-6581-3689-a2c6-ef1f8f463a77",
                                                "text": "„Nichts gegen Moselweine, aber diese Probe verläuft in eher schaler Touristenroutine.“"
                                            },
                                            {
                                                "example_id": "f583b4c1-fb3f-464e-8bc2-63bab4942026",
                                                "sense_id": "970952e3-6581-3689-a2c6-ef1f8f463a77",
                                                "text": "„Wenn der schwere Rheinwein wie flüssiges Gold in den Adern rollt und pocht, wenn er den Trinker beansprucht bis zu einem Glückstaumel und Rausch, in dem er stumm vor dem Glase sitzt und sich und die Welt vergißt, vertauscht der Moselwein nicht heimlich zu seinen Gunsten die Gegenwart mit einer anderen Welt.“"
                                            },
                                            {
                                                "example_id": "4fdba565-49e3-4cc9-90e0-59314f8e397c",
                                                "sense_id": "970952e3-6581-3689-a2c6-ef1f8f463a77",
                                                "text": "„Gering geachtet setzte man den Moselwein dem Kutscher vor, derweil am Rheinwein oder Pfälzer die Herrschaft stillvergnügt sich labte.“"
                                            },
                                            {
                                                "example_id": "21c88185-f8ac-43d3-8ddf-f344e248f233",
                                                "sense_id": "970952e3-6581-3689-a2c6-ef1f8f463a77",
                                                "text": "„In dem Garten gab es auch Schaukeln und Rutschen, und so habe ich mit einigen anderen Kindern, deren Eltern auch Moselwein getrunken haben, etwas geschaukelt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
