                            }
                        },
                        {
                            "text": "She was surprised by the <w>violence</w> of his reaction to the news.",
                            "target_lang_translations": {
                                "ru": "Она была удивлена <w>яростью</w> его реакции на новости.",
                                "zh": "她对他听到消息后那种<w>剧烈</w>的反应感到惊讶。"
                            }
                        }
