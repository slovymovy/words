                "senses": [
                    {
                        "sense_id": "4bc1ea00-3dc0-3118-a2a0-4a13a2c6aead",
                        "entry_id": "4805030b-d37d-3cef-a93f-9310dd4e6708",
                        "glosses": [
                            "Être victime d’hémorragie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "70536d33-a3b8-4f0a-94ea-2329ea40cbb1",
                                "sense_id": "4bc1ea00-3dc0-3118-a2a0-4a13a2c6aead",
                                "text": "Oh! je frétille, je me flasquifie, j’hémorrage de partout."
                            },
                            {
                                "example_id": "ad823211-82b9-4d1a-9218-30af3de41b87",
                                "sense_id": "4bc1ea00-3dc0-3118-a2a0-4a13a2c6aead",
                                "text": "Mon cœur rage, hémorrage, ralentit."
                            },
                            {
                                "example_id": "bc54a0ef-aebf-42b4-b733-b6c62714da20",
                                "sense_id": "4bc1ea00-3dc0-3118-a2a0-4a13a2c6aead",
                                "text": "Ce qu’ils ont en commun : le jet. Le jaillissement. Le déferlement, comme lorsqu’on sanglote ou le contraire, ou lorsqu’on hémorrage."
                            }
                        ]
                    }
