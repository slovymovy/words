                        "tags": [
                            "без доп."
                        ],
                        "examples": [
                            {
                                "example_id": "a84dd8d8-b369-4bca-9fe2-923969df9da0",
                                "sense_id": "9f6d8a0e-f764-3c3a-b40a-a45f1cf35456",
                                "text": "Дело запуталось."
                            },
                            {
                                "example_id": "8f9e0007-948e-44e2-b206-e4970e5f1193",
