                "senses": [
                    {
                        "sense_id": "97f14872-b35a-3ab8-9902-33c98b14f052",
                        "entry_id": "f757d346-c08e-3d40-8e02-07ef4d15f858",
                        "glosses": [
                            "Sprache, in der mit einer Änderung im Ton auch eine Änderung der Bedeutung des Wortes einhergeht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a8ad0e9f-2a64-43ac-8e8b-7ff60c83d746",
                                "sense_id": "97f14872-b35a-3ab8-9902-33c98b14f052",
                                "text": "Chinesisch ist ein Beispiel für eine Tonsprache."
                            },
                            {
                                "example_id": "df9981c0-1b9d-4377-a1d1-cc5798f69612",
                                "sense_id": "97f14872-b35a-3ab8-9902-33c98b14f052",
                                "text": "„Im Unterschied zu Hindi ist das Tibetische eine Tonsprache.“"
                            },
                            {
                                "example_id": "a69b9187-3012-4a5e-8cc2-5b82ef2b01bd",
                                "sense_id": "97f14872-b35a-3ab8-9902-33c98b14f052",
                                "text": "„Dem hält allerdings Haarmann (…) entgegen, dass dies auch im Vietnamesischen gelang, obwohl das Vietnamesische ebenfalls eine Tonsprache (mit sechs Tönen) ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
