            "senses": [
                {
                    "sense_id": "1b11b17a-73f3-3bf3-b348-a15227fa7d99",
                    "sense_definition": "Exprimer avec netteté et précision une pensée, une demande ou un souhait.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "expression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'étudiant a pris le temps de bien <w>formuler</w> sa question avant d'interrompre le cours."
                        },
                        {
                            "text": "Elle a enfin réussi à <w>formuler</w> une demande claire auprès de la direction."
                        }
                    ],
                    "synonyms": [
                        "exprimer",
                        "énoncer"
                    ],
                    "antonyms": [
                        "taire"
                    ],
                    "common_phrases": [
