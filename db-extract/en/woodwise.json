                        "glosses": [
                            "Having the skills and attitudes that allow one to survive in a woodland environment."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0961a97-ce8a-493e-b8d6-e08df1eea737",
                                "sense_id": "e4a13087-5b17-39c2-98ad-6cafdfd09924",
                                "text": "Traveling through woodlands offers good cover for a band moving under the direction of a woodwise chief, so birds and beasts are sometimes caught off guard and can be observed from cover for some time before they take alarm."
                            },
                            {
                                "example_id": "560d57c2-9c5d-4a5b-b36e-f5f103b2903f",
                                "sense_id": "e4a13087-5b17-39c2-98ad-6cafdfd09924",
                                "text": "Suddenly all the classes we'd had at school about being streetwise came flooding back. No one had mentioned being 'woodwise'. The survival mantras ran through my mind: Don't go into isolated places where no one could hear if you called for help."
                            },
                            {
                                "example_id": "5ed4cd37-cade-41cb-98ac-0c840e65ccf8",
                                "sense_id": "e4a13087-5b17-39c2-98ad-6cafdfd09924",
                                "text": "Self-examination combines with a “woodwise” attitude to shape new lives."
                            }
                        ]
                    }
