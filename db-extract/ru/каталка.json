                "senses": [
                    {
                        "sense_id": "0903aa71-d824-334d-aefa-7309e89d0f50",
                        "entry_id": "b6a770c6-7473-3c09-ae3f-4fb640fb0149",
                        "glosses": [
                            "разг. то же, что кресло-каталка"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "d42ec409-f4c7-3e25-81a0-11567f65b4c9",
                        "entry_id": "b6a770c6-7473-3c09-ae3f-4fb640fb0149",
                        "glosses": [
                            "мед. и разг. специальная полифункциональная тележка для перевозки больных (пострадавших), а также транспортировки трупов в медицинских учреждениях"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9b1d50b2-f4f7-4515-952a-d32cb57f6091",
                                "sense_id": "d42ec409-f4c7-3e25-81a0-11567f65b4c9",
                                "text": "Некоторых детей привезли на каталках, рядом стояли штативы с капельницами."
                            }
                        ]
                    },
                    {
                        "sense_id": "9141aa17-efbf-3e58-9254-c98b760014e2",
                        "entry_id": "b6a770c6-7473-3c09-ae3f-4fb640fb0149",
                        "glosses": [
                            "разг. детская игрушка на колёсиках"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "497800c4-c3c9-45a1-a1c8-e4fc65074137",
                                "sense_id": "9141aa17-efbf-3e58-9254-c98b760014e2",
                                "text": "Для использования дома идеальны каталки и толокары с колёсами из пластика, так как они более лёгкие и маневренные."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "204e7e4f-9fb6-45eb-9e81-43a81591cfb2",
                        "source_entry_id": "b6a770c6-7473-3c09-ae3f-4fb640fb0149",
                        "source_sense_description": "специальная полифункциональная тележка для перевозки больных (пострадавших), а также транспортировки трупов в медицинских учреждениях",
                        "target_lang_word": "gurney",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gurney",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "70ee214c-2020-3280-9a18-fb659f3e604f",
                                        "entry_id": "94ccac21-0eb0-3674-99cf-d3a447a893de",
                                        "glosses": [
                                            "A stretcher having wheeled legs."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5f84389b-843d-4fe5-98d6-9f97fe11d0f2",
                                                "sense_id": "70ee214c-2020-3280-9a18-fb659f3e604f",
                                                "text": "The death row convict was strapped into the gurney in order to be given the lethal injection."
                                            },
                                            {
                                                "example_id": "a47f1010-4d25-4a90-8410-84ca8788db02",
                                                "sense_id": "70ee214c-2020-3280-9a18-fb659f3e604f",
                                                "text": "Yet her vision has narrowed strangely (good, for she was in a medical facility, if she were having a hemorrhage or a stroke it could not be happening at a more convenient time) so that she was able to see little in the fluorescent-lit space except the man who lay motionless on a gurney beneath the strongest of the lights."
                                            },
                                            {
                                                "example_id": "e508c65f-dbb4-4e91-b7c4-f5cc08d0a70c",
                                                "sense_id": "70ee214c-2020-3280-9a18-fb659f3e604f",
                                                "text": "I’m pretty sure I didn’t actively steer towards the tree, but… I don’t know. I just remember that wave of despair and then the EMTs pulling me out of the car and putting me on a gurney."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4b52644f-cb27-42fa-9a98-6b01485a5b7e",
                        "source_entry_id": "b6a770c6-7473-3c09-ae3f-4fb640fb0149",
                        "source_sense_description": "специальная полифункциональная тележка для перевозки больных (пострадавших), а также транспортировки трупов в медицинских учреждениях",
                        "target_lang_word": "Fahrbahre",
