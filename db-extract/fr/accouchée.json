        "fr-extract.jsonl": [
            {
                "entry_id": "bf6f3c86-4e76-32be-afc6-b6c8604c6c67",
                "word": "accouchée",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "dde67efc-45bf-4ab2-857c-80bab5411681",
                        "entry_id": "bf6f3c86-4e76-32be-afc6-b6c8604c6c67",
                        "tags": [
                            "plural"
                        ],
                        "form": "accouchées"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fb9c94f3-02d7-30fe-931b-1b7be7fd7772",
                        "entry_id": "bf6f3c86-4e76-32be-afc6-b6c8604c6c67",
                        "glosses": [
                            "Femme qui vient de mettre au monde un enfant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af2239a4-8f65-4c07-952f-a6b7f0ffd435",
                                "sense_id": "fb9c94f3-02d7-30fe-931b-1b7be7fd7772",
                                "text": "Au milieu d’un cercle affairé de commères accourues pour donner soi-disant leurs soins à l’accouchée, la sage-femme triomphante brandit un petit être rougeaud, gigotant, qui braillait d’une voix obstinée et sonore."
                            },
                            {
                                "example_id": "623a482b-cbc6-42af-bc4c-5a48a67b957d",
                                "sense_id": "fb9c94f3-02d7-30fe-931b-1b7be7fd7772",
                                "text": "Je me sentais léger et creux comme une accouchée."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ea4ebe7d-6301-4828-92e5-caaaf8c2d108",
                        "source_entry_id": "bf6f3c86-4e76-32be-afc6-b6c8604c6c67",
                        "source_sense_id": "fb9c94f3-02d7-30fe-931b-1b7be7fd7772",
                        "target_lang_word": "Wöchnerin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wöchnerin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "89eb14c8-c0cd-30b3-9fb5-053bd915fa3b",
                                        "entry_id": "bd343718-f7e6-35d2-8bda-e7b18ec692ff",
                                        "glosses": [
                                            "eine Frau in den ersten sechs bis acht Wochen nach der Geburt, in denen sich die Geschlechtsorgane (mit Ausnahme der Brüste) auf ihren Zustand vor der Schwangerschaft zurückbilden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a412bba-705e-4769-96fb-c9229918fd4a",
                                                "sense_id": "89eb14c8-c0cd-30b3-9fb5-053bd915fa3b",
                                                "text": "„Im allgemeinen hält sie sich für sich selber und geht davon nur ab, wenn sie helfen kann, sei es, daß es sich um eine Wöchnerin handelt, die zu arm ist, um die rechte Pflege haben zu können, oder um kranke oder anderswie unglückliche Menschen.“"
                                            },
                                            {
                                                "example_id": "71f86b2c-80b1-4159-bfb9-be6541b69bb0",
                                                "sense_id": "89eb14c8-c0cd-30b3-9fb5-053bd915fa3b",
                                                "text": "„Aber am Lager der Wöchnerin mit dem Kind im Arm halten Erzengel Wache.“"
                                            },
                                            {
                                                "example_id": "5862a63d-ea3a-464a-87b1-6d9fe9339989",
                                                "sense_id": "89eb14c8-c0cd-30b3-9fb5-053bd915fa3b",
                                                "text": "„Nach Bogutscharowo hatte er auf eigene Kosten eine gelernte Hebamme kommen lassen, um den Wöchnerinnen zur Hand zu gehen, und gegen ein regelmässiges Gehalt lehrte der Geistliche die Kinder der Bauern und Hofesleute Lesen und Schreiben.“"
                                            },
                                            {
                                                "example_id": "4c9f27d7-fb62-467b-be1c-0d89021b80ff",
                                                "sense_id": "89eb14c8-c0cd-30b3-9fb5-053bd915fa3b",
                                                "text": "„Die Wöchnerin wollte davon nichts wissen, denn sie konnte das Militär nicht leiden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "519824b8-e530-43ff-ae44-0c504320be0c",
                        "source_entry_id": "bf6f3c86-4e76-32be-afc6-b6c8604c6c67",
                        "source_sense_id": "fb9c94f3-02d7-30fe-931b-1b7be7fd7772",
                        "target_lang_word": "lying-in woman",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "f29e3864-8401-461c-9f78-307206a46ebb",
                        "source_entry_id": "bf6f3c86-4e76-32be-afc6-b6c8604c6c67",
                        "source_sense_id": "fb9c94f3-02d7-30fe-931b-1b7be7fd7772",
                        "target_lang_word": "puerpera",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "puerpera",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "513c54a4-8cd8-30cf-884a-89b900338d27",
                                        "entry_id": "550b0348-0d6e-31f0-861c-1e7f721e28ba",
                                        "glosses": [
                                            "A woman undergoing puerperium; a woman whose uterus is still enlarged from pregnancy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b37d4257-0813-4460-9216-781535d86695",
                                                "sense_id": "513c54a4-8cd8-30cf-884a-89b900338d27",
                                                "text": "I saw a very serious hemorrhage result from relaxation of the uterus on the eleventh day when the puerpera had been frightened by a domestic quarrel."
                                            },
                                            {
                                                "example_id": "42ede984-81a9-4ca7-98ae-ccfe02c34ce5",
                                                "sense_id": "513c54a4-8cd8-30cf-884a-89b900338d27",
                                                "text": "Since one of the principal reasons for keeping the puerpera in a recumbent posture is avoidance of strain upon relaxed and weakened supporting structures by a large heavy uterus, the length of the stay in bed is not made a matter of routine"
                                            },
                                            {
                                                "example_id": "741070dd-8b52-4886-958b-e1980b1a5468",
                                                "sense_id": "513c54a4-8cd8-30cf-884a-89b900338d27",
                                                "text": "A statistically significant circadian rhythm for urine volume was revealed in 6 of 10 pregnant women in the first trimester and in 6 of 9 puerperas on the 7th puerperal day."
                                            },
                                            {
                                                "example_id": "b3d8d350-533e-4e52-8874-a2c491f04f2e",
                                                "sense_id": "513c54a4-8cd8-30cf-884a-89b900338d27",
                                                "text": "Abdominal ultrasound of the puerpera usually does not require a full bladder, because the enlarged uterus directly abuts the anterior abdominal wall and can be scanned without difficulty."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a97f14b8-50e3-3ba1-b010-fac7323d9bfe",
                                        "entry_id": "550b0348-0d6e-31f0-861c-1e7f721e28ba",
                                        "glosses": [
                                            "A woman who has recently given birth."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3c38e095-b793-4b60-8928-0c90c8adbafa",
                                                "sense_id": "a97f14b8-50e3-3ba1-b010-fac7323d9bfe",
                                                "text": "An often proved Remedy to bring away what is, or should not be left in the Womb of a Puerpera, though it were Part of a dead Child."
                                            },
                                            {
                                                "example_id": "fc173d71-9e4e-4686-ab2a-fde640343f09",
                                                "sense_id": "a97f14b8-50e3-3ba1-b010-fac7323d9bfe",
                                                "text": "\"I must acknowledge, if Kolletschka's disease and the disease from which I saw so many puerperae die, are identical, then in the puerperae it must be produced by the self-same engendering cause, which produced it in Kolletschka.\""
                                            },
                                            {
                                                "example_id": "8fe87969-5f29-4b4b-a43d-6b584093ae6e",
                                                "sense_id": "a97f14b8-50e3-3ba1-b010-fac7323d9bfe",
                                                "text": "Among the ancient Iranians, the puerpera, like the menstruating woman, was regarded as \"unclean\"."
                                            },
                                            {
                                                "example_id": "36c410b7-bfa8-4c45-a8ef-e3e34de75511",
                                                "sense_id": "a97f14b8-50e3-3ba1-b010-fac7323d9bfe",
                                                "text": "With the exception of the very nearest, — for instance, the husband and the mother of the puerpera, — visitors should be kept away until she has been out of bed for a few days, and even then admitted only in small numbers and one at a time."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b525027e-1831-4f25-bec3-dfd337e40687",
                        "source_entry_id": "bf6f3c86-4e76-32be-afc6-b6c8604c6c67",
