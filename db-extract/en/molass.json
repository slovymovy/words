                        "examples": [
                            {
                                "example_id": "f912e800-1dd8-46bb-8319-1e9818cf3436",
                                "sense_id": "6373f48f-8321-30d8-b5ce-67dfc0eb8d8c",
                                "text": "The limestone is accompanied by a molass or a sort of breccia, consisting of gravel of quartz and schistose rocks cemented with asphalt."
                            },
                            {
                                "example_id": "8eb2f219-a25f-4a09-815a-f15caba85329",
                                "sense_id": "6373f48f-8321-30d8-b5ce-67dfc0eb8d8c",
                                "text": "The geological subsoil is either moraine and sandy molass or, rarely, clay-rich molass marl."
                            },
                            {
                                "example_id": "52cdfb9f-2c2d-49d9-90f1-8033137d44ff",
                                "sense_id": "6373f48f-8321-30d8-b5ce-67dfc0eb8d8c",
                                "text": "In molass basins, the molass formations indicate the variations of strain strength similar to those in foreland fold-thrust belt."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "005609ba-114b-372b-865a-0a2a7078cb8f",
                "word": "molass",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "80818561-034c-40f5-92c7-f438dba6fe86",
