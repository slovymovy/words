                            "Mengenlehre"
                        ],
                        "examples": [
                            {
                                "example_id": "457a5702-34f5-4766-959a-7bdeeefe5ed9",
                                "sense_id": "6d174261-2eec-3677-aaa1-9f85ad7697f4",
                                "text": "„Die Wertebereiche statischer Datenstrukturen bestehen aus dem kartesischen Produkt oder aus der Potenzmenge der Wertebereiche ihrer Komponenten.“"
