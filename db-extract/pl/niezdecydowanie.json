                "pos": "adv",
                "lang_code": "pl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "ccbd3ba4-8ed7-3736-9ea3-34286702aac4",
                        "entry_id": "d73c7919-4a82-390e-80c5-1c8ee7695a9c",
                        "glosses": [
                            "w sposób niezdecydowany"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a70787e5-2155-4130-8f08-b77365ac65a5",
                                "sense_id": "ccbd3ba4-8ed7-3736-9ea3-34286702aac4",
                                "text": "Amerykańskie indeksy zamknęły się wczoraj raczej niezdecydowanie po przecenie z poniedziałku."
                            }
                        ],
                        "sense_index_json": "\"2.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ae0b844d-91fa-430a-b588-eb69e38ad1e3",
                        "source_entry_id": "d73c7919-4a82-390e-80c5-1c8ee7695a9c",
                        "source_sense_id": "ccbd3ba4-8ed7-3736-9ea3-34286702aac4",
                        "target_lang_word": "indecisamente",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "60ad58d7-c9a7-401a-9aa1-2f32b78cb42c",
                        "source_entry_id": "d73c7919-4a82-390e-80c5-1c8ee7695a9c",
                        "source_sense_id": "ccbd3ba4-8ed7-3736-9ea3-34286702aac4",
                        "target_lang_word": "unentschlossen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unentschlossen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c1cfe126-003d-3a64-9d60-712d9ef4828e",
                                        "entry_id": "910d435a-119e-33fa-95cf-d3fdb8b1ae1e",
                                        "glosses": [
                                            "unsicher, wie etwas zu beurteilen oder was zu tun ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89f029c6-90f5-414b-8b9e-8d847eead76e",
                                                "sense_id": "c1cfe126-003d-3a64-9d60-712d9ef4828e",
                                                "text": "„Nur ein knappes Viertel sieht darin kein Problem, der Rest zeigt sich unentschlossen.“"
                                            },
                                            {
                                                "example_id": "8f76c919-426a-4ce2-bf89-451707b39cf4",
                                                "sense_id": "c1cfe126-003d-3a64-9d60-712d9ef4828e",
                                                "text": "„Einige Wähler mögen noch unentschlossen sein, und mancher ist so frei, gar nicht zur Wahl zu gehen.“"
                                            },
                                            {
                                                "example_id": "a42def9b-8c63-4126-981c-1a4ebafe9d0a",
                                                "sense_id": "c1cfe126-003d-3a64-9d60-712d9ef4828e",
                                                "text": "„Vier von sieben Personen waren unentschlossen (50 %) hinsichtlich der wahrgenommenen Schlaflosigkeit.“"
                                            },
                                            {
                                                "example_id": "963460e9-a495-436c-be39-ccbb526eaf3b",
                                                "sense_id": "c1cfe126-003d-3a64-9d60-712d9ef4828e",
                                                "text": "„Gerade wenn sie es mit einem so unentschlossenen Kunden wie Herrn Kunze zu tun hat, kann sich alles immer wieder neu verändern.“"
                                            },
                                            {
                                                "example_id": "b1ea9f0f-0798-4c06-bcc7-123d775948d0",
                                                "sense_id": "c1cfe126-003d-3a64-9d60-712d9ef4828e",
                                                "text": "„Wäre ich wirklich so unentschlossen gewesen, wie ich wohl den Eindruck gemacht hatte, dann wäre dieser Kauf nie zustande gekommen.“"
                                            },
                                            {
                                                "example_id": "da4686b0-9c09-4bec-87d6-06d1c03e49cf",
                                                "sense_id": "c1cfe126-003d-3a64-9d60-712d9ef4828e",
                                                "text": "„Ein ebenso großer Anteil ist zwar noch unentschlossen, zurück zu weniger Homeoffice will aber kaum ein Unternehmen, heißt es in der am Donnerstag veröffentlichten Studie.“"
                                            },
                                            {
                                                "example_id": "18ff0f17-9704-4220-9d3c-1b38dc78317f",
                                                "sense_id": "c1cfe126-003d-3a64-9d60-712d9ef4828e",
                                                "text": "„Die Freien Wähler hingegen sind noch unentschlossen und fordern Antworten auf ‚viele offene Fragen‘.“"
                                            },
                                            {
                                                "example_id": "f9fc1622-7b87-4a29-813a-8ccd5fb4974f",
                                                "sense_id": "c1cfe126-003d-3a64-9d60-712d9ef4828e",
                                                "text": "„Allerdings sind viele Franzosen noch unentschlossen, wem sie bei der Präsidentschaftswahl ihre Stimme geben sollen.“"
                                            },
                                            {
                                                "example_id": "4843711f-37d8-4d94-9e3d-7a338d573b7e",
                                                "sense_id": "c1cfe126-003d-3a64-9d60-712d9ef4828e",
                                                "text": "„Lediglich fünf Prozent lehnten diese Aussage stark ab, neun Prozent lehnten ab und 18 Prozent antworteten unentschlossen mit ‚teils/teils‘.“"
                                            },
                                            {
                                                "example_id": "cfa207e3-83a0-4f7e-98c8-7002f4eb283c",
                                                "sense_id": "c1cfe126-003d-3a64-9d60-712d9ef4828e",
                                                "text": "„Doch der Inhalt ist so lückenhaft und unentschlossen, dass die Anschuldigung kippen könnte.“"
                                            },
                                            {
                                                "example_id": "9ca94bba-2d4c-44df-97f8-05dfeea290a4",
                                                "sense_id": "c1cfe126-003d-3a64-9d60-712d9ef4828e",
                                                "text": "„Sollten unsere unentschlossenen Ministerpräsidenten also nicht vielleicht in Washington nachfragen, was genau die dortigen Ärzte Trump verabreicht haben?“"
                                            },
                                            {
                                                "example_id": "45d61aae-cf25-4bc0-8852-62eb189cb643",
                                                "sense_id": "c1cfe126-003d-3a64-9d60-712d9ef4828e",
                                                "text": "„Doch sicher sein kann man sich nicht; die Zahl der unentschlossenen Wähler ist groß.“"
                                            },
                                            {
                                                "example_id": "8854d39b-b2fe-4888-9d56-4b3e69804f4a",
                                                "sense_id": "c1cfe126-003d-3a64-9d60-712d9ef4828e",
                                                "text": "„Hilfsorganisationen übten scharfe Kritik an der unentschlossenen Haltung der G20-Staaten, die Probleme konkret anzugehen.“"
                                            },
                                            {
                                                "example_id": "bd236d20-ed31-405d-bd0f-bb57a25f74bc",
                                                "sense_id": "c1cfe126-003d-3a64-9d60-712d9ef4828e",
                                                "text": "„Die Finanzmärkte reagierten eher unentschlossen auf die Botschaften vom ‚Superdonnerstag‘ mit EZB-Sitzung und amerikanischen Inflationszahlen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
