                    {
                        "sense_id": "b59ff149-26fa-39ed-8432-99afc86b5289",
                        "entry_id": "fe8cfd32-c713-326b-aa7d-832613dade36",
                        "glosses": [
                            "system, w którym władza powierzana jest osobom kompetentnym"
                        ],
