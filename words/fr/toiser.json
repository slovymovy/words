    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "114c6712-46da-300a-96cf-d0f82c8030fb",
                    "sense_definition": "Regarder quelqu'un de la tête aux pieds avec insistance, dédain ou provocation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "regard",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le garde à l'entrée me <w>toisa</w> avec méfiance avant de vérifier mes papiers."
                        },
                        {
                            "text": "Elle l'a <w>toisé</w> de la tête aux pieds sans prononcer le moindre mot."
                        }
                    ],
                    "common_phrases": [
                        "toiser du regard",
                        "toiser avec mépris"
                    ]
                },
                {
                    "sense_id": "72154ea2-abe4-33de-9e35-1f1ca9ee8859",
                    "sense_definition": "Se regarder mutuellement avec méfiance, dédain ou hostilité.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "regard",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les deux adversaires se <w>toisèrent</w> un long moment avant d'engager le combat."
                        },
                        {
                            "text": "Dans le couloir, les deux rivaux se <w>toisent</w> sans dire un seul mot."
                        }
                    ],
                    "synonyms": [
                        "se regarder en chiens de faïence"
                    ],
                    "common_phrases": [
                        "se toiser en silence"
                    ]
                },
                {
                    "sense_id": "68fc5b97-9bf6-3a53-9c01-46a28365e777",
                    "sense_definition": "Mesurer la taille d'une personne.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mesure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le médecin militaire <w>toisa</w> chaque recrue pour vérifier qu'elle avait la stature requise."
                        },
                        {
                            "text": "À la rentrée, l'infirmière <w>toisait</w> chaque élève afin de suivre sa croissance."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "souvent remplacé par mesurer"
                        }
                    ]
                },
                {
                    "sense_id": "982b0b69-7cb6-3c45-8e6f-7de8a7469160",
                    "sense_definition": "Mesurer les dimensions d'un terrain, d'un mur ou d'un ouvrage à la toise.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mesure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'arpenteur commença à <w>toiser</w> la parcelle pour définir l'étendue exacte de la propriété."
                        },
                        {
                            "text": "Les maçons ont <w>toisé</w> les fondations du vieux rempart avant de continuer le chantier."
                        }
                    ],
                    "synonyms": [
                        "métrer"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "lié à l'ancienne unité de mesure de la toise"
                        }
                    ]
                }
            ]
        }
    ]
}