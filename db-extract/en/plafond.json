                                        "glosses": [
                                            "sufit ozdobiony sztukaterią, płaskorzeźbą, freskiem lub malowidłem olejnym"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1691ca36-0b69-41dd-87f0-1bbc4fc937df",
                                                "sense_id": "8f70a173-dcc6-353b-b40c-f576114ae31b",
                                                "text": "Połyskiwały złocone gzemsy stiuku, a pośrodku sufitu zamajaczał wyblakły plafon"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "ba58aa53-95ad-3129-8287-173955ed20b0",
                                        "entry_id": "55243c4b-7dd9-3e78-b678-7b976aff8f2e",
                                        "glosses": [
                                            "malowidło na tynku, płótnie lub dekoracja stiukowa zajmujące centralną część sufitu lub sklepienia"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0bca0d24-c66b-4b28-b70b-c1b4a43b8e04",
                                                "sense_id": "ba58aa53-95ad-3129-8287-173955ed20b0",
                                                "text": "Połyskiwały złocone gzemsy stiuku, a pośrodku sufitu zamajaczał wyblakły plafon"
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    },
                                    {
                                        "sense_id": "e153db2b-1a68-324b-a0f2-10d741432f52",
                                        "entry_id": "55243c4b-7dd9-3e78-b678-7b976aff8f2e",
                                        "glosses": [
                                            "ogólna kwota akredytywy odnawialnej (rewolwingowej), z której co jakiś czas następuje wypłata części środków (nawiązki)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9156de67-7713-44e9-8d6f-7a10577ae017",
                                                "sense_id": "e153db2b-1a68-324b-a0f2-10d741432f52",
                                                "text": "Przy zastosowaniu akredytywy niekumulatywnej część plafonu może zostać niewykorzystana, jeśli nie wszystkie nawiązki będą wykorzystane w pełnej wysokości."
                                            },
                                            {
                                                "example_id": "d60d9536-af75-42c6-8f0e-a4d1a56fa8f3",
                                                "sense_id": "e153db2b-1a68-324b-a0f2-10d741432f52",
                                                "text": "Połyskiwały złocone gzemsy stiuku, a pośrodku sufitu zamajaczał wyblakły plafon"
                                            }
                                        ],
                                        "sense_index_json": "\"1.3\""
                                    },
                                    {
                                        "sense_id": "0771066e-fc8f-3c67-883a-24b8aed0e663",
                                        "entry_id": "55243c4b-7dd9-3e78-b678-7b976aff8f2e",
                                        "glosses": [
                                            "gra karciana z początku XX wieku, dawniejsza odmiana brydża"
                                        ],
                                        "tags": [
                                            "karc."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e2e4e5ae-d729-4c89-993d-413b7ac061a7",
                                                "sense_id": "0771066e-fc8f-3c67-883a-24b8aed0e663",
                                                "text": "Opowiadał jak jego krewny, bogaty przemysłowiec z Łodzi, świetnie grający w plafona, został zaproszony na Zamek do samego prezydenta Mościckiego na robra. Mościcki, tak głosi fama, choć fuszeruje jak stołowa noga, przepada za plafonem"
                                            },
                                            {
                                                "example_id": "e4106643-c1c3-471a-a3a7-57163dd8ae56",
                                                "sense_id": "0771066e-fc8f-3c67-883a-24b8aed0e663",
                                                "text": "Połyskiwały złocone gzemsy stiuku, a pośrodku sufitu zamajaczał wyblakły plafon"
                                            }
                                        ],
                                        "sense_index_json": "\"1.4\""
                                    }
                                ]
                            }
