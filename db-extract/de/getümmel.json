                ],
                "senses": [
                    {
                        "sense_id": "a3d3631d-8b40-3c9d-84b5-43ff586f26dc",
                        "entry_id": "f3086fcb-5a30-391b-bfe8-5a0c4d4c9132",
                        "glosses": [
                            "Menschenmenge in lebhafter Bewegung; lebhafte Bewegung einer Menschenmenge"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b799f282-5f82-44be-9d75-907867d5371a",
                                "sense_id": "a3d3631d-8b40-3c9d-84b5-43ff586f26dc",
                                "text": "In der Adventszeit (ursprünglich eine stille Bußzeit) ist in den Innenstädten und Kaufhäusern ein Getümmel wie sonst nie."
                            },
                            {
                                "example_id": "48c106e8-c2d6-434c-a67d-4c0ab2959a08",
                                "sense_id": "a3d3631d-8b40-3c9d-84b5-43ff586f26dc",
                                "text": "Etliche Male kam es zu Getümmeln vor dem Ringseer Tor – aber nie wollte der Ball ins Netz."
                            },
                            {
                                "example_id": "9e3fdc0f-23e9-4790-a2fd-c96786ba80a6",
                                "sense_id": "a3d3631d-8b40-3c9d-84b5-43ff586f26dc",
                                "text": "„Ich hatte Angst vor Menschenmassen, aber ausgerechnet hier, in diesem entfesselten, mir fremden Getümmel, spürte ich sie nicht.“"
                            },
                            {
                                "example_id": "decb1a56-a38e-428a-9579-f05c7338d857",
                                "sense_id": "a3d3631d-8b40-3c9d-84b5-43ff586f26dc",
                                "text": "„Ich lief durch das Getümmel, um nach Davids Truck Ausschau zu halten, und kam an einem deutschen Team vorbei, das zum ohrenbetäubenden Sound von Trash Metal in atemberaubender Geschwindigkeit einen Reifen wechselte.“"
                            },
                            {
                                "example_id": "628ccf8d-838d-490d-939e-58b9065cf6ed",
                                "sense_id": "a3d3631d-8b40-3c9d-84b5-43ff586f26dc",
                                "text": "„In diesem Getümmel war alles eins.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "82da65ac-3e57-4298-a1b5-ef44db1478fe",
                        "source_entry_id": "f3086fcb-5a30-391b-bfe8-5a0c4d4c9132",
                        "source_sense_id": "a3d3631d-8b40-3c9d-84b5-43ff586f26dc",
                        "source_sense_description": "Menschenmenge in lebhafter Bewegung; lebhafte Bewegung einer Menschenmenge",
                        "target_lang_word": "tumulte",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tumulte",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9d9c3d5b-10e5-3930-8049-8ca126f338d8",
                                        "entry_id": "fc600090-25eb-3d41-9b14-469dfdee38be",
                                        "glosses": [
                                            "Grand mouvement accompagné de désordre et souvent de bruit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "97948dd5-e849-485e-9158-01881dc54c7c",
                                                "sense_id": "9d9c3d5b-10e5-3930-8049-8ca126f338d8",
                                                "text": "Le bruit dans l’intérieur du château, bruit occasionné par les apprêts de la défense, devint plus considérable, et se changea en tumulte et en clameurs de plus en plus assourdissantes."
                                            },
                                            {
                                                "example_id": "5777194f-2baa-45e3-bc6c-a604782d560b",
                                                "sense_id": "9d9c3d5b-10e5-3930-8049-8ca126f338d8",
                                                "text": "Là-haut sa voix tonnante domine souvent les hurlements de la tempête ou le tumulte des combats ; mais ici elle est douce et mélodieuse."
                                            },
                                            {
                                                "example_id": "97d650ae-93be-48a3-a8b2-68f95db3895f",
                                                "sense_id": "9d9c3d5b-10e5-3930-8049-8ca126f338d8",
                                                "text": "Un instant avant le meurtre, Claude suivait l'empereur; les conjurés l'écartèrent pêle-mêle avec la foule, il s'en fut dans une salle voisine, de là entendit du tumulte, eut peur, et alla se cacher."
                                            },
                                            {
                                                "example_id": "5889c3f8-c375-4bd8-b310-80487a229fc0",
                                                "sense_id": "9d9c3d5b-10e5-3930-8049-8ca126f338d8",
                                                "text": "Et, à cet instant précis, le halètement sourd d'une locomotive et son cri rauque montant dans un jet de vapeur, m'emplirent d'un tel tumulte de sensations heurtées qu'eussé-je vu l'océan surgir et balayer de contraste le hideux mur de l'hôpital Lariboisière, ma stupéfaction n'aurait pas été plus profonde."
                                            },
                                            {
                                                "example_id": "0c81a2cc-303b-43ed-8dd0-3f1d70feb88b",
                                                "sense_id": "9d9c3d5b-10e5-3930-8049-8ca126f338d8",
                                                "text": "J’essuyai mes larmes, repoudrai le bout de mon nez. En un mot, je ravalais ma façade lézardée. Je m'étudiai une dernière fois dans la glace. Personne n'aurait pu soupçonner mon tumulte intérieur."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "19f5be08-ba8d-4077-a4fb-0980d1d1ba44",
                        "source_entry_id": "f3086fcb-5a30-391b-bfe8-5a0c4d4c9132",
                        "source_sense_id": "a3d3631d-8b40-3c9d-84b5-43ff586f26dc",
                        "source_sense_description": "Menschenmenge in lebhafter Bewegung; lebhafte Bewegung einer Menschenmenge",
                        "target_lang_word": "mêlée",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mêlée",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5023d771-57b2-3135-8db6-6081ac6de9f8",
                                        "entry_id": "7d12871c-cdc1-3751-9415-fb354ef74bfc",
                                        "glosses": [
                                            "Combat opiniâtre, où deux troupes s’attaquent corps-à-corps et se mêlent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "666834c5-af27-4a54-8e3c-4d38236894fc",
                                                "sense_id": "5023d771-57b2-3135-8db6-6081ac6de9f8",
                                                "text": "Deux choses déplurent à Cédric dans ce discours : il contenait le mot normand mêlée, pour exprimer un combat général, et il montrait de l’indifférence pour l’honneur de son pays."
                                            },
                                            {
                                                "example_id": "dd5f51ac-b316-4617-b000-d5ba7867364e",
                                                "sense_id": "5023d771-57b2-3135-8db6-6081ac6de9f8",
                                                "text": "Les mêlées aériennes révélèrent une autre particularité qui eut son contre-coup sur le bouleversement social."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3fae6f10-6df8-33ee-b644-736fc55f32b7",
                                        "entry_id": "7d12871c-cdc1-3751-9415-fb354ef74bfc",
                                        "glosses": [
                                            "Lutte entre plusieurs individus."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d3a6d8ce-5a1c-4739-826d-5d66dd58aa94",
                                                "sense_id": "3fae6f10-6df8-33ee-b644-736fc55f32b7",
                                                "text": "Il a perdu son chapeau dans la mêlée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e1621bd2-df91-34a9-975e-f0737e772937",
                                        "entry_id": "7d12871c-cdc1-3751-9415-fb354ef74bfc",
                                        "glosses": [
                                            "Contestation vive entre plusieurs personnes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d9c0de68-e43c-409b-882e-0d656b2d9913",
                                                "sense_id": "e1621bd2-df91-34a9-975e-f0737e772937",
                                                "text": "Comme je vis que la dispute s’échauffait, je me tirai de la mêlée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "001db889-5a34-3f41-a8cc-fb3db4ba8627",
                                        "entry_id": "7d12871c-cdc1-3751-9415-fb354ef74bfc",
                                        "glosses": [
                                            "Guerre."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "38fb2bbb-a859-4717-a84a-603c11aded35",
                                                "sense_id": "001db889-5a34-3f41-a8cc-fb3db4ba8627",
                                                "text": "Dans l’abominable mêlée où les peuples qui se ruent les uns contre les autres déchirent notre Europe, sauvons au moins le drapeau et rassemblons-nous autour."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "db4baf91-1a22-308a-a8c1-5cdb7d5f1b96",
                                        "entry_id": "7d12871c-cdc1-3751-9415-fb354ef74bfc",
                                        "glosses": [
                                            "Regroupement organisé dans lequel les packs adverses se font face et poussent, arc-boutés, dans le but d’avancer et de récupérer le ballon introduit au sol."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c722d81a-9d80-30d8-a865-c79e9f43f0d6",
                                        "entry_id": "7d12871c-cdc1-3751-9415-fb354ef74bfc",
                                        "glosses": [
                                            "Ensemble de choses qui se mélangent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "26317e3f-75c3-4527-801d-55478d072421",
                                                "sense_id": "c722d81a-9d80-30d8-a865-c79e9f43f0d6",
                                                "text": "Il la contemplait, et il y avait entre eux un échange de conversations, une mêlée de souvenirs et quelque chose de plus fort encore : on eût dit que le lien qui les avait unis pendant la vie les tenait attachés à nouveau."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8f4f34a7-fc06-34bb-bf97-c3c12e1e4f04",
                                        "entry_id": "7d12871c-cdc1-3751-9415-fb354ef74bfc",
                                        "glosses": [
                                            "(Dans les méthodes agiles) Réunion quotidienne courte permettant à une équipe de se mettre à jour sur l’avancée des uns et des autres."
                                        ],
                                        "tags": [
                                            "Travail"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "70dfa58a-8dcf-414a-abc5-62426f413795",
                                                "sense_id": "8f4f34a7-fc06-34bb-bf97-c3c12e1e4f04",
                                                "text": "Le tour de parole doit être scrupuleusement respecté pour éviter que la mêlée ne dérive sur des discussions techniques et dépasse la limite de 15 minutes."
                                            }
                                        ]
                                    }
                                ]
                            },
