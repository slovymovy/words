                                    {
                                        "sense_id": "d39e8720-2474-3a50-8173-f4e49ea3aa00",
                                        "entry_id": "86737a7c-b519-3d3c-b4d0-ba34849fe88e",
                                        "glosses": [
                                            "Mécanisme permettant de bloquer automatiquement un mouvement intempestif comme par exemple le dévissage. → voir autofreinage."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c800c0a9-8136-399e-8c36-352e303b4fcc",
                                        "entry_id": "86737a7c-b519-3d3c-b4d0-ba34849fe88e",
                                        "glosses": [
                                            "Mécanisme permettant de bloquer automatiquement un mouvement intempestif comme par exemple le dévissage. → voir autofreinage.",
                                            "Dispositif limitant ou bloquant la rotation de certaines pièces dans un différentiel d’automobile."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a3bb9867-f504-427a-ad8c-c7530523a21d",
                                                "sense_id": "c800c0a9-8136-399e-8c36-352e303b4fcc",
                                                "text": "Dans certains cas, le système se complète d'un répartiteur central (avec un différentiel à autoblocage), de manière à distribuer la puissance du moteur aux ponts moteurs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8e419a49-3a96-3e08-a388-a48b296f9c97",
                                        "entry_id": "86737a7c-b519-3d3c-b4d0-ba34849fe88e",
                                        "glosses": [
                                            "Action de loquer automatiquement une chose, une action, un mouvement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4f147a0b-e6a2-4193-bfdc-cf8d110b054b",
                                                "sense_id": "8e419a49-3a96-3e08-a388-a48b296f9c97",
                                                "text": "Son autoblocage ^([de l’Union Européenne]) prévu et voulu par les Américains fonctionne parfaitement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5ad9dde8-4256-3c10-a855-755cb78e5fca",
                                        "entry_id": "86737a7c-b519-3d3c-b4d0-ba34849fe88e",
                                        "glosses": [
                                            "Blocage automatique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a33a2fc-aa19-4229-9ce7-5dd9e50fe77f",
                                                "sense_id": "5ad9dde8-4256-3c10-a855-755cb78e5fca",
                                                "text": "L’autoblocage se produit lorsqu'une adresse IP est bloquée automatiquement par le logiciel MediaWiki. Les autoblocages sont le résultat d'une tentative d'édition du wiki à partir d'une adresse IP récemment utilisée par un utilisateur bloqué parce que ces deux modifications anonymes ou sous des noms différents ne sont pas autorisées."
                                            }
                                        ]
                                    }
                                ]
                            }
