                        "entry_id": "e8250a6c-46b4-3d1a-a04f-1c7ce52f765c",
                        "glosses": [
                            "Pièce d’armure qui protège les épaules."
                        ],
                        "tags": [
                            "Armurerie"
                        ],
                        "examples": [
                            {
                                "example_id": "2dd13e4c-dc5b-4ae9-93f3-2edc6060e515",
                                "sense_id": "cbda396a-557e-391f-bd13-7174c0c22019",
                                "text": "Les spalières protègent les épaules; le corselet protège le buste, et sa partie inférieure forme pansière; le brassard comme son nom l’indique, couvre le bras, et la coudière ou cubitière le coude."
                            },
                            {
                                "example_id": "4222f6f9-ee6f-4383-b97d-7d7e4aee14d0",
                                "sense_id": "cbda396a-557e-391f-bd13-7174c0c22019",
                                "text": "Le champion avait revêtu une impressionnante armure de plates rutilante, aux spalières hérissées de piquants."
                            }
                        ]
                    }
                ],
