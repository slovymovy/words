                "senses": [
                    {
                        "sense_id": "b5cf5587-a73f-3363-a98c-efcbc4f08508",
                        "entry_id": "d74b78de-0c50-327a-acf2-99556d718848",
                        "glosses": [
                            "computer-aided investigation in databases"
