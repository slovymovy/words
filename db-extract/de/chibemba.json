                "senses": [
                    {
                        "sense_id": "11757f65-0711-3a31-a9fd-52f5bb65cdf3",
                        "entry_id": "3716d511-a679-3d11-8059-936f7eb6ef3d",
                        "glosses": [
                            "eine Sprache, die vor allem in Sambia vom gleichnamigen Volk gesprochen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a14eb78-b967-4727-8ba3-a067c40ab020",
                                "sense_id": "11757f65-0711-3a31-a9fd-52f5bb65cdf3",
                                "text": "„Ob der Vorschlag, alle Missionen in Rhodesien für das Kupferbecken zu einheitlichem Vorgehen zu erziehen, durchführbar ist oder die Trennung in zwei Parteien nach den Hauptsprachen Chibemba und Chinyanja besser ist, muß die Zukunft zeigen.“"
                            },
                            {
                                "example_id": "16b30520-42c7-480c-904d-cee120ef9646",
                                "sense_id": "11757f65-0711-3a31-a9fd-52f5bb65cdf3",
                                "text": "„Chinyanja und Chibemba sind die Hauptsprachen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
