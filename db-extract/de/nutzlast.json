                        "entry_id": "1bd1fecf-34ea-3e73-acb1-1e3b5ff9fa6a",
                        "glosses": [
                            "Last, die von einem Fahrzeug transportiert werden darf"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee65458b-6079-439f-b260-4e55a51e95a8",
                                "sense_id": "756fa4a7-06c3-3e2c-b84b-d4585b155570",
                                "text": "„Der Klimabonus gilt für Pkws/Kombis und Klein-Lkws bis 1,5 Tonnen Nutzlast mit einem CO2-Ausstoß bis 160 g/km.“"
                            },
                            {
                                "example_id": "8cc9d77a-8d9f-44cc-bb23-b9d5eda64962",
                                "sense_id": "756fa4a7-06c3-3e2c-b84b-d4585b155570",
                                "text": "„Die Reichweite mit voller Nutzlast ist auf 3650 km angelegt, wobei die Swiss, welche noch dieses Jahr die Zertifizierung durch die kanadischen Behörden erwartet, im Einsatz laut Bombardier-Zusicherungen mit noch besseren Werten rechnen darf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
