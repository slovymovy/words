                                    {
                                        "sense_id": "b34a17ac-9ef6-3560-8f65-730c09de24bd",
                                        "entry_id": "65ff7f7c-8b65-300b-b7f3-fad10f5dfda1",
                                        "glosses": [
                                            "een periode van 30 minuten"
                                        ],
                                        "tags": [
                                            "tijdrekening"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "29ef8a0d-0856-4596-9f5d-5c0ef3bea334",
                                                "sense_id": "b34a17ac-9ef6-3560-8f65-730c09de24bd",
                                                "text": "Het was in een halfuurtje voor elkaar."
                                            },
                                            {
                                                "example_id": "bc2e970b-6075-482a-8cd2-b333e6d1a7b3",
                                                "sense_id": "b34a17ac-9ef6-3560-8f65-730c09de24bd",
                                                "text": "Ik bleef wel een halfuur op de stoep zitten en voelde mijn benen en armen stijf worden."
                                            },
                                            {
                                                "example_id": "b1904c95-2346-4a04-898e-345daf7ba827",
                                                "sense_id": "b34a17ac-9ef6-3560-8f65-730c09de24bd",
                                                "text": "Met een plons sprong Goldie naast me het hete water in. Goldie en Barbie hadden me binnen een halfuur al ingehaald en waren ook gearriveerd bij de rivier."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "299d7c12-2998-4df8-bf93-305f44aed03e",
                        "source_entry_id": "cefb9282-f281-3702-9e46-6dec55fbc520",
                        "source_sense_id": "a2480dfa-5c74-3f0e-95e6-011572cd0fda",
