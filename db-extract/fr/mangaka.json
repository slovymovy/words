        "fr-extract.jsonl": [
            {
                "entry_id": "33734153-82d9-32a7-8f96-18f243aa0c26",
                "word": "mangaka",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "01f6f894-02c4-4b90-897e-033a9b0ff5a7",
                        "entry_id": "33734153-82d9-32a7-8f96-18f243aa0c26",
