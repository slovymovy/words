                "senses": [
                    {
                        "sense_id": "54c67909-0bde-375b-8d66-e451340bb08f",
                        "entry_id": "0743b9dc-e361-3d06-b4e7-2a2692b3916d",
                        "glosses": [
                            "spiralförmige oder irreguläre Galaxie mit einem sehr hellen Galaxienkern, welcher charakteristische Emissionslinien zeigt, die nicht durch Sterne angeregt werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6fa8fbad-57fd-4ba9-95a4-ea18c41c186a",
                                "sense_id": "54c67909-0bde-375b-8d66-e451340bb08f",
                                "text": "„Quasare und Seyfertgalaxien sind die wohl am besten untersuchten aktiven Galaxien und an ihnen wurde das Standard-Akkretionsmodell für supermassive schwarze Löcher entwickelt.“"
                            },
                            {
                                "example_id": "a84ed50d-6908-49e2-94f9-9bdbf20b52c8",
                                "sense_id": "54c67909-0bde-375b-8d66-e451340bb08f",
                                "text": "„Quasare gehören wie die schwächeren Seyfertgalaxien zur Klasse der aktiven Galaxien.“"
                            },
                            {
                                "example_id": "37be3a86-82cf-49a9-9400-19a10451df26",
                                "sense_id": "54c67909-0bde-375b-8d66-e451340bb08f",
                                "text": "„Prominentestes Beispiel für eine solche Seyfertgalaxie ist Messier 77 (NGC 1068), welche Seyfert selbst entdeckt hat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
