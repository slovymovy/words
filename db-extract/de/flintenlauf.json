                                        "sense_id": "05347f53-9011-3f5e-8d92-d6ee7966b6f3",
                                        "entry_id": "2347726e-b0e3-3770-98fe-0574c3054b6b",
                                        "glosses": [
                                            "Alternative form of gunbarrel."
                                        ],
                                        "tags": [
