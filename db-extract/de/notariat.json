                            {
                                "example_id": "c20d37bd-3c36-461e-9693-947ed92e5bcd",
                                "sense_id": "c8c34883-03e4-3d05-a357-6e08c14b092d",
                                "text": "Heutzutage wird das Notariat nicht mehr vererbt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c01ea270-1f0c-367f-a459-dfdafa134d87",
                        "entry_id": "f1138bf5-7235-3384-8b8f-846754b61978",
                        "glosses": [
