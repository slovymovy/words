                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df966c7e-91ea-41c7-80cf-3031523afb3f",
                                                "sense_id": "e10d01ee-c11f-33f6-8d88-c05282b07ca9",
                                                "text": "Quallen schweben im Wasser. Pollen schweben in der Luft. Luftballons auch."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7a9aa8a6-8362-3111-a3d5-d0f41666de0d",
                                        "entry_id": "6fe1ac9e-7067-32c8-8b86-d20af5e04f36",
                                        "glosses": [
                                            "in einem Medium treiben",
                                            "langsam fliegen, sich langsam durch die Luft bewegen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed02c411-999c-412c-aa02-452ed00a7530",
                                                "sense_id": "7a9aa8a6-8362-3111-a3d5-d0f41666de0d",
                                                "text": "„Dieses den jungen Goethe ergreifende Verlangen, sich in den unendlichen Luftraum zu stürzen und über den schauerlichen Abgründen zu schweben, frei zu werden wie der Adler im Äther, beflügelt und bewegt auch die heutigen Delta- und Gleitschirmpiloten, die dank des opferbereiten Wagemuts Lilienthals und anderer Flugpioniere diesen Traum heute zu realisieren vermögen.“"
                                            },
                                            {
                                                "example_id": "51b5abac-c645-47a8-97c0-19780368298c",
                                                "sense_id": "7a9aa8a6-8362-3111-a3d5-d0f41666de0d",
                                                "text": "Das Segelflugzeug schwebte dem Sonnenuntergang entgegen."
                                            },
                                            {
                                                "example_id": "5fabe43f-c43f-48dc-afa2-5231d28c59ec",
                                                "sense_id": "7a9aa8a6-8362-3111-a3d5-d0f41666de0d",
                                                "text": "Die Schneeflocke ist zu Boden geschwebt."
                                            }
                                        ],
                                        "sense_index_json": "\"1a\""
                                    },
                                    {
                                        "sense_id": "ebcf6488-0056-3f95-85ad-592706d20a23",
                                        "entry_id": "6fe1ac9e-7067-32c8-8b86-d20af5e04f36",
                                        "glosses": [
                                            "in einem Medium treiben",
                                            "auf der Stelle fliegen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63e3d78d-95f4-400b-a7fc-d9ca8b7f3f74",
                                                "sense_id": "ebcf6488-0056-3f95-85ad-592706d20a23",
                                                "text": "Hubschrauber können auf der Stelle schweben."
                                            }
                                        ],
                                        "sense_index_json": "\"1b\""
                                    },
                                    {
                                        "sense_id": "e4aa81d4-6cf0-37d1-813e-a6bcef728b21",
                                        "entry_id": "6fe1ac9e-7067-32c8-8b86-d20af5e04f36",
                                        "glosses": [
                                            "noch nicht entschieden sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a40b8f8-46ed-4e2b-ba85-2d0ffed3ff46",
                                                "sense_id": "e4aa81d4-6cf0-37d1-813e-a6bcef728b21",
                                                "text": "Karl schwebt in der Firma zwischen Beförderung und Rauswurf."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "c4496647-d964-3d56-a0f4-7332168fac39",
