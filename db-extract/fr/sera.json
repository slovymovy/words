                "senses": [
                    {
                        "sense_id": "5264a2b9-9dcb-3b2c-9ee2-330d66395e08",
                        "entry_id": "f6c227bc-cfd3-37b7-96fe-aa133d582b80",
                        "glosses": [
                            "Troisième personne du singulier du futur du verbe être."
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "4369b085-ecd4-4625-b908-930c8fd9c085",
                                "sense_id": "5264a2b9-9dcb-3b2c-9ee2-330d66395e08",
                                "text": "Et maintenant, si c’est que vous êtes amateur de suspense, le mieux est que je me reporte au propre récit de la gamine. Ayez crainte : il sera fidèle."
                            },
                            {
                                "example_id": "e9cf2196-dad9-498b-8f0a-c66d0dde48cc",
                                "sense_id": "5264a2b9-9dcb-3b2c-9ee2-330d66395e08",
                                "text": "La députation demanda la liberté des cultes et la conservation des églises et des biens de fondation : non, tout sera théophilanthropisé."
                            },
                            {
                                "example_id": "648d8e2d-4d5a-488c-89aa-22396fd425c2",
                                "sense_id": "5264a2b9-9dcb-3b2c-9ee2-330d66395e08",
                                "text": "— Ce sera ?\n— Je voudrais un verre de vin."
                            },
                            {
                                "example_id": "a335a7ec-7435-4672-8c34-3cc74e72b6d7",
                                "sense_id": "5264a2b9-9dcb-3b2c-9ee2-330d66395e08",
                                "text": "Le fantôme opalin du garçon interrompit à propos ce questionnaire embarrassant.\n— Ça s’ra, ces m’sieurs-dames ?"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
