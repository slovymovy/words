                                        "entry_id": "a096f687-9605-372d-a898-0cf0fa450680",
                                        "glosses": [
                                            "rozbieżność między znaczeniem wyrazu a jego morfologiczną strukturą, która była uformowana przez znaczenie pierwotne"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46ab309c-6d34-44dd-b99e-a03cbfbd9780",
                                                "sense_id": "864ef234-61a6-3db4-b76a-cd47d2cfaf73",
                                                "text": "Przykładem leksykalizacji jest transformacja skrótowców w samodzielnie funkcjonujące rzeczowniki, np. PC – pecet, WF – wuef, ND – endek"
                                            }
                                        ],
