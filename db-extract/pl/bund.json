                "senses": [
                    {
                        "sense_id": "eedf52fa-f6ed-3ad4-a6db-f63c0c2a2d0f",
                        "entry_id": "a6f27bec-dd7b-378f-b43c-e8874fc6c1de",
                        "glosses": [
                            "skrótowa nazwa Powszechnego Żydowskiego Związku Robotniczego na Litwie, w Polsce i Rosji"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "625f4adf-5835-4f19-9dd7-8ce21d2255cf",
                                "sense_id": "eedf52fa-f6ed-3ad4-a6db-f63c0c2a2d0f",
                                "text": "Po zakończeniu pierwszej wojny światowej w związku z rozpadem wielonarodowego Imperium Rosyjskiego i powstaniem odrodzonego państwa polskiego, Bund zmuszony był dostosować się do nowej rzeczywistości"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e822f8ce-b70a-4edc-a61a-7b114c86c579",
                        "source_entry_id": "a6f27bec-dd7b-378f-b43c-e8874fc6c1de",
                        "source_sense_id": "eedf52fa-f6ed-3ad4-a6db-f63c0c2a2d0f",
