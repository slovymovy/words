                "senses": [
                    {
                        "sense_id": "c419f2d1-d3f8-3023-990b-8ac1d3419027",
                        "entry_id": "67cf03eb-7836-3ec6-9a2a-cc2fe9222d0e",
                        "glosses": [
                            "niet uit te drukken door een breuk van twee gehele getallen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e4d8e67-0642-47ef-8e72-d8379f1604bf",
                                "sense_id": "c419f2d1-d3f8-3023-990b-8ac1d3419027",
                                "text": "Met Pi kunnen de omtrek en diameter van een cirkel worden berekend. Het is een irrationaal getal, wat inhoudt dat het een eindeloos lange reeks cijfers achter de komma heeft. Meestal wordt het afgerond tot 3,14159."
                            },
                            {
                                "example_id": "31b80453-53c7-402b-bb93-d828bbca7187",
                                "sense_id": "c419f2d1-d3f8-3023-990b-8ac1d3419027",
                                "text": "Vandaag is het Fibonacci-dag! De rij van Fibonacci is innig verbonden met het bijzondere getal φ, beter bekend als de gulden snede. Hier lees je waarom φ wordt gezien als het meest irrationale getal van allemaal."
                            }
                        ]
                    }
