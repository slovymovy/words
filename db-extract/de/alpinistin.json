                                "target_senses": [
                                    {
                                        "sense_id": "6c7a8090-66cf-348f-b34e-514cb0491454",
                                        "entry_id": "b99384e0-852b-3e86-a593-5f73138f9007",
                                        "glosses": [
                                            "A mountain climber, especially in the European Alps or in ranges of similar ruggedness and elevation."
                                        ],
                                        "tags": [
                                            "capitalized",
                                            "sometimes"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "624c9565-b4fc-488d-80de-4d4bad851cbf",
                                                "sense_id": "6c7a8090-66cf-348f-b34e-514cb0491454",
                                                "text": "The Swiss geologist and alpinist, Horace Bénédict de Saussure, the first to make the ascent of Mont Blanc (Aug. 3, 1787), is to have erected in his honor a statue in the village of Chamounix."
                                            },
                                            {
                                                "example_id": "6f8685a4-7554-4ea6-8711-e3e70e7284f7",
                                                "sense_id": "6c7a8090-66cf-348f-b34e-514cb0491454",
                                                "text": "A cross in the sky could have appeared. . . . The famous Alpinist Edward Whymper saw a similar effect on the Matterhorn."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "796ca8d8-42c5-3b79-9a0b-9b334fb853d2",
                                        "entry_id": "b99384e0-852b-3e86-a593-5f73138f9007",
                                        "glosses": [
                                            "A downhill skier who practises the sport on high mountains."
                                        ],
                                        "tags": [
                                            "capitalized",
                                            "sometimes"
                                        ],
                                        "examples": []
                                    },
