                                    {
                                        "sense_id": "633ffa98-d375-3d21-b4ff-cfdfd1cc40cf",
                                        "entry_id": "3c62d711-df66-3ce7-8894-2a233cb14959",
                                        "glosses": [
                                            "A bile pigment that is a product of the breakdown of the heme portion of hemoglobin (which occurs within macrophages as they digest red blood cells), and which is responsible for the yellowish color seen in bruises. Extremely high levels of bilirubin may cause jaundice."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "22e05798-5abd-4f35-8f7b-23074340937a",
                                                "sense_id": "633ffa98-d375-3d21-b4ff-cfdfd1cc40cf",
                                                "text": "The doctors said this was very common, just her new-born liver catching up with the rest of her — the build-up of bilirubin in her blood. The substance red blood cells produce when broken down."
                                            }
                                        ]
                                    }
