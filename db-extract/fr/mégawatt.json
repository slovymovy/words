                    {
                        "translation_id": "1adf202c-1120-4321-afcf-5c23f5744f1b",
                        "source_entry_id": "af40e338-15ae-3cec-a9c7-ff7f7523f8cd",
                        "source_sense_id": "d3793863-767a-3fbd-9eba-2d46540e2774",
