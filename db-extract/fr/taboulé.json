                                    {
                                        "sense_id": "47ae6825-2529-3cc3-8967-47d3a6852385",
                                        "entry_id": "02e2128c-8d42-3b2e-be5d-f6793f8f4124",
                                        "glosses": [
                                            "Libanese salade met bulgur"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b084eaf7-eac9-4987-a1ba-817447afea63",
                                                "sense_id": "47ae6825-2529-3cc3-8967-47d3a6852385",
                                                "text": "Begin het jaar goed met deze taboulé met feta, kersen en couscous. Wij krijgen al trek bij de gedachten. Smullen maar!"
                                            },
                                            {
                                                "example_id": "13b40223-697f-49e9-80a8-7ca89643e729",
                                                "sense_id": "47ae6825-2529-3cc3-8967-47d3a6852385",
                                                "text": "Het valt ons overigens wel op dat hier geen bulgur is gebruikt (ze beweren dat het met cracked wheat ofwel bulgur gemaakt wordt), maar couscous; misschien wel makkelijker om mee te werken, maar het maakt het gerecht wel droger. Dat geldt met name voor de kibbeh nayeh, waarbij opnieuw de bulgur vervangen is door couscous. Verder zijn er taboulé (met couscous) en baba ghanuj (auberginedip) en hummus (kikkererwtendip), beide erg lekker; tahin die wat sterk van smaak is, en ten slotte labneh, wat neerkomt op aangemaakte yoghurt. Het mooiste erbij is het brood, zo uit de oven, opgeblazen als een kussen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
