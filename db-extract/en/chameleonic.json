                                "example_id": "fe7c5382-d475-47cd-9509-90c22bde6db1",
                                "sense_id": "ba336e85-261c-3d21-891f-faa13378e2d1",
                                "text": "David Johansen, the chameleonic and charismatic vocalist who fronted the New York Dolls and found solo success under the moniker Buster Poindexter, died on Friday, his publicist confirmed to NPR."
                            }
                        ]
                    }
