                        "tags": [],
                        "examples": [
                            {
                                "example_id": "78da47d4-a8b2-46e6-ab07-550b0395af51",
                                "sense_id": "3badf4fc-c61c-341f-9d95-da1e1063fb1c",
                                "text": "Туда, где может возникнуть опасность малейшего загрязнения волжской воды, геологов и газовиков близко не подпускают."
                            }
                        ]
                    },
                    {
                        "sense_id": "ac104c04-4654-3219-acd2-e9762cd3c6db",
                        "entry_id": "d5a0106b-788a-3eea-9a45-d63ba71eaa78",
                        "glosses": [
                            "разг. газовый пистолет"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3252db20-b474-46d4-8979-9c53e7903b8e",
                                "sense_id": "ac104c04-4654-3219-acd2-e9762cd3c6db",
                                "text": "Чингиз, отступая, принялся раз за разом методично стрелять из своего газовика."
                            }
                        ]
                    }
