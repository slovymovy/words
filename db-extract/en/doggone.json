                "pos": "adj",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "d1529cdc-9f80-4388-b5d2-480e6e056a3f",
                        "entry_id": "6963379a-6eaa-32de-af69-52bcc6087260",
                        "tags": [
                            "superlative"
                        ],
                        "form": "doggonest"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6a2da28a-c5fe-3166-bfc3-67844339d3ad",
                        "entry_id": "6963379a-6eaa-32de-af69-52bcc6087260",
                        "glosses": [
                            "Euphemistic form of goddamned."
                        ],
                        "tags": [
                            "US",
                            "dialectal",
                            "euphemistic",
                            "form-of",
                            "no-comparative"
                        ],
                        "examples": [
                            {
                                "example_id": "4174bfa1-32ac-4797-8ceb-fba719268057",
                                "sense_id": "6a2da28a-c5fe-3166-bfc3-67844339d3ad",
                                "text": "I lost my doggone keys again!"
                            },
                            {
                                "example_id": "e5395527-e51f-4b9b-842a-6d5ffb857d56",
                                "sense_id": "6a2da28a-c5fe-3166-bfc3-67844339d3ad",
                                "text": "\"Hist!\" exclaimed Black George. \"I'll be dog-gone ef [if] I don't think we're chawed [chewed] up this time, sure as sin!\""
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c39f3929-613d-4e89-b8db-19f5046916ad",
                        "source_entry_id": "6963379a-6eaa-32de-af69-52bcc6087260",
                        "source_sense_id": "6a2da28a-c5fe-3166-bfc3-67844339d3ad",
                        "source_sense_description": "Translations",
                        "target_lang_word": "sacré",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sacré",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e172b73d-0c60-36d5-a9b6-6af24c144cc1",
                                        "entry_id": "94c9be8e-0e28-3fc8-bb08-cab634237094",
                                        "glosses": [
                                            "Ce à quoi l’on doit un respect absolu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f94eee01-80fa-48b1-84aa-5f8685d585a9",
                                                "sense_id": "e172b73d-0c60-36d5-a9b6-6af24c144cc1",
                                                "text": "Le professeur Durkheim disait dernièrement à la Société française de philosophie (11 février 1906) qu’on ne saurait supprimer le sacré dans le moral et que ce qui caractérise le sacré est d’être incommensurable avec les autres valeurs humaines ; […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ac4b942b-4584-3451-971e-dbc4281cbbb4",
                                        "entry_id": "94c9be8e-0e28-3fc8-bb08-cab634237094",
                                        "glosses": [
                                            "Ce qui relève du religieux, du divin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e1c4c425-976e-4032-bb07-601095406d2f",
                                                "sense_id": "ac4b942b-4584-3451-971e-dbc4281cbbb4",
                                                "text": "Le sacré et le profane."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sacré",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3d07d7ed-a75d-3e09-9df8-11f9edc183e2",
                                        "entry_id": "20b4a162-0625-399a-932f-b3467d1f6c20",
                                        "glosses": [
                                            "Qui concerne la religion, qui a pour objet le culte de Dieu ou des dieux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bfcfd5ac-ed9f-4246-899d-82eec46cb6aa",
                                                "sense_id": "3d07d7ed-a75d-3e09-9df8-11f9edc183e2",
                                                "text": "Les choses sacrées. — Les lieux sacrés."
                                            },
                                            {
                                                "example_id": "332c7c26-b2cd-47a8-b889-c1d2022fdf23",
                                                "sense_id": "3d07d7ed-a75d-3e09-9df8-11f9edc183e2",
                                                "text": "Les védas sont les livres sacrés de l’Inde. — Le Zend-Avesta est le livre sacré des sectateurs de Zoroastre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b68b240c-33b9-3098-967c-fbe105388b67",
                                        "entry_id": "20b4a162-0625-399a-932f-b3467d1f6c20",
                                        "glosses": [
                                            "Religieux, cultuel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "651ed6b1-6e4c-4f54-a5e6-0fa892d6ecfd",
                                                "sense_id": "b68b240c-33b9-3098-967c-fbe105388b67",
                                                "text": "Qui n’a même reconnu un vestige des anciens cultes païens dans ces libations faites à des fontaines sacrées que leurs propriétés curatives ont rendues célèbres ?"
                                            },
                                            {
                                                "example_id": "00d1b0be-ec2c-4297-ab34-c711b3a29445",
                                                "sense_id": "b68b240c-33b9-3098-967c-fbe105388b67",
                                                "text": "Le bœuf sacré des égyptiens. — Les oies sacrées du Capitole. — Le feu sacré de Vesta."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e8c66fb7-23e1-3254-8a95-86dfc24e8cbe",
                                        "entry_id": "20b4a162-0625-399a-932f-b3467d1f6c20",
                                        "glosses": [
                                            "Vénéré ; vénérable ; qu’on ne doit pas violer, enfreindre ou divulguer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "42731544-44c7-4db7-935a-43e476a5bb22",
                                                "sense_id": "e8c66fb7-23e1-3254-8a95-86dfc24e8cbe",
                                                "text": "La Convention, au milieu de sa lutte terrible contre le monde, contre la France qu’elle sauvait malgré elle, parmi les dangers personnels qu’elle courait, assassinée en détail, décimée et mutilée, elle ne lâcha pas prise, elle poursuivit obstinément ce sujet saint et sacré de l’éducation populaire; […]."
                                            },
                                            {
                                                "example_id": "8fe0d806-faf7-4af0-a4d5-f815a945c319",
                                                "sense_id": "e8c66fb7-23e1-3254-8a95-86dfc24e8cbe",
                                                "text": "Tant qu’on n’enseignera pas une arachnologie dans les écoles, tant que les araignées ne seront pas regardées dans chaque maison comme des animaux sacrés, et conservées avec le même respect que les hirondelles et les cigognes, l’agriculture n’atteindra jamais à un haut degré de perfection."
                                            },
                                            {
                                                "example_id": "8f59a942-efd3-498a-a46b-6733b0e5776c",
                                                "sense_id": "e8c66fb7-23e1-3254-8a95-86dfc24e8cbe",
                                                "text": "J’ignorais […] quelles abominations pouvaient s’y perpétrer et jusqu’où se dégradaient les sentiments les plus sacrés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2c62deb5-f522-343a-96a8-9f547a06a9f8",
                                        "entry_id": "20b4a162-0625-399a-932f-b3467d1f6c20",
                                        "glosses": [
                                            "Inviolable, intouchable, tabou."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1439bd90-5c41-4de2-a7a1-699cb9230f01",
                                                "sense_id": "2c62deb5-f522-343a-96a8-9f547a06a9f8",
                                                "text": "L’homme n’est plus pour l’homme un objet si sacré : on a une idée moins grande de sa dignité quand l’autorité publique se joue de sa vie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "48f8b226-1fa9-3c72-924f-597925593020",
                                        "entry_id": "20b4a162-0625-399a-932f-b3467d1f6c20",
                                        "glosses": [
                                            "Sert d’épithète à des termes d’injure ou d’admiration ironique, pour leur donner plus de force."
                                        ],
                                        "tags": [],
                                        "note": "S'utilise aussi bien péjorativement que méliorativement",
                                        "examples": [
                                            {
                                                "example_id": "deb1e445-e767-4301-b970-ee3bff4a81d1",
                                                "sense_id": "48f8b226-1fa9-3c72-924f-597925593020",
                                                "text": "Je dis toujours : « Sacré mâtin ! » C’est une habitude ; elle me suit jusque dans son salon.\n« Mossieu Vingtras, me crie-t-il d’un bout de la table à l’autre, où avez-vous été élevé ? Est-ce que vous avez gardé les vaches ?"
                                            },
                                            {
                                                "example_id": "7c963dd5-bef6-4a83-b9f4-672391e7a33e",
                                                "sense_id": "48f8b226-1fa9-3c72-924f-597925593020",
                                                "text": "Sacré Gérard ! Il nous étonnera toujours… - Sacré coquin !"
                                            },
                                            {
                                                "example_id": "3a7deb2a-3081-4a06-b97d-404bada05282",
                                                "sense_id": "48f8b226-1fa9-3c72-924f-597925593020",
                                                "text": "C’est un sacré filou!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7800eb0d-e395-34ba-a880-7c3505a709e0",
                                        "entry_id": "20b4a162-0625-399a-932f-b3467d1f6c20",
                                        "glosses": [
                                            "Relatif au sacrum, sacral."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "18b782a6-51ff-4a31-a495-34147f7a6c14",
                                                "sense_id": "7800eb0d-e395-34ba-a880-7c3505a709e0",
                                                "text": "[…] elle présente une surface ovalaire à grand axe transversal, destinée à s'articuler avec la 5ᵉ lombaire, et, en arrière d’elle, l’orifice supérieur du canal sacré, triangulaire à base antérieure ;"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "10e0bd66-fc3a-3534-a31e-250846538b33",
                                        "entry_id": "20b4a162-0625-399a-932f-b3467d1f6c20",
                                        "glosses": [
                                            "Fameux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "752944d1-06fc-4559-9c0a-c3265a560a84",
                                                "sense_id": "10e0bd66-fc3a-3534-a31e-250846538b33",
                                                "text": "C’était une sacrée fête !"
                                            },
                                            {
                                                "example_id": "b437cee5-253b-4615-b1d5-4be8137aca64",
                                                "sense_id": "10e0bd66-fc3a-3534-a31e-250846538b33",
                                                "text": "Ah, lui, c’est un sacré type !"
                                            },
                                            {
                                                "example_id": "223737d5-f9b8-4a0b-9226-88d1bba4f9f8",
                                                "sense_id": "10e0bd66-fc3a-3534-a31e-250846538b33",
                                                "text": "Il a vraiment un sacré caractère !"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sacré",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d1aa7479-3660-3cb7-9eb7-7bc0ebfb56de",
                                        "entry_id": "c057a66c-c26f-3a49-8c39-3debb9fb0942",
