                "senses": [
                    {
                        "sense_id": "ce29da38-ce8d-3dcf-80f8-96dcf0c86479",
                        "entry_id": "cfdfa4b2-1991-33ec-bfd9-864decf9048e",
                        "glosses": [
                            "Fait de placer hors convention avec l’Assurance maladie un médecin, un centre de santé, une clinique, de ce fait les patients ne bénéficient d'aucun remboursement de la part de l'assurance maladie."
                        ],
                        "tags": [
                            "France"
                        ],
                        "examples": [
                            {
                                "example_id": "9bdb7b40-8ccb-4db2-82e5-2ed17797be33",
                                "sense_id": "ce29da38-ce8d-3dcf-80f8-96dcf0c86479",
                                "text": "Le déconventionnement d’un centre de santé implique que l’Assurance Maladie ne prend en charge les soins pratiqués dans ce centre que sur une base très faible, le tarif d’autorité, soit par exemple pour une consultation d’ophtalmologie à 30 € un remboursement de 1,22 €."
                            },
                            {
                                "example_id": "320565b5-e214-4f49-a6c4-b94abc6c04f6",
                                "sense_id": "ce29da38-ce8d-3dcf-80f8-96dcf0c86479",
                                "text": "Si la logique de déconventionnement consiste à permettre de pratiquer des prix plus élevés que ceux négociés avec la Sécu, cela signifie qu’il faut trouver suffisamment de patients prêts à payer bien plus, par exemple 50 euros par consultation et, surtout, acceptant de ne pas être remboursés."
                            },
                            {
                                "example_id": "36be8543-a97e-445f-b3c5-cc2379c7545d",
                                "sense_id": "ce29da38-ce8d-3dcf-80f8-96dcf0c86479",
                                "text": "Face à l’échec des négociations entre les médecins et l’Assurance maladie au sujet du tarif des consultations, un syndicat de praticiens pousse au déconventionnement massif afin de pouvoir librement fixer les prix."
                            }
                        ]
                    }
