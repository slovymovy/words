                {
                    "sense_id": "0bc65c48-41fc-3100-b441-e03c62a086df",
                    "sense_definition": "A cap with small holes attached to a spout, such as on a watering can, used to produce a gentle spray.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "tool_part",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Make sure the <w>rose</w> is firmly attached to the watering can before you start.",
                            "target_lang_translations": {
                                "ru": "Убедитесь, что <w>насадка-разбрызгиватель</w> прочно прикреплена к лейке, прежде чем начинать.",
                                "zh": "开始前请确保<w>喷头</w>已牢固地安装在喷壶上。"
                            }
                        },
                        {
                            "text": "He cleaned the <w>rose</w> to ensure the water flowed evenly over the seedlings.",
                            "target_lang_translations": {
                                "ru": "Он почистил <w>ситечко</w>, чтобы вода равномерно лилась на рассаду.",
                                "zh": "他清理了<w>喷头</w>，以确保水能均匀地洒在幼苗上。"
                            }
                        }
                    ],
                    "synonyms": [
                        "nozzle"
                    ],
                    "target_lang_definitions": {
                        "ru": "Насадка с мелкими отверстиями, надеваемая на носик лейки для создания мягкой струи.",
                        "zh": "安装在喷壶嘴上的带有小孔的盖子，用于产生柔和的喷雾。"
                    },
                    "translations": {
                        "ru": [
