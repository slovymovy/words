                            {
                                "example_id": "7752c394-803e-445d-b42f-5eb93757b9f7",
                                "sense_id": "0e0b2af9-b65a-3fc7-b0a9-0d771a9feaca",
                                "text": "Het dodental van deze aardbeving loopt in de honderden."
                            },
                            {
                                "example_id": "44256fba-3cf9-4a54-9168-834726f37ecd",
                                "sense_id": "0e0b2af9-b65a-3fc7-b0a9-0d771a9feaca",
                                "text": "Het dodental in Zweden is ook veel hoger dan in naburige Scandinavische landen, die allemaal strengere beperkende maatregelen hebben opgelegd."
                            },
                            {
                                "example_id": "58a6822a-8ba7-4a2d-94e7-439b3e1ce57e",
                                "sense_id": "0e0b2af9-b65a-3fc7-b0a9-0d771a9feaca",
                                "text": "Verschillende historici hebben schattingen gemaakt van het totale dodental ten gevolge van Japans geweld in de periode 1895-1945. Historicus Michael Richard Daniell Foot schatte de burgerdoden tussen 10 en 20 miljoen. Historicus Mark Felon beweerde dat er 30 miljoen mensen omkwamen"
                            }
                        ]
