            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3c7bd3e5-a6fe-3970-99bb-234ebecc563e",
                    "sense_definition": "Systematisch geordnetes Verzeichnis von Waren, Produkten oder Dienstleistungen, meist mit Beschreibungen und Preisen.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "verzeichnis",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sie hat sich einen neuen <w>Katalog</w> für Möbel nach Hause schicken lassen."
                        },
                        {
                            "text": "Der neue <w>Katalog</w> enthält viele preisgünstige Angebote für den kommenden Sommer."
                        }
                    ],
                    "synonyms": [
                        "Verzeichnis",
                        "Liste"
                    ],
                    "common_phrases": [
                        "im Katalog blättern",
                        "einen Katalog bestellen"
                    ]
                },
                {
                    "sense_id": "ec599e02-61a7-3617-b2e0-db861c5a60a7",
                    "sense_definition": "Systematische Bestandsliste von Werken, Büchern oder Ausstellungsstücken in einer Bibliothek oder einem Museum.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "verzeichnis",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Alle Werke mit Erscheinungsjahr ab 1971 sind in diesem <w>Katalog</w> verzeichnet."
                        },
                        {
                            "text": "Ich konnte das gesuchte Buch im elektronischen <w>Katalog</w> der Universitätsbibliothek nicht finden."
                        }
                    ],
                    "synonyms": [
                        "Verzeichnis",
                        "Liste"
                    ],
                    "common_phrases": [
                        "im Katalog suchen",
                        "den Katalog durchsuchen"
                    ]
                },
                {
                    "sense_id": "446e5a99-3f31-358a-ad97-a9538cd22ee1",
                    "sense_definition": "Zusammengestellte Übersicht oder systematische Sammlung von Maßnahmen, Kriterien oder Regelungen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "verzeichnis",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die Regierung hat einen umfangreichen <w>Katalog</w> von wirtschaftlichen Maßnahmen vorgelegt."
                        },
                        {
                            "text": "Vor dem Beschluss der neuen Richtlinie muss die Kommission den <w>Katalog</w> an Anforderungen prüfen."
                        }
                    ],
                    "synonyms": [
                        "Liste",
                        "Verzeichnis"
                    ],
                    "common_phrases": [
