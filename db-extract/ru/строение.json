                                                "text": "Dit gebouw is in jugendstil opgetrokken."
                                            },
                                            {
                                                "example_id": "86028499-bbab-434a-9521-8947466b0a48",
                                                "sense_id": "84a91fe8-8a25-3315-8107-6e9565b12b72",
