                "senses": [
                    {
                        "sense_id": "0efd8ad3-4441-30c4-8e5c-3517630f6af7",
                        "entry_id": "79df79af-db35-3157-88a9-31adfd5562ee",
                        "glosses": [
                            "mit Strom von einem Akkumulator betriebenes Fahrzeug"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "66e374e4-dac4-4e06-94d1-8e8032960c59",
                                "sense_id": "0efd8ad3-4441-30c4-8e5c-3517630f6af7",
                                "text": "„Seine neueren Elektromodelle schaffen mit einer Batterieladung um die 100 Kilometer.“"
                            },
                            {
                                "example_id": "3e4535be-77a2-4c7e-a04c-7498081b584b",
                                "sense_id": "0efd8ad3-4441-30c4-8e5c-3517630f6af7",
                                "text": "„Der Kofferraum fasst 525 l beim Elektromodell bzw. 560 l bei Versionen mit Verbrennungsmotoren.“"
                            },
                            {
                                "example_id": "5c4019a5-abbd-4948-964e-edacba5a16fc",
                                "sense_id": "0efd8ad3-4441-30c4-8e5c-3517630f6af7",
                                "text": "[Nach 200.000 Kilometern] „hat das Elektromodell durch Herstellung und Betrieb knapp 25 Tonnen CO₂ verursacht, ein vergleichbares Fahrzeug mit Dieselmotor liegt etwa fünf Tonnen darüber.“"
                            },
                            {
                                "example_id": "697d656a-7c31-4b38-b712-2e6ddfb70832",
                                "sense_id": "0efd8ad3-4441-30c4-8e5c-3517630f6af7",
                                "text": "„Erstmals ist laut Marktanalysten ein Elektromodell und kein Verbrenner mehr das meistverkaufte Auto der Welt.“"
                            },
                            {
                                "example_id": "3c4dd01a-f734-4d10-837e-2c5eb8d3bf63",
                                "sense_id": "0efd8ad3-4441-30c4-8e5c-3517630f6af7",
                                "text": "„In Mexiko soll das Elektromodell entsprechend der Marktnachfrage nach und nach die derzeit im Werk produzierten konventionellen Modelle ersetzen.“"
                            },
                            {
                                "example_id": "70668620-82c5-4ee6-a8fe-2b03542deee4",
                                "sense_id": "0efd8ad3-4441-30c4-8e5c-3517630f6af7",
                                "text": "„Im Neckarsulmer Audi-Werk soll künftig das Elektromodell A6 E-Tron gebaut werden.“"
                            },
                            {
                                "example_id": "337f28f6-ceb3-4ef1-899f-915241d900ec",
                                "sense_id": "0efd8ad3-4441-30c4-8e5c-3517630f6af7",
                                "text": "„Bis 2025 will die Marke VW mehr als 20 reine Elektromodelle auf den Markt bringen.“"
                            },
                            {
                                "example_id": "fd5b1025-0531-4c2c-bbb7-c7fb1346ddbd",
                                "sense_id": "0efd8ad3-4441-30c4-8e5c-3517630f6af7",
                                "text": "„Rivian hat im September sein erstes Elektromodell im umkämpften Pick-up-Segment auf den Markt gebracht“ […]."
                            },
                            {
                                "example_id": "57463d6a-b6fe-4853-8fc3-00c01a2ca8b7",
                                "sense_id": "0efd8ad3-4441-30c4-8e5c-3517630f6af7",
                                "text": "[Parkgebühren in Paris:] „Greifen soll der Tarif für Verbrenner- und Hybridmodelle mit einem Gewicht ab 1,6 Tonnen und Elektromodelle ab zwei Tonnen Gewicht.“"
                            },
                            {
                                "example_id": "153c5a3a-5644-410f-a896-b9907ec88222",
                                "sense_id": "0efd8ad3-4441-30c4-8e5c-3517630f6af7",
                                "text": "„Die Nachfrage nach Elektromodellen ist nicht so eingetroffen, wie wir das mal prognostiziert haben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
