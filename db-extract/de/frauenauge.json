                "senses": [
                    {
                        "sense_id": "4d905c58-2b83-3eec-be8f-c825dcc4fdc0",
                        "entry_id": "7a3b8be1-4d0d-3c62-b6cf-413752e09461",
                        "glosses": [
                            "Auge einer Frau"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "82ae6f33-00a0-4ed7-a69c-f12beecb8d98",
                                "sense_id": "4d905c58-2b83-3eec-be8f-c825dcc4fdc0",
                                "text": "„Eine, sah er, zerrte gerade den blauen süßen Happen eines Frauenauges aus der Höhle.“"
                            },
                            {
                                "example_id": "0f0daaab-d4cb-42f0-9440-8dc5e97b562b",
                                "sense_id": "4d905c58-2b83-3eec-be8f-c825dcc4fdc0",
                                "text": "„Im ältesten Flügel des Mausoleums, dem Zufriedenheits-Flügel, ist Jesus ausgemergelt und romantisch, da hat er große feuchte Frauenaugen mit langen Wimpern.“"
                            },
                            {
                                "example_id": "0dd255d5-60ed-4011-9f89-7fcd590f344a",
                                "sense_id": "4d905c58-2b83-3eec-be8f-c825dcc4fdc0",
                                "text": "„Hier wurden silberne Gefäße mit jener Flüssigkeit gefüllt, welche zahllose Frauenaugen verschönt hatte, seit die Stadt gegründet worden war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
