                        "target_lang_word": "windig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "windig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0a681e94-3c23-3324-a711-5f3a27772066",
                                        "entry_id": "ddc3bfe5-963c-3df6-b5f2-71b06ed68c74",
                                        "glosses": [
                                            "mit Wind, von Wind geprägt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "499bd02a-46da-4785-9188-bd94d85b5c91",
                                                "sense_id": "0a681e94-3c23-3324-a711-5f3a27772066",
                                                "text": "Auf dem Gipfel ist es oft sehr windig."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d69c896a-2b3e-3a1f-91ed-ccde862d4e5b",
                                        "entry_id": "ddc3bfe5-963c-3df6-b5f2-71b06ed68c74",
                                        "glosses": [
                                            "nicht zuverlässig, unsicher, zweifelhaft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4091f3c8-0202-4ddf-b4d8-9b85bfaccd9b",
                                                "sense_id": "d69c896a-2b3e-3a1f-91ed-ccde862d4e5b",
                                                "text": "„Einem Amerikaner, der mit windigen Projekten auftaucht, zu deren Realisierung er »nur« noch preiswerten Grund und Boden benötigt, weist er schroff die Tür.“"
                                            },
                                            {
                                                "example_id": "d16478d0-a063-4564-a4bb-e7c752a3b919",
                                                "sense_id": "d69c896a-2b3e-3a1f-91ed-ccde862d4e5b",
                                                "text": "„Der Kokainhandel zieht die windigsten und gewalttätigsten Charaktere an.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
