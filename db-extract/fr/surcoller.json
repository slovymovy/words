                        "glosses": [
                            "Trop coller (le vin)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "896417a6-4dc1-4dfc-be62-0dabd9230c36",
                                "sense_id": "5ff54538-ecbe-37a4-9596-7a1d0a806ded",
                                "text": "Le collage du vin de raisins secs est assez délicat, parce que l'on est exposé à le surcoller, ou à ne pas le clarifier suffisamment."
                            }
                        ]
                    },
                    {
                        "sense_id": "1ad68ad9-5cdd-37c1-a1f0-a57abb83aef2",
                        "entry_id": "1379b34b-21a3-32fd-9299-7fa3809ea644",
                        "glosses": [
                            "Coller par-dessus."
                        ],
                        "tags": [],
                        "examples": [
