                        ],
                        "form": "die Pissmuscheln"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "27de5486-d87e-386e-8fcc-f52e6bfdb5bc",
                        "entry_id": "f33e1d2a-5ba1-3d05-a74b-069f2f05fe95",
                        "glosses": [
                            "An der Wand montierte Vorrichtung zum urinieren, meist für Männer"
                        ],
                        "tags": [
                            "Austrian German"
                        ],
                        "examples": [
                            {
                                "example_id": "cc8e620d-3983-44cf-a1dd-f06ff614656e",
                                "sense_id": "27de5486-d87e-386e-8fcc-f52e6bfdb5bc",
                                "text": "„Werden kindergerechte Ausstattungen vorgesehen, so sind die WC-Schale auf der Höhe von 36 cm und die Pissmuschel auf eine Höhe von 55 cm zu setzen.“"
                            },
                            {
                                "example_id": "564e94fc-864c-4883-9712-8a803cd58c66",
                                "sense_id": "27de5486-d87e-386e-8fcc-f52e6bfdb5bc",
                                "text": "„Eine WC- und eine Pissmuschel, ein Handwaschbecken sowie ein Unterwandspülkasten sind montiert.“"
                            },
                            {
                                "example_id": "f49e8df7-583a-4074-b3db-540ac178babc",
                                "sense_id": "27de5486-d87e-386e-8fcc-f52e6bfdb5bc",
                                "text": "„Ich würde eine Stunde vorher am Bahnhof abgeholt, angelehnt an ‚Predigtdienst‘ Nr. 281, am Herrenklo Obergeschoß, linkeste Pissmuschel rechts.“"
                            },
                            {
                                "example_id": "6cc26ac4-4e16-4e8b-9521-463f33fa66e5",
                                "sense_id": "27de5486-d87e-386e-8fcc-f52e6bfdb5bc",
                                "text": "„Befinden sich auf dem Grundbesitz Pissanlagen, so ist die Gebühr außerdem nach der Zahl der Pissmuscheln beziehungsweise nach der Länge der Pisswände zu bemessen.“"
                            },
                            {
                                "example_id": "8b7e0f48-ef11-4ef5-a752-c02ba9dd056e",
                                "sense_id": "27de5486-d87e-386e-8fcc-f52e6bfdb5bc",
                                "text": "„Die laufende Kanalbenützungsgebühr ist […] nach der Anzahl der Sitzaborte, Pissmuscheln beziehungsweise laufenden Meter der Pisswände hinsichtlich der Ableitung häuslicher Abwässer, die von Menschen herrühren, zu bemessen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
