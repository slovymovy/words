                ],
                "senses": [
                    {
                        "sense_id": "a936cf8b-1b1e-3bdf-8505-a26bc433bbe9",
                        "entry_id": "dfc46346-3046-3721-a380-d1a53ddf3a45",
                        "glosses": [
                            "Qui est formé de basalte."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4f827154-d623-438e-96d8-5261c3eb6075",
                                "sense_id": "a936cf8b-1b1e-3bdf-8505-a26bc433bbe9",
                                "text": "En Islande, toutes les empreintes tertiaires proviennent du surturbrand, formation locale également d'eau douce qui consiste en un mélange de menus lits charbonneux alternant avec une roche tufacée à la constitution de laquelle les détritus basaltiques remaniés par les eaux ont certainement contribué."
                            },
                            {
                                "example_id": "701c26bb-28c6-4f0f-bb14-79238aacdfea",
                                "sense_id": "a936cf8b-1b1e-3bdf-8505-a26bc433bbe9",
                                "text": "Quant au paysage, tout ce qu'on peut imaginer de plus effroyable, de plus sinistre d'aspect, n'en donnerait pas même l'idée. Partout le noir roc basaltique, nu, pelé, hérissé de pointes et d'aiguilles."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3a9c11d0-c35e-4ed4-b345-3b5b0b6380c7",
                        "source_entry_id": "dfc46346-3046-3721-a380-d1a53ddf3a45",
                        "source_sense_id": "a936cf8b-1b1e-3bdf-8505-a26bc433bbe9",
                        "target_lang_word": "basaltisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "basaltisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f9184991-8b78-3ba7-a286-bcb63fa23e84",
                                        "entry_id": "9376b113-dea7-30f5-9360-226ac2caac8f",
                                        "glosses": [
                                            "aus Basalt bestehend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f30a5685-177c-4166-8b77-a291c86af91c",
                                                "sense_id": "f9184991-8b78-3ba7-a286-bcb63fa23e84",
                                                "text": "„An der Unterseite der alten, inzwischen sehr kalten Platte schieden sich im Laufe der Zeit große Mengen basaltischen Gesteins aus dem Erdmantel ab.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2daf55f1-8f84-4589-90e3-e4ca5c3ce3bc",
