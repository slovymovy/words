                        "glosses": [
                            "Endroit où dessaouler."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6dba8d3c-9189-4cba-83e8-0d722bb9aca0",
                                "sense_id": "ee98fc0e-4d37-39c1-81ee-092dd1e5685a",
                                "text": "Les ivrognes ou les gens un peu éméchés sont emmenés au poste, où ils sont installés au dessaouloir."
                            },
                            {
                                "example_id": "6e19848f-b4a9-41aa-b162-89c44649551e",
                                "sense_id": "ee98fc0e-4d37-39c1-81ee-092dd1e5685a",
                                "text": "Ainsi par exemple, en novembre 1956, un habitant russe de Tallinn, A. I. Troudov, déclara, alors qu’il se trouvait dans un dessaouloir pour la nuit, qu’il détestait le pouvoir soviétique et qu’il y avait trop de Juifs dans le gouvernement « Je vais vous organiser un tour à la hongroise »."
                            }
                        ]
