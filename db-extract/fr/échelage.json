                        "glosses": [
                            "Droit d’écheler sur la propriété mitoyenne d’autrui afin de reconstruire ou de réparer un bâtiment ou un mur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "09987dae-0425-40af-aceb-dd02b134dd2f",
                                "sense_id": "cd8d294d-de5e-38fe-b25d-9f6e9794b18f",
                                "text": "Appelée aussi échelage, cette servitude permet au propriétaire dont le bâtiment se situe à la limite séparative de passer chez son voisin pour pouvoir effectuer des travaux indispensables sur son bâtiment, à condition qu’il ne puisse pas faire ces travaux de chez lui (réfection d’un mur pignon, d’une toiture, etc.) et que la durée et le lieu de passage soient limités."
                            }
                        ]
                    }
