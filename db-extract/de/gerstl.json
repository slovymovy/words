                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "d0ecd6d3-60ab-3ae1-a5aa-5f7d0dae0148",
                        "entry_id": "490be86a-4dee-3ec9-98ff-f734f238226c",
                        "glosses": [
                            "kurz für Reibgerstl, geriebenes Gerstl; eine Suppeneinlage aus in kleine Stücke geriebenem festen Nudelteig"
                        ],
                        "tags": [
                            "Austrian German"
                        ],
                        "examples": [],
