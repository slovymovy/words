                "senses": [
                    {
                        "sense_id": "652b044d-cb71-3c67-88a6-6101c1032a10",
                        "entry_id": "950ff663-5b12-3b9c-bca3-fbc6edaec5e1",
                        "glosses": [
                            "Behältnis aus dem Material Kunststoff, in dem Stoffe verschiedener Beschaffenheit aufbewahrt und transportiert werden können"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "999a3941-cabb-4601-a3e0-3a60e48c32a7",
                                "sense_id": "652b044d-cb71-3c67-88a6-6101c1032a10",
                                "text": "„Viele Kunststoffgefäße nehmen schon nach kurzer Zeit Farben oder Gerüche der darin gelagerten Lebensmittel an.“"
                            },
                            {
                                "example_id": "b9371267-736e-45a2-8eea-b445aca25534",
                                "sense_id": "652b044d-cb71-3c67-88a6-6101c1032a10",
                                "text": "„Imposante Solitärpflanzen wie diese prachtvollen Trachycarpus fortunei verbreiten tropisches Flair und sind ein wahrer Raumschmuck. Sie bilden mit den zeitlos eleganten Kunststoffgefäßen der Serie Classico eine harmonische Einheit.“"
                            },
                            {
                                "example_id": "da57b5ea-b409-4176-a11a-3f8026a0c61c",
                                "sense_id": "652b044d-cb71-3c67-88a6-6101c1032a10",
                                "text": "„Petrischale über dem Kunststoffgefäß schnell umdrehen und eine Spatelspitze wasserfreies Kupfersulfat darauf streuen.“"
                            },
                            {
                                "example_id": "b22ef87a-79db-4a58-83aa-f2260f209cd8",
                                "sense_id": "652b044d-cb71-3c67-88a6-6101c1032a10",
                                "text": "„Unsere Kunststoffgefäße lassen viel Spielraum für eine kreative Raumbegrünung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
