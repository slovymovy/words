                        "examples": [
                            {
                                "example_id": "5d7a9aa3-c922-42b4-98fc-553ac5e4140e",
                                "sense_id": "4d37e874-b898-3320-b2b9-1d24dab01993",
                                "text": "Dens in dente, peg-shaped lateral incisors, microdontia, megadontia, fusion, gemination and connation, talon cusp, taurodontism, etc. Recognised by their appearance"
                            },
                            {
                                "example_id": "872a0895-cd3d-4004-b8bf-2cc023c01a62",
                                "sense_id": "4d37e874-b898-3320-b2b9-1d24dab01993",
                                "text": "Isolated megadontia in the permanent dentition has been estimated to occur in approximately 1% of patients. The condition may be symmetrical. Generalized megadontia has been reported in association with pituitary gigantism, unilateral facial hyperplasia, and hereditary gingival fibromatosis."
                            },
                            {
                                "example_id": "b9b07254-441e-4561-9065-5034a6fba3fa",
                                "sense_id": "4d37e874-b898-3320-b2b9-1d24dab01993",
                                "text": "With the thresholds added on the curves it also accounts for the higher prevalences of hypodontia and microdontia in females and the higher prevalences of megadontia and supernumeraries in males."
                            }
                        ]
                    }
