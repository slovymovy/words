                "senses": [
                    {
                        "sense_id": "830b4e9a-dc3a-3725-826a-727c0cc6e17b",
                        "entry_id": "fa1e18ac-411e-30f7-a9f5-dfc974f1ab5a",
                        "glosses": [
                            "ausgeprägter Geschmack und/oder Geruch nach Äpfeln"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "23c0424d-b29d-4549-ad68-d9f8049ec205",
                                "sense_id": "830b4e9a-dc3a-3725-826a-727c0cc6e17b",
                                "text": "„Im Wesentlichen sind Ester, Aldehyde und Alkohole am Apfelaroma beteiligt.“"
                            },
                            {
                                "example_id": "5b89ddd6-a3be-4c85-92f2-91733e1f25d7",
                                "sense_id": "830b4e9a-dc3a-3725-826a-727c0cc6e17b",
                                "text": "„Apfelaroma fördert das Wachstum der Keimpflanzen bei Belichtung und hemmt es bei Verdunkelung.“"
                            },
                            {
                                "example_id": "19f20403-e6bc-43f9-b9a7-96c3b40a4dce",
                                "sense_id": "830b4e9a-dc3a-3725-826a-727c0cc6e17b",
                                "text": "„Apfelaroma können Sie zum Beispiel herstellen, indem Sie einen halben Granny Smith klein schneiden und in 100 ml Grundwein (Silvaner oder einfachen Riesling) für 1 Stunde extrahieren.“"
                            },
                            {
                                "example_id": "690e9f4a-c45a-4529-884e-040c3d821504",
                                "sense_id": "830b4e9a-dc3a-3725-826a-727c0cc6e17b",
                                "text": "„Nehmen wir an, wir befinden uns in einer Gruppe von Menschen, von denen einer behauptet: »Es riecht hier nach Apfelaroma.«“"
                            },
                            {
                                "example_id": "dbc4d20c-7931-4f72-be96-174436bf962d",
                                "sense_id": "830b4e9a-dc3a-3725-826a-727c0cc6e17b",
                                "text": "„Apfelbranntwein ist geschmacklich recht neutral und das typische Apfelaroma ist nur schwach erkennbar.“"
                            },
                            {
                                "example_id": "d019cd41-8843-47fd-92ae-b688be979a07",
                                "sense_id": "830b4e9a-dc3a-3725-826a-727c0cc6e17b",
                                "text": "„Das Apfelaroma ist für den Fruchtgenuss unverzichtbar, daher gehört das Apfelaroma zum Apfel als Lebensmittel.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
