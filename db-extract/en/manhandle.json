                "senses": [
                    {
                        "sense_id": "54605a8b-2217-3e56-a0e6-5a5e005c425b",
                        "entry_id": "9211cfaa-e8c2-39cd-928d-049dd3810968",
                        "glosses": [
                            "To move something heavy by force of men, without aid of levers, pulleys, machine, or tackles."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "c0fd46d8-cd6c-4fcd-a022-af8229db773c",
                                "sense_id": "54605a8b-2217-3e56-a0e6-5a5e005c425b",
                                "text": "I see him—Tom—on horse-block standing,\nTrumpet at mouth, thrown up all amain,\nAn elephant's bugle, vociferous demanding\nOf topmen aloft in the hurricane of rain,\n\"Letting that sail there your faces flog?\nManhandle it, men, and you'll get the good grog!\""
                            }
                        ]
                    },
                    {
                        "sense_id": "b30e3833-ed0f-3d66-aef1-f57546db5aa0",
                        "entry_id": "9211cfaa-e8c2-39cd-928d-049dd3810968",
                        "glosses": [
                            "To assault or beat up a person."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "d8ccea6d-b96c-4146-8e48-ed78f93b6d56",
                                "sense_id": "b30e3833-ed0f-3d66-aef1-f57546db5aa0",
                                "text": "The polls were guarded by bullies who did not hesitate at command to manhandle any decent citizen indicated by the local leaders."
                            }
                        ]
                    },
                    {
                        "sense_id": "104aa63c-25fe-3da1-96cf-a8968800900f",
                        "entry_id": "9211cfaa-e8c2-39cd-928d-049dd3810968",
                        "glosses": [
                            "To mishandle; to handle roughly; to mangle."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "31564e3a-6f1e-4901-992b-b1616b68d37a",
                                "sense_id": "104aa63c-25fe-3da1-96cf-a8968800900f",
                                "text": "She yells at people who manhandle the tomatoes or break the beans."
                            },
                            {
                                "example_id": "5dce4cba-0b0e-4ff3-80f5-8ff959b31700",
                                "sense_id": "104aa63c-25fe-3da1-96cf-a8968800900f",
                                "text": "Britain’s most senior police chief defied pressure to resign as she dismissed “armchair” critics amid widespread outrage over officers manhandling women who were mourning the killing of Sarah Everard."
                            }
                        ]
                    },
                    {
                        "sense_id": "63c813e6-984d-3a05-a6e2-769bbed866b0",
                        "entry_id": "9211cfaa-e8c2-39cd-928d-049dd3810968",
                        "glosses": [
                            "To control (a machine, vehicle, situation, etc.) by means of physical strength."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "64ec2dc8-a491-4074-b15c-b24d9cf7ebd5",
                                "sense_id": "63c813e6-984d-3a05-a6e2-769bbed866b0",
                                "text": "Riders who succeed on this terrain are able to manhandle their bike as it rattles over the bumps."
                            }
                        ]
                    }
                ],
                "translations": [
