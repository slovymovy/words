                        "entry_id": "b16860d4-c165-3ccf-ab14-06cd0100529e",
                        "glosses": [
                            "Cercle de la voûte céleste, parallèle à l’horizon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e2c4cbe8-de60-4a56-a2d8-22bf18b96830",
                                "sense_id": "ba03fe73-370a-3177-a686-1c1769a823c6",
                                "text": "Ces derniers vont du zénith à lʼhorizon en coupant chaque almicantarat à angle droit."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "01493f68-50de-4091-84af-dc33c5db80a4",
                        "source_entry_id": "b16860d4-c165-3ccf-ab14-06cd0100529e",
