                    {
                        "sense_id": "aa286770-9dcc-374d-b65e-ad6996119ab2",
                        "entry_id": "9c209f94-613b-3cc1-98b1-7f66c4726f5a",
                        "glosses": [
                            "Blutung in der Lunge, bei der es zu Husten mit blutigem Auswurf kommt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a8bb389-00bf-403e-915f-e26da347dda3",
                                "sense_id": "aa286770-9dcc-374d-b65e-ad6996119ab2",
                                "text": "„Nur so als Tipp für die Zukunft: Falls Sie sich aussuchen können, wie Sie aus dem Leben scheiden, versuchen Sie, eine Lungenblutung zu vermeiden.“"
                            },
                            {
                                "example_id": "50e101db-2598-4166-9456-fc2262ade412",
                                "sense_id": "aa286770-9dcc-374d-b65e-ad6996119ab2",
                                "text": "„›Es gab massive Lungenblutungen, und auch sein Brustkorb war mit Blut gefüllt.‹“"
                            }
                        ],
