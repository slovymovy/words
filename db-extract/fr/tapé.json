            },
            {
                "entry_id": "fb6f3eb3-7da7-36c6-9954-88b29900f5e0",
                "word": "tapé",
                "pos": "verb",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "b09a5e4c-c7c9-3a94-a7e9-fba2511d92d7",
                        "entry_id": "fb6f3eb3-7da7-36c6-9954-88b29900f5e0",
                        "glosses": [
                            "Participe passé masculin singulier de taper."
                        ],
                        "tags": [
