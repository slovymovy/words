                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kerbe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b4ec1746-7a73-3642-b67d-456100862076",
                                        "entry_id": "27856862-cfbb-3c11-898b-785de75caf7e",
                                        "glosses": [
                                            "eine keilförmige Vertiefung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e231c910-c346-49f1-8052-23b51218410a",
                                                "sense_id": "b4ec1746-7a73-3642-b67d-456100862076",
                                                "text": "Um einen Baum mit einer Axt zu fällen, sollte man zuerst eine Kerbe in den Stamm schlagen."
                                            },
                                            {
                                                "example_id": "86a9add9-534a-43ed-91fc-7a1457314315",
                                                "sense_id": "b4ec1746-7a73-3642-b67d-456100862076",
                                                "text": "„Aber alle realen Gläser weisen mikroskopische Kerben und Fehlstellen auf.“"
                                            },
                                            {
                                                "example_id": "a7a25970-def4-4c1e-a66e-1957d198456c",
                                                "sense_id": "b4ec1746-7a73-3642-b67d-456100862076",
                                                "text": "„Nur ab und zu warf ich einen Blick in den Container, auf die Reste dessen, womit ich aufgewachsen war und was jetzt Kerben und Beulen bekommen hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "eaa5ed78-182b-3351-b713-e04ea79013bf",
                                        "entry_id": "27856862-cfbb-3c11-898b-785de75caf7e",
                                        "glosses": [
                                            "regional für: Kirchweih"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2c0cb035-7390-4508-9d0f-5c12640fffac",
                        "source_entry_id": "c7554e6a-d148-3bf6-84b6-798f4abd97cd",
                        "source_sense_id": "6bf81972-6eb9-3b7a-a199-72f6afff1fa0",
