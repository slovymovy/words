    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d010ae27-e0d6-3bf9-b55c-631a7d745cc7",
                    "sense_definition": "het weerklinken van luid gerommel in de lucht als gevolg van een bliksemontlading",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "weersverschijnsel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In de verte hoor ik het al een tijdje <w>donderen</w>.",
                            "target_lang_translations": {
                                "en": "I've been hearing it <w>thunder</w> in the distance for a while now."
                            }
                        },
                        {
                            "text": "Het begon hard te <w>donderen</w> vlak voordat de regen met bakken uit de hemel kwam.",
                            "target_lang_translations": {
                                "en": "It started to <w>thunder</w> loudly just before the rain started pouring down."
                            }
                        }
                    ],
                    "synonyms": [
                        "rommelen"
                    ],
                    "common_phrases": [
                        "horen donderen"
                    ],
                    "target_lang_definitions": {
                        "en": "the sound of loud rumbling in the sky as a result of a lightning discharge"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "thunder",
                                "target_lang_sense_clarification": "to produce the sound of thunder"
                            },
                            {
                                "target_lang_word": "rumble",
                                "target_lang_sense_clarification": "to make a low, heavy, continuous sound"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e3aa1772-2405-3df7-9fb7-b26bcd091eb4",
                    "sense_definition": "met veel lawaai of plotseling ergens van afvallen of naar beneden vallen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "vallen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De leerling verloor zijn evenwicht en <w>donderde</w> achterover van zijn stoel.",
                            "target_lang_translations": {
                                "en": "The student lost his balance and <w>tumbled</w> backward off his chair."
                            }
                        },
                        {
                            "text": "Ze struikelde en <w>donderde</w> met veel gedruis de trap af.",
                            "target_lang_translations": {
                                "en": "She tripped and <w>fell</w> down the stairs with a lot of noise."
                            }
                        }
                    ],
                    "synonyms": [
                        "vallen",
                        "kukelen",
                        "mieteren"
                    ],
                    "common_phrases": [
                        "de trap af donderen"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informeel gebruik voor vallen"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to fall off or down from something suddenly or with a lot of noise"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "tumble",
                                "target_lang_sense_clarification": "to fall suddenly or headlong"
                            },
                            {
                                "target_lang_word": "come crashing down",
                                "target_lang_sense_clarification": "to fall with a loud noise"
                            },
                            {
                                "target_lang_word": "fall",
                                "target_lang_sense_clarification": "to drop down from a higher level"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6dbf5346-68f5-379e-8d26-9eb8b8e8cde0",
                    "sense_definition": "op een zeer luide, boze of dwingende toon spreken of schreeuwen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "spreken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hou daar nu mee op <w>donderde</w> de man tegen de spelende kinderen.",
                            "target_lang_translations": {
                                "en": "\"Stop that right now!\" the man <w>thundered</w> at the children playing."
                            }
                        },
                        {
                            "text": "De generaal <w>donderde</w> zijn bevelen over het exercitieveld.",
                            "target_lang_translations": {
                                "en": "The general <w>bellowed</w> his orders across the parade ground."
                            }
                        }
                    ],
                    "synonyms": [
                        "bulderen",
                        "razen"
                    ],
                    "antonyms": [
                        "fluisteren"
                    ],
                    "common_phrases": [
                        "een bevel donderen"
                    ],
                    "target_lang_definitions": {
                        "en": "to speak or shout in a very loud, angry, or commanding tone"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "thunder",
                                "target_lang_sense_clarification": "to shout or speak very loudly and forcefully"
                            },
                            {
                                "target_lang_word": "bellow",
                                "target_lang_sense_clarification": "to shout in a deep, loud voice"
                            },
                            {
                                "target_lang_word": "roar",
                                "target_lang_sense_clarification": "to make a very loud, deep sound"
                            }
                        ]
                    }
                }
            ]
        },
