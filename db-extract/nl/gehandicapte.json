                                "target_senses": [
                                    {
                                        "sense_id": "9432e509-eb3c-371f-a8f4-b87d4e2978e0",
                                        "entry_id": "ea0e20d0-d876-3eb0-9046-bf032bafd4b2",
                                        "glosses": [
                                            "(männliche^☆) Person mit einer starken und dauerhaften körperlichen und/oder geistigen Beeinträchtigung der gesellschaftlichen und wirtschaftlichen Teilhabe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b43ed79f-015c-4a0d-b157-35b2c55257bb",
                                                "sense_id": "9432e509-eb3c-371f-a8f4-b87d4e2978e0",
                                                "text": "Der Behinderte schlurfte die Straße entlang."
                                            },
                                            {
                                                "example_id": "848fbcc1-af35-40c5-a85f-5c4034ea9a0b",
                                                "sense_id": "9432e509-eb3c-371f-a8f4-b87d4e2978e0",
                                                "text": "Einige Behinderte stellen in speziellen Werkstätten handgemachte Besen und andere Gebrauchsgegenstände her."
                                            },
                                            {
                                                "example_id": "b9a284e8-2b18-40d5-a995-10fea289b253",
                                                "sense_id": "9432e509-eb3c-371f-a8f4-b87d4e2978e0",
                                                "text": "Den meisten Behinderten fehle, was auch viele gesunde Freier suchten: menschliche Wärme, Nähe, Gesprächsbereitschaft."
                                            },
                                            {
                                                "example_id": "e3662204-f1d2-45fb-ba91-3630a27bdebc",
                                                "sense_id": "9432e509-eb3c-371f-a8f4-b87d4e2978e0",
                                                "text": "„Auch Hundertausende Roma und Sinti, 200.000 körperlich oder geistig Behinderte und etwa 5.000 Homosexuelle kostete der Rassenwahn das Leben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
