                "senses": [
                    {
                        "sense_id": "e229c405-801f-3e34-8361-f1e9e244f767",
                        "entry_id": "f1cb36dc-0930-3596-88c6-33b576656cb9",
                        "glosses": [
                            "Prozess, bei dem sich etwas (zum Beispiel Eis) verflüssigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c8b9cf26-ab27-4b42-b565-710f55f24960",
                                "sense_id": "e229c405-801f-3e34-8361-f1e9e244f767",
                                "text": "„Auf Monitoren überwacht ein Mitarbeiter rund um die Uhr den Schmelzvorgang.“"
                            },
                            {
                                "example_id": "1fa3f9f2-27c9-4eb1-be29-486e6a457647",
                                "sense_id": "e229c405-801f-3e34-8361-f1e9e244f767",
                                "text": "„Die alte Silberminenstadt im Südwesten des US-Staates hat verschiedene Kohleöfen im Freien, die einst für den Schmelzvorgang benutzt wurden.“"
                            },
                            {
                                "example_id": "c8ef89c6-fa1e-4615-b565-39228d02dd76",
                                "sense_id": "e229c405-801f-3e34-8361-f1e9e244f767",
                                "text": "„Diese Gletscherschmelze wollen die Wissenschaftler natürlich vermeiden und erforschen nun, wie sich der Schmelzvorgang verhindern lässt.“"
                            },
                            {
                                "example_id": "3f2289a7-a665-4851-9047-59b842659557",
                                "sense_id": "e229c405-801f-3e34-8361-f1e9e244f767",
                                "text": "„Nun müsse erforscht werden, wie der Schmelzvorgang den Meeresspiegel beeinflusse.“"
                            },
                            {
                                "example_id": "51aafdfd-ac4e-418e-97d6-148d69a5b0b2",
                                "sense_id": "e229c405-801f-3e34-8361-f1e9e244f767",
                                "text": "„Das Material reflektiert die UV-Strahlen und verlangsamt damit den Schmelzvorgang des Gletschers.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
