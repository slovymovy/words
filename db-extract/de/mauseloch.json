                "senses": [
                    {
                        "sense_id": "d54926cb-508e-343e-b419-69b468c457bf",
                        "entry_id": "723d04d5-4a2f-3f49-a663-409f333f7af3",
                        "glosses": [
                            "erzeugte Öffnung zum Bau einer Maus"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d41b9963-6d4b-4b75-a684-f887c50dead4",
                                "sense_id": "d54926cb-508e-343e-b419-69b468c457bf",
                                "text": "„Jerry sitzt in seinem Mäusebau und isst Käse von der vor dem Mauseloch stehenden Mausefalle, als es an seiner Tür klingelt.“"
                            },
                            {
                                "example_id": "057a062e-4b92-474a-88a1-282ab0bfbbd1",
                                "sense_id": "d54926cb-508e-343e-b419-69b468c457bf",
                                "text": "„Wir sollten uns baldmöglichst darauf vorbereiten, in ein Mauseloch zu kriechen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
