                "senses": [
                    {
                        "sense_id": "cfa58389-ccbb-3840-8760-703a38ab733a",
                        "entry_id": "ebd7a154-470f-3fdb-a3e0-48016d29e242",
                        "glosses": [
                            "met een rasp iets vanaf de buitenkant verwijderen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e4aede0e-464c-4a56-b83b-c98275c7e68c",
                                "sense_id": "cfa58389-ccbb-3840-8760-703a38ab733a",
                                "text": "Hij zei ook dat de saneringsoperatie die op stapel staat, niet zal kunnen gebeuren volgens het recept dat de Vlaamse regering toepaste: de kaasschaafmethode, overal een beetje afraspen."
                            },
                            {
                                "example_id": "024356e8-039c-47f1-bb16-e41b09050523",
                                "sense_id": "cfa58389-ccbb-3840-8760-703a38ab733a",
                                "text": "Ik begin meer en meer dingen te denken als\n Ouder worden is de genade om te horen\nHoe de bijen verdroogde bloemstengels afraspen\nGelatenheid is het geluk\nVan de galwesp in de nooit opgemerkte inktappel"
                            }
                        ]
                    }
