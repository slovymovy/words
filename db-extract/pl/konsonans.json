                                        "entry_id": "385c6c76-c421-341e-a070-37a74d1c340e",
                                        "glosses": [
                                            "Harmony; agreement; absence of discordance."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "05937d19-4b4d-4c94-8844-1a3214ad7697",
                                                "sense_id": "d36fed15-61b8-3eff-a5eb-a0c50a354049",
                                                "text": "Like a musical string, the optic nerve responds to the waves with which it is in consonance, while it refuses to be excited by others of almost infinitely greater energy, whose period of recurrence are not in unison with its own."
                                            }
                                        ]
                                    }
                                ]
                            }
