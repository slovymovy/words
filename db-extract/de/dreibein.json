                    },
                    {
                        "translation_id": "709d70bf-eada-4312-82e2-9fe73c47111d",
                        "source_entry_id": "4a1eec88-61d9-3ea6-8b63-516ecdff4453",
                        "source_sense_id": "7758b990-29fd-3372-a6c8-085b9f4302f4",
                        "source_sense_description": "Möbelstück oder Gerät mit drei Beinen",
                        "target_lang_word": "trépied",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "trépied",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "43f3c246-635a-3547-9ce7-dbfb472a8575",
                                        "entry_id": "82f5cc4d-cfba-3b0e-b094-2321e9d91317",
                                        "glosses": [
                                            "Ustensile de cuisine à trois pieds, qui sert de support à un chaudron, à une marmite sur le feu."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "aee5e255-a993-3a91-9116-c710fa2ed800",
                                        "entry_id": "82f5cc4d-cfba-3b0e-b094-2321e9d91317",
                                        "glosses": [
                                            "Support à trois pieds."
                                        ],
                                        "tags": [
                                            "Ancient"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c3cbff6a-25e1-4f44-9056-a4d0ca927e9c",
                                                "sense_id": "aee5e255-a993-3a91-9116-c710fa2ed800",
                                                "text": "Le trépied de Delphes, le trépied d’Apollon, Sorte de siège à trois pieds, sur lequel la prêtresse de Delphes s’asseyait pour rendre des oracles."
                                            },
                                            {
                                                "example_id": "9ef42ef7-7c81-464f-a75a-e221a8bc26c2",
                                                "sense_id": "aee5e255-a993-3a91-9116-c710fa2ed800",
                                                "text": "La flamme azurée et pétillante jaillit tout à coup de tous les trépieds."
                                            },
                                            {
                                                "example_id": "22a560bd-ff7f-4a46-aca5-ad7dc92eede5",
                                                "sense_id": "aee5e255-a993-3a91-9116-c710fa2ed800",
                                                "text": "D’un étroit trépied monte la fumée du sacrifice agreste d’herbes et de racines parfumées."
                                            },
                                            {
                                                "example_id": "01ce281d-8323-43f8-8d84-763ad07754b2",
                                                "sense_id": "aee5e255-a993-3a91-9116-c710fa2ed800",
                                                "text": "C’est un canapé de magicien. Ce meuble étrange où le profane ne verrait qu’un vestige poussiéreux d’une époque démodée, c’est un inspirateur terrible, c’est le manche à balais de la sorcière, c’est le trépied de la Pythie, c’est le tapis des contes orientaux qui rend invisible et vous transporte en tous lieux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "073ae2b3-2b1a-3254-b146-2a456f3b318f",
                                        "entry_id": "82f5cc4d-cfba-3b0e-b094-2321e9d91317",
                                        "glosses": [
                                            "Tout support à trois pieds."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6d245770-892b-4559-9bec-5d708c9eb7f4",
                                                "sense_id": "073ae2b3-2b1a-3254-b146-2a456f3b318f",
                                                "text": "Il baladait sur son épaule un énorme trépied, emmanché d’un vieux dix-huit-vingt-quatre presque aussi antique que Niepce et Daguerre, tout en glapissant comme un écorché : — Invraisemblable ! C’est invraisemblable ! Vos cognes m’ont contré, malgré mon coupe-file !."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
