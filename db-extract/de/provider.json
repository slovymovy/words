                "senses": [
                    {
                        "sense_id": "42df0c96-1fdd-38ff-8213-345885ddde0c",
                        "entry_id": "8314f05b-b2f6-3ad5-b852-552a47e88fa3",
                        "glosses": [
                            "Anbieter eines Diensts oder einer Ressource"
                        ],
                        "tags": [
                            "Handel"
                        ],
                        "examples": [
                            {
                                "example_id": "898be649-c505-4b41-9bd1-b8c9131a7d44",
                                "sense_id": "42df0c96-1fdd-38ff-8213-345885ddde0c",
                                "text": "Der Provider für unseren Mailserver hat uns eine Rechnung geschickt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e632c22c-90ac-34af-a5d9-58242f146bba",
                        "entry_id": "8314f05b-b2f6-3ad5-b852-552a47e88fa3",
                        "glosses": [
                            "Anbieter, der Telekommunikationsdienstleistungen, insbesondere Internetzugänge bereitstellt"
                        ],
                        "tags": [
                            "Telekommunikation",
                            "im engeren Sinne"
                        ],
                        "examples": [
                            {
                                "example_id": "bf75b347-32c5-4eed-9bf1-c793bac741b4",
                                "sense_id": "e632c22c-90ac-34af-a5d9-58242f146bba",
                                "text": "Ich bin mit meinem Provider sehr unzufrieden, weil mein Internet viel langsamer ist, als in der Werbung versprochen wurde."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "60581cb9-4f50-426f-a45d-6bd9957965e1",
                        "source_entry_id": "8314f05b-b2f6-3ad5-b852-552a47e88fa3",
                        "source_sense_id": "42df0c96-1fdd-38ff-8213-345885ddde0c",
                        "source_sense_description": "Handel, Informatik: Anbieter eines Diensts oder einer Ressource",
                        "target_lang_word": "provider",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "provider",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "120dc7cd-2b06-3e75-956c-49c3def508b1",
                                        "entry_id": "3837f502-8bb0-3b27-ad24-5fbdb9d223fc",
                                        "glosses": [
                                            "One who, or that which, provides a service, commodity, or the means for subsistence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9590e751-3c32-4dd2-98cd-60ed31ae9d69",
                                                "sense_id": "120dc7cd-2b06-3e75-956c-49c3def508b1",
                                                "text": "In view of this, it is clear why internet service providers (ISPs) are inclined to play a backbench role when it comes to combating file sharing."
                                            },
                                            {
                                                "example_id": "39a52648-d6d9-4a32-a159-54b067de78d8",
                                                "sense_id": "120dc7cd-2b06-3e75-956c-49c3def508b1",
                                                "text": "Using BLE, a merchant or other provider can define more targeted \"micro-locations\" to trigger an alert, in some cases requiring that you be in the presence of an iBeacon in order to validate a Passbook entry."
                                            },
                                            {
                                                "example_id": "c47927e8-660e-4c92-943a-a7431b57ca84",
                                                "sense_id": "120dc7cd-2b06-3e75-956c-49c3def508b1",
                                                "text": "Even if policy shifts resources away from hard investment and back into social spending, the \"Floridization\" of Chinese demographics will intensify the shortage of healthcare provision over the next decade, worsening the frayed contract between patients, providers, and the government."
                                            },
                                            {
                                                "example_id": "d7205103-73a7-4e4f-bf15-2fcfb087dd4e",
                                                "sense_id": "120dc7cd-2b06-3e75-956c-49c3def508b1",
                                                "text": "A part of the nervousness at Chelsea involves whether any more sponsors will follow the telecommunications and internet service provider Three in withdrawing support, at least temporarily."
                                            },
                                            {
                                                "example_id": "c15f9fbb-fd47-449e-9a7a-c12e7642c0b4",
                                                "sense_id": "120dc7cd-2b06-3e75-956c-49c3def508b1",
                                                "text": "Both switching costs and network effects tend to lead to enshittification because platform providers see early adopters as an investment in future profits."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8eaa555c-030b-40f7-85ae-ec4c94c68c84",
                        "source_entry_id": "8314f05b-b2f6-3ad5-b852-552a47e88fa3",
                        "source_sense_id": "42df0c96-1fdd-38ff-8213-345885ddde0c",
