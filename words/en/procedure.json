{
    "word_family": [
        "proceed",
        "procedural",
        "procedurally",
        "proceeding",
        "proceedings"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "166c1c71-4d2f-36c3-bd87-fb37337509b4",
                    "sense_definition": "A series of actions or steps taken in a certain order to accomplish a particular task or end.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "method_steps",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You must follow the correct <w>procedure</w> to apply for a new passport.",
                            "target_lang_translations": {
                                "ru": "Вы должны соблюдать правильную <w>процедуру</w> подачи заявления на новый паспорт.",
                                "zh": "你必须遵循正确的<w>程序</w>来申请新护照。"
                            }
                        },
                        {
                            "text": "The school has a strict safety <w>procedure</w> for dealing with fire alarms.",
                            "target_lang_translations": {
                                "ru": "В школе действует строгая <w>процедура</w> безопасности на случай пожарной тревоги.",
                                "zh": "学校针对火警有严格的安全<w>流程</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "method",
                        "process",
                        "routine",
                        "step-by-step guide",
                        "system"
                    ],
                    "common_phrases": [
                        "standard procedure",
                        "safety procedure",
                        "emergency procedure",
                        "application procedure"
                    ],
                    "target_lang_definitions": {
                        "ru": "Серия действий или шагов, предпринимаемых в определенном порядке для выполнения конкретной задачи",
                        "zh": "为完成特定任务或目标而按一定顺序采取的一系列行动或步骤。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "процедура",
                                "target_lang_sense_clarification": "порядок действий"
                            },
                            {
                                "target_lang_word": "методика",
                                "target_lang_sense_clarification": "совокупность методов"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "程序",
                                "target_lang_sense_clarification": "完成任务的步骤"
                            },
                            {
                                "target_lang_word": "步骤",
                                "target_lang_sense_clarification": "行动的顺序"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f4ff1b3c-4885-36d3-92ef-85962e12f2ad",
                    "sense_definition": "The official or established way of doing things in an organization, business, or legal system.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "method_steps",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lawyer explained the legal <w>procedure</w> for filing a complaint against the company.",
                            "target_lang_translations": {
                                "ru": "Адвокат разъяснил юридическую <w>процедуру</w> подачи жалобы на компанию.",
                                "zh": "律师解释了针对该公司提起诉讼的法律<w>手续</w>。"
                            }
                        },
                        {
                            "text": "It is standard <w>procedure</w> to check identification at the entrance of the building.",
                            "target_lang_translations": {
                                "ru": "Проверка удостоверения личности при входе в здание — это стандартная <w>процедура</w>.",
                                "zh": "在大楼入口处检查身份证件是标准<w>流程</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "protocol"
                    ],
                    "common_phrases": [
                        "legal procedure",
                        "parliamentary procedure",
                        "follow procedure",
                        "breach of procedure"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официальный или установленный способ ведения дел в организации, бизнесе или правовой системе",
                        "zh": "在组织、企业或法律体系中处理事务的官方或既定方式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "процедура",
                                "target_lang_sense_clarification": "официальный порядок"
                            },
                            {
                                "target_lang_word": "процесс",
                                "target_lang_sense_clarification": "судебное дело"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "流程",
                                "target_lang_sense_clarification": "既定的工作方式"
                            },
                            {
                                "target_lang_word": "手续",
                                "target_lang_sense_clarification": "办理事务的程序"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6cb580ed-8e46-3fb1-a6a9-e223e8f5034c",
                    "sense_definition": "A medical or surgical operation performed to treat a condition.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "medical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor said the surgical <w>procedure</w> would only take about an hour.",
                            "target_lang_translations": {
                                "ru": "Врач сказал, что хирургическая <w>процедура</w> займет всего около часа.",
                                "zh": "医生说这项外科<w>手术</w>只需要大约一个小时。"
                            }
                        },
                        {
                            "text": "She is recovering well at home after a minor medical <w>procedure</w>.",
                            "target_lang_translations": {
                                "ru": "Она хорошо восстанавливается дома после небольшой медицинской <w>процедуры</w>.",
                                "zh": "她在做完一个小型的医疗<w>手术</w>后，正在家中顺利康复。"
                            }
                        }
                    ],
                    "synonyms": [
                        "operation"
                    ],
                    "common_phrases": [
                        "surgical procedure",
                        "medical procedure",
                        "minor procedure",
                        "invasive procedure"
                    ],
                    "target_lang_definitions": {
                        "ru": "Медицинская или хирургическая операция, выполняемая для лечения заболевания",
                        "zh": "为治疗某种疾病而进行的医疗或外科手术。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "процедура",
                                "target_lang_sense_clarification": "медицинская манипуляция"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "手术",
                                "target_lang_sense_clarification": "外科医疗操作"
                            },
                            {
                                "target_lang_word": "疗程",
                                "target_lang_sense_clarification": "医疗处理过程"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9d741597-9360-3e5a-a844-a50735b3ba61",
                    "sense_definition": "A section of computer code or a subroutine that performs a specific task.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The programmer wrote a new <w>procedure</w> to handle user authentication securely.",
                            "target_lang_translations": {
                                "ru": "Программист написал новую <w>процедуру</w> для безопасной обработки аутентификации пользователей.",
                                "zh": "程序员编写了一个新的<w>子程序</w>来安全地处理用户身份验证。"
                            }
                        },
                        {
                            "text": "This <w>procedure</w> calculates the total value of the items in the cart.",
                            "target_lang_translations": {
                                "ru": "Эта <w>процедура</w> рассчитывает общую стоимость товаров в корзине.",
                                "zh": "这个<w>函数</w>用于计算购物车中商品的总价值。"
                            }
                        }
                    ],
                    "synonyms": [
                        "subroutine",
                        "function",
                        "routine"
                    ],
                    "common_phrases": [
                        "stored procedure",
                        "call a procedure"
                    ],
                    "target_lang_definitions": {
                        "ru": "Секция компьютерного кода или подпрограмма, выполняющая определенную задачу",
                        "zh": "执行特定任务的一段计算机代码或子程序。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "процедура",
                                "target_lang_sense_clarification": "в программировании"
                            },
                            {
                                "target_lang_word": "подпрограмма",
                                "target_lang_sense_clarification": "часть программы"
                            },
                            {
                                "target_lang_word": "функция",
                                "target_lang_sense_clarification": "фрагмент кода"
                            },
                            {
                                "target_lang_word": "метод",
                                "target_lang_sense_clarification": "функция класса"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "程序",
                                "target_lang_sense_clarification": "计算机代码段"
                            },
                            {
                                "target_lang_word": "子程序",
                                "target_lang_sense_clarification": "程序中的功能模块"
                            },
                            {
                                "target_lang_word": "函数",
                                "target_lang_sense_clarification": "编程中的功能单元"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}