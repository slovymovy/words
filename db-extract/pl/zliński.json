                        "examples": [
                            {
                                "example_id": "1773f2c6-28b4-487c-bcfa-38ae0dae47f8",
                                "sense_id": "045c3e20-cee7-3a48-8e17-f4caf736070c",
                                "text": "Gdy pytam, dlaczego nie biorą pod uwagę portów polskich, a zwłaszcza Szczecina, który ma zgodnie z międzynarodowym porozumieniem przejąć tranzyt czechosłowacki — uzyskuję odpowiedź, że tradycyjnym portem dla zlińskich wyrobów Baty był przecież zawsze Hamburg"
                            }
                        ],
