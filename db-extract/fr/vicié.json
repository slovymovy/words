                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ab1077b-997a-4030-a409-df779691afc3",
                                                "sense_id": "35430b3a-ae08-3706-9c69-bac09c6eca6e",
                                                "text": "Bu savaş yılları o kadar fena ve ağır felaketler öğretmişti ki..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "14705e6c-be17-34a5-bdbe-a9e5659d6645",
                                        "entry_id": "3d4cf741-c791-3ce0-9889-65fdd4ee2bbf",
                                        "glosses": [
                                            "istenilen ve gereken nitelikte olmayan"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f27cf7ab-75cd-41d6-af51-67bf47653313",
                                                "sense_id": "14705e6c-be17-34a5-bdbe-a9e5659d6645",
                                                "text": "Fena bir öğrenci."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d68cf9fd-d1ea-3593-bafb-6a70b3bd1a12",
                                        "entry_id": "3d4cf741-c791-3ce0-9889-65fdd4ee2bbf",
                                        "glosses": [
                                            "hoşa gitmeyen, rahatsız edici"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dbead6d3-18b2-4572-8812-990aa9b18964",
                                                "sense_id": "d68cf9fd-d1ea-3593-bafb-6a70b3bd1a12",
                                                "text": "Fena günler yaşadığına inanmak için bin şahit lazım."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aedebe22-4d4b-3be5-886b-66fae6a03c31",
                                        "entry_id": "3d4cf741-c791-3ce0-9889-65fdd4ee2bbf",
                                        "glosses": [
                                            "davranışları toplumun ahlak anlayışına uymayan:"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e8beddaf-172d-4ac2-bf15-da63497d49e5",
                                                "sense_id": "aedebe22-4d4b-3be5-886b-66fae6a03c31",
                                                "text": "Siz fena adamsınız, odanıza geldiğime bin kere pişman oldum."
                                            }
