                        "glosses": [
                            "Onomatopée imitant le glapissement d’un chien qui a peur, qui a reçu un coup (généralement répétée au moins une fois : « kaï kaï »)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "40ccd1d0-075f-42a3-b3de-2fcddc35b6a3",
