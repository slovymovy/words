                ],
                "senses": [
                    {
                        "sense_id": "8f0e25e8-1512-38d6-8780-b6df9877589d",
                        "entry_id": "4b50d935-96a3-3535-b728-a8af7186ef83",
                        "glosses": [
                            "Donner un caractère asin à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "789d6d0d-e7f1-4c85-9903-861e846de1c2",
                                "sense_id": "8f0e25e8-1512-38d6-8780-b6df9877589d",
                                "text": "À l’inverse, pour les ovistes, le sperme asinise l’œuf de la jument par l’effet d’un quelconque magnétisme ou d’hypothétiques particules nourricières."
                            },
                            {
                                "example_id": "7076ebcb-ec48-4134-881a-ce00de6fab12",
                                "sense_id": "8f0e25e8-1512-38d6-8780-b6df9877589d",
                                "text": "Dans le cas de Lémery - et s’il avait, de front, abordé ce problème -, on aurait pu s’attendre à une théorie reposant, à la rigueur, sur l’idée d’un œuf chevalin originaire « asinisé » par un processus externe relié à la présence active de la semence de l’âne."
                            },
                            {
                                "example_id": "3921202b-864b-42b4-9a8e-caa6a344febc",
                                "sense_id": "8f0e25e8-1512-38d6-8780-b6df9877589d",
                                "text": "Je lui propose une carrière de videur-rabatteur-artiste et il laisse entendre qu'à la suite de mutations génétiques et d'effets de serre incongrus le renne lapon se serait asinisé!"
                            }
                        ]
                    }
                ],
