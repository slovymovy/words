                                                "sense_id": "35f42592-5530-3ad9-b40b-8b135671dd3d",
                                                "text": "Mein Fahrrad hat ein Getriebe mit drei Gängen."
                                            },
                                            {
                                                "example_id": "340fc402-4ec4-4e63-8445-abcac5634592",
                                                "sense_id": "35f42592-5530-3ad9-b40b-8b135671dd3d",
                                                "text": "„Das Getriebe mahlt vor sich hin.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "5d46a1a4-b549-38c7-9cf3-cf27923e6215",
                                        "entry_id": "e1de71e5-d313-3894-ad97-d07ec55bbfed",
                                        "glosses": [
                                            "Gesamtheit der Handlungen einer Menschenmenge"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5299ec77-af05-4259-aac0-1ada0b427b62",
                                                "sense_id": "5d46a1a4-b549-38c7-9cf3-cf27923e6215",
