                        "glosses": [
                            "een ziekte bij aardappels die veroorzaakt wordt door Ralstonia solanacearum bacterie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "15b4d29f-1f76-4b06-8267-df5690a6c478",
                                "sense_id": "8475c7d2-a879-33f7-96ff-02791afdb92a",
                                "text": "Bij drie aardappeltelers in Groningen, Friesland en Noord-Holland zijn besmettingen met bruinrot ontdekt. De Nederlandse Voedsel- en Warenautoriteit (NVWA) onderzoekt de bron en eventuele verspreiding van de besmetting en legt de bedrijven maatregelen op, onder meer ten aanzien van de hygiëne."
                            }
                        ]
                    },
                    {
                        "sense_id": "1adca75b-f8f1-30a0-bae7-141bb69fd22d",
                        "entry_id": "d62a9a47-f3cc-3101-a151-da474f6ef553",
                        "glosses": [
                            "schimmelaandoening van bomen waarbij cellulose wordt afgebroken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c5049431-7dd2-431a-adbd-b3683b9f0aa7",
                                "sense_id": "1adca75b-f8f1-30a0-bae7-141bb69fd22d",
                                "text": "De eik is hol van binnen en metingen wijzen uit dat de wand van de stam te dun is geworden om de grote takken te dragen. De boom heeft bovendien last van bruinrot die wordt veroorzaakt door de zwavelzwam."
                            }
                        ]
                    }
