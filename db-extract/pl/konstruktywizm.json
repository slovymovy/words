                                                "text": "Mondriaan war ein Vertreter des Konstruktivismus."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "eb4619b5-8625-3b99-a4a2-963a0c0152ea",
                                        "entry_id": "f7aadaf3-c4c0-3658-a117-16e32f4f36bd",
                                        "glosses": [
                                            "Richtung innerhalb der russischen Literatur, deren Vertreter sich um die Bedingungen der proletarischen Kunst bemühten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fddc77cf-4dfc-486b-8ef5-dbc8b6cccb12",
                                                "sense_id": "eb4619b5-8625-3b99-a4a2-963a0c0152ea",
                                                "text": "Juri liest vorzugsweise Bücher des Konstruktivismus."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "cf240f4f-2620-3deb-a3f5-bb3a6e8ddce6",
                                        "entry_id": "f7aadaf3-c4c0-3658-a117-16e32f4f36bd",
                                        "glosses": [
                                            "Denkweise, die von der Konstruktion der Realität durch den Betrachter ausgeht"
                                        ],
                                        "tags": [
                                            "Erkenntnistheorie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "615eeafd-d2c2-439b-9ba4-b2e2c7ce37ef",
                                                "sense_id": "cf240f4f-2620-3deb-a3f5-bb3a6e8ddce6",
                                                "text": "Der Konstruktivismus hat eine andere Auffassung von der Realität als der Realismus."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "60cbd46c-5f41-35b5-9ba9-5ed8ba31946c",
                                        "entry_id": "f7aadaf3-c4c0-3658-a117-16e32f4f36bd",
                                        "glosses": [
                                            "Stilrichtung der (vor allem sowjetischen) Baukunst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b13a7ec0-5067-4e63-92b3-f89a8def535d",
                                                "sense_id": "60cbd46c-5f41-35b5-9ba9-5ed8ba31946c",
                                                "text": "„Allein in Moskau gibt es noch rund 70 Gebäude im damals entwickelten Stil, dem Konstruktivismus, darunter Fabriken und Kommunenhäuser.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "3785cfa3-f93c-36df-9099-aeb5b89518e7",
                                        "entry_id": "f7aadaf3-c4c0-3658-a117-16e32f4f36bd",
                                        "glosses": [
                                            "einer von mehreren umfassenden metatheoretischen Ansätzen auf dem Gebiet der Internationalen Beziehungen"
                                        ],
                                        "tags": [
                                            "Internationale Beziehungen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "246023ff-b159-4d02-ab3f-274641e57450",
                                                "sense_id": "3785cfa3-f93c-36df-9099-aeb5b89518e7",
                                                "text": "„Der politikwissenschaftliche Konstruktivismus zielt auf die Erklärung von politischen Handlungsmustern. Typisch ist dabei, dass in Anlehnung an Grundideen sonstiger konstruktivistischer Theorien in der Philosophie und in Nachbarwissenschaften Handlung als Ergebnis einer sozialen Situation bzw. von vorherrschenden sozialen Strukturen verstanden wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
                    },
