                "senses": [
                    {
                        "sense_id": "3dd46961-0362-33aa-9e1f-cbfc39f04403",
                        "entry_id": "80827c1d-80d0-3055-b453-376735e59917",
                        "glosses": [
                            "König, der in Preußen regierte"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "fac3087c-d306-4bdf-b02e-4953b8351dbe",
                                "sense_id": "3dd46961-0362-33aa-9e1f-cbfc39f04403",
                                "text": "„Bemerkenswert ist vor allem, dass der Preußenkönig auch nach der Thronbesteigung auf das für ihn so bedeutenden Kronprinzenbildnis zurückgriff und es von Antoine Pesne selber für die Württemberger fertigen ließ.“"
                            },
                            {
                                "example_id": "5fa953a8-624b-4554-8dc3-67bc1b04c4e6",
                                "sense_id": "3dd46961-0362-33aa-9e1f-cbfc39f04403",
                                "text": "„Preußenkönig Friedrich Wilhelm III. steht am 7. Juli 1807 frierend am Ufer der Memel bei Tilsit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
