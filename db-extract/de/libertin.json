                        "sense_id": "dddb654e-de06-3124-83b1-d16537dc9393",
                        "entry_id": "9f2abc45-9722-351a-931b-a9c423783e00",
                        "glosses": [
                            "im 18. Jahrhundert ein Freigeist, doch später als Synonym für einen zügellosen Menschen verwendet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "29adc611-6266-46c2-934b-de998aaf57a7",
                                "sense_id": "dddb654e-de06-3124-83b1-d16537dc9393",
                                "text": "„Dieser Libertin, der seine Leidenschaften als Spielzeug braucht, bei dem sie aber zugleich so heftig sind, daß sie wieder zur Wahrheit werden und ihn im 3. Akte körperlich krank machen.“"
                            },
                            {
                                "example_id": "ad42c28f-6a90-496f-8cca-2ecb3720afe6",
                                "sense_id": "dddb654e-de06-3124-83b1-d16537dc9393",
                                "text": "„Ich konnte mich C. C. weder als Ehrenmann noch als Libertin nähern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
