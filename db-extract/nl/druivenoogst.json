                "senses": [
                    {
                        "sense_id": "26bfa420-6351-38d0-a0d8-83eec8e25944",
                        "entry_id": "2dbc328c-f4b1-3884-98c6-a1585a0509f2",
                        "glosses": [
                            "de rijpe druiven die men kan plukken in een wijngaard of druivenkwekerij; opbrengst van een wijngaard of druivenkwekerij"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "34428986-4ac5-4449-b3ff-cb4b98208161",
                                "sense_id": "26bfa420-6351-38d0-a0d8-83eec8e25944",
                                "text": "'Ik raak mijn enorme druivenoogst kwijt dankzij die buurtapp'"
                            },
                            {
                                "example_id": "17060351-5a3a-4229-b2c6-41c9fde3d7ed",
                                "sense_id": "26bfa420-6351-38d0-a0d8-83eec8e25944",
                                "text": "Wijnmaker Stamatis Mylonas moet voor zijn product bijna alles importeren. \"Flessen, kurken, machines, etiketten, noem maar op... Alleen de druiven komen uit Griekenland. De laatste druivenoogst in juli kon ik niet direct verwerken. Pas in augustus kon ik de benodigde spullen kopen.\""
                            },
                            {
                                "example_id": "8f83fe02-5495-4b9b-80d4-f9640b9a5b90",
                                "sense_id": "26bfa420-6351-38d0-a0d8-83eec8e25944",
                                "text": "Franse en Italiaanse wijnboeren voorspellen een historisch lage wijnproductie in 2012. De Franse druivenoogst valt naar verwachting 20 procent lager uit dan in 2011. En ook in Italië bereidt men zich voor op een mager wijnjaar."
                            }
                        ]
                    }
                ],
