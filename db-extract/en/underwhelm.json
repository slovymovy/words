                                                "example_id": "ddc602b3-37a1-4c67-84e9-e7b0a0be1fd3",
                                                "sense_id": "caf0332b-5971-37d4-9248-4bda2c69db41",
                                                "text": "Ich kann nicht sagen, dass es mich verwundert, aber enttäuschen tut es mich schon."
                                            },
