                "senses": [
                    {
                        "sense_id": "463b0287-ea88-38a4-bf09-4edff0a5c2c5",
                        "entry_id": "3f6731fa-8f28-3c4c-a6f4-4ff2b39728d0",
                        "glosses": [
                            "Étirer pour séparer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "276635a2-4ae4-4475-89c1-c7306633e1e6",
                                "sense_id": "463b0287-ea88-38a4-bf09-4edff0a5c2c5",
                                "text": "Ces décompressions sont utiles pour décoapter la colonne après le port de lourdes charges, ou après une sollicitation intense extraordinaire du dos."
                            },
                            {
                                "example_id": "633fef03-d0d8-40c5-afae-7094a814c579",
                                "sense_id": "463b0287-ea88-38a4-bf09-4edff0a5c2c5",
                                "text": "Même si les soies maxillaires peuvent momentanément se décoapter comme chez certains Lépidoptères (Parastichtis monoglypha Hufn.), il est nécessaire que les deux canaux nourricier et salivaire soient constitués au moment de l’aspiration et de l’expiration produites par l’animal."
                            }
                        ]
                    }
