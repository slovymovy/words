    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "af98d98b-c6e2-370d-8f8c-016971dc9469",
                    "sense_definition": "Een voorlopige opzet of eerste versie van een tekst of tekening.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "ontwerp",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij schreef de eerste <w>klad</w> van zijn brief op een oud stuk papier.",
                            "target_lang_translations": {
                                "en": "He wrote the first <w>draft</w> of his letter on an old piece of paper."
                            }
                        },
                        {
                            "text": "Voordat je de definitieve versie inlevert, moet je eerst een <w>klad</w> maken.",
                            "target_lang_translations": {
                                "en": "Before you hand in the final version, you must first make a <w>rough draft</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "concept"
                    ],
                    "common_phrases": [
                        "in klad schrijven"
                    ],
                    "target_lang_definitions": {
                        "en": "A preliminary sketch, outline, or first version of a text or drawing."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "draft",
                                "target_lang_sense_clarification": "a preliminary version of a piece of writing"
                            },
                            {
                                "target_lang_word": "rough draft",
                                "target_lang_sense_clarification": "an initial, unpolished version of a text"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0fc2ca53-b1e6-30b3-aa2e-7e0b8bc8dc80",
                    "sense_definition": "Een ongewenste vlek of smet, bijvoorbeeld van inkt of vuil.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "vlek",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er zat een grote zwarte <w>klad</w> op zijn schone witte hemd.",
                            "target_lang_translations": {
                                "en": "There was a large black <w>blot</w> on his clean white shirt."
                            }
                        },
                        {
                            "text": "Door de lekkende pen kwam er een lelijke <w>klad</w> op het papier.",
                            "target_lang_translations": {
                                "en": "The leaking pen left an ugly <w>smudge</w> on the paper."
                            }
                        }
                    ],
                    "synonyms": [
                        "vlek",
                        "smet"
                    ],
                    "target_lang_definitions": {
                        "en": "An unwanted stain, spot, or blemish, such as from ink or dirt."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "blot",
                                "target_lang_sense_clarification": "a spot or stain made by ink or a similar substance"
                            },
                            {
                                "target_lang_word": "spot",
                                "target_lang_sense_clarification": "a small mark or stain on a surface"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "babebec3-e438-3784-b169-759abf648cec",
                    "sense_definition": "Een uitgestelde betaling of aankoop op rekening.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "krediet",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij kocht zijn drankjes in het café op de <w>klad</w>.",
                            "target_lang_translations": {
                                "en": "He bought his drinks in the pub on <w>credit</w>."
                            }
                        },
                        {
                            "text": "De barman schreef de consumpties op de <w>klad</w> van de vaste klant.",
                            "target_lang_translations": {
                                "en": "The bartender put the drinks on the regular customer's <w>tab</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "krediet"
                    ],
                    "common_phrases": [
                        "op de klad"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used in informal contexts regarding buying on credit"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A deferred payment or purchase on credit, especially in a bar or shop."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "tab",
                                "target_lang_sense_clarification": "a restaurant or bar bill to be paid later"
                            },
                            {
                                "target_lang_word": "credit",
                                "target_lang_sense_clarification": "buying goods or services with deferred payment"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8a7d2693-749c-3841-86a2-ec411be43d85",
                    "sense_definition": "Een in het wild levende duif.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "vogel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In het bos zagen we een schuwe <w>klad</w> tussen de bomen vliegen.",
                            "target_lang_translations": {
                                "en": "In the forest, we saw a shy <w>wild pigeon</w> flying among the trees."
                            }
                        },
                        {
                            "text": "De jager probeerde een wilde <w>klad</w> te spotten in het veld.",
                            "target_lang_translations": {
                                "en": "The hunter tried to spot a wild <w>dove</w> in the field."
                            }
                        }
                    ],
                    "synonyms": [
                        "kladduif",
                        "veldduif",
                        "veldklad"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "used in specific dialects for wild pigeons"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A wild pigeon or dove."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "wild pigeon",
                                "target_lang_sense_clarification": "a pigeon living in the wild"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "de0a2960-7d8c-3731-8f58-edc8a17bddac",
                    "sense_definition": "Eerste persoon enkelvoud tegenwoordige tijd van <w>kladden</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "werkwoordsvorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>klad</w> snel wat aantekeningen op een briefje tijdens het bellen.",
                            "target_lang_translations": {
                                "en": "I quickly <w>scribble</w> some notes on a piece of paper while on the phone."
                            }
                        },
                        {
                            "text": "Als ik me verveel, <w>klad</w> ik vaak de hele pagina vol met poppetjes.",
                            "target_lang_translations": {
                                "en": "When I am bored, I often <w>scrawl</w> stick figures all over the page."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "first-person singular present"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "First-person singular present tense of the verb 'kladden' (to scribble, scrawl, or smudge)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "scribble",
                                "target_lang_sense_clarification": "to write or draw something quickly or carelessly"
                            },
                            {
                                "target_lang_word": "scrawl",
                                "target_lang_sense_clarification": "to write in a hurried, untidy way"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "51f6a4ed-bb7a-3d0f-ac34-09bf0e76c913",
                    "sense_definition": "Gebiedende wijs van <w>kladden</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "werkwoordsvorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Klad</w> niet zo op die schone muur, gebruik liever een papier!",
                            "target_lang_translations": {
                                "en": "Don't <w>scribble</w> on that clean wall like that, use a piece of paper instead!"
                            }
                        },
                        {
                            "text": "Alsjeblieft, <w>klad</w> die belangrijke documenten niet zo slordig onder.",
                            "target_lang_translations": {
                                "en": "Please don't <w>scrawl</w> all over those important documents so messily."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "imperative"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Imperative form of the verb 'kladden' (to scribble, scrawl, or smudge)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "scribble",
                                "target_lang_sense_clarification": "command to write or draw carelessly"
                            },
                            {
                                "target_lang_word": "scrawl",
