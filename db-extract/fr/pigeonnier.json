        "fr-extract.jsonl": [
            {
                "entry_id": "4649eca8-925e-3c21-821f-8129920db15a",
                "word": "pigeonnier",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "b9cf39a9-00dd-40ea-9145-285a4c1bf8cf",
                        "entry_id": "4649eca8-925e-3c21-821f-8129920db15a",
                        "tags": [
                            "plural"
                        ],
                        "form": "pigeonniers"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9ca9c9bf-75b7-3a1a-a98a-0ef6c6886c2a",
                        "entry_id": "4649eca8-925e-3c21-821f-8129920db15a",
                        "glosses": [
                            "Construction destinée à loger les pigeons domestiques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bbfd6977-b19d-4dd3-b578-8748806258c1",
                                "sense_id": "9ca9c9bf-75b7-3a1a-a98a-0ef6c6886c2a",
                                "text": "Confondu dans le pays avec le four à chanvre qui lui ressemble étrangement, le pigeonnier est souvent plus soigné dans sa construction. C'est un élément plus rare du décor architectural car il provient, pour l'essentiel, d'anciens domaines."
                            },
                            {
                                "example_id": "a88c384d-1192-4c43-b8a8-177adc57edff",
                                "sense_id": "9ca9c9bf-75b7-3a1a-a98a-0ef6c6886c2a",
                                "text": "Le Gers n'est certainement pas le département le plus fourni en pigeonniers mais il n'est pas rare d'en croiser au détour des petites routes de campagne et ce sur tout le territoire. Ces petites bâtisses d'ornement sont parfois surprenantes par leur forme, leur emplacement, leur décor."
                            },
                            {
                                "example_id": "e796db29-b152-4fc5-aa66-cca7a69710b5",
                                "sense_id": "9ca9c9bf-75b7-3a1a-a98a-0ef6c6886c2a",
                                "text": "Après un contact téléphonique et une vérification nocturne dans son pigeonnier par le propriétaire, il s’est avéré qu’il lui manquait 26 pigeons de compétition."
                            }
                        ]
                    },
                    {
                        "sense_id": "32cd4f3c-1a66-35fe-bbfd-9d25dab2a825",
                        "entry_id": "4649eca8-925e-3c21-821f-8129920db15a",
                        "glosses": [
                            "Habitation élevée."
                        ],
                        "tags": [
                            "familiar",
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "47b756fe-b941-4c25-b7f5-7a99c2d952c3",
                                "sense_id": "32cd4f3c-1a66-35fe-bbfd-9d25dab2a825",
                                "text": "Je le trouve ailleurs , ne vous déplaise , repartit Boisrobert: M. de Balzac ne reste confiné dans son pigeonnier depuis plus de quinze ans , que pour faire pièce à Votre Éminence."
                            }
                        ]
                    },
                    {
                        "sense_id": "0c49f8d9-2455-3b8f-bcd8-4db65aa4cbc6",
                        "entry_id": "4649eca8-925e-3c21-821f-8129920db15a",
                        "glosses": [
                            "Boîte aux lettres ou un système de boîtes aux lettres collectif souvent utilisé dans un milieu administratif ou scolaire."
                        ],
                        "tags": [
                            "Québec"
                        ],
                        "examples": [
                            {
                                "example_id": "86ba23d4-6445-488c-8862-3f7c62d409d3",
                                "sense_id": "0c49f8d9-2455-3b8f-bcd8-4db65aa4cbc6",
                                "text": "En allant chercher mon courrier dans le pigeonnier, je croise Jean-Pierre, un prof de physique."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "37766114-7868-47db-a359-686a04ec0254",
                        "source_entry_id": "4649eca8-925e-3c21-821f-8129920db15a",
                        "target_lang_word": "Taubenschlag",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Taubenschlag",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "252f8a45-e619-33e3-a7ec-ff71377957db",
                                        "entry_id": "5823d365-4104-3c9d-83ff-745a05399f37",
                                        "glosses": [
                                            "Verschlag, der Haustauben Schutz vor Witterungseinflüssen und natürlichen Feinden bietet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d282d4b6-a3dc-468f-a7b8-756e77ec81d1",
                                                "sense_id": "252f8a45-e619-33e3-a7ec-ff71377957db",
                                                "text": "Auf der Flucht vor einem Habicht konnte sich die Taube in den Taubenschlag retten."
                                            },
                                            {
                                                "example_id": "69e584e9-96a8-4d01-8ab3-d14c3f2cbd37",
                                                "sense_id": "252f8a45-e619-33e3-a7ec-ff71377957db",
                                                "text": "„Er forderte von der Stadt eine vorübergehende Aufhebung des Fütterungsverbotes und neue Taubenschläge zur kontrollierten Haltung der Vögel, um deren \"Leid\" in den Griff zu bekommen.“"
                                            },
                                            {
                                                "example_id": "e39b3944-6a6c-431e-b908-04699a9a290d",
                                                "sense_id": "252f8a45-e619-33e3-a7ec-ff71377957db",
                                                "text": "„Kosole erzählt, dass er heute Nachmittag seinen Taubenschlag reparieren will.“"
                                            },
                                            {
                                                "example_id": "c384c44f-17c1-45ea-8945-0401cd51d066",
                                                "sense_id": "252f8a45-e619-33e3-a7ec-ff71377957db",
                                                "text": "„In einer Ecke des Hühnerhofs wurde ein Taubenschlag aufgestellt.“"
                                            },
                                            {
                                                "example_id": "2c2ac939-ad5f-479a-a5f6-6e1ff14e3451",
                                                "sense_id": "252f8a45-e619-33e3-a7ec-ff71377957db",
                                                "text": "„Die Welle der Kelter erschien ihnen riesenhaft; dann stiegen sie in den Taubenschlag hinauf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5b57a78f-0255-40c7-b680-d9e841707b93",
                        "source_entry_id": "4649eca8-925e-3c21-821f-8129920db15a",
                        "target_lang_word": "dovecote",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dovecote",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "95f6a4fc-0630-3803-bc6f-7935033272fe",
                                        "entry_id": "fe9e8bc8-15a4-380f-84ff-7f5293126354",
                                        "glosses": [
                                            "A small house or box, often raised to a considerable height above the ground, and having compartments (pigeonholes), in which domestic pigeons breed; a dove house."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f38c7b1e-dcb6-4641-a84a-8c5b794d5438",
                                                "sense_id": "95f6a4fc-0630-3803-bc6f-7935033272fe",
                                                "text": "If you haue writ your Annales true, 'tis there, / That like an Eagle in a Doue-cote, I / Flutter'd your Volcians in Corioles."
                                            },
                                            {
                                                "example_id": "f961b99d-6304-472c-a1c7-28ca94773621",
                                                "sense_id": "95f6a4fc-0630-3803-bc6f-7935033272fe",
                                                "text": "she could see the malt-house with its dovecote"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "de14b183-4683-34cb-a204-c18ad8e58b12",
                                        "entry_id": "fe9e8bc8-15a4-380f-84ff-7f5293126354",
                                        "glosses": [
                                            "In medieval Europe, a round or square structure of stone or wood, free-standing or built into a tower, in which pigeons were kept."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
