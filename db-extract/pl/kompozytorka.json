                "translations": [
                    {
                        "translation_id": "38c3f885-4811-4fa4-a68a-1e95dc9c7b37",
                        "source_entry_id": "a21a2810-8d96-3222-8393-ee1461333cd1",
                        "source_sense_id": "622a37ff-39fa-32e1-95b5-136c055a7dcb",
                        "target_lang_word": "compositrice",
                        "target_lang_code": "fr",
