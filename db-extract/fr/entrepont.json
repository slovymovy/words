                ],
                "senses": [
                    {
                        "sense_id": "2b415d2f-544b-37a0-bad1-140e229de84a",
                        "entry_id": "b24d5957-4b58-3d4d-beaa-a50aa3be6f4b",
                        "glosses": [
                            "Intervalle, étage qui sépare deux ponts dans un vaisseau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0187c350-986c-4d54-9f59-a5f5f8b9fd45",
                                "sense_id": "2b415d2f-544b-37a0-bad1-140e229de84a",
                                "text": "Il voulut que les entre-ponts, étroits et rentrés, n’eussent que trois pieds quatre pouces de haut, prétendant que cette dimension permettait aux esclaves de taille raisonnable d’être commodément assis."
                            },
                            {
                                "example_id": "bd29d596-f523-434e-bf0a-5316abadf427",
                                "sense_id": "2b415d2f-544b-37a0-bad1-140e229de84a",
                                "text": "La pestilentielle odeur de friture à l’huile qui s’échappe de l’entrepont fait le trait d’union entre les cuisines espagnoles et les cuisines marocaines et met déjà le cœur à l’envers."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2df8f34f-25d5-42f2-a746-b08990070627",
                        "source_entry_id": "b24d5957-4b58-3d4d-beaa-a50aa3be6f4b",
                        "source_sense_id": "2b415d2f-544b-37a0-bad1-140e229de84a",
                        "source_sense_description": "étage qui sépare deux ponts d’un vaisseau",
                        "target_lang_word": "'tween-decks",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "a4fd8289-2024-4d67-b4a2-e67fdc6e1932",
                        "source_entry_id": "b24d5957-4b58-3d4d-beaa-a50aa3be6f4b",
                        "source_sense_id": "2b415d2f-544b-37a0-bad1-140e229de84a",
                        "source_sense_description": "étage qui sépare deux ponts d’un vaisseau",
                        "target_lang_word": "steerage",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "steerage",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3e0f1ba1-ced8-39c6-8320-d684f41e79d4",
                                        "entry_id": "d3f8cd5e-59ef-35be-9689-02d7623ba269",
                                        "glosses": [
                                            "The art of steering."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8b22e538-311f-3ff2-877a-44dd19c0a824",
                                        "entry_id": "d3f8cd5e-59ef-35be-9689-02d7623ba269",
                                        "glosses": [
                                            "The section of a passenger ship that provided inexpensive accommodation with no individual cabins."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a9c75986-21da-4d73-905e-76c1ad483fc8",
                                                "sense_id": "8b22e538-311f-3ff2-877a-44dd19c0a824",
                                                "text": "It is stuffy in the steerage where the second-classers sleep,\nFor there's near a hundred for'ard, and they're stowed away like sheep"
                                            },
                                            {
                                                "example_id": "dd312921-a213-476e-8642-d3a61fd22377",
                                                "sense_id": "8b22e538-311f-3ff2-877a-44dd19c0a824",
                                                "text": "Hope was alive again in my breast, and I looked about me with greater coolness. I noted that the boats were missing. The steerage told the same tale as the forecastle. The hunters had packed their belongings with similar haste. The Ghost was deserted. It was Maud's and mine. I thought of the ship's stores and the lazarette beneath the cabin, and the idea came to me of surprising Maud with something nice for breakfast."
                                            },
                                            {
                                                "example_id": "c12f8262-4f58-4e76-9f36-26f0d028c0a7",
                                                "sense_id": "8b22e538-311f-3ff2-877a-44dd19c0a824",
                                                "text": "“I have visited my quarters, and find them very comfortable.[…]Steerage is like everything else maritime[…]vastly improved since Robert Louis Stevenson took his trip third class to New York.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3b58b345-7419-3983-b271-88d56f1f1a56",
                                        "entry_id": "d3f8cd5e-59ef-35be-9689-02d7623ba269",
                                        "glosses": [
                                            "The effect of the helm on a ship."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
