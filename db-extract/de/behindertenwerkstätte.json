                "senses": [
                    {
                        "sense_id": "3101f593-7756-3361-975d-efe6ebff9e9d",
                        "entry_id": "f2765339-c408-30ec-a3e1-2109fe05ac4b",
                        "glosses": [
                            "Arbeitsstätte für Menschen mit Behinderungen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b394207d-05de-498f-b647-8b05de9dc9e7",
                                "sense_id": "3101f593-7756-3361-975d-efe6ebff9e9d",
                                "text": "„Deutschlandweit arbeiten 300 000 Menschen in Behindertenwerkstätten.“"
                            },
                            {
                                "example_id": "aa6a45d5-2b25-4c06-9adc-c3b301069991",
                                "sense_id": "3101f593-7756-3361-975d-efe6ebff9e9d",
                                "text": "„Hauptnutzer des Gebäudes war jahrzehntelang die Lebenshilfe mit einer Behindertenwerkstätte.“"
                            },
                            {
                                "example_id": "5b06f88c-5c35-4af2-b6d5-e8f089673feb",
                                "sense_id": "3101f593-7756-3361-975d-efe6ebff9e9d",
                                "text": "„Mieter war seit Jahrzehnten der Staat, der dort eine Behindertenwerkstätte betrieb.“"
                            },
                            {
                                "example_id": "d2ab68d5-b9bd-405c-bcb6-d18761a8dae1",
                                "sense_id": "3101f593-7756-3361-975d-efe6ebff9e9d",
                                "text": "„Markus Hebgen, Stiftungsvorstand in Eberbach, hatte den Bundespräsidenten und seine Frau am Samstag zur Begrüßung kleine Kreuze aus Rebstockholz, gefertigt in der Behindertenwerkstätte des St. Vincenzstifts in Rüdesheim, überreicht.“"
                            },
                            {
                                "example_id": "e000978c-337c-406c-a3c9-00b14ff1cb17",
                                "sense_id": "3101f593-7756-3361-975d-efe6ebff9e9d",
                                "text": "„Garten und Landschaftsbau, Metallbau, Lebensmittelherstellung, Produktion von Kleidung: Die Leistungen der fast 100 Behindertenwerkstätten in Nordrhein-Westfalen und ihrer annähernd 70.000 Beschäftigten decken nahezu alle Wirtschaftsbereiche ab.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
