                "senses": [
                    {
                        "sense_id": "a1bddf1a-9e0a-3148-b226-041659996679",
                        "entry_id": "c35925f1-1733-3429-a648-1886fc81346c",
                        "glosses": [
                            "Lehre der Schönheit; das Schöne (in der Kunst)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fac66eee-5ca7-4244-8b4c-b2d04f140064",
                                "sense_id": "a1bddf1a-9e0a-3148-b226-041659996679",
                                "text": "„»Philosophie der Kunst«, könnte man sagen, ist »Kallistik«, Schönheitslehre« – und nur, weil deren Bereich weiter gefaßt ist, beläßt Hegel es für sein Unternehmen bei »Ästhetik« und »Philosophie der Kunst«.“"
                            },
                            {
                                "example_id": "f55f7ec4-caed-4408-8057-35c2245d29f1",
                                "sense_id": "a1bddf1a-9e0a-3148-b226-041659996679",
                                "text": "Die Kallistik bietet einen Abschluß menschlicher Weltorientierung um den Preis existenzieller Entwirklichung."
                            },
                            {
                                "example_id": "4a7f9f95-8720-4a45-b1a8-62f33f604cb0",
                                "sense_id": "a1bddf1a-9e0a-3148-b226-041659996679",
                                "text": "Um des Unpassenden oder eigentlicher um des Oberflächlichen dieses Namens willen hat man denn auch andere, z. B. den Namen Kallistik, zu bilden versucht. Doch auch dieser zeigt sich als ungenügend, denn die Wissenschaft, die gemeint ist, betrachtet nicht das Schöne überhaupt, sondern rein das Schöne der Kunst."
                            },
                            {
                                "example_id": "6412a558-c66f-4317-a7dd-c536a61e0585",
                                "sense_id": "a1bddf1a-9e0a-3148-b226-041659996679",
                                "text": "Ästhetisch im Sinne neuzeitlicher Kallistik heißt alles, was sich auf den Gefühlszustand des menschlichen Gemütes bezieht."
                            },
                            {
                                "example_id": "66f96a0a-ec25-452e-aef7-01ae7fae06e8",
                                "sense_id": "a1bddf1a-9e0a-3148-b226-041659996679",
                                "text": "„Das Mögliche fasst Duchamp als zerstörerische Kraft gegen das Ästhetische und das Schöne, das »Kallistische« auf: »Das Mögliche ist nur/(Genre Vitriol)/eine physische ›Ätze‹/die jede Ästhetik oder Kallistik versengt//.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
