                        "sense_id": "043029dc-5947-3915-a429-5cad53b5fcc1",
                        "entry_id": "a1e908a6-1258-3c74-bb44-1508e4ff5a81",
                        "glosses": [
                            "One of the fine soft hairs on fruits, flowers, and other parts of plants."
                        ],
