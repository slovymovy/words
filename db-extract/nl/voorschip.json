                        "tags": [
                            "plural"
                        ],
                        "form": "voorschepen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7f074ec9-f56e-32b9-a673-ada9355381fd",
                        "entry_id": "3ea29505-f1cd-35ba-a4f3-4e3d56d6819e",
                        "glosses": [
                            "voorste deel van een schip"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f40b51a-efc3-4eab-85f1-ff36aec201ec",
                                "sense_id": "7f074ec9-f56e-32b9-a673-ada9355381fd",
                                "text": "Nadat het schip in tweeën brak, zonk het voorschip met de daarop verzamelde schipbreukelingen. Door het grote aantal slachtoffers, 129 passagiers en bemanningsleden, ging deze ramp de geschiedenisboeken in als de grootste scheepsramp bij Hoek van Holland. Nieuw was de massa ramptoeristen die op de reddingspogingen en, erna, op het wrak af kwam."
                            },
                            {
                                "example_id": "5cf2e0cc-7892-4d14-ac3b-9294adae31e4",
                                "sense_id": "7f074ec9-f56e-32b9-a673-ada9355381fd",
                                "text": "Inwendig overtuigt de Azuree 41 met in het voorschip een luxe eigenaarshut met veel kastruimte en een diagonaal geplaatste douche. De beide hutten in het achterschip zijn identiek, eentje heeft een natte cel. De salon voorziet in een in lengterichting geplaatste kombuis met alle voorzieningen die nodig zijn voor langer verblijf."
                            },
                            {
                                "example_id": "d6baa94a-6fac-4d04-8993-a5b4455dde80",
                                "sense_id": "7f074ec9-f56e-32b9-a673-ada9355381fd",
                                "text": "Vlak voor ze werden aangevaren hoorde de dochter vanuit het voorschip van de Bolero haar moeder aan haar vader vragen: „Markus, heb je dat schip niet gezien?” Ze stond op, zag het grote zwarte schip naderen, groen water golfde over de reling. De boot kantelde. Een klap volgde."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d06b4fae-49fc-4758-8790-838ac590857b",
                        "source_entry_id": "3ea29505-f1cd-35ba-a4f3-4e3d56d6819e",
                        "source_sense_id": "7f074ec9-f56e-32b9-a673-ada9355381fd",
                        "target_lang_word": "prow",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prow",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "489a93ed-8d5e-3008-8704-76eae02f0531",
                                        "entry_id": "69d78310-1f2f-3942-9aaa-8c2ed74cbbe5",
                                        "glosses": [
                                            "The front part of a vessel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "968e4c11-3e41-4533-bc00-c8778e791a0a",
                                                "sense_id": "489a93ed-8d5e-3008-8704-76eae02f0531",
                                                "text": "The floating vessel swum / Uplifted, and secure with beaked prow / rode tilting o'er the waves."
                                            },
                                            {
                                                "example_id": "d3cb1c33-d955-4968-a706-cd6a8d1755f8",
                                                "sense_id": "489a93ed-8d5e-3008-8704-76eae02f0531",
                                                "text": "We were already rather close in; but I ordered the U-33's prow turned inshore and we crept slowly along, constantly dipping up the water and tasting it to assure ourselves that we didn't get outside the fresh-water current."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "06e50555-5b6b-3872-b26e-c885f2b9b90a",
                                        "entry_id": "69d78310-1f2f-3942-9aaa-8c2ed74cbbe5",
                                        "glosses": [
                                            "A vessel."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "prow",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "98881a33-2d7d-3ea3-b03c-285a00550c31",
                                        "entry_id": "ae0f9010-5eb8-38b0-a87d-fa0fc124754e",
                                        "glosses": [
                                            "Brave, valiant, gallant."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a1f9ff26-af52-4b63-891e-7c2ba92fcf7a",
                                                "sense_id": "98881a33-2d7d-3ea3-b03c-285a00550c31",
                                                "text": "For they be two the prowest knights on ground, / And oft approu’d in many hard assay […]"
                                            }
                                        ]
                                    }
                                ]
                            },
