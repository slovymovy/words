                    {
                        "translation_id": "f1174048-7135-4eb7-8a24-bbdc8d55dfcf",
                        "source_entry_id": "fdc78e7a-29b2-3272-8717-a700c0a05b49",
                        "source_sense_id": "d5933067-bd7d-3ecc-875c-3b38c5cad882",
                        "target_lang_word": "sempervirent",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sempervirent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "25faedbf-75f7-36b0-9fbf-b54114ed01af",
                                        "entry_id": "dce73eea-7725-373c-9842-3f08feaa3fe3",
                                        "glosses": [
                                            "Evergreen."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2af961eb-ca74-4783-9153-e9b6fdc7ab19",
                                                "sense_id": "25faedbf-75f7-36b0-9fbf-b54114ed01af",
                                                "text": "A boxwood-lined path, presided over by a nostalgic-looking sempervirent sequoia (which American visitor mistook for a ‘Lebanese cedar’ – if they remarked it at all) took them to the absurdly misnamed rue du Mûrier […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ee1ba220-264a-4af4-98c1-1f04e0148c42",
                        "source_entry_id": "fdc78e7a-29b2-3272-8717-a700c0a05b49",
                        "source_sense_id": "d5933067-bd7d-3ecc-875c-3b38c5cad882",
                        "target_lang_word": "evergreen",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "evergreen",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0f13fb99-9fde-3fe3-b25c-83da61b84fc1",
                                        "entry_id": "78844744-330c-3350-ae04-8a389f965273",
                                        "glosses": [
                                            "Of plants, especially trees, that do not shed their leaves seasonally."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "75af70d2-d02e-466e-a0e8-ead891f38b51",
                                                "sense_id": "0f13fb99-9fde-3fe3-b25c-83da61b84fc1",
                                                "text": "Near-synonym: nondeciduous"
                                            },
                                            {
                                                "example_id": "d2a0ad5c-eedc-4fbf-aac3-fa9711eda680",
                                                "sense_id": "0f13fb99-9fde-3fe3-b25c-83da61b84fc1",
                                                "text": "...these three little creeping vines put forth their hands with joy, and spread over rock and hillock and twisted tree-root and mouldering log, in cloaks and scarves and wreaths of tiny evergreen, glossy leaves."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "93e20184-5cc3-37ae-a959-24209df97088",
                                        "entry_id": "78844744-330c-3350-ae04-8a389f965273",
                                        "glosses": [
                                            "Continually fresh or self-renewing.",
                                            "Being a clause which causes an automatic renewal of a contract unless action is taken."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "not-comparable",
                                            "often"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9002e230-0405-37d9-8bfe-9f39b5ea413d",
                                        "entry_id": "78844744-330c-3350-ae04-8a389f965273",
                                        "glosses": [
                                            "Continually fresh or self-renewing.",
                                            "Of a document, a piece of software, or a data set: kept continually up to date (as opposed to being published at regular intervals and outdated in the meantime)"
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "not-comparable",
                                            "often"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b5adc572-056f-4202-87d0-47916dda066e",
                                                "sense_id": "9002e230-0405-37d9-8bfe-9f39b5ea413d",
                                                "text": "Chrome and Firefox are evergreen browsers: they update automatically and version numbers are only used for internal reference."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "582670b4-5227-3bba-9572-59be43bab4a7",
                                        "entry_id": "78844744-330c-3350-ae04-8a389f965273",
                                        "glosses": [
                                            "Suitable for transmission at any time; not urgent or time-dependent."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d9afdd99-6f0e-42e1-8663-4bd70b5e0bd8",
                                                "sense_id": "582670b4-5227-3bba-9572-59be43bab4a7",
                                                "text": "Another change in the news was emphasis on “evergreen” features involving attractive children or animals, parades or fireworks, as well as local developments."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "evergreen",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "49c703ff-7a6b-3d43-b769-6545ba2401b4",
                                        "entry_id": "ddb1b0c3-1ad2-3ce2-bf6f-92dded2fae1a",
                                        "glosses": [
                                            "A shrub or tree that does not shed its leaves or needles seasonally."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1c1655d-c94c-48d8-ae63-2705b06282ff",
                                                "sense_id": "49c703ff-7a6b-3d43-b769-6545ba2401b4",
                                                "text": "The lawn before them was gay with evergreens, relieved by the first few flowers and fresh turf of the reviving Spring; […]"
                                            },
                                            {
                                                "example_id": "69a682b2-7ca3-4e2b-b244-5bb75beb0499",
                                                "sense_id": "49c703ff-7a6b-3d43-b769-6545ba2401b4",
                                                "text": "Husband and wife walked till they had reached the house they were in search of, which stood in a terrace facing the sea, and was fronted by a small garden of wind-proof and salt-proof evergreens, stone steps leading up to the porch."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fdafd1df-5526-33c0-bfcd-866f31571261",
                                        "entry_id": "ddb1b0c3-1ad2-3ce2-bf6f-92dded2fae1a",
                                        "glosses": [
                                            "A conifer tree."
                                        ],
                                        "tags": [
                                            "informal",
                                            "specifically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ed669769-4f69-4fea-ad76-675b03b6cce0",
                                                "sense_id": "fdafd1df-5526-33c0-bfcd-866f31571261",
                                                "text": "The spruce and fir trees crowded to the track on each side to welcome us, the arbor- vitae, with its changing leaves, prompted us to make haste, and the sight of the canoe-birch gave us spirits to do so. Sometimes an evergreen just fallen lay across the track with its rich burden of cones, looking, still, fuller of life than our trees in the most favorable positions."
                                            },
                                            {
                                                "example_id": "7026bdca-899d-44ac-a02f-7759fe8bf0b4",
                                                "sense_id": "fdafd1df-5526-33c0-bfcd-866f31571261",
                                                "text": "Deep down in Louisiana, close to New Orleans, / Way back up in the woods among the evergreens, / There stood a log cabin made of earth and wood / Where lived a country boy named Johnny B. Goode"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "774fbd23-0993-301a-8ac1-ca353d026395",
                                        "entry_id": "ddb1b0c3-1ad2-3ce2-bf6f-92dded2fae1a",
                                        "glosses": [
                                            "A news story that can be published or broadcast at any time."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "evergreen",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f54e8cba-fb9f-383b-adb7-5675553c9c09",
                                        "entry_id": "2e9b4e1c-8749-36aa-81ed-697db4c34240",
                                        "glosses": [
                                            "To extend the term of a patent beyond the normal legal limit, usually through repeated small modifications."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9bdf1f80-5706-3843-b103-59db665ea825",
