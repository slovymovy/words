                    {
                        "translation_id": "7e990c13-5969-4cd3-bc99-6bceb6839c93",
                        "source_entry_id": "48b6970f-3b89-3bda-a73b-29b5fd7e785a",
                        "source_sense_id": "d59aaa81-8de2-39ec-9bce-0f25cb43499e",
                        "target_lang_word": "ponton",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ponton",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "39e1e77c-0b72-36ef-baba-c2edcc6f4b53",
                                        "entry_id": "60ca0921-645c-3654-b634-523e7e338caa",
                                        "glosses": [
                                            "Pont flottant, ensemble composé de deux ou de plusieurs bateaux joints par des poutres et couverts de madriers, dont on se sert pour faire passer une rivière, un fleuve à des troupes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80efc74c-a516-4c68-a0b8-18bf5f6c09f6",
                                                "sense_id": "39e1e77c-0b72-36ef-baba-c2edcc6f4b53",
                                                "text": "[…], et un bateau à vapeur du service municipal de la Tamise heurta si violemment le ponton de Westminster qu’il n’échappa au naufrage qu’en allant s’enliser sur la rive opposée, dans la vase découverte par la marée basse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3b1b45b4-c391-36e0-85fd-e1c6a6fb8b25",
                                        "entry_id": "60ca0921-645c-3654-b634-523e7e338caa",
                                        "glosses": [
                                            "Grand bateau plat et ponté, employé pour divers usages dans les ports."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0e5ef7bc-f426-31bb-9e85-064d6f9e4be7",
                                        "entry_id": "60ca0921-645c-3654-b634-523e7e338caa",
                                        "glosses": [
                                            "Cale flottante qui sert de station pour les bateaux qui transportent des voyageurs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "06e80836-e280-4a6a-a773-254df6239ba5",
                                                "sense_id": "0e5ef7bc-f426-31bb-9e85-064d6f9e4be7",
                                                "text": "Cette étonnante coopérative ouvrière d'une soixantaine d'hommes-grenouilles, créée en 1952 par des « mordus » de la spéléologie a son quartier général sur un vieux ponton, ancré au pied des piles du pont de Bercy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ce8e6f75-4c18-3dc5-8ead-dbf56897898a",
                                        "entry_id": "60ca0921-645c-3654-b634-523e7e338caa",
                                        "glosses": [
                                            "Vaisseaux démâtés, où l’on enfermait des prisonniers."
                                        ],
                                        "tags": [
                                            "Prison"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "df605cf9-eeae-45d7-8ef4-f7c9f64551a1",
                                                "sense_id": "ce8e6f75-4c18-3dc5-8ead-dbf56897898a",
                                                "text": "Un grain tombe sur sa mâture\nV'là le corsaire en ponton !"
                                            },
                                            {
                                                "example_id": "e29f76f6-4a9e-4643-9f3f-817f31de70f5",
                                                "sense_id": "ce8e6f75-4c18-3dc5-8ead-dbf56897898a",
                                                "text": "[…]; vous êtes de la même année que cette pauvre Junon, le meilleur voilier qui soit jamais entré dans le port de Saint-Malo; et je me souviens même que, peu de jours après notre mariage, on la fit raser pour en faire un ponton."
                                            },
                                            {
                                                "example_id": "169d1edd-061f-4bf4-ab51-fa4653b8b055",
                                                "sense_id": "ce8e6f75-4c18-3dc5-8ead-dbf56897898a",
                                                "text": "Voyez-vous, monsieur, ils auront beau nous fusiller en grand, nous déporter, nous exporter, mettre Cayenne au bout de Satory, bourrer les pontons comme des barils à sardines, le Parisien aime l’émeute, et rien ne pourra lui enlever ce goût-là !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6a9d4b6d-3976-414b-ab30-76e68132117e",
                        "source_entry_id": "48b6970f-3b89-3bda-a73b-29b5fd7e785a",
                        "source_sense_id": "d59aaa81-8de2-39ec-9bce-0f25cb43499e",
                        "target_lang_word": "Schlauchboot",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schlauchboot",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0e78cddc-2481-32ee-a6a5-7913e3cb8f45",
                                        "entry_id": "8467dede-f285-3e33-a2da-c9b0d4b510c0",
                                        "glosses": [
                                            "ein Boot, dessen Rumpf aufblasbar ist und aus Hartgummi oder ähnlichen Kunststoffen besteht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c0171352-efa9-4ecf-8b78-8586b286a743",
                                                "sense_id": "0e78cddc-2481-32ee-a6a5-7913e3cb8f45",
                                                "text": "Wegen des geringen Gewichts sind Schlauchboote auch auf Land leicht zu transportieren."
                                            },
                                            {
                                                "example_id": "62434f0d-26b2-42f8-93df-bd84db636155",
                                                "sense_id": "0e78cddc-2481-32ee-a6a5-7913e3cb8f45",
                                                "text": "Modernere Schlauchboote haben einen Rumpf aus glasfaserverstärktem Kunststoff (GFK) und stehen normalen Booten ohne Schlauch in nichts nach , d.h. sie sind nach Norm unsinkbar und normalerweise als Rettungsboote klassifiziert."
                                            },
                                            {
                                                "example_id": "d69636cd-5481-429d-a4e6-51298505511c",
                                                "sense_id": "0e78cddc-2481-32ee-a6a5-7913e3cb8f45",
                                                "text": "„Renate zuliebe, die mit ihrer Mandelentzündung nicht ins Wasser durfte, wurde ein Schlauchboot gekauft, damit sie darin herumschippern konnte und auf diese Weise auch was vom Mittelmeer hatte.“"
                                            },
                                            {
                                                "example_id": "4048b872-519e-4c94-a74d-a4f36e022a2b",
                                                "sense_id": "0e78cddc-2481-32ee-a6a5-7913e3cb8f45",
                                                "text": "„Das Schlauchboot trieb nur unmerklich.“"
                                            },
                                            {
                                                "example_id": "51192210-4cb6-4efd-a203-c71d8a967392",
                                                "sense_id": "0e78cddc-2481-32ee-a6a5-7913e3cb8f45",
                                                "text": "„Schon fünf Tage schwimmen die Passagiere in ihren Schlauchbooten herum.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
