                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c1a117d0-6b32-416c-b724-0d1dadec9ccf",
                                "sense_id": "55b5c035-4a0f-32cd-babc-827ea03fde0c",
                                "text": "„Dann gedachte ich der Jahreszeit und sagte mir, dass dieses alte Puritanervolk sehr wohl Weihnachtsbräuche pflegen mochte, die mir fremd waren, erfüllt von stummen Gebeten am heimischen Herd.“"
                            },
                            {
                                "example_id": "a6e9889a-fbc3-4231-a2ef-a1417b4ca389",
                                "sense_id": "55b5c035-4a0f-32cd-babc-827ea03fde0c",
                                "text": "„In manchen Ländern gibt es den Weihnachtsbrauch, ein kleines Jesuskind in den Kuchen einzubacken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
