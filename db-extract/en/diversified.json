    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "bb81122a-9651-3b3f-9079-b316b3e2bdd4",
                "word": "diversified",
                "pos": "adj",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "2b2ce48b-016a-456e-9b46-bdaaa78b53ee",
                        "entry_id": "bb81122a-9651-3b3f-9079-b316b3e2bdd4",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more diversified"
                    },
                    {
                        "form_id": "4d60e48e-2fca-4a7d-9b4e-3dd4c5225787",
                        "entry_id": "bb81122a-9651-3b3f-9079-b316b3e2bdd4",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most diversified"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ccd00144-56cf-34eb-b371-3542c2dc9511",
                        "entry_id": "bb81122a-9651-3b3f-9079-b316b3e2bdd4",
                        "glosses": [
                            "Diverse; various."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "5e071a77-07e6-4845-a2c3-d029e655d430",
                                "sense_id": "ccd00144-56cf-34eb-b371-3542c2dc9511",
                                "text": "Against the huge boulderstones which lay scattered about on the shore, the mighty waves broke incessantly in the maddest and most diversified manner."
                            },
                            {
                                "example_id": "adfb5520-f9bd-46c5-b144-209a293fc4c0",
                                "sense_id": "ccd00144-56cf-34eb-b371-3542c2dc9511",
                                "text": "We thus see that these naturalised plants are of a highly diversified nature."
                            },
                            {
                                "example_id": "29c123fa-7801-42f4-9a70-9604f1c098c2",
                                "sense_id": "ccd00144-56cf-34eb-b371-3542c2dc9511",
                                "text": "Men of diversified temperament can learn valuable lessons from those of the conserving type by not attempting to think of so many disassociated things; that is, by concentrating the mind."
                            }
                        ]
                    },
                    {
                        "sense_id": "27a8bcc7-6f93-300d-83fa-b6225c8924fb",
                        "entry_id": "bb81122a-9651-3b3f-9079-b316b3e2bdd4",
                        "glosses": [
                            "Employing the use of diversification; deliberately using a variety of instruments, methods, ingredients, or products, typically to reduce risk."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "339d8554-bd56-4d51-9a27-20b33f5d6bb4",
                                "sense_id": "27a8bcc7-6f93-300d-83fa-b6225c8924fb",
                                "text": "Diversified farming reduces the risk."
                            },
                            {
                                "example_id": "aadacb24-dd53-42ce-b52f-ad3c6aa099ee",
                                "sense_id": "27a8bcc7-6f93-300d-83fa-b6225c8924fb",
                                "text": "On-farm irrigation facilities require modifications to provide the proper water conditions for diversified crops."
                            },
                            {
                                "example_id": "fa7491a8-7387-4dea-8bb3-59f9c292ef64",
                                "sense_id": "27a8bcc7-6f93-300d-83fa-b6225c8924fb",
                                "text": "The main lesson from East Asia is that improved access to infrastructure, a highly qualified workforce, and enforced rules of the game that reward investment and innovation are more likely to provide fertile ground for the emergence of a more efficient and diversified production base."
                            },
                            {
                                "example_id": "ff1ae8cc-c29c-4248-96c7-10bd562c43dd",
                                "sense_id": "27a8bcc7-6f93-300d-83fa-b6225c8924fb",
                                "text": "This also involves establishing a diversified portfolio that matches the investor's objectives and periodically examining and adjusting the portfolio to ensure it stays aligned with the investor's goals."
                            }
                        ]
                    },
                    {
                        "sense_id": "a14a5617-b7be-3e18-8368-3f406eed87a7",
                        "entry_id": "bb81122a-9651-3b3f-9079-b316b3e2bdd4",
                        "glosses": [
                            "Changed in a way that creates more diversity."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b69eb3a7-b5c7-449d-aeb3-5715604ca1e3",
                                "sense_id": "a14a5617-b7be-3e18-8368-3f406eed87a7",
                                "text": "In West Pakistan during the second plan period efforts were made to introduce diversified courses in 600 middle schools but the difficulty in getting qualified teachers even by giving them shorter periods of training did not make it possible to implement the scheme successfully."
                            },
                            {
                                "example_id": "78ed95ca-accc-4ce8-bc1f-1bd8c279bdce",
                                "sense_id": "a14a5617-b7be-3e18-8368-3f406eed87a7",
                                "text": "The diversified gene differs from the germline gene by multiple nucleotides."
                            },
                            {
                                "example_id": "af63eb6b-4d11-4053-8482-edfcd4fa7239",
                                "sense_id": "a14a5617-b7be-3e18-8368-3f406eed87a7",
                                "text": "Even in a highly diversified society, Durkheim (1933) wrote, Men submit to the same law ."
                            }
                        ]
                    }
                ],
