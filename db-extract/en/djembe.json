        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "b528af6e-fd67-378c-aee9-61b7c29a2a2e",
                "word": "djembe",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "a8899251-95aa-4f66-9513-1a773c92fdb0",
                        "entry_id": "b528af6e-fd67-378c-aee9-61b7c29a2a2e",
                        "tags": [
                            "plural"
                        ],
                        "form": "djembes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ef0a569b-631a-3701-b024-f8d5e80bd5ff",
                        "entry_id": "b528af6e-fd67-378c-aee9-61b7c29a2a2e",
                        "glosses": [
                            "A large, rope-tuned, skin-covered drum played with the bare hands, used in West African and some fusion music."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f2448f23-28a8-4e29-b3e4-9f4d7db0b48a",
                                "sense_id": "ef0a569b-631a-3701-b024-f8d5e80bd5ff",
                                "text": "There are three principal types of traditional drums in Guinean Sousou culture: the djembe, the dundun, and the tama. The djembe is a single-headed goblet-shaped drum with a relatively high-pitched tone."
                            },
                            {
                                "example_id": "b35f4044-6cad-4ba5-80f4-449d9359740e",
                                "sense_id": "ef0a569b-631a-3701-b024-f8d5e80bd5ff",
                                "text": "The djembe is one of the best-known and popular African drums, particular with those in the West who are interested in learning a drumming tradition."
                            },
                            {
                                "example_id": "adc6f3e4-b813-47e3-82a5-f1f3e6fd8dbd",
                                "sense_id": "ef0a569b-631a-3701-b024-f8d5e80bd5ff",
                                "text": "The djembe has become the most recognizable drum from West Africa, with a history that can be traced to the twelfth century Mali Empire and the Mandinka people."
                            },
                            {
                                "example_id": "22823865-e07a-4041-aba3-a6a85566a156",
                                "sense_id": "ef0a569b-631a-3701-b024-f8d5e80bd5ff",
                                "text": "Very few djembes are perfectly round. Most are slightly egg- or triangle-shaped. Lack of roundness is not a problem for sound: many such djembes sound excellent."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "40aab21b-db03-4b12-b18f-d221ce5b31f8",
                        "source_entry_id": "b528af6e-fd67-378c-aee9-61b7c29a2a2e",
                        "source_sense_id": "ef0a569b-631a-3701-b024-f8d5e80bd5ff",
                        "source_sense_description": "a large drum played with the hands",
                        "target_lang_word": "djembé",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "djembé",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "2de224c3-1202-324c-9779-d27cbc343de5",
                                        "entry_id": "2b765ab6-7489-3c8d-a454-b5fce9b9f854",
                                        "glosses": [
                                            "soort trommel die oorspronkelijk vooral bespeeld werd in West-Afrika"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1edfc809-d851-4b17-8251-deb84767e3d5",
                                                "sense_id": "2de224c3-1202-324c-9779-d27cbc343de5",
                                                "text": "Hij probeerde al een half jaar een djembé te leren bespelen, maar zijn broer was nog steeds tien keer beter."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4dcb37cd-d786-45bc-a106-4ad8bffea290",
                        "source_entry_id": "b528af6e-fd67-378c-aee9-61b7c29a2a2e",
                        "source_sense_id": "ef0a569b-631a-3701-b024-f8d5e80bd5ff",
                        "source_sense_description": "a large drum played with the hands",
                        "target_lang_word": "djembé",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "djembé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e694cfe9-bfb4-3cee-b7f1-b66cab1616a3",
                                        "entry_id": "6d3b3230-38a5-38ad-844f-67dcfc44b75f",
                                        "glosses": [
                                            "Instrument de musique originaire d’Afrique, composé d'une pièce de bois recouvert d’une peau tendue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3e48f72-5ae4-4f81-9381-4275b08b7ff6",
                                                "sense_id": "e694cfe9-bfb4-3cee-b7f1-b66cab1616a3",
                                                "text": "Il raconte avec forces détails les différentes remises d’espèces de chefs d’État africains, dans des contenants plus ou moins folkloriques (comme des djembés bourrés de billets «offerts» par le président burkinabé Blaise Compaoré)."
                                            },
                                            {
                                                "example_id": "80bbc291-9555-4874-b155-5266d6adc668",
                                                "sense_id": "e694cfe9-bfb4-3cee-b7f1-b66cab1616a3",
                                                "text": "— Cette formation organisée selon la demande est consacrée aux polyrythmies jouées par les tambours djembé et dundun au Mali et en Guinée et à celles de l'ensemble de tambours sabar du Sénégal."
                                            },
                                            {
                                                "example_id": "9ac68274-01aa-40ff-bcce-a96e3495588a",
                                                "sense_id": "e694cfe9-bfb4-3cee-b7f1-b66cab1616a3",
                                                "text": "Il est désormais possible de repartir chez soi avec une guitare électrique, un djembé ou un ukulélé."
                                            }
                                        ]
                                    }
                                ]
                            },
