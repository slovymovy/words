                        "tags": [],
                        "examples": [
                            {
                                "example_id": "238bd182-6c4c-43d7-8335-ea4866706e3e",
                                "sense_id": "62b433df-0764-36e9-9dec-cda61f1cd4a2",
                                "text": "En outre, la Société a fait chromolithographier une planche où sont reproduites un certain nombre de teintes de la peau et des yeux, déterminées d’après les instructions et les cercles chromatiques de M. Chevreul."
                            },
                            {
                                "example_id": "10d0875e-b8ef-4a4a-b228-365323a7be3d",
                                "sense_id": "62b433df-0764-36e9-9dec-cda61f1cd4a2",
                                "text": "A Saint-Denis et Breteuil, le carrelage est disposé en bandes longitudinales; mais, en ce moment, nous faisons chromolithographier un admirable carrelage disposé en losanges, puis graver un ensemble de pavés distribués circulairement."
                            }
                        ]
                    }
