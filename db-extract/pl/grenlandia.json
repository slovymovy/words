                                        "glosses": [
                                            "The ice-covered island on which it is located, the largest island in the world (not counting Australia)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "07fa51dd-50c2-4271-95ae-d35fd5604b48",
                                                "sense_id": "ed27dea6-1e36-33de-bd90-843fe5fbd381",
                                                "text": "To most people, the huge ice sheets of Antarctica and Greenland are merely water that once was snow. To glaciologists and climatologists, they are storehouses of the Earth's former atmospheres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c1bd858f-d371-3a31-af31-029af4018395",
                                        "entry_id": "8e9f48f5-f5a6-3294-85cb-c3fe24164ca5",
                                        "glosses": [
                                            "Spitzbergen, another island in Europe formerly thought to have been part of Greenland."
                                        ],
