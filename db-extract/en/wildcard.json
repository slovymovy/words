    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "9c799944-9a96-3711-be07-4692071bab07",
                "word": "wildcard",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "83d9644d-1a88-4c1e-a928-731bc30b71d7",
                        "entry_id": "9c799944-9a96-3711-be07-4692071bab07",
                        "tags": [
                            "plural"
                        ],
                        "form": "wildcards"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3a0f46fc-5837-3dba-b656-ee01c6b6be74",
                        "entry_id": "9c799944-9a96-3711-be07-4692071bab07",
                        "glosses": [
                            "A character that takes the place of any other character or string that is not known or specified."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d109182-56da-4b9f-a9af-337cc7dc8923",
                                "sense_id": "3a0f46fc-5837-3dba-b656-ee01c6b6be74",
                                "text": "1968, Digital Equipment Corporation, VAX/VMS 319(5864), page 751, Section 2.1.2 Using Wildcard Characters\nA wildcard character is a symbol that you can use with many DCL commands to apply the command to several files at once, rather than specifying each file individually."
                            },
                            {
                                "example_id": "bee5c0e4-da47-4f90-be84-d0404323639e",
                                "sense_id": "3a0f46fc-5837-3dba-b656-ee01c6b6be74",
                                "text": "If the character * is acting as a wildcard, then the pattern a*m matches each of the words amalgam, atom and alum."
                            }
                        ]
                    },
                    {
                        "sense_id": "1047c4f6-ac60-3567-b2a4-b86ac7a3632d",
                        "entry_id": "9c799944-9a96-3711-be07-4692071bab07",
                        "glosses": [
                            "An uncontrolled or unpredictable element."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f6d7a904-15ca-4d34-b620-6649d08de18c",
                                "sense_id": "1047c4f6-ac60-3567-b2a4-b86ac7a3632d",
                                "text": "There are several technical wildcards, such as how the larger battery packs--four times larger than those of the Prius--will withstand the rigors of city driving, […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "994c5523-124b-3dbf-87cd-33d20f4ffc38",
                        "entry_id": "9c799944-9a96-3711-be07-4692071bab07",
                        "glosses": [
                            "An element, often deliberately concealed, which is withheld for contingency."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "02e0e7a9-087b-34fb-a657-1b88853f4769",
                        "entry_id": "9c799944-9a96-3711-be07-4692071bab07",
                        "glosses": [
                            "Alternative form of wild card."
                        ],
                        "tags": [
                            "alt-of",
                            "alternative"
                        ],
                        "examples": [
                            {
                                "example_id": "1147131c-e5f3-4832-9634-7773e06f50ee",
                                "sense_id": "02e0e7a9-087b-34fb-a657-1b88853f4769",
                                "text": "German wildcard Sabine Lisicki conquered her nerves to defeat France's Marion Bartoli and take her amazing Wimbledon run into the semi-finals."
                            }
                        ]
                    },
                    {
                        "sense_id": "2964e751-4f36-37d9-a89e-d9a19ed6b481",
                        "entry_id": "9c799944-9a96-3711-be07-4692071bab07",
                        "glosses": [
                            "A letter or symbol that substitutes for a generic or poorly identified sound, for example capital C for any or some consonant, or capital V for any or some vowel."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "25a34b3e-75cf-4af9-b239-f9c22429fcc3",
                        "source_entry_id": "9c799944-9a96-3711-be07-4692071bab07",
