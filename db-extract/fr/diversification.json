                                "target_senses": [
                                    {
                                        "sense_id": "da3db817-d991-385c-a020-70bba1abdf67",
                                        "entry_id": "d8d71a6e-ba31-31bd-9df2-deb0c9c29caf",
                                        "glosses": [
                                            "een verzameling van zeer verschillende zaken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89af0cba-5192-47cc-a3fe-4db4b8e90875",
                                                "sense_id": "da3db817-d991-385c-a020-70bba1abdf67",
                                                "text": "In de klas was een grote verscheidenheid van afkomsten te herkennen."
                                            }
                                        ]
