                "senses": [
                    {
                        "sense_id": "18dcddea-53a8-308b-aa57-73d5db02bdb5",
                        "entry_id": "d5c5f200-990e-3d23-a6e1-8a49d107257d",
                        "glosses": [
                            "To engage in noisy, drunken, or riotous behaviour."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "893c55dd-738a-491d-8b47-4340a2f91823",
                                "sense_id": "18dcddea-53a8-308b-aa57-73d5db02bdb5",
                                "text": "Then Elzevir cried out angrily, 'Silence. Are you mad, or has the liquor mastered you? Are you Revenue-men that you dare shout and roister? or contrabandiers with the lugger in the offing, and your life in your hand. You make noise enough to wake folk in Moonfleet from their beds.'"
                            },
                            {
                                "example_id": "1af51346-a6c8-411e-b557-b429cc2b9943",
                                "sense_id": "18dcddea-53a8-308b-aa57-73d5db02bdb5",
                                "text": "He loved Rick and gave the best years of his life, now to roistering with him, now to hanging on to his coat-tails."
                            }
                        ]
                    },
                    {
                        "sense_id": "1a1530a8-5a36-3ff8-ba88-5eb8e3617fbd",
                        "entry_id": "d5c5f200-990e-3d23-a6e1-8a49d107257d",
                        "glosses": [
                            "To walk with a swaying motion."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": []
                    }
