                "senses": [
                    {
                        "sense_id": "2a4730b7-d665-3f2f-8a75-88805201fde7",
                        "entry_id": "8fcd2e2a-a2f5-34d0-addd-41d79ba175f4",
                        "glosses": [
                            "житель или уроженец Хабаровска"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c0786261-c9cc-484c-a44c-d9ffe295b9fc",
                                "sense_id": "2a4730b7-d665-3f2f-8a75-88805201fde7",
                                "text": "Осмотрели местный стадион — краса и гордость хабаровчан, отвоевавших эту территорию у Амура."
                            },
                            {
                                "example_id": "dacf9ffd-f6f4-4e7e-b64d-07e6b8bfe7f0",
                                "sense_id": "2a4730b7-d665-3f2f-8a75-88805201fde7",
                                "text": "Радиослушатели и телезрители тех лет хорошо помнят литературные передачи, созданные Людмилой Миланич. Благодаря им хабаровчане узнавали не только о творчестве известных по всей России писателей, но и о том, что пишут земляки: П. Халов, Н. Рогаль, Вс. Иванов. В. Клипель."
                            }
                        ]
                    }
