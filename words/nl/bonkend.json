{
    "word_family": [
        "bonk",
        "bonken"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "f01f6a19-05ee-3f3f-b3d1-355eca08b3a9",
                    "sense_definition": "die hard en hevig klopt",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "hard_kloppen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na de trap voelde ik mijn <w>bonkend</w> hart in mijn borst.",
                            "target_lang_translations": {
                                "en": "After the fall, I felt my <w>pounding</w> heart in my chest."
                            }
                        },
                        {
                            "text": "Ze lag wakker met <w>bonkende</w> hoofdpijn na het feest.",
                            "target_lang_translations": {
                                "en": "She lay awake with a <w>throbbing</w> headache after the party."
                            }
                        }
                    ],
                    "synonyms": [
                        "dreunend"
                    ],
                    "common_phrases": [
                        "bonkend hart",
                        "bonkende hoofdpijn",
                        "bonkende slaapader"
                    ],
                    "target_lang_definitions": {
                        "en": "beating hard and heavily"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "pounding",
                                "target_lang_sense_clarification": "used for a heart, headache, temple, etc. beating hard and noticeably"
                            },
                            {
                                "target_lang_word": "throbbing",
                                "target_lang_sense_clarification": "used especially for pain that pulses strongly, such as a headache"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3e5844c5-10c1-3f65-adc7-51560542ac80",
                    "sense_definition": "onvoltooid deelwoord van <w>bonken</w>",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "hard_kloppen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De oude motor reed <w>bonkend</w> door de smalle straat.",
                            "target_lang_translations": {
                                "en": "The old engine drove <w>thumping</w> through the narrow street."
                            }
                        },
                        {
                            "text": "Hij kwam <w>bonkend</w> de trap af na het harde ongeluk.",
                            "target_lang_translations": {
                                "en": "He came <w>thumping</w> down the stairs after the bad accident."
                            }
                        }
                    ],
                    "common_phrases": [
                        "bonkend rijden",
                        "bonkend aankomen"
                    ],
                    "target_lang_definitions": {
                        "en": "present participle of \"bonken\""
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "thumping",
                                "target_lang_sense_clarification": "present participle used for moving or sounding with heavy repeated beats"
                            },
                            {
                                "target_lang_word": "pounding",
                                "target_lang_sense_clarification": "present participle used for making heavy repeated banging sounds"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}