{
    "word_family": [
        "measurement",
        "measurable",
        "measurer",
        "immeasurable",
        "unmeasured",
        "measureless"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "32fd08dc-e242-316b-ac18-8c23ff1dd116",
                    "sense_definition": "To find out the size, weight, or amount of something by using a standard unit or tool.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "ascertain_size",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tailor needs to <w>measure</w> your waist before he can make the trousers.",
                            "target_lang_translations": {
                                "ru": "Портному нужно <w>измерить</w> вашу талию, прежде чем он сможет сшить брюки."
                            }
                        },
                        {
                            "text": "You should <w>measure</w> the ingredients carefully to ensure the cake tastes good.",
                            "target_lang_translations": {
                                "ru": "Вам следует тщательно <w>отмерить</w> ингредиенты, чтобы торт получился вкусным."
                            }
                        }
                    ],
                    "synonyms": [
                        "take"
                    ],
                    "common_phrases": [
                        "measure the ingredients",
                        "measure the distance",
                        "measure the temperature"
                    ],
                    "target_lang_definitions": {
                        "ru": "Определять размер, вес или количество чего-либо с помощью стандартных единиц или инструментов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "измерять",
                                "target_lang_sense_clarification": "процесс определения величины"
                            },
                            {
                                "target_lang_word": "мерить",
                                "target_lang_sense_clarification": "разговорный вариант"
                            },
                            {
                                "target_lang_word": "измерить",
                                "target_lang_sense_clarification": "завершенное действие"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3d4dc9ea-f796-3150-9b45-82765d3d40cf",
                    "sense_definition": "To have a specific size, length, or amount.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "ascertain_size",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new dining table <w>measures</w> two meters in length.",
                            "target_lang_translations": {
                                "ru": "Длина нового обеденного стола <w>составляет</w> два метра."
                            }
                        },
                        {
                            "text": "This small park <w>measures</w> about ten hectares and is very popular with locals.",
                            "target_lang_translations": {
                                "ru": "Этот небольшой парк <w>занимает</w> около десяти гектаров и очень популярен среди местных жителей."
                            }
                        }
                    ],
                    "common_phrases": [
                        "measures two meters",
                        "measures ten hectares"
                    ],
                    "target_lang_definitions": {
                        "ru": "Иметь определенный размер, длину или количество."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "иметь размер",
                                "target_lang_sense_clarification": "о физических параметрах"
                            },
                            {
                                "target_lang_word": "быть длиной в",
                                "target_lang_sense_clarification": "о протяженности"
                            },
                            {
                                "target_lang_word": "составлять",
                                "target_lang_sense_clarification": "о площади или объеме"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1cbc25af-00d8-32c4-98d5-59a0b7d3cff0",
                    "sense_definition": "To judge or evaluate the quality, value, or importance of something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "evaluation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is difficult to <w>measure</w> the success of the project at such an early stage.",
                            "target_lang_translations": {
                                "ru": "Трудно <w>оценить</w> успех проекта на столь ранней стадии."
                            }
                        },
                        {
                            "text": "You cannot <w>measure</w> a person's worth solely by their bank account.",
                            "target_lang_translations": {
                                "ru": "Нельзя <w>измерять</w> ценность человека исключительно его банковским счетом."
                            }
                        }
                    ],
                    "common_phrases": [
                        "measure the success",
                        "measure the impact"
                    ],
                    "target_lang_definitions": {
                        "ru": "Судить или оценивать качество, ценность или важность чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оценивать",
                                "target_lang_sense_clarification": "определять значимость"
                            },
                            {
                                "target_lang_word": "измерять",
                                "target_lang_sense_clarification": "в переносном смысле"
                            },
                            {
                                "target_lang_word": "соизмерять",
                                "target_lang_sense_clarification": "сравнивать с чем-то"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d5ab3be0-9387-3949-ae23-3cb741aa6611",
                    "sense_definition": "To carefully control or regulate one's words or actions.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "control",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The politician <w>measured</w> his words carefully to avoid any controversy during the interview.",
                            "target_lang_translations": {
                                "ru": "Политик тщательно <w>взвешивал</w> свои слова, чтобы избежать споров во время интервью."
                            }
                        },
                        {
                            "text": "She <w>measured</w> her every move to ensure she did not offend the hosts.",
                            "target_lang_translations": {
                                "ru": "Она <w>выверяла</w> каждое свое движение, чтобы не обидеть хозяев."
                            }
                        }
                    ],
                    "common_phrases": [
                        "measure one's words",
                        "measure her every word"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тщательно контролировать или взвешивать свои слова или действия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "взвешивать",
                                "target_lang_sense_clarification": "о словах или решениях"
                            },
                            {
                                "target_lang_word": "обдумывать",
                                "target_lang_sense_clarification": "тщательно выбирать"
                            },
                            {
                                "target_lang_word": "размерять",
                                "target_lang_sense_clarification": "делать что-то размеренно"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "cb275bb2-c708-3a48-a8f8-fe4eef5b5246",
                    "sense_definition": "A specific unit used for expressing the size, amount, or degree of something.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "unit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The meter is a standard <w>measure</w> of length used in most countries.",
                            "target_lang_translations": {
                                "ru": "Метр — это стандартная <w>мера</w> длины, используемая в большинстве стран."
                            }
                        },
                        {
                            "text": "We need a reliable <w>measure</w> of weight to check the heavy cargo.",
                            "target_lang_translations": {
                                "ru": "Нам нужна надежная <w>единица</w> веса, чтобы проверить тяжелый груз."
                            }
                        }
                    ],
                    "synonyms": [
                        "metric"
                    ],
                    "common_phrases": [
                        "standard measure",
                        "measure of length",
                        "measure of weight"
                    ],
                    "target_lang_definitions": {
                        "ru": "Определенная единица, используемая для выражения размера, количества или степени чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мера",
                                "target_lang_sense_clarification": "единица измерения"
                            },
                            {
                                "target_lang_word": "система мер",
                                "target_lang_sense_clarification": "совокупность единиц"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4d6ebbcc-a99b-3230-8089-0c7afa1b958d",
                    "sense_definition": "An action or step taken to achieve a particular goal or solve a problem.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government introduced new safety <w>measures</w> to prevent accidents at work.",
                            "target_lang_translations": {
                                "ru": "Правительство ввело новые <w>меры</w> безопасности для предотвращения несчастных случаев на производстве."
                            }
                        },
                        {
                            "text": "We must take drastic <w>measures</w> to reduce the pollution in our city.",
                            "target_lang_translations": {
                                "ru": "Мы должны принять решительные <w>меры</w>, чтобы снизить уровень загрязнения в нашем городе."
                            }
                        }
                    ],
                    "common_phrases": [
                        "safety measures",
                        "take measures",
                        "drastic measures",
                        "preventive measures"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие или шаг, предпринятый для достижения определенной цели или решения проблемы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мера",
                                "target_lang_sense_clarification": "средство для достижения цели"
                            },
                            {
                                "target_lang_word": "мероприятие",
                                "target_lang_sense_clarification": "организованное действие"
                            },
                            {
                                "target_lang_word": "шаг",
                                "target_lang_sense_clarification": "предпринятое действие"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "552804f0-5e35-3a03-ba6f-6a8864984601",
                    "sense_definition": "A standard or criterion used for judging or comparing something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "evaluation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Exam results are not always a fair <w>measure</w> of a student's intelligence.",
                            "target_lang_translations": {
                                "ru": "Результаты экзаменов не всегда являются справедливым <w>критерием</w> интеллекта студента."
                            }
                        },
                        {
                            "text": "The company uses customer satisfaction as a <w>measure</w> of its progress.",
                            "target_lang_translations": {
                                "ru": "Компания использует удовлетворенность клиентов как <w>показатель</w> своего прогресса."
                            }
                        }
                    ],
                    "common_phrases": [
                        "measure of success",
                        "measure of progress",
                        "true measure"
                    ],
                    "target_lang_definitions": {
                        "ru": "Стандарт или критерий, используемый для суждения о чем-либо или сравнения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мерило",
                                "target_lang_sense_clarification": "основание для оценки"
                            },
                            {
                                "target_lang_word": "критерий",
                                "target_lang_sense_clarification": "показатель для сравнения"
                            },
                            {
                                "target_lang_word": "мера",
                                "target_lang_sense_clarification": "показатель качества"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9459c858-80b9-331a-818e-1486f973593d",
                    "sense_definition": "A certain amount or degree of something, often intangible.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "quantity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The team felt a <w>measure</w> of relief after winning the difficult match.",
                            "target_lang_translations": {
                                "ru": "Команда почувствовала некоторую <w>долю</w> облегчения после победы в трудном матче."
                            }
                        },
                        {
                            "text": "There is a <w>measure</w> of truth in what he says, even if he exaggerates.",
                            "target_lang_translations": {
                                "ru": "В его словах есть <w>доля</w> правды, даже если он преувеличивает."
                            }
                        }
                    ],
                    "common_phrases": [
                        "measure of relief",
                        "measure of truth",
                        "measure of regret"
                    ],
                    "target_lang_definitions": {
                        "ru": "Определенное количество или степень чего-либо, часто нематериального."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "доля",
                                "target_lang_sense_clarification": "некоторая часть"
                            },
                            {
                                "target_lang_word": "степень",
                                "target_lang_sense_clarification": "уровень проявления"
                            },
                            {
                                "target_lang_word": "мера",
                                "target_lang_sense_clarification": "некоторое количество"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7f3832b2-c713-3841-aa0b-1c121ac57490",
                    "sense_definition": "In music, a group of notes and rests separated by vertical lines; a bar.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "music",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pianist played the first <w>measure</w> of the song perfectly.",
                            "target_lang_translations": {
                                "ru": "Пианист безупречно сыграл первый <w>такт</w> песни."
                            }
                        },
                        {
                            "text": "There are four beats in every <w>measure</w> of this waltz.",
                            "target_lang_translations": {
                                "ru": "В каждом <w>такте</w> этого вальса четыре доли."
                            }
                        }
                    ],
                    "synonyms": [
                        "bar"
                    ],
                    "common_phrases": [
                        "first measure",
                        "musical measure"
                    ],
                    "target_lang_definitions": {
                        "ru": "В музыке: группа нот и пауз, разделенных вертикальными линиями; такт."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "такт",
                                "target_lang_sense_clarification": "музыкальная единица"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4b4f5046-fb7f-3ab9-968e-8b80144e636e",
                    "sense_definition": "A limit or bound that cannot be exceeded.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "limit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The beauty of the landscape was breathtaking beyond <w>measure</w>.",
                            "target_lang_translations": {
                                "ru": "Красота пейзажа была захватывающей сверх всякой <w>меры</w>."
                            }
                        },
                        {
                            "text": "His kindness knows no <w>measure</w> and he helps everyone he meets.",
                            "target_lang_translations": {
                                "ru": "Его доброта не знает <w>границ</w>, и он помогает каждому, кого встречает."
                            }
                        }
                    ],
                    "common_phrases": [
                        "beyond measure",
                        "knows no measure"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предел или граница, которую невозможно превысить."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мера",
                                "target_lang_sense_clarification": "предел, граница"
                            },
                            {
                                "target_lang_word": "предел",
                                "target_lang_sense_clarification": "крайняя точка"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}