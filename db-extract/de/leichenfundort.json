                "senses": [
                    {
                        "sense_id": "bb831cfe-1119-36f5-9809-2985411d8986",
                        "entry_id": "ada5d68c-36ba-32c4-af30-5a3b14e00502",
                        "glosses": [
                            "Ort, an dem eine Leiche gefunden wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f54ecf3-77c6-4f2f-af19-8bbb4bf51a6b",
                                "sense_id": "bb831cfe-1119-36f5-9809-2985411d8986",
                                "text": "„Landsman schaut zu Pellegrini hinüber. Der zögert, steht in der Tür herum und ist drauf und dran, den Jungs mit der Bahre zu sagen, sie sollen noch warten, die Leiche nicht anrühren, um Zeit zu gewinnen und den Leichenfundort, der sich bereits vor seinen Augen auflöst, noch eine Weile zu erhalten.“"
                            },
                            {
                                "example_id": "9c4db8dc-2b34-4d2a-a9b0-d41684afaf55",
                                "sense_id": "bb831cfe-1119-36f5-9809-2985411d8986",
                                "text": "„Ein Zeuge hatte beobachtet, wie in der Tatnacht ein weißer Pick-up in unmittelbarer Nähe des Leichenfundorts mit hohem Tempo davonbrauste.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
