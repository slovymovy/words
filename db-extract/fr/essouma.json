                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "268061e2-fd1c-3ed8-9958-49dba399214c",
                        "entry_id": "7625cdcd-df34-34d6-89fd-d8fecbd93f68",
                        "glosses": [
                            "Langue africaine de la branche des langues kwa, qui fut parlée dans l’actuelle Côte d’Ivoire, aujourd’hui éteinte."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff79e5dd-ead1-4b1d-9969-02c44b7f47b4",
                                "sense_id": "268061e2-fd1c-3ed8-9958-49dba399214c",
                                "text": "Certains chercheurs, historiens notamment, pensent que l’essouma était en fait un dialecte nzima. En réalité, cette langue fait partie des nombreuses langues minoritaires qui ont été phagocytées par la conquête des Agni."
                            }
                        ]
                    }
                ],
