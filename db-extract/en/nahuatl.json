                                "target_senses": [
                                    {
                                        "sense_id": "a09c9fb6-378b-31ce-87df-12d5e80412ab",
                                        "entry_id": "fa7e7152-73cf-3524-9180-0acf639d140f",
                                        "glosses": [
                                            "benaming voor een groep van verwante talen die door de Nahua, oorspronkelijke bewoners van Mexico, gesproken worden\\nNahuatl wordt door taalkundigen gezien als een zogenaamde macrotaal, er bestaat geen \\\"Standaardnahuatl\\\"."
                                        ],
