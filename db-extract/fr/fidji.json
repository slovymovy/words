        "fr-extract.jsonl": [
            {
                "entry_id": "09dde363-f5a4-32a8-b00f-dde2f9df5264",
                "word": "Fidji",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "93bc1212-aadd-39ca-b2ce-60043f66c4af",
                        "entry_id": "09dde363-f5a4-32a8-b00f-dde2f9df5264",
                        "glosses": [
                            "Pays d’Océanie, archipel situé à l’est du Vanuatu, à l’ouest des Tonga et au sud des Tuvalu. Sa capitale est Suva."
                        ],
                        "tags": [
                            "Pays"
                        ],
                        "examples": [
                            {
                                "example_id": "1a2ac1f5-968e-4e67-a0ab-6dabdd6e7787",
                                "sense_id": "93bc1212-aadd-39ca-b2ce-60043f66c4af",
                                "text": "Vers la fin de 1812, je m’embarquai, en qualité d’officier, sur le navire le Hunter, capitaine Robson, qui partit de Calcutta, pour un voyage à la Nouvelle-Galles du sud, aux îles Biti, communément appelées îles Fidji, et finalement à Canton."
                            },
                            {
                                "example_id": "5e7e28da-5578-4d26-8c75-ebb2e8eec4d2",
                                "sense_id": "93bc1212-aadd-39ca-b2ce-60043f66c4af",
                                "text": "Subtil mélange d’authenticité, de tradition et d’exotisme, et première destination touristique du Pacifique insulaire, les Fidji sont devenues un rêve accessible, en confort et sécurité."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1a6de199-4968-4e14-aa86-58366c838465",
                        "source_entry_id": "09dde363-f5a4-32a8-b00f-dde2f9df5264",
                        "source_sense_id": "93bc1212-aadd-39ca-b2ce-60043f66c4af",
                        "target_lang_word": "Fidschi",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fidschi",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2a5ee1f4-2ca9-3d33-ad10-9ccbcb07c044",
                                        "entry_id": "cb447c5e-df1f-34bf-99ea-42e33cb706ad",
                                        "glosses": [
                                            "Inselstaat im Südpazifik"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c0996709-a3ff-4d79-9424-11cb22099e96",
                                                "sense_id": "2a5ee1f4-2ca9-3d33-ad10-9ccbcb07c044",
                                                "text": "Wir fahren im Urlaub nach Fidschi."
                                            },
                                            {
                                                "example_id": "c13df6a2-9088-44df-adb7-39cd5458c18c",
                                                "sense_id": "2a5ee1f4-2ca9-3d33-ad10-9ccbcb07c044",
                                                "text": "Suva ist die Hauptstadt von Fidschi."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Fidschi",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3c83e7e6-85c2-35ba-be93-9976dd7be71a",
                                        "entry_id": "ba174b60-8fc2-3a7e-92ea-43ac5c46ce70",
                                        "glosses": [
                                            "auf den Fidschi-Inseln gesprochene austronesische Sprache"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "05d9eb65-0846-4083-add0-1312bae71fd3",
                                                "sense_id": "3c83e7e6-85c2-35ba-be93-9976dd7be71a",
                                                "text": "Wie heißt das auf Fidschi?"
                                            },
                                            {
                                                "example_id": "0b64edd0-3fc0-4974-8f7a-352964e45c38",
                                                "sense_id": "3c83e7e6-85c2-35ba-be93-9976dd7be71a",
                                                "text": "Das Tonganische zeigt Anklänge ans Fidschi."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Fidschi",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cea3fb88-fce6-3b4a-b988-bbdd4b416754",
                                        "entry_id": "9c524d19-e8dd-3e61-a740-7f651c44b412",
                                        "glosses": [
                                            "Vietnamese; Person, die aus Vietnam stammt; im weiteren Sinne alle Ost- und Südostasiaten"
                                        ],
                                        "tags": [
                                            "meist abwertend"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f3a44f2b-7797-4f4c-8e36-222406fc27e6",
                                                "sense_id": "cea3fb88-fce6-3b4a-b988-bbdd4b416754",
                                                "text": "„Einmal habe jemand den Freund „Fidschi“ geschimpft und ihm ein Messer an den Hals gehalten.“"
                                            },
                                            {
                                                "example_id": "d87e9aa7-5257-47a9-bfc1-37cffdfe3a28",
                                                "sense_id": "cea3fb88-fce6-3b4a-b988-bbdd4b416754",
                                                "text": "„Das tröstete sie über die hinweg, die beim Einkaufen in ihren Korb sahen und über die Fidschis schimpften, die den Einheimischen hier alles wegkauften.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Fidschi",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0f7b1ff1-739a-3493-a66e-0ad8e62fa510",
                                        "entry_id": "3bc54a48-8619-368f-ac1a-faafe1ee195d",
                                        "glosses": [
                                            "Vietnamesin; weibliche Person, die aus Indochina stammt; im Plural auch männliche Personen einbeziehend"
                                        ],
                                        "tags": [
                                            "casual"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "185ab0f8-c1d2-4d9a-af62-26dbb003d61a",
                                                "sense_id": "0f7b1ff1-739a-3493-a66e-0ad8e62fa510",
                                                "text": "Kaufst du bei den Fidschis?"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
