                    {
                        "sense_id": "e04348c6-ee48-3a35-8660-61b853f4d649",
                        "entry_id": "709e5838-c2ce-3fcf-8e55-c3bb401104ba",
                        "glosses": [
                            "Première personne du pluriel. Qui sont à nous. Plusieurs possesseurs et plusieurs objets."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a914e746-5339-48d3-b38b-5f3093eb5f91",
                                "sense_id": "e04348c6-ee48-3a35-8660-61b853f4d649",
                                "text": "Dès ce moment, je sus que, pour avoir le maximum de nos vainqueurs, il fallait être plus jugulaires qu’eux-mêmes ; leurs chefs adoraient le respect des gradés, et nous pouvions profiter de leur faiblesse ? − ainsi, je commençai à devenir un « sale collaborateur »."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "00c487ba-4652-4348-8760-90f507e9a2b2",
                        "source_entry_id": "709e5838-c2ce-3fcf-8e55-c3bb401104ba",
                        "source_sense_id": "e04348c6-ee48-3a35-8660-61b853f4d649",
                        "target_lang_word": "our",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "our",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0da0c955-044c-350d-8642-a55622347b1f",
                                        "entry_id": "5e59311b-97d2-3b8e-8d10-c4f0404d5538",
                                        "glosses": [
                                            "Belonging to us, excluding the person(s) being addressed (exclusive our)."
                                        ],
                                        "tags": [
                                            "determiner",
                                            "first-person",
                                            "plural",
                                            "possessive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "76346a38-b94b-448a-8d48-a37a2cfeae86",
                                                "sense_id": "0da0c955-044c-350d-8642-a55622347b1f",
                                                "text": "Sorry, you're not invited to our party."
                                            },
                                            {
                                                "example_id": "731fd0dc-c04d-4d45-ad77-549a60e63835",
                                                "sense_id": "0da0c955-044c-350d-8642-a55622347b1f",
                                                "text": "Paying no attention to Lizzy, Mrs. Gibson began calling out our names in alphabetical order."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "536324a1-5eb2-3241-849a-54bb03eb5dd5",
                                        "entry_id": "5e59311b-97d2-3b8e-8d10-c4f0404d5538",
                                        "glosses": [
                                            "Belonging to us, including the person(s) being addressed (inclusive our)."
                                        ],
                                        "tags": [
                                            "determiner",
                                            "first-person",
                                            "plural",
                                            "possessive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "16dd08fe-267a-49c1-9dda-0fe6286e8165",
                                                "sense_id": "536324a1-5eb2-3241-849a-54bb03eb5dd5",
                                                "text": "We must try to save our marriage for the sake of our children."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "30500a00-8764-3bca-8215-e550b2461ba0",
                                        "entry_id": "5e59311b-97d2-3b8e-8d10-c4f0404d5538",
                                        "glosses": [
                                            "Of, from, or belonging to any entity that the speaker is a part of or identifies with, such as place of employment or education, nation, region, language, etc."
                                        ],
                                        "tags": [
                                            "determiner",
                                            "first-person",
                                            "plural",
                                            "possessive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "96521162-1e86-4e11-94b1-d35daa2760e5",
                                                "sense_id": "30500a00-8764-3bca-8215-e550b2461ba0",
                                                "text": "Our safety record at ABC Widgets is very good."
                                            },
                                            {
                                                "example_id": "afdc6c6c-62a1-469d-b012-8021ef78479c",
                                                "sense_id": "30500a00-8764-3bca-8215-e550b2461ba0",
                                                "text": "In English, our nouns do not generally have gender."
                                            },
                                            {
                                                "example_id": "84584ad0-0e33-4fa2-bc09-912f0fe8f572",
                                                "sense_id": "30500a00-8764-3bca-8215-e550b2461ba0",
                                                "text": "Thirdly, I continue to attempt to interdigitate the taxa in our flora with taxa of the remainder of the world."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6241c633-bab0-3453-ad46-81f8c68e638b",
                                        "entry_id": "5e59311b-97d2-3b8e-8d10-c4f0404d5538",
                                        "glosses": [
                                            "Belonging to people in general."
                                        ],
                                        "tags": [
                                            "determiner",
                                            "first-person",
                                            "plural",
                                            "possessive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d7386cdf-e048-460e-930c-37440bff93da",
                                                "sense_id": "6241c633-bab0-3453-ad46-81f8c68e638b",
                                                "text": "As we get older, our reactions get slower."
                                            },
                                            {
                                                "example_id": "38ff1bdb-253c-4d52-b70a-ffbf5ff8dfbb",
                                                "sense_id": "6241c633-bab0-3453-ad46-81f8c68e638b",
                                                "text": "As we age, the major arteries of our bodies frequently become thickened with plaque, a fatty material with an oatmeal-like consistency that builds up along the inner lining of blood vessels."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "615cbcf0-4f53-3beb-a54e-226959d7dd09",
                                        "entry_id": "5e59311b-97d2-3b8e-8d10-c4f0404d5538",
                                        "glosses": [
                                            "Belonging to everyone being addressed."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "determiner",
                                            "first-person",
                                            "plural",
                                            "possessive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a9c24f0c-f689-47c9-a20c-2636662ab11f",
                                                "sense_id": "615cbcf0-4f53-3beb-a54e-226959d7dd09",
                                                "text": "How are we all tonight? Have we got our happy faces on?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9a3cc7d3-72e6-30ea-8ba0-206f0ef95af8",
                                        "entry_id": "5e59311b-97d2-3b8e-8d10-c4f0404d5538",
                                        "glosses": [
                                            "Belonging to an individual being addressed; used especially of a person in the speaker's care, or to whom advice or instruction is being given."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "determiner",
                                            "first-person",
                                            "plural",
                                            "possessive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5a8a1b8e-8b48-4e0d-a410-7b619719dfcf",
                                                "sense_id": "9a3cc7d3-72e6-30ea-8ba0-206f0ef95af8",
                                                "text": "How are we feeling this morning, Mrs Miggins? Have we taken our tablets yet?"
                                            },
                                            {
                                                "example_id": "82ac3e1a-1ee5-4ed3-b752-ffd5af594de7",
                                                "sense_id": "9a3cc7d3-72e6-30ea-8ba0-206f0ef95af8",
                                                "text": "You've been spending all your money boozing when you have a wife and family to support. I think we need to get our priorities straight."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "89c48c1e-8c76-32c8-aeef-f216411731ed",
                                        "entry_id": "5e59311b-97d2-3b8e-8d10-c4f0404d5538",
                                        "glosses": [
                                            "Belonging to a third person, especially someone in the speaker's care."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "determiner",
                                            "first-person",
                                            "plural",
                                            "possessive",
                                            "uncommon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "49fa6027-a6fc-417f-ae01-fdfab624a44a",
                                                "sense_id": "89c48c1e-8c76-32c8-aeef-f216411731ed",
                                                "text": "\"I've just been to see Mrs Miggins.\" — \"And how is she?\" — \"Not too good today. We've had a little problem with our tummy.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "86d05a28-babf-386d-b537-a2e445cc2f00",
                                        "entry_id": "5e59311b-97d2-3b8e-8d10-c4f0404d5538",
                                        "glosses": [
                                            "Used to imply connection between the speaker's experiences or activities and a group of listeners."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "determiner",
                                            "first-person",
                                            "plural",
                                            "possessive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "548db3f9-b1e5-4d26-800c-b6b96de246a3",
                                                "sense_id": "86d05a28-babf-386d-b537-a2e445cc2f00",
                                                "text": "Hey guys, in this video I'll show you how I make my upside-down sponge cake. First, let's get our ingredients weighed out."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "01385658-dd55-3b83-89ad-599f791b3282",
                                        "entry_id": "5e59311b-97d2-3b8e-8d10-c4f0404d5538",
                                        "glosses": [
                                            "Used before a person's name to indicate that the person is in one's family, or is a very close friend."
                                        ],
                                        "tags": [
                                            "Northern-England",
                                            "Scotland",
                                            "determiner",
                                            "first-person",
                                            "plural",
                                            "possessive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8bfa9e84-849b-42f5-86b5-f88d30f16d45",
                                                "sense_id": "01385658-dd55-3b83-89ad-599f791b3282",
                                                "text": "I'm going to see our Terry for tea."
                                            }
                                        ]
                                    }
                                ]
                            },
