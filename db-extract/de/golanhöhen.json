                                        "glosses": [
                                            "A plateau in Syria straddling the border with (and currently occupied by) Israel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d77a6a5-bcbb-4b47-a0b6-eb098d766556",
                                                "sense_id": "0de9b3d9-d152-3547-a910-31f6889032fb",
                                                "text": "The agreement to disengage forces in the Golan Heights had been an achievement of substational proportions, and my visit was an opportunity to encourage, support, and nurture the new Syrian-American relationship that Kissinger had begun."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
