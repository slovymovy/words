                                                "sense_id": "5485a9f4-04fc-39d7-a5bd-30989adaeccb",
                                                "text": "We climbed up into the cove hardwood along a CCC path laid by unemployed boys not much older than Robin."
                                            },
                                            {
                                                "example_id": "716b5b61-561d-402b-82f1-f243e8bf6490",
                                                "sense_id": "5485a9f4-04fc-39d7-a5bd-30989adaeccb",
                                                "text": "The CCC would restore the soil health of farmlands in the Heartland and power the Colorado River by constructing the Hoover Dam. Their work transformed the very landscape of America."
                                            }
                                        ]
                                    },
