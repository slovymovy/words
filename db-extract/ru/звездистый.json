                                        "entry_id": "508f4c3b-0e07-35a4-9a14-7d583f24cbba",
                                        "glosses": [
                                            "Participe passé masculin singulier de étoiler."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    }
