                "senses": [
                    {
                        "sense_id": "4de44859-0d2e-36d9-a9aa-018d17e9b981",
                        "entry_id": "776ffc23-b33a-36d9-a8f3-6e186d91fe9f",
                        "glosses": [
                            "Synonyme de déboucher, ouvrir."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "29481088-3972-4449-87d0-c6b788165059",
                                "sense_id": "4de44859-0d2e-36d9-a9aa-018d17e9b981",
                                "text": "Les hypers débouchonnent leur foire aux vins."
                            },
                            {
                                "example_id": "870fd6b2-527c-4f1f-9ae2-fe5e1ab6ab32",
                                "sense_id": "4de44859-0d2e-36d9-a9aa-018d17e9b981",
                                "text": "Ben je suis désolé, mais (…) 90% des personnes que je connais débouchonnent des bouteilles de pinard et débouchent seulement les chiottes. D'ailleurs, « décapsuler » est bien la preuve que ce n'est pas déconnant."
                            },
                            {
                                "example_id": "2f0658e6-b801-4b2c-889e-dd6224d4635e",
                                "sense_id": "4de44859-0d2e-36d9-a9aa-018d17e9b981",
                                "text": "La housse arrive avec ses 16 feutres ultralavables prêts à débouchonner."
                            }
                        ]
                    },
                    {
                        "sense_id": "3e21697c-82e9-3197-84e7-64d9593b00be",
                        "entry_id": "776ffc23-b33a-36d9-a8f3-6e186d91fe9f",
                        "glosses": [
                            "Mettre fin à un bouchon routier."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52d914a8-0746-4f69-bb82-00ba62c297ea",
                                "sense_id": "3e21697c-82e9-3197-84e7-64d9593b00be",
                                "text": "Je restai quatre heures pleines dans ce fossé car les secours, une fois avertis, ne pouvaient me rejoindre, leurs sirènes et gyrophares se trouvant absolument inaptes à débouchonner les accès qui les eussent conduits à moi."
                            }
                        ]
                    }
