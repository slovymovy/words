                        "entry_id": "b54dab57-5ac7-3301-897b-ec363f47105b",
                        "glosses": [
                            "A female centaur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9d632ca-4697-451e-8441-ae8e31794854",
                                "sense_id": "1a111847-e4ae-3670-8baf-1e40c9cf9527",
                                "text": "1575. A CENTAURESS ſuckling a child. Cornelian."
                            },
                            {
                                "example_id": "ef1933a6-e3d9-4c3d-b480-e1a2658e3030",
                                "sense_id": "1a111847-e4ae-3670-8baf-1e40c9cf9527",
                                "text": "a Centaureſs with a young Man, ſhe holds a cymbal of gilt-bronze, the thrones of Venus and Mars, with their attributes, are in the fame picture"
                            },
                            {
                                "example_id": "2add6924-638d-4faf-874a-7fcbd772281b",
                                "sense_id": "1a111847-e4ae-3670-8baf-1e40c9cf9527",
                                "text": "On a grass-plot of the most glossy verdure lies the centauress, with the whole equine part of her stretched on the ground, the hind feet extending backwards: while the upper female part is gently raised, and reclining on one elbow."
                            },
                            {
                                "example_id": "711e4686-2daf-4bdc-bc33-14b3420e45c9",
                                "sense_id": "1a111847-e4ae-3670-8baf-1e40c9cf9527",
                                "text": "we see, from the emptied drinking-vessel of the Centauress before us, that the God did not neglect to requite them for their zeal"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c16c8bdc-6de4-4fa6-bb40-410fe1251906",
                        "source_entry_id": "b54dab57-5ac7-3301-897b-ec363f47105b",
                        "source_sense_id": "1a111847-e4ae-3670-8baf-1e40c9cf9527",
                        "source_sense_description": "a female centaur",
                        "target_lang_word": "centauresse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "centauresse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "aece8fd6-532d-3f39-9b0e-79c3ce20d26d",
                                        "entry_id": "7f80d059-bf93-31fb-a287-f5849bd32574",
                                        "glosses": [
                                            "Centaure femelle."
                                        ],
                                        "tags": [
                                            "Fantastique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "96c6f6ae-d16f-490f-8322-ceef1784ef27",
                                                "sense_id": "aece8fd6-532d-3f39-9b0e-79c3ce20d26d",
                                                "text": "Les longues queues s’enroulent sur elles-mêmes et deviennent des serpents que la centauresse maintient à distance de sa tête à l’aide de ses deux mains."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9cccad9e-b346-3c86-be35-b587804c2480",
                                        "entry_id": "7f80d059-bf93-31fb-a287-f5849bd32574",
                                        "glosses": [
                                            "Cavalière habile et infatigable."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3dd6c185-537b-4e8f-a2c7-bd3250065f71",
                                                "sense_id": "9cccad9e-b346-3c86-be35-b587804c2480",
                                                "text": "Les tribulations maritales que le philosophe eut avec sa centauresse, le jetèrent dans le vin du cru, un vin qui contient trois quarts d’eau-de-vie, et qui lui donna une attaque de delirium tremens."
                                            },
                                            {
                                                "example_id": "ed12db78-37be-4d28-852f-ac4ce9d2645b",
                                                "sense_id": "9cccad9e-b346-3c86-be35-b587804c2480",
                                                "text": "[…] Ne parlons même pas de la moto, qu’elle avait essayé une fois, avec un amant. Elle ne pensait à rien tant elle avait peur, cœur emballé, respiration courte, supplications pour qu’il roule au ralenti.\n Jamais elle ne serait cette femme-là, mi-fille aux cheveux longs, mi-engin de course, centauresse explosive à laquelle les hommes rêvaient de se coller. Seule une femme-bolide gainée de cuir pouvait arraisonner Axel."
                                            }
                                        ]
                                    }
                                ]
                            }
