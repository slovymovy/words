                "translations": [
                    {
                        "translation_id": "2ec0bab7-3cd9-46df-aa70-185ca5e27368",
                        "source_entry_id": "45a8bd3c-5054-33f1-bfcd-861def91a2f4",
                        "source_sense_id": "733b9b8f-3db5-34ef-bea3-0a91d4785480",
                        "source_sense_description": "krachtterm, drukt verbazing uit",
                        "target_lang_word": "Donnerwetter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Donnerwetter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "46159950-b3b1-301d-bfdc-876269f4ec84",
                                        "entry_id": "125c9526-c048-33d8-ae47-26a6c64d8d6b",
                                        "glosses": [
                                            "Gewitter"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a4126f6-f09e-4a20-b347-8519d469655c",
                                                "sense_id": "46159950-b3b1-301d-bfdc-876269f4ec84",
                                                "text": "Gestern Abend gab es ein heftiges Donnerwetter mit Hagel und sintflutartigem Regen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d947a742-d58c-3d25-864a-ecba58e2c327",
                                        "entry_id": "125c9526-c048-33d8-ae47-26a6c64d8d6b",
                                        "glosses": [
                                            "heftige Schelte, deutliche Zurechtweisung"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c6f094cc-16cb-42b9-9a15-a1220f404799",
                                                "sense_id": "d947a742-d58c-3d25-864a-ecba58e2c327",
                                                "text": "Wenn du jetzt nicht spurst, gibt es ein Donnerwetter!"
                                            },
                                            {
                                                "example_id": "c12a82ef-2e18-4bd6-b98d-400cbbbecd3a",
                                                "sense_id": "d947a742-d58c-3d25-864a-ecba58e2c327",
                                                "text": "„Das gab ein gewaltiges Donnerwetter und eine Tracht Prügel für den bösen Bruno.“"
                                            },
                                            {
                                                "example_id": "0b917383-25e7-4d8d-bcd6-c19dcd088c10",
                                                "sense_id": "d947a742-d58c-3d25-864a-ecba58e2c327",
                                                "text": "„Ich konnte ihr nie dafür danken, dass sie mir mit ihrem Donnerwetter zu dem einen Gedankenblitz verholfen hat, der das Rätsel um den verlorenen Teil der Tabula Peutingeriana schließlich lösen sollte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Donnerwetter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "458ca456-23fc-351b-a27d-46e342a24243",
                                        "entry_id": "f4dc54d3-8bdc-34da-b01f-6ee2fa565cc5",
                                        "glosses": [
                                            "Ausruf des Erstaunens, der freudigen Überraschung, der Bewunderung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "faa29f2f-a504-4a2f-8c5b-318cf2b7edf4",
                                                "sense_id": "458ca456-23fc-351b-a27d-46e342a24243",
                                                "text": "Donnerwetter! Du siehst aber heute scharf aus!"
                                            },
                                            {
                                                "example_id": "e2c4aa5f-0d2b-4cd7-b911-2d24affa1a7b",
                                                "sense_id": "458ca456-23fc-351b-a27d-46e342a24243",
                                                "text": "„Donnerwetter, dachte Thomas Lieven, da fängt ja ein Riesending an!“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3e17d0d3-c942-4ebf-bfef-545b3fad4587",
                        "source_entry_id": "45a8bd3c-5054-33f1-bfcd-861def91a2f4",
                        "source_sense_id": "733b9b8f-3db5-34ef-bea3-0a91d4785480",
