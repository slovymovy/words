            "senses": [
                {
                    "sense_id": "a9fa0234-106f-37de-b2e8-c97a0e52ad3c",
                    "sense_definition": "Mettre ou faire tomber dans une situation embarrassante, compliquée ou inextricable.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "difficulte_abstraite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le porte-parole s'<w>empêtre</w> dans des explications confuses pour tenter de justifier cette décision impopulaire."
                        },
                        {
                            "text": "L'entreprise s'est <w>empêtrée</w> dans un scandale financier qui menace sa réputation internationale."
                        }
                    ],
                    "synonyms": [
                        "embarrasser",
                        "embourber"
                    ],
                    "antonyms": [
                        "dépêtrer"
                    ],
                    "common_phrases": [
                        "s'empêtrer dans ses explications",
                        "s'empêtrer dans ses mensonges"
                    ]
                },
                {
                    "sense_id": "07fef35e-23c6-3651-ad50-65f8f5021b44",
                    "sense_definition": "Engager dans des liens, des cordages ou des obstacles matériels entravant les mouvements.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "entrave_materielle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le chat s'est <w>empêtré</w> dans les rideaux du salon et miaule pour qu'on le délivre."
                        },
                        {
                            "text": "En courant dans la forêt sombre, le promeneur s'<w>empêtre</w> les pieds dans les racines d'un arbre."
                        }
                    ],
                    "synonyms": [
                        "emmêler",
                        "enchevêtrer",
                        "entraver"
                    ],
                    "antonyms": [
                        "dépêtrer"
                    ],
                    "common_phrases": [
                        "s'empêtrer les pieds",
                        "s'empêtrer dans les cordes"
                    ]
                }
            ]
        }
    ]
