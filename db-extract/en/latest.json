                    {
                        "sense_id": "3d53d161-c573-3c97-baed-3563ce212de7",
                        "entry_id": "53c65e5b-1fbb-37be-82a0-5073b75d68bc",
                        "glosses": [
                            "Last, final."
                        ],
                        "tags": [
                            "archaic",
                            "poetic"
                        ],
                        "examples": [
                            {
                                "example_id": "d2f90c97-ba75-4ac0-a9d7-c6bfc4ac2a22",
                                "sense_id": "3d53d161-c573-3c97-baed-3563ce212de7",
                                "text": "Whiles the sad pang approching she does feele, / Brayes out her latest breath, and vp her eyes doth seele."
                            }
                        ]
                    },
                    {
                        "sense_id": "bb0743e1-e6b0-30fb-9e55-2bf90a511d33",
                        "entry_id": "53c65e5b-1fbb-37be-82a0-5073b75d68bc",
                        "glosses": [
                            "Most recent."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e2d8186-14ac-4ffb-8b64-dd56479e65b6",
                                "sense_id": "bb0743e1-e6b0-30fb-9e55-2bf90a511d33",
                                "text": "Here is the latest news on the accident."
                            },
                            {
                                "example_id": "07f5ccd3-3359-4edf-be12-6c5434c7542b",
                                "sense_id": "bb0743e1-e6b0-30fb-9e55-2bf90a511d33",
                                "text": "My latest album, which is being published next week, is even better than my last one."
                            },
                            {
                                "example_id": "554b8847-fb68-40f8-8e35-a5933846c090",
                                "sense_id": "bb0743e1-e6b0-30fb-9e55-2bf90a511d33",
                                "text": "It's the latest fashion, ma'am."
                            },
                            {
                                "example_id": "6d0b1cbd-8dd5-41f6-b5cf-7c1c90d694dd",
                                "sense_id": "bb0743e1-e6b0-30fb-9e55-2bf90a511d33",
                                "text": "Equally I can stand in a station like Lucerne in Switzerland, and watch with ill-concealed admiration the majestic entry of one of the latest Gotthard \"Ae 6/6\" electrics, packing 6,000 horsepower within its 60 ft. of length and 121 tons of weight, with its sleek dark green sides and handsome stainless steel bands and front wings."
                            }
                        ]
                    }
                ],
