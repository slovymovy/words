        "nl-extract.jsonl": [
            {
                "entry_id": "6854d171-4fd5-3bbe-aace-8587303cc8b2",
                "word": "verstoordheid",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "3c2802d7-f6c9-32d6-a30c-857235eb16a0",
                        "entry_id": "6854d171-4fd5-3bbe-aace-8587303cc8b2",
                        "glosses": [
                            "gevoel van woede en toorn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "049f48e8-3b16-4ca9-8fbf-5d01e4e5bf70",
                                "sense_id": "3c2802d7-f6c9-32d6-a30c-857235eb16a0",
                                "text": "Mijn verstoordheid hield hem nog wat in leven, voor zolang als het duurde."
                            },
                            {
                                "example_id": "d2ca4bd2-1d7d-45e5-91f6-0feb98e5cac0",
                                "sense_id": "3c2802d7-f6c9-32d6-a30c-857235eb16a0",
                                "text": "Vrienden van je waren verontwaardigd over de koppen in sommige kranten waarin je bij je dood werd herdacht. De Volkskrant kenschetste je als ‘Malle Appie’, NRC Handelsblad noemde je ‘Nationale lachebek’. Deze verstoordheid begreep ik niet goed. Beide karakteriseringen gaven exact weer wat je bij leven voor je miljoenenpubliek was, toch? Zou je er zelf verontwaardigd of zelfs kwaad om zijn geweest?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c693e5b1-0234-41e8-baab-b9854f5d8108",
                        "source_entry_id": "6854d171-4fd5-3bbe-aace-8587303cc8b2",
                        "source_sense_id": "3c2802d7-f6c9-32d6-a30c-857235eb16a0",
                        "source_sense_description": "gevoel van woede en toorn",
                        "target_lang_word": "indignation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "indignation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ca9d5700-d0c2-33a2-be44-6976f09674b3",
                                        "entry_id": "c20ae4d4-b66f-3e14-ae72-e102a2cbc5ac",
                                        "glosses": [
                                            "An anger aroused by something perceived as an indignity, notably an offense or injustice."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "da34d63c-b862-4acb-ba62-a8c003e19eff",
                                                "sense_id": "ca9d5700-d0c2-33a2-be44-6976f09674b3",
                                                "text": "He protested in indignation."
                                            },
                                            {
                                                "example_id": "0c73b90d-9dcc-434d-baa0-0c15e6d572ac",
                                                "sense_id": "ca9d5700-d0c2-33a2-be44-6976f09674b3",
                                                "text": "The Iron of it ſelfe, though heate red hot, / Approaching neere theſe eyes, would drinke my teares, / And quench this fierie indignation, / Euen in the matter of mine innocence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eb5e2a75-324f-341a-b2fc-5e38b60df618",
                                        "entry_id": "c20ae4d4-b66f-3e14-ae72-e102a2cbc5ac",
                                        "glosses": [
                                            "A self-righteous anger or disgust."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1006b5b4-735e-4f08-8448-174ae673a507",
                        "source_entry_id": "6854d171-4fd5-3bbe-aace-8587303cc8b2",
                        "source_sense_id": "3c2802d7-f6c9-32d6-a30c-857235eb16a0",
                        "source_sense_description": "gevoel van woede en toorn",
                        "target_lang_word": "peevishness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "peevishness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b15ce26b-f39e-3f47-9217-8e3b91b0c669",
                                        "entry_id": "f1ebc63b-5dda-3de7-bacf-ff60f9a6c344",
                                        "glosses": [
                                            "The state of being peevish."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d9df2792-2488-40f6-a159-8c2536c0e469",
                                                "sense_id": "b15ce26b-f39e-3f47-9217-8e3b91b0c669",
                                                "text": "Moreover, it were ungenerous, having bred thee up freakish and fiery, to dismiss thee to want or wandering, for shewing that very peevishness and impatience of discipline which arose from thy too delicate nurture."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b7bbf077-df26-4f54-9f00-77784beb4ff1",
                        "source_entry_id": "6854d171-4fd5-3bbe-aace-8587303cc8b2",
                        "source_sense_id": "3c2802d7-f6c9-32d6-a30c-857235eb16a0",
                        "source_sense_description": "gevoel van woede en toorn",
                        "target_lang_word": "spite",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "spite",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f58fc171-5359-3892-92ef-a344eb249b62",
                                        "entry_id": "52613071-e410-3026-82b9-e9b45a5dbfe3",
                                        "glosses": [
                                            "Ill will or hatred toward another, accompanied with the desire to unjustifiably irritate, annoy, or thwart; a want to disturb or put out another; mild malice"
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0d44c1d7-f746-4e56-9bc3-7cf1227d684c",
                                                "sense_id": "f58fc171-5359-3892-92ef-a344eb249b62",
                                                "text": "He was so filled with spite for his ex-wife, his brother was afraid of what he might do."
                                            },
                                            {
                                                "example_id": "cac032a3-e3f3-4b5c-a101-373144c458c7",
                                                "sense_id": "f58fc171-5359-3892-92ef-a344eb249b62",
                                                "text": "They did it just for spite."
                                            },
                                            {
                                                "example_id": "4c852062-f663-4fc8-b533-aa620efafd2b",
                                                "sense_id": "f58fc171-5359-3892-92ef-a344eb249b62",
                                                "text": "This is the deadly spite that angers."
                                            },
                                            {
                                                "example_id": "97f3e3a7-ca15-40da-b2b4-2506dffae4aa",
                                                "sense_id": "f58fc171-5359-3892-92ef-a344eb249b62",
                                                "text": "Out of spite, the human beings pretended not to believe that it was Snowball who had destroyed the windmill: they said that it had fallen down because the walls were too thin."
                                            },
                                            {
                                                "example_id": "ec6194d0-2442-4d3c-92f1-443eafde358f",
                                                "sense_id": "f58fc171-5359-3892-92ef-a344eb249b62",
                                                "text": "sex with older men was a way to both internalize my spite towards my mother and to find security in a father figure I lacked with my own father."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0636b4f2-f483-305c-8624-d6e6dcce5b53",
                                        "entry_id": "52613071-e410-3026-82b9-e9b45a5dbfe3",
                                        "glosses": [
                                            "Vexation; chagrin; mortification."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "efb48490-a3a2-45aa-93d5-a7fa80b0c2c4",
                                                "sense_id": "0636b4f2-f483-305c-8624-d6e6dcce5b53",
                                                "text": "\"The time is out of joint: O cursed spite.\""
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "spite",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "93f44a66-7ec8-3cb1-b07e-7e616d59f5cc",
                                        "entry_id": "69b388a9-01dd-34b5-b069-461d5da13803",
                                        "glosses": [
                                            "To treat maliciously; to try to hurt or thwart."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9626b14c-8854-4db0-8e93-b78d87c767af",
                                                "sense_id": "93f44a66-7ec8-3cb1-b07e-7e616d59f5cc",
                                                "text": "She soon married again, to spite her ex-husband."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fbfa1852-b390-35fb-9376-9a2e5e0cecfb",
                                        "entry_id": "69b388a9-01dd-34b5-b069-461d5da13803",
                                        "glosses": [
                                            "To be angry at; to hate."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c38f1e43-2cda-4efd-b30a-8b83aa3184fd",
                                                "sense_id": "fbfa1852-b390-35fb-9376-9a2e5e0cecfb",
                                                "text": "The Danes, then […] pagans, principally spited places of religion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3ad5b6ea-23da-3894-b977-baf98fe7e5bd",
                                        "entry_id": "69b388a9-01dd-34b5-b069-461d5da13803",
                                        "glosses": [
                                            "To fill with spite; to offend; to vex."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "01196f68-0e88-49ea-9c8b-ca6335b87433",
                                                "sense_id": "3ad5b6ea-23da-3894-b977-baf98fe7e5bd",
                                                "text": "But the laſt and fatal Blow, given to that antient Learning, was in the time of Darius, Father of Xerxes, who with the reſt of the Perſians, ſpighted at the Magi, upon the Uſurpation of the Crown by one of their Number, (that counterfeited a younger Son of Cyrus after the Death of Cambyſes,) when he came to be ſetled in that Throne, endeavour'd to aboliſh, not only their Learning and Credit, but their Language too, by changing the old Aſſyrian Characters, and introducing thoſe of Perſia, which grew to be the common Uſe of that whole Empire."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "spite",
                                "target_lang_code": "en",
                                "target_senses": [
