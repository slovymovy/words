                        "examples": [
                            {
                                "example_id": "9c74bca1-145b-4487-b962-6067ba9ec0a7",
                                "sense_id": "477ec58f-4768-33ff-a654-57f9fd61bb20",
                                "text": "Zie ze eens fanatiek tekeer gaan op de schitterende grasmat naast het luxueuze Cornelia Diamond Hotel waar Ajax deze week overwintert. John Heitinga bemoeit zich nadrukkelijk met talent Kasper Dolberg, Lasse Schöne pijnigt zijn buikspieren en Ricardo van Rhijn trekt zich tientallen keren op aan een doellat."
                            },
                            {
                                "example_id": "214796ec-6d8c-4717-a075-c342f9ab7322",
                                "sense_id": "477ec58f-4768-33ff-a654-57f9fd61bb20",
                                "text": "In een filmpje hangt Elbersen aan een doellat. Dat heeft een reden, vertelt hij. „Mensen die mee willen doen, moeten zelf van dit soort filmpjes maken. Zeven weken lang, al hoop ik natuurlijk dat ik er met dit filmpje al ben.”"
                            }
                        ]
                    }
