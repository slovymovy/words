                                "target_senses": [
                                    {
                                        "sense_id": "35a31dc1-9903-3a09-b60f-15c7be77af3e",
                                        "entry_id": "04b97636-064a-39fb-8607-3fd1ce2d582b",
                                        "glosses": [
                                            "chemisches Element mit der Ordnungszahl 57, das zur Serie der Übergangsmetalle gehört"
                                        ],
                                        "tags": [],
                                        "examples": [
