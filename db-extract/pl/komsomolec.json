                "senses": [
                    {
                        "sense_id": "4597e3e2-15c4-3793-b2e3-109f6ec7963c",
                        "entry_id": "470f2dca-6cc5-3cbd-b4f2-2b361d1ef6d4",
                        "glosses": [
                            "członek komsomołu"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44bd354b-2401-4ac1-a605-c7888379a864",
                                "sense_id": "4597e3e2-15c4-3793-b2e3-109f6ec7963c",
                                "text": "Książki Ostrowskiego, służące politycznej indoktrynacji młodego pokolenia, sprawiły, iż Korczagin stał się patronem pionierów i komsomolców"
                            },
                            {
                                "example_id": "5bc9933a-47ab-48d8-ba2e-4e3779150540",
                                "sense_id": "4597e3e2-15c4-3793-b2e3-109f6ec7963c",
                                "text": "Epoka Chruszczowa to również wyjazdy komsomolców do Kazachstanu i na Syberię […], megalomańskie hasła typu „Dogonimy i przegonimy Amerykę!”, obietnice bez pokrycia"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e8d0c5c8-e009-41c0-9435-4dcd9f3ca4fc",
                        "source_entry_id": "470f2dca-6cc5-3cbd-b4f2-2b361d1ef6d4",
                        "source_sense_id": "4597e3e2-15c4-3793-b2e3-109f6ec7963c",
                        "target_lang_word": "комсомо́лец",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "комсомо́лец",
