                                        "entry_id": "4334105c-a6c7-37a5-8a1a-a7eff2412722",
                                        "glosses": [
                                            "Containing a great number."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d09de212-6a01-40ec-a0fb-d00ca2a21728",
                                                "sense_id": "5087a60b-4156-3f88-90a9-f4480ff56b1a",
                                                "text": "1646, Sir Thomas Browne, Pseudodoxia Epidemica (aka, Vulgar Errours), Google Books\nUnto whom (what is deplorable in men and Christians) too many applying themselves, betwixt jest and earnest, betray the cause of truth, and insensibly make up the legionary body of error."
                                            }
                                        ]
