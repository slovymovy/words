                "senses": [
                    {
                        "sense_id": "b884f0c8-5d3e-3aff-b352-25c1a419503c",
                        "entry_id": "9191fdd8-b5bf-3c3f-bab4-f9413ab69a79",
                        "glosses": [
                            "het weer dat voor de komende dagen verwacht wordt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a915855-eee9-4292-abaf-6ccb975b2175",
                                "sense_id": "b884f0c8-5d3e-3aff-b352-25c1a419503c",
                                "text": "De weersverwachting geeft men tijdens het weerbericht."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2e9e6829-5a86-477f-91ef-5e53222b9660",
                        "source_entry_id": "9191fdd8-b5bf-3c3f-bab4-f9413ab69a79",
                        "source_sense_id": "b884f0c8-5d3e-3aff-b352-25c1a419503c",
                        "target_lang_word": "Wettervorhersage",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wettervorhersage",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1b43110f-9d2f-30be-8427-97fa95e1f414",
                                        "entry_id": "167169a0-77df-3e8b-9fd5-35b2ab12991f",
                                        "glosses": [
                                            "eine Aussage über den angenommenen Verlauf des Wetters in der nächsten Zeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df8a1164-6257-4106-9072-c67b19c47105",
                                                "sense_id": "1b43110f-9d2f-30be-8427-97fa95e1f414",
                                                "text": "Laut Wettervorhersage soll es am Wochenende regnen."
                                            },
                                            {
                                                "example_id": "9c7ab53d-09e1-456c-873f-9184da29cdae",
                                                "sense_id": "1b43110f-9d2f-30be-8427-97fa95e1f414",
                                                "text": "Die Wettervorhersage ist nur kurzfristig präzise."
                                            },
                                            {
                                                "example_id": "0c6923e1-236e-4a97-ba7c-4c5ed057d246",
                                                "sense_id": "1b43110f-9d2f-30be-8427-97fa95e1f414",
                                                "text": "Weiterhin teilte der Direktor des National Satellite Meteorological Centre, Yang Jun, mit, dass man zwei Wettersatelliten zur Wettervorhersage noch vor den Olympischen Sommerspielen 2008 in Peking starten will."
                                            },
                                            {
                                                "example_id": "b2a69b2d-24a1-478a-925d-88d04e927ac0",
                                                "sense_id": "1b43110f-9d2f-30be-8427-97fa95e1f414",
                                                "text": "„Der Einsatz der zweiten Atombombe war für den 11. August anberaumt, aber die Wettervorhersage für diesen Tag war schlecht.“"
                                            },
                                            {
                                                "example_id": "9af164f1-1d94-4e04-8d18-e4733d6fd055",
                                                "sense_id": "1b43110f-9d2f-30be-8427-97fa95e1f414",
                                                "text": "„Flutwarnungen kommen mit der Wettervorhersage, also nicht viel früher als wenige Tage.“"
                                            },
                                            {
                                                "example_id": "54fc3eba-3f59-4e9d-befb-43eff95884d4",
                                                "sense_id": "1b43110f-9d2f-30be-8427-97fa95e1f414",
                                                "text": "„Wie immer hatte ich mich genau an die Einladung gehalten, nicht wie Katinka, die sich nach Lust und Laune anzog, die nicht einmal die Wettervorhersage checkte, ehe sie sich für ein Outfit entschied.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "024d9ce7-b711-4972-89ec-d807f104fe40",
                        "source_entry_id": "9191fdd8-b5bf-3c3f-bab4-f9413ab69a79",
