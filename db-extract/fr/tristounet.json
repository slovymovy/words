                    {
                        "sense_id": "193057f1-b518-3530-9e2e-b3cb6b1e6bcf",
                        "entry_id": "ddbcf0da-882c-3883-8bc7-b86ffa1183ce",
                        "glosses": [
                            "Maussade."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "da35672c-0465-4ee3-a9c4-5eeea93fd238",
                                "sense_id": "193057f1-b518-3530-9e2e-b3cb6b1e6bcf",
                                "text": "Pourquoi as-tu cet air tristounet ?"
                            },
                            {
                                "example_id": "8e24aeae-efd0-4641-a857-e45f1c027445",
                                "sense_id": "193057f1-b518-3530-9e2e-b3cb6b1e6bcf",
                                "text": "Le stade baignait dans un crachin tristounet."
                            },
                            {
                                "example_id": "6b95e7e4-4bcd-4d0d-9649-b2ffb1b036f2",
                                "sense_id": "193057f1-b518-3530-9e2e-b3cb6b1e6bcf",
                                "text": "Je ne vois rien de bon à l’horizon. J’ai plutôt l’impression qu’on va se faire resserrer la vis vers le mode confinement. En attendant, ce sont des Pâques tristounettes."
                            }
                        ]
                    },
                    {
                        "sense_id": "5382e4ab-5c9f-395b-bad3-a7547e26a806",
                        "entry_id": "ddbcf0da-882c-3883-8bc7-b86ffa1183ce",
                        "glosses": [
                            "En mauvais état."
                        ],
                        "tags": [
                            "familiar",
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "891b89ba-d02c-4bd6-8d42-0454da2caee2",
                                "sense_id": "5382e4ab-5c9f-395b-bad3-a7547e26a806",
                                "text": "Il y avait foule de l’autre côté, une foule sympathique, c’était jour de marché, des fonctionnaires faisaient provision de légumes frais qui schlinguaient la terre polluée et l’eau croupie, des carottes maigrelettes, des oignons tristounets, des patates fripées et une sorte de citrouille mutante et toute pustuleuse."
                            }
                        ]
                    }
