                        "budget serré",
                        "petit budget"
                    ]
                },
                {
                    "sense_id": "ab1dd104-dcc6-3c04-8d8e-a088e96fe8d8",
                    "sense_definition": "Prévision chiffrée de l'ensemble des revenus et des dépenses d'un foyer ou d'une entreprise.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "prevision_financiere",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Chaque début de mois, elle vérifie son <w>budget</w> pour éviter les mauvaises surprises."
                        },
                        {
                            "text": "L'entreprise doit réviser son <w>budget</w> annuel après la baisse imprévue des ventes."
                        }
                    ],
                    "synonyms": [
