                "entry_id": "60043752-81a1-307f-948b-24c2cb6c1e05",
                "word": "shroom",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "0a42bece-5e9a-4e2d-8575-7258246b3baf",
                        "entry_id": "60043752-81a1-307f-948b-24c2cb6c1e05",
                        "tags": [
                            "plural"
                        ],
                        "form": "shrooms"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6831f06a-3d88-3ddc-bc2d-534151968b26",
                        "entry_id": "60043752-81a1-307f-948b-24c2cb6c1e05",
                        "glosses": [
                            "A magic mushroom: a hallucinogenic fungus."
                        ],
                        "tags": [
                            "plural-normally",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "bc3b466e-d441-45f4-96e8-06a9f9eeeb14",
                                "sense_id": "6831f06a-3d88-3ddc-bc2d-534151968b26",
                                "text": "Dosage: The typical amount of beginner “shroom” dosage ranges from 1.5 grams of dried shrooms for a mild experience, to 3.5 grams for an intense experience."
                            }
                        ]
                    },
                    {
                        "sense_id": "66f481fe-77a5-357a-bd0d-bf30c300e911",
                        "entry_id": "60043752-81a1-307f-948b-24c2cb6c1e05",
                        "glosses": [
                            "Any mushroom."
                        ],
                        "tags": [
                            "informal",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "46de499e-6f65-446d-bccb-b4ee069aa751",
                                "sense_id": "66f481fe-77a5-357a-bd0d-bf30c300e911",
                                "text": "To determine how much live protein may be occupying a shroom, try this test: […]."
                            },
                            {
                                "example_id": "998d54c0-6fd4-4dd3-b8ca-68f58667d038",
                                "sense_id": "66f481fe-77a5-357a-bd0d-bf30c300e911",
                                "text": "These succulent little shrooms from pop culture scholar Lena Lencek will drive everyone back for seconds."
                            },
                            {
                                "example_id": "301be2f7-8cc5-44fb-9826-3f77b403ab1f",
                                "sense_id": "66f481fe-77a5-357a-bd0d-bf30c300e911",
                                "text": "Shrooms—and I don’t mean the psychedelic kind—are one of those vegetables that you either love or hate."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
