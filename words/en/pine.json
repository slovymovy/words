                                "target_lang_word": "uvadat",
                                "target_lang_sense_clarification": "ztrácet vitalitu"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "7c6f6fdc-3f22-30c0-be4e-3a82c910671c",
                    "sense_definition": "A surname.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Pine</w> is the new mathematics teacher at our local high school.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Пайн</w> — новый учитель математики в нашей местной средней школе.",
                                "zh": "<w>派恩</w>先生是我们当地高中的新数学老师。",
                                "cs": "Pan <w>Pine</w> je nový učitel matematiky na naší místní střední škole."
                            }
                        },
                        {
                            "text": "I have an appointment with Dr. <w>Pine</w> tomorrow morning.",
                            "target_lang_translations": {
                                "ru": "У меня прием у доктора <w>Пайна</w> завтра утром.",
                                "zh": "我明天早上预约了<w>派恩</w>医生。",
                                "cs": "Zítra ráno mám schůzku s doktorem <w>Pinem</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
