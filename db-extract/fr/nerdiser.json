                "senses": [
                    {
                        "sense_id": "086437da-27dc-3945-9bda-7edde5e3a213",
                        "entry_id": "54f53b86-b501-3115-8f33-e568702b254f",
                        "glosses": [
                            "Donner un caractère nerd à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f08b2ac7-e467-4eff-a0ea-4de5f221c4be",
                                "sense_id": "086437da-27dc-3945-9bda-7edde5e3a213",
                                "text": "L'histoire de Bart qui se voit \"nerdisé\" est sympathique, surtout au niveau de sa fin, mais sans vraiment plus."
                            },
                            {
                                "example_id": "f889a1cf-cf2b-4bbe-9aca-844f5f964127",
                                "sense_id": "086437da-27dc-3945-9bda-7edde5e3a213",
                                "text": "J'avoue que j'en ai toujours un sur moi, au cas où je tombe sur un specimen manquant à ma collection (oui, je suis en train de me Nerdiser)."
                            },
                            {
                                "example_id": "f9920429-d325-40f8-8e51-1c1854fcc11d",
                                "sense_id": "086437da-27dc-3945-9bda-7edde5e3a213",
                                "text": "Finie la vie étudiante pour de bon, adieu grandes vacances qui me permettaient de nerdiser."
                            }
                        ]
                    }
