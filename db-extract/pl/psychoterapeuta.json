                "senses": [
                    {
                        "sense_id": "6fcb30c6-7aa3-3a34-8ef0-f1a479affb5a",
                        "entry_id": "d457c257-6e57-3563-bf90-57d209340115",
                        "glosses": [
                            "specjalista w dziedzinie psychoterapii"
                        ],
