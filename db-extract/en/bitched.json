                        "examples": [
                            {
                                "example_id": "e6edce99-a530-4c29-ae30-34a8782c24c0",
                                "sense_id": "48da4620-f403-3f6f-87d0-93e07a367ebe",
                                "text": "Such is the whelping of the bitched bones two: Perjury, anger, cheating, homicide."
                            }
                        ]
                    },
                    {
                        "sense_id": "45e39922-a167-3ead-8d3b-76f06b5638fd",
                        "entry_id": "0e3eac1c-17b4-361f-876a-61fde8b75401",
                        "glosses": [
                            "Causing difficulty; nasty; unpleasant; problematic; (intensifier) damned, bloody"
                        ],
                        "tags": [
                            "vulgar"
                        ],
                        "examples": [
                            {
                                "example_id": "57eb3c7b-4420-49df-b81f-7ed907edc855",
                                "sense_id": "45e39922-a167-3ead-8d3b-76f06b5638fd",
                                "text": "A Sussex villager told his friends that Elizabeth Best was a 'bitched whore', and offered a shilling to anyone who would drive his cart to her door and say, 'Dame, here is a cart load of whores'."
                            },
                            {
                                "example_id": "47f59bcb-d984-42e5-93c6-8ebb395a2bd1",
                                "sense_id": "45e39922-a167-3ead-8d3b-76f06b5638fd",
                                "text": "For example, she fought a bitched battle with the Condorloser, although she, the Boxer, was eventually vanquished."
                            },
                            {
                                "example_id": "407d0b7b-7125-447b-a0e3-f2c0380d286c",
                                "sense_id": "45e39922-a167-3ead-8d3b-76f06b5638fd",
                                "text": "Sully took a look and diagnosed a bitched spring, but said he could make a temporary repair."
                            },
                            {
                                "example_id": "e6827633-460a-4bc3-a806-b67e22121b39",
                                "sense_id": "45e39922-a167-3ead-8d3b-76f06b5638fd",
                                "text": "Let us renounce the dichotomies of the bitched mandarins."
                            }
                        ]
                    }
