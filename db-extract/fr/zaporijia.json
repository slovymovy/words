                "senses": [
                    {
                        "sense_id": "4ae1dbf0-9dc4-3b7e-a512-31c9635a9ebb",
                        "entry_id": "1e50f7d1-f2fb-3f1d-910b-563507fd7037",
                        "glosses": [
                            "Ville d’Ukraine arrosée par le Dniepr et capitale administrative de l’oblast de Zaporijia."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d41fe3a1-4da5-4312-869c-d26f4fd67930",
                                "sense_id": "4ae1dbf0-9dc4-3b7e-a512-31c9635a9ebb",
                                "text": "M. Phillips a ensuite été conduit dans une voiture de police jusqu’à une caserne de l’armée ukrainienne à Zaporijia."
                            },
                            {
                                "example_id": "2cdec537-cbb7-48ae-b4e9-fe10ad8a7cc5",
                                "sense_id": "4ae1dbf0-9dc4-3b7e-a512-31c9635a9ebb",
                                "text": "Un réacteur de la centrale ukrainienne de Zaporijia (sud-est), la plus grande d’Europe, a été débranché aujourd’hui par son système de protection automatique pour une raison encore inconnue, a annoncé la centrale, assurant qu’aucune fuite de radioactivité n’avait eu lieu."
                            },
                            {
                                "example_id": "45b7bde6-4c7d-419a-9c4a-8e7f6a6e64ab",
                                "sense_id": "4ae1dbf0-9dc4-3b7e-a512-31c9635a9ebb",
                                "text": "Il soutient les efforts d’Antonio Guterres, le secrétaire général de l’ONU, pour geler les combats autour de la centrale nucléaire ukrainienne de Zaporijia."
                            }
                        ]
                    }
