                                    {
                                        "sense_id": "9ea491e8-ab02-3d0d-bc44-494430c854f5",
                                        "entry_id": "5ac8fd00-fba9-3c5c-ae9c-21fc8051517a",
                                        "glosses": [
                                            "The close and long-term relationship or interaction between two or more different species in which at least one of the organisms benefit.",
                                            "The close and long-tern relationship or interaction between two or more different species in which all organisms benefit; mutualism."
                                        ],
                                        "tags": [
