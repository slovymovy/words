                        "sense_id": "afa27927-0587-39c6-8f82-4e444f3c582d",
                        "entry_id": "6f886db6-94d8-3db7-b0b7-db0c4319b9b8",
                        "glosses": [
                            "A cloak or gown, especially of a kind popular with women in the 17th and 18th centuries."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b032dcf-fa70-416d-8fc1-819039d7d6b5",
                                "sense_id": "afa27927-0587-39c6-8f82-4e444f3c582d",
                                "text": "Not to mention the need to keep her manteau from becoming a sort of anti-parachute which sought to lift her free of the pavement."
                            }
                        ]
                    },
                    {
                        "sense_id": "bca10b54-98cd-3d1c-8118-2499f3870d15",
                        "entry_id": "6f886db6-94d8-3db7-b0b7-db0c4319b9b8",
                        "glosses": [
                            "A long, loose-fitting coat worn by Iranian Muslim women based off the trenchcoat, originally worn with a square Arabic-style hijab and in plain colours, and often associated with liberal politics."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0cdbc4d-f65a-4c3c-a03c-e6bf069bb070",
                                "sense_id": "bca10b54-98cd-3d1c-8118-2499f3870d15",
                                "text": "As a result of this politics of personal appearance, Iranians have come to refer to three types of woman, defining their politics by the clothes they wear: the chadory, the manteauy, and the maghna'eh-poosh. […] In contrast, the manteauy woman wears the loose-fitting manteau, often fashionably with a colorful, loosely tied head scarf. She generally supports both political and social reform."
                            }
                        ]
                    }
