                "senses": [
                    {
                        "sense_id": "dec0d51b-8062-3df6-a3b3-0eee75d0b9f2",
                        "entry_id": "a5f82332-a427-3b7e-9ff0-418d84e0a97f",
                        "glosses": [
                            "The territory governed by a satrap; a province of any of several ancient empires of West Asia (specifically, of the Median or Achaemenid empires or certain of their successors, including the Sasanian Empire and Hellenistic empires)."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "8f03c6ad-7f1f-49e3-9184-b8979e4ac335",
                                "sense_id": "dec0d51b-8062-3df6-a3b3-0eee75d0b9f2",
                                "text": "Several, which occur as one Satrapy in the system given by Herodotus, are given in the lists as distinct provinces."
                            },
                            {
                                "example_id": "c2fd219c-0431-4b05-8046-ff5268b3d31c",
                                "sense_id": "dec0d51b-8062-3df6-a3b3-0eee75d0b9f2",
                                "text": "1951, W. W. Tarn, The Greeks in Bactria and India, Cambridge University Press, 2nd Edition, Digital printing 2010, page 1,\nThe Seleucid empire in its turn was still, in outward shape, very much the empire of Persia under different rulers; the great satrapies still remained, their military nature emphasised by the governor of a satrapy being no longer called satrap but strategos, 'general'."
                            },
                            {
                                "example_id": "3af8fea4-d995-4b32-ab29-07bbf5c2cf29",
                                "sense_id": "dec0d51b-8062-3df6-a3b3-0eee75d0b9f2",
                                "text": "A satrapy′s borders were generally the same as those of the previously independent kingdom, with the satrap stationed in the old capital.[…]The Great King expected two things from the satrapies: a regular supply of taxes (called \"tribute\" because it underlined the satrapy′s subordination to the king) and units for the Persian army when needed."
                            }
                        ]
                    }
                ],
