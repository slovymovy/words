                "senses": [
                    {
                        "sense_id": "95392965-37ab-3406-be74-c764c8e4b5ae",
                        "entry_id": "ed80ebca-36b4-3e88-8493-d7a19ae1496c",
                        "glosses": [
                            "patent leather glove"
                        ],
                        "tags": [
                            "literally",
                            "masculine",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "1a5771bd-c6f7-4622-a76c-be64c85d12ee",
                                "sense_id": "95392965-37ab-3406-be74-c764c8e4b5ae",
                                "text": "Plötzlich war jener Fiaker herangerast, ein offenes Gefährt, und darin lehnte blasiert ein Herrchen, vielleicht neunzehn, vielleicht zwanzig Jahre alt, die Spuren der Ausschweifung in den Zügen, die Finger voller Ringe, Brillantnadel im Schlips, mit Lackschuhen, gebügelter Hose, Spazierstöckchen, Glacéhandschuhen, die ganze Welt in der Tasche, doch sie verachtend."
                            }
                        ]
                    },
                    {
                        "sense_id": "cbbf7ce3-a46f-335a-8359-30ab0ce787ff",
                        "entry_id": "ed80ebca-36b4-3e88-8493-d7a19ae1496c",
                        "glosses": [
                            "kid glove"
                        ],
                        "tags": [
                            "figuratively",
                            "masculine",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "63b16c8e-aa71-4e0b-bd0d-c10e7d0540a8",
                                "sense_id": "cbbf7ce3-a46f-335a-8359-30ab0ce787ff",
                                "text": "Es wird so leicht für sie sein, mich zu kränken, mir weh zu tun, denn schließlich behandelt man ja eine Bettlerin nicht, wie man mit Glacéhandschuhen jemanden anrührt."
                            }
                        ]
                    }
                ],
