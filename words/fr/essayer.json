                    "sense_definition": "Mettre un vêtement ou un accessoire afin de vérifier sa taille et son apparence.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle va <w>essayer</w> une robe élégante avant de l'acheter."
                        },
                        {
