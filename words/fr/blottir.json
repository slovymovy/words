                    "frequency": "Middle",
                    "semantic_group_id": "repli_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Par cette nuit d'hiver, le chien préfère se <w>blottir</w> au pied du lit pour dormir."
                        },
                        {
                            "text": "Effrayé par le bruit du tonnerre, l'enfant s'est vite <w>blotti</w> sous sa couverture."
                        }
                    ],
                    "synonyms": [
                        "se pelotonner"
                    ],
                    "common_phrases": [
                        "se blottir dans un coin",
