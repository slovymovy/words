                        "sense_id": "7f705165-9c9c-31ad-b9a9-5eb97caacb61",
                        "entry_id": "3db6a67f-c1a9-3c44-ae1d-1da7584aed31",
                        "glosses": [
                            "actie om mensen over een bepaald onderwerp in te lichten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "959a0f61-8aa8-457b-8094-c2fb32313e93",
                                "sense_id": "7f705165-9c9c-31ad-b9a9-5eb97caacb61",
                                "text": "De minister vindt het wel belangrijk dat er een informatiecampagne komt om de burgers goed voor te lichten. Die voorlichting wordt gedaan door de referendumcommissie."
                            },
                            {
                                "example_id": "d0eab5db-f9a4-41e0-b580-03db239a8ab8",
                                "sense_id": "7f705165-9c9c-31ad-b9a9-5eb97caacb61",
                                "text": "De uitgebreide informatiecampagne die de werkzaamheden aankondigen, zijn volgens De Standaard ongekend in België."
                            }
                        ]
                    },
                    {
                        "sense_id": "bbf9fe3d-d2d7-3bd6-b9ae-22c39150b961",
                        "entry_id": "3db6a67f-c1a9-3c44-ae1d-1da7584aed31",
                        "glosses": [
                            "actie om mensen te overtuigen van een bepaalde mening over een bepaald onderwerp"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a1615761-1e72-4438-b3ba-0aa030e594bf",
                                "sense_id": "bbf9fe3d-d2d7-3bd6-b9ae-22c39150b961",
                                "text": "\"Met de houding van 'het zal toch wel meevallen' en 'gaat het wel echt gebeuren', gaan we het niet winnen\", zegt werkgeversvoorman Hans de Boer. Reden genoeg voor een informatiecampagne hulpbijbrexit.nl."
                            },
                            {
                                "example_id": "a4b04336-c743-4fac-8cbe-6aa4f1d7f7b2",
                                "sense_id": "bbf9fe3d-d2d7-3bd6-b9ae-22c39150b961",
                                "text": "\"Jullie hebben geen toekomst in Nederland.\" Dat is de boodschap van de Nederlandse overheid aan de inwoners van Albanië. Met een informatiecampagne, die 72.000 euro kost, moet deze boodschap het komende jaar bij zoveel mogelijk Albanezen in eigen land terecht komen."
                            }
                        ]
                    }
