                        "target_lang_word": "rerun",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rerun",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "91e642f4-41df-34b1-b9d0-0df660da9fc5",
                                        "entry_id": "921f1922-c876-32f5-915c-d139e003f8aa",
                                        "glosses": [
                                            "An act or instance of rerunning; a repetition."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43073afb-09de-42dc-80e8-345547b2fa7d",
                                                "sense_id": "91e642f4-41df-34b1-b9d0-0df660da9fc5",
                                                "text": "Even some strong supporters of leaving the UK worry that an early re-run would be doomed to failure."
                                            },
                                            {
                                                "example_id": "efa571c6-3760-4dcb-9b75-1d844b95447b",
                                                "sense_id": "91e642f4-41df-34b1-b9d0-0df660da9fc5",
                                                "text": "The central concern that runs through The Technology Trap is that, unless we are very careful, our latest technological revolution may well turn out to be a tumultuous rerun of the Industrial Revolution, with dire social and political consequences."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "33cb6936-9b48-3b55-8cd8-a287262edd28",
                                        "entry_id": "921f1922-c876-32f5-915c-d139e003f8aa",
                                        "glosses": [
                                            "A television program shown after its initial presentation, particularly many weeks after its initial presentation; a repeat."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "13461083-958f-4841-a919-09213b50693a",
                                                "sense_id": "33cb6936-9b48-3b55-8cd8-a287262edd28",
                                                "text": "I'm not a fan of the new Simpsons episodes, but the old reruns have me in stitches, although I've seen them countless times."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "82dd6a0f-eeac-31e7-9a8a-f318e3c8fdee",
                                        "entry_id": "921f1922-c876-32f5-915c-d139e003f8aa",
                                        "glosses": [
                                            "Another printing run (impression; batch of copies of a given edition) of a book, cartoon, etc."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ea81dd90-4229-32ca-a746-914d56b54ea6",
                                        "entry_id": "921f1922-c876-32f5-915c-d139e003f8aa",
                                        "glosses": [
                                            "A political candidate who holds the same political agenda or doctrine as a past or incumbent holder of a given political office."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "06af1ae5-1ac8-3232-81f1-db90db6a3919",
                                        "entry_id": "921f1922-c876-32f5-915c-d139e003f8aa",
                                        "glosses": [
                                            "A second or subsequent run of a computer program."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "31364682-86f4-4af9-a5fc-0a49b6e9f2cb",
                                                "sense_id": "06af1ae5-1ac8-3232-81f1-db90db6a3919",
                                                "text": "Each rerun of the algorithm takes several minutes."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "rerun",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8ad08e9b-4abb-3c7d-8c50-8ee3a91fb04d",
                                        "entry_id": "2fe11cde-9f63-3609-87f0-127148b308a6",
                                        "glosses": [
                                            "To run again; to repeat."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d948b372-9f1a-4f8d-a08a-9eea71b0ac82",
                                                "sense_id": "8ad08e9b-4abb-3c7d-8c50-8ee3a91fb04d",
                                                "text": "Ms. Hill has rerun those questions in her mind. “If the girls told me they want to stay where they are, I would have to leave them,” she said."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eca3c66f-7c5b-3bb3-a6d1-f3979698adee",
                                        "entry_id": "2fe11cde-9f63-3609-87f0-127148b308a6",
                                        "glosses": [
                                            "To broadcast (a television program etc.) again."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fdeeb67d-1db8-40ed-9bb0-d75c0ebf780e",
                                                "sense_id": "eca3c66f-7c5b-3bb3-a6d1-f3979698adee",
                                                "text": "They're still rerunning The Flintstones on this channel."
                                            },
                                            {
                                                "example_id": "50d83bbe-7b21-401b-b38f-19302c9c2b34",
                                                "sense_id": "eca3c66f-7c5b-3bb3-a6d1-f3979698adee",
                                                "text": "Earlier Sunday, MTV ran and reran a compilation of Ms. Spears’s previous appearances on the show, including her high-school hottie debut in 1999 and her on-the-lips kiss with Madonna in 2003, glossing over her lethargic dance number last year."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f8d7d479-b263-3faf-ba91-5534d335dbff",
                                        "entry_id": "2fe11cde-9f63-3609-87f0-127148b308a6",
                                        "glosses": [
                                            "To be broadcast again."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f1b98235-c7c3-4ec7-9430-4d3b2404d633",
                                                "sense_id": "f8d7d479-b263-3faf-ba91-5534d335dbff",
                                                "text": "Everyone is talking about Lemonade, Beyoncé's new visual album that immediately became a sensation when it debuted on HBO on Saturday night. For those who missed it (and those without a loved one's HBO Go password), Lemonade even reran just before the Game of Thrones' highly anticipated season six premiere on April 24."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "be9bf793-cd13-3bbb-a87f-0663762ce476",
                                        "entry_id": "2fe11cde-9f63-3609-87f0-127148b308a6",
                                        "glosses": [
                                            "To run (a race or other contest) again."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "318629e5-ece9-4c49-874d-222ef56bc07c",
                                                "sense_id": "be9bf793-cd13-3bbb-a87f-0663762ce476",
                                                "text": "rerun the election"
                                            },
                                            {
                                                "example_id": "a8777d68-44e6-4cd3-a754-532d5fa5cdd0",
                                                "sense_id": "be9bf793-cd13-3bbb-a87f-0663762ce476",
                                                "text": "Thursday night, running in Lane 2 on an otherwise empty eight-lane track, at a half-empty Olympic Stadium, the United States women’s 4x100-meter relay team reran a qualifying round all by itself."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "56c18cc2-a798-3af3-b94a-9ea3c0c36a32",
                                        "entry_id": "2fe11cde-9f63-3609-87f0-127148b308a6",
                                        "glosses": [
                                            "To run (a computer program) again."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5a94a619-4d1c-4129-89bd-baa7dc5456a0",
                                                "sense_id": "56c18cc2-a798-3af3-b94a-9ea3c0c36a32",
                                                "text": "Restart the computer and rerun the installation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
