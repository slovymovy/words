            "senses": [
                {
                    "sense_id": "457b826d-1a9c-392a-a942-c4f2110f6491",
                    "sense_definition": "A set of clothes or a costume, especially one that is unusual or eye-catching.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "clothing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She wore a strange <w>getup</w> to the party that made everyone look at her.",
                            "target_lang_translations": {
                                "cs": "Na večírek si vzala podivný <w>úbor</w>, kvůli kterému se na ni všichni dívali."
                            }
                        },
                        {
                            "text": "The actor arrived in a colorful <w>getup</w> for the movie premiere.",
                            "target_lang_translations": {
                                "cs": "Herec dorazil na premiéru filmu v barevném <w>kostýmu</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "outfit",
                        "costume",
                        "attire"
                    ],
                    "common_phrases": [
                        "strange getup",
                        "funny getup"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Often used to describe outfits that are eccentric or elaborate."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Soubor oblečení nebo kostým, zejména takový, který je neobvyklý nebo nápadný."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "úbor",
                                "target_lang_sense_clarification": "obecné označení pro oblečení, často s nádechem výstřednosti"
                            },
                            {
                                "target_lang_word": "kostým",
                                "target_lang_sense_clarification": "oblečení určené pro zvláštní příležitost nebo převlek"
                            },
                            {
                                "target_lang_word": "obleček",
                                "target_lang_sense_clarification": "hovorové označení pro nápadný nebo specifický oděv"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "599a7744-1064-3e7a-ad10-ea2f73ad5b5a",
                    "sense_definition": "A physical fight or argument.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "conflict",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The two men started a <w>getup</w> in the middle of the street.",
                            "target_lang_translations": {
