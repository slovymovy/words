                    "frequency": "Middle",
                    "semantic_group_id": "spiel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er warf die schwere Kugel und traf alle neun <w>Kegel</w> auf einmal."
                        },
                        {
                            "text": "Nach jedem Wurf stellt die automatische Anlage die umgefallenen <w>Kegel</w> wieder auf."
                        }
                    ],
                    "synonyms": [
