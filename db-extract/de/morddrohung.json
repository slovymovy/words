                "senses": [
                    {
                        "sense_id": "efa12bb1-fbbd-361b-b335-d28f75d46318",
                        "entry_id": "8fd0a544-6990-34f7-b9f8-c485ec2829d1",
                        "glosses": [
                            "geäußerte Drohung, dass man jemanden ermorden wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a179db3a-b5bb-43b3-8f2b-aea1492595a4",
                                "sense_id": "efa12bb1-fbbd-361b-b335-d28f75d46318",
                                "text": "„Die Türkische Rachebrigade […] ist eine paramilitärische ultra-nationalistische Organisation in der Türkei. Sie übernahm mehrfach die Verantwortung für Anschläge auf kurdische Zivilisten, politische Morde und Morddrohungen.“"
                            },
                            {
                                "example_id": "656bfe45-9e80-46df-af5b-08f747cf8f5f",
                                "sense_id": "efa12bb1-fbbd-361b-b335-d28f75d46318",
                                "text": "„Die erste Morddrohung kam um drei Uhr morgens.“"
                            },
                            {
                                "example_id": "b9618529-6289-4ba2-b766-e7a131cfe59e",
                                "sense_id": "efa12bb1-fbbd-361b-b335-d28f75d46318",
                                "text": "„Immer wieder erhält sie Morddrohungen, weil sie Russland als Terrorstaat bezeichnete und Putin als Diktator.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
