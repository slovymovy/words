                "senses": [
                    {
                        "sense_id": "c4348333-c727-304c-aad2-f3c93059d668",
                        "entry_id": "285051f3-09e1-349a-a22d-4ddc61b812ac",
                        "glosses": [
                            "auf höchstem Leistungsniveau betriebener Sport"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a64d2158-bbdf-423d-b31d-55720c5197a1",
                                "sense_id": "c4348333-c727-304c-aad2-f3c93059d668",
                                "text": "„Coubertin schuf damit eine Formel, unter welcher der Spitzensport, der Extremsport und der Wagnissport spiralförmig aufblühten.“"
                            },
                            {
                                "example_id": "bfb80b5c-6360-4bb9-a712-29d9b8244a26",
                                "sense_id": "c4348333-c727-304c-aad2-f3c93059d668",
                                "text": "„Depressionen im Spitzensport sind seit den Suiziden bekannter Athleten und Athletinnen ein Dauerthema im öffentlichen Diskurs.“"
                            },
                            {
                                "example_id": "c1df11cb-6336-4729-a0c6-90ab1dcf49a0",
                                "sense_id": "c4348333-c727-304c-aad2-f3c93059d668",
                                "text": "„Es hat nie jemand behauptet, dass Spitzensport auf Kufen den entscheidenden Beitrag zur Entlastung der Krankenkassen leisten kann.“"
                            },
                            {
                                "example_id": "8ebead37-1177-4421-b109-5aa509fc5bde",
                                "sense_id": "c4348333-c727-304c-aad2-f3c93059d668",
                                "text": "„Mit einer Geschwindigkeit von rund 13 Kilometern in der Stunde gehe es nicht um Spitzensport, so der Veranstalter.“"
                            },
                            {
                                "example_id": "3f30089a-c068-444f-8ead-2028501245b5",
                                "sense_id": "c4348333-c727-304c-aad2-f3c93059d668",
                                "text": "„Für eine Weile bringt ihn die Welt wieder mit Spitzensport in Verbindung und nicht mit finanziellen Sorgen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
