                "senses": [
                    {
                        "sense_id": "37917633-8701-3a21-9d1b-dd0f42ef5624",
                        "entry_id": "f58e9cc5-1f66-3c8a-bf81-25a7d5d655e1",
                        "glosses": [
                            "van iets dat het niet te begrijpen is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb062c97-a39a-4f30-882a-5c92cffc1ad8",
                                "sense_id": "37917633-8701-3a21-9d1b-dd0f42ef5624",
                                "text": "Wie heeft Hem verzonnen als Hij er niet is? Waarom is in u het vermoeden opgekomen dat er zo'n onbegrijpelijk wezen bestaat? Hoe zijt gij en hoe is de hele wereld tot de veronderstelling gekomen dat er zo'n onbevattelijk wezen bestaat, een almachtig, eeuwig en in al zijn eigenschappen oneindig wezen?."
                            },
                            {
                                "example_id": "09e5dd97-9f6e-4d49-ae80-ebfe865b3d57",
                                "sense_id": "37917633-8701-3a21-9d1b-dd0f42ef5624",
                                "text": "Ook bij de verschillende partijen is met afschuw gereageerd op de aanval. ,,Opnieuw zo’n onmenselijke daad tegen de vrijheid”, zegt Kamerlid Bente Becker van regeringspartij VVD. ,,Onbevattelijk en hartverscheurend.”"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ed506dc0-1495-4392-8393-49b7ed98a816",
                        "source_entry_id": "f58e9cc5-1f66-3c8a-bf81-25a7d5d655e1",
                        "source_sense_id": "37917633-8701-3a21-9d1b-dd0f42ef5624",
                        "source_sense_description": "van iets dat het niet te begrijpen is",
                        "target_lang_word": "inscrutable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inscrutable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f245990a-36ea-309c-9df5-e7b4cc16213e",
                                        "entry_id": "721596fe-e922-37fb-b5a9-5bf0195b711a",
                                        "glosses": [
                                            "Difficult or impossible to comprehend, fathom, or interpret."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf604419-de3d-4566-aaf8-89a4ba7b4469",
                                                "sense_id": "f245990a-36ea-309c-9df5-e7b4cc16213e",
                                                "text": "His inscrutable theories would years later become the foundation of a whole new science."
                                            },
                                            {
                                                "example_id": "06ade488-6c09-4419-956e-2a0123d5bf1d",
                                                "sense_id": "f245990a-36ea-309c-9df5-e7b4cc16213e",
                                                "text": "The pale, inscrutable determinateness, and flinchless intrepidity of Pierre, now began to domineer upon them; for any social unusualness or greatness is sometimes most impressive in the retrospect."
                                            },
                                            {
                                                "example_id": "de5def77-e3c3-464b-b997-5972a96898ab",
                                                "sense_id": "f245990a-36ea-309c-9df5-e7b4cc16213e",
                                                "text": "It was unconscious, this smile was, though just after he had said something it got intensified for an instant. It came at the end of his speeches like a seal applied on the words to make the meaning of the commonest phrase appear absolutely inscrutable."
                                            },
                                            {
                                                "example_id": "98f6ab16-5fb8-4f86-bad7-f9e68d54148b",
                                                "sense_id": "f245990a-36ea-309c-9df5-e7b4cc16213e",
                                                "text": "She called my vanity license plate inscrutable! 'ICU81MI'? Hilarious!"
                                            },
                                            {
                                                "example_id": "e56580a9-410d-448d-814a-f4d9e4517ae4",
                                                "sense_id": "f245990a-36ea-309c-9df5-e7b4cc16213e",
                                                "text": "The writer Juan Rulfo, whose 1955 novel, “Pedro Páramo,” still stands as the central monument of modern Mexican literature, grew up in Jalisco and vividly depicted its arid, sun-blasted landscapes in his writing, while the architect Luis Barragán, who moved from Guadalajara to Mexico City in the 1930s, carried with him an appreciation for his home state’s cloisters, haciendas and humble country buildings, which he translated in his own work as austere, inscrutable volumes of stucco."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "inscrutable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a97a8ef0-12d7-3c28-9cfa-46701e43f0a5",
                                        "entry_id": "5ecfa31a-3789-30d6-938a-a6a5bc58655c",
                                        "glosses": [
                                            "One who or that which is inscrutable; a person, etc. that cannot be comprehended."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1a120005-ea28-43c7-bfd1-6027ad316d4c",
                        "source_entry_id": "f58e9cc5-1f66-3c8a-bf81-25a7d5d655e1",
                        "source_sense_id": "37917633-8701-3a21-9d1b-dd0f42ef5624",
                        "source_sense_description": "van iets dat het niet te begrijpen is",
                        "target_lang_word": "incomprehensible",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "incomprehensible",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7fc3dea2-c809-3d6c-a897-70288fd3a5c9",
                                        "entry_id": "52ea041a-a7aa-341f-81a5-01ff3c1d406b",
                                        "glosses": [
                                            "Impossible or very difficult to understand."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2937a1d-1fd4-4f9c-a87a-31f40d7cfaf9",
                                                "sense_id": "7fc3dea2-c809-3d6c-a897-70288fd3a5c9",
                                                "text": "But this inference, which is supported by the opening of Book I, renders incomprehensible the note \"and I have finished writing this,\" which is included within the dream."
                                            },
                                            {
                                                "example_id": "f7c4fb4e-ca2a-4162-9ba7-1770e9ff88e1",
                                                "sense_id": "7fc3dea2-c809-3d6c-a897-70288fd3a5c9",
                                                "text": "In the empty immensity of earth, sky, and water, there she was, incomprehensible, firing into a continent."
                                            },
                                            {
                                                "example_id": "996672d0-b519-4456-998f-c9a0e5aea3bd",
                                                "sense_id": "7fc3dea2-c809-3d6c-a897-70288fd3a5c9",
                                                "text": "He shook his head. 'It's not only undefined, it's incomprehensible. Even the QL is befuddled by it and can't give me straight answers.'"
                                            },
                                            {
                                                "example_id": "7d9a9e3a-41d8-43d2-9a83-16002bd6aa84",
                                                "sense_id": "7fc3dea2-c809-3d6c-a897-70288fd3a5c9",
                                                "text": "Trump’s grotesque and incomprehensible fondness for Putin makes the details of any deal highly dangerous for Europe and the NATO alliance, founded to confront Russia."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "47ddc3c4-1914-3a90-a009-16541f4dfb3d",
                                        "entry_id": "52ea041a-a7aa-341f-81a5-01ff3c1d406b",
                                        "glosses": [
                                            "Which cannot be contained; boundless, infinite."
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6c1e8a1b-80de-41ff-ad05-240bcdd3d443",
                                                "sense_id": "47ddc3c4-1914-3a90-a009-16541f4dfb3d",
                                                "text": "Prayer to God the Father: It is fitting and right to sing to You, to bless You, to praise You, to give thanks to You, to worship You in every place of your dominion: for You are God, beyond description, beyond understanding, invisible, incomprehensible, always existing, always the same; You and your only-begotten Son and your Holy Spirit"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "incomprehensible",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "24a1cd17-d498-3694-aa83-856f1fa4e834",
                                        "entry_id": "7a770504-68b3-3514-891a-6085d0cc6d0f",
                                        "glosses": [
                                            "Anything that is beyond understanding."
                                        ],
