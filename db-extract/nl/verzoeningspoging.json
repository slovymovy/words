                            {
                                "example_id": "7ef33272-0c17-46bb-8a3a-a0e5feb37686",
                                "sense_id": "cb8baa62-2f13-33af-954c-e0a3c0d43d29",
                                "text": "Vronski reed naar de Franse schouwburg, waar hij inderdaad een afspraak met de regimentscommandant had, (die nooit een voorstelling in de Franse schouwburg oversloeg) om hem verslag uit te brengen van zijn verzoeningspogingen, die zijn aandacht nu al drie dagen lang bezighielden en hem in hoge mate vermaakten."
                            },
                            {
                                "example_id": "24a61158-0bff-450b-813f-a51229ec9b96",
                                "sense_id": "cb8baa62-2f13-33af-954c-e0a3c0d43d29",
                                "text": "Het Turkse bezoek aan Brussel wordt gezien als een verzoeningspoging. Hier ging een reeks uitspraken van hoge Turkse regeringsfunctionarissen aan vooraf."
                            }
                        ]
