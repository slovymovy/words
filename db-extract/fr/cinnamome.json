                        "examples": [
                            {
                                "example_id": "82bbbd68-3c68-4de1-9442-5699135daa9f",
                                "sense_id": "dc355a6b-e2eb-350d-8374-4915efa62af9",
                                "text": "[J]e roulais sous ton ciel pluvieux, mâchant une feuille de cinnamome!"
                            }
                        ]
                    },
                    {
                        "sense_id": "75719436-b0df-30ff-81bf-deac28339e2e",
                        "entry_id": "6d0c2f6c-dbb0-35f7-969f-6c9853aa0f0b",
                        "glosses": [
                            "Autre nom de la cannelle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f886c4b3-b031-42e4-82fe-b70caf01f012",
                                "sense_id": "75719436-b0df-30ff-81bf-deac28339e2e",
                                "text": "Quand il entra dans sa chambre, du cinnamome fumait sur une vasque de porphyre."
                            },
                            {
                                "example_id": "ab749ee1-8768-40af-b5e7-60a74479bf5d",
                                "sense_id": "75719436-b0df-30ff-81bf-deac28339e2e",
                                "text": "Du côté du Midi. la dernière des terres habitées est I’Arabie; c’est le seul pays du monde qui produise l’encens, la myrrhe, la cannelle, le cinnamome et le Iadanum."
                            },
                            {
                                "example_id": "d52e22f6-995b-48f9-8943-6b216ebda46a",
                                "sense_id": "75719436-b0df-30ff-81bf-deac28339e2e",
                                "text": "Du baume de Judée à la cinnamome, en passant par le castoreum tiré des testicules des castors, il me faut tout savoir sur le bout des doigts, comme si j’étais au service de l’épouse d’un grand notable."
                            }
                        ]
                    }
