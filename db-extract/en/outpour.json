                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8cbf5cc9-d576-4115-b0a6-2d0c2edf106e",
                                "sense_id": "626cb3ed-f220-3b37-b613-ee2173afccf3",
                                "text": "But the raven, sitting lonely on the placid bust, spoke only / That one word, as if his soul in that one word he did outpour. / Nothing farther then he uttered—not a feather then he fluttered— / Till I scarcely more than muttered, \"Other friends have flown before— / On the morrow he will leave me, as my hopes have flown before.\" / Quoth the raven, \"Nevermore.\""
                            }
                        ]
                    }
