                ],
                "senses": [
                    {
                        "sense_id": "ab6914e0-09f7-31ae-8bd1-3a899ecce5b5",
                        "entry_id": "d1d83fd7-d4cf-3707-87f6-d3896ee63cdf",
                        "glosses": [
                            "дёргая, продеть"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3945c952-a70f-473e-9e98-42bcfa6acd91",
                                "sense_id": "ab6914e0-09f7-31ae-8bd1-3a899ecce5b5",
                                "text": "Расчехлил у заднего борта пулемет, откинул свисающий брезентовый полог. Продернул пулеметную ленту — как по маслу шла."
                            }
                        ]
                    },
                    {
                        "sense_id": "fb0de39f-8662-3d89-8dda-d3c2951a2557",
                        "entry_id": "d1d83fd7-d4cf-3707-87f6-d3896ee63cdf",
                        "glosses": [
                            "разг., неодобр. подвергнуть критике, осмеять (в печати, публичном выступлении и т.п.)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c0e609d2-3364-4821-a8ac-486e0f721f9c",
                                "sense_id": "fb0de39f-8662-3d89-8dda-d3c2951a2557",
                                "text": "А читали вы, как прекрасно сегодня насчет нашей необеспеченности газетчик продернул?"
                            },
                            {
                                "example_id": "b142779d-b0d2-47f4-81b9-89741e3c8c15",
                                "sense_id": "fb0de39f-8662-3d89-8dda-d3c2951a2557",
                                "text": "Всех нас позорили в строю и на собраниях, продернули в стенгазетах, школьной и детдомовской."
                            }
                        ]
                    }
                ],
