                                    {
                                        "sense_id": "b28e50c4-6ca7-3ba8-a513-becbd04d6eab",
                                        "entry_id": "10f69c8b-7432-3bd4-9c85-6d9e8b4ce990",
                                        "glosses": [
                                            "A legal document, signed by both parties before marriage, stating the legal claims on each other's estate upon a subsequent divorce."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc394596-e603-4ef3-a8cb-8a036eadff22",
                                                "sense_id": "b28e50c4-6ca7-3ba8-a513-becbd04d6eab",
                                                "text": "Not so long ago, prenuptial agreements raised eyebrows. What hope was there for a marriage, the thinking went, if even before the wedding the couple were specifying who gets what in case of divorce?"
                                            },
                                            {
                                                "example_id": "c88b8c69-86cd-4fb3-af41-8cadeb8c5360",
                                                "sense_id": "b28e50c4-6ca7-3ba8-a513-becbd04d6eab",
                                                "text": "Last week, he said we should get married and that he wants a prenuptial agreement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f5f53c23-3af5-4eef-93b2-561d6e49a021",
                        "source_entry_id": "c42bc2e5-2ae3-3232-b286-fe420266fb80",
                        "source_sense_id": "5125161d-04ca-3d16-80be-4880c3b91629",
                        "source_sense_description": "notarieel contract waarin de vermogenspositie van beide huwelijkspartners wordt geregeld",
                        "target_lang_word": "contrat de mariage",
