                        "glosses": [
                            "höchster Priester in Eleusis (und anderswo)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e31a255-e431-4bf2-a122-2f11248417fc",
                                "sense_id": "2af7dd2c-dd22-348e-9a22-08ffa179caed",
                                "text": "„Auf diese Weise wurde ich der Hierophant der drei äußerst ehrenwerten Männer, die denkbar liebenswert, aber keineswegs weise waren, denn alle drei verloren sich in Dinge, die man Hirngespinste der Wissenschaft nennt; sie hielten das nach allen Gründen der Wahrscheinlichkeit Unmögliche für möglich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
