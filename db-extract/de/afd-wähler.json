                "senses": [
                    {
                        "sense_id": "4853af8f-b511-3bbf-85c8-ac647780d91a",
                        "entry_id": "71edbdae-fd24-39de-bc0a-81ffd2c6c9d3",
                        "glosses": [
                            "Person, die bei einer Wahl für die Alternative für Deutschland (AfD) gestimmt hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e72f8fb-0001-4b7a-8d75-90703a14d57d",
                                "sense_id": "4853af8f-b511-3bbf-85c8-ac647780d91a",
                                "text": "„War das eine ‚Protestwahl‘ am vergangenen Wochenende? Vielen sagen das so, Politiker und AfD-Wähler selbst.“"
                            },
                            {
                                "example_id": "16fd01f9-e267-4211-80f3-500bcc472d31",
                                "sense_id": "4853af8f-b511-3bbf-85c8-ac647780d91a",
                                "text": "„Die Migrationsthematik prägt in Bayern vor allem die Problemwahrnehmung von AfD-Wählern (71 Prozent), aber auch die von Anhängern der CSU (56 Prozent) sowie der Freien Wähler (46 Prozent).“"
                            },
                            {
                                "example_id": "d17650ed-6386-48a2-bd4f-7cc9f36049cd",
                                "sense_id": "4853af8f-b511-3bbf-85c8-ac647780d91a",
                                "text": "„Am Sonntag wählen Brandenburg und Sachsen. Die CDU kämpft um jeden AfD-Wähler, den sie zurückgewinnen kann.“"
                            },
                            {
                                "example_id": "896ca168-5691-4646-bf57-6543c621d772",
                                "sense_id": "4853af8f-b511-3bbf-85c8-ac647780d91a",
                                "text": "„Brandenburgs Ministerpräsident Woidke verspricht, die zukünftige Landesregierung werde alles dafür tun, die AfD-Wähler zurückgewinnen.“"
                            },
                            {
                                "example_id": "290e14bb-bafb-4482-ab3d-4f8029cbeaf5",
                                "sense_id": "4853af8f-b511-3bbf-85c8-ac647780d91a",
                                "text": "„Quent schätzt es als schwierig ein, AfD-Wähler ‚zurückzuholen‘, da die AfD in den vergangenen Jahren vor allem bei Nichtwählern punkten konnte.“"
                            },
                            {
                                "example_id": "fb6881e8-a637-4412-a702-bf55085e6ca9",
                                "sense_id": "4853af8f-b511-3bbf-85c8-ac647780d91a",
                                "text": "„»Bei den letzten Wahlen haben die Leute in manchen Dörfern schon mehrheitlich die NPD gewählt«, fügt der dritter Arbeiter hinzu. Ganz abgesehen von den vielen AfD-Wählern, denn ihr Anteil ist hier deutschlandweit am höchsten.“"
                            },
                            {
                                "example_id": "dabd6156-bd2f-494b-bfd5-f4a7c6ef3032",
                                "sense_id": "4853af8f-b511-3bbf-85c8-ac647780d91a",
                                "text": "„Auch wenn natürlich nicht jeder AfD-Wähler und auch nicht jeder Mandatsträger extrem rechts eingestellt ist, so tummelt sich in der Partei, die so viel Wert auf ihr bürgerliches Erscheinungsbild legt, doch allerhand unappetitliches Personal.“"
                            },
                            {
                                "example_id": "3b178f39-1281-46bc-a5c7-21209c48e73a",
                                "sense_id": "4853af8f-b511-3bbf-85c8-ac647780d91a",
                                "text": "„Linken-Politikerin Ulla Jelpke wirft Seehofer vor, Stimmung gegen syrische Flüchtlinge zu machen, um CDU und CSU ‚für AfD-Wähler attraktiv zu machen‘.“"
                            },
                            {
                                "example_id": "311f149f-147f-465b-85ef-f8a0dc9f80d6",
                                "sense_id": "4853af8f-b511-3bbf-85c8-ac647780d91a",
                                "text": "„Hinter dem grünen Ufer der Neiße gelegen entsprechen die Dörfer der Region nicht dem Bild eines vernachlässigten und vergessenen ländlichen Deutschlands, mit dem oft die Motive der AfD-Wähler erklärt werden. Große pastellfarbene Häuser, umgeben von riesigen Gärten und gepflegten Blumenbeeten, säumen die Straßen.“"
                            },
                            {
                                "example_id": "06f262c7-6840-4adb-bec6-2fe7cb435a64",
                                "sense_id": "4853af8f-b511-3bbf-85c8-ac647780d91a",
                                "text": "„Es gäbe eine einfache Möglichkeit das Schauspiel zu beenden. Einfach nicht AfD wählen. Davon aber ist in Umfragen bislang wenig zu spüren. So einfach machen es die Bürger den anderen Parteien nicht. Die müssen sich schon noch anstrengen, die stattliche Zahl der AfD-Wähler zurückzuerobern. Sich nur auszuruhen und sich an der Selbstzerfleischung der anderen zu erfreuen, wird nicht ausreichen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
