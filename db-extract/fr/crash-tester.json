                        "glosses": [
                            "Tester par un crash-test."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb0a8b4f-d190-4369-acde-ea008790694d",
                                "sense_id": "034d94a1-fc43-3243-ac67-51a7e4151746",
                                "text": "Pour l'occasion, nous avons envoyé sur place notre jeune reporter et skieur polyvalent, Dylan Florit, pour crash-tester les modules en compagnie des stars du halfpipe David Wise et Mike Riddle sous l'oeil de notre cameraman."
                            },
                            {
                                "example_id": "e7c5903f-15a8-4b47-a5dc-feee23dc044f",
                                "sense_id": "034d94a1-fc43-3243-ac67-51a7e4151746",
                                "text": "Éternel instatisfait, franc et challenger, il est le bras armé et la voix de l'équipe pour crash-tester les sujets de réflexion, en tirer le meilleur pour l’orienter vers l’avenir."
                            },
                            {
                                "example_id": "dd7ff716-f05b-495f-a13d-3a8ceb00001f",
                                "sense_id": "034d94a1-fc43-3243-ac67-51a7e4151746",
                                "text": "Trois Slim Design Elancyl à crash-tester."
                            }
                        ]
