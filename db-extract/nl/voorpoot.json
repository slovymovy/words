                ],
                "senses": [
                    {
                        "sense_id": "650236f7-756a-3413-b7db-91a4176e5754",
                        "entry_id": "477fb938-f391-3038-988a-2e214252198f",
                        "glosses": [
                            "een van de twee voorste ledematen van een dier"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "67599156-2db3-434a-829e-f7317d3ad96d",
                                "sense_id": "650236f7-756a-3413-b7db-91a4176e5754",
                                "text": "Maar inmiddels is Morris weer stukken beter in vorm: waar de nog altijd magere hond (hij wordt in kleine porties bijgevoerd, en is al een kilo aangekomen in een week tijd) eerst niet met zijn voorpoot over de drempel durfde, loopt hij nu voorop bij de wandelsessies van het asiel."
                            },
                            {
                                "example_id": "15d3f55f-29f6-4481-848d-a36814ac6e1b",
                                "sense_id": "650236f7-756a-3413-b7db-91a4176e5754",
                                "text": "De prijs heet Maestoso Superba en bestaat uit een beeldje van een hengst die een zogenoemde levade uitvoert, een oefening waarbij het paard met beide voorpoten van de grond komt."
                            },
                            {
                                "example_id": "098689e0-5c44-4ac5-b666-48cf3fb8fb22",
                                "sense_id": "650236f7-756a-3413-b7db-91a4176e5754",
                                "text": "In de jungle van Costa Rica hoor ik wat geritsel in de bosjes, en een klein knaagdier komt tevoorschijn. De agouti heeft een kop als een eekhoorn, lange achterpoten en veel kortere voorpoten."
                            }
                        ]
                    },
                    {
                        "sense_id": "9d3eb5e5-2798-376b-b742-56b9c4920a52",
                        "entry_id": "477fb938-f391-3038-988a-2e214252198f",
                        "glosses": [
                            "een van de twee voorste poten van een stoel"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a7e07f82-1c7f-4185-b11f-0b264dbfb21e",
                        "source_entry_id": "477fb938-f391-3038-988a-2e214252198f",
                        "source_sense_id": "650236f7-756a-3413-b7db-91a4176e5754",
