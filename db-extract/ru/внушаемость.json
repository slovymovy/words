                                        "sense_id": "5cf3e05f-0936-3ec1-9c19-5795021ddf98",
                                        "entry_id": "1908c069-c9a0-3f7f-9ff6-04f650cdf539",
                                        "glosses": [
                                            "The property of being suggestible."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "746cef59-3b9c-4801-9a49-ba93d99f8f59",
                                                "sense_id": "5cf3e05f-0936-3ec1-9c19-5795021ddf98",
                                                "text": "Using techniques of character invalidation (i.e. humiliation), shouting to induce feelings of guilt, fear and suggestibility."
                                            },
                                            {
                                                "example_id": "79460b12-8cd6-4379-bc2e-bbbbef45752a",
                                                "sense_id": "5cf3e05f-0936-3ec1-9c19-5795021ddf98",
                                                "text": "In Europe, through his clinical and forensic work, Gisli Gudjonsson noted that some individuals seemed to be more suggestible than others. This approach assumed that suggestibility is a trait and led to the development of a model of interrogative suggestibility (Gudjonsson & Clark, 1986)."
                                            }
                                        ]
                                    }
                                ]
                            }
