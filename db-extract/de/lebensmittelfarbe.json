                    },
                    {
                        "translation_id": "5b5429e6-17fb-4e8e-a4b2-f3b78cade383",
                        "source_entry_id": "73b989dd-cfd4-336d-86d4-74bb0e5e4dfe",
                        "source_sense_id": "98718b16-e627-395d-946e-a32f6d1fd14c",
                        "source_sense_description": "Zusatzstoff, der das Aussehen von Lebensmitteln hinsichtlich der Farbe verändert",
                        "target_lang_word": "food colouring",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "food colouring",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "29e1104f-29ce-35bf-b589-04ee5d10d965",
                                        "entry_id": "bb6da023-800a-324a-a514-feb847d7b516",
                                        "glosses": [
                                            "Any substance added to food in order to change its colour."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "763c3671-6aa9-46ef-8630-05c2f66e09e8",
                                                "sense_id": "29e1104f-29ce-35bf-b589-04ee5d10d965",
                                                "text": "Add a few drops of blue food colouring to the icing."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a0747a9e-278a-435e-ad56-b8bc372b23dc",
                        "source_entry_id": "73b989dd-cfd4-336d-86d4-74bb0e5e4dfe",
                        "source_sense_id": "98718b16-e627-395d-946e-a32f6d1fd14c",
                        "source_sense_description": "Zusatzstoff, der das Aussehen von Lebensmitteln hinsichtlich der Farbe verändert",
                        "target_lang_word": "colorant alimentaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "colorant alimentaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b00a4f09-4443-32df-97f7-c59ef8017da8",
                                        "entry_id": "8aa29251-20db-31df-bb6d-33f0dfe971dd",
                                        "glosses": [
                                            "Un additif alimentaire servant à ajouter de la couleur à une denrée alimentaire, ou à en rétablir la couleur originale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "78203a31-6e31-45bc-bbe2-d22ab996b3d8",
                                                "sense_id": "b00a4f09-4443-32df-97f7-c59ef8017da8",
                                                "text": "De plus, la spiruline est riche en phycocyanine, le seul pigment bleu naturel pouvant servir de colorant alimentaire et auquel on attribue une activité antioxydante importante."
                                            },
                                            {
                                                "example_id": "57d59609-6f09-4bf6-aee8-76b179951b5d",
                                                "sense_id": "b00a4f09-4443-32df-97f7-c59ef8017da8",
                                                "text": "Les principaux caroténoïdes sont le bêta-carotène donc, mais aussi le lycopène — dans la tomate, la pastèque, le pamplemousse — la lutéine — jaune d’œuf, maïs, épinards — ou encore l’astaxanthine — qui donne cette couleur rose aux flamants, aux crustacés et au saumon, molécule aussi utilisée comme colorant alimentaire sous le nom de E 161."
                                            },
                                            {
                                                "example_id": "95c0744b-1ebd-4b27-bc49-e715ec381d35",
                                                "sense_id": "b00a4f09-4443-32df-97f7-c59ef8017da8",
                                                "text": "Cuire des feuilles de menthe dans de l’eau avec du sucre fait un produit clair, qui n’a certainement pas la couleur verte que nous attendons ; cela conduit l’industrie des sirops à ajouter des colorants alimentaires, en l’occurrence soit des chlorophyllines, soit un mélange de divers colorants, par exemple le caramel (E150 b) et le bleu brillant (E133)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
