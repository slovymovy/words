                "senses": [
                    {
                        "sense_id": "fcab76ae-9796-3954-90c6-2106d871927b",
                        "entry_id": "ffb32795-24f4-3969-9c93-33feaae06513",
                        "glosses": [
                            "indigenes Volk im Osten Kanadas"
                        ],
                        "tags": [],
