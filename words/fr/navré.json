                {
                    "sense_id": "083d148f-bcdd-36b4-b832-2f3438268254",
                    "sense_definition": "Très désolé, sincèrement peiné par un contretemps, un refus ou une situation fâcheuse.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "regret",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je suis sincèrement <w>navré</w> de ne pas pouvoir venir à votre anniversaire demain."
                        },
                        {
                            "text": "Le directeur semblait vraiment <w>navré</w> d'annoncer l'annulation de la réunion."
                        }
                    ],
                    "synonyms": [
                        "désolé",
                        "peiné"
                    ],
                    "common_phrases": [
                        "être navré",
                        "avoir un air navré"
                    ]
                },
                {
                    "sense_id": "4ad230f9-dd9f-3314-a254-c0f59b044a23",
                    "sense_definition": "Qui ressent ou exprime une grande affliction, une douleur morale profonde.",
