                "senses": [
                    {
                        "sense_id": "f175d2b7-831d-3328-b7fb-ebdc8c4ac973",
                        "entry_id": "5f7bc206-4e23-309d-b974-d2cf5630e183",
                        "glosses": [
                            "ein Öl-Wasser-Gemisch, das in der Maschinenbilge von Schiffen aufgefangen und bei Binnenschiffen von Spezialschiffen abgepumpt wird."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d8b6a1d5-6987-4677-9252-d95328c96d85",
                                "sense_id": "f175d2b7-831d-3328-b7fb-ebdc8c4ac973",
                                "text": "„Auf dem Rhein und seinen Nebenwasserstraßen haben die Entölerboote der Bilgenentölungsgesellschaft im Jahre 1983 bei 11396 Lenzungen insgesamt 8020 t Bilgenöl aufgenommen.“"
                            },
                            {
                                "example_id": "19d64e36-d45a-47e1-8797-414e778c85e7",
                                "sense_id": "f175d2b7-831d-3328-b7fb-ebdc8c4ac973",
                                "text": "„Für die Schiffer ist die Entsorgung des Bilgenöls kostenfrei.“"
                            },
                            {
                                "example_id": "88ec555a-56e0-4e53-9859-9eb73a05edfb",
                                "sense_id": "f175d2b7-831d-3328-b7fb-ebdc8c4ac973",
                                "text": "Das Bilgenöl wird Raffinerien zur Wiederaufbereitung überlassen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
