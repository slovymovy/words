        "nl-extract.jsonl": [
            {
                "entry_id": "8ae0ecad-756d-392e-bf77-804b3763073f",
                "word": "kalligrafie",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "20cd3da5-c213-4d6d-a61a-414a5bd4ee62",
                        "entry_id": "8ae0ecad-756d-392e-bf77-804b3763073f",
                        "tags": [
                            "plural"
                        ],
                        "form": "kalligrafieën"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e21cfaeb-71a3-3fa1-91e4-0eca1087aa93",
                        "entry_id": "8ae0ecad-756d-392e-bf77-804b3763073f",
                        "glosses": [
                            "de kunst van het schoonschrift"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "48cefd0f-be15-40a1-b833-7579d4c90684",
                                "sense_id": "e21cfaeb-71a3-3fa1-91e4-0eca1087aa93",
                                "text": "De kunst van Japanse kalligrafie leer je het beste in Japan. Fotoredacteur Paula van Akkeren reisde voor ruim een maand naar Tokio. Aan de hand genomen door de tachtigjarige Saiso, dompelde ze zich onder in de kunst en de cultuur."
                            }
                        ]
                    },
                    {
                        "sense_id": "01f0fd79-6898-368b-ac1b-062ff8ef92dd",
                        "entry_id": "8ae0ecad-756d-392e-bf77-804b3763073f",
                        "glosses": [
                            "een kalligrafisch kunstwerk"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "16636aad-09b3-4be7-a221-eca29f1c5483",
                                "sense_id": "01f0fd79-6898-368b-ac1b-062ff8ef92dd",
                                "text": "Meest geslaagd is het onderdeel 'Schrift en Beeld', waarin de aandacht van Cobra-kunstenaars voor taal en teken centraal staat. De (her)ontdekking van de elegante 'peinture-mots' van Christian Dotremont alleen al; prachtig hoe zijn hand al schrijvend en tekenend een weg zoekt in een combinatie van kalligrafie en tekening."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "78b2081e-46f0-4907-a3fa-4645d154ede2",
                        "source_entry_id": "8ae0ecad-756d-392e-bf77-804b3763073f",
                        "source_sense_id": "e21cfaeb-71a3-3fa1-91e4-0eca1087aa93",
                        "source_sense_description": "(typografie) de kunst van het schoonschrift",
                        "target_lang_word": "Kalligraphie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kalligraphie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "22d793c0-c964-34ae-8e90-947ab836ecb3",
                                        "entry_id": "3d13856b-947c-3058-b713-6c20203d6ff5",
                                        "glosses": [
                                            "Schönschreibkunst"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3980e26c-4740-4613-a18d-15dde2942b34",
                                                "sense_id": "22d793c0-c964-34ae-8e90-947ab836ecb3",
                                                "text": "Er ist geübt im Umgang mit der Kalligraphie."
                                            },
                                            {
                                                "example_id": "64fb7d09-1f8c-4bfb-9ccf-450998940c68",
                                                "sense_id": "22d793c0-c964-34ae-8e90-947ab836ecb3",
                                                "text": "„Und ein letzter Punkt, der die Kunst des Schönschreibens, die Kalligraphie betrifft: Die Kurzzeichen haben einen geringeren ästhetischen Reiz.“"
                                            },
                                            {
                                                "example_id": "30b88955-b7d5-4eac-a339-6ae0e4a6cb02",
                                                "sense_id": "22d793c0-c964-34ae-8e90-947ab836ecb3",
                                                "text": "„Daneben aber lebte Künstlerisches in ihm, ein Herz für die Kalligraphie.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "63a556fc-8fc2-3480-982b-53dd2af67235",
                                        "entry_id": "3d13856b-947c-3058-b713-6c20203d6ff5",
                                        "glosses": [
                                            "ein Werk der Schönschreibkunst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "77d44676-ad51-4fa1-8cd0-28132bef29c1",
                                                "sense_id": "63a556fc-8fc2-3480-982b-53dd2af67235",
                                                "text": "„Kalligraphien haben ikonische, indexikalische und symbolische Eigenschaften.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "00dea6f0-f213-44cc-a8c1-11852e6726ec",
                        "source_entry_id": "8ae0ecad-756d-392e-bf77-804b3763073f",
                        "source_sense_id": "e21cfaeb-71a3-3fa1-91e4-0eca1087aa93",
                        "source_sense_description": "(typografie) de kunst van het schoonschrift",
                        "target_lang_word": "calligraphy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "calligraphy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "606983a9-ffa5-36a2-aba1-2f920b048609",
                                        "entry_id": "d0f69f11-2db0-317a-bc49-a6f38dd9a476",
                                        "glosses": [
                                            "The art or practice of writing letters and words in a decorative style; the letters and words so written."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "59693755-7177-4b40-a489-72ffabfa96e5",
                                                "sense_id": "606983a9-ffa5-36a2-aba1-2f920b048609",
                                                "text": "This paper will explore the role of calligraphy on three royal mosques built during the reign of the Mughal emperor Shah Jahan (1628-1658):[…]."
                                            },
                                            {
                                                "example_id": "54a177d9-9256-4e43-a451-1a289bbba2a0",
                                                "sense_id": "606983a9-ffa5-36a2-aba1-2f920b048609",
                                                "text": "There is, however, a temporal separation between the earthly crystallization of Quranic calligraphy and the advent of the Quranic revelation."
                                            },
                                            {
                                                "example_id": "03644984-f949-445a-9bf9-5aae0b86845f",
                                                "sense_id": "606983a9-ffa5-36a2-aba1-2f920b048609",
                                                "text": "Calligraphy, however, can seem like a live concert recording with a shallow, raw sound and awkward \"accidentals.\" But calligraphy has grown on me, and a distinction must be made between the calligraphy of high school diplomas and that of experts whose work is often breathtakingly beautiful."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "95ef0b6e-24c4-30ab-99dc-76da937ca6f7",
                                        "entry_id": "d0f69f11-2db0-317a-bc49-a6f38dd9a476",
                                        "glosses": [
                                            "Any such style of decorative writing."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "07fe7626-af07-4a88-bc77-edcbe62b514d",
                                                "sense_id": "95ef0b6e-24c4-30ab-99dc-76da937ca6f7",
                                                "text": "Around the corner, at Goedhuis, among more contemporary calligraphies, the fat and fuzzy brushwork of Zeng Yizeng (born 1973) stands out."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "764577f9-a7ae-36bc-b6ba-04f742eff441",
                                        "entry_id": "d0f69f11-2db0-317a-bc49-a6f38dd9a476",
                                        "glosses": [
                                            "A document written in decorative style."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a4ed9587-c260-418f-ae63-ae557a31467e",
                                                "sense_id": "764577f9-a7ae-36bc-b6ba-04f742eff441",
                                                "text": "2004, Diana J, Mukpo, Carolyn Rose Gimian (editors), Chogyam Trungpa, The Collected Works of Chogyam Trungpa, Volume 7, page 169,\nOnly a small number of Trungpa Rinpoche's calligraphies have been reproduced heretofore, some in very limited editions."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
