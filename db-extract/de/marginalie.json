                "senses": [
                    {
                        "sense_id": "3cf10012-f52a-37b3-96f6-8c368a608483",
                        "entry_id": "c8086ece-4ef7-371e-a1e7-b8556fc814ae",
                        "glosses": [
                            "Anmerkungen am Rand eines Buches oder einer Handschrift"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "326540c0-9ca3-44c3-abc1-2d5c3e903d8a",
                                "sense_id": "3cf10012-f52a-37b3-96f6-8c368a608483",
                                "text": "Marginalien befinden sich häufig auf dem äußeren und seltener auf dem inneren Rand eines Buches."
                            },
                            {
                                "example_id": "7bf6d118-02e0-45a1-bc23-ebae4348fef2",
                                "sense_id": "3cf10012-f52a-37b3-96f6-8c368a608483",
                                "text": "„Marginalien unbekannter Verfasser in den Büchern von öffentlichen Bibliotheken und Sammlungen oder auch in ausgeliehenen Schulbüchern gelten … als Kritzeleien und meist nur als Ärgernis und Sachbeschädigung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "f134401e-7c61-32d6-bedb-e58ebb988984",
                        "entry_id": "c8086ece-4ef7-371e-a1e7-b8556fc814ae",
