                                        "entry_id": "fa14b207-01c9-3dd8-bdac-11df5c5b39e8",
                                        "glosses": [
                                            "One who makes an apology.",
                                            "One who speaks or writes in defense of a faith, a cause, or an institution."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9a8f5dd3-2133-48ca-ad18-cdb6f83fde64",
                                                "sense_id": "7ff493ec-ca92-3163-91f6-36860e69ca22",
                                                "text": "[…] he will appear to many of the more speculatively minded intellectuals merely as a timid apologist of things as they are; at the same time he will be dismissed by the men of affairs as an impractical theorist."
                                            },
                                            {
                                                "example_id": "de809575-8314-462f-a6f3-2c32db8b3f52",
                                                "sense_id": "7ff493ec-ca92-3163-91f6-36860e69ca22",
                                                "text": "A genocide denier is an apologist for the next genocide. […] Mr. Handke is the Bob Dylan of genocide apologists."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7ab5698d-c82e-391e-9e17-59f7ae638768",
                                        "entry_id": "fa14b207-01c9-3dd8-bdac-11df5c5b39e8",
                                        "glosses": [
                                            "One who makes an apology.",
                                            "Synonym of apologizer."
                                        ],
                                        "tags": [
