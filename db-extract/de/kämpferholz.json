                "senses": [
                    {
                        "sense_id": "2ec17aa3-40ab-3d9a-b43b-ff74f6a6aeab",
                        "entry_id": "fe14db2f-dee6-3874-9f7a-005ed1a5d21c",
                        "glosses": [
                            "die waagerechte Verstrebung in einem Fensterrahmen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "792ba0c5-9af8-4ff7-a4ac-95d53b98517b",
                                "sense_id": "2ec17aa3-40ab-3d9a-b43b-ff74f6a6aeab",
                                "text": "Die in der Ostwand sichtbare im schlichten Kleeblattbogen abgeschlossene Tür, in die in Kämpferhöhe ein gerader Zwischensturz oder Kämpferholz eingezogen erscheint, wird ein Fenster der Sakristei gewesen sein."
                            },
                            {
                                "example_id": "8c826e41-d7ae-4e39-97e3-ea838b626d90",
                                "sense_id": "2ec17aa3-40ab-3d9a-b43b-ff74f6a6aeab",
                                "text": "Zum Abtragen der Glaslast und zur Aussteifung gegen den Winddruck wird zusätzlich zum Mittelpfosten in der Höhe nach jedem vierten Glasfeld ein Kämpferholz vorgesehen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "f5cf5362-9651-3f48-bd73-0d504714e3d3",
                        "entry_id": "fe14db2f-dee6-3874-9f7a-005ed1a5d21c",
                        "glosses": [
                            "das Querholz oberhalb von Türflügeln, an das sich ein Oberlicht anschließt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f61eb20-238b-4842-92e7-3e23b5295696",
                                "sense_id": "f5cf5362-9651-3f48-bd73-0d504714e3d3",
                                "text": "Soll die Tür Oberlicht erhalten, so ist ein etwa 12 cm hohes, 6–8 cm starkes Kämpferholz, das in einfacher Weise profiliert wird, anzuordnen."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
