                "senses": [
                    {
                        "sense_id": "1aa2a642-b8e5-3bda-b50d-fa66103714b6",
                        "entry_id": "4f098e90-3e49-3863-8da3-c42a0e37209a",
                        "glosses": [
                            "synchronisation, bringing into line"
