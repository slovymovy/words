                "senses": [
                    {
                        "sense_id": "2cdd8fab-92b9-3e53-911c-4a01a3ecea52",
                        "entry_id": "e87385cf-fa57-39c4-91f8-a1435304b03a",
                        "glosses": [
                            "Genre de crevettes translucides et à yeux pédonculés, de l’ordre des décapodes et de la famille des palémonidés, comprenant une quarantaine d’espèces comestibles appelées également crevettes roses, dont la crevette bouquet (genre Palaemon)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "626f60f2-5c73-4e34-9b3a-5a172c72cc85",
                                "sense_id": "2cdd8fab-92b9-3e53-911c-4a01a3ecea52",
                                "text": "Les palémons sont surnommés « crevettes roses » car elles perdent leur couleur gris translucide initiale pour prendre une teinte rose distinctive durant la cuisson."
                            },
                            {
                                "example_id": "a04cc931-b024-4cfe-a280-c84e7a12e8bc",
                                "sense_id": "2cdd8fab-92b9-3e53-911c-4a01a3ecea52",
                                "text": "L’homme distingue avec une telle évidence une proie dans le palémon que plusieurs dictionnaires donnent pour synonyme à la crevette de roche crevette rose."
                            }
                        ]
                    }
                ],
