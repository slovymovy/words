                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "дай кулак",
                                "target_lang_sense_clarification": "разговорное приглашение к приветствию"
                            }
                        ],
                        "de": [],
                        "es": [
                            {
                                "target_lang_word": "choca los puños",
                                "target_lang_sense_clarification": "invitación informal a saludar"
                            }
                        ],
                        "zh": [
                            {
