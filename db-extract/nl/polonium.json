                    {
                        "translation_id": "c56cf24d-6230-4505-90a0-592be862eeb1",
                        "source_entry_id": "f3430dfb-2a32-3f60-8830-39dfd5ee9018",
                        "source_sense_id": "926c33b6-24e7-3726-9c4d-c6efd0359dc2",
                        "source_sense_description": "Chemisch element",
