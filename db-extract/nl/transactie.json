                    {
                        "sense_id": "bdfc51f2-9db3-3e7a-925b-21b3c19cf5f8",
                        "entry_id": "acaa8006-a4ef-359e-a564-d1dad90e2251",
                        "glosses": [
                            "het betalen van een geldbedrag voor het verkrijgen van een product of dienst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bce6f1a1-c82d-43e1-ab62-f26cafbd4504",
                                "sense_id": "bdfc51f2-9db3-3e7a-925b-21b3c19cf5f8",
                                "text": "Opa Oscar was een echte ondernemer en hij had zijn vermogen systematisch opgebouwd van de olifantenjacht in Afrika en zijn transacties met mahoniehout toen hij jong was tot aan de innovaties op het gebied van techniek en bouw."
                            }
                        ]
                    },
                    {
                        "sense_id": "d8db5a8a-849f-37c7-ad4e-759c9de45f5e",
                        "entry_id": "acaa8006-a4ef-359e-a564-d1dad90e2251",
                        "glosses": [
                            "afdoening van een strafbaar feit van de lichte soort op voorstel van het Openbaar Ministerie, meestal via een door de verdachte te betalen geldsom"
                        ],
                        "tags": [
                            "strafrecht"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0668f1f1-db21-423e-ad44-69d1fa761e10",
                        "source_entry_id": "acaa8006-a4ef-359e-a564-d1dad90e2251",
                        "target_lang_word": "Transaktion",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Transaktion",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f896ddb6-8cc1-32c0-8d86-e3d428d85213",
                                        "entry_id": "d6d09cd8-d712-3c8a-9f03-4597ed3a9cef",
                                        "glosses": [
                                            "Folge von Operationen, die nur komplett oder gar nicht durchgeführt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e29db67-6c34-4b88-9ea8-93082ba5de9c",
                                                "sense_id": "f896ddb6-8cc1-32c0-8d86-e3d428d85213",
                                                "text": "Ist die Transaktion nicht erfolgreich, wird sie zurückgerollt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7d874eb8-1f92-3461-a5c2-33f170a9d701",
                                        "entry_id": "d6d09cd8-d712-3c8a-9f03-4597ed3a9cef",
                                        "glosses": [
                                            "gegenseitige Übertragung von Gütern und Dienstleistungen in erheblichem Ausmaß"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8890772a-6a19-4738-81eb-aa1c0f4e9c50",
                                                "sense_id": "7d874eb8-1f92-3461-a5c2-33f170a9d701",
                                                "text": "Das war nicht nur einfach ein Kauf, das war eine richtige Transaktion."
                                            },
                                            {
                                                "example_id": "ce822936-a0f5-414c-b8c9-2e8832d3ef3e",
                                                "sense_id": "7d874eb8-1f92-3461-a5c2-33f170a9d701",
                                                "text": "„Mit insgesamt 34 Mrd. US-Dollar Umfang war diese Transaktion [der Kauf von Red Hat durch IBM] die größte Übernahme im Software-Bereich, die es je gab, was zeigt, wie dominierend freie Software mittlerweile ist.“"
                                            },
                                            {
                                                "example_id": "0b6e2b6a-73f0-4e1e-a573-9904cd2c174b",
                                                "sense_id": "7d874eb8-1f92-3461-a5c2-33f170a9d701",
                                                "text": "„Aus diesen Transaktionen fällt indessen nur wenig für ihn selber ab, weil die geschiedene Marquise im Interesse ihrer Kinder alles Erdenkliche tut, um möglichst viel von den Verkaufserlösen, mit Berufung auf den vom Marquis anerkannten Scheidungsvertrag, für ihre Schatulle abzuzweigen.“"
                                            },
                                            {
                                                "example_id": "d62eca34-53cd-4ca6-a3c1-79e5a663227c",
                                                "sense_id": "7d874eb8-1f92-3461-a5c2-33f170a9d701",
                                                "text": "„Vor allem aber lag es an der Tatsache, dass Amalia in ihnen nicht ihre tiefsten Gedanken und Gefühle ausgebreitet hatte wie ein liebeskranker Teenager, sondern vor allem ihre und später unsere zahlreichen Transaktionen, An- und Verkäufe detailliert dokumentiert hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1d95faa1-0724-4ff8-ab5d-0395da2451fa",
