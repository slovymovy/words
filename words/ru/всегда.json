                                "nl": "Ik drink 's ochtends <w>altijd</w> hete koffie.",
                                "pl": "Rano <w>zawsze</w> piję gorącą kawę.",
                                "de": "Ich trinke morgens <w>immer</w> heißen Kaffee.",
                                "fr": "Je bois <w>toujours</w> un café chaud le matin.",
                                "it": "La mattina bevo <w>sempre</w> un caffè caldo.",
