                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d31798a4-5fc6-40c3-a6fa-ac758a1ad4af",
                        "source_entry_id": "fc3dd49b-cd9f-3c41-9db5-b45606368069",
                        "source_sense_id": "6909d872-52ca-3399-a40f-1fc28ee063f5",
