                "senses": [
                    {
                        "sense_id": "0018d7e7-17e6-354b-bb07-432735f4e8bd",
                        "entry_id": "8faa07d5-db65-394f-a8b5-dd9afc12ec79",
                        "glosses": [
                            "рабочий, специалист по обработке мрамора"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "96a13ebd-5130-4ba9-8b1c-22b65852eba6",
                                "sense_id": "0018d7e7-17e6-354b-bb07-432735f4e8bd",
                                "text": "Заехав потом к мраморщику, он заказал ему поставить над её могилою памятник, а теперь, сидя один в комнате, невольно вспоминал об этой доброй старушке, так горячо и так бескорыстно его любившей."
                            },
                            {
                                "example_id": "66d8bcb9-0b72-4b50-a837-c623e329b52d",
                                "sense_id": "0018d7e7-17e6-354b-bb07-432735f4e8bd",
                                "text": "Из Белоруссии двигались землекопы, из Ярославской губернии — каменщики, штукатуры и печники, из Костромской — плотники, столяры, из Галичского уезда — \"комнатные живописцы\" и маляры, Олонецкий край давал мраморщиков и гранильщиков."
                            }
                        ]
                    }
