                                        "entry_id": "1a98a3d0-0ea2-37b2-abde-e44607e2a1bf",
                                        "glosses": [
                                            "englischer Maschinenstürmer aus dem frühen 19. Jahrhundert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "147f1007-b15f-42c6-8cc6-d8926f77cfac",
                                                "sense_id": "6be5d2ab-468b-3e87-9d58-de9ea4d32377",
                                                "text": "„Dabei zerstörten die Ludditen zahlreiche Woll- und Baumwollspinnereien.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
