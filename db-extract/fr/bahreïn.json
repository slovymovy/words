                                        "examples": [
                                            {
                                                "example_id": "cd5cf965-ad40-474f-9682-f9808e8b045b",
                                                "sense_id": "85550b7c-d58c-30ae-a207-9b98e9b96554",
                                                "text": "Manama ist die Hauptstadt von Bahrain."
                                            },
                                            {
                                                "example_id": "a9ccac1c-400d-4809-a21a-b927fe28f78b",
                                                "sense_id": "85550b7c-d58c-30ae-a207-9b98e9b96554",
                                                "text": "„Gemäß der Verfassung von 1973, zuletzt geändert 2002, ist Bahrain eine konstitutionelle Monarchie.“"
                                            },
                                            {
                                                "example_id": "4950fc60-911d-4cbb-93c6-acfb4642c7bc",
                                                "sense_id": "85550b7c-d58c-30ae-a207-9b98e9b96554",
                                                "text": "Ich bin gespannt, wie sich das Bahrain der Zukunft entwickelt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d7ba50c7-df01-3588-b1af-d3d466e970a0",
