                        "glosses": [
                            "grundlegende Veränderung der Stimmung (der Gefühlslage und/oder Erwartung)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4af1903b-c611-4ef8-9be3-d32c3739d4d4",
                                "sense_id": "9ef58e73-1526-36ca-b8e7-746e068424dc",
                                "text": "„Die mit wenigen Ausnahmen allgemeine Wut über Italiens Kriegserklärung und eine Reihe von erfolgreichen Schlachten deutscher Truppen an der Ostfront sorgten im Frühsommer 1915 für einen Stimmungsumschwung:...“"
                            },
                            {
                                "example_id": "c2b1b2e7-919d-47c5-81ea-c7564e7f0f3d",
                                "sense_id": "9ef58e73-1526-36ca-b8e7-746e068424dc",
                                "text": "„Während die Vertriebenenverbände lange Zeit versuchten, dem Stimmungsumschwung zu trotzen, machte sich bei vielen Betroffenen relativ früh Resignation breit.“"
                            }
                        ],
