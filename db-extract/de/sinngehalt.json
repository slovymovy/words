                ],
                "senses": [
                    {
                        "sense_id": "b3f4a4e3-419e-339d-b121-c14965514885",
                        "entry_id": "dbd62855-4dab-398d-9404-5074a4924536",
                        "glosses": [
                            "Sinn, Bedeutung eines Ausdrucks, einer Information, Handlung oder Sache"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f2cfa0b2-ab59-4eb4-b781-369db7039665",
                                "sense_id": "b3f4a4e3-419e-339d-b121-c14965514885",
                                "text": "„Wie drückt sich der Sinngehalt der Eucharistie in ihrer konkreten Feiergestalt aus?“"
                            },
                            {
                                "example_id": "170d59c5-fa23-4a19-9308-5c89f3aad169",
                                "sense_id": "b3f4a4e3-419e-339d-b121-c14965514885",
                                "text": "„Es besteht nun die Möglichkeit, das Wort als Naturding zu entmächtigen, es gleichgültig zu machen gegenüber dem Sinngehalt, den es trägt.“"
                            },
                            {
                                "example_id": "e94c4b7e-94bb-415d-b171-9939acb5c304",
                                "sense_id": "b3f4a4e3-419e-339d-b121-c14965514885",
                                "text": "„Stellt aus meinem Worte ein Buch zusammen, entnehmt ihm den Sinngehalt, damit ihr einen wirklichen Begriff von der Reinheit meiner Lehre bekommt.“"
                            },
                            {
                                "example_id": "7366b0af-2555-499d-a63d-37cb479d5eac",
                                "sense_id": "b3f4a4e3-419e-339d-b121-c14965514885",
                                "text": "„Die Rechtsprechung ergründet also den Sinngehalt eines Gesetzes und stellt seine Anwendbarkeit im Einzelfall fest.“"
                            },
                            {
                                "example_id": "21def2d4-e67a-4fcd-8984-37bf54972fe5",
                                "sense_id": "b3f4a4e3-419e-339d-b121-c14965514885",
                                "text": "„Der dokumentarische Sinngehalt ist also in der Handlungspraxis verwurzelt.“"
                            },
                            {
                                "example_id": "49b3a1ed-2828-4159-82c5-2c253d389752",
                                "sense_id": "b3f4a4e3-419e-339d-b121-c14965514885",
                                "text": "„Dies ist ein Beispieltext ohne weiteren Sinngehalt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
