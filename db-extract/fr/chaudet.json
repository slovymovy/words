                                        "glosses": [
                                            "To serve as a caudle to; to refresh."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ed996645-485d-4d6a-a9ae-417bfefc8e46",
                                                "sense_id": "e266df22-7151-31e2-9a6a-dc419065a638",
                                                "text": "Will the cold brook, / Candied with ice, caudle thy morning taste, / To cure thy o'ernight's surfeit?"
