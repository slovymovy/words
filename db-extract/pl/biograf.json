                                        "examples": [
                                            {
                                                "example_id": "2381cb0c-7876-4029-9aa0-713d6197cf46",
                                                "sense_id": "fb4a497a-4ef5-373b-a6a8-ffcb5a9f020b",
                                                "text": "Der Biograf deckte in seinem Buch einige unbekannte Seiten des verstorbenen Stars auf."
                                            },
                                            {
                                                "example_id": "ad9880b6-895b-4c68-a86f-8ecb718fcbd2",
                                                "sense_id": "fb4a497a-4ef5-373b-a6a8-ffcb5a9f020b",
                                                "text": "„Melanchthons Intimfreund und erster Biograf Joachim Camerarius machte sich über die Sterndeuterei des Faust lustig.“"
                                            }
