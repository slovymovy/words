                "senses": [
                    {
                        "sense_id": "04b0a53a-fd70-3d14-8be7-beebe91e77d3",
                        "entry_id": "bc1a010b-b4c6-36d8-bef7-2e7e2c3e315c",
                        "glosses": [
                            "Présence de petites hernies muqueuses, de diverticules sur la paroi du tube digestif : côlon, intestin grêle, œsophage. Cela entraîne divers troubles en fonctions de la taille et de la position des diverticules."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6b9af4c3-01bb-4555-b30b-fa9fb8c84b4d",
                                "sense_id": "04b0a53a-fd70-3d14-8be7-beebe91e77d3",
                                "text": "La diverticulose non compliquée et la diverticulite qui correspond à une poussée inflammatoire siégeant au niveau d’un ou plusieurs diverticules nécessitent des attitudes nutritionnelles différentes."
                            },
                            {
                                "example_id": "41d3bd9c-97cf-4383-846d-b52a88dec065",
                                "sense_id": "04b0a53a-fd70-3d14-8be7-beebe91e77d3",
                                "text": "Sous le terme générique diverticulite, on regroupe toutes les évolutions compliquées d’une diverticulose."
                            }
                        ]
                    },
                    {
                        "sense_id": "a7e70aab-e98e-39ed-a12d-d2fd7a5eda02",
                        "entry_id": "bc1a010b-b4c6-36d8-bef7-2e7e2c3e315c",
                        "glosses": [
                            "Présence de diverticule dans la trompe de Fallope. On parle alors de diverticulose tubaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e8bfac53-0ead-4e7a-bdf3-e079d2dbf6e2",
                                "sense_id": "a7e70aab-e98e-39ed-a12d-d2fd7a5eda02",
                                "text": "La «diverticulose» tubaire , de par ses caractères strictement tubaires revêtements cylindriques ciliés , absence de chorion cytogène ) , correspond aux malformations bien connues."
                            }
                        ]
                    }
                ],
