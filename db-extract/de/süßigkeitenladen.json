                "senses": [
                    {
                        "sense_id": "637543f0-5ceb-3983-9314-a70543a5ecba",
                        "entry_id": "9f7232de-d45d-3d4d-8477-a1577bf9441a",
                        "glosses": [
                            "Laden, in dem Süßigkeiten verkauft werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1084cf3b-8089-488a-bba5-734d02aa2a9b",
                                "sense_id": "637543f0-5ceb-3983-9314-a70543a5ecba",
                                "text": "„Entschuldige, Baby, aber der Süßigkeitenladen war geschlossen.“"
                            },
                            {
                                "example_id": "9941fab8-3330-4570-830a-aa0bd98be67a",
                                "sense_id": "637543f0-5ceb-3983-9314-a70543a5ecba",
                                "text": "„Er besuchte mehrere Elektronikläden und spähte dabei jeweils von innen durch die Schaufenster hinaus auf die Straße. Und deckte sich dabei mit Verschiedenem ein; bei dem Überangebot an billigem Hightech-Zeug fühlte er sich fast wie ein Kind im Süßigkeitenladen, doch blieb er durchweg im Antiüberwachungsmodus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
