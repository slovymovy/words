{
    "word_family": [
        "deploy",
        "deployment",
        "employ",
        "employment"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "fad3cbe5-2730-393d-89c4-896aacfc3e0f",
                    "sense_definition": "A tactic, strategy, or scheme, especially one used to gain an advantage or deceive someone.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "strategy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The free T-shirt is really a clever <w>ploy</w> to get you inside to see their sales pitch.",
                            "target_lang_translations": {
                                "ru": "Бесплатная футболка — это на самом деле умная <w>уловка</w>, чтобы заманить вас внутрь и навязать товар."
                            }
                        },
                        {
                            "text": "She saw through his marketing <w>ploy</w> immediately and refused to buy the product.",
                            "target_lang_translations": {
                                "ru": "Она сразу раскусила его маркетинговую <w>уловку</w> и отказалась покупать товар."
                            }
                        }
                    ],
                    "synonyms": [
                        "ruse",
                        "stratagem",
                        "trick",
                        "scheme"
                    ],
                    "common_phrases": [
                        "clever ploy",
                        "marketing ploy",
                        "publicity ploy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тактика, стратегия или схема, особенно используемая для получения преимущества или обмана кого-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уловка",
                                "target_lang_sense_clarification": "хитрый прием для достижения цели"
                            },
                            {
                                "target_lang_word": "хитрость",
                                "target_lang_sense_clarification": "обманный маневр"
                            },
                            {
                                "target_lang_word": "трюк",
                                "target_lang_sense_clarification": "ловкий ход"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "43f19a2c-16b8-3860-b15b-136fbb980469",
                    "sense_definition": "Employment or occupation.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "occupation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He sought some honest <w>ploy</w> to keep himself busy during the long winter months.",
                            "target_lang_translations": {
                                "ru": "Он искал какое-нибудь честное <w>занятие</w>, чтобы занять себя долгими зимними месяцами."
                            }
                        },
                        {
                            "text": "After retirement, his main <w>ploy</w> became gardening and woodworking.",
                            "target_lang_translations": {
                                "ru": "После выхода на пенсию его главным <w>занятием</w> стали садоводство и работа по дереву."
                            }
                        }
                    ],
                    "synonyms": [
                        "employment",
                        "occupation",
                        "job"
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "Mainly Scottish or Northern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Занятие, работа или дело (в основном в шотландском или северноанглийском диалектах)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "занятие",
                                "target_lang_sense_clarification": "дело, работа"
                            },
                            {
                                "target_lang_word": "работа",
                                "target_lang_sense_clarification": "деятельность"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "89cb1d96-48d4-309d-863b-d11a9a1bfee5",
                    "sense_definition": "An amusement, escapade, sport, or frolic.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "amusement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children were planning a harmless <w>ploy</w> to surprise their teacher.",
                            "target_lang_translations": {
                                "ru": "Дети планировали безобидную <w>забаву</w>, чтобы удивить своего учителя."
                            }
                        },
                        {
                            "text": "They went out on a weekend <w>ploy</w> to explore the old ruins.",
                            "target_lang_translations": {
                                "ru": "В выходные они отправились на <w>прогулку</w>, чтобы исследовать старые руины."
                            }
                        }
                    ],
                    "synonyms": [
                        "frolic",
                        "escapade",
                        "caper"
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "Mainly Scottish"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Забава, шалость, развлечение или проделка (в основном в шотландском диалекте)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "забава",
                                "target_lang_sense_clarification": "развлечение"
                            },
                            {
                                "target_lang_word": "выходка",
                                "target_lang_sense_clarification": "шалость, проделка"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c454adb2-a769-3faa-abff-3f0ba843dc85",
                    "sense_definition": "To form a column from a line of troops on some designated subdivision.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "military_tactics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The commander ordered the regiment to <w>ploy</w> into a close column.",
                            "target_lang_translations": {
                                "ru": "Командир приказал полку <w>перестроиться</w> в сомкнутую колонну."
                            }
                        },
                        {
                            "text": "It is much easier to maneuver when troops <w>ploy</w> before marching through the narrow pass.",
                            "target_lang_translations": {
                                "ru": "Маневрировать гораздо проще, когда войска <w>перестраиваются в колонну</w> перед проходом через узкое ущелье."
                            }
                        }
                    ],
                    "antonyms": [
                        "deploy"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Mainly historical military usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Перестраивать войска из развернутого фронта в колонну (устаревший военный термин)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перестраивать в колонну",
                                "target_lang_sense_clarification": "о войсках"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}