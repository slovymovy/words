                ],
                "senses": [
                    {
                        "sense_id": "206272bf-ee3f-3e22-9d69-55a9b721e8db",
                        "entry_id": "15527759-57c9-38e8-bea6-d9256aadfa24",
                        "glosses": [
                            "Unterricht, der das Verfassen von Aufsätzen zum Gegenstand hat"
                        ],
                        "tags": [
                            "Schule"
                        ],
                        "examples": [
                            {
                                "example_id": "eabc9ac8-9f90-4ec0-a7fb-6202a9e6923b",
                                "sense_id": "206272bf-ee3f-3e22-9d69-55a9b721e8db",
                                "text": "„Ausgehend von der ›inventio‹, einem Teilgebiet der Poetik und Rhetorik, wurde hier Gottsched zu dem Begründer jenes Aufsatzunterrichts, der dann im 19. Jahrhundert große Bedeutung erlangen sollte, weil mit ihm der Deutschunterricht die Aufgabe einer allgemeinen Verstandesbildung und Denkschulung übernahm […].“"
                            },
                            {
                                "example_id": "79c67748-ce22-41ae-b0e9-1039b57e7c9e",
                                "sense_id": "206272bf-ee3f-3e22-9d69-55a9b721e8db",
                                "text": "„\"Aufsatzunterricht\" ist ein historischer Begriff, der den aktuellen Schreibunterricht nicht mehr trifft.“"
                            },
                            {
                                "example_id": "d9678c39-11f8-4faa-b932-db41c38a0a18",
                                "sense_id": "206272bf-ee3f-3e22-9d69-55a9b721e8db",
                                "text": "„Im prozessorientierten Aufsatzunterricht wurde den einzelnen Teilprozessen, wie der Übung, der Planungs- und Überarbeitungsaktivität ein größeres Eigengewicht zugesprochen.“"
                            },
                            {
                                "example_id": "d799bd9a-9eff-4252-bd7f-a65aa654fd86",
                                "sense_id": "206272bf-ee3f-3e22-9d69-55a9b721e8db",
                                "text": "„Dabei war der Aufsatzunterricht von schulischen Normen geprägt: Es galt, die wichtigsten schriftlichen Darstellungsformen als regelgerechtes Schreiben zu vermitteln.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
