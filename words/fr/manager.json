    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2e4183fd-a64a-3b02-b76c-a5c907ad8a0b",
                    "sense_definition": "Responsable chargé d'encadrer, d'animer et de coordonner une équipe au sein d'une organisation.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "direction_entreprise",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Chaque matin, le <w>manager</w> réunit son équipe pour distribuer les tâches prioritaires de la journée."
                        },
                        {
                            "text": "Elle a suivi une formation spécifique pour devenir un bon <w>manager</w> de proximité."
                        }
                    ],
                    "synonyms": [
                        "manageur",
                        "contremaître"
                    ],
                    "common_phrases": [
                        "manager de proximité",
                        "bon manager",
                        "nouveau manager"
                    ]
                },
                {
                    "sense_id": "c26ff166-aa80-377b-8e87-417b08b510e3",
                    "sense_definition": "Cadre dirigeant assurant la gestion administrative, financière et stratégique d'une entreprise ou d'un département.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "direction_entreprise",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les <w>managers</w> de la multinationale ont approuvé la nouvelle stratégie d'expansion à l'international."
                        },
                        {
                            "text": "Ce poste stratégique requiert un <w>manager</w> expérimenté capable de restructurer complètement le département commercial."
                        }
                    ],
                    "synonyms": [
                        "manageur",
                        "gérant",
                        "chef d'entreprise"
                    ],
                    "common_phrases": [
                        "top manager",
                        "manager général"
                    ]
                },
                {
                    "sense_id": "2fe17063-6350-37bf-a995-b1d54df09796",
                    "sense_definition": "Personne chargée de défendre les intérêts matériels et professionnels d'un sportif ou de diriger une équipe sportive.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "representation_carriere",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le <w>manager</w> du boxeur négocie actuellement les conditions financières du prochain combat pour le titre."
                        },
                        {
                            "text": "Avant le départ de l'étape, tous les coureurs cyclistes écoutent attentivement les consignes de leur <w>manager</w>."
                        }
                    ],
                    "synonyms": [
                        "manageur",
                        "agent",
                        "imprésario"
                    ],
                    "common_phrases": [
                        "manager sportif"
                    ]
                },
                {
                    "sense_id": "055a6395-1a61-3053-a0c4-30cbc9784345",
                    "sense_definition": "Personne qui prend en charge les affaires contractuelles, la promotion et la carrière d'un artiste ou d'un groupe musical.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "representation_carriere",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le <w>manager</w> du groupe a planifié une grande tournée européenne afin de promouvoir le dernier album."
                        },
                        {
                            "text": "Sans les précieux conseils de son <w>manager</w>, cette jeune chanteuse n'aurait jamais signé un tel contrat."
                        }
                    ],
                    "synonyms": [
                        "manageur",
                        "imprésario",
                        "agent"
                    ],
                    "common_phrases": [
                        "manager du groupe"
                    ]
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "82780297-6ebd-359f-87f6-85af81cc7b5a",
                    "sense_definition": "Encadrer et motiver des collaborateurs ou piloter la gestion et le déroulement d'un projet.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il apprend progressivement à <w>manager</w> une équipe pluridisciplinaire dans le cadre de sa nouvelle fonction."
                        },
                        {
                            "text": "Elle a su <w>manager</w> ce projet complexe avec succès malgré des délais particulièrement serrés."
                        }
                    ],
                    "common_phrases": [
                        "manager une équipe",
                        "manager un projet"
                    ]
                }
            ]
        }
    ]
