                ],
                "senses": [
                    {
                        "sense_id": "4777e25c-9f80-34f7-9757-f57b9ab2b92a",
                        "entry_id": "51db4245-f948-3cc1-97be-1c04cc2725da",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a41e799-d562-4d6b-aa0a-2d0a8661ae71",
                                "sense_id": "4777e25c-9f80-34f7-9757-f57b9ab2b92a",
                                "text": "Frau Kisele ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "10f9483b-434d-457c-a4ff-a57a28763589",
                                "sense_id": "4777e25c-9f80-34f7-9757-f57b9ab2b92a",
                                "text": "Herr Kisele wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "ede99f3b-e1eb-4108-b09d-b70f607c6445",
                                "sense_id": "4777e25c-9f80-34f7-9757-f57b9ab2b92a",
                                "text": "Die Kiseles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "ee0d30f1-ce61-4903-a239-760c2c9c8441",
                                "sense_id": "4777e25c-9f80-34f7-9757-f57b9ab2b92a",
                                "text": "Der Kisele trägt nie die Pullover, die die Kisele ihm strickt."
                            },
                            {
                                "example_id": "1e2ce3e3-af0e-40e9-91e9-db3095fc71fa",
                                "sense_id": "4777e25c-9f80-34f7-9757-f57b9ab2b92a",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Kisele kommt, geht der Herr Kisele.“"
                            },
                            {
                                "example_id": "8f927393-2ca0-442c-bd5d-2e063eeb74c2",
                                "sense_id": "4777e25c-9f80-34f7-9757-f57b9ab2b92a",
                                "text": "Kisele kommt und geht."
                            },
                            {
                                "example_id": "66796910-0b78-45f6-84af-28bbbcb8c4aa",
                                "sense_id": "4777e25c-9f80-34f7-9757-f57b9ab2b92a",
                                "text": "Kiseles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
