                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a9b54e9e-7cd1-4f2c-99fb-e62f87db9f55",
                                                "sense_id": "f10a47a3-b5b8-35bd-882e-9d513d6fe7b7",
                                                "text": "Some believings are believings with simple certainty; others are more or less uncertain; still others are believings with a reassured certainty, perhaps after a time during which they were uncertain."
                                            }
                                        ]
                                    }
                                ]
