{
    "word_family": [
        "afmelding",
        "aanmelden",
        "melden",
        "melding"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6fe3395b-e61e-3824-bbaa-e187348d92cd",
                    "sense_definition": "laten weten dat men niet aanwezig zal zijn of niet langer deelneemt",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "deelname",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Als je ziek bent, moet je je op tijd <w>afmelden</w> voor de les.",
                            "target_lang_translations": {
                                "en": "If you are ill, you must <w>give notice of your absence</w> for class in time."
                            }
                        },
                        {
                            "text": "Hij <w>meldde</w> zich <w>af</w> van de vergadering omdat hij een andere afspraak had.",
                            "target_lang_translations": {
                                "en": "He <w>excused himself</w> from the meeting because he had another appointment."
                            }
                        }
                    ],
                    "antonyms": [
                        "aanmelden"
                    ],
                    "common_phrases": [
                        "zich afmelden voor"
                    ],
                    "target_lang_definitions": {
                        "en": "to give notice of one's absence or to withdraw/cancel participation"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "call in sick",
                                "target_lang_sense_clarification": "to report absence due to illness"
                            },
                            {
                                "target_lang_word": "opt out",
                                "target_lang_sense_clarification": "to cancel attendance or participation"
                            },
                            {
                                "target_lang_word": "unregister",
                                "target_lang_sense_clarification": "to withdraw registration"
                            },
                            {
                                "target_lang_word": "cancel",
                                "target_lang_sense_clarification": "to give notice of not attending"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e295f52f-6a62-37b6-8d4d-208c2cbef29f",
                    "sense_definition": "een sessie op een computer of digitaal systeem beëindigen",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "computer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Vergeet niet om je <w>af</w> te <w>melden</w> als je een openbare computer gebruikt.",
                            "target_lang_translations": {
                                "en": "Don't forget to <w>log out</w> when using a public computer."
                            }
                        },
                        {
                            "text": "Toen hij klaar was met het programma, <w>meldde</w> hij zich direct <w>af</w>.",
                            "target_lang_translations": {
                                "en": "When he finished using the program, he <w>signed out</w> right away."
                            }
                        }
                    ],
                    "synonyms": [
                        "uitloggen"
                    ],
                    "antonyms": [
                        "aanmelden"
                    ],
                    "common_phrases": [
                        "zich afmelden van het systeem"
                    ],
                    "target_lang_definitions": {
                        "en": "to end a session on a computer or digital system"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "log out",
                                "target_lang_sense_clarification": "to exit a digital account or system"
                            },
                            {
                                "target_lang_word": "sign out",
                                "target_lang_sense_clarification": "to end a computer or online session"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b5e8db91-2f10-36e3-ae03-a0ca2198ed96",
                    "sense_definition": "doorgeven dat men vertrekt van een bepaalde locatie of uitchecken",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "vertrek",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Voordat je het terrein verlaat, moet je je bij de receptie <w>afmelden</w>.",
                            "target_lang_translations": {
                                "en": "Before leaving the premises, you must <w>sign out</w> at reception."
                            }
                        },
                        {
                            "text": "De werknemer <w>meldde</w> zich netjes <w>af</w> bij zijn leidinggevende aan het einde van de dag.",
                            "target_lang_translations": {
                                "en": "The employee politely <w>clocked out with</w> his supervisor at the end of the day."
                            }
                        }
                    ],
                    "antonyms": [
                        "aanmelden"
                    ],
                    "common_phrases": [
                        "zich afmelden bij de balie"
                    ],
                    "target_lang_definitions": {
                        "en": "to notify that one is leaving a specific location or to check out"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sign out",
                                "target_lang_sense_clarification": "to record one's departure from a building or desk"
                            },
                            {
                                "target_lang_word": "check out",
                                "target_lang_sense_clarification": "to register departure from a location"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}