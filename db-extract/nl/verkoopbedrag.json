                    {
                        "sense_id": "b179ab8a-a2f8-32c2-845d-bd293b20c13c",
                        "entry_id": "df09f2e1-31d8-3cc8-b276-c0b6da27dd30",
                        "glosses": [
                            "de hoeveelheid geld die men ontvangt als men iets verkoopt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45cc1982-8f14-4223-a116-18bc8f68f980",
                                "sense_id": "b179ab8a-a2f8-32c2-845d-bd293b20c13c",
                                "text": "Nadat ik mijn verhaal had gedaan, vertelde Tom dat hij heeft ontdekt dat de vijf procent van het verkoopbedrag van iedere vervalsing naar een Zwitserse GmbH ging waarvan Heinz Kramm nog steeds enig aandeelhouder is."
                            },
                            {
                                "example_id": "98ec08a5-de41-4520-912b-616bd016b41a",
                                "sense_id": "b179ab8a-a2f8-32c2-845d-bd293b20c13c",
                                "text": "De Fyra-treinen zouden gaan rijden op de hogesnelheidslijn tussen Amsterdam en Brussel, maar er ontstonden na de introductie grote problemen. De NS krijgt een deel van het verkoopbedrag."
                            },
                            {
                                "example_id": "a0f22b12-b909-4279-8031-2bd142c4b676",
                                "sense_id": "b179ab8a-a2f8-32c2-845d-bd293b20c13c",
                                "text": "De startup hoeft overigens niet te verwachten dat er een samenwerking in zit met bijvoorbeeld Marktplaats. De bekendste tweedehandsverkoopsite van het land heeft zijn eigen systeem: Gelijk Oversteken. De site vraagt een commissie van twee procent over het verkoopbedrag."
                            }
                        ]
                    }
