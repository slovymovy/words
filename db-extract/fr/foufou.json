                "senses": [
                    {
                        "sense_id": "f0512172-f8c4-33cd-92d7-f7cb76f91698",
                        "entry_id": "ea38a829-640d-39a0-bce2-5c5002fe4241",
                        "glosses": [
                            "Celui qui se comporte de façon espiègle, écervelé, tout fou (affectif)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b119d23c-c043-4f00-ac07-cf6f537fa0a2",
                                "sense_id": "f0512172-f8c4-33cd-92d7-f7cb76f91698",
                                "text": "Ce n'est pas parce que l'on est un petit gabarit qu'on n'est pas autorisé à faire le foufou en courant partout !"
                            },
                            {
                                "example_id": "cbf7c281-8c45-459d-9bd3-e34c06962231",
                                "sense_id": "f0512172-f8c4-33cd-92d7-f7cb76f91698",
                                "text": "Zouzouille de son petit surnom est très joueur et n'hésitera pas à faire le foufou en sautant partout."
                            },
                            {
                                "example_id": "417269a5-0c65-4905-8495-eafd1c971541",
                                "sense_id": "f0512172-f8c4-33cd-92d7-f7cb76f91698",
                                "text": "Frustré de ne pas voir sa fiancée, coincée sur l’île de Man située en mer d’Irlande) à cause du coronavirus, Dale McLaughlan, habitant d’Ayrshire (Écosse), a fait le foufou."
                            }
                        ]
                    }
                ],
