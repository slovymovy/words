    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "231c2f40-a980-3b90-abda-3e51026542a6",
                    "sense_definition": "Rassembler des personnes ou des choses en un même endroit.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "rassemblement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le directeur veut <w>réunir</w> toute son équipe pour discuter du nouveau projet."
                        },
                        {
                            "text": "Nous aimons <w>réunir</w> la famille chaque dimanche autour d'un grand repas."
                        }
                    ],
                    "synonyms": [
                        "rassembler"
                    ],
                    "common_phrases": [
                        "réunir la famille",
                        "réunir des documents",
                        "réunir des conditions"
                    ]
                },
                {
                    "sense_id": "cccaedeb-58ce-374e-832e-984417ec935e",
                    "sense_definition": "Unir ou relier plusieurs choses distinctes pour former un ensemble.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "jonction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce nouveau pont suspendu permet de <w>réunir</w> les deux rives du fleuve."
                        },
                        {
                            "text": "Les architectes ont décidé de <w>réunir</w> deux appartements pour créer un vaste espace."
                        }
                    ],
                    "synonyms": [
                        "unir"
                    ]
                },
                {
                    "sense_id": "7f7529ae-e73a-3f7a-bbbd-111d40624855",
                    "sense_definition": "Rapprocher des personnes brouillées et rétablir la bonne entente entre elles.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "reconciliation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce projet associatif a enfin réussi à <w>réunir</w> les deux voisins après des années de dispute."
                        },
                        {
                            "text": "Une épreuve difficile peut parfois <w>réunir</w> des collègues qui ne s'entendaient plus."
                        }
                    ],
                    "synonyms": [
                        "réconcilier"
                    ]
                },
                {
                    "sense_id": "7e887090-4159-30a0-9a57-c24888dc152d",
                    "sense_definition": "Rejoindre ou refermer des tissus ou des parties anatomiques séparées.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "medical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le chirurgien a dû poser plusieurs points de suture pour <w>réunir</w> les bords de la plaie."
                        },
                        {
                            "text": "Ce pansement aide à <w>réunir</w> les tissus cutanés afin de faciliter une guérison rapide."
                        }
                    ],
                    "common_phrases": [
                        "réunir les bords"
                    ]
                }
            ]
        }
    ]
