                                        "sense_id": "c3d5a6a3-3688-3439-b900-153fdfac7721",
                                        "entry_id": "6ff2aa2e-4700-30a4-9a5e-7bb4f3059a80",
                                        "glosses": [
                                            "Subject to sudden or frequent changes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ebf8853-76ba-418a-8e64-801d82d5f8cc",
                                                "sense_id": "c3d5a6a3-3688-3439-b900-153fdfac7721",
                                                "text": "The weather is very changeable today: we've had bright sunshine, clouds, wind and rain in the same half-hour."
                                            },
                                            {
                                                "example_id": "9f6316fd-c269-40eb-8c26-2b5c635e3dc1",
                                                "sense_id": "c3d5a6a3-3688-3439-b900-153fdfac7721",
                                                "text": "There will be no problems with visibility, or the highly changeable Highland weather, as Scotland basks in what is reported to be the country's hottest September day for more than a century."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "92690260-d139-3401-a56b-acdfb5f9a2a1",
                                        "entry_id": "6ff2aa2e-4700-30a4-9a5e-7bb4f3059a80",
                                        "glosses": [
                                            "Capable of camouflaging itself by changing colour."
