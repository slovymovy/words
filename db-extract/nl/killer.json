                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e775985d-5365-3caf-9919-84972c4d8492",
                                        "entry_id": "1f0488d3-f330-32f8-9f13-9bf40e8dcdd8",
                                        "glosses": [
                                            "Distressing, uncomfortable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9dce0f7b-108c-4de9-9b9d-bfda0ae18348",
                                                "sense_id": "e775985d-5365-3caf-9919-84972c4d8492",
                                                "text": "I had a killer headache this morning."
                                            }
