    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "36ffc1a3-9989-30bb-81cc-6f21d97e5bb2",
                    "sense_definition": "Having a shape like a rectangle; four-sided with four right angles.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We bought a long <w>rectangular</w> table for the dining room.",
                            "target_lang_translations": {
                                "ru": "Мы купили длинный <w>прямоугольный</w> стол для столовой.",
                                "zh": "我们为餐厅买了一张长长的<w>长方形</w>桌子。"
                            }
                        },
                        {
                            "text": "The computer monitor has a <w>rectangular</w> shape that fits perfectly on the desk.",
                            "target_lang_translations": {
                                "ru": "Монитор компьютера имеет <w>прямоугольную</w> форму, которая отлично подходит для письменного стола.",
                                "zh": "电脑显示器呈<w>长方形</w>，放在桌子上非常合适。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "rectangular shape",
                        "rectangular table",
                        "rectangular box"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий форму прямоугольника; четырехугольный с четырьмя прямыми углами.",
                        "zh": "具有长方形的形状；有四个直角的四边形。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прямоугольный",
                                "target_lang_sense_clarification": "о форме предмета"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "长方形的",
                                "target_lang_sense_clarification": "描述物体的形状"
                            },
                            {
                                "target_lang_word": "矩形的",
                                "target_lang_sense_clarification": "几何学上的正式描述"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c2b2d023-fe29-3eaf-8ff7-b76718ea13c2",
                    "sense_definition": "Intersecting at or formed by right angles; orthogonal.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The city uses a <w>rectangular</w> grid system for its streets.",
                            "target_lang_translations": {
                                "ru": "В городе используется <w>прямоугольная</w> система сетки улиц.",
                                "zh": "这座城市的街道采用了<w>直角</w>网格系统。"
                            }
                        },
                        {
                            "text": "We can plot these points on a standard <w>rectangular</w> coordinate system.",
                            "target_lang_translations": {
                                "ru": "Мы можем нанести эти точки на стандартную <w>прямоугольную</w> систему координат.",
                                "zh": "我们可以将这些点绘制在标准的<w>直角</w>坐标系上。"
                            }
                        }
                    ],
                    "synonyms": [
                        "orthogonal"
                    ],
                    "common_phrases": [
                        "rectangular coordinates",
                        "rectangular grid"
                    ],
                    "target_lang_definitions": {
                        "ru": "Пересекающийся под прямым углом или образованный прямыми углами; ортогональный.",
                        "zh": "以直角相交或由直角构成；正交的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прямоугольный",
                                "target_lang_sense_clarification": "о системе координат или сетке"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "直角的",
                                "target_lang_sense_clarification": "指相交的角度"
                            },
                            {
                                "target_lang_word": "正交的",
                                "target_lang_sense_clarification": "数学或技术语境下的术语"
                            }
                        ]
                    }
                }
            ]
        }
    ]
