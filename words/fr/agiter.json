{
    "word_family": [
        "agitation",
        "agitateur",
        "agitatrice"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "738cecb7-6e9b-36e2-aacb-00514f243a38",
                    "sense_definition": "Secouer ou remuer vivement un objet de manière répétée.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "mouvement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il faut bien <w>agiter</w> la bouteille de jus avant de la servir."
                        },
                        {
                            "text": "Les enfants sur le quai <w>agitent</w> la main pour saluer leurs grands-parents."
                        }
                    ],
                    "synonyms": [
                        "secouer",
                        "remuer"
                    ],
                    "common_phrases": [
                        "agiter la main",
                        "agiter un drapeau"
                    ]
                },
                {
                    "sense_id": "33d10875-3374-3a1a-86bc-8aa521405c60",
                    "sense_definition": "Bouger vivement ou s'animer sans cesse, souvent sous l'effet de l'impatience ou du stress.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "mouvement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les élèves fatigués s'<w>agitent</w> sur leurs chaises à la fin de la journée."
                        },
                        {
                            "text": "Le bébé s'<w>agitait</w> dans son berceau avant de finalement trouver le sommeil."
                        }
                    ],
                    "synonyms": [
                        "se remuer",
                        "bouger"
                    ],
                    "antonyms": [
                        "calmer"
                    ],
                    "common_phrases": [
                        "s'agiter sur place"
                    ]
                },
                {
                    "sense_id": "f6b4d0b7-4662-3e93-91e6-d84936fc5c4c",
                    "sense_definition": "Troubler l'esprit, susciter de l'inquiétude ou une vive émotion chez quelqu'un ou dans un groupe.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette sombre nouvelle <w>agite</w> tous les membres de notre petite communauté."
                        },
                        {
                            "text": "De vieilles angoisses <w>agitaient</w> ses nuits et l'empêchaient de dormir paisiblement."
                        }
                    ],
                    "synonyms": [
                        "troubler",
                        "inquiéter"
                    ],
                    "antonyms": [
                        "calmer"
                    ],
                    "common_phrases": [
                        "agiter les esprits"
                    ]
                },
                {
                    "sense_id": "68f32c59-541c-34a0-9fac-842f696a80f1",
                    "sense_definition": "Brandir ou évoquer avec insistance une idée pour faire pression ou effrayer.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "figure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le ministre <w>agite</w> la menace d'une nouvelle taxe sur les carburants."
                        },
                        {
                            "text": "Pour convaincre les électeurs hésitants, l'opposition <w>agite</w> le spectre de la récession."
                        }
                    ],
                    "synonyms": [
                        "brandir"
                    ],
                    "common_phrases": [
                        "agiter la menace",
                        "agiter le spectre"
                    ]
                },
                {
                    "sense_id": "70788909-ff00-33e3-b9af-0561986ced22",
                    "sense_definition": "Se démener de façon désordonnée ou excessive dans l'espoir d'obtenir un résultat.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il s'<w>agite</w> beaucoup dans les couloirs mais n'obtient aucun soutien concret."
                        },
                        {
                            "text": "Le candidat s'<w>agitait</w> en vain auprès des journalistes pour relancer sa campagne."
                        }
                    ],
                    "synonyms": [
                        "se démener"
                    ],
                    "antonyms": [
                        "calmer"
                    ],
                    "common_phrases": [
                        "s'agiter en vain"
                    ]
                },
                {
                    "sense_id": "818b394e-4b30-3b84-8e0e-7e99a847ab1d",
                    "sense_definition": "Discuter ou examiner sous tous ses aspects une question théorique ou juridique.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "discussion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les juristes continuent d'<w>agiter</w> la question sans parvenir à une décision unanime."
                        },
                        {
                            "text": "Pendant des siècles, les philosophes ont <w>agité</w> ce problème moral complexe."
                        }
                    ],
                    "synonyms": [
                        "débattre",
                        "discuter"
                    ],
                    "common_phrases": [
                        "agiter une question"
                    ]
                }
            ]
        }
    ]
}