                    },
                    {
                        "translation_id": "b2b4269d-884e-4684-a992-edc7193d1866",
                        "source_entry_id": "2038c98b-daa5-3ea3-bb70-68744c41ed5b",
                        "source_sense_id": "327f4ab6-bbfc-3c1e-b584-12d1e3fdfe5a",
                        "target_lang_word": "Hashtag",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hashtag",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2d31491f-eee8-36ad-aadd-558c5d357770",
                                        "entry_id": "8f5fdd04-cb5f-398a-930f-904d922777b5",
                                        "glosses": [
                                            "ein mit einem vorangestellten Rautezeichen gekennzeichnetes Schlüsselwort oder Schlagwort, das damit als potentieller Suchbegriff markiert wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ace77db0-2c60-4999-8fe4-d869f3687848",
                                                "sense_id": "2d31491f-eee8-36ad-aadd-558c5d357770",
                                                "text": "Hashtags können hierbei sowohl im Fließtext integriert sein als auch am Ende der Nachricht stehen."
                                            },
                                            {
                                                "example_id": "54ee5e34-f5ec-41de-8d2b-2fe013bce68d",
                                                "sense_id": "2d31491f-eee8-36ad-aadd-558c5d357770",
                                                "text": "Twitter ist die „Mutter der Hashtags“."
                                            },
                                            {
                                                "example_id": "ec864dea-bd29-4469-bf74-f0dbd3d92f67",
                                                "sense_id": "2d31491f-eee8-36ad-aadd-558c5d357770",
                                                "text": "Ihre Währung ist der Hashtag, das digitale Schlagwort, mit dem sie jeden Blogeintrag, Tweet und Instagram-Post versehen und so ein gigantisches digitales Archiv anlegen."
                                            },
                                            {
                                                "example_id": "39474cda-dd2c-4d4c-9f91-120fa8a78722",
                                                "sense_id": "2d31491f-eee8-36ad-aadd-558c5d357770",
                                                "text": "Nach dem Terroranschlag auf das Pariser Satiremagazin \"Charlie Hebdo\" hat sich der Slogan \"Je suis Charlie\" (Ich bin Charlie) als Zeichen der Solidarität in Windeseile weltweit verbreitet: Auf dem Kurznachrichtendienst Twitter wurde der Hashtag #JeSuisCharlie nach der Attacke vom Mittwoch bisher mehr als fünf Millionen Mal benutzt."
