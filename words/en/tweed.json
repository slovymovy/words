        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "105d74cb-d9ad-3895-849d-16615be43841",
                    "sense_definition": "A rough, durable woolen fabric, typically woven in mixed flecked colors and used especially for warm outerwear or suits.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fabric",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He bought a thick <w>tweed</w> jacket to stay warm during the cold autumn walks.",
                            "target_lang_translations": {
                                "zh": "他买了一件厚实的<w>粗花呢</w>夹克，以便在寒冷的秋日散步时保暖。"
                            }
                        },
                        {
                            "text": "The tailor recommended using Scottish <w>tweed</w> for the new winter coat.",
                            "target_lang_translations": {
                                "zh": "裁缝建议用苏格兰<w>粗花呢</w>来做这件新冬装大衣。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "tweed jacket",
                        "tweed suit"
                    ],
                    "target_lang_definitions": {
                        "zh": "粗花呢；一种粗糙、结实的毛料织物，通常带有混色斑纹，常用于制作保暖外套或西装"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "粗花呢",
                                "target_lang_sense_clarification": "毛织物名"
                            },
                            {
                                "target_lang_word": "花呢",
                                "target_lang_sense_clarification": "毛织物"
                            }
                        ]
                    }
                }
            ]
        },
        {
