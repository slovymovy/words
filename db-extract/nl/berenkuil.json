                            {
                                "example_id": "f6dea597-772d-4f8d-802c-589a4ff782b6",
                                "sense_id": "896998d7-7ecd-365a-a4ef-91f06b779cfc",
                                "text": "Nederlanders levend uit berenkuil: In het berenverblijf van een Duitse dierentuin zijn gisteren een Nederlandse man en zijn dochter van drie zwaargewond geraakt. Het meisje klom in de dierentuin van Lünebach, in de Eifel, over een ruim één meter hoog hek en viel daarna in het water tussen de bezoekers en het bereneiland."
                            },
                            {
                                "example_id": "83ae1c4b-8f60-4f7c-88ba-79238af5dda6",
                                "sense_id": "896998d7-7ecd-365a-a4ef-91f06b779cfc",
                                "text": "Maxi was bij de Berlijners zeer bekend, omdat hij met de beer Schnute in een berenkuil in het centrum van de stad leefde."
                            }
                        ]
