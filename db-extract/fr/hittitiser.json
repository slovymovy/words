                        "glosses": [
                            "Donner un caractère hittite à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "33205739-9518-4353-aa35-4bd583cf9771",
                                "sense_id": "c8a2f414-0410-3627-b2da-7278f203945f",
                                "text": "Il aurait donc décidé de lui-même « d’hittitiser » cette forme."
                            },
                            {
                                "example_id": "b57ae597-ac45-4f59-96f7-b6b1548c0a7c",
                                "sense_id": "c8a2f414-0410-3627-b2da-7278f203945f",
                                "text": "A l’appui de cette hypothèse, on rappelle le traité conclu entre un autre souverain hatti, le grand roi Muwatalli, et un certain Aleksandu de Wilhusa, qui ne serait autre qu’un prince troyen au nom « hittitisé », Alexandre d’Ilion."
                            }
                        ]
                    }
