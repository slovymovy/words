                "senses": [
                    {
                        "sense_id": "af3243c1-742f-34ac-a079-d75d8109c198",
                        "entry_id": "4b7702f3-8ef0-3fed-894c-8e4c9c26fea6",
                        "glosses": [
                            "Denkspiel, bei dem es auf das richtige Beantworten von Fragen ankommt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "baef35c3-fb43-4e0c-aa08-dc1d32f056a3",
                                "sense_id": "af3243c1-742f-34ac-a079-d75d8109c198",
                                "text": "„Der hatte dafür die guten Ideen – zum Beispiel, wie man die Vorliebe der Leser für Rätselspiele und Preisausschreiben nutzen konnte.“"
                            },
                            {
                                "example_id": "5e91a9ec-cfd9-4c01-bd69-41278c3fe45b",
                                "sense_id": "af3243c1-742f-34ac-a079-d75d8109c198",
                                "text": "„Das Resultat sind kunstvoll inszenierte Rätselspiele, die sich mal als roman noir erweisen, mal als finster-poetischer Fiebertraum.“"
                            },
                            {
                                "example_id": "0bd97aed-b5af-443c-9a92-ce4d04c68d75",
                                "sense_id": "af3243c1-742f-34ac-a079-d75d8109c198",
                                "text": "„Waren in früheren Zeiten die Rätselspiele weit verbreitet, so haben heute auf Spielfesten und in Unterhaltungssendungen Quizspiele Konjunktur.“"
                            },
                            {
                                "example_id": "09a04a35-1f9c-48d4-8e11-4540627b91ce",
                                "sense_id": "af3243c1-742f-34ac-a079-d75d8109c198",
                                "text": "„Das Rätsel- und Denkspiel Fiete Choice und das Rätselspiel Shift Happens bekamen jeweils 30000 Euro Preisgeld.“"
                            },
                            {
                                "example_id": "774dcc96-8352-4d05-97df-f409fcb67307",
                                "sense_id": "af3243c1-742f-34ac-a079-d75d8109c198",
                                "text": "„In Form von Briefen, Telegrammen und Tagebucheintragungen entfaltet der Autor ein buntes Kaleidoskop an Geschichten, Figuren und zwischenmenschlichen Konflikten, und zugleich ist das Buch ein faszinierendes literarisches Rätselspiel um einen ebenso leidenschaftlichen wie zwielichtigen Altertumsforscher und Glücksritter.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
