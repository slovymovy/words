            {
                "entry_id": "77c6f3e1-1f4f-3e61-837e-232e699849b4",
                "word": "Pénélope",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "73a6fa46-d763-3e13-ad4a-4810d9ebbe4e",
                        "entry_id": "77c6f3e1-1f4f-3e61-837e-232e699849b4",
                        "glosses": [
                            "Personnage de la mythologie grecque, épouse d’Ulysse dont elle a un fils, Télémaque."
                        ],
                        "tags": [
                            "Anthroponyme"
                        ],
                        "examples": [
                            {
                                "example_id": "37820db8-fe2d-42be-a3c6-28e9269738cd",
                                "sense_id": "73a6fa46-d763-3e13-ad4a-4810d9ebbe4e",
                                "text": "20 octobre 1940 – Il y a un Ulysse dans chaque homme et ils ne cessent de s’étonner quand on s’essaie à ne pas jouer les Pénélope."
                            },
                            {
                                "example_id": "80e6f9fc-adff-4b8d-b8f1-e78f4f97ae69",
                                "sense_id": "73a6fa46-d763-3e13-ad4a-4810d9ebbe4e",
                                "text": "C’est au chant I : parce que la sage Pénélope a demandé à l’aède de cesser de jouer, elle se fait rabrouer devant les prétendants par son fils, Télémaque, et ordonner sans ambages de retourner dans ses appartements."
                            }
                        ]
                    },
                    {
                        "sense_id": "221dc2eb-d970-32c4-835d-95b1bf1dd78a",
                        "entry_id": "77c6f3e1-1f4f-3e61-837e-232e699849b4",
                        "glosses": [
                            "Nymphe de la mythologie grecque, mère de Pan."
                        ],
                        "tags": [
                            "Divinité"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "c69e0e3f-7aa4-3e74-9b14-29ea2f22571b",
                        "entry_id": "77c6f3e1-1f4f-3e61-837e-232e699849b4",
                        "glosses": [
                            "(Par antonomase) Femme fidèle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3dbabf21-2dde-4086-972a-83bf3fb801bf",
                                "sense_id": "c69e0e3f-7aa4-3e74-9b14-29ea2f22571b",
                                "text": "C’est une Pénélope."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0f459d1f-8c9b-46c9-86e8-974fcabe8093",
                        "source_entry_id": "77c6f3e1-1f4f-3e61-837e-232e699849b4",
                        "target_lang_word": "Penelope",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
