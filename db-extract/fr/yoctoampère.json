                                        "sense_id": "1687f208-e69c-39fe-8337-4a8a10af4dd4",
                                        "entry_id": "b445017e-942c-3bc4-a979-9072183cef2a",
                                        "glosses": [
                                            "An SI unit of electrical current equal to 10⁻²⁴ amperes. Symbol: yA"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d85004aa-ef5d-4e9f-aeec-1b1f94287454",
                                                "sense_id": "1687f208-e69c-39fe-8337-4a8a10af4dd4",
                                                "text": "However, in the IGZO-FET, heavy holes strongly suppress tunneling current, and at most yoctoampere off-state current is estimated which is dominated by thermally excited holes."
                                            },
                                            {
                                                "example_id": "0435cc64-c1fd-496e-ba7e-d9e7c78760f0",
                                                "sense_id": "1687f208-e69c-39fe-8337-4a8a10af4dd4",
                                                "text": "First, they are known to show an off-state current on the order of yoctoampere per micron (10⁻²⁴ A/µm) at room temperature (RT)."
                                            },
                                            {
                                                "example_id": "04b4a38b-c30f-4983-8338-20115723e1ba",
                                                "sense_id": "1687f208-e69c-39fe-8337-4a8a10af4dd4",
                                                "text": "For example, the off-state current per micrometer of the channel width at 85° C. is less than or equal to 100 yA (1 yA (yoctoampere) is 1×10⁻²⁴ A)."
                                            }
                                        ]
                                    }
                                ]
                            }
