                                        "entry_id": "34267cc3-5817-35af-8fe1-cba701f493c2",
                                        "glosses": [
                                            "Gerät zum Verbrennen flüssiger oder gasförmiger Stoffe zur Erzeugung thermischer Energie, also Wärme"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc352a60-a6c0-4842-bfc7-103b7c7ea92c",
                                                "sense_id": "10eb9899-e8fd-3982-aee7-d8d497ac9d64",
                                                "text": "Über der Flamme des Brenners wird der Stoff vorsichtig erhitzt."
                                            },
                                            {
                                                "example_id": "f287e567-668f-46ef-89b7-d1cb12d67c26",
                                                "sense_id": "10eb9899-e8fd-3982-aee7-d8d497ac9d64",
                                                "text": "„Sie ging in die Küche und drehte den Brenner auf; dann kam sie wieder und tanzte, bis der Kaffee fertig war, zu einem schnellen Lied und zu zwei langsamen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5c2deadd-868b-32f2-af10-7fab72c6e335",
                                        "entry_id": "34267cc3-5817-35af-8fe1-cba701f493c2",
                                        "glosses": [
                                            "Person, die aus Agrarprodukten Alkohol herstellt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10d1f2bd-c99d-4b56-9c9c-c75ecbcb503f",
                                                "sense_id": "5c2deadd-868b-32f2-af10-7fab72c6e335",
                                                "text": "Aus den Kartoffeln stellt der Brenner Alkohol zur industriellen Nutzung her."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "2281d0b1-e5ed-3d5c-8453-0d3a1b41ec6f",
                                        "entry_id": "34267cc3-5817-35af-8fe1-cba701f493c2",
                                        "glosses": [
                                            "Gerät zur Verstärkung hochfrequenter Signale"
                                        ],
                                        "tags": [
                                            "Funktechnik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c2aea741-325e-446d-84d0-54b6104bbe29",
                                                "sense_id": "2281d0b1-e5ed-3d5c-8453-0d3a1b41ec6f",
                                                "text": "Statt das Signal mit einem Brenner zu verstärken sollte man besser eine gute Antenne benutzen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "aec93bc9-1380-3187-8044-8bf75d0ca960",
                                        "entry_id": "34267cc3-5817-35af-8fe1-cba701f493c2",
                                        "glosses": [
                                            "Gerät zum Beschreiben optischer Medien wie einer CD-RW oder DVD+R"
                                        ],
                                        "tags": [
                                            "Informationstechnik"
