                    {
                        "sense_id": "2f55decc-a6cc-3b8f-82b6-24d8f0808014",
                        "entry_id": "7944d815-5c7f-3eea-8a55-133a15e3c4dd",
                        "glosses": [
                            "public street urinal"
                        ],
