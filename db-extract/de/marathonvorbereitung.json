                ],
                "senses": [
                    {
                        "sense_id": "b9dc9e1a-0334-33bf-aaf0-f6bc5a8b6aa0",
                        "entry_id": "098fe59a-ce4c-39d0-9ae6-4899c0bc6a2d",
                        "glosses": [
                            "(systematische) Vorbereitung auf einen Marathonlauf; Trainingsphase eines Läufers vor einem Marathon, die darauf abzielt, die Leistungsfähigkeit für den Wettkampf aufzubauen"
                        ],
                        "tags": [
                            "Laufsport"
                        ],
                        "examples": [
                            {
                                "example_id": "d1df1932-5f27-49b9-83d9-b8b7b824fc95",
                                "sense_id": "b9dc9e1a-0334-33bf-aaf0-f6bc5a8b6aa0",
                                "text": "„Für einen 30km Lauf in der Marathonvorbereitung braucht Katrin zum Beispiel ungefähr 2 Stunden und 50 Minuten (bei einer Pace von 5:45 min./km).“"
                            },
                            {
                                "example_id": "08bbb320-e1da-401e-a9b1-773d267519ee",
                                "sense_id": "b9dc9e1a-0334-33bf-aaf0-f6bc5a8b6aa0",
                                "text": "„Das wird in den nächsten Wochen sicherlich an Umfang zunehmen, denn deutlich über 100 Wochenkilometer sind in Kathas Marathonvorbereitung keine Seltenheit.“"
                            },
                            {
                                "example_id": "88058fb5-be4f-4dd9-acdc-d26cf1a43337",
                                "sense_id": "b9dc9e1a-0334-33bf-aaf0-f6bc5a8b6aa0",
                                "text": "„Weil der Körper lernen kann, bei gleichem Tempo mehr Fette zu verbrennen, sind lange Dauerläufe für die Halbmarathon- und Marathonvorbereitung sehr wichtig.“"
                            },
                            {
                                "example_id": "3fbe4cba-29e3-4ad3-95eb-7ac9323bf022",
                                "sense_id": "b9dc9e1a-0334-33bf-aaf0-f6bc5a8b6aa0",
                                "text": "„In der Marathonvorbereitung ist eine positive Energiebilanz über den Tag und während der Trainingseinheiten enorm wichtig.“"
                            },
                            {
                                "example_id": "f147e3a5-211a-4afa-991f-b678203349f6",
                                "sense_id": "b9dc9e1a-0334-33bf-aaf0-f6bc5a8b6aa0",
                                "text": "„Für eine seriöse Halbmarathon- oder Marathonvorbereitung sind 6 bis 8 lange Läufe in den 12 Wochen vor dem Wettkampf einzuplanen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
