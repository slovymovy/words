                "senses": [
                    {
                        "sense_id": "58ef068d-a82c-3d06-8eea-2f89da66a2ce",
                        "entry_id": "d2493f48-1366-3395-8bc4-f318a80cf29d",
                        "glosses": [
                            "Celui, celle à qui on fait un legs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "28ea2fc9-4452-4f60-8ab2-627c7e05231d",
                                "sense_id": "58ef068d-a82c-3d06-8eea-2f89da66a2ce",
                                "text": "Bien entendu, pour qu’il y ait un legs en duo, il faut bien un legs au profit du légataire principal."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5a2e9bea-afd0-4360-83aa-9fd2c323a46a",
                        "source_entry_id": "d2493f48-1366-3395-8bc4-f318a80cf29d",
                        "source_sense_id": "58ef068d-a82c-3d06-8eea-2f89da66a2ce",
                        "target_lang_word": "Vermächtnisnehmer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "7fb189af-03a8-4c68-bfb5-867442c4336b",
                        "source_entry_id": "d2493f48-1366-3395-8bc4-f318a80cf29d",
                        "source_sense_id": "58ef068d-a82c-3d06-8eea-2f89da66a2ce",
                        "target_lang_word": "Erbe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Erbe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "59a95fea-dc17-38bc-9d36-168354846e88",
                                        "entry_id": "b8afc1b1-a5da-3557-8345-5ff73727eea2",
                                        "glosses": [
                                            "Besitz eines Verstorbenen, der an eine lebende Person übertragen werden kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "589e0921-b3db-4ebd-ab5a-faf1afa9db76",
                                                "sense_id": "59a95fea-dc17-38bc-9d36-168354846e88",
                                                "text": "Das Erbe muss nicht angetreten werden, es kann auch ausgeschlagen werden."
                                            },
                                            {
                                                "example_id": "cf41b615-e06b-4dc5-836c-fcdad6a7e966",
                                                "sense_id": "59a95fea-dc17-38bc-9d36-168354846e88",
                                                "text": "„Jamanda konnte auf ein erkleckliches Erbe hoffen, was ihren Nerven eine Stärke verlieh, die man selten antrifft.“"
                                            },
                                            {
                                                "example_id": "1e3c6a30-4e27-4981-9753-f7c20682df6d",
                                                "sense_id": "59a95fea-dc17-38bc-9d36-168354846e88",
                                                "text": "„Wenn Holmes' Nachforschungen erfolgreich waren, würde sie ein beachtliches Erbe antreten.“"
                                            },
                                            {
                                                "example_id": "b1a614dc-7cae-40d6-a733-cdea808adeb3",
                                                "sense_id": "59a95fea-dc17-38bc-9d36-168354846e88",
                                                "text": "„Wer sein bürgerliches Leben zu erheblichen Teilen auf Kapitaleinkünften oder einem zu erwartenden Erbe aufbaut, wird eine Vermögen- und eine vernünftige Erbschaftsteuer eher nicht so gut finden.“"
                                            },
                                            {
                                                "example_id": "e3042403-7283-4de9-970b-19d1273d6d8e",
                                                "sense_id": "59a95fea-dc17-38bc-9d36-168354846e88",
                                                "text": "„Joyce war seit Monaten in London und hatte im Standesamt von Kensington endlich Nora geheiratet, um das Erbe für seine Kinder zu sichern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4fae42b7-1e51-3fc2-bb7c-a50a2bbc6ecc",
                                        "entry_id": "b8afc1b1-a5da-3557-8345-5ff73727eea2",
                                        "glosses": [
                                            "Nachwirkungen einer Epoche"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53006ecb-3a91-4b7c-87c6-3489c4a99f9a",
                                                "sense_id": "4fae42b7-1e51-3fc2-bb7c-a50a2bbc6ecc",
                                                "text": "Das Erbe der Antike ist in Europa allgegenwärtig."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "d035c45e-e009-3c67-998b-02576e6880d2",
                                        "entry_id": "b8afc1b1-a5da-3557-8345-5ff73727eea2",
                                        "glosses": [
                                            "vom Abgelösten hinterlassene Situation, mit der sich ein Nachfolger befassen muss"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ff5cb979-6b50-48d0-9a68-d85df3bb731d",
                                                "sense_id": "d035c45e-e009-3c67-998b-02576e6880d2",
                                                "text": "Er tritt ein großes Erbe an."
                                            },
                                            {
                                                "example_id": "3e9c182f-73fd-4fd8-a345-709c11387266",
                                                "sense_id": "d035c45e-e009-3c67-998b-02576e6880d2",
                                                "text": "Nun muss der Arme sich auch noch mit dem Erbe seines Vorgängers herumschlagen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Erbe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "233b7e3f-b735-3bf4-8112-fd99d597bb4b",
                                        "entry_id": "85a1c239-5e17-3fae-bcc8-554cb1e3efcb",
                                        "glosses": [
                                            "Person, der die Güter von Verstorbenen zufallen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80a87c03-edde-4de4-9b1c-7e31101a9cb8",
                                                "sense_id": "233b7e3f-b735-3bf4-8112-fd99d597bb4b",
                                                "text": "Die Erben versammelten sich beim Rechtsanwalt zur Testamentseröffnung."
                                            },
                                            {
                                                "example_id": "0a3d4e2f-ddae-410b-b5c8-7004dff771c5",
                                                "sense_id": "233b7e3f-b735-3bf4-8112-fd99d597bb4b",
                                                "text": "„Erben hatte Tante Dagmar keine.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
