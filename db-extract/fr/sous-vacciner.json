                                "example_id": "56d12114-f49e-42ac-a310-954bb26fc174",
                                "sense_id": "5998db6a-e1e6-3709-bba8-1d57b2b0de61",
                                "text": "Cependant, de nombreux parents continuent à sous-vacciner leurs enfants par peur - un choix néfaste qui a conduit à des épidémies dans le passé."
                            },
                            {
                                "example_id": "ef889729-e73d-4fb6-9a8b-418ff26e72e9",
                                "sense_id": "5998db6a-e1e6-3709-bba8-1d57b2b0de61",
                                "text": "Sous-vacciner, c'est prendre le risque de voir réapparaître certaines épidémies."
                            },
                            {
                                "example_id": "695a6e32-c802-473a-bf41-6f5ee56ceb06",
                                "sense_id": "5998db6a-e1e6-3709-bba8-1d57b2b0de61",
                                "text": "Sommes-nous en train de sous-vacciner ou de sur-vacciner nos chats?"
                            }
                        ]
