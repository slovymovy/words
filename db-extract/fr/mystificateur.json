                                    {
                                        "sense_id": "92be0390-2d93-3192-85b4-b9a5f955488a",
                                        "entry_id": "4068ac93-7b71-3037-ac4f-6b3f1f486bb7",
                                        "glosses": [
                                            "Someone who instigates practical jokes; a prankster."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f84dc27d-7c87-41ea-9a67-66b1979d4b4c",
                                                "sense_id": "92be0390-2d93-3192-85b4-b9a5f955488a",
                                                "text": "Some of his allies miss the old Zelensky, the practical joker with the boyish smile. But they realize he needs to be different now, much harder and deaf to distractions, or else his country might not survive."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
