                "forms": [],
                "senses": [
                    {
                        "sense_id": "0a12ffc1-24a2-36c3-8248-39287e46934d",
                        "entry_id": "2f1024c7-36ee-33e1-bdeb-a4e4a5633721",
                        "glosses": [
                            "meervoud van het zelfstandig naamwoord spons"
                        ],
                        "tags": [
                            "form-of",
                            "plural"
                        ],
                        "examples": [
                            {
                                "example_id": "e77bdba9-ca3b-4abd-aecf-beb687ba1c93",
                                "sense_id": "0a12ffc1-24a2-36c3-8248-39287e46934d",
                                "text": "Er worden meer waterstations opgetuigd, meer ijsbaden neergezet en de medische assistentie wordt uitgebreid. Maar bijvoorbeeld het (her)gebruik van sponzen is lastig vanwege de coronamaatregelen, zegt Barlag."
                            }
                        ]
                    },
                    {
                        "sense_id": "5ca7c227-4a3f-3a46-963c-9712dbdc8650",
                        "entry_id": "2f1024c7-36ee-33e1-bdeb-a4e4a5633721",
                        "glosses": [
                            "een stam Porifera van sedentaire, primitieve meercellige dieren die zich vastzetten op de bodem van (meestal) zeeën en oceanen tot op 8,5 kilometer diepte"
                        ],
                        "tags": [
                            "meervoudsvorm als officiële benaming",
                            "dieren"
                        ],
                        "examples": [
                            {
                                "example_id": "0101b51b-a12f-4f98-a526-6621810c6fb6",
                                "sense_id": "5ca7c227-4a3f-3a46-963c-9712dbdc8650",
                                "text": "Sponzen vormen een stam van meercellige zeedieren met interne filtersystemen. Wereldwijd zijn er rond 8.500 soorten bekend. Via speciale poriën (de ostia) laten ze zeewater binnenstromen, filteren het voedsel eruit en voeren het overtollige water via diverse uitstroomopeningen (de zogeheten oscula) weer af."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "d5192183-83cd-3264-8fc3-7364a4b0a985",
                "word": "sponzen",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "707a5961-089e-3633-be99-1fba7cc08130",
                        "entry_id": "d5192183-83cd-3264-8fc3-7364a4b0a985",
                        "glosses": [
                            "opzuigen van water of vloeistof met een stuk kneedbaar, poreus materiaal"
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "95de4490-657c-4530-bab7-5114b31b9b8a",
                                "sense_id": "707a5961-089e-3633-be99-1fba7cc08130",
                                "text": "Dit jaar hebben we gelukkig geen banen hoeven te sponzen, want het was prachtig weer."
                            }
                        ]
                    },
                    {
                        "sense_id": "41954606-5905-3a5b-bcee-ae3b938cb37d",
                        "entry_id": "d5192183-83cd-3264-8fc3-7364a4b0a985",
                        "glosses": [
                            "voorzien van water, verf of schoonmaakmiddel door dat op te zuigen in een stuk kneedbaar, poreus materiaal en het op een oppervlak uit te knijpen"
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "dd450481-a9f0-442c-9f63-ccf1e3b5462e",
                                "sense_id": "41954606-5905-3a5b-bcee-ae3b938cb37d",
                                "text": "Geregeld komt Jan van Overbeek langs om de ramen van het clubhuis schoon te maken, te sponzen en te zemen."
                            }
                        ]
                    },
                    {
                        "sense_id": "e229e743-2d51-3940-b930-0b7c49feb2a9",
                        "entry_id": "d5192183-83cd-3264-8fc3-7364a4b0a985",
                        "glosses": [
                            "ongeremd opnemen van veel informatie"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "b2e509fc-6e9c-46a9-874c-0143a1ff0442",
                                "sense_id": "e229e743-2d51-3940-b930-0b7c49feb2a9",
                                "text": "De basisschool is zo’n leuke leeftijd. Het sponzen is dan maximaal. Alle informatie wordt opgezogen."
                            },
                            {
                                "example_id": "1495141e-ad2b-45f2-8dfb-ac2f1db8a743",
                                "sense_id": "e229e743-2d51-3940-b930-0b7c49feb2a9",
                                "text": "Haar jonge jaren in Turkije, en later in de Amerikaanse zone van Duitsland hebben haar leren ‘sponzen’: „Als je ergens de taal of de situatie niet begrijpt: oordeel niet, maar kijk. Neem de visuele informatie in je op. Onthoud de beelden.”"
                            }
                        ]
                    }
