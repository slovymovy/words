                    {
                        "translation_id": "a030b4c9-58dc-40c4-87d8-fe9e84d06363",
                        "source_entry_id": "50d879f4-3a49-3d83-a8f8-662827428edb",
                        "source_sense_id": "3219f98d-2770-3c71-8dfa-90877621c331",
                        "target_lang_word": "paniqueuse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "paniqueuse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0c2afa29-eaa3-3f97-9274-92f9a9e77eb8",
                                        "entry_id": "5dfef911-21d9-3d8d-8589-ddbc0344215d",
                                        "glosses": [
                                            "Personne qui panique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca30268a-ee55-4cac-b5c1-da9091bdaaf9",
                                                "sense_id": "0c2afa29-eaa3-3f97-9274-92f9a9e77eb8",
                                                "text": "Tu ne l’as pas voulu, c’est certain, mais tu as fait de ta petite fille une anxieuse, une paniqueuse, une fragile, une grande petite ; une fille qui essaye d’avancer en regardant le ciel, mais qui est attachée, chaîne au pied, à un devoir : celui d’écouter, de comprendre, de rassurer, de consoler, de surmonter, de masser, de prendre parti, de subir."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "643073e7-0e6a-4d29-a582-85f2eb423ff9",
                        "source_entry_id": "50d879f4-3a49-3d83-a8f8-662827428edb",
                        "source_sense_id": "3219f98d-2770-3c71-8dfa-90877621c331",
                        "target_lang_word": "paniquarde",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "paniquarde",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c10c0f48-0e5a-31f4-9f92-7cd1b56b1af4",
                                        "entry_id": "db8575e6-3cc2-3ed4-8bc1-9f7b0dde0761",
                                        "glosses": [
                                            "Celle qui est en proie à une peur panique ou qui se laisse facilement aller à une peur panique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "39a1ce86-c47d-48bb-a702-1835141fffaf",
                                                "sense_id": "c10c0f48-0e5a-31f4-9f92-7cd1b56b1af4",
                                                "text": "Celle-ci avait eu un réflexe de paniquarde et s’en était allée hurler à la mort, comme une chienne, à la fenêtre."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "paniquarde",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "73515111-8c02-3d4c-8687-8adc560a8806",
                                        "entry_id": "cf8f1361-8ddb-388a-87ff-49b604caeb47",
                                        "glosses": [
                                            "Féminin singulier de paniquard."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e4b2fdf3-a394-4821-910f-abd1d3f066e1",
                                                "sense_id": "73515111-8c02-3d4c-8687-8adc560a8806",
                                                "text": "Enfin l’on connaît le mythe des mouvements de libération dirigés par Moscou. Dans l’argumentation paniquarde du régime, cela signifie : « Si cela continue, les communistes risquent de profiter de ces troubles pour s’infiltrer dans ces régions. »"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
