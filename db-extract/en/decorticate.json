                "translations": [
                    {
                        "translation_id": "221685f7-4854-425d-956d-5fdd0ec10dfc",
                        "source_entry_id": "69fe8c56-419d-372b-94f1-1cbe0a808ca2",
                        "source_sense_description": "peel or remove the bark, husk or outer layer from something",
                        "target_lang_word": "décortiquer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "décortiquer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "803aeca2-a781-380a-804e-1b0e6de24854",
                                        "entry_id": "f9d479c5-9ea3-33bf-a71a-f7c6feddded0",
                                        "glosses": [
                                            "Dégarnir des aliments de leur écorce, de leur enveloppe ou de leur carapace."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cfefb484-88dc-42a9-8336-bb8aca516447",
                                                "sense_id": "803aeca2-a781-380a-804e-1b0e6de24854",
                                                "text": "En décortiquant des langoustines, la petite Française s’était envoyé dans l’œil un éclat de carapace."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "904bfdac-86d1-348b-9774-b7f8803a782a",
                                        "entry_id": "f9d479c5-9ea3-33bf-a71a-f7c6feddded0",
                                        "glosses": [
                                            "Analyser avec soin."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9a11a687-9021-4e72-ae3d-f4ef8cc78fe2",
                                                "sense_id": "904bfdac-86d1-348b-9774-b7f8803a782a",
                                                "text": "Il passait avec elle des heures au téléphone, lui parlant des pièces qu’elle interprétait, jugeant les auteurs, l’interrogeant sur les acteurs, décortiquant la mise en scène jusqu’au noyau."
                                            },
                                            {
                                                "example_id": "77b80a98-9211-4e3d-8969-a6ee79f879a5",
                                                "sense_id": "904bfdac-86d1-348b-9774-b7f8803a782a",
                                                "text": "Ce gendarme des autoroutes a décortiqué le plan de travaux présenté à la fin de 2016 par les concessionnaires."
                                            },
                                            {
                                                "example_id": "03f9399a-17c5-420c-9551-b0880674e3ed",
                                                "sense_id": "904bfdac-86d1-348b-9774-b7f8803a782a",
                                                "text": "Rancière s'en prendra en 1984 à la Leçon sur la leçon, titre de la « leçon inaugurale » de Pierre Bourdieu au Collège de France, en décortiquant de façon très caustique les paradoxes de la position de « donneur de leçon » du sociologue (ES 28)."
                                            },
                                            {
                                                "example_id": "6de50a79-4ba2-4a50-8ea0-b5d9d685e87f",
                                                "sense_id": "904bfdac-86d1-348b-9774-b7f8803a782a",
                                                "text": "Un jour, dans les cours de science politique, on enseignera et on décortiquera finement cet événement bien particulier, j’en suis sûre. Une leçon magistrale de diplomatie politiquement très incorrecte et d’une efficacité redoutable."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
