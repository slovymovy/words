                "senses": [
                    {
                        "sense_id": "8cfaeb86-063e-3e97-8e8e-7a9a367c13eb",
                        "entry_id": "f4f53dd8-1972-339f-bf7c-c7528032e950",
                        "glosses": [
                            "Extirper, chez le cheval, dans la cavité glossienne les ganglions lymphatiques dont l’induration constitue les glandes de la morve."
                        ],
                        "tags": [
                            "Hippologie"
                        ],
                        "examples": [
                            {
                                "example_id": "c1deecf3-39a1-4518-8638-c3f26833da48",
                                "sense_id": "8cfaeb86-063e-3e97-8e8e-7a9a367c13eb",
                                "text": "Déglander un cheval dans le cas de morve est aggraver le mal."
                            },
                            {
                                "example_id": "8d3aa1f3-9fc0-403c-8b39-2152decfc5f8",
                                "sense_id": "8cfaeb86-063e-3e97-8e8e-7a9a367c13eb",
                                "text": "J’ai aidé un ami vétérinaire à déglander un cheval et c’était… très instructif."
                            }
                        ]
                    },
                    {
                        "sense_id": "0e8f665d-4354-3cc6-990f-a7567ce32a23",
                        "entry_id": "f4f53dd8-1972-339f-bf7c-c7528032e950",
                        "glosses": [
                            "Définition manquante ou à compléter. (Ajouter)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2d27233b-81e4-4418-8108-bee9f59f13d1",
                                "sense_id": "0e8f665d-4354-3cc6-990f-a7567ce32a23",
                                "text": "J’ai eu envie de déglander et suis allé trouver la bonne."
                            },
                            {
                                "example_id": "eb2b31ac-91be-4612-9683-1f27cbd1ae18",
                                "sense_id": "0e8f665d-4354-3cc6-990f-a7567ce32a23",
                                "text": "Un bath chibroque chevalin qui vient de se déglander les tourments, mais conserve encore des volumes qui impressionneraient la femme d’un cornac."
                            }
                        ]
                    }
