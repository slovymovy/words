                    {
                        "sense_id": "60983f8e-3897-37f6-aad4-370438df6e61",
                        "entry_id": "e10cd121-8487-3d50-b80d-c04681e02116",
                        "glosses": [
                            "Spiralgalaxie im Sternbild Andromeda in 2,5 Millionen Lichtjahren Entfernung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a5810883-0e4c-4016-a83f-248aa1dbf03a",
                                "sense_id": "60983f8e-3897-37f6-aad4-370438df6e61",
                                "text": "„Selbst die kühnsten Visionen können derzeitig kein Transportsystem erahnen, da selbst das Licht schon 2,5 Mio. Jahre benötigt, um zur Andromeda-Galaxie zu gelangen.“"
                            },
                            {
                                "example_id": "d230bcd8-dac8-432b-88d7-72091badc94f",
                                "sense_id": "60983f8e-3897-37f6-aad4-370438df6e61",
                                "text": "„Die Andromeda-Galaxie gilt als das am weitesten von der Erde entfernte Objekt, das sich sogar mit bloßem Auge beobachten lässt, als verschwommener Lichtfleck. Sie ist etwa 2,5 Millionen Lichtjahre entfernt und sozusagen ein galaktischer Nachbar der Milchstraße.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
