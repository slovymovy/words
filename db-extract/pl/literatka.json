                                                "example_id": "7350d69c-01cb-438f-acbb-79b2340af658",
                                                "sense_id": "209ef159-c797-3e55-880f-e72275e00152",
                                                "text": "Has your girlfriend written you another letter already? She’s quite a writer!"
                                            },
