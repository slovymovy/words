                        "reconnaissance diplomatique"
                    ]
                },
                {
                    "sense_id": "58233323-bbba-3651-abd8-4dc9ead6eee2",
                    "sense_definition": "Acte légal ou formel constatant une dette, un dépôt ou établissant un lien de filiation.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a signé une <w>reconnaissance</w> de dette avant d'emprunter de l'argent à son associé."
                        },
                        {
                            "text": "La <w>reconnaissance</w> de paternité a été enregistrée à la mairie après la naissance."
