                                        "glosses": [
                                            "Of or relating to a wall; on, or in, or against a wall."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fc4cb97f-f0e6-4489-8ca0-9077a5974230",
                                                "sense_id": "67ef13cf-b601-3940-be3e-86275020b27b",
                                                "text": "a mural quadrant"
                                            },
                                            {
                                                "example_id": "7b1b7f2a-a8ef-4350-90b5-1e5ce56d849d",
                                                "sense_id": "67ef13cf-b601-3940-be3e-86275020b27b",
                                                "text": "Disburd’nd Heav’n rejoic’d, and soon repaird / Her mural breach, returning whence it rowld."
                                            },
                                            {
                                                "example_id": "64ecf755-f0b9-42a6-93de-3686c6ec6650",
                                                "sense_id": "67ef13cf-b601-3940-be3e-86275020b27b",
                                                "text": "[Y]et in the Nectarine and like delicate Mural-fruit, the later your Pruning, the better, [...]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5361c17f-8808-30cd-9ed0-ca889b7b36c5",
                                        "entry_id": "7ed1cfa6-6d08-3d68-ad0b-6ee1747a10ec",
                                        "glosses": [
                                            "Resembling a wall; perpendicular or steep."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c9a751f1-9ca5-43e2-a27f-eb953e3329a2",
                                                "sense_id": "5361c17f-8808-30cd-9ed0-ca889b7b36c5",
                                                "text": "a mural precipice"
                                            },
                                            {
                                                "example_id": "58244c9c-b85e-4bd3-8c13-9b991b4f77f8",
                                                "sense_id": "5361c17f-8808-30cd-9ed0-ca889b7b36c5",
                                                "text": "Soon the swift horses drew this fair god and goddess nigh the wooded hills, whose distant blue, now changed into a variously-shaded green, stood before them like old Babylonian walls, overgrown with verdure; while here and there, at regular intervals, the scattered peaks seemed mural towers; […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "mural",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "32b38595-293a-3ab9-b6a9-e30f93dd2016",
                                        "entry_id": "7abf5210-e3e7-3ff0-bafd-390a28e0cf14",
                                        "glosses": [
                                            "To create a mural."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "418b1afb-7327-45ca-b474-db66ec68d823",
                                                "sense_id": "32b38595-293a-3ab9-b6a9-e30f93dd2016",
                                                "text": "Today savvy operators and designers are stenciling, streaking, stippling, spattering, sponging, mirroring, muraling and marbleizing their way to wonderful walls."
                                            },
                                            {
                                                "example_id": "9dd6d8b2-f7a0-48f6-ab80-d9f206b31c7c",
                                                "sense_id": "32b38595-293a-3ab9-b6a9-e30f93dd2016",
                                                "text": "Its walls were devoutly muraled by artists from the John Reed Club, a Communist-controlled cultural organization."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
