                ],
                "senses": [
                    {
                        "sense_id": "aa0b2eea-cfd3-33eb-89d1-af9f5364aee7",
                        "entry_id": "26c579c9-d123-399a-91ce-6de9f3d6d965",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4155b93f-e540-466a-b27d-b49812fa6f95",
                                "sense_id": "aa0b2eea-cfd3-33eb-89d1-af9f5364aee7",
                                "text": "Frau Unru ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "a2bc8094-fa82-4b56-863a-4d1d393a46d1",
                                "sense_id": "aa0b2eea-cfd3-33eb-89d1-af9f5364aee7",
                                "text": "Herr Unru wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "42040e86-a847-40fa-b225-886c162638c4",
                                "sense_id": "aa0b2eea-cfd3-33eb-89d1-af9f5364aee7",
                                "text": "Die Unrus fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "89eda51c-3e8c-4ddf-9311-f9d25b87ccda",
                                "sense_id": "aa0b2eea-cfd3-33eb-89d1-af9f5364aee7",
                                "text": "Der Unru trägt nie die Schals, die die Unru ihm strickt."
                            },
                            {
                                "example_id": "68d6cd19-1768-464a-90ef-6d7bd4b14ba8",
                                "sense_id": "aa0b2eea-cfd3-33eb-89d1-af9f5364aee7",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Unru kommt, geht der Herr Unru.“"
                            },
                            {
                                "example_id": "13356a4d-d5da-4414-9560-72479c8d90f0",
                                "sense_id": "aa0b2eea-cfd3-33eb-89d1-af9f5364aee7",
                                "text": "Unru kommt und geht."
                            },
                            {
                                "example_id": "1d3a42c9-b10e-47e0-9c29-3acf74194970",
                                "sense_id": "aa0b2eea-cfd3-33eb-89d1-af9f5364aee7",
                                "text": "Unrus kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
