                                        "entry_id": "533a3922-30a2-3310-8146-3d9122b3f74e",
                                        "glosses": [
                                            "A 42.195-kilometre (26-mile-385-yard) road race."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "676a696f-19db-3c06-83f8-1e0586f2fb1e",
                                        "entry_id": "533a3922-30a2-3310-8146-3d9122b3f74e",
                                        "glosses": [
                                            "Any extended or sustained activity."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cb60ed40-3d19-4844-a6b6-e8dbb9931067",
                                                "sense_id": "676a696f-19db-3c06-83f8-1e0586f2fb1e",
                                                "text": "He had a cleaning marathon the night before his girlfriend came over."
                                            },
                                            {
                                                "example_id": "15fd9b67-537e-44e5-9216-41c4f3d83832",
                                                "sense_id": "676a696f-19db-3c06-83f8-1e0586f2fb1e",
                                                "text": "I learned from the marathon that to finish a race you simply keep running."
                                            },
                                            {
                                                "example_id": "9663165b-2138-40e1-bb87-bd67f6930535",
                                                "sense_id": "676a696f-19db-3c06-83f8-1e0586f2fb1e",
                                                "text": "After a marathon session that included more than 14 hours of mostly negative public comment, the council agreed 11 to 4 to fund the center, and then gaveled out just before 6 a.m."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "marathon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6673bc68-7cca-31dd-b267-5fd1cc1db2b8",
                                        "entry_id": "da7e445c-3096-3f60-b701-2f9ed2167213",
                                        "glosses": [
                                            "To run a marathon."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5320fb6a-a18f-478d-b88b-839261180ec0",
                                                "sense_id": "6673bc68-7cca-31dd-b267-5fd1cc1db2b8",
                                                "text": "In less than two years, they and their family and friends have skydived, marathoned, tray-baked and dinner-danced their way to £130,000 for Duchenne research through their help4harry campaign."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "82eedb6c-cf29-3dd8-82ab-e126498c0bc8",
                                        "entry_id": "da7e445c-3096-3f60-b701-2f9ed2167213",
                                        "glosses": [
                                            "To watch or read a large number of instalments of (a film, book, TV series, etc.) in one sitting."
                                        ],
                                        "tags": [
                                            "informal",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7d0b4593-eee6-4942-ad89-67329285ca66",
                                                "sense_id": "82eedb6c-cf29-3dd8-82ab-e126498c0bc8",
                                                "text": "We're going to marathon Star Trek next weekend."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
