                        "cross_references": [
                            {
                                "target_word": "vocatif",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3fec701a-24b5-3373-9708-e0882f334545",
                                        "entry_id": "91ea84fc-c784-3320-b8f3-5e87dc3f9790",
                                        "glosses": [
                                            "Dans les langues à déclinaisons, cas dont on se sert quand on adresse la parole à quelqu’un."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "411b7ddc-9d75-445b-8fca-52143e4e542b",
                                                "sense_id": "3fec701a-24b5-3373-9708-e0882f334545",
                                                "text": "Dans les phrases suivantes : « Ô mon Dieu ! » ; « Malheureux, que fais-tu ? » ; « Toi que j’implore », les termes mon Dieu, Malheureux et Toi doivent être mis au vocatif en grec et en latin."
                                            },
                                            {
                                                "example_id": "ac59b023-45ab-4010-b9de-0757b263ec94",
                                                "sense_id": "3fec701a-24b5-3373-9708-e0882f334545",
                                                "text": "Dans la célèbre phrase (en latin) de Jules César en train de mourir « Tu quoque, fili ! » (« toi aussi, mon fils ! »), fili est le vocatif de filius (« fils »)."
                                            },
                                            {
                                                "example_id": "eb0d1395-9730-4670-aad7-4aacb8996b5b",
                                                "sense_id": "3fec701a-24b5-3373-9708-e0882f334545",
                                                "text": "En russe, l’expression figée « Боже мой » (\"Bozhe moy\", \"Mon Dieu\") fait intervenir une ancienne forme du vocatif de « Бог » (\"bog\", \"dieu\")."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "daa36f28-f2b4-313f-8a51-468799113926",
                                        "entry_id": "91ea84fc-c784-3320-b8f3-5e87dc3f9790",
                                        "glosses": [
                                            "Fonction vocative ; fonction énonciative (ou fonction syntaxique) d’appel de l’allocutaire remplie généralement par un terme d’adresse."
                                        ],
