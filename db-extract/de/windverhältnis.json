                "senses": [
                    {
                        "sense_id": "cd851b31-8470-3289-9774-9299d9156009",
                        "entry_id": "11e7e2df-3083-3f46-bc5c-be7920161936",
                        "glosses": [
                            "Stärke/Richtung des Windes zur Beurteilung einer bestimmten klimatischen Situation"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d2a75d4f-099e-4e8b-be1b-0028181dcc98",
                                "sense_id": "cd851b31-8470-3289-9774-9299d9156009",
                                "text": "„Auch die Lage zum Meer, die Höhenlage, die Windverhältnisse und die damit verbundenen Niederschläge bestimmen das Klima mit.“"
                            },
                            {
                                "example_id": "3c56faca-21ae-4fff-8bcf-2f3ccd9c57c0",
                                "sense_id": "cd851b31-8470-3289-9774-9299d9156009",
                                "text": "„Ferner konnten gute Aussagen über das Windverhältnis am Standort getroffen werden.“"
                            },
                            {
                                "example_id": "9e3179b0-8674-44dc-b7ae-7981f6eef409",
                                "sense_id": "cd851b31-8470-3289-9774-9299d9156009",
                                "text": "„Neben der Gebäudedichtheit haben insbesondere die Lage des Gebäudes und das damit verbundene Windverhältnis einen wesentlichen Einfluss auf den Infiltrationsluftwechsel.“"
                            },
                            {
                                "example_id": "cb1d4e9b-c3b1-427a-aa66-9db6ea850a9a",
                                "sense_id": "cd851b31-8470-3289-9774-9299d9156009",
                                "text": "„In geringen Höhen ist die turbulente Durchmischung stärker, wenngleich sie auch in Höhen über 100 km nach dem dort beobachteten Windverhältnis immer noch merklich ist, […]“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
