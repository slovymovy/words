                                            },
                                            {
                                                "example_id": "e81afb77-12cc-4be0-a7d6-3d0b222d1bc4",
                                                "sense_id": "8ded6195-25f0-3a6c-9342-29ffea6ab70b",
                                                "text": "Dans la prononciation mandarine du chinois, on distingue, outre une intonation unie, deux intonations montantes et une intonation descendante."
