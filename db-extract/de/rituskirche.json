                "senses": [
                    {
                        "sense_id": "cef4f520-c4ec-34d3-a1d2-cacd9397621a",
                        "entry_id": "172ac2ba-a6bc-365c-96d9-82a42808fb22",
                        "glosses": [
                            "eine von 24 Teilkirchen der katholischen Kirche, die jeweils einen eigenen Rechtsstatus (und meist auch Ritus) haben; Teilkirche eigenen Rechts (lateinisch: ecclesia (ritualis) sui iuris)"
                        ],
                        "tags": [
                            "Katholizismus"
                        ],
                        "examples": [
                            {
                                "example_id": "e9ff9645-63f7-4ae1-affa-9ab27b8f4271",
                                "sense_id": "cef4f520-c4ec-34d3-a1d2-cacd9397621a",
                                "text": "Die größte und bedeutendste Rituskirche innerhalb der römisch-katholischen Kirche ist die lateinische Kirche, auch Westkirche genannt."
                            },
                            {
                                "example_id": "d2d8b176-7018-433a-975d-51544f72f286",
                                "sense_id": "cef4f520-c4ec-34d3-a1d2-cacd9397621a",
                                "text": "Mit der Errichtung der eritreisch-katholische Kirche als Rituskirche der römisch-katholischen Kirche in äthiopischer Ritustradition am 19. Januar 2015 durch Papst Franziskus gibt es nun 24 Rituskirchen in der katholischen Kirche."
                            }
                        ],
