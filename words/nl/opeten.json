            "pos": "verb",
            "senses": [
                {
                    "sense_id": "68a8fab8-4bc4-3175-9277-d8d971166c2d",
                    "sense_definition": "iets volledig consumeren door het te eten",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "consumptie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je moet je bord <w>opeten</w> voordat je een toetje krijgt.",
                            "target_lang_translations": {
                                "en": "You must <w>eat up</w> everything on your plate before you get dessert.",
                                "ru": "Ты должен <w>съесть</w> всё на тарелке, прежде чем получишь десерт."
                            }
                        },
                        {
                            "text": "De hongerige wolf wilde het kleine konijntje direct <w>opeten</w>.",
                            "target_lang_translations": {
                                "en": "The hungry wolf wanted to <w>devour</w> the little bunny immediately.",
                                "ru": "Голодный волк хотел тут же <w>сожрать</w> маленького зайчика."
                            }
                        }
                    ],
                    "synonyms": [
                        "verorberen",
                        "oppeuzelen"
                    ],
                    "common_phrases": [
                        "je bord opeten",
                        "alles opeten"
                    ],
                    "target_lang_definitions": {
                        "en": "to consume something completely by eating it",
                        "ru": "полностью съесть что-либо, не оставляя ничего"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "eat up",
                                "target_lang_sense_clarification": "to finish all of the food"
                            },
                            {
                                "target_lang_word": "finish",
                                "target_lang_sense_clarification": "to eat everything on a plate"
                            },
                            {
                                "target_lang_word": "devour",
                                "target_lang_sense_clarification": "to eat hungrily or quickly"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "съесть",
                                "target_lang_sense_clarification": "полностью употребить пищу"
                            },
                            {
                                "target_lang_word": "доесть",
                                "target_lang_sense_clarification": "закончить есть то, что на тарелке"
                            },
                            {
                                "target_lang_word": "сожрать",
                                "target_lang_sense_clarification": "съесть быстро или жадно (разговорное)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "626b37f4-6039-34d3-b9f6-8f961a7189c5",
                    "sense_definition": "iets volledig verbruiken of opmaken, vaak met betrekking tot geld of middelen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "verbruik",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De hoge reparatiekosten zullen al onze spaarcenten <w>opeten</w>.",
                            "target_lang_translations": {
                                "en": "The high repair costs will <w>eat into</w> all our savings.",
                                "ru": "Высокие расходы на ремонт <w>съедят</w> все наши сбережения."
                            }
                        },
                        {
                            "text": "Als we niet voorzichtig zijn, zal dit project het hele budget <w>opeten</w>.",
                            "target_lang_translations": {
                                "en": "If we are not careful, this project will <w>consume</w> the entire budget.",
                                "ru": "Если мы не будем осторожны, этот проект <w>поглотит</w> весь бюджет."
                            }
                        }
                    ],
                    "synonyms": [
                        "oppeuzelen",
                        "wegwerken"
                    ],
                    "common_phrases": [
                        "het budget opeten",
                        "spaargeld opeten"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "vaak figuurlijk gebruikt voor middelen"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to use up or exhaust something completely, often referring to money or resources",
                        "ru": "полностью израсходовать или исчерпать что-либо, часто о деньгах или ресурсах"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "eat into",
                                "target_lang_sense_clarification": "to use up a part of something valuable like savings"
                            },
                            {
                                "target_lang_word": "consume",
                                "target_lang_sense_clarification": "to use up resources or budget"
                            },
                            {
                                "target_lang_word": "gobble up",
                                "target_lang_sense_clarification": "to use up resources very quickly"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "съедать",
                                "target_lang_sense_clarification": "постепенно расходовать ресурсы или бюджет"
                            },
                            {
                                "target_lang_word": "поглощать",
                                "target_lang_sense_clarification": "тратить большое количество средств или времени"
                            },
                            {
                                "target_lang_word": "проедать",
                                "target_lang_sense_clarification": "тратить сбережения на текущие нужды"
                            }
                        ]
                    }
                }
            ]
        }
    ]
