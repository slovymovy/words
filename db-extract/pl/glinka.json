                            {
                                "target_word": "clay",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "90734fd2-fb11-3bda-83bc-cd56331dbd73",
                                        "entry_id": "28878445-3d59-3d79-9926-4391e1c8bb3d",
                                        "glosses": [
                                            "To add clay to, to spread clay onto."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3f78e9d3-6c1d-353b-9eae-9b42d9d8f26f",
                                        "entry_id": "28878445-3d59-3d79-9926-4391e1c8bb3d",
                                        "glosses": [
                                            "To purify using clay."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "af8bef3a-82dd-4e5f-93fa-2eb7b3ee8a51",
                                                "sense_id": "3f78e9d3-6c1d-353b-9eae-9b42d9d8f26f",
                                                "text": "1776, Adam Smith, An Inquiry into the Nature and Causes of the Wealth of Nations, Book IV, Chapter 7: Of Colonies, Part 2: Causes of Prosperity of New Colonies,\nThey amounted, therefore, to a prohibition, at first of claying or refining sugar for any foreign market, and at present of claying or refining it for the market, which takes off, perhaps, more than nine-tenths of the whole produce."
                                            },
                                            {
                                                "example_id": "f250b781-f02b-4da5-8ba4-cc64a3a16eb1",
                                                "sense_id": "3f78e9d3-6c1d-353b-9eae-9b42d9d8f26f",
                                                "text": "The Portuguese had mastered the technique of claying sugar, and other European nations tried to learn the secrets from them."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1ae0ccea-03b2-4e81-94a6-62648970b6a9",
                        "source_entry_id": "823b7f88-21d2-3d26-9336-dfbb1ef9ae14",
                        "source_sense_id": "22e90755-e06e-3edc-90a3-e8bf1574bb14",
                        "target_lang_word": "Ton",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ton",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e47e28e7-3d6b-3344-92b9-6cfa5f9660b6",
                                        "entry_id": "97ba1d60-695d-3dde-a025-f46ab0f7ebed",
                                        "glosses": [
                                            "feinkörniges Verwitterungsprodukt, Bodenart, Töpfermaterial, Baustoff/Werkstoff"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "84a18639-fff2-4c00-aa6b-334b79a5947e",
                                                "sense_id": "e47e28e7-3d6b-3344-92b9-6cfa5f9660b6",
                                                "text": "Der Boden hier besteht zum größten Teil aus Ton."
                                            },
                                            {
                                                "example_id": "c05dbd6c-f7e7-4825-a1c1-cd7ed70a4171",
                                                "sense_id": "e47e28e7-3d6b-3344-92b9-6cfa5f9660b6",
                                                "text": "„Die Auswahl reiner Tone verfeinert sich und höhere Brenntemperaturen bis zu 800 °C werden erreicht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Ton",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "697d344a-e4b2-39d8-bfee-c7d8eb8d38bd",
                                        "entry_id": "59e1c895-c546-3a8a-8bde-52f8a8fa3b46",
                                        "glosses": [
                                            "etwas, das man hören kann; Klang, Laut"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5977e015-ebe2-4be1-b44c-12629cf8af9b",
                                                "sense_id": "697d344a-e4b2-39d8-bfee-c7d8eb8d38bd",
                                                "text": "„Sie hörte einen Ton wie von zerreißendem Stoff, und ihre Gelenke wurden zusammengebunden. An dem eiskalten Luftzug spürte sie, daß die Tür geöffnet wurde, und in der nächsten Sekunde war sie im Garten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e26e8bae-20b8-36b3-9513-19230a8d5481",
                                        "entry_id": "59e1c895-c546-3a8a-8bde-52f8a8fa3b46",
                                        "glosses": [
                                            "Abstufung einer Farbe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4d4ec12-cf9e-401a-a854-e11abe9b1c8a",
                                                "sense_id": "e26e8bae-20b8-36b3-9513-19230a8d5481",
                                                "text": "Das Rot gefällt mir nicht, ich probiere einen anderen Ton aus."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "f8e26db8-5eac-3c39-b7c4-c60ffab106e8",
                                        "entry_id": "59e1c895-c546-3a8a-8bde-52f8a8fa3b46",
                                        "glosses": [
                                            "Art der sprachlichen Ausdrucksweise, Benehmen"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba305775-b240-4211-9fb2-5a23091185d8",
                                                "sense_id": "f8e26db8-5eac-3c39-b7c4-c60ffab106e8",
                                                "text": "Dein Ton ist ziemlich schroff, beruhige dich erstmal."
                                            },
                                            {
                                                "example_id": "d5501acf-b536-4037-a744-a9357dae273c",
                                                "sense_id": "f8e26db8-5eac-3c39-b7c4-c60ffab106e8",
                                                "text": "„Das Seltsame war, dass ich drei Monate später eine Postkarte von ihr bekam, aus einem Luxushotel in irgendeinem Land der Dritten Welt – Belize, Honduras oder so –, und die war in einem überaus freundlichen Ton gehalten.“"
                                            },
                                            {
                                                "example_id": "630a4921-bb0b-45a1-8428-98bb769e8cc4",
                                                "sense_id": "f8e26db8-5eac-3c39-b7c4-c60ffab106e8",
                                                "text": "„Es ist völlig sinnlos, herausfinden zu wollen, wer mit der Verrohung des Tons angefangen hat.“"
                                            },
                                            {
                                                "example_id": "f12b9fea-6e02-43b9-a4d2-8c3f6bc39fc1",
                                                "sense_id": "f8e26db8-5eac-3c39-b7c4-c60ffab106e8",
                                                "text": "„Auch der Reichspropagandaminister schwärmte in höchsten Tönen von den neuen Waffen.“"
                                            },
                                            {
                                                "example_id": "3ada5922-8f87-4fa7-8f5b-b5b3938eebee",
                                                "sense_id": "f8e26db8-5eac-3c39-b7c4-c60ffab106e8",
                                                "text": "„Sein Ton wird sanfter.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "e7db4af7-dad7-3997-abcf-e10d0bb45d70",
                                        "entry_id": "59e1c895-c546-3a8a-8bde-52f8a8fa3b46",
                                        "glosses": [
                                            "Tonhöhenverlauf bei Wörtern in Tonsprachen, zum Beispiel im Chinesischen, zur Unterscheidung von Wörtern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee5a1de4-b406-4a20-bb2c-3400528b9149",
                                                "sense_id": "e7db4af7-dad7-3997-abcf-e10d0bb45d70",
                                                "text": "In Tonsprachen werden die Töne zur Unterscheidung von Wörtern verwendet."
                                            },
                                            {
                                                "example_id": "6645c6d4-49cb-44df-a3b1-71306d6ddfba",
                                                "sense_id": "e7db4af7-dad7-3997-abcf-e10d0bb45d70",
                                                "text": "„Das Chinesische kennt vier solcher Töne, einen hohen Ton, einen steigenden Ton, einen tiefen (genauer: leicht fallend-steigenden) Ton und einen fallenden Ton.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "524baf97-199e-3279-8762-0c1eb4375163",
                                        "entry_id": "59e1c895-c546-3a8a-8bde-52f8a8fa3b46",
                                        "glosses": [
                                            "„Schwingung des Luftdrucks im hörbaren Frequenzbereich“ bei sprachlichen Äußerungen"
                                        ],
                                        "tags": [
                                            "Phonetik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b74bea9e-ea50-4a4f-a1fb-3468115a6bdb",
                                                "sense_id": "524baf97-199e-3279-8762-0c1eb4375163",
                                                "text": "Die Junktur „fällt (wie die Phänomene Ton, Intonation, Akzent und Quantität) in den Bereich der prosodischen Merkmale.“"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
