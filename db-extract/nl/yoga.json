            {
                "entry_id": "46f009a7-e655-32dc-93ba-cb6aacce9054",
                "word": "yoga",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "0c9f393b-cefd-3546-9523-29a6da35afb7",
                        "entry_id": "46f009a7-e655-32dc-93ba-cb6aacce9054",
                        "glosses": [
                            "het streven om door lichamelijke en geestelijke methoden van concentratie tot hogere bewustzijnstoestanden te geraken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d5820fd-eca7-4fab-8665-c4ca5efa78d5",
                                "sense_id": "0c9f393b-cefd-3546-9523-29a6da35afb7",
                                "text": "Ik ben een jaar naar India gegaan om me te verdiepen in yoga."
                            }
                        ]
                    },
                    {
                        "sense_id": "1c76e782-d7c5-320f-93f6-079b367ecd4d",
                        "entry_id": "46f009a7-e655-32dc-93ba-cb6aacce9054",
                        "glosses": [
                            "systeem van oefeningen om beheersing te verkrijgen over de geest en het lichaam, weliswaar afkomstig uit een bepaalde yogatraditie, de hathayoga, maar ook beoefend zonder geestelijk doel"
                        ],
                        "tags": [
                            "metonymisch"
                        ],
                        "examples": [
                            {
                                "example_id": "9a5dd3de-4cb3-4650-a588-d54b7bf8650f",
                                "sense_id": "1c76e782-d7c5-320f-93f6-079b367ecd4d",
                                "text": "Ik ben begonnen met yoga op de sportschool, want ik wil er mooi uitzien deze zomer."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b855175b-f65c-4cfb-aecd-69284c442d99",
                        "source_entry_id": "46f009a7-e655-32dc-93ba-cb6aacce9054",
                        "source_sense_id": "0c9f393b-cefd-3546-9523-29a6da35afb7",
                        "source_sense_description": "het streven om door lichamelijke en geestelijke methoden van concentratie...",
                        "target_lang_word": "Yoga",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Yoga",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "684f4094-be9f-3207-9cc0-60d49332c652",
                                        "entry_id": "1a0a6f21-8a5a-3d13-a8c7-2e75f029dcf4",
                                        "glosses": [
                                            "ein aus dem so genannten östlichen, dem indischen Kulturkreis stammendes philosophisches System mit geistigen und körperlichen Übungen zur Erlangung verschiedener mentaler und körperlichen Fähigkeiten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc7b72ee-5c99-4b7f-84b8-1a5a2db10268",
                                                "sense_id": "684f4094-be9f-3207-9cc0-60d49332c652",
                                                "text": "Mit Techniken des Yoga lassen sich Konzentration, Selbstdisziplin und positives Denken erreichen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "cae90532-b800-31f6-9b5a-f43f09e99dcf",
                                        "entry_id": "1a0a6f21-8a5a-3d13-a8c7-2e75f029dcf4",
                                        "glosses": [
                                            "eine an das so genannte westliche Denken angepasste gymnastische und meditative Sportart"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "709713d4-3367-4d6f-8d59-44bdb8133ea8",
                                                "sense_id": "cae90532-b800-31f6-9b5a-f43f09e99dcf",
                                                "text": "Meine Mutter geht jeden Mittwoch zum Yoga."
                                            },
                                            {
                                                "example_id": "17014b42-e4f7-4b10-8d45-4ef295b1e5aa",
                                                "sense_id": "cae90532-b800-31f6-9b5a-f43f09e99dcf",
                                                "text": "„Heute ist dieser selbsternannte Anhänger der Janosch-eigenen Art des Buddhismus, abgehärtet durch Yoga und von der spanischen Sonne gewärmt, ein glücklicher Mensch.“"
                                            },
                                            {
                                                "example_id": "e54f007c-3d85-49f4-add8-39e4a5dddd51",
                                                "sense_id": "cae90532-b800-31f6-9b5a-f43f09e99dcf",
                                                "text": "„Yoga ist etwas Spezielles."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ac5cfc1c-d644-42f3-a283-71f8fd24c3e7",
                        "source_entry_id": "46f009a7-e655-32dc-93ba-cb6aacce9054",
                        "source_sense_id": "0c9f393b-cefd-3546-9523-29a6da35afb7",
                        "source_sense_description": "het streven om door lichamelijke en geestelijke methoden van concentratie...",
                        "target_lang_word": "yoga",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "yoga",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1e476caf-80b5-3bc0-8fe3-0eaca078b992",
                                        "entry_id": "bd255194-2a1c-3b46-852d-da8018fd4c7f",
                                        "glosses": [
                                            "Any of several Hindu or Buddhist disciplines aimed at training the consciousness for a state of perfect spiritual insight and tranquillity; especially a system of exercises practiced to promote control of the body and mind."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a56c2cf2-b2b2-4b0d-976f-2a07a9890812",
                                                "sense_id": "1e476caf-80b5-3bc0-8fe3-0eaca078b992",
                                                "text": "Whether you need to recover from a stressful day, a strenuous workout or even an injury or surgery, restorative yoga may be just the thing for you."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "yoga",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b458c239-4767-3853-8da7-6f1cb7e7ecf2",
                                        "entry_id": "61c16260-4fb4-332f-be97-fca2f8bf1741",
                                        "glosses": [
                                            "The tree Elaeocarpus joga."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f58f68bb-37d7-4b4f-bc97-96d92066d966",
                                                "sense_id": "b458c239-4767-3853-8da7-6f1cb7e7ecf2",
                                                "text": "A mealybug, Pseudococcus nr. microadonidum Beardsley (Homoptera: Pseudococcidae) has been found feeding on the foliage of E. joga. This mealybug was sometimes found in the domatia of yoga leaves. It has been recorded on coconut, banana, and pandanus from Kiribati, Pohnpei, and Marshall Islands. This insect is a new record on yoga and for Guam."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "30a300e7-6d7c-4048-a264-40a64132777f",
                        "source_entry_id": "46f009a7-e655-32dc-93ba-cb6aacce9054",
                        "source_sense_id": "0c9f393b-cefd-3546-9523-29a6da35afb7",
                        "source_sense_description": "het streven om door lichamelijke en geestelijke methoden van concentratie...",
