                    }
                ],
                "senses": [
                    {
                        "sense_id": "ff4ab6bc-2b1f-3495-a59d-65e961061b8b",
                        "entry_id": "ef9dce66-1b6e-3e51-8cf0-596fcb998185",
                        "glosses": [
                            "A Jacobian matrix or its associated operator."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c47a9c7-9a80-440c-995d-9607f83a9d11",
                                "sense_id": "ff4ab6bc-2b1f-3495-a59d-65e961061b8b",
                                "text": "As a demonstration, we first establish the correctness of the Jacobian matrices for kinetic models of hydrogen, methane, ethylene, and isopentanol oxidation, then demonstrate the performance achievable on CPUs and GPUs using pyJac via matrix evaluation timing comparisons.."
                            }
                        ]
                    },
                    {
                        "sense_id": "3e1dab84-8079-3d58-91bc-2be1f783e53f",
                        "entry_id": "ef9dce66-1b6e-3e51-8cf0-596fcb998185",
                        "glosses": [
                            "The determinant of such a matrix."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f735fb0-b08e-4ee4-a24f-e15c55533b89",
                                "sense_id": "3e1dab84-8079-3d58-91bc-2be1f783e53f",
                                "text": "In terms of per-bit security, elliptic curves and Jacobians of genus 2 curves appear to be roughly equivalent. However, when it comes to efficient and side-channel-aware implementations, we see a curious divergence."
                            }
                        ]
                    }
