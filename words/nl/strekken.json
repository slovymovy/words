                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De metselaar plaatste de <w>strekken</w> zorgvuldig in de horizontale laag van de muur.",
                            "target_lang_translations": {
                                "en": "The bricklayer carefully placed the <w>stretchers</w> in the horizontal course of the wall.",
                                "ru": "Каменщик аккуратно укладывал <w>ложки</w> в горизонтальный ряд стены."
                            }
