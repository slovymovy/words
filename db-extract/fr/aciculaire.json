                                "target_senses": [
                                    {
                                        "sense_id": "77e5cf70-dec4-3145-bc38-b440c97c0f4a",
                                        "entry_id": "0e05fda4-04d2-3c77-81e1-efa5f827f803",
                                        "glosses": [
                                            "Needle-shaped; slender like a needle or bristle."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d439df58-3666-42eb-8c82-9aac62c50358",
                                                "sense_id": "77e5cf70-dec4-3145-bc38-b440c97c0f4a",
                                                "text": "Near-synonyms: needlelike, pinlike"
                                            },
                                            {
                                                "example_id": "f2b6bb75-42ca-4710-9ee6-f1f26edf0d95",
                                                "sense_id": "77e5cf70-dec4-3145-bc38-b440c97c0f4a",
                                                "text": "1992, Oliver Sacks, Migraine, Berkeley: University of California Press, revised and expanded edition, Part 5, Chapter 17, p. 279,\nSometimes these networks have an acicular or crystalline appearance, and may grow visibly, sometimes with sudden jerks, “like frost on a windowpane,” or “primitive plants.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "164cffe1-5666-3ad5-ac7e-938381a82f29",
                                        "entry_id": "0e05fda4-04d2-3c77-81e1-efa5f827f803",
                                        "glosses": [
                                            "Having sharp points like needles."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7bdd9d9d-544e-31d9-bb5e-7236ee19772d",
                                        "entry_id": "0e05fda4-04d2-3c77-81e1-efa5f827f803",
                                        "glosses": [
                                            "Of a leaf, slender and pointed, needle-like."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4f62f625-e735-46f0-be37-0b3c5fded1cf",
                                                "sense_id": "7bdd9d9d-544e-31d9-bb5e-7236ee19772d",
                                                "text": "the acicular foliage of coniferous trees"
                                            },
                                            {
                                                "example_id": "6dcc5117-5280-49c9-9a10-536d1b1db5ed",
                                                "sense_id": "7bdd9d9d-544e-31d9-bb5e-7236ee19772d",
                                                "text": "[…] though fond of foliage, their trees always had a tendency to congeal into little acicular thorn-hedges, and never tossed free."
                                            }
                                        ]
