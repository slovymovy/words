                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "148f122e-f312-32af-993b-d64dda651b74",
                        "entry_id": "0cbd4556-38a6-3ce2-ab66-89836a70efdd",
                        "glosses": [
                            "to hold / stretch / reach out; to extend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ccc7c148-2479-48cd-b09a-ffb1602d6b19",
                                "sense_id": "148f122e-f312-32af-993b-d64dda651b74",
                                "text": "протя́гивать ру́ку по́мощи",
                                "translation": "to extend a helping hand to someone",
                                "english": "to extend a helping hand to someone"
                            }
                        ]
                    },
                    {
                        "sense_id": "e6ec40c0-8fee-31db-8aea-bc6e542f73bb",
                        "entry_id": "0cbd4556-38a6-3ce2-ab66-89836a70efdd",
                        "glosses": [
                            "to delay, to drag out"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "8982c155-6f3c-3a47-b2d8-235639a14d53",
                        "entry_id": "0cbd4556-38a6-3ce2-ab66-89836a70efdd",
                        "glosses": [
                            "to drawl, to prolong, to sustain"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "97f4dea8-8ab7-4ef3-abbf-77f58430f1d0",
                                "sense_id": "8982c155-6f3c-3a47-b2d8-235639a14d53",
                                "text": "Я не могу́ вы́дать вам э́тот креди́т, обречённо протяну́л он.",
                                "translation": "I cannot give you this credit, he drawled resignedly.",
                                "english": "I cannot give you this credit, he drawled resignedly."
                            }
                        ]
                    },
                    {
                        "sense_id": "f2990198-08c0-3121-a2b7-894a38bdb47e",
                        "entry_id": "0cbd4556-38a6-3ce2-ab66-89836a70efdd",
                        "glosses": [
                            "to hold out, to live a while longer, to last (survive)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ed90add-158b-4f84-a157-619a22c0ca11",
                                "sense_id": "f2990198-08c0-3121-a2b7-894a38bdb47e",
                                "text": "Он до́лго не протя́нет",
                                "translation": "He won't last (live) long.",
                                "english": "He won't last (live) long."
                            }
                        ]
                    },
                    {
                        "sense_id": "faf5dc7b-ce33-3e1f-93d7-1bd482e97e8f",
                        "entry_id": "0cbd4556-38a6-3ce2-ab66-89836a70efdd",
                        "glosses": [
                            "in expressions"
                        ],
                        "tags": [],
                        "examples": [
                            {
