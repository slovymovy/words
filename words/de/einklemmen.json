                {
                    "sense_id": "67b9db15-5f26-39a1-82c7-2a886a3c9a38",
                    "sense_definition": "einen Körperteil versehentlich und schmerzhaft zwischen zwei harten Gegenständen quetschen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "verletzen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pass auf die schwere Autotür auf, damit du dir nicht den Finger <w>einklemmst</w>."
                        },
                        {
                            "text": "Das weinende Kind hatte sich die Hand in der Schublade <w>eingeklemmt</w>."
                        }
                    ],
                    "synonyms": [
                        "einquetschen",
                        "einzwicken"
                    ],
                    "common_phrases": [
                        "den Finger einklemmen",
                        "sich die Hand einklemmen"
                    ]
                },
                {
                    "sense_id": "a763b856-5479-38fc-a268-c38f845454fe",
                    "sense_definition": "durch Trümmer, schwere Teile oder bei einem Unfall so festgehalten werden, dass man sich nicht mehr bewegen oder befreien kann",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "einschliessen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der verletzte Fahrer war nach dem Zusammenstoß zwischen Lenkrad und Sitz <w>eingeklemmt</w>."
                        },
                        {
                            "text": "Die Feuerwehr musste Spezialwerkzeug einsetzen, um die <w>eingeklemmten</w> Personen zu befreien."
                        }
                    ],
                    "synonyms": [
                        "einkeilen"
                    ],
                    "common_phrases": [
                        "im Auto eingeklemmt sein",
                        "im Fahrzeug eingeklemmt sein"
                    ]
                },
                {
                    "sense_id": "1d2fd2e5-acc4-34b5-8ae5-c797a5f998bb",
                    "sense_definition": "einen Gegenstand fest zwischen zwei Flächen oder Spannbacken befestigen, um ihn zu fixieren",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "befestigen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der Handwerker <w>klemmte</w> das Holzstück fest in den Schraubstock <w>ein</w>."
                        },
                        {
                            "text": "Vor dem Bohren müssen Sie das Metallteil sorgfältig <w>einklemmen</w>."
                        }
                    ],
                    "synonyms": [
                        "einspannen"
                    ],
                    "common_phrases": [
                        "in den Schraubstock einklemmen"
                    ]
                }
            ]
        }
