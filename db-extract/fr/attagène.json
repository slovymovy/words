                "senses": [
                    {
                        "sense_id": "dfea124f-75b2-39f3-bdba-743a2438bc5b",
                        "entry_id": "ba5459ff-2b41-3ab3-bb5f-f10df8dd76a3",
                        "glosses": [
                            "Genre de coléoptère de la famille des dermestidés, de très petite taille, dont l’espèce la plus connue est nommée attagène des tapis car sa larve se nourrit de fibres d’origine animale ou végétale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "07e38e6e-dfba-4d97-bc32-1174621f4046",
                                "sense_id": "dfea124f-75b2-39f3-bdba-743a2438bc5b",
                                "text": "Détritivore, l’attagène aime les recoins poussiéreux."
                            },
                            {
                                "example_id": "6ead6fba-0ce3-45e0-b8f0-21e8b9040d66",
                                "sense_id": "dfea124f-75b2-39f3-bdba-743a2438bc5b",
                                "text": "Une fois desséché et momifié, il héberge encore des exploitants : les larves des attagènes et des anthrènes, les chenilles d'Aglossa cuprealis et de Tineola bisselelia."
                            },
                            {
                                "example_id": "de22f3e4-a733-492b-8236-3c728f893eb3",
                                "sense_id": "dfea124f-75b2-39f3-bdba-743a2438bc5b",
                                "text": "Les attagènes sont considérés comme des ravageurs mineurs des produits céréaliers. Mais ce sont de véritables fléaux lorsque l’on parle de tissus ou lorsqu’ils sont observés dans les musées."
                            }
                        ]
                    }
                ],
