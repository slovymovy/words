    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "cd623239-c588-3a37-b16d-f11199491245",
                    "sense_definition": "Искренне, правдиво, без обмана и лжи.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Скажи мне <честно>, ты действительно хочешь поехать с нами?",
                            "target_lang_translations": {
                                "en": "Tell me <honestly>, do you really want to go with us?",
                                "zh": "请<w>诚实</w>地告诉我，你真的想和我们一起去吗？"
                            }
                        },
                        {
                            "text": "Я <честно> говоря не ожидал увидеть тебя здесь сегодня.",
                            "target_lang_translations": {
                                "en": "<Honestly> speaking, I didn't expect to see you here today.",
                                "zh": "<w>老实说</w>，我没想到今天会在这里见到你。"
                            }
                        }
                    ],
                    "synonyms": [
                        "правдиво",
                        "искренне",
                        "откровенно"
                    ],
                    "antonyms": [
                        "нечестно"
                    ],
                    "common_phrases": [
                        "честно говоря",
                        "честно признаться",
                        "честно сказать"
                    ],
                    "target_lang_definitions": {
                        "en": "Sincerely, truthfully, without deceit or lies.",
                        "zh": "真诚地、真实地，没有欺骗或谎言。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "honestly",
                                "target_lang_sense_clarification": "in a truthful manner"
                            },
                            {
                                "target_lang_word": "truthfully",
                                "target_lang_sense_clarification": "telling the truth"
                            },
                            {
                                "target_lang_word": "frankly",
                                "target_lang_sense_clarification": "openly and sincerely"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "诚实地",
                                "target_lang_sense_clarification": "以诚实的方式"
                            },
                            {
                                "target_lang_word": "坦率地",
                                "target_lang_sense_clarification": "直言不讳地"
                            },
                            {
                                "target_lang_word": "老实说",
                                "target_lang_sense_clarification": "用于引出真实想法的副词短语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7a3909d9-e336-308c-b9bb-517eabf27d8e",
                    "sense_definition": "Справедливо, добросовестно, в соответствии с правилами.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы договорились делить прибыль <честно>, поровну между всеми участниками.",
                            "target_lang_translations": {
                                "en": "We agreed to divide the profit <fairly>, equally among all participants.",
                                "zh": "我们商定要<w>公平</w>地分配利润，所有参与者平分。"
                            }
                        },
                        {
                            "text": "Важно играть <честно> и уважать своих соперников на поле.",
                            "target_lang_translations": {
                                "en": "It is important to play <fair> and respect your opponents on the field.",
                                "zh": "在赛场上<w>公平</w>竞争并尊重对手是很重要的。"
                            }
                        }
                    ],
                    "synonyms": [
                        "справедливо",
                        "по-честному"
                    ],
                    "antonyms": [
                        "нечестно",
                        "несправедливо"
                    ],
                    "common_phrases": [
                        "играть честно",
                        "поступить честно",
                        "заработать честно"
                    ],
                    "target_lang_definitions": {
                        "en": "Fairly, conscientiously, in accordance with rules.",
                        "zh": "公平地、尽责地，按照规则行事。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "fairly",
                                "target_lang_sense_clarification": "in a just and equitable manner"
                            },
                            {
                                "target_lang_word": "fair",
                                "target_lang_sense_clarification": "according to the rules (e.g., play fair)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "公平地",
                                "target_lang_sense_clarification": "以公正、平等的方式"
                            },
                            {
                                "target_lang_word": "公正地",
                                "target_lang_sense_clarification": "符合正义或规则"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "e15abd6f-2a5a-3ff4-b205-713b90f54e78",
                    "sense_definition": "Краткая форма среднего рода прилагательного <w>честный</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Его признание было <честно> и тронуло всех присутствующих.",
                            "target_lang_translations": {
                                "en": "His confession was <honest> and touched everyone present.",
                                "zh": "他的坦白非常<w>诚实</w>，打动了在场的所有人。"
                            }
                        },
                        {
                            "text": "Это решение вполне <честно> по отношению к остальным сотрудникам.",
                            "target_lang_translations": {
                                "en": "This decision is quite <fair> towards the other employees.",
                                "zh": "这个决定对其他员工来说相当<w>公平</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "short neuter singular"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Short neuter form of the adjective 'honest'.",
                        "zh": "形容词“诚实的”的短语形式，表示诚实或公正。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "honest",
                                "target_lang_sense_clarification": "truthful or sincere"
                            },
                            {
                                "target_lang_word": "fair",
                                "target_lang_sense_clarification": "just or appropriate"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "诚实",
                                "target_lang_sense_clarification": "指人或行为真实可靠"
                            },
                            {
                                "target_lang_word": "公平",
                                "target_lang_sense_clarification": "指处理事情公正合理"
                            }
                        ]
                    }
                }
