                        "examples": [
                            {
                                "example_id": "3b32e666-dc64-4e0e-9d44-5cf764a1f026",
                                "sense_id": "d2ed26b6-3ac7-3879-bdb7-97b7c63cc1b1",
                                "text": "Marco Rubio heeft zaterdag de Republikeinse voorverkiezingen in Washington DC gewonnen. Zijn opponent Ted Cruz ging er in de staat Wyoming met de winst vandoor. Bij de Democraten kreeg Hillary Clinton op de Noordelijke Marianen, een eilandgebied van de Verenigde Staten, de meeste stemmen."
                            }
