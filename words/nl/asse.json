                    "sense_id": "3ac6fce0-f462-3d6d-964e-cab367be9543",
                    "sense_definition": "Het overblijfsel van iets dat volledig verbrand is.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "verbrandingsresten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na het kampvuur bleef er alleen een hoopje grijze <w>asse</w> over.",
                            "target_lang_translations": {
                                "en": "After the campfire, only a small pile of gray <w>ash</w> remained."
                            }
                        },
                        {
                            "text": "Zij strooiden de <w>asse</w> van hun grootvader uit over de zee.",
                            "target_lang_translations": {
                                "en": "They scattered their grandfather's <w>ashes</w> over the sea."
                            }
                        }
                    ],
                    "synonyms": [
                        "as"
                    ],
                    "common_phrases": [
                        "grijze asse",
                        "tot asse verbranden"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Voornamelijk gebruikt in Vlaanderen; in Nederland is 'as' gebruikelijker."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The powdery residue remaining after something has been completely burned."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "ash",
                                "target_lang_sense_clarification": "powdery residue left after burning"
                            },
                            {
                                "target_lang_word": "ashes",
                                "target_lang_sense_clarification": "remains of a cremated body or ruined substance"
                            }
                        ]
                    }
                }
            ]
