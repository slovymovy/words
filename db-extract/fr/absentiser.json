                "senses": [
                    {
                        "sense_id": "ff4a2b03-7da2-3d71-9a51-e79ee2001d44",
                        "entry_id": "a5ecf936-9d28-3a77-bea2-bad8170e6d80",
                        "glosses": [
                            "Rendre absent ou comme absent."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "def28ffb-c423-424d-8498-72bb285c5b12",
                                "sense_id": "ff4a2b03-7da2-3d71-9a51-e79ee2001d44",
                                "text": "Cette fonction (ce néopsychisme) supplée la défaillance du processus d’hallucination négative où l’enfant peut absentiser (puis faire réapparaître) l’objet, évitant ainsi le risque intrusif (comme dans le rêve, le jeu, la création artistique et le transfert)."
                            },
                            {
                                "example_id": "52964d60-1f8f-40fd-99dd-06dd85c830b7",
                                "sense_id": "ff4a2b03-7da2-3d71-9a51-e79ee2001d44",
                                "text": "La régression et l’hallucination négative ont pour fonction d’absentiser cette présence et de rendre la personne de l’analyste « transparente » comme l'air."
                            },
                            {
                                "example_id": "534b97a9-5a4b-4cea-a908-f31e148d149e",
                                "sense_id": "ff4a2b03-7da2-3d71-9a51-e79ee2001d44",
                                "text": "A part ça, c'est un métier qui consiste à s'absenter, à «s'absentiser», disait le psychanalyste Pierre Fédida."
                            }
                        ]
                    }
                ],
