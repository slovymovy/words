                "senses": [
                    {
                        "sense_id": "2e3dde83-7624-3f54-9e2d-f198495f9071",
                        "entry_id": "ff6c3a3d-b336-3741-81c1-6c3998d42d3f",
                        "glosses": [
                            "in bestimmter Art und Weise im Februar scheinende Sonne"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec10c2cd-9c4c-4d9f-83db-559493be85f5",
                                "sense_id": "2e3dde83-7624-3f54-9e2d-f198495f9071",
                                "text": "„Die Februarsonne hat nach langem Ringen endlich das Gewölk durchbrochen und läßt goldene Strahlen durch das Fenster fluten.“"
                            },
                            {
                                "example_id": "b344d701-2f84-49d5-803f-7e67edf8aba2",
                                "sense_id": "2e3dde83-7624-3f54-9e2d-f198495f9071",
                                "text": "„Das ächzende Vehikel hielt vor dem halb ländlichen, halb städtischen Haus der Mutter Loew, die gerade ihre Wäsche in der Februarsonne zum Trocknen in ihrem Garten und im Garten ihrer evakuierten Nachbarn ausbreitete.“"
                            },
                            {
                                "example_id": "7f844bfc-e149-415e-86ef-e1e1e9daa6a9",
                                "sense_id": "2e3dde83-7624-3f54-9e2d-f198495f9071",
                                "text": "„Die noch tiefstehende Februarsonne schaute häufig in die leicht rußverschmierten und mit kleinen Ziergardinen bestückten Fenster hinein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
