                "senses": [
                    {
                        "sense_id": "60ace7d4-6972-312f-a115-c184e6fb08ff",
                        "entry_id": "a96a5b98-36cc-3cf7-9967-65bd47fc1181",
                        "glosses": [
                            "passives elektrisches Bauelement, dessen Leitfähigkeit vom vorher geflossenen Strom abhängt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a2c790d8-c17c-4e18-a001-76215588dcfc",
                                "sense_id": "60ace7d4-6972-312f-a115-c184e6fb08ff",
                                "text": "Chips auf Grundlage von Memristoren statt Transistoren könnten eines Tages den Stromverbrauch von Computern erheblich senken."
                            },
                            {
                                "example_id": "d3e233dd-c567-4da2-a872-67eb07b15f03",
                                "sense_id": "60ace7d4-6972-312f-a115-c184e6fb08ff",
                                "text": "Memristoren könnten Transistor-Funktionen ersetzen, dabei aber womöglich bei kleineren Strukturgrößen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
