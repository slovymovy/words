                            {
                                "example_id": "4a622d65-7ef7-45a9-96a9-22e68be03a06",
                                "sense_id": "9a1d62c3-eb7f-313c-8b5a-e9a64141ad00",
                                "text": "1646, Sir Thomas Browne, Pseudodoxia Epidemica or Enquries into very many received tenets and commonly presumed truths\nit came to be ordered that the Goat should be fed with saxifragous herbes, and such as are conceived of power to breake the stone."
                            },
                            {
                                "example_id": "5e0ee0ee-f159-4067-ad63-44c67c67ec77",
                                "sense_id": "9a1d62c3-eb7f-313c-8b5a-e9a64141ad00",
                                "text": "1677, William Hughes, The man of sin: or a discourse of popery\nI have six or seven Instances more, ... which will make such a Saxifragous Dose, that no scruple can stand before it."
                            }
                        ]
