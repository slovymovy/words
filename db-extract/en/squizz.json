                        "sense_id": "18b0c567-348e-32d5-9d39-f0525496ce71",
                        "entry_id": "69932374-ee2d-315f-91e1-cc97f33e7e55",
                        "glosses": [
                            "A look."
                        ],
                        "tags": [
                            "Commonwealth",
