                "senses": [
                    {
                        "sense_id": "bbbadc19-d591-3854-b428-ce95d61660ee",
                        "entry_id": "dd1f72de-39d7-38dd-9933-a733d61c298f",
                        "glosses": [
                            "Variante orthographique, parfois rencontrée, de recoucher (coucher à nouveau)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75817e82-605f-4013-8abf-dd7e75f23b16",
                                "sense_id": "bbbadc19-d591-3854-b428-ce95d61660ee",
                                "text": "Donc le matin je le re-couche vers 9h30 et il peut dormir 2h."
                            },
                            {
                                "example_id": "095cdcc7-1088-4a64-9ce8-4eba4926967d",
                                "sense_id": "bbbadc19-d591-3854-b428-ce95d61660ee",
                                "text": "Il écrit, éteint, se couche, réfléchit, rallume, ré-écrit, ré-éteint, se re-couche, re-pense."
                            },
                            {
                                "example_id": "af095170-3fe0-48e2-8eb3-c7e8fe06cd08",
                                "sense_id": "bbbadc19-d591-3854-b428-ce95d61660ee",
                                "text": "Bon tant pis, moi, je me re-couche."
                            },
                            {
                                "example_id": "8cdb3f62-c1ee-410c-b680-785b2e9d9173",
                                "sense_id": "bbbadc19-d591-3854-b428-ce95d61660ee",
                                "text": "Pendant que tout le monde se re-couchait, je pris mon tour de garde."
                            },
                            {
                                "example_id": "59a4dcb4-e41d-4815-af0d-645c2ad6f767",
                                "sense_id": "bbbadc19-d591-3854-b428-ce95d61660ee",
                                "text": "Il me regarda et se re-coucha."
                            }
                        ]
                    }
                ],
