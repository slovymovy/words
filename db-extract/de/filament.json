                ],
                "senses": [
                    {
                        "sense_id": "00c4e44e-6bd3-3b09-aa24-7ecd4f1c0cff",
                        "entry_id": "ee2e1fd7-fbea-311f-9aea-495f2156099a",
                        "glosses": [
                            "der den Staubbeutel tragende Faden einer Blüte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e3cdb369-a130-4df4-91f7-903af3d5d339",
                                "sense_id": "00c4e44e-6bd3-3b09-aa24-7ecd4f1c0cff",
                                "text": "Ein Staubblatt gliedert sich in ein Filament und eine am Ende sitzende Anthere."
                            },
                            {
                                "example_id": "e5fe233f-2012-41c8-9c93-529c8fb206fc",
                                "sense_id": "00c4e44e-6bd3-3b09-aa24-7ecd4f1c0cff",
                                "text": "Das sogenannte Staubblatt ist der männliche Teil der Blüte. (Androeceum) Es setzt sich meistens aus dem Staubfaden (Filament) und dem Staubbeutel (Anthere) zusammen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "f0f4b409-382b-3a8d-9908-c669521d64f6",
                        "entry_id": "ee2e1fd7-fbea-311f-9aea-495f2156099a",
                        "glosses": [
                            "dunkle, fadenförmige Struktur in der Chromosphäre"
                        ],
                        "tags": [
                            "plural-normally"
                        ],
                        "examples": [
                            {
                                "example_id": "0c8342a6-8f3e-4037-8a08-c38fc2440006",
                                "sense_id": "f0f4b409-382b-3a8d-9908-c669521d64f6",
                                "text": "Filamente zeigen sich als lange dunkle Fäden, wenn sie im Licht bestimmter Spektrallinien, besonders von Wasserstoff-Alpha und ionisiertem Kalzium, auf der Sonnenscheibe beobachtet werden."
                            },
                            {
                                "example_id": "223add13-a0a7-41bb-81ea-c87e2fe3b4ed",
                                "sense_id": "f0f4b409-382b-3a8d-9908-c669521d64f6",
                                "text": "Es ist ziemlich sicher, daß die Filamente nichts anderes sind, als höher gelegene Teile der später zu besprechenden Chromosphäre, also Gebilde, die uns am Sonnenrande in Gestalt von Protuberanzen entgegentreten."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "cf0cf7c4-380c-3cca-b518-9dcf1c56dd53",
                        "entry_id": "ee2e1fd7-fbea-311f-9aea-495f2156099a",
                        "glosses": [
                            "nahezu unbegrenzt lange Faser in Garnen und Kabeln"
                        ],
                        "tags": [
                            "Textilindustrie"
                        ],
                        "examples": [
                            {
                                "example_id": "ea92bf51-11f1-422f-b238-55cc350c7933",
                                "sense_id": "cf0cf7c4-380c-3cca-b518-9dcf1c56dd53",
                                "text": "Daraus wird durch Spinnen, bei dem die Spinnmasse zur Fadenbildung durch Düsen gepreßt wird, das Filament gewonnen."
                            },
                            {
                                "example_id": "e48782e3-235f-4e98-a808-1ab38cca58f2",
                                "sense_id": "cf0cf7c4-380c-3cca-b518-9dcf1c56dd53",
                                "text": "Chemiefasern werden entweder als Spinnfasern in Ballenform oder als Kabel aus endlosen Filamenten verarbeitet."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
