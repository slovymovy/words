                        ]
                    },
                    {
                        "translation_id": "4dcb4c96-5f94-4fb1-822e-fe810c667eca",
                        "source_entry_id": "8ad8a2c8-32a8-3baf-adc0-5c8292579e91",
                        "source_sense_description": "кочующий человек",
                        "target_lang_word": "rolling stone",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rolling stone",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5634ab7f-9d5b-3c27-80df-913c36484194",
                                        "entry_id": "f45c7e21-abb9-383d-a0d1-c71a2bad4a3e",
                                        "glosses": [
                                            "A person who moves around a lot and never settles down; a vagrant."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b735f46-9074-463d-a125-8f368a2db927",
                                                "sense_id": "5634ab7f-9d5b-3c27-80df-913c36484194",
                                                "text": "Before that they had been a good deal on the move, trekking about after the white man, who was one of those rolling stones that keep going round after a soft job."
                                            },
                                            {
                                                "example_id": "fa171abe-1d25-4f32-b3ce-0d9e6c2fc802",
                                                "sense_id": "5634ab7f-9d5b-3c27-80df-913c36484194",
                                                "text": "How does it feel\nTo be on your own\nWith no direction home\nLike a complete unknown\nLike a rolling stone?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ca857815-5f20-39e2-9641-0c078315792c",
                                        "entry_id": "f45c7e21-abb9-383d-a0d1-c71a2bad4a3e",
                                        "glosses": [
                                            "A womanizer."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "708e4c0b-eb14-426e-999d-4e27bb1acb76",
                                                "sense_id": "ca857815-5f20-39e2-9641-0c078315792c",
                                                "text": "Papa was a rolling stone\nWherever he laid his hat was his home\nAnd when he died, all he left us was a loan"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "11151bb6-406c-3831-9830-fce2a6bb89a2",
                                        "entry_id": "f45c7e21-abb9-383d-a0d1-c71a2bad4a3e",
                                        "glosses": [
                                            "A geological phenomenon where rocks move and inscribe long tracks along a smooth valley floor without animal or human intervention."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "caf5b231-2470-39bc-9d0b-ccbc224ffa69",
