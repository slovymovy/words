                                            {
                                                "example_id": "23eaba2a-2ebf-452d-92f5-68fcc3aa6359",
                                                "sense_id": "b2e3cd76-0964-3358-ae9a-a581fb2c1e84",
                                                "text": "A brief steep ascent and then a more gradual ascent through snow. Bets probably had taken my water container by then. Mack asks how I'm doing. I manage the words — pretty wasted. She offers to take the tent."
                                            }
                                        ]
                                    },
                                    {
