                        "sense_id": "4171ee8d-3a4c-32e0-b72a-171d9e9e3705",
                        "entry_id": "12618a7c-8010-31a9-bbd2-6cb3b61700e0",
                        "glosses": [
                            "to laugh quietly, giggle furtively or in a quasi-conspiratorial manner"
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "d604e5b0-8657-47e4-af9d-4fba713b6dce",
                                "sense_id": "4171ee8d-3a4c-32e0-b72a-171d9e9e3705",
                                "text": "Ik weet niet waarom die twee daar achterin aan het giebelen zijn.",
                                "translation": "I don't know why those two in the back are laughing furtively.",
                                "english": "I don't know why those two in the back are laughing furtively."
                            }
                        ]
                    }
