                        "cross_references": [
                            {
                                "target_word": "Abszess",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "022ef720-d6ef-3e1c-adb8-4dce76dc8934",
                                        "entry_id": "b0426ad9-6556-316e-b6dc-4d41d894cbac",
                                        "glosses": [
                                            "Ansammlung von Eiter in einem durch Gewebseinschmelzung (Nekrose) entstandenen unnatürlichen Hohlraum"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3ff8192-7d3f-4dc3-a8c8-2b478f4eb2b2",
                                                "sense_id": "022ef720-d6ef-3e1c-adb8-4dce76dc8934",
                                                "text": "Abszesse können ohne offenbare äußere Ursache auftreten, aber sie können auch Folge einer Operation, einer Spritze, eines Fremdkörpers oder durch eine Abwehrschwäche des Betroffenen begünstigt sein."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fab5869a-d8bc-4f40-a3f4-edf2fbb3e3c9",
                        "source_entry_id": "c9d16604-19d6-3112-8d08-420d7cf8736a",
                        "source_sense_id": "72f18966-589a-3656-9fea-6b6cd128bb79",
                        "target_lang_word": "abces",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abces",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "359b2adf-dcfc-36e6-92ed-49fc9db51433",
                                        "entry_id": "3016aa50-dca1-3e48-8349-47fcc454f1af",
                                        "glosses": [
                                            "een ophoping van pus in het lichaam, daarbij een onnatuurlijke holte vormend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "14ce1108-bde4-4e3a-8ecf-049c817cf2d7",
                                                "sense_id": "359b2adf-dcfc-36e6-92ed-49fc9db51433",
                                                "text": "Als je door een lokale ontsteking niet meer kunt slapen is er meestal sprake van een abces."
                                            },
                                            {
                                                "example_id": "3e1c441b-4375-4413-970d-48ff882bc6a4",
                                                "sense_id": "359b2adf-dcfc-36e6-92ed-49fc9db51433",
                                                "text": "Als een abces doorbreekt is de pijn meestal direct verdwenen."
                                            },
                                            {
                                                "example_id": "3337581c-4a17-4315-891e-e214e17c28d5",
                                                "sense_id": "359b2adf-dcfc-36e6-92ed-49fc9db51433",
                                                "text": "De behandeling van een abces is incisie en drainage."
                                            },
                                            {
                                                "example_id": "920eb99a-7376-4cb3-a6c8-28f98b94c814",
                                                "sense_id": "359b2adf-dcfc-36e6-92ed-49fc9db51433",
                                                "text": "Jonge zeehonden: Ollie en Brandy zijn allebei nog jonge zeehonden. Ollie werd half januari gevonden op Schiermonnikoog, pas tien dagen oud, met een abces op zijn rug. Brandy kwam begin maart van Terschelling, met diepe wonden aan zijn flippers. Beiden waren na weken van verzorging gisteren weer fit genoeg om terug te keren naar zee. Ze werden uit hun bassin in Pieterburen gehaald, in kisten gedaan en naar Lauwersoog vervoerd. Vanaf daar voeren ze met de boot naar een zandplaat bij Schiermonnikoog."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c7b7d2da-28b4-44cb-b563-a5f219846abf",
                        "source_entry_id": "c9d16604-19d6-3112-8d08-420d7cf8736a",
                        "source_sense_id": "72f18966-589a-3656-9fea-6b6cd128bb79",
                        "target_lang_word": "absces",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "absces",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "258d3e20-86c8-36cb-a051-652c1c4a7ebc",
                                        "entry_id": "505b5f8d-e845-3856-9114-255f4a65f693",
                                        "glosses": [
                                            "ropień"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "378c2f19-c002-4e47-88fc-17e55572cb83",
                                                "sense_id": "258d3e20-86c8-36cb-a051-652c1c4a7ebc",
                                                "text": "Tu i owdzie formowały się wzdęte, ciemne abscesy. Chory przyglądał się tym swoim ranom przez chwilę"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b8294da5-66b9-42a8-a34c-a3a24e7a383d",
                        "source_entry_id": "c9d16604-19d6-3112-8d08-420d7cf8736a",
                        "source_sense_id": "72f18966-589a-3656-9fea-6b6cd128bb79",
                        "target_lang_word": "abcès",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abcès",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5c52d7b1-4800-39b5-bb39-d1843490f168",
                                        "entry_id": "0a381d58-33ed-33e5-99c7-f64cc83b9966",
                                        "glosses": [
                                            "Poche de pus dans une cavité formée aux dépens des tissus environnants."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4eea8d3c-0688-48e7-af84-e0ab4bb3564c",
                                                "sense_id": "5c52d7b1-4800-39b5-bb39-d1843490f168",
                                                "text": "Pour guérir le dernier-né de la Reine, qui souffrait d'un abcès à la gorge et qu’Hadès semblait encore une fois attirer dans ses ténèbres, le médecin Olympos avait jugé qu'il fallait prendre les grands moyens : une incubation, et à Canope."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ce92304e-f582-367d-a2c4-fe4ba8733ce0",
                                        "entry_id": "0a381d58-33ed-33e5-99c7-f64cc83b9966",
                                        "glosses": [
                                            "Amas d'urine et de matière stercorale"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9dbf3353-3e89-31e3-9f8c-771413eecc21",
                                        "entry_id": "0a381d58-33ed-33e5-99c7-f64cc83b9966",
                                        "glosses": [
                                            "Endroit où l'on laisse se cristalliser une situation mauvaise pour éviter son extension."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4f3f1dd9-7939-4c44-861b-2945640359c7",
                                                "sense_id": "9dbf3353-3e89-31e3-9f8c-771413eecc21",
                                                "text": "Les abcès peuvent affecter tous les animaux. Ils se développent généralement sur la peau à la faveur d’une lésion mais ils peuvent être dus à une maladie et se développer sous la peau ou dans les tissus profonds."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
