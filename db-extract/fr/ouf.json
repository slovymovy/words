                                                "example_id": "056f361a-ba51-43e5-95f0-af88b2900980",
                                                "sense_id": "f1bd8cba-b836-3ec8-9bf7-c06c761096f9",
                                                "text": "(from intense concern) Whew! Thank goodness youʼre safe! I thought something terrible had happened to you!"
                                            },
                                            {
                                                "example_id": "f9e1d2e5-c440-4d8a-8f3d-060167360d3a",
                                                "sense_id": "f1bd8cba-b836-3ec8-9bf7-c06c761096f9",
                                                "text": "(from fear of being seen) Whew! That cop didnʼt see me! That was a close call!"
                                            }
                                        ]
                                    },
