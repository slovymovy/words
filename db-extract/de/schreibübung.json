                "senses": [
                    {
                        "sense_id": "4178e9a1-c937-3f9b-9edd-f95f47b2ab39",
                        "entry_id": "88e4190d-7efe-3ef3-92de-b6dc92a39d04",
                        "glosses": [
                            "Bemühung darum, die Fähigkeit zu schreiben zu erlernen/verbessern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "91b80cee-578e-4047-b45b-691e64b368e0",
                                "sense_id": "4178e9a1-c937-3f9b-9edd-f95f47b2ab39",
                                "text": "„Neben Kritzeleien finden sich Schreibübungen aus schulischem Kontext, Vorüberlegungen zu einer Handschrift, deren Seitengestaltung anscheinend zuerst auf Schiefer geplant wurde, der Entwurf eines Kaufvertrags, ein Bibelzitat (Zweck bisher ungeklärt) und Namenslisten.“"
                            },
                            {
                                "example_id": "32a4014a-9e01-4f4e-a7c0-6319beeb3075",
                                "sense_id": "4178e9a1-c937-3f9b-9edd-f95f47b2ab39",
                                "text": "„Zum anderen aber konnten solche Notate auch aus kleinen Schreibübungen bestehen, deren Themen ich mir selbst vorgab.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
