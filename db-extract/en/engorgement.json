                        "examples": []
                    },
                    {
                        "sense_id": "331de01b-843c-3dab-b13b-bc4a797f701d",
                        "entry_id": "95816ee4-9a75-3b97-933c-9b165310b20e",
                        "glosses": [
                            "The process or the condition of becoming engorged, becoming over-filled with fluid."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "2981bb9e-c3ef-47bc-bc93-33bef3e04ea2",
                                "sense_id": "331de01b-843c-3dab-b13b-bc4a797f701d",
                                "text": "However, several enterographic findings are associated with increased disease activity, including wall thickening greater than 4 mm, intramural and mesenteric oedema, mucosal hyperaemia, wall enhancement (and enhancement pattern), transmural ulceration and fistula formation, vascular engorgement and inflammatory mesenteric lymph nodes (often with hyperenhancement)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6de179fe-dfea-463d-9e2a-1c6d29623c2c",
                        "source_entry_id": "95816ee4-9a75-3b97-933c-9b165310b20e",
                        "source_sense_description": "the process or the condition of becoming engorged",
                        "target_lang_word": "engorgement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "engorgement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "75ce0724-026d-3c65-8993-0b2d6a079c58",
                                        "entry_id": "cc1aa93a-ba0d-3090-a985-58d8c380a1a4",
                                        "glosses": [
                                            "Action d’engorger ou état de ce qui est engorgé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9429cb7-ac36-41b4-9b65-45a42302ef5b",
                                                "sense_id": "75ce0724-026d-3c65-8993-0b2d6a079c58",
                                                "text": "De même que toutes les autres parties situées au fond de la bouche, les tonsilles sont sujettes à différentes sortes d’engorgements dont la nature varie autant que les suites."
                                            },
                                            {
                                                "example_id": "cc42f8b0-a72c-4348-8a23-a3b9dad043a8",
                                                "sense_id": "75ce0724-026d-3c65-8993-0b2d6a079c58",
                                                "text": "L’engorgement a fait crever ces tuyaux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cbddc98c-767a-396f-8351-06a7b434bfa6",
                                        "entry_id": "cc1aa93a-ba0d-3090-a985-58d8c380a1a4",
                                        "glosses": [
                                            "Saturation en eau, ennoiement du sol."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "af792214-f678-4cc5-b9c8-7a8bcdc5c47b",
                                                "sense_id": "cbddc98c-767a-396f-8351-06a7b434bfa6",
                                                "text": "Mais lorsque la nappe estivale se trouve à plusieurs décimètres de profondeur, elle permet une alimentation en eau pendant les périodes sèches : si la contrainte d’engorgement peut être extrêmement forte dans ces sols, ils ne présentent pas de contrainte de sécheresse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2cbe7298-6c6e-3f3a-9e5b-95e299e7ae58",
                                        "entry_id": "cc1aa93a-ba0d-3090-a985-58d8c380a1a4",
                                        "glosses": [
                                            "État de sursollicitation d'un service public."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "76692261-baab-4594-a19e-278929b56d90",
                                                "sense_id": "2cbe7298-6c6e-3f3a-9e5b-95e299e7ae58",
                                                "text": "À l'Assemblée nationale, on parle beaucoup des engorgements dans les salles d'urgenc et de la « déshumanisation des soins de santé »."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
