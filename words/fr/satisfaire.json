    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2a944be7-3eb7-3f15-9999-466f1e7c5205",
                    "sense_definition": "Contenter quelqu'un en répondant à ses désirs, ses attentes ou ses besoins matériels ou moraux.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "contenter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette entreprise cherche toujours à <w>satisfaire</w> les attentes de ses nouveaux clients."
                        },
                        {
                            "text": "Il est souvent impossible de <w>satisfaire</w> tout le monde lors d'un grand projet."
                        }
                    ],
                    "synonyms": [
                        "contenter",
                        "combler"
                    ],
                    "common_phrases": [
                        "satisfaire un besoin",
                        "satisfaire tout le monde",
                        "satisfaire la curiosité"
                    ]
                },
                {
                    "sense_id": "aa268806-fae1-3f2a-a651-d3613eca1a51",
                    "sense_definition": "S'acquitter d'une obligation, respecter une règle ou remplir une condition requise.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "regles",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les candidats doivent impérativement <w>satisfaire</w> aux conditions d'admission fixées par l'école."
                        },
                        {
                            "text": "Ce nouveau modèle <w>satisfait</w> à toutes les normes de sécurité en vigueur."
                        }
                    ],
                    "synonyms": [
                        "répondre"
                    ],
                    "common_phrases": [
                        "satisfaire aux conditions",
                        "satisfaire aux critères",
                        "satisfaire aux exigences"
                    ]
                },
                {
                    "sense_id": "1e8884b0-5c84-388d-927a-869c602693fe",
                    "sense_definition": "Se contenter de quelque chose, trouver une situation ou un résultat acceptable.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "contenter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Faute de temps, l'équipe a dû se <w>satisfaire</w> d'un compromis temporaire."
                        },
                        {
                            "text": "Il sait se <w>satisfaire</w> de peu et apprécie les choses simples du quotidien."
                        }
                    ],
                    "synonyms": [
                        "se contenter"
                    ],
                    "common_phrases": [
                        "se satisfaire de peu",
                        "se satisfaire d'un résultat"
                    ]
                },
                {
                    "sense_id": "93a49be1-d91f-3b52-832a-8052f22377c6",
                    "sense_definition": "Plaire à l'esprit ou charmer les sens par son harmonie ou sa justesse.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "plaisir",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette explication limpide et rationnelle <w>satisfait</w> pleinement l'esprit."
                        },
                        {
                            "text": "L'harmonie des couleurs dans ce tableau <w>satisfait</w> le regard de l'observateur."
                        }
                    ],
                    "synonyms": [
                        "combler"
                    ],
                    "common_phrases": [
                        "satisfaire l'esprit",
                        "satisfaire la vue"
                    ]
                },
                {
                    "sense_id": "6c26b279-57d2-35b5-b567-513910742b3b",
                    "sense_definition": "Rembourser ses dettes ou indemniser une personne pour réparer un tort.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "regles",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le débiteur a vendu une partie de ses terres pour <w>satisfaire</w> ses créanciers."
                        },
                        {
                            "text": "Le tribunal a ordonné des saisies afin de <w>satisfaire</w> les victimes."
                        }
                    ],
                    "common_phrases": [
                        "satisfaire ses créanciers"
                    ]
                }
            ]
        }
    ]
}