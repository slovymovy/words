                    {
                        "sense_id": "a3cc3217-680f-32d6-b488-4f1847ffc326",
                        "entry_id": "cf4e22d1-7567-3e56-a5c3-8348a8f4c5dd",
                        "glosses": [
                            "Verhindern von Konflikten und sich aufschaukelnden Prozessen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "81ba60ae-89d7-4415-b2af-7ded9598e33b",
                                "sense_id": "a3cc3217-680f-32d6-b488-4f1847ffc326",
                                "text": "Die Deeskalation verhinderte den Konflikt."
                            },
                            {
                                "example_id": "7dda8c16-15d3-4166-9d8d-971801cdd6e0",
                                "sense_id": "a3cc3217-680f-32d6-b488-4f1847ffc326",
                                "text": "„Eine Sprecherin der EU-Außenbeauftragten Catherine Ashton sagte, Ziel sei eine Deeskalation der Situation in der Ukraine.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "84c1f38a-4fe1-4bbd-8292-5b071c673d0e",
                        "source_entry_id": "cf4e22d1-7567-3e56-a5c3-8348a8f4c5dd",
                        "source_sense_id": "a3cc3217-680f-32d6-b488-4f1847ffc326",
                        "source_sense_description": "Verhindern von Konflikten und sich aufschaukelnden Prozessen",
                        "target_lang_word": "de-escalation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "de-escalation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "80050795-f1e2-3459-bd01-68080a41118c",
                                        "entry_id": "30271c79-5e81-33f4-8d98-d51c658b697d",
                                        "glosses": [
                                            "A decrease in scope, extension or severity."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a7db7d38-6b1a-43c1-aa3b-f3152fc59f28",
                                                "sense_id": "80050795-f1e2-3459-bd01-68080a41118c",
                                                "text": "The efforts at de-escalation have been many and varied. The most obvious have been high-level visits to Israel from US, UK and German leaders."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "295dde5a-b848-43ec-91ff-6027f677915b",
                        "source_entry_id": "cf4e22d1-7567-3e56-a5c3-8348a8f4c5dd",
                        "source_sense_id": "a3cc3217-680f-32d6-b488-4f1847ffc326",
                        "source_sense_description": "Verhindern von Konflikten und sich aufschaukelnden Prozessen",
                        "target_lang_word": "désescalade",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "désescalade",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d7b83227-4ad8-3dbd-81dd-bb407994f931",
                                        "entry_id": "d1c6b78a-555c-3c85-990f-69196e5ad330",
                                        "glosses": [
                                            "Changement d’orientation d’une action, d’un résultat, consistant à revenir en arrière, à en arrêter la croissance."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "20020da9-76bb-41ad-8d74-a11945a1e84a",
                                                "sense_id": "d7b83227-4ad8-3dbd-81dd-bb407994f931",
                                                "text": "Comment favoriser au mieux la désescalade thérapeutique?"
                                            },
                                            {
                                                "example_id": "ff884b6d-36c8-4321-9a09-f3a4f4ba7616",
                                                "sense_id": "d7b83227-4ad8-3dbd-81dd-bb407994f931",
                                                "text": "En Allemagne, la « désescalade » est entre autres le produit de la décision « Bockdorf » du Tribunal constitutionnel (1985), qui avait introduit une « obligation de communication et de coopération » des forces de l’ordre avec les protestataires."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "593391eb-a8c7-343f-8a28-0fc510856449",
                                        "entry_id": "d1c6b78a-555c-3c85-990f-69196e5ad330",
                                        "glosses": [
                                            "Approche d'intervention visant à réduire les tensions, les émotions et la violence."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "698f7183-7698-4e25-ad41-2a1a412c7a73",
                                                "sense_id": "593391eb-a8c7-343f-8a28-0fc510856449",
                                                "text": "Elle devrait aussi se traduire par l'élaboration d'un contre-discours dans lequel la valorisation de la notion de désescalade, par opposition à l'emploi de la force policière, devrait occuper un rôle central au SPVM."
                                            },
                                            {
                                                "example_id": "c783c27c-305c-4801-85c6-66d59b50642b",
                                                "sense_id": "593391eb-a8c7-343f-8a28-0fc510856449",
                                                "text": "Cet ensemble de pourparlers doit permettre une désescalade des tensions autour de l'Ukraine, Kiev et ses alliés occidentaux accusant la Russie d'avoir massé des dizaines de milliers de militaires à sa frontière en prévision d'une possible invasion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e1681744-d353-363b-8fd6-8c5df8ed241e",
                                        "entry_id": "d1c6b78a-555c-3c85-990f-69196e5ad330",
                                        "glosses": [
                                            "Technique de descente consistant à prendre appui sur la paroi avec les pieds et les mains."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
