                        "translation_id": "7372ac3c-7b91-41dc-b7ff-14adacb5e169",
                        "source_entry_id": "3e03b5c6-c029-3883-876d-c01ec7e4abee",
                        "source_sense_description": "farmer",
                        "target_lang_word": "Landwirt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Landwirt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "27ac7bbc-e437-3874-b003-a012f2f74f19",
                                        "entry_id": "f7c524e4-0dbe-31b3-8dc1-787acc8c4498",
                                        "glosses": [
                                            "Person, die eine Produktion pflanzlicher und tierischer Erzeugnisse selbständig betreibt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7bc0f992-60b6-47cd-8180-e8609e196e44",
                                                "sense_id": "27ac7bbc-e437-3874-b003-a012f2f74f19",
                                                "text": "Der Landwirt ist vom Wetter abhängig."
                                            },
                                            {
                                                "example_id": "b3be0a77-67fb-4b70-98f1-6bb9d5a24a04",
                                                "sense_id": "27ac7bbc-e437-3874-b003-a012f2f74f19",
                                                "text": "„Durch die Trockenheit begünstigt, sind die meisten Landwirte gerade dabei, die letzten Bestände anzuernten.“"
                                            },
                                            {
                                                "example_id": "dd934332-b4dd-4870-ad91-029862293309",
                                                "sense_id": "27ac7bbc-e437-3874-b003-a012f2f74f19",
                                                "text": "„Manche Äcker müssen die Landwirte mehrfach mit dem umstrittenen Totalherbizid Glyphosat behandeln oder ein bis zwei Jahre lang brach liegen lassen, um die Ausbreitung des Ungrases zu stoppen.“"
                                            },
                                            {
                                                "example_id": "56ea82fb-5f8c-430c-bb05-7ee3946543c5",
                                                "sense_id": "27ac7bbc-e437-3874-b003-a012f2f74f19",
                                                "text": "„Mitten in der Arbeit erreicht ihn die Nachricht, dass das Erbgesundheitsamt den Landwirt Johannes Kagelmacher, Falladas Freund aus Rügen, in die Heilanstalt Leipzig-Dösen eingewiesen hat, um festzustellen, ob er nach dem »Gesetz zur Verhütung erbkranken Nachwuchses« zu sterilisieren sei.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8e75daeb-32c3-306c-8834-219f27e0d194",
                                        "entry_id": "f7c524e4-0dbe-31b3-8dc1-787acc8c4498",
                                        "glosses": [
                                            "Berufszweig, der sich mit der Herstellung pflanzlicher und tierischer Erzeugnisse befasst"
                                        ],
                                        "tags": [
                                            "Beruf"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2f04ad29-55a9-4baf-ad33-6a884a6c84e8",
                                                "sense_id": "8e75daeb-32c3-306c-8834-219f27e0d194",
                                                "text": "Er wurde von seinen Eltern gezwungen, Landwirt zu lernen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "75dbc515-0f90-4bbc-837c-70c814f56b5e",
                        "source_entry_id": "3e03b5c6-c029-3883-876d-c01ec7e4abee",
                        "source_sense_description": "farmer",
                        "target_lang_word": "Landwirtin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Landwirtin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "53909ea1-097b-3cc8-b2f5-db115437ddbb",
                                        "entry_id": "8b81fe5d-bc6b-34cf-aac0-6d4684ba56a9",
                                        "glosses": [
                                            "weibliche Person, die selbständig eine Produktion pflanzlicher und/oder tierischer Erzeugnisse betreibt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6730f95d-6608-48b0-8bbf-962ff5cd3dd7",
                                                "sense_id": "53909ea1-097b-3cc8-b2f5-db115437ddbb",
                                                "text": "In Deutschland kann man sich zur Landwirtin ausbilden lassen."
                                            },
                                            {
                                                "example_id": "4208df6b-6374-438f-bfeb-f95a11ccfb71",
                                                "sense_id": "53909ea1-097b-3cc8-b2f5-db115437ddbb",
                                                "text": "Als Landwirtin kann man zum Beispiel Schweine züchten oder Getreide anbauen."
                                            },
                                            {
                                                "example_id": "7451b92a-a9e1-4f72-a920-c97c7109d9d2",
                                                "sense_id": "53909ea1-097b-3cc8-b2f5-db115437ddbb",
                                                "text": "Wahrscheinlich gibt es weniger Landwirtinnen als Landwirte."
                                            },
                                            {
                                                "example_id": "46893eb0-2017-44f0-b838-e6bb5bbabbb2",
                                                "sense_id": "53909ea1-097b-3cc8-b2f5-db115437ddbb",
                                                "text": "Die Landwirtinnen des Ortes treffen sich jeden Samstag im Dorfgemeinschaftshaus."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
