                ],
                "senses": [
                    {
                        "sense_id": "9c7e3b5d-d762-3ce7-9574-6cab0caa443b",
                        "entry_id": "f1fcd689-5486-37ea-9dfc-562fd184c67e",
                        "glosses": [
                            "weltweite Kette mit sehr vielen Infektionen von Menschen mit SARS-CoV-2"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "d498502a-21da-4ac3-b847-066131983d0c",
                                "sense_id": "9c7e3b5d-d762-3ce7-9574-6cab0caa443b",
                                "text": "„Wegen der Corona-Pandemie könnte es der Weltgesundheitsorganisation (WHO) zufolge in diesem Jahr Zehntausende zusätzliche Todesfälle durch Malaria geben.“"
                            },
                            {
                                "example_id": "81fac6f2-8ebd-4258-9528-ec4701a96426",
                                "sense_id": "9c7e3b5d-d762-3ce7-9574-6cab0caa443b",
                                "text": "„Vor etwa einer Woche hatte bereits die Weltgesundheitsorganisation (WHO) davor gewarnt, bei der Bekämpfung der Corona-Pandemie auf eine Herdenimmunität durch massenweise Ansteckungen zu setzen.“"
                            },
                            {
                                "example_id": "7977aece-a22f-474d-a6e4-89b8d4472b82",
                                "sense_id": "9c7e3b5d-d762-3ce7-9574-6cab0caa443b",
                                "text": "„Im Frühjahr haben wir ja viel über die Abiturientinnen und Abiturienten berichtet, die ihre Prüfungen während der Corona-Pandemie ablegen und deshalb auf Höhepunkte wie Abireisen oder den Abiball verzichten müssen.“"
                            },
                            {
                                "example_id": "24d33bf3-fa31-4a96-89da-ce12a99f3925",
                                "sense_id": "9c7e3b5d-d762-3ce7-9574-6cab0caa443b",
                                "text": "„Die Saison begann am 14. September 2019 und wurde am 13. März 2020 aufgrund der Corona-Pandemie vor Ende der Hauptrunde ohne Meister abgebrochen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
