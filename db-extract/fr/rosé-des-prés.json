                        "glosses": [
                            "Autre nom de l’agaric champêtre (espèce de champignons)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "68482805-abf4-4917-a55b-131c2b23b985",
                                "sense_id": "9ee92478-282d-3e5b-a487-f36afe97c3bd",
                                "text": "Je peux citer l’exemple des agarics aux lamelles roses, qui ne sont pas forcément des rosés-des-prés, ou des lépiotes, dont les formes toxiques se confondent très facilement avec des coulemelles."
                            },
                            {
                                "example_id": "11e2d27f-5197-40ec-8d33-7d2bf47e10a4",
                                "sense_id": "9ee92478-282d-3e5b-a487-f36afe97c3bd",
                                "text": "Ne pourrais-tu pas commencer par des rosés-des-prés et des mousserons ?"
                            },
                            {
