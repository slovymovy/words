                        "entry_id": "61777524-66b1-3815-b262-4c4c6ae61586",
                        "glosses": [
                            "Première chantresse d’une congrégation."
                        ],
                        "tags": [
                            "Middle-Ages"
                        ],
                        "examples": [
                            {
                                "example_id": "9ddf87ee-0601-404d-b9c8-9ef66cb65ef4",
                                "sense_id": "9ab530a4-f249-3b88-a85c-4b488cfd3746",
                                "text": "Viennent ensuite, sans qu’on puisse indiquer un ordre de prééminence : la cellérière, la sacristaine, la pitansière, l’infirmière, la vestiaire, la préchantresse, la panatière, la portière."
                            },
                            {
                                "example_id": "cac4b512-7927-40cf-819c-72e1f45e5939",
                                "sense_id": "9ab530a4-f249-3b88-a85c-4b488cfd3746",
                                "text": "Curieuse de nature, elle avait suspendu son geste pour jauger le visiteur qui déambulait aux côtés de sœur Aymonette, la préchantresse de la communauté."
                            }
                        ]
                    }
                ],
