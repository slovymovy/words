                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "grammatica",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>spook</w> 's nachts vaak door het huis als ik niet kan slapen.",
                            "target_lang_translations": {
                                "en": "I often <w>wander</w> through the house at night when I can't sleep.",
                                "fr": "J'<w>erre</w> souvent dans la maison la nuit quand je n'arrive pas à dormir."
                            }
                        },
                        {
                            "text": "Soms <w>spook</w> ik wat rond in de tuin om de planten water te geven.",
                            "target_lang_translations": {
                                "en": "Sometimes I <w>potter</w> around in the garden to water the plants.",
                                "fr": "Parfois, j'<w>erre</w> un peu dans le jardin pour arroser les plantes."
                            }
                        }
