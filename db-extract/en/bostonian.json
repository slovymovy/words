                                        "entry_id": "209b7086-2e86-38e1-b611-3dd14b1861bc",
                                        "glosses": [
                                            "mieszkaniec Bostonu"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4cee5909-51ed-4863-8f9a-a010a5ba393b",
                                                "sense_id": "7e19b0ce-0776-315a-a834-a14a4bb7097e",
                                                "text": "To otworzyło mi oczy - zwykli bostończycy nie żyli wtedy wyborami. Oni żyli zakończonymi właśnie rozgrywkami pierwszej ligi baseballowej, w której ich drużyna, Red Sox, pierwszy raz od kilkudziesięciu lat zwyciężyła!"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "96cedf05-0795-4a54-a0b5-e0b3e45903e4",
                        "source_entry_id": "8b8c964b-e406-3467-8670-3c4c83c36294",
