                    },
                    {
                        "translation_id": "324649ec-a775-44ba-bdbf-e5f9f4fbd6e8",
                        "source_entry_id": "b7dda671-031f-3e1b-bbeb-ad5fdd3a2a6b",
                        "source_sense_id": "9aa53b47-51c0-31ce-97f6-63fc538aa984",
                        "source_sense_description": "the act of approval",
                        "target_lang_word": "approbation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "approbation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "05452f6a-3d61-3f6b-bc5c-1f9594e6db2f",
                                        "entry_id": "5249b8ba-f726-3ad5-b6b3-fda143eb5d11",
                                        "glosses": [
                                            "Agrément qu’on donne à quelque chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5322f045-1190-459e-9677-7c249769e93d",
                                                "sense_id": "05452f6a-3d61-3f6b-bc5c-1f9594e6db2f",
                                                "text": "Vous recherchez moins mon avis sur le parti que vous avez à prendre que mon approbation pour celui que vous avez pris."
                                            },
                                            {
                                                "example_id": "e8e7a2cf-3e04-40b5-9247-cd244412015f",
                                                "sense_id": "05452f6a-3d61-3f6b-bc5c-1f9594e6db2f",
                                                "text": "Cette décision est confirmée par Clotaire II. Malgré l'approbation royale, elle ne fut sans doute pas rigoureusement appliquée, car le concile de Reims (615) dut la renouveler."
                                            },
                                            {
                                                "example_id": "0cd5cc25-8c7e-4f03-8945-4f9592986fb1",
                                                "sense_id": "05452f6a-3d61-3f6b-bc5c-1f9594e6db2f",
                                                "text": "Ces clauses jouent généralement lorsque l'entreprise est proche de la faillite. Toutefois, l’application de ces clauses est subordonnée à des garanties d'emploi et à l’approbation du syndicat et de la fédération d’employeurs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c593a8bc-1f77-316d-853d-5eee73519aff",
                                        "entry_id": "5249b8ba-f726-3ad5-b6b3-fda143eb5d11",
                                        "glosses": [
                                            "Jugement favorable qu’on porte de quelqu’un, de quelque chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f64a54a9-4f46-426f-a1ab-7bcd1f160f42",
                                                "sense_id": "c593a8bc-1f77-316d-853d-5eee73519aff",
                                                "text": "Staline ne supporte que l'approbation; il tient pour adversaires tous ceux qui n'applaudissent pas."
                                            },
                                            {
                                                "example_id": "93c5b642-3495-4853-80f3-f88b17b7e3c8",
                                                "sense_id": "c593a8bc-1f77-316d-853d-5eee73519aff",
                                                "text": "L’approbation a tellement moins de nuances que le dénigrement !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c7bb96a5-4ca3-42af-8460-9c0180f05a82",
                        "source_entry_id": "b7dda671-031f-3e1b-bbeb-ad5fdd3a2a6b",
