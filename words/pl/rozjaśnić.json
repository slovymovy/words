{
    "word_family": [
        "jasny",
        "jaśnieć",
        "jasność",
        "rozjaśnienie"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "76eb8bcd-79a2-35e9-9cb2-0726605c34d1",
                    "sense_definition": "uczynić coś jaśniejszym, zwiększyć natężenie światła",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "oświetlenie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Muszę <w>rozjaśnić</w> ten pokój, bo jest w nim zbyt ciemno.",
                            "target_lang_translations": {
                                "ru": "Мне нужно <w>осветить</w> эту комнату, потому что в ней слишком темно."
                            }
                        },
                        {
                            "text": "Warto <w>rozjaśnić</w> ekran, aby lepiej widzieć tekst.",
                            "target_lang_translations": {
                                "ru": "Стоит <w>сделать</w> экран <w>светлее</w>, чтобы лучше видеть текст."
                            }
                        }
                    ],
                    "antonyms": [
                        "ściemnić"
                    ],
                    "common_phrases": [
                        "rozjaśnić pokój",
                        "rozjaśnić ekran"
                    ],
                    "target_lang_definitions": {
                        "ru": "сделать что-либо более светлым, увеличить интенсивность света"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "осветить",
                                "target_lang_sense_clarification": "сделать светлее, наполнить светом"
                            },
                            {
                                "target_lang_word": "сделать светлее",
                                "target_lang_sense_clarification": "увеличить яркость (например, экрана)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "02c3e9f3-9cb2-31f3-b0d9-8625dd9fc26e",
                    "sense_definition": "uczynić coś bardziej zrozumiałym, wyjaśnić zawiłe kwestie",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "zrozumienie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ta rozmowa pomogła mi <w>rozjaśnić</w> sytuację w firmie.",
                            "target_lang_translations": {
                                "ru": "Этот разговор помог мне <w>прояснить</w> ситуацию в компании."
                            }
                        },
                        {
                            "text": "Ekspert musiał <w>rozjaśnić</w> zawiłe przepisy prawne dla klientów.",
                            "target_lang_translations": {
                                "ru": "Эксперту пришлось <w>разъяснить</w> клиентам запутанные правовые нормы."
                            }
                        }
                    ],
                    "antonyms": [
                        "skomplikować"
                    ],
                    "common_phrases": [
                        "rozjaśnić sytuację",
                        "rozjaśnić wątpliwości"
                    ],
                    "target_lang_definitions": {
                        "ru": "сделать что-либо более понятным, прояснить запутанные вопросы"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прояснить",
                                "target_lang_sense_clarification": "сделать понятным, внести ясность"
                            },
                            {
                                "target_lang_word": "разъяснить",
                                "target_lang_sense_clarification": "объяснить что-то сложное"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d7aaf3dc-fce3-347a-8b58-fe94bcde8416",
                    "sense_definition": "stać się jaśniejszym, nabrać jasności",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "oświetlenie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Niebo zaczęło <w>rozjaśniać</w> się po burzy.",
                            "target_lang_translations": {
                                "ru": "Небо начало <w>светлеть</w> после грозы."
                            }
                        },
                        {
                            "text": "Wraz ze wschodem słońca horyzont zaczął <w>rozjaśniać</w> się.",
                            "target_lang_translations": {
                                "ru": "С восходом солнца горизонт начал <w>светлеть</w>."
                            }
                        }
                    ],
                    "antonyms": [
                        "ściemnić się"
                    ],
                    "common_phrases": [
                        "niebo rozjaśnia się"
                    ],
                    "target_lang_definitions": {
                        "ru": "стать светлее, приобрести яркость"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "светлеть",
                                "target_lang_sense_clarification": "становиться светлее (о небе, горизонте)"
                            },
                            {
                                "target_lang_word": "проясняться",
                                "target_lang_sense_clarification": "становиться ясным, светлым после темноты или непогоды"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "43f30f3f-66b7-3566-a7ae-6077efa4c43b",
                    "sense_definition": "zmienić kolor włosów na jaśniejszy",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "wygląd",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Postanowiła <w>rozjaśnić</w> włosy przed latem.",
                            "target_lang_translations": {
                                "ru": "Она решила <w>осветлить</w> волосы перед летом."
                            }
                        },
                        {
                            "text": "Fryzjer doradził jej, jak bezpiecznie <w>rozjaśnić</w> pasemka.",
                            "target_lang_translations": {
                                "ru": "Парикмахер посоветовал ей, как безопасно <w>осветлить</w> пряди."
                            }
                        }
                    ],
                    "common_phrases": [
                        "rozjaśnić włosy"
                    ],
                    "target_lang_definitions": {
                        "ru": "изменить цвет волос на более светлый"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "осветлить",
                                "target_lang_sense_clarification": "сделать волосы светлее (о краске или процедуре)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cf8b2af2-77b6-3523-9e96-d5c4753eab5c",
                    "sense_definition": "stawać się pogodnym, radosnym, poprawiać sobie nastrój",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "emocje",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Jej twarz zaczęła <w>rozjaśniać</w> się, gdy usłyszała dobre wieści.",
                            "target_lang_translations": {
                                "ru": "Её лицо начало <w>проясняться</w>, когда она услышала хорошие новости."
                            }
                        },
                        {
                            "text": "Wspomnienia o wakacjach potrafią <w>rozjaśnić</w> nawet najgorszy dzień.",
                            "target_lang_translations": {
                                "ru": "Воспоминания об отпуске могут <w>скрасить</w> даже самый плохой день."
                            }
                        }
                    ],
                    "common_phrases": [
                        "rozjaśnić twarz"
                    ],
                    "target_lang_definitions": {
                        "ru": "становиться радостным, улучшать настроение"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "просиять",
                                "target_lang_sense_clarification": "стать радостным, выражать счастье (о лице)"
                            },
                            {
                                "target_lang_word": "скрасить",
                                "target_lang_sense_clarification": "сделать что-то более приятным, поднять настроение"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}