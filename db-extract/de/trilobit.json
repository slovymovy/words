                "senses": [
                    {
                        "sense_id": "f242796c-0622-3d93-ae55-cf447ed6d3aa",
                        "entry_id": "1a7b119a-6bf9-354c-9215-9693c4a6ba9e",
                        "glosses": [
                            "Vertreter einer Klasse ausgestorbener mariner Gliederfüßer"
                        ],
                        "tags": [
                            "Archäozoologie"
                        ],
                        "examples": [
                            {
                                "example_id": "bf7f04b2-9063-490d-be63-f182c3b8fb35",
                                "sense_id": "f242796c-0622-3d93-ae55-cf447ed6d3aa",
                                "text": "Die Trilobiten sind wichtige Leitfossilien."
                            },
                            {
                                "example_id": "b093595d-674e-405b-aee2-df8aa0f12b80",
                                "sense_id": "f242796c-0622-3d93-ae55-cf447ed6d3aa",
                                "text": "Trilobiten haben einen Rückenpanzer und gut entwickelte Augen."
                            },
                            {
                                "example_id": "47b3592c-ef51-463d-b962-a9bd9a47e046",
                                "sense_id": "f242796c-0622-3d93-ae55-cf447ed6d3aa",
                                "text": "Die Trilobiten sind eine sehr charakteristische Gruppe für das Paläozoikum."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ccb14634-7c0e-4ea6-9425-99093328302b",
                        "source_entry_id": "1a7b119a-6bf9-354c-9215-9693c4a6ba9e",
                        "source_sense_id": "f242796c-0622-3d93-ae55-cf447ed6d3aa",
                        "source_sense_description": "Zoologie, Archäozoologie: Vertreter einer Klasse ausgestorbener mariner Gliederfüßer",
                        "target_lang_word": "trilobite",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "trilobite",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0c05e4c6-0564-3bf3-bbbe-3cb66aae14b4",
                                        "entry_id": "63cb520e-212c-3726-958f-a064529375d1",
                                        "glosses": [
                                            "An extinct arthropod of the class Trilobita, whose body had three large lobes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc275eed-0c8e-4d2d-ab6d-44e3656a04d3",
                                                "sense_id": "0c05e4c6-0564-3bf3-bbbe-3cb66aae14b4",
                                                "text": "When you look at a Precambrian trilobite in the lobby of a New York bank, it is difficult to speculate about its primeval environment."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e278c9a0-6e96-49cb-b588-6f2e47c5cecb",
                        "source_entry_id": "1a7b119a-6bf9-354c-9215-9693c4a6ba9e",
                        "source_sense_id": "f242796c-0622-3d93-ae55-cf447ed6d3aa",
                        "source_sense_description": "Zoologie, Archäozoologie: Vertreter einer Klasse ausgestorbener mariner Gliederfüßer",
                        "target_lang_word": "trilobite",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "trilobite",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "030217df-c012-3d2b-a555-3765a7efe5b0",
                                        "entry_id": "931d91b2-9567-368d-a306-400a4841bd77",
                                        "glosses": [
                                            "Crustacé de l’époque primaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1bffb2b9-96b8-4a32-867e-25c34c2532ef",
                                                "sense_id": "030217df-c012-3d2b-a555-3765a7efe5b0",
                                                "text": "De gros crustacés à l’aspect de « cochons de saint Antoine » (cloportes), divisés de la tête à la queue en trois lobes, et aussi en trois lobes de la gauche à la droite, et que, pour cette double raison, on nomme des Trilobites, erraient aux alentours des rivages primitifs ; […]."
                                            },
                                            {
                                                "example_id": "d985dc95-1a6e-4bc9-9d05-241de13316cc",
                                                "sense_id": "030217df-c012-3d2b-a555-3765a7efe5b0",
                                                "text": "Les faunes « de type Burgess » sont réputées pour leur diversité tout à fait extraordinaire et pour avoir livré, aux côtés d'organismes qui nous sont relativement familiers (échinodermes, mollusques, trilobites), de très nombreux restes de créatures beaucoup plus étranges, particulièrement difficiles à classer dans les groupes « traditionnels »."
                                            },
                                            {
                                                "example_id": "27a45a08-6a1a-44de-af97-038bf975eeff",
                                                "sense_id": "030217df-c012-3d2b-a555-3765a7efe5b0",
                                                "text": "On trouve dans le silurien des crustacés aux formes bizarres, tels que les trilobites."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6c9b8224-312e-4749-9d32-d77f1f61210d",
                        "source_entry_id": "1a7b119a-6bf9-354c-9215-9693c4a6ba9e",
