                                    {
                                        "sense_id": "b32ab870-2316-3628-8f42-bce43381d133",
                                        "entry_id": "09a2dac0-bc12-38f4-9f61-e5be3cf79941",
                                        "glosses": [
                                            "kwaadaardige software die de toegang tot bestanden op een computer of server blokkeert door deze te versleutelen, waarna er bijvoorbeeld geld gevraagd wordt om weer toegang te kunnen krijgen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "046a9819-6602-4c16-b13f-49c90bf8870f",
                                                "sense_id": "b32ab870-2316-3628-8f42-bce43381d133",
                                                "text": "Wereldwijd raken computers geïnfecteerd met gijzelsoftware."
                                            },
                                            {
                                                "example_id": "932a4cfa-4924-4f39-9a19-7fd423543660",
                                                "sense_id": "b32ab870-2316-3628-8f42-bce43381d133",
                                                "text": "De UM werd eind 2019 volledig lamgelegd door criminele hackers. Als gevolg van de aanval met de gijzelsoftware konden studenten, onderzoekers en andere medewerkers dagenlang onder meer niet e-mailen, beperkt gebruikmaken van het internet en hadden zij geen toegang tot bestanden op de servers van de universiteit."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
