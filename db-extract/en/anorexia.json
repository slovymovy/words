                        "cross_references": [
                            {
                                "target_word": "anorexie",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "245493b2-6e16-3864-a530-0833360304bc",
                                        "entry_id": "c21ad413-3a12-3e19-b5ea-dc46cd20254c",
                                        "glosses": [
                                            "verlies van eetlust"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "071a0633-1340-487f-b157-002aa94d0aee",
                                                "sense_id": "245493b2-6e16-3864-a530-0833360304bc",
                                                "text": "Alleen al de hoofdstuktitels van het deel waarin Johannisson de toen gangbare 'kwalen' en bijbehorende geneeswijzen bespreekt, vormen een encyclopedie van ellende die je de moed voor welke wandeling dan ook zou ontnemen: 'ziekelijkheid, menstruatie, zwangerschap, menopauze, migraine, chlorose, anorexie, neurasthenie, hysterie, krankzinnigheid'."
                                            },
                                            {
                                                "example_id": "1a8c6bab-f52f-4498-8d4d-4a49aabaf68a",
                                                "sense_id": "245493b2-6e16-3864-a530-0833360304bc",
                                                "text": "Patiënten met legionellose (veteranenziekte) lijden meestal aan een ernstige longontsteking, hebben hoge koorts, maar daarnaast kunnen zich ook verschijnselen voordoen als diarree, anorexie, spierpijn en verwardheid."
                                            },
                                            {
                                                "example_id": "92d9c296-f6b6-48e2-b61f-19e5af77bd74",
                                                "sense_id": "245493b2-6e16-3864-a530-0833360304bc",
                                                "text": "De president van het orkest werd later opgenomen in een vooruitstrevende zenuwinrichting in Bazel, waar hij een holistische behandeling onderging voor anorexie en klachten die verband hielden met alcoholverslaving."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2d745394-6a81-478c-a1d6-93604e709e09",
                        "source_entry_id": "ea0c1309-9355-3827-9543-4dfcb5594fe4",
                        "source_sense_description": "loss of appetite",
                        "target_lang_word": "anorexie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anorexie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0777667d-c678-3970-a174-6a1551dd49af",
                                        "entry_id": "d8ba4138-9e09-3d28-a385-926d79f8566b",
                                        "glosses": [
                                            "Absence, perte d’appétit."
                                        ],
                                        "tags": [
                                            "Nutrition"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fef50b06-674e-4144-9559-897fb1978836",
                                                "sense_id": "0777667d-c678-3970-a174-6a1551dd49af",
                                                "text": "En psychiatrie, l’anorexie est un des symptômes principaux du syndrome dépressif."
                                            },
                                            {
                                                "example_id": "72318349-8e6a-4c79-bdd3-32c8e969d678",
                                                "sense_id": "0777667d-c678-3970-a174-6a1551dd49af",
                                                "text": "L’anorexie restrictive est une addiction qui fait croire au contrôle alors qu’elle conduit le corps à sa destruction."
                                            },
                                            {
                                                "example_id": "95f50676-aa3b-4322-a44e-82286d0a05d2",
                                                "sense_id": "0777667d-c678-3970-a174-6a1551dd49af",
                                                "text": "L’isolement et l’anxiété engendrés par la pandémie de COVID-19 ont fait augmenter les cas de troubles alimentaires, selon des organismes de soutien albertains.\n Sophie Balisky a souffert d'anorexie et de boulimie pendant la majeure partie de son adolescence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f816388e-ae3e-39e2-9c3f-0f18ceb898cf",
                                        "entry_id": "d8ba4138-9e09-3d28-a385-926d79f8566b",
                                        "glosses": [
                                            "Sensation de satiété qui se rencontre dans nombre de maladies infectieuses (cancer, tuberculose…) et des affections du tube digestif."
                                        ],
                                        "tags": [
                                            "Nosologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ea2488a8-936c-49dd-9d75-f2fe1fb338fe",
                                                "sense_id": "f816388e-ae3e-39e2-9c3f-0f18ceb898cf",
                                                "text": "L’anorexie ne traduit pas forcément une symptomatologie psychopathologique, notamment dépressive, elle peut également relever de multiples étiologies somatiques."
                                            },
                                            {
                                                "example_id": "4ab0b948-338a-42b2-a271-94dba2a78261",
                                                "sense_id": "f816388e-ae3e-39e2-9c3f-0f18ceb898cf",
                                                "text": "Selon la façon dont les anticorps vont se lier à cette hormone et le temps durant lequel ils vont le faire, cela déclenchera soit une sensation de satiété (anorexie), soit l’absence de cette même sensation (boulimie, hyperphagie)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "42373a9b-3b8d-461c-868e-565daba85c13",
                        "source_entry_id": "ea0c1309-9355-3827-9543-4dfcb5594fe4",
                        "source_sense_description": "loss of appetite",
