                    },
                    {
                        "form_id": "f6f6e954-add8-4cd6-96ce-5dcb43a055f2",
                        "entry_id": "b321b9f4-982b-3e9a-998f-c4efd746819a",
                        "tags": [
                            "dative",
                            "singular"
                        ],
                        "form": "der Rockmusik"
                    },
                    {
                        "form_id": "f3355e0f-db18-4b0e-9576-5c054351076f",
                        "entry_id": "b321b9f4-982b-3e9a-998f-c4efd746819a",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "die Rockmusik"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6354b946-04be-3a5d-b1d7-ba844ceec043",
                        "entry_id": "b321b9f4-982b-3e9a-998f-c4efd746819a",
                        "glosses": [
                            "Musikrichtung, die sich aus dem Rock 'n' Roll entwickelt hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aea835fa-773e-4dcf-9951-c12781688e8d",
                                "sense_id": "6354b946-04be-3a5d-b1d7-ba844ceec043",
                                "text": "Rockmusik und elektrisch verstärkte Gitarre gehören für viele Musiker untrennbar zusammen."
                            },
                            {
                                "example_id": "d0c3293e-b07d-494b-a681-d1d7a533c063",
                                "sense_id": "6354b946-04be-3a5d-b1d7-ba844ceec043",
                                "text": "„Es handelte sich praktisch nur noch darum, daß einzelne Personen nachdenklich vor sich hinschauten, zur Rockmusik träumten oder auch ein wenig dämmerten und vielleicht zwei, drei Teilnehmer ab und zu noch miteinander raunten oder murmelten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "016ab1cb-6a84-4c79-9352-83e8c0f40e14",
                        "source_entry_id": "b321b9f4-982b-3e9a-998f-c4efd746819a",
                        "source_sense_id": "6354b946-04be-3a5d-b1d7-ba844ceec043",
                        "target_lang_word": "摇滚乐",
                        "target_lang_code": "zh",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "e2a53db3-4937-48e7-ba83-b30d4895610f",
                        "source_entry_id": "b321b9f4-982b-3e9a-998f-c4efd746819a",
                        "source_sense_id": "6354b946-04be-3a5d-b1d7-ba844ceec043",
                        "target_lang_word": "rock music",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rock music",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1bd80f46-9207-3e23-a373-d4ddfcebed33",
                                        "entry_id": "54f96eb6-d426-3c92-bab4-a954728b0ef6",
                                        "glosses": [
                                            "A broad genre of popular music, including especially those styles ultimately derived from rock and roll, employing electrical amplification, heavy use of guitars, 4/4 time with strong percussive rhythm on beats two and four (backbeat), and usually themes of bold wildness, rebellion, and sexuality."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a6ed3e9f-1cf9-4e14-b929-23cbaf39e470",
                        "source_entry_id": "b321b9f4-982b-3e9a-998f-c4efd746819a",
                        "source_sense_id": "6354b946-04be-3a5d-b1d7-ba844ceec043",
                        "target_lang_word": "rock",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rock",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c6e9db14-1e36-3696-ad5c-45b2ec0bfd1c",
                                        "entry_id": "e5d68c0b-e4c7-3d71-8a1a-66022911b3ee",
                                        "glosses": [
                                            "Style de musique caractérisé par une pulsation souvent basique — en général 4/4 — avec des guitares le plus souvent électriques, une guitare basse, une batterie, quelquefois des pianos, claviers ou synthétiseurs et au moins un chanteur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe6701ef-e7eb-4033-abe4-0768c62d3a06",
                                                "sense_id": "c6e9db14-1e36-3696-ad5c-45b2ec0bfd1c",
                                                "text": "Il est vrai qu’à l’époque le jazz — ou plus précisément sa version allégée, la musique syncopée, dernière vogue venue des États-Unis — constitue (comme le fera le rock plus tard) l’ossature de la variété."
                                            },
                                            {
                                                "example_id": "2ea074f6-01c9-4087-b1e8-92cc34a9d3df",
                                                "sense_id": "c6e9db14-1e36-3696-ad5c-45b2ec0bfd1c",
                                                "text": "Série de tangos, casatchoks, rocks lourdingues."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6f13a7a8-40d4-361a-8312-2d5b27ca70e4",
                                        "entry_id": "e5d68c0b-e4c7-3d71-8a1a-66022911b3ee",
                                        "glosses": [
                                            "Danse pratiquée sur cette musique."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "rock",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8a0f5dad-9cd6-3156-afdc-890b26bb7aba",
                                        "entry_id": "f437eae1-dd6e-3cdb-bd22-7e1d0d1418a3",
                                        "glosses": [
                                            "Aigle fabuleux des contes arabes, qui est supposé être d’une force et d’une grandeur prodigieuses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5196f919-6235-45df-9f18-c9319302e610",
                                                "sense_id": "8a0f5dad-9cd6-3156-afdc-890b26bb7aba",
                                                "text": "C’est moi, l’oiseau Rock, qui dois être,\nDe ce monde, seigneur et maître,\nEt je suis roi de par mon vol."
                                            },
                                            {
                                                "example_id": "eeca9fb7-67ea-469a-9619-764566774507",
                                                "sense_id": "8a0f5dad-9cd6-3156-afdc-890b26bb7aba",
                                                "text": "[Une statue] a une tête d'aigle, et il nous paraît très vraisemblable qu'elle nous offre l'image vulgaire du nesrokh, l'aigle tout-puissant, divinité primordiale de la théogonie assyrienne, le prototype de l'oiseau fabuleux des contes arabes, de cet aigle gigantesque qui a conservé le nom de rock, finale du nom primitif de la divinité oubliée."
                                            },
                                            {
                                                "example_id": "f3bd6b63-47a6-407d-b678-b1588bca406e",
                                                "sense_id": "8a0f5dad-9cd6-3156-afdc-890b26bb7aba",
                                                "text": "Alors, du côté de la mer, un âcre appel déchira la nuit : c’était comme la plainte d’un jeune cyclope en dentition — ou le cri de guerre de l’oiseau appelé rock quand il se précipite sur une foule d’éléphants."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
