                                        "sense_id": "bf07d421-926b-342f-96e3-5a1b2bb73146",
                                        "entry_id": "cdccd819-2f36-3593-a5f5-650596f6a3ab",
                                        "glosses": [
                                            "nazewnictwo osobowe, będące przedmiotem badań antroponimii (1.1)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad075ad8-7efa-48ad-8630-d3c025fe4b5d",
                                                "sense_id": "bf07d421-926b-342f-96e3-5a1b2bb73146",
                                                "text": "Profesor był znanym specjalistą w zakresie białoruskiej i ukraińskiej antroponimii."
