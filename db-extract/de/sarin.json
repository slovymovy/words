                        "sense_id": "7ec2c7b7-b4ad-3848-aeae-f81aef72af2c",
                        "entry_id": "25d671ce-b7df-322d-b8d9-72c062eb01ea",
                        "glosses": [
                            "chemischer Kampfstoff, der als Nervengift wirkt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "535caaf1-db46-4dc7-97de-fb44cd96d839",
                                "sense_id": "7ec2c7b7-b4ad-3848-aeae-f81aef72af2c",
                                "text": "„Schutz gegen das Eindringen von Sarin in den Körper bietet daher nur ein Ganzkörper-Schutzanzug mit Atemschutzmaske.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
