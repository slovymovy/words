                    {
                        "translation_id": "b62bb0f7-adfc-460f-bbec-a6a033bc7314",
                        "source_entry_id": "4b4e3c8b-3033-33d6-8a76-2d132f85f748",
                        "source_sense_description": "the orographic features of a region",
                        "target_lang_word": "релье́ф",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "релье́ф",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "b40859c3-2552-3b72-b61e-bca8b6253576",
                                        "entry_id": "d77f9632-10ac-32a7-81f4-722b0a22b8e3",
                                        "glosses": [
                                            "совокупность выступов и впадин на какой-либо поверхности"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ea9eb21-7fc8-4e57-a9ea-ec96fe8ec9f0",
                                                "sense_id": "b40859c3-2552-3b72-b61e-bca8b6253576",
                                                "text": "В большинстве случаев бетонная плитка имеет неровный рельеф и стилизована под кирпич."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "15ac9b21-972e-3861-bc81-b2b62aaa078b",
                                        "entry_id": "d77f9632-10ac-32a7-81f4-722b0a22b8e3",
                                        "glosses": [
                                            "геогр. совокупность выступов и впадин земной поверхности"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bcc9d470-4763-4e3e-902a-cfb11617ec06",
                                                "sense_id": "15ac9b21-972e-3861-bc81-b2b62aaa078b",
                                                "text": "Страна имеет гористый рельеф и сильно изрезанную береговую линию, составляющую почти 1500 км."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b6291270-eedd-3a63-abf7-87fb9e54c391",
                                        "entry_id": "d77f9632-10ac-32a7-81f4-722b0a22b8e3",
                                        "glosses": [
                                            "искусств. разновидность скульптуры, выпуклое изображение на плоскости, создаваемое с помощью объёма, частично выступающего из плоскости фона"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "98d79a39-9c70-4881-978f-3189cfc46493",
                                                "sense_id": "b6291270-eedd-3a63-abf7-87fb9e54c391",
                                                "text": "В настоящее время рельеф как способ украсить интерьер и экстерьер здания используется почти повсеместно."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
