                "senses": [
                    {
                        "sense_id": "ded26289-2190-3021-bef7-b9b7d31040f9",
                        "entry_id": "19869f97-a412-3502-acb2-f23559dd9ec8",
                        "glosses": [
                            "landwirtschaftlicher Betrieb, in dem eine Vollbeschäftigung des Bauern nicht möglich ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "afa92ae2-46d6-42d0-9061-ec3980415469",
                                "sense_id": "ded26289-2190-3021-bef7-b9b7d31040f9",
                                "text": "„In diesem Fall aber kann ein Parzellenbetrieb nur nebenberuflich genutzt werden.“"
                            },
                            {
                                "example_id": "bb78cb7c-9540-4eb9-8fad-569c1beea0ed",
                                "sense_id": "ded26289-2190-3021-bef7-b9b7d31040f9",
                                "text": "„Sicherlich nicht der kleine Parzellenbetrieb des landwirtschaftlichen Arbeiters oder das Gut des auf Weideland wirtschaftenden Kleinpächters.“"
                            },
                            {
                                "example_id": "812be0c1-c888-4345-8006-bee4fb8702b7",
                                "sense_id": "ded26289-2190-3021-bef7-b9b7d31040f9",
                                "text": "„Der Parzellenbetrieb selbst bleibt darum aber doch ein selbständiges Unternehmen.“"
                            },
                            {
                                "example_id": "10f70788-3421-4d06-8199-96cc5bcbfab0",
                                "sense_id": "ded26289-2190-3021-bef7-b9b7d31040f9",
                                "text": "„Bei einem Häusler oder Einlieger ist der Parzellenbetrieb immer nur Nebenerwerb oder sollte es wenigstens sein, niemals aber Haupterwerb.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
