                    {
                        "translation_id": "4582a99f-cc87-4cdc-ad50-4777e9f121b3",
                        "source_entry_id": "6d3e16aa-86a7-3c6b-9057-8d63f0849363",
                        "target_lang_word": "turnip",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "turnip",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6afd8d4b-28df-3991-8714-6a203094bb42",
                                        "entry_id": "c68ec39a-8ac1-3478-928d-ad74a1c9e064",
                                        "glosses": [
                                            "The white root of a yellow-flowered plant, Brassica rapa, grown as a vegetable and as fodder for cattle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d7b1dd6f-2242-43b9-ae8e-fdea72b21de7",
                                                "sense_id": "6afd8d4b-28df-3991-8714-6a203094bb42",
                                                "text": "The ancient Roman gastronomists considered the turnip, when prepared in the following manner, a dish fit for epicures: \"After boiling, extract the water from them, and season with cummin, rue, or benzoin, pounded in a mortar; afterward add honey, vinegar, gravy, and boiled grapes. Allow the whole to simmer, and serve.\""
                                            },
                                            {
                                                "example_id": "77879593-1acb-4086-aab4-f9d853e91391",
                                                "sense_id": "6afd8d4b-28df-3991-8714-6a203094bb42",
                                                "text": "In general, beets, carrots, and turnips are all of aphrodisiac value in erotic dietary."
                                            },
                                            {
                                                "example_id": "d77f6b9d-70df-4778-b411-200b09b7f9a1",
                                                "sense_id": "6afd8d4b-28df-3991-8714-6a203094bb42",
                                                "text": "The turnip is one of the lordliest vegetables in the world; its broth is practically a soup in itself."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "41bcc13f-fbcd-379e-978f-b277d1e99ce1",
                                        "entry_id": "c68ec39a-8ac1-3478-928d-ad74a1c9e064",
                                        "glosses": [
                                            "The yellow root of a related plant, the swede or Brassica napus."
                                        ],
                                        "tags": [
                                            "Atlantic-Canada",
                                            "Cornwall",
                                            "Ireland",
                                            "Northern-England",
                                            "Scotland"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e0320db1-458b-3c88-a5e6-0679bc4a947a",
                                        "entry_id": "c68ec39a-8ac1-3478-928d-ad74a1c9e064",
                                        "glosses": [
                                            "The white root of Raphanus sativus var. longipinnatus, also known as a daikon."
                                        ],
                                        "tags": [
                                            "Hong-Kong"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "75f3b8e1-2e80-39ee-8177-8b466266be81",
                                        "entry_id": "c68ec39a-8ac1-3478-928d-ad74a1c9e064",
                                        "glosses": [
                                            "The root of the yam bean, Pachyrhizus erosus; jicama."
                                        ],
                                        "tags": [
                                            "Malaysia",
                                            "Singapore",
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f75445db-cec0-3d8b-8f2b-5fde3e35baee",
                                        "entry_id": "c68ec39a-8ac1-3478-928d-ad74a1c9e064",
                                        "glosses": [
                                            "A large, heavy pocket watch, so called because its profile resembled the vegetable."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "db4b3683-7168-39f9-bc30-4593f236d888",
                                        "entry_id": "c68ec39a-8ac1-3478-928d-ad74a1c9e064",
                                        "glosses": [
                                            "A fool or simpleton."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f9df86d-482e-4b1a-997d-67038f0b14da",
                                                "sense_id": "db4b3683-7168-39f9-bc30-4593f236d888",
                                                "text": "\"Dost thou not believe, thou twittering turnip?\""
                                            },
                                            {
                                                "example_id": "844861ba-ec9b-4b9f-9471-1e202ec79865",
                                                "sense_id": "db4b3683-7168-39f9-bc30-4593f236d888",
                                                "text": "You absolute turnip, you.\nHannah replaced the clipboard in her lap and pretended to write Very Serious notes. Thank God it was dark in the rear of the studio. No one could see the tomato-colored tidal wave surging up her neck."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "turnip",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "34dc82e9-0d97-3ca6-8fab-e4d5a1c146f5",
                                        "entry_id": "b01c6e7c-6e21-352f-b907-b4f38d825f1b",
                                        "glosses": [
                                            "To plant with turnips."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "58947811-ac8d-4a6a-bed9-f0e6b3435b66",
                                                "sense_id": "34dc82e9-0d97-3ca6-8fab-e4d5a1c146f5",
                                                "text": "This identical field has been turniped before, and to good account, in a favourable winter."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1d7bfbf7-b472-3559-b1e3-5e95049bec45",
                                        "entry_id": "b01c6e7c-6e21-352f-b907-b4f38d825f1b",
                                        "glosses": [
                                            "To feed or graze (livestock) on turnips."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "69233f9f-2632-4a75-821b-8d695355a2d0",
                                                "sense_id": "1d7bfbf7-b472-3559-b1e3-5e95049bec45",
                                                "text": "The Leicesters and half-breds are purchased by farmers who keep no breeding stock: they are well turniped during the winter, and clipped and fattened in the following season."
                                            },
                                            {
                                                "example_id": "e927d82c-7217-4189-9f2e-89ff065a0568",
                                                "sense_id": "1d7bfbf7-b472-3559-b1e3-5e95049bec45",
                                                "text": "This system of turniping is found to encourage the growth and muscular development of young stock."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "17f26feb-7a39-4a91-bd57-201df18dd63f",
                        "source_entry_id": "6d3e16aa-86a7-3c6b-9057-8d63f0849363",
                        "target_lang_word": "navet",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "navet",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fd7e51ef-c684-3784-8683-2f95e26d5caf",
                                        "entry_id": "50952b98-4435-35fe-a9f6-5da94b90cbfa",
                                        "glosses": [
                                            "Plante de la famille des Brassicacées, que l’on cultive pour sa racine tuberculée comestible."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe56b3ea-f05d-42f9-89d1-b04c4e58b121",
                                                "sense_id": "fd7e51ef-c684-3784-8683-2f95e26d5caf",
                                                "text": "On peut semer le navet en deux saisons : au printemps et à la fin de l’été."
                                            },
                                            {
                                                "example_id": "adbf23fe-a987-4a8b-a6ff-96e440ac89f6",
                                                "sense_id": "fd7e51ef-c684-3784-8683-2f95e26d5caf",
                                                "text": "Une grasse fumée s’élève en tourbillonnant du potage abondamment garni de choux, navets et autres légumes."
                                            },
                                            {
                                                "example_id": "5f3cbe37-f5d3-43f7-981f-5a8c0569d924",
                                                "sense_id": "fd7e51ef-c684-3784-8683-2f95e26d5caf",
                                                "text": "Le navet, désigné parfois sous les noms de rabioule ou turnep (en anglais turnip), est cultivé pour sa racine pivotante et charnue que l’on consomme après cuisson."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "51cbd0f0-f0ef-39e5-92b2-86f955ca55f1",
                                        "entry_id": "50952b98-4435-35fe-a9f6-5da94b90cbfa",
                                        "glosses": [
                                            "Racine tubérisée de cette plante."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ff60e16d-b96b-4fe8-8d7e-0e470423806c",
                                                "sense_id": "51cbd0f0-f0ef-39e5-92b2-86f955ca55f1",
                                                "text": "On entendait, sur le pavé, le craquement des roues des hautes charrettes chargées de choux, de navets, de poireaux, de carottes […]."
                                            },
                                            {
                                                "example_id": "c64c96f0-dce0-4c4c-96a0-a4fbb25de479",
                                                "sense_id": "51cbd0f0-f0ef-39e5-92b2-86f955ca55f1",
                                                "text": "Comme le rutabaga, le navet a une mauvaise et tenace réputation. Légume de disette, de pauvres, d’économie paysanne pour le navet et légume de restriction, de guerre pour le rutabaga. Pourtant, nos voisins anglais adorent le navet, il est un de leurs légumes de base ; […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3bc13edd-7178-3af2-971e-48bad4da87e9",
                                        "entry_id": "50952b98-4435-35fe-a9f6-5da94b90cbfa",
                                        "glosses": [
                                            "Mauvais film."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e1baec71-985d-4b93-80f7-51b206730098",
                                                "sense_id": "3bc13edd-7178-3af2-971e-48bad4da87e9",
                                                "text": "Finalement l'histoire de ma vie est d'une si triste banalité qu'elle ne mériterait même pas le privilège d'inspirer un scénario nullard pour navet égyptien."
                                            },
                                            {
                                                "example_id": "2f2a0c2b-7151-4d8c-8cc1-11e65fb8667d",
                                                "sense_id": "3bc13edd-7178-3af2-971e-48bad4da87e9",
                                                "text": "L’ironie du sort c’est qu’un nanar, à la différence d’un navet, devient culte. J'ai fait des navets mais pas de nanars, hélas..."
                                            },
                                            {
                                                "example_id": "ded2580e-5ab3-4e22-bf1a-c56566a258a6",
                                                "sense_id": "3bc13edd-7178-3af2-971e-48bad4da87e9",
                                                "text": "Les esprits brillants adorent se moquer des navets et cʼest principalement pour cela quʼils les regardent avec délectation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b501d817-5b7a-3992-8b2e-c620967aa580",
                                        "entry_id": "50952b98-4435-35fe-a9f6-5da94b90cbfa",
                                        "glosses": [
                                            "Œuvre artistique de mauvaise qualité."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bdc86bb8-a17f-4e30-b96a-83748741f3db",
                                                "sense_id": "b501d817-5b7a-3992-8b2e-c620967aa580",
                                                "text": "Le buste de Macaulay à Westminster n’a pas de valeur artistique et donc il ne représente, du grand historien, qu’une effigie privée d`âme. Cependant je serais bien demeuré une heure à méditer devant ce navet consacré à un homme de génie, comme devant l’abîme entrouvert du grand passé de l’île mystérieuse et qui s’est composé, pour son usage personnel, toute une civilisation à part."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
