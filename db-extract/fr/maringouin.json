                    {
                        "translation_id": "19f3b9d1-6f68-4c58-90ac-47f7518a0c45",
                        "source_entry_id": "cabcc582-3051-3b53-9abf-2209a62b8436",
                        "source_sense_id": "b9cdf92d-330d-3548-809e-12f942b1aadd",
                        "target_lang_word": "Schnake",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schnake",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9f70e6d0-4fcc-3b98-a6bc-15b7900b79bc",
                                        "entry_id": "4ca954d2-fd97-357c-a8c2-559184971083",
                                        "glosses": [
                                            "nicht stechendes Insekt aus der Familie der Tipulidae"
                                        ],
                                        "tags": [
                                            "jargon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b9b38dad-5350-46e0-98b3-12391b3cf71c",
                                                "sense_id": "9f70e6d0-4fcc-3b98-a6bc-15b7900b79bc",
                                                "text": "Vor Schnaken habe ich keine Angst, weil die nicht stechen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d1909479-b1d0-3dcc-ad7b-0a058f1b00d4",
                                        "entry_id": "4ca954d2-fd97-357c-a8c2-559184971083",
                                        "glosses": [
                                            "(in vielen Arten vorkommende) sich insbesondere in stehenden Gewässern entwickelnde dünnleibige, langbeinige Mücke mit Fühlern und Stechrüssel (Culicidae), deren Männchen Pflanzensaft und deren Weibchen Tier- und Menschenblut saugen, wodurch oft gefährliche Krankheiten übertragen werden"
                                        ],
                                        "tags": [
                                            "regional"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "560f6d0f-0aed-4b7b-a5eb-1337f2e5242d",
                                                "sense_id": "d1909479-b1d0-3dcc-ad7b-0a058f1b00d4",
                                                "text": "In Ketsch auf der Insel zwischen Rhein und dem Altarm kann man gar im Sommer nicht schnell genug mit den Händen schlagen, um die blutlüsternen Schnaken zu vertreiben."
                                            },
                                            {
                                                "example_id": "2ddda4d7-e3bb-4731-abb3-cde0aefee6f3",
                                                "sense_id": "d1909479-b1d0-3dcc-ad7b-0a058f1b00d4",
                                                "text": "„Oliver Wolter kannte den Unterschied zwischen Bremse und Schnake nicht.“"
                                            },
                                            {
                                                "example_id": "a22d7b37-3b91-44f4-af2a-fcb5d013202c",
                                                "sense_id": "d1909479-b1d0-3dcc-ad7b-0a058f1b00d4",
                                                "text": "„Die Luft war voll von giftigen Schnaken, die uns peinigten und uns im Gesicht sehr schmerzhafte Pusteln beibrachten; aber ich hatte mich verpflichtet, dort acht Tage zu bleiben, und wäre in großer Verlegenheit gewesen, einen Vorwand zu finden, um diese Zeit abzukürzen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
