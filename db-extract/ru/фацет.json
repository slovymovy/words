                                        "glosses": [
                                            "eckige, geschliffene Fläche; eine der vielen Flächen eines geschliffenen Edelsteins"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a0afeeb-3e89-46a2-a2ac-f7ab3ea0178e",
                                                "sense_id": "4c6cb0fb-a016-3591-9380-e937acb1e151",
                                                "text": "Bei dieser Art von Schliff müssen hunderte Facetten geschliffen werden."
                                            },
                                            {
                                                "example_id": "be06c723-59b9-4606-84a7-e77b77d1b5d4",
                                                "sense_id": "4c6cb0fb-a016-3591-9380-e937acb1e151",
                                                "text": "„Bilder der Vergangenheit Frankreichs, die einen verfolgen, die sich über und über spiegeln wie die Facetten eines unerschöpflichn Edelsteins.“"
                                            },
                                            {
                                                "example_id": "4eceed32-b35f-4e95-a231-f769dc7f4751",
                                                "sense_id": "4c6cb0fb-a016-3591-9380-e937acb1e151",
                                                "text": "„In den Facetten bricht sich verwirrend das Licht, in den vorüberdrehenden Facetten spiegeln sich die Anwesenden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "496f80b5-eab8-3bd5-852f-bb3d8986179d",
