                "senses": [
                    {
                        "sense_id": "3254efcc-0c21-3f61-8aed-b8cad28df6a6",
                        "entry_id": "9b1f5948-74e9-397f-bde5-c25e4046eb14",
                        "glosses": [
                            "Fehlen von Kenntnissen; Frage innerhalb eines Gebietes, die eine Person nicht beantworten kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd0fbd42-660f-44fb-91a9-12c159402012",
                                "sense_id": "3254efcc-0c21-3f61-8aed-b8cad28df6a6",
                                "text": "[Fahrradfahren:] „Die größten Wissenslücken gibt es bei der Frage, bis wann Kinder und Jugendliche auf den Gehweg fahren dürfen oder müssen.“"
                            },
                            {
                                "example_id": "11234ccf-b732-4631-bd56-cd036c055320",
                                "sense_id": "3254efcc-0c21-3f61-8aed-b8cad28df6a6",
                                "text": "„Fragt man die Braunschweiger nach dem Namen Louis Spohr, fällt den meisten dazu nicht viel ein: […] »Kann ich nichts zu sagen, habe ich noch nie gehört. Ist das eine große Wissenslücke?«“"
                            },
                            {
                                "example_id": "4ac772d8-e964-41ed-887b-659f22b07c3d",
                                "sense_id": "3254efcc-0c21-3f61-8aed-b8cad28df6a6",
                                "text": "„Ziel ist es, die Wissenslücken der Millennials und Mitglieder der Generation Z zu schließen, damit sie finanzielle Entscheidungen unabhängig und kompetent treffen können.“"
                            },
                            {
                                "example_id": "02cefb06-fda7-4c97-a9bd-d9cad2dd595e",
                                "sense_id": "3254efcc-0c21-3f61-8aed-b8cad28df6a6",
                                "text": "„Die Arbeit der Hobbyastronomen schließt eine wichtige Wissenslücke über unsere interstellare Nachbarschaft.“"
                            },
                            {
                                "example_id": "25dd1fcb-c8f2-40d0-90c7-ab7c1bdb601a",
                                "sense_id": "3254efcc-0c21-3f61-8aed-b8cad28df6a6",
                                "text": "„Wissenschaftlich schließt das Fossil eine Wissenslücke zur Entwicklung der Vögel.“"
                            },
                            {
                                "example_id": "8fb5ae63-4ac7-4e5d-9ade-f316f699dc76",
                                "sense_id": "3254efcc-0c21-3f61-8aed-b8cad28df6a6",
                                "text": "„Gleichzeitig gibt es noch immer einige Wissenslücken und falsche Vorstellungen.“"
                            },
                            {
                                "example_id": "4ee8252b-028a-4243-8d0a-5fb472edb94f",
                                "sense_id": "3254efcc-0c21-3f61-8aed-b8cad28df6a6",
                                "text": "„Bis heute klafft eine noch immer große Wissenslücke, auch mangels Forschung auf diesem Gebiet.“"
                            },
                            {
                                "example_id": "8e80af5c-5f94-4bf3-b2d7-5becdf5f9efe",
                                "sense_id": "3254efcc-0c21-3f61-8aed-b8cad28df6a6",
                                "text": "„Hochschullehrer beklagten eine bei vielen Abiturienten mangelnde Studierfähigkeit und Wissenslücken etwa in Mathematik, den Naturwissenschaften und bei der Sprachbildung.“"
                            },
                            {
                                "example_id": "b9d61050-398a-4873-94ad-c39bd9310408",
                                "sense_id": "3254efcc-0c21-3f61-8aed-b8cad28df6a6",
                                "text": "[…] „hätte mich jemand vor der Lektüre dieses Buches gefragt, wie viele (bekannte) SäugetierARTEN – nicht Säugetiere! – es hierzulande eigentlich genau gibt, ich hätte passen müssen. Genauso hätte ich die Zahl der Vogel-, Reptilien-, Amphibien-, Pflanzen- und Pilzarten nur grob schätzen können. Erst durch das Buch ist mir diese Wissenslücke überhaupt bewusst geworden. Zum Glück!“"
                            },
                            {
                                "example_id": "d5ecbf70-7bc3-4645-a2dd-1e4184c175be",
                                "sense_id": "3254efcc-0c21-3f61-8aed-b8cad28df6a6",
                                "text": "[China:] „Die Entscheidungen, die von der Viererbande getroffen wurden, sind allerdings schwer von denen zu trennen, die von Mao selbst diktiert wurden. Diese Wissenslücke ermöglichte es späteren chinesischen Führungen, die Schuld an den grausamsten Taten der Kulturrevolution der Viererbande zuzuweisen und die zentrale Gründerfigur Mao damit zu entlasten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
