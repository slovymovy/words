                "senses": [
                    {
                        "sense_id": "8ad5634e-2221-3dea-8547-ba09463abdf2",
                        "entry_id": "99445a0f-3969-3641-9ebd-2e5f4104e7f5",
                        "glosses": [
                            "Petite sucette comportant à l'extrémité de son bâtonnet, au lieu du bonbon traditionnel, une préparation compacte à base de cake généralement enrobée de sucre ou chocolat et très souvent décorée."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "86bd9acd-4c17-4606-abbe-23c152d83b44",
                                "sense_id": "8ad5634e-2221-3dea-8547-ba09463abdf2",
                                "text": "Avec sa forme de sucette et toutes ses couleurs, le popcake ravira vos enfants, des plus petits aux plus grands."
                            },
                            {
                                "example_id": "2d2ebf9a-be61-4cd6-8d4f-de73f1e1e3c8",
                                "sense_id": "8ad5634e-2221-3dea-8547-ba09463abdf2",
                                "text": "Découvrez les popcakes et préparez ces gourmandises tout droit venues des U.S.A. chez vous avec le Princess Popcake Maker. Cet appareil vous permet de réaliser des popcakes à la fois gourmands et aériens chez vous et de tester vos propres recettes! — (http://www.vandenborre.be/fr/fun-cooking/princess-popcake-maker-132600)"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9b1e1a8a-478b-4b83-b65f-8395ae396f67",
                        "source_entry_id": "99445a0f-3969-3641-9ebd-2e5f4104e7f5",
