                                            {
                                                "example_id": "7d16e7a6-d5db-4ef9-85aa-d462da4821ba",
                                                "sense_id": "c0335e7b-4cbd-3777-8afd-018e402c69ca",
                                                "text": "Quand il y a un renvoi dans un acte, il faut parapher le renvoi."
                                            },
                                            {
                                                "example_id": "ca6a1299-9955-457d-94b6-87cac70cdb3c",
                                                "sense_id": "c0335e7b-4cbd-3777-8afd-018e402c69ca",
                                                "text": "Devant une table, deux hommes, l'un vieux, le juge d'instruction, l'autre jeune, le greffier, classaient et paraphaient des papiers."
                                            },
                                            {
                                                "example_id": "314d7872-da57-4350-93d9-227027887142",
                                                "sense_id": "c0335e7b-4cbd-3777-8afd-018e402c69ca",
                                                "text": "Hier, en signant le procès-verbal, il a oublié de parapher un renvoi."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
