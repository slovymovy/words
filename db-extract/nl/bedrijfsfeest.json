                        "examples": [
                            {
                                "example_id": "fd5a8d24-c556-4d3f-9dac-9cf7362ee136",
                                "sense_id": "25f39df3-14fd-3a64-ab76-1ada301beae0",
                                "text": "In Amsterdam zijn in de nacht van maandag op dinsdag 3 mensen gewond geraakt bij een steekpartij. Een man (26) viel bij een bioscoop mensen aan, die op een besloten bedrijfsfeest aanwezig waren."
                            },
                            {
                                "example_id": "750dfaa2-14ab-4088-9e1d-ec9516e2ad20",
                                "sense_id": "25f39df3-14fd-3a64-ab76-1ada301beae0",
                                "text": "De schietpartij vond plaats in een groot zorgcentrum voor gehandicapten. In het gebouw was een bedrijfsfeest gaande toen de schutters binnenvielen en het vuur openden."
                            },
                            {
                                "example_id": "6596c88b-b45e-4841-acbe-c086cfca5b65",
                                "sense_id": "25f39df3-14fd-3a64-ab76-1ada301beae0",
                                "text": "Op een bedrijfsfeest in Heiloo in Noord-Holland zijn twee mensen zwaargewond geraakt. De twee werden met een heftruck omhoog getild en kwamen daarbij ten val."
                            }
                        ]
                    }
