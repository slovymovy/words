                    {
                        "form_id": "7c5915d7-d3f3-4344-93e5-3a43e9aa9bf9",
                        "entry_id": "e7efa5d7-75dc-32f9-a295-e54bcec38911",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Sturmbannführer"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "995e4833-3fba-3c96-9349-a9ee6b0692b2",
                        "entry_id": "e7efa5d7-75dc-32f9-a295-e54bcec38911",
                        "glosses": [
                            "Anrede von SA-Sturmbannführer und SS-Sturmbannführer"
                        ],
                        "tags": [
                            "Sturmabteilung",
                            "Schutzstaffel"
                        ],
                        "examples": [
                            {
                                "example_id": "d86dc266-1855-470b-be80-9625924f5c46",
                                "sense_id": "995e4833-3fba-3c96-9349-a9ee6b0692b2",
                                "text": "„Kann ich auch nicht für, Herr Sturmbannführer!“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "f89996a8-a895-3b93-9175-ff7a61a4ec88",
                        "entry_id": "e7efa5d7-75dc-32f9-a295-e54bcec38911",
                        "glosses": [
                            "Offizier im Range eines SA-Sturmbannführers oder SS-Sturmbannführers"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "fba7d01a-3de5-463c-818e-26939eb3d435",
                                "sense_id": "f89996a8-a895-3b93-9175-ff7a61a4ec88",
                                "text": "„Wenn es Ihnen gelingt, den Sturmbannführer zu retten, stehen Sie wohl nicht sehr günstig vor ihren eigenen Leuten da.“"
                            },
                            {
                                "example_id": "2393e448-304d-4aaf-a9df-3211a930771a",
                                "sense_id": "f89996a8-a895-3b93-9175-ff7a61a4ec88",
                                "text": "„Ich wurde dann von dem aufsichtführenden Sturmbannführer aufgefordert, beim Zuschütten der Leichen zu helfen.“"
                            },
                            {
                                "example_id": "537e4e48-0ca5-49b5-b466-f24477a780a3",
                                "sense_id": "f89996a8-a895-3b93-9175-ff7a61a4ec88",
                                "text": "„Schließlich schlage ich vor, den dienstältesten SS-Offizier der Stadt, einen Sturmbannführer zu alarmieren.“"
                            },
                            {
                                "example_id": "3d321125-ea07-493b-b590-3cc5c5f1fa31",
                                "sense_id": "f89996a8-a895-3b93-9175-ff7a61a4ec88",
                                "text": "„Opa Friedrich war ein ‚lupenreiner Nazi‘. Sturmbannführer der SS, Abteilungsleiter im Rasseamt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
