                    {
                        "sense_id": "532267f1-ef3d-30d9-8392-6c0926b889a0",
                        "entry_id": "beb0c48c-6bb4-3ca0-992f-816bcacdd8d2",
                        "glosses": [
                            "Any of the evergreen conifers belonging to the genus Sequoia in the wide sense."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": [
                            {
                                "example_id": "7c348fa6-06cf-4400-a035-fa48079b71ff",
                                "sense_id": "532267f1-ef3d-30d9-8392-6c0926b889a0",
                                "text": "I remember redwood trees,\nbumper cars and wolverines,\n the ocean's Trident submarines,\nlemons, limes and tangerines.\nI remember this..."
                            }
                        ]
                    },
                    {
                        "sense_id": "08786ed2-656f-3394-a825-d5f140cf0462",
                        "entry_id": "beb0c48c-6bb4-3ca0-992f-816bcacdd8d2",
