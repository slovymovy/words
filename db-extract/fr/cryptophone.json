                        "glosses": [
                            "Microphone de surveillance, d’espionnage qu’il est possible de placer sous l’eau ou enfoui dans le sol."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a799c029-5e11-4b27-a1a6-1f849c262955",
                                "sense_id": "fac4e65e-b01a-3dcc-85d0-cc1912d70de6",
                                "text": "On peut aussi, avec trois appareils placés à quelques centaines de mètres de distance, relever par recoupements la trajectoire que suit un navire dont on entend le battement de l’hélice dans le cryptophone."
                            }
                        ]
                    },
