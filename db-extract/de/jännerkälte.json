                ],
                "senses": [
                    {
                        "sense_id": "3d504d7b-5397-3409-b5f2-a6699c5b150b",
                        "entry_id": "2eae6b9a-f92e-3aa2-9f41-2a71a4c5aaa8",
                        "glosses": [
                            "niedrige Temperatur im ersten Monat des Jahres"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "431d5232-e725-4b93-87bd-d992e3246819",
                                "sense_id": "3d504d7b-5397-3409-b5f2-a6699c5b150b",
                                "text": "„Da ich keine Lebenden habe für diesen Zweck, sage ich mir, will ich mich wenigstens mit den Toten gegen diese Jännerkälte und Jännerleere wehren und von allen diesen Toten ist mir in diesen Tagen und in diesem Augenblick keiner näher als mein Freund Paul.“"
                            },
                            {
                                "example_id": "97f2e83e-e9a9-498c-a21c-7714a454ac8f",
                                "sense_id": "3d504d7b-5397-3409-b5f2-a6699c5b150b",
                                "text": "„Als der Schuhmeier angefahren kam, wollten ihn die Massen nicht hineinlassen und verlangten, er möge auf der Straße in der grimmigen Jännerkälte zu ihnen reden.“"
                            },
                            {
                                "example_id": "1f4d20c9-db7f-4745-b6f6-dd25abd6f7ee",
                                "sense_id": "3d504d7b-5397-3409-b5f2-a6699c5b150b",
                                "text": "„In der von nur wenigen Temperaturanstiegen unterbrochenen Jännerkälte gefriert Wacholderbranntwein zu glasigen Klumpen, und ausgesetztes Quecksilber wird so hart, daß sie damit ein Gewehr laden und zolldicke Bretter durchschießen können.“"
                            },
                            {
                                "example_id": "b8cec855-d39d-4b44-875a-872b6c17c64c",
                                "sense_id": "3d504d7b-5397-3409-b5f2-a6699c5b150b",
                                "text": "„Die Jännerkälte im ungeheizten Pariser Grand Palais ließ die Illusion von Sonne und Wärme in Karl Lagerfelds Haute-Couture-Präsentation allerdings schnell verfliegen.“"
                            },
                            {
                                "example_id": "107c315e-8379-4278-bd54-3e60a967fb92",
                                "sense_id": "3d504d7b-5397-3409-b5f2-a6699c5b150b",
                                "text": "„Drinnen, im blauen Neonlicht der Uni-Arena, schlägt Newt Gingrich, eigentlich ein Freund des Kapitalismus, in die gleiche Kerbe wie die Kapitalismuskritiker draußen in der Jännerkälte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
