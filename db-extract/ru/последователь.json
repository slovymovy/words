                                            {
                                                "example_id": "1edd3a9e-20be-4e45-9b44-468b19ba7a7c",
                                                "sense_id": "8e3f828f-2fe6-3c84-977a-80d6377de1fa",
                                                "text": "Der junge Graf wurde schon früh als Nachfolger des Vaters in der Geschäftsführung der Brennerei aufgebaut."
                                            },
                                            {
                                                "example_id": "12c0806c-7a4a-4c2b-9fc0-270c16fc32bb",
                                                "sense_id": "8e3f828f-2fe6-3c84-977a-80d6377de1fa",
                                                "text": "„In München ist der Vorsitzende des Zentralrats zurückgetreten, ich werde zu seinem Nachfolger bestimmt.“"
                                            },
                                            {
                                                "example_id": "983df513-3f8b-4802-b299-e3508dd5a9f7",
                                                "sense_id": "8e3f828f-2fe6-3c84-977a-80d6377de1fa",
                                                "text": "„Ich gab mir vergeblich Mühe, den Kopf Hannibls und die Inschrift zu Ehren des Cäsar Claudius, des Nachfolgers des Gallienus, zu finden; aber ich sah die Überreste des Amphitheaters.“"
                                            },
                                            {
                                                "example_id": "adde7f39-efe8-4dfe-a382-cc4867589ace",
                                                "sense_id": "8e3f828f-2fe6-3c84-977a-80d6377de1fa",
                                                "text": "„Der Nachfolger Heinrichs VIII., König Eduard VI., ist gestorben, Heinrichs Testament verfügt, auf Eduard solle im Todesfalle Maria, die Katholische, folgen, aber Eduard, so sagt man, habe auf dem Totenbett seine Schwester Johanna zur Nachfolgerin bestimmt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "45bd5b93-e0de-3ddb-981a-771275d74880",
                                        "entry_id": "d0948a13-1fdb-3ecb-aa67-2bc0be8c5020",
                                        "glosses": [
                                            "ein Produkt, das ein bestimmtes älteres Produkt ablöst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7bf1920c-3b86-4509-8850-a9ef3c1ff4ca",
                                                "sense_id": "45bd5b93-e0de-3ddb-981a-771275d74880",
                                                "text": "Der Passat war der Nachfolger des VW 1600."
                                            },
                                            {
                                                "example_id": "6ac45434-c7db-45d4-b971-faf5857606f5",
                                                "sense_id": "45bd5b93-e0de-3ddb-981a-771275d74880",
                                                "text": "Der Nachfolger der X-Box ist jetzt auf dem Markt erhältlich."
                                            },
                                            {
                                                "example_id": "4f7a02eb-7ff6-4d8c-ae82-4dab19f8a365",
                                                "sense_id": "45bd5b93-e0de-3ddb-981a-771275d74880",
                                                "text": "Ericsson arbeitet fieberhaft an einem Nachfolger für das Erfolgsmodell YM."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "7ce4c9cc-86f9-3524-9bdf-989d10e08695",
                                        "entry_id": "d0948a13-1fdb-3ecb-aa67-2bc0be8c5020",
                                        "glosses": [
                                            "die nächsthöhere Zahl in einer gegebenen Menge (meist der ganzen Zahlen)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5778935d-516d-47bc-bb9d-bf3ac3bccb49",
                                                "sense_id": "7ce4c9cc-86f9-3524-9bdf-989d10e08695",
                                                "text": "0 ist der Nachfolger von -1."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
