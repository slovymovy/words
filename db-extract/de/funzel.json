                                            {
                                                "example_id": "6601dae2-a3bc-4c69-8140-075fd289aab5",
                                                "sense_id": "fa10ced4-f40f-3d4f-9ff4-12ad43daebf8",
                                                "text": "— Eh bien, loupiote, plaisante joyeusement Bertrand, tu as donc avalé ta langue qu'on ne t'entend pas jacasser.\nLa fillette lui jeta un regard en dessous, mais ne bougea pas, serrée contre les jupes de sa tante."
                                            },
                                            {
                                                "example_id": "8bfe5241-e15a-44b8-98d7-61a06f1831c4",
                                                "sense_id": "fa10ced4-f40f-3d4f-9ff4-12ad43daebf8",
                                                "text": "Alors qu'elle longeait le couloir, une loupiote blonde en pyjama passa sa tête dans l'ouverture d'une porte et se précipita sur elle."
                                            }
                                        ]
                                    }
                                ]
