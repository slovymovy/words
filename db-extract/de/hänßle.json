                ],
                "senses": [
                    {
                        "sense_id": "d7c4fa99-c326-3977-8a5a-56243b5ad018",
                        "entry_id": "c2959d01-60d8-3bab-b9e8-3af8722c74be",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a0b298f-99d0-4b55-8392-12deaa6ef4cf",
                                "sense_id": "d7c4fa99-c326-3977-8a5a-56243b5ad018",
                                "text": "Hänßles kamen, sahen und siegten."
                            },
                            {
                                "example_id": "81c94bcf-d4d9-4fbd-961f-ea32a8d32eb6",
                                "sense_id": "d7c4fa99-c326-3977-8a5a-56243b5ad018",
                                "text": "Frau Hänßle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "5a20eaf5-1869-417a-ac36-79f189d16fa8",
                                "sense_id": "d7c4fa99-c326-3977-8a5a-56243b5ad018",
                                "text": "Herr Hänßle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "7642742a-bb2d-4341-8498-4ab4fc002c22",
                                "sense_id": "d7c4fa99-c326-3977-8a5a-56243b5ad018",
                                "text": "Die Hänßles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "776f7da1-17fd-47d6-bc05-6ebcababc3d5",
                                "sense_id": "d7c4fa99-c326-3977-8a5a-56243b5ad018",
                                "text": "Der Hänßle trägt nie die Schals, die die Hänßle ihm strickt."
                            },
                            {
                                "example_id": "d247d9ff-3fbd-4b3a-9271-3db9ebc94da2",
                                "sense_id": "d7c4fa99-c326-3977-8a5a-56243b5ad018",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Hänßle kommt, geht der Herr Hänßle.“"
                            },
                            {
                                "example_id": "0fe13c9f-0903-4800-8534-3aeb8d2ac87e",
                                "sense_id": "d7c4fa99-c326-3977-8a5a-56243b5ad018",
                                "text": "Hänßle kommt und geht."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
