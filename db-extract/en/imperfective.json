        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "cc0311d0-91c0-3e2e-90f8-6c0aa7d7a822",
                "word": "imperfective",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "01dee220-5535-31aa-a1b9-27d9e3a8f3fd",
                        "entry_id": "cc0311d0-91c0-3e2e-90f8-6c0aa7d7a822",
                        "glosses": [
                            "Of, relating to or having the properties of the imperfective aspect."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "9f7c121e-cc53-45b5-a2c5-76647ba54c0b",
                                "sense_id": "01dee220-5535-31aa-a1b9-27d9e3a8f3fd",
                                "text": "In the last chapter, we observed the rise of an imperfective marker in English, the Progressive, as the dominant and surviving member of a wider paradigm of imperfective aspectual functions in Old English, but which were no longer marked in the same way in later stages of the history of English."
                            },
                            {
                                "example_id": "0784bdac-b5ad-43af-aeda-4e21ad5bb6f0",
                                "sense_id": "01dee220-5535-31aa-a1b9-27d9e3a8f3fd",
                                "text": "The former is the basic imperfective subjunctive, while the latter is prominent or intensified.[…]While the present subjunctive is imperfective in aspect, the perfect subjunctive is imperfective in aspect and spatially proximate."
                            },
                            {
                                "example_id": "bcd7fe67-9505-4d4e-8529-8c778a2329f6",
                                "sense_id": "01dee220-5535-31aa-a1b9-27d9e3a8f3fd",
                                "text": "Consider, then, the result of applying these tense morphemes to a perfective or an imperfective verb."
                            }
                        ]
                    }
                ],
                "translations": [
