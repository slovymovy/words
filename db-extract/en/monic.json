                "translations": [
                    {
                        "translation_id": "892a3321-c62c-42ce-a7ba-50084a4ac9e6",
                        "source_entry_id": "e8d2ff49-5759-3d10-8a8a-661e0ef905ac",
                        "source_sense_id": "2a965b52-3a0a-3183-befd-541dac83112a",
                        "source_sense_description": "of a polynomial whose leading coefficient is one",
                        "target_lang_word": "unitaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unitaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "594f0638-630e-35b9-8191-559b33cb65b8",
                                        "entry_id": "27f844f4-9af0-3a35-962a-9170028d112c",
                                        "glosses": [
                                            "Relatif au nombre un, à l'unité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7bc0c064-e1cf-4d27-9968-9a380c6ff975",
                                                "sense_id": "594f0638-630e-35b9-8191-559b33cb65b8",
                                                "text": "Dieu n’est pas un. Il est au contraire multiple. Mais la croyance est une. Et c’est cela qui est divin. C'est sur cette croyance seule que repose le principe moral unitaire sans qui ni la cité ni la famille ne seraient."
                                            },
                                            {
                                                "example_id": "65e7166e-1e5b-46fa-99e4-dd0458b85696",
                                                "sense_id": "594f0638-630e-35b9-8191-559b33cb65b8",
                                                "text": "[Les plantes] ne satisfont donc pas aux critères classiques de l’individualité et présentent dans leur écrasante majorité un mode d’existence coloniaire, seul un cinquième d’entre elles vivant de façon unitaire, tels les arbres."
                                            },
                                            {
                                                "example_id": "90d95ff0-4688-4875-a780-c92532a5d0ee",
                                                "sense_id": "594f0638-630e-35b9-8191-559b33cb65b8",
                                                "text": "Avec ce concept de réitération, on peut alors distinguer deux sortes d’arbres, les « unitaires » et les « coloniaires ». Les arbres unitaires sont dépourvus de réitération. Cela signifie que leur croissance se limite à celle de leur modèle architectural. Ils ont une forme simple et une esthétique séduisante – ils sont très souvent utilisés pour la décoration."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c6720e68-39b8-395f-9c53-86f592bd3273",
                                        "entry_id": "27f844f4-9af0-3a35-962a-9170028d112c",
                                        "glosses": [
                                            "Relatif au nombre un, à l'unité.",
                                            "Qualifie le prix d'une unité dans un lot."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a44baa4-e825-4643-9732-fb1c25c52fac",
                                                "sense_id": "c6720e68-39b8-395f-9c53-86f592bd3273",
                                                "text": "La société Funboard importe des planches à roulettes de Corée et de Taïwan selon les modèles. La dernière commande concerne l’importation de 8 000 planches à roulettes au prix unitaire de 100 USD CIF Le Havre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bbc9ce75-e043-3d80-8905-acd91241d46a",
                                        "entry_id": "27f844f4-9af0-3a35-962a-9170028d112c",
                                        "glosses": [
                                            "Relatif au nombre un, à l'unité.",
                                            "Dont le coefficient dominant est un."
                                        ],
                                        "tags": [
                                            "Se dit d’un polynôme"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6a16de4c-dfd1-3aba-afe2-ad5c9d067823",
                                        "entry_id": "27f844f4-9af0-3a35-962a-9170028d112c",
                                        "glosses": [
                                            "Relatif au nombre un, à l'unité.",
                                            "Possédant un élément neutre pour la multiplication (une unité)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fbf7c0cb-dd8b-433f-8109-6b0522aba50c",
                                                "sense_id": "6a16de4c-dfd1-3aba-afe2-ad5c9d067823",
                                                "text": "Anneau unitaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9dd2e128-26b5-3fc8-94ea-7a27839741c8",
                                        "entry_id": "27f844f4-9af0-3a35-962a-9170028d112c",
                                        "glosses": [
                                            "Relatif au nombre un, à l'unité.",
                                            "Qualifie une matrice inversible et dont l’inverse est égal à la matrice adjointe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0579984f-cd03-4079-ac75-8c6530ee8e5a",
                                                "sense_id": "9dd2e128-26b5-3fc8-94ea-7a27839741c8",
                                                "text": "Les matrices unitaires à coefficients réels sont les matrices orthogonales."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "29cfa5bf-b86b-3d9e-8bf5-9c8c4c10e9a0",
                                        "entry_id": "27f844f4-9af0-3a35-962a-9170028d112c",
                                        "glosses": [
                                            "Relatif au nombre un, à l'unité.",
                                            "Dont la norme vaut un."
                                        ],
                                        "tags": [
                                            "Se dit d’un vecteur"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "505221ca-d01d-39d4-96b0-f4402755d049",
                                        "entry_id": "27f844f4-9af0-3a35-962a-9170028d112c",
                                        "glosses": [
                                            "Qui est partisan de l’unité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "09a6d456-a485-43e1-b004-edb13d73f97b",
                                                "sense_id": "505221ca-d01d-39d4-96b0-f4402755d049",
                                                "text": "Nous tous, nous avons à défendre un bien qui nous est commun, un empire unitaire, car une Allemagne morcelée cesserait d’avoir une influence dans le monde."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "412c71fc-ba76-3fd2-8582-5d2f16b857d2",
                                        "entry_id": "27f844f4-9af0-3a35-962a-9170028d112c",
                                        "glosses": [
                                            "Unitarien."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "unitaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9df9ec43-652e-3253-b8f9-0344eac9b713",
                                        "entry_id": "9881cdc5-4fc5-3bcc-adb9-9385902e4c92",
                                        "glosses": [
                                            "Partisan de l’union dans l’action."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1717a335-d7ca-3dd5-982f-be031e59b93a",
                                        "entry_id": "9881cdc5-4fc5-3bcc-adb9-9385902e4c92",
                                        "glosses": [
                                            "Chrétien qui ne reconnaît qu’une seule personne en Dieu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71cf386c-007a-4ee4-aac3-b6a156e8456a",
                                                "sense_id": "1717a335-d7ca-3dd5-982f-be031e59b93a",
                                                "text": "Contre les unitaires, on a prouvé que le Père, le Fils et le Saint-Esprit sont trois personnes, et contre les trithéistes on a prouvé l’unité de la substance divine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ed8dc8c6-2974-31be-8cf7-7bcda0b090fc",
                                        "entry_id": "9881cdc5-4fc5-3bcc-adb9-9385902e4c92",
                                        "glosses": [
                                            "Œuvre audiovisuelle unique dont l'histoire est bouclée, par opposition à la série."
                                        ],
