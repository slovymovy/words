                    },
                    {
                        "translation_id": "e9cd8c13-808e-45ba-b564-030347d6b277",
                        "source_entry_id": "d155806c-06eb-304c-b290-589ebf661879",
                        "source_sense_id": "89ba4cc6-c218-373a-b7de-9953402273fb",
                        "target_lang_word": "Essstäbchen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Essstäbchen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c48794d7-c21d-3df7-b089-0628a41d33a3",
                                        "entry_id": "ea2a22b1-459c-3600-b70a-c0aaaf4951f2",
                                        "glosses": [
                                            "Essbesteck in Form eines kleinen, aus Holz, Bambus oder dergleichen bestehenden Stabes für asiatische Speisen"
                                        ],
                                        "tags": [
                                            "plural",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "17a53c4c-7800-4cbc-9e74-63d02fc0c06f",
                                                "sense_id": "c48794d7-c21d-3df7-b089-0628a41d33a3",
                                                "text": "„Nach jeweils zwei Fragen beugt sie sich mit dem Kugelschreiber in der Hand vor und hebt das Glas am Stiel an, sodass sich Kuli und Glas in ihrer Hand wie Essstäbchen kreuzen.“"
                                            },
                                            {
                                                "example_id": "eb0fa265-5f66-4006-8058-a604c8e7ba3c",
                                                "sense_id": "c48794d7-c21d-3df7-b089-0628a41d33a3",
                                                "text": "„Eine Wachfrau am Eingang hatte den Inhalt sorgfältig inspiziert und zum Herumstochern zwei überdimensionale Essstäbchen benutzt.“"
                                            },
                                            {
                                                "example_id": "5cf2ba3a-b064-40d1-bb22-32d09dbc9f18",
                                                "sense_id": "c48794d7-c21d-3df7-b089-0628a41d33a3",
                                                "text": "„Sie hatte wunderschöne Mandelaugen, mit denen sie Pendleton, allem Anschein nach, zärtlich betrachtete, während dieser sich mit seinen Essstäbchen abmühte.“"
                                            },
                                            {
                                                "example_id": "1cecd72c-2fa4-434b-85c1-5695033c3239",
                                                "sense_id": "c48794d7-c21d-3df7-b089-0628a41d33a3",
                                                "text": "„›Stimmt. Wenn es einen Keiler umwirft, ist es egal, was für ein Gewehr es ist. Verdammt, wenn sie einen Keiler mit Essstäbchen - oder von mir aus mit einem Zahnstocher - erlegen können, dürfen Sie das Gewehr auch gleich ganz weglassen.‹“"
                                            },
                                            {
                                                "example_id": "79992790-7679-4445-8181-7cbc6e8caeb8",
                                                "sense_id": "c48794d7-c21d-3df7-b089-0628a41d33a3",
                                                "text": "„Blackthorne bediente sich der Essstäbchen, wie er es den Gefangenen im Gefängnis abgeguckt hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
