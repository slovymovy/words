                "senses": [
                    {
                        "sense_id": "64a83662-3503-3bc2-a317-20169ff1f996",
                        "entry_id": "1190a040-a058-30fb-ac9c-8741ec4edefc",
                        "glosses": [
                            "Relatif à l'intellectualisme et à ses adeptes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aae8f813-4921-44a0-af77-a91b04174223",
                                "sense_id": "64a83662-3503-3bc2-a317-20169ff1f996",
                                "text": "S'il en était ainsi, je n'aurais guère eu de chance, puisque je voulais écarter tout contrôle de la philosophie intellectualiste, qui me semble être un grand embarras pour l'historien qui la suit."
                            },
                            {
                                "example_id": "882db7b5-ad95-4cae-84c6-65b5e37c531a",
                                "sense_id": "64a83662-3503-3bc2-a317-20169ff1f996",
                                "text": "Il est bien remarquable que toutes, ou presque toutes les théories contemporaines du rire soient des théories intellectualistes."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
