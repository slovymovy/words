                "senses": [
                    {
                        "sense_id": "d084c02c-664e-36ec-b709-32e05cce4f8c",
                        "entry_id": "f928eb8b-cfc3-360b-ac9a-3a30b6358272",
                        "glosses": [
                            "von einem Unternehmen selbst bestimmbarer Anteil an Frauen in Führungspositionen"
                        ],
                        "tags": [
                            "Politikjargon"
                        ],
                        "examples": [
                            {
                                "example_id": "51966332-9580-4f9c-9404-a4ed74da169d",
                                "sense_id": "d084c02c-664e-36ec-b709-32e05cce4f8c",
                                "text": "„Zudem lässt das Gesetz die praktische Handhabung der Flexiquote, anders als bei der fixen Quote, weitgehend ungeregelt.“"
                            },
                            {
                                "example_id": "0ff6e4d7-ed9c-429d-a3f2-978290d25345",
                                "sense_id": "d084c02c-664e-36ec-b709-32e05cce4f8c",
                                "text": "„Bedingung dafür sei aber, dass von der Leyen jetzt – gegen ihre Überzeugung – für die Flexiquote stimme und die Regierungskoalition nicht gefährde.“"
                            },
                            {
                                "example_id": "0f9eea0d-a0a3-4e81-b3f5-1ad78b36ce38",
                                "sense_id": "d084c02c-664e-36ec-b709-32e05cce4f8c",
                                "text": "„Unionspolitiker befürworten stattdessen eine sogenannte »Flexiquote«, bei der deutsche Gerichte selbst über die Anzahl der verurteilten Frauen entscheiden dürfen, diese dann aber auch umsetzen müssen.“"
                            },
                            {
                                "example_id": "814e7b6d-d574-4db3-a910-cbc339700a35",
                                "sense_id": "d084c02c-664e-36ec-b709-32e05cce4f8c",
                                "text": "„Ex-Frauenministerin Schröder schwor auf Freiwilligkeit, forderte bestenfalls eine Flexiquote.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
