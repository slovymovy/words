        "fr-extract.jsonl": [
            {
                "entry_id": "fd7772ad-9d08-3cf7-afb2-5088a6891971",
                "word": "syndicalisme",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "0643f7f1-cdc9-4425-bc18-588b74b84ca5",
                        "entry_id": "fd7772ad-9d08-3cf7-afb2-5088a6891971",
                        "tags": [
                            "plural"
                        ],
                        "form": "syndicalismes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fe389940-8079-3ddb-bcb4-dfc2b4cbe0a3",
                        "entry_id": "fd7772ad-9d08-3cf7-afb2-5088a6891971",
                        "glosses": [
                            "Activisme des syndicats dans lequel des acteurs économiques s’unissent."
                        ],
                        "tags": [
                            "Économie",
                            "Syndicalisme"
                        ],
                        "examples": [
                            {
                                "example_id": "815c2afc-6f10-410b-bf44-07ab8bf8cbd5",
                                "sense_id": "fe389940-8079-3ddb-bcb4-dfc2b4cbe0a3",
                                "text": "Ainsi pourvue d'un statut légal et de moyens financiers, la vulgarisation se développe rapidement, surtout dans la mouvance du syndicalisme, […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "470de8f8-1174-3e4e-80e1-a1fe054efd05",
                        "entry_id": "fd7772ad-9d08-3cf7-afb2-5088a6891971",
                        "glosses": [
                            "Mouvement social qui vise à unifier les travailleurs dans des syndicats, pour défendre leurs intérêts communs."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "c6e9fc79-acb0-40f7-be5c-0c674dccd49e",
                                "sense_id": "470de8f8-1174-3e4e-80e1-a1fe054efd05",
                                "text": "Ainsi on ne pourrait plus contester qu’il y ait une opposition absolue entre le syndicalisme révolutionnaire et l’État ; cette opposition prend en France la forme particulièrement âpre de l’antipatriotisme […]"
                            },
                            {
                                "example_id": "b187746e-5197-4486-abb6-548be31f540c",
                                "sense_id": "470de8f8-1174-3e4e-80e1-a1fe054efd05",
                                "text": "Il se peut qu’à l’heure du péril de guerre, le syndicalisme souffrît d’un léger fléchissement."
                            },
                            {
                                "example_id": "5f5bd251-947c-479e-9c91-fc19b94ca323",
                                "sense_id": "470de8f8-1174-3e4e-80e1-a1fe054efd05",
                                "text": "Il existait en 1914 trois principaux courants de pensée à la S.F.I.O. : le syndicalisme révolutionnaire, le jaurésisme et le guesdisme. Dans l'entre-deux-guerres, deux de ces courants connaissent une éclipse durable, au profit du troisième."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1c38acc8-9712-4c9a-aff1-956e4c212ad5",
                        "source_entry_id": "fd7772ad-9d08-3cf7-afb2-5088a6891971",
                        "source_sense_description": "mouvement social visant l’union des travailleurs pour la défense de leurs intérêts",
                        "target_lang_word": "Syndikalismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Syndikalismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e8f36a39-3ebe-3308-9d81-f620e2286228",
                                        "entry_id": "8b9f1546-54e0-35e7-ab87-3df94f70adee",
                                        "glosses": [
                                            "gegen Ende des 19. Jahrhunderts entstandene politisch-soziale Bewegung, die in den gewerkschaftlichen Zusammenschlüssen der Lohnarbeiter, und nicht in den politischen Parteien den entscheidenden Träger revolutionärer Bestrebungen sah"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "efbfc017-3fa0-492a-8e1c-78e1452c9cc9",
                                                "sense_id": "e8f36a39-3ebe-3308-9d81-f620e2286228",
                                                "text": "„Auch wenn der Syndikalismus anfangs Aufwind hatte, waren seine Theoretiker zunehmend enttäuscht über den Konservatismus der Massen.“"
                                            },
                                            {
                                                "example_id": "50d1f462-1b6e-4524-9513-a0de323729fe",
                                                "sense_id": "e8f36a39-3ebe-3308-9d81-f620e2286228",
                                                "text": "„Deine Entwicklung - es ist nicht meine, die tiefgründend im Syndikalismus verwurzelt blieb - habe ich deshalb nachvollziehen können: denn Hanna Arendt's Radikalismus ist nicht fern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8bdb331b-c449-4b98-8b86-214366e1332f",
                        "source_entry_id": "fd7772ad-9d08-3cf7-afb2-5088a6891971",
