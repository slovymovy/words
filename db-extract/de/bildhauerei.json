                "senses": [
                    {
                        "sense_id": "4ae77fbd-ebdd-3476-b541-acc443349a9d",
                        "entry_id": "b409cc04-0436-36f4-9c9b-1f89d50d7cbe",
                        "glosses": [
                            "Kunstform, bei der Skulpturen und Plastiken hergestellt werden"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "964a6786-152f-3c7c-8ce3-374a23a29fd0",
                        "entry_id": "b409cc04-0436-36f4-9c9b-1f89d50d7cbe",
                        "glosses": [
                            "Werk der Bildhauerkunst"
                        ],
                        "tags": [],
