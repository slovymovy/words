                ],
                "senses": [
                    {
                        "sense_id": "c7a4c44d-58a1-3e38-90a3-a8e70885a8f8",
                        "entry_id": "10dd865b-d9af-362b-97b1-4b3f215810e2",
                        "glosses": [
                            "Mélange équimoléculaire de deux énantiomères."
                        ],
                        "tags": [
                            "Stéréochimie"
                        ],
                        "examples": [
                            {
                                "example_id": "d71781d8-4ffe-49cf-97a8-0c286f48d990",
                                "sense_id": "c7a4c44d-58a1-3e38-90a3-a8e70885a8f8",
                                "text": "Procéder au dédoublement d’un racémique."
                            },
                            {
                                "example_id": "00b9a42d-c02b-4148-811c-c9a5397cf988",
                                "sense_id": "c7a4c44d-58a1-3e38-90a3-a8e70885a8f8",
                                "text": "La méthode consiste normalement à faire réagir avec le racémique à résoudre un composé optiquement actif pris sous la forme d’un énantiomère pur."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1fb09298-556d-43f9-9522-2ea4c3a3bb17",
                        "source_entry_id": "10dd865b-d9af-362b-97b1-4b3f215810e2",
                        "source_sense_id": "c7a4c44d-58a1-3e38-90a3-a8e70885a8f8",
                        "target_lang_word": "racemate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "racemate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a687ae92-bc1f-3603-9113-5d668a1a0919",
                                        "entry_id": "170fabfd-8e5b-3933-b24c-3119354332ad",
                                        "glosses": [
                                            "A mixture which is racemic (“containing equal amounts of dextrorotatory and levorotatory stereoisomers and therefore not optically active”)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7930e385-7698-434c-9d6b-33be77516805",
                                                "sense_id": "a687ae92-bc1f-3603-9113-5d668a1a0919",
                                                "text": "Тhe greatest racemate contents were found in the products prepared in dimethylformamide and dimethylsulphoxide."
                                            },
                                            {
                                                "example_id": "7337ae5c-11a2-4ddf-b562-754ff6cc4d9f",
                                                "sense_id": "a687ae92-bc1f-3603-9113-5d668a1a0919",
                                                "text": "Let us discuss different scenarios that may arise from a racemate consisting of two enantiomers."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "racemate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6e177ee9-a8c4-36a0-9900-b86921e7ed6b",
                                        "entry_id": "010ed0d0-d042-3166-8994-56a273059416",
                                        "glosses": [
                                            "Any salt or ester of racemic acid."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "racemate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3c8ebf77-a7e7-3e93-bf5a-012e47329fdf",
                                        "entry_id": "fc4895be-29a8-3739-95ff-8e39011d834a",
                                        "glosses": [
                                            "One participating in the same race as others."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "23a13d4a-9f1f-4496-a932-8cf3354a6586",
                                                "sense_id": "3c8ebf77-a7e7-3e93-bf5a-012e47329fdf",
                                                "text": "Differences in time at finish, time minus time of winner, and time minus racemate average for various track conditions are given in Tables 15, 16, and 17, respectively."
                                            },
                                            {
                                                "example_id": "704897fd-9531-4889-877d-3ee7736727b2",
                                                "sense_id": "3c8ebf77-a7e7-3e93-bf5a-012e47329fdf",
                                                "text": "Many environmental factors, such as track condition or shape, racing strategy or quality of racemates, modify the expression of true speed by a horse in a race and thereby bias performance records."
                                            },
                                            {
                                                "example_id": "50f3aac8-f6e0-41c7-b999-6c99aba6e98f",
                                                "sense_id": "3c8ebf77-a7e7-3e93-bf5a-012e47329fdf",
                                                "text": "The interpretation of pace or purse is complicated by the fact that the data reflect not only the performance of the horse but the decisions and behavior of the track officials, the driver, the owner, racemates, etc."
                                            },
                                            {
                                                "example_id": "4d410653-18e0-4de6-91cb-02e289b9fc90",
                                                "sense_id": "3c8ebf77-a7e7-3e93-bf5a-012e47329fdf",
                                                "text": "A second three-car pileup happened later on. [Scott] Tucker’s racemate Guy Cosmo avoided the accidents."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "racemate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3264dd87-c747-332b-b9ff-01b4a390f8d1",
                                        "entry_id": "75bfd925-2a5d-3e4a-b0b0-8f2ff39416a7",
                                        "glosses": [
                                            "A person of the same racial group as others."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4451163d-3f6a-4388-99f4-cbfebc67da64",
                                                "sense_id": "3264dd87-c747-332b-b9ff-01b4a390f8d1",
                                                "text": "In Figure 1, Negroes and whites alternate around the circle, so that racemates are isolated from one another communicationally. If they communicate, it must be thru a person of the other race."
                                            },
                                            {
                                                "example_id": "3672826a-cb80-4b66-9bf6-bd962fbf16a1",
                                                "sense_id": "3264dd87-c747-332b-b9ff-01b4a390f8d1",
                                                "text": "if you still lay claim to the achievements your ancestors and racemates carried out, you must also share the guilt for their crimes"
                                            },
                                            {
                                                "example_id": "adaa3d3e-72c3-41d9-98a6-00bcf5fe6cd7",
                                                "sense_id": "3264dd87-c747-332b-b9ff-01b4a390f8d1",
                                                "text": "I'm 'white' and not so proud of it because of what my 'racemates' have done to the Americans and Africans. :-("
                                            },
                                            {
                                                "example_id": "bfa211b1-ceb7-4b2a-90d1-95c27cfc11cb",
                                                "sense_id": "3264dd87-c747-332b-b9ff-01b4a390f8d1",
                                                "text": "She finds an organizational environment with limited prospects for responsiveness and meaningful exchange, even where, theoretically, one might have expected racial and ethnic affinity to produce responsiveness between racemates."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
