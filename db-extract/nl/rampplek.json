                        "examples": [
                            {
                                "example_id": "c040577b-d39f-4941-b862-bdf7c32a0265",
                                "sense_id": "098c6b71-dc2e-341e-a3e3-095928005e03",
                                "text": "„Ons team is nog niet ter plekke. Veel wegen zijn geblokkeerd door de aardverschuiving”, zei een functionaris van de nationale reddingsdienst tegen Metro TV. Hij zei dat twee graafmachines proberen de rampplek te bereiken."
                            },
                            {
                                "example_id": "a52f9290-b275-4241-81a4-a7d7a97e4495",
                                "sense_id": "098c6b71-dc2e-341e-a3e3-095928005e03",
                                "text": "Het duurt vermoedelijk nog geruime tijd voordat alle lichamen zijn geborgen, zei een bron binnen de hulpdiensten. Helikopters kunnen naar verluidt niet landen op de rampplek. Daardoor moeten werkzaamheden te voet worden uitgevoerd. Het is nog onduidelijk waardoor het 24 jaar oude toestel crashte."
                            }
                        ]
                    }
