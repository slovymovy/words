                        "en": [
                            {
                                "target_lang_word": "PAN",
                                "target_lang_sense_clarification": "abbreviation for Polish Academy of Sciences"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2df6476b-fd73-369c-8f6c-e9f2035e2da4",
                    "sense_definition": "Grecki bóg opiekuńczy lasów i pól, strzegący pasterzy oraz ich trzód, przedstawiany z koźlimi nogami.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mythology",
                    "name_type": "mythological_or_astrological_entity",
                    "examples": [
                        {
                            "text": "Mityczny <w>Pan</w> grał na fletni, zwanej syryngą.",
                            "target_lang_translations": {
                                "ru": "Мифический <w>Пан</w> играл на флейте, называемой сирингой.",
                                "en": "The mythical <w>Pan</w> played the panpipes, called a syrinx."
                            }
                        },
                        {
                            "text": "Nagłe pojawienie się boga <w>Pana</w> wywoływało paniczny strach.",
                            "target_lang_translations": {
                                "ru": "Внезапное появление бога <w>Пана</w> вызывало панический страх.",
                                "en": "The sudden appearance of the god <w>Pan</w> caused panic."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Греческий бог лесов и полей, покровитель пастухов и стад, изображаемый с козлиными ногами.",
                        "en": "Greek god of forests and fields, protector of shepherds and their flocks, depicted with goat legs."
                    },
                    "translations": {
