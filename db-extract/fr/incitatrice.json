                            {
                                "example_id": "31643ab6-d38a-450d-91f6-101d1c6d8e28",
                                "sense_id": "bd5b42bd-96e3-379c-bb0f-01d77a6a742c",
                                "text": "Tel était bien le but de la « Sainte Eglise », qui voyait dans la femme la plus grande incitatrice au péché."
                            }
