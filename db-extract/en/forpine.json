                        "glosses": [
                            "To pine away."
                        ],
                        "tags": [
                            "intransitive",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "499a1248-0f9e-4600-a6c8-e68acf9b8abd",
                                "sense_id": "263458f2-839f-3fdb-9582-f53e5a7a5bf5",
                                "text": "But, through long anguish and selfe-murd'ring\nHe was so wasted and forpined quight"
                            }
                        ]
                    },
                    {
                        "sense_id": "798b400e-87dc-3efc-98ca-229f03ca3dff",
                        "entry_id": "a9748862-c230-3540-9473-7e21e027bce4",
                        "glosses": [
                            "To waste away through suffering or through torment."
                        ],
                        "tags": [
                            "archaic",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "95780531-b944-47f1-b0df-c00984ae3ef7",
                                "sense_id": "798b400e-87dc-3efc-98ca-229f03ca3dff",
                                "text": "[…] While to my sight thy giant stature rears\nIts bulk forpined upon these savage rocks\nIn shameful bonds the linked adamant locks."
                            }
                        ]
                    }
