                "senses": [
                    {
                        "sense_id": "11f96ad1-fd33-36c4-907f-41814e554fd6",
                        "entry_id": "3c5b5ac0-be53-3424-8a2d-7ece83417f82",
                        "glosses": [
                            "Hunger"
                        ],
                        "tags": [
                            "Wien"
                        ],
                        "examples": [
                            {
                                "example_id": "afb45aeb-6574-4d05-a256-0cf130a3fdce",
                                "sense_id": "11f96ad1-fd33-36c4-907f-41814e554fd6",
                                "text": "„»Eigentlich habe ich schon einen ziemlichen Flameau«, seufzte Walz gähnend, nachdem er seiner Freundin in einem von vielen Zwischenfragen unterbrochenen Gespräch das Geschehen erklärt hatte, »so früh aufstehen müssen und dann noch dazu im Nachhinein erfahren, dass alle Müh' und Plag' umsonst war – das kann nicht ohne Folgen auf die Psyche bleiben. […]«“"
                            },
                            {
                                "example_id": "f60fdcfd-0026-4115-aa5b-1d9094288fef",
                                "sense_id": "11f96ad1-fd33-36c4-907f-41814e554fd6",
                                "text": "„Der Flameau der beiden ist gewaltig, und sie beschließen, sich durch die Speisekarte durchzuessen.“"
                            },
                            {
                                "example_id": "2c96486f-207a-4221-8e1e-4e2038c17a11",
                                "sense_id": "11f96ad1-fd33-36c4-907f-41814e554fd6",
                                "text": "„Was heißt da: Hunger?! – Einen Riesen-Flameau hab ich g' habt!“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
