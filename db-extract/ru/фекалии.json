                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fèces",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dcdc6072-8b5c-3c24-af56-5451eb63a646",
                                        "entry_id": "7969c6dd-c170-3358-ace8-79c21ad00e45",
                                        "glosses": [
                                            "Sédiment qui reste au fond d’un liquide trouble, après qu’on l’a laissé reposer."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "475e9531-0a0f-3307-9429-6288ed09f9c0",
                                        "entry_id": "7969c6dd-c170-3358-ace8-79c21ad00e45",
                                        "glosses": [
                                            "Dépôts qui se forment au fond des barriques d’huile, et qu’on employait pour faire le mastic."
                                        ],
                                        "tags": [
                                            "Vitrerie"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "98548148-bab2-3f47-b34a-629fbf3a5f6b",
                                        "entry_id": "7969c6dd-c170-3358-ace8-79c21ad00e45",
                                        "glosses": [
                                            "Excréments solides de l’homme ou des animaux, formés des résidus de la digestion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c783ac5c-2e4b-44f9-af49-e77feb9b3d95",
                                                "sense_id": "98548148-bab2-3f47-b34a-629fbf3a5f6b",
                                                "text": "La consistance et la couleur des fèces produites par un animal sain varient bien entendu avec le régime alimentaire. Par conséquent, il convient d’en tenir compte et de savoir reconnaître les excréments « normaux » produits par des animaux en bonne santé recevant différents régimes alimentaires, fréquentant différents parcours ou conduits selon divers modes de gestion, etc."
                                            },
                                            {
                                                "example_id": "2bf3718a-eb98-4cc0-a70a-bba227ade9b7",
                                                "sense_id": "98548148-bab2-3f47-b34a-629fbf3a5f6b",
                                                "text": "En effet, l’analyse des fèces de 57 mâles a mis en évidence 34 haplotypes Y différents, qu’on retrouve de manière homogène sur toute cette aire."
                                            },
                                            {
                                                "example_id": "999c334a-2d37-4b88-bbc9-0ab02aac1cbc",
                                                "sense_id": "98548148-bab2-3f47-b34a-629fbf3a5f6b",
                                                "text": "Nous naissons entre l’urine et les fèces."
                                            }
                                        ]
                                    }
                                ]
                            },
