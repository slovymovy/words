                "senses": [
                    {
                        "sense_id": "76273a45-48f2-3463-a692-4ceb0f20dc17",
                        "entry_id": "64b8022c-c756-31bd-a1d9-f721be91f3b5",
                        "glosses": [
                            "aus Italien stammende Strophenform mit dem Reimschema abababcc"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fafd241b-e836-4689-8704-ffff56a16854",
                                "sense_id": "76273a45-48f2-3463-a692-4ceb0f20dc17",
                                "text": "„Die Mädchen hatten die drei Stanzen zum Preise der Schlehenblüten noch nicht beendet, als Jing Bo-djau erschien.“"
                            },
                            {
                                "example_id": "935b1fa8-2109-4151-83e9-c4e6d07fb74d",
                                "sense_id": "76273a45-48f2-3463-a692-4ceb0f20dc17",
                                "text": "„Er schloß ein Schreibpult auf und gab mir zehn Stanzen zu lesen, die von ihm handelten.“"
                            },
                            {
                                "example_id": "ff25c393-d219-4fea-8bfd-ec4972e31e98",
                                "sense_id": "76273a45-48f2-3463-a692-4ceb0f20dc17",
                                "text": "„»Ottave rime« oder Stanzen sind eine im Italienischen wohl eingeführte Strophenform, bestehend aus je acht elfsilbigen Versen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
