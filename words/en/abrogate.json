{
    "word_family": [
        "abrogation",
        "abrogative",
        "abrogator"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "563f403b-9a0c-3313-aa7e-c432aea4f2e4",
                    "sense_definition": "To officially end or cancel a law, agreement, or formal custom through an authoritative act.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "legal_annulment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government decided to <w>abrogate</w> the treaty after the other nation failed to meet its obligations.",
                            "target_lang_translations": {
                                "ru": "Правительство решило <w>расторгнуть</w> договор после того, как другое государство не выполнило свои обязательства."
                            }
                        },
                        {
                            "text": "The new administration intends to <w>abrogate</w> a treaty that has been in place for decades.",
                            "target_lang_translations": {
                                "ru": "Новая администрация намерена <w>аннулировать</w> договор, действовавший десятилетиями."
                            }
                        }
                    ],
                    "synonyms": [
                        "repeal",
                        "annul",
                        "nullify",
                        "rescind",
                        "revoke",
                        "invalidate"
                    ],
                    "antonyms": [
                        "establish",
                        "fix",
                        "promulgate"
                    ],
                    "common_phrases": [
                        "abrogate a treaty",
                        "abrogate a law",
                        "abrogate an agreement"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "formal and legalistic"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Официально прекратить действие или отменить закон, соглашение или формальный обычай посредством властного акта."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "аннулировать",
                                "target_lang_sense_clarification": "объявлять недействительным"
                            },
                            {
                                "target_lang_word": "отменять",
                                "target_lang_sense_clarification": "упразднять закон или распоряжение"
                            },
                            {
                                "target_lang_word": "расторгать",
                                "target_lang_sense_clarification": "прекращать действие договора или соглашения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "abe69115-4d8f-3f06-8fd5-9a81b12bd279",
                    "sense_definition": "To fail to carry out a responsibility or to do away with a duty or practice.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "ending_responsibility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company was accused of trying to <w>abrogate</w> its responsibility to provide a safe working environment.",
                            "target_lang_translations": {
                                "ru": "Компанию обвинили в попытке <w>сложить с себя</w> ответственность за обеспечение безопасных условий труда."
                            }
                        },
                        {
                            "text": "Leaders should never <w>abrogate</w> responsibility for the safety of their citizens during a crisis.",
                            "target_lang_translations": {
                                "ru": "Лидеры никогда не должны <w>уклоняться</w> от ответственности за безопасность своих граждан во время кризиса."
                            }
                        }
                    ],
                    "synonyms": [
                        "repudiate",
                        "renounce",
                        "abandon",
                        "do away with"
                    ],
                    "common_phrases": [
                        "abrogate responsibility",
                        "abrogate a duty"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "formal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Не выполнить обязательство или отказаться от исполнения долга или сложившейся практики."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "слагать с себя",
                                "target_lang_sense_clarification": "отказываться от ответственности"
                            },
                            {
                                "target_lang_word": "отрекаться",
                                "target_lang_sense_clarification": "отказываться от выполнения долга"
                            },
                            {
                                "target_lang_word": "уклоняться",
                                "target_lang_sense_clarification": "избегать выполнения обязанностей"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4446995d-25a8-33b2-89ab-17a4d7a639f4",
                    "sense_definition": "To block, inhibit, or interfere with a biological process or mechanical function.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "functional_blockage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The researchers found a specific protein that can <w>abrogate</w> the signaling pathway of the virus.",
                            "target_lang_translations": {
                                "ru": "Исследователи обнаружили специфический белок, способный <w>подавить</w> сигнальный путь вируса."
                            }
                        },
                        {
                            "text": "Certain chemical compounds are known to <w>abrogate</w> the function of these enzymes entirely.",
                            "target_lang_translations": {
                                "ru": "Известно, что определенные химические соединения полностью <w>блокируют</w> функцию этих ферментов."
                            }
                        }
                    ],
                    "synonyms": [
                        "inhibit",
                        "block",
                        "suppress"
                    ],
                    "common_phrases": [
                        "abrogate the function",
                        "abrogate the effect"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "scientific and technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Блокировать, подавлять или препятствовать биологическому процессу или механической функции."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подавлять",
                                "target_lang_sense_clarification": "пресекать биологический процесс"
                            },
                            {
                                "target_lang_word": "блокировать",
                                "target_lang_sense_clarification": "препятствовать функционированию"
                            },
                            {
                                "target_lang_word": "ингибировать",
                                "target_lang_sense_clarification": "замедлять или предотвращать реакцию"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "4e7236f7-6bb4-372a-a597-ade7ee8ea877",
                    "sense_definition": "Being in a state of having been abolished or annulled.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "legal_annulment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The scholar studied the <w>abrogate</w> customs of the ancient civilization to understand their social decline.",
                            "target_lang_translations": {
                                "ru": "Ученый изучал <w>упраздненные</w> обычаи древней цивилизации, чтобы понять причины их социального упадка."
                            }
                        },
                        {
                            "text": "He found himself lost in a world of <w>abrogate</w> laws and forgotten traditions.",
                            "target_lang_translations": {
                                "ru": "Он почувствовал себя потерянным в мире <w>отмененных</w> законов и забытых традиций."
                            }
                        }
                    ],
                    "synonyms": [
                        "abolished",
                        "annulled",
                        "void"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used as an adjective in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Находящийся в состоянии отмены или аннулирования."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отмененный",
                                "target_lang_sense_clarification": "утративший силу"
                            },
                            {
                                "target_lang_word": "аннулированный",
                                "target_lang_sense_clarification": "признанный недействительным"
                            },
                            {
                                "target_lang_word": "упраздненный",
                                "target_lang_sense_clarification": "о законах или обычаях"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}