        "fr-extract.jsonl": [
            {
                "entry_id": "463875dc-05dd-3ced-85dd-e82a4149f930",
                "word": "alourdissement",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "20a47b82-471b-4f11-a6e8-5631362ca7a3",
                        "entry_id": "463875dc-05dd-3ced-85dd-e82a4149f930",
                        "tags": [
                            "plural"
                        ],
                        "form": "alourdissements"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "687979e1-26d3-356a-81f1-2d4a7620d3bd",
                        "entry_id": "463875dc-05dd-3ced-85dd-e82a4149f930",
                        "glosses": [
                            "État de ce qui est alourdi."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e3b42c6f-2a58-40b8-ab9d-acbeb83c3be0",
                                "sense_id": "687979e1-26d3-356a-81f1-2d4a7620d3bd",
                                "text": "Il ressentit de l’alourdissement."
                            },
                            {
                                "example_id": "0a88d786-a420-4a27-b12b-9ccf58087458",
                                "sense_id": "687979e1-26d3-356a-81f1-2d4a7620d3bd",
                                "text": "L’alourdissement des sens."
                            },
                            {
                                "example_id": "11b8f146-4a63-4a7e-a573-d773b72231fc",
                                "sense_id": "687979e1-26d3-356a-81f1-2d4a7620d3bd",
                                "text": "Un alourdissement de tous ses membres, accompagné d’un commencement de nausées l’avertit bientôt qu’il avait sous la main un laboratoire naturel de belladone, c’est-à-dire du plus actif des narcotiques."
                            },
                            {
                                "example_id": "b0b2d92b-ab50-4a4c-a06d-10b788c8e47d",
                                "sense_id": "687979e1-26d3-356a-81f1-2d4a7620d3bd",
                                "text": "Le baron, l'ayant vue chaque jour, n'avait point remarqué cette décadence; et, quand elle se plaignait de ses étouffements continus, de son alourdissement grandissant, il répondait: « Mais non, ma chère, je vous ai toujours connue comme ça. »"
                            },
                            {
                                "example_id": "27f0b903-642e-433e-9d8c-5040f28a44ae",
                                "sense_id": "687979e1-26d3-356a-81f1-2d4a7620d3bd",
                                "text": "Ce contexte est marqué par un alourdissement du travail, une réduction des temps d'intervention, avons-nous vu plus haut."
                            },
                            {
                                "example_id": "fc9e35c5-4487-49cb-9079-3ab5eca44b8f",
                                "sense_id": "687979e1-26d3-356a-81f1-2d4a7620d3bd",
                                "text": "J’aime l’alourdissement de cette fin d’été."
                            }
                        ]
                    }
                ],
