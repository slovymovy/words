                                        "entry_id": "1a20ad81-6560-3462-b296-25aef0da568c",
                                        "glosses": [
                                            "królowa Etiopii, żona Cefeusza i matka Andromedy, po śmierci przeniesiona na firmament jako gwiazdozbiór Kasjopei (1.2)"
                                        ],
                                        "tags": [
