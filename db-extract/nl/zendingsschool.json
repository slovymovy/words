                            {
                                "example_id": "f6e7a954-e285-4913-a5fb-8556a7d27e4e",
                                "sense_id": "18660940-2357-3be9-b4af-b4ee700e601b",
                                "text": "Hij studeerde aan de zendingsschool in het Zwitserse Basel, de Basler Mission, die vanuit het lutherse piëtisme werd ondersteund."
                            },
                            {
                                "example_id": "dc169bec-db32-48c6-a1b4-0613523d62b3",
                                "sense_id": "18660940-2357-3be9-b4af-b4ee700e601b",
                                "text": "De laatste jaren van zijn leven is de bejaarde ”vader van het toerisme” nog actief en buitengewoon vrijgevig voor zijn Baptistenunie en de verspreiding van Gods Woord. Hij had meegewerkt aan de oprichting van een baptistenkerk in Rome en een zendingsschool in Jeruzalem gesteund."
                            }
