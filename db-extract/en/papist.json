                    },
                    {
                        "translation_id": "4417f4bf-0f9b-43c9-a3ff-7c1bc5f6a160",
                        "source_entry_id": "a55c4879-8cd4-3a43-8c8e-811f6a542325",
                        "source_sense_id": "7c93efe7-4a0e-3b1e-aba9-0bde7ae591d0",
