                    {
                        "sense_id": "e5a47d81-23a6-30a1-bbc6-b5cc3544891e",
                        "entry_id": "1da387a0-dea3-31f0-b9cc-7216175e2130",
                        "glosses": [
                            "Petites choses délicates, comme les ris de veau, les crêtes de coq, que l’on met dans les pâtés, les ragoûts, etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59199a3c-feee-45ad-b25a-538949e02469",
                                "sense_id": "e5a47d81-23a6-30a1-bbc6-b5cc3544891e",
                                "text": "C’est une pièce de pâtisserie qu’on fait cuire dans une tourtière, & qui est faite de pigeonneaux, de béatille, de moelle ou de fruits."
                            },
                            {
                                "example_id": "bb0006c4-513b-4b84-b03f-98a547541ff5",
                                "sense_id": "e5a47d81-23a6-30a1-bbc6-b5cc3544891e",
                                "text": "Ce sont pâtés en croûte, dorés comme jour naissant, pâtés de béatilles, faits de petits oiseaux, de truffes, de riz, de crêtes."
                            },
                            {
                                "example_id": "f9a6716c-35e2-482e-a26b-90b53373506e",
                                "sense_id": "e5a47d81-23a6-30a1-bbc6-b5cc3544891e",
                                "text": "– Tes béatilles, c’est comme de la garniture de vol-au-vent… Apporte-moi tes crêtes de coq, je te ferai un vol-au-vent."
                            },
                            {
                                "example_id": "8bffe8cb-2dbd-4235-88be-ea8b06f15ea8",
                                "sense_id": "e5a47d81-23a6-30a1-bbc6-b5cc3544891e",
                                "text": "Sa recette était la suivante : filet de chevreuil en croûte de pain d’épices, accompagné d’une pomme confite aux chanterelles, d’une royale de potiron et sa béatille ainsi que d’un crumble poire cassis, le tout servi avec une sauce émulsionnée à l’huile de cèpes et aux morilles."
                            }
                        ]
                    }
