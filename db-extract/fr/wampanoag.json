                        "entry_id": "840efec1-b46b-360d-a774-b86d1ea67ab9",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "Wampanoags"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2c5f9438-e4ea-3cca-9c23-fa548f60dd06",
                        "entry_id": "840efec1-b46b-360d-a774-b86d1ea67ab9",
                        "glosses": [
                            "Personne appartenant au peuple wampanoag, Algonquiens de la baie de Cape Cod parlant le massachusett (ou wampanoag)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ec56355-a251-4cc2-9738-a0fafe44e4ab",
                                "sense_id": "2c5f9438-e4ea-3cca-9c23-fa548f60dd06",
                                "text": "Les Wampanoag se sont retrouvés seuls pour combattre les colons et les tribus qui s’étaient ralliées aux Anglais."
                            },
                            {
                                "example_id": "0ba9a3f7-23f8-4aed-a514-dbe4efd65d8c",
                                "sense_id": "2c5f9438-e4ea-3cca-9c23-fa548f60dd06",
                                "text": "L’été et l’automne de 1675 s’étaient passés en hostilités actives entre les Anglais et les Wampanoags, sans attirer ouvertements aucune autre nation dans leur querelle."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1d7d3684-22b4-40d5-9800-8e81891f9e45",
                        "source_entry_id": "840efec1-b46b-360d-a774-b86d1ea67ab9",
                        "source_sense_id": "2c5f9438-e4ea-3cca-9c23-fa548f60dd06",
