                    {
                        "sense_id": "b5ff1e1c-bd56-31ec-8b2b-f318fafd7ed4",
                        "entry_id": "e0aa9a7a-5226-3452-bf6e-61aa94b3d020",
                        "glosses": [
                            "eine Modellpflege in der Automobilbranche"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59ed6e9e-907f-4632-a27d-85e5509e8312",
                                "sense_id": "b5ff1e1c-bd56-31ec-8b2b-f318fafd7ed4",
                                "text": "Mit dem Facelift des Mercedes W 123 erhielten 1982 alle Modelle die Breitbandscheinwerfer, die zuvor den Spitzenmodellen vorbehalten waren."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "ee9c111a-b5c1-3401-9f16-4176282c4e6a",
                        "entry_id": "e0aa9a7a-5226-3452-bf6e-61aa94b3d020",
                        "glosses": [
                            "ein Eingriff zur Gesichtsstraffung in der plastischen Chirurgie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "48742202-6d48-4550-86c7-40a40779001f",
                                "sense_id": "ee9c111a-b5c1-3401-9f16-4176282c4e6a",
                                "text": "Ein Facelift lässt Sie um Jahre jünger wirken."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "71e2c563-d4f3-4127-9cf5-e0280a930b23",
                        "source_entry_id": "e0aa9a7a-5226-3452-bf6e-61aa94b3d020",
