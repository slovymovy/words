                    "frequency": "High",
                    "semantic_group_id": "tristesse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle éprouve un profond <w>chagrin</w> depuis la perte de son fidèle compagnon."
                        },
                        {
                            "text": "Il essayait de cacher son grand <w>chagrin</w> derrière un sourire courageux."
                        }
                    ],
