                                        "glosses": [
                                            "om te draaien, terug te gaan van waar men komt, binnenstebuiten te draaien"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d16459f8-1089-435f-9df0-faf7ee44430d",
                                                "sense_id": "b0c426dd-ec38-3f76-b33b-03fb5934b97e",
                                                "text": "Systeemveranderingen zijn vaak moeilijk omkeerbaar, leren ecologen. Dat geldt ook hiervoor zegt Scheffer: „De klimaatverandering maakt de droge delen van de aarde onleefbaar. Dat betekent dat veel mensen elders moeten gaan wonen. Dat is wat er nu gebeurt met de komst van vluchtelingen naar Europa.”"
                                            }
