                                        "glosses": [
                                            "An ingressive sound made by coarticulating a velar or uvular closure with another closure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d869756b-f8fb-4680-87ec-4a20b6f846d5",
                                                "sense_id": "1c919541-6bc5-3d7c-a0d0-3adc7e49bcc6",
                                                "text": "tsk is a click in English."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "02113506-c74c-3318-bfe0-70a52c298fcc",
                                        "entry_id": "ff7484ca-a42f-30cc-a81d-b4deae26394a",
