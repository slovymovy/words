                "senses": [
                    {
                        "sense_id": "8bd2987f-0396-3b69-8b42-da209d3f5ede",
                        "entry_id": "8098b3f4-12fd-39ca-894e-dabe8ca895b1",
                        "glosses": [
                            "abfällige Bezeichnung für Franzose"
                        ],
                        "tags": [
                            "archaic",
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "4e75bed2-f153-4180-a967-da3b4b6da909",
                                "sense_id": "8bd2987f-0396-3b69-8b42-da209d3f5ede",
                                "text": "„Als ein paar renitente Franzmänner in Acadia, Kanada, es 1710 ablehnten, den Briten die Treue zu schwören, wurden sie über die nächsten Jahrzehnte kaltherzig den Mississippi hinuntergejagt.“"
                            },
                            {
                                "example_id": "2b9f7bf5-5419-4fb7-aa2a-18476a8c736b",
                                "sense_id": "8bd2987f-0396-3b69-8b42-da209d3f5ede",
                                "text": "„Aber der Franzmann schnalzte mit der Zunge und zwinkerte mit den Augen.“"
                            },
                            {
                                "example_id": "9d4abcab-7c64-4bb8-aabc-6e57e153bfb3",
                                "sense_id": "8bd2987f-0396-3b69-8b42-da209d3f5ede",
                                "text": "„Ein Franzmann sollte ein Bäuchlein haben wie der Baron de Charlus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f898ca8c-21ca-41e1-9fab-efe26f434d32",
                        "source_entry_id": "8098b3f4-12fd-39ca-894e-dabe8ca895b1",
                        "source_sense_id": "8bd2987f-0396-3b69-8b42-da209d3f5ede",
