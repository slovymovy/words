                    {
                        "sense_id": "92ce5abc-b7af-36f8-a7d6-c740aee77f48",
                        "entry_id": "3a776026-f3ec-3d9c-82d1-1477371d4c75",
                        "glosses": [
                            "Otaria Péron, rodzaj drapieżnego ssaka morskiego z rodziny uchatkowatych występujący u południowych wybrzeży Ameryki Południowej"
                        ],
                        "tags": [
                            "syst."
                        ],
                        "examples": [
                            {
                                "example_id": "1889acba-ee49-4300-94b2-42f0d755ec0b",
                                "sense_id": "92ce5abc-b7af-36f8-a7d6-c740aee77f48",
                                "text": "Samica uchatki rodzi zwykle jedno młode."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "3779336f-6f27-37a7-9bcd-afd95ebc24e0",
                        "entry_id": "3a776026-f3ec-3d9c-82d1-1477371d4c75",
                        "glosses": [
                            "drapieżnik z rodzaju uchatka (1.1)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a32a37ca-1770-45e7-98a0-02e90025ae5b",
                                "sense_id": "3779336f-6f27-37a7-9bcd-afd95ebc24e0",
                                "text": "Na skałach leżała szarobrunatna uchatka."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "45b12844-dfbc-424c-a52e-0ee8fe44cf7f",
                        "source_entry_id": "3a776026-f3ec-3d9c-82d1-1477371d4c75",
                        "source_sense_id": "92ce5abc-b7af-36f8-a7d6-c740aee77f48",
                        "target_lang_word": "sea lion",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sea lion",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cea57374-d396-367d-90fd-6caea68ca221",
                                        "entry_id": "8125ad88-b152-3c63-a3a4-89d50868503f",
                                        "glosses": [
                                            "A marine mammal of most genera in the family Otariidae (the eared seals)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e42ca899-0cb5-4d55-b5ae-b477a769fb46",
                                                "sense_id": "cea57374-d396-367d-90fd-6caea68ca221",
                                                "text": "But Sophia's mother was not the woman to brook defiance. After a few moments' vain remonstrance her husband complied. His manner and appearance were suggestive of a satiated sea-lion."
                                            },
                                            {
                                                "example_id": "a859d67b-ec5b-4cf4-b10f-5fab4f8b5bb6",
                                                "sense_id": "cea57374-d396-367d-90fd-6caea68ca221",
                                                "text": "Peek a Boo said, \"I'm sorry guys, please tell my father that I'm ok. You see, I'm trying to become the first sea lion to become a Navy Seal.” The Jamaican Shaken Crabs looked at each other and said, “I don't know if your father told you, but you're a sea lion and no sea lion has ever become a Navy Seal.\""
                                            },
                                            {
                                                "example_id": "731d003f-d0d3-4a8d-8658-51481cd9138e",
                                                "sense_id": "cea57374-d396-367d-90fd-6caea68ca221",
                                                "text": "Sea lion pups are born with baby teeth, but most of these are replaced with permanent adult teeth by the time the pup is four months old. An adult sea lion has a total of 34 to 36 teeth, with 10 incisors in the front (six in the upper jaw and four in the lower jaw) plus two long canines and 10 to 12 cheek teeth on each side. Sea lions do not chew their food."
                                            },
                                            {
                                                "example_id": "2d94df2d-c5e0-4d00-bfb6-cefd49167c52",
                                                "sense_id": "cea57374-d396-367d-90fd-6caea68ca221",
                                                "text": "When people ask me what the circus is really like behind the scenes, I tell them about runaway gypsy wagons, vanished acrobats, desperate ringmasters and recalcitrant sea lions to name a few."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e2983c6a-bb51-3489-9ebd-b35f86aff0ed",
                                        "entry_id": "8125ad88-b152-3c63-a3a4-89d50868503f",
                                        "glosses": [
                                            "A monster consisting of the upper part of a lion combined with the tail of a fish (a lion marined)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e6b9b4f0-ef8d-37d0-be64-befac531670a",
                                        "entry_id": "8125ad88-b152-3c63-a3a4-89d50868503f",
                                        "glosses": [
                                            "A steamer transporting cattle from the ports of Texas."
                                        ],
                                        "tags": [
                                            "US",
                                            "historical",
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "eedf2610-5e06-3ccb-904c-6fa47027e7aa",
                                        "entry_id": "8125ad88-b152-3c63-a3a4-89d50868503f",
                                        "glosses": [
                                            "A cow or bull transported by steamer from the ports of Texas."
                                        ],
                                        "tags": [
                                            "US",
                                            "historical",
                                            "slang"
                                        ],
                                        "examples": []
                                    }
