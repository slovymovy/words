                "senses": [
                    {
                        "sense_id": "c913358a-e59e-3ac0-930d-111f4b148335",
                        "entry_id": "27c7bdda-9c19-3363-9ccf-156aee49dd5f",
                        "glosses": [
                            "Gerät mit radioaktiven Bauteilen, das Alarm schlägt, wenn es messbar zur Rauchentwicklung im Raum kommt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6adfc759-80f0-48cb-b439-d2c26dda9faa",
                                "sense_id": "c913358a-e59e-3ac0-930d-111f4b148335",
                                "text": "„Das Funktionsprinzip der Ionisationsrauchmelder beruht auf der Änderung der Leitfähigkeit von Luft, wenn sie mit bestimmten Partikeln versetzt ist.“"
                            },
                            {
                                "example_id": "9ad50f67-6194-4971-823f-e49780d64491",
                                "sense_id": "c913358a-e59e-3ac0-930d-111f4b148335",
                                "text": "„Ionisationsrauchmelder (IRM) sind Rauchmelder, in denen radioaktive Stoffe, vorwiegend Americium-241, mit Aktivitäten zwischen 15 bis 40 Kilobecquerel, verwendet werden.“"
                            },
                            {
                                "example_id": "932b3265-6fdd-46f9-8260-615546f24cd1",
                                "sense_id": "c913358a-e59e-3ac0-930d-111f4b148335",
                                "text": "„Der Countdown läuft: Laut Strahlenschutzverordnung müssen veraltete Ionisationsrauchmelder (kurz I-Melder) bis zum 1. Juli 2011 einer Dichtheitsprüfung unterzogen werden.“"
                            },
                            {
                                "example_id": "2c434239-30ec-4931-8278-721a62cde825",
                                "sense_id": "c913358a-e59e-3ac0-930d-111f4b148335",
                                "text": "„Schauen wir uns verschiedene Rauch- und Gasmelder genauer an, merken wir sofort, dass sie sich im Innern kaum voneinander unterscheiden – es sei denn, wir legen einen optischen Rauchmelder neben einem sogenannten Ionisationsrauchmelder.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
