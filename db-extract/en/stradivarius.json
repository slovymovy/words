                        "glosses": [
                            "A stringed instrument built by members of the Stradivari family, particularly Antonio Stradivari."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "85522cf1-8e27-33e7-85b2-159e37110f17",
                        "entry_id": "77e0a1ad-8796-3769-b579-3aa9a841e196",
                        "glosses": [
                            "A violin made by another manufacturer, named to capitalise on the fame of the instruments made by Antonio Stradivari."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "9f94962b-6b9a-3380-87d2-d0c548c9235a",
                        "entry_id": "77e0a1ad-8796-3769-b579-3aa9a841e196",
                        "glosses": [
                            "A name invoked as a standard of excellence in unrelated fields."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "5d27977c-c34a-4b96-b3c1-9f84b41649de",
                                "sense_id": "9f94962b-6b9a-3380-87d2-d0c548c9235a",
                                "text": "A Bath boat is the Stradivarius of destroyers!"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "47baaa12-a21f-429a-a156-b38466e72713",
                        "source_entry_id": "77e0a1ad-8796-3769-b579-3aa9a841e196",
                        "source_sense_description": "stringed instrument built by members of the Stradivari family",
                        "target_lang_word": "stradivárky",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stradivárky",
