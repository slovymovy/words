                "senses": [
                    {
                        "sense_id": "f9a74176-fb9f-3ca6-8f17-595af8450662",
                        "entry_id": "2f8d2794-90af-3f59-ba7d-8345d6179ead",
                        "glosses": [
                            "Relatif à la politique de Juan Perón, ou à ses partisans."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "05980e68-b3c4-4c3b-b2ae-97c519c7f9d1",
                                "sense_id": "f9a74176-fb9f-3ca6-8f17-595af8450662",
                                "text": "Cette attitude de pasionaria inflexible face à « l’impérialisme » des pays développés a jusqu’ici plutôt bien réussi à la présidente péroniste, réélue en 2011 avec 54% des voix. Elle sait à merveille stimuler les fiertés nationalistes, d’autant que son pays, qui a su se relever seul de sa chute fin 2001 en envoyant promener les préceptes orthodoxes du FMI, n’a guère de leçons à recevoir d’une Europe à la dérive."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d9d6b4e7-5fb2-4921-8c66-453a1d0cc7f0",
                        "source_entry_id": "2f8d2794-90af-3f59-ba7d-8345d6179ead",
                        "source_sense_id": "f9a74176-fb9f-3ca6-8f17-595af8450662",
                        "target_lang_word": "peronistisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "peronistisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0677114e-0dab-38f5-badc-338f5f045a09",
                                        "entry_id": "5d658083-635f-38a8-91a6-7cabb71d2ae5",
                                        "glosses": [
                                            "sich am Peronismus orientierend, den Grundsätzen des Peronismus entsprechend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d6b9286e-4579-41b0-938f-fedb29e448d9",
                                                "sense_id": "0677114e-0dab-38f5-badc-338f5f045a09",
                                                "text": "„Lucio nimmt die argentinische Version von ›Perón‹ in Angriff, indem er zwei Unbekannte bezahlt, damit sie die Außenwände des Palais de Glace mit peronistischen, unserem Werk gegenüber feindseligen Botschaften besprühen.“"
                                            },
                                            {
                                                "example_id": "5f263e6d-1559-4273-ba6c-6cf7cee42806",
                                                "sense_id": "0677114e-0dab-38f5-badc-338f5f045a09",
                                                "text": "„Ich lächelte, aber die alte peronistische Losung rief auf diesen drei Gesichtern, denen die Muskeln abhanden gekommen zu sein schienen, nicht das geringste Lächeln hervor.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
