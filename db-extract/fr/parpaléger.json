                "senses": [
                    {
                        "sense_id": "fc88911c-013f-3b09-ba9d-37b7fd92c40b",
                        "entry_id": "d8d7b701-2d8a-38fc-8f1a-426d2fdaeb9d",
                        "glosses": [
                            "Variante de parpeléger."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4f62a78a-6e2f-42be-8626-ea77c27b9a99",
                                "sense_id": "fc88911c-013f-3b09-ba9d-37b7fd92c40b",
                                "text": "Mais il avait l’œil, à force de regarder les belles choses qui commençait à parpaléger."
                            },
                            {
                                "example_id": "574e4897-7e15-48e3-90a3-c8a918edad3c",
                                "sense_id": "fc88911c-013f-3b09-ba9d-37b7fd92c40b",
                                "text": "Qu’est-ce t’as à parpaléger comme ça ?"
                            },
                            {
                                "example_id": "bfe1ee60-6990-4bf9-8b5b-8af072456d26",
                                "sense_id": "fc88911c-013f-3b09-ba9d-37b7fd92c40b",
                                "text": "Toujours ce même long visage en lame de couteau avec le front étroit, les cheveux en brosse, les yeux gris très rapprochés l'un de l'autre et qui parpalègent, dès qu'il est ému."
                            }
                        ]
                    }
