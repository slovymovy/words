                ],
                "senses": [
                    {
                        "sense_id": "3e0336f3-3d1f-3fb9-bacc-0f3e821cf63c",
                        "entry_id": "6782991b-a466-31a3-be92-ac3111261693",
                        "glosses": [
                            "der Morgen eines Donnerstages"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c443805-efae-46e2-ba6a-e8c922a53b56",
                                "sense_id": "3e0336f3-3d1f-3fb9-bacc-0f3e821cf63c",
                                "text": "Ich hole dich Donnerstagmorgen zu Hause ab."
                            },
                            {
                                "example_id": "5f740bd7-135c-44bd-95d8-212d524a9dbe",
                                "sense_id": "3e0336f3-3d1f-3fb9-bacc-0f3e821cf63c",
                                "text": "Die Hektik des Donnerstagmorgens durch früheres Aufstehen zu verhindern, gelingt mir nie."
                            },
                            {
                                "example_id": "86026219-e394-425d-b43c-eb8504af0f63",
                                "sense_id": "3e0336f3-3d1f-3fb9-bacc-0f3e821cf63c",
                                "text": "Oft kommt es an Donnerstagmorgen zu Staus in der Straße vor unserem Firmenparkhaus."
                            },
                            {
                                "example_id": "efa53b13-0330-4be0-a10a-eba39c1db2a4",
                                "sense_id": "3e0336f3-3d1f-3fb9-bacc-0f3e821cf63c",
                                "text": "„Es war ein kühler Donnerstagmorgen und fast die gesamte Strecke musste ich gegen einen sturmartigen Gegenwind antreten.“"
                            },
                            {
                                "example_id": "433e4ee3-1a75-4505-ac2b-e642053af79e",
                                "sense_id": "3e0336f3-3d1f-3fb9-bacc-0f3e821cf63c",
                                "text": "„Die europäische Großforschungseinrichtung Cern in Genf unterzieht den weltgrößten Teilchenbeschleuniger einer Generalüberholung: Am Donnerstagmorgen hat das Cern damit begonnen, den Beschleuniger herunterzufahren.“"
                            },
                            {
                                "example_id": "5dee8219-bd27-40ad-89fc-4b261998ac50",
                                "sense_id": "3e0336f3-3d1f-3fb9-bacc-0f3e821cf63c",
                                "text": "„Kelly hatte am Donnerstagmorgen, fast mit Tagesanbruch, die Insel verlassen und sie seitdem nicht wieder betreten; ihr ausgesandter Bote, der Mestize, ein Junge, den sie aufgezogen hatte, war ebenfalls nicht zurückgekehrt, und ihre Gefangene entflohen – Gott allein wußte, wohin –, Grund genug, ein Gemüt wie das ihre zu äußerster Aufregung zu treiben.“"
                            },
                            {
                                "example_id": "0aaaf072-f2a2-4e20-9a35-3e8b3ffb6e07",
                                "sense_id": "3e0336f3-3d1f-3fb9-bacc-0f3e821cf63c",
                                "text": "„Donnerstagmorgen bei Tagesanbruch brannten alle Häuser auf beiden Seiten der Nörregade.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
