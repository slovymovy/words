                                "sense_id": "c65ecb8b-2043-3740-be46-ab10342d1b31",
                                "text": "Der Beifang (Gammel) wird mit heimgebracht und an Darren und Fischmehlfabriken verkauft."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
