{
    "word_family": [
        "spurner"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "040f24bd-1789-339e-b443-0c146571e50d",
                    "sense_definition": "To reject something with disdain or contempt.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "rejection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company decided to <w>spurn</w> the merger offer because it undervalued their long-term potential.",
                            "target_lang_translations": {
                                "pl": "Firma zdecydowała się <w>odrzucić</w> ofertę fuzji, ponieważ zaniżała ona ich długoterminowy potencjał.",
                                "nl": "Het bedrijf besloot het fusievoorstel te <w>versmaden</w> omdat het hun langetermijnpotentieel onderschatte."
                            }
                        },
                        {
                            "text": "He chose to <w>spurn</w> the advice of his mentors and followed his own path instead.",
                            "target_lang_translations": {
                                "pl": "Postanowił <w>wzgardzić</w> radami swoich mentorów i zamiast tego podążył własną ścieżką.",
                                "nl": "Hij koos ervoor om het advies van zijn mentoren in de wind te slaan en te <w>versmaden</w>, en volgde in plaats daarvan zijn eigen pad."
                            }
                        }
                    ],
                    "synonyms": [
                        "reject",
                        "scorn",
                        "rebuff"
                    ],
                    "antonyms": [
                        "accept",
                        "embrace"
                    ],
                    "common_phrases": [
                        "spurn an offer",
                        "spurn advice"
                    ],
                    "target_lang_definitions": {
                        "pl": "Odrzucić coś z pogardą lub lekceważeniem.",
                        "nl": "Iets met minachting of afwijzing van de hand wijzen."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "odrzucić",
                                "target_lang_sense_clarification": "odrzucić ofertę lub propozycję z pogardą"
                            },
                            {
                                "target_lang_word": "wzgardzić",
                                "target_lang_sense_clarification": "okazać pogardę wobec czegoś lub kogoś"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "versmaden",
                                "target_lang_sense_clarification": "met minachting weigeren of afwijzen"
                            },
                            {
                                "target_lang_word": "afwijzen",
                                "target_lang_sense_clarification": "niet ingaan op een aanbod of voorstel"
                            },
                            {
                                "target_lang_word": "minachten",
                                "target_lang_sense_clarification": "met verachting bejegenen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "07f6e354-3e6c-3ae6-8230-1d09b574df78",
                    "sense_definition": "To fail to take advantage of an opportunity.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "rejection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The striker <w>spurned</w> a golden opportunity to score the winning goal in the final minute.",
                            "target_lang_translations": {
                                "pl": "Napastnik <w>zmarnował</w> złotą okazję na zdobycie zwycięskiego gola w ostatniej minucie.",
                                "nl": "De spits liet in de laatste minuut een gouden kans <w>onbenut</w> om de winnende treffer te maken."
                            }
                        },
                        {
                            "text": "After having <w>spurned</w> several chances to win, the team eventually lost the match.",
                            "target_lang_translations": {
                                "pl": "Po <w>zmarnowaniu</w> kilku szans na wygraną, drużyna ostatecznie przegrała mecz.",
                                "nl": "Na verscheidene kansen op de overwinning te hebben <w>verprutst</w>, verloor het team uiteindelijk de wedstrijd."
                            }
                        }
                    ],
                    "synonyms": [
                        "squander",
                        "waste"
                    ],
                    "common_phrases": [
                        "spurn a chance"
                    ],
                    "target_lang_definitions": {
                        "pl": "Nie wykorzystać nadarzającej się okazji.",
                        "nl": "Een kans onbenut laten of verprutsen."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "zmarnować",
                                "target_lang_sense_clarification": "nie wykorzystać szansy lub okazji"
                            },
                            {
                                "target_lang_word": "przepuścić",
                                "target_lang_sense_clarification": "stracić okazję"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "onbenut laten",
                                "target_lang_sense_clarification": "een kans voorbij laten gaan"
                            },
                            {
                                "target_lang_word": "verprutsen",
                                "target_lang_sense_clarification": "een mogelijkheid verspillen"
                            },
                            {
                                "target_lang_word": "versmaden",
                                "target_lang_sense_clarification": "een kans niet willen grijpen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4545cd49-f94f-3514-a74d-d6e3e7639fb0",
                    "sense_definition": "To push or kick something away with the foot.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "physical_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The angry man <w>spurned</w> the dirt from his boots before entering the house.",
                            "target_lang_translations": {
                                "pl": "Zły mężczyzna <w>odtrącił</w> brud ze swoich butów przed wejściem do domu.",
                                "nl": "De boze man <w>schopte</w> het vuil van zijn laarzen voordat hij het huis binnenging."
                            }
                        },
                        {
                            "text": "He <w>spurned</w> the fallen object aside as he walked past.",
                            "target_lang_translations": {
                                "pl": "Przechodząc obok, <w>odkopnął</w> leżący przedmiot na bok.",
                                "nl": "Hij <w>schopte</w> het gevallen voorwerp opzij terwijl hij voorbijliep."
                            }
                        }
                    ],
                    "synonyms": [
                        "kick",
                        "push"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This literal physical sense is largely archaic or literary."
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Odepchnąć lub kopnąć coś stopą (użycie przestarzałe).",
                        "nl": "Iets met de voet wegtrappen of wegduwen (verouderd)."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "odtrącić",
                                "target_lang_sense_clarification": "odsunąć coś nogą"
                            },
                            {
                                "target_lang_word": "odkopnąć",
                                "target_lang_sense_clarification": "kopnięciem usunąć przedmiot"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "wegtrappen",
                                "target_lang_sense_clarification": "met de voet opzij schoppen"
                            },
                            {
                                "target_lang_word": "wegschoppen",
                                "target_lang_sense_clarification": "door schoppen verwijderen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9906fed5-1e28-3852-9bab-52c7d487ecfa",
                    "sense_definition": "To kick or toss up the heels.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "physical_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The horse began <w>spurning</w> the ground in excitement.",
                            "target_lang_translations": {
                                "pl": "Koń zaczął <w>wierzgać</w> nogami w ziemię z ekscytacji.",
                                "nl": "Het paard begon van opwinding met zijn hoeven over de grond te <w>schrapen</w>."
                            }
                        },
                        {
                            "text": "The animal <w>spurned</w> its heels as it galloped across the field.",
                            "target_lang_translations": {
                                "pl": "Zwierzę <w>wierzgało</w> kopytami, galopując przez pole.",
                                "nl": "Het dier <w>sloeg achteruit</w> terwijl het over het veld galopeerde."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This usage is archaic."
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Wyrzucać nogi w górę lub wierzgać (użycie przestarzałe).",
                        "nl": "Met de hielen of achterpoten slaan of trappen (verouderd)."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "wierzgać",
                                "target_lang_sense_clarification": "uderzać nogami w powietrze"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "achteruitslaan",
                                "target_lang_sense_clarification": "met de hoeven of poten schoppen"
                            },
                            {
                                "target_lang_word": "trappelen",
                                "target_lang_sense_clarification": "onrustig schoppen met de benen"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d92b4980-4bb4-3441-a136-67809934c0cf",
                    "sense_definition": "A scornful or disdainful rejection.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "rejection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He suffered the <w>spurns</w> of his colleagues after his proposal was rejected.",
                            "target_lang_translations": {
                                "pl": "Doświadczył <w>wzgardy</w> ze strony swoich kolegów po tym, jak jego propozycja została odrzucona.",
                                "nl": "Hij leed onder de <w>afwijzingen</w> van zijn collega's nadat zijn voorstel was afgewezen."
                            }
                        },
                        {
                            "text": "Despite the <w>spurns</w> he faced, he remained committed to his vision.",
                            "target_lang_translations": {
                                "pl": "Pomimo <w>odtrąceń</w>, z którymi się spotkał, pozostał wierny swojej wizji.",
                                "nl": "Ondanks de <w>versmadingen</w> waarmee hij te maken kreeg, bleef hij trouw aan zijn visie."
                            }
                        }
                    ],
                    "synonyms": [
                        "rejection",
                        "scorn"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This noun usage is primarily literary or archaic."
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Pogardliwe odrzucenie (użycie literackie).",
                        "nl": "Een minachtende of hooghartige afwijzing."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "wzgardzenie",
