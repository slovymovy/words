                "senses": [
                    {
                        "sense_id": "a75275ee-bc67-32a9-bb59-47e87e23b0c2",
                        "entry_id": "6ef4f1dd-e074-3d24-904a-55eae3013cca",
                        "glosses": [
                            "Verbform ohne Personalendung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a141870-ef20-4a76-bfce-4c779cd445a7",
                                "sense_id": "a75275ee-bc67-32a9-bb59-47e87e23b0c2",
                                "text": "„Außerdem finden sich comicsprachliche Interjektionen (boing), Inflektive (infinite und unflektierte Verbformen, meist in Sternzeichen gesetzt wie bspw. *grins*, *gähn*) sowie sprachliche Einflüsse verschiedener Varietäten.“"
                            },
                            {
                                "example_id": "f2deaa76-f3a2-4e85-9b47-62296854539d",
                                "sense_id": "a75275ee-bc67-32a9-bb59-47e87e23b0c2",
                                "text": "„Ein weiterer Typ der komplexen Interjektion sind Inflektive (auch Lexeminterjektionen, deverbative Interjektionen) wie ächs, würg, seufz, staun.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
