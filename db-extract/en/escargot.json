                        "cross_references": [
                            {
                                "target_word": "escargot",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1be2caa4-feeb-34e5-9287-135ce27ca523",
                                        "entry_id": "0c03f623-cc68-3c34-a3bd-893306abfc93",
                                        "glosses": [
                                            "Nom générique donné aux mollusques possédant une coquille, particulièrement ceux de la classe des gastéropodes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6dff9f14-241b-4703-aee1-bc1b8aa81aa0",
                                                "sense_id": "1be2caa4-feeb-34e5-9287-135ce27ca523",
                                                "text": "Mon oncle avait une longue canne, terminée par une brochette de fer, au moyen de laquelle il enfilait les limaces et les escargots, mangeurs de salades."
                                            },
                                            {
                                                "example_id": "1c144fd8-3021-4f22-b3f9-d72e14f7b518",
                                                "sense_id": "1be2caa4-feeb-34e5-9287-135ce27ca523",
                                                "text": "Il restait des jardinières envahies de plantes poilues […]. Un pulvérisateur de désherbant pas catholique du tout. Et un escargot qui bavait trop rampait sur un gant perdu au milieu de tout ça."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "df930a81-c711-37e9-8d32-9a9cf494ac69",
                                        "entry_id": "0c03f623-cc68-3c34-a3bd-893306abfc93",
                                        "glosses": [
                                            "Mets préparé avec cet animal, surtout l’escargot de Bourgogne."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1f72dba2-409f-4f17-9929-941f836f6e9e",
                                                "sense_id": "df930a81-c711-37e9-8d32-9a9cf494ac69",
                                                "text": "Les deux hommes consultèrent la carte : il commandèrent chacun une douzaine d’escargots qu’ils arrosèrent de muscadet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9a5bd5af-9420-359f-a479-10957917d0db",
                                        "entry_id": "0c03f623-cc68-3c34-a3bd-893306abfc93",
                                        "glosses": [
                                            "Quelqu’un de lent."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "86defe54-231e-4b10-9a05-8dd3b4a92e99",
                                                "sense_id": "9a5bd5af-9420-359f-a479-10957917d0db",
                                                "text": "En dépit de ma prudence et de mon allure d’escargot contemplatif, j'y ai crevé le carter de mon moteur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e7edca97-e26d-3d43-9343-217390a34788",
                                        "entry_id": "0c03f623-cc68-3c34-a3bd-893306abfc93",
                                        "glosses": [
                                            "Spirale, colimaçon."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "045eb126-4a0d-460b-bd32-44adedc081d6",
                                                "sense_id": "e7edca97-e26d-3d43-9343-217390a34788",
                                                "text": "Escalier en escargot."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b7c7ea49-3a90-3e18-9287-02b0cb449ac8",
                                        "entry_id": "0c03f623-cc68-3c34-a3bd-893306abfc93",
                                        "glosses": [
                                            "Pain aux raisins en forme d’escargot."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "964546e8-272c-402e-9c13-4d3dece557ad",
                                                "sense_id": "b7c7ea49-3a90-3e18-9287-02b0cb449ac8",
                                                "text": "Au petit-déjeuner, je préfère les escargots aux croissants."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "06510586-720a-3b60-b45d-ef5c144d7038",
                                        "entry_id": "0c03f623-cc68-3c34-a3bd-893306abfc93",
                                        "glosses": [
                                            "Terme utilisé pour se moquer des personnes transgenres ou non-binaires."
                                        ],
                                        "tags": [
                                            "offensive",
                                            "pejorative"
                                        ],
                                        "note": "Surtout utilisé par les détracteurs de la cause transgenre et non binaire",
                                        "examples": [
                                            {
                                                "example_id": "593e7c04-e7d3-4528-8c4c-18f1cd4f8a5f",
                                                "sense_id": "06510586-720a-3b60-b45d-ef5c144d7038",
                                                "text": "Je suis un humain, mais je me sens trop un escargot 🐌, tiens je suis escargot, vous refusez je porte plainte ... C'est ça maintenant la vie nous aurons ???"
                                            },
                                            {
                                                "example_id": "cb12ba79-6091-4526-b6ed-94fce685700b",
                                                "sense_id": "06510586-720a-3b60-b45d-ef5c144d7038",
                                                "text": "Imagine tu descends d’une famille de martyr, t’es parents et leurs frères/soeurs ont des traumas profonds de la guerre et du pillage mais tu tombes sur ce tweet écrit par un golmon qui se sent escargot en semaine A et abricotier en semaine B"
                                            },
                                            {
                                                "example_id": "cd62ac32-62ad-4c8e-a3be-40c37a5b8956",
                                                "sense_id": "06510586-720a-3b60-b45d-ef5c144d7038",
                                                "text": "Ben enfait c'est simple Si tu me dis mon pronom c'est iel.. ben tu es un escargot ou???une grenouille;\nsi c'est they ou them ben tu as un trouble psy et faut ce faire soigner ah et evidemment en disant ça la bienpensance vas me tomber dessus"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
