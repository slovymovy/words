                                    {
                                        "sense_id": "84d12e2b-ad25-3435-8003-2fd7ddbd771d",
                                        "entry_id": "25b9e7f8-0821-395f-a722-0547785fb5d1",
                                        "glosses": [
                                            "Rente versée jusqu'au décès du bénéficiaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d2c08463-4db0-4b34-a8c1-ae7f922e6671",
                                                "sense_id": "84d12e2b-ad25-3435-8003-2fd7ddbd771d",
                                                "text": "Il accusait le dévouement de son fils et de sa femme, en prétendant parfois que leurs soins touchants et délicats ne lui étaient si tendrement prodigués que parce qu’il avait placé toute sa fortune en rentes viagères."
                                            },
                                            {
                                                "example_id": "83e27213-1266-41da-a68b-f52ffa38ebae",
                                                "sense_id": "84d12e2b-ad25-3435-8003-2fd7ddbd771d",
                                                "text": "[…] comme le vieillard, ruiné par une fille, qui vend sa rente viagère pour faire un cadeau qui lui méritera encore un sourire, un instant de bonne grâce, le dernier."
                                            },
                                            {
                                                "example_id": "eb473c09-0d62-45f5-a46c-d6aec3fa74b8",
                                                "sense_id": "84d12e2b-ad25-3435-8003-2fd7ddbd771d",
                                                "text": "Le fermier but un verre avec elle et s’en fut, songeant qu’une rente viagère sur la tête d’Augustine, autant semer un clou, on en verrait plus tôt la fleur !"
                                            },
                                            {
                                                "example_id": "64805754-5c5a-4d1e-aa66-a64824d7a536",
                                                "sense_id": "84d12e2b-ad25-3435-8003-2fd7ddbd771d",
                                                "text": "La Caisse des dépôts inscrit alors la rente viagère sur le Grand livre et l’État devient à son tour bénéficiaire du nouveau dispositif en viagérisant ainsi la dette perpétuelle."
                                            }
                                        ]
                                    }
                                ]
                            }
