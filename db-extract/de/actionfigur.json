                            {
                                "target_word": "action figure",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b7ea880a-133d-31fd-a6c5-ef5f8aba3363",
                                        "entry_id": "84a0f74a-8f8e-3eee-9a88-19deff67b545",
                                        "glosses": [
                                            "A children's toy in the form of a posable plastic figurine of a character, often from a movie, video game, or television program, with moving parts and often capable of some form of spring-loaded movement. It is used to distinguish from dolls, which have acquired the reputation as a girl's toy, whereas action figures are more marketed toward boys."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
