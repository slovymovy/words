                "senses": [
                    {
                        "sense_id": "d304ea9c-a38b-3b92-bac0-5f5e96356f6a",
                        "entry_id": "6de82aa5-97d7-390c-80bf-823a98198d60",
                        "glosses": [
                            "bestimmte Anweisung, Regel, die zur ordnungsmäßigen Ausführung eines Amtes einzuhalten ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a61dc24-1419-4486-81f5-9d0955bf7bbc",
                                "sense_id": "d304ea9c-a38b-3b92-bac0-5f5e96356f6a",
                                "text": "„Er habe vielleicht gegen eine Dienstvorschrift verstoßen.“"
                            },
                            {
                                "example_id": "06ea7753-f017-47ae-b5a3-6e05b8ebd55f",
                                "sense_id": "d304ea9c-a38b-3b92-bac0-5f5e96356f6a",
                                "text": "„Eigentlich, nach Dienstvorschrift, sollte sie ja bei Alarm in den Schutzraum laufen, aber was hat das für einen Sinn?“"
                            },
                            {
                                "example_id": "8be38f75-ee55-4927-8c67-194241d31748",
                                "sense_id": "d304ea9c-a38b-3b92-bac0-5f5e96356f6a",
                                "text": "„Seit dem Jahr 2000 nun regelt die Zentrale Dienstvorschrift (ZDv) 14/3, wie Bundeswehrsoldaten mit dem Thema Sexualität umzugehen haben.“"
                            },
                            {
                                "example_id": "a574350f-6158-4ca6-9f92-1108f87fdbe7",
                                "sense_id": "d304ea9c-a38b-3b92-bac0-5f5e96356f6a",
                                "text": "„Das Bundesverwaltungsgericht hat die als ‚Haar- und Bartertlass‘ bekannte Dienstvorschrift der Bundeswehr, die auch Vorgaben zu Tattoos und Piercings enthält, mangels gesetzlicher Ermächtigungsgrundlage für unwirksam erklärt – und gleichzeitig einstweilen ihre weitere Anwendung angeordnet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
