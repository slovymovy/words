                        "sense_id": "b021d719-aa9a-33e7-a3b0-f4426a5a22b5",
                        "entry_id": "23db2eee-4d34-3ef6-b3d2-7439002af41d",
                        "glosses": [
                            "umiejętność przekształcania tekstu zrozumiałego dla wszystkich w tekst zaszyfrowany; szyfrowanie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f054465-a037-4ecd-9c09-ff32a6970aa7",
                                "sense_id": "b021d719-aa9a-33e7-a3b0-f4426a5a22b5",
                                "text": "Ogólnie stosowane w starożytności metody kryptografii można podzielić na dwa rodzaje – przestawianie i podstawianie"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0233a2f2-123a-4629-8c9a-f4b9c9aa1580",
                        "source_entry_id": "23db2eee-4d34-3ef6-b3d2-7439002af41d",
                        "source_sense_id": "b021d719-aa9a-33e7-a3b0-f4426a5a22b5",
                        "target_lang_word": "cryptography",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cryptography",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "01984e08-48da-324c-bfb0-6f84f473a27f",
                                        "entry_id": "3b759864-265f-323c-b387-39255b20a24e",
                                        "glosses": [
                                            "The discipline concerned with communication security (eg, confidentiality of messages, integrity of messages, sender authentication, non-repudiation of messages, and many other related issues), regardless of the used medium such as pencil and paper or computers."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4c9d105e-254a-4822-9d3a-6dd09d47ef65",
                                                "sense_id": "01984e08-48da-324c-bfb0-6f84f473a27f",
                                                "text": "Holonym: cryptology"
                                            },
                                            {
                                                "example_id": "d7011284-b1a3-450c-8883-b5bfc14e2414",
                                                "sense_id": "01984e08-48da-324c-bfb0-6f84f473a27f",
                                                "text": "We might abate...the strange cryptography of Gaffarell in his Starrie Booke of Heaven."
                                            },
                                            {
                                                "example_id": "133eaf9e-28cb-40cd-a82c-26c02cb23e5a",
                                                "sense_id": "01984e08-48da-324c-bfb0-6f84f473a27f",
                                                "text": "[A] man named Satoshi Nakamoto posted a research paper to an obscure cryptography listserv describing his design for a new digital currency that he called bitcoin."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b26ff20d-8575-4e6b-8c0a-634197935c6a",
                        "source_entry_id": "23db2eee-4d34-3ef6-b3d2-7439002af41d",
                        "source_sense_id": "b021d719-aa9a-33e7-a3b0-f4426a5a22b5",
                        "target_lang_word": "kryptografie",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kryptografie",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "02f5f526-68de-3dc5-a790-005cd74c346e",
                                        "entry_id": "cf465ab1-514e-3511-af51-d9957cec4ef5",
                                        "glosses": [
                                            "nauka o ochraně informací šifrováním"
                                        ],
                                        "tags": [],
