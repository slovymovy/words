                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Merchandising",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "75fa59f7-17c1-35aa-a91e-4f6dc7d09291",
                                        "entry_id": "41592d15-f00b-379f-89bd-6ce424b0c22d",
                                        "glosses": [
                                            "die Gesamtheit aller Maßnahmen wie Produktgestaltung, -werbung oder Kundendienst, die den Verkauf eines Produktes oder einer Ware fördern"
                                        ],
                                        "tags": [
                                            "ursprünglich",
                                            "seltenere umfassendere Definition"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0baf84bc-0824-4915-a533-3a995d98dcb0",
                                                "sense_id": "75fa59f7-17c1-35aa-a91e-4f6dc7d09291",
                                                "text": "In Vahlens Großem Wirtschaftslexikon wird Merchandising als Konzept des Handels der optimalen Warenpräsentation und Kommunikation am Verkaufspunkt (point of sale) definiert."
                                            },
                                            {
                                                "example_id": "9bada5b4-7528-488d-8758-ae55c51b8eca",
                                                "sense_id": "75fa59f7-17c1-35aa-a91e-4f6dc7d09291",
                                                "text": "Unter Merchandising werden die Produktion und Vermarktung von Ableger-Produkten rund um ein Hauptprodukt angesehen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b699366c-3cbf-36ca-b8d5-d137c862e337",
                                        "entry_id": "41592d15-f00b-379f-89bd-6ce424b0c22d",
                                        "glosses": [
                                            "die Vermarktung von Produkten, die mit einem bestimmten Film, einem bestimmten Sportereignis oder einem gesellschaftlichen Großereignis in Verbindung stehen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b36f5b72-312e-4b92-bfbf-618215925939",
                                                "sense_id": "b699366c-3cbf-36ca-b8d5-d137c862e337",
                                                "text": "Unter Merchandising werden die Produktion und Vermarktung von Ableger-Produkten rund um ein Hauptprodukt angesehen."
                                            },
                                            {
                                                "example_id": "89670d15-1c4d-4806-826c-b278c84693c5",
                                                "sense_id": "b699366c-3cbf-36ca-b8d5-d137c862e337",
                                                "text": "Das Aufwerten von Billigprodukten durch ein Firmenlogo entspricht nicht einer durchdachten Merchandising-Strategie. Merchandising funktioniert, wenn gewisse Voraussetzungen gegeben sind."
                                            },
                                            {
                                                "example_id": "1cce1466-682f-4fd4-ab77-f167c54c828c",
                                                "sense_id": "b699366c-3cbf-36ca-b8d5-d137c862e337",
                                                "text": "„Alleine die Einnahmen aus dem Pay-TV belaufen sich auf rund 430 Millionen Dollar ( 380 Millionen Euro ). Hinzu kommen Erlöse aus den weltweiten TV-Rechten, dem Merchandising, dem Ticketverkauf und von Sponsoren. Die Top 10 der Großverdiener im Sport: […]“"
                                            },
                                            {
                                                "example_id": "534ad3ad-c275-4852-95d4-4811471680a2",
                                                "sense_id": "b699366c-3cbf-36ca-b8d5-d137c862e337",
                                                "text": "Merchandising kann sogar so weit gehen, dass ein Programm nur hergestellt wird, um später Merchandisingartikel verkaufen zu können."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
