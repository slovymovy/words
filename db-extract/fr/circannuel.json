                "senses": [
                    {
                        "sense_id": "3f15ae67-123e-32c4-b0ee-bc416a818410",
                        "entry_id": "b0640cc8-55e6-3ff1-a22b-f21dea2235a3",
                        "glosses": [
                            "Qui concerne les cycles biologiques à l’échelle d’une année."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da1d08c6-7c97-4f74-b6ef-a9bbc4852849",
                                "sense_id": "3f15ae67-123e-32c4-b0ee-bc416a818410",
                                "text": "Outre la photopériode, certains oiseaux utilisent un « calendrier interne » (une horloge circannuelle)."
                            },
                            {
                                "example_id": "591f92f9-0b21-4019-ad28-30f3093373ec",
                                "sense_id": "3f15ae67-123e-32c4-b0ee-bc416a818410",
                                "text": "Cette saisonnalité est généralement multifactorielle, et l’un des facteurs impliqués est pour de nombreuses espèces une horloge circannuelle. Le mécanisme de cette horloge n’est pas encore élucidé."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7eedb82f-0812-4714-a439-d65d8e27c373",
                        "source_entry_id": "b0640cc8-55e6-3ff1-a22b-f21dea2235a3",
                        "source_sense_id": "3f15ae67-123e-32c4-b0ee-bc416a818410",
