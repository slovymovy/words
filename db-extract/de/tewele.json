                ],
                "senses": [
                    {
                        "sense_id": "3d001b5a-a29b-3622-b150-4d32326d1822",
                        "entry_id": "30014f62-a025-3447-a117-eb065fa556fc",
                        "glosses": [
                            "Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf71bb2f-0754-47bc-9164-f87a6b0a11b5",
                                "sense_id": "3d001b5a-a29b-3622-b150-4d32326d1822",
                                "text": "Frau Tewele ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "a964facb-9021-4bd8-8852-f7d6d0d02b0e",
                                "sense_id": "3d001b5a-a29b-3622-b150-4d32326d1822",
                                "text": "Herr Tewele wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "427e4577-b1fa-4fc1-95f1-e1d65b4c5ac0",
                                "sense_id": "3d001b5a-a29b-3622-b150-4d32326d1822",
                                "text": "Die Teweles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "ee08395c-e0ba-4c62-911b-f85527c5ae80",
                                "sense_id": "3d001b5a-a29b-3622-b150-4d32326d1822",
                                "text": "Der Tewele trägt nie die Schals, die die Tewele ihm strickt."
                            },
                            {
                                "example_id": "7a3d9ab1-3139-4cfa-9cd3-384497fb26cb",
                                "sense_id": "3d001b5a-a29b-3622-b150-4d32326d1822",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Tewele kommt, geht der Herr Tewele.“"
                            },
                            {
                                "example_id": "6847ef8d-e345-4782-a18d-4b1be7c64809",
                                "sense_id": "3d001b5a-a29b-3622-b150-4d32326d1822",
                                "text": "Tewele kommt und geht."
                            },
                            {
                                "example_id": "64635f77-8ede-41c5-83bf-104beef64cbd",
                                "sense_id": "3d001b5a-a29b-3622-b150-4d32326d1822",
                                "text": "Teweles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
