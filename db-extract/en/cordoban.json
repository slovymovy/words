                                        "glosses": [
                                            "Habitant ou natif de la ville de Cordoue, en Espagne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7580387d-f611-47c3-ad4c-1f6699a1e4cf",
                                                "sense_id": "1cb02342-723a-38b1-a84a-208dd9fc9482",
                                                "text": "Actuellement, la Plaza de la Corredera est un espace de loisir de Cordoue. Les tavernes et magasins d’antan ont laissé place, après des multiples remodelages de la place, spécialement celui du XXème siècle, aux bars et aux terrasses pour permettre la détente des Cordouans."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Cordouan",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8950aac0-4d22-33f6-aa8d-3fdbc446c389",
                                        "entry_id": "2d9d10c9-3f9f-3210-90c5-da1f842dd644",
                                        "glosses": [
                                            "Nom donné à une zone de hauts-fonds rocheux et sablonneux située en France, à l’entrée de l'estuaire de la Gironde, dans l’océan Atlantique : le plateau de Cordouan."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e4b633dc-369c-4349-ab8e-3e624373a1d2",
                                                "sense_id": "8950aac0-4d22-33f6-aa8d-3fdbc446c389",
                                                "text": "Niché en bord de mer et face au phare de Cordouan, l’espace a vu défiler les plus grands festivals saint-palaisiens dont Crescendo, Ouest Riderz Festival ou encore Musique et Gastronomie du Monde."
                                            }
                                        ]
                                    }
                                ]
                            }
