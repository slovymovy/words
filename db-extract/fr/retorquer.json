                "senses": [
                    {
                        "sense_id": "248c7a9b-82c7-3ebe-aee5-33c34138b4e4",
                        "entry_id": "d6da3b10-a6a4-37db-8d33-7647923c3d06",
                        "glosses": [
                            "Redonner du couple (puissance de rotation du moteur)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "180e6890-afca-4dea-9706-08d85be98cea",
                                "sense_id": "248c7a9b-82c7-3ebe-aee5-33c34138b4e4",
                                "text": "Pourquoi dévisser et retorquer ? ;"
                            },
                            {
                                "example_id": "e999794f-400a-4b1c-8b60-24150f45750f",
                                "sense_id": "248c7a9b-82c7-3ebe-aee5-33c34138b4e4",
                                "text": "Pour les bolts de tête j’ai bien lu de pas les looser moi ! Seulement de les retorquer au torque d’origine, et ensuite d’en mettre plus. ;"
                            },
                            {
                                "example_id": "642b5a2d-e9c9-4df5-adb6-cdbfa014b04c",
                                "sense_id": "248c7a9b-82c7-3ebe-aee5-33c34138b4e4",
                                "text": "Je te conseille également de retorquer les quatre nuts qui retiennent la tête du moteur au cylindre à 80 livres/pouce (9 N/M ^([sic : N/m])) environ toutes les 10 à 15 heures, c’est très simple."
                            }
                        ]
                    }
