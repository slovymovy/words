                                        "glosses": [
                                            "Qui pratique des opérations de change."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3dda0bd-8590-4b3c-a283-a90b29a7520c",
                                                "sense_id": "56e1a4ce-a828-3b22-880f-8f0e645ca56a",
                                                "text": "Entre le XIIᵉ et la fin du XIIIᵉ siècle, la Champagne a en effet été grâce à ses foires la principale place commerciale, financière et cambiste de la planète."
                                            }
                                        ]
                                    }
                                ]
                            },
