                "senses": [
                    {
                        "sense_id": "599bc861-4077-3929-bc70-ac2a2bcb9de7",
                        "entry_id": "1c1815b1-1bc2-3c47-9ab1-9a1b5d1301cc",
                        "glosses": [
                            "jemand, der von einer Flut betroffen ist und dadurch zu Tode kommt oder Schäden erleidet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "13430b63-828e-4ad4-a25f-c42b84e4e316",
                                "sense_id": "599bc861-4077-3929-bc70-ac2a2bcb9de7",
                                "text": "„Der Hersteller Opel will nun Flutopfern, die ihren Wagen verloren haben, für bis zu drei Wochen kostenlos ein Fahrzeug zur Verfügung stellen.“"
                            },
                            {
                                "example_id": "c69fcd66-d876-44af-945e-29a72e413b45",
                                "sense_id": "599bc861-4077-3929-bc70-ac2a2bcb9de7",
                                "text": "„Fußballvereine und Prominente unterstützen die Flutopfer großzügig, die breite Bevölkerung gibt sich zurückhaltend.“"
                            },
                            {
                                "example_id": "c61cf1f9-fa01-491b-ad35-c18fa0485fb6",
                                "sense_id": "599bc861-4077-3929-bc70-ac2a2bcb9de7",
                                "text": "„In mehreren Orten an der Elbe und der Saale hielten Deiche den Wassermassen nicht mehr stand oder waren akut gefährdet. Tausende Flutopfer mussten sich in Sicherheit bringen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
