                        "glosses": [
                            "A mountain-climber, especially one that uses an alpenstock."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b51aa556-96b7-45d4-83cc-25eda22453ab",
                                "sense_id": "9a4e9785-89d8-3e4e-bd22-6822c5b11e39",
                                "text": "I started to give Lucky a digest of the Perugia affair, but we were interrupted by a group of German alpenstockers who clumped into the chamber under the guide of a female ramrod."
                            },
                            {
                                "example_id": "6628ac92-5571-470a-850c-2755c6fdfa61",
                                "sense_id": "9a4e9785-89d8-3e4e-bd22-6822c5b11e39",
                                "text": "Careful to step over the bergschrund and not fall down in and get extruded out the foot of the ice centuries hence, as an old glaciology prof used to tell it and cackle, true to some dear dead alpenstocker pipesmoker in the years before the lab took your best years."
                            },
                            {
                                "example_id": "f98ebfb8-ed84-4f09-8997-5b47fcc85276",
                                "sense_id": "9a4e9785-89d8-3e4e-bd22-6822c5b11e39",
                                "text": "We attempted to reach Professor LaFave upon receipt of this article, only to learn that LaFave, a confirmed alpenstocker, had earlier departed for Europe to undertake the grueling ascent of the forbidding south face of the Matterhorn."
                            }
                        ]
                    }
