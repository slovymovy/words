                "senses": [
                    {
                        "sense_id": "3baa5939-4164-31fb-a139-b92b7d840622",
                        "entry_id": "43e2bcb0-687d-3269-b5c9-61f16506e78e",
                        "glosses": [
                            "jemand, der Rinder von den Larven der Dasselfliege befreit"
                        ],
                        "tags": [
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "c8708a18-7646-4ed3-b23c-7374ed9d71da",
                                "sense_id": "3baa5939-4164-31fb-a139-b92b7d840622",
                                "text": "„Bei der Bekämpfung der Dasselfliege sind Rinder, bei denen trotz Durchführung der Herbstabdasselung im Frühjahr noch Dasselbeulen auftreten, durch den Abdassler nachdasseln zu lassen.“"
                            },
                            {
                                "example_id": "0628e4d3-feae-416d-9deb-9149798f77a3",
                                "sense_id": "3baa5939-4164-31fb-a139-b92b7d840622",
                                "text": "„Im gleichen Jahr wurden auf Veranlassung der oldenburgischen Landwirtschaftskammer Abdassler von Amtstierärzten im Abdasseln mit der Hand oder mit Häkelnadel und Pinzette ausgebildet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
