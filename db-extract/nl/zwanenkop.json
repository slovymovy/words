                        "examples": [
                            {
                                "example_id": "9a9d282a-8bdf-4364-8726-a550f3e494f6",
                                "sense_id": "d38c68a8-9b31-3d1b-8fde-611efa697f68",
                                "text": "De man liep na de onthoofding met de zwanenkop door de binnenstad van Arnhem en zwaaide ermee in het rond op de Korenmarkt. De dierenmishandeling trof niet alleen de zwaan zelf; het dier had een nest met eieren."
                            },
                            {
                                "example_id": "83d6b526-77c8-436b-88d6-479ecdf398b9",
                                "sense_id": "d38c68a8-9b31-3d1b-8fde-611efa697f68",
                                "text": "Een recensie van restaurant Fred moet bij het sanitair beginnen. Vooral het damestoilet. In de hoge ruimte zijn de muren van spiegels. Met daarop gezandstraalde sierlijke figuren. Links staat een tafel, schuin, met een wasbak en een zilverkleurige kraan in de vorm van een zwanenkop met vleugels."
                            }
                        ]
                    }
