                ],
                "senses": [
                    {
                        "sense_id": "d68bae1c-95ae-3884-a7bc-16e41cc4759a",
                        "entry_id": "5adcade0-d299-322e-9365-72a81cec2f82",
                        "glosses": [
                            "Donner un caractère de latérite à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b3f59d15-7d58-4eaf-9551-3b31f31fdbf0",
                                "sense_id": "d68bae1c-95ae-3884-a7bc-16e41cc4759a",
                                "text": "Pendant ce temps, on fera encore des prêts au nom de ce peuple pour latériser nos routes et nous faire mourrir par la pneumonie, la méningite et je ne sais quoi!"
                            },
                            {
                                "example_id": "2f7a6718-0109-423d-b31c-939c9fc3d869",
                                "sense_id": "d68bae1c-95ae-3884-a7bc-16e41cc4759a",
                                "text": "Ainsi on trouve des zones où le sol est très appauvri et a tendance à se latériser étant données les quantités relativement importantes de roches ferrugineuses en certains points."
                            },
                            {
                                "example_id": "45d2bb4a-a16c-4506-8bca-83e91d91693e",
                                "sense_id": "d68bae1c-95ae-3884-a7bc-16e41cc4759a",
                                "text": "Le sens intuitif du mot irréversibilité, c'est quand quelque chose se fait qui ne peut plus être défait ensuite, par exemple abattre une forêt ou laisser un sol se latériser."
                            }
                        ]
                    }
