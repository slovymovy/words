                                        "entry_id": "1dedac91-2150-3d38-b8b7-c4b740a32a0c",
                                        "glosses": [
                                            "entsetzlich, furchtbar"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dbf61f00-eeca-42b8-9cf2-b62b16bf754c",
                                                "sense_id": "b5eefc99-b6dd-3620-bcda-ba8e800a456f",
                                                "text": "Die Vorstellung war grauenvoll."
                                            }
                                        ],
