{
    "word_family": [
        "laureate"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5c7b4e23-3c3b-3849-a2cb-ef5564d27e8c",
                    "sense_definition": "An evergreen shrub with aromatic leaves and small yellowish-white flowers.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "plant",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The garden was filled with the scent of the <w>laurel</w> bushes.",
                            "target_lang_translations": {
                                "ru": "Сад был наполнен ароматом кустов <w>лавра</w>."
                            }
                        },
                        {
                            "text": "Ancient Greeks often used <w>laurel</w> branches to decorate their homes.",
                            "target_lang_translations": {
                                "ru": "Древние греки часто использовали ветви <w>лавра</w> для украшения своих домов."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вечнозеленый кустарник с ароматными листьями и мелкими желтовато-белыми цветами."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лавр",
                                "target_lang_sense_clarification": "растение семейства лавровых"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6f292837-abeb-39f0-9546-ca96637925b1",
                    "sense_definition": "Honor, distinction, or fame achieved through success.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "honor",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The athlete decided to retire while he could still rest on his <w>laurels</w>.",
                            "target_lang_translations": {
                                "ru": "Спортсмен решил уйти на покой, пока он еще мог <w>почивать на лаврах</w>."
                            }
                        },
                        {
                            "text": "She won many <w>laurels</w> for her contributions to medical research.",
                            "target_lang_translations": {
                                "ru": "Она завоевала множество <w>лавров</w> за свой вклад в медицинские исследования."
                            }
                        }
                    ],
                    "synonyms": [
                        "acclaim",
                        "glory",
                        "prestige"
                    ],
                    "common_phrases": [
                        "rest on one's laurels"
                    ],
                    "target_lang_definitions": {
                        "ru": "Честь, отличие или слава, достигнутые благодаря успеху."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лавры",
                                "target_lang_sense_clarification": "символ славы, почета или победы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ba341d1c-08f0-3a93-a23f-62a578ed6c20",
                    "sense_definition": "A crown made of laurel leaves, traditionally given as a symbol of victory.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "honor",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The winner of the race was presented with a golden <w>laurel</w>.",
                            "target_lang_translations": {
                                "ru": "Победителю гонки вручили золотой <w>лавровый венок</w>."
                            }
                        },
                        {
                            "text": "In ancient times, poets were often crowned with a <w>laurel</w>.",
                            "target_lang_translations": {
                                "ru": "В древности поэтов часто увенчивали <w>лавровым венком</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "wreath"
                    ],
                    "target_lang_definitions": {
                        "ru": "Венок из лавровых листьев, традиционно вручаемый как символ победы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лавровый венок",
                                "target_lang_sense_clarification": "награда или символ победы"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "08d400a6-68a8-3b2f-935c-6144fed3506e",
                    "sense_definition": "To award top honors or praise to someone.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "honor",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The critics <w>laurelled</w> the young director for her innovative film.",
                            "target_lang_translations": {
                                "ru": "Критики <w>увенчали лаврами</w> молодого режиссера за ее инновационный фильм."
                            }
                        },
                        {
                            "text": "He was <w>laurelled</w> by the academy for his lifetime of service.",
                            "target_lang_translations": {
                                "ru": "Он был <w>удостоен почестей</w> академией за свои заслуги на протяжении всей жизни."
                            }
                        }
                    ],
                    "synonyms": [
                        "honor",
                        "praise",
                        "acclaim"
                    ],
                    "target_lang_definitions": {
                        "ru": "Награждать высшими почестями или хвалить кого-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "увенчивать лаврами",
                                "target_lang_sense_clarification": "оказывать высокие почести"
                            },
                            {
                                "target_lang_word": "чествовать",
                                "target_lang_sense_clarification": "оказывать почет"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "c8227c86-1e01-3318-9947-103e7f74df6e",
                    "sense_definition": "A female or male given name derived from the laurel plant.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "<w>Laurel</w> decided to study botany at the university.",
                            "target_lang_translations": {
                                "ru": "<w>Лорел</w> решила изучать ботанику в университете."
                            }
                        },
                        {
                            "text": "I met a woman named <w>Laurel</w> at the conference yesterday.",
                            "target_lang_translations": {
                                "ru": "Вчера на конференции я встретил женщину по имени <w>Лорел</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Женское или мужское имя, происходящее от названия растения лавр."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Лорел",
                                "target_lang_sense_clarification": "имя собственное"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}