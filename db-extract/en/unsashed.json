        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "b13c03ec-3b3f-3df4-82fe-1f426e678621",
                "word": "unsashed",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "127ce7cf-3568-3113-8cab-42ed787feb65",
                        "entry_id": "b13c03ec-3b3f-3df4-82fe-1f426e678621",
                        "glosses": [
                            "Not fitted with a sash."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "f62dad72-3567-4916-81c2-52883fe96e86",
                                "sense_id": "127ce7cf-3568-3113-8cab-42ed787feb65",
                                "text": "A gleam of sun shining through the unsashed window, and chequering the dark workshop with a broad patch of light, fell full upon him, as though attracted by his sunny heart."
                            },
                            {
                                "example_id": "91b2bede-4ac8-4384-85c2-901b223a000e",
                                "sense_id": "127ce7cf-3568-3113-8cab-42ed787feb65",
                                "text": "The sun with accelerated pace abandoned the horizon, so that the darkness of night entering by the unsashed skylights of the ruins, mingled with the gloom shed by the dense foliage which served for curtains."
                            },
                            {
                                "example_id": "1dc8eff8-f6f4-47e5-8c1b-675b538638c7",
                                "sense_id": "127ce7cf-3568-3113-8cab-42ed787feb65",
                                "text": "One storied in height — barred at the windows — unsashed — and with roofs covered by coarse tiles — they make no favorable first impression."
                            }
                        ]
                    },
                    {
                        "sense_id": "ec102107-6003-3ba9-9eb2-ebfb4eaee8cb",
                        "entry_id": "b13c03ec-3b3f-3df4-82fe-1f426e678621",
                        "glosses": [
                            "Not fastened with a sash."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "3b86f1ef-4330-44b4-89dd-0c15eb2f6b1d",
                                "sense_id": "ec102107-6003-3ba9-9eb2-ebfb4eaee8cb",
                                "text": "Before I can shout a warning the garment comes unsashed, instead of womanflesh, an automatic rifle flashes in an arc, and firing from the hip, the man runs for his life."
                            },
                            {
                                "example_id": "8cfe063d-c91a-4b45-b32f-67a4732b35a8",
                                "sense_id": "ec102107-6003-3ba9-9eb2-ebfb4eaee8cb",
                                "text": "I, for one, had to dance through the hedges and out into the road, tour jete, chasse, my terry-cloth robe unsashed and flapping in what the police report described as a moment of weakness cloaked in exceptional grace."
                            },
                            {
                                "example_id": "9e03a43f-baab-48a0-8bdc-96679a191aa9",
                                "sense_id": "ec102107-6003-3ba9-9eb2-ebfb4eaee8cb",
                                "text": "A man seated near the middle of the table rose to his feet and inclined his upper body, extending his hands to either side. He was tall, slender except for the stomach that tugged at his light-colored shirt that he wore loose and unsashed over."
                            }
                        ]
                    }
