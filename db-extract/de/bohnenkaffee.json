                ],
                "senses": [
                    {
                        "sense_id": "9fa2aec3-5e39-352d-af04-3b1caaa1a01c",
                        "entry_id": "4259d98f-6fe7-3832-a2c5-5154d39fbf58",
                        "glosses": [
                            "Kaffeebohnen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94efff6f-1657-4fb8-9584-1c2a52e865bd",
                                "sense_id": "9fa2aec3-5e39-352d-af04-3b1caaa1a01c",
                                "text": "„Auf dem Boden standen vier Säcke. Es roch nach Bohnenkaffee.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "933db57d-9725-30fb-b2d4-36a42b06b69b",
                        "entry_id": "4259d98f-6fe7-3832-a2c5-5154d39fbf58",
                        "glosses": [
                            "Getränk, aus Kaffeebohnen hergestellt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e9ffa91-b073-4f69-b6e7-e89b746bfc50",
                                "sense_id": "933db57d-9725-30fb-b2d4-36a42b06b69b",
                                "text": "„Alles duckt sich, und dann traben zwei Mann mit je einer großen Kanne erstklassigem Bohnenkaffee ab und erreichen vor dem folgenden Einschlag den Unterstand.“"
                            },
                            {
                                "example_id": "28a5a696-c45c-4c74-8766-a8581af88a17",
                                "sense_id": "933db57d-9725-30fb-b2d4-36a42b06b69b",
                                "text": "„Hackendahl schnuppert, natürlich ist es der für den Alltag verbotene Bohnenkaffee, statt des angeordneten Malzkaffees!“"
                            },
                            {
                                "example_id": "cc355fa1-8c03-4de5-9a98-94b3ed051b5a",
                                "sense_id": "933db57d-9725-30fb-b2d4-36a42b06b69b",
                                "text": "„Wir opfern dieser Gelegenheit unseren beinahe letzten Bohnenkaffee, den der Gast mit Wodka anreichert; das Gespräch dauert bis weit in den Abend hinein.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
