                        "examples": [
                            {
                                "example_id": "d09fc81e-a398-4e1f-8f84-a9856b0c71fd",
                                "sense_id": "a22b3d5d-9aad-3f1a-a4f3-7c0b22a6045c",
                                "text": "Het varken staat bekend als een langzame groeier. Een volwassen weegt volgens het vakblad Levende Have 350 kilo, een beer 400 kilo. „En het vlees is bijzonder lekker”, weet Amund Pierik uit ervaring."
                            },
                            {
                                "example_id": "fa9468a1-b01c-4c3f-9957-a7b25ea15436",
                                "sense_id": "a22b3d5d-9aad-3f1a-a4f3-7c0b22a6045c",
                                "text": "Uitzendorganisatie In Person heeft de omzet vorig jaar met 62 procent zien stijgen tot 101 miljoen euro. Bij de middelgrote bureaus is de Twentse uitzendorganisatie daarmee de snelste groeier van Nederland."
                            },
                            {
                                "example_id": "e37b6569-a791-4f91-ab48-eb6aed2d662a",
                                "sense_id": "a22b3d5d-9aad-3f1a-a4f3-7c0b22a6045c",
                                "text": "De gemeente Diemen was de grootste groeier. Daar bedroeg de toename van het aantal nieuwbouw bijna 5 procent: in totaal werden er 638 nieuwbouwwoningen opgeleverd. Amsterdam spant, traditiegetrouw de kroon. Daar werden vorig jaar 7.263 nieuwbouwhuizen opgeleverd."
                            }
                        ]
                    }
