                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e69d7d13-4fa6-411e-981a-515c772b2d74",
                                "sense_id": "355327b7-61a5-3f89-9f93-70197b3d8e17",
                                "text": "Bentley is a heartful bee. His heart is filled with love."
                            },
                            {
                                "example_id": "6fa6941f-ef9c-44d7-90b8-2a5c190b61e1",
                                "sense_id": "355327b7-61a5-3f89-9f93-70197b3d8e17",
                                "text": "They ſhall mourne foꝛ the with hertfull ſoꝛow, […]"
                            },
                            {
                                "example_id": "03b326a8-2eb8-4f19-ba27-43c6427c3f88",
                                "sense_id": "355327b7-61a5-3f89-9f93-70197b3d8e17",
                                "text": "[…] a heartful approach, we open ourselves to the transformative power of love, compassion, and genuine connection. In a heartful way, we begin our meditation practice by creating a serene and sacred space, free from distractions."
                            }
                        ]
                    }
