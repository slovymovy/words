                        "target_lang_word": "antiquity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "antiquity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "796e04b4-2103-3fbb-8aaa-25c09cbdd43c",
                                        "entry_id": "b68bc13c-58ec-3820-a1e5-cb3c874c1915",
                                        "glosses": [
                                            "Ancient times; faraway history; former ages."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f19acc04-402c-4f7a-a08c-a1c0d3abc53f",
                                                "sense_id": "796e04b4-2103-3fbb-8aaa-25c09cbdd43c",
                                                "text": "Cicero was an eloquent orator of antiquity."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e71fb551-f4c6-332b-81d1-4bdd50014303",
                                        "entry_id": "b68bc13c-58ec-3820-a1e5-cb3c874c1915",
                                        "glosses": [
                                            "The people of ancient times."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3fec299b-4fd6-4147-a4d2-65eef4deb382",
                                                "sense_id": "e71fb551-f4c6-332b-81d1-4bdd50014303",
                                                "text": "That such pillars were raised by Seth all antiquity has avowed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c74476fe-f688-3b21-ad8a-2f6b98928b52",
                                        "entry_id": "b68bc13c-58ec-3820-a1e5-cb3c874c1915",
                                        "glosses": [
                                            "An old gentleman."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b8c507c-44c7-4680-9ed8-9d9bcc8ae5f4",
                                                "sense_id": "c74476fe-f688-3b21-ad8a-2f6b98928b52",
                                                "text": "You are a shrewd antiquity, neighbor Clench."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "86191a9a-c976-314d-8111-455a2c0ac4ae",
                                        "entry_id": "b68bc13c-58ec-3820-a1e5-cb3c874c1915",
                                        "glosses": [
                                            "The historical period preceding the Middle Ages (c. 500-1500), primarily relating to European history."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f3896cd0-4d07-3e58-a204-8c25c5c06576",
                                        "entry_id": "b68bc13c-58ec-3820-a1e5-cb3c874c1915",
                                        "glosses": [
                                            "A relic or monument of ancient times, such as a coin, a statue, etc.; an ancient institution."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "04a2102b-de00-3096-9e30-839e652922bc",
                                        "entry_id": "b68bc13c-58ec-3820-a1e5-cb3c874c1915",
                                        "glosses": [
                                            "The state of being ancient or of ancient lineage."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7ed00668-8d7f-49e3-8167-91a23ae5cfec",
                                                "sense_id": "04a2102b-de00-3096-9e30-839e652922bc",
                                                "text": "He was thinking; but the glory of the song, the swell from the great organ, the clustered lights, […], the height and vastness of this noble fane, its antiquity and its strength—all these things seemed to have their part as causes of the thrilling emotion that accompanied his thoughts."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1e7cf238-5998-4c63-8d4e-6811e3acc3f3",
                        "source_entry_id": "fe162b84-25c4-3856-81b1-1413b4012aac",
                        "source_sense_id": "03b933c8-dff2-3ebe-a028-181adcfe71e9",
                        "source_sense_description": "een oud kunst-, sier- of gebruiksvoorwerp, voorwerp uit de oude tijd",
                        "target_lang_word": "antiquité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "antiquité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "01f7db75-e316-342a-98ff-dbaa5c32ed59",
                                        "entry_id": "e96dac8b-dafd-3e60-81cd-f9d921277470",
                                        "glosses": [
                                            "État de ce qui est antique ; ancienneté."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "51394531-2e4e-4697-a4f7-c9fdbef929d6",
                                                "sense_id": "01f7db75-e316-342a-98ff-dbaa5c32ed59",
                                                "text": "Une dame considérable étant entrée, madame de Serpierre dit à Lucien qu’elle allait le présenter, et, sans attendre sa réponse, elle se mit à lui expliquer l’antiquité de la maison de Furonière, à laquelle appartenait cette dame, qui entendait très bien tout ce qu’on disait d’elle."
                                            },
                                            {
                                                "example_id": "2966107e-8a04-414d-b0da-7c09107f3aeb",
                                                "sense_id": "01f7db75-e316-342a-98ff-dbaa5c32ed59",
                                                "text": "Je n’ai rien nié, j’ai expliqué. Je n’ai pas eu besoin de récuser les évangiles ni la tradition chrétienne, de supposer des interpolations, des anachronismes, des mensonges dans cette haute et respectable antiquité du christianisme. J’ai tout accepté, et j’ai seulement expliqué."
                                            },
                                            {
                                                "example_id": "c03dba56-6e96-4433-afde-b2b763d44c03",
                                                "sense_id": "01f7db75-e316-342a-98ff-dbaa5c32ed59",
                                                "text": "Azemmour est une ville très ancienne. […]. Malgré son antiquité et les vicissitudes de son histoire, elle n’a rien de bien intéressant à offrir au visiteur, si ce n’est l’aspect d’une vieille ville maure dépérissante : […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aefcb636-325f-3b99-9efd-b509f1d37239",
                                        "entry_id": "e96dac8b-dafd-3e60-81cd-f9d921277470",
                                        "glosses": [
                                            "Ancienneté reculée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "29f43f4d-1895-4eef-b1b9-d16db36a4378",
                                                "sense_id": "aefcb636-325f-3b99-9efd-b509f1d37239",
                                                "text": "Les murs extérieurs ont été probablement ajoutés par les Normands, mais le donjon intérieur présente les indices d’une très grande antiquité."
                                            },
                                            {
                                                "example_id": "a890e473-5cd0-4205-bbce-f62ead02472b",
                                                "sense_id": "aefcb636-325f-3b99-9efd-b509f1d37239",
                                                "text": "L'oxydation relativement rapide du fer n'a pas permis de retrouver aisément, parmi les restes des travaux métalliques que l’antiquité a laissés derrière elle, un grand nombre d'objets fabriqués avec ce métal ; […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9e961403-20d8-3242-bade-ef2c225ab55a",
                                        "entry_id": "e96dac8b-dafd-3e60-81cd-f9d921277470",
                                        "glosses": [
                                            "Monument, chose qui nous reste de l’Antiquité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "504d8879-21d2-4fbe-a036-46af1f34b21a",
                                                "sense_id": "9e961403-20d8-3242-bade-ef2c225ab55a",
                                                "text": "On voit près de cette ville une belle antiquité."
                                            },
                                            {
                                                "example_id": "0aee03a5-7bb3-41e1-98fd-2600f2b96529",
                                                "sense_id": "9e961403-20d8-3242-bade-ef2c225ab55a",
                                                "text": "Les antiquités de Rome."
                                            },
                                            {
                                                "example_id": "9459d1f4-983c-4c9e-a1c1-1f6384cfb5a2",
                                                "sense_id": "9e961403-20d8-3242-bade-ef2c225ab55a",
                                                "text": "L’histoire des antiquités de Paris, de Nîmes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3bf89512-e319-3547-b72b-b3531f358dea",
                                        "entry_id": "e96dac8b-dafd-3e60-81cd-f9d921277470",
                                        "glosses": [
                                            "Objets plus ou moins anciens."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7cd0b08c-ab50-403b-8491-0c14af655258",
                                                "sense_id": "3bf89512-e319-3547-b72b-b3531f358dea",
                                                "text": "Magasin d’antiquités. — Marchand d’antiquités."
                                            },
                                            {
                                                "example_id": "fc1b7f8b-1f3c-4211-92a6-1bf17df925e6",
                                                "sense_id": "3bf89512-e319-3547-b72b-b3531f358dea",
                                                "text": "L’imagination ne manquait pas à Julia. Elle ouvrit bientôt à l’autre bout de la ville un magasin d’antiquités, le premier sans doute qu'il y eût eu jamais dans le département, achetant tout ce qu’on lui offrait de rencontre sur son chemin ou dans les encans."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6f3de5ba-d976-354e-8148-65abb5a5a072",
                                        "entry_id": "e96dac8b-dafd-3e60-81cd-f9d921277470",
                                        "glosses": [
                                            "Vieillerie."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9c8dbe44-2571-4e1a-9bb8-58c31292fb17",
                                                "sense_id": "6f3de5ba-d976-354e-8148-65abb5a5a072",
                                                "text": "— Mon pauvre Gaston, tu ne vas pas te faire du souci pour une charrette, mais qui veux-tu qui aille s’embarrasser de cette antiquité…"
                                            },
                                            {
                                                "example_id": "d727260e-fa29-40de-b027-ad24a7b0fa8a",
                                                "sense_id": "6f3de5ba-d976-354e-8148-65abb5a5a072",
                                                "text": "Son chopper est une antiquité. Un tas de boue avec un guidon très haut de type Harley Davidson."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
