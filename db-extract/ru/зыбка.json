                "senses": [
                    {
                        "sense_id": "688f8f3e-9632-39e7-bff7-b37795c7478e",
                        "entry_id": "9d80d6f3-be30-3d77-9743-d635d9e3a35d",
                        "glosses": [
                            "рег. подвесная колыбель, люлька; кроватка, подвешиваемая к потолку для качания грудных малышей"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8431d0df-6e81-48c3-9753-fc1fe056e430",
                                "sense_id": "688f8f3e-9632-39e7-bff7-b37795c7478e",
                                "text": "Качать в зыбке"
                            },
                            {
                                "example_id": "10d89a76-6e57-4ad7-93e5-a845373e4f2c",
                                "sense_id": "688f8f3e-9632-39e7-bff7-b37795c7478e",
                                "text": "Ребятишки, те вертятся около становища, грудных караулят, зыбки качают."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f0f9d587-f1b8-4b17-ad07-dff4fabc4738",
                        "source_entry_id": "9d80d6f3-be30-3d77-9743-d635d9e3a35d",
                        "source_sense_id": "688f8f3e-9632-39e7-bff7-b37795c7478e",
                        "target_lang_word": "cradle",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cradle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1c00bbfe-81f0-3efd-ae89-d3e2a940cd73",
                                        "entry_id": "2d21a751-7f76-3f06-bed3-813f843ac259",
                                        "glosses": [
                                            "A bed or cot for a baby, oscillating on rockers or swinging on pivots."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "57ba1c45-fe78-496c-bf3e-6c229bba5bc4",
                                                "sense_id": "1c00bbfe-81f0-3efd-ae89-d3e2a940cd73",
                                                "text": "No sooner was I crept out of my cradle / But I was made a king, at nine months old."
                                            },
                                            {
                                                "example_id": "023d5d1a-8ce8-4779-9301-4ce612854f82",
                                                "sense_id": "1c00bbfe-81f0-3efd-ae89-d3e2a940cd73",
                                                "text": "the cradle that received thee at thy birth"
                                            },
                                            {
                                                "example_id": "6cb15a8a-9270-4265-89d0-119fd29be68a",
                                                "sense_id": "1c00bbfe-81f0-3efd-ae89-d3e2a940cd73",
                                                "text": "Hush-a-by, baby, upon the tree-top; / When the wind blows the cradle will rock; / When the bough breaks the cradle will fall; / Down will come cradle and baby and all."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9cd0b72b-4460-3f3f-b9eb-a49cf8c84484",
                                        "entry_id": "2d21a751-7f76-3f06-bed3-813f843ac259",
                                        "glosses": [
                                            "The place of origin, or in which anything is nurtured or protected in the earlier period of existence."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba3298c7-edef-4fc5-9234-3fc2e73a8860",
                                                "sense_id": "9cd0b72b-4460-3f3f-b9eb-a49cf8c84484",
                                                "text": "a cradle of crime"
                                            },
                                            {
                                                "example_id": "62864615-6cbc-4104-a3c7-63539091f6d6",
                                                "sense_id": "9cd0b72b-4460-3f3f-b9eb-a49cf8c84484",
                                                "text": "the cradle of liberty"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "abed1b96-fc0a-3f84-904a-4f595f18537a",
                                        "entry_id": "2d21a751-7f76-3f06-bed3-813f843ac259",
                                        "glosses": [
                                            "Infancy, or very early life."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "33a039ca-0294-4c83-9782-e84d27a5e0e4",
                                                "sense_id": "abed1b96-fc0a-3f84-904a-4f595f18537a",
                                                "text": "from the cradle to the grave"
                                            },
                                            {
                                                "example_id": "0a64f56d-531f-4065-87bb-a4e24b2780f2",
                                                "sense_id": "abed1b96-fc0a-3f84-904a-4f595f18537a",
                                                "text": "from their cradles bred together"
                                            },
                                            {
                                                "example_id": "002c41e4-40cf-448f-8d3f-dc9e7e0b1b32",
                                                "sense_id": "abed1b96-fc0a-3f84-904a-4f595f18537a",
                                                "text": "a form of worship in which they had been educated from their cradle"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b3a9b403-79b7-3361-b2bd-080f5761c0bd",
                                        "entry_id": "2d21a751-7f76-3f06-bed3-813f843ac259",
                                        "glosses": [
                                            "An implement consisting of a broad scythe for cutting grain, with a set of long fingers parallel to the scythe, designed to receive the grain, and to lay it evenly in a swath."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4555a3b0-0610-392b-a2cb-1ea18a742237",
                                        "entry_id": "2d21a751-7f76-3f06-bed3-813f843ac259",
                                        "glosses": [
                                            "A tool used in mezzotint engraving, which, by a rocking motion, raises burrs on the surface of the plate, so as to prepare the ground."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1c9d9b1d-4a9e-36f4-8113-04a6ae9b121c",
                                        "entry_id": "2d21a751-7f76-3f06-bed3-813f843ac259",
                                        "glosses": [
                                            "A framework of timbers, or iron bars, moving upon ways or rollers, used to support, lift, or carry ships or other vessels, heavy guns, etc., as up an inclined plane, or across a strip of land, or in launching a ship."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ee8986cc-acf5-3649-8b64-dd2a783855c2",
                                        "entry_id": "2d21a751-7f76-3f06-bed3-813f843ac259",
                                        "glosses": [
                                            "A case for a broken or dislocated limb."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "41a388d0-7152-31b3-ad4b-d808739ae3d0",
                                        "entry_id": "2d21a751-7f76-3f06-bed3-813f843ac259",
                                        "glosses": [
                                            "A frame to keep the bedclothes from contact with the sensitive parts of an injured person."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "45c6a4c2-48c6-3599-9719-6ff2a014993b",
                                        "entry_id": "2d21a751-7f76-3f06-bed3-813f843ac259",
                                        "glosses": [
                                            "A machine on rockers, used in washing out auriferous earth."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c475b56-bbca-4e4b-b92d-f277e4d5c497",
                                                "sense_id": "45c6a4c2-48c6-3599-9719-6ff2a014993b",
                                                "text": "Rough men brought pickle bottles full of nuggets. Mysterious dirty-looking calico bags were opened, disclosing small quantities of water-worn flaky gold, which had been washed out of the beds of rivers with a cradle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "697e4dd8-a857-361d-93be-648b9c350a79",
                                        "entry_id": "2d21a751-7f76-3f06-bed3-813f843ac259",
                                        "glosses": [
                                            "A suspended scaffold used in shafts."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4b59f713-598b-3495-a37e-2ca06ef2a86e",
                                        "entry_id": "2d21a751-7f76-3f06-bed3-813f843ac259",
                                        "glosses": [
                                            "A ribbing for vaulted ceilings and arches intended to be covered with plaster."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4533bb7-34dc-43ed-9c0e-4a0e1b8e8493",
                                                "sense_id": "4b59f713-598b-3495-a37e-2ca06ef2a86e",
                                                "text": "A strong iron bar is fixed at the top of each cradle, to which the suspending chains are attached; the latter pass over the sheaves, and the cradles are kept in a horizontal position, by means of an adjusting rod placed above them"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e53baba3-efac-3119-9d1a-1422a65fede4",
