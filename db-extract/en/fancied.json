    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "e3984349-a692-32b9-9f88-a29e58468977",
                "word": "fancied",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "53d735e5-d615-357b-a469-f51e9e80fe76",
                        "entry_id": "e3984349-a692-32b9-9f88-a29e58468977",
                        "glosses": [
                            "Existing only in the fancy (“imagination”); imaginary, imagined."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "52b02cad-ba3a-4467-981a-db04f0e0b0b1",
                                "sense_id": "53d735e5-d615-357b-a469-f51e9e80fe76",
                                "text": "Near-synonyms: conceptual, fanciful, ideal, notional"
                            },
                            {
                                "example_id": "5c890593-1a48-4b6b-857a-660ea44186bf",
                                "sense_id": "53d735e5-d615-357b-a469-f51e9e80fe76",
                                "text": "The plant was named for its fancied resemblance to a Roman spear."
                            },
                            {
                                "example_id": "97473fd1-03d2-42cf-8d36-cbaf0da44fce",
                                "sense_id": "53d735e5-d615-357b-a469-f51e9e80fe76",
                                "text": "VVhy therefore may not the Angels that appeared to Lot, […] be underſtood of images of men, ſupernaturally formed in the Fancy; as vvell as before by Angel vvas underſtood a fancyed Voice?"
                            },
                            {
                                "example_id": "52890797-9918-42b8-bd30-620438502d5c",
                                "sense_id": "53d735e5-d615-357b-a469-f51e9e80fe76",
                                "text": "That being depriv'd of all the fancy'd Felicity vvhich he enjoy'd, in the full Exerciſe of all thoſe Vices, he ſaid, he vvas at leiſure to look upon the dark Side of them, vvhere he found all manner of Deformity, and vvas novv convinc'd, that Virtue only makes a Man truly vviſe, rich and great, and preſerves him in the VVay to a ſuperior Happineſs in a future State."
                            },
                            {
                                "example_id": "49b11edc-9f1e-4fa3-9a7a-1d3ec7634756",
                                "sense_id": "53d735e5-d615-357b-a469-f51e9e80fe76",
                                "text": "Oh! if thou hover'ſt round my walk, / While, under ev'ry well-known tree, / I to thy fancy'd ſhadow talk, / And every tear is full of thee."
                            },
                            {
                                "example_id": "3ea7e481-33d6-459b-a2ce-b8fc793f5fbd",
                                "sense_id": "53d735e5-d615-357b-a469-f51e9e80fe76",
                                "text": "[S]till by the maid / Love went submiss, with eye more dangerous / Than fancied basilisk to wound whoe'er / Too bold approached, […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "c7788102-6bc0-34ea-bb57-0febc19f27d0",
                        "entry_id": "e3984349-a692-32b9-9f88-a29e58468977",
                        "glosses": [
                            "Organized, or (especially of attire) designed, to suit one's fancy or whim."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "1b435f24-01f9-42a7-98d0-3596451f0846",
                                "sense_id": "c7788102-6bc0-34ea-bb57-0febc19f27d0",
                                "text": "Man does vvith dangerous Curioſity / Theſe unfathom'd VVonders try: / VVith fancy'd Rules and Arbitrary Lavvs / Matter and Motion he reſtrains, / And ſtudy'd Lines and fictious Circles dravvs; […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "76541832-b547-3866-9128-37a0a344a465",
                        "entry_id": "e3984349-a692-32b9-9f88-a29e58468977",
                        "glosses": [
                            "Having a fancy (“inclination, liking, or love”) for; desired, favourite."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "5abc1ce5-06f8-4d7e-ace1-597de1d2f66c",
                                "sense_id": "76541832-b547-3866-9128-37a0a344a465",
                                "text": "Now St. Paul, \"not willing to make\" these ministers \"a public example,\" concealeth their persons, yet discovereth the fault; and, making bold with his brethren, Apollos and Cephas, applieth to them and himself what the Corinthians spake of their fancied preachers. \"Now this I say, that every one of you saith, I am of Paul; and I am of Apollos; and I am of Cephas; and I am of Christ.\""
                            },
                            {
                                "example_id": "60e67c05-7552-4203-af91-7e1ea096bcb0",
                                "sense_id": "76541832-b547-3866-9128-37a0a344a465",
                                "text": "I did not call him fool, and vex my friend, / But quietly allowed experiment, / Encouraged him to dust his drink, and now / Grate lignum vitæ now bruise so-called grains / Of Paradise, and now, for perfume, pour / Distilment rare, the rose of Jericho, / Holy-thorn, passion-flower, and what know I? / Till beverage obtained the fancied smack."
                            },
                            {
                                "example_id": "9d20ffce-30dc-4eb9-ad84-fbcd74e29a27",
                                "sense_id": "76541832-b547-3866-9128-37a0a344a465",
                                "text": "The visitors were worthy winners, taking the game to the highly fancied hosts from the first minute."
                            }
                        ]
                    },
                    {
                        "sense_id": "9bb1f0b2-1c5b-38b6-bfeb-11186ee27ca5",
                        "entry_id": "e3984349-a692-32b9-9f88-a29e58468977",
                        "glosses": [
                            "Designed in an artistic manner."
                        ],
                        "tags": [
                            "not-comparable",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "6a334af6-aa0c-4d74-bc0d-738560ae8e48",
                                "sense_id": "9bb1f0b2-1c5b-38b6-bfeb-11186ee27ca5",
                                "text": "[T]hey have taken thoſe beautiful buckles out of her ſhoes! […] I vvonder vvho'll buy them. I aſſure you they vvere the prettieſt fancied I ever ſavv."
                            },
                            {
                                "example_id": "0c11dbab-5524-462d-a1c7-825bf0a3e660",
                                "sense_id": "9bb1f0b2-1c5b-38b6-bfeb-11186ee27ca5",
                                "text": "His seals are curiously fancied, and exquisitely well cut, and of great use to encourage young gentlemen to write a good hand."
                            }
                        ]
                    }
                ],
