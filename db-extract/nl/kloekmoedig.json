                "senses": [
                    {
                        "sense_id": "c2a01e3c-b72a-3748-aadf-056aa79b05c7",
                        "entry_id": "30ca6bd3-875c-39fe-8ac1-8d7295fbcb98",
                        "glosses": [
                            "flink en moedig handelen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ff6ef26-2314-4bde-9cac-f4b8016649cf",
                                "sense_id": "c2a01e3c-b72a-3748-aadf-056aa79b05c7",
                                "text": "Daarom geeft de apostel deze troost, dat wij het onderpand des Geestes hebben (2 Kor. 5:5), waardoor wij vast en zeker mogen gaan en altijd kloekmoedig kunnen zijn, wetend dat ons het hemels erfgoed niet ontgaan kan."
                            },
                            {
                                "example_id": "2d5b692d-4f6d-44f4-be80-b9b55a668976",
                                "sense_id": "c2a01e3c-b72a-3748-aadf-056aa79b05c7",
                                "text": "Kloekmoedig was het hart, dat zingen kon, met de dood voor ogen."
                            }
                        ]
                    }
                ],
