                                        "tags": [
                                            "umgangssprachlich,",
                                            "meist negativ"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "002e0d51-162c-4911-87d3-61f5aac3db09",
                                                "sense_id": "e11c6a43-eab6-3784-81ee-4dc3f58efd4c",
                                                "text": "Von deinem Spontanbesuch bin ich aber ehrlich gesagt nicht sehr erbaut!"
                                            },
                                            {
                                                "example_id": "287174ab-e4ab-4067-ab61-fe14a88fd14c",
                                                "sense_id": "e11c6a43-eab6-3784-81ee-4dc3f58efd4c",
                                                "text": "„Sie waren über diese neue Regelung nicht sonderlich erbaut.“"
                                            },
                                            {
                                                "example_id": "4117a5da-f4d1-4d68-9ce2-e5e776d06a14",
                                                "sense_id": "e11c6a43-eab6-3784-81ee-4dc3f58efd4c",
                                                "text": "„Die Eltern sind von den Zensuren ihres Kindes nicht gerade erbaut.“"
                                            }
                                        ],
