                                "target_senses": [
                                    {
                                        "sense_id": "e9ce202d-4d1d-35fe-805b-c81a71c8560f",
                                        "entry_id": "cddc3959-e5e9-3246-8fbd-977bf752729f",
                                        "glosses": [
