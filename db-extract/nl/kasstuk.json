                    {
                        "sense_id": "ce1ecf77-1ead-3505-aee0-24346f8dfb2d",
                        "entry_id": "df089703-ca73-37e6-a756-aa7f3537495a",
                        "glosses": [
                            "film of uitvoering die alle verwachtingen overtreft wat betreft de opkomst van publiek"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "454096f9-acfa-4c38-b292-db570dafd062",
                                "sense_id": "ce1ecf77-1ead-3505-aee0-24346f8dfb2d",
                                "text": "Financieel kan het toernooi voor ons niet meer stuk met de volle bak van zondag en de 18.000 toeschouwers, die er tot dit ogenblik al zijn gekomen. Nederland blijkt met zijn fascinerende spel een kasstuk."
                            },
                            {
                                "example_id": "3f1332be-af99-4015-a171-c96555a969d4",
                                "sense_id": "ce1ecf77-1ead-3505-aee0-24346f8dfb2d",
                                "text": "Voor het misselijke ‘Schlager’ hebben we het goede woord kasstuk; we zouden desnoods ook successtuk kunnen zeggen."
                            }
                        ]
                    },
                    {
                        "sense_id": "b7f0be12-9a9a-375b-8970-9c276e9f4834",
                        "entry_id": "df089703-ca73-37e6-a756-aa7f3537495a",
                        "glosses": [
                            "document dat aantoont hoe een bepaald bedrag is ontvangen of uitgegeven"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3aec4872-5f77-4eb9-87a1-059cde0fa945",
                                "sense_id": "b7f0be12-9a9a-375b-8970-9c276e9f4834",
                                "text": "Als door baliepersoneel gevraagd werd geld uit de kas op te nemen of als geld door baliepersoneel werd gestort, werd daarvoor een formulier opgemaakt. Dat formulier of kasstuk werd bij de boekhoudstukken gelegd, in de ordner die betrekking had op de kas."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "04f67e6b-5b32-4447-9643-9f3f6399edac",
                        "source_entry_id": "df089703-ca73-37e6-a756-aa7f3537495a",
                        "source_sense_id": "ce1ecf77-1ead-3505-aee0-24346f8dfb2d",
