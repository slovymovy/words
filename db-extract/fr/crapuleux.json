                    },
                    {
                        "form_id": "691663a2-97af-4ceb-979a-63c85e152925",
                        "entry_id": "cc30117d-1324-301b-8f62-49eb38a9d72d",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "crapuleuses"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "826d0bb1-6329-36c6-af6a-f476f7b08dd1",
                        "entry_id": "cc30117d-1324-301b-8f62-49eb38a9d72d",
                        "glosses": [
                            "Porté sur la boisson, ivrogne."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "fbbc494e-a203-4eb6-ae2d-2905c0528414",
                                "sense_id": "826d0bb1-6329-36c6-af6a-f476f7b08dd1",
                                "text": "Je n’ai jamais été dissolu ni crapuleux, et ne me suis enivré de ma vie."
                            }
                        ]
                    },
                    {
                        "sense_id": "1e4d1bbf-7894-39ae-a3bf-33394dc30c7e",
                        "entry_id": "cc30117d-1324-301b-8f62-49eb38a9d72d",
                        "glosses": [
                            "Qui se plaît dans la crapule."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "06ee72c5-2983-4b82-a786-eee3bb3a468e",
                                "sense_id": "1e4d1bbf-7894-39ae-a3bf-33394dc30c7e",
                                "text": "Individus crapuleux."
                            },
                            {
                                "example_id": "042216e8-26c6-4524-be92-a3bf5c28f781",
                                "sense_id": "1e4d1bbf-7894-39ae-a3bf-33394dc30c7e",
                                "text": "Gens crapuleux."
                            },
                            {
                                "example_id": "199bd1de-806a-4700-bd06-774ccff3b2ba",
                                "sense_id": "1e4d1bbf-7894-39ae-a3bf-33394dc30c7e",
                                "text": "Sieste crapuleuse, lorsqu'on se couche pour faire l'amour et dormir."
                            }
                        ]
                    },
                    {
                        "sense_id": "3e33f231-d28a-321f-8d3e-b285e8720d1a",
                        "entry_id": "cc30117d-1324-301b-8f62-49eb38a9d72d",
                        "glosses": [
                            "Qui a rapport à la crapule."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "24a90d77-86d1-4216-b5b6-91b1c0ae1aa4",
                                "sense_id": "3e33f231-d28a-321f-8d3e-b285e8720d1a",
                                "text": "Or cette fameuse bagarre ne se produisit pas. Une sorte de crapuleux délire empêchait toute discorde."
                            },
                            {
                                "example_id": "510b031a-d80a-4b72-a7f7-41077dd5a32e",
                                "sense_id": "3e33f231-d28a-321f-8d3e-b285e8720d1a",
                                "text": "Et elle me bombarde, d’une voix mauvaise, avec un accent crapuleux, d’une bordée d’injures grasses."
                            }
                        ]
                    },
                    {
                        "sense_id": "b8181094-faf3-3b9e-ad6d-88f0e99293fd",
                        "entry_id": "cc30117d-1324-301b-8f62-49eb38a9d72d",
                        "glosses": [
                            "Qualifie ce qui a trait aux ébats sexuels."
                        ],
                        "tags": [
                            "hyperbole"
                        ],
                        "examples": [
                            {
                                "example_id": "91d8e762-d738-4874-9860-8a71c7d0bf38",
                                "sense_id": "b8181094-faf3-3b9e-ad6d-88f0e99293fd",
                                "text": "[…] celle en combinaison de dentelle et bas de soie noire avec laquelle, étant vierge, je me trouvai couché, une nuit de bombe crapuleuse, mais que je ne pus pas toucher parce que je me mis à dégurgiter sur les draps une nappe de vin rouge."
                            },
                            {
                                "example_id": "b9d9928a-7a82-4819-805f-25cd739ee21f",
                                "sense_id": "b8181094-faf3-3b9e-ad6d-88f0e99293fd",
                                "text": "Il dînait avec elle puis ils montaient tous les deux au grenier pour ne pas se faire voir de la mère Billant. Ils y passaient un p’tit moment crapuleux et, après le café-du-pauvre, Petitcorps se rentrait en son petit logis."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b9e9b19f-9677-42fc-ae9a-753a7e94685f",
                        "source_entry_id": "cc30117d-1324-301b-8f62-49eb38a9d72d",
                        "target_lang_word": "crapulous",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "crapulous",
