                "senses": [
                    {
                        "sense_id": "7946c364-06f1-3a96-b49a-4ab2aa039df2",
                        "entry_id": "c2b782b0-3227-328b-b1d6-c0e3969e8775",
                        "glosses": [
                            "Rendre meilleur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2faba3d1-077c-4a7a-b35a-47024bd65213",
                                "sense_id": "7946c364-06f1-3a96-b49a-4ab2aa039df2",
                                "text": "Ça va empironner avant de s'emmieuter."
                            },
                            {
                                "example_id": "5d721021-0d10-4be2-b01b-baf5012e3a40",
                                "sense_id": "7946c364-06f1-3a96-b49a-4ab2aa039df2",
                                "text": "Avec votre personnage du petit Gnouf, vous dites que vous souhaitez faire lire pour « emmieuter le monde »."
                            },
                            {
                                "example_id": "dd684134-ada6-45ea-b0a2-e22fc7aaa662",
                                "sense_id": "7946c364-06f1-3a96-b49a-4ab2aa039df2",
                                "text": "Or, c’est en libérant leur imaginaire qu’on développe des petits êtres qui deviendront aussi bien des poètes que des politiciens, des ingénieurs, des professeurs, des gestionnaires, capables d’emmieuter le monde en imaginant toutes sortes de solutions."
                            }
                        ]
                    }
