                        "sense_id": "fab49cbb-339b-3b95-9717-3c729da7e4a2",
                        "entry_id": "55de04c0-9f77-3443-b7b9-e697eb78e78b",
                        "glosses": [
                            "das Führen und Geführtwerdenlassen; ganzheitliche Betreuung durch einen Guide mit Lerneffekt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "848cd13d-61ac-4f8f-8e21-e36f0b35fd11",
                                "sense_id": "fab49cbb-339b-3b95-9717-3c729da7e4a2",
                                "text": "„Ganz unter dem Motto „Fliegenfischen in Salzburg\" bieten wir Ihnen kombinierte Fliegenfischer-Kurse (Guiding Intensiv), reine Wurfkurse und individuell massgeschneiderte Einzel-Guidings an.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
