                                    {
                                        "sense_id": "ef3e4c48-0490-3a26-adf9-baca8c388d3a",
                                        "entry_id": "403bad89-871c-35a3-9abb-63719a2defec",
                                        "glosses": [
                                            "eine Sprache die vom Indianervolk der Anishinabe (auch Ojibwe) in Nordamerika gesprochen wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b67ae020-c178-4e28-b2de-ac5681e87c3c",
                                                "sense_id": "ef3e4c48-0490-3a26-adf9-baca8c388d3a",
                                                "text": "Es gibt zahlreiche Dialekte des Ojibwe, weshalb es manchmal als Dialektkontinuum anstatt einer Sprache aufgefasst wird."
                                            },
                                            {
                                                "example_id": "2169cf25-44be-438c-9778-dc77accb3325",
                                                "sense_id": "ef3e4c48-0490-3a26-adf9-baca8c388d3a",
                                                "text": "„Gerade durch die Verwendung von Ojibwe als Romansprache befand sich Vizenor wie vor ihm Pokagon auf einem Weg, der von afrikanischen Autoren seit Jahren verstärkt beschritten wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
