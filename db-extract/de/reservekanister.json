                "senses": [
                    {
                        "sense_id": "a76463cd-3927-3af1-b9a2-e4cd2dc508d9",
                        "entry_id": "cbee8757-0a93-3f54-8b1f-cf34fb6003a8",
                        "glosses": [
                            "Kanister mit einer Flüssigkeit (Benzin, Wasser oder Ähnliches), der für einen Bedarfs- oder Notfall bereitgehalten wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "09ffc2ba-53f8-441b-b4c3-19d2b41ae143",
                                "sense_id": "a76463cd-3927-3af1-b9a2-e4cd2dc508d9",
                                "text": "„Eilig bereitet er das Boot auf den Sturm vor, pumpt Trinkwasser in einen Reservekanister und rasiert sich ein letztes Mal.“"
                            },
                            {
                                "example_id": "404fbe5d-1631-46da-9a0c-7729f50bf8b7",
                                "sense_id": "a76463cd-3927-3af1-b9a2-e4cd2dc508d9",
                                "text": "„Wähend Hamid und Jacques die Reservekanister mit Benzin und Wasser füllten, schrieben wir eine Einkaufsliste, die ein algerisches Dorf gut ein Jahr versorgt hätte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
