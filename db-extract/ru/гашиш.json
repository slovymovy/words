                "senses": [
                    {
                        "sense_id": "872d1692-b148-3bb1-8835-e68be7b95d99",
                        "entry_id": "999e0662-d3b5-388e-88c3-8077a2b49e9b",
                        "glosses": [
                            "высушенная смола индийской конопли, используемая как наркотик"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3247eb27-e216-4b82-bec2-ba968badffe3",
                                "sense_id": "872d1692-b148-3bb1-8835-e68be7b95d99",
                                "text": "Заройтесь в цветы с одуряющим ароматом, задыхайтесь в мускусе, ешьте гашиш, а главное, любите, любите и любите…"
                            },
                            {
                                "example_id": "26d50ff1-7af1-4e5a-ab6e-4967c69ba1d5",
                                "sense_id": "872d1692-b148-3bb1-8835-e68be7b95d99",
                                "text": "Приехал он. Спешит, едва дыша, // И узнаёт, что господин во фраке // Однажды вечером, наевшись гашиша́, // Зарезал девушку из Нагасаки."
                            }
                        ]
                    }
