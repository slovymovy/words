                                                "sense_id": "6baa2ad6-163b-380a-9015-c64d9ac886dc",
                                                "text": "That girl at the party was really stacked."
                                            },
                                            {
                                                "example_id": "9b3171e1-1fc4-4fce-9e4c-8f549b832eb3",
                                                "sense_id": "6baa2ad6-163b-380a-9015-c64d9ac886dc",
                                                "text": "You know what I like, I like a girl that's really smart / Provided that she's really stacked"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b6c8bf8a-396c-3f06-9c42-d7f11bbfb78a",
                                        "entry_id": "f2fbe8f3-7b5f-34c1-b529-e8a41f9c701e",
                                        "glosses": [
                                            "Having large muscles; buff."
