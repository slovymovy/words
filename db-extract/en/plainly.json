                    },
                    {
                        "form_id": "a71a2c06-6a44-4abc-bb4f-06481e282aea",
                        "entry_id": "e4adbbf6-8f86-3187-a3cb-743b404b4697",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most plainly"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "843c51bd-e45e-3de7-9e81-17bf9394c3d0",
                        "entry_id": "e4adbbf6-8f86-3187-a3cb-743b404b4697",
                        "glosses": [
                            "In a plain manner; simply; basically."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c94f750-8fa7-4427-a4de-e01b945d2d08",
                                "sense_id": "843c51bd-e45e-3de7-9e81-17bf9394c3d0",
                                "text": "She decorated the room plainly but neatly."
                            },
                            {
                                "example_id": "a2522760-5d67-4dff-821a-9551efd86e30",
                                "sense_id": "843c51bd-e45e-3de7-9e81-17bf9394c3d0",
                                "text": "'Tell me plainly what you think of my daughter's little companion.'"
                            }
                        ]
                    },
                    {
                        "sense_id": "0160e8cc-c48a-3fbf-a2d1-b00fc2c982cf",
                        "entry_id": "e4adbbf6-8f86-3187-a3cb-743b404b4697",
                        "glosses": [
                            "Obviously; clearly."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f1060563-3455-4aeb-8fec-0099957aa51f",
                                "sense_id": "0160e8cc-c48a-3fbf-a2d1-b00fc2c982cf",
                                "text": "You will see that ours is plainly the better method."
                            },
                            {
                                "example_id": "84af7e50-d76c-436e-9827-75c6f2d77b1c",
                                "sense_id": "0160e8cc-c48a-3fbf-a2d1-b00fc2c982cf",
                                "text": "The stories did not seem to me to touch life. They were plainly intended to have a bracing moral effect, and perhaps had this result for the people at whom they were aimed. They left me with the impression of a well-delivered stereopticon lecture, with characters about as life-like as the shadows on the screen, and whisking on and off, at the mercy of the operator."
                            },
                            {
                                "example_id": "405ed914-8d92-40b0-97ec-1a9b888153fe",
                                "sense_id": "0160e8cc-c48a-3fbf-a2d1-b00fc2c982cf",
                                "text": "Plainly he was prepared to bark out an interminable succession of charges against the Wanderer."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "938ec475-b37c-4165-9e2b-b379bbccd81d",
                        "source_entry_id": "e4adbbf6-8f86-3187-a3cb-743b404b4697",
                        "source_sense_description": "In a plain manner",
                        "target_lang_word": "simplement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "simplement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3e02f41a-2b6e-3764-824b-05b740439d1d",
                                        "entry_id": "179b4961-5ac2-366d-88ff-88a5f0834bb5",
                                        "glosses": [
                                            "Sans complication."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c19d1fcd-39ba-487f-8ff3-f915425be6ad",
                                                "sense_id": "3e02f41a-2b6e-3764-824b-05b740439d1d",
                                                "text": "L’action de cette pièce est conduite simplement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea48e98d-9c1e-3255-b03a-6e01ada3b8d6",
                                        "entry_id": "179b4961-5ac2-366d-88ff-88a5f0834bb5",
                                        "glosses": [
                                            "Seulement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "652e3925-d16b-4989-b4bb-321a69933fc3",
                                                "sense_id": "ea48e98d-9c1e-3255-b03a-6e01ada3b8d6",
                                                "text": "S'il n'y a aucun signe plessimétrique ou stéthoscopique indiquant une lésion superficielle du poumon, et si la respiration est simplement affaiblie, on ne peut guère hésiter qu'entre l'existence d'indurations centrales ou disséminées et un état emphysémateux du poumon."
                                            },
                                            {
                                                "example_id": "dc5fa188-9205-4a0d-80c0-f10fede7cf77",
                                                "sense_id": "ea48e98d-9c1e-3255-b03a-6e01ada3b8d6",
                                                "text": "Mais aussi parce que nous nous trouvons à la veille d’une tragédie. L’angoisse monte, celle de perdre nos proches, ou simplement celle de mourir."
                                            },
                                            {
                                                "example_id": "66744014-756c-43a6-8e13-2d12d0176fba",
                                                "sense_id": "ea48e98d-9c1e-3255-b03a-6e01ada3b8d6",
                                                "text": "Avez-vous jamais rien vu qui paraisse plus contraire [les lois de l’Évangile et les lois du monde] ? Et cependant, quand je vous dis que nos pères ont accordé ces choses, vous me dites simplement que cela vous étonne."
                                            },
                                            {
                                                "example_id": "d583d11f-963e-44f6-96f7-dc02d55379dc",
                                                "sense_id": "ea48e98d-9c1e-3255-b03a-6e01ada3b8d6",
                                                "text": "[…] mais dans la pensée que ce n’est pas votre faute [si je n’ai pas reçu vos dernières nouvelles], je ne fais simplement que me plaindre de l’infidélité de nos courriers […]"
                                            },
                                            {
                                                "example_id": "a67d545c-214b-4db6-9fb6-26de0039a52a",
                                                "sense_id": "ea48e98d-9c1e-3255-b03a-6e01ada3b8d6",
                                                "text": "Mais Longin ne fut pas simplement un critique habile, ce fut un ministre d’État considérable […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0fcbca2c-557a-3f93-9bbb-3efcb7c7a93c",
                                        "entry_id": "179b4961-5ac2-366d-88ff-88a5f0834bb5",
                                        "glosses": [
                                            "D’une manière simple, sans recherche, sans ornement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "458cf6bd-61c1-4c38-a4f1-23bf58a5afa4",
                                                "sense_id": "0fcbca2c-557a-3f93-9bbb-3efcb7c7a93c",
                                                "text": "[…] la tristesse doit parler simplement, si elle veut nous intéresser […]"
                                            },
                                            {
                                                "example_id": "471ba7a0-2d2b-4baa-bfb8-a99aaa732655",
                                                "sense_id": "0fcbca2c-557a-3f93-9bbb-3efcb7c7a93c",
                                                "text": "On s’accoutume à bien parler en lisant souvent ceux qui ont bien écrit ; on se fait une habitude d’exprimer simplement et noblement sa pensée sans effort."
                                            },
                                            {
                                                "example_id": "c00fde5a-dc4e-45d0-b634-6e84423c767c",
                                                "sense_id": "0fcbca2c-557a-3f93-9bbb-3efcb7c7a93c",
                                                "text": "S’il [Marivaux] ne pouvait se résoudre à dire simplement les choses même les plus communes, du moins la facilité avec laquelle il parlait de la sorte, semblait demander grâce pour ses écrits […]"
                                            },
                                            {
                                                "example_id": "6a9aaa00-64f5-4e3c-98b1-0eef287a8b3c",
                                                "sense_id": "0fcbca2c-557a-3f93-9bbb-3efcb7c7a93c",
                                                "text": "Sitôt que la petite maison de Mont-Louis fut prête, je la fis meubler proprement, simplement, et retournai m’y établir, ne pouvant renoncer à cette loi que je m’étais faite, en quittant l’Ermitage, d’avoir toujours mon logement à moi : mais je ne pus me résoudre non plus à quitter mon appartement du petit château."
                                            },
                                            {
                                                "example_id": "94693a57-2b6f-4141-9c34-218f2a265261",
                                                "sense_id": "0fcbca2c-557a-3f93-9bbb-3efcb7c7a93c",
                                                "text": "Mais, madame, vous serez la seule, à cette fête, mise aussi simplement […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "48513f0c-cbef-3fff-97a2-ac1631312bef",
                                        "entry_id": "179b4961-5ac2-366d-88ff-88a5f0834bb5",
                                        "glosses": [
                                            "Naïvement, sans détour."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5948b4d-397f-42ba-93a9-4035151db0e5",
                                                "sense_id": "48513f0c-cbef-3fff-97a2-ac1631312bef",
                                                "text": "Elle était heureuse simplement, sans réflexion et sans autre désir que celui de voir son bonheur durer éternellement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "53009f6e-fd63-3c28-91ac-32f2d226cef8",
                                        "entry_id": "179b4961-5ac2-366d-88ff-88a5f0834bb5",
                                        "glosses": [
                                            "Bonnement, sans finesse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "44cce4ec-ad83-42b4-bd38-e5ba3c845294",
                                                "sense_id": "53009f6e-fd63-3c28-91ac-32f2d226cef8",
                                                "text": "C’est un bon homme, il y procède simplement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f719d24a-7ffa-4a92-a3f4-dcb37720f721",
