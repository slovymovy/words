                                        "sense_index_json": "\"1.2\""
                                    },
                                    {
                                        "sense_id": "4d920e16-3d1e-3f32-b9ba-0a47184257c2",
                                        "entry_id": "18b1252d-cbfe-3f86-8cca-d4b8b3247b17",
                                        "glosses": [
                                            "pawilon ogrodowy o funkcji wypoczynkowej i rozrywkowej, popularny w XVIII i XIX wieku; również cała posiadłość z ogrodem"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4210881a-cde5-4a1b-96dd-f3f4663c4c6c",
                                                "sense_id": "4d920e16-3d1e-3f32-b9ba-0a47184257c2",
                                                "text": "Majętny teść zakupił im pod miastem gustowną bagatelę, gdzie odbywały się wesołe spotkania."
                                            }
                                        ],
                                        "sense_index_json": "\"1.3\""
                                    },
                                    {
                                        "sense_id": "03fb1687-4665-3a0e-b884-b0795db13b8e",
                                        "entry_id": "18b1252d-cbfe-3f86-8cca-d4b8b3247b17",
                                        "glosses": [
                                            "krótki utwór, zazwyczaj fortepianowy, utrzymany w pogodnym nastroju"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "439b9838-afe0-4f2e-afae-c50cbe50ebe2",
                                                "sense_id": "03fb1687-4665-3a0e-b884-b0795db13b8e",
                                                "text": "Tworzył je nawet sławny Beethoven, który napisał kilkadziesiąt bagateli."
                                            }
                                        ],
                                        "sense_index_json": "\"1.4\""
                                    }
                                ]
                            },
                            {
