                "senses": [
                    {
                        "sense_id": "949d4a55-ac19-369a-8a57-23ea38a6276c",
                        "entry_id": "e55beede-79ed-3d36-a13d-7106f86e23b0",
                        "glosses": [
                            "female equivalent of баловни́к (balovník): female mischievous/spoilt person"
                        ],
                        "tags": [
                            "feminine",
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "6d510228-4b90-425f-975b-8562a3eb592e",
                                "sense_id": "949d4a55-ac19-369a-8a57-23ea38a6276c",
                                "text": "— Рекоменду́ю вам мою́ баловни́цу! — сказа́л генера́л, обратя́сь к Чи́чикову. — Одна́ко ж фами́лии ва́шей, и́мени и о́течества до сих по́р не зна́ю.",
                                "translation": "\"May I introduce you to my little pet?\" said the General to Chichikov. \"To tell you the truth, I do not know your name.\"",
                                "english": "\"May I introduce you to my little pet?\" said the General to Chichikov. \"To tell you the truth, I do not know your name.\""
                            },
                            {
                                "example_id": "bdd9f62b-22c9-4837-a08d-64234b672979",
                                "sense_id": "949d4a55-ac19-369a-8a57-23ea38a6276c",
                                "text": "Но уж тако́й был хара́ктер: была́ она́, по всей фо́рме, баловни́ца.",
                                "translation": "But that was her character; she was a spoilt child in every respect.",
                                "english": "But that was her character; she was a spoilt child in every respect."
                            }
                        ]
                    }
                ],
