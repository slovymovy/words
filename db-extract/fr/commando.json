                        ]
                    },
                    {
                        "translation_id": "d180ccce-09a1-489d-8fdb-26f275bdf0be",
                        "source_entry_id": "ab6e6096-1521-3d84-998f-c27f0c47ef13",
                        "target_lang_word": "commando",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "commando",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "6813ce8d-a616-3f4e-b722-183dde1c5398",
                                        "entry_id": "173933c8-2e1d-32d0-bf37-c3410059610a",
                                        "glosses": [
                                            "bevel, leiding"
                                        ],
                                        "tags": [
                                            "neuter"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d9feaba1-62f3-485b-a6ff-6648fdb41bff",
                                                "sense_id": "6813ce8d-a616-3f4e-b722-183dde1c5398",
                                                "text": "De kapitein voerde het commando over het schip."
                                            },
                                            {
                                                "example_id": "934587f7-9815-49a8-bc9d-fb231ace7946",
                                                "sense_id": "6813ce8d-a616-3f4e-b722-183dde1c5398",
                                                "text": "Een kapitein bijv., die 2 jaren in de rijen van het leger een commando heeft gevoerd, daarna 5 jaar werkzaam was in een speciale betrekking, zou tot majoor kunnen worden bevorderd."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "103897df-4030-392e-94fd-994dd2c10bc3",
                                        "entry_id": "173933c8-2e1d-32d0-bf37-c3410059610a",
                                        "glosses": [
                                            "speciaal getrainde groep militairen voor speciale missies"
                                        ],
                                        "tags": [
                                            "neuter"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ce9cf0b3-4ebf-4bc2-805c-e6367caaa991",
                                                "sense_id": "103897df-4030-392e-94fd-994dd2c10bc3",
                                                "text": "Het is wel de moeite waard, om voor een oogenblik na te gaan, op welke wijze deze Boeren ten oorlog uittrokken. De plaats der samenkomst was nabij de Tugela, waar alles voor het commando geregeld werd, en men zou wachten totdat de dappere Karel Landman met zijne mannen, van de kust waren aangekomen. Het opperbevel over het commando werd gevoerd door Pretorius, en, eer naast dan, onder hem stonden ‘commandanten’, wien de ‘veldcornetten’ ondergeschikt waren."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e960077a-a995-3f43-bb49-5353fe72f8af",
                                        "entry_id": "173933c8-2e1d-32d0-bf37-c3410059610a",
                                        "glosses": [
                                            "opdracht om een bepaald proces uit te voeren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
