    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c81ae0e0-b868-3a48-83bf-34dce9a6b766",
                    "sense_definition": "To sell goods to a foreign country.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Japan <w>exports</w> electronic goods throughout the world.",
                            "target_lang_translations": {
                                "ru": "Япония <w>экспортирует</w> электронные товары по всему миру.",
                                "tr": "Japonya tüm dünyaya elektronik eşya <w>ihraç eder</w>.",
                                "zh": "日本向全世界<w>出口</w>电子产品。"
                            }
                        },
                        {
                            "text": "The company plans to <w>export</w> its products to Europe next year.",
                            "target_lang_translations": {
                                "ru": "Компания планирует <w>экспортировать</w> свою продукцию в Европу в следующем году.",
                                "tr": "Şirket önümüzdeki yıl ürünlerini Avrupa'ya <w>ihraç etmeyi</w> planlıyor.",
                                "zh": "该公司计划明年将产品<w>出口</w>到欧洲。"
                            }
                        }
                    ],
                    "antonyms": [
                        "import"
                    ],
                    "common_phrases": [
                        "export goods",
                        "export products",
                        "export to countries"
                    ],
                    "target_lang_definitions": {
                        "ru": "Продавать товары или услуги в другую страну.",
                        "tr": "Başka bir ülkeye mal satmak, ihraç etmek.",
                        "zh": "将商品销售到外国。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "экспортировать",
                                "target_lang_sense_clarification": "продавать за границу"
                            },
                            {
                                "target_lang_word": "вывозить",
                                "target_lang_sense_clarification": "отправлять товары за границу"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "ihraç etmek",
                                "target_lang_sense_clarification": "yurt dışına mal satmak"
                            },
                            {
                                "target_lang_word": "dışarı satmak",
                                "target_lang_sense_clarification": "yurt dışına satmak"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "出口",
                                "target_lang_sense_clarification": "将商品运往国外销售"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7f1071be-e002-31f2-b146-6ac3d6f7c4f1",
                    "sense_definition": "To send data from one program or format to another.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You can <w>export</w> the file as a PDF document.",
                            "target_lang_translations": {
                                "ru": "Вы можете <w>экспортировать</w> этот файл как PDF-документ.",
                                "tr": "Dosyayı bir PDF belgesi olarak <w>dışa aktarabilirsiniz</w>.",
                                "zh": "你可以将该文件<w>导出</w>为PDF文档。"
                            }
                        },
                        {
                            "text": "The software allows users to <w>export</w> data easily.",
                            "target_lang_translations": {
                                "ru": "Программное обеспечение позволяет пользователям легко <w>экспортировать</w> данные.",
                                "tr": "Yazılım, kullanıcıların verileri kolayca <w>dışa aktarmasına</w> olanak tanır.",
                                "zh": "该软件允许用户轻松<w>导出</w>数据。"
                            }
                        }
                    ],
                    "antonyms": [
                        "import"
                    ],
                    "common_phrases": [
                        "export data",
                        "export files",
                        "export as PDF"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сохранять данные в формате, который может быть использован другой программой.",
                        "tr": "Verileri bir programdan veya biçimden diğerine aktarmak.",
                        "zh": "将数据从一个程序或格式转移到另一个。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "экспортировать",
                                "target_lang_sense_clarification": "данные или файлы"
                            },
                            {
                                "target_lang_word": "выгружать",
                                "target_lang_sense_clarification": "данные из системы"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "dışa aktarmak",
                                "target_lang_sense_clarification": "dosya veya veri aktarmak"
                            },
                            {
                                "target_lang_word": "ihraç etmek",
                                "target_lang_sense_clarification": "yazılımda veri aktarmak"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "导出",
                                "target_lang_sense_clarification": "将数据或文件从系统中输出"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d5d18f9d-c594-3d02-94fa-dd515a8f1548",
                    "sense_definition": "To cause an idea, culture, or practice to spread to another part of the world.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The country tried to <w>export</w> its culture to neighboring nations.",
                            "target_lang_translations": {
                                "ru": "Страна пыталась <w>экспортировать</w> свою культуру в соседние государства.",
                                "tr": "Ülke, kültürünü komşu ülkelere <w>yaymaya</w> çalıştı.",
                                "zh": "该国试图向邻国<w>输出</w>其文化。"
                            }
                        },
                        {
                            "text": "It is difficult to <w>export</w> democracy to regions with different traditions.",
                            "target_lang_translations": {
                                "ru": "Трудно <w>экспортировать</w> демократию в регионы с другими традициями.",
                                "tr": "Farklı geleneklere sahip bölgelere demokrasi <w>ihraç etmek</w> zordur.",
                                "zh": "将民主<w>输出</w>到传统不同的地区是很困难的。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "export culture",
                        "export democracy",
                        "export ideas"
                    ],
                    "target_lang_definitions": {
                        "ru": "Распространять идеи, культуру или обычаи в другие части мира.",
                        "tr": "Bir fikrin, kültürün veya uygulamanın dünyanın başka bir bölgesine yayılmasını sağlamak.",
                        "zh": "使某种思想、文化或习俗传播到世界其他地区。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "экспортировать",
                                "target_lang_sense_clarification": "идеи или культуру"
                            },
                            {
                                "target_lang_word": "распространять",
                                "target_lang_sense_clarification": "влияние или практики"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "yaymak",
                                "target_lang_sense_clarification": "fikir veya kültür yaymak"
                            },
                            {
                                "target_lang_word": "ihraç etmek",
                                "target_lang_sense_clarification": "kültür veya düşünce taşımak"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "输出",
                                "target_lang_sense_clarification": "传播文化或思想"
                            },
                            {
                                "target_lang_word": "传播",
                                "target_lang_sense_clarification": "使影响或实践扩散"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0d2f0ee5-896b-3a47-9d0a-f741422fb0d1",
                    "sense_definition": "To carry away.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They sought to <w>export</w> honour from a man through envy.",
                            "target_lang_translations": {
                                "ru": "Они стремились <w>похитить</w> честь человека через зависть.",
                                "tr": "Kıskançlık yoluyla bir adamın onurunu <w>götürmeye</w> çalıştılar.",
                                "zh": "他们试图通过嫉妒从那个人身上<w>夺走</w>荣誉。"
                            }
                        },
                        {
                            "text": "The thieves managed to <w>export</w> the stolen items before anyone noticed.",
                            "target_lang_translations": {
                                "ru": "Ворам удалось <w>вывезти</w> украденные вещи, прежде чем кто-либо заметил.",
                                "tr": "Hırsızlar kimse fark etmeden çalınan eşyaları <w>kaçırmayı</w> başardı.",
                                "zh": "小偷在被人发现之前设法<w>运走</w>了赃物。"
                            }
                        }
                    ],
                    "synonyms": [
                        "remove"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Уносить или увозить прочь (устаревшее значение).",
                        "tr": "Uzağa götürmek, taşımak (eski kullanım).",
                        "zh": "带走或运走（古语）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уносить",
                                "target_lang_sense_clarification": "похищать или забирать"
                            },
                            {
                                "target_lang_word": "вывозить",
                                "target_lang_sense_clarification": "удалять откуда-либо"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "götürmek",
                                "target_lang_sense_clarification": "uzaklaştırmak"
                            },
                            {
                                "target_lang_word": "kaçırmak",
                                "target_lang_sense_clarification": "çalıp götürmek"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "运走",
                                "target_lang_sense_clarification": "将某物移走"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "43ea4fc0-9125-3ece-acb3-4f02649ec907",
                    "sense_definition": "To put up a child for international adoption.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The agency was investigated for trying to <w>export</w> children illegally.",
                            "target_lang_translations": {
                                "ru": "Агентство находилось под следствием за попытку незаконно <w>вывезти</w> детей.",
                                "tr": "Ajans, çocukları yasa dışı yollardan <w>yurt dışına göndermeye</w> çalıştığı için soruşturuldu.",
                                "zh": "该机构因试图非法将儿童<w>送往国外</w>而受到调查。"
                            }
                        },
                        {
                            "text": "Laws were changed to prevent people from seeking to <w>export</w> orphans for profit.",
                            "target_lang_translations": {
                                "ru": "Законы были изменены, чтобы помешать людям пытаться <w>вывозить</w> сирот ради наживы.",
                                "tr": "İnsanların kar amacıyla yetimleri <w>yurt dışına göndermeye</w> çalışmasını önlemek için yasalar değiştirildi.",
                                "zh": "法律已修改，以防止人们试图为牟利而将孤儿<w>送往国外</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Отправлять детей за границу для усыновления.",
                        "tr": "Bir çocuğu uluslararası evlat edinme amacıyla yurt dışına göndermek.",
                        "zh": "将儿童送往国外进行跨国收养。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вывозить",
                                "target_lang_sense_clarification": "детей для усыновления"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "yurt dışına göndermek",
                                "target_lang_sense_clarification": "evlat edinme amacıyla çocuğu göndermek"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "送往国外",
                                "target_lang_sense_clarification": "将儿童送出境外"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "56162f61-77e0-368e-bced-edd65e67496e",
                    "sense_definition": "Something that is sold to a foreign country.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Oil is the main <w>export</w> of Saudi Arabia.",
                            "target_lang_translations": {
                                "ru": "Нефть является основным <w>экспортом</w> Саудовской Аравии.",
                                "tr": "Petrol, Suudi Arabistan'ın ana <w>ihraç malıdır</w>.",
                                "zh": "石油是沙特阿拉伯主要的<w>出口商品</w>。"
                            }
                        },
                        {
                            "text": "Agricultural <w>exports</w> have increased significantly this year.",
                            "target_lang_translations": {
                                "ru": "Сельскохозяйственный <w>экспорт</w> значительно вырос в этом году.",
                                "tr": "Tarımsal <w>ihracat</w> bu yıl önemli ölçüde arttı.",
                                "zh": "今年农产品<w>出口</w>量显著增加。"
                            }
                        }
                    ],
                    "antonyms": [
                        "import"
                    ],
                    "common_phrases": [
                        "main export",
                        "major export",
                        "agricultural exports"
                    ],
                    "target_lang_definitions": {
                        "ru": "Товар, который продается в другую страну.",
                        "tr": "Yabancı bir ülkeye satılan ürün veya mal.",
                        "zh": "销售到外国的商品。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "экспорт",
                                "target_lang_sense_clarification": "вывозимый товар"
                            },
                            {
                                "target_lang_word": "предмет экспорта",
                                "target_lang_sense_clarification": "товар для вывоза"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "ihraç malı",
                                "target_lang_sense_clarification": "dışa satılan ürün"
                            },
                            {
                                "target_lang_word": "ihracat",
                                "target_lang_sense_clarification": "ihraç edilen ürünler"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "出口商品",
                                "target_lang_sense_clarification": "用于外销的货物"
                            },
                            {
                                "target_lang_word": "出口产品",
                                "target_lang_sense_clarification": "外销的产物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9105c0c4-7f81-3b77-a135-c574d6dca789",
                    "sense_definition": "The act of sending goods to another country for sale.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>export</w> of fish is forbidden in this country.",
                            "target_lang_translations": {
                                "ru": "<w>Экспорт</w> рыбы запрещен в этой стране.",
                                "tr": "Bu ülkede balık <w>ihracatı</w> yasaktır.",
                                "zh": "在这个国家，鱼类的<w>出口</w>是被禁止的。"
                            }
                        },
                        {
                            "text": "The government encourages the <w>export</w> of local manufactured goods.",
                            "target_lang_translations": {
                                "ru": "Правительство поощряет <w>экспорт</w> товаров местного производства.",
                                "tr": "Hükümet, yerel üretilen malların <w>ihracatını</w> teşvik ediyor.",
                                "zh": "政府鼓励本地制造商品的<w>出口</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "exportation"
                    ],
                    "antonyms": [
                        "import",
                        "importation"
                    ],
                    "common_phrases": [
                        "export license",
                        "ban on export",
                        "export market"
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс отправки товаров в другую страну для продажи.",
                        "tr": "Malların satılmak üzere başka bir ülkeye gönderilmesi eylemi, dış satım.",
                        "zh": "将货物运往他国销售的行为。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "экспорт",
                                "target_lang_sense_clarification": "процесс вывоза товаров"
                            },
                            {
                                "target_lang_word": "вывоз",
                                "target_lang_sense_clarification": "действие по отправке товаров"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "ihracat",
                                "target_lang_sense_clarification": "dış satım süreci"
                            },
                            {
                                "target_lang_word": "ihraç",
                                "target_lang_sense_clarification": "dışarı çıkarma işlemi"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "出口",
                                "target_lang_sense_clarification": "外销的行为或过程"
                            }
                        ]
                    }
                }
            ]
        },
