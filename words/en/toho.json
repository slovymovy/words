                    "frequency": "VeryLow",
                    "semantic_group_id": "hunting_calls",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hunter cried <w>toho</w> to get the attention of the hounds as they neared the woods.",
                            "target_lang_translations": {
                                "ru": "Охотник крикнул «<w>ату</w>», чтобы привлечь внимание гончих, когда они приблизились к лесу."
                            }
                        },
                        {
                            "text": "The old dog became rigid when he heard the master shout <w>toho</w> across the field.",
                            "target_lang_translations": {
                                "ru": "Старый пес замер, услышав, как хозяин крикнул «<w>ату</w>» через все поле."
                            }
                        }
                    ],
                    "synonyms": [
                        "tallyho"
                    ],
                    "traits": [
