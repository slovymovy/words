                        "lautes Organ"
                    ]
                },
                {
                    "sense_id": "4c4c3d23-c199-33bf-ab67-87d204622b39",
                    "sense_definition": "Zeitschrift oder Zeitung, die als Sprachrohr einer Partei, Organisation oder eines Vereins dient",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "publikation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die monatliche Zeitschrift fungiert als offizielles <w>Organ</w> der medizinischen Gesellschaft."
                        },
                        {
                            "text": "In diesem <w>Organ</w> veröffentlicht die Gewerkschaft regelmäßig ihre politischen Forderungen."
                        }
                    ],
                    "synonyms": [
                        "Mitgliederzeitschrift",
                        "Parteizeitung",
                        "Vereinsblatt"
                    ],
                    "common_phrases": [
                        "offizielles Organ"
                    ]
                },
                {
                    "sense_id": "3a163973-d0f0-317e-a5ac-bfdb32db1f6e",
                    "sense_definition": "Gespür, innerer Sinn oder Empfänglichkeit für bestimmte Themen, Stimmungen oder Belange",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "empfindung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Für moderne Malerei hat mein Gesprächspartner leider überhaupt kein <w>Organ</w>."
                        },
                        {
                            "text": "Die Diplomatin besaß ein feines <w>Organ</w> für politische Zwischentöne."
                        }
                    ],
                    "synonyms": [
                        "Empfänglichkeit",
                        "Empfindung",
                        "Sinn"
                    ],
                    "common_phrases": [
                        "kein Organ haben"
                    ]
                }
            ]
        }
    ]
