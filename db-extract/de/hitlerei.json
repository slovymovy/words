                        "examples": [
                            {
                                "example_id": "5f1b328f-1cd0-484a-ba81-3fbd6f6d0bfe",
                                "sense_id": "171e51d8-ec69-3ae0-a592-5eb1286e37c2",
                                "text": "„Wie weit war man selber schuldig geworden in der Jahren der Hitlerei, schuldig im Handeln, schuldig im Denken, schuldig im Gewährenlassen, im Nichtaufbegehren gegen Unrecht?“"
                            },
                            {
                                "example_id": "7d1e3518-5a35-4656-b6c3-bff2576287ca",
                                "sense_id": "171e51d8-ec69-3ae0-a592-5eb1286e37c2",
                                "text": "„Dass irgendein Kollege an Dr. Helmys Krankenhaus Sympathien für die Hitlerei äußerte, war bis dahin selten vorgekommen.“"
                            }
                        ],
