                            {
                                "example_id": "e74ed685-7c09-479b-aad5-9acd4097b291",
                                "sense_id": "30f8f514-5eaf-3f6a-82b6-41ef41dfdd00",
                                "text": "Dans notre petite ferme, nous avons de la quinoa, de la kiwicha (amarante), de la pomme de terre, de l'oca, du camote (patate douce), un peu de tout."
                            }
                        ]
                    },
