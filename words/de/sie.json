            "senses": [
                {
                    "sense_id": "01eee410-7d53-3782-8e50-707bb37e4862",
                    "sense_definition": "Personalpronomen der 3. Person Singular Femininum; ersetzt eine weibliche Person oder ein grammatisch feminines Substantiv im Nominativ oder Akkusativ.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "3_person_singular_femininum",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Meine Schwester wohnt in Berlin und <w>sie</w> arbeitet dort als Lehrerin."
                        },
                        {
                            "text": "Wo ist meine Brille? Ich kann <w>sie</w> nirgends finden."
                        }
                    ],
                    "common_phrases": [
                        "sie selbst"
                    ]
                },
                {
                    "sense_id": "249c0393-361a-3d55-bfc3-65a6ae789f4e",
                    "sense_definition": "Personalpronomen der 3. Person Plural; ersetzt mehrere Personen oder Sachen im Nominativ oder Akkusativ.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "3_person_plural",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die Kinder sind im Garten, weil <w>sie</w> dort gerne Fußball spielen."
                        },
                        {
                            "text": "Ich habe die Dokumente ausgedruckt und werde <w>sie</w> gleich unterschreiben."
                        }
                    ],
                    "common_phrases": [
                        "sie alle",
                        "sie beide"
                    ]
                },
                {
                    "sense_id": "777e14d6-73d5-3bf7-9fc5-7df7d0609d46",
                    "sense_definition": "Höfliche, formelle Anrede für eine oder mehrere angesprochene Personen im Nominativ oder Akkusativ.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "anrede_hoeflichkeitsform",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Können <w>Sie</w> mir bitte sagen, wo der Bahnhof ist?"
                        },
                        {
                            "text": "Guten Tag, Frau Meier, möchten <w>Sie</w> einen Kaffee trinken?"
                        }
                    ],
                    "common_phrases": [
                        "Sie alle"
                    ]
                },
                {
                    "sense_id": "66759f38-c00c-376c-97c8-8800fba010ec",
                    "sense_definition": "Personalpronomen der 3. Person Plural, das sich auf unbestimmte oder nicht näher benannte Personen bezieht; im Sinne von „man“ oder „die Leute“.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "3_person_plural_indefinit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Im Radio haben <w>sie</w> heute vor dem starken Schneefall gewarnt."
                        },
                        {
                            "text": "In diesem Restaurant bereiten <w>sie</w> die Pizza immer frisch zu."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "umgangssprachlich"
                        }
                    ]
                }
            ]
        },
        {
