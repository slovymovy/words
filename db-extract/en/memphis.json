                                "target_senses": [
                                    {
                                        "sense_id": "c297d5f1-0a62-35dd-bf7d-ba3be3d0633f",
                                        "entry_id": "d0d9ac8e-c7f3-3e67-9a47-caacfe9af0d2",
                                        "glosses": [
                                            "Großstadt in Tennessee, USA"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5cf57c07-704a-4ed0-8022-757f9e342f35",
                                                "sense_id": "c297d5f1-0a62-35dd-bf7d-ba3be3d0633f",
                                                "text": "„Das mit dem PornoDepot verklickert mir der Agent eines Tages in Dallas oder Memphis.“"
                                            },
                                            {
                                                "example_id": "b90bf024-97c8-4b10-90bb-d539fa0c221e",
                                                "sense_id": "c297d5f1-0a62-35dd-bf7d-ba3be3d0633f",
                                                "text": "„Seine Leiche wurde zur medizinischen Fakultät der Universität von Memphis befördert.“"
                                            },
                                            {
                                                "example_id": "ea33e575-6b97-470a-878d-144fb7a8dbc0",
                                                "sense_id": "c297d5f1-0a62-35dd-bf7d-ba3be3d0633f",
                                                "text": "„Dann, kurz vor Morgengrauen in Memphis, hielt ein Citypolizist auf Streife, der eine Beschwerde hinsichtlich eines Herumtreibers auf der Winchester Avenue untersuchte, einen älteren Mann an, der entlang des Banketts Aluminiumdosen und Schrott auflas.“"
                                            },
                                            {
                                                "example_id": "5e819544-73b0-4cf2-9268-a8a79514af47",
                                                "sense_id": "c297d5f1-0a62-35dd-bf7d-ba3be3d0633f",
                                                "text": "„Er zieht westwärts bis Memphis, ein einsamer Wanderer in der flachen, pastoralen Landschaft.“"
                                            },
                                            {
                                                "example_id": "c31266df-766e-4c7b-8a34-1baeba78e564",
                                                "sense_id": "c297d5f1-0a62-35dd-bf7d-ba3be3d0633f",
                                                "text": "„Momentan spreche ich mit einer älteren einsamen Frau, die laut Vorwahl irgendwo in Memphis, Tennessee, lebt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "37899cb0-69ae-32a5-827a-f64be9925e5c",
                                        "entry_id": "d0d9ac8e-c7f3-3e67-9a47-caacfe9af0d2",
                                        "glosses": [
                                            "antike Stadt und damalige Hauptstadt des des ersten unterägyptischen Gaues"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e294ac33-f0b0-474a-be1c-dbdb303ee5b0",
                                                "sense_id": "37899cb0-69ae-32a5-827a-f64be9925e5c",
                                                "text": "„So muss es bereits gewesen sei, ehe der Grundstein zu Memphis gelegt wurde und als die Ziegel Babylons noch nicht gebrannt waren.“"
                                            },
                                            {
                                                "example_id": "078cd6f8-5200-4340-903f-7bc8b2fb0921",
                                                "sense_id": "37899cb0-69ae-32a5-827a-f64be9925e5c",
                                                "text": "„Die Gruppe der Pyramiden erhob sich auf einem hohen Felsplateau als annähernd nördlichste jener Reihen von prachtvollen und erhabenen Totenburgen der Herrscher und der Hochgestellten, die in Nachbarschaft zur erloschenen Hauptstadt Memphis erbaut worden waren, welche etwas südlich von Giseh am selben Nilufer lag und von 3400 bis 2000 vor Christi Geburt in Blüte stand.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "e74b6832-5bb1-34f4-9a0e-ae5a89e42871",
                                        "entry_id": "d0d9ac8e-c7f3-3e67-9a47-caacfe9af0d2",
                                        "glosses": [
                                            "Name verschiedener Orte (vor allem in den USA)"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
