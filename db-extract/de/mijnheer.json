                                    {
                                        "sense_id": "efa8405b-dde2-3ee2-834e-fd10e12b133c",
                                        "entry_id": "8b75f3c8-81dd-356f-90ad-8fb6d47637d1",
                                        "glosses": [
                                            "een formele manier om een man aan te spreken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb90a524-7348-4d4e-bfac-71933614ebf0",
                                                "sense_id": "efa8405b-dde2-3ee2-834e-fd10e12b133c",
                                                "text": "Dag, meneer De Vries!"
                                            },
                                            {
                                                "example_id": "fa3cdeae-9285-42cf-805b-6bdd7c81e745",
                                                "sense_id": "efa8405b-dde2-3ee2-834e-fd10e12b133c",
                                                "text": "`Heeft het hotel een nieuwe eigenaar?' vroeg ik.\n `Onlangs is Grand Hotel Europa overgegaan in Chinese handen,' zei hij. 'De nieuwe eigenaar heet meneer Wang. Het gaat om een recente ontwikkeling die we op dit moment onmogelijk kunnen beoordelen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "34039ce8-97d3-3380-84f9-be9bf703fde8",
                                        "entry_id": "8b75f3c8-81dd-356f-90ad-8fb6d47637d1",
                                        "glosses": [
                                            "een nette man"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e99d7d87-3546-4f25-95d4-9dbb0718525a",
                                                "sense_id": "34039ce8-97d3-3380-84f9-be9bf703fde8",
                                                "text": "Je bent een hele meneer in dat pak!"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "meneer",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "d6cf4776-b85d-354a-8147-1a4858cea900",
                                        "entry_id": "35678a91-6028-33a5-a1db-4dc86da1927b",
                                        "glosses": [
