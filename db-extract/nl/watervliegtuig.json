                                                "example_id": "fce09db5-ff14-428f-934b-bda7a7494e4a",
                                                "sense_id": "d03f7f43-02ba-39e1-a017-b3cf8ad05888",
                                                "text": "Don't drive too fast on wet roads or the car may hydroplane and cause you to lose control of the vehicle."
                                            }
                                        ]
                                    }
