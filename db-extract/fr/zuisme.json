                    {
                        "sense_id": "3dfdaebc-cdb9-3863-8f8e-41fb87048b64",
                        "entry_id": "5dc027aa-a6ba-3cf7-8190-849b6ac7d0b5",
                        "glosses": [
                            "Sorte de mouvement néopaïen, d'origine hongroise, bâti sur des doctrines issues des civilisations sumérienne, mésopotamienne, sémite et cananéenne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "90634df8-3540-4b09-b601-cd3762ed9229",
                                "sense_id": "3dfdaebc-cdb9-3863-8f8e-41fb87048b64",
                                "text": "Le 1ᵉʳ janvier, 3 Islandais se réclamaient du zuisme, un culte sumérien vieux de 3000 ans. En onze mois, leur nombre a été multiplié par un peu plus de 1000."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dd58b70f-df78-492b-9ffa-8a440fd5e388",
                        "source_entry_id": "5dc027aa-a6ba-3cf7-8190-849b6ac7d0b5",
                        "source_sense_id": "3dfdaebc-cdb9-3863-8f8e-41fb87048b64",
                        "target_lang_word": "Zuism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zuism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ea44f83b-59fd-34c7-b7df-01ecdca2fe03",
                                        "entry_id": "862e6b04-77cf-3056-abea-984135822c71",
                                        "glosses": [
                                            "Sumerian and Semitic Neopaganism; modern revival of the Mesopotamian and Canaanite religions."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c1900d9-0de6-404a-922f-24c5c7f2f88d",
                                                "sense_id": "ea44f83b-59fd-34c7-b7df-01ecdca2fe03",
                                                "text": "Zuism is defined as an international religious movement which intends to represent all the groups professing Sumerian-Mesopotamian religions."
                                            },
                                            {
                                                "example_id": "d213ad3f-962d-40b9-823b-851840edfae3",
                                                "sense_id": "ea44f83b-59fd-34c7-b7df-01ecdca2fe03",
                                                "text": "Here is the recovery and incorporation of wisdom from the Ancient Near East into a modern tradition of Babylonian Neopaganism known for over a decade as Mardukite Zuism."
                                            },
                                            {
                                                "example_id": "61e3be36-66e5-41e4-9882-5aafdf9f8c4e",
                                                "sense_id": "ea44f83b-59fd-34c7-b7df-01ecdca2fe03",
                                                "text": "...Zuism, an officially recognized religion in Iceland that, according to Hagstofa Íslands, grew from having no members in 2014 to having 3,087 members in 2016."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
