                "senses": [
                    {
                        "sense_id": "7dea029c-9ae0-3940-87cb-a12bb2a719d1",
                        "entry_id": "a36fd9e7-92db-3f67-9d13-7f2045f49ddb",
                        "glosses": [
                            "поэт. о чувствах, мыслях и т. п.: скрываемый от других; скрытый, тайный"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d5b84f70-f71c-44a0-a8f7-0baf43535c45",
                                "sense_id": "7dea029c-9ae0-3940-87cb-a12bb2a719d1",
                                "text": "Когда дряхлеющие силы // Нам начинают изменять // И мы должны, как старожилы, // Пришельцам новым место дать, — // Спаси тогда нас, добрый гений, // От малодушных укоризн, // От клеветы, от озлоблений // На изменяющую жизнь; // От чувства затаенной злости // На обновляющийся мир, // Где новые садятся гости // За уготованный им пир."
                            }
                        ]
                    },
                    {
                        "sense_id": "d9bd1286-b871-3eb5-afd0-c9a869fe7d71",
                        "entry_id": "a36fd9e7-92db-3f67-9d13-7f2045f49ddb",
                        "glosses": [
                            "поэт. о звуках: намеренно тихий; приглушённый"
                        ],
