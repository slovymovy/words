                    {
                        "translation_id": "22f39b81-7ea6-49c6-bd0b-6bf03d845b23",
                        "source_entry_id": "0cb33be0-8137-3f26-bfcd-8987aa7537cb",
                        "source_sense_id": "d89752c4-098f-366c-9d21-36b0d5cff746",
