            {
                "entry_id": "a1d6d39c-31ec-37fb-8e36-4c401ac51116",
                "word": "Jodendom",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "502404de-6cda-36ed-b782-0cd1fa5af4d9",
                        "entry_id": "a1d6d39c-31ec-37fb-8e36-4c401ac51116",
                        "glosses": [
                            "het Joodse volk (beschouwd als etnische groep)"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6a4fe2df-af19-4cb3-8a53-ce1d8abce736",
                        "source_entry_id": "a1d6d39c-31ec-37fb-8e36-4c401ac51116",
                        "source_sense_id": "502404de-6cda-36ed-b782-0cd1fa5af4d9",
                        "target_lang_word": "Judentum",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Judentum",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "106c9046-3b45-3fef-9ed7-6269a26ebfb8",
                                        "entry_id": "1db1faca-6a4f-3992-88b5-e16c890ffc99",
                                        "glosses": [
                                            "Gesamtheit aus Kultur, Geschichte, Religion und Tradition des sich selbst als „Volk Israel“ bezeichnenden jüdischen Volkes"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "28e12849-8ca0-43a7-9331-4b2430ac0fb4",
                                                "sense_id": "106c9046-3b45-3fef-9ed7-6269a26ebfb8",
                                                "text": "„Natürlich konnte Heine nicht ahnen, was im zwanzigsten Jahrhundert geschehen würde, aber er wußte sehr genau, dass der Hass gegen das Judentum tief verwurzelt ist.“"
                                            },
                                            {
                                                "example_id": "885e4d38-a1e8-466f-9ad9-80d9771d4b29",
                                                "sense_id": "106c9046-3b45-3fef-9ed7-6269a26ebfb8",
                                                "text": "„Insgesamt gesehen verschob sich der kulturelle und demographische Schwerpunkt des aschkenasischen Judentums jedoch immer weiter nach Osten.“"
                                            },
                                            {
                                                "example_id": "527208dc-09a1-47b8-8975-c7d3d3776396",
                                                "sense_id": "106c9046-3b45-3fef-9ed7-6269a26ebfb8",
                                                "text": "„Sein Judentum reflektiert Canetti in diversen Aufzeichnungen immer wieder.“"
                                            },
                                            {
                                                "example_id": "0635d3ad-c79b-473c-a27d-ed2e1c0f04a9",
                                                "sense_id": "106c9046-3b45-3fef-9ed7-6269a26ebfb8",
                                                "text": "„Der Firmengründer trug noch Kippa und Bart, sein Porträt hängt im Büro, seine Nachfahren sind typische Vertreter eines erfolgreich assimilierten Judentums.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "cbb9233c-08bf-3aa4-952a-267770a0003b",
                                        "entry_id": "1db1faca-6a4f-3992-88b5-e16c890ffc99",
                                        "glosses": [
                                            "eine der Weltreligionen"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0fb4349e-42f8-4190-9eee-4607cae98d67",
                                                "sense_id": "cbb9233c-08bf-3aa4-952a-267770a0003b",
                                                "text": "Das Christentum hat viele Überlieferungen vom Judentum und vom Heidentum übernommen."
                                            },
                                            {
                                                "example_id": "0117ed40-187e-4990-9c58-4a1260641d29",
                                                "sense_id": "cbb9233c-08bf-3aa4-952a-267770a0003b",
                                                "text": "„Anders als im Christentum ist die sogenannte Ruhefrist im Judentum zeitlich unbegrenzt.“"
                                            },
                                            {
                                                "example_id": "d0c88a51-39c9-44a7-900e-121ce8e841f5",
                                                "sense_id": "cbb9233c-08bf-3aa4-952a-267770a0003b",
                                                "text": "„Christentum, Judentum und gerade auch der Islam sind spielfeindliche Religionen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "fe872a80-aab5-3be5-82bd-ba3019dc8937",
                                        "entry_id": "1db1faca-6a4f-3992-88b5-e16c890ffc99",
                                        "glosses": [
                                            "eine spezifische Auffassung oder Art von [1] und/oder [2]"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d14f1b55-aba4-4788-bef8-95397f27bcd7",
                                                "sense_id": "fe872a80-aab5-3be5-82bd-ba3019dc8937",
                                                "text": "„Insofern müssen sie als ‚Geschichtszeichen‘ (Immanuel Kant) begriffen werden, deren nackte Faktizität für die Orthodoxien, wie die konservativen, liberalen und säkularen Bewegungen innerhalb der Judentümer maßgeblich sind.“"
                                            },
                                            {
                                                "example_id": "c775bdd0-40c7-4772-ad22-f42742fa5d8a",
                                                "sense_id": "fe872a80-aab5-3be5-82bd-ba3019dc8937",
                                                "text": "„So mag es paradox erscheinen, dass sich nach der frühen Phase der Distanzierung mit wechselseitigen Anschuldigungen und Verdächtigungen auch die ‚Begegnung‘ der beiden Judentümer – trotz Gemeinsamkeiten in der Einwanderungs- und Russlandpolitik – konfliktreich gestaltet und spannungsreich auflädt.“"
                                            },
                                            {
                                                "example_id": "7d68f037-7149-4770-9ea3-ef8e45857b03",
                                                "sense_id": "fe872a80-aab5-3be5-82bd-ba3019dc8937",
                                                "text": "„Manchmal scheint es uns, als hätten wir nicht ein Judentum, sondern viele Judentümer […]“"
                                            },
                                            {
                                                "example_id": "7c1bc1f9-4a0d-495e-93e8-6045c5e5c5f8",
                                                "sense_id": "fe872a80-aab5-3be5-82bd-ba3019dc8937",
                                                "text": "„Es gab zu allen Zeiten verschiedene Judentümer.“"
                                            },
                                            {
                                                "example_id": "14143c3f-b42a-45b2-9f4c-dab237bb9fb1",
                                                "sense_id": "fe872a80-aab5-3be5-82bd-ba3019dc8937",
                                                "text": "„Das Judentum bzw. die Judentümer ab der rabbinischen Zeit unterscheiden sich nicht weniger von den Judentümern (bzw. israelitischen, judäischen und Diaspora-Kulturen), aus denen die alttestamentlichen Schriften hervorgegangen sind, als das Christentum bzw. die Christentümer ab der Zeit der Kirchenväter von den ur- und frühchristlichen Gruppen der neutestamentlichen Zeit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a179fa74-4e0d-4438-a65b-c263c9c0606d",
                        "source_entry_id": "a1d6d39c-31ec-37fb-8e36-4c401ac51116",
                        "source_sense_id": "502404de-6cda-36ed-b782-0cd1fa5af4d9",
                        "target_lang_word": "Judaism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Judaism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "77c36366-e5e0-337c-8b3e-0ada2a059047",
                                        "entry_id": "cc1a7eb7-7415-3953-8443-4d8b74258cc1",
                                        "glosses": [
                                            "An Abrahamic religion tracing its origin to the Hebrew people of the ancient Middle East, as documented in their religious writings, the Tanakh."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cb17bb7a-ab90-4a90-9b0f-e977ea21cdb0",
                                                "sense_id": "77c36366-e5e0-337c-8b3e-0ada2a059047",
                                                "text": "I am a person of faith, and I am proud of my Judaism, its culture, its traditions and most importantly its belief in the family."
                                            },
                                            {
                                                "example_id": "ce5eba41-7278-4cce-9785-8d43e4dca9be",
                                                "sense_id": "77c36366-e5e0-337c-8b3e-0ada2a059047",
                                                "text": "The resurgence of overt antisemitism has underscored just how limiting the category of race is, said Rabbi Jacob Blumenthal, CEO of the United Synagogue of Conservative Judaism and the Rabbinical Assembly."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c74018bf-aa5f-4760-8a0f-000ba8d81e8b",
                        "source_entry_id": "a1d6d39c-31ec-37fb-8e36-4c401ac51116",
                        "source_sense_id": "502404de-6cda-36ed-b782-0cd1fa5af4d9",
                        "target_lang_word": "judaïsme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "judaïsme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3a54e4fe-4f44-38f3-a1e5-2966fb4d3451",
                                        "entry_id": "a7bbc082-c493-3216-9f9b-1a7d98484b0a",
                                        "glosses": [
                                            "Religion des Juifs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "362f5127-9c31-46b4-8738-ba498180d937",
                                                "sense_id": "3a54e4fe-4f44-38f3-a1e5-2966fb4d3451",
                                                "text": "Pour le judaïsme, chantre de l’Unicité divine, toute dichotomie est entièrement due à la perception humaine, puisque dans l’absolu, toute réalité est obligatoirement Une."
                                            },
                                            {
                                                "example_id": "c7f618af-31fe-460f-b297-0be9a3d52da7",
                                                "sense_id": "3a54e4fe-4f44-38f3-a1e5-2966fb4d3451",
                                                "text": "Nul n’a synthétisé avec autant de netteté les doctrines cardinales du judaïsme pour tenter de les rapprocher de l’enseignement du philosophe stagirite."
                                            },
                                            {
                                                "example_id": "f65ea040-a7d1-4f39-abfb-75ba26c90c23",
                                                "sense_id": "3a54e4fe-4f44-38f3-a1e5-2966fb4d3451",
                                                "text": "Il y a là une sorte de prostitution des valeurs du judaïsme, qui consiste à se servir d’elles comme couverture pour satisfaire des pulsions et des intérêts patriotiques."
                                            },
                                            {
                                                "example_id": "879dc0db-8ed3-4814-b280-0e18d127c330",
                                                "sense_id": "3a54e4fe-4f44-38f3-a1e5-2966fb4d3451",
                                                "text": "Enfin, au sein même du judaïsme, un clivage oppose les orthodoxes et les modérés."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
