                ],
                "senses": [
                    {
                        "sense_id": "0b0e2c38-4a35-3309-803f-831444d8968c",
                        "entry_id": "9606d918-4fed-35bd-af6e-6e54b7803aa9",
                        "glosses": [
                            "hoefdier met twee bulten op de rug Camelus bactrianus"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "574800ca-1010-4dbf-81e0-03302e882424",
                                "sense_id": "0b0e2c38-4a35-3309-803f-831444d8968c",
                                "text": "Volgens mijn eigen onderzoek zijn in het spitsuur drie op de vijf meisjes tussen de veertien en twintig jaar mobiel aan het bellen. Eer kruipt een kemel door het oog van een naald dan dat je ze daar van afbrengt. Er zijn ernstiger zaken aan de orde."
                            },
                            {
                                "example_id": "a1fa6321-a0c8-4b7d-85f1-04e51b05d409",
                                "sense_id": "0b0e2c38-4a35-3309-803f-831444d8968c",
                                "text": "En hij deed Abram goed, om harentwil; zodat hij had schapen, en runderen, en ezelen, en knechten, en maagden, en ezelinnen, en kemelen."
                            }
                        ]
                    },
                    {
                        "sense_id": "90f28e9f-a441-3e1c-bbde-48a461f2492a",
                        "entry_id": "9606d918-4fed-35bd-af6e-6e54b7803aa9",
                        "glosses": [
                            "blunder, flater, een stomme grote fout die je eigenlijk niet had hoeven maken"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "d3766a6d-d07d-4e02-953b-f8586bbaa05c",
                                "sense_id": "90f28e9f-a441-3e1c-bbde-48a461f2492a",
                                "text": "Toen aan de kandidaten gevraagd werd of ze de uitslag van de verkiezingen zouden respecteren, schoot Trump volgens velen een kemel. 'Dat zal ik op dat moment nog wel zien. Ik hou jullie in spanning.'"
                            },
                            {
                                "example_id": "1dad06f8-573c-4d81-9ab6-d49336e352d0",
                                "sense_id": "90f28e9f-a441-3e1c-bbde-48a461f2492a",
                                "text": "Het viel op dat de deelnemers milder waren voor elkaar dan tijdens de afgelopen debatten. De campagne weegt, en iedereen lijkt voorzichtiger te zijn. En op te letten dat ze, zo kort voor 14 oktober, geen kemel schieten of zich niet vergalopperen."
                            },
                            {
                                "example_id": "c980e168-8b8b-4621-953d-a5f8f6c0ab89",
                                "sense_id": "90f28e9f-a441-3e1c-bbde-48a461f2492a",
                                "text": "Stelling: als Willy Vandersteen na de Tweede Wereldoorlog had geweigerd om zijn Suske en Wiskes in het Noord-Nederlands te laten vertalen, spraken we nu allemaal Vlaams en dan wisten we wat spreekdraad was en doddelen, een kemel, ribbediebie, truut en een gekalibreerde kwibus. En dan hoefden we niet zo schaapachtig stom te lachen als het woord goesting, plezant of amaai valt. En is er al eens door middel van een vergelijkend warenonderzoek uitgezocht hoe Nooit meer slapen is vertaald in het Engels, Duits en Frans?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "288bda47-6d69-46ca-a296-fbb6e90fd856",
                        "source_entry_id": "9606d918-4fed-35bd-af6e-6e54b7803aa9",
                        "source_sense_description": "zie ook kameel",
                        "target_lang_word": "camel",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "camel",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dff1c088-9d49-3e16-963c-b74db01fbcd2",
                                        "entry_id": "800b704e-8e4d-32ac-8e13-4b10cc9ea61f",
                                        "glosses": [
                                            "A mammalian beast of burden, much used in desert areas, of the genus Camelus."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15067e89-e6a5-4fd7-956c-bba741d70b75",
                                                "sense_id": "dff1c088-9d49-3e16-963c-b74db01fbcd2",
                                                "text": "Returne our Mules and emptie Camels backe,\nThat we may trauell into Siria, […]"
                                            },
                                            {
                                                "example_id": "fccad1fe-47dc-4072-a7c2-3667344fc276",
                                                "sense_id": "dff1c088-9d49-3e16-963c-b74db01fbcd2",
                                                "text": "Achilles! a drayman, a porter, a very camel."
                                            },
                                            {
                                                "example_id": "1b5ce76d-1977-4ffc-935b-526875d403d3",
                                                "sense_id": "dff1c088-9d49-3e16-963c-b74db01fbcd2",
                                                "text": "As sometimes happens in countries of small civilisation, a leader arose from among the Arabs. None knew from where he sprang, and it was said that he had been a camel driver."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fe7f52ad-214f-3cb1-96ec-960acb426a40",
                                        "entry_id": "800b704e-8e4d-32ac-8e13-4b10cc9ea61f",
                                        "glosses": [
                                            "A light brownish color, like that of a camel (also called camel brown)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "20ec9650-2999-335d-a8e9-87b787b0a3f5",
                                        "entry_id": "800b704e-8e4d-32ac-8e13-4b10cc9ea61f",
                                        "glosses": [
                                            "A vessel or tank, typically paired, used to make an object more buoyant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0d54b05-b211-4131-83f1-7da0a2d9f3d7",
                                                "sense_id": "20ec9650-2999-335d-a8e9-87b787b0a3f5",
                                                "text": "Nantucket Island is probably the only place in the United States where camels were put to work to solve the problem created by a sandbar. They were Marine camels, and like their live namesake, they were of a rugged construction and were designed to do very heavy work. In the shape of two large wooden boxes, the camels were flooded with sea water until they sank to a low level in the water; they were then arranged on each side of a heavily-loaded ship and drawn tightly together around the ship by means of heavy chains passing under the ship's hull. As the sea water was pumped out of the camels, they rose up to a higher level, raising the ship between them, and when fully emptied the camels and the ship were towed across the bar easily and safely because of the lesser draft. First used in Holland as early as 1688, the camels were invented by one M. M. Bakker, who named them for their great strength. The Dutch used them to carry large ships over the Pampas, which was a passage between two sandbanks in the Zyder Zee, opposite the mouth of the River Y, and about six miles from the city of Amsterdam. The Russians adopted the idea and used camels for carrying ships over the shoals at Neva..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "60cd3ad7-22ab-329a-aa50-e718817b09b5",
                                        "entry_id": "800b704e-8e4d-32ac-8e13-4b10cc9ea61f",
                                        "glosses": [
                                            "A person of Middle Eastern origin."
                                        ],
                                        "tags": [
                                            "ethnic",
                                            "slur"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2c3f4dee-1ecc-3a5c-8992-93c8250ffe2d",
                                        "entry_id": "800b704e-8e4d-32ac-8e13-4b10cc9ea61f",
                                        "glosses": [
                                            "A fairy chess piece that is moved three squares in one direction and one at right angles to that direction in a single move, leaping over any intervening pieces."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1759f3b9-e24d-47c7-ae56-b12b6b071b9b",
                                                "sense_id": "2c3f4dee-1ecc-3a5c-8992-93c8250ffe2d",
                                                "text": "The fers and camel can reach all the cells of one colour. The others are more restricted; the dummy cannot move at all, and the commuter can only move back and forth between two cells."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "camel",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "afab3a82-f6e5-3d5c-9e79-a46d28317217",
                                        "entry_id": "8443bfe3-239e-3155-87a3-e0cf67902f4a",
                                        "glosses": [
                                            "Of a light brown color like that of a camel."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1d0394e1-2689-4cf1-b4cc-a1ffd9a0c602",
                                                "sense_id": "afab3a82-f6e5-3d5c-9e79-a46d28317217",
                                                "text": "[…] try to select accessories that are in the same color family as your coat,\" says millinery designer Patricia Underwood. To pick up the weave of a brown tweed jacket, for instance, choose a camel hat and black gloves."
                                            }
