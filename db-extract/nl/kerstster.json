                "forms": [],
                "senses": [
                    {
                        "sense_id": "8cc6dfc2-c2de-3fe5-a0b9-cf4906086d9d",
                        "entry_id": "7642ba09-06c7-387c-91b5-4d78ce13f616",
                        "glosses": [
                            "de ster die volgens het Evangelie van Matteüs (2:2) door de Wijzen uit het oosten opgevat werd als voorteken voor de geboorte van de koning der Joden"
                        ],
                        "tags": [
                            "kerst"
                        ],
                        "examples": [
                            {
                                "example_id": "352ea93f-94ad-4937-83ba-e95eb41530c1",
                                "sense_id": "8cc6dfc2-c2de-3fe5-a0b9-cf4906086d9d",
                                "text": "De Italiaanse schilder Giotto heeft waarschijnlijk de komeet van Halley in 1301 waargenomen, getuige de vorm van de Kerstster boven zijn fresco De aanbidding van de Drie Koningen."
                            }
                        ]
                    }
