                                        "glosses": [
                                            "Escuela filosófica derivada de la teosofía, fundada por Rudolf Steiner a principios del siglo XX."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aee5d94f-6ed0-4c5b-9b19-483b8434ba5b",
                                                "sense_id": "9067eafb-b902-3569-87c5-ec091774419d",
                                                "text": "En 1947 entra en la escuela antroposófica, en Stuttgart (en Michael Ende)."
                                            },
                                            {
                                                "example_id": "259524a1-d7fe-46f5-9220-eb41fedde274",
                                                "sense_id": "9067eafb-b902-3569-87c5-ec091774419d",
                                                "text": "El método de agricultura biodinámico se desarrolla desde 1922, a partir de las indicaciones y consejos dados por el filósofo croata Rudolf Steiner, conocido por su visión del mundo llamada «Antroposofía» o «Ciencia Espiritual» (en Agricultura biodinámica)."
                                            }
                                        ],
