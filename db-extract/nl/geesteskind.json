                "forms": [
                    {
                        "form_id": "fd4f625e-6782-42e6-a479-450d1493de00",
                        "entry_id": "121e98c9-9e61-3fef-9899-cf4d63258d53",
                        "tags": [
                            "plural"
                        ],
                        "form": "geesteskinderen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fccc046f-f694-3825-a8de-2381461a5f6b",
                        "entry_id": "121e98c9-9e61-3fef-9899-cf4d63258d53",
                        "glosses": [
                            "wat iemand bedacht heeft en waar die persoon zich heel erg betrokken bij voelt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fbbdd66b-e6fb-4151-a4fb-f17491137e58",
                                "sense_id": "fccc046f-f694-3825-a8de-2381461a5f6b",
                                "text": "Walt Disney is de geestelijk vader van onder meer Mickey Mouse en Donald Duck, omgekeerd is Donald Duck het kind van Walt Disney.Donald Duck is onder andere ook ontworpen door de Amerikaanse man Ellen Parker ook wel bekend van het Amerikaanse snackbar Wendys"
                            },
                            {
                                "example_id": "bd565ec0-558e-4c88-bf7a-b580c5d46892",
                                "sense_id": "fccc046f-f694-3825-a8de-2381461a5f6b",
                                "text": "Publicis, na het Britse WPP en het Amerikaanse Omnicom het grootste reclamebureau ter wereld, is het geesteskind van de in 1996 overleden oud-verzetsstrijder Marcel Bleustein-Blanchet. In 1926 bedacht hij zijn eerste reclameslogan voor een bevriende meubelfabrikant. Een klassieker uit Bleusteins pen is „Du pain, du vin, du Boursin” (1972)."
                            },
                            {
                                "example_id": "fedf3e91-9e9f-4561-939a-8350246c8f38",
                                "sense_id": "fccc046f-f694-3825-a8de-2381461a5f6b",
                                "text": "Londen krijgt geen tuinbrug. Burgemeester Sadiq Khan vindt de 'Garden Bridge' te duur. Zijn voorganger Boris Johnson had zijn fiat gegeven voor het 200 miljoen pond (237 miljoen euro) kostende geesteskind van actrice Joanna Lumley. Er was een tekort van 70 miljoen pond ontstaan. De Brugstichting bleek grote moeite te hebben om geld los te peuteren bij het bedrijfsleven en Khan vindt dat overheidsgeld beter kan worden besteed."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "068cd648-97d0-4552-92ad-49e6fd636272",
                        "source_entry_id": "121e98c9-9e61-3fef-9899-cf4d63258d53",
                        "source_sense_id": "fccc046f-f694-3825-a8de-2381461a5f6b",
                        "source_sense_description": "wat iemand bedacht heeft en waar die persoon zich heel erg betrokken bij voelt",
                        "target_lang_word": "brainchild",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "brainchild",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c1f92b3e-7cc6-33a3-a28b-f67b602e9b7f",
                                        "entry_id": "601671d7-ef98-350a-9fbf-7a3e4e5f73b4",
                                        "glosses": [
                                            "A creation of one's brain; an original idea or innovation of a person or group of people, an organization, etc."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b332b336-0e9a-4450-8984-1bcab3d424a7",
                                                "sense_id": "c1f92b3e-7cc6-33a3-a28b-f67b602e9b7f",
                                                "text": "The entire project was the brainchild of a small group of visionaries."
                                            },
                                            {
                                                "example_id": "2660976a-841d-422b-905b-0ee176cdefb9",
                                                "sense_id": "c1f92b3e-7cc6-33a3-a28b-f67b602e9b7f",
                                                "text": "A brayne-child o' mine ovvne! and I am proud on't!"
                                            },
                                            {
                                                "example_id": "49dd392e-2bdf-4679-b56e-5251b8c7645e",
                                                "sense_id": "c1f92b3e-7cc6-33a3-a28b-f67b602e9b7f",
                                                "text": "I am glad you find so many lovers of your brain children in the West, although I knew it would be so."
                                            },
                                            {
                                                "example_id": "805fe3b5-f9b9-41ff-8c21-e58b905e64f0",
                                                "sense_id": "c1f92b3e-7cc6-33a3-a28b-f67b602e9b7f",
                                                "text": "Then, gradually, the almost maternal yearning to see his brain-child [a play] once more, which can never be wholly crushed out of a young dramatist, returned to him—faintly at first, then getting stronger by degrees till it could no longer be resisted. True, he knew that when he beheld it, the offspring of his brain would have been mangled almost out of recognition, but that did not deter him."
                                            },
                                            {
                                                "example_id": "51da0038-c367-4f16-aa07-6031b9d00615",
                                                "sense_id": "c1f92b3e-7cc6-33a3-a28b-f67b602e9b7f",
                                                "text": "Inspiration's old lady gave birth to a new brainchild one afternoon at a Rhythm Kings rehearsal, when I took a few choruses on Jack Pettis' C-melody sax while he was out humoring his bladder."
                                            },
                                            {
                                                "example_id": "d85b4bac-8c20-4fbf-bc22-9de337ac2df2",
                                                "sense_id": "c1f92b3e-7cc6-33a3-a28b-f67b602e9b7f",
                                                "text": "We had these people for years and years, such as Mr. [Robert] McNamara and all of his brainchilds, come up here, and he said everything is going to work out fine and everybody followed him. Look what a mess we got into in Southeast Asia."
                                            },
                                            {
                                                "example_id": "943bacc4-98ba-442a-a547-126d1f2eb7c1",
                                                "sense_id": "c1f92b3e-7cc6-33a3-a28b-f67b602e9b7f",
                                                "text": "Not only all your children and your children’s children, but all your brainchildren and your brainchildren’s brainchildren must grow from the common stock of Design elements, genes and memes, that have so far been accumulated and conserved by the inexorable lifting algorithms, the ramps and cranes and cranes-atop-cranes of natural selection and its products."
                                            },
                                            {
                                                "example_id": "fb7dbd4c-96fe-4997-bf6f-9bfbcd8d2fe3",
                                                "sense_id": "c1f92b3e-7cc6-33a3-a28b-f67b602e9b7f",
                                                "text": "Recent health 'movements' such as the Child Survival Development Revolution and Universal Childhood Immunization, are all brainchilds of international or (Western) national aid institutions."
                                            },
                                            {
                                                "example_id": "6bd2fb59-55b9-4515-b1eb-a75fc1ebdef1",
                                                "sense_id": "c1f92b3e-7cc6-33a3-a28b-f67b602e9b7f",
                                                "text": "Electricity powers all the sensors (cameras, microphones, accelerometers, radio receivers, collision detectors, etc.) and effectors (motors, solenoids, switches) of our robotic artifacts, and even if these brainchildren of ours can be made to live off sunlight (or plutonium), they will need batteries to store that energy until it is required."
                                            },
                                            {
                                                "example_id": "eb5b4bb2-6cb4-4c2c-8c9b-50c093a85e4e",
                                                "sense_id": "c1f92b3e-7cc6-33a3-a28b-f67b602e9b7f",
                                                "text": "But even though the Pleven Plan was the brainchild of a French prime minister, public debate had revealed the extent of French reluctance to countenance German rearmament under any conditions."
                                            },
                                            {
                                                "example_id": "6194b2b5-968d-4df8-acbd-39e0ca80025a",
                                                "sense_id": "c1f92b3e-7cc6-33a3-a28b-f67b602e9b7f",
                                                "text": "At the extreme end of the promenade, backing on to the river, was a small funfair. Edward had informed us earlier that this had been in existence since 1929 and had been one of the very early brainchilds of Sir Billy Butlin."
                                            },
                                            {
                                                "example_id": "6aa801e1-0186-44fd-8bc5-9de718cc5b29",
                                                "sense_id": "c1f92b3e-7cc6-33a3-a28b-f67b602e9b7f",
                                                "text": "The Everlasting Gobstopper, a jawbreaker that changes colors and flavors, was the brainchild of Roald Dahl in Charlie and the Chocolate Factory in 1964. They were intended as poor kids candy since they magically kept regenerating, no matter how long you sucked on them."
                                            },
                                            {
                                                "example_id": "6b6fd67a-0e35-4eac-b8d8-41128f95a7e8",
                                                "sense_id": "c1f92b3e-7cc6-33a3-a28b-f67b602e9b7f",
                                                "text": "Their joint cost is £54 million, and the scheme is the brainchild of the West Midlands Combined Authority."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "brainchild",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2ed780eb-27a0-3c8e-b688-dedce36c5612",
                                        "entry_id": "f0668ad2-75c5-3f0e-80af-ebccf84d98f8",
                                        "glosses": [
                                            "To think up (an idea or innovation); to come up with."
                                        ],
                                        "tags": [
                                            "rare",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dd3e2a8c-1073-4d38-93dc-ec2c3b67586d",
                                                "sense_id": "2ed780eb-27a0-3c8e-b688-dedce36c5612",
                                                "text": "John Law brainchilded the establishment of a national bank to expedite and secure the creation of credit."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
