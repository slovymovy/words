                        "form": "die Luftlinie"
                    },
                    {
                        "form_id": "c0183e43-76ff-46b2-9f24-1298c2f8602a",
                        "entry_id": "d6139321-7eff-34a0-bf60-9372b6657ce6",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Luftlinien"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "84a1bc87-bf97-35f3-b8ee-290f1443491a",
                        "entry_id": "d6139321-7eff-34a0-bf60-9372b6657ce6",
                        "glosses": [
                            "gedachte Linie; kürzeste Entfernung zwischen zwei Orten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc96a662-0b41-42a9-b07a-90bdc62cac80",
                                "sense_id": "84a1bc87-bf97-35f3-b8ee-290f1443491a",
                                "text": "Die Entfernung beträgt nur 300 m Luftlinie."
                            },
                            {
                                "example_id": "26782eb7-bc1c-4895-9b96-51653848b127",
                                "sense_id": "84a1bc87-bf97-35f3-b8ee-290f1443491a",
                                "text": "„750 Kilometer Luftlinie trennen die beiden Orte, die Reise birgt viele Gefahren, und so engagiert Tobit, der Vater des Tobias, den Mann Asarja als Reisebegleiter.“"
                            },
                            {
                                "example_id": "73d1daeb-60e8-4de2-b8d5-e760fa665725",
                                "sense_id": "84a1bc87-bf97-35f3-b8ee-290f1443491a",
                                "text": "„Vom Kallisaw-Sund zum Rainbow-Fishing-Camp sind's bloß anderthalb Meilen, das heißt, in der Luftlinie.“"
                            },
                            {
                                "example_id": "fdf1f0be-cb10-4641-ac79-0131caa6f8eb",
                                "sense_id": "84a1bc87-bf97-35f3-b8ee-290f1443491a",
                                "text": "„Die ganze Grenze war abgeriegelt, selbst hier im Nirgendwo, 15 Kilometer Luftlinie vom offiziellen Grenzübergang entfernt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "cb19b3b7-049b-368d-9e62-3ce7d6c5161b",
                        "entry_id": "d6139321-7eff-34a0-bf60-9372b6657ce6",
                        "glosses": [
                            "Unternehmen, das Flugverkehr betreibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "21d4f3b1-5ab3-45b4-a7c5-7f14ac1451f0",
                                "sense_id": "cb19b3b7-049b-368d-9e62-3ce7d6c5161b",
                                "text": "„Der Aufsichtsrat der Luftlinie hat das neue Konzept für Eurowings genehmigt.“"
                            },
                            {
                                "example_id": "3783b45e-1eae-412e-9291-ad8c304a7b55",
                                "sense_id": "cb19b3b7-049b-368d-9e62-3ce7d6c5161b",
                                "text": "„Am Flughafen Düsseldorf sind am Dienstag mehr als zwei Dutzend Flüge der Luftlinie Eurowings am Boden geblieben.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5ddc9d43-cef7-4eca-9623-83c256439d6f",
                        "source_entry_id": "d6139321-7eff-34a0-bf60-9372b6657ce6",
                        "source_sense_id": "84a1bc87-bf97-35f3-b8ee-290f1443491a",
                        "source_sense_description": "gedachte Linie; kürzeste Entfernung zwischen zwei Orten",
                        "target_lang_word": "beeline",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "beeline",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6dad0b8a-6ccf-3637-8f1d-04ea025ec054",
                                        "entry_id": "cf663b4b-3915-3c91-8b61-f015c0a9c6e1",
                                        "glosses": [
                                            "A very direct or quick path or trip."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3242090a-3a73-4076-9ece-6ae624d4883f",
                                                "sense_id": "6dad0b8a-6ccf-3637-8f1d-04ea025ec054",
                                                "text": "to make / strike a beeline for / to something"
                                            },
                                            {
                                                "example_id": "b56e3d42-4f60-4ff4-aa15-84c36d39180d",
                                                "sense_id": "6dad0b8a-6ccf-3637-8f1d-04ea025ec054",
                                                "text": "The children made a beeline to the swimming pool."
                                            },
                                            {
                                                "example_id": "b4880828-087e-4248-8712-7f1d8c7daa3b",
                                                "sense_id": "6dad0b8a-6ccf-3637-8f1d-04ea025ec054",
                                                "text": "Discussing these and kindred topics they made a beeline across the back of the Customhouse and passed under the Loop Line bridge where a brazier of coke burning in front of a sentrybox or something like one attracted their rather lagging footsteps."
                                            },
                                            {
                                                "example_id": "d61a4850-3295-48b2-b95a-06ad609e54b0",
                                                "sense_id": "6dad0b8a-6ccf-3637-8f1d-04ea025ec054",
                                                "text": "Hershie made a beeline for Thomas's table, not making eye-contact with the others — old-guard activists who still saw him as a tool of the war-machine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9b0a3a12-d372-3ba1-a573-ea851d36f982",
                                        "entry_id": "cf663b4b-3915-3c91-8b61-f015c0a9c6e1",
                                        "glosses": [
                                            "A dynamite fuse made with a small quantity of dynamite powder along its length, so that the spark travels quickly and at a specific known rate."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "beeline",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dc288a02-950e-3f82-915a-6b2aa241af07",
                                        "entry_id": "087ce473-8323-302b-9048-67bd9290bfc5",
                                        "glosses": [
                                            "To travel in a straight line, ignoring established paths of travel."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "57d34d6f-6bdf-4c7d-8d82-259d02d5b1ed",
                                                "sense_id": "dc288a02-950e-3f82-915a-6b2aa241af07",
                                                "text": "A uniformed policeman came off the elevator and beelined for the nurse's station. I beelined into the stairwell. I wasn't in the mood for chatting with the police."
                                            },
                                            {
                                                "example_id": "2420bc08-5ed7-40da-a9e7-079329186509",
                                                "sense_id": "dc288a02-950e-3f82-915a-6b2aa241af07",
                                                "text": "Suddenly, a woman beelines to the president, climbs to join him on his platform, there’s no security around to stop her and leans in for a kiss."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0683bdd8-70de-4e05-bec3-59f70680073b",
                        "source_entry_id": "d6139321-7eff-34a0-bf60-9372b6657ce6",
                        "source_sense_id": "84a1bc87-bf97-35f3-b8ee-290f1443491a",
                        "source_sense_description": "gedachte Linie; kürzeste Entfernung zwischen zwei Orten",
                        "target_lang_word": "as the crow flies",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "as the crow flies",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "688f1fb1-3445-3d28-9158-ad29a99fd789",
                                        "entry_id": "8f425ce2-f18f-34fd-913a-c37add1faeb0",
                                        "glosses": [
                                            "In a straight line distance between two locations, as opposed to the road distance or over land distance."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f2e47f06-65b1-4c3e-b92f-bb7f9b1ab3c2",
                                                "sense_id": "688f1fb1-3445-3d28-9158-ad29a99fd789",
                                                "text": "ʽFire,ʼ said Bill, ʽin the form of a common cowshed, is burnin' about nor'-nor'-east as the crow flies.ʼ"
                                            },
                                            {
                                                "example_id": "49d951a4-0cfd-4306-b442-b4f51f3a3452",
                                                "sense_id": "688f1fb1-3445-3d28-9158-ad29a99fd789",
                                                "text": "It is 15 kilometers as the crow flies."
                                            },
                                            {
                                                "example_id": "143f1a61-143f-4e0a-b487-31194b2c47be",
                                                "sense_id": "688f1fb1-3445-3d28-9158-ad29a99fd789",
                                                "text": "The distance from Sarajevo to Ploce is 75 miles as the crow flies, but because of the difficult terrain the new line is 120 miles long."
                                            },
                                            {
                                                "example_id": "5b75002c-5af4-4015-97e4-d94a00c8b761",
                                                "sense_id": "688f1fb1-3445-3d28-9158-ad29a99fd789",
                                                "text": "Then it told me the distance between the two is 331 miles, which is totally irrelevant as that's as the crow flies and not the 393 miles of the rail route."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
