                ],
                "senses": [
                    {
                        "sense_id": "a382e16b-e063-3f85-89c0-fd42375453b7",
                        "entry_id": "706118dc-d224-3aba-9542-0d65b256d172",
                        "glosses": [
                            "bauliche Vorrichtung zur gezielten Be- und/oder Entlüftung eines Raumes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "937d10f0-158c-4de1-ae03-d2c4fc89b7c6",
                                "sense_id": "a382e16b-e063-3f85-89c0-fd42375453b7",
                                "text": "„Soweit technische Lüftungseinrichtungen notwendigerweise installiert sind, müssen diese vor Inbetriebnahme der Verbrauchseinrichtungen in Funktion gesetzt werden.“"
                            },
                            {
                                "example_id": "e8bb3371-e6c1-4be4-9a40-7c7527b439c5",
                                "sense_id": "a382e16b-e063-3f85-89c0-fd42375453b7",
                                "text": "„Trotz der Bedeutung des Fensters als Lüftungseinrichtung werden Konstruktion und Öffnungsart meist weniger von optimalen Lüftungseigenschaften als von anderen Gesichtspunkten wie Standort des Gebäudes, Klima, Wirtschaftlichkeit, Sicherheitsdenken und gestalterischen Trends bestimmt.“"
                            },
                            {
                                "example_id": "cf46813d-0423-419c-bb91-53c254c1fabc",
                                "sense_id": "a382e16b-e063-3f85-89c0-fd42375453b7",
                                "text": "„Es ist zu vermuten, daß in unterschiedliche Lüftungskonzeptionen eingebundene dezentrale Lüftungseinrichtungen prinzipbedingt auch einer unterschiedlichen Beeinflussung durch den Wind unterliegen.“"
                            },
                            {
                                "example_id": "038e4963-7708-47d4-9657-5993b36951bd",
                                "sense_id": "a382e16b-e063-3f85-89c0-fd42375453b7",
                                "text": "„Für diesen Fall werden technische Lösungsmöglichkeiten zur Planung, Konstruktion und Ausführung von Lüftungseinrichtungen aufgestellt, die sicherstellen, dass in derartigen Verkaufsstätten Bedingungen einer räumlichen Abtrennung erreicht werden, die den lebensmittelhygienischen Vorschriften entsprechen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
