                                "target_senses": [
                                    {
                                        "sense_id": "f01377ce-34aa-3a43-9f60-6240489bd971",
                                        "entry_id": "a05f7726-6d88-338f-b757-914e4f624b94",
                                        "glosses": [
                                            "Clipping of costermonger."
                                        ],
                                        "tags": [
