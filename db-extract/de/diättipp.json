                "senses": [
                    {
                        "sense_id": "efd6003e-71b3-37cc-9470-55602db08e22",
                        "entry_id": "1f480bcf-377f-36a9-a42c-ff6a36d9a785",
                        "glosses": [
                            "Ratschlag (Tipp) über eine Ernährung, bei der man Gewicht verlieren soll (Diät)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "77bb5502-b4bc-467a-a2af-b058eb823d1c",
                                "sense_id": "efd6003e-71b3-37cc-9470-55602db08e22",
                                "text": "„Die Tagesschau lieferte den neuesten Diättipp mit der Headline „Bildung macht schlank“ gleich mit.“"
                            },
                            {
                                "example_id": "31f35e28-56ea-46ee-a2c7-07fac6b546b9",
                                "sense_id": "efd6003e-71b3-37cc-9470-55602db08e22",
                                "text": "„Ein Diättipp: Zwei Wochen lang bei jeder Hauptmahlzeit etwa 200 Gramm Spargel essen und dafür auf Fleisch verzichten.“"
                            },
                            {
                                "example_id": "9b7b6186-e9fb-4dc9-af40-2cca0608ecaf",
                                "sense_id": "efd6003e-71b3-37cc-9470-55602db08e22",
                                "text": "„Hier sind einige unserer bewährten Diättipps fürs College und später, die wirklich funktionieren: Wenn Sie mit den unbegrenzten Portionen und der Essensauswahl in der Mensa überfordert sind, essen Sie einfach nicht mehr dort.“"
                            },
                            {
                                "example_id": "994425db-6335-4e98-b04c-2d201a412b33",
                                "sense_id": "efd6003e-71b3-37cc-9470-55602db08e22",
                                "text": "„Hast du alle Diättipps beachtet und der Erfolg ist nicht gleich so, wie du es dir vorgestellt hast?“"
                            },
                            {
                                "example_id": "fef1f2b7-6eea-4269-8a69-cfb4dea7341e",
                                "sense_id": "efd6003e-71b3-37cc-9470-55602db08e22",
                                "text": "„Okay, mein schlechtes Gewissen plagt mich, also gibt es jetzt einen, aber auch nur einen Diättipp, take it or leave it!“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
