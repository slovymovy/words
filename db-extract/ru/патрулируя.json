                                        "sense_id": "280c394e-fffd-3874-bd9f-634f51ed1fed",
                                        "entry_id": "63edf540-afe7-3c65-802e-55b2c67e6e46",
                                        "glosses": [
                                            "The act of going on patrol."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "439d700e-1ac8-438a-9f14-306f5e37570e",
                                                "sense_id": "280c394e-fffd-3874-bd9f-634f51ed1fed",
                                                "text": "The remainder of our patrollings simply consisted of journeying up and down the enemy coast looking for anything that may appear."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5a0c13ff-66f4-4c32-897d-f352f6bf3316",
                        "source_entry_id": "25b34ed0-0cf2-3450-9bfe-22b0a977dae8",
                        "source_sense_id": "7b1381bf-35c1-3fb1-af3a-11bba4d2a2e5",
                        "target_lang_word": "patrouillieren",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "patrouillieren",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ff2cb991-bda1-3a23-97ff-527c9832a993",
                                        "entry_id": "dae1a9c0-8e0c-3d76-9be9-fb29d383ab38",
                                        "glosses": [
                                            "als Posten (einer Polizei, eines Militärs, eines sonstigen Sicherheitsorgans sowie einer Bürgerwehr, Miliz oder dergleichen) in einem bestimmten Gebiet regelmäßige Erkundungs- und/oder Kontrollgänge oder -fahrten durchführen"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cdbfa0ab-671b-4c7f-a905-dff7848d89be",
                                                "sense_id": "ff2cb991-bda1-3a23-97ff-527c9832a993",
                                                "text": "Der Wachposten patrouillierte durch die Stadt."
                                            },
                                            {
                                                "example_id": "3337b3a7-1d80-4fd4-a5a3-1f9e8cdb8c19",
                                                "sense_id": "ff2cb991-bda1-3a23-97ff-527c9832a993",
                                                "text": "„Vielleicht eine halbe Stunde lang patrouillierten wir auf einem kurzen Stück Weg, um die Stelle herauszufinden, an der das Geräusch des Wassers am deutlichsten zu hören war.“"
                                            },
                                            {
                                                "example_id": "8b5fb32e-a1f3-415a-b797-3f39a46a1229",
                                                "sense_id": "ff2cb991-bda1-3a23-97ff-527c9832a993",
                                                "text": "„Die Polizei- und Militärhubschrauber patrouillieren mit besonderer Häufigkeit über der Küste.“"
                                            },
                                            {
                                                "example_id": "fc88c75c-f2ae-401e-84df-e0ce25d29844",
                                                "sense_id": "ff2cb991-bda1-3a23-97ff-527c9832a993",
                                                "text": "„Deutsche Truppen stehen am Hindukusch, patrouillieren am Horn von Afrika, im Sudan, auf dem Balkan und vor der libanesischen Küste.“"
                                            },
                                            {
                                                "example_id": "de18b004-7b90-49c8-9a6e-25bdb9b5d072",
                                                "sense_id": "ff2cb991-bda1-3a23-97ff-527c9832a993",
                                                "text": "„Im Grunde bekomme ich sie seltener zu Gesicht als den Fuchs, der nachts über das Gelände patrouilliert.“"
                                            },
                                            {
                                                "example_id": "5c0cf57e-4bee-47d4-849a-2f8348adc0d4",
                                                "sense_id": "ff2cb991-bda1-3a23-97ff-527c9832a993",
                                                "text": "„Jede Menge Polizisten und Sicherheitsbeamte patrouillierten auf dem Gelände, denn die Ehrentitel wurden vom Kanzler der Universität überreicht, und dieser Kanzler war Prinz Philipp, der Herzog von Edinburgh.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d78df51a-3eb2-3706-b95a-8609da423961",
                                        "entry_id": "dae1a9c0-8e0c-3d76-9be9-fb29d383ab38",
                                        "glosses": [
                                            "auf- und abgehen, als der Straßenprostitution nachgehende weibliche Person"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "88280db7-69f2-49ce-afae-52ead21a5c30",
                                                "sense_id": "d78df51a-3eb2-3706-b95a-8609da423961",
                                                "text": "„Die Topographie der Berliner Prostitution ist damit noch nicht vollendet. In den Nebenstraßen trifft man die Reglementierten aller Gruppen, für die der Hauptstrich verboten ist.[…]Sie sind fast in allen Gegenden der Stadt, sie patrouillieren die Hauptzufuhrstraßen bis nach Steglitz, Neukölln, Westend, Lichtenberg usw. hinaus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
