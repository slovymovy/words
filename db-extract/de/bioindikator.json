                                "example_id": "88d04405-4329-4f7e-b490-76d22239d402",
                                "sense_id": "9ed1afb6-e078-3349-a15d-f478c5d693e8",
                                "text": "Flechten sind klassische Bioindikatoren, die auf eine saubere Luft hinweisen."
                            },
                            {
