                    "semantic_group_id": "animal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>gaper</w> graaft zich diep in het zand van de zeebodem.",
                            "target_lang_translations": {
                                "en": "The <w>gaper clam</w> burrows deep into the sand of the seabed."
                            }
