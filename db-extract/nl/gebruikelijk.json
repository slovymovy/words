                        "sense_id": "b94f5be2-fc65-3a9f-81f9-80efd51b9dfb",
                        "entry_id": "d46c583b-a9a5-330c-bc61-6779fd7b8d33",
                        "glosses": [
                            "naar gewoonte, zoals men regelmatig doet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "baac1390-0111-4265-8f84-6e44f0d78e1f",
                                "sense_id": "b94f5be2-fc65-3a9f-81f9-80efd51b9dfb",
                                "text": "De gebruikelijkste wijze van optreden in zo'n geval is zich snel te verontschuldigen."
                            },
                            {
                                "example_id": "15651a22-fef1-4242-b5be-c7bbac5ba796",
                                "sense_id": "b94f5be2-fc65-3a9f-81f9-80efd51b9dfb",
                                "text": "Rijke en belastingschuwe politieke vluchtelingen hebben namelijk een voor deze groep karakteristiek probleem, dat verder niet zo gebruikelijk is onder politieke vluchtelingen."
                            }
                        ]
                    }
                ],
