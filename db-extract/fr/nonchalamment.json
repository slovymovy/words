        "fr-extract.jsonl": [
            {
                "entry_id": "f5fb7730-9e0a-3a6f-947d-72a200748e27",
                "word": "nonchalamment",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "cb0f0b74-14b1-3267-a484-1c32104e41ef",
                        "entry_id": "f5fb7730-9e0a-3a6f-947d-72a200748e27",
                        "glosses": [
                            "D’une manière nonchalante."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3775aa2e-2f26-4a0a-982b-679f0563269b",
                                "sense_id": "cb0f0b74-14b1-3267-a484-1c32104e41ef",
                                "text": "Tous les hommes, […], écoutaient nonchalamment, sans y prêter grande attention, un mauvais phonographe, aux accents métalliques. Du pavillon sonore sortaient des paroles qui serrèrent le cœur de Bert d’une angoisse nostalgique […]."
                            },
                            {
                                "example_id": "b2b2f901-4aa4-4d6a-b9d1-653eb3630fa0",
                                "sense_id": "cb0f0b74-14b1-3267-a484-1c32104e41ef",
                                "text": "Lorsqu'on entend les prédicateurs, je ne sais quelle accoutumance malheureuse de recevoir par leur entremise la parole de l’Évangile fait qu’on l’écoute de leur bouche plus nonchalamment."
                            }
                        ]
                    },
                    {
                        "sense_id": "2170ed64-0cc7-31d2-b346-5697280fe818",
                        "entry_id": "f5fb7730-9e0a-3a6f-947d-72a200748e27",
                        "glosses": [
                            "Mollement, avec abandon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b25fe458-7ebb-4f06-bcb6-454d1b5f6c37",
                                "sense_id": "2170ed64-0cc7-31d2-b346-5697280fe818",
                                "text": "Celle-ci s’exprime nonchalamment et d’un air distrait, afin qu’on croie qu’elle n'a presque pas besoin de prendre la peine de penser, et que tout ce qu’elle dit lui échappe."
                            },
                            {
                                "example_id": "7e6e63b1-0993-415b-98d6-c89c1536892e",
                                "sense_id": "2170ed64-0cc7-31d2-b346-5697280fe818",
                                "text": "Pour premier mot et pour toute réponse, Nonchalamment, et d’un air de dédain, Mon gars répond avec un ton faquin […]"
                            },
                            {
                                "example_id": "4f4a8f43-0117-42e3-907c-4977f137cd11",
                                "sense_id": "2170ed64-0cc7-31d2-b346-5697280fe818",
                                "text": "Errer nonchalamment dans les bois et dans la campagne, prendre machinalement çà et là, tantôt une fleur, tantôt un rameau, brouter mon foin presque au hasard, observer mille et mille fois les mêmes choses, et toujours avec le même intérêt, parce que je les oubliais toujours, était de quoi passer l’éternité sans pouvoir m’ennuyer un moment."
                            },
                            {
                                "example_id": "8412b7e0-b94b-4b30-a1d1-ef04d0423b24",
                                "sense_id": "2170ed64-0cc7-31d2-b346-5697280fe818",
                                "text": "Notre-Dame d'Atocha, protégez-nous! s'écriaient les brunes Andalouses nonchalamment bercées au pas de leurs mules."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "48f5c98c-48c0-4b41-9800-d40b8e10ff7f",
                        "source_entry_id": "f5fb7730-9e0a-3a6f-947d-72a200748e27",
                        "target_lang_word": "carelessly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "carelessly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "62a1532e-d3af-3548-aaf0-683c5e8d1aba",
                                        "entry_id": "1a6758ef-f5a8-3be1-98f2-60ca27a7467b",
                                        "glosses": [
                                            "Giving the appearance of carelessness; relaxedly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be8156b1-f80e-4106-a27e-65fb7b5b85c6",
                                                "sense_id": "62a1532e-d3af-3548-aaf0-683c5e8d1aba",
                                                "text": "The papers were carelessly strewn on the table."
                                            },
                                            {
                                                "example_id": "c1542fe3-8aa4-46b6-abb7-4b3840f404e0",
                                                "sense_id": "62a1532e-d3af-3548-aaf0-683c5e8d1aba",
                                                "text": "Let us try to imagine the qualms of some Fifth Avenue florist if he could but see so many potential boutonnières, at a dollar apiece, so carelessly heaped up in baskets, lining the dingy pavement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "933ce3df-1f32-3079-ac82-c5cbbba8d48e",
                                        "entry_id": "1a6758ef-f5a8-3be1-98f2-60ca27a7467b",
                                        "glosses": [
                                            "Done without care or attention; inattentively."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4cd05c4-3647-4311-b5dc-962173fd5149",
                                                "sense_id": "933ce3df-1f32-3079-ac82-c5cbbba8d48e",
                                                "text": "Distracted by the salesperson, he carelessly read the contract."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "621687ee-5a65-4936-af7c-c10e28661c22",
                        "source_entry_id": "f5fb7730-9e0a-3a6f-947d-72a200748e27",
                        "target_lang_word": "casually",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "casually",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fea4d285-a983-3e23-9967-ec4e6d2705b2",
                                        "entry_id": "610a2907-2a61-3bfd-a20e-c7ecedcaa571",
                                        "glosses": [
                                            "In a casual manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "708e7548-5f42-4614-adf8-dab1f3d2ec1f",
                                                "sense_id": "fea4d285-a983-3e23-9967-ec4e6d2705b2",
                                                "text": "A small minority, mainly strangers, would look long at her in casually passing by, and grow momentarily fascinated by her freshness, and wonder if they would ever see her again: but to almost everybody she was a fine and picturesque country girl, and no more."
                                            },
                                            {
                                                "example_id": "8792bb94-145f-4c60-9127-c45234507751",
                                                "sense_id": "fea4d285-a983-3e23-9967-ec4e6d2705b2",
                                                "text": "\"A fine man, that Dunwody, yonder,\" commented the young captain, as they parted, and as he turned to his prisoner. \"We'll see him on in Washington some day.[…]A strong man—a strong one; and a heedless.\" ¶ \"Of what party is he?\" she inquired, as though casually."
                                            },
                                            {
                                                "example_id": "fd649d6e-0ee1-49f0-b2a3-a04cb9a53519",
                                                "sense_id": "fea4d285-a983-3e23-9967-ec4e6d2705b2",
                                                "text": "The detective kept them in view. He made his way casually along the inside of the shelter until he reached an open scuttle close to where the two men were standing talking. Eavesdropping was not a thing Larard would have practised from choice, but there were times when, in the public interest, he had to do it, and this was one of them."
                                            },
                                            {
                                                "example_id": "02902476-5026-4540-bbbf-63790e1a359b",
                                                "sense_id": "fea4d285-a983-3e23-9967-ec4e6d2705b2",
                                                "text": "He wore his strange and colourful clothes as if for inspection by a lesser being: condescendingly, casually."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a4f3bf3a-2c84-4ebd-9cf5-35d07babbe0a",
                        "source_entry_id": "f5fb7730-9e0a-3a6f-947d-72a200748e27",
                        "target_lang_word": "nonchalantly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nonchalantly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5b2922ea-68c1-3f0f-9198-e8846ae1b47d",
                                        "entry_id": "87f1f425-a3ba-3ddf-ab7d-bd6403d4dc98",
                                        "glosses": [
                                            "In a nonchalant manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aee3491d-2f27-4b36-a5cc-9fe67408276a",
                                                "sense_id": "5b2922ea-68c1-3f0f-9198-e8846ae1b47d",
                                                "text": "Smoke a gold leaf, I hold heat nonchalantly"
                                            },
                                            {
                                                "example_id": "852d4d57-8d97-4fea-a9a9-86afea25821e",
                                                "sense_id": "5b2922ea-68c1-3f0f-9198-e8846ae1b47d",
                                                "text": "I'm sure the Brunel-designed stone-built structure would have had a hatstand for his trademark stovepipe. I can picture him rocking up there of a morning and lobbing it nonchalantly onto the hatstand."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3005d68c-a925-40ad-ad65-5610d37bcabf",
                        "source_entry_id": "f5fb7730-9e0a-3a6f-947d-72a200748e27",
