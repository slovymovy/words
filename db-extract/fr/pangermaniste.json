                        "entry_id": "37e82ecd-8bc5-3dc4-b9b9-3ccf3215009a",
                        "glosses": [
                            "Personne qui défend le pangermanisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "38d65cb7-c502-4fd4-944f-740c4501eec8",
                                "sense_id": "a50cf967-856b-3a52-bd7c-b105f7419ba3",
                                "text": "Loin d’être un pangermaniste belliqueux, Nietzsche revient des hostilités convaincu que la fraternité des armes et la grandeur nationale sont des artifices de propagande."
                            },
                            {
                                "example_id": "3897b49a-1cfb-44b6-9b4c-e9c00184b1f9",
                                "sense_id": "a50cf967-856b-3a52-bd7c-b105f7419ba3",
                                "text": "Les pangermanistes représentent la fraction de la bourgeoisie, libérale initialement, qui n'est pas liée à l'ouverture vers le sud-est de l'Europe.."
                            }
                        ]
                    }
