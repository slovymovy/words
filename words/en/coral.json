                        "zh": [
                            {
                                "target_lang_word": "科拉尔",
                                "target_lang_sense_clarification": "美国伊利诺伊州的地名"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6ef56f6a-ebe8-3ca3-958c-aaf760b78224",
                    "sense_definition": "Obsolete spelling of <w>corral</w>.",
