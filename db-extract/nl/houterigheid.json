                        "examples": [
                            {
                                "example_id": "efd01030-d5ec-4b65-a52b-31315cbb0729",
                                "sense_id": "f11d6824-789e-39a0-9dd0-6130133b2c85",
                                "text": "Houterigheid genoeg, simpele bewegingen en kleine gebaren werden meteen onhandig en stijf zodra er iemand die niet bij de repetities aanwezig was geweest de zaal binnenkwam met een berichtje voor mij of om iets klaar te zetten voor de première."
                            },
                            {
                                "example_id": "f4b6d319-efca-4375-87f1-e44730eb64ea",
                                "sense_id": "f11d6824-789e-39a0-9dd0-6130133b2c85",
                                "text": "Met haar robotachtige voorkomen dreven de media de spot. De Maybot, werd haar bijnaam. Helemaal toen ze in al haar houterigheid bij haar bezoek aan Zuid-Afrika en Kenia een poging deed om mee te dansen tijdens haar ontvangstceremonie."
                            }
                        ]
                    }
                ],
                "translations": [
