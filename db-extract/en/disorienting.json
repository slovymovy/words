                        "sense_id": "f5eed75b-b3bf-363f-8ca9-bfd9b88a4bb4",
                        "entry_id": "121941d3-9db6-3eed-95c7-f9da2f44d368",
                        "glosses": [
                            "That causes disorientation; confusing."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "524a3ec0-d370-4c3f-9c75-d7c00c7688a1",
                                "sense_id": "f5eed75b-b3bf-363f-8ca9-bfd9b88a4bb4",
                                "text": "But as you begin to take all the different perspectives into account, it gets very dizzifying, very aperspectival, very disorienting."
                            },
                            {
                                "example_id": "47a29214-0a2b-4c1d-b698-47f4d53e5ec2",
                                "sense_id": "f5eed75b-b3bf-363f-8ca9-bfd9b88a4bb4",
                                "text": "There are few experiences more disorienting than hearing the words, “You have cancer.”"
                            },
                            {
                                "example_id": "9f136684-355d-47f2-8ad9-58802ed82144",
                                "sense_id": "f5eed75b-b3bf-363f-8ca9-bfd9b88a4bb4",
                                "text": "Disorienting dilemmas can be small, like having to find your way around a strange city when your GPS isn't working, or they can be large, such as facing life-changing events like the loss of a job or a serious health or relationship problem."
                            }
                        ]
                    }
