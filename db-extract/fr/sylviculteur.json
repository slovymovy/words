                        "entry_id": "d3007a7e-92e5-3b94-bd52-b2cc08ef15ae",
                        "glosses": [
                            "Celui qui s’occupe de cultiver les bois, les forêts."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5153fa8d-f218-4f61-b8d6-982f34dc6e34",
                                "sense_id": "261d6536-f60c-3d96-a5d3-a9f7ac69b9a6",
                                "text": "Le secrétaire général du Syndicat des sylviculteurs, Christian Pinaudeau, avoue ne pas savoir si cette absence a été déterminante."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "392d0e46-4b03-462e-a3ff-418ce45ea11d",
                        "source_entry_id": "d3007a7e-92e5-3b94-bd52-b2cc08ef15ae",
                        "source_sense_id": "261d6536-f60c-3d96-a5d3-a9f7ac69b9a6",
                        "target_lang_word": "Forstwirt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Forstwirt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3bd8e441-afb4-36ee-96a7-c9966d7dcab9",
                                        "entry_id": "100a3b7e-9681-33b0-983b-7c1141bd0b14",
                                        "glosses": [
                                            "Person, die Wald nach ökonomischen Grundsätzen bewirtschaftet oder bewirtschaften lässt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81468cc5-b8bd-49ec-9008-d567da456b5c",
                                                "sense_id": "3bd8e441-afb4-36ee-96a7-c9966d7dcab9",
                                                "text": "„Die Wildschweinpopulation stellt seit Jahren ein zunehmendes Problem für Land- und Forstwirte dar.“"
                                            },
                                            {
                                                "example_id": "9275559c-4962-4067-be7a-e1def46e1f09",
                                                "sense_id": "3bd8e441-afb4-36ee-96a7-c9966d7dcab9",
                                                "text": "„Die Forstwirte betrachteten es als gefährlich und zerstörerisch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "732da76d-e23b-3a27-96ee-95be5244c7c8",
                                        "entry_id": "100a3b7e-9681-33b0-983b-7c1141bd0b14",
                                        "glosses": [
                                            "staatlich anerkannter Ausbildungsberuf für einen Waldarbeiter in Deutschland"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa0a619b-768e-4f24-9ec9-202955e4babf",
                                                "sense_id": "732da76d-e23b-3a27-96ee-95be5244c7c8",
                                                "text": "„Ein Forstwirt führt alle anfallenden Tätigkeiten im Forstbetrieb (Waldarbeit) aus, von der Begründung neuer Waldbestände bis zur Holzernte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "29b354f8-8ce0-4b20-92b3-3c693cd2d4b8",
                        "source_entry_id": "d3007a7e-92e5-3b94-bd52-b2cc08ef15ae",
                        "source_sense_id": "261d6536-f60c-3d96-a5d3-a9f7ac69b9a6",
                        "target_lang_word": "Forstwirtin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
