                ],
                "senses": [
                    {
                        "sense_id": "f3e71303-c32b-3b4e-b6d8-75491242408f",
                        "entry_id": "4581a43c-b062-3f2b-9031-7284b45b3ee4",
                        "glosses": [
                            "Homme de Néandertal."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df8b383d-1eab-4317-93f7-c9c9d58e659b",
                                "sense_id": "f3e71303-c32b-3b4e-b6d8-75491242408f",
                                "text": "Un fragment d'os d'une jeune fille de 13 ans, découverte dans une grotte des montages de l'Altaï, qui, selon son ADN, s'avère être une hybride entre un père Dénisovien et une mère Néandertal, espèces cousines d'Homo Sapiens aujourd'hui disparues."
                            },
                            {
                                "example_id": "d43e458e-e515-4127-97d6-11e54ddd33db",
                                "sense_id": "f3e71303-c32b-3b4e-b6d8-75491242408f",
                                "text": "Ce résultat surprend d’autant plus qu’il s’écarte vraiment trop des évaluations proposées pour le crâne de Néandertal."
                            },
                            {
                                "example_id": "de6887be-2fbd-4cf1-9041-79652845ea8d",
                                "sense_id": "f3e71303-c32b-3b4e-b6d8-75491242408f",
                                "text": "Depuis plusieurs décennies, les anthropologues espèrent retrouver des hommes fruits de l’union de Néandertal et de Cro-Magnon."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "792e6865-b354-45e0-877e-2e136d70307f",
                        "source_entry_id": "4581a43c-b062-3f2b-9031-7284b45b3ee4",
                        "source_sense_id": "f3e71303-c32b-3b4e-b6d8-75491242408f",
