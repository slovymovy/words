                "senses": [
                    {
                        "sense_id": "0b4eb0d3-06a5-3e45-840b-7cb1de1a627a",
                        "entry_id": "bc9a3184-0f58-34ca-92c9-fa9fd58e6baa",
                        "glosses": [
                            "Priorité de temps."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f859b05d-8be5-4305-b071-2ad421702764",
                                "sense_id": "0b4eb0d3-06a5-3e45-840b-7cb1de1a627a",
                                "text": "Antériorité de date."
                            },
                            {
                                "example_id": "943ba231-40f3-4aa1-8e5a-9681847af709",
                                "sense_id": "0b4eb0d3-06a5-3e45-840b-7cb1de1a627a",
                                "text": "L’antériorité d’une demande."
                            },
                            {
                                "example_id": "857c10fd-0045-4ab7-9ace-ff7f5d799dda",
                                "sense_id": "0b4eb0d3-06a5-3e45-840b-7cb1de1a627a",
                                "text": "L’antériorité d’un brevet."
                            },
                            {
                                "example_id": "9cd39105-2548-4210-9056-5750f5e0b560",
                                "sense_id": "0b4eb0d3-06a5-3e45-840b-7cb1de1a627a",
                                "text": "Pour cette forme de conscience du passé, l’antériorité temporelle ne se révèle plus à travers cette absence qu’est l'oubli mais dans la différence qu’est autrui."
                            }
                        ]
                    },
                    {
                        "sense_id": "d08f0642-e0f1-3413-a253-170e1cd79b7d",
                        "entry_id": "bc9a3184-0f58-34ca-92c9-fa9fd58e6baa",
                        "glosses": [
                            "Qualité d’être voyelle antérieure."
                        ],
