                    {
                        "sense_id": "14d51efa-986a-315a-91e9-c0bbfd039159",
                        "entry_id": "8d9a6a9d-7951-3636-aaa7-31fb3bc79e90",
                        "glosses": [
                            "Flughafen"
                        ],
                        "tags": [
                            "outdated"
                        ],
                        "examples": [],
