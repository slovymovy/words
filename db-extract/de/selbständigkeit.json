                                        "glosses": [
                                            "The act or practice of working for oneself, such as being an independent contractor."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "647c7dfc-b3b1-43ec-8f10-3aaf0e8ccd3d",
