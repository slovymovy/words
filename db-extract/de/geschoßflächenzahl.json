                ],
                "senses": [
                    {
                        "sense_id": "2dec0297-4593-3350-9615-ce5bd9b2af52",
                        "entry_id": "73d5664d-0244-3d00-9b0d-cab111f2d539",
                        "glosses": [
                            "eine dimensionslose Zahl, die angibt, wie viele Quadratmeter eines Gebäudes an Geschoßflächen pro Quadratmeter Grundstücksfläche maximal geplant werden dürfen"
                        ],
                        "tags": [
                            "Austrian German"
                        ],
                        "examples": [
                            {
                                "example_id": "8f192f91-6323-43e4-ae37-fd368f8f1aa3",
                                "sense_id": "2dec0297-4593-3350-9615-ce5bd9b2af52",
                                "text": "„Die bauliche Ausnutzbarkeit der Grundflächen kann durch die Festlegung einer Grundflächenzahl, einer Baumassenzahl oder einer Geschoßflächenzahl festgelegt werden.“"
                            },
                            {
                                "example_id": "5de212fc-cc38-4b32-9998-e16bb64d4ad2",
                                "sense_id": "2dec0297-4593-3350-9615-ce5bd9b2af52",
                                "text": "„Die Geschoßflächenzahl stellt einen der Werte dar, die nach § 32 Abs. 6 Oö ROG 1994 das Maß der baulichen Nutzung eines Grundstückes festlegen.“"
                            },
                            {
                                "example_id": "51ad1915-6fab-4874-9eb3-f1b83795e5b1",
                                "sense_id": "2dec0297-4593-3350-9615-ce5bd9b2af52",
                                "text": "„Für die Berechnung der Geschoßflächenzahl des Projektes zog der Sachverständige die Außenumrisse des Gebäudes für jedes Geschoß, das über dem Gelände des Bauplatzes liege, heran.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
