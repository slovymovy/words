        "ru-extract.jsonl": [],
        "nl-extract.jsonl": [
            {
                "entry_id": "eb93dc23-3b59-3487-9bc9-4c5938f65c5a",
                "word": "weeklagen",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "9e3ec95f-ec38-3732-8c26-a427c69b1124",
                        "entry_id": "eb93dc23-3b59-3487-9bc9-4c5938f65c5a",
                        "glosses": [
                            "een jammerklacht aanheffen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "933ad6dd-9d52-4742-9963-97522c72822c",
                                "sense_id": "9e3ec95f-ec38-3732-8c26-a427c69b1124",
                                "text": "Steeds maar horen we mensen weeklagen dat er niet voldoende voedsel geproduceerd kan worden voor het voeden van een bevolking van negen miljard in 2050."
                            },
                            {
                                "example_id": "99a1a83d-2266-45a0-8e23-6114f4d705e7",
                                "sense_id": "9e3ec95f-ec38-3732-8c26-a427c69b1124",
                                "text": "Was het zwaar, je kind uitzwaaien? Hoe stoer dat ie marinier wordt. En hoe beangstigend. Ben je aan zijn benen gaan hangen, heb je hem huilend gesmeekt niet te gaan? Heb je jezelf weeklagend aan zijn voeten geworpen? Nee zeker, daar ben je te verstandig voor."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d78f71e6-a38b-4304-82b7-e77be74dfc4b",
                        "source_entry_id": "eb93dc23-3b59-3487-9bc9-4c5938f65c5a",
                        "source_sense_id": "9e3ec95f-ec38-3732-8c26-a427c69b1124",
                        "target_lang_word": "whine",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "whine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a33338b6-0572-3dc2-908d-727b2294d622",
                                        "entry_id": "6309b92d-3a73-37db-8bfa-854204842a6a",
                                        "glosses": [
                                            "A long-drawn, high-pitched complaining cry or sound."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c75ad3b5-ffb4-4676-840a-3e234e3302c2",
                                                "sense_id": "a33338b6-0572-3dc2-908d-727b2294d622",
                                                "text": "The 18-year-old [Justin] Bieber can’t quite pull off the “adult” thing just yet: His voice may have dropped a bit since the days of “Baby,” but it still mostly registers as “angelic,” and veers toward a pubescent whine at times."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ec2211da-0daf-3f39-bc23-5a8e24548d7b",
                                        "entry_id": "6309b92d-3a73-37db-8bfa-854204842a6a",
                                        "glosses": [
                                            "A complaint or criticism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e32d766a-2251-4ac2-ac07-9aa9c8e1edf0",
                                                "sense_id": "ec2211da-0daf-3f39-bc23-5a8e24548d7b",
                                                "text": "I need to have a quick whine about my boss before we start talking about the holiday."
                                            },
                                            {
                                                "example_id": "4b6960d0-12dc-4652-8f20-425b4bc8d10c",
                                                "sense_id": "ec2211da-0daf-3f39-bc23-5a8e24548d7b",
                                                "text": "Eighner, in particular, is infamous for his \"what publishers and editors did to poor me\" whines."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "whine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "815902ea-0e26-3a67-9bd9-c2a3416615a1",
                                        "entry_id": "ebb7e835-7cd9-3f20-9710-16e9f94dadc3",
                                        "glosses": [
                                            "To utter a high-pitched cry."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "00118e6c-3bd4-32b5-b20e-7e1b11994f9a",
                                        "entry_id": "ebb7e835-7cd9-3f20-9710-16e9f94dadc3",
                                        "glosses": [
                                            "To make a sound resembling such a cry."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "456e12bb-c172-4823-9746-7704041054ff",
                                                "sense_id": "00118e6c-3bd4-32b5-b20e-7e1b11994f9a",
                                                "text": "The jet engines whined at take off."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9180a1db-556b-3a07-8961-6ded0d67ef66",
                                        "entry_id": "ebb7e835-7cd9-3f20-9710-16e9f94dadc3",
                                        "glosses": [
                                            "To complain or protest with a whine (compare whinge) or as if with a whine."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "910dc3d0-88ee-4e29-a544-b03a1f560d3c",
                                                "sense_id": "9180a1db-556b-3a07-8961-6ded0d67ef66",
                                                "text": "[S]he was one of your ſoft ſpoken, canting, whining hypocrites, who with a truly jeſuitical art, could wreſt evil out of the moſt inoffenſive thought, word, look or action; […]"
                                            },
                                            {
                                                "example_id": "5eff3abf-3242-46a0-9922-268aebd72fc3",
                                                "sense_id": "9180a1db-556b-3a07-8961-6ded0d67ef66",
                                                "text": "Feel awfully about Scott... I always knew he couldn't think—he never could—but he had a marvelous talent and the thing is to use it—not whine in public."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "01e0823f-2107-373d-8cbe-4d0167504f8a",
                                        "entry_id": "ebb7e835-7cd9-3f20-9710-16e9f94dadc3",
                                        "glosses": [
                                            "To move with a whining sound."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "72d12854-613a-49f9-8c07-0e4a69f3d815",
                                                "sense_id": "01e0823f-2107-373d-8cbe-4d0167504f8a",
                                                "text": "The jet whined into the air."
                                            },
                                            {
                                                "example_id": "e60faf57-7955-49d9-8b3f-a27d6f8f2d47",
                                                "sense_id": "01e0823f-2107-373d-8cbe-4d0167504f8a",
                                                "text": "The wind whined and moaned through the trees."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "08728c3d-62ea-3bcf-bc25-d5135f004383",
                                        "entry_id": "ebb7e835-7cd9-3f20-9710-16e9f94dadc3",
                                        "glosses": [
                                            "To utter with the sound of a whine."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e93e0b4f-ae59-4770-b746-8e00a7adbefc",
                                                "sense_id": "08728c3d-62ea-3bcf-bc25-d5135f004383",
                                                "text": "The child whined all his complaints."
                                            },
                                            {
                                                "example_id": "69724124-6bba-4a22-a3fc-cd7c92d4f4de",
                                                "sense_id": "08728c3d-62ea-3bcf-bc25-d5135f004383",
                                                "text": "Kelly Queen was whining that the boss made him put on his tie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "11297d1c-26a2-47ac-a9e9-5590224f7db6",
                        "source_entry_id": "eb93dc23-3b59-3487-9bc9-4c5938f65c5a",
                        "source_sense_id": "9e3ec95f-ec38-3732-8c26-a427c69b1124",
                        "target_lang_word": "complain",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "complain",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bd8067c9-1d38-35a3-b0ae-cae20ac57a3d",
                                        "entry_id": "2f3b0732-cfad-3b62-b951-00e91f2cfbd0",
                                        "glosses": [
                                            "To express feelings of pain, dissatisfaction, or resentment."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e4703c8f-2668-40d5-b50c-16fe6d6fa871",
                                                "sense_id": "bd8067c9-1d38-35a3-b0ae-cae20ac57a3d",
                                                "text": "Joe was always complaining about the noise made by his neighbours."
                                            },
                                            {
                                                "example_id": "09c161b0-c436-4e00-a068-d364b780d1ec",
                                                "sense_id": "bd8067c9-1d38-35a3-b0ae-cae20ac57a3d",
                                                "text": "O loſs of ſight, of thee I moſt complain!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2f849159-15c5-3af6-b629-c44177722feb",
                                        "entry_id": "2f3b0732-cfad-3b62-b951-00e91f2cfbd0",
                                        "glosses": [
                                            "To make a formal accusation or bring a formal charge."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8ef67ee9-3465-4166-b760-6e1a37c6ab62",
                                                "sense_id": "2f849159-15c5-3af6-b629-c44177722feb",
                                                "text": "They've complained about me to the police again."
                                            },
                                            {
                                                "example_id": "2f546466-6cf0-4b38-8744-6fc217b7c8dc",
                                                "sense_id": "2f849159-15c5-3af6-b629-c44177722feb",
                                                "text": "Now, Master Shallow, you'll complain of me to the king?"
                                            },
                                            {
                                                "example_id": "334edb79-afae-454c-ada7-c1d6ac367d9e",
                                                "sense_id": "2f849159-15c5-3af6-b629-c44177722feb",
                                                "text": "If you get cheated by the Better Business Bureau, who do you complain to?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6b9aab22-3c2f-38cc-a1ed-2bc0385e37d2",
                                        "entry_id": "2f3b0732-cfad-3b62-b951-00e91f2cfbd0",
                                        "glosses": [
                                            "To creak or squeak, as a timber or wheel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b426e2d0-f893-4086-ba8d-ac40d060f797",
                                                "sense_id": "6b9aab22-3c2f-38cc-a1ed-2bc0385e37d2",
                                                "text": "the complaining bed-springs"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "67d49024-2aea-405b-a614-66b9a27db957",
                        "source_entry_id": "eb93dc23-3b59-3487-9bc9-4c5938f65c5a",
                        "source_sense_id": "9e3ec95f-ec38-3732-8c26-a427c69b1124",
                        "target_lang_word": "lamentation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lamentation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f13a8a44-f8d2-347a-8a08-277b9ee7be48",
                                        "entry_id": "8b772eee-53d8-3c92-8565-0d2d774f5420",
                                        "glosses": [
                                            "The act of lamenting."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "67e168b9-004b-4391-8d4e-e497abaad3bb",
                                                "sense_id": "f13a8a44-f8d2-347a-8a08-277b9ee7be48",
                                                "text": "About John Marin, there move sad, disgruntled beings, full of talk and lamentations. [...] They bewail the fact that in America, soil is poor and unconducive to growth, and men remain unmoved by growing green. But Marin persists, and what ebullience and good humour, in the rocky ungentle loam?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5857dda0-3dcb-3d23-8218-2020889866df",
                                        "entry_id": "8b772eee-53d8-3c92-8565-0d2d774f5420",
                                        "glosses": [
                                            "A sorrowful cry; a lament."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "eb601db0-ba9a-3461-9df4-1e7f3a9944b7",
