                "senses": [
                    {
                        "sense_id": "98013f1f-b68b-3ec3-a4e5-c598c3295120",
                        "entry_id": "862b4ed5-cb80-30e1-8538-bc97d53db84a",
                        "glosses": [
                            "Enlever sa capacitation à (un spermatozoïde), le rendre incapable de féconder."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "766c5029-8bee-4e85-9434-3dd148c364b8",
                                "sense_id": "98013f1f-b68b-3ec3-a4e5-c598c3295120",
                                "text": "Fort intéressante est la découverte récente chez l'animal d'une substance susceptible dans le plasma séminal de décapaciter les spermatozoïdes."
                            },
                            {
                                "example_id": "25f55fef-177f-45c6-915e-8a33d41f7fea",
                                "sense_id": "98013f1f-b68b-3ec3-a4e5-c598c3295120",
                                "text": "La capacitation est un phénomène réversible et la mise en présence avec du plasma séminal ou du cholestérol peut décapaciter les spermatozoïdes."
                            },
                            {
                                "example_id": "08586147-50b3-4bcf-bfa4-ffc42859eb5b",
                                "sense_id": "98013f1f-b68b-3ec3-a4e5-c598c3295120",
                                "text": "Seulement il ne peut pas féconder car il a été décapacité : sa membrane externe a été modifiée pour qu'il soit plus résistant en gros."
                            }
                        ]
                    }
                ],
