                        "source_sense_id": "85863d82-c956-3617-83ad-563f4ca1a82e",
                        "source_sense_description": "Gefühl einer drohenden Gefahr oder Missstimmung",
                        "target_lang_word": "беспокойство",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "беспокойство",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "ff5832f7-92bb-3f50-b36e-804aa1f0c798",
