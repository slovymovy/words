                "senses": [
                    {
                        "sense_id": "f3b50279-68ae-3d33-9881-21c73a124abf",
                        "entry_id": "f595c2db-a785-390f-8c2d-4ea1d3e82d14",
                        "glosses": [
                            "an auxiliary material used in a production; fitting"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "561e3b04-8802-4627-b6e8-220f1d629e3f",
                                "sense_id": "f3b50279-68ae-3d33-9881-21c73a124abf",
                                "text": "Разнообразие расцветок, покроя, отделки, фурнитуры — вот что сдвинет вкус человека с мертвой точки.",
                                "translation": "The diversity of colours, cuts, finishes, fittings is what will get a person's taste move forward.",
                                "english": "The diversity of colours, cuts, finishes, fittings is what will get a person's taste move forward."
                            },
                            {
                                "example_id": "acbdcede-14e7-433a-9dfc-18e09f083125",
                                "sense_id": "f3b50279-68ae-3d33-9881-21c73a124abf",
                                "text": "Как драгоценная, сверкала фурнитура на комоде в стиле Людовика Солнца.",
                                "translation": "Like precious, the fitting on the dresser sparked in the style of Louis the Sun King.",
                                "english": "Like precious, the fitting on the dresser sparked in the style of Louis the Sun King."
                            },
                            {
                                "example_id": "1d73ff9f-58ff-4861-b09b-0fedf8015358",
                                "sense_id": "f3b50279-68ae-3d33-9881-21c73a124abf",
                                "text": "Молнии и металлическая фурнитура цвета розового золота отлично подчеркивают пастельный оттенок кожи.",
                                "translation": "The zips and the rose-gold coloured fitting perfectly accentuate the pastel tone of the skin.",
                                "english": "The zips and the rose-gold coloured fitting perfectly accentuate the pastel tone of the skin."
                            }
                        ]
                    }
                ],
