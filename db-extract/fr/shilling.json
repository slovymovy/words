                        ],
                        "form": "shillings"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4a8fc3de-b826-3b05-a3a6-431bcdc8c90d",
                        "entry_id": "c2ce2172-213f-3275-a0a6-4f79c8b02a34",
                        "glosses": [
                            "Ancienne pièce de monnaie du Royaume-Uni avant la décimalisation de 1971, qui avait une valeur de 12 pennys ou un vingtième de livre sterling. Son symbole était la barre oblique (/)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59319676-c2a7-4129-8b1a-a16bccfb21ce",
                                "sense_id": "4a8fc3de-b826-3b05-a3a6-431bcdc8c90d",
                                "text": "Par bonheur, Mattia avait douze francs d’économies et en plus notre part de recette provenant de notre association avec Bob et ses camarades, laquelle s’élevait à vingt-deux shillings, ou vingt-sept francs cinquante ; cela nous constituait une fortune de près de quarante francs, ce qui était considérable pour nous."
                            },
                            {
                                "example_id": "775ab786-f6f4-40ff-ada9-c3ace6133016",
                                "sense_id": "4a8fc3de-b826-3b05-a3a6-431bcdc8c90d",
                                "text": "Vers cet âge, il se faisait par semaine trois shillings et plus en portant les bagages des voyageurs à la station et en vendant la gazette hebdomadaire de la localité."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a8158f57-05b2-4dcd-b8f6-a8ec6b2f27dc",
                        "source_entry_id": "c2ce2172-213f-3275-a0a6-4f79c8b02a34",
                        "source_sense_id": "4a8fc3de-b826-3b05-a3a6-431bcdc8c90d",
                        "target_lang_word": "Schilling",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schilling",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4bbe7edd-3df5-39b3-80be-a0833075c8a1",
                                        "entry_id": "cdf2fb26-cfb9-3f6e-ae72-9245c8c98079",
                                        "glosses": [
                                            "mittelalterliches und historisches Zahlungsmittel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9750fc8a-4b9f-49d6-a27c-771e6d05daea",
                                                "sense_id": "4bbe7edd-3df5-39b3-80be-a0833075c8a1",
                                                "text": "In Norwegen wurden Schillinge erst ab dem 16. Jahrhundert geprägt."
                                            },
                                            {
                                                "example_id": "118e29ef-ecc3-4dfc-b71d-12502f63f07d",
                                                "sense_id": "4bbe7edd-3df5-39b3-80be-a0833075c8a1",
                                                "text": "„Es ist eine der ersten Ausgaben aus dem Jahr 1867 und das Porto ist in englischen Schilling angegeben.“"
                                            },
                                            {
                                                "example_id": "59ac2de4-45d2-4d23-836c-52c3b2dd2441",
                                                "sense_id": "4bbe7edd-3df5-39b3-80be-a0833075c8a1",
                                                "text": "„Er gab jedem von ihnen einen Schilling, und sie sausten davon, die Treppen hinunter, und einen Augenblick später sah ich sie auf der Straße.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "37b4f596-bf01-3c98-b17b-fd33c62ad230",
                                        "entry_id": "cdf2fb26-cfb9-3f6e-ae72-9245c8c98079",
                                        "glosses": [
                                            "ehemalige Währungseinheit (bis 2001) in Österreich Schilling"
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "485f9a77-d652-43c3-b336-64b044445a73",
                                                "sense_id": "37b4f596-bf01-3c98-b17b-fd33c62ad230",
                                                "text": "Seit 2001 gibt es den österreichischen Schilling nicht mehr."
                                            },
                                            {
                                                "example_id": "c836716a-a2c9-45fb-b3d3-2062a231a3be",
                                                "sense_id": "37b4f596-bf01-3c98-b17b-fd33c62ad230",
                                                "text": "Eine halbe Stunde Parken hat damals 7 Schilling gekostet."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "bdd8bd8b-ae30-3752-aa3a-39dd2c8874a0",
                                        "entry_id": "cdf2fb26-cfb9-3f6e-ae72-9245c8c98079",
                                        "glosses": [
                                            "eine Münze mit dem Wert 1 Schilling. Schillinge"
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3fdc4979-9318-4986-aff9-d35ff8ff5ef9",
                                                "sense_id": "bdd8bd8b-ae30-3752-aa3a-39dd2c8874a0",
                                                "text": "Der Automat hat Schillinge, Fünfer und Zehner akzeptiert."
                                            }
                                        ],
                                        "sense_index_json": "\"2a\""
                                    },
                                    {
                                        "sense_id": "9fce1b5f-87af-3c95-a091-16b101a70074",
                                        "entry_id": "cdf2fb26-cfb9-3f6e-ae72-9245c8c98079",
                                        "glosses": [
                                            "Währungseinheit in Kenia und Tansania"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4eb8508e-901c-4897-bdf3-7b373f5b683c",
                                                "sense_id": "9fce1b5f-87af-3c95-a091-16b101a70074",
                                                "text": "In Kenia zahlt man mit Schillingen."
                                            }
                                        ],
