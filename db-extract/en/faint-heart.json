                        "glosses": [
                            "A cowardly, faint-hearted person; one who is irresolute or fearful."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "028e1498-5b6a-4418-9d70-c6ecdc0f2fd7",
                                "sense_id": "5ad7c536-7e6c-37cc-b0f8-2a93a2d0ad9e",
                                "text": "Beowulf had scarcely died before the faint-hearts came crawling out of their burrows."
                            },
                            {
                                "example_id": "36e3b8ad-58c3-478a-99f6-1e384abac681",
                                "sense_id": "5ad7c536-7e6c-37cc-b0f8-2a93a2d0ad9e",
                                "text": "We are going to need all forces in the conditions that we have to face, and in the fight that we have before us we want no half-hearted supporters, no vacillators, no faint-hearts."
                            }
