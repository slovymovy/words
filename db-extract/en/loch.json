                                                "sense_id": "1603c8ef-7d17-306f-9184-7eceb4918617",
                                                "text": "Und er kam auf direktem Wege wieder ins Loch."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "663121ad-352c-39d6-bba1-ecc657d57794",
