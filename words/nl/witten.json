                    "sense_id": "41f1ca22-382e-3844-ac9a-4290a34ecc92",
                    "sense_definition": "Een muur of plafond wit maken met kalk of witverf.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "wit_maken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We moeten de muren van de woonkamer opnieuw <w>witten</w> voor de zomer.",
                            "target_lang_translations": {
                                "en": "We need to <w>whitewash</w> the living room walls again before the summer."
                            }
                        },
                        {
                            "text": "Hij besloot om zelf het plafond te <w>witten</w> om geld te besparen.",
                            "target_lang_translations": {
                                "en": "He decided to <w>paint</w> the ceiling <w>white</w> himself to save money."
                            }
                        }
                    ],
                    "common_phrases": [
                        "een muur witten",
                        "het plafond witten"
                    ],
                    "target_lang_definitions": {
                        "en": "To paint a wall or ceiling white using whitewash or white paint."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "whitewash",
                                "target_lang_sense_clarification": "to paint walls or ceilings white with lime or whitewash"
                            },
                            {
                                "target_lang_word": "paint white",
                                "target_lang_sense_clarification": "to apply white paint to a surface"
                            }
                        ]
                    }
                },
                {
