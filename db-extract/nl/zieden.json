                        ],
                        "form": "gezoden"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a5ec6842-2850-33bb-9066-cd64da926293",
                        "entry_id": "5dd74d1a-ddc1-33ef-bbe8-ec4fe231b67c",
                        "glosses": [
                            "droogkoken, [grondstoffen] zuiveren of raffineren door ze aan de kook te brengen; met name van pekel of suiker of zeep"
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "9791fc7a-4984-432c-b2bc-3aa522fdb0eb",
                                "sense_id": "a5ec6842-2850-33bb-9066-cd64da926293",
                                "text": "In Zwijndrecht werd vroeger gezoden ter wille van de zoutwinning."
                            }
                        ]
                    },
                    {
                        "sense_id": "aa177468-fcac-3b6a-be5c-83e7cfc3bf12",
                        "entry_id": "5dd74d1a-ddc1-33ef-bbe8-ec4fe231b67c",
                        "glosses": [
                            "[een chemische verbinding] bereiden door de grondstoffen te koken; met name van zeep, verf of vernis"
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "33c53dd5-52a0-4f33-bdb8-16da1ec125b0",
                                "sense_id": "aa177468-fcac-3b6a-be5c-83e7cfc3bf12",
                                "text": "Het productieproces van zeep begon vroeger door vet samen met loog te zieden, zodat het vet verzeepte."
                            }
                        ]
                    },
                    {
                        "sense_id": "99fbe5b3-864f-31b9-831e-abca83972382",
                        "entry_id": "5dd74d1a-ddc1-33ef-bbe8-ec4fe231b67c",
                        "glosses": [
                            "koken, zo heet zijn dat het kookpunt bereikt wordt"
                        ],
                        "tags": [
                            "ergative"
                        ],
                        "examples": [
                            {
                                "example_id": "5ebcb095-8aab-4e1b-a7f9-52f8a393f4a9",
                                "sense_id": "99fbe5b3-864f-31b9-831e-abca83972382",
                                "text": "Laat de pan eerst heet worden, doe er dan boter in tot deze ziedt en leg ten slotte het vlees erbij."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
