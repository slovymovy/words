    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7679afac-7934-3651-894b-89be60ff13ee",
                    "sense_definition": "A curtain or piece of fabric used for covering windows or doors.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "fabric_hanging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She pulled the heavy <w>drapes</w> shut to block out the bright morning sun."
                        },
                        {
                            "text": "The elegant <w>drapes</w> added a touch of luxury to the living room."
                        }
                    ],
                    "common_phrases": [
                        "heavy drapes",
                        "close the drapes"
                    ],
                    "synonyms": [
                        "curtain"
                    ]
                },
                {
                    "sense_id": "678a5042-4233-3865-846d-197434328c74",
                    "sense_definition": "The way in which fabric falls or hangs on a person or object.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "fabric_hanging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The silk dress has a beautiful <w>drape</w> that follows the body perfectly."
                        },
                        {
                            "text": "The quality of the fabric is determined by its weight and natural <w>drape</w>."
                        }
                    ]
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "cc6ae4b4-e2c2-30a9-8517-889db8b98ddc",
                    "sense_definition": "To spread something over an object to cover it.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "covering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I <w>draped</w> my coat over the back of the chair."
                        },
                        {
                            "text": "She <w>draped</w> a blanket over her shoulders to stay warm."
                        }
                    ],
                    "common_phrases": [
                        "draped over"
                    ]
                },
                {
                    "sense_id": "a6fc32e5-4314-395d-818c-ad7fc63d3bdb",
                    "sense_definition": "To decorate or adorn something with cloth or fabric.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "covering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They <w>draped</w> the walls with colorful banners for the celebration."
                        },
                        {
                            "text": "The statue was <w>draped</w> in fine silk for the ceremony."
                        }
                    ]
                },
                {
                    "sense_id": "0af6d4b8-9da0-3a19-9115-42b376e83ce8",
                    "sense_definition": "To hang or rest in a relaxed or limp manner.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "posture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>draped</w> himself across the sofa after a long day at work."
                        },
                        {
                            "text": "Her arms <w>draped</w> loosely over the sides of the armchair."
                        }
                    ]
                }
            ]
        }
    ]
