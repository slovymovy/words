{
    "word_family": [
        "globalisering",
        "globaliseren",
        "globalisme",
        "globalist"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "045e63ce-3281-3598-811b-7161cbc26114",
                    "sense_definition": "betrekking hebbend op de hele wereld",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "wereldwijd",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De opwarming van de aarde is een <w>globaal</w> probleem dat we samen moeten oplossen.",
                            "target_lang_translations": {
                                "en": "Global warming is a <w>global</w> problem that we must solve together."
                            }
                        },
                        {
                            "text": "Het bedrijf wil een grotere rol spelen op de <w>globale</w> markt.",
                            "target_lang_translations": {
                                "en": "The company wants to play a larger role in the <w>global</w> market."
                            }
                        }
                    ],
                    "synonyms": [
                        "wereldwijd",
                        "mondiaal"
                    ],
                    "common_phrases": [
                        "globale markt",
                        "globale economie",
                        "globale opwarming"
                    ],
                    "target_lang_definitions": {
                        "en": "relating to the whole world"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "global",
                                "target_lang_sense_clarification": "concerning all parts of the world"
                            },
                            {
                                "target_lang_word": "worldwide",
                                "target_lang_sense_clarification": "extending throughout the entire world"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ff3360fb-23b4-3094-a434-f43074730576",
                    "sense_definition": "niet in detail tredend; bij benadering",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "algemeen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kun je mij een <w>globaal</w> idee geven van de kosten voor deze verbouwing?",
                            "target_lang_translations": {
                                "en": "Can you give me a <w>rough</w> idea of the costs for this renovation?"
                            }
                        },
                        {
                            "text": "Na een <w>globale</w> schatting bleek dat het project veel duurder zou worden.",
                            "target_lang_translations": {
                                "en": "After an <w>approximate</w> estimate, it turned out the project would be much more expensive."
                            }
                        }
                    ],
                    "synonyms": [
                        "algemeen",
                        "grof"
                    ],
                    "antonyms": [
                        "precies"
                    ],
                    "common_phrases": [
                        "globale schatting",
                        "globaal idee",
                        "globale raming"
                    ],
                    "target_lang_definitions": {
                        "en": "not going into detail; approximate"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "rough",
                                "target_lang_sense_clarification": "not exact or detailed"
                            },
                            {
                                "target_lang_word": "approximate",
                                "target_lang_sense_clarification": "nearly exact; not perfectly accurate"
                            },
                            {
                                "target_lang_word": "general",
                                "target_lang_sense_clarification": "not specialized or detailed"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c1a2a0dc-8976-32d0-874e-051db720eca8",
                    "sense_definition": "het geheel omvattend; volledig",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "totaal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De politieke partij presenteerde een <w>globaal</w> plan voor de verkeersveiligheid in de stad.",
                            "target_lang_translations": {
                                "en": "The political party presented a <w>comprehensive</w> plan for road safety in the city."
                            }
                        },
                        {
                            "text": "Zonder een <w>globaal</w> overzicht van de situatie kunnen we geen besluit nemen.",
                            "target_lang_translations": {
                                "en": "Without an <w>overall</w> overview of the situation, we cannot make a decision."
                            }
                        }
                    ],
                    "common_phrases": [
                        "globaal plan",
                        "globaal overzicht"
                    ],
                    "target_lang_definitions": {
                        "en": "comprising the whole; complete or overall"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "overall",
                                "target_lang_sense_clarification": "taking everything into account"
                            },
                            {
                                "target_lang_word": "comprehensive",
                                "target_lang_sense_clarification": "including all or nearly all elements"
                            },
                            {
                                "target_lang_word": "global",
                                "target_lang_sense_clarification": "pertaining to the whole of something; total"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}