                                        "glosses": [
                                            "An uninterrupted series of alternate overs bowled by a single bowler."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "spell",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4ba71d34-ba36-324f-ba75-3191bf5e6022",
                                        "entry_id": "b9b3dc6b-ccc1-3f04-bffd-967280b03b94",
                                        "glosses": [
                                            "A splinter, usually of wood; a spelk."
                                        ],
                                        "tags": [
                                            "Northern-England"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2b837c11-1f18-4cae-ad47-c17a983b4924",
                                                "sense_id": "4ba71d34-ba36-324f-ba75-3191bf5e6022",
                                                "text": "To swadle a bowe much about wyth bandes, verye seldome dothe anye good, excepte it be to kepe downe a spel in the backe."
                                            }
