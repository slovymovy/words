{
    "word_family": [
        "zwabber",
        "gezwabber"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "af92ea6e-4902-358b-a33c-9e88feb54650",
                    "sense_definition": "het schoonmaken van een vloer of dek met een zwabber",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "schoonmaken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De matroos moet elke ochtend het houten dek van het schip <w>zwabberen</w>.",
                            "target_lang_translations": {
                                "en": "The sailor has to <w>swab</w> the ship's wooden deck every morning.",
                                "ru": "Матрос должен каждое утро <w>драить</w> деревянную палубу корабля."
                            }
                        },
                        {
                            "text": "Nadat de gasten weg waren, begon de eigenaar direct de vloer te <w>zwabberen</w>.",
                            "target_lang_translations": {
                                "en": "After the guests had left, the owner immediately started to <w>mop</w> the floor.",
                                "ru": "После того как гости ушли, владелец сразу начал <w>мыть</w> пол шваброй."
                            }
                        }
                    ],
                    "synonyms": [
                        "dweilen",
                        "moppen"
                    ],
                    "common_phrases": [
                        "de vloer zwabberen",
                        "het dek zwabberen"
                    ],
                    "target_lang_definitions": {
                        "en": "cleaning a floor or deck using a mop",
                        "ru": "очистка пола или палубы с помощью швабры"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "mop",
                                "target_lang_sense_clarification": "to clean with a mop"
                            },
                            {
                                "target_lang_word": "swab",
                                "target_lang_sense_clarification": "specifically used for cleaning a ship's deck"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "мыть шваброй",
                                "target_lang_sense_clarification": "очищать поверхность пола"
                            },
                            {
                                "target_lang_word": "драить",
                                "target_lang_sense_clarification": "интенсивно мыть палубу корабля"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "04588147-781e-3df3-8b11-84720863e041",
                    "sense_definition": "onvast of ongecontroleerd heen en weer bewegen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "beweging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Door de harde wind begon de auto gevaarlijk over de weg te <w>zwabberen</w>.",
                            "target_lang_translations": {
                                "en": "Because of the strong wind, the car began to <w>swerve</w> dangerously across the road.",
                                "ru": "Из-за сильного ветра машину начало опасно <w>вилять</w> по дороге."
                            }
                        },
                        {
                            "text": "Hij was zo moe dat zijn benen tijdens het lopen begonnen te <w>zwabberen</w>.",
                            "target_lang_translations": {
                                "en": "He was so tired that his legs began to <w>wobble</w> while walking.",
                                "ru": "Он так устал, что его ноги при ходьбе начали <w>подкашиваться</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "zwalken",
                        "slingeren",
                        "zwiepen"
                    ],
                    "common_phrases": [
                        "over de weg zwabberen",
                        "heen en weer zwabberen"
                    ],
                    "target_lang_definitions": {
                        "en": "moving back and forth in an unsteady or uncontrolled manner",
                        "ru": "неустойчивое или неконтролируемое движение из стороны в сторону"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "swerve",
                                "target_lang_sense_clarification": "moving unsteadily across a road"
                            },
                            {
                                "target_lang_word": "wobble",
                                "target_lang_sense_clarification": "moving unsteadily or shaking"
                            },
                            {
                                "target_lang_word": "sway",
                                "target_lang_sense_clarification": "moving back and forth"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "вилять",
                                "target_lang_sense_clarification": "двигаться из стороны в сторону, например, на дороге"
                            },
                            {
                                "target_lang_word": "болтаться",
                                "target_lang_sense_clarification": "неустойчиво двигаться или качаться"
                            },
                            {
                                "target_lang_word": "шататься",
                                "target_lang_sense_clarification": "идти неуверенной походкой"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2f02eff4-9ea5-3695-af81-54e085bd3e1f",
                    "sense_definition": "geen vaste koers houden of inconsistent zijn in beleid of beslissingen",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "inconsistentie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De oppositie bekritiseerde de regering omdat ze bleven <w>zwabberen</w> over de nieuwe klimaatwet.",
                            "target_lang_translations": {
                                "en": "The opposition criticized the government because they kept <w>wavering</w> on the new climate law.",
                                "ru": "Оппозиция критиковала правительство за то, что оно продолжало <w>колебаться</w> по поводу нового закона о климате."
                            }
                        },
                        {
                            "text": "Zonder een duidelijk plan zal het bedrijf alleen maar blijven <w>zwabberen</w> tussen verschillende strategieën.",
                            "target_lang_translations": {
                                "en": "Without a clear plan, the company will only keep <w>vacillating</w> between different strategies.",
                                "ru": "Без четкого плана компания будет лишь продолжать <w>метаться</w> между различными стратегиями."
                            }
                        }
                    ],
                    "synonyms": [
                        "weifelen",
                        "aarzelen",
                        "zwalken"
                    ],
                    "antonyms": [
                        "doorzetten",
                        "volharden"
                    ],
                    "common_phrases": [
                        "tussen twee opties zwabberen",
                        "in het beleid zwabberen"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vaak gebruikt in politieke of zakelijke context"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "failing to maintain a fixed course or being inconsistent in policy or decisions",
                        "ru": "отсутствие четкого курса или непоследовательность в политике или решениях"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "waver",
                                "target_lang_sense_clarification": "being indecisive or inconsistent"
                            },
                            {
                                "target_lang_word": "vacillate",
                                "target_lang_sense_clarification": "alternating between different opinions or actions"
                            },
                            {
                                "target_lang_word": "flip-flop",
                                "target_lang_sense_clarification": "changing decisions or policies frequently"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "колебаться",
                                "target_lang_sense_clarification": "быть нерешительным в выборе курса"
                            },
                            {
                                "target_lang_word": "метаться",
                                "target_lang_sense_clarification": "непоследовательно менять решения или стратегии"
                            }
                        ]
                    }
                }
            ]
        }
    ]
