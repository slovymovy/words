                "senses": [
                    {
                        "sense_id": "90d35eee-22a8-398f-b2e8-4ce61e4292a9",
                        "entry_id": "a7b5e6df-0a4a-30d3-b127-5ad854cc2c98",
                        "glosses": [
                            "belangrijkste en vaak ook zwaarste gang van een maaltijd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c7cb737-7076-4c10-b703-cadaa091e985",
                                "sense_id": "90d35eee-22a8-398f-b2e8-4ce61e4292a9",
                                "text": "Na de soep kwam het hoofdgerecht."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0aade678-99be-4121-89b8-87266b36e52a",
                        "source_entry_id": "a7b5e6df-0a4a-30d3-b127-5ad854cc2c98",
                        "source_sense_id": "90d35eee-22a8-398f-b2e8-4ce61e4292a9",
                        "target_lang_word": "Hauptgericht",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hauptgericht",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cc264a5e-10d7-3c4d-90d2-425ec8504a6d",
                                        "entry_id": "4a803ed0-7b15-342e-bf13-18f02da28f52",
                                        "glosses": [
                                            "reichhaltigster, meist mittlerer Teil einer Mahlzeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "06fa1bef-8c05-4e8e-b621-1de514c42a60",
                                                "sense_id": "cc264a5e-10d7-3c4d-90d2-425ec8504a6d",
                                                "text": "„Doch der eigentliche Glanzpunkt der Offerten sind für mich eindeutig die Hauptgerichte.“"
                                            },
                                            {
                                                "example_id": "98577d47-f7f9-4384-9852-9e341ecd33df",
                                                "sense_id": "cc264a5e-10d7-3c4d-90d2-425ec8504a6d",
                                                "text": "„Es gab Brennsuppe, als Hauptgericht Kartoffeln mit Soße und zum Nachtisch einen Apfel.“"
                                            },
                                            {
                                                "example_id": "63f63a40-de78-4900-b0b2-a5639ae2bbad",
                                                "sense_id": "cc264a5e-10d7-3c4d-90d2-425ec8504a6d",
                                                "text": "„Sie servierten eben das Hauptgericht: Leber auf portugiesische Art.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "44fee4a1-065c-4765-868d-243a3bb94562",
                        "source_entry_id": "a7b5e6df-0a4a-30d3-b127-5ad854cc2c98",
                        "source_sense_id": "90d35eee-22a8-398f-b2e8-4ce61e4292a9",
                        "target_lang_word": "Hauptgang",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hauptgang",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "920b7618-6696-38ea-b30f-4b400428ea5a",
                                        "entry_id": "d031bee8-9e7a-34ca-8f57-da76ff2a0bd8",
                                        "glosses": [
                                            "nach der Vorspeise und vor dem Nachtisch servierter Gang in einer Speisefolge, der reichhaltiger ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a8d270c5-201d-4f3f-b1b1-f635b65af84a",
                                                "sense_id": "920b7618-6696-38ea-b30f-4b400428ea5a",
                                                "text": "„Nach dem Hauptgang kam, wie meistens, das Gespräch auf Berufliches.“"
                                            },
                                            {
                                                "example_id": "982b3a43-90b1-4585-9f1b-9e80882e0251",
                                                "sense_id": "920b7618-6696-38ea-b30f-4b400428ea5a",
                                                "text": "„Ein Kellner begrüßt uns, stellt die drei Hauptgänge des heutigen Abendessens vor und bittet uns, bereits jetzt zu wählen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4213e413-7753-3e0d-b615-a6d9541f14c1",
                                        "entry_id": "d031bee8-9e7a-34ca-8f57-da76ff2a0bd8",
                                        "glosses": [
                                            "zentraler Gang in einem Gebäude, von dem Seitengänge abzweigen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11c42fe1-665a-43ce-bc67-451d5d9a56c2",
                                                "sense_id": "4213e413-7753-3e0d-b615-a6d9541f14c1",
                                                "text": "Der Hauptgang im obersten Geschoss der Firmenzentrale wird gegenwärtig renoviert."
                                            },
                                            {
                                                "example_id": "6cb8e502-cb90-46ca-98ca-5d7f85c5d911",
                                                "sense_id": "4213e413-7753-3e0d-b615-a6d9541f14c1",
                                                "text": "„Ich ging wieder in den Hauptgang und dann den nächsten Graben vor nach der vorderen Stellung, die neu angelegt war und daher ordentlicher aussah.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
