                "senses": [
                    {
                        "sense_id": "3c502c3d-c864-3e03-828e-536dbba0551a",
                        "entry_id": "ae376b22-3960-35e2-9862-cea802867dff",
                        "glosses": [
                            "Ausstellung von Werken dreier Künstlerinnen und/oder Künstler"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5be5e43c-4192-4d33-9d79-94ce5c725ffd",
                                "sense_id": "3c502c3d-c864-3e03-828e-536dbba0551a",
                                "text": "„Leiter Christopher Naumann hat dafür das im ehemaligen Schwedenhof eingeführte Verfahren der Tripelausstellung, sprich der gleichzeitigen Präsentation von drei Künstlern, neu aufgelegt.“"
                            },
                            {
                                "example_id": "0327bc5d-ff72-4b21-a6c6-dd9b2b20d961",
                                "sense_id": "3c502c3d-c864-3e03-828e-536dbba0551a",
                                "text": "„Durch die lange Umbauphase hat sich gewissermaßen auch ein Kunststau gebildet, der sich durch eine Tripelausstellung auflösen wird.“"
                            },
                            {
                                "example_id": "aa93385f-bc99-4545-a37d-747f4705c03a",
                                "sense_id": "3c502c3d-c864-3e03-828e-536dbba0551a",
                                "text": "„Die grosse Tripelausstellung über Geschichte und Schaffen von Tessiner Baukünstlern im Zarenreich, die vom 27. November 1994 bis zum 26. Februar 1995 gleichzeitig in zwei Museen Luganos und im Museo di Malcantone in Curio gezeigt wurde, hat zwar die Bedeutung…“"
                            },
                            {
                                "example_id": "3940152d-c95f-456f-b6e7-62c0b3f6d8a9",
                                "sense_id": "3c502c3d-c864-3e03-828e-536dbba0551a",
                                "text": "„Tripel-Ausstellung im Vebikus: Hurter, Mamet und Sauter. Surreal, bunt und sakral. Drei Künstler - eine Ausstellung.“"
                            },
                            {
                                "example_id": "6ada7261-5304-4978-a568-b0c2c98edc31",
                                "sense_id": "3c502c3d-c864-3e03-828e-536dbba0551a",
                                "text": "„Was besticht an der Tripel-Ausstellung von Shahryar Nashat, Marc Bauer und Alexia Walther im Kunstmuseum Solothurn, ist die emotionale Dichte, die einem roten Faden gleich die drei vernetzten Geschichten durchzieht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
