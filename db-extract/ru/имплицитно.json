                                                "example_id": "1886e57e-3dbc-4108-8372-3958044008cf",
                                                "sense_id": "e090fb6f-c369-381d-aca7-8640ce9e7ca9",
                                                "text": "tell someone implicitly"
                                            },
                                            {
                                                "example_id": "39a410a1-3423-4055-ab80-1f165a5ea04d",
                                                "sense_id": "e090fb6f-c369-381d-aca7-8640ce9e7ca9",
                                                "text": "He was punished for asking for answers implicitly during the exam."
