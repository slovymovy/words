                "forms": [
                    {
                        "form_id": "2b4a7352-4fe7-46bd-97a6-10a5f4ab3434",
                        "entry_id": "e152e7c6-cac2-3687-8fae-597d7ecc3766",
                        "tags": [],
                        "form": "à compte"
                    },
                    {
                        "form_id": "71b8ea05-24a6-4c81-a2ce-c299c33d2fc3",
                        "entry_id": "e152e7c6-cac2-3687-8fae-597d7ecc3766",
                        "tags": [],
                        "form": "à-compte"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "08642efd-02af-3256-a3cc-1bc3098843c2",
                        "entry_id": "e152e7c6-cac2-3687-8fae-597d7ecc3766",
                        "glosses": [
                            "Somme d’argent versée dès la signature d’un contrat, et enlevant toute possibilité de dédit."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "08b6ef36-293a-4f33-85b4-ebff0ebf16bf",
                                "sense_id": "08642efd-02af-3256-a3cc-1bc3098843c2",
                                "text": "Un acompte implique un engagement ferme."
                            },
                            {
                                "example_id": "fa809e77-5b1a-416e-b4f9-ff9474048eb0",
                                "sense_id": "08642efd-02af-3256-a3cc-1bc3098843c2",
                                "text": "L’acompte est un premier versement à valoir sur l’achat."
                            },
                            {
                                "example_id": "54a0ff1e-e170-417e-849a-4ae7eccc146a",
                                "sense_id": "08642efd-02af-3256-a3cc-1bc3098843c2",
                                "text": "Je ne peux annuler cette réservation, j’ai versé un acompte."
                            },
                            {
                                "example_id": "e18fbdd1-16e1-4972-9bcd-93cdd29002c3",
                                "sense_id": "08642efd-02af-3256-a3cc-1bc3098843c2",
                                "text": "Au moment du paiement du prix, l’acompte a vocation à représenter une partie du prix, payée de façon anticipée, qui vient en déduction du montant total du contrat."
                            }
                        ]
                    },
                    {
                        "sense_id": "a601e334-11d3-36b1-904b-6b1fca95a8bc",
                        "entry_id": "e152e7c6-cac2-3687-8fae-597d7ecc3766",
                        "glosses": [
                            "Prémices d’une action encore à venir."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "fb8665bf-56d6-4aaa-a869-ad5788ba37b7",
                                "sense_id": "a601e334-11d3-36b1-904b-6b1fca95a8bc",
                                "text": "La marche et ce premier effort l’avaient creusé, il pouvait bien prendre un petit acompte sur son repas de midi."
                            },
                            {
                                "example_id": "282e9d1f-1352-4c5e-a6af-a094723bd196",
                                "sense_id": "a601e334-11d3-36b1-904b-6b1fca95a8bc",
                                "text": "Il a surgi dans la cour en nous annonçant qu’il montait à Bruxelles casser la tronche de Lucas. Colombe s’est cabrée et Mehdi a décoché une droite à Paul, le meilleur ami de Lucas, comme s’il s’agissait d’un acompte."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a6f26cd9-e95b-4552-ace2-5dc73bf4066e",
                        "source_entry_id": "e152e7c6-cac2-3687-8fae-597d7ecc3766",
                        "source_sense_id": "08642efd-02af-3256-a3cc-1bc3098843c2",
                        "source_sense_description": "Somme d’argent versée dès la signature d’un contrat, et enlevant toute possibilité de dédit",
                        "target_lang_word": "Anzahlung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Anzahlung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5a78b513-a56c-32fb-a6f3-f355eacc3e8c",
                                        "entry_id": "6ebf38af-1aa8-3f84-97e6-818e24a76c84",
                                        "glosses": [
                                            "Zahlung des ersten Teiles eines Gesamtbetrages"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db0b066b-882e-441f-bfdd-4b1831c01dde",
                                                "sense_id": "5a78b513-a56c-32fb-a6f3-f355eacc3e8c",
                                                "text": "Anzahlungen müssen häufig bei Abschluss eines Kaufvertrages geleistet werden."
                                            },
                                            {
                                                "example_id": "eda2bfb4-a0c3-43e9-abe4-55a16bc47590",
                                                "sense_id": "5a78b513-a56c-32fb-a6f3-f355eacc3e8c",
                                                "text": "„Wir zahlen die Hälfte der Anzahlung sofort zurück.“"
                                            },
                                            {
                                                "example_id": "99c3843b-a670-4aa9-94f0-2b99bc52ae43",
                                                "sense_id": "5a78b513-a56c-32fb-a6f3-f355eacc3e8c",
                                                "text": "„Obwohl regelmäßig Subskriptionen und Anzahlungen von gespannten Lesern eingingen, war Sylvia ständig knapp bei Kasse, zumal die Druckkosten mit jeder neuen Durchsicht von Joyce stiegen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "051edf2a-8675-40b6-b615-86320dd1a796",
                        "source_entry_id": "e152e7c6-cac2-3687-8fae-597d7ecc3766",
                        "source_sense_id": "08642efd-02af-3256-a3cc-1bc3098843c2",
                        "source_sense_description": "Somme d’argent versée dès la signature d’un contrat, et enlevant toute possibilité de dédit",
                        "target_lang_word": "down payment",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "down payment",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8086e29e-59dc-3bf8-8f2c-4a404b39ca3c",
                                        "entry_id": "1eaddba5-4650-37df-a193-d02aaf0d6a80",
                                        "glosses": [
                                            "A payment representing a fraction of the price of something being purchased, made to secure the right to continue making payments towards that purchase."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e1663417-04ad-3d47-9e97-114e7ba6558c",
                                        "entry_id": "1eaddba5-4650-37df-a193-d02aaf0d6a80",
                                        "glosses": [
                                            "Any initial commitment signifying an intention to carry out a larger future commitment, even though no legal rights or obligations are secured."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ffc045f5-eaa4-4edf-9783-e8721228f9c8",
                                                "sense_id": "e1663417-04ad-3d47-9e97-114e7ba6558c",
                                                "text": "Her parents considered her school tuition a down payment on her future."
                                            },
                                            {
                                                "example_id": "8b83e26b-af59-4843-88e5-baf53c3d1b95",
                                                "sense_id": "e1663417-04ad-3d47-9e97-114e7ba6558c",
                                                "text": "After decades of empty rhetoric, that's the down payment that we need on energy independence."
                                            },
                                            {
                                                "example_id": "b1faac3f-d5da-4ccf-92f7-19a7f485e364",
                                                "sense_id": "e1663417-04ad-3d47-9e97-114e7ba6558c",
                                                "text": "2009 April 4, Barack Obama, NATO summit\nThese commitments of troops, trainers, and civilians represent a strong down payment on the future of our mission in Afghanistan and on the future of NATO."
                                            },
                                            {
                                                "example_id": "92b9507b-1a25-46f7-901d-af347cfeda20",
                                                "sense_id": "e1663417-04ad-3d47-9e97-114e7ba6558c",
                                                "text": "After all, when you buy a car, you're making a large down payment on future journeys - buying an annual rail pass or railcard should be no different."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
