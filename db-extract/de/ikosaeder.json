                                        "sense_id": "572a4a1b-a750-3017-81d7-dabdda740183",
                                        "entry_id": "a43afa09-fb1c-3650-bc81-6f515d6662fc",
                                        "glosses": [
                                            "A polyhedron with twenty faces."
                                        ],
