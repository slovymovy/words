    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "63abfecc-9316-3fd7-9bed-d1b3ec068437",
                    "sense_definition": "Engagement verbal ou écrit pris envers quelqu'un d'accomplir ou de ne pas accomplir quelque chose.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "engagement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il est toujours essentiel de tenir sa <w>promesse</w> quand on s'engage auprès d'un ami."
                        },
                        {
                            "text": "Elle a fait la <w>promesse</w> solennelle de revenir aider sa famille dès que possible."
                        }
                    ],
                    "synonyms": [
                        "engagement",
                        "serment",
                        "parole"
                    ],
                    "common_phrases": [
                        "tenir sa promesse",
                        "faire une promesse",
                        "rompre sa promesse"
                    ]
                },
                {
                    "sense_id": "9066ce1e-9b9b-3a87-ae02-e02d284cd819",
                    "sense_definition": "Indice ou espérance favorable de ce qui va arriver ou se réaliser.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "esperance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce premier roman très original est plein de <w>promesses</w> pour la carrière de l'auteur."
                        },
                        {
                            "text": "Le ciel parfaitement dégagé offre la douce <w>promesse</w> d'un magnifique coucher de soleil."
                        }
                    ],
                    "synonyms": [
                        "espoir",
                        "perspective"
                    ],
                    "common_phrases": [
                        "plein de promesses",
                        "riche de promesses"
                    ]
                },
                {
                    "sense_id": "9c3e0195-28a8-3da1-817d-2195f11767ec",
                    "sense_definition": "Convention ou acte juridique préalable par lequel une personne s'oblige formellement envers une autre.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "engagement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les futurs acheteurs ont signé une <w>promesse</w> de vente devant le notaire hier après-midi."
                        },
                        {
                            "text": "Le candidat a reçu une <w>promesse</w> d'embauche avant la rédaction de son contrat officiel."
                        }
                    ],
                    "synonyms": [
                        "convention",
                        "obligation"
                    ],
                    "common_phrases": [
