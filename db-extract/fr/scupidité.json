                        "examples": [
                            {
                                "example_id": "de1ce68d-7912-427f-ac16-a8b8569edcb2",
                                "sense_id": "1748c013-104c-3cad-861a-db2e2d47ae95",
                                "text": "Contraction de Stupidité et Cupidité, la scupidité qualifie les comportements humains irrationnels, égoïstes, uniquement guidé par l'appât du gain et le profit immédiat."
                            },
                            {
                                "example_id": "5134a003-ef6f-4691-9cf2-48d7ef38ec99",
                                "sense_id": "1748c013-104c-3cad-861a-db2e2d47ae95",
                                "text": "Les conséquences de la scupidité sont visibles partout : changement climatique, pollution, fraude à grande échelle, esclavage des populations, destruction d’écosystèmes, guerres, corruption et bien d’autres."
