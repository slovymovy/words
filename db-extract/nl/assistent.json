                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7a45635d-b254-439f-865c-c3e1060fb564",
                                                "sense_id": "10bd5a88-0013-3a23-8f51-5b551bca1b3c",
                                                "text": "Mit der SSIS-Toolbox kann man durch die Verwendung von Quellen- und Ziel-Assistenten das Einlesen von Daten in die MSSQL-Datenbank automatisieren."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
