{
    "word_family": [
        "devastate",
        "devastating",
        "devastation",
        "devastator"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "5315eb70-e6c2-35ea-b360-fd7b95e520db",
                    "sense_definition": "Extremely upset, shocked, and distressed by bad news or grief.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "emotional_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mary Ann was <w>devastated</w> when she found out her son was bullying a girl at school.",
                            "target_lang_translations": {
                                "ru": "Мэри Энн была <w>раздавлена</w>, когда узнала, что её сын травил девочку в школе."
                            }
                        },
                        {
                            "text": "He was absolutely <w>devastated</w> by the sudden news of his friend's passing.",
                            "target_lang_translations": {
                                "ru": "Он был совершенно <w>опустошён</w> внезапным известием о кончине своего друга."
                            }
                        }
                    ],
                    "synonyms": [
                        "heartbroken",
                        "shattered",
                        "crushed"
                    ],
                    "common_phrases": [
                        "absolutely devastated",
                        "completely devastated"
                    ],
                    "target_lang_definitions": {
                        "ru": "Крайне расстроенный, шокированный, раздавленный горем или плохими новостями."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "опустошённый",
                                "target_lang_sense_clarification": "чувствующий душевную пустоту от горя или потрясения"
                            },
                            {
                                "target_lang_word": "раздавленный",
                                "target_lang_sense_clarification": "сломленный тяжелым переживанием или горем"
                            },
                            {
                                "target_lang_word": "потрясённый",
                                "target_lang_sense_clarification": "глубоко поражённый неприятным известием"
                            },
                            {
                                "target_lang_word": "безутешный",
                                "target_lang_sense_clarification": "не находящий утешения от сильной скорби"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e1cd6f63-7892-32c6-9fe4-83b89f763add",
                    "sense_definition": "Completely destroyed, ruined, or ravaged.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "destruction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Rescue teams searched through the <w>devastated</w> city for possible survivors after the earthquake.",
                            "target_lang_translations": {
                                "ru": "Спасательные команды искали выживших в <w>разрушенном</w> после землетрясения городе."
                            }
                        },
                        {
                            "text": "The hurricane left behind a <w>devastated</w> landscape of flattened trees and collapsed buildings.",
                            "target_lang_translations": {
                                "ru": "Ураган оставил после себя <w>опустошённый</w> пейзаж с поваленными деревьями и рухнувшими зданиями."
                            }
                        }
                    ],
                    "synonyms": [
                        "ruined",
                        "destroyed",
                        "ravaged"
                    ],
                    "antonyms": [
                        "intact"
                    ],
                    "common_phrases": [
                        "devastated area",
                        "devastated region"
                    ],
                    "target_lang_definitions": {
                        "ru": "Полностью разрушенный, разоренный или стёртый с лица земли."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "опустошённый",
                                "target_lang_sense_clarification": "разорённый бедствием, войной или стихией"
                            },
                            {
                                "target_lang_word": "разорённый",
                                "target_lang_sense_clarification": "подвергшийся разрушению или разграблению"
                            },
                            {
                                "target_lang_word": "разрушенный",
                                "target_lang_sense_clarification": "превращённый в руины"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c16b4419-6979-33af-b430-bafaa6856f85",
                    "sense_definition": "Simple past and past participle of <w>devastate</w>.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "inflection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The massive wildfire <w>devastated</w> thousands of acres of forest within days.",
                            "target_lang_translations": {
                                "ru": "Масштабный лесной пожар за считанные дни <w>опустошил</w> тысячи акров леса."
                            }
                        },
                        {
                            "text": "Severe floods have <w>devastated</w> farmlands across the entire valley this spring.",
                            "target_lang_translations": {
                                "ru": "Этой весной сильные наводнения <w>разорили</w> сельскохозяйственные угодья по всей долине."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense and past participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Форма прошедшего времени и причастие прошедшего времени от глагола devastate (опустошать, разорять)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "опустошил",
                                "target_lang_sense_clarification": "прошедшее время: разорил, сжёг, уничтожил"
                            },
                            {
                                "target_lang_word": "разорил",
                                "target_lang_sense_clarification": "прошедшее время: нанёс огромный ущерб"
                            },
                            {
                                "target_lang_word": "опустошённый",
                                "target_lang_sense_clarification": "страдательное причастие прошедшего времени"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}