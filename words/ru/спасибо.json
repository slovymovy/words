{
    "word_family": [
        "спасать",
        "спасение",
        "спаситель"
    ],
    "entries": [
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "624214ef-7b90-3ef6-8136-d208dae87f52",
                    "sense_definition": "Слово, которое используют для выражения благодарности за помощь, услугу, внимание или подарок.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "gratitude_expression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Большое <w>спасибо</w> за твой прекрасный подарок на день рождения.",
                            "target_lang_translations": {
                                "en": "<w>Thank you</w> very much for your wonderful birthday gift.",
                                "zh": "非常<w>谢谢</w>你送的精美生日礼物。"
                            }
                        },
                        {
                            "text": "Я хочу сказать тебе <w>спасибо</w> за помощь в трудную минуту.",
                            "target_lang_translations": {
                                "en": "I want to say <w>thank you</w> for your help during a difficult time.",
                                "zh": "我想对你说声<w>谢谢</w>，感谢你在困难时刻给予的帮助。"
                            }
                        },
                        {
                            "text": "Всем <w>спасибо</w> за внимание, лекция окончена.",
                            "target_lang_translations": {
                                "en": "<w>Thank you</w> all for your attention, the lecture is over.",
                                "zh": "<w>谢谢</w>大家的聆听，讲座到此结束。"
                            }
                        }
                    ],
                    "synonyms": [
                        "благодарю",
                        "мерси"
                    ],
                    "common_phrases": [
                        "большое спасибо",
                        "огромное спасибо",
                        "спасибо за помощь",
                        "заранее спасибо",
                        "спасибо за внимание"
                    ],
                    "target_lang_definitions": {
                        "en": "A word used to express gratitude for help, a service, attention, or a gift.",
                        "zh": "用于表达对帮助、服务、关心或礼物的感激之情的词。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "thank you",
                                "target_lang_sense_clarification": "standard, polite expression of gratitude"
                            },
                            {
                                "target_lang_word": "thanks",
                                "target_lang_sense_clarification": "informal expression of gratitude"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "谢谢",
                                "target_lang_sense_clarification": "标准的、礼貌的感谢表达"
                            },
                            {
                                "target_lang_word": "多谢",
                                "target_lang_sense_clarification": "较正式或强调程度的感谢"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "37b53d55-0e54-3aa9-bfe9-90d320798539",
                    "sense_definition": "Слова благодарности или признательности, рассматриваемые как существительное (что?).",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "gratitude_expression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он ушёл молча, не сказав нам даже простого человеческого <w>спасибо</w>.",
                            "target_lang_translations": {
                                "en": "He left silently, without even saying a simple human <w>thank you</w> to us.",
                                "zh": "他沉默地离开了，甚至没对我们说一句简单的<w>谢意</w>。"
                            }
                        },
                        {
                            "text": "Я не жду от них никакого <w>спасибо</w> за эту сложную работу.",
                            "target_lang_translations": {
                                "en": "I don't expect any <w>thanks</w> from them for this hard work.",
                                "zh": "对于这项艰巨的工作，我并不指望从他们那里得到任何<w>感谢</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "ждать спасиба",
                        "сказать спасибо",
                        "услышать спасибо",
                        "вместо спасиба"
                    ],
                    "target_lang_definitions": {
                        "en": "Words of gratitude or appreciation, considered as a noun.",
                        "zh": "被视为名词的感谢或感激的话语。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "thank you",
                                "target_lang_sense_clarification": "the act or instance of thanking"
                            },
                            {
                                "target_lang_word": "thanks",
                                "target_lang_sense_clarification": "expression of appreciation"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "谢意",
                                "target_lang_sense_clarification": "表示感谢的心意或话语"
                            },
                            {
                                "target_lang_word": "感谢",
                                "target_lang_sense_clarification": "作为名词指代感谢的行为或话语"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "conjunction",
            "senses": [
                {
                    "sense_id": "a7e84248-3d07-393b-8d12-857091fa6ce5",
                    "sense_definition": "Слово, выражающее удовлетворение тем, что произошло; используется в значении «хорошо, что» или «к счастью».",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Спасибо</w>, дождь закончился, и мы смогли пойти гулять в парк.",
                            "target_lang_translations": {
                                "en": "<w>Thank goodness</w> the rain stopped, and we were able to go for a walk in the park.",
                                "zh": "<w>幸好</w>雨停了，我们才能去公园散步。"
                            }
                        },
                        {
                            "text": "<w>Спасибо</w> ещё, что мы успели купить билеты на последний поезд.",
                            "target_lang_translations": {
                                "en": "<w>It's a good thing</w> that we managed to buy tickets for the last train.",
                                "zh": "<w>好在</w>我们赶上了买最后那班火车的票。"
                            }
                        }
                    ],
                    "synonyms": [
                        "хорошо, что"
                    ],
                    "common_phrases": [
                        "спасибо, что",
                        "спасибо ещё"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "прост."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A word expressing satisfaction with an outcome; used to mean \"it is good that\" or \"fortunately\".",
                        "zh": "表达对结果感到满意；意为“幸好”或“好在”。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "thank goodness",
                                "target_lang_sense_clarification": "expression of relief or satisfaction"
                            },
                            {
                                "target_lang_word": "fortunately",
                                "target_lang_sense_clarification": "indicating a lucky outcome"
                            },
                            {
                                "target_lang_word": "luckily",
                                "target_lang_sense_clarification": "by good fortune"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "幸好",
                                "target_lang_sense_clarification": "表示对幸运结果的庆幸"
                            },
                            {
                                "target_lang_word": "好在",
                                "target_lang_sense_clarification": "表示对有利情况的庆幸"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}