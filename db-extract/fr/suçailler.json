                "senses": [
                    {
                        "sense_id": "9200928f-a77b-32b8-923b-f1cfbcb81a60",
                        "entry_id": "506c4452-d611-3799-8fae-11ad919684c2",
                        "glosses": [
                            "Sucer, manger en suçant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "116a5b39-4ded-422c-b443-7689cfbdcd69",
                                "sense_id": "9200928f-a77b-32b8-923b-f1cfbcb81a60",
                                "text": "Cette affection était quand même très intime ? reprit Gassin en agrippant un brin d’herbe qu’il se mit à suçailler."
                            },
                            {
                                "example_id": "21f7d5a7-cd6c-414b-b305-a33b5d3e4e58",
                                "sense_id": "9200928f-a77b-32b8-923b-f1cfbcb81a60",
                                "text": "Et en attendant ta réduction, qu’allons-nous suçailler ?"
                            },
                            {
                                "example_id": "1c8be1b9-dba3-46ed-bb8b-c657df0b358c",
                                "sense_id": "9200928f-a77b-32b8-923b-f1cfbcb81a60",
                                "text": "Il arracha une fleur gorgée d’eau au rebord du talus et en suçailla la tige entre ses dents."
                            }
                        ]
                    }
