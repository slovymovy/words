                "senses": [
                    {
                        "sense_id": "8de01a03-2c16-390b-8268-112201c19835",
                        "entry_id": "7d58a5b9-2087-3841-9fc1-01395260a19d",
                        "glosses": [
                            "to deliver, to hand in, to hand over"
                        ],
                        "tags": [
                            "perfective",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "5159085b-cfa1-4cda-a801-bbae73de1a58",
                                "sense_id": "8de01a03-2c16-390b-8268-112201c19835",
                                "text": "Учи́тель сказа́л сдать сочине́ния.",
                                "translation": "The teacher told us to turn in our compositions .",
                                "english": "The teacher told us to turn in our compositions ."
                            }
                        ]
                    },
                    {
                        "sense_id": "5d067a30-3fea-39cf-a1bc-8b15007da6f7",
                        "entry_id": "7d58a5b9-2087-3841-9fc1-01395260a19d",
                        "glosses": [
                            "to return, to turn in"
                        ],
                        "tags": [
                            "perfective",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "97fab429-85aa-4a3c-b89a-2190ca73535a",
                                "sense_id": "5d067a30-3fea-39cf-a1bc-8b15007da6f7",
                                "text": "сдать ве́щи в бага́ж",
                                "translation": "to check/register one's luggage",
                                "english": "to check/register one's luggage"
                            },
                            {
                                "example_id": "9769f4af-1dd9-4f87-a381-e37c42331873",
                                "sense_id": "5d067a30-3fea-39cf-a1bc-8b15007da6f7",
                                "text": "сдать дела",
                                "translation": "to turn over one's duties",
                                "english": "to turn over one's duties"
                            },
                            {
                                "example_id": "bfbf2915-a359-4469-8397-3fdad623206b",
                                "sense_id": "5d067a30-3fea-39cf-a1bc-8b15007da6f7",
                                "text": "сдать внаем",
                                "translation": "to let, to let out, to hire out",
                                "english": "to let, to let out, to hire out"
                            },
                            {
                                "example_id": "c48b048a-69d8-49b3-a585-5254e92a0451",
                                "sense_id": "5d067a30-3fea-39cf-a1bc-8b15007da6f7",
                                "text": "сдать в аре́нду",
                                "translation": "to lease (out), to grant on lease (out), to rent (out)",
                                "english": "to lease (out), to grant on lease (out), to rent (out)"
                            }
                        ]
                    },
                    {
                        "sense_id": "8204db61-0580-3405-b61e-7500be2d3236",
                        "entry_id": "7d58a5b9-2087-3841-9fc1-01395260a19d",
                        "glosses": [
                            "to surrender, to yield"
                        ],
                        "tags": [
                            "intransitive",
                            "perfective",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "be18d21f-0fd1-48a8-9cd7-73ef7f42fa29",
                                "sense_id": "8204db61-0580-3405-b61e-7500be2d3236",
                                "text": "Проти́вник сдал го́род без бо́я.",
                                "translation": "The enemy surrendered the town without a fight.",
                                "english": "The enemy surrendered the town without a fight."
                            }
                        ]
                    },
                    {
                        "sense_id": "e1fc68b0-4a10-3035-801f-e5bc9a5cbad5",
                        "entry_id": "7d58a5b9-2087-3841-9fc1-01395260a19d",
                        "glosses": [
                            "to deal"
                        ],
                        "tags": [
                            "intransitive",
                            "perfective",
                            "transitive"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "fc3b8fa3-4227-3fb0-b44e-e760a4725d28",
                        "entry_id": "7d58a5b9-2087-3841-9fc1-01395260a19d",
                        "glosses": [
                            "to take/pass, to usually about an exam"
                        ],
                        "tags": [
                            "intransitive",
                            "perfective",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "3ffb5286-2b8e-4e73-a72a-ed590de4996b",
                                "sense_id": "fc3b8fa3-4227-3fb0-b44e-e760a4725d28",
                                "text": "Пе́тька сдал экза́мен без осо́бых уси́лий.",
                                "translation": "Peter passed the exam without much effort.",
                                "english": "Peter passed the exam without much effort."
                            }
                        ]
                    },
                    {
                        "sense_id": "678ae024-253e-3209-b8f3-2e336ff64ee1",
                        "entry_id": "7d58a5b9-2087-3841-9fc1-01395260a19d",
                        "glosses": [
                            "to be weakened, to be in a reduced state"
                        ],
                        "tags": [
                            "perfective"
                        ],
                        "examples": [
                            {
                                "example_id": "0b26febd-f412-454e-94b3-2d9e6bee6262",
                                "sense_id": "678ae024-253e-3209-b8f3-2e336ff64ee1",
                                "text": "Твой оте́ц совсе́м сдал.",
                                "translation": "Your father's health declined a lot.",
                                "english": "Your father's health declined a lot."
                            }
                        ]
                    },
                    {
                        "sense_id": "fd5020c2-f4fa-37e3-98fb-1784272da683",
                        "entry_id": "7d58a5b9-2087-3841-9fc1-01395260a19d",
                        "glosses": [
                            "to move back a bit (like while driving)"
                        ],
                        "tags": [
                            "perfective"
                        ],
                        "examples": [
                            {
                                "example_id": "dd75421b-33c2-47f2-a858-f901dab72458",
                                "sense_id": "fd5020c2-f4fa-37e3-98fb-1784272da683",
                                "text": "Что́бы поверну́ть ну́жно бы́ло снача́ла сдать наза́д.",
                                "translation": "In order to turn he first had to move backwards a bit.",
                                "english": "In order to turn he first had to move backwards a bit."
                            }
                        ]
                    }
