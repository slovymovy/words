                "senses": [
                    {
                        "sense_id": "26d57cd6-4be2-3837-a422-4c1515dca3ea",
                        "entry_id": "981eaaaa-5a07-3689-a0f6-55688ba2dced",
                        "glosses": [
                            "Celui qui embrouille, qui jette la confusion dans les choses dont il se mêle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cc2f431b-8637-4e74-ba7c-2eb041fa1f34",
                                "sense_id": "26d57cd6-4be2-3837-a422-4c1515dca3ea",
                                "text": "Dans sa polémique contre Goetze, a-t-il été autre chose qu’un embrouilleur de questions ?"
                            },
                            {
                                "example_id": "2d2ccf43-e69c-4bdb-a150-437143e31400",
                                "sense_id": "26d57cd6-4be2-3837-a422-4c1515dca3ea",
                                "text": "Joueurs de flûte, embrouilleurs de mots, jongleurs lyriques et coloristes, exécuteurs de variations séduisantes, ce n'est ni avec de l'esprit ni avec de la fantaisie qu'on fait de la description vivante."
                            },
                            {
                                "example_id": "0d3cff76-efab-43d2-b830-4b34167f6742",
                                "sense_id": "26d57cd6-4be2-3837-a422-4c1515dca3ea",
                                "text": "Oui, j’ai changé d’avis sur Longoria. J’ai été très dur avec lui, j’avais l’impression qu’il était à côté de la plaque et que c’était un embrouilleur."
                            }
                        ]
                    }
                ],
