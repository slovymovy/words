                                    {
                                        "sense_id": "efae1c5c-3cf2-3d2f-a441-0ec3a19bdb22",
                                        "entry_id": "bc51a0c7-f654-3f68-885a-3715995f2342",
                                        "glosses": [
                                            "A newly hatched bird, reptile or other animal that has emerged from an egg."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15804fd9-cebc-4375-beab-c72c6d724beb",
                                                "sense_id": "efae1c5c-3cf2-3d2f-a441-0ec3a19bdb22",
                                                "text": "The hatchling alligator had just broken out of its shell but was already trying to follow its mother, who hunted hatchling birds."
                                            },
                                            {
                                                "example_id": "beb5b607-ecff-4984-a086-db114ef172c5",
                                                "sense_id": "efae1c5c-3cf2-3d2f-a441-0ec3a19bdb22",
                                                "text": "Hatchling nautiluses emerge, after nearly a year's gestation, as miniature adults and then immediately start swimming around, searching for food in the depths."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f2ace618-b6f3-335a-a913-7a4f9ae6b240",
                                        "entry_id": "bc51a0c7-f654-3f68-885a-3715995f2342",
                                        "glosses": [
                                            "A person who has (especially recently) realized that they are transgender."
                                        ],
