                    }
                ],
                "senses": [
                    {
                        "sense_id": "9adab226-08e9-3591-8e28-e7744df95802",
                        "entry_id": "be754705-63a2-3295-8306-943d2bad5266",
                        "glosses": [
                            "Qui est à bord d’une embarcation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "11ebe00d-b0db-4a31-a663-457a6c56279e",
                                "sense_id": "9adab226-08e9-3591-8e28-e7744df95802",
                                "text": "RÈGLEMENT I. — Des médecins embarqués, leurs attributions, leurs devoirs."
                            }
                        ]
                    },
                    {
                        "sense_id": "453b9bfe-70ac-332f-86dc-4c11738536fe",
                        "entry_id": "be754705-63a2-3295-8306-943d2bad5266",
                        "glosses": [
                            "Qui est à bord d’un véhicule."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "d99a87b2-40e4-4e0b-a70c-7ac8c5e05aa3",
                                "sense_id": "453b9bfe-70ac-332f-86dc-4c11738536fe",
                                "text": "la caméra embarquée d'un autre automobiliste."
                            }
                        ]
                    },
                    {
                        "sense_id": "16672b08-f5ec-3939-85ad-ec5247d11906",
                        "entry_id": "be754705-63a2-3295-8306-943d2bad5266",
                        "glosses": [
                            "Intégré de façon indissociable à un matériel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc139cab-9e03-41da-ba89-ee2ddc24ee3a",
                                "sense_id": "16672b08-f5ec-3939-85ad-ec5247d11906",
                                "text": "Les systèmes d’évitement des collisions sont des mesures préventives et pré-accident destinées à améliorer la sécurité du trafic. Ils peuvent être répartis en trois grandes catégories : systèmes embarqués, installés sur l’infrastructure et coopératifs."
                            }
                        ]
                    },
                    {
                        "sense_id": "7e216955-6a4f-3e07-b5e0-23c159be6a54",
                        "entry_id": "be754705-63a2-3295-8306-943d2bad5266",
                        "glosses": [
                            "Qui est encadré par des personnes armées qui peuvent en assurer la protection mais aussi contrôler son travail de façon plus ou moins volontaire ou subtile."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "72452474-5ed3-407b-a932-26d8ccdf81f1",
                                "sense_id": "7e216955-6a4f-3e07-b5e0-23c159be6a54",
                                "text": "Les groupes médiatiques ont dû reconstruire leur réseau de reporters à l’étranger, en le peuplant presque uniquement de correspondants de guerre, souvent « embarqués » (embedded), ce qui renoue les tensions entre objectivité et patriotisme."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e0d73383-9eec-47d2-a210-ea3727130911",
                        "source_entry_id": "be754705-63a2-3295-8306-943d2bad5266",
                        "source_sense_description": "Qui est à bord d’une embarcation. Par extension, à bord d’un véhicule",
                        "target_lang_word": "on board",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "on board",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c6b28cbf-3024-3a87-86c0-09f29979ac31",
                                        "entry_id": "e6580bf0-cb60-3df2-823c-1e6b8a93cbed",
                                        "glosses": [
                                            "On or in a means of transportation."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e35df786-7555-4158-ab10-0c279f818541",
                                                "sense_id": "c6b28cbf-3024-3a87-86c0-09f29979ac31",
                                                "text": "Baby on board"
                                            },
                                            {
                                                "example_id": "6a1701c6-ff71-4fbc-9791-6de3b7bd6d93",
                                                "sense_id": "c6b28cbf-3024-3a87-86c0-09f29979ac31",
                                                "text": "Even when I am on board the plane, I can never feel secure that my luggage is, too."
                                            },
                                            {
                                                "example_id": "6c14c443-e96a-4f5a-adf5-32c00b8150f7",
                                                "sense_id": "c6b28cbf-3024-3a87-86c0-09f29979ac31",
                                                "text": "There is an hour or two, after the passengers have embarked, which is disquieting and fussy. Mail bags, so I understand, are being put on board. Stewards, carrying cabin trunks, swarm in the corridors. Passengers wander restlessly about or hurry, with futile energy, from place to place."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3b28188d-cc3c-3ec6-b525-9edc700e1a28",
                                        "entry_id": "e6580bf0-cb60-3df2-823c-1e6b8a93cbed",
                                        "glosses": [
                                            "Joining in or participating."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f23a11d8-4a6c-48e3-915f-dea1aed63f9a",
                                                "sense_id": "3b28188d-cc3c-3ec6-b525-9edc700e1a28",
                                                "text": "Is that new teammate properly on board yet?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "65440ff9-04d8-3f59-99ce-d68007739d19",
                                        "entry_id": "e6580bf0-cb60-3df2-823c-1e6b8a93cbed",
                                        "glosses": [
                                            "Agreeing or supporting."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4d3968fe-515b-4817-bdeb-02154eaa3aaf",
                                                "sense_id": "65440ff9-04d8-3f59-99ce-d68007739d19",
                                                "text": "It's a good idea, but let's see if we can get a few more of the management team on board."
                                            },
                                            {
                                                "example_id": "0558fe2b-8573-4c63-87c0-a57bc1fa270b",
                                                "sense_id": "65440ff9-04d8-3f59-99ce-d68007739d19",
                                                "text": "Without management on board, the project has little chance of success."
                                            },
                                            {
                                                "example_id": "5b1c534c-0888-4544-997a-0d08b46a185b",
                                                "sense_id": "65440ff9-04d8-3f59-99ce-d68007739d19",
                                                "text": "The ships' successes made Hitler quite the fan of them, and he supported the idea of more being converted and sent out soon. And so, with the Führer on board, albeit not literally, another six vessels were rapidly placed under conversion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "79f6a95a-5ef0-3a73-9a75-6f3119e0c86c",
                                        "entry_id": "e6580bf0-cb60-3df2-823c-1e6b8a93cbed",
                                        "glosses": [
                                            "Into itself or oneself."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dfe93609-f19e-4430-8889-bc3526616183",
                                                "sense_id": "79f6a95a-5ef0-3a73-9a75-6f3119e0c86c",
                                                "text": "Soccer players certainly tend not to take fluids on board."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "on board",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fe234758-36f3-3c1a-8173-8f4d3ca1bdd1",
                                        "entry_id": "5e374129-f75f-3c51-87bc-0fa9a1f6a375",
                                        "glosses": [
                                            "The stereotypical cry of pirates when boarding a ship for close quarters combat."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "32bf9181-b0ae-4e7e-a01c-7559d898dd7f",
                        "source_entry_id": "be754705-63a2-3295-8306-943d2bad5266",
