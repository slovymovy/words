                "pos": "prep",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "ed78c5d3-1492-3bd1-a5ff-6f078cfaa17c",
                        "entry_id": "64711970-8abf-361e-9966-54aac9e6adc3",
                        "glosses": [
                            "устар. и прост. между"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cd11fbd1-3f02-43ec-be51-cf3dea639a2e",
                        "source_entry_id": "64711970-8abf-361e-9966-54aac9e6adc3",
                        "source_sense_id": "ed78c5d3-1492-3bd1-a5ff-6f078cfaa17c",
                        "target_lang_word": "entre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "entre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b2ec2a5f-09c4-39ea-aede-858be3bf0598",
                                        "entry_id": "a3fd642f-9381-3da9-aefa-dfa11a664046",
                                        "glosses": [
                                            "Au milieu de ou à peu près au milieu de l’espace qui sépare des personnes ou des choses dont on parle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "45308c47-6f0f-4077-9ed4-18ba4ce47370",
                                                "sense_id": "b2ec2a5f-09c4-39ea-aede-858be3bf0598",
                                                "text": "Nous reçûmes l’ordre de côtoyer en le remontant le ruisseau de la Tourbe, qui arrose la plus triste vallée du monde, entre des collines basses, sans arbres et sans buissons."
                                            },
                                            {
                                                "example_id": "edf6ad74-8376-4504-bee1-5bf6f5a4397f",
                                                "sense_id": "b2ec2a5f-09c4-39ea-aede-858be3bf0598",
                                                "text": "Derrière eux vient une litière fermée recouverte de maroquin et pourvue, devant et derrière, de brancards entre lesquels marchent des mules richement harnachées."
                                            },
                                            {
                                                "example_id": "9c2b3724-2415-4f04-9b29-bd8c6dd12003",
                                                "sense_id": "b2ec2a5f-09c4-39ea-aede-858be3bf0598",
                                                "text": "UNE HEURE DIX bloqué entre deux étages. Pour passer le temps, j’ai mangé les contrats!"
                                            },
                                            {
                                                "example_id": "d27782f7-cfda-487b-9f3f-8b4befdc66f1",
                                                "sense_id": "b2ec2a5f-09c4-39ea-aede-858be3bf0598",
                                                "text": "Il se trouvait entre deux extrémités fâcheuses."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "42341a9e-7d45-30b2-b8f0-a1404b837ada",
                                        "entry_id": "a3fd642f-9381-3da9-aefa-dfa11a664046",
                                        "glosses": [
                                            "Dans l’espace enfermé par les extrémités que l’on désigne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "32dc1af5-e9f7-43f9-928b-381761f77bb6",
                                                "sense_id": "42341a9e-7d45-30b2-b8f0-a1404b837ada",
                                                "text": "Avant l’arrivée des Magyars, les Slaves méridionaux occupaient toute la plaine danubienne et le noyau de leur puissance était situé entre le Rab, le Danube et la Drave."
                                            },
                                            {
                                                "example_id": "25bc0563-4685-4c3f-8d9f-9010b7a66f6b",
                                                "sense_id": "42341a9e-7d45-30b2-b8f0-a1404b837ada",
                                                "text": "La distance qu’il y a entre les deux pôles, entre le ciel et la terre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8fa37478-db65-345f-bc50-6b53f9924a41",
                                        "entry_id": "a3fd642f-9381-3da9-aefa-dfa11a664046",
                                        "glosses": [
                                            "Dans, en."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63d4df7a-9bb9-4673-86cd-5c232f666ff9",
                                                "sense_id": "8fa37478-db65-345f-bc50-6b53f9924a41",
                                                "text": "Tenir un enfant entre ses bras."
                                            },
                                            {
                                                "example_id": "41516a6b-62e5-4ee7-b0c1-def2624f271a",
                                                "sense_id": "8fa37478-db65-345f-bc50-6b53f9924a41",
                                                "text": "Je le remettrai entre vos mains."
                                            },
                                            {
                                                "example_id": "f752d42c-cdd8-428b-8285-8607f357587b",
                                                "sense_id": "8fa37478-db65-345f-bc50-6b53f9924a41",
                                                "text": "Cet écrit est demeuré entre mes mains."
                                            },
                                            {
                                                "example_id": "43052c9d-4f3f-4fbb-8a94-abe3bcb7adc4",
                                                "sense_id": "8fa37478-db65-345f-bc50-6b53f9924a41",
                                                "text": "Mon affaire est entre les mains d’un habile avocat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7926c3ec-71b5-393e-8c1d-18bb6b47d0f7",
                                        "entry_id": "a3fd642f-9381-3da9-aefa-dfa11a664046",
                                        "glosses": [
                                            "De."
                                        ],
                                        "tags": [
                                            "Plus rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1fdb3d2a-c622-4b58-90b9-850477da60fa",
                                                "sense_id": "7926c3ec-71b5-393e-8c1d-18bb6b47d0f7",
                                                "text": "On l’a retiré d’entre ses mains."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "acee9fe4-7fe6-39d6-9ed5-b63be9d7acab",
                                        "entry_id": "a3fd642f-9381-3da9-aefa-dfa11a664046",
                                        "glosses": [
                                            "Dans un espace de temps, de durée, qui varie entre les bornes désignées."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71698413-fe09-48bf-8145-5821902055cb",
                                                "sense_id": "acee9fe4-7fe6-39d6-9ed5-b63be9d7acab",
                                                "text": "Je serai chez vous entre onze heures et midi."
                                            },
                                            {
                                                "example_id": "8c761c46-48c4-4b85-bf21-208fa3a82987",
                                                "sense_id": "acee9fe4-7fe6-39d6-9ed5-b63be9d7acab",
                                                "text": "Il s’est écoulé tant d’années entre ces deux époques, entre ces deux événements."
                                            },
                                            {
                                                "example_id": "efc294f6-815e-4e43-996b-0d48baf4e734",
                                                "sense_id": "acee9fe4-7fe6-39d6-9ed5-b63be9d7acab",
                                                "text": "Entre le premier et le second acte."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "857bba6e-439d-3bd5-9aa4-383102f75b8c",
                                        "entry_id": "a3fd642f-9381-3da9-aefa-dfa11a664046",
                                        "glosses": [
                                            "Parmi."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f5a312d0-ebf7-433f-9019-9b2a4e8eabe3",
                                                "sense_id": "857bba6e-439d-3bd5-9aa4-383102f75b8c",
                                                "text": "Il fut trouvé entre les morts."
                                            },
                                            {
                                                "example_id": "1501b068-8551-4730-91fa-245ee5637b06",
                                                "sense_id": "857bba6e-439d-3bd5-9aa4-383102f75b8c",
                                                "text": "Entre toutes les merveilles de la nature, il n’en est point de plus admirable."
                                            },
                                            {
                                                "example_id": "ee54a7c0-4c79-4af8-95ad-8c0d605673ac",
                                                "sense_id": "857bba6e-439d-3bd5-9aa4-383102f75b8c",
                                                "text": "On l’a choisi entre tous les autres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "58aad991-a2d8-3044-b2e1-723f7d130f02",
                                        "entry_id": "a3fd642f-9381-3da9-aefa-dfa11a664046",
                                        "glosses": [
                                            "Qui participe de deux choses, qui tient de l’une et de l’autre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b40c0bce-f63e-4eb3-9564-d3d540b7b8d2",
                                                "sense_id": "58aad991-a2d8-3044-b2e1-723f7d130f02",
                                                "text": "Le gris est entre le blanc et le noir."
                                            },
                                            {
                                                "example_id": "99a5d9cf-def8-4564-9216-fb1c94ce1858",
                                                "sense_id": "58aad991-a2d8-3044-b2e1-723f7d130f02",
                                                "text": "Tenir le milieu entre une chose et une autre, entre deux choses."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "292a6e81-27e4-38df-a55c-fb2780101ffe",
                                        "entry_id": "a3fd642f-9381-3da9-aefa-dfa11a664046",
                                        "glosses": [
                                            "Dans une certaine relation, en parlant de deux ou de plusieurs personnes ou de deux ou de plusieurs choses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5688f05e-3c87-4e4f-bccb-25049b14de21",
                                                "sense_id": "292a6e81-27e4-38df-a55c-fb2780101ffe",
                                                "text": "Entre vous et moi, c’est à la vie et à la mort."
                                            },
                                            {
                                                "example_id": "83b11678-42b8-4198-912b-e12043c5ab8a",
                                                "sense_id": "292a6e81-27e4-38df-a55c-fb2780101ffe",
                                                "text": "Il y a procès, querelle, inimitié, liaison, intelligence entre ces deux hommes."
                                            },
                                            {
                                                "example_id": "df0ce7a7-78e1-4bd8-80da-9bdf4580ee54",
                                                "sense_id": "292a6e81-27e4-38df-a55c-fb2780101ffe",
                                                "text": "Qu’y a-t-il de commun entre nous, entre vous et moi ? quels rapports nous lient ? Qu’avons-nous à faire, à démêler ensemble ?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "entre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1983b984-0176-33c2-8cd1-29e293a58854",
                                        "entry_id": "dce63b45-faff-3373-9ce8-f3ec97457131",
                                        "glosses": [
                                            "Première personne du singulier du présent de l’indicatif de entrer."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "22bb1b64-514b-3c5b-870b-b12bd6208cd8",
                                        "entry_id": "dce63b45-faff-3373-9ce8-f3ec97457131",
                                        "glosses": [
                                            "Troisième personne du singulier du présent de l’indicatif de entrer."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2deef36e-7081-4043-bad6-a9cc767aac4d",
                                                "sense_id": "22bb1b64-514b-3c5b-870b-b12bd6208cd8",
                                                "text": "Tout-à-coup M. Western entre comme un furieux, et l’apostrophe en ces termes : « Vous avez fait vraiment un beau chef-d’œuvre; votre bâtard a bien profité de l’éducation qu’il a reçue de vous."
                                            },
                                            {
                                                "example_id": "6add3a69-e4c3-43a8-9a56-72f388774418",
                                                "sense_id": "22bb1b64-514b-3c5b-870b-b12bd6208cd8",
                                                "text": "La porte s’ouvre. Entre un homme d’une cinquantaine d'années vêtu d’un costume sombre et strict comme celui d’un clergyman, chemise blanche et cravate noire, un air de componction et de suffisance, le visage rose et les cheveux gris teintés de violet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ad8cc1a0-47ef-3101-80c7-f66d0003b949",
                                        "entry_id": "dce63b45-faff-3373-9ce8-f3ec97457131",
                                        "glosses": [
                                            "Première personne du singulier du présent du subjonctif de entrer."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5cc5d7e4-f991-3a24-b1e0-c12200b1293b",
                                        "entry_id": "dce63b45-faff-3373-9ce8-f3ec97457131",
                                        "glosses": [
                                            "Troisième personne du singulier du présent du subjonctif de entrer."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d9deb6bf-bef3-39a0-b77b-f054a903c130",
                                        "entry_id": "dce63b45-faff-3373-9ce8-f3ec97457131",
                                        "glosses": [
                                            "Deuxième personne du singulier de l’impératif présent de entrer."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "77100663-3ba0-4fa0-a6c3-c838a12c1dc5",
                                                "sense_id": "d9deb6bf-bef3-39a0-b77b-f054a903c130",
                                                "text": "Entre donc d’abord avec moi dans mon logement qui est, sans contredit, le meilleur et le plus commode qu’un étranger puisse trouver à Bone, mais qu’en Europe mon valet de chambre dédaignerait d’occuper."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
