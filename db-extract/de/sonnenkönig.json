                    {
                        "translation_id": "33539283-8312-4bb9-8bca-cbc2f6d6d36e",
                        "source_entry_id": "453bd8e6-45e0-3b94-874c-c4c055972e8b",
                        "source_sense_id": "aa112f7a-b23f-3713-8697-699da79d68fc",
                        "target_lang_word": "Roi-Soleil",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Roi-Soleil",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9f2a4194-c32f-35dd-a7b1-01a0dcbbc483",
                                        "entry_id": "76023d94-20f6-3e53-958c-43ae1625ab68",
                                        "glosses": [
                                            "Louis XIV."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "79cc8b62-951d-44f5-b207-ead4349e40f9",
                                                "sense_id": "9f2a4194-c32f-35dd-a7b1-01a0dcbbc483",
                                                "text": "Mais nous ne rions pas de tous les accoutrements : le cothurne de Phèdre et la perruque du Roi Soleil, la fourrure du chasseur de rennes et la tunique de la Merveilleuse n’éveillent aucune idée drolatique."
                                            },
                                            {
                                                "example_id": "f39fbfdb-eebb-42e1-9689-88c4b8afec3c",
                                                "sense_id": "9f2a4194-c32f-35dd-a7b1-01a0dcbbc483",
                                                "text": "Processus évidents sous les règnes de Louis XV et Louis XVI, dont les gouvernements ne poursuivaient pas la politique de contrôle social, d’imposition et de guerre totale de Louis XIV, notre Roi-Soleil mégalomane."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "01541e7f-0c74-49ad-8383-bc48ac67bce0",
                        "source_entry_id": "453bd8e6-45e0-3b94-874c-c4c055972e8b",
                        "source_sense_id": "aa112f7a-b23f-3713-8697-699da79d68fc",
                        "target_lang_word": "太陽王",
                        "target_lang_code": "ja",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "d54963ed-8757-4c0a-b1de-d0477ba33bd6",
                        "source_entry_id": "453bd8e6-45e0-3b94-874c-c4c055972e8b",
                        "source_sense_id": "aa112f7a-b23f-3713-8697-699da79d68fc",
                        "target_lang_word": "Zonnekoning",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zonnekoning",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "ac38351e-f9a7-301c-a020-9a3ee5490101",
                                        "entry_id": "b60f8573-3ec0-32e8-9b51-4ebd7c186d32",
                                        "glosses": [
                                            "bijnaam voor koning Lodewijk XIV van Frankrijk"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "235befef-4083-4d2a-afef-d61382351203",
                                                "sense_id": "ac38351e-f9a7-301c-a020-9a3ee5490101",
                                                "text": "De Zonnekoning, Lodewijk de Veertiende, is aan de macht gekomen en van hem is bekend dat hij alle touwtjes van zijn rijk in handen wilde krijgen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "59295698-dcbe-3663-a65f-b2964feeb57b",
                                        "entry_id": "b60f8573-3ec0-32e8-9b51-4ebd7c186d32",
                                        "glosses": [
                                            "bijnaam voor iemand die zich gedraagt als een alleenheerser"
                                        ],
                                        "tags": [
                                            "ironic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "233b844b-d0ae-43a9-9377-4d303e2e9380",
                                                "sense_id": "59295698-dcbe-3663-a65f-b2964feeb57b",
                                                "text": "Minister van Binnenlandse Zaken, Gérard Collomb, zei dat Macron zich te veel als een alleenheerser gedroeg. Macron werd niet voor niets de 'Zonnekoning' genoemd."
                                            },
                                            {
                                                "example_id": "0a1863a6-a43a-4328-8709-784650986e09",
                                                "sense_id": "59295698-dcbe-3663-a65f-b2964feeb57b",
                                                "text": "\"Bach houdt de teugels strak bij het IOC. De Zonnekoning noemen ze hem ook wel. Het beleid is helemaal op hem ingesteld en hij wordt omringd door jaknikkers en hielenlikkers."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
