                    },
                    {
                        "sense_id": "95f488bb-23ea-37cd-9b87-b4a675ca3e7a",
                        "entry_id": "8b2a20f9-4be7-3602-97fc-bfc2af45c87a",
                        "glosses": [
                            "Poudre au milieu de laquelle on chauffe certains corps pour leur donner de nouvelles propriétés."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "6683c43d-114f-3f73-9ffc-ee2029277128",
                        "entry_id": "8b2a20f9-4be7-3602-97fc-bfc2af45c87a",
                        "glosses": [
                            "Substance qui recouvre la dent au niveau de la racine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "280abedd-2022-4b2e-b71d-b831066cf43e",
                                "sense_id": "6683c43d-114f-3f73-9ffc-ee2029277128",
                                "text": "Chez les chevaux « bégus », le bouchon de cément est peu important, si bien que le trou de la cavité dentaire subsiste plus longtemps, les dents semblent plus jeunes qu'en réalité."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "89f89590-2003-4792-bfc2-44f75f17973f",
                        "source_entry_id": "8b2a20f9-4be7-3602-97fc-bfc2af45c87a",
                        "source_sense_id": "543fc26b-ab4e-3ee7-bc81-5d1d89ae43d2",
                        "source_sense_description": "poudre",
                        "target_lang_word": "Zement",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zement",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ea6c2201-856a-30d7-943d-abd40e2248be",
                                        "entry_id": "a0e7dccb-8652-3cac-a6f2-e5f1981e2fa6",
                                        "glosses": [
                                            "Bindemittel für Beton und Mörtel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ebfa0334-566e-49d4-8b70-d091b9ecb93b",
                                                "sense_id": "ea6c2201-856a-30d7-943d-abd40e2248be",
                                                "text": "Wir müssen den Zement noch ansetzen."
                                            },
                                            {
                                                "example_id": "fc25643d-515f-4913-b55c-4bb7c34c586b",
                                                "sense_id": "ea6c2201-856a-30d7-943d-abd40e2248be",
                                                "text": "„Weltweit werden jährlich um die vier Milliarden Tonnen Zement fabriziert, das macht rund 500 Kilogramm für jede Bewohnerin und jeden Bewohner des Planeten.“"
                                            },
                                            {
                                                "example_id": "604de638-1764-40ac-a56e-0f9dad8202d8",
                                                "sense_id": "ea6c2201-856a-30d7-943d-abd40e2248be",
                                                "text": "„Die Zementfabrik produziert übrigens heute noch, doch niemand würde auf die Idee kommen, seinen Zement dort selbst abzuholen, geschweige denn dafür zusätzlich mit Wein und Lebensmitteln zu zahlen.“"
                                            },
                                            {
                                                "example_id": "1cfc5a24-9ae6-4cf5-8358-e942cc73263b",
                                                "sense_id": "ea6c2201-856a-30d7-943d-abd40e2248be",
                                                "text": "„Für Beton braucht es vier Zutaten: Zement, Wasser, Sand und Kies.“"
                                            },
                                            {
                                                "example_id": "b2f6d238-1ab9-4fe2-8374-1ea23dd113c0",
                                                "sense_id": "ea6c2201-856a-30d7-943d-abd40e2248be",
                                                "text": "[…] „Die USA verbrauchte im gesamten 20. Jahrhundert 4.4 Milliarden Tonnen Zement. In China waren es allein in den Jahren 2011 bis 2013 ganze 6.4 Milliarden Tonnen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "05aea5ad-2668-3142-8784-99cfd4190c53",
                                        "entry_id": "a0e7dccb-8652-3cac-a6f2-e5f1981e2fa6",
                                        "glosses": [
                                            "natürliches Bindemittel von Sedimentgestein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec479654-e709-45a8-a5b9-f6fde6baf9e5",
                                                "sense_id": "05aea5ad-2668-3142-8784-99cfd4190c53",
                                                "text": "Zement ist in der Petrographie von Sedimentgesteinen der mit diagenetischen Ausscheidungen gefüllte Interstitialraum zwischen den Partikeln bzw. Körnern."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "e2e52930-0137-3d47-9a24-d95d56a2fa80",
                                        "entry_id": "a0e7dccb-8652-3cac-a6f2-e5f1981e2fa6",
                                        "glosses": [
                                            "die Zahnwurzel eines Zahnes bedeckende äußerste Schicht als Teil des Parodontiums"
                                        ],
                                        "tags": [
                                            "als Neutrum"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "edcd9b8a-0d7f-49a6-85cb-a9c0d34da3a6",
                                                "sense_id": "e2e52930-0137-3d47-9a24-d95d56a2fa80",
                                                "text": "Die vom mineralisierten Zement eingeschlossenen Zementoblasten wandeln sich in Zementozyten um."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "20f0f051-3de5-3229-8f61-7ac5f25805cc",
                                        "entry_id": "a0e7dccb-8652-3cac-a6f2-e5f1981e2fa6",
                                        "glosses": [
                                            "Füll- oder Befestigungsmaterial von Zahnersatz"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "047ffdfa-58b5-4a7e-9096-ce95110a796b",
                                                "sense_id": "20f0f051-3de5-3229-8f61-7ac5f25805cc",
                                                "text": "Von allen auf dem Markt angepriesenen Zementen scheint, trotz umstrittener Auswirkungen auf die Pulpa, der Zinkoxid-Phosphat-Zement noch immer an erster Stelle zu stehen."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
