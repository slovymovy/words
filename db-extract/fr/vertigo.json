                "translations": [
                    {
                        "translation_id": "2340edb1-6fa5-4089-92ed-fcebac423d14",
                        "source_entry_id": "3cdfca3e-d407-304e-b837-be9194a4a9d3",
                        "target_lang_word": "Koller",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Koller",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dce8bb17-402a-3465-b491-69b7f236675b",
                                        "entry_id": "af1a461d-d67b-380e-b98c-a87077c4ac3b",
                                        "glosses": [
                                            "plötzlich auftretende Wut"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d3d1f6d8-dc55-43c9-875b-f75aa6cefa7d",
                                                "sense_id": "dce8bb17-402a-3465-b491-69b7f236675b",
                                                "text": "Dann bekam er plötzlich einen Koller und verschwand, ohne noch etwas zu sagen."
                                            },
                                            {
                                                "example_id": "f57425ea-1d59-44f6-8b87-73ac44474950",
                                                "sense_id": "dce8bb17-402a-3465-b491-69b7f236675b",
                                                "text": "„Das Haupt der vierten Richtung war der Grossfürst Thronfolger, der die Enttäuschung von Austerlitz nicht verwinden konnte, wo er wie bei einer Parade in Helm und Koller vor seiner Garde hergeritten war, um die Franzosen mit einer schneidigen Attacke über den Haufen zu werfen und schliesslich, wider Erwarten in die vorderste Linie geraten, in der allgemeinen Verwirrung nur mit genauer Not davongekommen war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "26e08fd0-d30b-4275-8fe7-4b9becb5bdaa",
                        "source_entry_id": "3cdfca3e-d407-304e-b837-be9194a4a9d3",
                        "target_lang_word": "Narrheit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Narrheit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d376d3d5-7ec7-3f1d-8270-400d9d557e39",
                                        "entry_id": "631aadef-cb37-3d1f-b229-8b137180e3e4",
                                        "glosses": [
                                            "Zustand des Unwissens; mangelnde Intelligenz"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cff72642-6434-4df5-9fa1-b18cc93d6ceb",
                                                "sense_id": "d376d3d5-7ec7-3f1d-8270-400d9d557e39",
                                                "text": "Bei seiner Narrheit wundert mich die 6 in der Matheprüfung nicht."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6bcc3180-c643-3923-a155-bcb6acb0531a",
                                        "entry_id": "631aadef-cb37-3d1f-b229-8b137180e3e4",
                                        "glosses": [
                                            "unüberlegte, dumme, närrische Tat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "57e5fda1-3e22-4f44-a35c-ca06aca7065c",
                                                "sense_id": "6bcc3180-c643-3923-a155-bcb6acb0531a",
                                                "text": "In manchen Ländern kommen Jungen ins Gefängnis für Dinge, die wir als kleine Narrheiten abtun würden."
                                            },
                                            {
                                                "example_id": "cf9948cc-f3c8-44e2-9ad6-c10190274ef2",
                                                "sense_id": "6bcc3180-c643-3923-a155-bcb6acb0531a",
                                                "text": "„Nicht selten erschöpft er sich in Schilderungen von Situationskomik, Prügelszenen, Häufungen von Narrheiten und Ungeschicklichkeiten.“"
                                            },
                                            {
                                                "example_id": "27b5e336-821f-490c-9532-6bc4a5378542",
                                                "sense_id": "6bcc3180-c643-3923-a155-bcb6acb0531a",
                                                "text": "„Ich blieb unnachgiebig; Madame d'Urfé ihrerseits lachte über die Narrheiten ihrer angeblichen Nichte und zeigt sich sehr erfreut, als sie mich ihr gegenüber und den Schützling des mächtigen Selenis neben sich sitzen sah.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a5d2c3d6-5a32-47fd-b7e0-061840b8d296",
                        "source_entry_id": "3cdfca3e-d407-304e-b837-be9194a4a9d3",
