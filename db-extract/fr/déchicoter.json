                "senses": [
                    {
                        "sense_id": "7759be42-cf41-3bcb-ad82-a965a7f1a44b",
                        "entry_id": "08b7b3d0-1c36-3b98-b1d5-e6ff2698a3f4",
                        "glosses": [
                            "Déchiqueter, couper en morceaux."
                        ],
                        "tags": [
                            "Suisse"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "4ddae3bd-bf6b-31d8-bb79-0f902dc4cca6",
                        "entry_id": "08b7b3d0-1c36-3b98-b1d5-e6ff2698a3f4",
                        "glosses": [
                            "Enlever les souches, les racines."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "463cbfe9-5d5f-4d6b-b974-061fe4260c2e",
                                "sense_id": "4ddae3bd-bf6b-31d8-bb79-0f902dc4cca6",
                                "text": "Nos manœuvres ne furent plus employés dès lors qu’à déblayer ce qu’on avait abattu, à brûler les troncs, à déchicoter les racines."
                            },
                            {
                                "example_id": "0abbe433-6366-43eb-a2a9-a320ef88ea2c",
                                "sense_id": "4ddae3bd-bf6b-31d8-bb79-0f902dc4cca6",
                                "text": "Toutes les propriétés furent contraintes de mettre sous culture vivrière 20 pour cent de leurs étendues de cannes à couper ; elles eurent à les déchicoter immédiatement, et il fut convenu qu’elles seraient dédommagées."
                            }
                        ]
                    }
