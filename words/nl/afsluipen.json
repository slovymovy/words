    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ae1f18ec-7008-3b14-9137-4a065ab9cae8",
                    "sense_definition": "zich stilletjes en onopgemerkt van een plek verwijderen",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "stiekem weggaan",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Toen het feestje te druk werd, besloot hij stilletjes <w>af</w> te <w>sluipen</w> zonder iemand gedag te zeggen.",
                            "target_lang_translations": {
                                "en": "When the party became too crowded, he decided to quietly <w>sneak away</w> without saying goodbye to anyone."
                            }
                        },
                        {
                            "text": "De dief probeerde onopgemerkt <w>af</w> te <w>sluipen</w> nadat hij het alarm had gehoord.",
                            "target_lang_translations": {
                                "en": "The thief tried to <w>slip away</w> unnoticed after he heard the alarm."
                            }
                        }
                    ],
                    "synonyms": [
                        "wegsluipen",
                        "ontglippen"
                    ],
                    "antonyms": [
                        "aanstormen"
                    ],
                    "common_phrases": [
                        "stilletjes afsluipen",
                        "onopgemerkt afsluipen"
                    ],
                    "target_lang_definitions": {
                        "en": "To leave a place quietly and unnoticed, often to avoid attention or social interaction."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to sneak away",
                                "target_lang_sense_clarification": "leaving a place quietly"
                            },
                            {
                                "target_lang_word": "to slip away",
                                "target_lang_sense_clarification": "leaving unnoticed"
                            },
                            {
                                "target_lang_word": "to steal away",
                                "target_lang_sense_clarification": "leaving secretly"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8c9c212e-c399-34be-8f90-c503e469a512",
                    "sense_definition": "behoedzaam en heimelijk naar beneden bewegen",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "naar beneden bewegen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De jager zag de vos voorzichtig de heuvel <w>afsluipen</w> op zoek naar een prooi.",
                            "target_lang_translations": {
                                "en": "The hunter saw the fox carefully <w>sneak down</w> the hill in search of prey."
                            }
                        },
                        {
                            "text": "Je moet heel zachtjes de trap <w>afsluipen</w> om de kinderen niet wakker te maken.",
                            "target_lang_translations": {
                                "en": "You have to <w>creep down</w> the stairs very quietly so as not to wake the children."
                            }
                        }
                    ],
                    "synonyms": [
                        "naar beneden sluipen"
                    ],
                    "antonyms": [
                        "opsluipen"
                    ],
                    "common_phrases": [
                        "de trap afsluipen",
                        "de heuvel afsluipen"
                    ],
                    "target_lang_definitions": {
                        "en": "To move downwards cautiously and secretly, such as down a hill or stairs."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to sneak down",
                                "target_lang_sense_clarification": "moving downwards quietly"
                            },
                            {
                                "target_lang_word": "to creep down",
                                "target_lang_sense_clarification": "moving down slowly and stealthily"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}