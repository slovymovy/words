{
    "word_family": [
        "outwards",
        "outwardly",
        "outwardness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "98f51552-fc95-324d-a3de-a233b52262ee",
                    "sense_definition": "Located towards the outside or exterior.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "direction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>outward</w> appearance of the building is quite modern.",
                            "target_lang_translations": {
                                "tr": "Binanın <w>dış görünüşü</w> oldukça modern.",
                                "ru": "<w>Внешний</w> облик здания вполне современный."
                            }
                        },
                        {
                            "text": "Check the <w>outward</w> edges of the frame for any damage.",
                            "target_lang_translations": {
                                "tr": "Çerçevenin <w>dış kenarlarını</w> herhangi bir hasar için kontrol edin.",
                                "ru": "Проверьте <w>внешние</w> края рамы на наличие повреждений."
                            }
                        }
                    ],
                    "synonyms": [
                        "outer",
                        "external"
                    ],
                    "antonyms": [
                        "inward"
                    ],
                    "common_phrases": [
                        "outward appearance",
                        "outward sign"
                    ],
                    "target_lang_definitions": {
                        "tr": "Dış tarafa veya dış kısma doğru yerleşmiş.",
                        "ru": "Расположенный снаружи или обращенный к внешней стороне."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "dış",
                                "target_lang_sense_clarification": "Bir şeyin dış yüzeyi veya dış kısmı ile ilgili."
                            },
                            {
                                "target_lang_word": "harici",
                                "target_lang_sense_clarification": "Dışarıda bulunan, dıştan gelen."
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "внешний",
                                "target_lang_sense_clarification": "относящийся к наружной части или виду"
                            },
                            {
                                "target_lang_word": "наружный",
                                "target_lang_sense_clarification": "расположенный с внешней стороны"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "91fcea95-fe18-3bb5-b778-5926b18cd92d",
                    "sense_definition": "Visible or noticeable to others.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "visibility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There were no <w>outward</w> signs of his deep sadness.",
                            "target_lang_translations": {
                                "tr": "Derin üzüntüsünün <w>dışarıdan görünen</w> hiçbir belirtisi yoktu.",
                                "ru": "Не было никаких <w>видимых</w> признаков его глубокой печали."
                            }
                        },
                        {
                            "text": "She maintained an <w>outward</w> calm despite the chaos around her.",
                            "target_lang_translations": {
                                "tr": "Etrafındaki kaosa rağmen <w>dışarıdan sakin</w> görünmeyi başardı.",
                                "ru": "Она сохраняла <w>внешнее</w> спокойствие, несмотря на царивший вокруг хаос."
                            }
                        }
                    ],
                    "common_phrases": [
                        "outward calm",
                        "outward show"
                    ],
                    "target_lang_definitions": {
                        "tr": "Başkaları tarafından görülebilir veya fark edilebilir olan.",
                        "ru": "Заметный, видимый окружающим; проявляющийся снаружи."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "dıştan görünen",
                                "target_lang_sense_clarification": "Dışarıdan bakıldığında fark edilen durum."
                            },
                            {
                                "target_lang_word": "görünürdeki",
                                "target_lang_sense_clarification": "Dışarıya yansıtılan, dış görünüşe ait."
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "внешний",
                                "target_lang_sense_clarification": "кажущийся, видимый окружающим"
                            },
                            {
                                "target_lang_word": "видимый",
                                "target_lang_sense_clarification": "заметный для других"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "d54d8cef-880c-34cb-a5c7-6cd9799fed1d",
                    "sense_definition": "Towards the outside or away from the center.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "direction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The petals of the flower curve <w>outward</w>.",
                            "target_lang_translations": {
                                "tr": "Çiçeğin taç yaprakları <w>dışarıya doğru</w> kıvrılır.",
                                "ru": "Лепестки цветка загибаются <w>наружу</w>."
                            }
                        },
                        {
                            "text": "The ship is <w>outward</w> bound for the open sea.",
                            "target_lang_translations": {
                                "tr": "Gemi açık denizlere <w>doğru</w> yola çıkıyor.",
                                "ru": "Корабль держит курс <w>в открытое</w> море."
                            }
                        }
                    ],
                    "antonyms": [
                        "inward"
                    ],
                    "common_phrases": [
                        "facing outward",
                        "outward bound"
                    ],
                    "target_lang_definitions": {
                        "tr": "Dışarıya doğru veya merkezden uzağa.",
                        "ru": "По направлению наружу или в сторону от центра."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "dışarıya doğru",
                                "target_lang_sense_clarification": "Hareketin yönünü belirten zarf."
                            },
                            {
                                "target_lang_word": "dışa",
                                "target_lang_sense_clarification": "Merkezden uzaklaşan yön."
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "наружу",
                                "target_lang_sense_clarification": "по направлению за пределы чего-либо"
                            },
                            {
                                "target_lang_word": "вовне",
                                "target_lang_sense_clarification": "в направлении внешней стороны"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0e070129-948d-3fcf-adb4-aed000e560af",
                    "sense_definition": "A hospital ward located in a separate building.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "medical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The patient was moved to the <w>outward</w> for specialized care.",
                            "target_lang_translations": {
                                "tr": "Hasta, uzmanlaşmış bakım için <w>ek servise</w> taşındı.",
                                "ru": "Пациента перевели в <w>отдельный корпус</w> для специализированного лечения."
                            }
                        },
                        {
                            "text": "Staff must walk between the main hospital and the <w>outward</w>.",
                            "target_lang_translations": {
                                "tr": "Personel, ana hastane ile <w>ek servis</w> arasında yürümek zorundadır.",
                                "ru": "Персоналу приходится ходить между главным зданием больницы и <w>выносным отделением</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Ayrı bir binada bulunan hastane servisi.",
                        "ru": "Больничное отделение или палата, расположенная в отдельном здании."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "ek servis",
                                "target_lang_sense_clarification": "Ana binadan ayrı olan hastane bölümü."
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "отдельный корпус",
                                "target_lang_sense_clarification": "обособленное отделение больницы"
                            },
                            {
                                "target_lang_word": "выносное отделение",
                                "target_lang_sense_clarification": "палата или корпус вне основного здания"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f5b4352a-d1c1-3241-8d29-7e6a9ccff081",
                    "sense_definition": "To ward off or keep something away.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "defense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The knight used his shield to <w>outward</w> the heavy blow.",
                            "target_lang_translations": {
                                "tr": "Şövalye, ağır darbeyi <w>savuşturmak</w> için kalkanını kullandı.",
                                "ru": "Рыцарь использовал свой щит, чтобы <w>отразить</w> тяжёлый удар."
                            }
                        },
                        {
                            "text": "He tried to <w>outward</w> the criticism with a polite smile.",
                            "target_lang_translations": {
                                "tr": "Nazik bir gülümsemeyle eleştirileri <w>savuşturmaya</w> çalıştı.",
                                "ru": "Он попытался <w>парировать</w> критику вежливой улыбкой."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in older literary contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir şeyi uzak tutmak veya savuşturmak.",
                        "ru": "Отражать, предотвращать или отводить что-либо (устаревшее)."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "savuşturmak",
                                "target_lang_sense_clarification": "Bir saldırıyı veya etkiyi uzaklaştırmak."
                            },
                            {
                                "target_lang_word": "defetmek",
                                "target_lang_sense_clarification": "Bir şeyi geri çevirmek veya uzak tutmak."
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "отражать",
                                "target_lang_sense_clarification": "отбивать атаку или удар"
                            },
                            {
                                "target_lang_word": "парировать",
                                "target_lang_sense_clarification": "отводить угрозу или удар"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}