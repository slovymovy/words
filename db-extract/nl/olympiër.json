                    {
                        "sense_id": "06b37d19-c5bc-3341-9b2f-2c98205f8f01",
                        "entry_id": "fe990845-2805-3df6-9f02-f692c0b7f1ce",
                        "glosses": [
                            "sporter die heeft meegedaan aan de Olympische Spelen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a4bcb792-50a2-4a1b-b2aa-56b1666713b2",
                                "sense_id": "06b37d19-c5bc-3341-9b2f-2c98205f8f01",
                                "text": "Bij de Meerkampwedstrijd van AV De Spartaan in Lisse heeft de Enschedese Marleen Baas het nationaal record voor C-junioren van Olympiër Nadine Visser verbeterd. Baas kwam tot een totaal van 4775 punten, een verbetering van 70 punten van het oude record."
                            },
                            {
                                "example_id": "422fa018-b433-4630-a68a-c72a707e46d4",
                                "sense_id": "06b37d19-c5bc-3341-9b2f-2c98205f8f01",
                                "text": "Ireen Wüst heeft een nieuwe sponsor en ploeg. De meest succesvolle Nederlandse olympiër ooit heeft samen met Esmee Visser een contract getekend bij de Enschedese investeringsmaatschappij Infestos."
                            },
                            {
                                "example_id": "fe9c142a-58fe-421e-9249-4c5e4c374006",
                                "sense_id": "06b37d19-c5bc-3341-9b2f-2c98205f8f01",
                                "text": "Ook al heeft hij de zwemtocht niet voltooid. Op sociale media regent het complimenten en respectbetuigingen voor de \"indrukwekkende en grootse prestatie\" van de Olympiër."
                            }
                        ]
                    }
                ],
