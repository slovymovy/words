                                        "sense_id": "105cfff5-18fa-3686-b525-d5fe6aa714f3",
                                        "entry_id": "9aad112e-f52d-30fd-91ec-40564e5f6d65",
                                        "glosses": [
                                            "zur Familie der Coronaviridae gehörendes Virus, das unterschiedliche Krankheiten auslöst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c6201f1-9bcd-476c-b4e1-6bdf2fa135ad",
                                                "sense_id": "105cfff5-18fa-3686-b525-d5fe6aa714f3",
                                                "text": "„Der genetische Code des neuen Coronavirus wurde in Rekordtempo entschlüsselt. Gerade mal sechs Tage benötigte die Gruppe um Michael Smith vom Genome Sciences Centre in Vancouver, um das komplette Erbgut des Erregers zu squenzieren.“ (2003)"
                                            },
                                            {
                                                "example_id": "accb2d7d-63d9-4a11-a83a-cfca4d43518d",
                                                "sense_id": "105cfff5-18fa-3686-b525-d5fe6aa714f3",
                                                "text": "„Inzwischen ist das Erbgut des SARS-Erregers, ein neues Virus aus der Familie der Coronaviren, fast vollständig entschlüsselt.“ (2003)"
                                            },
                                            {
                                                "example_id": "99c007d8-8482-4b99-b01d-e73dafda02fd",
                                                "sense_id": "105cfff5-18fa-3686-b525-d5fe6aa714f3",
                                                "text": "„Das neue, vor allem im Nahen Osten verbreitete Coronavirus scheint sich vor allem über die Atemwege zu verbreiten.“ (2013)"
                                            },
                                            {
                                                "example_id": "a8a5945c-4d44-465a-8816-5c1ecb807f03",
                                                "sense_id": "105cfff5-18fa-3686-b525-d5fe6aa714f3",
                                                "text": "„Bei dem neuen Virus handelt es sich um einen Erreger aus der Familie der Coronaviren, also aus derselben Familie wie das SARS (severe acute respiratory syndrome) und das MERS-CoVirus (Middle East Respiratory Syndrome Coronavirus).“ (2020)"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "dfb5e3d5-1b73-3cd0-81ad-cbadcd47a4c3",
