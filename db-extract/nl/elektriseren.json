                        "source_sense_id": "bd60ebcf-1697-3b95-b585-3bd6c00e548c",
                        "target_lang_word": "electrify",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "electrify",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1d5d9538-c412-38a2-96c7-61b2ece30d06",
                                        "entry_id": "b7168d2a-b858-3241-923e-7dd5e1cf583f",
                                        "glosses": [
                                            "To supply electricity to; to charge with electricity."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c0525488-5ae5-4ddf-bac1-bc486f4ad277",
                                                "sense_id": "1d5d9538-c412-38a2-96c7-61b2ece30d06",
                                                "text": "to electrify a cable"
                                            },
                                            {
                                                "example_id": "53478442-cfaa-4662-9508-6b3e290ecf9b",
                                                "sense_id": "1d5d9538-c412-38a2-96c7-61b2ece30d06",
                                                "text": "Those most rural routes will not get overhead wires. As Reeve told the seminar: \"Even in my wildest dreams, I can't see a business case for electrifying the Far North Line.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b8bf43d5-cad2-3a86-a26f-9e7013585a24",
                                        "entry_id": "b7168d2a-b858-3241-923e-7dd5e1cf583f",
                                        "glosses": [
                                            "To cause electricity to pass through; to affect by electricity; to give an electric shock to."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "77612d9d-7204-46fb-9816-84ef6a96e3bc",
                                                "sense_id": "b8bf43d5-cad2-3a86-a26f-9e7013585a24",
                                                "text": "to electrify a limb, or the body"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "446962f4-b00b-3126-befd-23d2192da44f",
                                        "entry_id": "b7168d2a-b858-3241-923e-7dd5e1cf583f",
                                        "glosses": [
                                            "To adapt (a home, farm, village, city, industry, vehicle, railroad) for electric power."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0dd96f22-335b-43e8-8827-c143a0f5a2c8",
                                                "sense_id": "446962f4-b00b-3126-befd-23d2192da44f",
                                                "text": "Baroness Randerson had asked if, following the publication of the Government's Decarbonising transport: setting the challenge report in March, there had been any consideration to electrify more rail lines - and if so, to prioritise routes between Cardiff and Swansea, in the East Midlands and in the Lake District. All had been planned for electrification before subsequently being cancelled."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f1a0cd81-fd9f-3761-a0db-9c759ef7b8b4",
                                        "entry_id": "b7168d2a-b858-3241-923e-7dd5e1cf583f",
                                        "glosses": [
                                            "To strongly excite, especially by something delightful or inspiring; to thrill."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "40b5e1ff-4b37-4a62-8115-3e3a4a9556bd",
                                                "sense_id": "f1a0cd81-fd9f-3761-a0db-9c759ef7b8b4",
                                                "text": "Her performance in the play electrified the audience."
                                            },
                                            {
                                                "example_id": "986e1cf6-e6ed-4462-8e28-44db5ad3afb8",
                                                "sense_id": "f1a0cd81-fd9f-3761-a0db-9c759ef7b8b4",
                                                "text": "If the sovereign were now to immure a subject in defiance of the writ of habeas corpus […] the whole nation would be instantly electrified by the news."
                                            },
                                            {
                                                "example_id": "5b384daf-08e3-4766-9aec-5c5b6249cfd8",
                                                "sense_id": "f1a0cd81-fd9f-3761-a0db-9c759ef7b8b4",
                                                "text": "Try whether she could electrify Mr. Grandcourt by mentioning it to him at table."
                                            },
                                            {
                                                "example_id": "019b4296-50c7-4e84-9b34-079d866ebce2",
                                                "sense_id": "f1a0cd81-fd9f-3761-a0db-9c759ef7b8b4",
                                                "text": "His poeticized version of a news flash about the advent of AIDS (the disease that killed his mother) electrifies, as it should, like unexpected lightning."
                                            },
                                            {
                                                "example_id": "b27d83b7-2615-4954-8dc3-9d7582a1e76d",
                                                "sense_id": "f1a0cd81-fd9f-3761-a0db-9c759ef7b8b4",
                                                "text": "The trailblazing Oaxacan chef Alejandro Ruiz […] has spiked this black-bean sauce with a hidden depth charge of flavor: patches of foliage from a local avocado tree. The leaves electrify the sauce with an unexpected thrum of black licorice."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e3c15d13-27e7-3043-82e7-97b971a09bd6",
                                        "entry_id": "b7168d2a-b858-3241-923e-7dd5e1cf583f",
                                        "glosses": [
                                            "To make electric."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    }
                                ]
