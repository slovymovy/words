                        ],
                        "form": "die Industriekonzerne"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7e9961d4-7f89-3436-bf25-a5c3010b5a3c",
                        "entry_id": "bf08b992-4bc2-31be-94e8-4524c6d7ce2c",
                        "glosses": [
                            "Großunternehmen, das Waren aus Bereichen der automatisierten/maschinellen Produktion verkauft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a1b3fd82-1b46-43c3-8500-eac708fc101e",
                                "sense_id": "7e9961d4-7f89-3436-bf25-a5c3010b5a3c",
                                "text": "„Der deutsche Industriekonzern Siemens hat einen Riesenauftrag aus Ägypten erhalten.“"
                            },
                            {
                                "example_id": "ace2dada-c4c7-4d1c-b69d-a590f0747931",
                                "sense_id": "7e9961d4-7f89-3436-bf25-a5c3010b5a3c",
                                "text": "„Der chinesische Industriekonzern Midea hat inzwischen ein offizielles Übernahme-Angebot für Kuka vorgelegt.“"
                            },
                            {
                                "example_id": "7539d693-7166-4d2f-b7d9-8df812269c30",
                                "sense_id": "7e9961d4-7f89-3436-bf25-a5c3010b5a3c",
                                "text": "„Der Essener Stahl- und Industriekonzern konnte seine Erholung im dritten Geschäftsquartal fortsetzen.“"
                            },
                            {
                                "example_id": "e9c0ec4b-2b59-496f-9b3f-2fdd79a3a56f",
                                "sense_id": "7e9961d4-7f89-3436-bf25-a5c3010b5a3c",
                                "text": "„Wichtigstes Ziel ist für Österreichs größten Industriekonzern der Einstieg in Russland.“"
                            },
                            {
                                "example_id": "8ddc661b-55e2-440c-bd0f-8495bae005ef",
                                "sense_id": "7e9961d4-7f89-3436-bf25-a5c3010b5a3c",
                                "text": "„Der frühere Wintershall-Chef Seele stand von Mitte 2015“ […] „bis zum Frühjahr 2021 an der Spitze von Österreichs größtem Industriekonzern.“"
                            },
                            {
                                "example_id": "9cb120d2-e186-4304-8c95-7787f9682ad1",
                                "sense_id": "7e9961d4-7f89-3436-bf25-a5c3010b5a3c",
                                "text": "„Schneller, schlagkräftiger, rentabler. So soll Deutschlands größter Industriekonzern durch einen Konzernumbau werden.“"
                            },
                            {
                                "example_id": "62c033cc-2e4f-4e8f-bcae-d48f92566a73",
                                "sense_id": "7e9961d4-7f89-3436-bf25-a5c3010b5a3c",
                                "text": "„Den Durchbruch vom Familienunternehmen zum großen Industriekonzern schaffte Renault im Jahr 1906, als ein Pariser Taxiunternehmen 1500 Taxen bei Renault bestellte.“"
                            },
                            {
                                "example_id": "74ba0f43-79a8-43ea-91c0-5c67196efa0b",
                                "sense_id": "7e9961d4-7f89-3436-bf25-a5c3010b5a3c",
                                "text": "„Die 1856 gegründete Eisenhütte S.A. des Hauts-Fourneaux et Fonderies de Pont-à-Mousson war lange Zeit einer der führenden französischen Industriekonzerne.“"
                            },
                            {
                                "example_id": "08e1e759-28da-44b8-a4b5-9ac175537168",
                                "sense_id": "7e9961d4-7f89-3436-bf25-a5c3010b5a3c",
                                "text": "„Laut Händlern verkaufte der schwedische Investor Cevian weitere 3,8 Prozent seiner Beteiligung am deutschen Stahl- und Industriekonzern zum Preis von 5,15 Euro je Papier.“"
                            },
                            {
                                "example_id": "c39f2b50-11b4-4d27-91ce-cd9b97fa6a2b",
                                "sense_id": "7e9961d4-7f89-3436-bf25-a5c3010b5a3c",
                                "text": "„Der Industriekonzern beschäftigt“ […] „weltweit wieder mehr als 16'000 Mitarbeiterinnen und Mitarbeiter.“"
                            },
                            {
                                "example_id": "dad3b93d-40a9-49d5-82c8-b259b8a21dbe",
                                "sense_id": "7e9961d4-7f89-3436-bf25-a5c3010b5a3c",
                                "text": "„In der Vergangenheit lief es aber längst nicht rosig für den Industriekonzern.“"
                            },
                            {
                                "example_id": "673db9dd-57c7-460e-b764-4528fe59bc2a",
                                "sense_id": "7e9961d4-7f89-3436-bf25-a5c3010b5a3c",
                                "text": "„Anders als andere Industriekonzerne wie Georg Fischer in Schaffhausen oder Rieter in Winterthur meldet Sulzer fürs erste Halbjahr 2019 mehr Umsatz und Gewinn im Vergleich mit der Vorjahresperiode.“"
                            },
                            {
                                "example_id": "c9a47ec2-c862-4ef9-9ecf-900de37d0c41",
                                "sense_id": "7e9961d4-7f89-3436-bf25-a5c3010b5a3c",
                                "text": "„Die Erfahrung aus der jahrelangen operativen Tätigkeit in einem Industriekonzern bildete die Basis für die Gründung einer eigenen PR-Agentur,“ […]."
                            },
                            {
                                "example_id": "d47907d5-f601-428b-a3d9-46ee5d33f8fb",
                                "sense_id": "7e9961d4-7f89-3436-bf25-a5c3010b5a3c",
                                "text": "[Werbefilme:] „Timur Örge hat eine Produktionsfirma. Zu seinen Auftraggebern gehören Werbekunden aller Art - vom kleinen Friseursalon bis zum großen Industriekonzern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
