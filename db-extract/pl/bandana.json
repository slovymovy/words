                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "20c2fac2-1f28-41d9-80ab-3d4d03b63053",
                        "source_entry_id": "a9a043d5-28e3-3987-9dd3-50982b55b4a7",
                        "source_sense_id": "8ecfbb6d-169e-3782-833f-3131d71721ef",
                        "target_lang_word": "couvre-chef",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "couvre-chef",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "68727df6-f112-35f1-807f-460054c882bd",
                                        "entry_id": "43f021a0-03bf-35f0-add2-290cafeef779",
                                        "glosses": [
                                            "Coiffe, telle un bonnet, un chapeau, une capuche, ou un chaperon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "288f2909-6b00-48cc-8df2-05df1d94aab9",
                                                "sense_id": "68727df6-f112-35f1-807f-460054c882bd",
                                                "text": "On ne porte pas de couvre-chef dans un bureau, c’est du savoir-vivre élémentaire!"
                                            },
                                            {
                                                "example_id": "c537b0da-f0eb-4230-9d82-dc9b57bd5f9d",
                                                "sense_id": "68727df6-f112-35f1-807f-460054c882bd",
                                                "text": "C’était un très vieux magicien\nQui sortait de son couvre-chef\nDes facteurs, des politiciens,\nDes employés SNCF, […]"
                                            },
                                            {
                                                "example_id": "a5a7faea-30e4-4369-a2e3-ed39b7083078",
                                                "sense_id": "68727df6-f112-35f1-807f-460054c882bd",
                                                "text": "C’était un accident. Jim n’avait pas voulu aplatir son couvre-chef."
                                            },
                                            {
                                                "example_id": "d641ded2-1dac-453a-a3a9-3b854d17e852",
                                                "sense_id": "68727df6-f112-35f1-807f-460054c882bd",
                                                "text": "Les Américains se ruèrent à terre, sans un regard pour notre guide, dont le couvre-chef négligemment tendu laissait entendre qu'il ne dédaignerait pas un pourboire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
