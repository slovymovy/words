                        "sense_id": "0215bca4-7943-3616-aab6-3461d5447123",
                        "entry_id": "705a0e5b-f8d5-394a-bb97-66d0f5f6c9e4",
                        "glosses": [
                            "Zeremonie, bei der etwas geopfert wird, eine Opferung stattfindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b0abf0ce-44b2-4771-bc66-e5b893bec0b5",
                                "sense_id": "0215bca4-7943-3616-aab6-3461d5447123",
                                "text": "„Zum Schluss wurden die Männer und Frauen, die angeblich bei der Opferzeremonie dabei gewesen waren, gefesselt und in der glühenden Sonne an den Pranger gestellt.“"
                            },
                            {
                                "example_id": "2d102c67-e60a-447a-9a27-3d6a37452d2b",
                                "sense_id": "0215bca4-7943-3616-aab6-3461d5447123",
                                "text": "„›Die ersten Berichte über Menschenopfer für die Aschanti-Götter stammen aus den 1870ern, der britischen Kolonialzeit. Hier ist eine der sehr wenigen Zeichnungen einer Opferzeremonie von einem unbekannten Künstler.‹“"
                            }
                        ],
