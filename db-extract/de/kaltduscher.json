                "senses": [
                    {
                        "sense_id": "89818398-cc4a-3f9d-82dc-d1ceb0d72ec3",
                        "entry_id": "167b245e-1552-3563-ad50-906beee6df4a",
                        "glosses": [
                            "Person, die (regelmäßig/oft) mit kaltem Wasser duscht (und dadurch meist abgehärtet ist)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "953eeeae-9aa0-4f82-9aa6-32e28d98c3dc",
                                "sense_id": "89818398-cc4a-3f9d-82dc-d1ceb0d72ec3",
                                "text": "„Laut einer Studie melden sich Kaltduscher weniger häufig krank.“"
                            },
                            {
                                "example_id": "847eead7-f694-49e7-a80d-09ef40f69cfd",
                                "sense_id": "89818398-cc4a-3f9d-82dc-d1ceb0d72ec3",
                                "text": "„Wieder einmal eine warme Dusche zu haben, das war ein großer Genuss, bin ja eigentlich nicht so der ‚Kaltduscher‘.“"
                            },
                            {
                                "example_id": "55a94a08-6d1c-4ab5-8fa2-915223b17982",
                                "sense_id": "89818398-cc4a-3f9d-82dc-d1ceb0d72ec3",
                                "text": "„Insbesondere die körpereigenen starken Antioxidantien Glutathion (GSH), Superoxid-Dismutase (SOD) und Glutathion-Peroxidase (GPx) sind bei Winterschwimmern und Kaltduschern in viel höherem Maße vorhanden als bei Personen, die solche Aktivitäten lieber vermeiden.“"
                            },
                            {
                                "example_id": "da647b08-4dd8-4a93-9bc6-8e32111dc226",
                                "sense_id": "89818398-cc4a-3f9d-82dc-d1ceb0d72ec3",
                                "text": "„Allerdings bin ich seit Jahrzehnten Kaltduscher und heize im Winter nur auf etwa 20 Grad.“"
                            },
                            {
                                "example_id": "f4819573-057c-4c6a-be3d-f640811fb3ba",
                                "sense_id": "89818398-cc4a-3f9d-82dc-d1ceb0d72ec3",
                                "text": "„Ich bin 61 und ein Kaltduscher.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
