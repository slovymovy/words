                "senses": [
                    {
                        "sense_id": "29444df7-8741-3d50-8999-6536b6757cbb",
                        "entry_id": "79e6a26a-6bc0-3f25-8464-192a752b9e37",
                        "glosses": [
                            "Transformation en acide, action d’acidifier."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "04d555e6-26e1-4daf-be7c-8f07a887dc6d",
                                "sense_id": "29444df7-8741-3d50-8999-6536b6757cbb",
                                "text": "Quelle que soit la souche considérée, la croissance mycélienne conduit à l’acidification du milieu de culture."
                            },
                            {
                                "example_id": "0aa975f1-a723-4b6d-9f7c-1ab538a8b621",
                                "sense_id": "29444df7-8741-3d50-8999-6536b6757cbb",
                                "text": "«Quel climat a pu générer cette transition ? Une acidification, une glaciation ? C'est ce que nous cherchons», explique le géologue."
                            },
                            {
                                "example_id": "633ee1fe-7b4c-4f08-aa44-6ebfe4e2076b",
                                "sense_id": "29444df7-8741-3d50-8999-6536b6757cbb",
                                "text": "L’acidification de l’océan est la diminution progressive du pH des océans qui, entre 1751 et 2004, a diminué de 8,25 à 8,14."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "671c7aa6-18d3-4858-b931-07e2e010ffbf",
                        "source_entry_id": "79e6a26a-6bc0-3f25-8464-192a752b9e37",
