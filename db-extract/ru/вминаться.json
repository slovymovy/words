                "senses": [
                    {
                        "sense_id": "e66e9b07-03d1-3f4c-b113-cb31cf1400dd",
                        "entry_id": "f790a431-f00a-3705-9ca5-d891bcb7bfc4",
                        "glosses": [
                            "вдавливаться (обычно во что-то мягкое или вязкое)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "37ae209a-985f-4561-b78e-c4722b3d2a86",
                                "sense_id": "e66e9b07-03d1-3f4c-b113-cb31cf1400dd",
                                "text": "Чуть привстав на носки, она уверенно, как судебное определение, впечатала в губы мужа свои губы и не отрывала их, вся вминаясь в робковатого, струсившего Алексея Васильевича."
                            },
                            {
                                "example_id": "1c446737-2ec4-41e4-80a7-d2254b7738b8",
                                "sense_id": "e66e9b07-03d1-3f4c-b113-cb31cf1400dd",
                                "text": "Он прошёл по мокрой песчаной дорожке, американские сапоги вминались в песок, как в тёплый шоколад…"
                            }
                        ]
                    },
                    {
                        "sense_id": "2a67fc74-426b-35d3-8c94-3ffa4eef85a0",
                        "entry_id": "f790a431-f00a-3705-9ca5-d891bcb7bfc4",
                        "glosses": [
                            "образовывать вмятину; становиться вмятым"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f73c17f9-b7d7-4d86-b1ba-e427a0feee39",
                                "sense_id": "2a67fc74-426b-35d3-8c94-3ffa4eef85a0",
                                "text": "Голая земля с приникшей к ней мертвой прошлогодней травой лишь слегка вминалась под копытами."
                            }
                        ]
                    },
                    {
                        "sense_id": "2f86cede-c69b-3a75-bf94-91f950c2ba70",
                        "entry_id": "f790a431-f00a-3705-9ca5-d891bcb7bfc4",
                        "glosses": [
                            "страд. к вминать"
                        ],
                        "tags": [
                            "passive"
                        ],
                        "examples": [
                            {
                                "example_id": "e945d74d-90ad-404f-8164-906de83703c6",
                                "sense_id": "2f86cede-c69b-3a75-bf94-91f950c2ba70",
                                "text": "[Она] следила за тем, чтобы при культивации чёрного пара сорняки не вминались в землю, а срезались под корень."
                            }
                        ]
                    }
