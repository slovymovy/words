                ],
                "senses": [
                    {
                        "sense_id": "8dfeb3fe-3e4a-3588-9cd2-20347276b0a7",
                        "entry_id": "91e31cc6-d381-3bbf-a20c-b609b1075947",
                        "glosses": [
                            "Gesamtheit der Utensilien oder Bauteile zum Drehen"
                        ],
                        "tags": [
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "43d49fdf-e115-46f6-8ba2-c5c952524d38",
                                "sense_id": "8dfeb3fe-3e4a-3588-9cd2-20347276b0a7",
                                "text": "Leo kaufte das Drehzeug."
                            },
                            {
                                "example_id": "0aa7f7fa-e406-4666-814f-4d5175e4f272",
                                "sense_id": "8dfeb3fe-3e4a-3588-9cd2-20347276b0a7",
                                "text": "„Ein zweiter in Colditz thätiger Mann war Pankraz Zeller, Drechsler von Regensburg, später Bürger in Eger, 1583 angestellt für Colditz, wohin er mit dem Drehzeug übersiedeln sollte, um den Saal mit Leuchtern u. a. zu zieren und daran sein Meisterstück zu beweisen.“"
                            },
                            {
                                "example_id": "b96ed952-a255-4cc9-ad14-83fb24c3030d",
                                "sense_id": "8dfeb3fe-3e4a-3588-9cd2-20347276b0a7",
                                "text": "„Auch möchte es zur Empfehlung dienen, dass der Schlüssel für sich und aus dem Drehzeug herausgenommen, in einen gewöhnlichen Schraubstock gespannt, einen kleinen sehr bequemen Parallelschraubstock bildet.“"
                            },
                            {
                                "example_id": "cb55f67e-adfc-4764-8e8f-41197d78ea59",
                                "sense_id": "8dfeb3fe-3e4a-3588-9cd2-20347276b0a7",
                                "text": "„Die Nachtheile, welchen bisher derlei Maschinen unterliegen, bestehen in dem Drehzeug.“"
                            },
                            {
                                "example_id": "91936c2e-99e6-4996-8126-0ec05bc2eb0d",
                                "sense_id": "8dfeb3fe-3e4a-3588-9cd2-20347276b0a7",
                                "text": "„Beide Handwerke durften machen: Schneidzeug und allerlei Meißel, Bein- oder Barbiersägen und der Kammmacher Drehzeug.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
