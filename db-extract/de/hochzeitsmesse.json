                "senses": [
                    {
                        "sense_id": "db3d5824-2106-304d-8f87-2ec177b9da89",
                        "entry_id": "cbe8f18e-b948-38fd-a537-b29bf05cd78e",
                        "glosses": [
                            "Messe im Rahmen einer katholischen Hochzeit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "de5f0d8e-0b54-4aaa-b887-1fc0e20c7273",
                                "sense_id": "db3d5824-2106-304d-8f87-2ec177b9da89",
                                "text": "„Die Hochzeitsmesse wurde hauptsächlich in englischer Sprache abgehalten.“"
                            },
                            {
                                "example_id": "5148a769-9e5d-4d57-ae53-8ea0b74582f9",
                                "sense_id": "db3d5824-2106-304d-8f87-2ec177b9da89",
                                "text": "„Kaplan Regamy gestaltete eine schöne Hochzeitsmesse.“"
                            },
                            {
                                "example_id": "e53444ba-69b9-40dc-b58f-0778f039a823",
                                "sense_id": "db3d5824-2106-304d-8f87-2ec177b9da89",
                                "text": "„Nach der Hochzeitsmesse folgten Ritterspiele im Hof des kaiserlichen Palastes, bei denen sich, wie Loukas zur Kenntnis nahm, Fürst Alexios Angelos eifrig hervortat.“"
                            },
                            {
                                "example_id": "c717e699-6cce-402e-9ed4-91a86972cb06",
                                "sense_id": "db3d5824-2106-304d-8f87-2ec177b9da89",
                                "text": "„Nach der Hochzeitsmesse in der Burgkapelle begann das Fest des Jahrhundert!“"
                            },
                            {
                                "example_id": "4d1ed77c-0f60-4afa-89d1-659cf82785b8",
                                "sense_id": "db3d5824-2106-304d-8f87-2ec177b9da89",
                                "text": "„Aber da er bei den prächtigen Feierlichkeiten in Saint-Jean-de-Luz die Hochzeitsmesse lesen und die Ehe segnen sollte, nachdem er zuvor bei der in Spanien stattfindenden Trauung die wichtige Aufgabe erfüllt hatte, die Prokurationsunterlagen des Königs von Frankreich vorzulegen, verstand es sich von selbst, dass er seine eigenen Interessen vertrat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "845c6b9f-9da8-301b-8ca9-8ab4dd0b1625",
                        "entry_id": "cbe8f18e-b948-38fd-a537-b29bf05cd78e",
                        "glosses": [
                            "Messe (Ausstellung) rund um das Thema Hochzeit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8476b82e-950d-4e30-b2b6-eea033650d70",
                                "sense_id": "845c6b9f-9da8-301b-8ca9-8ab4dd0b1625",
                                "text": "„Rund 30 Prozent des Jahresumsatzes werde trotzdem auf einer solchen Hochzeitsmesse im Schnitt gemacht.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
