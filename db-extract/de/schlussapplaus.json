                        "examples": [
                            {
                                "example_id": "9beb7391-0cfe-4d4d-b64e-8e5f85924ebe",
                                "sense_id": "37d1eaa6-5712-373d-b9a7-06cd6189fee4",
                                "text": "„Man bleibt sitzen, bis die letzte Verbeugung erfolgt, der Schlussapplaus verklungen ist.“"
                            },
                            {
                                "example_id": "38c9ada3-40ed-472b-9ee3-523f520ac2c9",
                                "sense_id": "37d1eaa6-5712-373d-b9a7-06cd6189fee4",
                                "text": "„Beim Schlussapplaus vorne an der Rampe sehe ich in die erste Reihe.“"
                            },
                            {
                                "example_id": "986a950e-23e6-4bbb-8e86-6322352778aa",
                                "sense_id": "37d1eaa6-5712-373d-b9a7-06cd6189fee4",
                                "text": "„Als nach dem Schlussapplaus der Vorhang fiel, blieb noch eine knappe Stunde bis Mitternacht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
