        "nl-extract.jsonl": [
            {
                "entry_id": "6761a582-d480-3e15-91bb-3b9dcc2764db",
                "word": "opschikken",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "75c285cc-8b9a-3c6f-9b1d-8ce85cc5aa46",
                        "entry_id": "6761a582-d480-3e15-91bb-3b9dcc2764db",
                        "glosses": [
                            "door opschuiven plaats maken voor iemand"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dea358e7-b108-49a5-9fc8-c54a81a9513d",
                                "sense_id": "75c285cc-8b9a-3c6f-9b1d-8ce85cc5aa46",
                                "text": "Dat er tussen mannen en vrouwen nauwelijks verschillen zijn, is een bewering die aan de vermaarde schrijver Godfried Bomans niet was besteed. Als voorbeeld noemde hij het eendaagse uitstapje. Bij het uitje voor dames neemt eenieder gedisciplineerd haar plaats in. Zit een deelneemster krap, dan vraagt ze beleefd aan haar buurvrouw of die een stukje wil opschikken, waarna het gezelschap afreist om een kopje thee te nuttigen in Kraantje Lek. Oersaai, aldus Bomans."
                            },
                            {
                                "example_id": "57728e5a-737e-44c0-b2e1-ebb812640be5",
                                "sense_id": "75c285cc-8b9a-3c6f-9b1d-8ce85cc5aa46",
                                "text": "Om te bekijken of de groeiende maatschappelijke invloed van de islam ook in de vloekterminologie een rol is gaan spelen, proberen de onderzoekers bij hun huidige enquête zoveel mogelijk moslims te betrekken. Zal de god van de christenen nog meer moeten opschikken, dit keer voor nieuwe vloeken waarbij Allah het mikpunt vormt? Of nemen jonge moslims het jargon van hun autochtone leeftijdsgenoten over? 'Of moslims zoals wij religieus getinte vloeken hanteren, en welke dat dan wel zijn, is voorlopig afwachten', zegt Vandenbussche, 'maar vloekwoorden als fuck you en shit zullen onder allochtone jongeren vast wel circuleren.'"
                            }
                        ]
                    },
                    {
                        "sense_id": "37a7a9e3-f89d-35a8-8f43-cbc740504310",
                        "entry_id": "6761a582-d480-3e15-91bb-3b9dcc2764db",
                        "glosses": [
                            "iets mooier maken"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a5053b53-7b9b-44a7-8fb5-ee2a1bcb7497",
                        "source_entry_id": "6761a582-d480-3e15-91bb-3b9dcc2764db",
                        "source_sense_id": "37a7a9e3-f89d-35a8-8f43-cbc740504310",
                        "source_sense_description": "verfraaien",
                        "target_lang_word": "beautify",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "beautify",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2249e906-d48c-3cc0-ac73-17c3a00c3436",
                                        "entry_id": "fa20be2f-8a0d-37d2-9886-a59bd722725e",
                                        "glosses": [
                                            "To make beautiful; to increase the beauty of."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "15275149-e797-406e-bd0e-90351b1278c0",
                                                "sense_id": "2249e906-d48c-3cc0-ac73-17c3a00c3436",
                                                "text": "1592, Robert Greene, Greene's Groats-Worth of Wit, London: William Wright, “Robertoes Tale”\n[…] there is an vpstart Crow, beautified with our feathers, that with his Tygers hart wrapt in a Players hyde, supposes he is as well able to bombast out a blanke verse as the best of you:"
                                            },
                                            {
                                                "example_id": "37ed6104-6b74-4db8-96c6-8033ba2df705",
                                                "sense_id": "2249e906-d48c-3cc0-ac73-17c3a00c3436",
                                                "text": "And now, / This ornament [i.e. beard] / Makes me look dismal will I clip to form; / And what this fourteen years no razor touch’d, / To grace thy marriage-day, I’ll beautify."
                                            },
                                            {
                                                "example_id": "5857cc87-62aa-434b-b039-ca4511692acb",
                                                "sense_id": "2249e906-d48c-3cc0-ac73-17c3a00c3436",
                                                "text": "[…] she was at the other end of the room, beautifying a nosegay;"
                                            },
                                            {
                                                "example_id": "2b10e7b6-40fe-416e-934e-d02b33e49b36",
                                                "sense_id": "2249e906-d48c-3cc0-ac73-17c3a00c3436",
                                                "text": "“[…] I’m so thankful for friendship. It beautifies life so much.”"
                                            },
                                            {
                                                "example_id": "d0820470-4eec-4b09-a3ec-61d235358fbf",
                                                "sense_id": "2249e906-d48c-3cc0-ac73-17c3a00c3436",
                                                "text": "‘Boy, you take a big chance,’ Moses say. ‘Them pigeons there to beautify the park, not to eat. The people over here will kill you if you touch a fly.’"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2b9dc3bb-ad79-330b-9148-f5a6783e02cb",
                                        "entry_id": "fa20be2f-8a0d-37d2-9886-a59bd722725e",
                                        "glosses": [
                                            "To become beautiful."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a6368553-1882-4b16-85da-4124b2ee8036",
                                                "sense_id": "2b9dc3bb-ad79-330b-9148-f5a6783e02cb",
                                                "text": "[…] it must be a Prospect pleasing to God himself, to see his Creation for ever beautifying in his Eyes, and drawing nearer to him, by greater Degrees of Resemblance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c55edcf8-f384-327b-96c1-784c9f96de6a",
                                        "entry_id": "fa20be2f-8a0d-37d2-9886-a59bd722725e",
                                        "glosses": [
                                            "To make oneself beautiful."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8a206b79-e99d-49eb-b6ca-c38ca73d18ff",
                                                "sense_id": "c55edcf8-f384-327b-96c1-784c9f96de6a",
                                                "text": "She’d felt silly when she first put cucumbers on her eyes (to diminish puffiness), or oatmeal on her face (to cleanse the pores and absorb excess oils), or egg yolks in her hair (to make it shine). Her use of groceries had even made my mother laugh, then wonder if she should start to beautify."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9923df19-d00d-35eb-b438-2d5586828879",
                                        "entry_id": "fa20be2f-8a0d-37d2-9886-a59bd722725e",
                                        "glosses": [
                                            "Synonym of pretty-print."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2d1e3bbe-68cc-47e1-b460-e5efa6e0294a",
                        "source_entry_id": "6761a582-d480-3e15-91bb-3b9dcc2764db",
                        "source_sense_id": "37a7a9e3-f89d-35a8-8f43-cbc740504310",
                        "source_sense_description": "verfraaien",
                        "target_lang_word": "dress up",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dress up",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bd5d1ee7-c36e-3a0c-97c3-4c15438974fa",
                                        "entry_id": "d22faae3-8b97-34ae-b457-41be33a42518",
                                        "glosses": [
                                            "To put on special or fancy clothes."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "66baa17b-4bf6-4a27-8fa5-6af7477c3e92",
                                                "sense_id": "bd5d1ee7-c36e-3a0c-97c3-4c15438974fa",
                                                "text": "Everyone dressed up for the graduation ball."
                                            },
                                            {
                                                "example_id": "5609b7da-d21e-46e2-9543-04b87ac28bad",
                                                "sense_id": "bd5d1ee7-c36e-3a0c-97c3-4c15438974fa",
                                                "text": "I want a job where I don't have to dress up."
                                            },
                                            {
                                                "example_id": "2999cbf7-532f-48d0-80a6-b9cfaed28b35",
                                                "sense_id": "bd5d1ee7-c36e-3a0c-97c3-4c15438974fa",
                                                "text": "Runners had a fun day out in Friday's HKLRRC Boxing Day Race at Wan Chai Gap with most of the participants dressed up in costumes and braving the chilly weather."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f582d20-ec0d-374a-9894-f259a9d6f4fb",
                                        "entry_id": "d22faae3-8b97-34ae-b457-41be33a42518",
                                        "glosses": [
                                            "To put on a costume portraying oneself as a particular type of character or well-known person."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "often"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ac06bf70-ddaf-46bd-b932-9bcfbf6a3c41",
                                                "sense_id": "4f582d20-ec0d-374a-9894-f259a9d6f4fb",
                                                "text": "We're having a party on Saturday, but you must dress up as a famous historical figure."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "42191176-e1ec-34e1-86f1-cd36bc866d58",
                                        "entry_id": "d22faae3-8b97-34ae-b457-41be33a42518",
                                        "glosses": [
                                            "To put a costume on (someone) portraying them as a particular type of character or well-known person."
                                        ],
                                        "tags": [
                                            "often",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "95c6c36c-4553-4270-a796-70b6c210326e",
                                                "sense_id": "42191176-e1ec-34e1-86f1-cd36bc866d58",
                                                "text": "The cat hated when they dressed him up for Halloween."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "62585fb7-fd93-35c9-9cee-0bf5489bcd37",
                                        "entry_id": "d22faae3-8b97-34ae-b457-41be33a42518",
                                        "glosses": [
                                            "To decorate; to prettify."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "05d083d4-27ea-4615-a246-1a3197c06953",
                                                "sense_id": "62585fb7-fd93-35c9-9cee-0bf5489bcd37",
                                                "text": "Mistress, your father prays you leave your books,\nAnd help to dress your sister’s chamber up:\nYou know to-morrow is the wedding-day."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d09ee4c-96ba-341f-a7d5-0812e68f9ea9",
                                        "entry_id": "d22faae3-8b97-34ae-b457-41be33a42518",
                                        "glosses": [
                                            "To present in a favorable light."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b55e6fb5-ff72-4d75-bcfe-14ed4619f42f",
                                                "sense_id": "2d09ee4c-96ba-341f-a7d5-0812e68f9ea9",
                                                "text": "You can dress up that proposal however you want; it's still going to go over like a lead balloon."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
