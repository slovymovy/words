                    {
                        "sense_id": "58a11e29-4ae4-3b01-8ae9-ccbd45983871",
                        "entry_id": "aad3b782-2e69-33e6-90da-316af192e56e",
                        "glosses": [
                            "Gerät, um Radiosendungen zu empfangen, als Bestandteil einer Stereoanlage. Der Verstärker ist in einem Tuner nicht inbegriffen – einen Verstärker mit integriertem Tuner nennt man Receiver."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a45f7026-729b-4463-8459-4b1ab9c4657f",
                                "sense_id": "58a11e29-4ae4-3b01-8ae9-ccbd45983871",
                                "text": "Der Verstärker funktioniert noch, aber der Tuner ist kaputt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e51ec9aa-807e-34b6-bd0b-ba49bc871af1",
                        "entry_id": "aad3b782-2e69-33e6-90da-316af192e56e",
                        "glosses": [
                            "Person oder ein Unternehmen, die/das ein Fahrzeugtuning durchführt"
                        ],
                        "tags": [
                            "Automobil-Technik"
                        ],
                        "examples": [
                            {
                                "example_id": "328f8029-db90-4ea5-a6b2-2e9c96221846",
                                "sense_id": "e51ec9aa-807e-34b6-bd0b-ba49bc871af1",
                                "text": "Neben seinem normalen Job in der Autowerkstatt verdient er sich ein paar zusätzliche Euro als Tuner."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
