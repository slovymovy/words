                    {
                        "translation_id": "c70ac916-b6b7-4154-93f7-59f0591824d9",
                        "source_entry_id": "898bf1ca-68a0-3505-a721-deaf4559af7c",
                        "source_sense_id": "3bde592b-cc95-31fb-8f5f-3e71e3c0ce40",
                        "target_lang_word": "ombudsman",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ombudsman",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "c039572c-9748-384a-8ef5-32cac433f1d5",
                                        "entry_id": "8f3b7f7c-acb0-3304-b5de-0e72ca79792d",
                                        "glosses": [
                                            "een ambtenaar die de taak heeft om als onpartijdige instantie klachten van individuele burgers tegen de overheid, instellingen en bedrijven te onderzoeken"
                                        ],
                                        "tags": [
                                            "beroep"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f19811ff-c32e-4fe6-ad92-094905328568",
                                                "sense_id": "c039572c-9748-384a-8ef5-32cac433f1d5",
                                                "text": "\"Op deze site vindt u de weg naar de juiste ombudsman die kan helpen om uw probleem op te lossen\"."
                                            },
                                            {
                                                "example_id": "b3db9aab-7515-4073-bc33-4c862546ab71",
                                                "sense_id": "c039572c-9748-384a-8ef5-32cac433f1d5",
                                                "text": "Vier op de tien zegt tegen NOS op 3 dat ze inderdaad wangedrag meemaken, zoals een conflict met hun promotor, pesten of buitensluiting. Maar ze noemen ook voorbeelden van racisme, seksisme en seksueel grensoverschrijdend gedrag."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3086ae24-bd96-4207-bc38-39ac79eaff7c",
                        "source_entry_id": "898bf1ca-68a0-3505-a721-deaf4559af7c",
                        "source_sense_id": "3bde592b-cc95-31fb-8f5f-3e71e3c0ce40",
                        "target_lang_word": "Ombudsmann",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ombudsmann",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6ed4cf62-50ed-3f72-9ae2-1907ba1a0deb",
                                        "entry_id": "769ec601-f33f-336b-a7d1-09be09cda6fb",
                                        "glosses": [
                                            "männlicher Vertreter eines Personenkreises in nichtgerichtlichen Streitfällen gegenüber einer Organisation, Firma oder Institution"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "49f8b5fb-5433-4a44-a855-5fd827bbc51f",
                                                "sense_id": "6ed4cf62-50ed-3f72-9ae2-1907ba1a0deb",
                                                "text": "Der Ombudsmann der Versicherung konnte den Streitfall zur Zufriedenheit des Kunden lösen."
                                            },
                                            {
                                                "example_id": "613f341a-b23b-424a-af29-32b888d5c98e",
                                                "sense_id": "6ed4cf62-50ed-3f72-9ae2-1907ba1a0deb",
                                                "text": "„Der Bonner Juraprofessor Wolfgang Löwer, Sprecher des »Ombudsmanns« der Deutschen Forschungsgemeinschaft, war nach seinen Angaben bereits an vier oder fünf Verfahren beteiligt, an deren Ende die Doktoren keinen Titel mehr hatten.“"
                                            },
