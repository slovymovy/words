            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "d3246f96-5619-3f85-bc0c-d1a9fd80ac02",
                    "sense_definition": "ohne festes Ziel in verschiedene Richtungen; hin und her",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "bewegung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die Touristen irrten ziellos in den engen Gassen der Altstadt <w>umher</w>.",
                            "target_lang_translations": {
                                "en": "The tourists wandered aimlessly <w>around</w> in the narrow alleyways of the old town."
                            }
                        },
                        {
                            "text": "Er ging im Zimmer unruhig auf und ab und blickte suchend <w>umher</w>.",
                            "target_lang_translations": {
                                "en": "He paced restlessly up and down in the room, looking <w>around</w> searching for something."
                            }
                        }
                    ],
                    "synonyms": [
                        "herum"
                    ],
                    "antonyms": [
                        "geradeaus"
                    ],
                    "common_phrases": [
                        "ziellos umherirren",
                        "suchend umherblicken"
                    ],
                    "target_lang_definitions": {
                        "en": "in various directions without a fixed destination; to and fro, back and forth"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "around",
                                "target_lang_sense_clarification": "from place to place aimlessly"
                            },
                            {
                                "target_lang_word": "about",
                                "target_lang_sense_clarification": "here and there without a set course"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5cdeafa6-33c5-301e-a5e4-719ce8b41522",
                    "sense_definition": "in der näheren Umgebung; im Umkreis ringsum",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "ort",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wir standen auf dem Gipfel, und rings <w>umher</w> erstreckten sich die Berge.",
                            "target_lang_translations": {
                                "en": "We stood on the summit, and all <w>around</w> stretched the mountains."
                            }
                        },
                        {
                            "text": "Auf dem Hof und rings <w>umher</w> lagen nach dem Sturm abgebrochene Äste.",
                            "target_lang_translations": {
                                "en": "In the courtyard and all <w>around</w>, broken branches lay after the storm."
                            }
                        }
                    ],
                    "synonyms": [
                        "ringsherum",
                        "ringsum",
                        "rundherum"
                    ],
                    "common_phrases": [
                        "rings umher"
                    ],
                    "target_lang_definitions": {
                        "en": "in the surrounding area; all around"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "around",
                                "target_lang_sense_clarification": "in the vicinity or surrounding area"
                            },
                            {
                                "target_lang_word": "all around",
                                "target_lang_sense_clarification": "on every side, in all directions nearby"
                            }
                        ]
                    }
                }
            ]
        }
