                "senses": [
                    {
                        "sense_id": "027577bd-249b-3e73-b294-05a134e6bd42",
                        "entry_id": "c4a54e72-4f70-3f64-94cf-29264819703e",
                        "glosses": [
                            "Amtsträger in leitender Funktion in der römischen Kurie der römisch-katholischen Kirche"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf853687-cccd-4b2e-8357-83f9981371ac",
                                "sense_id": "027577bd-249b-3e73-b294-05a134e6bd42",
                                "text": "„Sobald nämlich ein Papst gestorben ist, erlöschen auf der Stelle alle vatikanischen Amtswürden: Kein noch so machtbewusster Kurienpräfekt, kein Substitut, kein vatikanischer Richter hat dann als solcher etwas zu sagen.“"
                            },
                            {
                                "example_id": "3e4d3ad9-cb23-4640-89e5-2a7b76038fc0",
                                "sense_id": "027577bd-249b-3e73-b294-05a134e6bd42",
                                "text": "„Und so wird die Synode in der Kurie zum Sinodone, zur ›tollen Synode‹. ›Hoffen wir, dass es keine Enttäuschung wird‹, raunt ein Kurienpräfekt.“"
                            },
                            {
                                "example_id": "35f4c20d-c39a-49bc-9ed7-557057cb939a",
                                "sense_id": "027577bd-249b-3e73-b294-05a134e6bd42",
                                "text": "„Im Namen der neuen Mitkardinäle dankte der italienische Kurienpräfekt Angelo Amato dem Papst für die Berufung in das Heilige Kollegium.“"
                            },
                            {
                                "example_id": "8daef1af-c8c2-4128-9e5d-49ca5ffa5b09",
                                "sense_id": "027577bd-249b-3e73-b294-05a134e6bd42",
                                "text": "„Deren Leiter, der frühere Fernsehmanager Paolo Ruffini und erste Laie auf dem Posten eines Kurienpräfekten, sei ganz schlecht vorbereitet gewesen, war zu hören.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
