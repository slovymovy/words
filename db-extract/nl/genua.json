                    },
                    {
                        "translation_id": "1dd48bd0-cdce-40b9-bb8b-b6466ac7cf8f",
                        "source_entry_id": "cb038cea-6ae1-3b77-96c7-69d247f7049f",
                        "source_sense_id": "1cce6204-c9bb-3872-9b5b-0a07da1b3178",
                        "source_sense_description": "een stad in Noordwest-Italië",
                        "target_lang_word": "Genua",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Genua",
