                        "glosses": [
                            "In a generous manner, in a way that is giving or ample."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f5fd2737-a528-4c2a-97bb-5850e0dbad53",
                                "sense_id": "ede7b638-8abc-396b-8d7a-3cc014248f73",
                                "text": "The dessert generously filled a large plate."
                            },
                            {
                                "example_id": "e5cf68b2-5a18-4273-a3b7-a4c1834f99dd",
                                "sense_id": "ede7b638-8abc-396b-8d7a-3cc014248f73",
                                "text": "He generously donated what little he could."
                            },
                            {
                                "example_id": "c3cacb83-728a-4f17-a6db-7e9964b911bd",
                                "sense_id": "ede7b638-8abc-396b-8d7a-3cc014248f73",
                                "text": "Consequently, to brighten up a shady spot in the front garden we have recently added ‘Harlequin’, its green foliage splashed generously with white, though hopefully not to be splashed generously with a multicolour yawn."
                            }
                        ]
                    }
