                "senses": [
                    {
                        "sense_id": "1aeaab24-731e-329a-afe7-d7e24327267c",
                        "entry_id": "c700bb35-66ce-3509-af5b-e970ed051cc9",
                        "glosses": [
                            "Person, die an einer Hochschule Biologie studiert"
                        ],
                        "tags": [
                            "Bildungswesen"
                        ],
                        "examples": [
                            {
                                "example_id": "4c39d655-f9c6-42a5-9aa9-4db4f3d9e1fe",
                                "sense_id": "1aeaab24-731e-329a-afe7-d7e24327267c",
                                "text": "„Der gemeine Biologiestudent (Discipulus baumschmuserus) ist eine in den Kellerlaboren der Universitäten beheimatete Anomalie, die, aus bisher nicht geklärten Gründen, der natürlichen Selektion entkommt.“"
                            },
                            {
                                "example_id": "41fc4578-1095-4e81-b5a6-d374c5828ec1",
                                "sense_id": "1aeaab24-731e-329a-afe7-d7e24327267c",
                                "text": "„Er war ein Musterschüler, der beste Biologiestudent des ganzen Semesters, und hatte keine Ahnung, wie es sich mit einer durchschnittlichen Intelligenz lebte.“"
                            },
                            {
                                "example_id": "10f48ed2-2d7a-4212-bab6-7f559f2327bd",
                                "sense_id": "1aeaab24-731e-329a-afe7-d7e24327267c",
                                "text": "„Zwar sind Wissen und Charakter individuell verschieden, aber über einen Kamm geschoren stellen wir fest, dass die Biologiestudenten wissenschaftlich am meisten orientiert sind.“"
                            },
                            {
                                "example_id": "8b939602-da3e-4450-9139-34b076927d40",
                                "sense_id": "1aeaab24-731e-329a-afe7-d7e24327267c",
                                "text": "„Als für das Studienjahr 1956/1957 wieder Biologiestudenten immatrikuliert werden konnten, atmete ich auf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
