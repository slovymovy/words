                    "frequency": "Middle",
                    "semantic_group_id": "colorer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous voulons <w>teindre</w> ces vieux rideaux en lin pour leur donner un style plus chaleureux."
                        },
                        {
                            "text": "Cet artisan <w>teint</w> la laine avec des pigments naturels extraits de diverses plantes."
                        }
                    ],
                    "synonyms": [
                        "colorer"
                    ],
                    "antonyms": [
                        "décolorer",
                        "blanchir"
                    ],
                    "common_phrases": [
                        "teindre du tissu",
                        "teindre un vêtement",
                        "teindre en bleu"
                    ]
                },
                {
                    "sense_id": "655541b8-dcaf-3bc1-9851-b496b7997a04",
                    "sense_definition": "Appliquer un produit cosmétique sur ses cheveux, sa barbe ou ses poils pour en modifier la couleur.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "colorer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle a décidé de se <w>teindre</w> les cheveux en blond avant de partir en vacances d'été."
                        },
                        {
                            "text": "Il <w>teint</w> sa barbe tous les mois pour masquer l'apparition de poils blancs."
                        }
                    ],
                    "synonyms": [
                        "colorer"
                    ],
                    "antonyms": [
                        "décolorer"
                    ],
                    "common_phrases": [
                        "se teindre les cheveux",
                        "teindre en blond",
                        "teindre sa barbe"
                    ]
                },
                {
                    "sense_id": "27e0f3f6-d83d-3075-a5f0-c89115556c8b",
                    "sense_definition": "Communiquer sa propre couleur à une surface ou à un corps par simple contact.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Attention en ramassant ces mûres sauvages, car leur jus très foncé <w>teint</w> rapidement les doigts."
                        },
                        {
                            "text": "En tombant sur le carrelage clair, le liquide rouge a immédiatement <w>teint</w> les joints."
