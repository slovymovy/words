                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "nazwisko",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Pan <w>Szczęk</w> pracuje w naszym dziale księgowości.",
                            "target_lang_translations": {
                                "ru": "Господин <w>Щенк</w> работает в нашем бухгалтерском отделе."
                            }
                        },
                        {
                            "text": "Dzisiaj na spotkanie przyjdzie również pan <w>Szczęk</w>.",
                            "target_lang_translations": {
                                "ru": "Сегодня на встречу придет также господин <w>Щенк</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "męskie nazwisko"
                        }
                    ],
                    "target_lang_definitions": {
