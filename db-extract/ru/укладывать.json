                                                "sense_id": "c276837a-ef13-358e-96d7-5c3860465d7a",
                                                "text": "„Bismarck verlegte seinen Hauptwohnsitz nach Friedrichsruh im Sachsenwald bei Hamburg.“"
                                            },
