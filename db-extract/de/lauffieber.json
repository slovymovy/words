                "senses": [
                    {
                        "sense_id": "6bbf5db7-6e4b-3a50-9752-eb1b52dc5e4f",
                        "entry_id": "2fb413d5-231a-396f-b821-4d94542c52df",
                        "glosses": [
                            "starke, mitreißende Begeisterung fürs Laufen"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "b7c69463-2eb6-4cd5-b7e9-03f83b0add4a",
                                "sense_id": "6bbf5db7-6e4b-3a50-9752-eb1b52dc5e4f",
                                "text": "„Bist du erst einmal vom Lauffieber angesteckt, kannst du nicht mehr aufhören.“"
                            },
                            {
                                "example_id": "e8759af1-fa64-4a78-bb2c-e0f167a289ed",
                                "sense_id": "6bbf5db7-6e4b-3a50-9752-eb1b52dc5e4f",
                                "text": "„Es war auch ein ganz andere Atmosphäre und Gefühl – das Lauffieber hat mich jetzt gepackt.“"
                            },
                            {
                                "example_id": "dd7c508d-588f-4a7d-848a-792842183b6e",
                                "sense_id": "6bbf5db7-6e4b-3a50-9752-eb1b52dc5e4f",
                                "text": "„Den ein oder anderen Schüler hat durch den Gutenberg-Marathon 2023 sicherlich das Lauffieber gepackt.“"
                            },
                            {
                                "example_id": "7a8a922f-3c1f-44c7-85c3-94cfd25e49c5",
                                "sense_id": "6bbf5db7-6e4b-3a50-9752-eb1b52dc5e4f",
                                "text": "„Wer sich vom Lauffieber hat anstecken lassen findet bei unserem Lauf-1×1 hilfreiche Tipps und Tricks.“"
                            },
                            {
                                "example_id": "ca4de44b-9777-462a-9478-04f840dca92a",
                                "sense_id": "6bbf5db7-6e4b-3a50-9752-eb1b52dc5e4f",
                                "text": "„Deutschland, ja die ganze Welt ist im Lauffieber.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
