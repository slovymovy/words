                    }
                ],
                "senses": [
                    {
                        "sense_id": "62900372-d08e-3067-a259-5107ae26affe",
                        "entry_id": "263d1141-5a61-35ca-999e-c60ed34fcb0f",
                        "glosses": [
                            "rodzaj szala lub chusty noszonej głównie przez muzułmanki, zakrywającej głowę, uszy, włosy i szyję, ale pozostawiającej twarz odsłoniętą"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e82576ca-6e36-43c2-abeb-03272970f099",
                                "sense_id": "62900372-d08e-3067-a259-5107ae26affe",
                                "text": "…w Egipcie, gdzie dozwolony jest strój europejski, młode, wykształcone i eleganckie kobiety same decydują się na nałożenie hidżabu"
                            },
                            {
                                "example_id": "4031741a-0078-4707-83f0-780f5f6cc520",
                                "sense_id": "62900372-d08e-3067-a259-5107ae26affe",
                                "text": "Termin hidżab obejmuje nie tylko ubranie i okrycie całego ciała, lecz również zachowanie w obecności kobiet…"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "16d7e278-0028-3b81-b9ec-1fc5efaeb237",
                        "entry_id": "263d1141-5a61-35ca-999e-c60ed34fcb0f",
                        "glosses": [
                            "tradycyjna zasada muzułmańskiego kobiecego i męskiego sposobu ubierania, ale także zachowywania się, zgodna z nakazem religijnej przyzwoitości, cnotliwości bądź skromności"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4f5806a7-3737-437f-ae9d-de9474d633ce",
                                "sense_id": "16d7e278-0028-3b81-b9ec-1fc5efaeb237",
                                "text": "Termin hidżab obejmuje nie tylko ubranie i okrycie całego ciała, lecz również zachowanie w obecności kobiet…"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0c00577c-14d1-4217-8669-2be14fb6d938",
                        "source_entry_id": "263d1141-5a61-35ca-999e-c60ed34fcb0f",
                        "source_sense_id": "62900372-d08e-3067-a259-5107ae26affe",
                        "target_lang_word": "hijab",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hijab",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1e73fe88-e863-3bd9-9254-1ff4cdccba50",
                                        "entry_id": "d8bd3109-b54e-32ec-b4b4-509c0420f08d",
                                        "glosses": [
                                            "A traditional headscarf worn by Muslim women, covering the hair and neck."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "384e4b89-8af1-3911-b7a5-b2282405750f",
                                        "entry_id": "d8bd3109-b54e-32ec-b4b4-509c0420f08d",
                                        "glosses": [
                                            "The practice, among Muslim women, of covering the body after the age of puberty in front of non-related (non-family) adult males."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4a7c80fa-7d5f-45f3-a559-a44a5c0a2ec0",
                                                "sense_id": "384e4b89-8af1-3911-b7a5-b2282405750f",
                                                "text": "The belief that Muslim females observe hijab because men force them to do so insults some Muslim females who have based their decision on their understanding of Islam."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7a83ce76-3823-4f7a-9dc9-5cbcb4080511",
                        "source_entry_id": "263d1141-5a61-35ca-999e-c60ed34fcb0f",
                        "source_sense_id": "62900372-d08e-3067-a259-5107ae26affe",
                        "target_lang_word": "hijab",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hijab",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "94280339-9623-3dd3-9048-49b14928a68c",
                                        "entry_id": "9fdada4a-4bf9-3802-9198-7e7f70bbb4ee",
                                        "glosses": [
                                            "Vêtement que les femmes musulmanes portent, qui cache selon les diverses traditions nationales tout ou partie de leur tête, notamment les cheveux, leur cou, et parfois estompe les formes de leur corps."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d81774e-de54-431c-818e-c21a76bd4066",
                                                "sense_id": "94280339-9623-3dd3-9048-49b14928a68c",
                                                "text": "Hedjab (ou hijab). Tenue islamique correcte, littéralement « celui qui empêche de voir ». À l’origine toute chose (tissu, enceinte, paravent) qui cache, qui empêche de voir, qui fait barrière en rendant impossible le contact entre deux choses."
                                            },
                                            {
                                                "example_id": "14d6bfc0-e540-489c-ad74-3c279d62d292",
                                                "sense_id": "94280339-9623-3dd3-9048-49b14928a68c",
                                                "text": "Si le hijab n’a pas de signification religieuse, s’il n’est que « décoratif », pourquoi ce refus obstiné de l’enlever pendant quelques heures ?"
                                            },
                                            {
                                                "example_id": "872ba4a2-999c-43fd-ba2a-f3feb60491e0",
                                                "sense_id": "94280339-9623-3dd3-9048-49b14928a68c",
                                                "text": "Il faisait valoir que «le respect ne doit pas altérer le fait que le hijab, le niqab et la burka sont aussi des instruments d’oppression pour des millions de filles et de femmes dans le monde qui n’ont pas la possibilité de faire un choix»."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a92c1c2e-6d8a-4a37-ad2c-31a11ef24301",
                        "source_entry_id": "263d1141-5a61-35ca-999e-c60ed34fcb0f",
