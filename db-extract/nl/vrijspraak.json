                ],
                "senses": [
                    {
                        "sense_id": "b68f0c88-d7c8-3fe4-bfac-41200f12f164",
                        "entry_id": "a770cf52-a5a3-388c-bb6b-4bd75cb22abd",
                        "glosses": [
                            "uitspraak in een strafproces, die inhoudt dat de rechter niet wettig en overtuigend bewezen acht dat de verdachte het ten laste gelegde feit heeft begaan"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a750270e-1498-481c-9961-312b0173d6f1",
                                "sense_id": "b68f0c88-d7c8-3fe4-bfac-41200f12f164",
                                "text": "Vrijspraak betekent niet dat je het niet gedaan hebt, het betekent alleen maar dat het niet bewezen kan worden."
                            },
                            {
                                "example_id": "acc4bc26-adeb-43be-a598-aebedd1899aa",
                                "sense_id": "b68f0c88-d7c8-3fe4-bfac-41200f12f164",
                                "text": "De Nederlandse levensmiddelentechnoloog Harm Fitié (44), in China wegens doodslag op zijn buurman tot twaalf jaar cel veroordeeld, heeft al zijn hoop op vrijspraak of een nieuw proces gevestigd op het hooggerechtshof in Beijing. „Hij heeft geloof in het Chinese systeem niet helemaal verloren. Dat houdt hem op de been. Zwaar is het wel”, vertelt zijn Franse vriendin Dianne Vandesmet. Zij werkte in Beijing als journaliste bij de Chinese staatstelevisie en bij de Franse Kamer van Koophandel."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "12fdb576-d957-4e67-9d7d-f3fd768dfe4f",
                        "source_entry_id": "a770cf52-a5a3-388c-bb6b-4bd75cb22abd",
                        "source_sense_id": "b68f0c88-d7c8-3fe4-bfac-41200f12f164",
                        "target_lang_word": "Freispruch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Freispruch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5b6e270c-eeac-3ff8-89ae-1ecdaf13fae5",
                                        "entry_id": "e5046125-4e41-37c3-a8c2-953d78ae817c",
                                        "glosses": [
                                            "gerichtlicher Abschluss eines Strafverfahrens, bei dem der Angeklagte für unschuldig erklärt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83b24aa6-d70b-47d1-90e2-7634f64b46fa",
                                                "sense_id": "5b6e270c-eeac-3ff8-89ae-1ecdaf13fae5",
                                                "text": "„Ähnliche Beschuldigungen eines Teenagers führten 2005 zu einem ‚Jahrhundertprozess‘, der mit einem Freispruch endete.“"
                                            },
                                            {
                                                "example_id": "7fa101e0-5501-463a-b91f-d0d54d2f1f76",
                                                "sense_id": "5b6e270c-eeac-3ff8-89ae-1ecdaf13fae5",
                                                "text": "„Auf keinen Fall durfte ich aber ohne seine Zustimmung einen Freispruch beantragen oder im Strafmaß heruntergehen.“"
                                            },
                                            {
                                                "example_id": "53b6067a-0523-4ba3-a2c0-dd2c7bee2219",
                                                "sense_id": "5b6e270c-eeac-3ff8-89ae-1ecdaf13fae5",
                                                "text": "„Der Freispruch verschaffte Akwa nur eine kurze Atempause.“"
                                            },
                                            {
                                                "example_id": "d8b13bbc-7664-4cc4-944b-1b9cfa22d03c",
                                                "sense_id": "5b6e270c-eeac-3ff8-89ae-1ecdaf13fae5",
                                                "text": "„Gleich nach dem Freispruch muß dieser, der gewähnt hatte, nun bald nach La Coste aufbrechen zu können, zu seinem Schrecken erfahren, daß die königliche Lettre de chachet unverändert weiter gelte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
