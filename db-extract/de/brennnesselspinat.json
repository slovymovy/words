                        "entry_id": "fcd2fc30-1975-3188-a6de-8f32eeee6197",
                        "glosses": [
                            "Gericht aus jungen Brennnesseln, die in der Art von Spinat zubereitet werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "64b2da64-0633-4e81-98b5-7c13bc9b8ffe",
                                "sense_id": "0edf48eb-c14d-3fe9-b764-6d1560c3f96d",
                                "text": "„Brennnesselspinat schmeckt, gemischt mit Giersch, sehr lecker und als Anwendung in einer Frühjahrskur tut dieser Spinat nicht nur dem Körper gut, sondern er treibt allerlei ‚Wehwehchen‘ und Schlacken aus dem Körper.“"
                            },
                            {
                                "example_id": "854aa4c9-8d64-4b0a-8835-af88c8cc3df3",
                                "sense_id": "0edf48eb-c14d-3fe9-b764-6d1560c3f96d",
                                "text": "„Nechyba erhitzte den Brennnesselspinat und rührte dann die kalte Einbrenn ein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
