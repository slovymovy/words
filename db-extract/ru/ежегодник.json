                                            {
                                                "example_id": "5e582cdc-c26e-4c79-9d50-16451fb7c3ef",
                                                "sense_id": "f1243a4e-cdf6-3fe1-a415-f0bc486c1f38",
                                                "text": "On lui doit de nombreux fascicules édités à compte d’auteur, qui constituent d’irremplaçables annuaires, consacrés à l’extrême droite,à l’extrême gauche,aux religions minoritaires et aux conspirationnismes."
                                            },
                                            {
                                                "example_id": "c679c019-6d04-47cd-80af-c427e6787e20",
                                                "sense_id": "f1243a4e-cdf6-3fe1-a415-f0bc486c1f38",
                                                "text": "L’annuaire du Commerce maritime, de l’Institut, du Bureau des longitudes, des téléphones."
                                            },
                                            {
                                                "example_id": "0d46d7b8-bd81-4ccc-b292-7e1c325aa1f8",
                                                "sense_id": "f1243a4e-cdf6-3fe1-a415-f0bc486c1f38",
                                                "text": "Si on interroge très souvent un annuaire, on le met à jour plus rarement."
