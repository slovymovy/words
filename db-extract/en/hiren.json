                        "examples": [
                            {
                                "example_id": "d6b4172e-f4c9-47cb-b992-a9a078f4baec",
                                "sense_id": "9234398d-6b25-3ce8-97af-90a2c67f327b",
                                "text": "Pistol. Haue we not Hiren here? / Host. On my word Captaine there's none such here."
                            },
                            {
                                "example_id": "92b9cfe5-f41e-41d7-8989-e33ea0c30c4a",
                                "sense_id": "9234398d-6b25-3ce8-97af-90a2c67f327b",
                                "text": "What a number of these Sirens, Hirens, Cockatrices, Courtezans, in plaine English, Harlots, swimme amongst vs!"
                            },
                            {
                                "example_id": "92557a2c-d869-4535-8d0b-4a4dd7cff4d2",
                                "sense_id": "9234398d-6b25-3ce8-97af-90a2c67f327b",
                                "text": "I summoned all the twenty hirens of the house (including the sweet-lipped, glossy chinned darling) into my resurrected presence."
                            }
                        ]
                    }
