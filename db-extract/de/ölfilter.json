                                "example_id": "211c710b-93a9-4a04-af13-606206f558a0",
                                "sense_id": "2fc9e404-6813-348a-85b6-9a25caa4b290",
                                "text": "„Das Ölfilter besteht in der Regel aus einem Ölfiltergehäuse und einem sogenannten Ölfiltertopf, in dem das eigentliche Ölfilterelement untergebracht ist.“"
                            }
