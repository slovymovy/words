{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "eacd20d3-596e-325b-bbe7-8e59e0a2856a",
                    "sense_definition": "A contractual financial arrangement where money or assets are held by a third party until specific conditions are fulfilled.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "escrow_financial",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The buyers placed their deposit into an <w>escrow</w> account before the property inspection was complete. ",
                            "target_lang_translations": {
                                "zh": "在房产检查完成前，买方将定金存入了<w>托管</w>账户。"
                            }
                        },
                        {
                            "text": "Until all legal conditions are fully met, the money remains safely held in <w>escrow</w>.",
                            "target_lang_translations": {
                                "zh": "在所有法律条件完全满足之前，这笔钱将安全地处于<w>托管</w>状态。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "in escrow",
                        "escrow account",
                        "escrow agent"
                    ],
                    "target_lang_definitions": {
                        "zh": "一种合同金融安排，指资金或资产由第三方代管，直到满足特定条件为止。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "托管",
                                "target_lang_sense_clarification": "指将资产或资金交由第三方代为保管的法律或金融状态。"
                            },
                            {
                                "target_lang_word": "第三方监管",
                                "target_lang_sense_clarification": "强调由中立的第三方机构对资金进行监管的金融行为。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bfcaf739-0199-3e5f-8b1e-a3b5bdf58997",
                    "sense_definition": "The actual funds, money, or property that are kept in trust under an escrow agreement.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "escrow_financial",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The court will determine which party is entitled to receive the <w>escrow</w>. ",
                            "target_lang_translations": {
                                "zh": "法院将裁定哪一方有权获得该笔<w>托管资金</w>。"
                            }
                        },
                        {
                            "text": "Once the contract terms were verified, the firm released the <w>escrow</w> to the seller.",
                            "target_lang_translations": {
                                "zh": "合同条款核实后，公司将<w>托管资金</w>发放给了卖方。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "release the escrow",
                        "hold the escrow"
                    ],
                    "target_lang_definitions": {
                        "zh": "根据托管协议被存放在信托中的实际资金、款项或财产。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "托管资金",
                                "target_lang_sense_clarification": "指处于托管状态下的具体款项。"
                            },
                            {
                                "target_lang_word": "托管资产",
                                "target_lang_sense_clarification": "指处于托管状态下的具体财产或资产。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8a58e1e3-a2a0-3e8d-8333-2743785a7dd3",
                    "sense_definition": "To deposit or place funds, documents, or property in the custody of a third party until conditions are met.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The law requires lenders to <w>escrow</w> monthly tax and insurance payments for certain loans. ",
                            "target_lang_translations": {
                                "zh": "法律要求贷款方对某些贷款的每月税费和保险费进行<w>托管</w>。"
                            }
                        },
                        {
                            "text": "The buyer agreed to <w>escrow</w> funds to ensure the repairs would be completed promptly.",
                            "target_lang_translations": {
                                "zh": "买方同意<w>托管</w>资金，以确保维修工作能及时完成。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "escrow funds",
                        "escrow payments"
                    ],
                    "target_lang_definitions": {
                        "zh": "将资金、文件或财产存放在第三方保管处，直到满足特定条件。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "托管",
                                "target_lang_sense_clarification": "指将资产或资金存入托管账户的行为。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}