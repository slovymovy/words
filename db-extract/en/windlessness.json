                    {
                        "translation_id": "50f13a37-51e2-4cb4-aa2c-ffebdfab4c52",
                        "source_entry_id": "670198df-e179-3741-b8a0-3e74abe8862d",
                        "source_sense_id": "9f29b1e7-9447-30c5-9952-1b2d8417692f",
                        "source_sense_description": "Translations",
                        "target_lang_word": "windstilte",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "windstilte",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "e029ca0f-3bb6-373a-8c2a-9b016699a998",
                                        "entry_id": "73aa82d2-f9d2-3b4a-95fb-573b103df0ff",
                                        "glosses": [
                                            "periode met geen of weinig wind"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7481154c-d5de-4bba-a8f7-165a926d23f1",
                                                "sense_id": "e029ca0f-3bb6-373a-8c2a-9b016699a998",
                                                "text": "Het was verschrikkelijk warm, maar daar leek niemand zich iets van aan te trekken en het was ook veel erger geweest tijdens de windstilte op de Rode Zee."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7d181143-0dbc-3413-aeb5-d7b130f7d1cf",
                                        "entry_id": "73aa82d2-f9d2-3b4a-95fb-573b103df0ff",
                                        "glosses": [
                                            "rustige periode"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7c069189-b68e-40b0-9d48-60f447a531b3",
                                                "sense_id": "7d181143-0dbc-3413-aeb5-d7b130f7d1cf",
                                                "text": "Na de verhuizing, tijdens de windstilte waarin de zaak-Noppen terecht was gekomen, vond hij pas echt tijd zich in het dossier van Egberts'majesteitsschennis te verdiepen."
                                            },
                                            {
                                                "example_id": "dac76993-0764-4a54-b4db-c302c0508a32",
                                                "sense_id": "7d181143-0dbc-3413-aeb5-d7b130f7d1cf",
                                                "text": "Met de bekendmaking Vincent Wevers, Wolther Kooistra en Nico Zijp geen toegang te geven tot de Olympische Spelen hoopt de KNGU 105 dagen voor de start van Tokio 2020 windstilte te creëren rond de Nederlandse turnploeg."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d786f1e3-87ea-4b40-8c4a-a14335fce8b4",
                        "source_entry_id": "670198df-e179-3741-b8a0-3e74abe8862d",
                        "source_sense_id": "9f29b1e7-9447-30c5-9952-1b2d8417692f",
                        "source_sense_description": "Translations",
                        "target_lang_word": "Windstille",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Windstille",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a9e77d9e-6b6c-3838-ab68-096466b5e5a4",
                                        "entry_id": "1e496ccf-f965-3c4b-9f00-82827a1c9eaa",
                                        "glosses": [
                                            "die Abwesenheit von Wind; das Fehlen jeglichen Windes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "97df46f1-2a9c-4daa-86bb-225caecad7b7",
                                                "sense_id": "a9e77d9e-6b6c-3838-ab68-096466b5e5a4",
                                                "text": "Gestern herrschte völlige Windstille, sehr zum Ärger der Segler."
                                            },
                                            {
                                                "example_id": "8c1c8083-7e38-4c78-bc07-9a6b6e167f50",
                                                "sense_id": "a9e77d9e-6b6c-3838-ab68-096466b5e5a4",
                                                "text": "„Bei anhaltender Windstille und ohne alle Temperatur- und Dichteänderungen bzw. die globale Zirkulation würde der Meeresspiegel genau mit der theoretischen Niveaufläche des Geoids zusammenfallen.“"
                                            },
                                            {
                                                "example_id": "2d279a3d-edf8-4f68-8848-2f22ad0721cf",
                                                "sense_id": "a9e77d9e-6b6c-3838-ab68-096466b5e5a4",
                                                "text": "„Es herrschte klare Sicht bei Windstille und ruhiger See.“"
                                            },
                                            {
                                                "example_id": "2a1e8ccc-22c3-44dc-ab82-501da2f2fa8b",
                                                "sense_id": "a9e77d9e-6b6c-3838-ab68-096466b5e5a4",
                                                "text": "„Steigende Hitze und vollkommene Windstille begünstigten Angriffe von winzigen Fliegen, Mücken und Moskitos, welche sich von der weißen Haut besonders angezogen fühlten.“"
                                            },
                                            {
                                                "example_id": "da74c267-3a11-437f-bfd5-f0cb2cf4a57d",
                                                "sense_id": "a9e77d9e-6b6c-3838-ab68-096466b5e5a4",
                                                "text": "„Am Nachmittag herrschte Windstille bis auf ein paar wechselnde Winde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "80e7a5a2-2e77-46cd-83db-82fad92e9153",
                        "source_entry_id": "670198df-e179-3741-b8a0-3e74abe8862d",
