                ],
                "senses": [
                    {
                        "sense_id": "5c6b3ad5-18b9-3b7b-801b-7945a7dfe107",
                        "entry_id": "e242c037-95ec-3e75-a73d-29510d9ccb3e",
                        "glosses": [
                            "Qui émet des radiations, des rayons."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "02da3cce-1046-4632-bc76-712443213d24",
                                "sense_id": "5c6b3ad5-18b9-3b7b-801b-7945a7dfe107",
                                "text": "Tout corps visible est radiant."
                            },
                            {
                                "example_id": "7cc3481e-1f42-4a60-ab7c-37c1bedc5911",
                                "sense_id": "5c6b3ad5-18b9-3b7b-801b-7945a7dfe107",
                                "text": "Chaleur radiante."
                            },
                            {
                                "example_id": "69f0cade-4a1b-4c6d-9784-5208dbbbd2b2",
                                "sense_id": "5c6b3ad5-18b9-3b7b-801b-7945a7dfe107",
                                "text": "Dans le fouillis poussiéreux de la pièce, la carnation égale et très pâle de ses bras et de sa gorge suggérait à l’œil une matière extraordinairement précieuse, radiante, comme la robe blanche d’une femme dans la nuit d’un jardin."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e2c87798-4398-40bb-b12e-df07491e3c93",
                        "source_entry_id": "e242c037-95ec-3e75-a73d-29510d9ccb3e",
                        "source_sense_id": "5c6b3ad5-18b9-3b7b-801b-7945a7dfe107",
                        "target_lang_word": "radiant",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "radiant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "61af7fce-7cd8-36d9-bab7-cdb5d9a9cd0e",
                                        "entry_id": "56f963e0-0180-3af7-9693-3a4f31221a46",
                                        "glosses": [
                                            "Radiating light and/or heat."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a9b3c1b-183c-4856-90e9-584692d5e210",
                                                "sense_id": "61af7fce-7cd8-36d9-bab7-cdb5d9a9cd0e",
                                                "text": "the radiant sun"
                                            },
                                            {
                                                "example_id": "1f639b6d-1a22-4966-815c-4f5193fc4801",
                                                "sense_id": "61af7fce-7cd8-36d9-bab7-cdb5d9a9cd0e",
                                                "text": "They in ranks / Sat all, where ſtood the fiery ſteeds of each, / And where his radiant arms lay on the field."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2958f824-2dfd-33bf-ad31-3e57a41160a2",
                                        "entry_id": "56f963e0-0180-3af7-9693-3a4f31221a46",
                                        "glosses": [
                                            "Emitted as radiation."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "903da255-f5de-375a-94b7-4d199975c324",
                                        "entry_id": "56f963e0-0180-3af7-9693-3a4f31221a46",
                                        "glosses": [
                                            "Beaming with vivacity and happiness."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "77322af4-bdee-41c8-ba0f-fc8b02458a22",
                                                "sense_id": "903da255-f5de-375a-94b7-4d199975c324",
                                                "text": "a radiant face"
                                            },
                                            {
                                                "example_id": "fd00b63f-1e5a-4752-9b14-08590eda3598",
                                                "sense_id": "903da255-f5de-375a-94b7-4d199975c324",
                                                "text": "His sister, Mrs. Gerard, stood there in carriage gown and sables, radiant with surprise. ¶ “Phil ! You ! Exactly like you, Philip, to come strolling in from the antipodes—dear fellow !” recovering from the fraternal embrace and holding both lapels of his coat in her gloved hands."
                                            },
                                            {
                                                "example_id": "2b1afbfa-26f8-43f7-9735-9075e81daff8",
                                                "sense_id": "903da255-f5de-375a-94b7-4d199975c324",
                                                "text": "Nurse Cramer had a cute nose and a radiant, blooming complexion dotted with fetching sprays of adorable freckles that Yossarian detested."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b9dcce4a-776f-369d-b170-c5e679e34103",
                                        "entry_id": "56f963e0-0180-3af7-9693-3a4f31221a46",
                                        "glosses": [
                                            "Strikingly beautiful."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bdc19961-6cb7-46bb-997a-5fbd65f53ebd",
                                                "sense_id": "b9dcce4a-776f-369d-b170-c5e679e34103",
                                                "text": "And yet she was ensnaringly beautiful, despite her pride and self-consciousness; radiant and certain of conquest she stood before the man who alone seemed to have neither eye nor ear for charms that had never elsewhere played her false."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "62ba070e-464e-36d1-9f23-508276cfbb81",
                                        "entry_id": "56f963e0-0180-3af7-9693-3a4f31221a46",
                                        "glosses": [
                                            "Emitting or proceeding as if from a center."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c306d4f0-7c98-3b80-b196-c61683e1409a",
                                        "entry_id": "56f963e0-0180-3af7-9693-3a4f31221a46",
                                        "glosses": [
                                            "Giving off rays."
                                        ],
                                        "tags": [
                                            "of a bearing"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6574b101-4992-491f-89cd-042f62db3c37",
                                                "sense_id": "c306d4f0-7c98-3b80-b196-c61683e1409a",
                                                "text": "the sun radiant"
                                            },
                                            {
                                                "example_id": "8b417af1-9e40-4993-8eea-ad4e052942cf",
                                                "sense_id": "c306d4f0-7c98-3b80-b196-c61683e1409a",
                                                "text": "a crown radiant"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "593766a2-a818-3dbc-8582-b5611daa0f88",
                                        "entry_id": "56f963e0-0180-3af7-9693-3a4f31221a46",
                                        "glosses": [
                                            "Having a ray-like appearance, like the large marginal flowers of certain umbelliferous plants; said also of the cluster which has such marginal flowers."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
