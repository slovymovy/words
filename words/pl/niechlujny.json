    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "7ac42d72-c9ef-3b2d-aed8-92832dfad3af",
                    "sense_definition": "taki, który nie dba o czystość, porządek lub własny wygląd",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "wyglad_porzadek",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Marek był tak <w>niechlujny</w>, że nigdy nie sprzątał po sobie naczyń w kuchni.",
                            "target_lang_translations": {
                                "ru": "Марек был настолько <w>неряшливым</w>, что никогда не убирал за собой посуду на кухне."
                            }
                        },
                        {
                            "text": "Jego <w>niechlujny</w> wygląd natychmiast zwrócił uwagę wszystkich uczestników eleganckiego przyjęcia.",
                            "target_lang_translations": {
                                "ru": "Его <w>неопрятный</w> вид сразу же привлек внимание всех участников элегантного приема."
                            }
                        }
                    ],
                    "synonyms": [
                        "brudny",
                        "nieporządny",
                        "zaniedbany",
                        "zapuszczony"
                    ],
                    "antonyms": [
                        "schludny"
                    ],
                    "common_phrases": [
                        "niechlujny wygląd",
                        "niechlujny strój"
                    ],
                    "target_lang_definitions": {
                        "ru": "не соблюдающий чистоты, порядка или не следящий за своим внешним видом"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неряшливый",
                                "target_lang_sense_clarification": "о человеке или внешнем виде"
                            },
                            {
                                "target_lang_word": "неопрятный",
                                "target_lang_sense_clarification": "нечистый, неаккуратный"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c8b37c77-c821-3e7d-a716-9a83739c6f48",
                    "sense_definition": "wykonany niestarannie, byle jak i bez dbałości o szczegóły",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "jakosc_pracy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Farmaceutka z trudem mogła odczytać bardzo <w>niechlujne</w> pismo lekarza na recepcie.",
                            "target_lang_translations": {
                                "ru": "Фармацевт с трудом смогла разобрать очень <w>неразборчивый</w> почерк врача на рецепте."
                            }
                        },
                        {
                            "text": "Nauczyciel oddał uczniowi referat, krytykując jego <w>niechlujną</w> i pospieszną pracę.",
                            "target_lang_translations": {
                                "ru": "Учитель вернул ученику реферат, раскритиковав его <w>небрежную</w> и поспешную работу."
                            }
                        }
                    ],
                    "synonyms": [
                        "niedbały",
                        "niestaranny",
                        "partacki"
                    ],
                    "antonyms": [
                        "staranny"
                    ],
                    "common_phrases": [
                        "niechlujne pismo",
                        "niechlujna praca"
                    ],
                    "target_lang_definitions": {
                        "ru": "выполненный неаккуратно, кое-как и без должного внимания к деталям"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "небрежный",
                                "target_lang_sense_clarification": "сделанный без старания"
                            },
                            {
                                "target_lang_word": "неряшливый",
                                "target_lang_sense_clarification": "о почерке, работе"
                            },
                            {
                                "target_lang_word": "неаккуратный",
                                "target_lang_sense_clarification": "лишенный точности и чистоты исполнения"
                            }
                        ]
                    }
                }
            ]
        }
    ]
