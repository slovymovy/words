        "nl-extract.jsonl": [
            {
                "entry_id": "eeb412de-04a2-397c-84e3-0abe2b5dbc71",
                "word": "martelend",
                "pos": "adj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "be19621b-7735-3727-8c9f-d4ae867f1c46",
                        "entry_id": "eeb412de-04a2-397c-84e3-0abe2b5dbc71",
                        "glosses": [
                            "opzettelijk heel erg gewelddadig en pijnlijk"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf609874-d41c-41af-85ba-c9354d1ea7f1",
                                "sense_id": "be19621b-7735-3727-8c9f-d4ae867f1c46",
                                "text": "De oudste Kever ter wereld overleefde martelende testritten, oorlogspuin, permanente roestaanvallen en een felle brand. Nu staat de auto nieuwer dan nieuw te glimmen in het Prototype Museum in Hamburg."
                            },
                            {
                                "example_id": "8d79be35-82bb-44ff-9f8f-9f5026d11237",
                                "sense_id": "be19621b-7735-3727-8c9f-d4ae867f1c46",
                                "text": "Ooit was Movies that Matter een activistisch geladen filmfestival over martelende regimes. HP de Tijd 23/03"
                            },
                            {
                                "example_id": "0266b876-5b34-4b05-bca5-b024e6ec738f",
                                "sense_id": "be19621b-7735-3727-8c9f-d4ae867f1c46",
                                "text": "De rechtbank spreekt van een gruwelijke meedogenloze moord, die op bijna martelende manier is voltrokken."
                            },
                            {
                                "example_id": "4e30f8b7-6b4f-4d46-9b54-ef106cc1fc25",
                                "sense_id": "be19621b-7735-3727-8c9f-d4ae867f1c46",
                                "text": "Familieleden en vrienden dragen nog steeds het verlies en verkeren nog altijd in martelende onzekerheid over het precieze lot van hun dierbaren.'"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a813a22e-de5a-4c7e-9040-8977de214100",
                        "source_entry_id": "eeb412de-04a2-397c-84e3-0abe2b5dbc71",
                        "source_sense_id": "be19621b-7735-3727-8c9f-d4ae867f1c46",
                        "source_sense_description": "opzettelijk heel erg gewelddadig en pijnlijk",
                        "target_lang_word": "excruciating",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "excruciating",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "088f1b7f-e448-3f62-8368-1b81b2165a86",
                                        "entry_id": "4dda31f5-009e-3d39-ab56-013801f2a1af",
                                        "glosses": [
                                            "Causing great pain or anguish, agonizing"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7a0a87ce-6e8a-4725-931f-c9f8c8b0476c",
                                                "sense_id": "088f1b7f-e448-3f62-8368-1b81b2165a86",
                                                "text": "Sagan faced an excruciating dilemma: Should he remain true to his naturalistic philosophy and reject the marrow graft as something acquired by immoral means? Or should he agree to undergo the medical treatment in hope of saving his life"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "95923b46-49e7-378a-ac71-6340787e8854",
                                        "entry_id": "4dda31f5-009e-3d39-ab56-013801f2a1af",
                                        "glosses": [
                                            "Exceedingly intense; extreme"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "18f235bf-fea8-4e02-af25-7df474911865",
                                                "sense_id": "95923b46-49e7-378a-ac71-6340787e8854",
                                                "text": "When he at last opened his eyes, he was conscious of nothing but an excruciating pain through his temples. He was vaguely aware of unfamiliar surroundings."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
