                "translations": [
                    {
                        "translation_id": "a2c2833b-9f57-4937-b1bc-e58e167efba6",
                        "source_entry_id": "9c1507fa-6a71-3fd1-bd8c-eba1d5593800",
                        "source_sense_id": "eab92caa-e3ca-3def-8012-c4413f014b17",
                        "target_lang_word": "vegetation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vegetation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "54a96443-d5dc-3730-bb9b-381dec904e4f",
                                        "entry_id": "7d1823dd-cb34-3003-8911-47d78c2259a0",
                                        "glosses": [
                                            "Plants, taken collectively."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "80534228-f533-422e-81d0-f127c0277b91",
                                                "sense_id": "54a96443-d5dc-3730-bb9b-381dec904e4f",
                                                "text": "There were large amounts of vegetation in the forest."
                                            },
                                            {
                                                "example_id": "3dc21717-c23c-4f6e-b85f-5740e83944ba",
                                                "sense_id": "54a96443-d5dc-3730-bb9b-381dec904e4f",
                                                "text": "Thus the growth of vegetation, though effected in a greater or less degree by the strong wind, the violent rain, and the heat and glare of the noonday sun, is yet still more effectually promoted by the mild action of the gentler breezes, the softly descending dew, and the less intense heat."
                                            },
                                            {
                                                "example_id": "25ce5aa0-f94c-4f1d-94ac-151e49c93aea",
                                                "sense_id": "54a96443-d5dc-3730-bb9b-381dec904e4f",
                                                "text": "As soon as the faintest ray of light reaches a seedling, heliotropism will guide it through any crack in the soil, or through an entangled mass of overlying vegetation; […]"
                                            },
                                            {
                                                "example_id": "a9568ce0-e723-4826-b553-7c8e60e094d9",
                                                "sense_id": "54a96443-d5dc-3730-bb9b-381dec904e4f",
                                                "text": "Similarity of vegetation on meadows was the result of heavy grazing and trampling by large numbers of driveway sheep before the study was begun."
                                            },
                                            {
                                                "example_id": "2d1a025a-ffd2-462f-92b7-22719c8d9672",
                                                "sense_id": "54a96443-d5dc-3730-bb9b-381dec904e4f",
                                                "text": "As towns continue to grow, replanting vegetation has become a form of urban utopia and green roofs are spreading fast."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8c70d8d1-8553-3025-a3bf-62937cb7ca3e",
                                        "entry_id": "7d1823dd-cb34-3003-8911-47d78c2259a0",
                                        "glosses": [
                                            "An abnormal verrucous or fibrinous growth"
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "657e2cf4-b871-3622-886d-17b95e4839f3",
                                        "entry_id": "7d1823dd-cb34-3003-8911-47d78c2259a0",
                                        "glosses": [
                                            "The act or process of vegetating, or growing as a plant does; vegetable growth."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3f623d7c-3458-46f9-a633-ca425582db57",
                        "source_entry_id": "9c1507fa-6a71-3fd1-bd8c-eba1d5593800",
                        "source_sense_id": "eab92caa-e3ca-3def-8012-c4413f014b17",
                        "target_lang_word": "végétation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "végétation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "edcea85a-fa35-3bc4-970d-af75a0b406d5",
                                        "entry_id": "5a97ad73-a462-3bf1-9eed-1322e138ebe7",
                                        "glosses": [
                                            "Action de végéter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a5153590-d801-476e-8595-3cd38089d254",
                                                "sense_id": "edcea85a-fa35-3bc4-970d-af75a0b406d5",
                                                "text": "Notre grand botaniste Tournefort, se fondant principalement sur les observations qu’il avait faites dans la grotte d’Antiparos, et, comme l’a dit Fontenelle, transformant tout en ce qu’il aimait le mieux, avait admis la végétation des pierres."
                                            },
                                            {
                                                "example_id": "e74f69c1-fa65-49e1-a178-90def7e684a8",
                                                "sense_id": "edcea85a-fa35-3bc4-970d-af75a0b406d5",
                                                "text": "Les savants s’occupèrent de tout dans une paix profonde, depuis la végétation anormale d’un ognon de jacinthe jusqu’aux courants électriques."
                                            },
                                            {
                                                "example_id": "b5517343-90d1-4709-a5d9-b7212e4a2fe7",
                                                "sense_id": "edcea85a-fa35-3bc4-970d-af75a0b406d5",
                                                "text": "[…], mais actuellement que les porte-greffes américains se sont adaptés au sol, la végétation des rangs greffés est supérieure à celle des rang de vignes franches de pied."
                                            },
                                            {
                                                "example_id": "0a1d527b-de5f-40c2-ae0c-ad848eea3a92",
                                                "sense_id": "edcea85a-fa35-3bc4-970d-af75a0b406d5",
                                                "text": "On cultive le loganberry comme le framboisier, en lui laissant, toutefois, plus d'espace : le loganberry a une végétation exubérante, et ses rameaux, ont souvent quatre à cinq mètres de longueur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6d20c8e9-7daf-303f-a135-4293a6c26346",
                                        "entry_id": "5a97ad73-a462-3bf1-9eed-1322e138ebe7",
                                        "glosses": [
                                            "Ensemble des arbres et des plantes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e5a13b0a-b658-4812-a3ab-a4aa414d9654",
                                                "sense_id": "6d20c8e9-7daf-303f-a135-4293a6c26346",
                                                "text": "C’est l’occasion de se familiariser avec la végétation qui caractérise le Marais, comme des chênes têtards, ses saules pleureurs, ainsi que l’angélique, plante qui a donné quelques spécialités locales."
                                            },
                                            {
                                                "example_id": "1f919dda-9bb6-49a1-8bc5-fe2394498db9",
                                                "sense_id": "6d20c8e9-7daf-303f-a135-4293a6c26346",
                                                "text": "La végétation algologique de Rockall fut particulièrement étudiée par M. Hamel dans le laboratoire du professeur Mangin."
                                            },
                                            {
                                                "example_id": "aa06e64a-52b8-4b2d-88d8-bd7c459d8118",
                                                "sense_id": "6d20c8e9-7daf-303f-a135-4293a6c26346",
                                                "text": "Les pentes vertes du mont San Giachinno, au Sud de l’île , contrastaient étrangement avec la partie Nord, hérissée de petits cônes volcaniques et presque entièrement dépourvue de végétation."
                                            },
                                            {
                                                "example_id": "ab976e29-4241-4bf4-9369-ff83bfa75916",
                                                "sense_id": "6d20c8e9-7daf-303f-a135-4293a6c26346",
                                                "text": "Une plus grande teneur de l’air en gaz carbonique permettrait d'ailleurs d'expliquer la luxuriance de la végétation sans faire intervenir un climat équatorial."
                                            },
                                            {
                                                "example_id": "e466a1e2-dfbe-47aa-85c9-c0708850120f",
                                                "sense_id": "6d20c8e9-7daf-303f-a135-4293a6c26346",
                                                "text": "Tansley considérait les landes comme un bon exemple de végétation subclimacique : un stade faisant partie de la succession de végétation des sables et graviers acides et nus, succession qui menait à une forêt caducifoliée arrivée à maturité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "541376ac-4bcf-33f6-95f9-e9b77098c39b",
                                        "entry_id": "5a97ad73-a462-3bf1-9eed-1322e138ebe7",
                                        "glosses": [
                                            "Nom donné à certaines lésions inflammatoires de la peau ou des muqueuses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc4ceb9f-65c9-4c01-93ab-469c3488a419",
                                                "sense_id": "541376ac-4bcf-33f6-95f9-e9b77098c39b",
                                                "text": "L’échographie cardiaque transthoracique (présence de valves remaniées ou/et de végétations) et les hémocultures confirment le diagnostic évoqué par la clinique : streptococcémies, staphylococcémies, etc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "747d8fe9-f1e9-3f52-8a09-a4e931b04a7e",
                                        "entry_id": "5a97ad73-a462-3bf1-9eed-1322e138ebe7",
                                        "glosses": [
                                            "Hypertrophie du tissu de l’amygdale pharyngée."
                                        ],
                                        "tags": [
                                            "especially",
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0aa29fde-9fc2-48cd-b049-02129097c99d",
                                                "sense_id": "747d8fe9-f1e9-3f52-8a09-a4e931b04a7e",
                                                "text": "Un jour, il m’a fait enlever les amygdales parce que j’avais trop souvent mal à la gorge, c’était de la faute à ces saloperies, soi-disant, ça m’a fait mal, merde, et peur, surtout, j’avais six-sept ans, et les végétations avec, tant qu’on y était, hop."
                                            },
                                            {
                                                "example_id": "2f0bea01-e735-4db7-8210-5dd501442424",
                                                "sense_id": "747d8fe9-f1e9-3f52-8a09-a4e931b04a7e",
                                                "text": "Il faut bien connaître ce schéma, car il ne faut pas être trop interventionniste au niveau des végétations dans la petite enfance : en opérant trop tôt, on assiste à une repousse."
                                            },
                                            {
                                                "example_id": "2022974d-8d73-47cd-9f8d-a197231c7102",
                                                "sense_id": "747d8fe9-f1e9-3f52-8a09-a4e931b04a7e",
                                                "text": "Mais, tant qu’on ne m’aura pas enlevé les amygdales et les végétations, je choperai tout ce que je voudrai."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
