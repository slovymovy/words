                        "examples": [
                            {
                                "example_id": "2f7effad-0f57-4fa6-85a3-1bb65855680c",
                                "sense_id": "54698254-5ada-3980-b630-429ffe4f3a3c",
                                "text": "Na de constatering dat de boekhouder afwezig was, ging de vergadering verder."
                            },
                            {
                                "example_id": "1481622f-2aee-45a4-9f8a-ae95a03ed587",
                                "sense_id": "54698254-5ada-3980-b630-429ffe4f3a3c",
                                "text": "Hij kon gewoonweg niet meer verder. Zijn leven was zinloos geworden. Mede door deze constatering waren zijn hersens op hol geslagen."
                            },
                            {
                                "example_id": "e546a260-3ba3-465e-a2d1-aa75dc8e1ada",
                                "sense_id": "54698254-5ada-3980-b630-429ffe4f3a3c",
                                "text": "Advocaat Van Tilborg wist zich duidelijk geen raad met deze constatering en zei dat deze zaak in een andere procedure tot de bodem moet worden uitgezocht."
                            }
                        ]
                    }
                ],
