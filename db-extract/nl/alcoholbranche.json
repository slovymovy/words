                        "examples": [
                            {
                                "example_id": "40c15966-a357-4ed7-9b54-aac842b553bb",
                                "sense_id": "2c3d9638-6192-34b1-92ae-406959a34e65",
                                "text": "Want hoe zit het eigenlijk in Nederland? Hier is sprake van zelfregulering als het gaat om alcoholreclame. De alcoholbranche, vertegenwoordigd in de Stichting Verantwoorde Alcoholconsumptie (STIVA), heeft zelf de marketingregels vastgesteld in de 'Reclamecode voor Alcoholhoudende Dranken'. Vorig jaar zijn daar afspraken over online promotie aan toegevoegd. De strekking: fabrikanten moeten ervoor zorgen dat hun advertenties alleen terecht komen bij mensen van 18 jaar of ouder."
                            },
                            {
                                "example_id": "5c262e99-f56c-4520-9793-989462c8937e",
                                "sense_id": "2c3d9638-6192-34b1-92ae-406959a34e65",
                                "text": "De Nederlandse alcoholbranche roept RTL op om met onmiddellijke ingang te stoppen met het uitzenden van het RTL-programma Oh Oh Daar Gaan We Weer. Volgens Stichting Verantwoord Alcoholgebruik (STIVA) moedigt RTL overmatig alcoholgebruik aan."
                            }
                        ]
                    }
