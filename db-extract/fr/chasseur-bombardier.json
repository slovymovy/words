                "senses": [
                    {
                        "sense_id": "8eb44a49-680a-34cc-bb41-c8a0f7f220ed",
                        "entry_id": "26dc4342-7b25-3c19-af05-03e6ec649d3a",
                        "glosses": [
                            "Avion multirôle, capable d’attaquer des cibles terrestres à l’aide de son armement air-sol, en plus de sa capacité au combat aérien proche de celle d’un avion de chasse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10228dab-6e08-40e1-bdbe-c1c7ffc415c4",
                                "sense_id": "8eb44a49-680a-34cc-bb41-c8a0f7f220ed",
                                "text": "Vers 15 heures, alors que le défilé de la débâcle continuait, un bruit d'avions inquiéta la population. Trois ou quatre chasseurs bombardiers survolaient la ville, et les habitants gagnèrent en hâte les abris."
                            },
                            {
                                "example_id": "fab4a86d-1d06-469a-a435-08cd2538fe93",
                                "sense_id": "8eb44a49-680a-34cc-bb41-c8a0f7f220ed",
                                "text": "La première génération chinoise de chasseur-bombardier J-15, surnommé « le Requin volant », a été développée, selon des experts, par la Shenyang Aircraft Corp, une filiale de l’Aviation Industry Corp de Chine."
                            }
                        ]
                    }
