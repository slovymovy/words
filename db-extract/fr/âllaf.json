                        "glosses": [
                            "Intendant général de l’armée, avec rang de vizir."
                        ],
                        "tags": [
                            "Maroc"
                        ],
                        "examples": [
                            {
                                "example_id": "738947ab-c0c3-4d09-854a-f58412fae3be",
                                "sense_id": "fa10fc2d-dc7d-32e9-88fd-dd0c67e4a24d",
                                "text": "[…] ; enfin l’âllaf, dont les Européens traduisaient improprement le titre par celui de ministre de la guerre mais qui n’était en réalité qu’un intendant général chargé de l’administration et du paiement des troupes commandées par des caïds relevant directement du sultan."
                            },
                            {
                                "example_id": "8c324dde-56c4-427e-8c3e-2f9626be140f",
                                "sense_id": "fa10fc2d-dc7d-32e9-88fd-dd0c67e4a24d",
                                "text": "[…] : son frère Si Driss lui succéda comme chambellan ; un autre de ses frères, Si Said, fut élevé à la dignité d’âllaf, intendant général de l’armée ; […]."
                            },
                            {
                                "example_id": "f9ce99f5-a8ae-4dcc-9895-6d64d814a56c",
                                "sense_id": "fa10fc2d-dc7d-32e9-88fd-dd0c67e4a24d",
                                "text": "Aucune punition ne devait être appliquée si elle n'était pas approuvée, après enquête, par l’\"allâf\" (intendant) et par l’instructeur délégué par le commandant."
                            }
                        ]
                    }
