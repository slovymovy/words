                "senses": [
                    {
                        "sense_id": "6dff266a-091d-3aea-bad5-1bf96c9382f6",
                        "entry_id": "21af60d3-f760-3519-84cc-489eb89a3463",
                        "glosses": [
                            "onderkant van ledikant, doodkist e.d. waar de voeten komen te liggen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8d3af003-81d2-495a-a7c9-0dc69f83156a",
                                "sense_id": "6dff266a-091d-3aea-bad5-1bf96c9382f6",
                                "text": "Er zat een gat in de vloer van mijn woonkamer. De kogel is bij mij in de muur geslagen. Als ik daar had gestaan, was het einde oefening geweest. En wat ook zo vreemd is: normaal gesproken ligt mijn hond precies op die plek. Nu lag hij bij het voeteneind van mijn bed. Dus ook mijn hond heeft geluk gehad.”"
                            },
                            {
                                "example_id": "b625b1ec-6507-4650-8ece-9322d1d5d5bf",
                                "sense_id": "6dff266a-091d-3aea-bad5-1bf96c9382f6",
                                "text": ",,Champagne in de hand, een vers croissantje op je bord en Dave Roelvink aan het voeteneind van het bed. Kan de ochtend beter beginnen?\", zo prijst VakantieVeilingen het opmerkelijke veilingitem aan. De website wil tijdens het ontbijtje trouwens ook nog promotiemateriaal schieten, dus je moet er wel rekening mee houden dat je in een reclamespot voor VakantieVeilingen terechtkomt."
                            }
                        ]
                    }
