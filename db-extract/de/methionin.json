                        "entry_id": "fbc64877-76c9-352c-b164-d60ec3818271",
                        "glosses": [
                            "eine essentielle, schwefelhaltige, proteinogene Aminosäure; allgemein für die Isomere D-Methionin und L-Methionin"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ddd78ecd-4acd-4669-9fff-803cdad34f08",
                                "sense_id": "17905b8c-1883-39d5-ac82-a9318603f353",
                                "text": "Der Tagesbedarf eines Erwachsenen an Methionin beträgt 1 bis 2 Gramm."
                            },
                            {
                                "example_id": "51c7af1e-9830-464a-8152-9ac86303ad62",
                                "sense_id": "17905b8c-1883-39d5-ac82-a9318603f353",
                                "text": "Methionin ist vor allem in Fisch, Fleisch und grünem Gemüse enthalten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
