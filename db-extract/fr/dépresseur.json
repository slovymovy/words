                                    {
                                        "sense_id": "13378373-b3da-3048-8ea1-a3ad3d7edaa4",
                                        "entry_id": "0ad94013-6988-3944-a151-2f573d9d5850",
                                        "glosses": [
                                            "A pharmacological substance which decreases neuronal or physiological activity."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f02b18ab-3ada-4d8c-8247-72bd7ecea86a",
                                                "sense_id": "13378373-b3da-3048-8ea1-a3ad3d7edaa4",
                                                "text": "Alcohol acts first as a stimulant and then as a depressant."
                                            },
                                            {
                                                "example_id": "b4a1eaee-a4d1-4ac8-a5da-d9e5a2121fcd",
                                                "sense_id": "13378373-b3da-3048-8ea1-a3ad3d7edaa4",
                                                "text": "The prescription painkiller Emily Jackson took is a respiratory depressant that slows breathing. That in combination with the alcohol, another respiratory depressant, overwhelmed her brain, which stopped giving her heart and lungs the signal to keep functioning."
                                            },
                                            {
                                                "example_id": "7942ab7e-c79c-43ee-b721-b405c88b327a",
                                                "sense_id": "13378373-b3da-3048-8ea1-a3ad3d7edaa4",
                                                "text": "On the opposite end of the drug side effect spectrum are downers. This slang term refers to CNS depressants, the types of drugs that produce a sedative effect by slowing down the messages sent and received between the central nervous system and the brain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "54b15fa2-f911-3e70-a282-d0141a84ccf7",
                                        "entry_id": "0ad94013-6988-3944-a151-2f573d9d5850",
                                        "glosses": [
                                            "An agent that inhibits the flotation of a mineral or minerals."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
