                "senses": [
                    {
                        "sense_id": "312cf817-aaba-3662-8932-936b1dfbcc29",
                        "entry_id": "232e07d5-f762-3abd-a25f-769a329feeed",
                        "glosses": [
                            "Qui précède la mort."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bb0644cf-0084-4d63-b88d-208da9bd7024",
                                "sense_id": "312cf817-aaba-3662-8932-936b1dfbcc29",
                                "text": "L’inspection ante-mortem peut améliorer l’efficacité de l’opération en éliminant un certain nombre d’animaux qui seraient impropres à la consommation."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2b8272f7-1ca5-48d7-a4c5-8578005b661e",
                        "source_entry_id": "232e07d5-f762-3abd-a25f-769a329feeed",
                        "source_sense_id": "312cf817-aaba-3662-8932-936b1dfbcc29",
                        "target_lang_word": "antemortem",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "antemortem",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c0677f6f-29ec-344c-bfbb-596d97ec8fb7",
                                        "entry_id": "c92dc21a-0cee-3a94-9bfb-9597455c4135",
                                        "glosses": [
                                            "Having occurred or having been inflicted before death."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "479d6328-5974-4360-9bab-4c77d0a43d43",
                                                "sense_id": "c0677f6f-29ec-344c-bfbb-596d97ec8fb7",
                                                "text": "Although the antemortem injuries are severe, they are not the cause of death."
                                            },
                                            {
                                                "example_id": "e83e89c3-7980-41b0-a9c2-32a19840c31a",
                                                "sense_id": "c0677f6f-29ec-344c-bfbb-596d97ec8fb7",
                                                "text": "Data for the potential human exposure portion of the model include antemortem and postmortem inspection, pneumatic stunning, carcass missplitting, advanced meat recovery systems, and […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "antemortem",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "28f5af74-88f8-3556-af9a-610004b66d91",
                                        "entry_id": "d90b0db9-e1e7-39f1-805a-9811bc4e6535",
                                        "glosses": [
                                            "Having occurred or having been inflicted before death."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1e66a652-1286-462f-93ec-1937897d0367",
                                                "sense_id": "28f5af74-88f8-3556-af9a-610004b66d91",
                                                "text": "These teeth have small pieces of enamel missing from the edges of the crowns, but it was not possible to establish if this had happened antemortem or postmortem."
                                            },
                                            {
                                                "example_id": "6152ba3b-1574-4354-8c7d-3bf5575b3459",
                                                "sense_id": "28f5af74-88f8-3556-af9a-610004b66d91",
                                                "text": "Stranded animals provide useful information on effects of the physiology and, therefore, samples should be collected and analyzed to confirm results of studies done antemortem."
                                            },
                                            {
                                                "example_id": "41783a8a-1204-4915-9876-212ec675af0e",
                                                "sense_id": "28f5af74-88f8-3556-af9a-610004b66d91",
                                                "text": "Since the process of healing has distinctive characteristics, injuries that occur antemortem usually can be distinguished from those that occur at the time of, or after, death."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
