                "senses": [
                    {
                        "sense_id": "8103ce27-dd61-3b3b-803d-44cb5b4c3658",
                        "entry_id": "c5301a90-4a54-324a-9836-590e5474b7b5",
                        "glosses": [
                            "professionelle Rückmeldung zu gezeigtem Verhalten in der Arbeit mit anderen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "19b476cf-5501-403e-a303-2d2478a80bc6",
                                "sense_id": "8103ce27-dd61-3b3b-803d-44cb5b4c3658",
                                "text": "Die Supervision einer Gruppe kann zum Beispiel die zeitweise Begleitung eines Arbeitsteams in einem Krankenhaus, einer Praxis oder Behörde sein."
                            },
                            {
                                "example_id": "5b685d1f-7a46-4c33-9e7a-cad86dbfdfbc",
                                "sense_id": "8103ce27-dd61-3b3b-803d-44cb5b4c3658",
                                "text": "Supervisionen unterliegen in der Regel klaren Strukturen: es steht von vornherein fest, was, wann, wie geschieht."
                            },
                            {
                                "example_id": "77026723-2bd6-4d25-8b39-a4a4dace75de",
                                "sense_id": "8103ce27-dd61-3b3b-803d-44cb5b4c3658",
                                "text": "Supervision ist im besten Falle kompetente, qualifizierte und einfühlsame Berufsbegleitung, die Stressfaktoren reduziert und Weiterentwicklung ermöglicht."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
