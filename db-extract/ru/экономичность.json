                                "target_senses": [
                                    {
                                        "sense_id": "4285f105-23fb-3561-9a98-da9f845ec66f",
                                        "entry_id": "bd6a1d15-99b0-395c-a2e3-477493267c25",
                                        "glosses": [
                                            "The extent to which a resource is used for the intended purpose."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3c612d17-dfa1-453d-a9db-aacdab9721bb",
                                                "sense_id": "4285f105-23fb-3561-9a98-da9f845ec66f",
                                                "text": "In a letter DeJoy sent to Congress on Thursday, he said DOGE teams will “assist us in identifying and achieving further efficiencies,” saying the Elon Musk-led agency will focus on improving the management of USPS retirement assets and the Workers’ Compensation Program, as well as addressing the agency’s legislative mandates and regulatory requirements."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b28e21b5-ed38-3159-87f7-30ba094282a6",
                                        "entry_id": "bd6a1d15-99b0-395c-a2e3-477493267c25",
                                        "glosses": [
                                            "The extent to which a resource is used for the intended purpose.",
                                            "The ratio of useful work to energy expended. Often given the symbol η."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f8e15ee-8ff6-4bb1-b06c-7f29e26b6922",
                                                "sense_id": "b28e21b5-ed38-3159-87f7-30ba094282a6",
                                                "text": "The efficiency of this loudspeaker is 40%."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b5adfb40-2da1-38ed-bac1-41112e6ac7b3",
                                        "entry_id": "bd6a1d15-99b0-395c-a2e3-477493267c25",
                                        "glosses": [
                                            "The extent to which a resource is used for the intended purpose.",
                                            "The extent to which time is well used for the intended task."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "42c1244f-8f30-4544-9358-dfd14a604f9b",
                                                "sense_id": "b5adfb40-2da1-38ed-bac1-41112e6ac7b3",
                                                "text": "The efficiency of the planning department is deplorable."
                                            },
                                            {
                                                "example_id": "830af234-5fc2-4f0f-8d70-c43a62e18110",
                                                "sense_id": "b5adfb40-2da1-38ed-bac1-41112e6ac7b3",
                                                "text": "Even at the busiest periods, an air of quiet orderliness pervades the hall, and the first impression gained by the traveller is one of efficiency, neatness and cleanliness."
                                            },
                                            {
                                                "example_id": "3c5361e7-a0a9-475d-abfc-7fbcc1ca081f",
                                                "sense_id": "b5adfb40-2da1-38ed-bac1-41112e6ac7b3",
                                                "text": "The display and result must be placed in the context that was it was against a side that looked every bit their Fifa world ranking of 141 - but England completed the job with efficiency to record their biggest away win in 19 years."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "77b16e98-f747-3755-9cf1-6d56f4687eb8",
                                        "entry_id": "bd6a1d15-99b0-395c-a2e3-477493267c25",
                                        "glosses": [
                                            "The quality of producing an effect or effects."
                                        ],
                                        "tags": [
                                            "countable",
                                            "dated",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "86a3dc20-ca48-4bbb-80c0-7b08b628f0bc",
                                                "sense_id": "77b16e98-f747-3755-9cf1-6d56f4687eb8",
                                                "text": "The manner of this divine efficiency being far above us."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ad78a281-2c6d-3137-a10d-9ef9245c82b2",
                                        "entry_id": "bd6a1d15-99b0-395c-a2e3-477493267c25",
                                        "glosses": [
                                            "A one-room apartment."
                                        ],
                                        "tags": [
                                            "US",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "283a4014-a0a8-4b6f-8a77-847975e2f289",
