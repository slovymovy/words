            "pos": "noun",
            "senses": [
                {
                    "sense_id": "763ae3f4-4a12-3df9-ada0-2410903fb716",
                    "sense_definition": "A small mountain lake or pool, especially one formed in a glacier-carved hollow.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mountain_lake",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After a steep hike up the rocky ridge, we rested beside a crystal-clear <w>tarn</w>.",
                            "target_lang_translations": {
                                "ru": "После крутого подъема по скалистому хребту мы отдохнули у кристально чистого <w>горного озерца</w>."
                            }
                        },
                        {
                            "text": "Cold mist drifted slowly over the surface of the lonely <w>tarn</w> as evening approached.",
                            "target_lang_translations": {
                                "ru": "С приближением вечера холодный туман медленно стелился над поверхностью уединенного <w>карового озера</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "corrie lake"
                    ],
                    "common_phrases": [
                        "glacial tarn",
                        "mountain tarn"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Often associated with Northern England"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшое горное озеро, особенно образовавшееся в ледниковом каре."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "каровое озеро",
                                "target_lang_sense_clarification": "озеро в ледниковом каре"
                            },
                            {
                                "target_lang_word": "горное озеро",
                                "target_lang_sense_clarification": "небольшой водоём в горах"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "63c9f0a0-5f8d-340d-8d40-04cdd1098f92",
                    "sense_definition": "A river in southwestern France, flowing as a right tributary of the Garonne.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "french_geography",
                    "name_type": "geographical_feature",
                    "examples": [
                        {
                            "text": "The <w>Tarn</w> carves a dramatic limestone canyon known throughout southern France.",
                            "target_lang_translations": {
                                "ru": "<w>Тарн</w> прорезает впечатляющий известняковый каньон, известный на всю южную Францию."
                            }
                        },
                        {
                            "text": "We took a leisurely canoe trip down the calm waters of the <w>Tarn</w>.",
                            "target_lang_translations": {
                                "ru": "Мы совершили неспешную прогулку на каноэ по спокойным водам <w>Тарна</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "Gorges du Tarn"
                    ],
                    "target_lang_definitions": {
                        "ru": "Река на юго-западе Франции, правый приток Гаронны."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Тарн",
                                "target_lang_sense_clarification": "река во Франции"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "86eaff01-b03b-32d1-8b6f-137f328349f0",
                    "sense_definition": "A department located in the Occitanie region of southwestern France.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "french_geography",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "Albi is the capital city of the department of <w>Tarn</w>.",
                            "target_lang_translations": {
                                "ru": "Альби — главный город департамента <w>Тарн</w>."
                            }
                        },
                        {
                            "text": "Many historic villages are scattered across the rolling hills of the <w>Tarn</w>.",
                            "target_lang_translations": {
                                "ru": "Множество старинных деревушек разбросано по холмам департамента <w>Тарн</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Департамент на юго-западе Франции в регионе Окситания."
                    },
                    "translations": {
