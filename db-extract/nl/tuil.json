                "senses": [
                    {
                        "sense_id": "d2424a71-2272-3f2d-b1ee-ee4ca5efd0f7",
                        "entry_id": "d2640bf1-d003-32e3-8247-8a23546899ce",
                        "glosses": [
                            "bos bloemen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab7e55a4-8afd-4ed8-b276-4f9966a4fc65",
                                "sense_id": "d2424a71-2272-3f2d-b1ee-ee4ca5efd0f7",
                                "text": "Met de linkerhand legt zij een bloementuil op het graf; in de rechterhand houdt zij een roos en met de rechterarm houdt zij nog een tuil voor haar borst."
                            }
                        ]
                    },
                    {
                        "sense_id": "de0a8fa8-5417-33d2-a5e3-b2f923a4b3ef",
                        "entry_id": "d2640bf1-d003-32e3-8247-8a23546899ce",
                        "glosses": [
                            "bloemenslinger of bloemenkrans in het haar, vooral gedragen door bruiden"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "51db6387-4cbb-4709-969e-aa029b140df9",
                                "sense_id": "de0a8fa8-5417-33d2-a5e3-b2f923a4b3ef",
                                "text": "Ik geef je er nog een krans hij van versche rozen! riep de koopvrouw blij en drukte Psyche den tuil op het hoofd."
                            }
                        ]
                    },
                    {
                        "sense_id": "21048991-0a3c-3d90-a3db-b81e675b69ec",
                        "entry_id": "d2640bf1-d003-32e3-8247-8a23546899ce",
                        "glosses": [
                            "bloeiwijze waarbij bloemstelen zo in lengte verschillen dat alle bloemen van een tros in één vlak liggen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8bf99da5-c290-440e-b808-d3faa9682d4e",
                                "sense_id": "21048991-0a3c-3d90-a3db-b81e675b69ec",
                                "text": "De bloemen zijn helder zuiverwit tot crèmewit, enkelvoudig, in tuilen, bundels of in trossen van zes tot twaalf bloemen per tuil, elke bloem met vijf ronde tot ovale petalen; (…)"
                            }
                        ]
                    },
                    {
                        "sense_id": "aa9f2e65-2113-3d55-bec4-2e809f1499db",
                        "entry_id": "d2640bf1-d003-32e3-8247-8a23546899ce",
                        "glosses": [
                            "bos, bundel"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "d97d3f4a-4252-4c5a-998b-ddbcd109d64d",
                                "sense_id": "aa9f2e65-2113-3d55-bec4-2e809f1499db",
                                "text": "Historia heeft aardige nukken: leest Elias in zijn besluitvorming een tuil ‘begripsbepalingen’ samen voor de intrensieke betekenis van de Vlaamse beweging, dan citeert hij b.v. een tekst uit Rudelsheim (…)"
                            }
                        ]
                    },
