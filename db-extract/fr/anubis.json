                "forms": [],
                "senses": [
                    {
                        "sense_id": "934b4b06-6d23-3b88-aaba-765aba16a258",
                        "entry_id": "9b6830b2-151c-36f3-9319-4b8f69f80f40",
                        "glosses": [
                            "Divinité infernale égyptienne, guide des défunts et gardien des nécropoles, à tête de chacal."
                        ],
                        "tags": [
                            "Divinité"
                        ],
                        "examples": [
                            {
                                "example_id": "a6b187c8-85fe-466e-9681-ff6a35596ab4",
                                "sense_id": "934b4b06-6d23-3b88-aaba-765aba16a258",
                                "text": "Lors de la pesée des âmes opérée sous le contrôle d’Anubis, dieu des morts, le cœur humain posé dans la balance doit, s'il ne veut pas être dévoré par Âmmout, la dévoreuse des morts, être aussi léger que la plume de Maât."
                            }
                        ]
                    },
                    {
                        "sense_id": "00321fdb-6a76-391f-8044-c2a93b8df26e",
                        "entry_id": "9b6830b2-151c-36f3-9319-4b8f69f80f40",
                        "glosses": [
                            "Représentation statuaire du dieu Anubis."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "1f7e7fee-a0fa-4f04-a825-0340c4f1d2d7",
                                "sense_id": "00321fdb-6a76-391f-8044-c2a93b8df26e",
                                "text": "Un matin éclatant de la chaude saison\nBaigne les grands sphinx roux couchés au sable aride,\nEt des vieux Anubis ceints du pagne rigide\nLa gueule de chacal aboie à l’horizon."
                            }
                        ]
                    }
