                        "source_sense_id": "de73d963-3177-320f-b453-5f96fb1f7356",
                        "target_lang_word": "Dampfkessel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dampfkessel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "96ab33f3-4e51-3596-a636-16c01ac40139",
                                        "entry_id": "af36886f-8bbe-3b8e-aee5-b6c2ff74319b",
                                        "glosses": [
                                            "geschlossenes beheiztes Gefäß zum Erzeugen von Wasserdampf mit hohem Druck für Heiz- und Betriebszwecke"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac38ebbb-2b00-4098-9826-9b7bacd8cff0",
                                                "sense_id": "96ab33f3-4e51-3596-a636-16c01ac40139",
                                                "text": "„Der zum Betrieb der Dampfturbine notwendige Wasserdampf wird in einem Dampfkessel aus zuvor gereinigtem und aufbereitetem Wasser erzeugt.“"
                                            },
                                            {
                                                "example_id": "cd66a97a-8250-4f1f-b9b0-18fb2b3c01b4",
                                                "sense_id": "96ab33f3-4e51-3596-a636-16c01ac40139",
                                                "text": "„Er liebte Dampfkessel und sah es gerne, daß sie gefeuert wurden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8802d21a-1c6c-4c87-9442-07a75de70dd2",
                        "source_entry_id": "0089849b-39c2-3850-8d6a-03dd2616a184",
