                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bda1160e-ddf7-4e37-9731-7a074022e9fc",
                                                "sense_id": "85e2ed79-c4bb-33fb-bc1a-82c707543bac",
                                                "text": "In balsamico gelakte eendenborst met gekonfijte kumquat. Het klinkt als een ingewikkeld gerecht, maar je zet het in 25 minuten al op tafel."
                                            },
                                            {
                                                "example_id": "b4844b3c-e3ae-4ecc-9a4c-e31158b4f551",
                                                "sense_id": "85e2ed79-c4bb-33fb-bc1a-82c707543bac",
                                                "text": "Citrusvruchten is een aanduiding die bij parfums vaak worden gebruikt. Maar wat voor citrus: citroen is weer anders dan sinaasappel en die ruikt weer anders dan een limoen of een kumquat."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
