                            },
                            {
                                "target_lang_word": "бляха",
                                "target_lang_sense_clarification": "крупная металлическая пряжка"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "29635745-ba91-330e-b7de-d3e6d3ee3531",
                    "sense_definition": "A distortion, bend, or kink in an object.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "distortion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The heat caused a noticeable <w>buckle</w> in the metal siding of the building.",
                            "target_lang_translations": {
                                "ru": "Жара вызвала заметную <w>деформацию</w> металлического сайдинга здания."
                            }
                        },
                        {
                            "text": "The carpenter noticed a slight <w>buckle</w> in the wooden plank.",
                            "target_lang_translations": {
                                "ru": "Плотник заметил небольшой <w>изгиб</w> в деревянной доске."
                            }
                        }
                    ],
                    "common_phrases": [
                        "a buckle in the blade"
                    ],
                    "target_lang_definitions": {
                        "ru": "Искривление, изгиб или деформация объекта."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "изгиб",
                                "target_lang_sense_clarification": "в результате деформации"
                            },
                            {
                                "target_lang_word": "вмятина",
                                "target_lang_sense_clarification": "или выпуклость"
                            },
                            {
                                "target_lang_word": "перекос",
                                "target_lang_sense_clarification": "конструкции"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "47606ee7-3832-3370-a808-442396fc8f84",
                    "sense_definition": "A type of cake baked with fresh fruit and a crumbly topping.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She served a delicious blueberry <w>buckle</w> for dessert after the Sunday dinner.",
                            "target_lang_translations": {
                                "ru": "На десерт после воскресного обеда она подала вкусный черничный <w>пирог</w>."
                            }
                        },
                        {
                            "text": "The recipe for the peach <w>buckle</w> requires a lot of butter for the streusel.",
                            "target_lang_translations": {
                                "ru": "Для рецепта персикового <w>бакла</w> требуется много масла для посыпки."
                            }
                        }
                    ],
                    "common_phrases": [
                        "blueberry buckle",
                        "fruit buckle"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "primarily North American"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вид пирога со свежими фруктами и крошащейся посыпкой."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бакл",
                                "target_lang_sense_clarification": "американский фруктовый пирог"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "7b3ac801-4392-36a8-9ab3-8997b61466e3",
                    "sense_definition": "An English surname originating from the occupation of making or selling <w>buckles</w>.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The historian researched the genealogy of the <w>Buckle</w> family in the local archives.",
                            "target_lang_translations": {
                                "ru": "Историк изучал генеалогию семьи <w>Бакл</w> в местных архивах."
                            }
                        },
                        {
                            "text": "Mr. <w>Buckle</w> was a well-known merchant in the town during the nineteenth century.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Бакл</w> был известным в городе торговцем в девятнадцатом веке."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "occupational origin"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Английская фамилия, происходящая от профессии изготовителя пряжек."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Бакл",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ]
                    }
                }
            ]
        }
    ]
