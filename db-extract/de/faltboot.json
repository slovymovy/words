                "senses": [
                    {
                        "sense_id": "8d78a7b7-2ac5-34a4-a707-4d7dd59f87d1",
                        "entry_id": "e14688ce-06a4-3294-be82-983ed31def3e",
                        "glosses": [
                            "ein zerlegbares Boot, welches im wesentlichen aus einer flexiblen Bootshaut und einem zerlegbarem Innengerüst besteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "837f400e-6960-4996-8e8a-4d6900e0334e",
                                "sense_id": "8d78a7b7-2ac5-34a4-a707-4d7dd59f87d1",
                                "text": "Für unseren Paddelausflug, nutzen wir ein Faltboot."
                            },
                            {
                                "example_id": "47847afb-cd8f-4612-9a90-b7c106f84402",
                                "sense_id": "8d78a7b7-2ac5-34a4-a707-4d7dd59f87d1",
                                "text": "Die Urlauber sind mit dem Faltboot auf dem Bodensee unterwegs."
                            },
                            {
                                "example_id": "0dd79016-30d3-4ea1-93ba-9164894b1ff0",
                                "sense_id": "8d78a7b7-2ac5-34a4-a707-4d7dd59f87d1",
                                "text": "„Flußromantik und Flußzauber, des Frühlings Einzug, des Sommers Erwachen kann man im Faltboot stimmungsvoll erleben.“"
                            },
                            {
                                "example_id": "5c9dbd03-d6d3-41ad-83b9-ac0d781e680b",
                                "sense_id": "8d78a7b7-2ac5-34a4-a707-4d7dd59f87d1",
                                "text": "„Denn kaum war der Arbeitsdienst vorüber, stürzte der 20-jährige sich in ein besonders veritables Abenteuer: eine Fahrt mit seinem Faltboot Marke Klepper auf der Donau von Passau bis zum Schwarzen Meer.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
