                                        "glosses": [
                                            "Einwohner von Danzig, in Danzig geborene Person"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12012e57-3fcd-4bf2-947e-db614df12baa",
                                                "sense_id": "bce89b9c-8fce-3fde-8fc6-4719fa6ddeb9",
                                                "text": "„Das Fischerörtchen, in dem normalerweise Boote in verträumten, schilfgesäumten Buchten lagen, war für die Danziger noch im Sommer zuvor ein Ausflugsziel gewesen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Danziger",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4ee0d120-21f5-388b-bc27-87c8d04c736d",
                                        "entry_id": "5333c4d9-3998-320e-a310-207a0c86605f",
                                        "glosses": [
                                            "sich auf Danzig beziehend, aus Danzig kommend, zu Danzig gehörend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5a3f8209-d0fd-468c-91e1-bbd6261dcf62",
                                                "sense_id": "4ee0d120-21f5-388b-bc27-87c8d04c736d",
                                                "text": "„Court stand an der Spitze des Schnellbootes und spähte blinzelnd zu den Docks der Danziger Schiffswerft, die vor ihm lagen.“"
                                            },
                                            {
                                                "example_id": "8386a947-5701-45ca-ae2e-4a93bfdeffe3",
                                                "sense_id": "4ee0d120-21f5-388b-bc27-87c8d04c736d",
                                                "text": "„Andere Ostpreußen misstrauten dem Landweg und steuerten bereits die Evakuierungshäfen in der Danziger Bucht an.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
