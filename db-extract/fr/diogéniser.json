                        "glosses": [
                            "Vivre volontairement de très peu, comme Diogène."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d244996a-e3a8-411b-8c70-774ee37f1e7f",
                                "sense_id": "c6f8ba44-04b6-33fb-8441-c5f981851cc2",
                                "text": "Pendant les dix premiers mois de ma réclusion, […] ; je faisais ma chambre, j’étais tout ensemble le maître et le serviteur, je diogénisais avec une incroyable fierté."
                            },
                            {
                                "example_id": "771c82be-3ce6-4f19-8099-34dd6c898257",
                                "sense_id": "c6f8ba44-04b6-33fb-8441-c5f981851cc2",
                                "text": "Le soupirant de Fœdora avait su auparavant « diogéniser »."
                            }
                        ]
