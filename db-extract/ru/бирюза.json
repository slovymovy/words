                ],
                "senses": [
                    {
                        "sense_id": "f17157d8-f5e7-33b6-9bea-e804334ef08d",
                        "entry_id": "f05e97ea-1151-3b47-9bb6-c76674dfc4bd",
                        "glosses": [
                            "минер. непрозрачный драгоценный камень небесно-голубого или зеленовато-голубого цвета"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d1b6a03-b605-4941-a85e-5628e08c4e28",
                                "sense_id": "f17157d8-f5e7-33b6-9bea-e804334ef08d",
                                "text": "На указательном пальце его синела большая бирюза, приносящая здоровье."
                            },
                            {
                                "example_id": "bfe7a69f-fdfc-4905-a667-7b57cfdcb6f8",
                                "sense_id": "f17157d8-f5e7-33b6-9bea-e804334ef08d",
                                "text": "Традиционно бедуинские украшения изготавливались из серебра, иногда в серебро оправлялась бирюза, а вместе с бирюзой камень красного цвета, например, коралл."
                            }
                        ]
                    },
                    {
                        "sense_id": "6781eaaa-fc13-33b9-8015-209e3281080e",
                        "entry_id": "f05e97ea-1151-3b47-9bb6-c76674dfc4bd",
                        "glosses": [
                            "небесно-голубой или зеленовато-голубой цвет"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "12cb2d55-f094-4e5a-8533-20660b3c6cf3",
                                "sense_id": "6781eaaa-fc13-33b9-8015-209e3281080e",
                                "text": "Замедлив ход, «Коршун» [судно] через узкий проход рифа оставил океан сзади и очутился в затишье лагуны, гладкой, как зеркало, и голубой, как бирюза."
                            },
                            {
                                "example_id": "4d57b9ba-9d65-49ee-80e1-b7c0f839a67a",
                                "sense_id": "6781eaaa-fc13-33b9-8015-209e3281080e",
                                "text": "Только над самыми нашими головами синеет клочок голубого неба, ясного и чистого, как бирюза."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f0903416-0ec5-491a-8d00-1c59177286e4",
                        "source_entry_id": "f05e97ea-1151-3b47-9bb6-c76674dfc4bd",
                        "source_sense_description": "непрозрачный драгоценный камень",
                        "target_lang_word": "turquoise",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "turquoise",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a5968ab6-aee6-3ab7-b3da-5c878c1e6f80",
                                        "entry_id": "1d4b12ab-df62-3f8a-916a-bb8b3369f9f9",
                                        "glosses": [
                                            "A sky-blue, greenish-blue, or greenish-gray semi-precious gemstone."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cee53d99-4227-41ca-bff7-bb143d661b87",
                                                "sense_id": "a5968ab6-aee6-3ab7-b3da-5c878c1e6f80",
                                                "text": "Although there are dozens of different types of gems, among the best known and most important are […] . (Common gem materials not addressed in this article include amber, amethyst, chalcedony, garnet, lazurite, malachite, opals, peridot, rhodonite, spinel, tourmaline, turquoise and zircon.)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eb5ade13-b7a3-35d8-9d10-ed011ff9ed65",
                                        "entry_id": "1d4b12ab-df62-3f8a-916a-bb8b3369f9f9",
                                        "glosses": [
                                            "A pale greenish-blue colour, like that of the gemstone."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "47b5253a-106e-4b93-a53e-276f7ea9de2a",
                                                "sense_id": "eb5ade13-b7a3-35d8-9d10-ed011ff9ed65",
                                                "text": "The half-dozen pieces […] were painted white and carved with festoons of flowers, birds and cupids. To display them the walls had been tinted a vivid blue which had now faded, but the carpet, which had evidently been stored and recently relaid, retained its original turquoise."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "turquoise",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5a8253d1-eaf3-3a55-a1d4-d37b2e74beb9",
                                        "entry_id": "3ef043fc-67bd-33b3-b2a2-9d7fb3dbbdb5",
