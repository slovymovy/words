        "fr-extract.jsonl": [
            {
                "entry_id": "3593ce46-7088-38aa-9cae-ff0969783d5d",
                "word": "désœuvrement",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "38febf86-40c8-40da-83b0-5b3ecdb002f8",
                        "entry_id": "3593ce46-7088-38aa-9cae-ff0969783d5d",
                        "tags": [
                            "plural"
                        ],
                        "form": "désœuvrements"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9e53db26-0f9d-3486-a7fc-1de00840a411",
                        "entry_id": "3593ce46-7088-38aa-9cae-ff0969783d5d",
                        "glosses": [
                            "État d’une personne désœuvrée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0bde823-8ac3-4e60-9fc0-ef91a79f7324",
                                "sense_id": "9e53db26-0f9d-3486-a7fc-1de00840a411",
                                "text": "La marquise trouva des distractions à sa profonde tristesse, et s’occupa par désœuvrement de sa terre, où elle se plut à ordonner quelques travaux."
                            },
                            {
                                "example_id": "c96e7167-efcc-431d-b616-41a0164a1caf",
                                "sense_id": "9e53db26-0f9d-3486-a7fc-1de00840a411",
                                "text": "À vous qui ne savez pas ce que c’est que le désœuvrement, je ne peux pas faire comprendre quelle influence immense il a sur nos déterminations, nos goûts et nos habitudes."
                            },
                            {
                                "example_id": "75292b4e-f722-46d2-b50b-8bf231193ccc",
                                "sense_id": "9e53db26-0f9d-3486-a7fc-1de00840a411",
                                "text": "On n’imagine pas les extrémités lamentables auxquelles le désœuvrement peut pousser les provinciaux qui s’ennuient : sans aptitudes pour la calomnie quotidienne, trop pauvre pour se faire client professionnel de la Manufacture de Saint-Étienne, Rétine sauta sur l’occasion d’enseigner le clairon à Battling."
                            },
                            {
                                "example_id": "4557ef14-25fb-4705-b11c-9dae2a2c21b8",
                                "sense_id": "9e53db26-0f9d-3486-a7fc-1de00840a411",
                                "text": "Égaré par le désœuvrement, il m’arrivait de me retourner sur ma folie, quand il aurait fallu l’ignorer, la maintenir en sous-main et fixer mon attention sur les objets extérieurs."
                            }
                        ]
                    },
                    {
                        "sense_id": "73009e2c-5490-3f42-9e9f-207dfd5b0aad",
                        "entry_id": "3593ce46-7088-38aa-9cae-ff0969783d5d",
                        "glosses": [
                            "Sentiment de malaise engendré par ce manque d’occupation."
                        ],
                        "tags": [
                            "metonymically"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "90debe53-881b-4640-8333-69dc007d6812",
                        "source_entry_id": "3593ce46-7088-38aa-9cae-ff0969783d5d",
                        "target_lang_word": "Müßiggang",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Müßiggang",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e0bae1a9-cd70-3171-b170-1733b61633bc",
                                        "entry_id": "7733e183-599b-3535-95a7-7adbf71deb77",
                                        "glosses": [
                                            "dauerhafte Untätigkeit (in der Umgangssprache negativer besetzt als Muße)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3db62650-4845-42dc-ab9a-fa863dbc87a8",
                                                "sense_id": "e0bae1a9-cd70-3171-b170-1733b61633bc",
                                                "text": "Sein Leben bestand nur noch aus Müßiggang."
                                            },
                                            {
                                                "example_id": "af70ee62-7389-4b48-8231-984f9450662b",
                                                "sense_id": "e0bae1a9-cd70-3171-b170-1733b61633bc",
                                                "text": "„Hui, der ehemals dem ehrbaren Handwerk des Schreibers obgelegen hatte, verdankte seinen Niedergang der südchinesischen Neigung zum Müßiggang.“"
                                            },
                                            {
                                                "example_id": "b6975227-8a6c-4138-93e8-527ad3be44a5",
                                                "sense_id": "e0bae1a9-cd70-3171-b170-1733b61633bc",
                                                "text": "„Falls ihm an der Gunst des französischen Publikums liegt, dann hat Kravchenko – Müßiggang ist aller … Anfang! – in den Ruhetagen zwischen der letzten Sitzung der vergangenen und der ersten dieser Woche einen unfaßlichen Fehler begangen; und mancher, der da schwankte, wird jetzt überzeugt sein, daß der Held der Affäre, wie die Lettres Françaises behaupten, wirklich nicht klug genug ist, um „Ich wählte die Freiheit“ geschrieben zu haben.“"
                                            },
                                            {
                                                "example_id": "3d3be8ae-f6bf-4891-bd88-d794df7e8b28",
                                                "sense_id": "e0bae1a9-cd70-3171-b170-1733b61633bc",
                                                "text": "„Wo Müßiggang und sein Genuß, aus der Öffentlichkeit verdrängt, zur Privatsache werden, hilft dem Flaneur die Maske des Begleiters.“"
                                            },
                                            {
                                                "example_id": "7db7d5d3-fab9-47cb-a7a4-2b840586c942",
                                                "sense_id": "e0bae1a9-cd70-3171-b170-1733b61633bc",
                                                "text": "„Dieser Müßiggang schien mir der Gipfel menschlichen Glücks zu sein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
