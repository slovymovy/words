        "fr-extract.jsonl": [
            {
                "entry_id": "c617bd4c-7755-3d0c-b7c6-e728107fa09f",
                "word": "блеснуть",
                "pos": "verb",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "9fae0126-1157-3bc3-badf-a16c2827d3a3",
                        "entry_id": "c617bd4c-7755-3d0c-b7c6-e728107fa09f",
                        "glosses": [
                            "Briller, resplendir, étinceler, chatoyer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f9053f70-e875-4881-b3d2-380c62e80373",
                                "sense_id": "9fae0126-1157-3bc3-badf-a16c2827d3a3",
                                "text": "Смотри, как блестит звезда!",
                                "translation": "Regarde comme cette étoile brille !"
                            },
                            {
                                "example_id": "553b3c0f-6083-465e-802e-5c22f057e408",
                                "sense_id": "9fae0126-1157-3bc3-badf-a16c2827d3a3",
                                "text": "У меня́ блесну́ла мысль.",
                                "translation": "Une pensée m’a traversé l’esprit."
                            },
                            {
                                "example_id": "cb2df97a-0dee-4189-a23e-bafbc9b0b2ef",
                                "sense_id": "9fae0126-1157-3bc3-badf-a16c2827d3a3",
                                "text": "Счастливая мысль блеснула у меня в голове.",
                                "translation": "Une pensée heureuse traversa un instant ma tête"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": [
                    {
