                        "form": "die Fachliteraturen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2fc095b4-169c-30cd-8585-3e529994227f",
                        "entry_id": "b43305d2-ba82-3be3-9bc8-df8bf133cbd5",
                        "glosses": [
                            "Gesamtheit aller Publikationen auf einem Gebiet, die sich an ein Fachpublikum richtet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3fe77d21-9d0d-421b-8c8c-7841fe42d5c3",
                                "sense_id": "2fc095b4-169c-30cd-8585-3e529994227f",
                                "text": "Die Fachliteratur auf dem Gebiet der Informatik ist fast ausschließlich auf Englisch verfasst."
                            },
                            {
                                "example_id": "6bd5015d-18cf-452c-9c32-f04a7405acae",
                                "sense_id": "2fc095b4-169c-30cd-8585-3e529994227f",
                                "text": "Was sagt denn die Fachliteratur dazu?"
                            },
                            {
                                "example_id": "85f2a00f-3d31-4798-9ddd-ee2385992a1e",
                                "sense_id": "2fc095b4-169c-30cd-8585-3e529994227f",
                                "text": "„Der rationale Kern, aber auch das Überzogene an der Kritik Wustmanns wie überhaupt das Problem der Substantivierungen im Deutschen ist inzwischen vielfältig in der Fachliteratur behandelt worden.“"
                            },
                            {
                                "example_id": "3d3b5616-b933-4007-b6e0-5e9595b04a66",
                                "sense_id": "2fc095b4-169c-30cd-8585-3e529994227f",
                                "text": "„Rund 4000 Bände Fachliteratur hat er zu Hause stehen…“"
                            },
                            {
                                "example_id": "c3d36b29-8fe8-4c08-b9ef-959129b48cb2",
                                "sense_id": "2fc095b4-169c-30cd-8585-3e529994227f",
                                "text": "„Fachliteratur findet der Interessierte zur Genüge.“"
                            },
                            {
                                "example_id": "8999e405-efb6-49ce-b9ce-585710b080fc",
                                "sense_id": "2fc095b4-169c-30cd-8585-3e529994227f",
                                "text": "„Verlässliche Informationen kann man in der Fachliteratur nachschlagen.“"
                            },
                            {
                                "example_id": "452cf72f-cff5-4c6e-af26-53b7f0bd2532",
                                "sense_id": "2fc095b4-169c-30cd-8585-3e529994227f",
                                "text": "„Darüber war die Fachliteratur liegengeblieben und hatte sich auf einer Ablage zu stapeln begonnen, griffbereit und doch nie angerührt, eine stetige Mahnung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
