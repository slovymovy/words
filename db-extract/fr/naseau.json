        "fr-extract.jsonl": [
            {
                "entry_id": "a067a54c-2404-3315-ab47-e86907f9a0e3",
                "word": "naseau",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "e37b20a6-73fd-452e-b119-d7b1fc4acdbb",
                        "entry_id": "a067a54c-2404-3315-ab47-e86907f9a0e3",
                        "tags": [
                            "plural"
                        ],
                        "form": "naseaux"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d1001d73-395b-3489-8814-a37e246eee9c",
                        "entry_id": "a067a54c-2404-3315-ab47-e86907f9a0e3",
                        "glosses": [
                            "Chacune des deux ouvertures du nez par lesquelles l’animal respire et flaire. Il se dit surtout des narines du cheval."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "285c0bcc-910b-433e-b89a-94f4d8bb3527",
                                "sense_id": "d1001d73-395b-3489-8814-a37e246eee9c",
                                "text": "L’attelage, ébranlant le chariot qu’il traîne,\nSe couche, les naseaux dans le sable, et le Roi\nSent tournoyer sa tête et se glacer sa veine."
                            },
                            {
                                "example_id": "d2df6d35-a9a9-4a94-9d00-2e41e40f4aec",
                                "sense_id": "d1001d73-395b-3489-8814-a37e246eee9c",
                                "text": "Il chancelait sur ses longues jambes faibles, et les mouches bourdonnaient autour de ses naseaux blancs, humides encore du lait de sa mère."
                            },
                            {
                                "example_id": "61de8a1b-b4b3-4c67-828a-629493c2f110",
                                "sense_id": "d1001d73-395b-3489-8814-a37e246eee9c",
                                "text": "Faites de petits cercles du bout des doigts en descendant le long du sinus du coin interne de l’œil jusqu’au naseau."
                            },
                            {
                                "example_id": "22319ca4-a829-49ac-b856-af0c6be79f74",
                                "sense_id": "d1001d73-395b-3489-8814-a37e246eee9c",
                                "text": "[…] les Housards et les Hongrois leur fendent les naseaux, dans la vue, dit-on, de leur donner plus d’haleine, et aussi pour les empêcher de hennir à la guerre ; on prétend que les chevaux auxquels on a fendu les naseaux ne peuvent plus hennir : je n’ai pas été à portée de vérifier ce fait, mais il me semble qu’ils doivent seulement hennir plus faiblement […]."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "355608f0-e543-48f8-9d39-fe113c58b58b",
                        "source_entry_id": "a067a54c-2404-3315-ab47-e86907f9a0e3",
                        "source_sense_id": "d1001d73-395b-3489-8814-a37e246eee9c",
                        "source_sense_description": "Chacune des deux ouvertures du nez par lesquelles l’animal respire et flaire. Il se dit surtout des narines du cheval",
                        "target_lang_word": "Nüster",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nüster",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f02aba42-3f0c-3ea0-a692-40a15fbec28b",
                                        "entry_id": "f00a17b2-e1c7-34ec-80dd-6f448a94781c",
                                        "glosses": [
                                            "Nasenöffnung der Pferde und anderer Unpaarhufer"
                                        ],
                                        "tags": [
                                            "vorwiegend im Plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "49f4c455-102b-4c18-921c-1c550df32917",
                                                "sense_id": "f02aba42-3f0c-3ea0-a692-40a15fbec28b",
                                                "text": "„Da Pferde aufgrund des sehr langen Gaumensegels fast nicht durch das Maul atmen können, sind die Nüstern der ausschließliche Zugang zu den Atemwegen.“"
                                            },
                                            {
                                                "example_id": "65d11de7-fd57-4a47-a443-b11087515093",
                                                "sense_id": "f02aba42-3f0c-3ea0-a692-40a15fbec28b",
                                                "text": "„Man sieht in der trockenen Kälte, wie der Atem wie Rauch aus den Nüstern der Rosse aufsteigt, vor einer Kulisse eleganter Damen, aparter pelzumhüllter Models und ihrer sportiven Begleiter in edlen Stiefeln und eleganten Anoraks.“"
                                            },
                                            {
                                                "example_id": "701a5805-9c2c-4d03-a7b1-8d3746c814ea",
                                                "sense_id": "f02aba42-3f0c-3ea0-a692-40a15fbec28b",
                                                "text": "„Die Nüstern der stolzen Rosse aus dem Palastgestüt dampften in der feuchten Luft zwischen den Palmenalleen.“"
                                            },
                                            {
                                                "example_id": "57342dd5-0cfd-4721-a881-3e7dde530c37",
                                                "sense_id": "f02aba42-3f0c-3ea0-a692-40a15fbec28b",
                                                "text": "„Ich spüre den warmen aasigen Hauch aus seinen Nüstern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
