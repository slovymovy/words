                                    {
                                        "sense_id": "097cf593-dc24-3794-8541-b4913eb44499",
                                        "entry_id": "92de712e-0021-3d68-b549-706a5aca3b76",
                                        "glosses": [
                                            "Abbreviation of Manitoba: a province of Canada."
                                        ],
