                "senses": [
                    {
                        "sense_id": "4e445208-9cda-3260-ab8b-fa53c5558fc6",
                        "entry_id": "b31169db-e065-3726-be55-acbf54bb576a",
                        "glosses": [
                            "Liste, in der Dinge nach Priorität/Wichtigkeit geordnet sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a75ef140-8106-436d-ba6d-922969cd955b",
                                "sense_id": "4e445208-9cda-3260-ab8b-fa53c5558fc6",
                                "text": "„Paris war eine Großstadt mit hoher Kriminalitätsrate. Entwendete Kennzeichen standen bei den Ermittlern sicher ziemlich weit unten auf der Prioritätenliste.“"
                            },
                            {
                                "example_id": "1282709f-58ed-4813-9799-17666c1a9020",
                                "sense_id": "4e445208-9cda-3260-ab8b-fa53c5558fc6",
                                "text": "„Gegen zwei Uhr nachts genehmigte Eschkol Dayans Prioritätenliste für den Rest des Krieges: die ägyptischen Panzertruppen vernichten; Scharm el-Scheich einnehmen; die Latrun-Straße, die Altstadt und das gesamte Westjordanland besetzen; den Fluss Banias bei den Golanhöhen, Tel Asasiat und die demilitarisierten Zonen an der syrischen Grenze einnehmen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
