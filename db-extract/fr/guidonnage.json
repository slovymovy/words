                ],
                "senses": [
                    {
                        "sense_id": "8f375ecb-e487-3c03-9d62-02c2dec26d14",
                        "entry_id": "1de38760-8850-33e8-8eec-805a32a68967",
                        "glosses": [
                            "Mouvements rapides et de forte amplitude du guidon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b4d81fed-29e6-4acd-9656-4be8a982cc82",
                                "sense_id": "8f375ecb-e487-3c03-9d62-02c2dec26d14",
                                "text": "Un guidonnage moto à grande vitesse peut être très dangereux."
                            },
                            {
                                "example_id": "44534cb2-3e36-45ad-82b9-9fe837642885",
                                "sense_id": "8f375ecb-e487-3c03-9d62-02c2dec26d14",
                                "text": "Il faut savoir que certaines motos BMW utilisées alors possédaient une fâcheuse tendance au « guidonnage » au bout d’un certain kilométrage."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "32ca6c7f-a669-492f-8b43-db42f27f8b53",
                        "source_entry_id": "1de38760-8850-33e8-8eec-805a32a68967",
                        "source_sense_id": "8f375ecb-e487-3c03-9d62-02c2dec26d14",
