                "senses": [
                    {
                        "sense_id": "7738e8d0-945f-33c1-a4b0-77c26f5d6563",
                        "entry_id": "e79f6aca-d16e-323a-b36c-7ca48ed2307d",
                        "glosses": [
                            "aus dem bearbeiteten Fell von Nerzen hergestellte Stola"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d160f58-d35e-4229-80ab-71f0a9a7540d",
                                "sense_id": "7738e8d0-945f-33c1-a4b0-77c26f5d6563",
                                "text": "„Dann entdeckt sie die Fontana di Trevi, entledigt sich des Kätzchens und der Nerzstola und steigt in den römischen Brunnen.“"
                            },
                            {
                                "example_id": "7c349ad8-d0b6-44d6-a88f-164e34990fec",
                                "sense_id": "7738e8d0-945f-33c1-a4b0-77c26f5d6563",
                                "text": "„Nerzstola, Handschuhe aus Satin, kunstvoll bestickte Stoffe, dezent getürmte Frisuren - mit dieser Aufzählung hat der Berichterstatter der Stuttgarter Nachrichten vom ersten Landespresseball nach dem Zweiten Weltkrieg fasziniert berichtet.“"
                            },
                            {
                                "example_id": "78fd0ad8-cf62-42ec-987e-5b35872b5746",
                                "sense_id": "7738e8d0-945f-33c1-a4b0-77c26f5d6563",
                                "text": "„Neugierig betrachteten Herren im Smoking und Damen mit kostbarsten Nerzstolen diese seltsame Gewinnerin, die bei jedem Gewinn aufschluchzte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
