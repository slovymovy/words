                ],
                "senses": [
                    {
                        "sense_id": "1fd6eca2-fec2-3e03-8af3-f81aad2b212c",
                        "entry_id": "4df544a4-939a-3bb9-b2c4-78bbc2ec3804",
                        "glosses": [
                            "immerwährender, ununterbrochener Zustand"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b3a5ea7-9c48-480b-baf9-b8ade91c3c9a",
                                "sense_id": "1fd6eca2-fec2-3e03-8af3-f81aad2b212c",
                                "text": "„Die Wirtschaft ist auf Schleichfahrt, die Schulden häufen sich. Die Krise der Vereinigten Staaten scheint zum Dauerzustand zu werden - mit Folgen für den Dollar, der beständig an Wert verliert.“"
                            },
                            {
                                "example_id": "2d8a13de-4b19-4de4-9802-44f8159bbe85",
                                "sense_id": "1fd6eca2-fec2-3e03-8af3-f81aad2b212c",
                                "text": "„Langsam hat sich die Erkenntnis durchgesetzt, daß der Alarm ein Dauerzustand ist.“"
                            },
                            {
                                "example_id": "dc6ba85c-bbe1-444c-9b8b-2ab015f8f3e7",
                                "sense_id": "1fd6eca2-fec2-3e03-8af3-f81aad2b212c",
                                "text": "„Kinderarmut ist in Deutschland ein Dauerzustand. …“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
