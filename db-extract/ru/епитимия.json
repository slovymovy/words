                ],
                "senses": [
                    {
                        "sense_id": "700d9fb9-4678-3ca9-9e9d-f7149b216ab1",
                        "entry_id": "e9bfb0a2-c783-336e-8b36-cdfa30b802f7",
                        "glosses": [
                            "религ. в христианстве — духовное взыскание, наказание, налагаемое церковью на кающегося грешника"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "869d84ee-0ac3-497b-8000-c3947bbb6e23",
                                "sense_id": "700d9fb9-4678-3ca9-9e9d-f7149b216ab1",
                                "text": "Епитимия назначается разная, по степени грехов, по возрасту, положению и по мере раскаяния."
                            },
                            {
                                "example_id": "f57c35e3-59d9-44fd-81be-1886ba4978b4",
                                "sense_id": "700d9fb9-4678-3ca9-9e9d-f7149b216ab1",
                                "text": "Такие жертвы происходят как епитимии, добровольно на себя почему-либо наложенные, и непременно из денег, собственным трудом добытых."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bcfd13b3-0811-4fba-abd2-ca3e56a9cac6",
                        "source_entry_id": "e9bfb0a2-c783-336e-8b36-cdfa30b802f7",
                        "source_sense_id": "700d9fb9-4678-3ca9-9e9d-f7149b216ab1",
                        "target_lang_word": "penance",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "penance",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "34286ff9-9000-37f8-93f2-85cc806d2c3c",
                                        "entry_id": "cefd2195-c298-30f4-a289-0084d0a92382",
                                        "glosses": [
                                            "A voluntary self-imposed punishment for a sinful act or wrongdoing. It may be intended to serve as reparation for the act."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "16c0c3c0-170e-4d40-964e-7b4600bb0daa",
                                                "sense_id": "34286ff9-9000-37f8-93f2-85cc806d2c3c",
                                                "text": "Quoth he, \"The man hath penance done, / And penance more will do.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "72979504-0651-3dd4-bb35-27f5d15a72da",
                                        "entry_id": "cefd2195-c298-30f4-a289-0084d0a92382",
                                        "glosses": [
                                            "A sacrament in some Christian churches that involves penitence (remorse plus restitution via prayer)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "70272583-2a74-3894-ac14-7bf55adc0401",
                                        "entry_id": "cefd2195-c298-30f4-a289-0084d0a92382",
                                        "glosses": [
                                            "Any instrument of self-punishment."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ed4f7025-dcc7-305c-82a9-e5add86d86c0",
                                        "entry_id": "cefd2195-c298-30f4-a289-0084d0a92382",
