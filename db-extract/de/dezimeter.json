                                "target_senses": [
                                    {
                                        "sense_id": "e867de22-b9c6-3cba-b5e7-fc964d7f0f91",
                                        "entry_id": "5f1caa16-bd5a-3eb5-b140-e128fd5de931",
                                        "glosses": [
                                            "An SI unit of length equal to 10⁻¹ metres. Symbol: dm"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4682853a-fbcc-4797-bcd7-c7c1d898f7bb",
                                                "sense_id": "e867de22-b9c6-3cba-b5e7-fc964d7f0f91",
                                                "text": "If the aquarium is placed where it receives insufficient daylight, artificial lighting by means of ordinary incandescent lamps should be employed. For good plant growth 2 decalumens of luminous flux per square decimetre of water surface […]"
                                            },
                                            {
                                                "example_id": "eb580af1-c51c-445d-8f34-855ddf89d9e8",
                                                "sense_id": "e867de22-b9c6-3cba-b5e7-fc964d7f0f91",
                                                "text": "Holonyms: metre < kilometre < megametre < gigametre < terametre < petametre"
                                            },
                                            {
                                                "example_id": "aad4ead7-9ea2-4875-852b-0bdcd9a4612c",
                                                "sense_id": "e867de22-b9c6-3cba-b5e7-fc964d7f0f91",
                                                "text": "Meronyms: picometre < nanometre < micrometre < millimetre < centimetre"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "89c93ebf-030d-4cce-990c-21933115c0f0",
                        "source_entry_id": "19596643-71ca-395d-8ee5-eae06dbaef07",
                        "source_sense_id": "5dc82ce7-a323-35aa-953a-0531a43d9203",
                        "source_sense_description": "der zehnte Teil eines Meters; 10 Zentimeter",
                        "target_lang_word": "décimètre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "décimètre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3b624f72-8327-3936-9d31-657d07d97c91",
                                        "entry_id": "01f75870-da29-315a-abd1-3cb9f2bde2a3",
                                        "glosses": [
                                            "Unité de mesure de longueur du Système international (SI), valant 10⁻¹ mètre, et dont le symbole est dm."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dce21f7b-4804-4d6b-b0b5-c50b63717378",
                                                "sense_id": "3b624f72-8327-3936-9d31-657d07d97c91",
                                                "text": "Ajoutons que, sur un grand nombre de points, lorsque les sables superposés à la couche imperméable (crassun) ont peu d'épaisseur, on arrive à l'eau en creusant de quelques décimètres seulement."
                                            },
                                            {
                                                "example_id": "01c8633a-e7bb-4f07-8b99-6f955dc74921",
                                                "sense_id": "3b624f72-8327-3936-9d31-657d07d97c91",
                                                "text": "Les traits des demi-centimètres devront être plus longs que ceux des millimètres, et plus courts que ceux des centimètres ; ces derniers seront aussi plus courts que ceux qui répondent aux décimètres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f2b03a22-ca6a-38f4-852f-b31eda24fe3f",
                                        "entry_id": "01f75870-da29-315a-abd1-3cb9f2bde2a3",
                                        "glosses": [
                                            "Règle de bois ou de métal ayant cette mesure et servant pour les ouvrages de dessin. Cette règle mesure souvent deux décimètres et s’appelle alors double décimètre."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
