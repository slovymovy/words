                "senses": [
                    {
                        "sense_id": "8c42792f-fa18-3a43-a237-760729c7ccef",
                        "entry_id": "33666a64-dad3-332f-bb31-bc813be4f8e4",
                        "glosses": [
                            "eine Frage einleitendes Fürwort (Pronomen)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf40bc7c-b277-4585-8fba-e8915fa8d9fa",
                                "sense_id": "8c42792f-fa18-3a43-a237-760729c7ccef",
                                "text": "Fragefürwörter leiten Ergänzungsfragen oder indirekte Fragen ein."
                            },
                            {
                                "example_id": "f2b84aa1-716d-457f-a630-bfe0fc41b42f",
                                "sense_id": "8c42792f-fa18-3a43-a237-760729c7ccef",
                                "text": "Fragefürwörter in einer Ergänzungsfrage: \"Wer kommt heute zu Besuch?\""
                            },
                            {
                                "example_id": "6a3e496e-8a5f-419a-9707-42e74d6951ee",
                                "sense_id": "8c42792f-fa18-3a43-a237-760729c7ccef",
                                "text": "Fragefürwörter in einer indirekten Frage: \"Er fragte mich, wer heute zu Besuch kommt.\""
                            },
                            {
                                "example_id": "769185e6-48e2-4fb2-9dd6-921c88093c27",
                                "sense_id": "8c42792f-fa18-3a43-a237-760729c7ccef",
                                "text": "„Es gibt noch diese so genannten »Interrogativpronomen«, auch »W-Wörter« oder »fragende Fürwörter«, »Fragefürwörter« genannt: WER, WELCHE, WAS, WEM, WESSEN...“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e5674c57-c006-4b97-b9e7-4c1ad684c07f",
                        "source_entry_id": "33666a64-dad3-332f-bb31-bc813be4f8e4",
                        "source_sense_id": "8c42792f-fa18-3a43-a237-760729c7ccef",
                        "source_sense_description": "Linguistik: eine Frage einleitendes Fürwort (Pronomen)",
                        "target_lang_word": "interrogative pronoun",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "interrogative pronoun",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "858e72db-52ea-39cc-85d2-e37ac92595fd",
                                        "entry_id": "ce216d45-9a58-3b38-8079-28f5ad035571",
                                        "glosses": [
                                            "A pronoun used in a question. In English, the five interrogative pronouns are what, which, who, whom, and whose (also used as relative pronouns). These require no antecedent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "79d73806-afb9-4bc6-b523-078ff7aac56a",
                                                "sense_id": "858e72db-52ea-39cc-85d2-e37ac92595fd",
                                                "text": "What did you say?"
                                            },
                                            {
                                                "example_id": "df1f7b43-7b72-4ebd-bf21-824094d0c0e9",
                                                "sense_id": "858e72db-52ea-39cc-85d2-e37ac92595fd",
                                                "text": "Who said that?"
                                            },
                                            {
                                                "example_id": "3896e8dc-9730-4902-bbde-baa4b234e649",
                                                "sense_id": "858e72db-52ea-39cc-85d2-e37ac92595fd",
                                                "text": "To whom was that said?"
                                            },
                                            {
                                                "example_id": "440cbb5c-ecbe-4237-be59-07c895519ff8",
                                                "sense_id": "858e72db-52ea-39cc-85d2-e37ac92595fd",
                                                "text": "Which student said that?"
                                            },
                                            {
                                                "example_id": "39672b06-8f14-416b-9d64-82e79c1554f8",
                                                "sense_id": "858e72db-52ea-39cc-85d2-e37ac92595fd",
                                                "text": "Whose question was that?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "060a7e95-bd40-4de4-8db0-fee5c9f3122c",
                        "source_entry_id": "33666a64-dad3-332f-bb31-bc813be4f8e4",
