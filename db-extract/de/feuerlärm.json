                "senses": [
                    {
                        "sense_id": "726be138-e98c-32fa-a01f-e1bc00c250d0",
                        "entry_id": "3e9c67e8-3d35-334c-822a-39a195d9a9d6",
                        "glosses": [
                            "Lärm, der durch einen Feueralarm verursacht wird"
                        ],
                        "tags": [
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "fa96049f-9d28-4dab-9f98-99c6fecf054d",
                                "sense_id": "726be138-e98c-32fa-a01f-e1bc00c250d0",
                                "text": "„In der auf diese grausame Tat folgenden Nacht wurde ich durch Feuerlärm aus dem Schlafe aufgeschreckt. Meine Bettvorhänge brannten. Das ganze Haus stand in Flammen.“"
                            },
                            {
                                "example_id": "2f286dca-9180-4fd3-8c87-c2311bbaccf7",
                                "sense_id": "726be138-e98c-32fa-a01f-e1bc00c250d0",
                                "text": "„Auf den Feuerlärm hin war sofort eine Menschenmenge in den Garten eingedrungen, und irgendeiner mußte dort das Tier abgeschnitten und durch das offenstehende Fenster in mein Zimmer geworfen haben, wahrscheinlich in der guten Absicht, mich dadurch aus dem Schlaf zu wecken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
