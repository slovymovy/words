                    }
                ],
                "senses": [
                    {
                        "sense_id": "675c06fd-2230-3454-bda3-a1925d62e7c4",
                        "entry_id": "dae05e2f-cb80-32e1-bd81-47c09e13dbc7",
                        "glosses": [
                            "The act of ordaining or the state of being ordained."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "3e84ded3-e810-3bc7-b291-c5a3edf0992c",
                        "entry_id": "dae05e2f-cb80-32e1-bd81-47c09e13dbc7",
                        "glosses": [
                            "The ceremony in which a priest is consecrated, considered a sacrament in the Catholic and Orthodox churches."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "53d0c4bf-49db-327c-87f7-44a22255d814",
                        "entry_id": "dae05e2f-cb80-32e1-bd81-47c09e13dbc7",
                        "glosses": [
                            "the ceremony in which a bhikkhu or bhikkhuni is ordained into the sangha"
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fc2b5318-6d38-4914-a9ec-6e2794e53e95",
                        "source_entry_id": "dae05e2f-cb80-32e1-bd81-47c09e13dbc7",
                        "source_sense_description": "act of ordaining",
                        "target_lang_word": "vysvěcení",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "af44938f-c6a4-4b5b-bf7c-359f0c789cba",
                        "source_entry_id": "dae05e2f-cb80-32e1-bd81-47c09e13dbc7",
                        "source_sense_description": "act of ordaining",
                        "target_lang_word": "ordination",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ordination",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e3634a4b-dfb8-33d3-8d67-c6f53f5338c5",
                                        "entry_id": "d7064462-d607-31a4-b2c8-9a2261b63963",
                                        "glosses": [
                                            "Action de conférer ou de recevoir les ordres de l’Église."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "942eed99-6692-4664-8c62-446396c9b953",
                                                "sense_id": "e3634a4b-dfb8-33d3-8d67-c6f53f5338c5",
                                                "text": "L’ordination ne peut être donnée que par un évêque."
                                            },
                                            {
                                                "example_id": "9e68300b-9c11-449c-9466-e0c6223a79fc",
                                                "sense_id": "e3634a4b-dfb8-33d3-8d67-c6f53f5338c5",
                                                "text": "Il a reçu l’ordination sacerdotale."
                                            },
                                            {
                                                "example_id": "e081a54f-45db-4a9c-b8b1-020a73b33d16",
                                                "sense_id": "e3634a4b-dfb8-33d3-8d67-c6f53f5338c5",
                                                "text": "Dans tous les pays catholiques [dans les années 1960], les églises se vident, l'ordination des prêtres ne cesse de décliner et bon nombre de clercs retournent à la vie civile."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d803c5ff-9550-3106-8bfd-412f38ea4195",
                                        "entry_id": "d7064462-d607-31a4-b2c8-9a2261b63963",
                                        "glosses": [
                                            "Cérémonie au cours de laquelle l’évêque confère les ordres sacrés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e458a9a7-9457-4182-9362-e9797290e003",
                                                "sense_id": "d803c5ff-9550-3106-8bfd-412f38ea4195",
                                                "text": "Ma mémoire du calendrier, mon exactitude à souhaiter les anniversaires d’ordination, par exemple, est célèbre."
                                            },
                                            {
                                                "example_id": "964719ec-9236-4976-8eef-bc821e8a33a8",
                                                "sense_id": "d803c5ff-9550-3106-8bfd-412f38ea4195",
                                                "text": "Les ordinations se font le jour de la Pierre, la veille de la Pentecôte, etc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2fee4ffa-a592-32c9-afa9-fb7c042375d3",
                                        "entry_id": "d7064462-d607-31a4-b2c8-9a2261b63963",
                                        "glosses": [
                                            "Mise en ordre, arrangement, organisation."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9393675c-1d57-41e3-8e82-5bd79e869e26",
                                                "sense_id": "2fee4ffa-a592-32c9-afa9-fb7c042375d3",
                                                "text": "Avant que de s’occuper de l’ordination générale des choses, il prit une forme matérielle ; car l’esprit n’a aucun rapport avec le corps & pour agir sur le corps il faut que l’esprit s’en revétisse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a0de8433-c4fc-340e-bd79-3c7cc55a53e5",
                                        "entry_id": "d7064462-d607-31a4-b2c8-9a2261b63963",
                                        "glosses": [
                                            "Mise en ordre, organisation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "95ff4a2a-9ffc-4091-a385-4d5b889dd978",
                                                "sense_id": "a0de8433-c4fc-340e-bd79-3c7cc55a53e5",
                                                "text": "Nous pensons ainsi que l’interprétation détermine et, dans ce sens, précède logiquement l’acquisition, la description et l’ordination des données de la fouille, ou, du moins, la forme définitive sous laquelle ces diverses étapes devraient être présentées au lecteur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "019e4dad-eb52-3869-afe9-a075353c5e48",
                                        "entry_id": "d7064462-d607-31a4-b2c8-9a2261b63963",
                                        "glosses": [
                                            "Mise en ordre, organisation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d12570c8-6a15-40b9-a16e-387b519416a8",
                                                "sense_id": "019e4dad-eb52-3869-afe9-a075353c5e48",
                                                "text": "La méthode présente des points communs avec Twinspan, en ce sens qu’elle débute par une ordination des données suivie d’un partitionnement des relevés."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
