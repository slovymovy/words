                        "source_sense_description": "gedrucktes Werk, das Kochrezepte enthält",
                        "target_lang_word": "поваренная книга",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "поваренная книга",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "2b305cb2-eed2-3336-ae4c-8cd6c85b3fb7",
                                        "entry_id": "63f5a548-40ee-3352-82a7-80e29e09d3e8",
                                        "glosses": [
                                            "справочное издание, содержащее в основном различные рецепты приготовления пищи и напитков, также иногда кулинарные советы; руководство по приготовлению блюд"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fae9e004-633e-4fed-b8f3-0cab0755085b",
                                                "sense_id": "2b305cb2-eed2-3336-ae4c-8cd6c85b3fb7",
                                                "text": "Он стал долго и красочно излагать рецепт приготовления борща, а потом ― вареников разных сортов, а потом ― галушек, но мы повторять этих рецептов не будем и отправляем желающих к поваренной книге."
                                            },
                                            {
                                                "example_id": "b1c3de8b-9811-404f-9611-38cae5a887c6",
                                                "sense_id": "2b305cb2-eed2-3336-ae4c-8cd6c85b3fb7",
                                                "text": "Он не выходил даже иногда из дому в столовую пообедать, а покупал раз в два дня мясо, картошку, крупу, затем в большой, опустевшей кухне ― все соседи разъезжались на лето ― варил себе еду, заглядывая в поваренную книгу."
                                            },
                                            {
                                                "example_id": "cc27794c-f39d-4eae-9eb6-0e36bb608977",
                                                "sense_id": "2b305cb2-eed2-3336-ae4c-8cd6c85b3fb7",
                                                "text": "Для того чтобы стимулировать спрос, компания выпустила несколько поваренных книг, содержащих рецепты с использованием этого продукта."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
