                "senses": [
                    {
                        "sense_id": "2803a1bb-0c4e-3f44-9998-33f9f4387361",
                        "entry_id": "34dbeba3-e572-38b8-ab61-a2a73d04f937",
                        "glosses": [
                            "Gelehrter mit umfangreichem Wissen über Religiöses, auf Gott Bezogenes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cca641fb-3b49-49c7-8b50-f668e9ad1fe5",
                                "sense_id": "2803a1bb-0c4e-3f44-9998-33f9f4387361",
                                "text": "„Er besitzt weder von offizieller noch von nichtoffizieller Seite irgendwelche Papiere, die ihn als Gottesgelehrten ausweisen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
