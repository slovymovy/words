                                "target_word": "аорта",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "6f8b6005-caef-35cb-942d-4989ad013fdf",
                                        "entry_id": "b5bb4492-0d2d-34b4-9407-2e1f0aa8a3ce",
                                        "glosses": [
                                            "анат. самая крупная артерия в организме позвоночных и человека, выходящая из левого желудочка сердца"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7403da7c-9470-4577-a939-b8b6a6479755",
                                                "sense_id": "6f8b6005-caef-35cb-942d-4989ad013fdf",
                                                "text": "На задней стенке брюшной полости проходят брюшная часть аорты, нижняя полая вена, лежат нервные сплетения, лимфатические сосуды и узлы."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2e02aef7-d434-408d-b671-6b85023cf62d",
                        "source_entry_id": "524fd967-d5c0-3076-a521-e6bcf8c781d5",
                        "source_sense_id": "6b455fd9-3890-3d97-bb24-94f22f5fc4e9",
                        "source_sense_description": "ein Blutgefäß, das direkt auf der linken Seite des Herzens entspringt",
                        "target_lang_word": "aorta",
