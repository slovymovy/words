                "translations": [
                    {
                        "translation_id": "f22405d1-97fd-4cf8-875f-d664762af42c",
                        "source_entry_id": "3e6123df-2cd2-387c-93cb-c623d5f04bb1",
                        "source_sense_id": "4d8925f5-3792-3f55-878b-864495fcc3b2",
                        "target_lang_word": "sodomite",
                        "target_lang_code": "en",
