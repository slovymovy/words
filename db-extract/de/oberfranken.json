                "senses": [
                    {
                        "sense_id": "05c55d1f-65af-3034-aee4-8e0de2dd8345",
                        "entry_id": "be4b554a-bad6-372d-900f-27650257a7ad",
                        "glosses": [
                            "Bezirk (kommunale Gebietskörperschaft oberhalb der Landkreise) im Norden des Bundeslands Bayern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b79e6a1-0a8d-475d-90cd-b99c21b97760",
                                "sense_id": "05c55d1f-65af-3034-aee4-8e0de2dd8345",
                                "text": "„Unter äußerst schwierigen Rahmenbedingungen hat der Bezirk Oberfranken am Donnerstag seinen Haushalt für 2011 verabschiedet.“"
                            },
                            {
                                "example_id": "719687a5-7891-4366-a8f9-cc10d13f3e38",
                                "sense_id": "05c55d1f-65af-3034-aee4-8e0de2dd8345",
                                "text": "„In Hallstadt in Oberfranken ist eine Frau in einer Zahnarztpraxis derart wütend geworden, dass die Polizei kommen musste.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "4d6d0558-7b6d-3b9b-9059-f555a03bf634",
                        "entry_id": "be4b554a-bad6-372d-900f-27650257a7ad",
                        "glosses": [
                            "Regierungsbezirk im Norden des Bundeslands Bayern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd563859-44e0-4d04-86ee-e6a30e800788",
                                "sense_id": "4d6d0558-7b6d-3b9b-9059-f555a03bf634",
                                "text": "„Die Regierungsbezirke Oberfranken und Mittelfranken haben beide eine Arbeitslosenquote von 4,4 Prozent.“"
                            },
                            {
                                "example_id": "195578a1-b8ad-41e0-af25-5d5c24e036bd",
                                "sense_id": "4d6d0558-7b6d-3b9b-9059-f555a03bf634",
                                "text": "„In Hallstadt in Oberfranken ist eine Frau in einer Zahnarztpraxis derart wütend geworden, dass die Polizei kommen musste.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
