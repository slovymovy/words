                        "entry_id": "738ee190-41ca-38fd-8c37-ff6f68d69b7f",
                        "glosses": [
                            "To ride waves or surf without equipment, such as a surfboard."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "450799ff-8e52-461d-ab39-62f169d547af",
                                "sense_id": "ab8c1e0f-a91a-31c4-a477-bf29d95b1e9c",
                                "text": "The key to bodysurfing a good wave is timing."
                            }
                        ]
                    },
                    {
                        "sense_id": "3790df07-bb3c-3302-9090-c615d481b580",
                        "entry_id": "738ee190-41ca-38fd-8c37-ff6f68d69b7f",
                        "glosses": [
                            "To ride waves either without equipment or with a handboard."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "89dff334-2203-42ca-927e-711aa7758561",
                                "sense_id": "3790df07-bb3c-3302-9090-c615d481b580",
                                "text": "A talented surfer and strong swimmer, and a fellow member of the Bronte Surf Club, he specialised in body surfing with a hand board."
                            },
                            {
                                "example_id": "126a1487-758c-4c21-95dd-e9f4df527abb",
                                "sense_id": "3790df07-bb3c-3302-9090-c615d481b580",
                                "text": "Australians had been surfing lying down on 4-5 foot wooden surfboards before then and bodysurfing with wooden handboards — some had even heard about stand-up surfing in Hawaii and seen a couple of local surfers standing up — but stand-up surfing was still more of a rumour than a reality for most Aussie beach-goers."
                            }
                        ]
                    }
