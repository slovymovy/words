                    }
                ],
                "senses": [
                    {
                        "sense_id": "285b07a4-e597-3a09-ae33-cdc5559b8933",
                        "entry_id": "7ee941ef-4b83-3b64-860c-bc6a53c5e277",
                        "glosses": [
                            "Bezeichnung für den Planeten Venus am westlichen Abendhimmel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "35726cfc-918a-4793-a841-fb55d1a316e4",
                                "sense_id": "285b07a4-e597-3a09-ae33-cdc5559b8933",
                                "text": "„Da hebt der Abendstern gemach / sich aus den Föhrenzweigen, / und grade ob der Hütte Dach / scheint er sich mild zu neigen.“"
                            },
                            {
                                "example_id": "b71a8792-c13b-49d8-b90f-b8a2e7735a28",
                                "sense_id": "285b07a4-e597-3a09-ae33-cdc5559b8933",
                                "text": "„Schon war die Sonne hinabgesunken; das Lied der Vögel verstummte; ein leiser Wind trieb die Wellen kräuselnd gegen meine Brust; der Abendstern stand lächelnd über dem jenseitigen Berg; eine wehmütige Lust durchdrang mein Herz bei dem Klange einer Hirtenflöte, die in der Gegend über die Wiesen hinspielte.“"
                            },
                            {
                                "example_id": "beb4c472-58cc-4873-ab09-4b37ff58d29a",
                                "sense_id": "285b07a4-e597-3a09-ae33-cdc5559b8933",
                                "text": "„Oft wanderte Martin abseits des Biwakfeuers über die Felder, sah der Sonne nach, wenn sie am westlichen Horizont versank und eine kleine zweite Sonne, den Abendstern, aufleuchten ließ.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2292df23-591f-4391-89ee-b0b7af88d997",
                        "source_entry_id": "7ee941ef-4b83-3b64-860c-bc6a53c5e277",
                        "source_sense_id": "285b07a4-e597-3a09-ae33-cdc5559b8933",
                        "source_sense_description": "Bezeichnung für den Planeten Venus am westlichen Abendhimmel",
