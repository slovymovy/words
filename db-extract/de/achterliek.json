                    }
                ],
                "senses": [
                    {
                        "sense_id": "1b8fc3cd-a27c-3e7f-bc6c-96bfaa2feb6e",
                        "entry_id": "d8b2e03e-f0f7-3653-b48f-784ecbb75285",
                        "glosses": [
                            "hintere Seite/ hinterer Rand eines Segels"
                        ],
                        "tags": [
                            "Seemannssprache"
                        ],
                        "examples": [
                            {
                                "example_id": "f66bb73e-7cf7-457e-bbff-9d857c70b67a",
                                "sense_id": "1b8fc3cd-a27c-3e7f-bc6c-96bfaa2feb6e",
                                "text": "Zwei oder drei Windfäden, die ins Achterliek geklebt werden, zeigen an, ob die Strömung bis zum Ende des Segels laminar bleibt."
                            },
                            {
                                "example_id": "97298a60-70b6-4e92-8372-35df27f23272",
                                "sense_id": "1b8fc3cd-a27c-3e7f-bc6c-96bfaa2feb6e",
                                "text": "„So soll es sein: Die Windfäden am Achterliek sollten gerade nach achtern auswehen, lediglich der oberste Faden darf ab und an nach Lee wegklappen.“"
                            },
                            {
                                "example_id": "e9a01e9c-68f2-48ad-a957-2d601cdb6fef",
                                "sense_id": "1b8fc3cd-a27c-3e7f-bc6c-96bfaa2feb6e",
                                "text": "„»Gestern hatten wir zwei Risse im Achterliek unserer J2.«“"
                            },
                            {
                                "example_id": "d47b9657-41c7-41fb-87d2-e727df0ada53",
                                "sense_id": "1b8fc3cd-a27c-3e7f-bc6c-96bfaa2feb6e",
                                "text": "„Vornehmlich auf Regattabooten gibt es häufig eine Leine im Achterliek, um die Liekspannung zu kontrollieren.“"
                            },
                            {
                                "example_id": "b9d3ec2f-65a1-4ec7-9d9d-dfd50192d0c0",
                                "sense_id": "1b8fc3cd-a27c-3e7f-bc6c-96bfaa2feb6e",
                                "text": "„Um dem Achterliek eine gewisse Stütze zu geben, ist in den Saum des Segels eine schwache, bewegliche Liekleine hineingesteckt, die man anholen und fieren kann, wodurch das Achterliek reguliert wird.“"
                            },
                            {
                                "example_id": "a8fa1be4-7726-4618-8084-f7ab4fd2a8c1",
                                "sense_id": "1b8fc3cd-a27c-3e7f-bc6c-96bfaa2feb6e",
                                "text": "[Trimm von Fock oder Genua:] „Je nachdem, wo der Umlenker an Deck positioniert ist, verändert sich die Krafteinleitung von der Schot ins Segel. Unter- und Achterliek werden also verschieden stark gespannt.“"
                            },
                            {
                                "example_id": "ebb57c93-072d-451f-afc0-659835909d02",
                                "sense_id": "1b8fc3cd-a27c-3e7f-bc6c-96bfaa2feb6e",
                                "text": "„Die Design-Spezifikation sieht für das Großsegel eine etwas größere Fläche durch ein oben etwas ausgestelltes Achterliek mit einer zweiten durchgehenden Segellatte vor.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3e5e9d8f-3011-4282-af99-55ab1096f33d",
                        "source_entry_id": "d8b2e03e-f0f7-3653-b48f-784ecbb75285",
                        "source_sense_id": "1b8fc3cd-a27c-3e7f-bc6c-96bfaa2feb6e",
                        "source_sense_description": "Seemannssprache: hintere Seite/ hinterer Rand eines Segels",
                        "target_lang_word": "leech",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "leech",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "defd4a5d-6285-3cab-ac44-c15dd39f5a3c",
                                        "entry_id": "c70d9971-df98-3f58-a8bc-660e4bd4c706",
                                        "glosses": [
                                            "An aquatic blood-sucking annelid of subclass Hirudinea, especially Hirudo medicinalis."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bad7f75a-bacf-4554-b1e5-ec5b52d06254",
                                                "sense_id": "defd4a5d-6285-3cab-ac44-c15dd39f5a3c",
                                                "text": "The leech on his leg had swelled to more than five inches long, puffed and swollen on his blood."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2e964472-bb0d-34dc-9e24-644fb0dc765d",
                                        "entry_id": "c70d9971-df98-3f58-a8bc-660e4bd4c706",
                                        "glosses": [
                                            "A person who derives advantage from others in a parasitic fashion."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "854d8ca5-1285-48d9-b012-cdfdc203bd79",
                                                "sense_id": "2e964472-bb0d-34dc-9e24-644fb0dc765d",
                                                "text": "'Wrecked his body and his mind, no use to hisself or his family or nobody, just a leech on society'."
                                            },
                                            {
                                                "example_id": "ae5a1dd8-95dd-4ec3-8cb5-6b38525bd7a4",
                                                "sense_id": "2e964472-bb0d-34dc-9e24-644fb0dc765d",
                                                "text": "At this point, I felt this man was a leech. I suspected that he had spent a lifetime living off the good will of women that he met."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9b2d898d-1e40-3a2f-bfc8-6491c4997a12",
                                        "entry_id": "c70d9971-df98-3f58-a8bc-660e4bd4c706",
                                        "glosses": [
                                            "A glass tube designed for drawing blood from damaged tissue by means of a vacuum."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "leech",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b4b124bf-99bf-3a20-a0bc-fe580e98557c",
                                        "entry_id": "0b25f995-d1a8-3b3f-b0ee-a910f0aa3b2a",
                                        "glosses": [
                                            "To apply a leech medicinally, so that it sucks blood from the patient."
                                        ],
                                        "tags": [
                                            "literally",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "893bba5a-c048-4779-b571-aef70802d9e7",
                                                "sense_id": "b4b124bf-99bf-3a20-a0bc-fe580e98557c",
                                                "text": "The poppy made him sleep and while he slept they leeched him to drain off the bad blood."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "43b0aec3-339e-3c1c-8834-e8fedbbc3a2f",
                                        "entry_id": "0b25f995-d1a8-3b3f-b0ee-a910f0aa3b2a",
                                        "glosses": [
                                            "To drain (resources) without giving back."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c10642db-d15a-476b-a7e5-401fceedc941",
                                                "sense_id": "43b0aec3-339e-3c1c-8834-e8fedbbc3a2f",
                                                "text": "Near-synonyms: mooch, suck down"
                                            },
                                            {
                                                "example_id": "1030bea9-d2f8-4bdf-8aee-aefb23cb2d4b",
                                                "sense_id": "43b0aec3-339e-3c1c-8834-e8fedbbc3a2f",
                                                "text": "Bert leeched hundreds of files from the BBS, but never uploaded anything in return."
                                            },
                                            {
                                                "example_id": "56994f8b-71ac-49fa-b156-cf8eb80c6692",
                                                "sense_id": "43b0aec3-339e-3c1c-8834-e8fedbbc3a2f",
                                                "text": "Her daughter Astrid (new Tim Burton muse Jenna Ortega) barely speaks to her, and her greasy-haired boyfriend Rory (Justin Theroux, proving once again to be a comedic tour de force) obviously leeching off her fame and money"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "leech",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "461619df-e995-38ad-a816-160a745d420e",
                                        "entry_id": "14d1c8b6-7308-3f40-94eb-cfdae94c84ac",
                                        "glosses": [
                                            "A physician."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "03580276-c3cb-46dc-9250-5ac15ca1fc4a",
                                                "sense_id": "461619df-e995-38ad-a816-160a745d420e",
                                                "text": "Many skillful leeches him abide to salve his hurts."
                                            },
                                            {
                                                "example_id": "70b0956b-0148-4d2a-b7e1-51b52a7555d0",
                                                "sense_id": "461619df-e995-38ad-a816-160a745d420e",
                                                "text": "The word Physitian we do vulgarly abuse (as we doe very many other(s)) for a Leech , or Medicus."
                                            },
                                            {
                                                "example_id": "fbb0fda7-b517-4506-b08c-77e79d01b3ef",
                                                "sense_id": "461619df-e995-38ad-a816-160a745d420e",
                                                "text": "1610, Bolton, Armoriesː\nAs if an expert leech must needs be expert in the physicks (that is, in those speculations which concerne the workes of nature) the nearest word to fall with our tongue, yet not farre from the thing, was physitian."
                                            },
                                            {
                                                "example_id": "ebe102b4-a813-41f0-b3fa-aba315c654b3",
                                                "sense_id": "461619df-e995-38ad-a816-160a745d420e",
                                                "text": "Thus virtuous Orsin was endued / With learning, conduct, fortitude / Incomparable; and as the prince / Of poets, Homer, sung long since, / A skilful leech is better far, / Than half a hundred men of war [...]"
                                            },
                                            {
                                                "example_id": "6eea0494-a77c-42cb-af36-786e4845793e",
                                                "sense_id": "461619df-e995-38ad-a816-160a745d420e",
                                                "text": "Can this proud leech, with all his boasted skill, / Amend the soul or body, wit or will?"
                                            },
                                            {
                                                "example_id": "3e9982de-604a-4bb8-9181-ab165ae67450",
                                                "sense_id": "461619df-e995-38ad-a816-160a745d420e",
                                                "text": "For the sake of the minister’s health, and to enable the leech to gather plants with healing balm in them, they took long walks on the seashore or in the forest; mingling various talk with the plash and murmur of the waves, and the solemn wind anthem among in treetops."
                                            },
                                            {
                                                "example_id": "0e150ce1-ccf9-44c6-8a7b-d9fcf0e24d6a",
                                                "sense_id": "461619df-e995-38ad-a816-160a745d420e",
                                                "text": "He coughed sputum stained with blood, and a scraping, crackling noise came from his chest, quite audible to anyone in the room. ‘Lungs possibly not too good,’ the leech said."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "79c9f8c4-c766-38ee-9e19-3fdf4c2b6faf",
                                        "entry_id": "14d1c8b6-7308-3f40-94eb-cfdae94c84ac",
                                        "glosses": [
                                            "A healer."
                                        ],
                                        "tags": [
                                            "Germanic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a374e492-ddc7-4aeb-82bd-1a6a6ceeda28",
                                                "sense_id": "79c9f8c4-c766-38ee-9e19-3fdf4c2b6faf",
                                                "text": "Their functions are threefold, those of the medicine-man (the leech, or healer by supernatural means); of the soothsayer (the prophet through communion with the invisible world); and of the priest, especially in his capacity as exorcist"
                                            },
                                            {
                                                "example_id": "e18bcbc1-0157-44ad-a527-3be5bb6c19da",
                                                "sense_id": "79c9f8c4-c766-38ee-9e19-3fdf4c2b6faf",
                                                "text": "In ancient times runesters were a specialized class separate from that of the witch or ordinary spell caster (much as the other specialists such as the leech or healer and the seithkona were different from a witch), and even today many believe it takes years of training to become adept at using the runes in spell work."
                                            },
                                            {
                                                "example_id": "3c4288fb-171f-43b4-a08b-9b7d8ac2635e",
                                                "sense_id": "79c9f8c4-c766-38ee-9e19-3fdf4c2b6faf",
                                                "text": "\"Leech?\" \"Not another doctor\"."
                                            },
                                            {
                                                "example_id": "33c9489c-50e7-44ae-8c43-334e56f8f2ee",
                                                "sense_id": "79c9f8c4-c766-38ee-9e19-3fdf4c2b6faf",
                                                "text": "There are many kinds of \"Leech\" or \"healer\" as there are healing techniques, some are more powerful than others and some are very specific to certain illnesses and complaints; some use potions and unguents, others crystals and stones, others galdr and some work their healing from within the hidden realms themselves."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "leech",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fcb6bed7-f040-39dc-9d8a-1bdf4dbf17ea",
                                        "entry_id": "efdf1058-b4b6-3096-83c7-755981a9d8e4",
                                        "glosses": [
                                            "To treat, cure or heal."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bc46259b-479d-4311-9d52-34cb198fdffe",
                                                "sense_id": "fcb6bed7-f040-39dc-9d8a-1bdf4dbf17ea",
                                                "text": "1564, Accounts of Louth Corporalː\nPaid for leeching.. my horses very sick."
                                            },
                                            {
                                                "example_id": "dfeb0759-a1ec-4461-8895-87279e130a4d",
                                                "sense_id": "fcb6bed7-f040-39dc-9d8a-1bdf4dbf17ea",
                                                "text": "1566–74, Accounts of the Treasurer of Scotlandː\nTo one man (that) broke his leg in Strivelin … Item to the man that leecheth him."
                                            },
                                            {
                                                "example_id": "dd176bad-89fd-406f-85c9-697d0275be1b",
                                                "sense_id": "fcb6bed7-f040-39dc-9d8a-1bdf4dbf17ea",
                                                "text": "though there are many Pretenders to the Art of Farriering and Cow-leeching, yet many of them are very ignorant , especially in the Countrie"
                                            },
                                            {
                                                "example_id": "e9a9589f-b183-44ef-b907-50109e5459b5",
                                                "sense_id": "fcb6bed7-f040-39dc-9d8a-1bdf4dbf17ea",
                                                "text": "1850, Blackieː\nA disease that none may leech."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "leech",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1f8f7630-e208-32e0-989d-6c58f2ab8488",
                                        "entry_id": "55c4cce9-32ce-3f00-9f8d-642dc112b4aa",
                                        "glosses": [
                                            "The vertical edge of a square sail."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba6eeb26-c815-4fb3-9d34-7986b17ee9d3",
                                                "sense_id": "1f8f7630-e208-32e0-989d-6c58f2ab8488",
                                                "text": "To help combat these problems, almost all sailmakers trim the leeches of their headsails to a hollow or concave profile and enclose a LEECHLINE within the leech tabling."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "02a318a8-cf3d-315a-9f92-d55f6eb884ac",
                                        "entry_id": "55c4cce9-32ce-3f00-9f8d-642dc112b4aa",
                                        "glosses": [
                                            "The aft edge of a triangular sail."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c5527b5-a512-4dd3-9dd5-63ff25b3274d",
                                                "sense_id": "02a318a8-cf3d-315a-9f92-d55f6eb884ac",
                                                "text": "Trim the leech of the jib parallel to the main by watching the slot between the mainsail and the jib."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
