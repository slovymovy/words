                ],
                "senses": [
                    {
                        "sense_id": "fe27e37f-ee50-3917-82ed-03468f18044b",
                        "entry_id": "cd8d4a33-7ea5-3328-a742-bd76c11fe8db",
                        "glosses": [
                            "Faire perdre son caractère racial à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "64757b92-f6db-4f5d-bf00-fdca1fcfc636",
                                "sense_id": "fe27e37f-ee50-3917-82ed-03468f18044b",
                                "text": "En 2008, le candidat Obama paraissait pourtant idéalement placé pour « déracialiser » la politique américaine."
                            },
                            {
                                "example_id": "ad601d8c-7633-4820-adab-484592a28583",
                                "sense_id": "fe27e37f-ee50-3917-82ed-03468f18044b",
                                "text": "Il souhaite, à la suite d'Amin Maalouf, déracialiser les identités, pour qu' « être citoyen » prenne tout son sens."
                            },
                            {
                                "example_id": "612a2e1a-ccfa-4163-ad05-11d15ff2b4ed",
                                "sense_id": "fe27e37f-ee50-3917-82ed-03468f18044b",
                                "text": "Déracialiser la propriété des biens de production et des capitaux n'est pas en soi à condamner, mais cela ne transformera pas la société."
                            }
                        ]
                    }
