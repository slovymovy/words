                "senses": [
                    {
                        "sense_id": "e94fb8cf-48ea-3449-b604-9b940e8e3901",
                        "entry_id": "99566a9d-4a30-32e6-92e9-d64bc04e9533",
                        "glosses": [
                            "Débarrasser de l’influence d’Emmanuel Macron."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "d8544ec6-fe4f-4a93-8b7d-b99ec660e8b4",
                                "sense_id": "e94fb8cf-48ea-3449-b604-9b940e8e3901",
                                "text": "Comment \"démacroniser\" la droite \"macroniste\"?"
                            },
                            {
                                "example_id": "80091945-c93f-443f-bc9f-d7ad57dd0adf",
                                "sense_id": "e94fb8cf-48ea-3449-b604-9b940e8e3901",
                                "text": "La rédaction en est aujourd’hui convaincue, le chroniqueur de CNEWS, qui n'a pas répondu aux sollicitations de Marianne, et a été envoyé pour « démacroniser » et « droitiser » la ligne éditoriale du journal."
                            },
                            {
                                "example_id": "006322dc-3c1a-4eea-88c7-6d14636d79da",
                                "sense_id": "e94fb8cf-48ea-3449-b604-9b940e8e3901",
                                "text": "Éric Ciotti tente de se démacroniser auprès des adhérents Les Républicains"
                            }
                        ]
                    }
