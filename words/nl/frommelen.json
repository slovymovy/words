{
    "word_family": [
        "gefrommel",
        "frommel"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7098ebda-81f8-3b5d-84b9-ed13021ffac4",
                    "sense_definition": "Met de vingers kreukelen of onregelmatig vouwen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "kreukelen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je moet het papier niet zo <w>frommelen</w> voordat je het weggooit.",
                            "target_lang_translations": {
                                "en": "You shouldn't <w>crumple</w> the paper like that before throwing it away."
                            }
                        },
                        {
                            "text": "Hij zat zenuwachtig in zijn handen te <w>frommelen</w> tijdens het gesprek.",
                            "target_lang_translations": {
                                "en": "He was nervously <w>fumbling</w> with his hands during the conversation."
                            }
                        }
                    ],
                    "synonyms": [
                        "kreuken",
                        "verfomfaaien",
                        "friemelen",
                        "frunniken"
                    ],
                    "common_phrases": [
                        "in je hand frommelen",
                        "papier frommelen"
                    ],
                    "target_lang_definitions": {
                        "en": "To crumple, crease, or fold irregularly with the fingers"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "crumple",
                                "target_lang_sense_clarification": "to crush or crease paper or fabric"
                            },
                            {
                                "target_lang_word": "fumble",
                                "target_lang_sense_clarification": "to handle nervously or awkwardly with the fingers"
                            },
                            {
                                "target_lang_word": "fidget",
                                "target_lang_sense_clarification": "to play nervously with one's hands"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "22dabae4-60d3-3288-ac0a-e3476877401e",
                    "sense_definition": "Op een slordige of haastige manier iets ergens tussen of in stoppen",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "stoppen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij probeerde de brief snel in zijn zak te <w>frommelen</w>.",
                            "target_lang_translations": {
                                "en": "He tried to quickly <w>stuff</w> the letter into his pocket."
                            }
                        },
                        {
                            "text": "Zij wist haar kleren snel in de koffer te <w>frommelen</w>.",
                            "target_lang_translations": {
                                "en": "She managed to quickly <w>cram</w> her clothes into the suitcase."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ergens tussen frommelen",
                        "in je zak frommelen"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used in informal contexts to describe stuffing or squeezing something somewhere."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To stuff, cram, or squeeze something somewhere in a messy or hasty manner"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stuff",
                                "target_lang_sense_clarification": "to shove or cram something into a space"
                            },
                            {
                                "target_lang_word": "shove",
                                "target_lang_sense_clarification": "to push or put something somewhere roughly or quickly"
                            },
                            {
                                "target_lang_word": "cram",
                                "target_lang_sense_clarification": "to force or pack tightly into a small space"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}