                    {
                        "translation_id": "784ac67a-3254-4925-a6f4-e40ed8cbfc07",
                        "source_entry_id": "8dbf1b1d-9e7d-3d90-a339-2055f4537d4e",
                        "source_sense_id": "9707beda-ef38-3a09-bbb3-54114b75a71c",
