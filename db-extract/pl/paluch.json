                        "target_lang_word": "gros orteil",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gros orteil",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4c4b3de7-278e-3752-ad55-73b40e9f4712",
                                        "entry_id": "7428f057-5408-3f15-b403-ad733c350320",
                                        "glosses": [
                                            "Orteil de l’intérieur du pied. À la différence du pouce de la main, le gros orteil n’est pas opposable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b39c68ed-aebc-4d52-b287-7803aa548651",
                                                "sense_id": "4c4b3de7-278e-3752-ad55-73b40e9f4712",
                                                "text": "« Non, Monsieur, le donateur auquel fait allusion notre Mère n’est pas ce gentilhomme en rose ; il est là – le voyez-vous ? – vêtu de violet. Non, un peu plus bas… Là, vous y êtes, il prend appui sur le gros orteil de la Madone… Mais oui, c’est ce personnage crépu, au teint basané, aux lèvres charnues. »"
                                            },
                                            {
                                                "example_id": "5400e568-267f-4c39-8605-94da8e94d91d",
                                                "sense_id": "4c4b3de7-278e-3752-ad55-73b40e9f4712",
                                                "text": "Chaussettes de cachemire reprisées aux deux gros orteils."
                                            },
                                            {
                                                "example_id": "665edea7-12cb-40db-baa8-19478f1f68bf",
                                                "sense_id": "4c4b3de7-278e-3752-ad55-73b40e9f4712",
                                                "text": "Quel est donc ce piège si terrifiant qui explique qu’aucun syndicat n’ait osé mettre un gros orteil dans l’un des forums pour aller tester ce qui pourrait s’y passer?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
