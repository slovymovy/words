                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "6c978aaa-609d-3d75-b177-74fe719ec8a8",
                        "entry_id": "35b5e668-06d4-3bf5-aa45-47e989036415",
                        "glosses": [
                            "Bezeichnung für ein eingefangenes Wildtier"
                        ],
                        "tags": [
                            "Jägersprache"
                        ],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "aa3662bb-a1d4-3c48-bd29-effd7e161f10",
                        "entry_id": "35b5e668-06d4-3bf5-aa45-47e989036415",
                        "glosses": [
                            "Bezeichnung für ein lebhaftes, ausgelassenes Kind (früher insbesondere für Mädchen verwendet)"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "e56e0b45-c292-4d6b-a50f-bb07049af3d2",
                                "sense_id": "aa3662bb-a1d4-3c48-bd29-effd7e161f10",
                                "text": "Gisela ist ein richtiger Wildfang."
                            },
                            {
                                "example_id": "801d39d5-052d-465e-846e-41d5a482cb91",
                                "sense_id": "aa3662bb-a1d4-3c48-bd29-effd7e161f10",
                                "text": "„Sie war etwa neunzehn, ein Wildfang mit dicken Ringellocken, voll Vitalität.“"
                            },
                            {
                                "example_id": "875f325b-5a5b-4895-82d2-3e3cd1d91094",
                                "sense_id": "aa3662bb-a1d4-3c48-bd29-effd7e161f10",
                                "text": "„Meine Mutter war das Problemkind, ein Wildfang, trotzig und dickköpfig.“"
                            },
                            {
                                "example_id": "bc44f69b-0d87-4ac3-ba9b-1c1f79e00b37",
                                "sense_id": "aa3662bb-a1d4-3c48-bd29-effd7e161f10",
                                "text": "„Als Kind war sie ein rechter Wildfang, eine, die ohne Angst schien und ständig ihre Grenzen auslotete.“"
                            },
                            {
                                "example_id": "c64cacf2-7e26-49e7-9694-510ce11edfd0",
                                "sense_id": "aa3662bb-a1d4-3c48-bd29-effd7e161f10",
                                "text": "„Ich brachte etwa zwölf Tage in Nancy damit zu, dem jungen Wildfang Anweisungen zu geben und die Mutter zu überzeugen, daß sie sich damit begnügen müsse, die sehr untertänige Dienerin der Gräfin Lascaris zu sein.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c3ddf59d-7bd3-4fab-94ec-0c38dc8a3615",
                        "source_entry_id": "35b5e668-06d4-3bf5-aa45-47e989036415",
                        "source_sense_id": "aa3662bb-a1d4-3c48-bd29-effd7e161f10",
                        "target_lang_word": "tomboy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tomboy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "016e0118-85e6-3d44-bc13-f3eddae39ab3",
                                        "entry_id": "7ba2e5c1-7c82-3a6c-9713-695edd230e7d",
                                        "glosses": [
                                            "A girl who behaves in a typically boyish manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d9ebac60-c762-42db-afdd-fb3a17bc33a3",
                                                "sense_id": "016e0118-85e6-3d44-bc13-f3eddae39ab3",
                                                "text": "His sister, his dearest and only playmate, is a tomboy at heart."
                                            },
                                            {
                                                "example_id": "51116898-c3ab-42ba-9b4b-d2fc0c7ec747",
                                                "sense_id": "016e0118-85e6-3d44-bc13-f3eddae39ab3",
                                                "text": "“When you have a little girl like mine who is obsessed with the ocean and giant squids and insect infestations in homes, she’s considered weird or odd or a tomboy when in fact, science and things like that should be considered girly.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c6ffb7d7-46d5-3d8e-924d-fb7b1044deaa",
                                        "entry_id": "7ba2e5c1-7c82-3a6c-9713-695edd230e7d",
                                        "glosses": [
                                            "A rude, boisterous boy."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "df8eb43c-b6a3-39ea-a40d-bbd28a1471af",
                                        "entry_id": "7ba2e5c1-7c82-3a6c-9713-695edd230e7d",
                                        "glosses": [
                                            "An immodest or bold woman."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
