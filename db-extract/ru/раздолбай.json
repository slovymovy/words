                ],
                "senses": [
                    {
                        "sense_id": "b937c9b0-dbbb-34a1-b8e2-23baa6b57fbe",
                        "entry_id": "443306fb-492f-3e4b-a4aa-dd212b3f5a44",
                        "glosses": [
                            "жарг., бран. глупый, никчёмный человек, бездельник"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "02163b09-f2ec-44ef-9241-55445dad5945",
                                "sense_id": "b937c9b0-dbbb-34a1-b8e2-23baa6b57fbe",
                                "text": "Сюжет повести таков: двое русских раздолбаев отправляются в Лондон, не имея денег на жизнь, и обитают там, воруя в магазинах, ночуя в аэропорту Хитроу, проделывая ради некоторых сумм ряд комбинаций, противоречащих букве британского закона. Ольга Славникова"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "68b98526-461e-4c6e-862d-5ad1e912a866",
                        "source_entry_id": "443306fb-492f-3e4b-a4aa-dd212b3f5a44",
                        "source_sense_id": "b937c9b0-dbbb-34a1-b8e2-23baa6b57fbe",
                        "target_lang_word": "no-account",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "no-account",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "58184943-e5a2-3780-b932-f29371bef290",
                                        "entry_id": "ff646e46-f6bb-30fa-aa04-cfee6bee6a02",
                                        "glosses": [
                                            "Of no value or merit; good-for-nothing; of no account."
                                        ],
                                        "tags": [
                                            "British",
                                            "US",
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2778f8f9-0aab-4940-b1da-b95182fcff8d",
                                                "sense_id": "58184943-e5a2-3780-b932-f29371bef290",
                                                "text": "\"There are ten or fifteen hound-dogs around the yard, and they are actually too no-account to scratch the fleas off.\""
                                            },
                                            {
                                                "example_id": "823f3b32-0de1-4273-8393-056bbd71faf8",
                                                "sense_id": "58184943-e5a2-3780-b932-f29371bef290",
                                                "text": "\"Well, I'm sorry to have had to be the one to give you the bad news,\" he says.\nWhat bad news would that be? I'm wondering. That's just one more no-account Carter for me not to have to think on."
                                            },
                                            {
                                                "example_id": "fa833fea-bc2f-4190-a6ca-463859228847",
                                                "sense_id": "58184943-e5a2-3780-b932-f29371bef290",
                                                "text": "You see, corporal, the human race is getting worse all the time. Each year we know less than we did in the preceding. We're more no-account now than we were five hundred years ago."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "75fc99de-7de3-4984-b7b4-44c8ad4db639",
                        "source_entry_id": "443306fb-492f-3e4b-a4aa-dd212b3f5a44",
                        "source_sense_id": "b937c9b0-dbbb-34a1-b8e2-23baa6b57fbe",
