                        "entry_id": "6d0cfeb2-3e99-37f1-8c0a-9308ab3f3286",
                        "glosses": [
                            "A nocturnal, insectivorous mammal, Proteles cristatus, of southern and eastern Africa, related to and resembling the hyena."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0b9d676-cbda-4af7-9d6b-7866b9f1587a",
                                "sense_id": "330786d3-a72d-3b9e-bcab-ff5a4481ab47",
                                "text": "Today the only dog-like hyena is Africa’s termite-eating aardwolf."
                            }
                        ]
                    }
