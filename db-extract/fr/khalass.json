                            {
                                "example_id": "0043ab67-5526-4bef-9c3b-e7ad3475b6f0",
                                "sense_id": "de3ccca8-cad6-3085-b03b-ed2fe99e99e4",
                                "text": "Ça va khalass du côté des Pelicans, mais on dit oui tous les jours vu la gueule du projet qui nous donne plus qu’envie de démarrer la saison."
                            },
                            {
                                "example_id": "8d9c4ac3-e2d0-4f72-91e7-5ee9c9ae756d",
                                "sense_id": "de3ccca8-cad6-3085-b03b-ed2fe99e99e4",
                                "text": "Clairement que je vais khalass j’attends que ça baisse encore. référence nécessaire (résoudre le problème)"
                            },
                            {
                                "example_id": "d7eef0ab-564d-4878-b655-c4dd590b4fcb",
                                "sense_id": "de3ccca8-cad6-3085-b03b-ed2fe99e99e4",
                                "text": "Je vais khalass les potes vous inquiétez pas référence nécessaire (résoudre le problème)"
                            }
                        ]
                    }
