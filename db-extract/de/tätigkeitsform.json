                                "target_senses": [
                                    {
                                        "sense_id": "83fe0d18-1b21-3dc6-ab11-7ed14cd53672",
                                        "entry_id": "221bcb71-33a3-3c4e-889d-a6a73225d115",
                                        "glosses": [
                                            "A person or thing that is acting or capable of acting."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8583804c-6dd1-4506-8436-6be1212056d5",
                                                "sense_id": "83fe0d18-1b21-3dc6-ab11-7ed14cd53672",
                                                "text": "\"Alumni could become more active in giving guidance and leadership to students. They act as sort of a 'maturity governor' on fraternities,\" notes Ratliff, citing surveys suggesting that fraternity actives presume mistakenly that alumni want hazing […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "366ef85d-40b1-3a52-8364-611dc54157c9",
                                        "entry_id": "221bcb71-33a3-3c4e-889d-a6a73225d115",
                                        "glosses": [
                                            "Any component that is not passive. See Passivity (engineering)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5025627-a088-4f4c-8576-ea93bc462643",
                                                "sense_id": "366ef85d-40b1-3a52-8364-611dc54157c9",
                                                "text": "Components are split into two broad segments: actives and passives. Active components like the vacuum tube and the transistor contain the power to generate and alter electrical signals."
                                            }
                                        ]
                                    }
                                ]
                            }
