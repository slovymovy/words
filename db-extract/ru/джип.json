                                "target_senses": [
                                    {
                                        "sense_id": "07dd1038-b339-356f-8e7a-e5a689233626",
                                        "entry_id": "633a15c4-7473-3462-99b4-737195218786",
                                        "glosses": [
                                            "ein geländegängiger Kraftwagen mit Allradantrieb"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43b10758-ce9a-41f9-8f42-ed8473618e4d",
                                                "sense_id": "07dd1038-b339-356f-8e7a-e5a689233626",
                                                "text": "Ich hab mir im Urlaub extra einen Jeep gemietet, um abseits der normalen Straßen fahren zu können."
                                            },
                                            {
                                                "example_id": "f330ba10-cb6d-4c09-8574-a2820b4d9edc",
                                                "sense_id": "07dd1038-b339-356f-8e7a-e5a689233626",
                                                "text": "„Die fünf CIA-Agenten, die auf Sumatra dabei gewesen waren, machten sich Hals über Kopf mit einem Jeep Richtung Süden aus dem Staub.“"
                                            },
                                            {
                                                "example_id": "ba81fe8f-2241-4f0b-b1ba-fac7282cdab0",
                                                "sense_id": "07dd1038-b339-356f-8e7a-e5a689233626",
                                                "text": "„Anfangs war es eine Qual, den Jeep zu fahren - der einzige Nachteil an ihm.“"
                                            },
                                            {
                                                "example_id": "c68fd3d9-9682-4a81-9c8f-84dde58e860a",
                                                "sense_id": "07dd1038-b339-356f-8e7a-e5a689233626",
                                                "text": "„Ich verließ meinen Jeep, zog meine Schuhe aus, wusch meine Plattfüße im Suezkanal, ging dann zurück, stieg in meinen Jeep.“"
                                            },
                                            {
                                                "example_id": "d19fbedf-2a85-4d20-83ca-feb2f28c1f4e",
                                                "sense_id": "07dd1038-b339-356f-8e7a-e5a689233626",
                                                "text": "„Sie parkten den Jeep vor der Jagdhütte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "92846393-650a-38b7-90f9-ffc0a2955d96",
                                        "entry_id": "633a15c4-7473-3462-99b4-737195218786",
