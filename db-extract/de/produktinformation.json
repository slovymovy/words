                ],
                "senses": [
                    {
                        "sense_id": "c0844f63-ab8b-3eec-8987-7477117dd670",
                        "entry_id": "e1f6a334-0c8d-3b73-9cb1-02dcb871acd4",
                        "glosses": [
                            "Angaben, die die wesentlichen Eigenschaften, Nutzungshinweise und weitere relevante Aspekte eines Produkts beschreiben"
                        ],
                        "tags": [
                            "plural",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "61779478-17f4-451c-bd0f-f3ade082f619",
                                "sense_id": "c0844f63-ab8b-3eec-8987-7477117dd670",
                                "text": "„Unternehmen nutzen X (ehemals Twitter), um Produktinformationen bereitzustellen und mit ihren Kunden zu kommunizieren.“"
                            },
                            {
                                "example_id": "a9bd8c9b-ad75-469f-bd02-023b5c7e3fea",
                                "sense_id": "c0844f63-ab8b-3eec-8987-7477117dd670",
                                "text": "„Die entsprechenden Produktinformationen (Produktbild, Preis, Bezeichnung und weitere Angaben) müssen vom Werbetreibenden in Daten-Feeds bei Google hinterlegt werden.“"
                            },
                            {
                                "example_id": "12c12c9f-9e3a-44d6-868f-cbd7f29e879a",
                                "sense_id": "c0844f63-ab8b-3eec-8987-7477117dd670",
                                "text": "„Daraufhin ordneten die europäische und die französische Behörde die Aufnahme eines entsprechenden Warnhinweises in die Produktinformation an.“"
                            },
                            {
                                "example_id": "88a8f410-2d24-4920-89f2-b48ed056860d",
                                "sense_id": "c0844f63-ab8b-3eec-8987-7477117dd670",
                                "text": "„Vergleichsportale mit großer Reichweite werden mittlerweile im Rahmen von Suchmaschinenmarketing-Aktivitäten automatisiert mit Produktinformationen versorgt.“"
                            },
                            {
                                "example_id": "2a516985-1395-429a-b6e1-a41e8056118d",
                                "sense_id": "c0844f63-ab8b-3eec-8987-7477117dd670",
                                "text": "„Die Banderolen können mit Produktinformationen, Mengen- oder Preisangaben, Strich- oder QR-Codes und Ähnlichem bedruckt sein.“"
                            },
                            {
                                "example_id": "bad59b7c-f7f6-45ff-b3e9-82a9c068d3ad",
                                "sense_id": "c0844f63-ab8b-3eec-8987-7477117dd670",
                                "text": "„Gerade bei tierischen Produkten müssen sich Verbraucherinnen und Verbraucher außerdem auf Produktinformationen verlassen können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
