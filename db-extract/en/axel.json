                                "target_senses": [
                                    {
                                        "sense_id": "726359bb-0179-3118-a3a9-45a53af4b13a",
                                        "entry_id": "af69f3c9-4676-34bc-903d-f73e81542e6f",
                                        "glosses": [
                                            "Prénom masculin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "182a84f5-3f74-4d99-b293-052cffb78853",
                                                "sense_id": "726359bb-0179-3118-a3a9-45a53af4b13a",
                                                "text": "Dylan Groenewegen s’est imposé hier lors de la deuxième étape de l’Arctic Race, la course la plus septentrionale du monde, le Français Axel Zingle conservant son maillot de leader."
                                            },
                                            {
                                                "example_id": "26b14843-e1c9-4c92-8dc5-f1a5b1085648",
                                                "sense_id": "726359bb-0179-3118-a3a9-45a53af4b13a",
                                                "text": "« C’est du jamais vu », se félicite Axel Dauchez, président de Make.org, qui héberge la consultation."
                                            },
                                            {
                                                "example_id": "5f2b182e-a3ec-4878-a69c-796662e77286",
                                                "sense_id": "726359bb-0179-3118-a3a9-45a53af4b13a",
                                                "text": "On se souvient d’Axel Disasi qui affirmait en début de Mondial n’être pas venu pour « profiter du soleil »."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Axel",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2f2486c6-feb8-373e-be26-05582ec996af",
                                        "entry_id": "6dec141b-ec42-3be7-9e13-682a014c3083",
                                        "glosses": [
                                            "Nom donné par la marque automobile Citroën à un modèle de petite berline importé de Roumanie de 1984 à 1988."
                                        ],
                                        "tags": [
                                            "Marque commerciale"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "80dacba9-ffe4-479c-9876-dbea10253d4a",
                                                "sense_id": "2f2486c6-feb8-373e-be26-05582ec996af",
                                                "text": "Puis, plus tard, sous l’aile protectrice du grand frère Peugeot qui s’est offert la marque en 1974, sortiront quelques ratés et avortons consanguins qui ont pour noms LN ou Axel et qu’il vaut mieux oublier."
                                            },
                                            {
                                                "example_id": "7c880672-f348-42f1-8eed-0b321e6af43e",
                                                "sense_id": "2f2486c6-feb8-373e-be26-05582ec996af",
                                                "text": "Elle a surtout construit en Roumanie une usine de montage pour les Axel, des dérivées du prototype Y refusé par Peugeot en 1974."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Axel",
                                "target_lang_code": "fr",
                                "target_senses": [
