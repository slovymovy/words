                        "sense_id": "6c964187-9a5b-3cf4-9fc8-9b2c95bf6658",
                        "entry_id": "97a998e5-68e7-3ac7-9823-4a43e8b13f72",
                        "glosses": [
                            "Personne malhonnête."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "20c7eed0-c4cf-4f64-a90f-4123139948b1",
                                "sense_id": "6c964187-9a5b-3cf4-9fc8-9b2c95bf6658",
                                "text": "Fandor s’est conduit comme un polisson et m’a fait soupçonner d’indiscrétion notoire."
                            },
                            {
                                "example_id": "32596826-1f8c-4f07-9294-9faf3808a722",
                                "sense_id": "6c964187-9a5b-3cf4-9fc8-9b2c95bf6658",
                                "text": "Douze mille francs de dettes ? Tu diras de ma part à ton client que c’est un polisson…"
                            }
                        ]
                    },
                    {
                        "sense_id": "9b385876-f6b2-3da2-85e9-73afdcd00d93",
                        "entry_id": "97a998e5-68e7-3ac7-9823-4a43e8b13f72",
                        "glosses": [
                            "Enfant mal élevé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "04ecb6f7-4abf-4398-ac10-f0154119dd9b",
                                "sense_id": "9b385876-f6b2-3da2-85e9-73afdcd00d93",
                                "text": "Il ne faut pas croire, en effet, que l’histoire ait attendu ces derniers temps pour savoir que ce furent de simples polissons qui méritaient la fessée et qui avaient reçu par hasard un coup de fusil."
                            }
                        ]
                    },
                    {
                        "sense_id": "cb91129d-397c-354d-b0d4-92cee1f4b199",
                        "entry_id": "97a998e5-68e7-3ac7-9823-4a43e8b13f72",
                        "glosses": [
                            "Personne grivoise."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b1f894e-3e40-4fcd-bd2b-2ccd2d00cba7",
                                "sense_id": "cb91129d-397c-354d-b0d4-92cee1f4b199",
                                "text": "— Monsieur, lui dit-il, j'ai vu ce que vous avez fait... Vous venez de vous conduire comme un polisson..."
                            },
                            {
                                "example_id": "4589538c-6c4f-4aa3-8b13-dea3530dc877",
                                "sense_id": "cb91129d-397c-354d-b0d4-92cee1f4b199",
                                "text": "Vatelin. — C’est-à-dire qu’un mari ne peut plus laisser sortir sa femme sans l’exposer aux impertinences d’un polisson !…"
                            }
                        ]
                    },
                    {
                        "sense_id": "3e3ddf61-54a2-3743-a508-5c4d90722055",
                        "entry_id": "97a998e5-68e7-3ac7-9823-4a43e8b13f72",
                        "glosses": [
                            "Pièce de grosse toile que les femmes ajoutaient à leur ceinture pour augmenter l’ampleur des reins"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b3c55f3-61c8-4394-922b-167146de888c",
                                "sense_id": "3e3ddf61-54a2-3743-a508-5c4d90722055",
                                "text": "Vous l’adorez pour le corset qui lui fait un sein admirable, pour le polisson (c’est un mot de vous) qui lui prête une croupe andalouse; vous vous passionnez pour sa taille roulée comme un saucisson ficelé. Vous n’aimez plus les femmes, mon maître; vous aimez le caoutchouc, l’empois et le coton."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3af9d203-69b5-4d60-9fd0-55bc259b4615",
                        "source_entry_id": "97a998e5-68e7-3ac7-9823-4a43e8b13f72",
                        "target_lang_word": "проказник",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "проказник",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "17bc6f5e-787a-3ef1-b89f-8bf4eaa99d20",
                                        "entry_id": "1dd56ffc-5270-3688-a745-65ea2d6471c6",
                                        "glosses": [
                                            "тот, кто шалит, проказничает"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "627ee5e6-1df2-40bc-bd13-0dee43edb451",
                                                "sense_id": "17bc6f5e-787a-3ef1-b89f-8bf4eaa99d20",
                                                "text": "Почивал наш герой весьма нехорошо, то есть никак не мог даже на пять минут заснуть совершенно: словно проказник какой-нибудь насыпал ему резаной щетины в постель."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
