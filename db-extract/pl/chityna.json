                "translations": [
                    {
                        "translation_id": "534aea20-3a47-4238-888a-9856b977bfc4",
                        "source_entry_id": "49e801f3-3d7d-3cb5-87c7-dfc9820d1d60",
                        "source_sense_id": "02b9f8d2-2981-3ca8-b638-306f37e80410",
                        "target_lang_word": "chitin",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chitin",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "314329ef-039f-31a9-b81b-df0ee41dde33",
                                        "entry_id": "f1154d10-7c1d-38c7-b59b-058a6d0707a8",
                                        "glosses": [
                                            "A complex polysaccharide, a polymer of N-acetylglucosamine, found in the exoskeletons of arthropods and in the cell walls of fungi; thought to be responsible for some forms of asthma in humans."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2abf7f69-701f-4340-b10f-0a1f12c0558b",
                                                "sense_id": "314329ef-039f-31a9-b81b-df0ee41dde33",
                                                "text": "Chitin usually occurs throughout Invertebrates in the form of an investment to the outermost cellular layer or ectoderm."
                                            },
                                            {
                                                "example_id": "177173ec-164e-43f9-8476-00b07405e24c",
                                                "sense_id": "314329ef-039f-31a9-b81b-df0ee41dde33",
                                                "text": "The robot’s energy source is the sugar in the polysaccharide called chitin that makes up a fly’s exoskeleton."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c5e334f3-440a-4019-b319-99d66cb73160",
                        "source_entry_id": "49e801f3-3d7d-3cb5-87c7-dfc9820d1d60",
                        "source_sense_id": "02b9f8d2-2981-3ca8-b638-306f37e80410",
                        "target_lang_word": "chitin",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chitin",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "82d4a724-c71b-3c03-b998-6881a4ea7001",
                                        "entry_id": "affd5283-8da3-3f2a-a329-f6ca7b004d90",
                                        "glosses": [
                                            "pevná poloprůsvitná organická látka, ze které je vytvořena vnější kostra hmyzu a dalších členovců"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1a501b11-53a7-46e6-aaa4-f750acce632f",
                        "source_entry_id": "49e801f3-3d7d-3cb5-87c7-dfc9820d1d60",
                        "source_sense_id": "02b9f8d2-2981-3ca8-b638-306f37e80410",
                        "target_lang_word": "chitine",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chitine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b60a0c58-5c08-3b0c-bd3a-e408fafaea03",
                                        "entry_id": "8abb9bc9-af5c-302f-aed0-ff24235e94eb",
                                        "glosses": [
                                            "Principal composant de l'exosquelette des arthropodes, présent aussi chez certains champignons et lichens."
                                        ],
                                        "tags": [
                                            "Biologie cellulaire"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "884136db-0a94-40d7-be49-4f0f20ec8522",
                                                "sense_id": "b60a0c58-5c08-3b0c-bd3a-e408fafaea03",
                                                "text": "La morphologie de ses cellules à paroi est identique à celle des végétaux, mais composée de chitine propre aux animaux à carapace."
                                            },
                                            {
                                                "example_id": "039433ed-0d3a-47d9-9653-844ec2fbffdf",
                                                "sense_id": "b60a0c58-5c08-3b0c-bd3a-e408fafaea03",
                                                "text": "Un des caractères importants qui le distingue des végétaux est la composition des ses parois cellulaires, faites en majeure partie de chitine, une chitine proche de celle des Arthropodes."
                                            },
                                            {
                                                "example_id": "013fa499-a225-4b57-97ee-4343cedc27f4",
                                                "sense_id": "b60a0c58-5c08-3b0c-bd3a-e408fafaea03",
                                                "text": "En commençant par une utile mise en garde : les insectes provoquent les mêmes allergies que les crustacés, mollusques, araignées, acariens… du fait qu’ils contiennent de la chitine. — (« Insectes : On fait la fine mouche », Malbouffe, le dico, Les Dossiers du Canard enchaîné nᵒ 147, avril 2018, page 42)"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7d5df9b0-8230-40ef-9ccb-939752f79ffd",
                        "source_entry_id": "49e801f3-3d7d-3cb5-87c7-dfc9820d1d60",
                        "source_sense_id": "02b9f8d2-2981-3ca8-b638-306f37e80410",
                        "target_lang_word": "Chitin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Chitin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3efe7d22-ff40-3805-8bc6-4d1571e8f7ca",
                                        "entry_id": "3f6aa55f-3caa-379b-8005-5f1b40315734",
                                        "glosses": [
                                            "stickstoffhaltiges Polysaccharid, das den organischen Hauptbestandteil des Außenskelettes der Gliederfüßer bildet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d547fcd6-ed10-468e-ac94-9f880e1fbb88",
                                                "sense_id": "3efe7d22-ff40-3805-8bc6-4d1571e8f7ca",
                                                "text": "Chitin kommt auch in den Zellwänden von Pilzen vor."
                                            },
                                            {
                                                "example_id": "1481230e-c198-46e3-bf08-1978f5874a16",
                                                "sense_id": "3efe7d22-ff40-3805-8bc6-4d1571e8f7ca",
                                                "text": "[Pilze:] „Während die Zellwände von Pflanzen überwiegend aus Zellulose bestehen, enthalten Pilzzellwände Chitin, einen Stoff, der auch im Exoskelett von Insekten und Krebstieren vorkommt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0bcbebf6-c24e-4d24-bb0d-892a4431f40d",
                        "source_entry_id": "49e801f3-3d7d-3cb5-87c7-dfc9820d1d60",
                        "source_sense_id": "02b9f8d2-2981-3ca8-b638-306f37e80410",
                        "target_lang_word": "хитин",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "хитин",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "cdbe68be-ea26-3763-bf12-e5b3ab178e4d",
                                        "entry_id": "96c49975-0f7d-3530-b088-76cd28ad7a50",
                                        "glosses": [
                                            "биол., хим. органическое вещество, из которого состоит наружный твёрдый покров ракообразных, насекомых и других членистоногих, а также содержащееся в оболочках ряда грибов и некоторых видов зелёных водорослей"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "987d68d8-8c42-413b-8ea3-0d32b4a823e1",
                                                "sense_id": "cdbe68be-ea26-3763-bf12-e5b3ab178e4d",
                                                "text": "Многие насекомые способны жить в очень твёрдой среде и одновременно ею же подкармливаться. Их тела покрыты оболочкой из плотного вещества — хитина, которая защищает насекомое от различных неблагоприятных воздействий."
                                            },
                                            {
                                                "example_id": "373d1c24-034a-4510-a360-d75fd6171c74",
                                                "sense_id": "cdbe68be-ea26-3763-bf12-e5b3ab178e4d",
                                                "text": "Таракана мы словили хорошего — большого, рыжего, усатого. Он стал бегать по стенкам банки, доползать до крыши и падать с сухим шлепком вниз. — Убьётся! — испугался Коля. — Не убьётся, — сказал я. — У них спина из хитина — пружинит."
                                            },
                                            {
                                                "example_id": "9e4105f1-508d-42ab-b584-00264a7f728c",
                                                "sense_id": "cdbe68be-ea26-3763-bf12-e5b3ab178e4d",
                                                "text": ".. грибы являются трудноперевариваемым продуктом, в них много грибной клетчатки — хитина."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
