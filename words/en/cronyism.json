    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "41717d33-fb1b-3710-be5b-2c616224ad84",
                    "sense_definition": "The practice of partiality in bestowing jobs and other advantages to close friends or associates, especially regardless of their qualifications.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "favoritism",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mayor faced accusations of <w>cronyism</w> after appointing his closest friend as chief of police."
                        },
                        {
                            "text": "Public trust fell when political <w>cronyism</w> led to the mismanagement of government contracts."
                        }
                    ],
                    "synonyms": [
                        "wasta"
                    ],
                    "common_phrases": [
                        "political cronyism",
                        "accusations of cronyism",
                        "cronyism and nepotism"
                    ]
                },
                {
                    "sense_id": "9e7f90bc-5122-31d4-a610-6f12fad3f0d2",
                    "sense_definition": "A state or feeling of intimate friendship or mutual familiarity; comradeship.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "friendship",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The two companions spent the evening talking together in a state of easy <w>cronyism</w>."
                        },
                        {
                            "text": "Their natural <w>cronyism</w> made living together during the long winter bearable."
                        }
                    ],
                    "synonyms": [
                        "cronydom"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rarely used today in the benign sense of friendship"
                        }
                    ]
                }
            ]
        }
    ]
