                "senses": [
                    {
                        "sense_id": "87795ba5-cef4-3c4b-8e5f-576e8304fa63",
                        "entry_id": "7ecc681f-1ab3-327f-9e2a-12f637d75eaf",
                        "glosses": [
                            "endless"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f6d3bccd-30c4-4b0a-a3b5-5101caef713f",
                                "sense_id": "87795ba5-cef4-3c4b-8e5f-576e8304fa63",
                                "text": "Het uitzicht over de oceaan leek eindeloos te zijn.",
                                "translation": "The view over the ocean seemed endless.",
                                "english": "The view over the ocean seemed endless."
                            },
                            {
                                "example_id": "c28c0e65-963b-4aa8-a368-2ef6dc485039",
                                "sense_id": "87795ba5-cef4-3c4b-8e5f-576e8304fa63",
                                "text": "Na een lange wandeling waren er nog eindeloze paden te verkennen.",
                                "translation": "After a long hike, there were still endless trails to explore.",
                                "english": "After a long hike, there were still endless trails to explore."
                            },
                            {
                                "example_id": "35817ff3-db82-4832-a959-bdaf21a008ee",
                                "sense_id": "87795ba5-cef4-3c4b-8e5f-576e8304fa63",
                                "text": "Het gesprek ging door met een eindeloze stroom van vragen en antwoorden.",
                                "translation": "The conversation continued with an endless flow of questions and answers.",
                                "english": "The conversation continued with an endless flow of questions and answers."
                            },
                            {
                                "example_id": "f00f9489-d5ac-4cfc-b9ed-5cb86da26266",
                                "sense_id": "87795ba5-cef4-3c4b-8e5f-576e8304fa63",
                                "text": "De reis door de woestijn leek een eindeloze ervaring.",
                                "translation": "The journey through the desert felt like an endless experience.",
                                "english": "The journey through the desert felt like an endless experience."
                            }
                        ]
                    }
                ],
