                                                "sense_id": "999783db-a3d6-34e3-8fe3-378394b91c0c",
                                                "text": "„Frankreichbücher sind in Deutschland immer wieder Bestseller geworden.“"
                                            },
                                            {
                                                "example_id": "81282dc2-2c65-49c9-8501-30cf773a0985",
                                                "sense_id": "999783db-a3d6-34e3-8fe3-378394b91c0c",
                                                "text": "„Und anders als die Berichte von Afrikareisenden wie Mungo Park wird sein Werk kein Bestseller.“"
                                            },
                                            {
                                                "example_id": "bf226afb-fc41-49da-acec-25a0c2f300ae",
                                                "sense_id": "999783db-a3d6-34e3-8fe3-378394b91c0c",
                                                "text": "„Der Titel selbst kam nie auch nur in die Nähe eines Bestsellers.“"
                                            }
