                ],
                "senses": [
                    {
                        "sense_id": "538ea4bc-ef9a-3d38-83f2-e0ee2c759054",
                        "entry_id": "95e75ad4-f3da-31f9-8715-8dcb43dad88b",
                        "glosses": [
                            "Ameublir ; rendre meuble."
                        ],
                        "tags": [
                            "Très rare"
                        ],
                        "examples": [
                            {
                                "example_id": "90449861-3568-4292-9013-c339ed7ff8c6",
                                "sense_id": "538ea4bc-ef9a-3d38-83f2-e0ee2c759054",
                                "text": "Ces opérations, très propres à meublir, nettoyer et améliorer la terre , consistent dans trois sarclages et buttages qui doivent se faire […]."
                            },
                            {
                                "example_id": "6e4267db-6da5-4b56-a77a-d7b1cf4d225c",
                                "sense_id": "538ea4bc-ef9a-3d38-83f2-e0ee2c759054",
                                "text": "On donne successivement deux labours légers destinés à meublir et aérer la terre ; un troisième, plus profond, sert quelquefois en même temps à ouvrir les tranchées pour déposer les tubercules […]."
                            },
                            {
                                "example_id": "6b0808a3-5689-4526-9307-1687e5b50327",
                                "sense_id": "538ea4bc-ef9a-3d38-83f2-e0ee2c759054",
                                "text": "Quand on l'emploie avant la semaille, quelques jours avant l'épandage on donne un labour suivi d'un hersage pour bien meublir le sol."
                            },
                            {
                                "example_id": "86c2cf0f-8384-40ca-8ace-d4fb0434253f",
                                "sense_id": "538ea4bc-ef9a-3d38-83f2-e0ee2c759054",
                                "text": "Le labour, opération sur le sol, contribue à meublir la partie supérieure du sol. Le labour, par le renversement et le brassage des horizons supérieurs, tend à créer la couche arable proprement dite."
                            }
                        ]
                    }
                ],
