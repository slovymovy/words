                "senses": [
                    {
                        "sense_id": "437f351e-1b02-363a-b5c2-1125f6bbff81",
                        "entry_id": "4cd71867-f035-321b-9bbb-c5922104a7ad",
                        "glosses": [
                            "osoba, która nakłania lub pobudza kogoś do zrobienia czegoś złego"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ce54e07-38fa-41f6-9e89-4d73853502c4",
                                "sense_id": "437f351e-1b02-363a-b5c2-1125f6bbff81",
                                "text": "W poniedziałek nakazał wzmocnienie policji w „trudnych” miejscowościach i skierowanie tam funkcjonariuszy w cywilu, aby zidentyfikowali podżegaczy do zamieszek."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2a37d912-539f-44ef-b34f-9e2eedba116d",
                        "source_entry_id": "4cd71867-f035-321b-9bbb-c5922104a7ad",
                        "source_sense_id": "437f351e-1b02-363a-b5c2-1125f6bbff81",
                        "target_lang_word": "instigateur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "instigateur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "aaeca311-00d5-333a-9002-f69a56e184bf",
                                        "entry_id": "629a7258-1ef7-3177-af97-2ccc8caea46d",
                                        "glosses": [
                                            "Personne qui incite ou qui pousse à faire quelque chose."
                                        ],
                                        "tags": [],
                                        "note": "Il se prend le plus souvent en mauvaise part",
                                        "examples": [
                                            {
                                                "example_id": "25fcfad9-3f63-4690-998a-bccd6071075d",
                                                "sense_id": "aaeca311-00d5-333a-9002-f69a56e184bf",
                                                "text": "Je croyais ce secret enseveli dans mon propre sein et dans celui d’une femme, l’instigatrice, la complice de mon crime."
                                            },
                                            {
                                                "example_id": "ba81c511-13c3-4218-bd20-ec9984f1a401",
                                                "sense_id": "aaeca311-00d5-333a-9002-f69a56e184bf",
                                                "text": "[…], tout concourait en même temps pour préparer la chute de la branche aînée des Bourbons; mais, de la probabilité à l'accomplissement du fait, il y avait loin , et l'on ne peut disconvenir que M. Thiers et tous les instigateurs du mouvement ne jouassent gros jeu."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
