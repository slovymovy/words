                "senses": [
                    {
                        "sense_id": "0d5c3601-1668-3bdd-acd0-06ef16c6d94d",
                        "entry_id": "f33aad9a-3126-3ff0-b82a-218b76c402c8",
                        "glosses": [
                            "Leiter eines Zirkus"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b55688b3-fcee-419a-a91b-4d37f00def43",
                                "sense_id": "0d5c3601-1668-3bdd-acd0-06ef16c6d94d",
                                "text": "Der Zirkusdirektor begrüßte die Zuschauer und stimmte sie auf die Show ein."
                            },
                            {
                                "example_id": "986e6e43-58e5-45a7-855a-1cc8bef08ce1",
                                "sense_id": "0d5c3601-1668-3bdd-acd0-06ef16c6d94d",
                                "text": "„Der Zirkusdirektor kam in die Mitte der Manege.“"
                            },
                            {
                                "example_id": "e8e60ed5-f5bf-439a-abba-dd3d1aa5bff5",
                                "sense_id": "0d5c3601-1668-3bdd-acd0-06ef16c6d94d",
                                "text": "„Zum Zirkusdirektor kommt ein kleiner, unscheinbarer Mann.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
