                "entry_id": "ec899e2a-9ed0-3f15-b680-632d3386961c",
                "word": "condyle",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "c24d1cd8-609a-4ac5-ac1c-d87d41624441",
                        "entry_id": "ec899e2a-9ed0-3f15-b680-632d3386961c",
                        "tags": [
                            "plural"
                        ],
                        "form": "condyles"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "eab672ed-29bf-3feb-b3b3-7dc955c3ddea",
                        "entry_id": "ec899e2a-9ed0-3f15-b680-632d3386961c",
                        "glosses": [
                            "A smooth prominence on a bone where it forms a joint with another bone."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b12ebd68-5af1-4a29-9a8d-9fa90d98c67b",
                                "sense_id": "eab672ed-29bf-3feb-b3b3-7dc955c3ddea",
                                "text": "“It's the upper condyle of a human femur,” said I."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d2b29d77-f3b6-43b2-8358-3d61818f6598",
                        "source_entry_id": "ec899e2a-9ed0-3f15-b680-632d3386961c",
                        "source_sense_id": "eab672ed-29bf-3feb-b3b3-7dc955c3ddea",
                        "source_sense_description": "prominence on a bone",
                        "target_lang_word": "condyle",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "condyle",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "190614c6-5473-3b64-862d-12624c777f92",
                                        "entry_id": "cbb4ca30-df21-3037-8c35-e8d3f2a46eed",
                                        "glosses": [
                                            "Tête articulaire d'un os, proéminente et arrondie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "76acfef0-a87d-4f47-8542-7200126767ba",
                                                "sense_id": "190614c6-5473-3b64-862d-12624c777f92",
                                                "text": "Le condyle externe et le condyle interne du fémur."
                                            },
                                            {
                                                "example_id": "8a38dc59-fb69-43a7-b0c5-bb4315cfa95d",
                                                "sense_id": "190614c6-5473-3b64-862d-12624c777f92",
                                                "text": "Le condyle de l'humérus ou capitulum."
                                            },
                                            {
                                                "example_id": "2d97f158-cbf1-4060-bb21-9a63a59a9ba2",
                                                "sense_id": "190614c6-5473-3b64-862d-12624c777f92",
                                                "text": "Les condyles de la mâchoire, etc."
                                            },
                                            {
                                                "example_id": "665366d5-db49-47de-a1aa-df5e296a6597",
                                                "sense_id": "190614c6-5473-3b64-862d-12624c777f92",
                                                "text": "Pour l’anatomiste, il n’existe qu’un condyle au coude : c’est la voussure arrondie qui fait face à la cupule radiale, comme la trochlée fait face aux surfaces articulaires cubitales."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7364b4c1-205e-40c9-8367-78f387f7ecf3",
                        "source_entry_id": "ec899e2a-9ed0-3f15-b680-632d3386961c",
                        "source_sense_id": "eab672ed-29bf-3feb-b3b3-7dc955c3ddea",
