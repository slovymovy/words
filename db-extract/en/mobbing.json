                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "37bac94e-87ea-365e-be7e-32129cdb377e",
                        "entry_id": "90b43765-b01e-3b7d-86be-5df5ee032d31",
                        "glosses": [
                            "Group bullying."
