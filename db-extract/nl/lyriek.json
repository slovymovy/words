                                                "sense_id": "bea4a780-605a-3407-91aa-43a681b9148b",
                                                "text": "Épica y teatro son formas en las cuales el hombre se reconoce como colectividad o comunidad, en tanto que en la lírica se ve como individuo"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
