                    }
                ],
                "senses": [
                    {
                        "sense_id": "3859e202-dd3c-3921-8c4a-6c38c42b8282",
                        "entry_id": "d560f39f-b829-3082-b409-7078ccda6d11",
                        "glosses": [
                            "Fabricant de table d'harmonie pour les instruments de musique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ccc93f12-ea8c-4c0c-9d52-96c274f523f8",
                                "sense_id": "3859e202-dd3c-3921-8c4a-6c38c42b8282",
                                "text": "Un tel assemblage demande une singulière connaissance des bois et beaucoup d'habileté dans leur disposition : aussi un bon tableur est-il un ouvrier rare, et un piano a déjà plus d'une chance d'être bon quand il arrive muni d'une excellente table d'harmonie dans le troisième atelier où nous allons le suivre."
                            }
                        ]
                    },
                    {
                        "sense_id": "75204a54-35d3-3e49-8722-90673c7e5f85",
                        "entry_id": "d560f39f-b829-3082-b409-7078ccda6d11",
                        "glosses": [
                            "Logiciel de création et de manipulation interactives de tableaux numériques."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7303c0a9-c47c-41d4-bff2-e2f4644ff14d",
                        "source_entry_id": "d560f39f-b829-3082-b409-7078ccda6d11",
                        "target_lang_word": "Tabellenkalkulation",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tabellenkalkulation",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "97a4bffb-0c7d-32c7-9990-5c735c2bc76f",
                                        "entry_id": "5c90f534-185e-38e0-98a6-cf4400a28f6d",
                                        "glosses": [
                                            "Software für die tabellarische, interaktive Eingabe, Verarbeitung und graphische Darstellung von numerischen und alphanumerischen Daten"
                                        ],
                                        "tags": [
                                            "EDV"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0e11dbf1-c023-48c9-bdf3-0bd193ad8455",
                                                "sense_id": "97a4bffb-0c7d-32c7-9990-5c735c2bc76f",
                                                "text": "Gnumeric ist, im Gegensatz zu Microsoft Excel, ein freies Tabellenkalkulationsprogramm."
                                            },
                                            {
                                                "example_id": "8a6d7de1-8011-4f79-8d96-8fa7fac2380b",
                                                "sense_id": "97a4bffb-0c7d-32c7-9990-5c735c2bc76f",
                                                "text": "„Mit einer Tabellenkalkulation kannst du viele Aufgaben leicht lösen“"
                                            },
                                            {
                                                "example_id": "5387d2db-13d3-480e-92c1-4d19568c0469",
                                                "sense_id": "97a4bffb-0c7d-32c7-9990-5c735c2bc76f",
                                                "text": "„Mit einer Tabellenkalkulation rechnest du meistens oder sortierst damit Datensätze zum Beispiel nach Namen oder Größen.“"
                                            },
                                            {
                                                "example_id": "ba2e07d1-2d7c-4f6f-9143-0328413434de",
                                                "sense_id": "97a4bffb-0c7d-32c7-9990-5c735c2bc76f",
                                                "text": "„In der Tabellenkalkulation sind alle Zeilen nummeriert und die Spalten mit Buchstaben gekennzeichnet.“"
                                            },
                                            {
                                                "example_id": "3db7b19b-2603-440f-9af7-bb52488b2e5d",
                                                "sense_id": "97a4bffb-0c7d-32c7-9990-5c735c2bc76f",
                                                "text": "„Alle Rechenbefehle in einer Tabellenkalkulation beginnen mit einem Gleichheitszeichen (\"=\"). Ohne das =Zeichen rechnet das Programm nichts!“"
                                            },
                                            {
                                                "example_id": "f83ba3bd-d52a-4af7-801a-4004adba9b0e",
                                                "sense_id": "97a4bffb-0c7d-32c7-9990-5c735c2bc76f",
                                                "text": "„Unter dem Summen-Symbol in der Tabellenkalkulation Calc versammeln sich jetzt sechs weitere, häufig gebrauchte Funktionen, um diese auf markierte Zellen anzuwenden.“"
                                            },
                                            {
                                                "example_id": "8b44e2aa-1d42-471c-950b-a12b898e41cb",
                                                "sense_id": "97a4bffb-0c7d-32c7-9990-5c735c2bc76f",
                                                "text": "„Office-Pakete mit Textverarbeitung, Tabellenkalkulation und Präsentationsprogramm stellen erfreulich geringe Anforderungen an den Rechner.“"
                                            },
                                            {
                                                "example_id": "6744768d-d8ee-4063-9a4d-70dd9e738a7c",
                                                "sense_id": "97a4bffb-0c7d-32c7-9990-5c735c2bc76f",
                                                "text": "„Öffnen kann man die dbf-Dateien, die jeweils eine Datenbanktabelle enthalten, heute am schnellsten mit der Tabellenkalkulation Calc aus der LibreOffice-Programmfamilie.“"
                                            },
                                            {
                                                "example_id": "c1a84dda-f640-4d15-9a56-72a9573a5b22",
                                                "sense_id": "97a4bffb-0c7d-32c7-9990-5c735c2bc76f",
                                                "text": "[Über Zirkelbezüge] „Die Tabellenkalkulation verweigert die Rechnung.“"
                                            },
                                            {
                                                "example_id": "9de7cfe1-85a2-4526-87fa-0c47d58c0fbe",
                                                "sense_id": "97a4bffb-0c7d-32c7-9990-5c735c2bc76f",
                                                "text": "„Das alles an jedem Monatsende in eine Tabellenkalkulation einzutippen und richtig zu verrechnen, gleicht einer Strafarbeit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f4a7a614-e052-4567-bd11-95123eca7627",
                        "source_entry_id": "d560f39f-b829-3082-b409-7078ccda6d11",
                        "target_lang_word": "Tabellenkalkulationsprogramm",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "9b1bd382-f339-4efd-9e95-843e5a7ce145",
                        "source_entry_id": "d560f39f-b829-3082-b409-7078ccda6d11",
                        "target_lang_word": "spreadsheet",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "spreadsheet",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "edb2aef9-e891-3761-86c6-014afb915703",
                                        "entry_id": "adc0e160-ac33-3027-ab2f-b7131e3599e3",
                                        "glosses": [
                                            "A computer application for organization, analysis, and storage of data in tabular form."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e2f89c9f-56de-4ec2-93bd-d7b3bcfd9e03",
                                                "sense_id": "edb2aef9-e891-3761-86c6-014afb915703",
                                                "text": "The program's most quintessentially Macintoshian feature, one as yet unique among spreadsheets, is its icon bar, which resides at the top of the screen just below the standard menu bar."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "043ef585-0402-3950-b470-7fdff82a4fd2",
                                        "entry_id": "adc0e160-ac33-3027-ab2f-b7131e3599e3",
                                        "glosses": [
                                            "A document created with such an application."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3752a8fb-52cd-40b4-bc5a-2aad57b5c61d",
                                                "sense_id": "043ef585-0402-3950-b470-7fdff82a4fd2",
                                                "text": "A little later in this chapter, we'll run through some of the most common methods journalists use to analyze the material they gather and store in spreadsheets."
                                            },
                                            {
                                                "example_id": "751520d0-402b-4f81-af6d-af5d17e36528",
                                                "sense_id": "043ef585-0402-3950-b470-7fdff82a4fd2",
                                                "text": "For example, my own entry into the world of theorycrafting happened when I took somebody’s prot paladin spreadsheet and translated it into MATLAB code."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b304e11c-e82a-31e3-97e0-8cdd023d315f",
                                        "entry_id": "adc0e160-ac33-3027-ab2f-b7131e3599e3",
                                        "glosses": [
                                            "A sheet of paper, marked with a grid, in which financial data is recorded and totals calculated manually."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "spreadsheet",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a128d5cd-66f4-374c-baf6-8eadfcdb817c",
                                        "entry_id": "e740c3c8-7707-3e29-b260-ce4f229a4948",
                                        "glosses": [
                                            "To model or compute by means of a spreadsheet."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a2654887-3024-4df8-8502-7bd78cdd023c",
                                                "sense_id": "a128d5cd-66f4-374c-baf6-8eadfcdb817c",
                                                "text": "If you'd spreadsheeted the cascade charts and sorted it by each name's sphere of influence, then the people Carrie Johnstone sent the police to get constituted a big chunk of the middle third—people who “commanded” maybe four of five others—and maybe 10 percent of the top influencers."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
