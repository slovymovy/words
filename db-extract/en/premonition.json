                    {
                        "translation_id": "1c9dea9d-39cd-4b38-bc72-ad7d1f20feae",
                        "source_entry_id": "b5160aeb-7717-31f1-a02d-870b89f5f1e0",
                        "source_sense_description": "clairvoyant or clairaudient experience",
                        "target_lang_word": "premonición",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "premonición",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "646defb2-4966-35db-9029-846c0a38bece",
                                        "entry_id": "4da0e482-8332-312f-9efe-087d810127fe",
                                        "glosses": [
                                            "Presagio, apercibimiento, augurio."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "65154118-e879-4286-805b-80c478fabe6d",
                                                "sense_id": "646defb2-4966-35db-9029-846c0a38bece",
                                                "text": "«A pesar de los libros, de escribir, y de sus contados amigos, Bianca siempre había llevado consigo una tristeza interna, inherente a ella, una constante melancolía que entonces se explicaba a sí misma como una especie de premonición acerca de lo que le iba a tocar vivir»."
                                            },
                                            {
                                                "example_id": "dd177cc1-92d0-4a94-b9d6-79f3b3071b34",
                                                "sense_id": "646defb2-4966-35db-9029-846c0a38bece",
                                                "text": "«Solo al final descubrimos que se trataba de un anticipo abstracto, de una premonición teórica de la muda capital que hace de Pereira, por un día de su vida, un héroe»."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9632c083-8b76-394d-b0e9-74257a2a0b2a",
                                        "entry_id": "4da0e482-8332-312f-9efe-087d810127fe",
                                        "glosses": [
                                            "Señal o advertencia que se da o lanza a alguien desde un punto de vista moral."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "62127951-b7f3-49eb-9d08-35bdef176d5b",
