                    {
                        "form_id": "c3e2a1b2-ae0b-4461-9a42-a671b6f7e37e",
                        "entry_id": "dcf56fc3-5c71-369f-8f3d-7bc5bbd9743f",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Luftküsse"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "bb8fe9d6-adf5-3d35-8fb9-47f57871af95",
                        "entry_id": "dcf56fc3-5c71-369f-8f3d-7bc5bbd9743f",
                        "glosses": [
                            "Kuss, der (meist über eine Entfernung) nur angedeutet wird, entweder nur durch Spitzen der Lippen oder mit einer unterstützenden Gestik der Hand/Hände; die Lippen berühren sich dabei nie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e903356e-54c4-4d15-86b0-434d2577b030",
                                "sense_id": "bb8fe9d6-adf5-3d35-8fb9-47f57871af95",
                                "text": "Sie hauchte ihm einen Luftkuss zu."
                            },
                            {
                                "example_id": "c04d65a7-c448-48c5-bbea-edfb94ef35a1",
                                "sense_id": "bb8fe9d6-adf5-3d35-8fb9-47f57871af95",
                                "text": "Über den roten Teppich kommt doch jeder: Man sieht gut aus, lächelt in die Kameras, winkt den Zuschauern und wirft Luftküsse."
                            },
                            {
                                "example_id": "d221a7ac-da25-4078-9b93-fce7e7812490",
                                "sense_id": "bb8fe9d6-adf5-3d35-8fb9-47f57871af95",
                                "text": "Vergangene Woche wurden in Paris die Prêt-à-Porter-Schauen zelebriert. Eine Zeit des Gratischampagners, der Luftküsse und unvorstellbarer Stundengehälter."
                            },
                            {
                                "example_id": "205abbc6-a53e-43bd-ab2f-c7b2bd2ea341",
                                "sense_id": "bb8fe9d6-adf5-3d35-8fb9-47f57871af95",
                                "text": "Der Engel auf dem Roller neben mir wirft Luftküsse in eine Linse."
                            },
                            {
                                "example_id": "9d600a17-f953-4c36-8515-6eaf9c0d22f4",
                                "sense_id": "bb8fe9d6-adf5-3d35-8fb9-47f57871af95",
                                "text": "Als seine Freundin ihn später im Café abholen will, schicken sie sich verliebt Luftküsse hin- und her."
                            },
                            {
                                "example_id": "01076663-4a71-407a-b5d4-5181bb09cb16",
                                "sense_id": "bb8fe9d6-adf5-3d35-8fb9-47f57871af95",
                                "text": "Sie wirft dem Ex sogar noch einen Luftkuss zu – als Dank dafür, dass sie nach der Scheidung alles behalten darf."
                            },
                            {
                                "example_id": "3fb83112-decf-4a23-a24d-15342c7baba2",
                                "sense_id": "bb8fe9d6-adf5-3d35-8fb9-47f57871af95",
                                "text": "Das zerstrittene Ex-Ehepaar Albano und Romina Power sollte sich auf der Bühne küssen. Es endete peinlich in einem Luftkuss."
                            },
                            {
                                "example_id": "01b31b2e-5fdb-46ad-857b-262c6d652866",
                                "sense_id": "bb8fe9d6-adf5-3d35-8fb9-47f57871af95",
                                "text": "Cacau macht nach jedem von ihm geschossenen Tor den gleichen Torjubel. In Heimspielen läuft er mit zwei winkenden Zeigefingern in der Luft zur Fankurve, kniet sich an die Eckfahne, wartet auf die Mitspieler und macht einen Luftkuss."
                            },
                            {
                                "example_id": "ba86f91d-327e-4243-a8e9-2b6b3a718e96",
                                "sense_id": "bb8fe9d6-adf5-3d35-8fb9-47f57871af95",
                                "text": "„Er ist immer schon so gewesen“, erzählt seine Frau Heike Wirth, die wie er seit 30 Jahren Straßenbahn fährt. Wenn sie sich wie an diesem Tag an der Uniklinik - beide in ihrem Führerhäuschen - begegnen, wirft er ihr einen Luftkuss zu."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
