                        "приходиться кстати"
                    ]
                },
                {
                    "sense_id": "df3594d0-ff7c-3b32-8ae5-79d71c06c84a",
                    "sense_definition": "составлять какую-либо часть от общего количества",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "quantity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Большая часть бюджета <w>приходится</w> на социальные нужды."
                        },
                        {
                            "text": "На этот регион <w>приходится</w> половина всего экспорта."
                        }
                    ]
                },
                {
