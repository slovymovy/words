        "fr-extract.jsonl": [
            {
                "entry_id": "5efe1f30-315f-34d2-b7fb-e9fe2c198e67",
                "word": "litanie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "cb4b7169-7903-4bbe-a52c-28db6d710662",
                        "entry_id": "5efe1f30-315f-34d2-b7fb-e9fe2c198e67",
                        "tags": [
                            "plural"
                        ],
                        "form": "litanies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "01091a85-5b0b-3c80-bfb2-ea38945be6d9",
                        "entry_id": "5efe1f30-315f-34d2-b7fb-e9fe2c198e67",
                        "glosses": [
                            "Prière."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "63be8270-29b8-461e-9168-f6a26ec55240",
                                "sense_id": "01091a85-5b0b-3c80-bfb2-ea38945be6d9",
                                "text": "« Le chant, à la messe, présente des formes extrêmement variées, constate le P. Wackenheim. Il y a des litanies (le Kyrie, l’Agnus) […]"
                            },
                            {
                                "example_id": "68bb6053-947a-4e36-b268-48ab55f0b470",
                                "sense_id": "01091a85-5b0b-3c80-bfb2-ea38945be6d9",
                                "text": "Au-dehors on entendait la tramontane qui ronflait et les voix criardes des élèves récitant les litanies à la chapelle."
                            },
                            {
                                "example_id": "9798654a-64a1-4c4e-858b-b878bfb2114a",
                                "sense_id": "01091a85-5b0b-3c80-bfb2-ea38945be6d9",
                                "text": "D’un côté un vieillard récitait des litanies et de l’autre un enfant agitait une sonnette."
                            },
                            {
                                "example_id": "dda4b9c0-d5d4-4619-a341-5dde3440dff9",
                                "sense_id": "01091a85-5b0b-3c80-bfb2-ea38945be6d9",
                                "text": "Dire, réciter, chanter les litanies du Saint Nom de Jésus, de la Sainte Vierge, des saints."
                            },
                            {
                                "example_id": "e3af88f8-a74a-42bf-b40f-05dd737e0483",
                                "sense_id": "01091a85-5b0b-3c80-bfb2-ea38945be6d9",
                                "text": "Un enfant de chœur vint nous mettre à chacun un cierge allumé dans la main, et il fallut entendre toutes les litanies du rite slave, chantées par les popes à longs cheveux, sur des airs sautillants comme des danses de morts."
                            }
                        ]
                    },
                    {
                        "sense_id": "4634b0c8-4710-3a6e-a84d-14357d7e391d",
                        "entry_id": "5efe1f30-315f-34d2-b7fb-e9fe2c198e67",
                        "glosses": [
                            "Longue et ennuyeuse énumération."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "afff30c3-415a-4e9b-87ca-0f610c51b2f7",
                                "sense_id": "4634b0c8-4710-3a6e-a84d-14357d7e391d",
                                "text": "D’un bout à l’autre du continent russe, des assemblées récitent ces litanies abêtissantes, étouffantes, sans fin recommencées tout le long des années."
                            },
                            {
                                "example_id": "679874aa-9c08-4bec-8243-0f74869d378c",
                                "sense_id": "4634b0c8-4710-3a6e-a84d-14357d7e391d",
                                "text": "Sorbet, gâteau au chocolat, tarte au pommes, crème caramel, mousse au chocolat. Je vous récite la litanie mais il n’y a qu’un dessert qui compte : nos îles flottantes. Il est impératif que vous goûtiez nos îles flottantes. Spécialité absolue."
                            },
                            {
                                "example_id": "3efa69df-6686-43fe-ba68-b6850dd382e5",
                                "sense_id": "4634b0c8-4710-3a6e-a84d-14357d7e391d",
                                "text": "Et sans doute avait-il encore moins envie de faire le moindre commentaire sur l’interminable litanie des propos rabat-joie que L’Ecclésiaste donne à entendre dans la Bible."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "588801e8-02ac-47f1-82c4-1bc8a8eba22e",
                        "source_entry_id": "5efe1f30-315f-34d2-b7fb-e9fe2c198e67",
                        "source_sense_id": "01091a85-5b0b-3c80-bfb2-ea38945be6d9",
                        "source_sense_description": "Prière",
                        "target_lang_word": "litany",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "litany",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bceb426a-3cc5-3667-89f9-a45ebf5eecf8",
                                        "entry_id": "ec6201d5-0925-3489-b100-e408cb3b747b",
                                        "glosses": [
                                            "A ritual liturgical prayer in which a series of prayers recited by a leader are alternated with responses from the congregation."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "56091c12-1320-3ed7-8e56-25d489643e0e",
                                        "entry_id": "ec6201d5-0925-3489-b100-e408cb3b747b",
                                        "glosses": [
                                            "A prolonged or tedious list."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1f0fbe89-b689-4141-9ead-f823ad6913ae",
                                                "sense_id": "56091c12-1320-3ed7-8e56-25d489643e0e",
                                                "text": "The litany of packaging innovations introduced to or popularized in the U.S. food market over the last generation seems endless: flexible aseptic packaging, barrier plastics, squeezables, lightweight glass, the retort pouch, […]"
                                            },
                                            {
                                                "example_id": "f41f016d-3072-4169-a2e8-e5b584fea9ce",
                                                "sense_id": "56091c12-1320-3ed7-8e56-25d489643e0e",
                                                "text": "To that end he had sent his men among the common folk of the town, from whom came a litany of tales that led Hawk to a stunningly wrong conclusion. \"It seems I may not be good enough at listening,\" he said regretfully."
                                            },
                                            {
                                                "example_id": "98f4bd01-d0c1-4de5-bba8-dd33f2642945",
                                                "sense_id": "56091c12-1320-3ed7-8e56-25d489643e0e",
                                                "text": "There are, to be sure, some differences in how the candidates propose addressing this litany of concerns."
                                            },
                                            {
                                                "example_id": "b724ce23-45fe-4d61-a869-429a8f16653c",
                                                "sense_id": "56091c12-1320-3ed7-8e56-25d489643e0e",
                                                "text": "[Sam Bankman-Fried] is charged with a litany of fraud and campaign finance law violations, in what US prosecutors are calling “one of the biggest financial frauds in American history”."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
