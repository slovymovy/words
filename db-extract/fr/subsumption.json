                        ],
                        "examples": [
                            {
                                "example_id": "74e74c69-4614-479b-9cb7-5d3916bffddf",
                                "sense_id": "1dba6a58-4f1b-383f-a8bb-10458a653f36",
                                "text": "« L’homme est un animal » est une subsumption, où l’idée moins générale d’homme est mise sous l’idée plus générale d’animal : « animal subsume homme »."
                            },
                            {
                                "example_id": "f13b0ccd-4aa5-4ffe-a716-e2cf94b30290",
                                "sense_id": "1dba6a58-4f1b-383f-a8bb-10458a653f36",
                                "text": "Même récemment, on est parti de la définition platonicienne de la perception pour étudier la nature de la représentation artistique : la subsumption de l’accidentel à l’universel implique que la comparaison des ressemblances est une « espèce de fusion perceptive » […], réalisée par le moyen de l’expérience."
                            }
                        ]
                    }
