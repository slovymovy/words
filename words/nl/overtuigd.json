                    "frequency": "VeryLow",
                    "semantic_group_id": "scheepvaart",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Te veel helling en roerdruk zijn vaak het gevolg van een <w>overtuigd</w> schip.",
                            "target_lang_translations": {
                                "en": "Too much heel and rudder pressure are often the result of an <w>over-canvassed</w> ship."
                            }
                        },
                        {
                            "text": "Omdat de wind plotseling toenam, voer de zeilboot nu gevaarlijk <w>overtuigd</w>.",
                            "target_lang_translations": {
                                "en": "Because the wind suddenly increased, the sailboat was now sailing dangerously <w>over-canvassed</w>."
