                                "target_senses": [
                                    {
                                        "sense_id": "8e382e22-b45a-339c-9dae-db8cb67b75c9",
                                        "entry_id": "c79bab91-10ef-3290-a861-3fd1ce84d7d5",
                                        "glosses": [
                                            "Unité de masse utilisée encore en Russie pour mesurer le poids des céréales, qui équivaut à quarante livres russes soit 16,38 kg."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1440ecc-1374-432e-b169-a91b8fa152b8",
                                                "sense_id": "8e382e22-b45a-339c-9dae-db8cb67b75c9",
                                                "text": "Parmi les sacs, il y en avait un d’énorme, un sac de sept pouds, fait de grosse toile de laine."
                                            },
                                            {
                                                "example_id": "a0f616e7-d3f9-4a84-a97b-1e07a512a9bd",
                                                "sense_id": "8e382e22-b45a-339c-9dae-db8cb67b75c9",
                                                "text": "Chacun devait moudre deux pouds de seigle par jour."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "efb14742-ac7e-462a-8a46-ab79fad787db",
                        "source_entry_id": "2967d6e3-3364-3fa8-9a51-cc05a5ea629d",
                        "source_sense_description": "Russian unit of mass",
                        "target_lang_word": "Pud",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
