                        "entry_id": "f68386a5-4fbf-3fd5-bbbb-4bfa7f5c061a",
                        "glosses": [
                            "celowe wprowadzenie kogoś w błąd, próba zaskoczenia, onieśmielenia kogoś poprzez stworzenie pozorów, że ma się przewagę, jakieś poważne atuty przeciwko komuś lub czemuś"
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "2998e913-b223-45c1-a8a3-4fa3b3819b37",
                                "sense_id": "d9fbc8d6-3e9d-3c9a-94d0-8918d63d5ea4",
                                "text": "Informacja o tym, że wylecimy z pracy, jeśli nie zdobędziemy tego kontraktu, okazała się blefem."
