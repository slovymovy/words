        "de-extract.jsonl": [
            {
                "entry_id": "a8b58dc6-f0dc-339d-b9b9-2a788c44f55d",
                "word": "vorderhand",
                "pos": "adv",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "83a09c3e-7840-39c3-8112-f686a3935889",
                        "entry_id": "a8b58dc6-f0dc-339d-b9b9-2a788c44f55d",
                        "glosses": [
                            "erst einmal, fürs Erste"
                        ],
                        "tags": [
                            "Austrian German",
                            "Swiss Standard German",
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "10aa798a-aca4-40e3-bf15-29ccad66663a",
                                "sense_id": "83a09c3e-7840-39c3-8112-f686a3935889",
                                "text": "„Übrigens konnte von Überrumpelung und Gewalttätigkeit nicht die Rede ſein, der Winter kam gelinde, er ſah vorderhand nicht ſehr anders aus als mancher Tag, den auch der Hochſommer ſchon mit ſich geführt hatte.“"
                            },
                            {
                                "example_id": "58a06e69-8677-4283-b972-a398fb2a253b",
                                "sense_id": "83a09c3e-7840-39c3-8112-f686a3935889",
                                "text": "„Vorderhand reagieren wir auf die unerträglichen Zuſtände ziemlich unvernünftig, tun aber im Grunde doch das Richtige: wir reduzieren.“"
                            },
                            {
                                "example_id": "d1396e03-7262-484e-b6ca-6d4bcbb63a98",
                                "sense_id": "83a09c3e-7840-39c3-8112-f686a3935889",
                                "text": "„Und darum will ich in der Untersuchung dieser Frage vorderhand nicht weiter gehen.“"
                            },
                            {
                                "example_id": "e459882f-ddaf-47b2-be04-9b807d19f473",
                                "sense_id": "83a09c3e-7840-39c3-8112-f686a3935889",
                                "text": "„Auf eine Begnadigung hinzuarbeiten, sei vorderhand so gut wie aussichtslos.“"
                            },
                            {
                                "example_id": "4857997a-444e-4531-b35c-e7551046aa50",
                                "sense_id": "83a09c3e-7840-39c3-8112-f686a3935889",
                                "text": "„Vorderhand habe ich keine Ahnung, wie ich es durchbringen soll… ich müßte schier eine Amme auftreiben …“"
                            },
                            {
                                "example_id": "5ce9337d-33b5-4c19-8d0c-07b1d3f8ccdb",
                                "sense_id": "83a09c3e-7840-39c3-8112-f686a3935889",
                                "text": "„Wenn sich eine vorderhand irrationale Äußerung Interpretationsversuchen hartnäckig widersetzt, kann der Interpret gewiß dazu übergehen, die unzugängliche Äußerung im Sinne des Eintretens eines empirischen Ereignisses mit Hilfe von kausalen Hypothesen und Anfangsbedingungen, beispielsweise psychologisch oder soziologisch zu erklären.“"
                            },
                            {
                                "example_id": "e94d4c1f-22de-45a1-ba94-23c0ac21eb6d",
                                "sense_id": "83a09c3e-7840-39c3-8112-f686a3935889",
                                "text": "„Vorderhand müssen sich die Palästinenser mit zahllosen Einzelaktionen, Eingaben an die Behörden, Klagen vor Gericht und Aufrufen an die Öffentlichkeit gegen diskriminierende Massnahmen und rassistische Übergriffe wehren.“"
                            },
                            {
                                "example_id": "b5ef2a85-ee3b-489e-a16e-64779a708825",
                                "sense_id": "83a09c3e-7840-39c3-8112-f686a3935889",
                                "text": "„Gebaut werden kann aber vorderhand noch nicht.“"
                            },
                            {
                                "example_id": "e6a44a3a-deb7-42c2-a847-d77c463e2d71",
                                "sense_id": "83a09c3e-7840-39c3-8112-f686a3935889",
                                "text": "„Im neuen palästinensischen Parlament sitzen nun – ausgestattet mit einer wohl absoluten Mehrheit – Abgeordnete, die für etwa 60 der Selbstmordattentate seit der zweiten Intifada im Herbst 2000 verantwortlich sind, die aktiv die Gehirnwäsche einer zum ‚Märtyrertum‘ bereiten Jugend betrieben, Israels Recht auf eine staatliche Existenz nicht anerkennen, Verhandlungen mit internationalen Hilfsgebern – vorderhand – ablehnen und deren politische Führung in palästinensischen Flüchtlingslagern im Libanon und in Syrien sitzt.“"
                            },
                            {
                                "example_id": "1a39288c-dac6-42f7-aa5f-ff6763f7dcaf",
                                "sense_id": "83a09c3e-7840-39c3-8112-f686a3935889",
                                "text": "„Klar ist für ihn vorderhand nur eines: ‚Hinter einer so aufwändigen Operation steckt mit Sicherheit ein Staat.‘“"
                            },
                            {
                                "example_id": "3047830b-f531-42b1-8151-e7900efc41ec",
                                "sense_id": "83a09c3e-7840-39c3-8112-f686a3935889",
                                "text": "„Die Politik schaut vorderhand tatenlos zu.“"
                            },
                            {
                                "example_id": "62300e70-d796-4678-8891-ece56c73f567",
                                "sense_id": "83a09c3e-7840-39c3-8112-f686a3935889",
                                "text": "„Während Helmy den Nazis vorderhand vorgaukelte, dass man absolut NS-treu geworden sei, knüpfte er insgeheim ein immer größeres Netz.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fa5e8430-6308-4a04-b231-f413ca5ca81f",
                        "source_entry_id": "a8b58dc6-f0dc-339d-b9b9-2a788c44f55d",
                        "source_sense_id": "83a09c3e-7840-39c3-8112-f686a3935889",
                        "target_lang_word": "for the time being",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "for the time being",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "58e5d290-65d0-3dbc-a843-24f1f4edc601",
                                        "entry_id": "b03ac985-242f-3b07-8068-45936b45a76d",
                                        "glosses": [
                                            "Temporarily; for now; until later; until the situation changes; in an indefinite period of time."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0ecedfb8-3c39-4e49-a4a9-eaaa12d5eb5b",
                                                "sense_id": "58e5d290-65d0-3dbc-a843-24f1f4edc601",
                                                "text": "I think I will ignore the problem for the time being."
                                            },
                                            {
                                                "example_id": "5a6323b0-9e1e-4155-92f8-18d1bf22eb04",
                                                "sense_id": "58e5d290-65d0-3dbc-a843-24f1f4edc601",
                                                "text": "And so, unfortunately, this great and spreading network of railways, that recently showed such promise as a major instrument in the modern development of China, must be left for the time being in the melting-pot of Armageddon."
                                            },
                                            {
                                                "example_id": "8889eef2-b73b-4e9c-a677-281a78634428",
                                                "sense_id": "58e5d290-65d0-3dbc-a843-24f1f4edc601",
                                                "text": "Neither Aracil nor his five friends have the money to pay for the costs of the demolition, which, they say, are punitively over-inflated. For the time being, their hopes rest on legal appeals, and should those fail, on a crowdfunding campaign."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9f79592e-e057-4dc2-83d0-02660ef6d719",
                        "source_entry_id": "a8b58dc6-f0dc-339d-b9b9-2a788c44f55d",
                        "source_sense_id": "83a09c3e-7840-39c3-8112-f686a3935889",
                        "target_lang_word": "à titre temporaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "0c7389f6-ba9d-4adc-b51a-07b2d2c5ccdd",
                        "source_entry_id": "a8b58dc6-f0dc-339d-b9b9-2a788c44f55d",
                        "source_sense_id": "83a09c3e-7840-39c3-8112-f686a3935889",
                        "target_lang_word": "dans les premiers temps",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "00b6d5a4-2c7e-43cf-b46a-d409ea46ddff",
                        "source_entry_id": "a8b58dc6-f0dc-339d-b9b9-2a788c44f55d",
                        "source_sense_id": "83a09c3e-7840-39c3-8112-f686a3935889",
                        "target_lang_word": "pour l’instant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pour l’instant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f1ec33ff-6a67-3b5b-b117-0e6840a9fe85",
                                        "entry_id": "17c36c4c-ef0d-38b2-acd9-7fbe50808dbc",
                                        "glosses": [
                                            "À l’heure actuelle, pour le moment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "99094216-5cc7-4416-a4b8-e5a892e8faa2",
                                                "sense_id": "f1ec33ff-6a67-3b5b-b117-0e6840a9fe85",
                                                "text": "« Pour l’instant, les juges d’instruction ne communiquent pas, c’est le black-out complet », regrette son avocat, Matthieu Airoldi."
                                            },
                                            {
                                                "example_id": "e02aa021-2676-455a-bf74-d7efd023eec5",
                                                "sense_id": "f1ec33ff-6a67-3b5b-b117-0e6840a9fe85",
                                                "text": "Pour l’instant, cette vieille maison tient encore debout, mais ses murs sont si craquelés et fendillés qu’elle tombera tôt ou tard."
                                            },
                                            {
                                                "example_id": "6c4d0015-16e6-4557-bece-1b5726943165",
                                                "sense_id": "f1ec33ff-6a67-3b5b-b117-0e6840a9fe85",
                                                "text": "La directrice n’est pas là pour l’instant, mais vous pouvez l’attendre : elle reviendra dans quelques minutes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "15039785-fc4d-434d-897f-fec58d4f6350",
                        "source_entry_id": "a8b58dc6-f0dc-339d-b9b9-2a788c44f55d",
                        "source_sense_id": "83a09c3e-7840-39c3-8112-f686a3935889",
                        "target_lang_word": "pour le moment",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pour le moment",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3e08c605-ec44-3901-a7de-56a8ec4a12b2",
                                        "entry_id": "8363563e-f42c-3473-8958-02797c653a3d",
                                        "glosses": [
                                            "Actuellement ; pour l’instant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "870217c9-4a72-47a9-9b7e-82c7c13419be",
                                                "sense_id": "3e08c605-ec44-3901-a7de-56a8ec4a12b2",
                                                "text": "Ce matin, les autres dormaient encore quand je suis allée chercher des bûches dans la remise pour allumer le feu dans le poêle. Pour le moment, les températures de la nuit sont négatives dans la région de Berlin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ee5708c0-edc5-393e-969d-ef3f01652407",
                                        "entry_id": "8363563e-f42c-3473-8958-02797c653a3d",
                                        "glosses": [
                                            "Dans l’attente de quelque chose ; en attendant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d1be30f2-e743-4cc9-be69-fca52903774e",
                                                "sense_id": "ee5708c0-edc5-393e-969d-ef3f01652407",
                                                "text": "Faute de pouvoir faire toute la lumière désirable sur ce fait énigmatique, nous réunirons ici le faisceau de vraisemblances et de témoignages qui peuvent seuls nous éclairer pour le moment."
                                            },
                                            {
                                                "example_id": "53f2f0ce-9179-4f67-86e7-4940aed751d4",
                                                "sense_id": "ee5708c0-edc5-393e-969d-ef3f01652407",
                                                "text": "On va faire comme ça pour le moment, et si ça ne va pas, on changera."
                                            },
                                            {
                                                "example_id": "3c99bbe0-22e9-4a4b-91bb-3c8838e4cf0e",
                                                "sense_id": "ee5708c0-edc5-393e-969d-ef3f01652407",
                                                "text": "Pour le moment, il loge chez des amis, mais dès qu’il aura trouvé un appartement, il déménagera."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
