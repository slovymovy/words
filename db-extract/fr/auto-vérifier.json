                "senses": [
                    {
                        "sense_id": "3df0b035-9c0a-3c42-a9b7-9fe6d0db4459",
                        "entry_id": "02598a1a-65f3-3aa8-bfb5-edd9341ca2cc",
                        "glosses": [
                            "Vérifier soi-même (ce qu’on a fait)."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "028b57cb-9dd7-3b1d-8fe7-08afc5880635",
                        "entry_id": "02598a1a-65f3-3aa8-bfb5-edd9341ca2cc",
                        "glosses": [
                            "Se vérifier naturellement à partir des hypothèses de départ."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "ff9a7166-07b2-4931-a326-7470efc0f222",
                                "sense_id": "028b57cb-9dd7-3b1d-8fe7-08afc5880635",
                                "text": "À ce titre, l’évidence est susceptible de plus et de moins, possède des degrés mais aussi des moyens de s’auto-vérifier."
                            },
                            {
                                "example_id": "b849ae42-c562-48b3-8ea5-f1aa9fb7940b",
                                "sense_id": "028b57cb-9dd7-3b1d-8fe7-08afc5880635",
                                "text": "Tout ce qu’elle « vérifie », c’est donc le langage déjà fait et la capacité du discours à s’auto-vérifier hors de toute connaissance véritable."
                            }
                        ]
                    }
