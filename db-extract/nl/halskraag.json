                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d8e9bef6-0248-4b9d-ad94-0e12a7cc660c",
                                "sense_id": "a2ff6e7f-e3dd-3ff9-8784-ddcc96757203",
                                "text": "De 19-jarige speler kwam woensdag in de slotfase van het duel met Arsenal in botsing met zijn eigen doelman Ederson en moest na langdurige behandeling op het veld met een zuurstofmasker en een halskraag per brancard worden weggedragen."
                            },
                            {
                                "example_id": "ce81b7b3-db55-4f90-a80e-096437181ab4",
                                "sense_id": "a2ff6e7f-e3dd-3ff9-8784-ddcc96757203",
                                "text": "Met een halskraag om zat hij naast Miriam in de taxi en probeerde zich een voorstelling te maken van wat hij zou aantreffen."
                            }
                        ]
                    },
                    {
                        "sense_id": "69f6357f-85a0-305e-a409-c21995cb9114",
