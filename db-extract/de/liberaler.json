                "senses": [
                    {
                        "sense_id": "1b762492-c04b-320d-a7ff-fa342162249c",
                        "entry_id": "1c4a3fbc-6ea8-3c8c-b67e-aaae79e93619",
                        "glosses": [
                            "Person, die einer liberalen Partei anhängt oder eine liberalen Grundeinstellung vertritt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b05794f-1012-44bf-a2ba-6d5b14723e6c",
                                "sense_id": "1b762492-c04b-320d-a7ff-fa342162249c",
                                "text": "„Liberale kritisierten, dass die neue Regierung die meisten der demokratischen Errungenschaften, die aus der jungtürkischen Ära verblieben waren, wieder rückgängig machte.“"
                            },
                            {
                                "example_id": "bcf62be8-bbe8-44c2-8888-be8e354d29a0",
                                "sense_id": "1b762492-c04b-320d-a7ff-fa342162249c",
                                "text": "„Er war Chefredakteur der Liberalen in Island.“"
                            }
                        ],
