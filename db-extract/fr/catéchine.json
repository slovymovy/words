                        "sense_id": "13221b58-606c-3a1c-88db-03a528c1bea4",
                        "entry_id": "dcb555db-2412-3e82-b746-358f42687b36",
                        "glosses": [
                            "Composé de la famille des flavonoïdes de la sous-classe des flavanols."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c29f2c91-28cf-4a48-b650-92cb0bc1c45b",
                                "sense_id": "13221b58-606c-3a1c-88db-03a528c1bea4",
                                "text": "La catéchine qui forme la portion du cachou insoluble dans l’eau froide, a fourni en quantité notable par la distillation la pyrocatéchine de M. Zwenger."
                            },
                            {
                                "example_id": "7528ffc0-ab13-4e41-935d-c1f6d8f97f55",
                                "sense_id": "13221b58-606c-3a1c-88db-03a528c1bea4",
                                "text": "Différents mécanismes anti-obésité sont envisagés pour le thé vert. Ainsi les catéchines stimuleraient, … les dépenses énergétiques et l'oxydation des graisses."
                            }
                        ]
                    }
                ],
