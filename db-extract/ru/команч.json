                    {
                        "translation_id": "0afdacbe-fc75-4399-ba2f-f0b5449466c3",
                        "source_entry_id": "46c4af21-374a-3ab5-8d20-2a51fe72db3c",
                        "source_sense_id": "3932e663-a0d9-3d3c-95a6-e9369c01c17e",
