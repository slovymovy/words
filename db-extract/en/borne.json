                                                "sense_id": "895a10e1-13d9-3253-8505-3ccc979cee2d",
                                                "text": "Vóór Gerry heeft mijn moeder zelfs nooit een trouwring gedragen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2ab1d229-b9a3-32f2-ac1f-ffb297029ee3",
                                        "entry_id": "71552339-f255-3410-9ab1-8ca8bc957f54",
                                        "glosses": [
                                            "voltooid deelwoord van gedragen"
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2dcdfcec-96cb-437d-bbce-75361e5794e5",
                                                "sense_id": "2ab1d229-b9a3-32f2-ac1f-ffb297029ee3",
                                                "text": "' Ik probeerde me te herinneren hoe Lawrie zich had gedragen wanneer Reede het over Harold Schloss had gehad."
                                            }
                                        ]
                                    }
                                ]
                            }
