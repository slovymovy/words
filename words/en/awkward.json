{
    "word_family": [
        "awkwardly",
        "awkwardness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "062e1a12-87e6-37f6-9d36-b7cc7dff16ed",
                    "sense_definition": "Causing or feeling embarrassment, discomfort, or inconvenience.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "That was an extremely <w>awkward</w> moment for everyone involved.",
                            "target_lang_translations": {
                                "ru": "Это был крайне <w>неловкий</w> момент для всех участников.",
                                "tr": "O, olaya dahil olan herkes için son derece <w>utandırıcı</w> bir andı.",
                                "zh": "对所有相关人员来说，那都是一个极其<w>尴尬</w>的时刻。"
                            }
                        },
                        {
                            "text": "An <w>awkward</w> silence fell over the room after the joke failed.",
                            "target_lang_translations": {
                                "ru": "После неудачной шутки в комнате повисла <w>неловкая</w> тишина.",
                                "tr": "Espri tutmayınca odaya <w>garip</w> bir sessizlik çöktü.",
                                "zh": "笑话没讲好后，房间里陷入了一阵<w>尴尬</w>的沉默。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "awkward silence",
                        "awkward moment",
                        "awkward situation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вызывающий или чувствующий смущение, дискомфорт или неудобство.",
                        "tr": "Utanç, rahatsızlık veya elverişsizlik hissettiren veya bunlara neden olan.",
                        "zh": "指引起或感到尴尬、不适或不便的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неловкий",
                                "target_lang_sense_clarification": "вызывающий смущение"
                            },
                            {
                                "target_lang_word": "неудобный",
                                "target_lang_sense_clarification": "вызывающий дискомфорт"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "utandırıcı",
                                "target_lang_sense_clarification": "sıkıntı ve mahcubiyet veren"
                            },
                            {
                                "target_lang_word": "rahatsız edici",
                                "target_lang_sense_clarification": "huzursuzluk yaratan"
                            },
                            {
                                "target_lang_word": "garip",
                                "target_lang_sense_clarification": "tuhaf, ortamı geren"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "尴尬",
                                "target_lang_sense_clarification": "指处境或气氛令人难堪"
                            },
                            {
                                "target_lang_word": "不自在",
                                "target_lang_sense_clarification": "指感到不舒服或拘束"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ffe10be7-a36c-3c88-bf7a-e3568b7def23",
                    "sense_definition": "Lacking social skills, confidence, or grace; feeling uneasy around others.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I always feel <w>awkward</w> at large parties where I do not know anyone.",
                            "target_lang_translations": {
                                "ru": "Я всегда чувствую себя <w>неловко</w> на больших вечеринках, где никого не знаю.",
                                "tr": "Kimseyi tanımadığım büyük partilerde kendimi her zaman <w>çekingen</w> hissederim.",
                                "zh": "在大型聚会上，如果我不认识任何人，我总是感到很<w>不自在</w>。"
                            }
                        },
                        {
                            "text": "He is socially <w>awkward</w> and struggles to make small talk with strangers.",
                            "target_lang_translations": {
                                "ru": "Он социально <w>неловок</w> и с трудом поддерживает светскую беседу с незнакомцами.",
                                "tr": "Sosyal açıdan <w>beceriksizdir</w> ve yabancılarla havadan sudan konuşmakta zorlanır.",
                                "zh": "他<w>不善于交际</w>，很难与陌生人进行闲聊。"
                            }
                        }
                    ],
                    "synonyms": [
                        "gauche",
                        "gawky"
                    ],
                    "antonyms": [
                        "cool"
                    ],
                    "common_phrases": [
                        "socially awkward",
                        "feel awkward"
                    ],
                    "target_lang_definitions": {
                        "ru": "Не имеющий социальных навыков, уверенности или изящества; чувствующий себя скованно среди других.",
                        "tr": "Sosyal becerilerden, özgüvenden veya zarafetten yoksun; başkalarının yanında huzursuz hisseden.",
                        "zh": "缺乏社交技巧、自信或优雅；在他人面前感到拘束。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неловкий",
                                "target_lang_sense_clarification": "испытывающий стеснение"
                            },
                            {
                                "target_lang_word": "скованный",
                                "target_lang_sense_clarification": "зажатый, неуверенный"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "utangaç",
                                "target_lang_sense_clarification": "sosyal ortamlarda çekingen"
                            },
                            {
                                "target_lang_word": "çekingen",
                                "target_lang_sense_clarification": "topluluk içinde kendini rahat hissetmeyen"
                            },
                            {
                                "target_lang_word": "beceriksiz",
                                "target_lang_sense_clarification": "sosyal ilişkilerde rahat olamayan"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "拘束",
                                "target_lang_sense_clarification": "指在社交场合感到不自然"
                            },
                            {
                                "target_lang_word": "不善交际",
                                "target_lang_sense_clarification": "指缺乏社交能力"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "88ec0a74-7036-398e-aaae-f13ff6d33e2f",
                    "sense_definition": "Lacking physical dexterity or grace; moving or handling things clumsily.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "John was <w>awkward</w> at performing the trick and dropped the cards.",
                            "target_lang_translations": {
                                "ru": "Джон был <w>неловок</w> при выполнении фокуса и уронил карты.",
                                "tr": "John numarayı yaparken <w>sakar</w> davrandı ve kartları düşürdü.",
                                "zh": "约翰表演魔术时动作很<w>笨拙</w>，把牌掉在了地上。"
                            }
                        },
                        {
                            "text": "The teenager felt <w>awkward</w> in his body as he grew taller.",
                            "target_lang_translations": {
                                "ru": "Подросток чувствовал себя <w>неуклюжим</w> в своем теле, когда стал расти.",
                                "tr": "Genç çocuk boyu uzadıkça kendi bedeninde <w>hantal</w> hissetti.",
                                "zh": "这个少年在长高时，感到自己的身体很<w>不协调</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "clumsy",
                        "ungraceful",
                        "maladroit",
                        "lubberly"
                    ],
                    "antonyms": [
                        "dexterous",
                        "graceful",
                        "skillful"
                    ],
                    "common_phrases": [
                        "awkward gait",
                        "awkward movement"
                    ],
                    "target_lang_definitions": {
                        "ru": "Лишенный физической ловкости или грации; неуклюжий в движениях или обращении с предметами.",
                        "tr": "Fiziksel beceriden veya zarafetten yoksun; sakarca hareket eden veya eşyaları sakarca kullanan.",
                        "zh": "缺乏身体灵活性或优雅；动作或处理事物时笨拙。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неуклюжий",
                                "target_lang_sense_clarification": "лишенный грации"
                            },
                            {
                                "target_lang_word": "неловкий",
                                "target_lang_sense_clarification": "неумелый в движениях"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "sakar",
                                "target_lang_sense_clarification": "sürekli kaza yapan, elinden bir şey düşüren"
                            },
                            {
                                "target_lang_word": "beceriksiz",
                                "target_lang_sense_clarification": "fiziksel işlerde ustalaşamamış"
                            },
                            {
                                "target_lang_word": "hantal",
                                "target_lang_sense_clarification": "hareketleri zarafetten uzak"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "笨拙",
                                "target_lang_sense_clarification": "指动作不灵敏"
                            },
                            {
                                "target_lang_word": "手脚不灵活",
                                "target_lang_sense_clarification": "指处理事物时缺乏技巧"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c1f6b1d5-9d6c-3a87-8f51-4a1e4bfb3968",
                    "sense_definition": "Difficult to handle, deal with, or satisfy; uncooperative or inconvenient.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "These large cabinets are going to be very <w>awkward</w> to move through the door.",
                            "target_lang_translations": {
                                "ru": "Эти большие шкафы будет очень <w>неудобно</w> проносить через дверь.",
                                "tr": "Bu büyük dolapları kapıdan geçirmek çok <w>kullanışsız</w> ve zor olacak.",
                                "zh": "这些大柜子很难搬过那扇门，非常<w>不便</w>。"
                            }
                        },
                        {
                            "text": "He can be a bit of an <w>awkward</w> customer when he does not get his way.",
                            "target_lang_translations": {
                                "ru": "Он может быть немного <w>трудным</w> клиентом, когда не получает желаемого.",
                                "tr": "İstediği olmadığında biraz <w>zor</w> bir müşteri olabiliyor.",
                                "zh": "当他的要求得不到满足时，他可能会成为一个有点<w>棘手</w>的顾客。"
                            }
                        }
                    ],
                    "synonyms": [
                        "recalcitrant",
                        "unhandy"
                    ],
                    "antonyms": [
                        "handy",
                        "amiable"
                    ],
                    "common_phrases": [
                        "awkward time",
                        "awkward position",
                        "awkward customer"
                    ],
                    "target_lang_definitions": {
                        "ru": "Трудный в обращении, решении или удовлетворении; несговорчивый или доставляющий неудобства.",
                        "tr": "Taşıması, başa çıkılması veya tatmin edilmesi zor; kullanışsız veya elverişsiz.",
                        "zh": "难以处理、应对或满足；不配合或不方便。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неудобный",
                                "target_lang_sense_clarification": "трудный в использовании или перемещении"
                            },
                            {
                                "target_lang_word": "затруднительный",
                                "target_lang_sense_clarification": "о ситуации или положении"
                            },
                            {
                                "target_lang_word": "трудный",
                                "target_lang_sense_clarification": "о характере человека"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "kullanışsız",
                                "target_lang_sense_clarification": "kullanması ve taşıması zor"
                            },
                            {
                                "target_lang_word": "zor",
                                "target_lang_sense_clarification": "başa çıkması veya idare etmesi güç"
                            },
                            {
                                "target_lang_word": "uygunsuz",
                                "target_lang_sense_clarification": "zamanı veya durumu elverişli olmayan"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "棘手",
                                "target_lang_sense_clarification": "指事情难以处理"
                            },
                            {
                                "target_lang_word": "不便",
                                "target_lang_sense_clarification": "指使用或移动时感到困难"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5b8505a2-5769-311c-aa82-8d8c0b67a7da",
                    "sense_definition": "Someone or something that is clumsy, difficult, or embarrassing.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teacher tried to help the <w>awkwards</w> feel more comfortable in the class.",
                            "target_lang_translations": {
                                "ru": "Учитель пытался помочь <w>недотёпам</w> чувствовать себя комфортнее в классе.",
                                "tr": "Öğretmen, <w>beceriksizlerin</w> sınıfta kendilerini daha rahat hissetmelerine yardımcı olmaya çalıştı.",
                                "zh": "老师试图让那些<w>笨手笨脚的人</w>在课堂上感到更自在。"
                            }
                        },
                        {
                            "text": "It is not fun to hang out with <w>awkwards</w> more than once.",
                            "target_lang_translations": {
                                "ru": "Невесело проводить время с <w>недотёпами</w> больше одного раза.",
                                "tr": "<w>Sakar kimselerle</w> birden fazla kez takılmak eğlenceli değildir.",
                                "zh": "和那些<w>社交障碍者</w>待在一起，一次就够让人受不了了。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used to refer to awkward people or situations as a noun."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек или предмет, который является неуклюжим, сложным или вызывающим смущение.",
                        "tr": "Sakar, zor veya utandırıcı olan kişi veya şey.",
                        "zh": "指笨拙、难以相处或令人尴尬的人或事物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "недотёпа",
                                "target_lang_sense_clarification": "неуклюжий человек"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "sakar kimse",
                                "target_lang_sense_clarification": "sürekli sakarlık yapan kişi"
                            },
                            {
                                "target_lang_word": "beceriksiz",
                                "target_lang_sense_clarification": "toplumsal veya fiziksel olarak uyumsuz kimse"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "笨手笨脚的人",
                                "target_lang_sense_clarification": "指动作笨拙的人"
                            },
                            {
                                "target_lang_word": "社交障碍者",
                                "target_lang_sense_clarification": "指在社交中表现不自然的人"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}