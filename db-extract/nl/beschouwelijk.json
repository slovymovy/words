                                    {
                                        "sense_id": "1bba1e6a-7c78-3660-aa9b-463d9e6350f0",
                                        "entry_id": "a574d754-1cbd-32ed-97a6-d5f730a40804",
                                        "glosses": [
                                            "Referring back to the subject, or having an object equal to the subject."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3bdeac27-4b3c-3f83-a7fa-e686f82fbb3b",
                                        "entry_id": "a574d754-1cbd-32ed-97a6-d5f730a40804",
                                        "glosses": [
                                            "Of a relation R on a set S, such that xRx for all members x of S (that is, the relation holds between any element of the set and itself)."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "046185e0-e91a-4558-9292-28646e8fe358",
                                                "sense_id": "3bdeac27-4b3c-3f83-a7fa-e686f82fbb3b",
                                                "text": "\"Equals\" is a reflexive relation, as it holds for all possible x; \"not less\" is non-reflexive because it is true only for some x and y, \"unequal\" is irreflexive, as it never holds between x and itself."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ce5db26d-de29-3d76-b49c-aff4905240da",
                                        "entry_id": "a574d754-1cbd-32ed-97a6-d5f730a40804",
                                        "glosses": [
                                            "Of or resulting from a reflex."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "11e29473-2a20-4f53-9a9b-0840f98e17a0",
                                                "sense_id": "ce5db26d-de29-3d76-b49c-aff4905240da",
                                                "text": "The electric shock elicited an automatic and reflexive response from him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "290eb95a-edbc-3e85-9b69-e7eef09d3233",
                                        "entry_id": "a574d754-1cbd-32ed-97a6-d5f730a40804",
                                        "glosses": [
                                            "Producing immediate response, spontaneous."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d4676f78-2936-45cb-adbc-33757066c7fd",
                                                "sense_id": "290eb95a-edbc-3e85-9b69-e7eef09d3233",
                                                "text": "a reflexive dislike"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1850dfcd-e756-35c7-820c-b2ab9a43b25d",
                                        "entry_id": "a574d754-1cbd-32ed-97a6-d5f730a40804",
                                        "glosses": [
                                            "Producing or provoking a reciprocal response."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dc1dea1c-a6c5-4126-8a1b-0cff2f1d8aea",
                                                "sense_id": "1850dfcd-e756-35c7-820c-b2ab9a43b25d",
                                                "text": "Shoigu's thinly veiled nuclear threats against NATO are part of the Kremlin's broader reflexive control campaign to influence Western decision-making in Russia's favor and against Western states' own interests. Shoigu's nuclear threats are attempts to push European states to self-deter and reduce their buildups of their defenses – leaving NATO's eastern border largely undefended. These reflexive control efforts are in line with Russian President Vladimir Putin's 2021 demand before launching his full-scale invasion of Ukraine that NATO not deploy any military forces to states that became NATO members after 1997, including Poland, Estonia, Latvia, Lithuania, and Poland."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2708fdb0-14cb-309d-b446-c34aa29f922b",
                                        "entry_id": "a574d754-1cbd-32ed-97a6-d5f730a40804",
                                        "glosses": [
                                            "Synonym of reflective."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
