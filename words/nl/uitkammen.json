{
    "word_family": [
        "kam",
        "kammen",
        "kammer"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2f216808-98fa-30f2-8372-33a6c18d9fd9",
                    "sense_definition": "door grondig kammen in orde brengen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "verzorging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij <w>kamde</w> het haar van haar dochter zorgvuldig <w>uit</w>.",
                            "target_lang_translations": {
                                "fr": "Elle a soigneusement <w>démêlé</w> les cheveux de sa fille."
                            }
                        },
                        {
                            "text": "Het is belangrijk om klitten uit lang haar te <w>uit</w> te <w>kammen</w>.",
                            "target_lang_translations": {
                                "fr": "Il est important de <w>démêler</w> les nœuds des cheveux longs."
                            }
                        }
                    ],
                    "common_phrases": [
                        "haar uitkammen"
                    ],
                    "target_lang_definitions": {
                        "fr": "Démêler ou mettre en ordre les cheveux en les peignant soigneusement."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "démêler",
                                "target_lang_sense_clarification": "enlever les nœuds des cheveux"
                            },
                            {
                                "target_lang_word": "peigner",
                                "target_lang_sense_clarification": "passer le peigne dans les cheveux"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3a698032-4c04-34fc-818a-f207e8ec96e2",
                    "sense_definition": "zorgvuldig doorzoeken",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "onderzoek",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De politie <w>kamde</w> het hele bos <w>uit</w> op zoek naar de vermiste persoon.",
                            "target_lang_translations": {
                                "fr": "La police a <w>ratissé</w> toute la forêt à la recherche de la personne disparue."
                            }
                        },
                        {
                            "text": "De rechercheurs <w>kamden</w> de administratie <w>uit</w> om bewijzen te vinden.",
                            "target_lang_translations": {
                                "fr": "Les enquêteurs ont <w>fouillé</w> l'administration pour trouver des preuves."
                            }
                        }
                    ],
                    "synonyms": [
                        "doorzoeken",
                        "afspeuren"
                    ],
                    "common_phrases": [
                        "gebied uitkammen"
                    ],
                    "target_lang_definitions": {
                        "fr": "Rechercher quelque chose de manière très minutieuse et systématique."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "ratisser",
                                "target_lang_sense_clarification": "fouiller un terrain de manière méthodique"
                            },
                            {
                                "target_lang_word": "fouiller",
                                "target_lang_sense_clarification": "examiner un lieu ou des documents en détail"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cf1742ab-9703-3a12-b5ec-e4e188146540",
                    "sense_definition": "met een kam wegnemen uit",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "verzorging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Gebruik een luizenkam om de neten uit het haar te <w>uit</w> te <w>kammen</w>.",
                            "target_lang_translations": {
                                "fr": "Utilisez un peigne anti-poux pour <w>enlever</w> les lentes des cheveux."
                            }
                        },
                        {
                            "text": "Ze <w>kamde</w> de luizen uit het haar van haar zoon <w>uit</w>.",
                            "target_lang_translations": {
                                "fr": "Elle a <w>peigné</w> les cheveux de son fils pour enlever les poux."
                            }
                        }
                    ],
                    "common_phrases": [
                        "luizen uitkammen"
                    ],
                    "target_lang_definitions": {
                        "fr": "Retirer quelque chose (comme des poux ou des lentes) des cheveux à l'aide d'un peigne."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "enlever",
                                "target_lang_sense_clarification": "retirer des parasites avec un peigne"
                            },
                            {
                                "target_lang_word": "peigner",
                                "target_lang_sense_clarification": "extraire par le peignage"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}