                        "cross_references": [
                            {
                                "target_word": "accurate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1e332250-42a0-3a69-a64d-ab8d4a99b72b",
                                        "entry_id": "f53e99c5-73b1-300e-9d12-817c74927f6b",
                                        "glosses": [
                                            "Telling the truth or giving a true result; exact; not defective or faulty"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ac3a0a9-4d2f-451f-82e9-2139979fd31e",
                                                "sense_id": "1e332250-42a0-3a69-a64d-ab8d4a99b72b",
                                                "text": "an accurate calculator"
                                            },
                                            {
                                                "example_id": "cc2a6e97-4948-4836-92a9-602c239cc628",
                                                "sense_id": "1e332250-42a0-3a69-a64d-ab8d4a99b72b",
                                                "text": "an accurate measure"
                                            },
                                            {
                                                "example_id": "dd4e8f0a-3980-441b-b029-8b5052b4face",
                                                "sense_id": "1e332250-42a0-3a69-a64d-ab8d4a99b72b",
                                                "text": "accurate knowledge"
                                            },
                                            {
                                                "example_id": "a3bb4da8-8164-4c19-9091-2ab0c9ec3557",
                                                "sense_id": "1e332250-42a0-3a69-a64d-ab8d4a99b72b",
                                                "text": "For more than 90% of the figures (mostly drawn during 1976-1990), either a scale, or the given magnification, will allow the user to derive accurate measurements, even when these are lacking in the diagnosis."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7a3c0140-3f1c-3a62-b77e-e3ac4cd2559f",
                                        "entry_id": "f53e99c5-73b1-300e-9d12-817c74927f6b",
                                        "glosses": [
                                            "Deviating only slightly or within acceptable limits."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8813a1e5-dc55-4584-88ce-2a6fd061ddc4",
                                                "sense_id": "7a3c0140-3f1c-3a62-b77e-e3ac4cd2559f",
                                                "text": "My horoscopes I read last week were surprisingly accurate."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6b45a460-7e88-3410-9ce9-ff61c8711280",
                                        "entry_id": "f53e99c5-73b1-300e-9d12-817c74927f6b",
                                        "glosses": [
                                            "Precisely fixed; executed with care; careful."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e28ff4d2-473d-4b4e-8c0a-28546d942a13",
                                                "sense_id": "6b45a460-7e88-3410-9ce9-ff61c8711280",
                                                "text": "for that is the fume of those, that conceive the celestial bodies have more accurate influences upon these things below, than indeed they have"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "568ee20d-f052-4ea3-92f1-a61a66efaaa7",
                        "source_entry_id": "d05da6d9-6611-3bb4-8d40-14a0d82d93d1",
                        "source_sense_id": "53abbbd1-4a9e-346e-9d3a-552f783f63f8",
                        "target_lang_word": "precise",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "precise",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c94e522b-36e5-378b-9124-5c1be71f69a1",
                                        "entry_id": "a8da898d-ce42-3a60-baa1-81717bd49c13",
                                        "glosses": [
                                            "Both exact and accurate."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "00adeaf9-c7d0-4d32-9027-a39c1e3ec2bb",
                                                "sense_id": "c94e522b-36e5-378b-9124-5c1be71f69a1",
                                                "text": "A memory is \"precise\" when the occurrences that would verify it are narrowly circumscribed: for instance, \"I met Jones\" is precise as compared to \"I met a man.\" A memory is \"accurate\" when it is both precise and true, i.e. in the above instance, if it was Jones I met."
                                            },
                                            {
                                                "example_id": "4b5c77b3-1687-4be1-8071-3cd46c0a3cb6",
                                                "sense_id": "c94e522b-36e5-378b-9124-5c1be71f69a1",
                                                "text": "Individually, some of these definitions fall into the common definitional trap of being overly precise."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7eb57d31-8228-339a-98df-f950a1459ad1",
                                        "entry_id": "a8da898d-ce42-3a60-baa1-81717bd49c13",
                                        "glosses": [
                                            "Consistent, clustered close together, agreeing with each other (this does not mean that they cluster near the true, correct, or accurate value)."
                                        ],
                                        "tags": [
                                            "of data points"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fe5b0ce8-d2a3-31fd-9a6c-ce396e7db219",
                                        "entry_id": "a8da898d-ce42-3a60-baa1-81717bd49c13",
                                        "glosses": [
                                            "Adhering too much to rules; prim or punctilious."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "precise",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6de424d6-fea2-39a4-9064-5213819229fe",
                                        "entry_id": "15a845fb-6a9f-35d3-8d9e-29d00b4404d2",
                                        "glosses": [
                                            "To make or render precise; to specify."
