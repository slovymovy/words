                                "target_senses": [
                                    {
                                        "sense_id": "56d3e75d-18dd-385f-89c3-b692fbf83b23",
                                        "entry_id": "f9ad5702-2380-3444-819a-5fd135b03532",
                                        "glosses": [
                                            "Celui qui est en train de dormir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c7a48e8a-8c74-4dce-b78f-948c45eced52",
                                                "sense_id": "56d3e75d-18dd-385f-89c3-b692fbf83b23",
                                                "text": "« Le garçon se laissait faire, muet et incrédule, visiblement écrasé par les bontés excessives que la Providence déversait sur lui, souriant avec la béatitude du dormeur qui se demande à quel moment on viendra le réveiller à la réalité du monde…"
                                            },
                                            {
                                                "example_id": "57e7d6f5-296f-49e5-97a3-9f8a77f40510",
                                                "sense_id": "56d3e75d-18dd-385f-89c3-b692fbf83b23",
                                                "text": "Ce n’était pas un des estafiers de Jean-sans-Peur ; pas davantage un de ces veilleurs nocturnes, horloges parlantes de l’époque, qui réveillaient les dormeurs pour les inviter à reposer sans crainte."
                                            },
                                            {
                                                "example_id": "85185b8d-5afd-4435-b159-fc7b0c5ec168",
                                                "sense_id": "56d3e75d-18dd-385f-89c3-b692fbf83b23",
                                                "text": "Le pion se précipite sur le petit dormeur, le secoue d'importance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "29463c5d-e420-3ba3-bf5e-86db117da5d6",
                                        "entry_id": "f9ad5702-2380-3444-819a-5fd135b03532",
                                        "glosses": [
                                            "Celui qui aime dormir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "324fa45d-fb32-4ce2-87b1-719efe4df885",
                                                "sense_id": "29463c5d-e420-3ba3-bf5e-86db117da5d6",
                                                "text": "C’est un grand dormeur."
                                            }
                                        ]
                                    },
