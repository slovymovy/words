                "senses": [
                    {
                        "sense_id": "0a5af375-6164-3909-b01b-859b4d94a8ef",
                        "entry_id": "d26d098d-9207-3a9b-9cfd-3b346fd7abe0",
                        "glosses": [
                            "Situation, in der ein Verkehrsteilnehmer seine Fahrtrichtung bogenartig ändert oder ändern will"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee04a6bd-38ad-4c0c-a587-a99fbb928853",
                                "sense_id": "0a5af375-6164-3909-b01b-859b4d94a8ef",
                                "text": "„Besonders prekär: die Abbiegesituation von der Ungererstraße zum Isarring.“"
                            },
                            {
                                "example_id": "00e617f0-3789-49a4-b976-3fd9c97c3d78",
                                "sense_id": "0a5af375-6164-3909-b01b-859b4d94a8ef",
                                "text": "„Die Idee, eine Fahrspur des Rings für Busse, Fiaker und Radler zu reservieren, habe man wegen der schwierigen Abbiegesituation im Konflikt mit der Straßenbahn wieder verworfen.“"
                            },
                            {
                                "example_id": "47fc7ad2-f8ca-4749-b9de-e77099a483ce",
                                "sense_id": "0a5af375-6164-3909-b01b-859b4d94a8ef",
                                "text": "„Die Abbiegesituation vor Ort werde gegenüber heute sogar verbessert, weil sich die Lieferfahrzeuge den Weg weniger lange mit den Velos teilten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
