{
    "word_family": [
        "verplichten",
        "verplichting",
        "plicht"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "fe49deda-cd25-3438-ac54-4b079710e6fd",
                    "sense_definition": "iets wat moet gebeuren volgens de wet of een regel",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "obligation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wiskunde is een <w>verplicht</w> vak op bijna elke middelbare school.",
                            "target_lang_translations": {
                                "en": "Mathematics is a <w>compulsory</w> subject at almost every high school.",
                                "ru": "Математика — это <w>обязательный</w> предмет почти в каждой средней школе."
                            }
                        },
                        {
                            "text": "Het dragen van een helm is <w>verplicht</w> voor alle motorrijders.",
                            "target_lang_translations": {
                                "en": "Wearing a helmet is <w>mandatory</w> for all motorcyclists.",
                                "ru": "Ношение шлема <w>обязательно</w> для всех мотоциклистов."
                            }
                        }
                    ],
                    "synonyms": [
                        "noodzakelijk",
                        "vereist",
                        "gedwongen"
                    ],
                    "antonyms": [
                        "facultatief",
                        "optioneel"
                    ],
                    "common_phrases": [
                        "verplicht vak",
                        "wettelijk verplicht",
                        "verplicht stellen"
                    ],
                    "target_lang_definitions": {
                        "en": "something that must happen according to the law or a rule",
                        "ru": "то, что должно произойти в соответствии с законом или правилом"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "compulsory",
                                "target_lang_sense_clarification": "required by law or a rule, especially in education"
                            },
                            {
                                "target_lang_word": "mandatory",
                                "target_lang_sense_clarification": "required by law or mandate; not optional"
                            },
                            {
                                "target_lang_word": "obligatory",
                                "target_lang_sense_clarification": "required by a legal, moral, or social rule"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "обязательный",
                                "target_lang_sense_clarification": "требуемый по закону или правилам"
                            },
                            {
                                "target_lang_word": "принудительный",
                                "target_lang_sense_clarification": "осуществляемый по принуждению"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0c4b471e-4030-377a-a9cc-4be96c69ce05",
                    "sense_definition": "voltooid deelwoord van <w>verplichten</w>",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "verb_form",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De overheid heeft ons <w>verplicht</w> om deze formulieren in te vullen.",
                            "target_lang_translations": {
                                "en": "The government has <w>obliged</w> us to fill out these forms.",
                                "ru": "Правительство <w>обязало</w> нас заполнить эти формы."
                            }
                        },
                        {
                            "text": "Zij voelde zich <w>verplicht</w> om haar buren te helpen met de verhuizing.",
                            "target_lang_translations": {
                                "en": "She felt <w>obliged</w> to help her neighbors with the move.",
                                "ru": "Она чувствовала себя <w>обязанной</w> помочь соседям с переездом."
                            }
                        }
                    ],
                    "common_phrases": [
                        "zich verplicht voelen"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "past participle of 'to oblige' or 'to compel'",
                        "ru": "причастие прошедшего времени от глагола 'обязывать' или 'принуждать'"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "obliged",
                                "target_lang_sense_clarification": "feeling a moral or legal duty to do something"
                            },
                            {
                                "target_lang_word": "compelled",
                                "target_lang_sense_clarification": "forced or driven to do something"
                            },
                            {
                                "target_lang_word": "required",
                                "target_lang_sense_clarification": "made necessary by rules or circumstances"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "обязал",
                                "target_lang_sense_clarification": "в значении принуждения со стороны закона или власти"
                            },
                            {
                                "target_lang_word": "обязанный",
                                "target_lang_sense_clarification": "чувствующий моральный или юридический долг"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a4314f9f-0f4a-32a9-92a1-0b2ded59522e",
                    "sense_definition": "enkelvoud tegenwoordige tijd van <w>verplichten</w>",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "verb_form",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Deze nieuwe wet <w>verplicht</w> bedrijven om hun uitstoot te verminderen.",
                            "target_lang_translations": {
                                "en": "This new law <w>obliges</w> companies to reduce their emissions.",
                                "ru": "Этот новый закон <w>обязывает</w> компании сократить свои выбросы."
                            }
                        },
                        {
                            "text": "De leraar <w>verplicht</w> de leerlingen om elke dag een uur te lezen.",
                            "target_lang_translations": {
                                "en": "The teacher <w>requires</w> the students to read for an hour every day.",
                                "ru": "Учитель <w>заставляет</w> учеников читать по часу каждый день."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present indicative"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "singular present tense of 'to oblige' or 'to compel'",
                        "ru": "форма единственного числа настоящего времени глагола 'обязывать' или 'принуждать'"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "obliges",
                                "target_lang_sense_clarification": "legally or morally binds someone to an action"
                            },
                            {
                                "target_lang_word": "compels",
                                "target_lang_sense_clarification": "forces someone to do something"
                            },
                            {
                                "target_lang_word": "requires",
                                "target_lang_sense_clarification": "makes something necessary according to a rule"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "обязывает",
                                "target_lang_sense_clarification": "накладывает юридическое или моральное обязательство"
                            },
                            {
                                "target_lang_word": "принуждает",
                                "target_lang_sense_clarification": "заставляет кого-либо совершить действие"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a51ccc9f-566c-3fb4-815d-34072fc76546",
                    "sense_definition": "gebiedende wijs van <w>verplichten</w>",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "verb_form",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Verplicht</w> hen niet tot actie als ze er nog niet klaar voor zijn.",
                            "target_lang_translations": {
                                "en": "Do not <w>compel</w> them to take action if they are not ready yet.",
                                "ru": "Не <w>принуждай</w> их к действию, если они еще не готовы."
                            }
                        },
                        {
                            "text": "<w>Verplicht</w> jezelf tot een gezonde levensstijl voor een beter resultaat.",
                            "target_lang_translations": {
                                "en": "<w>Commit</w> yourself to a healthy lifestyle for a better result.",
                                "ru": "<w>Обяжи</w> себя вести здоровый образ жизни для достижения лучшего результата."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "imperative"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "imperative form of 'to oblige' or 'to compel'",
                        "ru": "повелительное наклонение глагола 'обязывать' или 'принуждать'"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "oblige",
                                "target_lang_sense_clarification": "command to bind someone to a duty"
                            },
                            {
                                "target_lang_word": "compel",
                                "target_lang_sense_clarification": "command to force someone to act"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "обязывай",
                                "target_lang_sense_clarification": "приказ наложить обязательство"
                            },
                            {
                                "target_lang_word": "принуждай",
                                "target_lang_sense_clarification": "приказ заставить кого-то действовать"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}