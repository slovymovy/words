                        ],
                        "form": "го́ном"
                    },
                    {
                        "form_id": "422e7f40-f2bf-44de-9be6-14ea43ab23c6",
                        "entry_id": "f827252a-1e6b-3b7d-9733-9ea6b3effc3c",
                        "tags": [
