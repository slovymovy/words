                        "entry_id": "905a2fc9-cb22-3036-9f50-7619596f3b9d",
                        "glosses": [
                            "Qui peut être destitué."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f563026-bd46-4e8e-b2cc-b9ee3d929f64",
                                "sense_id": "8f8cacca-95a0-3bcd-93a7-d6a2fb43c9d0",
                                "text": "Chaque tribunal civil est composé de vingt juges au moins ; d’un commissaire et d’un substitut nommé et destituable par le directoire exécutif, et d’un greffier."
                            },
                            {
                                "example_id": "8ecd9faa-5aa0-4743-a840-2e952b635934",
                                "sense_id": "8f8cacca-95a0-3bcd-93a7-d6a2fb43c9d0",
                                "text": "Un tuteur est destituable si, par sa négligence, sa pupille a été séduite, surtout si elle a été séduite par le fils même du tuteur."
                            },
                            {
                                "example_id": "239924fb-e7c1-4bad-a0b2-197a1af89e5c",
                                "sense_id": "8f8cacca-95a0-3bcd-93a7-d6a2fb43c9d0",
                                "text": "M. de Cormenin, que la Liste civile bénisse ! semble affirmer que le roi des Français est un employé à douze millions d’appointements, destituable à coups de pavé dans la rue par le peuple, et à coup de vote par la Chambre."
                            }
                        ]
                    }
