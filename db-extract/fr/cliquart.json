                                        "sense_id": "1a4b665b-0355-3ba8-acc9-b6ecb17f2541",
                                        "entry_id": "c933cdd9-4a9a-30df-a3ec-4a08f408f539",
                                        "glosses": [
                                            "To convert or be converted into clinker."
