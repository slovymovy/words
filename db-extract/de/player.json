                                                "sense_id": "bdcb9867-a849-34fe-a0d2-30a964e924f8",
                                                "text": "He is a player for the Australian team."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6beb90f8-707f-32cc-9865-cfaa57a5ed06",
