                ],
                "senses": [
                    {
                        "sense_id": "b8f9a76d-48b0-36b9-bede-3a5e7a385884",
                        "entry_id": "f50f8285-5bd1-34e6-a553-67b5baceeb9b",
                        "glosses": [
                            "to cost; to come to"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "37bc9734-a216-4cd7-bf14-2c59ea1c4c8c",
                                "sense_id": "b8f9a76d-48b0-36b9-bede-3a5e7a385884",
                                "text": "Э́то вам до́рого обойдётся.",
                                "translation": "It will cost you dearly. (literal and figurative senses)",
                                "english": "It will cost you dearly. (literal and figurative senses)"
                            },
                            {
                                "example_id": "742fb431-6f4b-4769-8327-940692461c8a",
                                "sense_id": "b8f9a76d-48b0-36b9-bede-3a5e7a385884",
                                "text": "Во ско́лько вам обошёлся после́дний визи́т в ветерина́рную кли́нику?",
                                "translation": "How much did your last visit to the veterinary clinic cost you?",
                                "english": "How much did your last visit to the veterinary clinic cost you?"
                            }
                        ]
                    },
                    {
                        "sense_id": "8ec5bfa1-4695-3da3-9269-a6873f698155",
                        "entry_id": "f50f8285-5bd1-34e6-a553-67b5baceeb9b",
                        "glosses": [
                            "to treat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6da195b9-8032-475e-a41b-94936b878657",
                                "sense_id": "8ec5bfa1-4695-3da3-9269-a6873f698155",
                                "text": "Со мной там обошли́сь о́чень пло́хо.",
                                "translation": "They treated me very badly there.",
                                "english": "They treated me very badly there."
                            }
                        ]
                    },
                    {
                        "sense_id": "f55bcb1a-972c-363c-9b30-5c7815149e12",
                        "entry_id": "f50f8285-5bd1-34e6-a553-67b5baceeb9b",
                        "glosses": [
                            "to be able to do without"
                        ],
                        "tags": [
                            "in the negative"
                        ],
                        "examples": [
                            {
                                "example_id": "69710dc7-f938-4b1e-8269-803566627cd2",
                                "sense_id": "f55bcb1a-972c-363c-9b30-5c7815149e12",
                                "text": "Без уче́бников не обойти́сь.",
                                "translation": "One cannot do without textbooks.",
                                "english": "One cannot do without textbooks."
                            },
                            {
                                "example_id": "270bcaa2-11ee-496e-a263-e1fb5bf86b29",
                                "sense_id": "f55bcb1a-972c-363c-9b30-5c7815149e12",
                                "text": "Он и дня́ не мо́г обойти́сь без во́дки.",
                                "translation": "He couldn't do (even) a day without vodka.",
                                "english": "He couldn't do (even) a day without vodka."
                            }
                        ]
                    },
                    {
                        "sense_id": "666bfe80-5396-325f-92d6-ba4b99f79ea5",
                        "entry_id": "f50f8285-5bd1-34e6-a553-67b5baceeb9b",
                        "glosses": [
                            "to turn out, to work out"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2fe90ad0-e2ae-4856-9fb3-9b27cdd39eb6",
                                "sense_id": "666bfe80-5396-325f-92d6-ba4b99f79ea5",
                                "text": "Всё обошло́сь",
                                "translation": "Everything turned out all right.",
                                "english": "Everything turned out all right."
                            }
                        ]
                    },
                    {
                        "sense_id": "db89264e-3914-3830-8255-619821fae652",
