                        "cross_references": [
                            {
                                "target_word": "demonic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d1e0caff-b733-3e67-849c-25b2f533b04c",
                                        "entry_id": "e04167e7-6307-34fc-be8f-460767016312",
                                        "glosses": [
                                            "Pertaining to demons or evil spirits; demoniac."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7156f4e9-70b3-4afc-aea1-edade747b108",
                                                "sense_id": "d1e0caff-b733-3e67-849c-25b2f533b04c",
                                                "text": "Convinced that his uncle was a warlock, he rifled through his attic, looking for demonic artifacts."
                                            },
                                            {
                                                "example_id": "813395ee-96e5-4a42-982e-c41270de4dd5",
                                                "sense_id": "d1e0caff-b733-3e67-849c-25b2f533b04c",
                                                "text": "Once he had grasped the controls, he unleashed a demonic laugh that made his hostages shudder."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1419110a-7da1-3e43-a4c0-0ce8b7d33d50",
                                        "entry_id": "e04167e7-6307-34fc-be8f-460767016312",
                                        "glosses": [
                                            "Pertaining to daemons in ancient Greek thought; concerning supernatural ‘genius’."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3dd37937-2c89-4418-92d0-be7ad7b87bc8",
                                                "sense_id": "1419110a-7da1-3e43-a4c0-0ce8b7d33d50",
                                                "text": "Aristotle concedes that the nature of the dream is indeed daemonic [translating dämonischer], but not divine – which might well reveal a profound meaning, if one could hit on the right translation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9677faae-ea53-3cc8-a287-ae93990b5586",
                                        "entry_id": "e04167e7-6307-34fc-be8f-460767016312",
                                        "glosses": [
                                            "Extremely cruel or evil; abhorrent or repugnant; diabolical."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a72125e2-bdd6-49ab-a3f0-38f69d325c0d",
                                                "sense_id": "9677faae-ea53-3cc8-a287-ae93990b5586",
                                                "text": "Lifton goes on to argue that they can commit these demonic acts because they rationalize their behaviour. A whole array of rationalizations justified the murder of innocent men, women and children."
                                            },
                                            {
                                                "example_id": "d5c6304e-f31e-4069-89e6-fe991f109d05",
                                                "sense_id": "9677faae-ea53-3cc8-a287-ae93990b5586",
                                                "text": "Texts show the star prime time host Tucker Carlson calling Mr. Trump a “demonic force,” […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
