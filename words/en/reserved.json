{
    "word_family": [
        "reservation",
        "reservist",
        "unreserved"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "49d6db3a-3457-33b7-b47d-c89537f0f5fa",
                    "sense_definition": "Set aside for a particular person or purpose; spoken for.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "allocation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I am sorry, sir, but these are <w>reserved</w> seats.",
                            "target_lang_translations": {
                                "ru": "Простите, сэр, но это <w>зарезервированные</w> места.",
                                "zh": "先生，很抱歉，这些座位是<w>预留的</w>。"
                            }
                        },
                        {
                            "text": "We parked our car in the space <w>reserved</w> for staff members.",
                            "target_lang_translations": {
                                "ru": "Мы припарковали машину на месте, <w>отведённом</w> для сотрудников.",
                                "zh": "我们将车停在了员工<w>专用</w>车位上。"
                            }
                        }
                    ],
                    "synonyms": [
                        "allocated",
                        "assigned",
                        "dedicated",
                        "booked",
                        "kept"
                    ],
                    "antonyms": [
                        "available",
                        "free",
                        "unreserved",
                        "public"
                    ],
                    "common_phrases": [
                        "reserved seat",
                        "reserved parking",
                        "all rights reserved",
                        "reserved table"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отложенный или предназначенный для конкретного человека или цели; занятый.",
                        "zh": "为特定的人或目的而预留的；已有人预定的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зарезервированный",
                                "target_lang_sense_clarification": "общий термин"
                            },
                            {
                                "target_lang_word": "забронированный",
                                "target_lang_sense_clarification": "о билетах, столиках, номерах"
                            },
                            {
                                "target_lang_word": "отведённый",
                                "target_lang_sense_clarification": "предназначенный для определенной цели"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "预留的",
                                "target_lang_sense_clarification": "指为特定用途或人保留的"
                            },
                            {
                                "target_lang_word": "已预订的",
                                "target_lang_sense_clarification": "指座位、房间等已被预订"
                            },
                            {
                                "target_lang_word": "专用",
                                "target_lang_sense_clarification": "指为特定用途或人保留的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "917b3c18-56e1-3477-8ac3-9478b28ff036",
                    "sense_definition": "Slow to reveal emotion or opinions.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "personality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was a quiet, <w>reserved</w> person who rarely spoke about himself.",
                            "target_lang_translations": {
                                "ru": "Он был тихим, <w>сдержанным</w> человеком, который редко говорил о себе.",
                                "zh": "他是一个安静且<w>内向</w>的人，很少谈论自己。"
                            }
                        },
                        {
                            "text": "She has a <w>reserved</w> nature and takes time to warm up to new people.",
                            "target_lang_translations": {
                                "ru": "У нее <w>замкнутый</w> характер, и ей нужно время, чтобы привыкнуть к новым людям.",
                                "zh": "她性格<w>矜持</w>，需要一段时间才能和新认识的人熟络起来。"
                            }
                        }
                    ],
                    "synonyms": [
                        "quiet",
                        "reticent",
                        "aloof",
                        "distant",
                        "undemonstrative",
                        "taciturn",
                        "standoffish"
                    ],
                    "antonyms": [
                        "outgoing",
                        "sociable",
                        "open",
                        "demonstrative"
                    ],
                    "common_phrases": [
                        "reserved nature",
                        "reserved manner",
                        "remain reserved"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сдержанный в проявлении эмоций или мнений; необщительный.",
                        "zh": "在表达情感或观点时表现得不积极、不外露；内向的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сдержанный",
                                "target_lang_sense_clarification": "умеющий владеть собой"
                            },
                            {
                                "target_lang_word": "замкнутый",
                                "target_lang_sense_clarification": "необщительный, погруженный в себя"
                            },
                            {
                                "target_lang_word": "скрытный",
                                "target_lang_sense_clarification": "не склонный делиться мыслями"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "内向的",
                                "target_lang_sense_clarification": "性格不外向"
                            },
                            {
                                "target_lang_word": "矜持的",
                                "target_lang_sense_clarification": "态度庄重、含蓄"
                            },
                            {
                                "target_lang_word": "含蓄的",
                                "target_lang_sense_clarification": "不轻易流露情感"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8af8a4ff-b736-37ec-8316-00256592e07f",
                    "sense_definition": "Simple past and past participle of <w>reserve</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>reserved</w> a table for two at the Italian restaurant.",
                            "target_lang_translations": {
                                "ru": "Она <w>забронировала</w> столик на двоих в итальянском ресторане.",
                                "zh": "她在意大利餐厅<w>预订了</w>一张双人桌。"
                            }
                        },
                        {
                            "text": "The judge <w>reserved</w> his decision until the following week.",
                            "target_lang_translations": {
                                "ru": "Судья <w>отложил</w> вынесение решения до следующей недели.",
                                "zh": "法官将裁决<w>推迟</w>到了下周。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "reserved a room",
                        "reserved judgment",
                        "reserved the right"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense and participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время и причастие прошедшего времени от глагола reserve (бронировать, сохранять).",
                        "zh": "动词 reserve 的过去式和过去分词，意为预订、保留或推迟。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "забронировал",
                                "target_lang_sense_clarification": "заказал заранее"
                            },
                            {
                                "target_lang_word": "зарезервировал",
                                "target_lang_sense_clarification": "закрепил за собой"
                            },
                            {
                                "target_lang_word": "отложил",
                                "target_lang_sense_clarification": "перенес решение или действие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "预订了",
                                "target_lang_sense_clarification": "提前预订服务或位置"
                            },
                            {
                                "target_lang_word": "保留了",
                                "target_lang_sense_clarification": "留存某物或权利"
                            },
                            {
                                "target_lang_word": "推迟了",
                                "target_lang_sense_clarification": "延后做出决定"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}