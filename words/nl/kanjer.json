{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ec4415f5-2abd-3987-a68c-bd34e986592c",
                    "sense_definition": "Iemand die bewondering verdient vanwege een geweldige prestatie of een fijn karakter; een uitblinker of held.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "uitblinker",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wauw, wat een <w>kanjer</w> ben jij dat je dat examen hebt gehaald!",
                            "target_lang_translations": {
                                "en": "Wow, what a <w>star</w> you are for passing that exam!"
                            }
                        },
                        {
                            "text": "Zij is echt een <w>kanjer</w> die altijd voor iedereen klaarstaat.",
                            "target_lang_translations": {
                                "en": "She is truly a <w>gem</w> who is always there for everyone."
                            }
                        }
                    ],
                    "synonyms": [
                        "kei",
                        "uitblinker",
                        "flinkerd"
                    ],
                    "common_phrases": [
                        "echt een kanjer"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Veelal informeel gebruikt als compliment."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Someone who deserves admiration because of a great achievement or a wonderful character; a star, champion, or gem."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "star",
                                "target_lang_sense_clarification": "referring to an outstanding person"
                            },
                            {
                                "target_lang_word": "champion",
                                "target_lang_sense_clarification": "referring to someone who did something great"
                            },
                            {
                                "target_lang_word": "gem",
                                "target_lang_sense_clarification": "referring to a wonderful, helpful person"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "181a4a2e-df51-3cf4-ac5c-145b8a27b9cc",
                    "sense_definition": "Iets wat of iemand die opvallend groot is in zijn soort.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "groot_exemplaar",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De visser ving een enorme <w>kanjer</w> van een snoek.",
                            "target_lang_translations": {
                                "en": "The fisherman caught a huge <w>whopper</w> of a pike."
                            }
                        },
                        {
                            "text": "Die nieuwe auto is echt een <w>kanjer</w> op de weg.",
                            "target_lang_translations": {
                                "en": "That new car is really a <w>beauty</w> on the road."
                            }
                        }
                    ],
                    "synonyms": [
                        "joekel",
                        "loeier",
                        "knoeperd"
                    ],
                    "common_phrases": [
                        "kanjer van een"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Informeel gebruikt voor grote objecten of dieren."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Something or someone that is remarkably large or impressive of its kind."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "whopper",
                                "target_lang_sense_clarification": "something remarkably large"
                            },
                            {
                                "target_lang_word": "beauty",
                                "target_lang_sense_clarification": "an outstandingly large or fine specimen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "273313d1-4a69-3e51-a671-a14bb5c6b557",
                    "sense_definition": "Een lui of opschepperig persoon.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die luie <w>kanjer</w> voert de hele dag helemaal niets uit.",
                            "target_lang_translations": {
                                "en": "That lazy <w>slacker</w> doesn't do a single thing all day."
                            }
                        },
                        {
                            "text": "Geloof hem niet, hij is slechts een opschepperige <w>kanjer</w>.",
                            "target_lang_translations": {
                                "en": "Don't believe him, he is just a boastful <w>braggart</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "In deze betekenis verouderd."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A lazy or boastful person."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "slacker",
                                "target_lang_sense_clarification": "a lazy person"
                            },
                            {
                                "target_lang_word": "braggart",
                                "target_lang_sense_clarification": "a boastful person"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9dcaa89e-5944-3e73-8f5e-23a8411e2c2b",
                    "sense_definition": "Een kwakzalver of charlatan.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De zieke man werd bedrogen door een gewetenloze <w>kanjer</w>.",
                            "target_lang_translations": {
                                "en": "The sick man was deceived by an unprincipled <w>quack</w>."
                            }
                        },
                        {
                            "text": "Die zogenaamde dokter bleek achteraf een ordinaire <w>kanjer</w> te zijn.",
                            "target_lang_translations": {
                                "en": "That so-called doctor turned out to be a common <w>charlatan</w> in the end."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "In deze betekenis niet meer in gebruik."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A quack or charlatan."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "quack",
                                "target_lang_sense_clarification": "an unqualified person claiming medical knowledge"
                            },
                            {
                                "target_lang_word": "charlatan",
                                "target_lang_sense_clarification": "a fraud or deceiver"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}