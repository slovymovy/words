    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "749dfb14-479e-35ec-8110-25af34b7738d",
                    "sense_definition": "Connected or associated with something else.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "connection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Electric and magnetic forces are closely <w>related</w>.",
                            "target_lang_translations": {
                                "ru": "Электрические и магнитные силы тесно <w>связаны</w>.",
                                "pl": "Siły elektryczne i magnetyczne są ze sobą ściśle <w>związane</w>.",
                                "zh": "电磁力之间有着紧密的<w>联系</w>。"
                            }
                        },
                        {
                            "text": "We discussed several <w>related</w> topics during the meeting.",
                            "target_lang_translations": {
                                "ru": "Во время встречи мы обсудили несколько <w>смежных</w> тем.",
                                "pl": "Podczas spotkania omówiliśmy kilka <w>pokrewnych</w> tematów.",
                                "zh": "我们在会议期间讨论了几个<w>相关</w>的话题。"
                            }
                        }
                    ],
                    "synonyms": [
                        "connected",
                        "linked"
                    ],
                    "antonyms": [
                        "unrelated",
                        "non-related"
                    ],
                    "common_phrases": [
                        "closely related",
                        "directly related",
                        "related to"
                    ],
                    "target_lang_definitions": {
                        "ru": "Связанный или ассоциирующийся с чем-то другим.",
                        "pl": "Połączony lub kojarzony z czymś innym.",
                        "zh": "与某事物有联系或相关联。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "связанный",
                                "target_lang_sense_clarification": "соединенный или имеющий отношение"
                            },
                            {
                                "target_lang_word": "смежный",
                                "target_lang_sense_clarification": "касающийся похожей темы"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "związany",
                                "target_lang_sense_clarification": "mający związek z czymś"
                            },
                            {
                                "target_lang_word": "powiązany",
                                "target_lang_sense_clarification": "pozostający w relacji z czymś"
                            },
                            {
                                "target_lang_word": "pokrewny",
                                "target_lang_sense_clarification": "dotyczący podobnej tematyki"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "相关",
                                "target_lang_sense_clarification": "指事物之间存在联系"
                            },
                            {
                                "target_lang_word": "有关",
                                "target_lang_sense_clarification": "指与某事有关系"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d2b52965-adcf-3898-a503-ad35f70155ff",
                    "sense_definition": "Belonging to the same family.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "family",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Everyone is <w>related</w> to their parents.",
                            "target_lang_translations": {
                                "ru": "Все <w>состоят в родстве</w> со своими родителями.",
                                "pl": "Każdy jest <w>spokrewniony</w> ze swoimi rodzicami.",
                                "zh": "每个人都与自己的父母有<w>亲属关系</w>。"
                            }
                        },
                        {
                            "text": "She was surprised to find she is <w>related</w> to a famous actor.",
                            "target_lang_translations": {
                                "ru": "Она с удивлением обнаружила, что <w>состоит в родстве</w> с известным актером.",
                                "pl": "Była zaskoczona, gdy dowiedziała się, że jest <w>spokrewniona</w> ze sławnym aktorem.",
                                "zh": "她惊讶地发现自己和一位著名演员有<w>亲戚</w>关系。"
                            }
                        }
                    ],
                    "synonyms": [
                        "kin"
                    ],
                    "antonyms": [
                        "unrelated"
                    ],
                    "common_phrases": [
                        "related by blood",
                        "distantly related"
                    ],
                    "target_lang_definitions": {
                        "ru": "Принадлежащий к одной семье; состоящий в родстве.",
                        "pl": "Należący do tej samej rodziny; spokrewniony.",
                        "zh": "属于同一个家庭；有亲属关系。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "родственный",
                                "target_lang_sense_clarification": "имеющий общих предков"
                            },
                            {
                                "target_lang_word": "состоящий в родстве",
                                "target_lang_sense_clarification": "быть родственником"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "spokrewniony",
                                "target_lang_sense_clarification": "mający wspólnych przodków"
                            },
                            {
                                "target_lang_word": "z rodziny",
                                "target_lang_sense_clarification": "będący krewnym"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "有亲属关系",
                                "target_lang_sense_clarification": "指血缘或姻亲关系"
                            },
                            {
                                "target_lang_word": "亲戚",
                                "target_lang_sense_clarification": "指有血缘关系的人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "03c4f76b-612f-3e95-a063-95cef4461e52",
                    "sense_definition": "Associated with the specific thing mentioned, often used in combination.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "connection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police are investigating a drug-<w>related</w> crime.",
                            "target_lang_translations": {
                                "ru": "Полиция расследует преступление, <w>связанное</w> с наркотиками.",
                                "pl": "Policja prowadzi dochodzenie w sprawie przestępstwa <w>związanego</w> z narkotykami.",
                                "zh": "警方正在调查一起与毒品<w>相关</w>的犯罪。"
                            }
                        },
                        {
                            "text": "Many people suffer from stress-<w>related</w> illnesses.",
                            "target_lang_translations": {
                                "ru": "Многие люди страдают от заболеваний, <w>связанных</w> со стрессом.",
                                "pl": "Wiele osób cierpi na choroby <w>wynikające</w> ze stresu.",
                                "zh": "许多人患有与压力<w>相关</w>的疾病。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "work-related",
                        "health-related",
                        "age-related"
                    ],
                    "target_lang_definitions": {
                        "ru": "Связанный с конкретным упомянутым предметом или явлением.",
                        "pl": "Związany z konkretną wymienioną rzeczą, często używany w złożeniach.",
                        "zh": "与所提到的特定事物相关，常用于复合词中。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "связанный",
                                "target_lang_sense_clarification": "имеющий отношение к чему-либо"
                            },
                            {
                                "target_lang_word": "обусловленный",
                                "target_lang_sense_clarification": "вызванный чем-либо"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "związany z",
                                "target_lang_sense_clarification": "dotyczący konkretnego zjawiska"
                            },
                            {
                                "target_lang_word": "wynikający z",
                                "target_lang_sense_clarification": "spowodowany przez coś"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "相关的",
                                "target_lang_sense_clarification": "用于修饰特定领域的事物"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "bfa826df-beef-3abe-9521-2cb5e423336a",
                    "sense_definition": "Simple past and past participle of <w>relate</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>related</w> the story of his journey to the audience.",
                            "target_lang_translations": {
                                "ru": "Он <w>рассказал</w> аудитории историю своего путешествия.",
                                "pl": "<w>Opowiedział</w> słuchaczom historię swojej podróży.",
                                "zh": "他向听众<w>讲述</w>了他旅途的故事。"
                            }
                        },
                        {
                            "text": "The researcher <w>related</w> the findings to previous studies.",
                            "target_lang_translations": {
                                "ru": "Исследователь <w>связал</w> полученные данные с предыдущими исследованиями.",
                                "pl": "Badacz <w>powiązał</w> wyniki z poprzednimi badaniami.",
                                "zh": "研究人员将这些发现与之前的研究进行了<w>联系</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense and participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время и причастие прошедшего времени от глагола relate.",
                        "pl": "Forma czasu przeszłego i imiesłów czasu przeszłego od czasownika relate.",
                        "zh": "relate 的过去式和过去分词。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рассказал",
                                "target_lang_sense_clarification": "поведал историю"
                            },
                            {
                                "target_lang_word": "связал",
                                "target_lang_sense_clarification": "установил связь"
                            },
                            {
                                "target_lang_word": "рассказанный",
                                "target_lang_sense_clarification": "причастие: изложенный"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "opowiedział",
                                "target_lang_sense_clarification": "zrelacjonował historię"
                            },
                            {
                                "target_lang_word": "powiązał",
                                "target_lang_sense_clarification": "wykazał związek między faktami"
                            },
                            {
                                "target_lang_word": "odnosił się",
                                "target_lang_sense_clarification": "miał związek z czymś"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "讲述",
                                "target_lang_sense_clarification": "叙述故事或经历"
                            },
                            {
                                "target_lang_word": "联系",
                                "target_lang_sense_clarification": "将事物建立关联"
                            }
                        ]
                    }
                }
            ]
        }
    ]
