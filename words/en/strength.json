    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5d71326e-4922-3a69-b07b-94aa4eb50bb2",
                    "sense_definition": "The quality or state of being physically strong.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It requires great <w>strength</w> to lift such heavy objects safely.",
                            "target_lang_translations": {
                                "ru": "Требуется огромная <w>сила</w>, чтобы безопасно поднимать такие тяжелые предметы.",
                                "tr": "Böyle ağır nesneleri güvenle kaldırmak büyük bir <w>güç</w> gerektirir."
                            }
                        },
                        {
                            "text": "He used all his physical <w>strength</w> to push the broken car.",
                            "target_lang_translations": {
                                "ru": "Он использовал всю свою физическую <w>силу</w>, чтобы толкать сломанную машину.",
                                "tr": "Bozuk arabayı itmek için bütün fiziksel <w>kuvvetini</w> kullandı."
                            }
                        }
                    ],
                    "synonyms": [
                        "power"
                    ],
                    "antonyms": [
                        "weakness"
                    ],
                    "common_phrases": [
                        "physical strength",
                        "brute strength",
                        "gain strength",
                        "strength of character"
                    ],
                    "target_lang_definitions": {
                        "ru": "Качество или состояние физической силы.",
                        "tr": "Fiziksel olarak güçlü olma durumu veya niteliği."
                    },
                    "translations": {
                        "ru": [
