                ],
                "senses": [
                    {
                        "sense_id": "4453b61c-9f0f-3f96-bbe8-ccae14ec9b18",
                        "entry_id": "79d179a5-653f-3beb-9169-6a4c46bf73cd",
                        "glosses": [
                            "Straße entlang einem Ufer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b71b52b1-ea50-470d-9185-a4c0a9212622",
                                "sense_id": "4453b61c-9f0f-3f96-bbe8-ccae14ec9b18",
                                "text": "„Die kurvenreiche Uferstraße, unterhalb der Steilküste, bot laufend wechselnde Ausblicke.“"
                            },
                            {
                                "example_id": "9fb9051a-1e50-4474-b1bc-21c92c84514a",
                                "sense_id": "4453b61c-9f0f-3f96-bbe8-ccae14ec9b18",
                                "text": "„Die kurze Gasse mündet in eine Uferstraße, die am Donaukanal entlangführt, was Erinnerungen an die Spaziergänge in Manchester aufkommen lassen mag – und natürlich an Rustschuk.“"
                            },
                            {
                                "example_id": "e1d63336-b6f3-4fff-9c4d-af0a55678207",
                                "sense_id": "4453b61c-9f0f-3f96-bbe8-ccae14ec9b18",
                                "text": "„Der Lancia stand in der unten an der Uferstraße in den Fels gehauenen Garage.“"
                            },
                            {
                                "example_id": "e97f3157-82c5-4b44-ae77-5d00c1f26a9e",
                                "sense_id": "4453b61c-9f0f-3f96-bbe8-ccae14ec9b18",
                                "text": "„Am Moselufer standen viele Häuser dicht nebeneinander, und vom Ufer aus führten dann viele schmale Gassen von der Uferstraße aus in den Ort.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
