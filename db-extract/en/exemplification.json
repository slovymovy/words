                "translations": [
                    {
                        "translation_id": "f9b448d0-82eb-4589-87c2-1719476c9c13",
                        "source_entry_id": "91f433da-f910-3f7e-b1aa-680a2742e2d5",
                        "source_sense_description": "act of exemplifying",
                        "target_lang_word": "exemplification",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "exemplification",
