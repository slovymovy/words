                ],
                "senses": [
                    {
                        "sense_id": "dbb6c19e-9fd2-36d0-b8ce-90593d3a1c47",
                        "entry_id": "d5561b98-6461-3ce9-ad1a-fc3825128219",
                        "glosses": [
                            "Art und Weise, wie etwas systematisch, gegebenenfalls auch mit einer Hilfskonstruktion, und gewaltsam durch Schläge in eine Oberfläche hineingetrieben wird, zum Beispiel Nägel zum Verankern einer Prothese im Knochen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f50160b-3c40-4136-b780-321eded820f2",
                                "sense_id": "dbb6c19e-9fd2-36d0-b8ce-90593d3a1c47",
                                "text": "„Durch das einfache Einschlagsystem haben Sie den Vorteil einer schnelleren und damit kostenreduzierten Fertigung.“"
                            },
                            {
                                "example_id": "fc9bcf65-6da6-4a2a-b17b-8cc8db19a9a3",
                                "sense_id": "dbb6c19e-9fd2-36d0-b8ce-90593d3a1c47",
                                "text": "„Für die punktuellen Untersuchungen beim Einsatz des Taucherschachtes wurde ein vertikales Einschlagsystem (Abb. 25) verwendet, da ein Verlegen von Entnahmeschläuchen von der Flussmitte zum Ufer technisch nicht realisierbar und seitens der verantwortlichen Wasserbehörden in Zusammenhang mit der Schifffahrt nicht genehmigungsfähig war.“"
                            },
                            {
                                "example_id": "ac230f14-bb51-4f39-b214-a8062fd87582",
                                "sense_id": "dbb6c19e-9fd2-36d0-b8ce-90593d3a1c47",
                                "text": "Die Tibiakomponente wird mit dem Einschlagsystem eingebracht, auf eine korrekte Zentrierung ist zu achten (Abb.339). Mit mehreren kräftigen Hammerschlägen wird das Plateau implantiert."
                            },
                            {
                                "example_id": "80a0b7c2-3ff9-4ae1-a160-291b40580b4d",
                                "sense_id": "dbb6c19e-9fd2-36d0-b8ce-90593d3a1c47",
                                "text": "AO-Einschlagsystem für die Marknagelung: Links für Tibia, rechts für Femur."
                            },
                            {
                                "example_id": "affa3517-80dd-4398-b92b-68007fa4ea1c",
                                "sense_id": "dbb6c19e-9fd2-36d0-b8ce-90593d3a1c47",
                                "text": "Einschlagsystem für zylindrisch geschlossene Ober- und Unterschenkelnägel mit zylindrischem Schraubanschluß (Howmedica). Abb. II. 4."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "d0937d34-4600-3cf0-a366-bd461bdf2466",
                        "entry_id": "d5561b98-6461-3ce9-ad1a-fc3825128219",
                        "glosses": [
                            "Art und Weise, gegebenenfalls auch die Maschine, mit der ein Gegenstand umhüllt wird, zum Beispiel eine Ware mit einer Plastikfolie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d86cd064-1f25-40ea-8a63-e5cd82d664bb",
                                "sense_id": "d0937d34-4600-3cf0-a366-bd461bdf2466",
                                "text": "„Das Maschinenkonzept unterscheidet sich zum Einschlagsystem darin, dass eine Rotorumdrehung zwei Seilschläge / Umdrehung erzeugt.“"
                            },
                            {
                                "example_id": "eeb54f34-5fb1-4435-b3a3-5bb14789f81f",
                                "sense_id": "d0937d34-4600-3cf0-a366-bd461bdf2466",
                                "text": "„Liebe Eltern, das Neue Gymnasium Oldenburg hat im Herbst 2008 ein Einschlagsystem angeschafft, dass die Schulbücher unserer Kinder haltbarer machen soll und somit die Kosten vor allem für die Eltern senkt.“"
                            },
                            {
                                "example_id": "91128b6d-8647-4e06-b6aa-a7797d999cd0",
                                "sense_id": "d0937d34-4600-3cf0-a366-bd461bdf2466",
                                "text": "„Der Buchdeckenautomat DA 260 erfüllt sämtliche Anforderungen einer professionellen Buchdeckenfertigung. Herausragend die exzellente Produktqualität: Entscheidende Funktionen, wie das Einschlagsystem, arbeiten auf hohem Qualitätsniveau.“"
                            },
                            {
                                "example_id": "6c199be0-8e91-4661-b146-3321fa392724",
                                "sense_id": "d0937d34-4600-3cf0-a366-bd461bdf2466",
                                "text": "„Zusammengefaßt wird mit diesem Einschlagsystem die bei der Buchdeckenherstellung gewünschte Scharfkantigkeit nicht erreicht, Luftein schlüsse zwischen dem Überzugsmaterial und den Pappen, hohle Kanten sowie Lösen des Einschlags sind keine Seltenheit.“"
                            },
                            {
                                "example_id": "7df9b924-30a8-4617-ba98-d3226620aaca",
                                "sense_id": "d0937d34-4600-3cf0-a366-bd461bdf2466",
                                "text": "Die Folienzuschnitte werden dann mittels eines Einschlagsystems innerhalb der Einrichtung um die Artikel herumgewickelt."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
