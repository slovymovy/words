                    {
                        "sense_id": "a8510664-10e2-3492-9545-1e08ba3c7b13",
                        "entry_id": "813d55f6-7bc4-3cf1-97f8-9e5d65a33241",
                        "glosses": [
                            "verpleegkundige die nachtdienst heeft"
