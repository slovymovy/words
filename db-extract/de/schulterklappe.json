                                    {
                                        "sense_id": "f10cb19d-2a7b-37a2-b022-d65d8c27b5a6",
                                        "entry_id": "49984b1c-44e6-334f-8091-18b60a9e0042",
                                        "glosses": [
                                            "An ornamentation, worn on the shoulders of a military uniform, as a sign of rank."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "290cff41-98f5-41f2-bbde-d62aa1a0fe4a",
                                                "sense_id": "f10cb19d-2a7b-37a2-b022-d65d8c27b5a6",
                                                "text": "He would have answered for it at the end of a quarter of an hour that some of the glass cases contained swords and epaulettes of ancient colonels and generals; medals and orders once pinned over hearts that had long since ceased to beat; […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a0f6366d-01b3-3b4e-b38e-f170522339bb",
                                        "entry_id": "49984b1c-44e6-334f-8091-18b60a9e0042",
                                        "glosses": [
                                            "A similar piece of trimming on a lady’s dress."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6f518129-54ad-326f-a04d-3a72d8ff4a81",
                                        "entry_id": "49984b1c-44e6-334f-8091-18b60a9e0042",
