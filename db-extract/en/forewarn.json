                    },
                    {
                        "translation_id": "acc757a2-1dd5-4077-afd6-31ed48099cd5",
                        "source_entry_id": "19f7a7e0-8b8a-3d97-97ad-e279dfe29497",
                        "source_sense_id": "74c5aa60-e501-3a98-bce0-1d9376a17e16",
                        "source_sense_description": "to warn in advance",
                        "target_lang_word": "précautionner",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "précautionner",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b21c03d9-2a45-36ac-9697-aba5544cb240",
                                        "entry_id": "94052248-5cec-3839-a930-d9db1776153e",
                                        "glosses": [
                                            "Prémunir quelqu’un par ses conseils contre un mal dont il est menacé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "287be77d-2f52-40ef-8193-4d1f604ac8fd",
                                                "sense_id": "b21c03d9-2a45-36ac-9697-aba5544cb240",
                                                "text": "Précautionner les fidèles contre l’hérésie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cd3eddba-6d94-3aaa-a123-98780153159e",
                                        "entry_id": "94052248-5cec-3839-a930-d9db1776153e",
                                        "glosses": [
                                            "Prendre ses précautions."
                                        ],
                                        "tags": [
                                            "common",
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c524a9f4-7b54-4150-97ea-29bc177ed87f",
                                                "sense_id": "cd3eddba-6d94-3aaa-a123-98780153159e",
                                                "text": "Bien nourris, et s’étant précautionnés à la friperie de vêtements chauds et plus épais que la serge des manteaux de théâtre, les comédiens ne souffraient pas du froid, et la bise n’avait d’autre inconvénient que de faire monter aux joues des jeunes actrices un incarnat un peu plus vif que de coutume et qui parfois même s’étendait jusque sur leur nez délicat."
                                            },
                                            {
                                                "example_id": "2c88c968-aad6-43ac-8369-5d143df46385",
                                                "sense_id": "cd3eddba-6d94-3aaa-a123-98780153159e",
                                                "text": "Il ne parut donc pas nécessaire de se précautionner contre ces excès auxquels se portent souvent les aliénés, soit contre autrui, soit contre eux-mêmes."
                                            },
                                            {
                                                "example_id": "705eb6bb-6013-474a-8eb8-cc6c8641297f",
                                                "sense_id": "cd3eddba-6d94-3aaa-a123-98780153159e",
                                                "text": "Nous nous sommes encore précautionnées de bougies, inutiles cette fois, une main bienveillante ayant accroché une grosse lanterne au-dessus de l’affiche blanche où sont inscrits nos noms."
                                            },
                                            {
                                                "example_id": "1def8857-2872-434c-b24c-c8ff123de3f7",
                                                "sense_id": "cd3eddba-6d94-3aaa-a123-98780153159e",
                                                "text": "Du moins il s’était précautionné pour la nuit : il avait acheté à Toulon, le matin, une boîte de poudre insecticide."
                                            },
                                            {
                                                "example_id": "905f8934-4618-4570-9246-fac3fd656953",
                                                "sense_id": "cd3eddba-6d94-3aaa-a123-98780153159e",
                                                "text": "Dites-moi, docteur, peut-être serait-il sage que je me précautionne ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "755a1b51-6898-45c3-a324-cce4823682df",
