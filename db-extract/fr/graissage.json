                        "examples": [
                            {
                                "example_id": "4dc1dfa8-22fb-4f85-9e28-d569dd5f5285",
                                "sense_id": "4d704a14-4327-3632-9328-ded55b4619de",
                                "text": "Ces mouvements étant délicats et rapides (…), il faut un très bon graissage des cames, des barrettes et des vis."
                            },
                            {
                                "example_id": "91154fc3-0cd6-4545-97aa-c53a5a3cd0dd",
                                "sense_id": "4d704a14-4327-3632-9328-ded55b4619de",
                                "text": "Le piston est creusé hémisphériquement, ce qui offre encore l'avantage d'empêcher le combustible de diluer l'huile de graissage et de provoquer son écoulement hors du cylindre."
                            }
                        ]
                    },
