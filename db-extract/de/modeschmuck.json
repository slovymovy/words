                        "glosses": [
                            "der neuesten Mode entsprechender Schmuck mit einem geringem Wert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b62328c4-32c3-4fc2-b8c9-177464d935bd",
                                "sense_id": "3dfd23f0-d0fb-346c-937a-97e02f395f4e",
                                "text": "Die Diebe interessierten sich nicht für den Modeschmuck, da der Wert zu gering war."
