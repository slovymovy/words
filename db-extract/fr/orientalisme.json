        "fr-extract.jsonl": [
            {
                "entry_id": "04ca49cf-f203-3200-9d4d-fde354280b3a",
                "word": "orientalisme",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "cdf501cc-71bc-4da3-806b-afa6303785d6",
                        "entry_id": "04ca49cf-f203-3200-9d4d-fde354280b3a",
                        "tags": [
