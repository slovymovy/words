                "senses": [
                    {
                        "sense_id": "235a6dd3-d2eb-3a8a-a9dd-6ebe1a7fce04",
                        "entry_id": "0c48cd2b-2629-35b5-bdd7-14f9eef97245",
                        "glosses": [
                            "Zeitraum, in dem man sich in einem Ausbildungsverhältnis befindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ec88641-5436-4612-9033-6a3789d7890d",
                                "sense_id": "235a6dd3-d2eb-3a8a-a9dd-6ebe1a7fce04",
                                "text": "„Die Ausbildungszeit kann auf Antrag und bei sehr guten Leistungen gekürzt werden, wenn trotzdem zu erwarten ist, dass der Auszubildende sein Ausbildungsziel erreicht.“"
                            },
                            {
                                "example_id": "51a071c1-0f36-4f27-92c5-75377d76c03a",
                                "sense_id": "235a6dd3-d2eb-3a8a-a9dd-6ebe1a7fce04",
                                "text": "„In Ausnahmefällen kann die Ausbildungszeit auf Antrag bei den zuständigen Kammern auch verlängert werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
