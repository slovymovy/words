            "pos": "noun",
            "senses": [
                {
                    "sense_id": "93e054da-a744-3304-9cfb-d18464d29703",
                    "sense_definition": "A dish made of grain or legumes, milk or water, heated and stirred until thick and typically eaten for breakfast.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Eat your <w>porridge</w> while it is still warm.",
                            "target_lang_translations": {
                                "pl": "Zjedz swoją <w>owsiankę</w>, póki jest jeszcze ciepła."
                            }
                        },
                        {
                            "text": "She prepared a bowl of hot <w>porridge</w> for breakfast.",
                            "target_lang_translations": {
                                "pl": "Przygotowała miskę gorącej <w>owsianki</w> na śniadanie."
                            }
                        }
                    ],
                    "synonyms": [
                        "oatmeal"
                    ],
                    "common_phrases": [
                        "bowl of porridge",
                        "hot porridge"
                    ],
                    "target_lang_definitions": {
                        "pl": "Danie z ziaren zbóż lub roślin strączkowych gotowane na mleku lub wodzie, podawane zazwyczaj na śniadanie."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "owsianka",
                                "target_lang_sense_clarification": "najczęstsze określenie na śniadaniową potrawę z płatków owsianych"
                            },
                            {
                                "target_lang_word": "kleik",
                                "target_lang_sense_clarification": "rzadsza, bardziej płynna forma potrawy zbożowej"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "14950d66-255a-3cee-86e1-1ae964e4e709",
                    "sense_definition": "A type of thick soup or stew, especially thickened with barley.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cook made a hearty <w>porridge</w> using barley and fresh vegetables.",
                            "target_lang_translations": {
                                "pl": "Kucharz przygotował treściwą <w>potrawkę</w> z jęczmienia i świeżych warzyw."
                            }
                        },
                        {
                            "text": "This traditional <w>porridge</w> is more like a thick stew than a breakfast cereal.",
                            "target_lang_translations": {
                                "pl": "Ta tradycyjna <w>potrawka</w> bardziej przypomina gęsty gulasz niż płatki śniadaniowe."
                            }
                        }
                    ],
                    "synonyms": [
                        "stew",
                        "pottage"
                    ],
                    "target_lang_definitions": {
                        "pl": "Gęsta zupa lub potrawka, często zagęszczana jęczmieniem."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "potrawka",
                                "target_lang_sense_clarification": "gęste danie jednogarnkowe"
                            },
                            {
                                "target_lang_word": "gęsta zupa",
                                "target_lang_sense_clarification": "opisowe określenie treściwej zupy"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0aedaa7b-35f6-321d-9946-0107bfdb6f11",
                    "sense_definition": "A prison sentence.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "slang",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He had to do his <w>porridge</w> after being caught stealing cars.",
                            "target_lang_translations": {
                                "pl": "Musiał odbyć swoją <w>odsiadkę</w> po tym, jak został złapany na kradzieży samochodów."
                            }
                        },
                        {
                            "text": "After years of doing <w>porridge</w>, he finally returned to his family.",
                            "target_lang_translations": {
                                "pl": "Po latach <w>odsiadki</w> w końcu wrócił do rodziny."
                            }
                        }
                    ],
                    "synonyms": [
                        "jail time",
                        "prison sentence"
                    ],
                    "common_phrases": [
                        "do porridge"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "British English slang for a prison sentence."
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Potoczne określenie kary więzienia."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "odsiadka",
                                "target_lang_sense_clarification": "potoczne określenie odbywania kary pozbawienia wolności"
                            },
                            {
                                "target_lang_word": "wyrok",
                                "target_lang_sense_clarification": "formalne określenie kary więzienia"
                            }
                        ]
                    }
                }
            ]
        }
    ]
