        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "454e3c4e-b59e-36d8-8ded-254231b2043f",
                "word": "breakdancing",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "ed70eac9-f259-3704-ba3e-34549023a068",
                        "entry_id": "454e3c4e-b59e-36d8-8ded-254231b2043f",
                        "glosses": [
                            "An urban style of acrobatic street dance that originated in the hip hop culture of New York City in the late 20th century."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "04b1ec4d-2c06-43d9-af16-90a96b1072e4",
                                "sense_id": "ed70eac9-f259-3704-ba3e-34549023a068",
                                "text": "Hollywood made movies about breakdancing, dancers performed at the White House and the sky seemed the limit."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "515be290-f34d-464a-9a9b-10b95f12b50c",
                        "source_entry_id": "454e3c4e-b59e-36d8-8ded-254231b2043f",
                        "source_sense_id": "ed70eac9-f259-3704-ba3e-34549023a068",
                        "source_sense_description": "Style of dance",
                        "target_lang_word": "breakdance",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "breakdance",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ef4b5abd-0cc7-366e-b94c-fac2095b9807",
                                        "entry_id": "82301194-d688-3872-ae92-20fdad1fe1ed",
                                        "glosses": [
                                            "Forme de danse caractérisée par l’acrobatie et souvent associée au hip-hop."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "99f2bc8c-1dc9-4a37-a806-4b8070b2b1ff",
                                                "sense_id": "ef4b5abd-0cc7-366e-b94c-fac2095b9807",
                                                "text": "Par ailleurs, en créant un style inédit exprimé dans le rap, le graff, le tag, le breakdance ou leurs looks, ils gagnent le respect de la communauté et s’opposent aux styles des dominateurs."
                                            },
                                            {
                                                "example_id": "1105247d-fee2-4551-ae80-8c5e909935da",
                                                "sense_id": "ef4b5abd-0cc7-366e-b94c-fac2095b9807",
                                                "text": "C’est dans les cages d’escalier, les parcs, les terrains vagues et les terrains de basket des boroughs pauvres de New York que la breakdance s’est développée au début des années 1970."
                                            },
                                            {
                                                "example_id": "af140966-2219-4699-9dfe-4be4eb6e5b45",
                                                "sense_id": "ef4b5abd-0cc7-366e-b94c-fac2095b9807",
                                                "text": "Car samedi à 18 heures, Dany Dann pourrait remporter la finale mondiale du Red Bull BC One, la plus grande compétition de breakdance du monde."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1e554388-ada0-4522-995b-7ebecfa0e1bc",
                        "source_entry_id": "454e3c4e-b59e-36d8-8ded-254231b2043f",
                        "source_sense_id": "ed70eac9-f259-3704-ba3e-34549023a068",
