                    },
                    {
                        "translation_id": "90b74654-f9c3-410b-8e74-8c378c8b2e41",
                        "source_entry_id": "b1d6923f-507d-32ef-bfa5-3d31a2a66636",
                        "source_sense_id": "f26e655e-6df6-3264-8315-5e922db3be7c",
                        "source_sense_description": "jovial, exuberant, lighthearted; merry and in high spirits",
                        "target_lang_word": "jovial",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jovial",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dbb157ef-a554-341f-8371-eb62249d32d2",
                                        "entry_id": "4579861f-8d18-303c-abc5-45ca8bd41c84",
                                        "glosses": [
                                            "Qui est d’une gaieté communicative."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea51c943-01b8-469c-978f-b806e5502ddf",
                                                "sense_id": "dbb157ef-a554-341f-8371-eb62249d32d2",
                                                "text": "Dès le lendemain du crime, je devins éperdument amoureux de Rosalie. Je songeai aussitôt à en faire ma maîtresse, mais je me heurtai à une résistance entêtée et joviale, qui exaspéra et redoubla ma passion."
                                            },
                                            {
                                                "example_id": "e93048e9-0c19-4e91-a4be-6c9df1453390",
                                                "sense_id": "dbb157ef-a554-341f-8371-eb62249d32d2",
                                                "text": "Or, tandis qu'il bonissait avec cette verve joviale, son œil rusé m'observait."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "722b639f-7423-3831-85ae-f0a4c2c86948",
                                        "entry_id": "4579861f-8d18-303c-abc5-45ca8bd41c84",
                                        "glosses": [
                                            "Qui est d'humeur joyeuse et drôle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "92f2e9d9-9eff-4881-9ddf-154213a3065a",
                                                "sense_id": "722b639f-7423-3831-85ae-f0a4c2c86948",
                                                "text": "Le docteur est tout à fait jovial. Il paraît que je lui fais beaucoup d’honneur en me tenant debout."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3d9d3e97-ee42-4ca9-8717-9462193bc626",
                        "source_entry_id": "b1d6923f-507d-32ef-bfa5-3d31a2a66636",
                        "source_sense_id": "f26e655e-6df6-3264-8315-5e922db3be7c",
                        "source_sense_description": "jovial, exuberant, lighthearted; merry and in high spirits",
                        "target_lang_word": "heiter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "heiter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a40e46cd-7d3f-3630-92b3-4959f7b44d9c",
                                        "entry_id": "e8a153d0-cadc-3742-b9d1-ac693c4edd01",
                                        "glosses": [
                                            "eine gute Stimmung oder gute Laune betreffend, lustig, humorvoll; innere Ausgeglichenheit haben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "44b15a9d-3ca3-4eef-9cab-232388caa3ac",
                                                "sense_id": "a40e46cd-7d3f-3630-92b3-4959f7b44d9c",
                                                "text": "Alle waren in heiterer und ausgelassener Stimmung."
                                            },
                                            {
                                                "example_id": "ccd61b30-302d-4316-b811-5cf5ec97fbd6",
                                                "sense_id": "a40e46cd-7d3f-3630-92b3-4959f7b44d9c",
                                                "text": "„Ernst ist das Leben, heiter die Kunst.“ (Schiller)"
                                            },
                                            {
                                                "example_id": "332a510f-c068-4fce-967e-ffdf51dc43be",
                                                "sense_id": "a40e46cd-7d3f-3630-92b3-4959f7b44d9c",
                                                "text": "„Die Menschen begreifen gar nicht, wie ernst man sein muss, um heiter zu sein.“ (Goethe)"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1bcdafb9-173f-3fa8-a89c-474b67452c4c",
                                        "entry_id": "e8a153d0-cadc-3742-b9d1-ac693c4edd01",
                                        "glosses": [
                                            "so, dass weniger als zwei Achtel und mehr als ein Achtel des Himmels mit Wolken bedeckt ist; heiter"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3226631-69a2-43ad-a0d6-c04ec6ac9731",
                                                "sense_id": "1bcdafb9-173f-3fa8-a89c-474b67452c4c",
                                                "text": "Heute soll es überwiegend heiter werden."
                                            },
                                            {
                                                "example_id": "001db854-fa13-4308-ad9d-430771738b4b",
                                                "sense_id": "1bcdafb9-173f-3fa8-a89c-474b67452c4c",
                                                "text": "Das Wetter wird heiter bis wolkig."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
