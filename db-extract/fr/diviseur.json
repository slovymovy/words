                "senses": [
                    {
                        "sense_id": "0e50b69f-1576-3a53-8ac9-ef6a7ce4c235",
                        "entry_id": "7ef689fc-5fab-3ed9-b459-d7496676bdb1",
                        "glosses": [
                            "Nombre par lequel on divise un autre nombre, ce dernier étant appelé le dividende."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f1ab6487-4246-4e51-9ff2-986b82205620",
                                "sense_id": "0e50b69f-1576-3a53-8ac9-ef6a7ce4c235",
                                "text": "Le dividende s’écrit à la gauche du diviseur, dont on le sépare par un trait vertical."
                            }
                        ]
                    },
                    {
                        "sense_id": "624b1d0f-ef24-37d4-baef-cf560c08b4c8",
                        "entry_id": "7ef689fc-5fab-3ed9-b459-d7496676bdb1",
                        "glosses": [
                            "Nombre entier qui divise un autre nombre entier sans reste."
                        ],
                        "tags": [
                            "Théorie des nombres"
                        ],
                        "examples": [
                            {
                                "example_id": "af77399f-a247-44e4-8c16-f9f31c8d46ec",
                                "sense_id": "624b1d0f-ef24-37d4-baef-cf560c08b4c8",
                                "text": "La fraction 4/6 n’est pas sous forme irréductible car 4 et 6 ont en plus de 1 le nombre 2 comme diviseur commun. Cette fraction est donc simplifiable et on a : 4/6=(2×2)/(2×3)=2/3 en simplifiant par 2 en haut et en bas."
                            }
                        ]
                    },
                    {
                        "sense_id": "aa9c283e-4772-38b3-88f3-ef2b2de64786",
                        "entry_id": "7ef689fc-5fab-3ed9-b459-d7496676bdb1",
                        "glosses": [
                            "Élément d'un monoïde commutatif (resp. d'un anneau commutatif) qui peut être composé (resp. multiplié) avec un autre pour former un certain élément (qui est indiqué après la préposition de)."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": []
                    },
                    {
