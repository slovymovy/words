{
    "word_family": [
        "slippage",
        "slipper",
        "slippery",
        "slipway",
        "sideslip",
        "slipknot",
        "slipstream"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "12d078af-3070-3aa9-87aa-fc436c8eaa03",
                    "sense_definition": "To lose one’s traction on a slippery surface; to slide due to a lack of friction.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "physical_sliding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Be careful not to <w>slip</w> on the wet floor after it has been mopped.",
                            "target_lang_translations": {
                                "ru": "Будьте осторожны, не <w>поскользнитесь</w> на мокром полу после того, как его помыли."
                            }
                        },
                        {
                            "text": "He <w>slipped</w> on the ice and bruised his hip while walking to the car.",
                            "target_lang_translations": {
                                "ru": "Он <w>поскользнулся</w> на льду и ушиб бедро, пока шел к машине."
                            }
                        }
                    ],
                    "common_phrases": [
                        "slip on the ice",
                        "slip and fall"
                    ],
                    "target_lang_definitions": {
                        "ru": "Потерять сцепление на скользкой поверхности; поскользнуться из-за отсутствия трения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поскользнуться",
                                "target_lang_sense_clarification": "потерять равновесие на скользком"
                            },
                            {
                                "target_lang_word": "поскальзываться",
                                "target_lang_sense_clarification": "процесс потери равновесия на скользком"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "14349cbd-ebc5-3c12-811f-b409dd955a62",
                    "sense_definition": "To move quickly and often secretively; to depart, withdraw, or enter as if by sliding.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She managed to <w>slip</w> away from the party without anyone noticing her departure.",
                            "target_lang_translations": {
                                "ru": "Ей удалось незаметно <w>ускользнуть</w> с вечеринки так, что никто не заметил её ухода."
                            }
                        },
                        {
                            "text": "The thief <w>slipped</w> into the shadows before the police could arrive.",
                            "target_lang_translations": {
                                "ru": "Вор <w>скрылся</w> в тени до того, как успела приехать полиция."
                            }
                        }
                    ],
                    "common_phrases": [
                        "slip away",
                        "slip into the room",
                        "slip out unnoticed"
                    ],
                    "target_lang_definitions": {
                        "ru": "Двигаться быстро и часто тайно; уходить, удаляться или входить незаметно."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выскользнуть",
                                "target_lang_sense_clarification": "незаметно уйти"
                            },
                            {
                                "target_lang_word": "проскользнуть",
                                "target_lang_sense_clarification": "незаметно пройти внутрь или мимо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "212414f3-a9fd-3afc-9883-985986babe2c",
                    "sense_definition": "To pass an object, such as a note or money, often in a quiet or covert manner.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "transfer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She thanked the porter and <w>slipped</w> a ten-dollar bill into his hand.",
                            "target_lang_translations": {
                                "ru": "Она поблагодарила носильщика и <w>сунула</w> ему в руку десятидолларовую купюру."
                            }
                        },
                        {
                            "text": "He tried to <w>slip</w> a note to his friend during the boring lecture.",
                            "target_lang_translations": {
                                "ru": "Он попытался <w>передать</w> записку другу во время скучной лекции."
                            }
                        }
                    ],
                    "common_phrases": [
                        "slip someone money",
                        "slip a note"
                    ],
                    "target_lang_definitions": {
                        "ru": "Передать предмет (записку, деньги) тихо или скрытно."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сунуть",
                                "target_lang_sense_clarification": "незаметно передать в руки"
                            },
                            {
                                "target_lang_word": "подсунуть",
                                "target_lang_sense_clarification": "скрытно положить или передать"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "09982c7d-86dc-33c2-b085-1d7def0f8fe2",
                    "sense_definition": "To move down or decline in value, quality, or position.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "decline",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Company profits have <w>slipped</w> over the past six months due to low sales.",
                            "target_lang_translations": {
                                "ru": "Прибыль компании <w>снизилась</w> за последние шесть месяцев из-за низких продаж."
                            }
                        },
                        {
                            "text": "The team <w>slipped</w> into the relegation zone after losing their last three matches.",
                            "target_lang_translations": {
                                "ru": "Команда <w>опустилась</w> в зону вылета после проигрыша в последних трех матчах."
                            }
                        }
                    ],
                    "common_phrases": [
                        "profits have slipped",
                        "slip into decline"
                    ],
                    "target_lang_definitions": {
                        "ru": "Снижаться в стоимости, качестве или положении."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "снижаться",
                                "target_lang_sense_clarification": "о показателях или прибыли"
                            },
                            {
                                "target_lang_word": "ухудшаться",
                                "target_lang_sense_clarification": "о качестве или положении"
                            },
                            {
                                "target_lang_word": "опускаться",
                                "target_lang_sense_clarification": "в рейтинге или таблице"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ca68db29-d326-3065-9409-a4cb66abdebc",
                    "sense_definition": "To elude or evade someone or something by moving smoothly or quickly.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "evasion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I caught the thief, but he <w>slipped</w> my grasp and ran away into the crowd.",
                            "target_lang_translations": {
                                "ru": "Я поймал вора, но он <w>вырвался</w> из моих рук и убежал в толпу."
                            }
                        },
                        {
                            "text": "The fish <w>slipped</w> through the net and returned to the deep water.",
                            "target_lang_translations": {
                                "ru": "Рыба <w>проскользнула</w> сквозь сеть и вернулась на глубину."
                            }
                        }
                    ],
                    "common_phrases": [
                        "slip one's grasp",
                        "slip through the fingers"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ускользнуть или уклониться от кого-либо или чего-либо, двигаясь плавно или быстро."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выскользнуть",
                                "target_lang_sense_clarification": "из рук или сетей"
                            },
                            {
                                "target_lang_word": "ускользнуть",
                                "target_lang_sense_clarification": "избежать захвата"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4ca9c1d8-242d-3cdf-95d1-74eaa236c678",
                    "sense_definition": "To accidentally reveal a secret or say something unintentionally.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "speech_error",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I didn't mean to tell her about the surprise, but I <w>slipped</w> and mentioned the cake.",
                            "target_lang_translations": {
                                "ru": "Я не хотел говорить ей о сюрпризе, но <w>проговорился</w> и упомянул торт."
                            }
                        },
                        {
                            "text": "He let the secret <w>slip</w> during the dinner conversation last night.",
                            "target_lang_translations": {
                                "ru": "Вчера вечером во время ужина он случайно <w>выболтал</w> секрет."
                            }
                        }
                    ],
                    "common_phrases": [
                        "let it slip"
                    ],
                    "target_lang_definitions": {
                        "ru": "Случайно выдать секрет или сказать что-то непреднамеренно."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "проговориться",
                                "target_lang_sense_clarification": "случайно выдать секрет"
                            },
                            {
                                "target_lang_word": "обмолвиться",
                                "target_lang_sense_clarification": "нечаянно сказать"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5c5260eb-37f3-3a34-aeb3-629ebd5b0f39",
                    "sense_definition": "A small piece of paper, typically used for writing a short note or providing printed information.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "paper",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please write your phone number on this <w>slip</w> of paper so I can call you.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, напишите свой номер телефона на этом <w>листке</w> бумаги, чтобы я мог вам позвонить."
                            }
                        },
                        {
                            "text": "He checked his salary <w>slip</w> to see how much tax had been deducted this month.",
                            "target_lang_translations": {
                                "ru": "Он проверил свой расчетный <w>листок</w>, чтобы посмотреть, сколько налогов было удержано в этом месяце."
                            }
                        }
                    ],
                    "common_phrases": [
                        "slip of paper",
                        "salary slip",
                        "permission slip"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшой листок бумаги, обычно используемый для коротких заметок или печатной информации."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "листок",
                                "target_lang_sense_clarification": "небольшой кусок бумаги"
                            },
                            {
                                "target_lang_word": "квиток",
                                "target_lang_sense_clarification": "расчетный или официальный листок"
                            },
                            {
                                "target_lang_word": "бланк",
                                "target_lang_sense_clarification": "форма для заполнения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "961a027a-fc42-30d9-9780-cde237a18916",
                    "sense_definition": "A minor mistake or error, especially one made through carelessness.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "error",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Calling him by his brother's name was just a <w>slip</w> of the tongue.",
                            "target_lang_translations": {
                                "ru": "Назвать его именем брата было просто <w>оговоркой</w>."
                            }
                        },
                        {
                            "text": "I noticed a small grammatical <w>slip</w> in the first paragraph of your essay.",
                            "target_lang_translations": {
                                "ru": "Я заметил небольшую грамматическую <w>ошибку</w> в первом абзаце вашего эссе."
                            }
                        }
                    ],
                    "synonyms": [
                        "error",
                        "fault",
                        "lapse",
                        "mistake"
                    ],
                    "common_phrases": [
                        "slip of the tongue",
                        "slip of the pen"
                    ],
                    "target_lang_definitions": {
                        "ru": "Незначительная ошибка или оплошность, совершенная по неосторожности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ошибка",
                                "target_lang_sense_clarification": "небольшая погрешность"
                            },
                            {
                                "target_lang_word": "описка",
                                "target_lang_sense_clarification": "ошибка при письме"
                            },
                            {
                                "target_lang_word": "обмолвка",
                                "target_lang_sense_clarification": "ошибка в речи"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "58b10e82-b23a-3f3d-b971-d43ef2f8a416",
                    "sense_definition": "An act or instance of sliding accidentally on a surface.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_sliding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A sudden <w>slip</w> on the wet pavement caused him to drop his groceries.",
                            "target_lang_translations": {
                                "ru": "Внезапное <w>скольжение</w> на мокром тротуаре заставило его уронить продукты."
                            }
                        },
                        {
                            "text": "She recovered quickly after a slight <w>slip</w> while climbing the stairs.",
                            "target_lang_translations": {
                                "ru": "Она быстро пришла в себя после того, как слегка <w>оступилась</w> на лестнице."
                            }
                        }
                    ],
                    "synonyms": [
                        "stumble"
                    ],
                    "common_phrases": [
                        "a slight slip"
                    ],
                    "target_lang_definitions": {
                        "ru": "Случайное скольжение на поверхности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скольжение",
                                "target_lang_sense_clarification": "акт движения по поверхности"
                            },
                            {
                                "target_lang_word": "промах",
                                "target_lang_sense_clarification": "в контексте потери равновесия"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5485d80c-97a6-3573-b794-ef784ccdd4fe",
                    "sense_definition": "A woman's undergarment worn under a dress or skirt.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "clothing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She wore a silk <w>slip</w> under her lace dress to ensure it wasn't see-through.",
                            "target_lang_translations": {
                                "ru": "Она надела шелковую <w>комбинацию</w> под кружевное платье, чтобы оно не просвечивало."
                            }
                        },
                        {
                            "text": "The vintage <w>slip</w> was trimmed with delicate white lace at the hem.",
                            "target_lang_translations": {
                                "ru": "Винтажная <w>сорочка</w> была отделана нежным белым кружевом по подолу."
                            }
                        }
                    ],
                    "common_phrases": [
                        "silk slip",
                        "full slip"
                    ],
                    "target_lang_definitions": {
                        "ru": "Женское нижнее белье, надеваемое под платье или юбку."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "комбинация",
                                "target_lang_sense_clarification": "нижняя сорочка под платье"
                            },
                            {
                                "target_lang_word": "комбинашка",
                                "target_lang_sense_clarification": "разговорное название белья"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e4c5c7b6-47a1-314d-b4f4-2b694de8be24",
                    "sense_definition": "An act of escaping or leaving secretly and unexpectedly.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "evasion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The prisoner gave the guards the <w>slip</w> and disappeared into the woods.",
                            "target_lang_translations": {
                                "ru": "Заключенный <w>обманул</w> охрану и скрылся в лесу."
                            }
                        },
                        {
                            "text": "We managed to give the reporters the <w>slip</w> by leaving through the back door.",
                            "target_lang_translations": {
                                "ru": "Нам удалось <w>ускользнуть</w> от репортеров, выйдя через заднюю дверь."
                            }
                        }
                    ],
                    "common_phrases": [
                        "give someone the slip"
                    ],
                    "target_lang_definitions": {
                        "ru": "Побег или тайный, неожиданный уход."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "побег",
                                "target_lang_sense_clarification": "тайный уход"
                            },
                            {
                                "target_lang_word": "уловка",
                                "target_lang_sense_clarification": "в выражении 'обмануть/ускользнуть'"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "becb3739-bdc6-3731-8de6-3329beb0df16",
                    "sense_definition": "A small shoot or cutting taken from a plant for grafting or planting.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "botany",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She planted a <w>slip</w> from her grandmother's rose bush in her own garden.",
                            "target_lang_translations": {
                                "ru": "Она посадила <w>черенок</w> от бабушкиного розового куста в своем саду."
                            }
                        },
                        {
                            "text": "You can grow a new vine by taking a healthy <w>slip</w> from the parent plant.",
                            "target_lang_translations": {
                                "ru": "Вы можете вырастить новую лозу, взяв здоровый <w>отросток</w> от материнского растения."
                            }
                        }
                    ],
                    "common_phrases": [
                        "plant a slip"
                    ],
                    "target_lang_definitions": {
                        "ru": "Маленький побег или черенок, взятый от растения для прививки или посадки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "черенок",
                                "target_lang_sense_clarification": "часть растения для посадки"
                            },
                            {
                                "target_lang_word": "отросток",
                                "target_lang_sense_clarification": "молодой побег"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}