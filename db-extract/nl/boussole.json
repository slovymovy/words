    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [],
        "ru-extract.jsonl": [],
        "nl-extract.jsonl": [
            {
                "entry_id": "13bba601-628d-3159-a7fc-3360fc429bc7",
                "word": "boussole",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "7207a7a6-2c8b-374d-9636-6fef6a495e52",
                        "entry_id": "13bba601-628d-3159-a7fc-3360fc429bc7",
                        "glosses": [
                            "kompas"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c28c7b7e-4b78-4505-916d-0270118ddfa4",
                        "source_entry_id": "13bba601-628d-3159-a7fc-3360fc429bc7",
                        "source_sense_id": "7207a7a6-2c8b-374d-9636-6fef6a495e52",
                        "source_sense_description": "kompas",
                        "target_lang_word": "compass",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "compass",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3d5fdc54-f8dd-3707-8947-415436440c3e",
                                        "entry_id": "810c757d-7189-3545-a5cf-d357c1306a31",
                                        "glosses": [
                                            "A magnetic or electronic device used to determine the cardinal directions (usually magnetic or true north)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be4f455d-dd65-4731-8276-eb06b862ded4",
                                                "sense_id": "3d5fdc54-f8dd-3707-8947-415436440c3e",
                                                "text": "[H]ow many Seas to our fore-fathers impaſſable, for want of the Compaſſe?"
                                            },
                                            {
                                                "example_id": "b6c75424-f50e-4e1f-8446-e21890321499",
                                                "sense_id": "3d5fdc54-f8dd-3707-8947-415436440c3e",
                                                "text": "1689/1690, John Locke, On improvement of understanding\nHe that […] first discovered the use of the compass […] did more for the propagation of knowledge […] than those who built workhouses."
                                            },
                                            {
                                                "example_id": "8c4af9ad-1b38-420d-a8a6-8977d800657d",
                                                "sense_id": "3d5fdc54-f8dd-3707-8947-415436440c3e",
                                                "text": "a glance at his compass would have shown him that a northerly course instead of an easterly could not be right"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9cc7e468-3e3d-3ef5-adc8-799b01c54072",
                                        "entry_id": "810c757d-7189-3545-a5cf-d357c1306a31",
                                        "glosses": [
                                            "A pair of compasses (a device used to draw circular arcs and transfer length measurements)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f706c945-dbba-412c-87ec-b2c14bfd8dab",
                                                "sense_id": "9cc7e468-3e3d-3ef5-adc8-799b01c54072",
                                                "text": "to fix one foot of their compass wherever they please"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "875fa196-f2fd-31d4-8409-e316543dd631",
                                        "entry_id": "810c757d-7189-3545-a5cf-d357c1306a31",
                                        "glosses": [
                                            "The range of notes of a musical instrument or voice."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "20ae8ac8-5729-4ed8-b5db-04db2c07c645",
                                                "sense_id": "875fa196-f2fd-31d4-8409-e316543dd631",
                                                "text": "You would sound me from my lowest note to the top of my compass."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "888581be-d87e-30ad-b6ef-fe2322478bbf",
                                        "entry_id": "810c757d-7189-3545-a5cf-d357c1306a31",
                                        "glosses": [
                                            "A space within limits; an area."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7b23ffd0-2a3d-4fbd-bbcc-4ce2b64a40e6",
                                                "sense_id": "888581be-d87e-30ad-b6ef-fe2322478bbf",
                                                "text": "In going up the Missisippi ^([sic]), we meet with nothing remarkable before we come to the Detour aux Anglois, the English Reach: in that part the river takes a large compass."
                                            },
                                            {
                                                "example_id": "a0b89ffc-b2b8-42ce-97d4-b748742c0675",
                                                "sense_id": "888581be-d87e-30ad-b6ef-fe2322478bbf",
                                                "text": "Animals, in their generation, are wiser than the sons of men but their wisdom is confined to a few particulars, and lies in a very narrow compass."
                                            },
                                            {
                                                "example_id": "914dfbaa-93a8-4b0c-8a00-bf7058d88052",
                                                "sense_id": "888581be-d87e-30ad-b6ef-fe2322478bbf",
                                                "text": "Clara thought she had never seen him look so small and mean. He was as if trying to get himself into the smallest possible compass."
                                            },
                                            {
                                                "example_id": "999c7bc9-072e-4412-8d69-5b49c602a12b",
                                                "sense_id": "888581be-d87e-30ad-b6ef-fe2322478bbf",
                                                "text": "Among tank engines, the 0-6-2 wheel arrangement was by far the most numerous, there being nearly 450 of this arrangement, which offers the advantage of good power and adhesive weight, coupled with adequate tank and bunker capacity, within a limited compass."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c247da08-7773-3c2e-80d6-a7c970b0fe79",
                                        "entry_id": "810c757d-7189-3545-a5cf-d357c1306a31",
                                        "glosses": [
                                            "An enclosing limit; a boundary, a circumference."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1e79fa4a-08e4-40b6-8885-1cef14e04b34",
                                                "sense_id": "c247da08-7773-3c2e-80d6-a7c970b0fe79",
                                                "text": "within the compass of an encircling wall"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d9b14a3d-0d39-30e8-af4c-5a02023a1c8e",
                                        "entry_id": "810c757d-7189-3545-a5cf-d357c1306a31",
                                        "glosses": [
                                            "Moderate bounds, limits of truth; moderation; due limits; used with within."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d83d502c-43b2-4abc-b92e-68fc6838d51a",
                                                "sense_id": "d9b14a3d-0d39-30e8-af4c-5a02023a1c8e",
                                                "text": "In two hundred years before (I speak within compass), no such commission had been executed."
                                            },
                                            {
                                                "example_id": "13282c5e-6190-4683-9406-26280bc88cbf",
                                                "sense_id": "d9b14a3d-0d39-30e8-af4c-5a02023a1c8e",
                                                "text": "\"Saints!\" she cried, \"but what a noise you keep! Can you not speak in compass?\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "73c5968b-e5e1-3348-89b1-66a6576039f5",
                                        "entry_id": "810c757d-7189-3545-a5cf-d357c1306a31",
                                        "glosses": [
                                            "Synonym of scope."
                                        ],
                                        "tags": [
                                            "formal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3938529c-e099-4b59-ab0f-a34092ff14d8",
                                                "sense_id": "73c5968b-e5e1-3348-89b1-66a6576039f5",
                                                "text": "the compass of his argument"
                                            },
                                            {
                                                "example_id": "9e514952-d3dc-422d-8ccc-1812e1b4a431",
                                                "sense_id": "73c5968b-e5e1-3348-89b1-66a6576039f5",
                                                "text": "There is a truth and falsehood in all propositions on this subject, and a truth and falsehood, which lie not beyond the compass of human understanding."
                                            },
                                            {
                                                "example_id": "d06d0e79-8873-47ae-9013-52c7fa4812b3",
                                                "sense_id": "73c5968b-e5e1-3348-89b1-66a6576039f5",
                                                "text": "How very commonly we hear it remarked that such and such thoughts are beyond the compass of words! I do not believe that any thought, properly so called, is out of the reach of language."
                                            },
                                            {
                                                "example_id": "0b779cb2-5ca6-48fe-956d-dafc637a6666",
                                                "sense_id": "73c5968b-e5e1-3348-89b1-66a6576039f5",
                                                "text": "The 1664 pages of this Collegiate make it the most comprehensive ever published. And its treatment of words is as nearly exhaustive as the compass of an abridged work permits."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "858e0756-6b92-3319-83e5-45eae6436b2e",
                                        "entry_id": "810c757d-7189-3545-a5cf-d357c1306a31",
                                        "glosses": [
                                            "Range, reach."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a9dae5e1-9772-41e6-a398-fe1e9ccabfac",
                                                "sense_id": "858e0756-6b92-3319-83e5-45eae6436b2e",
                                                "text": "Lou's not Times foole, though roſie lips and cheeks\nVVithin his bending ſickles compaſſe come,\nLoue alters not with his breefe houres and vveekes,\nBut beares it out euen to the edge of doome:\nIf this be error and vpon me proued,\nI neuer vvrit, nor no man euer loued."
                                            },
                                            {
                                                "example_id": "90b810f2-564a-4ec5-97fd-e3df00c4d6b0",
                                                "sense_id": "858e0756-6b92-3319-83e5-45eae6436b2e",
                                                "text": "Then when our powers in points of ſwords are ioin’d\nAnd cloſde in compaſſe of the killing bullet,\nThough ſtraite the paſſage and the port be made,\nThat leads to Pallace of my brothers life,\nProud is his fortune if we pierce it not."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6c3f3727-a79d-3286-8ef4-0bc107a9a07c",
                                        "entry_id": "810c757d-7189-3545-a5cf-d357c1306a31",
                                        "glosses": [
                                            "A passing round; circuit; circuitous course."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ad570625-3b5e-4e01-8c6b-9ca6c7fe2995",
                                                "sense_id": "6c3f3727-a79d-3286-8ef4-0bc107a9a07c",
                                                "text": "They fetched a compass of seven days' journey."
                                            },
                                            {
                                                "example_id": "fb339b35-baaa-4762-82c1-e2783758c8ab",
                                                "sense_id": "6c3f3727-a79d-3286-8ef4-0bc107a9a07c",
                                                "text": "This day I breathed first; time is come round, / And where I did begin, there shall I end; / My life is run his compass."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8c5804fe-8636-35a6-b4e3-4a25df0367e9",
                                        "entry_id": "810c757d-7189-3545-a5cf-d357c1306a31",
                                        "glosses": [
                                            "A curved circular form."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "compass",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d24ec58c-eabe-3948-af9b-8e2624b5f0b7",
                                        "entry_id": "a13d1c07-506b-3874-b2b7-c8d35eef1781",
                                        "glosses": [
                                            "To surround; to encircle; to environ; to stretch round."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b0133416-084e-4b7d-bc67-96fd5fd54144",
                                                "sense_id": "d24ec58c-eabe-3948-af9b-8e2624b5f0b7",
                                                "text": "Now all the blessings\nOf a glad father compass thee about!"
                                            },
                                            {
                                                "example_id": "9ee7904c-3523-46e6-8e36-52efe87ca7fe",
                                                "sense_id": "d24ec58c-eabe-3948-af9b-8e2624b5f0b7",
                                                "text": "And the name of the second river is Gihon: the same is it that compasseth the whole land of Ethiopia."
                                            },
                                            {
                                                "example_id": "20016c6c-5a84-4d3f-9ce4-996c0f95495d",
                                                "sense_id": "d24ec58c-eabe-3948-af9b-8e2624b5f0b7",
                                                "text": "Jack was called plucky, and he was, but it took all the strength of will that the slim, resolute engineer possessed, to hold him to his purpose, when he faced about and surveyed the unimpassive faces which compassed him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e73a3a4a-828a-3fd2-8106-73da4e91f9e9",
                                        "entry_id": "a13d1c07-506b-3874-b2b7-c8d35eef1781",
                                        "glosses": [
                                            "To go about or round entirely; to traverse."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f5d932b3-a508-3c94-b645-80efc4052fae",
                                        "entry_id": "a13d1c07-506b-3874-b2b7-c8d35eef1781",
                                        "glosses": [
                                            "To accomplish; to reach; to achieve; to obtain."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "63a42d0f-9951-4ceb-be38-928ebad79ddd",
                                                "sense_id": "f5d932b3-a508-3c94-b645-80efc4052fae",
                                                "text": "[…] tho' theſe ſeem'd to be very unfit Inſtruments for compaſſing of that great Deſign for which they were then employ'd, becauſe of their Inability and Uncapacity in performing the Work ſo very great and important; […]"
                                            },
                                            {
                                                "example_id": "1ae34466-f439-4ad3-8550-fe4444101819",
                                                "sense_id": "f5d932b3-a508-3c94-b645-80efc4052fae",
                                                "text": "[...] they never find ways sufficient to compass that end."
                                            },
                                            {
                                                "example_id": "a81bab77-618c-4546-b035-050d190d876e",
                                                "sense_id": "f5d932b3-a508-3c94-b645-80efc4052fae",
                                                "text": "[...] to settle the end of our action or disputation; and then to take fit and effectual means to compass that end."
                                            },
                                            {
                                                "example_id": "3796ad3d-5dad-4df2-b60e-6f6f9e98af25",
                                                "sense_id": "f5d932b3-a508-3c94-b645-80efc4052fae",
                                                "text": "[...] and was an artful flatterer, when that was necessary to compass his end, in which generally he was successful."
                                            },
                                            {
                                                "example_id": "cc71851a-9587-47e7-9004-8c5340a45a10",
                                                "sense_id": "f5d932b3-a508-3c94-b645-80efc4052fae",
                                                "text": "The immediate problem is how to compass that end: by the seizure of territory or by the cultivation of the goodwill of the people whose business she seeks."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "35c0aa5f-3202-3a4d-9a4d-1ddde1479234",
                                        "entry_id": "a13d1c07-506b-3874-b2b7-c8d35eef1781",
                                        "glosses": [
                                            "To plot; to scheme (against someone)."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "951b9818-415e-4b17-acd6-f4685a3b1f38",
                                                "sense_id": "35c0aa5f-3202-3a4d-9a4d-1ddde1479234",
                                                "text": "But it went beyond it by the loose construction of compassing to depose the King, …"
                                            },
                                            {
                                                "example_id": "307bbb1d-8afc-4133-b2b3-51b8d4b67aff",
                                                "sense_id": "35c0aa5f-3202-3a4d-9a4d-1ddde1479234",
                                                "text": "That he plotted and compassed to raise Sedition and Rebellion [...]"
                                            },
                                            {
                                                "example_id": "a634e007-fe08-464f-a0d0-e9dea32c884c",
                                                "sense_id": "35c0aa5f-3202-3a4d-9a4d-1ddde1479234",
                                                "text": "The Bavarian felt a mad wave of desire for her sweep over him. What scheme wouldn't he compass to mould that girl to his wishes."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "compass",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "16bc5093-dec5-34de-bd2e-afa7e3bf6442",
                                        "entry_id": "976a139c-d73c-3e84-b34a-8ef7dc40f851",
                                        "glosses": [
                                            "In a circuit; round about."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d7b35684-ae66-4490-b720-58abccf84e15",
                                                "sense_id": "16bc5093-dec5-34de-bd2e-afa7e3bf6442",
                                                "text": "[T]he Towne is impailed about halfe a mile compaſſe."
                                            },
                                            {
                                                "example_id": "f55e2164-c5d0-4ee7-8275-333a43bf379f",
                                                "sense_id": "16bc5093-dec5-34de-bd2e-afa7e3bf6442",
                                                "text": "Near the same plot of ground, for about six yards compasse were digged up coals and incinerated substances, […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
