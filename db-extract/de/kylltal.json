                "senses": [
                    {
                        "sense_id": "81bbeb15-bdd2-3859-ad21-0a8240834b30",
                        "entry_id": "a5b37b24-ec61-3591-ba19-cab7eef29194",
                        "glosses": [
                            "das Tal, in dem die Kyll fließt"
                        ],
                        "tags": [
                            "geography"
                        ],
                        "examples": [
                            {
                                "example_id": "b50a0eb0-1d7b-407e-91ef-d4d2393d7c4e",
                                "sense_id": "81bbeb15-bdd2-3859-ad21-0a8240834b30",
                                "text": "„Der Abstieg ins Kylltal wird vom Rauschen des Flusses begleitet, bevor es wieder bergauf geht.“"
                            },
                            {
                                "example_id": "e145ff65-6685-46d7-b412-182065ff8fb8",
                                "sense_id": "81bbeb15-bdd2-3859-ad21-0a8240834b30",
                                "text": "„Wie geht es den Menschen im Kylltal ein Jahr nach der Flut?“"
                            },
                            {
                                "example_id": "e7aea828-c297-4850-9b61-df2f8b4c316f",
                                "sense_id": "81bbeb15-bdd2-3859-ad21-0a8240834b30",
                                "text": "„Mit einem sagenhaften Blick ins Kylltal und die Waldeifel.“"
                            },
                            {
                                "example_id": "7013398c-aafa-42a3-96fc-f4eeefce665f",
                                "sense_id": "81bbeb15-bdd2-3859-ad21-0a8240834b30",
                                "text": "„Im oberen Kylltal im deutsch-belgischen Grenzgebiet der Eifel liegt der urige Ort Kronenburg.“"
                            },
                            {
                                "example_id": "6e6f2707-8ed3-486b-b67a-6ca35fc53ca1",
                                "sense_id": "81bbeb15-bdd2-3859-ad21-0a8240834b30",
                                "text": "„Der Wald des Kylltals liegt unter einem und die Zeit spielt hier oben keine Rolle.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
