    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "08da8812-8ca6-34dd-b0f4-e2ea57ad7a5a",
                    "sense_definition": "A tool used for cutting thin material, consisting of two crossing blades attached at a pivot point.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "cutting_tool",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please use the <w>scissors</w> to cut this piece of paper.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, используй <w>ножницы</w>, чтобы разрезать этот лист бумаги."
                            }
                        },
                        {
                            "text": "Keep the <w>scissors</w> away from small children.",
                            "target_lang_translations": {
                                "ru": "Держи <w>ножницы</w> подальше от маленьких детей."
                            }
                        }
                    ],
                    "synonyms": [
                        "pair of scissors"
                    ],
                    "common_phrases": [
                        "pair of scissors"
                    ],
                    "target_lang_definitions": {
                        "ru": "Режущий инструмент, состоящий из двух скрепленных лезвий с кольцами для пальцев."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "но́жницы",
                                "target_lang_sense_clarification": "инструмент для резания"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a3c69553-b27f-3ece-8ee3-84c61260904e",
                    "sense_definition": "An attacking move in sports where two players cross paths to confuse defenders.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "sports_move",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The team executed a perfect <w>scissors</w> to bypass the defense.",
                            "target_lang_translations": {
                                "ru": "Команда выполнила идеальные <w>ножницы</w>, чтобы обойти защиту."
                            }
                        },
                        {
                            "text": "The midfielder performed a quick <w>scissors</w> before passing the ball.",
                            "target_lang_translations": {
                                "ru": "Полузащитник выполнил быстрые <w>ножницы</w> перед тем, как отдать пас."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Спортивный прием, при котором игроки пересекают траектории движения, чтобы запутать защиту."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "но́жницы",
                                "target_lang_sense_clarification": "спортивный технический прием"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "28619b37-da5d-3aee-bae9-b30f3edca4dc",
                    "sense_definition": "A hand gesture in the game rock-paper-scissors represented by two fingers extended.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "game_move",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I chose <w>scissors</w> and beat his paper.",
                            "target_lang_translations": {
                                "ru": "Я выбрал <w>ножницы</w> и победил его бумагу."
                            }
                        },
                        {
                            "text": "In this game, rock beats <w>scissors</w> every time.",
                            "target_lang_translations": {
                                "ru": "В этой игре камень всегда бьет <w>ножницы</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "rock-paper-scissors"
                    ],
                    "target_lang_definitions": {
                        "ru": "Жест в игре «камень-ножницы-бумага», изображаемый двумя вытянутыми пальцами."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "но́жницы",
                                "target_lang_sense_clarification": "жест в игре"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "59709a30-9e57-3e3a-8ee0-dd9064b258a6",
                    "sense_definition": "A physical exercise where legs are moved back and forth in a crossing motion.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "exercise",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Do twenty <w>scissors</w> to strengthen your core muscles.",
                            "target_lang_translations": {
                                "ru": "Сделай двадцать <w>ножниц</w>, чтобы укрепить мышцы кора."
                            }
                        },
                        {
                            "text": "The instructor asked us to perform <w>scissors</w> on the floor.",
                            "target_lang_translations": {
                                "ru": "Инструктор попросил нас выполнить <w>ножницы</w> на полу."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Физическое упражнение, при котором ноги совершают перекрестные движения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "но́жницы",
                                "target_lang_sense_clarification": "физическое упражнение"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6a9e6e6d-0d00-3fd3-b3f0-678f2004bddd",
                    "sense_definition": "To cut something using or as if using <w>scissor</w>.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "cutting_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She began to <w>scissors</w> through the thick fabric with great difficulty.",
                            "target_lang_translations": {
                                "ru": "Она начала с трудом <w>резать</w> плотную ткань."
                            }
                        },
                        {
                            "text": "He tried to <w>scissors</w> the paper into a specific shape.",
                            "target_lang_translations": {
                                "ru": "Он попытался <w>вырезать</w> из бумаги определенную фигуру."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rare usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Резать что-либо с помощью ножниц."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "резать ножницами",
                                "target_lang_sense_clarification": "действие инструментом"
