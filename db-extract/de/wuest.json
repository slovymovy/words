                ],
                "senses": [
                    {
                        "sense_id": "6be71f74-7a43-31bd-82fa-8f1208554bab",
                        "entry_id": "d576007e-307b-37d9-8d64-d1d685cb612a",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e640c914-bdb9-4263-afd7-c85ee9b9b559",
                                "sense_id": "6be71f74-7a43-31bd-82fa-8f1208554bab",
                                "text": "Frau Wuest ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "b9cfce02-4a40-4d4d-9c01-ac2e289da4e7",
                                "sense_id": "6be71f74-7a43-31bd-82fa-8f1208554bab",
                                "text": "Herr Wuest wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "85e96916-60c4-4a7d-b71e-b4f4d031b105",
                                "sense_id": "6be71f74-7a43-31bd-82fa-8f1208554bab",
                                "text": "Die Wuests fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "98639e09-d33b-410d-b77f-0e509b0e554f",
                                "sense_id": "6be71f74-7a43-31bd-82fa-8f1208554bab",
                                "text": "Der Wuest trägt nie die Schals, die die Wuest ihm strickt."
                            },
                            {
                                "example_id": "d759b51b-ceb5-404e-9150-cc52f8c23322",
                                "sense_id": "6be71f74-7a43-31bd-82fa-8f1208554bab",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Wuest kommt, geht der Herr Wuest.“"
                            },
                            {
                                "example_id": "029c1ab3-b6e7-46b3-a28b-69aab73cab77",
                                "sense_id": "6be71f74-7a43-31bd-82fa-8f1208554bab",
                                "text": "Wuest kommt und geht."
                            },
                            {
                                "example_id": "efc435fb-e9bb-45f5-9b6f-5f9f17f62039",
                                "sense_id": "6be71f74-7a43-31bd-82fa-8f1208554bab",
                                "text": "Wuests kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
