                        "examples": [
                            {
                                "example_id": "8c87c7da-c5f1-4a5f-b298-31c85f3764a3",
                                "sense_id": "5c53721c-12c0-3380-9ca5-4570c9cbe0d5",
                                "text": "I'll bring thee / To clust'ring filberts, and sometimes I'll get thee / Young scamels from the rock."
                            },
                            {
                                "example_id": "44d97c1a-f86c-4cd8-826b-355957478545",
                                "sense_id": "5c53721c-12c0-3380-9ca5-4570c9cbe0d5",
                                "text": "I've seen one monkey force open the jaws of his brother, resolutely introduce his fingers, pluck from the sanctuary of his cheek the filbert he had just stowed there for his private nutrition and delight, and crunch and eat it with a stern ecstasy of selfishness, himself […]"
