                "translations": [
                    {
                        "translation_id": "1d10efbb-448d-425e-a291-393c1e98fccb",
                        "source_entry_id": "70758454-84cb-3d34-aa1f-19ec94d7bd0b",
                        "source_sense_id": "dd6737e7-b339-36c1-935f-3b153bb1e35b",
                        "source_sense_description": "meist im Plural, veraltet: unregelmäßige und häufig illegale Einkunft; Akzidenz",
                        "target_lang_word": "Akzidenz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Akzidenz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "11a30d6a-a2c2-32dc-8112-c2b314916166",
                                        "entry_id": "1986b704-80e5-37e9-8bac-64b1287397d6",
