                        "entry_id": "66788539-7b27-3953-bf7e-86d2819b89ff",
                        "glosses": [
                            "Qui fait preuve d'une grande joie, d'un grand bonheur, très heureux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7114f1f4-339d-43ae-8356-c32dfc119386",
                                "sense_id": "24c1c7d7-1286-32e7-8eec-86ec32bd15e8",
                                "text": "Il était euphorique à l’annonce de la nouvelle."
                            },
                            {
                                "example_id": "beac740b-9109-4dd4-94bb-5aababcfde05",
                                "sense_id": "24c1c7d7-1286-32e7-8eec-86ec32bd15e8",
                                "text": "Car il a une vision pour le moins euphorique de sa situation, pour ne pas dire de ses affaires."
                            },
                            {
                                "example_id": "224589bf-8a1c-44a0-b295-a744f148a80e",
                                "sense_id": "24c1c7d7-1286-32e7-8eec-86ec32bd15e8",
                                "text": "Je vous préviens, ils sont euphoriques de vous recevoir."
                            }
                        ]
                    }
                ],
