                                        "sense_id": "0cda2446-e646-3216-a6c7-4f8640393afa",
                                        "entry_id": "7d98231f-d8ad-3126-b4c5-e60c1fbcb7cf",
                                        "glosses": [
                                            "wetenschap die de overerving van eigenschappen van de ene naar de volgende generatie onderzoekt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d42e836-e26e-439f-80db-7de574a6a07d",
                                                "sense_id": "0cda2446-e646-3216-a6c7-4f8640393afa",
                                                "text": "De resultaten van het erfelijkheidsonderzoek zijn bekendgemaakt door Nederlandse onderzoekers op een congres over erfelijkheidsleer in Canada."
                                            }
                                        ]
