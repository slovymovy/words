{
    "word_family": [
        "electronic",
        "electronically",
        "electricity",
        "electron",
        "electrician"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "33ed5426-f046-3015-8f95-b969fe9cc478",
                    "sense_definition": "Devices that operate on electrical power, such as computers, phones, or televisions.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "devices",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many stores sell consumer <w>electronics</w> like laptops and smartphones.",
                            "target_lang_translations": {
                                "ru": "Многие магазины продают бытовую <w>электронику</w>, такую как ноутбуки и смартфоны.",
                                "zh": "许多商店都出售笔记本电脑和智能手机等消费类<w>电子产品</w>。"
                            }
                        },
                        {
                            "text": "We need to recycle our old <w>electronics</w> responsibly instead of throwing them away.",
                            "target_lang_translations": {
                                "ru": "Нам нужно ответственно утилизировать старую <w>электронику</w>, вместо того чтобы выбрасывать её.",
                                "zh": "我们需要负责任地回收旧<w>电子设备</w>，而不是直接扔掉。"
                            }
                        }
                    ],
                    "synonyms": [
                        "gadgets",
                        "devices"
                    ],
                    "common_phrases": [
                        "consumer electronics",
                        "portable electronics",
                        "expensive electronics"
                    ],
                    "target_lang_definitions": {
                        "ru": "Устройства, работающие от электричества, такие как компьютеры, телефоны или телевизоры.",
                        "zh": "依靠电力运行的设备，例如电脑、手机或电视。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "электроника",
                                "target_lang_sense_clarification": "устройства, техника"
                            },
                            {
                                "target_lang_word": "электронная аппаратура",
                                "target_lang_sense_clarification": "оборудование"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "电子产品",
                                "target_lang_sense_clarification": "指各类电子设备"
                            },
                            {
                                "target_lang_word": "电子设备",
                                "target_lang_sense_clarification": "指具体的电子装置"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2dfdaa86-a94e-3489-913b-0f6a924264fa",
                    "sense_definition": "The scientific study, technology, or industry of creating and using electrical devices.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "study_field",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She decided to study <w>electronics</w> at the university to become an engineer.",
                            "target_lang_translations": {
                                "ru": "Она решила изучать <w>электронику</w> в университете, чтобы стать инженером.",
                                "zh": "她决定在大学学习<w>电子学</w>，以便成为一名工程师。"
                            }
                        },
                        {
                            "text": "The global <w>electronics</w> industry is growing rapidly every year.",
                            "target_lang_translations": {
                                "ru": "Мировая индустрия <w>электроники</w> стремительно растет с каждым годом.",
                                "zh": "全球<w>电子工业</w>每年都在迅速增长。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "electronics industry",
                        "study electronics",
                        "automotive electronics"
                    ],
                    "target_lang_definitions": {
                        "ru": "Научная дисциплина, технология или отрасль промышленности, связанная с созданием и использованием электрических устройств.",
                        "zh": "研究、开发和制造电子设备的科学、技术或行业。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "электроника",
                                "target_lang_sense_clarification": "наука или отрасль"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "电子学",
                                "target_lang_sense_clarification": "指科学研究领域"
                            },
                            {
                                "target_lang_word": "电子工业",
                                "target_lang_sense_clarification": "指相关产业"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "72fe9d1e-b49b-3d95-b9e4-acd34b73a40d",
                    "sense_definition": "The internal circuits and components that make a device work.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "components",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>electronics</w> inside the machine were damaged by water and need repair.",
                            "target_lang_translations": {
                                "ru": "<w>Электроника</w> внутри машины была повреждена водой и требует ремонта.",
                                "zh": "机器内部的<w>电子线路</w>被水损坏了，需要维修。"
                            }
                        },
                        {
                            "text": "Modern cars rely on sophisticated <w>electronics</w> to control safety features.",
                            "target_lang_translations": {
                                "ru": "Современные автомобили полагаются на сложную <w>электронику</w> для управления функциями безопасности.",
                                "zh": "现代汽车依靠复杂的<w>电子元件</w>来控制安全功能。"
                            }
                        }
                    ],
                    "synonyms": [
                        "circuitry",
                        "circuits"
                    ],
                    "common_phrases": [
                        "sophisticated electronics",
                        "onboard electronics",
                        "control electronics"
                    ],
                    "target_lang_definitions": {
                        "ru": "Внутренние схемы и компоненты, обеспечивающие работу устройства.",
                        "zh": "使设备运行的内部电路和组件。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "электроника",
                                "target_lang_sense_clarification": "внутренние компоненты, схемы"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "电子线路",
                                "target_lang_sense_clarification": "指内部电路"
                            },
                            {
                                "target_lang_word": "电子元件",
                                "target_lang_sense_clarification": "指内部组件"
                            }
                        ]
                    }
                }
            ]
        }
    ]
