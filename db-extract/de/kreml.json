                        ],
                        "form": "den Kreml"
                    },
                    {
                        "form_id": "39c273b9-5e69-48ad-9a58-864f8703c5fa",
                        "entry_id": "88d8d106-235e-3205-bfa0-f7ae527c0efa",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Kreml"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "95c4e427-c5f5-3b17-a75b-65535ac72e67",
                        "entry_id": "88d8d106-235e-3205-bfa0-f7ae527c0efa",
                        "glosses": [
                            "eine für mehrere altrussische Städte typische Burg- oder Festungsanlage"
                        ],
                        "tags": [
                            "im weitesten Sinne"
                        ],
                        "examples": [
                            {
                                "example_id": "100750da-4f9e-4a09-b981-e6135aed5ced",
                                "sense_id": "95c4e427-c5f5-3b17-a75b-65535ac72e67",
                                "text": "Wenn Peter I. die Kreml in Moskau, Pskow, Smolensk, Nowgorod und Kiew noch verstärkte, so ist das auf den drohenden Einfall der Schweden zurückzuführen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c2b1c374-4941-3dc0-b831-de75d41e6b49",
                        "entry_id": "88d8d106-235e-3205-bfa0-f7ae527c0efa",
                        "glosses": [
                            "der Moskauer Kreml, die weithin bekannteste dieser ehemaligen Festungen"
                        ],
                        "tags": [
                            "im engeren Sinne"
                        ],
                        "examples": [
                            {
                                "example_id": "827652a7-78ef-4622-9e7d-a53338098c39",
                                "sense_id": "c2b1c374-4941-3dc0-b831-de75d41e6b49",
                                "text": "Der Kreml ist älter als Moskau und älter als Rußland."
                            },
                            {
                                "example_id": "b35bf0a6-2e01-4597-915b-650bde46a6b7",
                                "sense_id": "c2b1c374-4941-3dc0-b831-de75d41e6b49",
                                "text": "„Er wollte Festbälle geben und zu üppigen Mahlzeiten einladen, mit dem Zaren Arm in Arm auf dem Balkon des Kremls stehen und die vorbeiziehenden Soldaten grüßen.“"
                            },
                            {
                                "example_id": "256d905e-51fa-4a59-892a-115b903de68c",
                                "sense_id": "c2b1c374-4941-3dc0-b831-de75d41e6b49",
                                "text": "„Kaum war Petja auf dem Platz, als er auch schon mit der grössten Deutlichkeit das Glockenläuten hörte, das den ganzen Kreml erfüllte, und dazu das frohe und lebhafte Stimmengewirr der Menge.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "69e3c981-e75c-3172-8f77-3492c81f44cd",
                        "entry_id": "88d8d106-235e-3205-bfa0-f7ae527c0efa",
                        "glosses": [
                            "oft metonymisch für die russische oder frühere sowjetische Staatsmacht, speziell den Präsidenten Russlands, der seinen Amtssitz im Moskauer Kreml hat, die russische Regierung oder präsidenten- oder regierungsnahe Behörden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6b7842f3-84e6-4195-bbb5-658969cbe4f7",
                                "sense_id": "69e3c981-e75c-3172-8f77-3492c81f44cd",
                                "text": "Den ost- und mitteleuropäischen Raum betrachtet der Kreml als eine Art Interessensphäre, die zwischen Russland und dem Westen aufgeteilt werden sollte."
                            },
                            {
                                "example_id": "e005e12a-995d-44c2-9b16-820b1b21bf1e",
                                "sense_id": "69e3c981-e75c-3172-8f77-3492c81f44cd",
                                "text": "Zum anderen wurde im Verlauf der Konferenz auch Kritik an der Sowjetunion deutlich, die sich in erster Linie auf die Politik des Kreml gegenüber Ost- und Mitteleuropa konzentrierte."
                            },
                            {
                                "example_id": "e1bca1a9-60c4-4349-b5ca-f4ab60873ea7",
                                "sense_id": "69e3c981-e75c-3172-8f77-3492c81f44cd",
                                "text": "„Doch der Kreml hat ganz andere Prioritäten.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "035da707-088b-47ec-8c8e-65d56ae51b32",
                        "source_entry_id": "88d8d106-235e-3205-bfa0-f7ae527c0efa",
                        "source_sense_id": "95c4e427-c5f5-3b17-a75b-65535ac72e67",
                        "source_sense_description": "im weitesten Sinne: eine für mehrere altrussische Städte typische Burg- oder Festungsanlage",
                        "target_lang_word": "kremlin",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kremlin",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "56aa6b00-4189-39b9-86aa-3f18e5d61304",
                                        "entry_id": "05810e2c-d171-3436-9225-28f81b61a2e8",
                                        "glosses": [
                                            "A fortified, central complex found in various Russian cities."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c0e41cd-42f4-464e-be42-3e707ccd4f43",
                                                "sense_id": "56aa6b00-4189-39b9-86aa-3f18e5d61304",
                                                "text": "9% of historical parks are the gardens of monasteries and kremlins (fortified centres in the towns), 8% are urban (\"public\") gardens and only 2% are parks on urban estates."
                                            },
                                            {
                                                "example_id": "43adcacb-5e7a-4575-87e6-48252a39da9a",
                                                "sense_id": "56aa6b00-4189-39b9-86aa-3f18e5d61304",
                                                "text": "Several cities in Russia were built around fortresses called kremlins. Russians built kremlins for defense during the Middle Ages. A kremlin was often located along a river."
                                            },
                                            {
                                                "example_id": "31ff43b8-7e76-4e7f-b422-f152f0e1ad26",
                                                "sense_id": "56aa6b00-4189-39b9-86aa-3f18e5d61304",
                                                "text": "The centre of the kremlin usually held the prince's or voivode’s court, the cathedral, and the bishop's court. This arrangement can be seen in quite a number of 16th-century kremlins. The main street of the kremlin connected this complex with the gate leading to the marketplace."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
