                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59067a6b-bf45-4bfd-8544-14c5b9db3743",
                                "sense_id": "19f92690-4636-3a46-9b6b-eb812e837aa4",
                                "text": "На столе́ ря́дом с ма́леньким то́лстеньким самова́ром стоя́л су́пник с осты́вшими ща́ми и блю́до с оста́тками како́го-то со́уса.",
                                "translation": "On the table, beside a podgy little samovar, was a soup tureen with some cold cabbage-soup in it, and a dish with traces of some sauce on it.",
                                "english": "On the table, beside a podgy little samovar, was a soup tureen with some cold cabbage-soup in it, and a dish with traces of some sauce on it."
                            }
                        ]
                    }
                ],
