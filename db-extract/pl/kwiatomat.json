                                "target_word": "flower",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "883f75a6-ade3-3dde-964c-36b78ee8fb18",
                                        "entry_id": "2311bae8-26db-3b88-9757-0ca9127701e2",
                                        "glosses": [
                                            "Something that flows, such as a river."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "22f86bd5-856c-4ccb-9d68-7e4c758b04c4",
                                                "sense_id": "883f75a6-ade3-3dde-964c-36b78ee8fb18",
                                                "text": "one that flows with force and speed; the fast flower"
                                            },
                                            {
                                                "example_id": "f76e37ff-6331-40d9-9455-d243cb787c0d",
                                                "sense_id": "883f75a6-ade3-3dde-964c-36b78ee8fb18",
                                                "text": "Leaving the weavers’ village behind you, and crossing the sandy bed of the Vengavati or ‘Swift-flower,’ which, however, contained not a drop of water, you reach the ancient Jain temple."
                                            },
                                            {
                                                "example_id": "082fdbff-3a05-4176-8d39-7f7febdda7fa",
                                                "sense_id": "883f75a6-ade3-3dde-964c-36b78ee8fb18",
                                                "text": "Rhŏdănus, i, m. The Rhodanus (now Rhone); a river of Gaul [prob. a northern word, meaning “Swift-flower or Swift-passer”]."
                                            },
                                            {
                                                "example_id": "27c86ed1-ec7c-46a6-b2e8-8baf1d373cc4",
                                                "sense_id": "883f75a6-ade3-3dde-964c-36b78ee8fb18",
                                                "text": "sará-yu, f. [swift flower: √sri] N. of a river (in Oudh), in C. gnly. û."
                                            },
                                            {
                                                "example_id": "3d1eca2a-d0b3-4157-80d8-74f39057f8e3",
                                                "sense_id": "883f75a6-ade3-3dde-964c-36b78ee8fb18",
                                                "text": "Bonnie partner with Scottish flower (5) [as a clue for CLYDE]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
