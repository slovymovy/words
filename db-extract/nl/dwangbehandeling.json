                        "examples": [
                            {
                                "example_id": "b359e7e8-a738-4500-95e5-e3a9904aa282",
                                "sense_id": "2be3824c-8802-3799-b10d-f756764c8ad7",
                                "text": "R. werd in 2014 veroordeeld tot zes jaar cel en tbs met dwangverpleging. De dwangbehandeling is inmiddels begonnen. R. verblijft in de Oostvaarderskliniek in Almere."
                            },
                            {
                                "example_id": "4902155c-4f24-4b74-9e44-cf64fc4472ac",
                                "sense_id": "2be3824c-8802-3799-b10d-f756764c8ad7",
                                "text": "Dwang hoeft niet persé, benadrukt Elzakkers, want soms stemmen wilsonbekwame mensen gewoon in met een behandeling. Bovendien kan het averechts werken. \"Het is kiezen tussen twee kwaden: niets doen met gevaar op overlijden of toch maar die dwangbehandeling.\""
                            },
                            {
                                "example_id": "c604eb96-0d10-4ff8-bae0-111cf6ef4d80",
                                "sense_id": "2be3824c-8802-3799-b10d-f756764c8ad7",
                                "text": "De vrouw werd in 1999 veroordeeld tot dwangbehandeling in een tbs-kliniek voor onder meer bedreiging met een gaspistool. Ze heeft niet geschoten."
                            }
                        ]
