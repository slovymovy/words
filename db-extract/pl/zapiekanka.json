                                            "spontane Ansammlung von Menschen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "94d8251d-802a-4715-b5ec-fcd4d64cb1f8",
                                                "sense_id": "c808c3c0-7c8f-3bc4-8f0c-391939e914d2",
                                                "text": "Nach dem Unfall gab es schnell einen Auflauf Neugieriger."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "890168a7-91f2-36f7-bf95-facf9aba7f51",
                                        "entry_id": "47df9b0a-84a5-3a55-9176-55a498abaf04",
                                        "glosses": [
                                            "im Ofen überbackenes Gericht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d724f08-be39-4cbc-8157-463c9eacc785",
                                                "sense_id": "890168a7-91f2-36f7-bf95-facf9aba7f51",
                                                "text": "Zur Nachspeise gab es einen Auflauf mit Kompott."
                                            },
                                            {
                                                "example_id": "ab4d404b-94c2-425d-86dd-7fb57e958ac5",
                                                "sense_id": "890168a7-91f2-36f7-bf95-facf9aba7f51",
                                                "text": "„Tatsächlich ist es der Name eines asiatisch angehauchten süßen Auflaufs.“"
                                            },
                                            {
                                                "example_id": "d65ff16f-259b-417c-aa54-ab5557332d80",
                                                "sense_id": "890168a7-91f2-36f7-bf95-facf9aba7f51",
                                                "text": "„Das erste Menü wurde auch aus verschiedenen Pilzsorten hergestellt, als Auflauf.“"
                                            },
                                            {
                                                "example_id": "2fc66f67-31b9-4866-a5bc-0ddf1eb420d5",
                                                "sense_id": "890168a7-91f2-36f7-bf95-facf9aba7f51",
                                                "text": "„Die Köchin hat meine Tür geöffnet und fragt, ob ich denn nicht in Jesu Namen schleunigst mit dem Auflauf reingehn will.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
