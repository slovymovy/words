                    {
                        "sense_id": "ebf05091-2065-3dce-80f5-431c20ae13ff",
                        "entry_id": "2b4bf637-f4f9-3341-89b5-27886fea66d6",
                        "glosses": [
                            "een beslissende 'game' bij tennis als de stand 6-6 is in een set"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "56f8bd92-5090-49ad-bb3a-b23d7e4cce06",
                                "sense_id": "ebf05091-2065-3dce-80f5-431c20ae13ff",
                                "text": "Met 6-3 in de tweede set en een break voorsprong in de derde kregen ze de bijna 30.000 toeschouwers stil. Herbert en Gasquet braken echter terug en waren in de tiebreak beter. Tot een vijfde set lieten ze het daarna niet meer komen: 6-4."
                            }
                        ]
                    },
                    {
                        "sense_id": "45ffbcb6-e055-3e9f-b4b2-df8b427f2d81",
                        "entry_id": "2b4bf637-f4f9-3341-89b5-27886fea66d6",
                        "glosses": [
                            "beslissend wedstrijd onderdeel bij gelijke stand"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "802f802f-40d6-4dde-9c85-58498100eb3f",
                                "sense_id": "45ffbcb6-e055-3e9f-b4b2-df8b427f2d81",
                                "text": "In Teheran werd Argentinië opzij gezet na een tiebreak, in Antwerpen waren vier sets genoeg om Italië te verslaan. Japan en de Dominicaanse Republiek trof België niet recent."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3e132536-42cc-4098-9494-4538b6768d0d",
                        "source_entry_id": "2b4bf637-f4f9-3341-89b5-27886fea66d6",
                        "source_sense_id": "ebf05091-2065-3dce-80f5-431c20ae13ff",
                        "source_sense_description": "beslissende wedstrijd bij gelijke stand",
                        "target_lang_word": "tiebreak",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tiebreak",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a08fb682-44b4-39a4-9bd0-7b3dc6d352dc",
                                        "entry_id": "10015ade-fab2-33aa-acc2-7dc17e2236f8",
                                        "glosses": [
                                            "A tiebreaker, a game or an extension to a game played to resolve a tied score."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d81afca-57b9-45f7-bab0-3c63a849dd2c",
                                                "sense_id": "a08fb682-44b4-39a4-9bd0-7b3dc6d352dc",
                                                "text": "Should the score in the tiebreak become tied at 6 points all, play must continue until one player has a two point advantage."
                                            },
                                            {
                                                "example_id": "d80b9161-ecbf-40f2-93bd-98d7d8c810e9",
                                                "sense_id": "a08fb682-44b4-39a4-9bd0-7b3dc6d352dc",
                                                "text": "2003, Athanasios Papageorgiou, Willy Spitzley, Handbook for Competitive Volleyball, Meyer & Meyer, UK, page 297,\nIf there have not been any major errors in the service reception, then the service reception strategy should not be changed during the tiebreak."
                                            },
                                            {
                                                "example_id": "12f46ea0-40ab-420f-b125-6dcb3c488f3e",
                                                "sense_id": "a08fb682-44b4-39a4-9bd0-7b3dc6d352dc",
                                                "text": "Simon committed only one unforced error in the 47-minute opening set, which required a tiebreak to settle it."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tiebreak",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e56c58c8-9ff5-3015-9214-0767281befab",
                                        "entry_id": "2fc941a9-05d5-3b69-8ed6-661be0ab4eb9",
                                        "glosses": [
                                            "To break a tie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47455fb1-e492-429e-abd7-a7241cac1fab",
                                                "sense_id": "e56c58c8-9ff5-3015-9214-0767281befab",
                                                "text": "As the end of the game, game tiebroke in favor of triad, inexplicably. I thought that two people on different teams(even if nominally aligned), like a Triad and a Judge lost ties against single factions with more members(2 town)."
                                            }
                                        ]
                                    }
                                ]
                            }
