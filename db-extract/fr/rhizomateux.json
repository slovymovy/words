                        "entry_id": "6bb20ac2-b52e-3950-b9d9-4064b60eb1b9",
                        "glosses": [
                            "Qui est pourvu d'un rhizome, tige souterraine qui se distingue d'une racine par ses feuilles réduites à des écailles, ses nœuds et ses bourgeons produisant des tiges aériennes et des racines adventives."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a827c798-85b6-436c-9ef2-0ef93e1c16f3",
                                "sense_id": "63d76ee7-3267-3385-bb6d-477ab7aa8005",
                                "text": "Il faut distinguer iris rhizomateux et iris bulbeux."
                            },
                            {
                                "example_id": "ce558197-dfe0-47fc-b0d4-37c5fb4d3a21",
                                "sense_id": "63d76ee7-3267-3385-bb6d-477ab7aa8005",
                                "text": "Le bambou noir (Phyllostachis nigra) est rhizomateux mais peu traçant."
                            }
                        ]
                    }
