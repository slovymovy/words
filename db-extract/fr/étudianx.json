                        "sense_id": "7997ec7c-0bb8-3849-a0c1-d3736643c5bf",
                        "entry_id": "5440f8de-583d-3e3d-97a1-0769778daa54",
                        "glosses": [
                            "Personne dont le genre est non-binaire ou inconnu qui suit les cours d’une université ou d’un autre établissement d’enseignement supérieur."
                        ],
                        "tags": [
                            "neologism",
                            "singular"
                        ],
                        "examples": [
                            {
                                "example_id": "5b754a8d-246d-4f1f-8ce3-452a8f19bd96",
                                "sense_id": "7997ec7c-0bb8-3849-a0c1-d3736643c5bf",
                                "text": "je dirais qu'en tant qu’étudianx le fait qu’une école soit RNCP vous offre une garantie"
                            },
                            {
                                "example_id": "988cafd4-6dad-4414-907a-53518669f085",
                                "sense_id": "7997ec7c-0bb8-3849-a0c1-d3736643c5bf",
                                "text": "Frank Nasca (iel/elleui) est um étudianx en droit queer et transgenre à l’Osgoode Hall Law School."
                            }
                        ]
                    },
                    {
                        "sense_id": "5086f888-fac7-38ef-8ead-d9d110f48dcb",
                        "entry_id": "5440f8de-583d-3e3d-97a1-0769778daa54",
                        "glosses": [
                            "Groupe de persones de genres inconnus, non-binaires ou différents qui suivent les cours d’une université ou d’un autre établissement d’enseignement supérieur."
                        ],
                        "tags": [
                            "plural"
                        ],
                        "examples": [
                            {
                                "example_id": "6c47cd65-de8c-4660-92cc-4d659e747841",
                                "sense_id": "5086f888-fac7-38ef-8ead-d9d110f48dcb",
                                "text": "Dans ce workshop, des étudianx de diverses disciplines, arts visuels et design d'interaction, ont adopté une approche expérimentale et pratique pour renverser cette relation."
                            },
                            {
                                "example_id": "c098a121-51c0-46d5-a2b7-468d3657d585",
                                "sense_id": "5086f888-fac7-38ef-8ead-d9d110f48dcb",
                                "text": "inscriptions prioritaires aux étudianX de l’ARC COVER"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6a7af84a-e05f-43d4-ae10-deb00bfa2047",
                        "source_entry_id": "5440f8de-583d-3e3d-97a1-0769778daa54",
                        "target_lang_word": "student",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "student",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6ce892b3-d1d3-3db6-b46f-b57022283a4f",
                                        "entry_id": "900e9f36-1942-3cd1-ba3d-2b38aebff53c",
                                        "glosses": [
                                            "A person who studies or learns about a particular subject."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e2f98bb-92b6-41d3-8ffa-09a04019519f",
                                                "sense_id": "6ce892b3-d1d3-3db6-b46f-b57022283a4f",
                                                "text": "She is a student of human interactions."
                                            },
                                            {
                                                "example_id": "2a61a31f-8e73-4645-b81e-cbfc82f587dc",
                                                "sense_id": "6ce892b3-d1d3-3db6-b46f-b57022283a4f",
                                                "text": "He is a student of life."
                                            },
                                            {
                                                "example_id": "9bc625f9-c6ce-4d2c-940e-dbe829103b44",
                                                "sense_id": "6ce892b3-d1d3-3db6-b46f-b57022283a4f",
                                                "text": "I am not tall enough to become the function well, nor leane enough to bee thought a good Studient : but to be ſaid an honeſt man and a good houſkeeper goes as fairely, as to ſay, a carefull man, & a great ſcholler. The Competitors enter."
                                            },
                                            {
                                                "example_id": "87b0e656-bc67-4361-bc02-80853055f320",
                                                "sense_id": "6ce892b3-d1d3-3db6-b46f-b57022283a4f",
                                                "text": "The student of marine life in Southern California should become aware that […] a great many changes have taken place during the past century that have modified the characters of the plant and animal communities of the seashore."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8f048fc0-2abb-3120-89c6-1e9d97f3b23b",
                                        "entry_id": "900e9f36-1942-3cd1-ba3d-2b38aebff53c",
                                        "glosses": [
                                            "A person who is formally enrolled at a school, a college or university, or another educational institution."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "905bf065-8154-4ddf-b033-f5feab77e550",
                                                "sense_id": "8f048fc0-2abb-3120-89c6-1e9d97f3b23b",
                                                "text": "The students were out raising funds for rag week."
                                            },
                                            {
                                                "example_id": "6c54da99-58c3-4646-b80e-b2946778ffd4",
                                                "sense_id": "8f048fc0-2abb-3120-89c6-1e9d97f3b23b",
                                                "text": "In general, alſo, it may be obſerved, that a greater degree of gentility is affixed to the character of a ſtudent in England than elſewhere ; by which means our clergy have an opportunity of ſeeing better company while young, and of ſooner wearing off thoſe prejudices which they are apt to imbibe even in the beſt regulated univerſities, and which may be juſtly termed the vulgar errors of the wiſe."
                                            },
                                            {
                                                "example_id": "a141275a-c593-433c-aa45-067a287b35fe",
                                                "sense_id": "8f048fc0-2abb-3120-89c6-1e9d97f3b23b",
                                                "text": "In behalf of manhood and common sense, he would protest against such a conclusion ; and if any pale student, glued to his desk here, seek an apology for a way of life whose natural fruit is that pallid and emasculate scholarship of which New England has had too many examples, it will be far better that this sketch had not been written."
                                            },
                                            {
                                                "example_id": "fd7c2f54-fb90-4ac0-b6ab-73725633c4bd",
                                                "sense_id": "8f048fc0-2abb-3120-89c6-1e9d97f3b23b",
                                                "text": "A handful of young students bent on showing their patriotism had stirred up more trouble than they possibly could have imagined."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e9b937f-10c4-35dc-bec1-b9069c7173e8",
                                        "entry_id": "900e9f36-1942-3cd1-ba3d-2b38aebff53c",
                                        "glosses": [
                                            "A person who is formally enrolled at a school, a college or university, or another educational institution.",
                                            "A person who is enrolled at a college or university (as contrasted with a pupil or schoolchild attending a primary or secondary school)."
                                        ],
                                        "tags": [
                                            "in particular"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
