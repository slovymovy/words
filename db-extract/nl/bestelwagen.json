                            {
                                "example_id": "c33f237d-2824-4e47-9b95-1ecb30941253",
                                "sense_id": "09200bed-e091-381c-a1ab-b1446075dbb0",
                                "text": "Een bestelauto wordt ook wel gebruikt voor kleine verhuizingen."
                            }
                        ]
