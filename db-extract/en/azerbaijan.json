        "de-extract.jsonl": [
            {
                "entry_id": "c0735680-ab22-34a5-b4c4-e0449e70ecbb",
                "word": "Azerbaijan",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "d505d516-3903-3b7f-82f2-5ae72c99af88",
                        "entry_id": "c0735680-ab22-34a5-b4c4-e0449e70ecbb",
                        "glosses": [
                            "Aserbaidschan"
                        ],
                        "tags": [],
