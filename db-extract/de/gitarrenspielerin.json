                    {
                        "translation_id": "d6a18134-b1e4-469b-a830-86e75446a3d5",
                        "source_entry_id": "29811f94-dcc3-3a85-bce1-fd6c2338c507",
                        "source_sense_id": "ab693af1-6d6f-3223-955d-0eff187b53a1",
                        "source_sense_description": "weibliche Person, die Gitarre spielt",
                        "target_lang_word": "guitariste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
