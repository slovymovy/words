                                    {
                                        "sense_id": "e2423e1c-dcfe-380c-86ca-8e5168b18947",
                                        "entry_id": "59f0a39c-de34-3c35-8ade-53c8df999f67",
                                        "glosses": [
                                            "Eigenschaft, sich so zu verhalten, dass die eigentlichen, negativen Absicht verborgen bleibt; Hinterlist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e9f742a-b547-4065-a039-c6afc7c54870",
                                                "sense_id": "e2423e1c-dcfe-380c-86ca-8e5168b18947",
                                                "text": "„Es liegt nicht im Bereich der Möglichkeit, ihre Schlauheit, ihre Hinterlistigkeit zu ergründen.“"
                                            },
                                            {
                                                "example_id": "3925287e-a571-4815-9300-0294b295205f",
                                                "sense_id": "e2423e1c-dcfe-380c-86ca-8e5168b18947",
                                                "text": "„Neben den typischen Eigenschaften Grausamkeit und Hinterlistigkeit wurden die Soldatinnen oft als besonders verbissene und unnachgiebige Kämpferinnen beschrieben.“"
                                            },
                                            {
                                                "example_id": "ebca5a24-f484-4e11-9bd4-3099fe61deb3",
                                                "sense_id": "e2423e1c-dcfe-380c-86ca-8e5168b18947",
                                                "text": "„Sie lächelte nie und wenn doch, dann konnte man in ihren leicht nach oben gezogenen Mundwinkelnd die Hinterlistigkeit erkennen.“"
                                            }
                                        ],
