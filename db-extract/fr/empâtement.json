                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d2dc0011-b5bd-380b-bf05-c188c14717d6",
                                        "entry_id": "8e639115-79e5-30c5-874a-79dcf76b2bca",
                                        "glosses": [
                                            "A thickened part of a structure."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e60cb244-fa1a-4a1b-a129-9416e5bc3254",
                                                "sense_id": "d2dc0011-b5bd-380b-bf05-c188c14717d6",
                                                "text": "[…] the inner layer (of nearly equally large cells) lacks the regular semiannular or annular thickenings of most other leafy liverworts […]"
                                            },
                                            {
                                                "example_id": "df8a3395-36c2-4675-ad0a-61f943d5e2e3",
                                                "sense_id": "d2dc0011-b5bd-380b-bf05-c188c14717d6",
                                                "text": "They disappear at once on slightly relaxing the air-pressure, whilst true incipient thickenings of the surface remain white and unpliably stiff."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "thickening",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6ed3d51a-77a9-3b4d-8982-3fcda5216340",
                                        "entry_id": "9d26b752-94ef-3ff8-b341-e646236021a5",
                                        "glosses": [
                                            "present participle and gerund of thicken"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "gerund",
                                            "participle",
                                            "present"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "thickening",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5616080b-8fc5-35e7-be78-0a4ccde23c3d",
                                        "entry_id": "e596e0b4-a182-339d-b740-c3fd671a0db8",
                                        "glosses": [
                                            "Beginning to thicken, becoming thicker."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ff2df2e8-e506-4a3d-aa39-827e86b39db4",
                                                "sense_id": "5616080b-8fc5-35e7-be78-0a4ccde23c3d",
                                                "text": "From Keighley onwards we had obviously returned to civilisation, for the surrounding country was now studded with the sodium street lights of suburbia and a thickening industrial haze was blotting out the moon."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "60020ac8-44d8-4537-ac67-13d94131926c",
                        "source_entry_id": "688a9d87-c6c6-3815-a9c9-f85055e77c4d",
                        "target_lang_word": "impasto",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "impasto",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b28ff9a9-4322-3e60-8eb1-99f586bb5a45",
                                        "entry_id": "0ce29a31-ac98-3a63-8662-2becb0f9fd8c",
                                        "glosses": [
                                            "The use of a thick-bodied paint to create peaks and crests that physically extend from the surface of a painting."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "87b3559c-a3ea-45e7-980a-b5b2db4c6330",
                                                "sense_id": "b28ff9a9-4322-3e60-8eb1-99f586bb5a45",
                                                "text": "He was thinking, ʽGot to get a subject where a man can weight the impasto in light. Paint thin against light. Got to remember that.ʼ"
                                            },
                                            {
                                                "example_id": "9eca4dcb-0871-465f-abf4-a66698be477d",
                                                "sense_id": "b28ff9a9-4322-3e60-8eb1-99f586bb5a45",
                                                "text": "[…]all got scumbled together, eventually, by the knives of the seasons, to an impasto, feet thick, of unbelievable black topsoil in which anything could grow, not the least being bananas."
                                            },
                                            {
                                                "example_id": "cdaa6df6-e668-43cd-a98b-a2e769411c58",
                                                "sense_id": "b28ff9a9-4322-3e60-8eb1-99f586bb5a45",
                                                "text": "These dully schematic yet sentimental misfortunes surround Van Gogh's “Sower”. He ploughs on, figure accentuated in deep impasto, across a field cast in blue shadow, chrome yellow corn merging with the sun."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "impasto",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d6afe801-15c2-3996-98a0-0402ca2b5d91",
                                        "entry_id": "97fd91c1-9da0-32de-b294-474514a9ac14",
                                        "glosses": [
                                            "To paint in thick-bodied paint; to paint in impasto style."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "affab3ca-a420-4782-b41b-0ae48bf33479",
                                                "sense_id": "d6afe801-15c2-3996-98a0-0402ca2b5d91",
                                                "text": "\"She looked tall to me, and slim, with delicate Semitic features, and a full mouth that she impastoed with red lipstick to play against her […]\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
