                "senses": [
                    {
                        "sense_id": "f0fd102d-f47a-3bf5-ae84-b3e557cedc2f",
                        "entry_id": "7d59fb4a-c4ab-33ee-b6a3-72d7769bb3da",
                        "glosses": [
                            "…łączący słowa i zdania równorzędne, wskazując je jako występujące równocześnie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d3623aa5-a26b-4d6d-a0ee-22f352491b69",
                                "sense_id": "f0fd102d-f47a-3bf5-ae84-b3e557cedc2f",
