                "senses": [
                    {
                        "sense_id": "98e4f943-05f0-33db-99b5-ce6b99809a00",
                        "entry_id": "4812f36e-affe-3ddc-b863-c4b14fd2aa63",
                        "glosses": [
                            "действие по значению гл. оправдывать, оправдать"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44fb619a-6add-4aed-aa37-d5defabb4f7a",
                                "sense_id": "98e4f943-05f0-33db-99b5-ce6b99809a00",
                                "text": "Левин в оправдание стал рассказывать, что делалось на собраниях в его уезде."
                            }
                        ]
                    },
                    {
                        "sense_id": "24f4614b-f482-3f62-a7ba-99464febb84f",
                        "entry_id": "4812f36e-affe-3ddc-b863-c4b14fd2aa63",
                        "glosses": [
                            "результат такого действия; признание кого-либо невиновным или поступившим непредосудительно"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
