                                "sense_id": "4a7fc260-4005-3b8a-aa44-e5799e63a943",
                                "text": "Ik heb een nieuw dekbed gekocht voor de winter.",
                                "translation": "I bought a new duvet for the winter.",
                                "english": "I bought a new duvet for the winter."
                            },
                            {
                                "example_id": "c0de19ae-24a1-43f7-8498-7ed53853bbc1",
                                "sense_id": "4a7fc260-4005-3b8a-aa44-e5799e63a943",
                                "text": "Ze houdt van haar donzen dekbed omdat het zo warm is.",
                                "translation": "She loves her feather duvet because it's so warm.",
                                "english": "She loves her feather duvet because it's so warm."
                            },
                            {
                                "example_id": "0988a60e-c539-49ed-b7e9-a8a42172a336",
                                "sense_id": "4a7fc260-4005-3b8a-aa44-e5799e63a943",
                                "text": "Kan je een dekbed in de wasmachine wassen?",
                                "translation": "Can you wash a duvet in the washing machine?",
                                "english": "Can you wash a duvet in the washing machine?"
                            }
                        ]
