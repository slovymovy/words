                        "evangelische Kirche"
                    ]
                },
                {
                    "sense_id": "05fb9b51-f9a4-3e37-9196-115b87d371cf",
                    "sense_definition": "Institution oder leitende Organisation einer christlichen Glaubensgemeinschaft mit ihren Ämtern und Strukturen.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "Institution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In einer modernen Demokratie gilt der Grundsatz der Trennung von Staat und <w>Kirche</w>."
                        },
                        {
                            "text": "Die offizielle Haltung der <w>Kirche</w> zu gesellschaftlichen Fragen wird oft öffentlich diskutiert."
