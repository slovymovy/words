                ],
                "senses": [
                    {
                        "sense_id": "299d8df1-7d11-32a7-a99d-1a8213c5d2f2",
                        "entry_id": "6d4fa63a-bc6a-3266-9315-5917811f9099",
                        "glosses": [
                            "Enlever la poussière (de quelque chose)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7e111edd-0cd2-4575-b029-24fafdaca282",
                                "sense_id": "299d8df1-7d11-32a7-a99d-1a8213c5d2f2",
                                "text": "Bienheureux est-il donc d’avoir désempoussiéré les vieux et nobles usages!"
                            },
                            {
                                "example_id": "2dfd56b8-6459-4add-a1ee-bcc52d79ba4f",
                                "sense_id": "299d8df1-7d11-32a7-a99d-1a8213c5d2f2",
                                "text": "J. Claverie n’est point arrivé au beau résultat de la route de Bouc sans efforts ; avant d'imprégner son tableau de toute cette franche et belle poussière, il a sans doute usé plusieurs brosses en chiendent à désempoussiérer ses propres habits, car cet artiste ne comprend pas d’autre procédé que la communion fréquente avec la nature ;"
                            },
                            {
                                "example_id": "c5c59e9e-c0ad-478a-a0bf-f55dfecd0dbd",
                                "sense_id": "299d8df1-7d11-32a7-a99d-1a8213c5d2f2",
                                "text": "Nous rions pour nous désempoussiérer des mille et une préoccupations de la vie quotidienne."
                            },
                            {
                                "example_id": "9cb06c59-e0c0-4911-bc77-c068820ce11c",
                                "sense_id": "299d8df1-7d11-32a7-a99d-1a8213c5d2f2",
                                "text": "Pour deux sous désaltérer sa soif et se désempoussiérer le gosier, c’est si nouveau à Paris, si inattendu, que les robinets à cidre et à café ne s’arrêtent de couler que taris jusqu’à la dernière goutte par le Parisien reconnaissant."
                            }
                        ]
                    }
