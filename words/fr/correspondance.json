    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ea1862d0-d401-335e-b448-41f8a13c184e",
                    "sense_definition": "Liaison ou changement entre deux moyens de transport public au cours d'un trajet.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "transport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le train avait du retard et nous avons manqué notre <w>correspondance</w> à Lyon."
                        },
                        {
                            "text": "Pour aller au musée, prenez le métro jusqu'à la prochaine <w>correspondance</w>."
                        }
                    ],
                    "synonyms": [
                        "connexion",
                        "changement"
                    ],
                    "common_phrases": [
                        "manquer la correspondance",
                        "train de correspondance",
                        "prendre une correspondance"
                    ]
                },
                {
                    "sense_id": "25ae9459-730d-3b4f-941f-6511e6c21040",
                    "sense_definition": "Communication ou échange régulier de lettres ou de courriels entre des personnes.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les deux amis ont entretenu une longue <w>correspondance</w> pendant plusieurs années."
                        },
                        {
                            "text": "Les parents doivent vérifier le carnet de <w>correspondance</w> chaque fin de semaine."
                        }
                    ],
                    "synonyms": [
                        "courrier",
                        "échange"
                    ],
                    "common_phrases": [
                        "entretenir une correspondance",
                        "carnet de correspondance"
                    ]
                },
                {
                    "sense_id": "59be77da-10b3-30eb-b479-69a526a17d78",
                    "sense_definition": "Ensemble des lettres ou messages écrits échangés entre des personnes.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La <w>correspondance</w> de cet auteur célèbre a été rassemblée dans un livre."
                        },
                        {
                            "text": "L'historien a analysé toute la <w>correspondance</w> officielle de cette période diplomatique."
                        }
                    ],
                    "synonyms": [
                        "courrier"
                    ],
                    "common_phrases": [
                        "trier la correspondance",
                        "publier la correspondance"
                    ]
                },
                {
                    "sense_id": "e881b8cf-554b-3768-b461-6ac1241d85cf",
                    "sense_definition": "Rapport de conformité, d'équivalence ou de symétrie entre deux ou plusieurs éléments.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "accord",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il existe une exacte <w>correspondance</w> entre ces deux colonnes de données chiffrées."
                        },
                        {
                            "text": "Le professeur utilise une table de <w>correspondance</w> pour convertir les notes obtenues."
                        }
                    ],
                    "synonyms": [
                        "conformité",
                        "équivalence",
                        "adéquation",
                        "concordance"
                    ],
                    "antonyms": [
                        "divergence",
                        "désaccord"
                    ],
                    "common_phrases": [
                        "table de correspondance",
                        "étroite correspondance",
                        "parfaite correspondance"
                    ]
                },
                {
                    "sense_id": "90131727-c439-326d-9858-6ca61152a9ba",
                    "sense_definition": "Chronique ou dépêche d'actualité transmise à un journal par un collaborateur basé ailleurs.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "presse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce grand quotidien publiait chaque semaine une <w>correspondance</w> en provenance de Berlin."
                        },
                        {
                            "text": "Le journal a dû son succès à la qualité de ses nombreuses <w>correspondances</w>."
                        }
                    ],
                    "synonyms": [
                        "chronique",
                        "dépêche"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "terme journalistique traditionnel"
                        }
                    ]
                },
                {
                    "sense_id": "8a8b1f24-2e32-3f4b-a463-04e5cf1e459b",
                    "sense_definition": "Analogie mystérieuse reliant différentes perceptions sensorielles ou le monde visible au monde invisible.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "accord",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le poète explore une obscure <w>correspondance</w> entre les parfums et les émotions humaines."
                        },
                        {
                            "text": "Dans son sonnet célèbre, Baudelaire met en scène la <w>correspondance</w> des sens."
