                ],
                "senses": [
                    {
                        "sense_id": "318aca21-bd02-37d7-b524-d69d0e33a92d",
                        "entry_id": "4bcb640c-366d-3ed0-bb3d-1a8ff6792bd4",
                        "glosses": [
                            "Ausflug, der mit allen Schülern einer Klasse (als Schulveranstaltung) unternommen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e9954825-e84a-4969-982e-d4340f4d42ba",
                                "sense_id": "318aca21-bd02-37d7-b524-d69d0e33a92d",
                                "text": "„Die Eltern eines Mädchens, das auf einem Schulausflug beim Riverrafting tödlich verunglückte, erhalten kein Schmerzensgeld.“"
                            },
                            {
                                "example_id": "82a1902b-ce20-45c2-afe3-91c04840a0b7",
                                "sense_id": "318aca21-bd02-37d7-b524-d69d0e33a92d",
                                "text": "„Diese Zuneigung lässt sich höchstwahrscheinlich auf wehmütige Erinnerungen an Schulausflüge und Familienurlaube zurückführen.“"
                            },
                            {
                                "example_id": "ff877aaf-ee1a-4c75-9e44-7eeda0f1d3aa",
                                "sense_id": "318aca21-bd02-37d7-b524-d69d0e33a92d",
                                "text": "„Auf den ersten Kilometern kam es ihr wie ein Schulausflug vor.“"
                            },
                            {
                                "example_id": "085a89a9-b860-4b12-8705-3aed8b0d12f3",
                                "sense_id": "318aca21-bd02-37d7-b524-d69d0e33a92d",
                                "text": "„Henriette sah wirklich aus, als mache sie einen Schulausflug.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
