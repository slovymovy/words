            "senses": [
                {
                    "sense_id": "77fa5902-d1a6-3074-9915-e085f07f9171",
                    "sense_definition": "Jemand, der mode- und trendbewusst ist und genau weiß, was gerade aktuell oder hip ist; Vertreter einer jugendlichen Subkultur mit speziellem Lebensstil",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In den trendigen Cafés der Großstadt trifft man täglich viele junge <w>Hipster</w>."
                        },
                        {
                            "text": "Mit seiner markanten Brille und dem gepflegten Vollbart geht er glatt als <w>Hipster</w> durch."
                        }
                    ],
                    "common_phrases": [
                        "typischer Hipster"
                    ]
                },
                {
                    "sense_id": "2bd09bd6-5f35-3225-8004-1a884ed71331",
                    "sense_definition": "Eng anliegender Slip oder Unterhose mit geradem Beinausschnitt, der tief auf den Hüften sitzt",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "kleidung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sie kaufte sich einen bequemen <w>Hipster</w> aus reiner Baumwolle."
                        },
                        {
                            "text": "Unter der tief geschnittenen Hose trägt sie am liebsten einen unauffälligen <w>Hipster</w>."
                        }
                    ]
                },
                {
