                        "glosses": [
                            "Propensity to change."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "46cdfffe-30ca-473d-8c1d-9f35a38d92f4",
                                "sense_id": "abdab7d2-b3a6-3c2a-9fdb-9ac66e3b1859",
                                "text": "I have cause to weep—I must weep over my own changefulness, and over the sweetest illusions of my youth."
                            },
                            {
                                "example_id": "98bed58f-3472-4758-90d0-dcf671dc2bf3",
                                "sense_id": "abdab7d2-b3a6-3c2a-9fdb-9ac66e3b1859",
                                "text": "The faint fluctuations in the light as someone ironed and someone played and someone experimented and the refrigerator cycled on and off had been part of the dream. This changefulness, though barely noticeable, had been a torment. But it had stopped now."
                            },
                            {
                                "example_id": "3e65b041-2c53-48ec-82ce-cf90d7b6dd65",
                                "sense_id": "abdab7d2-b3a6-3c2a-9fdb-9ac66e3b1859",
                                "text": "Like Nijinsky he had an astounding jump, an extraordinary neck, an animal intensity, an actor’s changefulness."
                            }
                        ]
                    }
