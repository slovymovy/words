                "translations": [
                    {
                        "translation_id": "783c0494-dc6b-432e-a305-4ea9f39ca466",
                        "source_entry_id": "c9d2c4c9-4d54-35f7-bc79-6d3c39ac7eca",
                        "source_sense_description": "стать более степенным",
                        "target_lang_word": "s'assagir",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "d0443ab6-490a-49c2-bfd2-17ee536c19db",
                        "source_entry_id": "c9d2c4c9-4d54-35f7-bc79-6d3c39ac7eca",
                        "source_sense_description": "стать более степенным",
                        "target_lang_word": "se ranger",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "se ranger",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "440d92f2-b19d-326b-9316-1bf0876f4c5b",
                                        "entry_id": "3fdede55-d723-3d72-85fd-6b148f09a9bf",
                                        "glosses": [
                                            "Adopter une manière de vivre plus ordonnée, plus régulière."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82ca9d7a-197a-48cc-a8f7-6390a91bb4c3",
                                                "sense_id": "440d92f2-b19d-326b-9316-1bf0876f4c5b",
                                                "text": "Néanmoins, c’est au début de cet hiver-là, en 1910, à Anvers, que mon copain Korzakow devait me lâcher, prendre femme et, comme on dit, se ranger."
                                            },
                                            {
                                                "example_id": "a2797e11-593b-4604-832b-7ec972b85078",
                                                "sense_id": "440d92f2-b19d-326b-9316-1bf0876f4c5b",
                                                "text": "On boit au futur mariage de Blanchette, puisque décidément elle se range."
                                            },
                                            {
                                                "example_id": "e1a482e6-727e-4f67-b67e-2196a55f1f56",
                                                "sense_id": "440d92f2-b19d-326b-9316-1bf0876f4c5b",
                                                "text": "Dans le sens le plus large du terme, l’individu marié « s’est rangé » et il doit le faire si le mariage doit être viable selon sa définition institutionnelle contemporaine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0b57d0a4-2e1d-3562-8994-953a0faff2a6",
                                        "entry_id": "3fdede55-d723-3d72-85fd-6b148f09a9bf",
                                        "glosses": [
                                            "Se soumettre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3b04435-9826-454d-9674-5d21d8156b97",
                                                "sense_id": "0b57d0a4-2e1d-3562-8994-953a0faff2a6",
                                                "text": "Tous les opinants se rangèrent à son avis."
                                            },
                                            {
                                                "example_id": "90b41a23-663a-476c-9a0f-e7fceedd501f",
                                                "sense_id": "0b57d0a4-2e1d-3562-8994-953a0faff2a6",
                                                "text": "Se ranger à l’avis, à l’opinion de quelqu’un."
                                            },
                                            {
                                                "example_id": "3cde9ecc-8b31-4307-8ced-e8e7edfc1ef7",
                                                "sense_id": "0b57d0a4-2e1d-3562-8994-953a0faff2a6",
                                                "text": "Les premiers bruits de révolution avaient effrayé Pierre. Lorsque sa femme lui eut fait entendre qu’ils avaient peu à perdre et beaucoup à gagner dans un bouleversement, il se rangea vite à son opinion.."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bb3c2ccf-8d31-3c9e-b390-76c2366c66c3",
                                        "entry_id": "3fdede55-d723-3d72-85fd-6b148f09a9bf",
                                        "glosses": [
                                            "Prendre place."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86a6994a-1624-4490-b3aa-4d7ac86b5fcd",
                                                "sense_id": "bb3c2ccf-8d31-3c9e-b390-76c2366c66c3",
                                                "text": "Se ranger autour du feu, autour d’une table."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
