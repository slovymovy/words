                    },
                    {
                        "sense_id": "d269d4b4-e2a9-3bc0-92b3-90fe164da0f1",
                        "entry_id": "94db0dc0-787d-3525-8172-3f570e48cc5e",
                        "glosses": [
                            "etap rozwoju ludzkości według Lewisa Morgana"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6b3a0471-7e72-4914-84ce-1c7e97e38a1f",
                                "sense_id": "d269d4b4-e2a9-3bc0-92b3-90fe164da0f1",
                                "text": "Po etapie dzikości nastał etap barbarzyństwa."
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    },
                    {
                        "sense_id": "b5cbb904-50d2-3971-9cfb-23e2d432d9ba",
                        "entry_id": "94db0dc0-787d-3525-8172-3f570e48cc5e",
                        "glosses": [
                            "zachowanie uznane za nie do zaakceptowania"
                        ],
                        "tags": [
                            "metaphoric"
                        ],
                        "examples": [
                            {
                                "example_id": "293e0e61-5947-4aaf-902e-7249731823f4",
                                "sense_id": "b5cbb904-50d2-3971-9cfb-23e2d432d9ba",
                                "text": "Wyrzucenie starego kredensu było barbarzyństwem."
                            }
                        ],
                        "sense_index_json": "\"1.4\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5cc9cd01-cf32-45a7-a79b-afd6a3ff83ea",
                        "source_entry_id": "94db0dc0-787d-3525-8172-3f570e48cc5e",
                        "source_sense_id": "76798684-e5db-353e-b736-3e175d9f80da",
                        "target_lang_word": "barbarism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "barbarism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cf650bd2-f043-3bd7-b216-5b53bd306ec4",
                                        "entry_id": "1ff7f523-bf98-3afb-a400-5f852149a576",
                                        "glosses": [
                                            "A barbaric act."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7b88561a-4ceb-482d-b2b1-720fba69f755",
                                                "sense_id": "cf650bd2-f043-3bd7-b216-5b53bd306ec4",
                                                "text": "These barbarisms can not be allowed to continue; they must be crushed or civilization will collapse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "46f6b49d-f6a7-388d-8b10-a0258b755cb1",
                                        "entry_id": "1ff7f523-bf98-3afb-a400-5f852149a576",
                                        "glosses": [
                                            "The condition of existing barbarically."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "98f6e1cc-5aa8-4763-8585-4fb41941c3c1",
                                                "sense_id": "46f6b49d-f6a7-388d-8b10-a0258b755cb1",
                                                "text": "Like dancing, it is a remnant of ancient barbarism—fit for the days of the Chaldeans or the Babylonians, when people were only amused through their eyes—the sole entertainment of which savage nations are susceptible."
                                            },
                                            {
                                                "example_id": "1714fdc3-3bd1-4d86-9384-d8f111f60a73",
                                                "sense_id": "46f6b49d-f6a7-388d-8b10-a0258b755cb1",
                                                "text": "War is at best barbarism... Its glory is all moonshine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "04abb23e-d992-32a7-b96b-213c0ec99a0d",
                                        "entry_id": "1ff7f523-bf98-3afb-a400-5f852149a576",
                                        "glosses": [
                                            "A word hybridizing Ancient Greek and Latin or other heterogeneous roots."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c6e2a330-d57a-3b88-9130-32f927072e85",
                                        "entry_id": "1ff7f523-bf98-3afb-a400-5f852149a576",
                                        "glosses": [
                                            "An error in language use within a single word, such as a mispronunciation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd62cde1-8af9-4641-a09d-6c926c6090ac",
                                                "sense_id": "c6e2a330-d57a-3b88-9130-32f927072e85",
                                                "text": "In the jargon of the ancient grammarian, penacilin would be a barbarism."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d34768c4-48ed-4bcf-b85e-99e35eda09a3",
                        "source_entry_id": "94db0dc0-787d-3525-8172-3f570e48cc5e",
                        "source_sense_id": "76798684-e5db-353e-b736-3e175d9f80da",
                        "target_lang_word": "barbarity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "barbarity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8dc10f2b-be04-3bf5-913e-ee84549976d1",
                                        "entry_id": "65cd52f3-4cc5-3881-813a-b693b5dee660",
                                        "glosses": [
                                            "The state of being barbarous; brutality"
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0ed703d4-378a-3c02-a96f-27ad3cc90b56",
                                        "entry_id": "65cd52f3-4cc5-3881-813a-b693b5dee660",
                                        "glosses": [
                                            "A barbaric act"
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ca2dffa8-4efb-4ebc-9225-2f843fe39f3d",
                                                "sense_id": "0ed703d4-378a-3c02-a96f-27ad3cc90b56",
                                                "text": "As regards barbarities committed by the Japanese army since our war of resistance, the fall of Nanking in December 1937 is a case in point. Over 200,000 civilians were massacred within one week."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8e87ed86-8833-3349-9956-56bfea1f2f9c",
                                        "entry_id": "65cd52f3-4cc5-3881-813a-b693b5dee660",
                                        "glosses": [
                                            "crudity"
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8d7f1f64-d491-30b4-a0e3-28132f6e536e",
                                        "entry_id": "65cd52f3-4cc5-3881-813a-b693b5dee660",
                                        "glosses": [
                                            "A crude act"
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7b3db6dd-9c92-427f-b4a5-812574b9c313",
                        "source_entry_id": "94db0dc0-787d-3525-8172-3f570e48cc5e",
                        "source_sense_id": "76798684-e5db-353e-b736-3e175d9f80da",
                        "target_lang_word": "barbarie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "barbarie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fb0182c7-01ce-3b51-9e75-06bb6b4b1d0b",
                                        "entry_id": "15ffd399-6643-38eb-9862-e10087387478",
                                        "glosses": [
                                            "Manque de civilisation, ignorance des arts, des lettres et des sciences chez un peuple, souvent étranger."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cec7311e-75c6-48ab-9fdf-3040577f87fe",
                                                "sense_id": "fb0182c7-01ce-3b51-9e75-06bb6b4b1d0b",
                                                "text": "La prévention du pays, jointe à l’orgueil de la nation, nous fait oublier que la raison est de tous les climats, et que l’on pense juste partout où il y a des hommes. Nous n’aimerions pas à être traités ainsi de ceux que nous appelons barbares ; et s’il y a en nous quelque barbarie, elle consiste à être épouvantés de voir d’autres peuples raisonner comme nous."
                                            },
                                            {
                                                "example_id": "29ac247f-d794-42b8-ba2c-bd3a8a8695e0",
                                                "sense_id": "fb0182c7-01ce-3b51-9e75-06bb6b4b1d0b",
                                                "text": "Mais il était poète aussi, et la poésie, à cette époque d’absolutisme et de barbarie, était chose dangereuse lorsqu’on avait l’esprit aussi caustique que Thierrat."
                                            },
                                            {
                                                "example_id": "fa7af190-5891-4ebc-8cbe-6b16e2045339",
                                                "sense_id": "fb0182c7-01ce-3b51-9e75-06bb6b4b1d0b",
                                                "text": "À la différence de la bête, l’homme est capable de se dénaturer, de renverser le cours naturel des choses, pour le meilleur – la culture – ou pour le pire – la barbarie."
                                            },
                                            {
                                                "example_id": "eb084f8a-8a56-4964-84a2-77b59d96d78e",
                                                "sense_id": "fb0182c7-01ce-3b51-9e75-06bb6b4b1d0b",
                                                "text": "L’état de barbarie."
                                            },
                                            {
                                                "example_id": "2ca9b226-8698-4497-95ba-0704f8a1c9a1",
                                                "sense_id": "fb0182c7-01ce-3b51-9e75-06bb6b4b1d0b",
                                                "text": "Les siècles de barbarie."
                                            },
                                            {
                                                "example_id": "1fb3154f-80ba-4719-b13a-c0cf14df28d1",
                                                "sense_id": "fb0182c7-01ce-3b51-9e75-06bb6b4b1d0b",
                                                "text": "Les ténèbres de la barbarie."
                                            },
                                            {
                                                "example_id": "aa4e237b-42ee-4d13-91c6-00c70b2c25bb",
                                                "sense_id": "fb0182c7-01ce-3b51-9e75-06bb6b4b1d0b",
                                                "text": "La barbarie était grande en ce temps-là."
                                            },
                                            {
                                                "example_id": "7ca62fe9-8f3c-4702-8e47-e5dd74321d2e",
                                                "sense_id": "fb0182c7-01ce-3b51-9e75-06bb6b4b1d0b",
                                                "text": "Un peuple qui sort à peine de la barbarie."
                                            },
                                            {
                                                "example_id": "e9f12591-33cb-41d7-b8c5-7bb4d4a48c3e",
                                                "sense_id": "fb0182c7-01ce-3b51-9e75-06bb6b4b1d0b",
                                                "text": "Vivre dans un temps de barbarie."
                                            },
                                            {
                                                "example_id": "ddce459d-f0bc-4223-b6a3-bedf878c93fc",
                                                "sense_id": "fb0182c7-01ce-3b51-9e75-06bb6b4b1d0b",
                                                "text": "Être plongé dans la barbarie."
                                            },
                                            {
                                                "example_id": "8530caa3-c050-40b5-ba74-db05a38b737f",
                                                "sense_id": "fb0182c7-01ce-3b51-9e75-06bb6b4b1d0b",
                                                "text": "Barbarie de langage, de style, se dit des façons de parler grossières et impropres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "53d8d8db-0d81-3c87-80f9-f64f180c5a38",
                                        "entry_id": "15ffd399-6643-38eb-9862-e10087387478",
                                        "glosses": [
                                            "Cruauté, inhumanité."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d6670f7b-65ed-49ee-a6da-5be5968aecb3",
                                                "sense_id": "53d8d8db-0d81-3c87-80f9-f64f180c5a38",
                                                "text": "Les ennemis acharnés qui combattent les uns contre les autres avec tous les raffinements de la barbarie ne demandent et n’accordent pas de quartier."
                                            },
                                            {
                                                "example_id": "2aadbe1e-f39f-4a61-85ba-f9b263972d08",
                                                "sense_id": "53d8d8db-0d81-3c87-80f9-f64f180c5a38",
                                                "text": "Ils n’ignorent rien de tout cela et savent notamment fort bien que c’est en l’affirmant qu’ils créeront cette éternité de barbarie nécessaire au maintien des institutions qui leur sont chères."
                                            },
                                            {
                                                "example_id": "15d2da73-4ee1-4e35-8d6a-57f01b9315c0",
                                                "sense_id": "53d8d8db-0d81-3c87-80f9-f64f180c5a38",
                                                "text": "Les barbares ne sont pas nécessairement des gens courageux : ce qui leur donne de l’audace est la passivité tremblante et soumise de ceux qui sont en face d’eux.\nJe dirais même que la passivité tremblante et soumise crée des vocations de barbares et constitue une incitation à la barbarie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "76c70423-78c1-3f98-b3e5-2040b958c30f",
                                        "entry_id": "15ffd399-6643-38eb-9862-e10087387478",
                                        "glosses": [
                                            "Acte barbare."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2556ccb7-7176-49b6-a7b3-827a8adc4ed4",
                                                "sense_id": "76c70423-78c1-3f98-b3e5-2040b958c30f",
                                                "text": "Vous avez vu parmi ces barbaries ridicules les barbaries sanglantes des guerres de religion."
                                            },
                                            {
                                                "example_id": "d7c6a67e-6c9e-4636-a577-7b8d8cc88c1d",
                                                "sense_id": "76c70423-78c1-3f98-b3e5-2040b958c30f",
                                                "text": "Commettre une barbarie, un acte inhumain."
                                            },
                                            {
                                                "example_id": "7f4537b9-ccec-470e-a85d-516552976d71",
                                                "sense_id": "76c70423-78c1-3f98-b3e5-2040b958c30f",
                                                "text": "Tant de barbaries l’avaient rendu odieux à ses sujets."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
