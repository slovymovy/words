                "senses": [
                    {
                        "sense_id": "ec058ff2-d324-347c-9d82-8281ee35135a",
                        "entry_id": "10545ad5-73d2-311c-8816-b4a1a85b76ee",
                        "glosses": [
                            "Entzündung des Bauchfells"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "22349a4c-af3d-4093-8747-e97976574657",
                                "sense_id": "ec058ff2-d324-347c-9d82-8281ee35135a",
                                "text": "„Bauchfellentzündungen führen zu Übelkeit, Brechreiz und nachlassender Darmperistaltik (deshalb wird beim Verdacht der Bauch nach Darmgeräuschen abgehört).“"
                            },
                            {
                                "example_id": "50b39d09-eaea-438e-9ef8-2b808b4b26a4",
                                "sense_id": "ec058ff2-d324-347c-9d82-8281ee35135a",
                                "text": "„1920, im Alter von neunundzwanzig Jahren, erlitt Morris einen Blinddarmdurchbruch und starb an einer Bauchfellentzündung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2fb31457-dba1-482d-8cab-332bd0ffd314",
                        "source_entry_id": "10545ad5-73d2-311c-8816-b4a1a85b76ee",
                        "source_sense_id": "ec058ff2-d324-347c-9d82-8281ee35135a",
                        "source_sense_description": "Medizin: Entzündung des Bauchfells",
                        "target_lang_word": "peritonitis",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "peritonitis",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "033d3e90-1759-3716-870a-cb2b888ad492",
                                        "entry_id": "405594e5-c2ef-3c4b-83ac-462cf32857f0",
                                        "glosses": [
                                            "Inflammation of the peritoneum, especially when caused by an infectious organism introduced into the abdominal cavity."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b94ea23f-0333-4012-9112-1fd54cd9925e",
                                                "sense_id": "033d3e90-1759-3716-870a-cb2b888ad492",
                                                "text": "Intraperitoneal injections of a strong solution produce fibrohemorrhagic peritonitis of varying intensity, according to the strength of the solution; while intraperitoneal injections of small quantities of a diluted solution of formalin induce a chronic peritonitis with great connective tissue proliferation, and a striking eosinophilia."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "20efd715-291b-4f4f-82bc-3cc63712614e",
