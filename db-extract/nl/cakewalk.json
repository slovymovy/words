                        "glosses": [
                            "kermisattractie met bewegende trappen en vloeren waar men doorheen moet lopen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a934fde-adab-44c4-9dea-80b89517190a",
                                "sense_id": "81481d3f-a10f-37ec-8380-5370b88e3e28",
                                "text": "Dit gedicht is een cakewalk waarin alle vloeren onder je voeten verzakken, verschuiven en wegdraaien en waarin elke leuning waaraan je je vastklampt onder je handen ineenzijgt. (Ilja Leonard Pfeijffer NRC 1 november 2002)"
                            }
                        ]
                    }
