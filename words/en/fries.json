                {
                    "sense_id": "076a3bd2-0f18-3814-a2fb-f16089b0bdee",
                    "sense_definition": "Long, thin pieces of potato that have been cooked in hot oil.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "food_potato",
                    "name_type": "no",
                    "examples": [
                        {
