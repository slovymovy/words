                "forms": [],
                "senses": [
                    {
                        "sense_id": "6e31f873-e595-3255-a861-35d0ea352b96",
                        "entry_id": "743281c5-96aa-32cd-8992-305820a581f4",
                        "glosses": [
                            "De série, en série."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd656c87-f490-417d-ac6f-2cfb9803a332",
                                "sense_id": "6e31f873-e595-3255-a861-35d0ea352b96",
                                "text": "Par exemple, le sérial killer qui a tué 20 personnes, lui, ne serait pas déchu de la nationalité."
                            },
                            {
                                "example_id": "4690355b-22f4-41c3-8034-efdac0e94510",
                                "sense_id": "6e31f873-e595-3255-a861-35d0ea352b96",
                                "text": "Un sérial violeur."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "36520d4f-987c-479b-b51a-f1815fba57c3",
                        "source_entry_id": "743281c5-96aa-32cd-8992-305820a581f4",
                        "source_sense_id": "6e31f873-e595-3255-a861-35d0ea352b96",
