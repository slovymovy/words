                                    {
                                        "sense_id": "f8db860f-8119-3a10-9acd-582dcb8ea97c",
                                        "entry_id": "ce338807-0f06-3cfc-abb2-c56d714f50cf",
                                        "glosses": [
                                            "A type of perfume consisting of 2–5% essential oils, 70–90% alcohol and water."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bfb9a594-5db7-41a4-b9cd-e4ffead3d3a9",
                                                "sense_id": "f8db860f-8119-3a10-9acd-582dcb8ea97c",
                                                "text": "You stink of too much cologne."
                                            },
                                            {
                                                "example_id": "d1f6407d-c436-4d93-b45f-229097c01e5e",
                                                "sense_id": "f8db860f-8119-3a10-9acd-582dcb8ea97c",
                                                "text": "The perfume market has always been a two-tiered one, with a relatively small number of buyers of small bottles of real perfume and eau de parfum that cost large amounts of money, and a larger number of buyers of somewhat larger bottles of cologne and eau de toilette that are considerably more affordable but not always cheap."
                                            },
                                            {
                                                "example_id": "2bc78508-ed26-44a1-95d6-2f629ad6a2ef",
                                                "sense_id": "f8db860f-8119-3a10-9acd-582dcb8ea97c",
                                                "text": "He wore some aftershave or cologne that gave him a heavy, nasty, sweet scent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "27ad1fc1-85a4-3c53-a814-3508f65b616b",
                                        "entry_id": "ce338807-0f06-3cfc-abb2-c56d714f50cf",
                                        "glosses": [
                                            "Any of a family of fresh, citrus-based fragrances distilled using extracts from citrus, floral, and woody ingredients, said to have been developed in the early 18th century in Cologne, Germany."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "54ee3c90-3540-3b3c-b8fa-62041a880b1d",
                                        "entry_id": "ce338807-0f06-3cfc-abb2-c56d714f50cf",
                                        "glosses": [
                                            "A fragrance typically worn by a man as opposed to a woman, regardless of its concentration."
                                        ],
