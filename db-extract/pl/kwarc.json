                        ]
                    },
                    {
                        "translation_id": "7ddef5ed-1a2f-4706-91f1-8687b6a06d0e",
                        "source_entry_id": "b756f4f9-7666-3d2b-b9ca-6535c3efa36b",
                        "source_sense_id": "1dc80e03-6bde-36f9-a044-60a6b04d86da",
                        "target_lang_word": "Quarz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Quarz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "125b8009-f3cf-3e5b-9d33-daea9727b95e",
                                        "entry_id": "b3d0d0f7-7457-389b-84f6-69b45d1707cf",
                                        "glosses": [
                                            "Mineral, das in reinem Zustand farblos und durchscheinend ist und aus Siliziumdioxid besteht"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "53e49f34-d7eb-495f-bb40-c6ef05cfaa49",
                                                "sense_id": "125b8009-f3cf-3e5b-9d33-daea9727b95e",
                                                "text": "Quarz ist eines der häufigsten Mineralien in der Erdkruste."
                                            },
                                            {
                                                "example_id": "63f3de0b-9f65-45a8-971c-c1cefbe4f66f",
                                                "sense_id": "125b8009-f3cf-3e5b-9d33-daea9727b95e",
                                                "text": "„Es war keine geringe Arbeit, vor dem Aufkleben der Etiketten die Namen der Gesteine festzustellen; die Verschiedenheit der Farben und des Korns ließ sie Tonerde und Mergel, Granit und Gneis, Quarz und Kalkstein verwechseln.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5946d10c-9ae0-3f2d-9770-2345039eafd9",
                                        "entry_id": "b3d0d0f7-7457-389b-84f6-69b45d1707cf",
                                        "glosses": [
                                            "Kristall aus Quarz"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad2ae25b-562f-4709-ae51-cda1cfd2e5cc",
                                                "sense_id": "5946d10c-9ae0-3f2d-9770-2345039eafd9",
                                                "text": "„Reiner Quarz ist vollkommen transparent und farblos und wird, wenn er gut ausgebildete Kristalle entwickelt, als Bergkristall bezeichnet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "633c3655-289e-3a31-bee8-5a388ad9ef8e",
                                        "entry_id": "b3d0d0f7-7457-389b-84f6-69b45d1707cf",
                                        "glosses": [
                                            "Elektronisches Bauelement; ein speziell geschnittener Quarzkristall mit angebrachten Elektroden, dessen piezoelektrische Eigenschaften zur Frequenzstabilisierung elektrischer Schwingungen benutzt werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "312e8257-9a47-47bd-8d98-09cc4a81dd1f",
                                                "sense_id": "633c3655-289e-3a31-bee8-5a388ad9ef8e",
                                                "text": "„Die piezoelektrischen Eigenschaften des Quarzes werden bei Schwingquarzen ausgenutzt, die ähnlich einer Stimmgabel bei Erregung durch eine elektrische Spannung mit einer festen Frequenz mechanisch schwingen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6a901871-5ded-4266-adcc-a73c39e4a797",
                        "source_entry_id": "b756f4f9-7666-3d2b-b9ca-6535c3efa36b",
                        "source_sense_id": "1dc80e03-6bde-36f9-a044-60a6b04d86da",
                        "target_lang_word": "кварц",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "кварц",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "96c08021-d395-39e1-adf8-21dffebbd46b",
                                        "entry_id": "145da7c9-408d-378d-b7b8-e3b6c2d51ee0",
                                        "glosses": [
                                            "породообразующий минерал, диоксид кремния"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e4ef7cd4-547d-42ca-9660-63d351c2d37e",
                                                "sense_id": "96c08021-d395-39e1-adf8-21dffebbd46b",
                                                "text": "Кварц — один из самых рапространённых в земной коре минералов."
                                            },
                                            {
                                                "example_id": "66d4b52a-f775-4903-986f-a7e342364a40",
                                                "sense_id": "96c08021-d395-39e1-adf8-21dffebbd46b",
                                                "text": "Из кварца делают химическую посуду, а из его натечных форм — агата и яшмы — камни для часов и чувствительных приборов."
                                            },
                                            {
                                                "example_id": "7f16f1bf-25f2-4de7-8dfc-e323004367e1",
                                                "sense_id": "96c08021-d395-39e1-adf8-21dffebbd46b",
                                                "text": "Полупрозрачный нерегулярный хрусталь называется кварц."
                                            },
                                            {
                                                "example_id": "56155d84-037f-4387-8ffa-7a353da30d12",
                                                "sense_id": "96c08021-d395-39e1-adf8-21dffebbd46b",
                                                "text": "Весь двор был завален кучками золотоносного кварца, добытого рабочими."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7944a548-e409-33f9-840e-1a79146e74fc",
                                        "entry_id": "145da7c9-408d-378d-b7b8-e3b6c2d51ee0",
                                        "glosses": [
                                            "перен., , разг. то же, что кварцевый резонатор"
                                        ],
                                        "tags": [
                                            "радиотехн."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "06f04217-cf42-41d6-94b3-d1204434d558",
                                                "sense_id": "7944a548-e409-33f9-840e-1a79146e74fc",
                                                "text": "Читал, что на кварц с обеих строн надо кондёры вешать, иначе плохо заводится."
                                            }
                                        ]
                                    },
                                    {
