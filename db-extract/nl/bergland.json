                        "glosses": [
                            "een land of deel van een land met grote hoogte verschillen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "038344f4-53d7-4633-b215-31923d81562e",
                                "sense_id": "12a0f428-549a-3938-8c89-32cb3130ff14",
                                "text": "Voor de aardbeving kampte het Aziatische bergland met verschillende problemen zoals werkloosheid, armoede en de nasleep van een tien jaar durende burgeroorlog."
                            },
                            {
                                "example_id": "9808d455-c5d4-48df-9eb2-0cd539ab605b",
                                "sense_id": "12a0f428-549a-3938-8c89-32cb3130ff14",
                                "text": "De geïsoleerde ligging op gepaste afstand van toeristentoppers verandert van een nadeel in een voordeel. In elk geval voor reizigers op zoek naar stil en puur. In de diepte ligt het gehucht Eygalayes, dat tijdens de Tweede Wereldoorlog een steunpunt was van het verzet, le maquis. Frisse bloemen bij een monument voor 35 gefusilleerde verzetsmannen. In het barre bergland zijn de helden nog lang niet vergeten."
                            }
                        ]
                    }
