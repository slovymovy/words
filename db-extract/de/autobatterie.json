                            {
                                "example_id": "4731f947-ed42-4735-a459-0a57bc6bfb7c",
                                "sense_id": "76e319fa-8e36-3f3c-a510-e906cdd770ab",
                                "text": "„Die innovative Autobatterie, die einem Elektromobil die Reichweiten eines Benzin- oder Dieselfahrzeugs ermöglicht und dabei sicher und bezahlbar ist, bleibt vorerst ein Traum.“"
                            },
                            {
                                "example_id": "f36687c9-0381-44d1-8bc8-938ed86b9041",
                                "sense_id": "76e319fa-8e36-3f3c-a510-e906cdd770ab",
                                "text": "„Unter dem Tisch hing ein Kassettenrekorder an einer Autobatterie.“"
                            }
                        ],
