                ],
                "senses": [
                    {
                        "sense_id": "ed87c561-6574-32d6-b630-9553664a1a0a",
                        "entry_id": "d3199c60-c325-38f4-af75-af3bb654a76f",
                        "glosses": [
                            "eine einzelnes Korn eines Pollen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bdda5b85-4902-4737-ac2b-fa952201c37c",
                                "sense_id": "ed87c561-6574-32d6-b630-9553664a1a0a",
                                "text": "„Würde eine Raumsonde zur Erde gleiten, um nach Lebewesen zu suchen, wären die ersten konkreten Lebenszeichen in einer Höhe von etwa 20 km zu finden, und zwar Mikroben, Sporen und Pollenkörner, die vom Wind dorthin befördert wurden.“"
                            },
                            {
                                "example_id": "29483841-d4cb-49e8-97a8-1961dc11e221",
                                "sense_id": "ed87c561-6574-32d6-b630-9553664a1a0a",
                                "text": "„Blumen produzieren Pollenkörner. Sie sind klein und leicht und einige von ihnen so geformt, dass sie über lange Entfernungen durch die Luft fliegen können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
