                "forms": [],
                "senses": [
                    {
                        "sense_id": "79d07b8e-7c75-3bf9-a8b8-bdc402fabe8c",
                        "entry_id": "c9136e16-03b9-36ee-801d-6aea033d77be",
                        "glosses": [
                            "Dishwashing"
                        ],
                        "tags": [
                            "plural",
                            "plural-only"
                        ],
                        "examples": [
                            {
                                "example_id": "7da7a462-7031-40d8-9830-b7c21e4888c6",
                                "sense_id": "79d07b8e-7c75-3bf9-a8b8-bdc402fabe8c",
                                "text": "After dinner they had to do the dishes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cc206102-11f1-478a-99f8-18eca338507d",
                        "source_entry_id": "c9136e16-03b9-36ee-801d-6aea033d77be",
                        "source_sense_id": "79d07b8e-7c75-3bf9-a8b8-bdc402fabe8c",
                        "source_sense_description": "dishwashing",
                        "target_lang_word": "afwas",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "afwas",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "ce6a2af2-3b4b-3416-9358-e468d9530578",
                                        "entry_id": "521dfe81-fa40-38aa-b620-ac4a8bb75906",
                                        "glosses": [
                                            "het afwassen, het af te wassene"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e1e9fb04-d9a7-4364-8a3e-1f3aaad5f65a",
                                                "sense_id": "ce6a2af2-3b4b-3416-9358-e468d9530578",
                                                "text": "Terwijl Dora de afwas doet ziet ze door het raam de houten wolf die al klaar is op de trap zitten."
                                            },
                                            {
                                                "example_id": "73952052-b170-4e1d-9093-d1e961592e82",
                                                "sense_id": "ce6a2af2-3b4b-3416-9358-e468d9530578",
                                                "text": "Er zaten altijd gaten in mijn kleren en ik deed de afwas alleen als ik het keukenblok niet meer kon zien."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "afwas",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "624e24a7-ea64-3fd5-9c26-3840a6472c98",
                                        "entry_id": "134677ac-e574-3cf2-a782-811fa0ca6e2b",
                                        "glosses": [
                                            "eerste persoon enkelvoud tegenwoordige tijd van afwassen"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "with-subordinate-clause"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "01800da6-e173-4fed-818f-c524d4c3fe7e",
                                                "sense_id": "624e24a7-ea64-3fd5-9c26-3840a6472c98",
                                                "text": "... dat ik afwas."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bb93acd4-2850-477f-8c44-ac99152ee7e1",
                        "source_entry_id": "c9136e16-03b9-36ee-801d-6aea033d77be",
                        "source_sense_id": "79d07b8e-7c75-3bf9-a8b8-bdc402fabe8c",
                        "source_sense_description": "dishwashing",
                        "target_lang_word": "vaisselle",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vaisselle",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a191e0c3-ffa5-3f6a-b809-8dbe8b994cf9",
                                        "entry_id": "1d0d08c1-86d1-3b66-828a-ced5ad02b494",
                                        "glosses": [
                                            "Ce qui sert à l’usage ordinaire de la table, comme plats, assiettes, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e0c2973-6b98-46ad-9048-c8fb8adb09b4",
                                                "sense_id": "a191e0c3-ffa5-3f6a-b809-8dbe8b994cf9",
                                                "text": "Pif ! paf ! les gifles commencèrent à pleuvoir et la vaisselle à danser : […]."
                                            },
                                            {
                                                "example_id": "d9131889-91c0-4145-bffd-030ca8f7e156",
                                                "sense_id": "a191e0c3-ffa5-3f6a-b809-8dbe8b994cf9",
                                                "text": "Vaisselle d’or, d’argent, de vermeil, de faïence, de porcelaine. — Vaisselle unie, ciselée, armoriée."
                                            },
                                            {
                                                "example_id": "b58fd149-fcfb-4d56-8e7c-220aa7b81933",
                                                "sense_id": "a191e0c3-ffa5-3f6a-b809-8dbe8b994cf9",
                                                "text": "De vieille vaisselle. — Vaisselle au poinçon de Paris."
                                            },
                                            {
                                                "example_id": "22d35201-be66-4a1c-9ec9-a108db77f426",
                                                "sense_id": "a191e0c3-ffa5-3f6a-b809-8dbe8b994cf9",
                                                "text": "Nettoyer la vaisselle."
                                            },
                                            {
                                                "example_id": "635a21d8-9023-401f-b2b6-55d562b2ea03",
                                                "sense_id": "a191e0c3-ffa5-3f6a-b809-8dbe8b994cf9",
                                                "text": "Écurer, laver la vaisselle."
                                            },
                                            {
                                                "example_id": "39f7940c-bca9-48be-9139-852a613cf4a3",
                                                "sense_id": "a191e0c3-ffa5-3f6a-b809-8dbe8b994cf9",
                                                "text": "Faire la vaisselle, laver la vaisselle qui a servi."
                                            },
                                            {
                                                "example_id": "9a982409-5c58-482a-96c7-72cf59fd630e",
                                                "sense_id": "a191e0c3-ffa5-3f6a-b809-8dbe8b994cf9",
                                                "text": "Vaisselle montée, celle qui est composée de plusieurs pièces jointes avec de la soudure."
                                            },
                                            {
                                                "example_id": "a1abeec6-ccee-4d05-8b1a-47f2a9e7dfa7",
                                                "sense_id": "a191e0c3-ffa5-3f6a-b809-8dbe8b994cf9",
                                                "text": "Vaisselle plate, vaisselle d’or ou d’argent où il n’y a point de soudure ; il se dit aujourd’hui plus particulièrement des Plats et des assiettes d’argent, à la différence de la vaisselle de porcelaine, de faïence, etc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "00dce542-566b-319b-950f-b4b48dc05cc8",
                                        "entry_id": "1d0d08c1-86d1-3b66-828a-ced5ad02b494",
                                        "glosses": [
                                            "Objets en métal précieux servant à l'usage de la table d’un seigneur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "efae21a2-d6bd-4e07-888f-0b25583f5eb0",
                                                "sense_id": "00dce542-566b-319b-950f-b4b48dc05cc8",
                                                "text": "Romulus accueillit ce prétendant avec faveur, espérant qu’une alliance avec cet homme puissant l’aiderait à rétablir ses propres affaires qu’il avait dérangées par le luxe de son palais, de sa vaisselle et de ses jardins."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "28942b89-d26e-3974-ad93-21760b96a9dc",
                                        "entry_id": "1d0d08c1-86d1-3b66-828a-ced5ad02b494",
                                        "glosses": [
                                            "Ensemble des récipients, des plats, des assiettes, des couverts, des verres et des ustensiles de cuisine qui sont à laver."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d9ed120-d700-43ea-9b16-e203010f35a6",
                                                "sense_id": "28942b89-d26e-3974-ad93-21760b96a9dc",
                                                "text": "Ce jour-là, elle négligea son ménage. Elle laissa même la vaisselle s’empiler sur l’évier et elle cousit longtemps"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3156c093-8571-47de-aac0-c46b4ae6156f",
                        "source_entry_id": "c9136e16-03b9-36ee-801d-6aea033d77be",
                        "source_sense_id": "79d07b8e-7c75-3bf9-a8b8-bdc402fabe8c",
                        "source_sense_description": "dishwashing",
                        "target_lang_word": "Abwasch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Abwasch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "89246abd-63a2-380a-adc8-1f9ef3de6720",
                                        "entry_id": "e008b9de-daa9-35ea-ada1-3294c039b0ac",
                                        "glosses": [
                                            "das Reinigen (von Geschirr) mit Wasser sowie meist mit Reinigungsmitteln"
                                        ],
                                        "tags": [
                                            "Swiss Standard German",
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "18c0b2e7-6dd6-42dd-a22e-f0c80c07da49",
                                                "sense_id": "89246abd-63a2-380a-adc8-1f9ef3de6720",
                                                "text": "„Zuerst war ja immer noch der Abwasch da, sich daran zu halten, und Pinneberg besorgte ihn langsam und gründlich, er ging jedem Topf mit Ata und Strohwisch zu Leibe, an ihm sollte es nicht liegen.“"
                                            },
                                            {
                                                "example_id": "e20acbdd-d9e3-4750-9f78-11fd830aa02e",
                                                "sense_id": "89246abd-63a2-380a-adc8-1f9ef3de6720",
                                                "text": "„So spähen denn auch diesen Sommer und Herbst Kunsttouristen verstohlen in jeden Innenhof auf der Suche nach einem markanten, schrattigen Steinkopf von Hans Josephsohn oder ducken sich unter einem Fenster, aus dem das Geklapper des Abwaschs dringt, den Blick auf Zilla Leuteneggers Zwei-Minuten-Video ‚Blow Job‘ fixiert, das über einen Bildschirm flimmert, in eine Spalte zwischen zwei Hausmauern geklemmt.“"
                                            },
                                            {
                                                "example_id": "f7430e83-99c9-441d-b1dc-47ae7385fe81",
                                                "sense_id": "89246abd-63a2-380a-adc8-1f9ef3de6720",
                                                "text": "„Sie hat den in der Pause gereichten Kaffee nicht schnell genug getrunken, hielt damit den reibungslosen Ablauf des Abwasches auf.“"
                                            },
                                            {
                                                "example_id": "d4de8528-53a3-43ad-ab56-76e2a522ec94",
                                                "sense_id": "89246abd-63a2-380a-adc8-1f9ef3de6720",
                                                "text": "bildlich: „‹Aha, ich verstehe›, höhnte Kamloth, ‹Sie wollen vor dem Amerikaner den loyalen Mann spielen und überlassen den Abwasch mir.›“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c842f7bf-1a5d-3efa-9dde-612978f4ab80",
                                        "entry_id": "e008b9de-daa9-35ea-ada1-3294c039b0ac",
                                        "glosses": [
                                            "Geschirr, das zu spülen ist beziehungsweise bereits gespült wurde"
                                        ],
                                        "tags": [
                                            "North German",
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bc838448-9ed5-4f05-bba5-14f00f46ce40",
                                                "sense_id": "c842f7bf-1a5d-3efa-9dde-612978f4ab80",
                                                "text": "„‹[…] Ich habe wieder einen schändlichen Abwasch stehen.›“"
                                            },
                                            {
                                                "example_id": "4260b62f-d852-40de-b447-77d0b15d7694",
                                                "sense_id": "c842f7bf-1a5d-3efa-9dde-612978f4ab80",
                                                "text": "„Ich kann nur noch diesen Mann beim Bier, seine Frau, die Hände in Spüli und den gleichgültigen Blick auf den Abwasch und das Entsetzen gerichtet, betrachten.“"
                                            },
                                            {
                                                "example_id": "340f9c6d-ebf8-4157-88d3-16a5c0ceb963",
                                                "sense_id": "c842f7bf-1a5d-3efa-9dde-612978f4ab80",
                                                "text": "„Aber ich denke, dass mir nach drei Inlandflügen in zehn Tagen ohnehin ein gewisser asiatischer Gleichmut eignet, der mir hoffentlich noch eine Zeit lang erhalten bleibt, wenn mich die Gefährtin nach der Rückkehr als erstes vorwurfsvoll vor zwei Wochen hohe Stapel unerledigten Abwaschs stellt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Abwasch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0d435715-6039-3eae-92f0-2bf673386c35",
                                        "entry_id": "f22f75a9-d4b5-3070-a2a3-9fa1b11dc8d2",
                                        "glosses": [
                                            "Becken (in einer Spüle), in dem das Geschirr gespült wird"
                                        ],
                                        "tags": [
                                            "Austrian German",
                                            "regional"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f9dd10f7-0bd9-475f-b827-2af9d0050123",
                                                "sense_id": "0d435715-6039-3eae-92f0-2bf673386c35",
                                                "text": "„Unter den Abwäschen ist in der Ablaufleitung ein Fettfänger mit großer Reinigungsschraube vorzusehen.“"
                                            },
                                            {
                                                "example_id": "bebad04b-b70a-42ed-8e89-0537ee14f34a",
                                                "sense_id": "0d435715-6039-3eae-92f0-2bf673386c35",
                                                "text": "„Ich stellte die Kaffeetasse in die Abwasch und ging mit einer Menge Fragen im Kopf hinauf ins Zimmer, zog den Rock an, ging hinunter und sagte durch die Küchentür, ich gehe zum Großkaufmann, um mir ein paar Sachen zu kaufen.“"
                                            },
                                            {
                                                "example_id": "73a544cd-8500-474d-bd0d-776c94b075bb",
                                                "sense_id": "0d435715-6039-3eae-92f0-2bf673386c35",
                                                "text": "„Sie lieferten sich eine wilde Schlacht um die Hühnerschnitzel, die zum Auftauen auf der Abtropftasse der Abwasch lagen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
