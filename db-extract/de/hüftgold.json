                "senses": [
                    {
                        "sense_id": "f69d5076-6997-36d0-bb15-7de414f65412",
                        "entry_id": "da3805de-5e84-3f30-80dc-305aaec834ed",
                        "glosses": [
                            "kalorienreiche Nahrung"
                        ],
                        "tags": [
                            "colloquial",
                            "humorous"
                        ],
                        "examples": [
                            {
                                "example_id": "8bdec181-8640-47ed-93b7-36cb2608b647",
                                "sense_id": "f69d5076-6997-36d0-bb15-7de414f65412",
                                "text": "Sie nahm sich vor mehr Sport zu treiben, denn die Weihnachtsente war reines Hüftgold."
                            },
                            {
                                "example_id": "fc7aaa10-9b98-4de4-b296-c3710c93ec63",
                                "sense_id": "f69d5076-6997-36d0-bb15-7de414f65412",
                                "text": "Es braucht schon einige Beherrschung um nicht schwach zu werden – im Angesicht der sündhaft leckeren Kunstwerke wie Obsttörtchen, Millefeuille, Schoko- und Nusshörnchen, Shpakia – den mit Honig und Sesam gebackenen Zuckerschnecken, oder Briwat, den Teigtaschen mit Mandeln und Honig. Pures orientalisches Hüftgold."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "af35162c-6cdb-3f37-a1e7-277347cdfc94",
                        "entry_id": "da3805de-5e84-3f30-80dc-305aaec834ed",
                        "glosses": [
                            "Fettpolster im Hüftenbereich"
                        ],
                        "tags": [
                            "colloquial",
                            "humorous"
                        ],
                        "examples": [
                            {
                                "example_id": "37b2c403-64b2-4500-bffe-11488a28964a",
                                "sense_id": "af35162c-6cdb-3f37-a1e7-277347cdfc94",
                                "text": "Viele Männer mit Hüftgold träumen vom Waschbrettbauch."
                            },
                            {
                                "example_id": "e72fc5d1-dd48-4577-b2d0-98438118e274",
                                "sense_id": "af35162c-6cdb-3f37-a1e7-277347cdfc94",
                                "text": "„Die Ehe scheint bei Männern übrigens erst recht das Hüftgold wachsen zu lassen: Bei Verheirateten betrug der Anteil der Übergewichtigen ganze 69 Prozent.“"
                            },
                            {
                                "example_id": "537e3db3-dea5-44ad-8ed4-849a80a72c5d",
                                "sense_id": "af35162c-6cdb-3f37-a1e7-277347cdfc94",
                                "text": "[…] die Experten [untersuchten] auch jene Zellen, die hinter Hüftgold und Rettungsringen stecken – Fettzellen."
                            },
                            {
                                "example_id": "2c64afd8-2430-4d01-a1fc-0a406af6e259",
                                "sense_id": "af35162c-6cdb-3f37-a1e7-277347cdfc94",
                                "text": "[… viele Moskauer] Hauptstädter [bekommen] derzeit Speckringe um die Leibesmitte: \"Hüftgold\" - Zeichen des neuen Wohlstands."
                            },
                            {
                                "example_id": "02d68a22-fbf4-49b4-b2f3-5f2905e3cd06",
                                "sense_id": "af35162c-6cdb-3f37-a1e7-277347cdfc94",
                                "text": "Die Winke-Ärmchen, die Cellulite, das Hüftgold … jede Frau findet etwas an sich, was ihr nicht gefällt."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
