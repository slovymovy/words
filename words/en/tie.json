                                "target_lang_word": "матч",
                                "target_lang_sense_clarification": "в рамках турнира"
                            },
                            {
                                "target_lang_word": "встреча",
                                "target_lang_sense_clarification": "спортивное состязание"
                            },
                            {
                                "target_lang_word": "раунд",
                                "target_lang_sense_clarification": "этап кубкового противостояния"
                            }
                        ]
                    }
