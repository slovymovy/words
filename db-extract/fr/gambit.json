                    {
                        "translation_id": "ec0b715e-c0c9-4d53-b505-38cd057aa502",
                        "source_entry_id": "c7835ec4-5a9b-3054-a998-e9208ce44738",
                        "target_lang_word": "gambiet",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gambiet",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "cd2f3636-4a57-3e55-a31e-c52fb9f20d5c",
                                        "entry_id": "180cb502-33a6-3dd9-9728-ea2140680972",
                                        "glosses": [
                                            "schaakopening waarbij een pion of ander schaakstuk wordt geofferd, in ruil voor een kansrijkere positie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c9b89673-cca1-4e3d-8461-12c23eab6178",
                                                "sense_id": "cd2f3636-4a57-3e55-a31e-c52fb9f20d5c",
                                                "text": "Waarom speelt iemand een gambiet? Siegbert Tarrasch (1862-1934), de Praeceptor Germaniae, had een duidelijk antwoord: „Om de reputatie te krijgen een romantisch aanvalsspeler te zijn, ten koste van het verlies van een partij.”"
                                            },
                                            {
                                                "example_id": "c20022ad-d6a6-4d7c-b36a-ba10ba7323a8",
                                                "sense_id": "cd2f3636-4a57-3e55-a31e-c52fb9f20d5c",
                                                "text": "Behelst, dat de wijze om het spel te beginnen in twee soorten te verdeelen is, waarvan het mogelijk is de beste zetten tot op zekere hoogte te bepalen, namelijk de gewone wijze en de Gambiet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "315b8cb3-9620-3421-82bf-12d1ab78b42c",
                                        "entry_id": "180cb502-33a6-3dd9-9728-ea2140680972",
                                        "glosses": [
                                            "gedurfde handeling waarbij je een opponent probeert te brengen tot gedrag dat uiteindelijk in zijn nadeel werkt"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bb7cdd59-48d4-427a-ad02-4264c7421b33",
                                                "sense_id": "315b8cb3-9620-3421-82bf-12d1ab78b42c",
                                                "text": "Hij werd totaal verrast door het diplomatieke gambiet uit Moskou, waarvan hij niet tevoren op de hoogte was gesteld. Zegslieden van het Witte Huis stamelden hun goedkeuring voor het akkoord, maar toonden zich wel bezorgd over de Russische troepen die zich nu voor de Servische geschutsstukken zullen opstellen, zodat bij schending van de voorwaarden van het ultimatum de bombardementen worden bemoeilijkt."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8dc52422-1664-47b1-a454-9339f81a4873",
