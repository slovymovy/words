                                "target_senses": [
                                    {
                                        "sense_id": "7e36c03e-dc84-38cb-99a8-7631198fc571",
                                        "entry_id": "51ac419f-e9fc-368d-9c47-2053c481c0b2",
                                        "glosses": [
                                            "Dont la longueur d’onde est plus courte que celles de la lumière visible dans le spectre électromagnétique."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4c786fc1-317d-43f9-a00f-a119c48f0583",
                                                "sense_id": "7e36c03e-dc84-38cb-99a8-7631198fc571",
                                                "text": "L’allylène et l’acide chlorhydrique donnent surtout du β-chloropropylène qui se polymérise par exemple sous l’action des rayons ultraviolets, et peut alors servir à faire des vernis ou peut être déshalogénisé par traitement en solvants neutres par le zinc, le magnésium ou le sodium, et donne alors un produit ressemblant au caoutchouc."
                                            },
                                            {
                                                "example_id": "d9273635-5d2a-4e2d-8f70-2dc8d4e6f021",
                                                "sense_id": "7e36c03e-dc84-38cb-99a8-7631198fc571",
                                                "text": "Contrairement aux rayons X ou ultraviolets, elles ne seraient pas assez puissantes pour atteindre les cellules du corps humain et affecter notre système immunitaire."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ultraviolet",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e6cc6775-2756-3d96-bd8d-b23084de070a",
                                        "entry_id": "3d64a4d2-afe6-3f00-a96a-d1f637c0a749",
                                        "glosses": [
                                            "Lumière ultraviolette."
                                        ],
