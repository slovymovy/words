                    {
                        "sense_id": "55dfcd46-73ba-3cd0-b2e5-d28e27ec9a10",
                        "entry_id": "a9a1f481-94f1-3244-b759-757fba9a76aa",
                        "glosses": [
                            "een gebouw dat door een verhuurder aan een huurder wordt verhuurd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c92112d-2622-48f8-a4af-d24cfe0aeb7e",
                                "sense_id": "55dfcd46-73ba-3cd0-b2e5-d28e27ec9a10",
                                "text": "In grote delen van het centrum van Berlijn hadden de huurpanden winkels op de begane grond, dat kon van alles zijn, van levensmiddelen en kleine naaiateliers tot antiquairs, groentemannen en meubelverkopers, groot en klein door elkaar heen zonder enig systeem, behalve in grote winkelstraten zoals de Leipziger Strasse."
                            },
                            {
                                "example_id": "3ad9e6cc-ea41-42c5-a9a3-c6e6f32179c3",
                                "sense_id": "55dfcd46-73ba-3cd0-b2e5-d28e27ec9a10",
                                "text": "Het zorgt ervoor dat ze noodgedwongen in hun huurpand blijven zitten en een doorstroming uitblijft. Olde Olthof: „Nieuwe huurders moeten hierdoor veel langer wachten tot een huis vrijkomt. Daarom gaan we bepalen wat een redelijke termijn is om een woning te vinden.”"
                            }
                        ]
                    }
