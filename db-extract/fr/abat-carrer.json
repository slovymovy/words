                "senses": [
                    {
                        "sense_id": "a89662da-4a7e-3ac3-98d3-6776b15a7b3f",
                        "entry_id": "476c8291-9e11-327d-abf8-256e656e7c17",
                        "glosses": [
                            "Rendre les arêtes du cuir plus douces en utilisant un abat-carre."
                        ],
                        "tags": [
                            "Cordonnerie"
                        ],
                        "examples": [
                            {
                                "example_id": "afb2f9ad-57b9-4f7d-bd6e-910c4bbfd4f0",
                                "sense_id": "a89662da-4a7e-3ac3-98d3-6776b15a7b3f",
                                "text": "Votre ceinture est ensuite abat-carrée : Les angles sont taillés sur toute la longueur côté cuir et côté chair...."
                            },
                            {
                                "example_id": "35fed1c1-9f35-402f-893a-8d5df5cff897",
                                "sense_id": "a89662da-4a7e-3ac3-98d3-6776b15a7b3f",
                                "text": "Sous l’œil de leur professeure, Myriam Vanden Daele, bourrelière professionnelle, ils sont une dizaine à découper, perforer, lisser ou plutôt “abat-carrer” le cuir comme le dit un vrai bourrelier, pour lui donner vie sous forme de harnais, de ceintures ou de selles."
                            }
                        ]
                    }
