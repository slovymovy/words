                "senses": [
                    {
                        "sense_id": "d0f8970e-956b-3fe5-82dc-3c6667424b0d",
                        "entry_id": "d313b4de-7ec5-3fea-b581-95d7d876e227",
                        "glosses": [
                            "Tinte, die in Tintenstrahldruckern verwendet wird um die zu druckenden Zeichen zu Papier zu bringen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0a9b1e8-b993-4b9e-b540-df280bb1f7fa",
                                "sense_id": "d0f8970e-956b-3fe5-82dc-3c6667424b0d",
                                "text": "„Allerdings muss dazugesagt werden, dass Druckertinte unterschiedliche Anforderungen erfüllen muss, etwa darf diese nicht eintrocknen, soll jedoch möglichst schnell drucken und nicht verschmieren.“"
                            },
                            {
                                "example_id": "3be7d143-b8fd-434f-8afe-859c581259b5",
                                "sense_id": "d0f8970e-956b-3fe5-82dc-3c6667424b0d",
                                "text": "„In den USA führten Tricksereien mit Druckertinte sogar schon zu Prozessen in über 30 Bundesstaaten - die meisten sind noch nicht entschieden.“"
                            },
                            {
                                "example_id": "1a7badb4-b5d6-4b68-a571-e229907363b8",
                                "sense_id": "d0f8970e-956b-3fe5-82dc-3c6667424b0d",
                                "text": "„Tonerpartner, ein Online-Versender von Druckertinte und Toner, wirbt fast so wortstark wie Aale-Dieter auf dem Hamburger Fischmarkt: „Bis zu 80 Prozent sparen“ könne der Kunde, und zwar „durch kompatible Produkte bei 100 Prozent Druckqualität“.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
