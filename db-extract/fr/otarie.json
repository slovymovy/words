                                "target_senses": [
                                    {
                                        "sense_id": "1a7db293-f676-358c-aaab-14e21d3f0659",
                                        "entry_id": "eff160d4-d6ff-34da-8eb8-3dfa4e2fb463",
                                        "glosses": [
                                            "To intrude on a conversation with probing questions in an attempt to engage in unwanted debate, usually disingenuously as a form of harassment or trolling."
                                        ],
                                        "tags": [
                                            "Internet",
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1fbdc11a-9c49-4bfb-b7e8-06c13c5e2def",
                                                "sense_id": "1a7db293-f676-358c-aaab-14e21d3f0659",
                                                "text": "There, Peggy speaks for every angry marginalised person who’s ever been sealioned or tone-policed in a disagreement."
                                            },
                                            {
                                                "example_id": "2c2e92e0-9d82-4019-8620-e6d371cd2f38",
                                                "sense_id": "1a7db293-f676-358c-aaab-14e21d3f0659",
                                                "text": "The purpose of sealioning never to actually learn or become more informed."
                                            },
                                            {
                                                "example_id": "15fba837-a53d-4aef-a759-0ce3c728c9a5",
                                                "sense_id": "1a7db293-f676-358c-aaab-14e21d3f0659",
                                                "text": "I can attest to reactionary right-wing trolls being the black belt masters of Internet pile-ons, or as Wondermark has indelibly dubbed the practice, “sealioning.”"
                                            },
                                            {
                                                "example_id": "82a6ba5c-08a6-46d8-a9b9-7e46ec674c56",
                                                "sense_id": "1a7db293-f676-358c-aaab-14e21d3f0659",
                                                "text": "Popular definitions of harassment also extend to “sealioning” — a recently coined term based on an Internet comic, “The Terrible Sea Lion” — which seems to mean little more than unwelcome attempts to engage someone in debate."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sealion",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b17977b4-eaa4-3e99-92d6-a0825d68a9ad",
                                        "entry_id": "a140b6ea-a09b-38f4-849b-a95d4daedd3a",
