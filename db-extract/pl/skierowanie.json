                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a9100823-b650-339b-b40a-0442a264cd50",
                                        "entry_id": "469484b1-7ae0-353b-9b65-cc1913af804b",
                                        "glosses": [
                                            "Of or relating to commitment."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "18287530-9b86-4d29-a5b2-b8de21bfe755",
                                                "sense_id": "a9100823-b650-339b-b40a-0442a264cd50",
                                                "text": "On reading the work, we have become impressed with this fact, and have several times wished that the author was more committal on the treatment of several diseases in which he himself must have had a large experience."
                                            },
                                            {
                                                "example_id": "3db6a72a-7e72-41b8-898d-f5cb1280d89f",
                                                "sense_id": "a9100823-b650-339b-b40a-0442a264cd50",
                                                "text": "He points out that the former hypothesis is less committal epistemically, and he claims that nothing more committal is required to make sense of scientific method."
                                            },
                                            {
                                                "example_id": "a745dae9-d81f-4ed3-95ce-0f326f45546c",
                                                "sense_id": "a9100823-b650-339b-b40a-0442a264cd50",
                                                "text": "Notice also that the credibility of noncommittal observational beliefs will compare in a similar way with the credibility of more committal (or theoretical) observational beliefs, such as belief that addition of a base solution to an acid solution (to take the more committal, or theoretical, version of the noncommittal observational belief just mentioned)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0edb2fd4-b5c5-461f-8b75-105e1c33a996",
                        "source_entry_id": "1f1f6cf1-5423-3668-9e63-3e739c16fdda",
                        "source_sense_id": "1fbd008f-e538-3974-a075-dddfd735566b",
                        "target_lang_word": "Einweisung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Einweisung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3409703a-f5e9-326e-bbc2-b929245af83c",
                                        "entry_id": "057f3a84-81ae-35b8-b2de-679eca02045f",
                                        "glosses": [
                                            "Betrauung mit einer Funktion"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a7c67d2d-0001-42f8-bcde-6641b03dd431",
                                                "sense_id": "3409703a-f5e9-326e-bbc2-b929245af83c",
                                                "text": "„Die Einweisung in eine Planstelle ist bei Beförderungen zum Ersten des Monats, in dem die Beförderung wirksam wird, vorzunehmen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b261df6c-d716-33da-9484-06e4e68214e3",
                                        "entry_id": "057f3a84-81ae-35b8-b2de-679eca02045f",
                                        "glosses": [
                                            "Unterbringung in einer Krankenanstalt oder in einer anderen Institution"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1095242-c778-4322-a149-49f15e5bc6c1",
                                                "sense_id": "b261df6c-d716-33da-9484-06e4e68214e3",
                                                "text": "„Hebammen ist die intramuskuläre und subkutane Anwendung von Wehenmitteln oder wehenhemmenden Mitteln bei Gefahr im Verzug ohne ärztliche Anordnung erlaubt, wenn 1. ärztliche Hilfe nicht rechtzeitig erreichbar ist oder 2. die rechtzeitige Einweisung in eine Krankenanstalt nicht möglich ist.“"
                                            },
                                            {
                                                "example_id": "69dd610a-5cf8-4763-bd45-f66345447e7b",
                                                "sense_id": "b261df6c-d716-33da-9484-06e4e68214e3",
                                                "text": "„Er verbrachte gut zwanzig Minuten hinter der verschlossenen Tür und kam strahlend mit einer Aufenthaltsgenemigung und einer Einweisung ins Ausländerwohnheim wieder heraus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "8f02f374-64e2-334d-9306-b24b53ce6704",
                                        "entry_id": "057f3a84-81ae-35b8-b2de-679eca02045f",
                                        "glosses": [
                                            "Vertrautmachung mit einer Aufgabe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a58581df-46ae-45a8-b077-c99a4cc62aba",
                                                "sense_id": "8f02f374-64e2-334d-9306-b24b53ce6704",
                                                "text": "„Für den Matrosen-Motorwart besteht die praktische Verwendung aus einer Einweisung in den Betrieb durch einen Maschinisten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
