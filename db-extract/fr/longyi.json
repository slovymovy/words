                "senses": [
                    {
                        "sense_id": "bb7203a3-6ed8-30ad-862f-45b36e52a8e1",
                        "entry_id": "ea7cd59e-7a08-3908-8847-bba8d2c07d15",
                        "glosses": [
                            "Vêtement birman consistant en une longue pièce de tissu que les hommes comme les femmes portent enroulée autour de la taille et qui descend jusqu’aux chevilles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b01b837-1801-43c5-9449-951fd3718631",
                                "sense_id": "bb7203a3-6ed8-30ad-862f-45b36e52a8e1",
                                "text": "Les véhicules enturbannés dégorgeaient à chaque instant un flot nouveau de gens endimanchés – une famille entière, parents, oncles, tantes et cousins auxquels s’ajoutaient les voisins, tous vêtus de leur meilleur longyi de soie."
                            },
                            {
                                "example_id": "7ce6b1fb-d435-4416-914f-2b5edd445082",
                                "sense_id": "bb7203a3-6ed8-30ad-862f-45b36e52a8e1",
                                "text": "Minuscule, mais bondé. Un bar glauque, avec des tables et des chaises de plastique tenues par une faune tétanisante. Au milieu de types hirsutes, chemises ouvertes et longyi poisseux, des filles décharnées en sari ou en hsipaw fendue jusqu’à mi-cuisse chantaient des airs de karaoké avec des voix trop aiguës."
                            },
                            {
                                "example_id": "0bc05bb4-5899-4036-8c53-0ecd733aab86",
                                "sense_id": "bb7203a3-6ed8-30ad-862f-45b36e52a8e1",
                                "text": "Il n’était pas courant de voir des filles en robe longue dans cette partie du pays, car si les Karens étaient chrétiens, ils avaient conservé la chemise et le longyi birmans traditionnels."
                            }
                        ]
                    }
