                "senses": [
                    {
                        "sense_id": "b0749ccc-0790-3f8e-af23-c58896e4424d",
                        "entry_id": "0f73b7bf-0261-3209-ba59-3baf8d0e1084",
                        "glosses": [
                            "To be dilatory about; put off; postpone; neglect; omit."
                        ],
                        "tags": [
                            "obsolete",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "a028d1bd-1b07-43d6-9d67-e3a0cca515f7",
                                "sense_id": "b0749ccc-0790-3f8e-af23-c58896e4424d",
                                "text": "[I]f you can thinke vpon any preſent meanes for his deliuerie, doe not forſlow it."
                            }
                        ]
                    },
                    {
                        "sense_id": "84fb0e08-c45d-30f0-884f-ef300b58900d",
                        "entry_id": "0f73b7bf-0261-3209-ba59-3baf8d0e1084",
                        "glosses": [
                            "To delay; hinder; impede; obstruct."
                        ],
                        "tags": [
                            "obsolete",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "a57025df-b361-41bd-aee9-783543b570e9",
                                "sense_id": "84fb0e08-c45d-30f0-884f-ef300b58900d",
                                "text": "But by no meanes my way I would forslow / For ought that ever she could doe or say […]"
                            },
                            {
                                "example_id": "972056b0-d390-44f4-9aac-f3d98ef7e2b9",
                                "sense_id": "84fb0e08-c45d-30f0-884f-ef300b58900d",
                                "text": "The wond'ring Nereids, though they rais'd no storm, / Foreslow'd her passage, to behold her form."
                            }
                        ]
                    },
                    {
                        "sense_id": "a5222a89-e74c-397a-a7e8-e1e787e33c1b",
                        "entry_id": "0f73b7bf-0261-3209-ba59-3baf8d0e1084",
                        "glosses": [
                            "To be slow or dilatory; loiter."
                        ],
                        "tags": [
                            "intransitive",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "92887f83-2b0b-43b3-ab79-80c3ad75f0e0",
                                "sense_id": "a5222a89-e74c-397a-a7e8-e1e787e33c1b",
                                "text": "Foreslow no longer, make we hence amaine."
                            }
                        ]
                    }
                ],
