                "senses": [
                    {
                        "sense_id": "faf3a125-f1ba-3ea8-8b88-b6de117a741f",
                        "entry_id": "5c341676-f021-39da-9e35-a9598c55c3a9",
                        "glosses": [
                            "massiver Behälter aus dem Holz des Teakbaums"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "14d88368-0410-4b77-b87a-4c1872f3cd21",
                                "sense_id": "faf3a125-f1ba-3ea8-8b88-b6de117a741f",
                                "text": "„Ein Großteil des Herbarmaterials wurde sorgfältig in Teakholzkisten verpackt und in alle Welt geschickt.“"
                            },
                            {
                                "example_id": "e7e48232-0020-4a0d-b5fa-ee51c8975bb7",
                                "sense_id": "faf3a125-f1ba-3ea8-8b88-b6de117a741f",
                                "text": "„Dieser Tee, der meist in dünnwandigen Teakholzkisten, die innen mit Metallfolien ausgekleidet sind, und in Sackleinen verpackt ist, kommt aus Indien […].“"
                            },
                            {
                                "example_id": "4e26095a-9ee8-4187-94c4-2d3711047cb2",
                                "sense_id": "faf3a125-f1ba-3ea8-8b88-b6de117a741f",
                                "text": "„Teakholzkisten sind für einen Reisenden in Tropenländern von unschätzbarem Werte […].“"
                            },
                            {
                                "example_id": "b38c166b-d9c8-4ea3-98f1-fa338755a25d",
                                "sense_id": "faf3a125-f1ba-3ea8-8b88-b6de117a741f",
                                "text": "„Schlimmer erging es mir mit der Teakholzkiste.“"
                            },
                            {
                                "example_id": "3d609153-2de8-4320-83b1-06d66ca6d970",
                                "sense_id": "faf3a125-f1ba-3ea8-8b88-b6de117a741f",
                                "text": "„Die schwere mit Lianen zusammengeschnürte Teakholzkiste, die noch von Wasser durchtränkt war, stellten wir auf dem Flugplatz von Dschorhat zwischen die Koffer.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
