                "forms": [],
                "senses": [
                    {
                        "sense_id": "921c13db-16dd-3db2-b5ef-7d6f73c1a97e",
                        "entry_id": "3fedeaae-a783-34c8-9aa5-df87bd56da20",
                        "glosses": [
                            "Péninsule canadienne située au sud-est du Québec et au nord du Nouveau-Brunswick."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e2931968-ceb5-4288-9580-1338b49e1b7f",
                                "sense_id": "921c13db-16dd-3db2-b5ef-7d6f73c1a97e",
                                "text": "La Gaspésie. Une péninsule au bout de la terre. Baignée par la mer, secouée par le vent."
                            },
                            {
                                "example_id": "2aadcb84-ff3f-4fdb-8852-84049ed46fd9",
                                "sense_id": "921c13db-16dd-3db2-b5ef-7d6f73c1a97e",
                                "text": "Ainsi l’air salin de la Gaspésie t’aurait peut-être consolé. On dirait que cette contrée, forte d’une riche tradition orale, agit comme un fort gaulois et redonne un air de santé à notre culture musicale avec la Bolduc dans les années 50, et ensuite la Piouke, poète et artiste […]."
                            },
                            {
                                "example_id": "8318ab3d-64aa-4773-adb9-d6b30a61fcc9",
                                "sense_id": "921c13db-16dd-3db2-b5ef-7d6f73c1a97e",
                                "text": "Les motoneigistes qui parcourent les sentiers de la Gaspésie ont la chance de passer par Cap-Chat où se trouve la plus grande éolienne à axe vertical au monde."
                            }
                        ]
                    }
                ],
