                ],
                "senses": [
                    {
                        "sense_id": "25931ba7-1e3a-3533-81c7-f3a30da55739",
                        "entry_id": "10e75ea2-b59d-308f-9ce2-9f22068c70cc",
                        "glosses": [
                            "in einem an Erbsen erinnernden Grünton, grün wie Erbsen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d7ef03ad-1d4c-4bea-afc1-d40b0f00df2f",
                                "sense_id": "25931ba7-1e3a-3533-81c7-f3a30da55739",
                                "text": "„Der erbsengrüne Glanzlack war billig, dafür aber leicht sauberzumachen, und der Geruch nach Desinfektionsmitteln überdeckte den Gestank des muffigen schlammbraunen Teppichs.“"
                            },
                            {
                                "example_id": "da3f7ecd-011d-4c5c-958e-d6f13cfffbcf",
                                "sense_id": "25931ba7-1e3a-3533-81c7-f3a30da55739",
                                "text": "„Der Mann öffnete die Eisentür; Harrogate trat allein in die Zelle. Ein erbsengrün gestrichener Raum aus Beton.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
