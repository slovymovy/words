                                    }
                                ]
                            },
                            {
                                "target_word": "licite",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ee3c3e3a-df4f-39a7-8da7-47e0ec111948",
                                        "entry_id": "2cab52d7-35b3-315d-8f86-9ce8aaf73370",
                                        "glosses": [
                                            "Ce qui est légal, ce qui est autorisé, ce qui est permis."
                                        ],
                                        "tags": [],
                                        "examples": [
