                "senses": [
                    {
                        "sense_id": "478e8b66-5e2b-34ad-adc1-b69f55272f9e",
                        "entry_id": "b3803afa-1533-37a4-b103-69fa03d1a098",
                        "glosses": [
                            "für Logorrhö, krankhafte Geschwätzigkeit"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "3a14f0b6-0ae9-4b10-b0e8-c527c02b9de3",
                                "sense_id": "478e8b66-5e2b-34ad-adc1-b69f55272f9e",
                                "text": "„Aber viele Plots enden damit, dass sie den Unhold mit entsicherter Pistole dem positiven Helden gegenüberstellen und den eben noch so wortkargen Killer einen schweren Sprechdurchfall erleiden lassen: Er bräuchte nur einen Finger zu krümmen, aber stattdessen redet er und redet, wie raffiniert er das alles eingefädelt und wer ihm dabei geholfen habe.“"
                            },
                            {
                                "example_id": "21c59077-20ec-41d0-9f1d-94f881107286",
                                "sense_id": "478e8b66-5e2b-34ad-adc1-b69f55272f9e",
                                "text": "„Sylvia blickt ihm hinterher: »Das war er außerdem: Taxi-Kai von letzter Woche.« Matilde bekommt einen Hustenanfall. »Wie, der war gar kein Arzt?«, röchelt sie. »Nö, ich sagte doch: Hypochonder mit Sprechdurchfall. Und für mich jetzt gestorben.«“"
                            },
                            {
                                "example_id": "7e46e7ea-ab07-4ed9-b151-36a78de51fa9",
                                "sense_id": "478e8b66-5e2b-34ad-adc1-b69f55272f9e",
                                "text": "„Einen ‚an Sprechdurchfall leidenden Zappelphilipp‘, nennt ihn Sigvard Wohlwend. Es gibt wohl niemanden, der mehr über Heinrich Kieber weiß, als der Liechtensteiner Journalist Wohlwend.“"
                            },
                            {
                                "example_id": "be6be9a0-afc0-4337-a146-1d444705d5f9",
                                "sense_id": "478e8b66-5e2b-34ad-adc1-b69f55272f9e",
                                "text": "„»Lahme Gags«, »Dauerwerbesendung«, »fehlende Dramaturgie«, »Ego-Show«, »keine Relevanz« und »Sprechdurchfall«: Verheerender hätte das Presseecho kaum ausfallen können. Thomas Gottschalks erste Sendung von »Gottschalk Live« erzielte zwar gute Einschaltquoten, fiel aber bei den Kritikern durch.“"
                            },
                            {
                                "example_id": "f87d8d61-a1be-4e04-a8cb-c8e42b2b032e",
                                "sense_id": "478e8b66-5e2b-34ad-adc1-b69f55272f9e",
                                "text": "„Oliver Pocher kann zwar nicht Tennis spielen, aber erleidet gerne mal in Live-Sendungen Anfälle von Sprechdurchfall."
                            },
                            {
                                "example_id": "fa616f87-2577-47ea-a02d-9bfaff6cc2d7",
                                "sense_id": "478e8b66-5e2b-34ad-adc1-b69f55272f9e",
                                "text": "„Umgangssprachlich wird Logorrhoe als Redesucht, Sprechdurchfall oder krankhafte Geschwätzigkeit bezeichnet.“"
                            },
                            {
                                "example_id": "0658d7f6-5d50-4fdb-86c1-27c41d44659c",
                                "sense_id": "478e8b66-5e2b-34ad-adc1-b69f55272f9e",
                                "text": "„Der Sprechdurchfall kann dann auch beispielsweise eine Begleiterscheinung von ADHS oder ein Hinweis auf eine bipolare Störung sein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
