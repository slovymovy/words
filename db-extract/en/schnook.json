                                        "sense_id": "d1b31973-e1b7-37c2-a0ac-3517ca66286f",
                                        "entry_id": "872f8315-3a49-3ffc-8567-069075f36cdb",
                                        "glosses": [
                                            "разг., пренебр. глупый, несообразительный, простодушный человек"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c124c90d-878b-475d-91c7-1615c6c6924e",
                                                "sense_id": "d1b31973-e1b7-37c2-a0ac-3517ca66286f",
                                                "text": "Конечно, не все мужики умны, конечно, есть между ними и идиоты, и дураки, и простофили, неспособные вести хозяйство…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1bf77020-705e-47e3-a730-2ef85574d5c9",
                        "source_entry_id": "5ce187ff-c7b4-32d7-8014-41037c1a5dcc",
                        "source_sense_id": "03513cbf-4e14-3d03-86d8-7dbc8e355e44",
                        "source_sense_description": "a person, easily taken advantage of",
                        "target_lang_word": "лопух",
