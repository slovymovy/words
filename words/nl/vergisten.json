                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "were mistaken",
                                "target_lang_sense_clarification": "past tense of being wrong about something"
                            },
                            {
                                "target_lang_word": "made a mistake",
                                "target_lang_sense_clarification": "past tense of making an error"
                            }
                        ]
                    }
                }
            ]
        }
