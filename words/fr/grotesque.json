                    ]
                },
                {
                    "sense_id": "7ed1a41a-da74-32de-98e0-ab2805bc8c22",
                    "sense_definition": "Ornement mural fait d'arabesques fantaisistes et de figures hybrides découvertes dans les ruines antiques.",
