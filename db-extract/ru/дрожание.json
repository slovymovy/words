                                    {
                                        "sense_id": "b95925e6-0d61-3075-8a2d-47fef45b851c",
                                        "entry_id": "7d014b1a-1e79-35dc-a429-d182b558ab3a",
                                        "glosses": [
                                            "To shake, quiver, or vibrate."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c39c0988-3e83-4a47-882b-297eea092029",
                                                "sense_id": "b95925e6-0d61-3075-8a2d-47fef45b851c",
                                                "text": "Her lip started to tremble as she burst into tears"
                                            },
                                            {
                                                "example_id": "8aa9bc02-1f35-4012-83a5-721beffa864c",
                                                "sense_id": "b95925e6-0d61-3075-8a2d-47fef45b851c",
                                                "text": "The dog was trembling from being in the cold weather all day."
                                            },
                                            {
                                                "example_id": "33dabe36-24a3-407a-995f-ebea976a1144",
                                                "sense_id": "b95925e6-0d61-3075-8a2d-47fef45b851c",
                                                "text": "Mr. Cooke at once began a tirade against the residents of Asquith for permitting a sandy and generally disgraceful condition of the roads. So roundly did he vituperate the inn management in particular, and with such a loud flow of words, that I trembled lest he should be heard on the veranda."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "24d7353d-f371-3872-9ab7-a0230f21de00",
                                        "entry_id": "7d014b1a-1e79-35dc-a429-d182b558ab3a",
                                        "glosses": [
                                            "To fear; to be afraid."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "06276092-f1ef-4b5b-be70-1ff6074086ca",
                                                "sense_id": "24d7353d-f371-3872-9ab7-a0230f21de00",
                                                "text": "Thou beleeuest that there is one God, thou doest well: the deuils also beleeue, and tremble."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tremble",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "56c850d5-9d04-3e3c-9d0b-28ee0106c7ba",
