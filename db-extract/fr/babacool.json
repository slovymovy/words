                        "entry_id": "6cf12d47-a7bf-322c-bcb4-4fcc809a4bfa",
                        "glosses": [
                            "Relax, non-violent, décalé, alternatif."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "91217e89-4812-4b23-a683-6bea52edd49b",
                                "sense_id": "fc4de4fa-f65a-3e76-9c06-1e29fe479123",
                                "text": "Ils s’habillent de façon plutôt babacool tous les deux."
                            },
                            {
                                "example_id": "217bc49b-51ad-4b00-9773-581e82358083",
                                "sense_id": "fc4de4fa-f65a-3e76-9c06-1e29fe479123",
                                "text": "Indiscutablement, le reggae c'est la musique babacool avec quelques percussions là où il faut."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ed906efd-5134-41e7-a78e-5aac9bca756f",
                        "source_entry_id": "6cf12d47-a7bf-322c-bcb4-4fcc809a4bfa",
                        "source_sense_id": "fc4de4fa-f65a-3e76-9c06-1e29fe479123",
                        "source_sense_description": "Relax, non-violent",
                        "target_lang_word": "hippiehaft",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hippiehaft",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f88e4cc9-53a8-381f-aec5-f2438d7be59b",
                                        "entry_id": "388216c0-6240-36b2-a906-f881f0287532",
                                        "glosses": [
                                            "nach der Art von oder vergleichbar mit einem Hippie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "14be2ff7-f515-4df9-871e-341040750003",
                                                "sense_id": "f88e4cc9-53a8-381f-aec5-f2438d7be59b",
                                                "text": "„Julie sah hippiehaft aus und machte ganz schön was her.“"
                                            },
                                            {
                                                "example_id": "385cbe67-f731-45fd-9220-922767a98533",
                                                "sense_id": "f88e4cc9-53a8-381f-aec5-f2438d7be59b",
                                                "text": "„In dem ausladenden Aufzug sah sie noch hippiehafter aus als die Angeklagten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fe9983e1-f803-4d4a-980c-2069d78fefb4",
                        "source_entry_id": "6cf12d47-a7bf-322c-bcb4-4fcc809a4bfa",
                        "source_sense_id": "fc4de4fa-f65a-3e76-9c06-1e29fe479123",
                        "source_sense_description": "Relax, non-violent",
                        "target_lang_word": "alternativ",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "alternativ",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5bdc2739-c457-39a7-8eda-dbc7152e196e",
                                        "entry_id": "e199e7a6-3909-3cdb-b3ba-a19d7a31d2cf",
                                        "glosses": [
                                            "eine weitere Möglichkeit darstellend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5cdbef2f-b783-4c46-a769-7df0cfe1199c",
                                                "sense_id": "5bdc2739-c457-39a7-8eda-dbc7152e196e",
                                                "text": "Damit hätten wir zwei alternative Lösungen auf dem Tisch."
                                            },
                                            {
                                                "example_id": "367614bc-eb19-4910-944c-5691d5e38a65",
                                                "sense_id": "5bdc2739-c457-39a7-8eda-dbc7152e196e",
                                                "text": "Können Sie uns eine alternative Reiseroute vorschlagen?"
                                            },
                                            {
                                                "example_id": "0e481796-6723-4b1f-af02-19aec9100ca3",
                                                "sense_id": "5bdc2739-c457-39a7-8eda-dbc7152e196e",
                                                "text": "Alternativ können wir auch die S-Bahn nehmen."
                                            },
                                            {
                                                "example_id": "b682c1d4-61f5-4aba-995b-e4bc5f3b4d8c",
                                                "sense_id": "5bdc2739-c457-39a7-8eda-dbc7152e196e",
                                                "text": "„Wir könnten Kartoffeln als Beilage essen; oder alternativ auch Reis.“"
                                            },
                                            {
                                                "example_id": "bf86984d-4000-4e9f-9465-cdeb00c37654",
                                                "sense_id": "5bdc2739-c457-39a7-8eda-dbc7152e196e",
                                                "text": "Die EU-Kommission hat ein Vertragsverletzungsverfahren gegen Deutschland eröffnet, weil der Ausbau der Infrastruktur für alternative Auto-Antriebe nicht vorankommt."
                                            },
                                            {
                                                "example_id": "48838231-f6c9-4f07-bad5-c5ff541bc02d",
                                                "sense_id": "5bdc2739-c457-39a7-8eda-dbc7152e196e",
                                                "text": "Ein Forscher aus Thailand hat ein Patent angemeldet, mit dem Bruchlandungen und Notlandungen von Passagierflugzeugen glimpflich abgehen sollen. […] Flugexperten zweifeln jedoch an diesem alternativen Konzept in der Praxis."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2f1d0f0d-3056-3815-8579-01caf43f8374",
                                        "entry_id": "e199e7a6-3909-3cdb-b3ba-a19d7a31d2cf",
                                        "glosses": [
                                            "einer anderen Einstellung als der Mehrheit folgend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d45bc85f-e979-4caa-91c2-f5824b92c43e",
                                                "sense_id": "2f1d0f0d-3056-3815-8579-01caf43f8374",
                                                "text": "Er war schon immer ein Sonderling und setzte auf eine alternative Lebensweise."
                                            },
                                            {
                                                "example_id": "488b9b2b-c3da-4725-82f4-f4992d5ff914",
                                                "sense_id": "2f1d0f0d-3056-3815-8579-01caf43f8374",
                                                "text": "Zwei Drittel aller alternativen Diagnose- und Heilmethoden sind unwirksam, so das Ergebnis einer gestern vorgestellten Studie […]."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "888fb018-20cc-3b87-914a-1bb1c06aaff9",
                                        "entry_id": "e199e7a6-3909-3cdb-b3ba-a19d7a31d2cf",
                                        "glosses": [
                                            "umweltfreundlicher als üblich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "287c0666-6cbd-4238-8fb3-2da8a5ec8fa7",
                                                "sense_id": "888fb018-20cc-3b87-914a-1bb1c06aaff9",
                                                "text": "Wir kaufen jetzt Eier aus alternativer Haltung."
                                            },
                                            {
                                                "example_id": "2d65a911-f78d-41c4-b3a0-eff9791b5dd3",
                                                "sense_id": "888fb018-20cc-3b87-914a-1bb1c06aaff9",
                                                "text": "Belgien plante, eines seiner ältesten Atomkraftwerke, das 1975 in Betrieb genommene Kernkraftwerk Tihange, 2015 abzuschalten. Mangels alternativer Energiequellen wird das Kraftwerk jedoch erst zehn Jahre später vom Netz genommen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
