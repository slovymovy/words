                            }
                        ]
                    },
                    {
                        "translation_id": "9352a754-6c64-4bad-9d73-872916746cb7",
                        "source_entry_id": "d5c1793a-f64c-3a11-9675-0cd3331e8b8a",
                        "target_lang_word": "phénoménal",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "phénoménal",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fdc59cd7-3e2f-3381-96c8-73818c7fd380",
                                        "entry_id": "e52be869-5b84-3b54-a90d-e543b3f954c1",
                                        "glosses": [
                                            "Qui relève du phénomène."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e81c5d07-450f-4ae5-898a-eb3a677ee4f3",
                                                "sense_id": "fdc59cd7-3e2f-3381-96c8-73818c7fd380",
                                                "text": "Chez Kant il y a deux mondes : le monde phénoménal et le monde nouménal."
                                            },
                                            {
                                                "example_id": "deb2e0c2-3019-4cc5-9bd7-f9bb7a93d978",
                                                "sense_id": "fdc59cd7-3e2f-3381-96c8-73818c7fd380",
                                                "text": "Le macaque ne dispose peut-être pas de conscience phénoménale au sens que nous donnons à ce terme : il ne peut pas rapporter, à lui-même ou à d’autres, le contenu de ses représentations mentales visuelles. — (Lionel Naccache, Le Nouvel Inconscient : Freud, le Christophe Colomb des neurosciences, Odile Jacob, 2009, page 340)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "949abf8d-812b-316c-8378-5225b360ac1e",
                                        "entry_id": "e52be869-5b84-3b54-a90d-e543b3f954c1",
                                        "glosses": [
                                            "Ce qui est extraordinaire, étonnant, prodigieux."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d95e78b0-2a16-4a00-b97d-6a374fb6f080",
                                                "sense_id": "949abf8d-812b-316c-8378-5225b360ac1e",
                                                "text": "Elle est d’une bêtise phénoménale."
                                            },
                                            {
                                                "example_id": "37b39a47-921e-421d-b718-fa5dee43d4d9",
                                                "sense_id": "949abf8d-812b-316c-8378-5225b360ac1e",
                                                "text": "À prendre la moyenne des observations faites à diverses reprises, […] on pouvait affirmer, cependant, que cet être phénoménal dépassait de beaucoup toutes les dimensions admises jusqu’à ce jour par les ichthyologistes, — s’il existait toutefois."
                                            },
                                            {
                                                "example_id": "04624956-b2ae-4eb3-9e18-d80e8ea52036",
                                                "sense_id": "949abf8d-812b-316c-8378-5225b360ac1e",
                                                "text": "D’une façon générale, je ne peux pas commencer à rédiger sans avoir auparavant accumulé une quantité phénoménale de notes, jusqu’à ce que cette accumulation devienne étouffante et que la rédaction apparaisse comme une échappatoire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ad8bf6c1-70be-400a-8169-53aa0c9d5f42",
                        "source_entry_id": "d5c1793a-f64c-3a11-9675-0cd3331e8b8a",
                        "target_lang_word": "fenomenal",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fenomenal",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "290ef24c-2909-3351-b673-8db48ce4affa",
                                        "entry_id": "b7d1c1f4-7a4c-3b59-a851-3a014f2f386b",
                                        "glosses": [
                                            "Muy bueno, estupendo, extraordinario."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a355a217-6f5c-4044-b65e-835b75335522",
                                                "sense_id": "290ef24c-2909-3351-b673-8db48ce4affa",
                                                "text": "El trabajo de Setién es fenomenal; el Betis tiene que estar más arriba en LaLiga."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6c1433d3-aff9-3e17-a909-59269abfb1b6",
                                        "entry_id": "b7d1c1f4-7a4c-3b59-a851-3a014f2f386b",
                                        "glosses": [
                                            "Perteneciente o relativo a los fenómenos (aspecto que las cosas ofrecen ante nuestros sentidos o manifestación física que puede constatarse por observación directa o medición indirecta)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c1d4e6c8-ca31-4796-add3-bba528876f1f",
                                                "sense_id": "6c1433d3-aff9-3e17-a909-59269abfb1b6",
                                                "text": "El exterior es el universo en el que se conecta a través de la experiencia extática; este universo contiene el mundo fenomenal como un aspecto limitado."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "d5eab08d-6222-343a-a5b7-8a1c3c9ff194",
                                        "entry_id": "b7d1c1f4-7a4c-3b59-a851-3a014f2f386b",
                                        "glosses": [
                                            "Tremendo, de gran tamaño."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "526ee302-9179-4ee1-b320-92c5614088c1",
                                                "sense_id": "d5eab08d-6222-343a-a5b7-8a1c3c9ff194",
                                                "text": "sonó la campana anunciando la cena, y hubo un fenomenal ruido de pisadas en el hall"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            },
                            {
                                "target_word": "fenomenal",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "dbe08b67-48f0-342c-ad7c-5f2aa74bb548",
                                        "entry_id": "6cf0e066-1306-3cea-b583-d93dd259489a",
                                        "glosses": [
                                            "Muy bien, de maravilla."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "59af4616-dd48-49f3-8fa0-2c7cbabd510a",
                                                "sense_id": "dbe08b67-48f0-342c-ad7c-5f2aa74bb548",
                                                "text": "Hasta ese momento, la logística había fluido perfectamente, y lo más importante los jóvenes estaban pasándolo fenomenal."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2f663237-d556-4b6e-96c9-ee7c94abbe29",
                        "source_entry_id": "d5c1793a-f64c-3a11-9675-0cd3331e8b8a",
                        "target_lang_word": "fenomenální",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
