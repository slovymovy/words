{
    "word_family": [
        "sarcasm"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "4bb8204e-4680-3d8e-b97e-e16c9332f449",
                    "sense_definition": "Containing or expressing irony to mock or convey contempt.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "sarcastic_nature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teacher used a <w>sarcastic</w> tone when the student gave a wrong answer.",
                            "target_lang_translations": {
                                "zh": "当学生回答错误时，老师用了<w>讽刺的</w>语气。"
                            }
                        },
                        {
                            "text": "He made a <w>sarcastic</w> remark about the terrible weather during our picnic.",
                            "target_lang_translations": {
                                "zh": "他针对我们野餐时糟糕的天气发表了一句<w>挖苦的</w>评论。"
                            }
                        }
                    ],
                    "synonyms": [
                        "sarky",
                        "snarky"
                    ],
                    "common_phrases": [
                        "sarcastic remark",
                        "sarcastic tone",
                        "sarcastic comment"
                    ],
                    "target_lang_definitions": {
                        "zh": "包含或表达讽刺，旨在嘲笑或表示轻蔑。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "讽刺的",
                                "target_lang_sense_clarification": "形容言语或语气带有嘲讽意味。"
                            },
                            {
                                "target_lang_word": "挖苦的",
                                "target_lang_sense_clarification": "形容言语尖刻，带有嘲弄色彩。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "07ce718d-d7a8-378f-b8b6-dbb7a675dc72",
                    "sense_definition": "Tending to use sarcasm as a regular part of one's personality.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "sarcastic_nature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is known for being quite <w>sarcastic</w> when she is feeling tired or annoyed.",
                            "target_lang_translations": {
                                "zh": "大家都知道她感到疲惫或烦躁时会变得很<w>爱挖苦人</w>。"
                            }
                        },
                        {
                            "text": "His <w>sarcastic</w> personality often makes it difficult for others to know when he is serious.",
                            "target_lang_translations": {
                                "zh": "他那<w>刻薄的</w>性格常让别人难以分辨他什么时候是认真的。"
                            }
                        }
                    ],
                    "synonyms": [
                        "snarky"
                    ],
                    "common_phrases": [
                        "sarcastic person",
                        "sarcastic attitude"
                    ],
                    "target_lang_definitions": {
                        "zh": "习惯性地使用讽刺作为性格的一部分。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "爱挖苦人的",
                                "target_lang_sense_clarification": "形容一个人性格中经常带有讽刺意味。"
                            },
                            {
                                "target_lang_word": "刻薄的",
                                "target_lang_sense_clarification": "形容人说话尖酸刻薄，常以讽刺为乐。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}