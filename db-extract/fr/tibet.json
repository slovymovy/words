                "senses": [
                    {
                        "sense_id": "d579afbf-fb17-33a8-9546-5c8b7df219c7",
                        "entry_id": "f079d7b4-de2f-3193-89ab-b9d36efcd38e",
                        "glosses": [
                            "Tissu de laine et de bourre de soie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b92b43e4-ef9b-4ac6-88c6-513f5a7eb098",
                                "sense_id": "d579afbf-fb17-33a8-9546-5c8b7df219c7",
                                "text": "Lyon fabrique, en outre, une grande variété de châles fantaisie carrés pour l'été, en cachemire, en laine douce, en tibet, en laine et soie damasquinée et en soie pure de différentes étoffes et armures qu'il est impossible d'énumérer en détail."
                            },
                            {
                                "example_id": "df81fc62-ce71-4f38-bf8f-a3cab2e1f97b",
                                "sense_id": "d579afbf-fb17-33a8-9546-5c8b7df219c7",
                                "text": "La fabrique de Lyon n'exploite guère que le cachemire indue ; au dessous de ces châles arrive le châle tibet fabriqué avec des matières mélangées de laine et de bourre de soie."
                            }
                        ]
                    }
