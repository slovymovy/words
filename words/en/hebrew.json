    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1341ef48-71ab-37d9-8c18-348329c2531d",
                    "sense_definition": "The Semitic language spoken by the Hebrew people.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "language_sense",
                    "name_type": "language_name",
                    "examples": [
                        {
                            "text": "She is learning to speak <w>Hebrew</w> before her trip to Israel.",
                            "target_lang_translations": {
                                "ru": "Она учится говорить на <w>иври́те</w> перед поездкой в Израиль.",
                                "zh": "她在去以色列旅行前正在学习说<w>希伯来语</w>。"
                            }
                        },
                        {
                            "text": "Many ancient religious texts were originally written in <w>Hebrew</w>.",
                            "target_lang_translations": {
                                "ru": "Многие древние религиозные тексты были изначально написаны на <w>иври́те</w>.",
                                "zh": "许多古代宗教文献最初都是用<w>希伯来语</w>写成的。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "speak Hebrew",
                        "modern Hebrew",
                        "biblical Hebrew",
                        "learn Hebrew"
                    ],
                    "target_lang_definitions": {
                        "ru": "Семитский язык, на котором говорят евреи.",
                        "zh": "希伯来人所使用的闪米特语。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "иври́т",
                                "target_lang_sense_clarification": "язык"
                            },
                            {
                                "target_lang_word": "евре́йский язы́к",
                                "target_lang_sense_clarification": "язык"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "希伯来语",
                                "target_lang_sense_clarification": "语言名称"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "47726af0-c74d-3211-9e41-5065c4d75792",
                    "sense_definition": "A member or descendant of a Semitic people claiming descent from Abraham, Isaac, and Jacob.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "people_sense",
                    "name_type": "ethnic_group_name",
                    "examples": [
                        {
                            "text": "The ancient <w>Hebrews</w> wandered in the desert for forty years.",
                            "target_lang_translations": {
                                "ru": "Древние <w>евре́и</w> скитались по пустыне сорок лет.",
                                "zh": "古代<w>希伯来人</w>在沙漠中漂泊了四十年。"
                            }
                        },
                        {
                            "text": "Historians study the culture and laws of the early <w>Hebrews</w>.",
                            "target_lang_translations": {
                                "ru": "Историки изучают культуру и законы ранних <w>евре́ев</w>.",
                                "zh": "历史学家研究早期<w>希伯来人</w>的文化和法律。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "ancient Hebrews",
                        "Epistle to the Hebrews"
                    ],
                    "target_lang_definitions": {
                        "ru": "Представитель или потомок семитского народа, ведущего происхождение от Авраама, Исаака и Иакова.",
                        "zh": "自称源于亚伯拉罕、以撒和雅各的闪米特民族成员或其后裔。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "евре́й",
                                "target_lang_sense_clarification": "человек"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "希伯来人",
                                "target_lang_sense_clarification": "民族名称"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2c091ca6-c168-3d45-b488-77cb2382badd",
                    "sense_definition": "The writing system used in the Hebrew language.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "language_sense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The scroll was covered in elegant <w>Hebrew</w> written by a scribe.",
                            "target_lang_translations": {
                                "ru": "Свиток был покрыт элегантным <w>евре́йским письмо́м</w>, написанным писцом.",
                                "zh": "卷轴上写满了抄写员书写的优雅的<w>希伯来文</w>。"
                            }
                        },
                        {
                            "text": "He practiced writing the letters of the <w>Hebrew</w> in his notebook.",
                            "target_lang_translations": {
                                "ru": "Он тренировался писать буквы <w>иври́та</w> в своей тетради.",
                                "zh": "他在笔记本上练习书写<w>希伯来文</w>字母。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "written in Hebrew",
                        "read Hebrew"
                    ],
                    "target_lang_definitions": {
                        "ru": "Система письма, используемая в иврите.",
                        "zh": "希伯来语所使用的书写系统。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "евре́йское письмо́",
                                "target_lang_sense_clarification": "система письма"
                            },
                            {
                                "target_lang_word": "иври́т",
                                "target_lang_sense_clarification": "письменность"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "希伯来文",
                                "target_lang_sense_clarification": "书写系统"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0eaeaa1d-6630-30a1-a99b-d450f1b930d3",
                    "sense_definition": "Unintelligible speech or writing.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I tried to read the technical manual, but it was all <w>Hebrew</w> to me.",
                            "target_lang_translations": {
                                "ru": "Я пытался прочитать техническое руководство, но для меня это была <w>кита́йская гра́мота</w>.",
                                "zh": "我试着读那本技术手册，但对我来说简直就像看<w>天书</w>一样。"
                            }
                        },
                        {
                            "text": "Without a translator, the foreign instructions were just <w>Hebrew</w>.",
                            "target_lang_translations": {
                                "ru": "Без переводчика иностранные инструкции были просто <w>кита́йской гра́мотой</w>.",
                                "zh": "没有翻译的话，这些外文说明书对我来说就是<w>天书</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "all Hebrew to me"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used in the phrase 'it is all Hebrew to me'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Неразборчивая речь или непонятный текст.",
                        "zh": "无法理解的言语或文字。"
                    },
                    "translations": {
