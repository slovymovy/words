                        "glosses": [
                            "Any of various colonial marine hydroids of the genus Obelia."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4f6df13d-9744-430b-b58d-4cab2849e22e",
                                "sense_id": "51bfceb3-b8d7-3031-8a55-bdbab3cd25e3",
                                "text": "All the polyps and branches of obelias are supported and protected by a thin, transparent, horny covering which is made by the outer layer of cells. About each polyp the horny covering is in the shape of a goblet or cup."
                            },
                            {
                                "example_id": "a9610ae6-7532-40cc-a720-1a198d05c3f3",
                                "sense_id": "51bfceb3-b8d7-3031-8a55-bdbab3cd25e3",
                                "text": "Fragile but menacing, obelias are colonies ranging from one to eight inches in length which grow on seaweeds, rocks, and piles. The medusa, only one stage in the obelia’s life cycle, has anywhere from eight to 24 tentacles,[…]."
                            },
                            {
                                "example_id": "9c194475-6239-4186-b1c2-c8094a1cc92a",
                                "sense_id": "51bfceb3-b8d7-3031-8a55-bdbab3cd25e3",
                                "text": "[…]some [hydroids], like obelias, live in stalked colonies[…]."
                            }
                        ]
                    }
                ],
