                        "examples": []
                    },
                    {
                        "sense_id": "f39a4154-0e58-3307-9318-d2b10a0b8254",
                        "entry_id": "471feb3c-bb72-365f-96aa-51744e16b150",
                        "glosses": [
                            "Encoller ; appliquer un adhésif sur une surface."
                        ],
                        "tags": [
                            "Plus courant"
                        ],
                        "examples": [
                            {
                                "example_id": "0bd973c1-2e82-40ca-9fbf-5da064136372",
                                "sense_id": "f39a4154-0e58-3307-9318-d2b10a0b8254",
                                "text": "Dans tous les cas, on procède par une activation préalable de la surface à adhésiver (immersion ou enduction) puis on assemble les parties à coller à l'aide d'un solvant du polymère ou d'un adhésif adapté."
                            },
                            {
                                "example_id": "16d87659-7031-4d36-9131-a32cf361228f",
                                "sense_id": "f39a4154-0e58-3307-9318-d2b10a0b8254",
                                "text": "Pour faire face à l'apparition de nouveaux types de matériaux à adhésiver ainsi qu'à l'évolution des techniques d'application, de nouveaux copolymères blocs ont été confondus."
                            }
                        ]
                    }
