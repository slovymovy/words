                ],
                "senses": [
                    {
                        "sense_id": "ce38aef7-2609-329f-9862-f1c7765a7605",
                        "entry_id": "a0b0d4a1-de92-38fa-818b-5f489da62164",
                        "glosses": [
                            "Attitude bien-pensante invoquant la défense des droits de l’homme et, plus généralement, une attitude purement déclamatoire ou excessivement tolérante."
                        ],
                        "tags": [
                            "neologism",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "314ac88b-2f0d-4756-8d8a-d6932d23fbde",
                                "sense_id": "ce38aef7-2609-329f-9862-f1c7765a7605",
                                "text": "Contrairement à ce que prétendent des contempteurs du « droit-de-l’hommisme », la lutte pour le respect des droits de l’homme est essentielle."
                            },
                            {
                                "example_id": "6ae5663a-7090-4dfd-96cb-9ff4d7035469",
                                "sense_id": "ce38aef7-2609-329f-9862-f1c7765a7605",
                                "text": "Selon cette veine, le droit-de-l’hommisme n’est que posture et moralisme, au mieux une illusion, au pire une hypocrite mascarade."
                            },
                            {
                                "example_id": "1f7f84f8-4208-4ba3-9245-901807350001",
                                "sense_id": "ce38aef7-2609-329f-9862-f1c7765a7605",
                                "text": "Laissons aux chefs d’établissements, aux policiers, aux juges, le droit légal de démêler le vrai du faux, mais de grâce, cessons d’assimiler cette affaire aux religions en transformant notre laïcité en droit-de-l’hommisme hybride."
                            }
                        ]
                    }
                ],
