                "senses": [
                    {
                        "sense_id": "f77ae698-a5e7-3cda-b553-fdbd8cba3cd1",
                        "entry_id": "40d6fefe-fd91-39ea-a9b3-40a545109289",
                        "glosses": [
                            "van iets dat het heel zwaar is om te ondergaan"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e3810365-de02-4230-ae3f-fb9a183cbe4b",
                                "sense_id": "f77ae698-a5e7-3cda-b553-fdbd8cba3cd1",
                                "text": "Het eerste concrete resultaat van de zwemtocht van Maarten van der Weijden staat vast. Het hoogste bedrag gaat naar onderzoekers die met een bloedtest vast willen stellen of darmkankerpatiënten na hun operatie chemotherapie nodig hebben. Nu hebben slechts twee van de tien patiënten baat bij de zwaar belastende behandeling."
                            }
                        ]
                    },
                    {
                        "sense_id": "57517b13-fdfc-3183-888b-f8c29eab3933",
                        "entry_id": "40d6fefe-fd91-39ea-a9b3-40a545109289",
                        "glosses": [
                            "van iets dat het iemand beschuldigd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "201526e8-34aa-4f53-867f-67a37ab82ed5",
                                "sense_id": "57517b13-fdfc-3183-888b-f8c29eab3933",
                                "text": "Daarnaast kreeg de Onderwijsinspectie onlangs ook kritiek van hoogleraren onderwijsrecht. Zij stelden in NRC Handelsblad dat de inspectie in het onderzoek naar het Haga Lyceum leed aan een ‘tunnelvisie’. Het onderzoek zou er vooral op gericht zijn belastend materiaal te vinden om de school te kunnen sluiten."
                            }
                        ]
                    }
