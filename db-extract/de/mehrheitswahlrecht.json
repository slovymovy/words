                "senses": [
                    {
                        "sense_id": "da91e704-8c89-38ee-a24f-a82e4ca5aa68",
                        "entry_id": "1799a10f-27cb-3cf3-936b-d05aa432a147",
                        "glosses": [
                            "Wahlverfahren zur Auswahl eines Vorschlages aus einer Reihe vorgegebener Alternativen durch die Mehrheit einer Gruppe von Wählern"
                        ],
                        "tags": [
                            "singular",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "6eae5e82-b5ef-47c4-81d1-ca19a4788b77",
                                "sense_id": "da91e704-8c89-38ee-a24f-a82e4ca5aa68",
                                "text": "„In Versammlungen wie dem Reichstag nutzten die katholischen Fürsten zudem das Mehrheitswahlrecht, um die Protestanten kaltzustellen.“"
                            },
                            {
                                "example_id": "f8716ca8-4a91-4f87-bd22-3e678c6efd9f",
                                "sense_id": "da91e704-8c89-38ee-a24f-a82e4ca5aa68",
                                "text": "„Das Mehrheitswahlrecht bietet Parteien, die Minderheiten vertreten, kaum eine Chance.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
