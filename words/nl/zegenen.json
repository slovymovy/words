                {
                    "sense_id": "06f07fc0-303c-3fc8-9262-a0e5700b7b0d",
                    "sense_definition": "de goddelijke gunst afsmeken over iemand of iets; wijden",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "zegenen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De priester besloot de gelovigen te <w>zegenen</w> aan het einde van de mis.",
                            "target_lang_translations": {
                                "en": "The priest decided to <w>bless</w> the faithful at the end of the mass."
                            }
                        },
                        {
                            "text": "Zij vroeg de pastoor om haar nieuwe huis plechtig te <w>zegenen</w>.",
                            "target_lang_translations": {
                                "en": "She asked the pastor to solemnly <w>bless</w> her new house."
                            }
                        }
                    ],
                    "synonyms": [
                        "benedijen"
                    ],
                    "antonyms": [
                        "vervloeken",
                        "maledijen",
                        "vermaledijen"
                    ],
                    "common_phrases": [
                        "het brood zegenen",
                        "iemand zegenen"
                    ],
                    "target_lang_definitions": {
                        "en": "To invoke divine favor upon someone or something; to consecrate or make holy."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bless",
                                "target_lang_sense_clarification": "to invoke divine favor upon or make holy"
                            },
                            {
                                "target_lang_word": "consecrate",
                                "target_lang_sense_clarification": "to make or declare sacred"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9cc37456-62f5-3c4e-bac3-8755d8d74700",
                    "sense_definition": "goedkeuring of instemming verlenen aan een bepaald initiatief of handeling",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "zegenen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De directeur besloot het nieuwe project uiteindelijk te <w>zegenen</w>.",
                            "target_lang_translations": {
                                "en": "The director finally decided to <w>approve</w> the new project."
                            }
                        },
                        {
                            "text": "Het leek alsof ze het plan persoonlijk <w>zegende</w> met haar glimlach.",
                            "target_lang_translations": {
                                "en": "It seemed as if she personally <w>blessed</w> the plan with her smile."
                            }
                        }
                    ],
                    "common_phrases": [
                        "een plan zegenen"
                    ],
                    "target_lang_definitions": {
