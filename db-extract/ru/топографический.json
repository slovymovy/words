                "senses": [
                    {
                        "sense_id": "c394006a-1014-33df-b311-fe02f30d44f8",
                        "entry_id": "77e61dbc-71a7-3c85-8b6c-f45ebd452161",
                        "glosses": [
                            "связанный, соотносящийся по значению с существительным топография"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1dfd1cd8-2bc3-4725-9277-325e65e8c1fe",
                                "sense_id": "c394006a-1014-33df-b311-fe02f30d44f8",
                                "text": "Для оценки зрительных способностей полезными оказываются данные о топографическом распределении плотности ганглиозных клеток и фоторецепторов по сетчатке."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bded2733-417f-40d4-99a0-33cdff9d8f01",
                        "source_entry_id": "77e61dbc-71a7-3c85-8b6c-f45ebd452161",
                        "source_sense_id": "c394006a-1014-33df-b311-fe02f30d44f8",
