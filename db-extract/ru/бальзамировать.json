                                            {
                                                "example_id": "ef5798fd-3ea4-474b-bf10-b1e886d9ed3c",
                                                "sense_id": "11e09fb2-83d4-38c2-b1a7-6259bd039c07",
                                                "text": "— Nous t’embaumerons, nous te pétrifierons afin que la face du premier Infaillible vive à jamais."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e39a011a-7b51-3d5d-9e57-433d8eba3487",
                                        "entry_id": "cde99485-da82-3aa0-b3b2-e817d3521615",
                                        "glosses": [
                                            "Parfumer ; remplir de bonne odeur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b482661-ae9a-408c-a560-cf0f8532cd8d",
                                                "sense_id": "e39a011a-7b51-3d5d-9e57-433d8eba3487",
                                                "text": "[…], non seulement la morte ne dégagea aucune odeur de putréfaction, mais encore elle continua à embaumer, comme de son vivant, une senteur inanalysable, exquise."
                                            },
                                            {
                                                "example_id": "403937ee-0658-46ce-b06b-b24c7f0d9c28",
                                                "sense_id": "e39a011a-7b51-3d5d-9e57-433d8eba3487",
                                                "text": "[…]; une agréable odeur résineuse embaumait l’air."
                                            },
                                            {
                                                "example_id": "1a0ef146-b6c1-418e-9e68-66236921ce0d",
                                                "sense_id": "e39a011a-7b51-3d5d-9e57-433d8eba3487",
                                                "text": "La maison embaumait l’encens ; la Maîtresse était seule et l’attendait."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4a0cb568-a387-3bf1-b884-58f3036eae0d",
                                        "entry_id": "cde99485-da82-3aa0-b3b2-e817d3521615",
                                        "glosses": [
                                            "Fleurer ; sentir bon."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "515c94af-906f-4e9d-8ea4-c6fd92a7ff01",
                                                "sense_id": "4a0cb568-a387-3bf1-b884-58f3036eae0d",
                                                "text": "Ce soir-là, le ciel n’offrait pas un nuage, l’air attiédi caressait la terre, les fleurs embaumaient, on entendait crier le sable sous les pieds de quelques promeneurs qui rentraient."
                                            },
                                            {
                                                "example_id": "114e98d2-8756-462a-9839-1bc647384297",
                                                "sense_id": "4a0cb568-a387-3bf1-b884-58f3036eae0d",
                                                "text": "Depuis plusieurs siècles, les aguedals ornent les cités de l'Atlas, tandis qu'à Tunis, à Bougie, à Tlemcen et dans les palmeraies de Biskra et d'ailleurs embaument les fleurs aux odeurs lourdes et aux couleurs d'argent."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
