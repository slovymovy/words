                ],
                "senses": [
                    {
                        "sense_id": "e9da276d-de0d-33fa-9a7c-a665dbdacace",
                        "entry_id": "c7a86025-fd47-3355-85c2-b09ccb66d2b6",
                        "glosses": [
                            "Verbund von einigen wenigen bis einigen tausend Atomen oder Molekülen, dessen Maximaldurchmesser bei 1 bis 100 Nanometern liegt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3884d011-c9d5-457f-9774-0bfd6b073e08",
                                "sense_id": "e9da276d-de0d-33fa-9a7c-a665dbdacace",
                                "text": "„Drei Stunden nach dem Ereignis, als die Sicherheitskameras zeigten, dass es keine Überlebenden gab, hatten ISA-Spezialisten die hermetische Abdichtung des Gebäudes genutzt, um es mit verschiedenen Gasen vollzupumpen, die alle Mikroorganismen vernichteten und alle von Menschen geschaffenen Nanopartikel korrodierten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "109abdf9-6e43-4ca7-b234-4c0fd2c90dbc",
                        "source_entry_id": "c7a86025-fd47-3355-85c2-b09ccb66d2b6",
                        "source_sense_id": "e9da276d-de0d-33fa-9a7c-a665dbdacace",
                        "source_sense_description": "Partikel mit einem Durchmesser von 1 bis 100 Nanometern",
                        "target_lang_word": "nanoparticle",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nanoparticle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d2cded67-471b-38e7-87ad-b669e91bcbb1",
                                        "entry_id": "6225aeff-7e6a-3b2b-9823-31d23a51b60c",
                                        "glosses": [
                                            "Any microscopic particle less than about 100 nanometers (nm) in diameter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86da9480-caaa-48ef-bfb1-ccd8d64146ad",
                                                "sense_id": "d2cded67-471b-38e7-87ad-b669e91bcbb1",
                                                "text": "Nanoparticles of various sorts are already found in products like sunscreen, paint and inkjet paper. More exotic varieties offer promise in medicine for sensitive diagnostic tests and novel treatments: the detection of Alzheimer's disease by finding a protein in spinal fluid, for instance, or nanoparticles that heat up and kill cancer cells."
                                            },
                                            {
                                                "example_id": "04ff1ee1-0329-4010-aed3-66bdd5f129d9",
                                                "sense_id": "d2cded67-471b-38e7-87ad-b669e91bcbb1",
                                                "text": "The high surface area of a nanoparticle relative to its weight and volume makes it behave differently from larger masses of the same material."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "de3cdc00-bb97-407d-96b6-94e4ba182a5e",
                        "source_entry_id": "c7a86025-fd47-3355-85c2-b09ccb66d2b6",
                        "source_sense_id": "e9da276d-de0d-33fa-9a7c-a665dbdacace",
                        "source_sense_description": "Partikel mit einem Durchmesser von 1 bis 100 Nanometern",
                        "target_lang_word": "nanoparticule",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nanoparticule",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1c9f8da3-5018-312f-adcf-b11b91152aef",
                                        "entry_id": "21beb885-c75f-3ff6-bdc5-fba9ff9cd8c4",
                                        "glosses": [
                                            "Nanoobjet dont toutes les dimensions externes sont nanométriques, c'est à dire de l'ordre du millionième de millimètre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba466ed2-2a31-439a-ae47-6d6ce890399b",
                                                "sense_id": "1c9f8da3-5018-312f-adcf-b11b91152aef",
                                                "text": "Exemples de couplage possible (biconjugaison) entre la surface d’une nanoparticule minérale et les fonctions disponibles sur la biomolécule que l’on veut greffer."
                                            },
                                            {
                                                "example_id": "49b208a5-9491-49e9-ae4f-2f23bf2dd49e",
                                                "sense_id": "1c9f8da3-5018-312f-adcf-b11b91152aef",
                                                "text": "Pour leurs travaux sur les nanoparticules, Moungi Bawendi, Louis Brus et Alexei Ekimov ont reçu, mercredi, le prestigieux prix."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
