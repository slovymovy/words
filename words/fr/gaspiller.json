    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e8412270-0c0a-3ad7-8b92-80c26c3d912a",
                    "sense_definition": "Dépenser inutilement ou consommer sans discernement de l'argent, de la nourriture ou des biens matériels.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "ressources_materielles",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il ne faut pas <w>gaspiller</w> la nourriture en jetant les restes du dîner.",
                            "target_lang_translations": {
                                "en": "You shouldn't <w>waste</w> food by throwing out the leftovers from dinner.",
                                "ru": "Не стоит <w>тратить</w> еду впустую, выбрасывая остатки ужина.",
                                "de": "Man sollte Essen nicht <w>verschwenden</w>, indem man die Reste vom Abendessen wegwirft.",
                                "es": "No hay que <w>desperdiciar</w> la comida tirando las sobras de la cena.",
                                "zh": "不应该把晚饭剩下的饭菜扔掉，这样会<w>浪费</w>食物。"
                            }
                        },
                        {
                            "text": "Il a <w>gaspillé</w> tout son argent dans des achats parfaitement inutiles.",
                            "target_lang_translations": {
                                "en": "He <w>wasted</w> all his money on completely unnecessary purchases.",
                                "ru": "Он <w>потратил</w> все свои деньги на совершенно ненужные покупки.",
                                "de": "Er hat sein ganzes Geld für völlig unnötige Einkäufe <w>verschwendet</w>.",
                                "es": "<w>Malgastó</w> todo su dinero en compras totalmente inútiles.",
                                "zh": "他把所有的钱都<w>浪费</w>在了毫无必要的购物上。"
                            }
                        }
                    ],
                    "synonyms": [
                        "dilapider",
                        "gâcher"
                    ],
                    "antonyms": [
                        "économiser",
                        "épargner"
                    ],
                    "common_phrases": [
                        "gaspiller de la nourriture",
                        "gaspiller de l'argent"
                    ],
                    "target_lang_definitions": {
                        "en": "To spend or use money, food, or goods carelessly and needlessly.",
                        "ru": "Бесцельно тратить деньги, продукты или вещи без необходимости и не думая о последствиях.",
                        "de": "Geld, Lebensmittel oder Güter unnötig und ohne Überlegung ausgeben oder verbrauchen.",
                        "es": "Gastar de manera inútil o sin control dinero, comida o bienes materiales.",
                        "zh": "不加节制或毫无必要地花费、消耗金钱、食物或其他物质财物。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "waste",
                                "target_lang_sense_clarification": "money, food, or goods"
                            },
                            {
                                "target_lang_word": "squander",
                                "target_lang_sense_clarification": "money or resources, extravagantly"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "тратить",
                                "target_lang_sense_clarification": "деньги, продукты, вещи"
                            },
                            {
                                "target_lang_word": "транжирить",
                                "target_lang_sense_clarification": "разговорное, о деньгах"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "verschwenden",
