                                        "entry_id": "9148a48f-7722-3074-b85b-f435093b9633",
                                        "glosses": [
                                            "A fabric or cloth treated on one side with a waterproof covering, especially one made from linseed oil etc.; used for flooring, tablecloths, kitchen shelves and sometimes furniture covering."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "176c2dc5-4a67-41b5-a239-d840af6edfb1",
                                                "sense_id": "b6505303-4fd3-308c-a830-17b86ac611c6",
                                                "text": "Ignatius pounded a paw into the oilcloth on the kitchen table."
                                            },
                                            {
                                                "example_id": "072629df-6b33-45d7-a1ef-775d662d33a6",
                                                "sense_id": "b6505303-4fd3-308c-a830-17b86ac611c6",
                                                "text": "When the Lincolns moved into the White House, it was not furnished, there was oilcloth on the floor in the State Rooms because of the overflow from the spittoons."
                                            }
                                        ]
                                    }
                                ]
                            }
