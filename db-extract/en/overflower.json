                        "glosses": [
                            "To produce too many flowers."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e52b0c66-47f0-4a21-8d53-e3ece65cfe09",
                                "sense_id": "1acfa5b0-7bd0-3566-8a67-71dea30435de",
                                "text": "It is said to be particularly useful when trees are inclined to bear only biennially, or in cases where trees are liable to overflower."
                            },
                            {
                                "example_id": "751d3ad2-1ec5-4248-a392-29210d840149",
                                "sense_id": "1acfa5b0-7bd0-3566-8a67-71dea30435de",
                                "text": "In some cases they are shy growers and apt to overflower their strength."
                            },
                            {
                                "example_id": "70238dd4-59a8-482d-9f6e-23f344ecb497",
                                "sense_id": "1acfa5b0-7bd0-3566-8a67-71dea30435de",
                                "text": "Of the 45 species found in seven samples of hay cut on 26 June, 16 species had overflowered."
                            }
                        ]
                    }
