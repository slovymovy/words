                ],
                "senses": [
                    {
                        "sense_id": "59f31ad5-64f1-37e2-b39d-7a3d0bee901f",
                        "entry_id": "de99df71-d10d-36b5-8b11-7d95ce776677",
                        "glosses": [
                            "Perturber, troubler, mettre sens dessus dessous."
                        ],
                        "tags": [
                            "ironic",
                            "neologism"
                        ],
                        "examples": [
                            {
                                "example_id": "86f1892b-47b7-47dd-8530-d26b563d952f",
                                "sense_id": "59f31ad5-64f1-37e2-b39d-7a3d0bee901f",
                                "text": "C’est tout le charme de la Solitaire. Ébouriffer les pronostics, bouleversifier les clas­sements, chif­fonner les nerfs des marins et de ceux qui les guettent à terre. Jusqu’au bout du suspense."
                            },
                            {
                                "example_id": "ab677d35-54a1-4196-9f78-20450eec701e",
                                "sense_id": "59f31ad5-64f1-37e2-b39d-7a3d0bee901f",
                                "text": "Bouleversifier ? Bouleverser, ne serait-ce pas plus simple, que ce néologisme alambiqué ?"
                            },
                            {
                                "example_id": "721f50de-9d88-4485-b469-0278f6844c3b",
                                "sense_id": "59f31ad5-64f1-37e2-b39d-7a3d0bee901f",
                                "text": "Comme dans un jeu de bonneteau, elle transforme la tomate au carré, donne des cubitus aux pommes, déstructure, lyophilise, bouleversifie le paysage des saveurs."
                            }
                        ]
                    },
                    {
                        "sense_id": "03a0ed87-033a-3e69-b573-b0386a3ee5f5",
                        "entry_id": "de99df71-d10d-36b5-8b11-7d95ce776677",
                        "glosses": [
                            "Bouleverser, troubler, causer une émotion."
                        ],
                        "tags": [
                            "ironic",
                            "neologism"
                        ],
                        "examples": [
                            {
                                "example_id": "994b7fef-cd39-4ed7-8a92-b7517e38fb88",
                                "sense_id": "03a0ed87-033a-3e69-b573-b0386a3ee5f5",
                                "text": "Son cœur était serré comme une sardine en boîte. Elle était toujours aussi jolie, peut-être même plus qu’avant et le garçon en était intensément bouleversifié."
                            },
                            {
                                "example_id": "bd3ec3b0-6be6-4095-bf3f-c4c169b616e0",
                                "sense_id": "03a0ed87-033a-3e69-b573-b0386a3ee5f5",
                                "text": "Plus qu’inspiré, j’étais, comme on dirait aujourd’hui, bouleversifié, scotché, amoureux grave. Cette belle plante d’un mètre quatre-vingts me faisait tourner la tête et le cœur."
                            },
                            {
                                "example_id": "306ef566-cdc5-452f-a743-aab3908e6554",
                                "sense_id": "03a0ed87-033a-3e69-b573-b0386a3ee5f5",
                                "text": "Bref, c’est pas le meilleur des Clint Eastwood, c’est pas une fiction qui veut te bouleversifier, mais ce n’est surtout pas un film de propagande."
                            }
                        ]
                    }
                ],
