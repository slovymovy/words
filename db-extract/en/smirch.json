                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82a5dd0a-3e21-4849-9014-19a46b753f79",
                                                "sense_id": "9509a1a7-0c1a-3f17-bb4f-78b416888ac2",
                                                "text": "Dobře proschlé dřevo má vedle vyšší výhřevnosti mnohem nižší kouřivost a díky tomu nebude špinit sklo na dvířkách krbových kamen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b0bfebfd-6ca0-3cf9-a7a2-986027408e67",
                                        "entry_id": "5cb1bd09-9d0d-3e4a-93f3-1331ef73b72d",
                                        "glosses": [
                                            "hanobit někoho"
                                        ],
                                        "tags": [
                                            "expressively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d8755f73-74e8-4c07-bc7d-94c4a3c00b6c",
                                                "sense_id": "b0bfebfd-6ca0-3cf9-a7a2-986027408e67",
                                                "text": "Klub se sešel se zástupci Městské policie, jež má zdokumentované už z minulosti, že někteří rádobyfanoušci špiní pověst hokejového Chomutova opakovaně."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "93e39984-61cf-3e5f-9da8-45b75b676d28",
                                        "entry_id": "5cb1bd09-9d0d-3e4a-93f3-1331ef73b72d",
                                        "glosses": [
                                            "slabě krvácet z rodidel"
                                        ],
                                        "tags": [
                                            "lidově"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d8b6a001-6d05-4041-82f8-f05b5a4e046d",
                                                "sense_id": "93e39984-61cf-3e5f-9da8-45b75b676d28",
                                                "text": "Poté, co mi vyšel pozitivní těhotenský test, objednala jsem se na gynekologii, pár dní před termínem prohlídky jsem ale začala špinit."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "82489bcc-5907-40c2-8686-54f60c550c67",
