                    {
                        "translation_id": "9e1282fd-dbc3-4eae-b870-2f699e44c478",
                        "source_entry_id": "c481956d-28ca-3c76-adb3-5e92157bb055",
                        "source_sense_id": "7e54dfc9-69c8-351f-9c3f-9980cfb68133",
                        "source_sense_description": "Frau, die Texte auf Rechtschreib- und Grammatikfehler überprüft",
                        "target_lang_word": "lectrice",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lectrice",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8f5ca19c-106b-354d-bb08-c79439db0c5a",
                                        "entry_id": "97978e35-9b63-3a42-adc0-9612592969b6",
                                        "glosses": [
                                            "Celle qui lit seule et silencieusement un livre, un journal, etc., pour son plaisir ou pour s’instruire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4eacf1c-a090-4607-9b78-f9c737ff94c4",
                                                "sense_id": "8f5ca19c-106b-354d-bb08-c79439db0c5a",
                                                "text": "Rassurez-vous, lecteur, et vous de même, chère lectrice, ce cocher était une cochère."
                                            },
                                            {
                                                "example_id": "80762b47-ee7b-4b98-80b5-209e8bc5b540",
                                                "sense_id": "8f5ca19c-106b-354d-bb08-c79439db0c5a",
                                                "text": "Il pleut, une de ces pluies allègres de printemps dont la lectrice, penchée sur ses archives, ne perçoit rien : ce qu'elle a sous les yeux a effacé les lilas, le moteur, la pluie et jusqu'à la bibliothèque."
                                            },
                                            {
                                                "example_id": "ddca01d4-ae19-4079-849c-d28491ff354f",
                                                "sense_id": "8f5ca19c-106b-354d-bb08-c79439db0c5a",
                                                "text": "Diffusé chaque soir à 22 h 55 sur la Une, le programme permet à nos lectrices et à nos lecteurs de retrouver l’esprit des Nuls, le collectif découvert sur Canal+ dans les années 1990, composé d’Alain Chabat himself, de Dominique Farrugia, de Chantal Lauby et de Bruno Carette."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "27fb6c6d-1be9-3b3a-9bd0-215b9f7327ac",
                                        "entry_id": "97978e35-9b63-3a42-adc0-9612592969b6",
                                        "glosses": [
                                            "Bénévole qui lit à haute voix pour une ou plusieurs personnes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3000f826-9032-40ca-ab93-ad0301d265ea",
                                                "sense_id": "27fb6c6d-1be9-3b3a-9bd0-215b9f7327ac",
                                                "text": "C’est une lectrice médiocre, sa voix est monotone."
                                            },
                                            {
                                                "example_id": "e805d392-95dc-4331-b30d-2fa8780db814",
                                                "sense_id": "27fb6c6d-1be9-3b3a-9bd0-215b9f7327ac",
                                                "text": "Dans les maisons d’éducation religieuses, il y a ordinairement une lectrice de semaine pour lire au réfectoire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "811ee882-962b-3dd0-9aa7-0a5c9fcb5ee8",
                                        "entry_id": "97978e35-9b63-3a42-adc0-9612592969b6",
                                        "glosses": [
                                            "Personne dont l’office, la fonction est de faire la lecture à un personnage important pour le distraire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ceccce99-670e-4bc0-ae8a-bbd5413416b0",
                                                "sense_id": "811ee882-962b-3dd0-9aa7-0a5c9fcb5ee8",
                                                "text": "Mˡˡᵉ de Chantoiseau, lectrice de la reine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "43f47cee-830a-3920-8919-99e86930b475",
                                        "entry_id": "97978e35-9b63-3a42-adc0-9612592969b6",
                                        "glosses": [
                                            "Personne dans une maison d’édition qui effectue une présélection des manuscrits destinés à être publiés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1755bca4-4081-42fc-80f1-dd99f5ebcb1f",
                                                "sense_id": "43f47cee-830a-3920-8919-99e86930b475",
                                                "text": "« Oui, assure Louis Gardel, président du comité de lecture du Seuil depuis dix ans. Au bout de trois pages, on a une première idée de la qualité. Et on décèle aussitôt un ton nouveau. » Justine Lévy, lectrice à mi-temps chez Stock, cherche, elle aussi, la perle rare."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b0360ba7-d6dc-3bef-a547-346aabe4d472",
                                        "entry_id": "97978e35-9b63-3a42-adc0-9612592969b6",
                                        "glosses": [
                                            "Répétitrice chargée de compléter dans sa langue maternelle l’enseignement d’un professeur de langues étrangères."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7a81a01-514d-4d1b-829c-156573c0c04f",
                                                "sense_id": "b0360ba7-d6dc-3bef-a547-346aabe4d472",
                                                "text": "Lectrice en langue française à l’Université d’Upsal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6ca60835-4d4f-3135-a1b5-638eecb515f0",
                                        "entry_id": "97978e35-9b63-3a42-adc0-9612592969b6",
                                        "glosses": [
                                            "Dans la liturgie chrétienne, celle qui lit les textes sacrés lors d’un office religieux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c01ca48-d950-42dd-8701-9a9556393bbd",
                                                "sense_id": "6ca60835-4d4f-3135-a1b5-638eecb515f0",
                                                "text": "Lecture de la Parole (Évangile du dimanche) Le lecteur ou la lectrice prend le lectionnaire du dimanche là où il a été déposé avant la célébration, et se rend à l’ambon, près de la croix, pour proclamer l’évangile du dimanche face à l’assemblée."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
