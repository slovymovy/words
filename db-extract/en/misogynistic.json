                        "glosses": [
                            "Of, relating to, or exhibiting misogyny."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "862842c8-0477-4cb7-bbc3-8f3934e6c4f8",
                                "sense_id": "2cbaee37-1894-3c14-9f7d-06261cc0e731",
                                "text": "This is arguably linked to two things: declining tolerance for straight men’s behavior may have, on the one hand, caused this; the effect is misogynistic backlash in the form of rising incelhood."
                            },
                            {
                                "example_id": "8cc837f7-3938-43b9-a220-e7cc9f4c71f0",
                                "sense_id": "2cbaee37-1894-3c14-9f7d-06261cc0e731",
                                "text": "Those who believe in the blackpill tend to adopt violently misogynistic beliefs about the nature of women, particularly with regard to their sexual behaviour."
                            }
                        ]
                    }
