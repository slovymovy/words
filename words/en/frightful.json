    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "629d829c-397c-3add-987f-98f1af8aca75",
                    "sense_definition": "Extremely unpleasant, annoying, or of very poor quality.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "unpleasant",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The weather during our entire vacation was absolutely <w>frightful</w> with constant rain.",
                            "target_lang_translations": {
                                "ru": "Погода на протяжении всего нашего отпуска была совершенно <w>ужасной</w> из-за постоянных дождей."
                            }
                        },
                        {
                            "text": "He is a <w>frightful</w> little man who always complains about everything.",
                            "target_lang_translations": {
                                "ru": "Он <w>скверный</w> человечишко, который вечно на всё жалуется."
                            }
                        }
                    ],
                    "synonyms": [
                        "bad"
                    ],
                    "antonyms": [
                        "wonderful",
                        "pleasant"
                    ],
                    "common_phrases": [
                        "frightful little man",
                        "frightful weather"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used as an intensifier for negative qualities"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Крайне неприятный, раздражающий или очень низкого качества."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ужасный",
                                "target_lang_sense_clarification": "о качестве или характере"
                            },
                            {
                                "target_lang_word": "скверный",
                                "target_lang_sense_clarification": "о погоде или человеке"
                            },
                            {
                                "target_lang_word": "отвратительный",
                                "target_lang_sense_clarification": "вызывающий неприязнь"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "76cc4dcc-7590-3c41-8c3d-77a42c98e7da",
                    "sense_definition": "Causing intense fear, horror, or alarm.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "fear",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The survivors told a <w>frightful</w> mess of stories about the night of the storm.",
                            "target_lang_translations": {
                                "ru": "Выжившие рассказывали <w>ужасающую</w> мешанину историй о ночи шторма."
                            }
                        },
                        {
                            "text": "The monster in the movie had a <w>frightful</w> appearance that scared the children.",
                            "target_lang_translations": {
                                "ru": "У монстра в фильме была <w>страшная</w> внешность, которая напугала детей."
                            }
                        }
                    ],
                    "synonyms": [
                        "frightening"
                    ],
                    "antonyms": [
                        "calming",
                        "reassuring"
                    ],
                    "common_phrases": [
                        "frightful appearance",
                        "frightful noise"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вызывающий сильный страх, ужас или тревогу."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "страшный",
                                "target_lang_sense_clarification": "пугающий"
                            },
                            {
                                "target_lang_word": "ужасающий",
                                "target_lang_sense_clarification": "внушающий ужас"
                            },
                            {
                                "target_lang_word": "жуткий",
                                "target_lang_sense_clarification": "вызывающий дрожь"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c6ed3148-a182-3244-b1c8-a02e05b083e8",
                    "sense_definition": "Easily scared or full of fear; timid.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "fear",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>frightful</w> herds ran quickly away from the edge of the dark wood.",
                            "target_lang_translations": {
                                "ru": "<w>Пугливые</w> стада быстро убежали от края темного леса."
                            }
                        },
                        {
                            "text": "A <w>frightful</w> child might hide behind their parents when meeting new people.",
                            "target_lang_translations": {
                                "ru": "<w>Робкий</w> ребенок может прятаться за родителей при знакомстве с новыми людьми."
                            }
                        }
                    ],
                    "synonyms": [
                        "frightening",
                        "frightening"
                    ],
                    "antonyms": [
                        "brave",
                        "bold"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used in modern English to mean timid"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Легко пугающийся или полный страха; робкий."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пугливый",
                                "target_lang_sense_clarification": "легко поддающийся страху"
                            },
                            {
                                "target_lang_word": "робкий",
                                "target_lang_sense_clarification": "стеснительный и боязливый"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "6edb4660-acf2-3dc1-a7e9-e810fe5dd440",
                    "sense_definition": "To a very great degree; extremely.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "intensifier",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I am so <w>frightful</w> sorry to tell you that we cannot attend the party.",
                            "target_lang_translations": {
                                "ru": "Мне <w>ужасно</w> жаль говорить вам, что мы не сможем прийти на вечеринку."
                            }
                        },
                        {
                            "text": "It has been a <w>frightful</w> long time since we last spoke to each other.",
                            "target_lang_translations": {
                                "ru": "Прошло <w>страшно</w> много времени с тех пор, как мы в последний раз разговаривали друг с другом."
                            }
                        }
                    ],
                    "synonyms": [
                        "frightening",
                        "frightening"
                    ],
                    "common_phrases": [
                        "frightful sorry",
                        "frightful long time"
                    ],
                    "traits": [
