                        "source_entry_id": "c7a70812-aeda-35a0-9384-b887ab822292",
                        "target_lang_word": "oxydant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "oxydant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0d090727-1c52-3219-befb-35c350b76df8",
                                        "entry_id": "d28b9f12-df02-3281-8a02-0edbac30f448",
                                        "glosses": [
                                            "Qui oxyde."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8514ceb5-2ac0-46b6-9655-c72c8ab14775",
                                                "sense_id": "0d090727-1c52-3219-befb-35c350b76df8",
                                                "text": "On a employé aussi comme bain oxydant des phosphates de potasse, de soude, de chaux ou d’alumine en proportion variable […]."
                                            },
                                            {
                                                "example_id": "0f959188-d192-45b5-a4e9-382e5efc90aa",
                                                "sense_id": "0d090727-1c52-3219-befb-35c350b76df8",
                                                "text": "Une autre méthode de déshydrogénation oxydante des hydrocarbures C4 en butadiène a pris de l'importance : ici, l'équilibre entre butènes et butadiène est déplacé vers celui-ci par introduction d'oxygène."
                                            },
                                            {
                                                "example_id": "4cf40371-5b41-41c8-a0f9-0aad146ac654",
                                                "sense_id": "0d090727-1c52-3219-befb-35c350b76df8",
                                                "text": "Le S n'est pas éliminé pendant l’affinage car les conditions sont oxydantes (voir plus haut), ce sera l'objectif de l'addition finale de ferro-manganèse à la coulée, après décrassage et désoxydation."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "oxydant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7cdb40e0-0c43-3d27-8f41-0a80ed07c3a8",
                                        "entry_id": "826b823e-5a70-3175-810e-dc6803f7d9e3",
                                        "glosses": [
                                            "Substance oxydante."
                                        ],
                                        "tags": [
                                            "Par substantivation"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3867a7de-b6a7-41a8-98b9-218e93c2be5c",
                                                "sense_id": "7cdb40e0-0c43-3d27-8f41-0a80ed07c3a8",
                                                "text": "L’oxygène est l’oxydant le plus courant dans le milieu environnant et c’est lui qui est la plupart du temps responsable du potentiel d’oxydoréduction."
                                            }
                                        ]
