                "senses": [
                    {
                        "sense_id": "3a165798-3cb0-3cb1-a908-07d5992abd96",
                        "entry_id": "cf58f157-8c05-3440-aa5d-566d7bb4a4b2",
                        "glosses": [
                            "Gefängnis, in dem ausschließlich Männer untergebracht sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5795b004-7ea0-4a18-a4e0-86fea2c7a42b",
                                "sense_id": "3a165798-3cb0-3cb1-a908-07d5992abd96",
                                "text": "„Anscheinend, so glaubte sie für einen Moment, hatte man sie in ein Männergefängnis gebracht.“"
                            },
                            {
                                "example_id": "41aad2a8-97cf-4ec9-9d06-137639cf84bf",
                                "sense_id": "3a165798-3cb0-3cb1-a908-07d5992abd96",
                                "text": "„Das Männergefängnis von Christchurch liegt knapp zehn Kilometer außerhalb der Stadt, eine Strecke, die die fittesten Ausbrecher in weniger als vierzig Minuten zurücklegen könnten.“"
                            }
                        ],
