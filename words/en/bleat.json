{
    "word_family": [
        "bleater",
        "bleatingly"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "228a91e2-518a-3651-b3df-6d3d16a1bdf8",
                    "sense_definition": "To make the characteristic cry of a sheep, goat, or calf, or to mimic this sound.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "animal_sounds",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lost lamb began to <w>bleat</w> loudly for its mother across the open field.",
                            "target_lang_translations": {
                                "de": "Das verlorene Lamm begann, auf dem offenen Feld laut nach seiner Mutter zu <w>blöken</w>."
                            }
                        },
                        {
                            "text": "We could hear the sheep <w>bleat</w> in the barn as the farmer approached with food.",
                            "target_lang_translations": {
                                "de": "Wir konnten die Schafe im Stall <w>blöken</w> hören, als der Bauer sich mit Futter näherte."
                            }
                        }
                    ],
                    "synonyms": [
                        "baa"
                    ],
                    "common_phrases": [
                        "sheep bleat in the field"
                    ],
                    "target_lang_definitions": {
                        "de": "Den charakteristischen Laut eines Schafs, einer Ziege oder eines Kalbs von sich geben oder diesen Laut nachahmen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "blöken",
                                "target_lang_sense_clarification": "von Schafen, Ziegen oder Kälbern"
                            },
                            {
                                "target_lang_word": "meckern",
                                "target_lang_sense_clarification": "speziell von Ziegen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b5c316a2-4099-327c-b8ca-61c4ae1b5dca",
                    "sense_definition": "To complain in a weak, annoying, or persistent manner.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "complaining",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Instead of trying to solve the problem, they just <w>bleat</w> about how unfair the rules are.",
                            "target_lang_translations": {
                                "de": "Anstatt zu versuchen, das Problem zu lösen, <w>jammern</w> sie nur darüber, wie ungerecht die Regeln sind."
                            }
                        },
                        {
                            "text": "I cannot stand to hear him <w>bleat</w> about his minor troubles all day long.",
                            "target_lang_translations": {
                                "de": "Ich kann es nicht ertragen, ihn den ganzen Tag über seine kleinen Probleme <w>meckernd</w> zu hören."
                            }
                        }
                    ],
                    "synonyms": [
                        "kvetch",
                        "moan",
                        "whinge",
                        "whine"
                    ],
                    "common_phrases": [
                        "bleat about problems"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Often used disapprovingly to describe weak complaining"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Sich auf schwache, nervige oder hartnäckige Weise beschweren."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "jammern",
                                "target_lang_sense_clarification": "klagen, wehleidig beschweren"
                            },
                            {
                                "target_lang_word": "meckern",
                                "target_lang_sense_clarification": "nörgeln, sich beschweren"
                            },
                            {
                                "target_lang_word": "quengeln",
                                "target_lang_sense_clarification": "lästig und anhaltend klagen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e36c5d41-c23d-3172-9c3e-eb0cdfe45aef",
                    "sense_definition": "To speak or babble foolishly about things of little importance.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "foolish_talk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She spent the entire afternoon <w>bleating</w> about her trivial social media updates.",
                            "target_lang_translations": {
                                "de": "Sie verbrachte den ganzen Nachmittag damit, über ihre belanglosen Social-Media-Updates zu <w>schwafeln</w>."
                            }
                        },
                        {
                            "text": "He would constantly <w>bleat</w> about minor details that nobody else cared about.",
                            "target_lang_translations": {
                                "de": "Er musste ständig über winzige Details <w>faseln</w>, die sonst niemanden interessierten."
                            }
                        }
                    ],
                    "common_phrases": [
                        "bleat about trivial things"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used to describe annoying or trivial chatter"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Töricht oder dümmlich über unwichtige Dinge daherreden."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "schwafeln",
                                "target_lang_sense_clarification": "unsinnig oder belanglos reden"
                            },
                            {
                                "target_lang_word": "faseln",
                                "target_lang_sense_clarification": "unklar oder töricht sprechen"
                            },
                            {
                                "target_lang_word": "plappern",
                                "target_lang_sense_clarification": "unaufhörlich über Belangloses reden"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "af587554-2dc5-3832-85e4-d2b576069fae",
                    "sense_definition": "The characteristic cry of a sheep, goat, or calf.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "animal_sounds",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden, sharp <w>bleat</w> of a goat startled the hikers on the mountain path.",
                            "target_lang_translations": {
                                "de": "Das plötzliche, schrille <w>Meckern</w> einer Ziege erschreckte die Wanderer auf dem Bergpfad."
                            }
                        },
                        {
                            "text": "We heard a faint <w>bleat</w> coming from the thick bushes near the fence.",
                            "target_lang_translations": {
                                "de": "Wir hörten ein leises <w>Blöken</w> aus den dichten Büschen nahe dem Zaun."
                            }
                        }
                    ],
                    "synonyms": [
                        "baa",
                        "baaing",
                        "bleating"
                    ],
                    "common_phrases": [
                        "faint bleat of a lamb"
                    ],
                    "target_lang_definitions": {
                        "de": "Der charakteristische Laut eines Schafs, einer Ziege oder eines Kalbs."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Blöken",
                                "target_lang_sense_clarification": "Laut von Schafen"
                            },
                            {
                                "target_lang_word": "Meckern",
                                "target_lang_sense_clarification": "Laut von Ziegen"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}