        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "92eca5f0-cfd0-3909-9f5b-727ccbe17e21",
                "word": "Molly",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "f6228ae5-52c0-39ae-b938-fdc1ed5e5cc2",
                        "entry_id": "92eca5f0-cfd0-3909-9f5b-727ccbe17e21",
                        "glosses": [
                            "A diminutive of Mary or, less often, Margaret."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e6479f87-70db-4332-8e97-53bf056d4586",
                                "sense_id": "f6228ae5-52c0-39ae-b938-fdc1ed5e5cc2",
                                "text": "\"My name's Molly. It is an old-fashioned name, and I was christened Mary. But Papa likes Molly.\"\n\"That's right. Keep to the good old fashions, dear.\"\n\"Well, I must say I think Mary is prettier than Molly, and quite as old a name, too,\" said Mrs Hamley.\n\"I think it was,\" said Molly, lowering her voice, and dropping her eyes, \"because mamma was Mary, and I was called Molly when she lived.\""
                            },
                            {
                                "example_id": "2581697c-a436-4e5d-a49f-c019aba468ec",
                                "sense_id": "f6228ae5-52c0-39ae-b938-fdc1ed5e5cc2",
                                "text": "But Mother and Father and Grandpa and Grandma and Uncle and Aunty couldn't very well call out \"Millicent Margaret Amanda\" every time they wanted her, so they shortened it to \"Milly-Molly-Mandy\" which is quite easy to say."
                            }
                        ]
                    },
                    {
                        "sense_id": "4692a547-8db6-3957-8b9c-0386baac7593",
                        "entry_id": "92eca5f0-cfd0-3909-9f5b-727ccbe17e21",
                        "glosses": [
                            "A female given name from Hebrew."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
