                    },
                    {
                        "translation_id": "70e14270-38b9-4a73-b6d8-e84d4609e690",
                        "source_entry_id": "6f117562-7650-327d-b859-6020756beb26",
                        "source_sense_id": "b5125a80-0876-321d-ac1b-0add49b3065b",
