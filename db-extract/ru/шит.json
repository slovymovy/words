                                                "sense_id": "958e9ba8-f885-3580-8a06-57d72c22e123",
                                                "text": "Shit! I think that I forgot to pack my sleeping bag last night!"
                                            },
                                            {
                                                "example_id": "0c3000e3-1b36-44d2-9306-14df0434b62f",
                                                "sense_id": "958e9ba8-f885-3580-8a06-57d72c22e123",
