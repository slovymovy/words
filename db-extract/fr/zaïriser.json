                "senses": [
                    {
                        "sense_id": "5402589e-93cb-3201-bb5d-0de68d1be4bd",
                        "entry_id": "a7961fd8-b8dc-366e-a0fb-847c6059de31",
                        "glosses": [
                            "Donner un caractère zaïrois à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d0a05345-b4a4-40be-a878-f7159c1ba5bc",
                                "sense_id": "5402589e-93cb-3201-bb5d-0de68d1be4bd",
                                "text": "Il commit l’énorme erreur de « zaïriser » les dominantes industrielles de ce pays alors qu’il n’en avait pas l’expertise appropriée, ni techniquement ni éthiquement."
                            },
                            {
                                "example_id": "ee247ed0-8b23-41e9-913d-1e036d93d5db",
                                "sense_id": "5402589e-93cb-3201-bb5d-0de68d1be4bd",
                                "text": "D’une main de fer, il dirige le pays qu’il rêve de \"zaïriser\"."
                            },
                            {
                                "example_id": "061de463-a063-4a33-91ec-855829b5cc76",
                                "sense_id": "5402589e-93cb-3201-bb5d-0de68d1be4bd",
                                "text": "En 1971, il a le «coup de génie» de «zaïriser» son pays."
                            }
                        ]
                    }
