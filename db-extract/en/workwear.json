                                                "sense_id": "b29308d0-2003-3f12-bdfa-181045291148",
                                                "text": "Die Arbeitskleidung der Ama-Taucherinnen von Hegurajima bestand nur aus einem Lendenschurz (Fundoshi)."
                                            },
                                            {
                                                "example_id": "a94548d1-3d52-4fa6-a5a5-132183e7d421",
                                                "sense_id": "b29308d0-2003-3f12-bdfa-181045291148",
                                                "text": "Die Holzschnitte zeigen Handwerker in unterschiedlicher Arbeitskleidung."
                                            },
                                            {
                                                "example_id": "365eedb6-c29b-4c8b-bf3d-659e52962da7",
                                                "sense_id": "b29308d0-2003-3f12-bdfa-181045291148",
                                                "text": "„Sie wollte sich ihre Arbeitskleidung später ansehen.“"
                                            },
                                            {
                                                "example_id": "0b6f5826-c4a3-4953-8094-aff59f884811",
                                                "sense_id": "b29308d0-2003-3f12-bdfa-181045291148",
                                                "text": "„Irgendwie fühlte er sich in seiner einfachen Arbeitskleidung in dieser pompösen Umgebung unbehaglich.“"
                                            },
                                            {
                                                "example_id": "c8ffed50-b625-4ee5-9170-b3d1301ccee4",
                                                "sense_id": "b29308d0-2003-3f12-bdfa-181045291148",
                                                "text": "„Er trug Arbeitskleidung und sah aus, als ob er von der Arbeit käme.“"
                                            }
                                        ],
