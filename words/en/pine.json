                                "target_lang_word": "lavička náhradníků",
                                "target_lang_sense_clarification": "místo pro nehrající hráče"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c0fe5d5c-9750-3f0d-9c2c-b5c7805f82dc",
                    "sense_definition": "A pineapple.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "botany_pine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In older literature, a pineapple was often simply referred to as a <w>pine</w>.",
                            "target_lang_translations": {
                                "ru": "В старой литературе ананас часто называли просто <w>ананасом</w> (pine).",
                                "zh": "在旧文学中，<w>菠萝</w>常被简称为pine。",
                                "cs": "Ve starší literatuře byl ananas často označován jednoduše jako <w>pine</w> (ananas)."
                            }
                        },
                        {
                            "text": "She placed the exotic <w>pine</w> on the table as a centerpiece for the feast.",
                            "target_lang_translations": {
                                "ru": "Она поставила экзотический <w>ананас</w> на стол в качестве главного украшения пира.",
                                "zh": "她把那个异国情调的<w>菠萝</w>放在桌子中央，作为宴席的装饰。",
                                "cs": "Položila ten exotický <w>ananas</w> na stůl jako hlavní ozdobu hostiny."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "short for pineapple"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ананас.",
                        "zh": "菠萝（旧称）。",
                        "cs": "Ananas (zastaralé označení)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ананас",
                                "target_lang_sense_clarification": "устаревшее"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "菠萝",
                                "target_lang_sense_clarification": "水果"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "ananas",
                                "target_lang_sense_clarification": "zastaralé"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1f03c95d-b49a-31c9-8d41-92c08c96eee8",
                    "sense_definition": "A bar counter or bartop.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bartender stood behind the <w>pine</w> serving drinks to the customers.",
                            "target_lang_translations": {
                                "ru": "Бармен стоял за <w>стойкой</w>, разливая напитки клиентам.",
                                "zh": "酒保站在<w>吧台</w>后为顾客倒酒。",
                                "cs": "Barman stál za <w>barovým pultem</w> a obsluhoval zákazníky."
                            }
                        },
                        {
                            "text": "I'll be working behind the <w>pine</w> all night, so come say hello.",
                            "target_lang_translations": {
                                "ru": "Я буду работать за <w>стойкой</w> всю ночь, так что заходи поздороваться.",
                                "zh": "我整晚都会在<w>吧台</w>工作，过来打个招呼吧。",
                                "cs": "Budu celou noc pracovat za <w>barem</w>, tak se přijď pozdravit."
                            }
                        }
                    ],
                    "common_phrases": [
                        "behind the pine"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Барная стойка.",
                        "zh": "酒吧的柜台。",
                        "cs": "Barový pult."
                    },
                    "translations": {
