                {
                    "sense_id": "5ae0d893-818e-3bd6-a467-cc8dda8bfbdc",
                    "sense_definition": "Taki, który żyje, funkcjonuje biologicznie; przeciwieństwo martwego.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Policja odnalazła zaginionego turystę całego i <żywego>.",
                            "target_lang_translations": {
                                "ru": "Полиция нашла пропавшего туриста целым и <живым>.",
                                "en": "The police found the missing hiker safe and <alive>."
                            }
                        },
                        {
                            "text": "Każdy <żywy> organizm potrzebuje wody, aby przetrwać w trudnych warunkach.",
                            "target_lang_translations": {
                                "ru": "Каждый <живой> организм нуждается в воде, чтобы выжить в трудных условиях.",
                                "en": "Every <living> organism needs water to survive in harsh conditions."
                            }
                        }
                    ],
                    "synonyms": [
                        "żyjący",
                        "ożywiony"
                    ],
                    "antonyms": [
                        "martwy",
                        "nieżywy"
                    ],
                    "common_phrases": [
                        "żywy organizm",
                        "żywa istota",
                        "cały i żywy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Живой, функционирующий биологически; противоположность мёртвому.",
                        "en": "Living, biologically functioning; the opposite of dead."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "живой",
                                "target_lang_sense_clarification": "о живых существах"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "alive",
                                "target_lang_sense_clarification": "not dead"
                            },
                            {
                                "target_lang_word": "living",
                                "target_lang_sense_clarification": "endowed with life"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bfe7ee35-df26-36a2-beb9-d47147aa7c92",
                    "sense_definition": "Pełen energii, bardzo ruchliwy i dynamiczny w zachowaniu.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "To bardzo <żywe> dziecko, które nie potrafi usiedzieć w jednym miejscu.",
                            "target_lang_translations": {
                                "ru": "Это очень <живой> ребёнок, который не может усидеть на одном месте.",
                                "en": "This is a very <lively> child who cannot sit still in one place."
                            }
                        },
                        {
                            "text": "Jego <żywy> temperament sprawia, że zawsze jest w centrum uwagi.",
                            "target_lang_translations": {
                                "ru": "Его <живой> темперамент делает так, что он всегда в центре внимания.",
                                "en": "His <vibrant> temperament ensures that he is always the center of attention."
                            }
                        }
                    ],
                    "synonyms": [
