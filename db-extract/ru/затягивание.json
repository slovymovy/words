                                "target_senses": [
                                    {
                                        "sense_id": "7981b401-776b-3e08-b0ab-70652cff4c24",
                                        "entry_id": "87f77426-d58a-33d8-a2ab-e4969f77068a",
                                        "glosses": [
                                            "Action de serrer ; résultat de cette action."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4f5ce618-3c56-46db-af30-96468459eb8d",
                                                "sense_id": "7981b401-776b-3e08-b0ab-70652cff4c24",
                                                "text": "Je tombai cependant dans cette sorte de somnolence que provoquent les trépidations régulières d’un train en marche, entremêlées de coups de sifflet déchirants, de bruits de serrage avant les ralentissements de vitesse, […]."
                                            },
                                            {
                                                "example_id": "53476402-ca1d-4378-8d67-25483990ba1f",
                                                "sense_id": "7981b401-776b-3e08-b0ab-70652cff4c24",
                                                "text": "La tension du ruban est assurée par le serrage à l’aide d’une vis à coulisseau qui appuie sur le ruban de la garniture."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "86235421-c1c3-4efe-8e90-204557614c86",
                        "source_entry_id": "f6ae4a5a-b4b7-37a8-aad2-40340e32afeb",
                        "target_lang_word": "prolongation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prolongation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fe183f07-05b6-3055-9212-969c2a093942",
                                        "entry_id": "b155378a-9210-31dd-ad9f-9dfe9ed72bad",
                                        "glosses": [
                                            "Action de prolonger, d’accorder un surcroît de durée ; Résultat de cette action."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d8043ac-bf3b-4bf8-827c-54e1c003e58d",
                                                "sense_id": "fe183f07-05b6-3055-9212-969c2a093942",
                                                "text": "Après la prolongation de la trêve."
                                            },
                                            {
                                                "example_id": "a7d83360-0eb0-4769-bc7f-161a5aa5c7af",
                                                "sense_id": "fe183f07-05b6-3055-9212-969c2a093942",
                                                "text": "Il a obtenu une prolongation de six mois."
                                            },
                                            {
                                                "example_id": "bb521c75-f8d6-474c-8a09-546c2d5c19ec",
                                                "sense_id": "fe183f07-05b6-3055-9212-969c2a093942",
                                                "text": "Prolongation de congé."
                                            },
                                            {
                                                "example_id": "b6882021-dd9b-4e26-9d16-4616e9522af8",
                                                "sense_id": "fe183f07-05b6-3055-9212-969c2a093942",
                                                "text": "Prolongation de terme."
                                            },
                                            {
                                                "example_id": "e19548ca-248f-49c7-99cd-5bd06845370c",
                                                "sense_id": "fe183f07-05b6-3055-9212-969c2a093942",
                                                "text": "Par construction, dans tous les scénarios, le maintien des capacités de production nucléaire à 70 % jusqu’en 2030 a été retenu, et par conséquent une prolongation de la durée de vie des réacteurs au-delà de 40 ans (scénario défendu par l’exploitant et retenu par vos rapporteurs spéciaux)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "869b7648-46f2-3059-b7ea-e41a92d14ae5",
                                        "entry_id": "b155378a-9210-31dd-ad9f-9dfe9ed72bad",
                                        "glosses": [
                                            "Période de jeu supplémentaire, se déroulant après le temps règlementaire et permettant aux participants de désigner un vainqueur."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1e4730b7-2b0d-4d53-8b85-c7431fbd4ab4",
                        "source_entry_id": "f6ae4a5a-b4b7-37a8-aad2-40340e32afeb",
                        "target_lang_word": "retard",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "retard",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5e38b9f8-8e5e-379c-b7ec-ef88f58b88ad",
                                        "entry_id": "291e53f9-7c7a-347a-93a5-073d5262e01e",
                                        "glosses": [
                                            "Fait d’arriver, de se produire plus tard que prévu, d’agir trop tard ; délai, remise, ralentissement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "39a21064-652b-4e03-894a-aef6378f64c7",
                                                "sense_id": "5e38b9f8-8e5e-379c-b7ec-ef88f58b88ad",
                                                "text": "J'avais rendez-vous avec Nguyên Trinh, me dit-il, tandis que nous nous asseyons, mais ma montre déraille et je suis arrivé avec un solide retard."
                                            },
                                            {
                                                "example_id": "0a25a46d-c0fb-4c8a-b48c-91ed6cb8c4b9",
                                                "sense_id": "5e38b9f8-8e5e-379c-b7ec-ef88f58b88ad",
                                                "text": "La mariée arrive avec le retard de circonstance, affublée d'une extraordinaire robe bouffante et emperlousée qui aurait fait rougir de honte même la fée la plus frivole."
                                            },
                                            {
                                                "example_id": "0ceb488c-c11b-4631-8afb-929b7756a12d",
                                                "sense_id": "5e38b9f8-8e5e-379c-b7ec-ef88f58b88ad",
                                                "text": "Veuillez excuser mon retard. — Vous êtes en retard, nous vous attendons depuis une demi-heure."
                                            },
                                            {
                                                "example_id": "6ee9bfc0-53b5-4ac4-954d-65b2b0e93e15",
                                                "sense_id": "5e38b9f8-8e5e-379c-b7ec-ef88f58b88ad",
                                                "text": "Votre montre est en retard de deux minutes. — Le retard de cette pendule est de 59 minutes par jour."
                                            },
                                            {
                                                "example_id": "2d073ccd-32e3-4085-a148-7302ad1cd0e6",
                                                "sense_id": "5e38b9f8-8e5e-379c-b7ec-ef88f58b88ad",
                                                "text": "Mon train est en retard. — J’ai été mis en retard par quelqu’un qui m’a dérangé."
                                            },
                                            {
                                                "example_id": "60629679-ac6a-49d0-9273-ed3bc7333765",
                                                "sense_id": "5e38b9f8-8e5e-379c-b7ec-ef88f58b88ad",
                                                "text": "Vous avez un retard de paiement de dix jours. — Un débiteur qui est en retard pour payer, qui est en retard."
                                            },
                                            {
                                                "example_id": "507b2719-fa72-41ea-a85a-ed4bcd19a9e7",
                                                "sense_id": "5e38b9f8-8e5e-379c-b7ec-ef88f58b88ad",
                                                "text": "Il est en retard, il devrait déjà être dans la classe supérieure."
                                            },
                                            {
                                                "example_id": "065b97d7-acd9-4f92-bd07-dd6e8d30e6ad",
                                                "sense_id": "5e38b9f8-8e5e-379c-b7ec-ef88f58b88ad",
                                                "text": "Je prends du retard à cause des travaux."
                                            },
                                            {
                                                "example_id": "1a03c5ad-9b56-4174-a25b-cb56bad190b2",
                                                "sense_id": "5e38b9f8-8e5e-379c-b7ec-ef88f58b88ad",
                                                "text": "Il faut agir sans retard."
                                            },
                                            {
                                                "example_id": "8a5c2a02-ba54-4572-9ab7-a309d0edd696",
                                                "sense_id": "5e38b9f8-8e5e-379c-b7ec-ef88f58b88ad",
                                                "text": "Cela peut causer du retard, des retards."
                                            },
                                            {
                                                "example_id": "1d9c7c65-b0da-42d8-9c42-49a5b725376c",
                                                "sense_id": "5e38b9f8-8e5e-379c-b7ec-ef88f58b88ad",
                                                "text": "Apporter du retard à quelque chose."
                                            },
                                            {
                                                "example_id": "59419484-1bfd-47ca-adcc-6baff0d7dc54",
                                                "sense_id": "5e38b9f8-8e5e-379c-b7ec-ef88f58b88ad",
                                                "text": "Éprouver du retard."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e469843a-3228-3c76-a14f-42b0a62fac03",
                                        "entry_id": "291e53f9-7c7a-347a-93a5-073d5262e01e",
                                        "glosses": [
                                            "Dispositif qui, dans une pendule ou une montre, sert à retarder ou à avancer son mouvement."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f4ff1d64-d48a-3d5c-bddd-4b82f8346f01",
                                        "entry_id": "291e53f9-7c7a-347a-93a5-073d5262e01e",
                                        "glosses": [
                                            "Note d’un accord qui continue à sonner pendant l’accord suivant, constituant une note étrangère."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
