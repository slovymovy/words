        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "1f5c2df7-f17d-3221-abbf-218b7074f60a",
                    "sense_definition": "A detached object in space with one known moon, Tinia.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "astronomical_name",
                    "examples": [
                        {
                            "text": "Astronomers have been tracking the orbit of <w>Uni</w> for several years.",
                            "target_lang_translations": {
                                "ru": "Астрономы отслеживают орбиту <w>Уни</w> уже несколько лет.",
                                "zh": "天文学家多年来一直在追踪小行星<w>乌尼</w>的轨道。"
                            }
                        },
                        {
                            "text": "The discovery of the moon Tinia orbiting <w>Uni</w> was significant.",
                            "target_lang_translations": {
                                "ru": "Открытие спутника Тиния, вращающегося вокруг <w>Уни</w>, было значимым.",
                                "zh": "发现围绕小行星<w>乌尼</w>运行的卫星蒂尼亚具有重要意义。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Астероид, имеющий спутник Тиния.",
                        "zh": "外海王星天体小行星乌尼（Uni），拥有一颗名为蒂尼亚（Tinia）的卫星"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Уни",
                                "target_lang_sense_clarification": "астрономическое название"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "乌尼",
                                "target_lang_sense_clarification": "小行星名称"
                            }
                        ]
                    }
                },
                {
