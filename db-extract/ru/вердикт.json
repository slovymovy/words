                                "target_senses": [
                                    {
                                        "sense_id": "f035a552-b5ae-3ea7-984d-810eb70caf1a",
                                        "entry_id": "fd1b8b84-ffa0-393c-a381-eff2e994d3de",
                                        "glosses": [
                                            "Déclaration du jury, résultat de sa délibération."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "78b2b35b-405f-468c-b6df-f129c59ad29b",
                                                "sense_id": "f035a552-b5ae-3ea7-984d-810eb70caf1a",
                                                "text": "Minuit trente-cinq : on venait de rendre le verdict. De la salle des assises, la foule muette se retirait lentement."
                                            },
                                            {
                                                "example_id": "a5d944d7-8ce7-407e-ac68-fe9169e6a512",
                                                "sense_id": "f035a552-b5ae-3ea7-984d-810eb70caf1a",
                                                "text": "Le jury a rendu un verdict de culpabilité, un verdict favorable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0733b41d-42c7-38c3-8eba-d59d4c118742",
                                        "entry_id": "fd1b8b84-ffa0-393c-a381-eff2e994d3de",
                                        "glosses": [
                                            "Appréciation définitive, jugement sévère."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9df1e6c9-3bd2-4708-a99d-5040dbdaa929",
                                                "sense_id": "0733b41d-42c7-38c3-8eba-d59d4c118742",
                                                "text": "Le verdict de l'opinion publique."
                                            },
                                            {
                                                "example_id": "82882169-aa63-48eb-a943-56b65d8a0ed9",
                                                "sense_id": "0733b41d-42c7-38c3-8eba-d59d4c118742",
                                                "text": "La faillite de Vichy corrobore assez le verdict du désastre militaire."
                                            }
                                        ]
