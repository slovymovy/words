                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f46f03df-e020-371c-97a2-a7bef3493cfc",
                                        "entry_id": "7d2edb10-a093-3067-9d93-0244b8d87973",
                                        "glosses": [
                                            "The brilliance or warmth of color in an environment or on a person (especially one's face)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bf96ef70-960b-493b-ada8-b5f5bf48b6e3",
                                                "sense_id": "f46f03df-e020-371c-97a2-a7bef3493cfc",
                                                "text": "He had a bright red glow on his face."
