                ],
                "senses": [
                    {
                        "sense_id": "8a5c4988-78b2-3c34-820d-a3ecb24bfd82",
                        "entry_id": "2b67d994-dbd4-3c09-b4b8-dad9b40ab5be",
                        "glosses": [
                            "Maximalbetrag der Winkelverschiebung, die durch Aberration (scheinbare Ortsveränderung eines Gestirns) auftritt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1de80d61-265b-413e-8b66-bf953a43cbbb",
                                "sense_id": "8a5c4988-78b2-3c34-820d-a3ecb24bfd82",
                                "text": "„Sekundäre Konstanten sind u.a. die astronomische Einheitslänge (gemessen in Metern), die Sonnenparallaxe, die Sonnenmasse (gemessen in Kilogramm) sowie die Aberrationskonstante.“"
                            },
                            {
                                "example_id": "e5fa0a55-a52d-49de-b2a8-4ad907be9944",
                                "sense_id": "8a5c4988-78b2-3c34-820d-a3ecb24bfd82",
                                "text": "„Die jährliche Aberration infolge der Erdbewegung um die Sonne (30 km/s) ruft eine Verschiebung der Gestirnsörter bis zu 20,5 Bogensekunden (Aberrationskonstante) hervor.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
