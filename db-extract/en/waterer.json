    "word": "waterer",
    "lang_code": "en",
    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "4a30a7f8-9817-37a0-a739-7b614207fee1",
                "word": "waterer",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "58e50d79-1772-4e1d-a0cd-9d604858d606",
                        "entry_id": "4a30a7f8-9817-37a0-a739-7b614207fee1",
                        "tags": [
                            "plural"
                        ],
                        "form": "waterers"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c6d4db60-6adf-31e1-b722-569cf234d126",
                        "entry_id": "4a30a7f8-9817-37a0-a739-7b614207fee1",
                        "glosses": [
                            "One who waters plants."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9cc4e378-01ae-4caf-9821-540eb3ecf0ab",
                                "sense_id": "c6d4db60-6adf-31e1-b722-569cf234d126",
                                "text": "She has dabbled in jobs as various as plant-waterer for a garden centre, trackwork rider for a racehorse trainer and librarian's assistant […]"
                            },
                            {
                                "example_id": "60b9e7d9-c77e-42b9-8cbe-c450ec9cea9f",
                                "sense_id": "c6d4db60-6adf-31e1-b722-569cf234d126",
                                "text": "Help me to become a pure waterer, weeder, and deadheader of our little plot, to mature from manic bride and bonnarder to the calm, the jen, of deep and ancient garden wifedom."
                            }
                        ]
                    },
                    {
                        "sense_id": "b426c4bc-6f35-38c0-8066-c9c767e66937",
                        "entry_id": "4a30a7f8-9817-37a0-a739-7b614207fee1",
                        "glosses": [
                            "One who waters down, or dilutes, something."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3126afff-8c82-46d9-bc36-4fb0dfca29bb",
                                "sense_id": "b426c4bc-6f35-38c0-8066-c9c767e66937",
                                "text": "Any Community funds intended for wine producers should benefit the producers and not the manufacturers of false labels, the forgers of transit papers, the mixers or waterers of wine or the resourceful characters who defy science and produce wine without using any grapes whatsoever."
                            }
                        ]
                    },
                    {
                        "sense_id": "9d41b171-859d-3fb0-99bb-df06921f4433",
                        "entry_id": "4a30a7f8-9817-37a0-a739-7b614207fee1",
                        "glosses": [
                            "A device used for watering."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f1302f9-9e18-4e7e-a5db-e4135b177409",
                                "sense_id": "9d41b171-859d-3fb0-99bb-df06921f4433",
                                "text": "She installed an automatic waterer for her garden."
                            }
                        ]
                    },
                    {
                        "sense_id": "91ba8b56-6a83-3948-9a93-9df278e9662b",
                        "entry_id": "4a30a7f8-9817-37a0-a739-7b614207fee1",
                        "glosses": [
                            "A device from which livestock, poultry, or pets may drink."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "32cab7d4-c33b-4a18-9d9e-8afd60bd032d",
                                "sense_id": "91ba8b56-6a83-3948-9a93-9df278e9662b",
                                "text": "Clean the chicks' waterer each time you refill it."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "105a7281-afff-46fc-af37-fe93ae8a5f34",
