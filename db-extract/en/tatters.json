                    {
                        "translation_id": "89efbe19-b414-461c-b602-9637ada60fa5",
                        "source_entry_id": "29c22ba9-191c-3e56-bc3f-43b388d03135",
                        "source_sense_id": "9c6a3278-671d-3a88-8166-fe730644e7f1",
                        "source_sense_description": "ragged clothing, fabric, paper etc",
                        "target_lang_word": "haillons",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "haillons",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "80253f73-c9ab-3e31-9242-426a059b77e9",
                                        "entry_id": "3b9ac2c7-015e-38b3-b5a2-30a8653488d1",
                                        "glosses": [
                                            "Pluriel de haillon."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5ff05122-3167-42a9-9298-a1924b52c9e9",
                                                "sense_id": "80253f73-c9ab-3e31-9242-426a059b77e9",
                                                "text": "Et Pierre était si blanc de terreur qu’on eût cru qu’il allait embrenner de peur ses haillons d’apôtre, et que les hommes le prirent en pitié et le tinrent pour fou."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a8b6201e-cbab-4cc3-b855-1b525ee538c2",
                        "source_entry_id": "29c22ba9-191c-3e56-bc3f-43b388d03135",
                        "source_sense_id": "9c6a3278-671d-3a88-8166-fe730644e7f1",
                        "source_sense_description": "ragged clothing, fabric, paper etc",
                        "target_lang_word": "guenille",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "guenille",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "de365b12-2ecf-3328-a1b3-36ade2120a63",
                                        "entry_id": "0e18ec8a-5499-39de-873d-3618617a9c1b",
                                        "glosses": [
                                            "Haillon, chose sans valeur, sans importance, méprisable."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c6750028-1c60-41c4-817b-49b3ce166f8c",
                                                "sense_id": "de365b12-2ecf-3328-a1b3-36ade2120a63",
                                                "text": "Selon lui, le corps est une guenille dont il est honteux de s’occuper."
                                            },
                                            {
                                                "example_id": "4743189a-adca-47a3-b275-6bd8168edf14",
                                                "sense_id": "de365b12-2ecf-3328-a1b3-36ade2120a63",
                                                "text": "Il n’a pas une guenille au cul qu’il ait gagnée par lui-même. Qu’il y vienne, vous verrez si je sais faire foutre le camp aux maquereaux !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d0b0ab21-b899-3efc-98ab-ec877e15e88b",
                                        "entry_id": "0e18ec8a-5499-39de-873d-3618617a9c1b",
                                        "glosses": [
                                            "Individu méprisable, vaurien."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "230821ef-9366-4bef-afaf-fcd6897b4ddc",
                                                "sense_id": "d0b0ab21-b899-3efc-98ab-ec877e15e88b",
                                                "text": "Ce type-là, c’est une guenille !"
                                            },
                                            {
                                                "example_id": "156747e4-7ca5-41e2-b64e-c05ab8fe4477",
                                                "sense_id": "d0b0ab21-b899-3efc-98ab-ec877e15e88b",
                                                "text": "— Mon Dieu, comme vous disposez de moi !… dit alors madame Marneffe. Et mon mari ?… — Cette guenille ? — Le fait est qu’auprès de vous, c’est cela… répondit-elle en riant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "98529708-0dc2-36e4-81ee-2c8f8c52eb7d",
                                        "entry_id": "0e18ec8a-5499-39de-873d-3618617a9c1b",
                                        "glosses": [
                                            "Appellation faussement insultante adressée à un enfant."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3e8b28d2-7aea-46e1-804a-480f4e3d188e",
                                                "sense_id": "98529708-0dc2-36e4-81ee-2c8f8c52eb7d",
                                                "text": "– Lève-toi de ma route, guenille ! me criait-elle. Je vais t'ébouillanter si tu restes là, bouche ouverte. Tu attends des truffes ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "17423516-d849-308d-bcba-10274e11b080",
                                        "entry_id": "0e18ec8a-5499-39de-873d-3618617a9c1b",
                                        "glosses": [
                                            "Vêtement misérable en lambeaux."
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2348ef2e-21d4-453b-8134-f144e9e99277",
                                                "sense_id": "17423516-d849-308d-bcba-10274e11b080",
                                                "text": "Un vieillard et son enfant en guenilles tendirent leurs mains sales et calleuses vers nous."
                                            },
                                            {
                                                "example_id": "48b3d250-5a84-40fe-87a0-a0c2aa176f1f",
                                                "sense_id": "17423516-d849-308d-bcba-10274e11b080",
                                                "text": "Victorin examina d’un œil défiant ce soi-disant ermite en pèlerinage, et vit un superbe modèle de ces moines napolitains dont les robes sont sœurs des guenilles du lazzarone, dont les sandales sont les haillons de cuir, comme le moine est lui-même un haillon humain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "18ee5e02-1dfd-3caf-9497-18dd30e5b0b3",
                                        "entry_id": "0e18ec8a-5499-39de-873d-3618617a9c1b",
                                        "glosses": [
                                            "Sorte de longs poils plus ou moins feutrés ou crasseux que portent certaine races de mules et de baudets."
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "75b9894a-fc54-4352-ab60-f9fe30a76d16",
                                                "sense_id": "18ee5e02-1dfd-3caf-9497-18dd30e5b0b3",
                                                "text": "La nécessité des guenilles, des cadenettes et de la moustache aux talons n’est certainement pas démontrée d’une manière très-rigoureuse ; mais l’éleveur de mules repousserait le baudet qui ne les porterait pas."
                                            },
                                            {
                                                "example_id": "ec58f7b5-df12-4a39-8dec-1c9749c862d3",
                                                "sense_id": "18ee5e02-1dfd-3caf-9497-18dd30e5b0b3",
                                                "text": "Le marchand de mules […] imite, au moyen de la bouse de vache ou du crottin délayé, les crottes ou guenilles qui pendent sur les fesses et le ventre des mules de bonne provenance qui ne sont pas débourrées."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "851ad4f1-fa71-3c35-b960-1e442acc3a39",
                                        "entry_id": "0e18ec8a-5499-39de-873d-3618617a9c1b",
                                        "glosses": [
                                            "Torchon, chiffon, débarbouillette."
                                        ],
                                        "tags": [
                                            "Québec"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
