                ],
                "senses": [
                    {
                        "sense_id": "5d04806f-a4bc-3956-b796-932a209e147c",
                        "entry_id": "b3af41e4-fefa-372a-9c6a-c6f00fe2304c",
                        "glosses": [
                            "Donner un caractère annamite à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6aa9752b-1209-46c9-9a18-8650fff74eed",
                                "sense_id": "5d04806f-a4bc-3956-b796-932a209e147c",
                                "text": "Ses détracteurs voudraient déchinoiser l’enseignement pour l’annamitiser."
                            },
                            {
                                "example_id": "33afb5e3-4f15-46a5-bd94-c2b4a12bd301",
                                "sense_id": "5d04806f-a4bc-3956-b796-932a209e147c",
                                "text": "Les Chams qui ne consentirent pas à s’annamitiser et à subir le joug de leurs vainqueurs cinglèrent les uns vers les mers du sud pour se réfugier au nord de Sumatra, les autres vers le Cambodge où leurs descendants, pour la plupart convertis à l’islamisme, vivent encore aujourd’hui."
                            }
                        ]
                    }
