                "senses": [
                    {
                        "sense_id": "47625db2-c1f3-39d6-aa7d-d14fc9ad5ed0",
                        "entry_id": "e68c9c43-f400-3512-96fb-f99b8df9aeb2",
                        "glosses": [
                            "Zubereitungsverfahren von Rotweinen, bei der die Maische auf bis zu 85 °C erhitzt, nach einer Verweilzeit rückgekühlt und gepresst und dann in der Art einer Weißweingärung gären gelassen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d1399ae-a150-4510-b2fb-e846a31b2160",
                                "sense_id": "47625db2-c1f3-39d6-aa7d-d14fc9ad5ed0",
                                "text": "„Auch durch das Weinbereitungsverfahren, Maischegärung oder Maischeerhitzung, Extraktionstechnik, Gärtemperatur und vieles andere wird der Polyphenolgehalt der Weine deutlich beeinflusst.“"
                            },
                            {
                                "example_id": "d3400a2b-5f68-4071-8eec-4f55ba0aa58a",
                                "sense_id": "47625db2-c1f3-39d6-aa7d-d14fc9ad5ed0",
                                "text": "„Fäulnisgrade von bis zu 10 % können bei ausreichender Ausfärbung und bei einer richtig durchgeführten Maischeerhitzung ohne lange Wartezeiten zwischen Lese und Erhitzung (87° C) toleriert werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
