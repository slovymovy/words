{
    "word_family": [
        "chock-full"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "624427a0-98c7-3f95-9061-f97721ee09cf",
                    "sense_definition": "A wedge or block placed behind a wheel or under an object to prevent it from moving or rolling.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fastening",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mechanic placed a <w>chock</w> behind the rear tire to keep the truck from rolling down the hill.",
                            "target_lang_translations": {
                                "zh": "修理工在后轮后面放了一个<w>轮挡</w>，以防止卡车顺着山坡滑下去。"
                            }
                        },
                        {
                            "text": "Before leaving the plane, the pilot signaled for the ground crew to remove the <w>chocks</w>.",
                            "target_lang_translations": {
                                "zh": "飞机离开前，飞行员示意地勤人员移走<w>轮挡</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "wedge",
                        "block"
                    ],
                    "common_phrases": [
                        "remove chocks",
                        "wheel chock"
                    ],
                    "target_lang_definitions": {
                        "zh": "放置在车轮后或物体下，用于防止其移动或滚动的楔子或垫块。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "轮挡",
                                "target_lang_sense_clarification": "专门用于固定车轮的垫块"
                            },
                            {
                                "target_lang_word": "楔子",
                                "target_lang_sense_clarification": "用于固定物体的楔形物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "90f0b875-1157-376c-b6f2-e6444631fb01",
                    "sense_definition": "A nautical fitting or fixture used to guide or restrict the movement of a rope or line.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "fastening",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sailor secured the mooring line through the <w>chock</w> on the deck.",
                            "target_lang_translations": {
                                "zh": "水手将系泊缆绳穿过甲板上的<w>导缆器</w>固定好。"
                            }
                        },
                        {
                            "text": "Ensure the rope is properly seated in the <w>chock</w> to prevent it from fraying against the hull.",
                            "target_lang_translations": {
                                "zh": "确保绳索正确地放置在<w>导缆器</w>中，以防其与船体摩擦磨损。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "deck chock"
                    ],
                    "target_lang_definitions": {
                        "zh": "船上用于引导或限制缆绳移动的装置。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "导缆器",
                                "target_lang_sense_clarification": "船用引导缆绳的固定装置"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "22c7aa38-6b94-3426-9a72-3fbce17d9f7d",
                    "sense_definition": "To secure or prevent an object from moving by using a wedge or block.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fastening",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Always <w>chock</w> the wheels of your vehicle when parking on a steep incline.",
                            "target_lang_translations": {
                                "zh": "在陡坡停车时，一定要用轮挡<w>塞住</w>车轮。"
                            }
                        },
                        {
                            "text": "The crew <w>chocked</w> the heavy equipment to ensure it would not shift during transport.",
                            "target_lang_translations": {
                                "zh": "船员们用垫块<w>塞住</w>了重型设备，以确保其在运输过程中不会移位。"
                            }
                        }
                    ],
                    "synonyms": [
                        "wedge",
                        "secure"
                    ],
                    "common_phrases": [
                        "chock the wheels"
                    ],
                    "target_lang_definitions": {
                        "zh": "使用楔子或垫块固定物体，防止其移动。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "塞住",
                                "target_lang_sense_clarification": "用垫块固定住"
                            },
                            {
                                "target_lang_word": "楔紧",
                                "target_lang_sense_clarification": "用楔子固定"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4078d795-b7f4-3f6a-a9da-3e32aa96213e",
                    "sense_definition": "To make a short, dull, percussive sound.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old wooden door began to <w>chock</w> every time the wind blew against it.",
                            "target_lang_translations": {
                                "zh": "每当风吹过时，那扇旧木门就会发出<w>咔哒</w>声。"
                            }
                        },
                        {
                            "text": "I heard the bolt <w>chock</w> into place as he locked the heavy gate.",
                            "target_lang_translations": {
                                "zh": "当他锁上沉重的大门时，我听见插销<w>咔哒</w>一声归位了。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "发出短促、沉闷的撞击声。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "咔哒声",
                                "target_lang_sense_clarification": "形容短促的撞击声"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "978ccd6f-b45e-3100-8672-d5da9299bef1",
                    "sense_definition": "Completely or entirely.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "degree",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ship was <w>chock</w> full of supplies for the long journey ahead.",
                            "target_lang_translations": {
                                "zh": "船上<w>塞满</w>了为前方漫长旅程准备的补给品。"
                            }
                        },
                        {
                            "text": "The small room was <w>chock</w> full of boxes and old furniture.",
                            "target_lang_translations": {
                                "zh": "这间小屋里<w>塞满</w>了箱子和旧家具。"
                            }
                        }
                    ],
                    "synonyms": [
                        "completely",
                        "entirely"
                    ],
                    "common_phrases": [
                        "chock full"
                    ],
                    "target_lang_definitions": {
                        "zh": "完全地，彻底地。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "塞满",
                                "target_lang_sense_clarification": "形容装得非常满"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "5e9645ad-eeb4-3f3b-b80c-9ec899f8f546",
                    "sense_definition": "A word used to imitate a dull, percussive sound.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bird made a rhythmic <w>chock</w> <w>chock</w> sound while sitting on the branch.",
                            "target_lang_translations": {
                                "zh": "那只鸟停在树枝上时，发出了有节奏的“<w>咔哒</w>、<w>咔哒</w>”声。"
                            }
                        },
                        {
                            "text": "I heard a <w>chock</w> <w>chock</w> coming from the loose floorboard in the hallway.",
                            "target_lang_translations": {
                                "zh": "我听到走廊里松动的地板发出“<w>咔哒</w>、<w>咔哒</w>”的声音。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used as an onomatopoeia."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "模仿沉闷撞击声的拟声词。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "咔哒",
                                "target_lang_sense_clarification": "拟声词"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "ad4edab5-7555-3364-aa06-e57340b538f4",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "name",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Chock</w> is the new manager of the local hardware store.",
                            "target_lang_translations": {
                                "zh": "<w>乔克</w>先生是当地五金店的新经理。"
                            }
                        },
                        {
                            "text": "The research paper was written by Dr. <w>Chock</w> and his colleagues.",
                            "target_lang_translations": {
                                "zh": "这份研究报告是由<w>乔克</w>博士和他的同事们撰写的。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Used as a family name."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "姓氏。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "乔克",
                                "target_lang_sense_clarification": "音译姓氏"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}