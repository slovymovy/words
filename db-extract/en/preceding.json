                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a7baa92-a571-4a57-b6a8-3bfaebea3019",
                                                "sense_id": "686fa6f8-f722-3dea-b45f-10d501c33fbe",
                                                "text": "Führende Wissenschaftler haben durch ihre Unterschrift unter dieses Dokument ihren Unmut über diese untragbaren Umstände zum Ausdruck gebracht."
                                            },
                                            {
                                                "example_id": "b666152e-fc64-4d34-b100-4ce7b6bdacdb",
                                                "sense_id": "686fa6f8-f722-3dea-b45f-10d501c33fbe",
                                                "text": "„Nachdem Canon mit dem Pocketronic erfolgreich war und Konkurrenzunternehmen wie Sharp eigene Versionen des Taschenrechners nachlegten, brachte Texas Instruments 1972 sein erstes eigenes Modell heraus, den TI 2500 Datamath. Schnell wurde das Unternehmen zum führenden Unternehmen für Taschenrechner. Zwischen 1972 und 1979 gab es um die 60 unterschiedliche TI-Rechner und -Modelle, von hochwertigen Wissenschaftsrechnern wie der programmierbare TI 59 bis hin zu Kinderrechnern wie der Wiz-a-Tron, ein kleiner orangefarbener Zauberer, der bei den Mathehausaufgaben half.“"
                                            },
                                            {
                                                "example_id": "d7256bc6-c956-4e4c-be36-26ec22bb9c59",
                                                "sense_id": "686fa6f8-f722-3dea-b45f-10d501c33fbe",
                                                "text": "„Dieses Unternehmen ist weltweit führend im Bereich Haushaltgeräte und besitzt berühmte Marken wie Moulinex, Tefal, Krups, Rowenta und Calor."
                                            },
                                            {
                                                "example_id": "6e99ff98-79a2-4ae1-b0f1-f6ed17887a3c",
                                                "sense_id": "686fa6f8-f722-3dea-b45f-10d501c33fbe",
                                                "text": "„Henry Purcell war der führende englische Komponist des 17. Jahrhunderts. Er schrieb Meisterwerke wie die Oper „Dido and Aeneas“.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
