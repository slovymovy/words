                        "glosses": [
                            "Quantité d’eau lâchée en ouvrant puis refermant une écluse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "35f10855-def7-4992-855e-1d3cb75ac6c4",
                                "sense_id": "c7c2b55f-040b-37ea-92f4-957e30fb1eda",
                                "text": "En général, le résultat sera une lâchure d’un volume d’eau important, entraînant des risques pour les personnes ou les biens à l’aval."
                            },
                            {
                                "example_id": "ac954be8-0e67-433b-ad21-2a6614662024",
                                "sense_id": "c7c2b55f-040b-37ea-92f4-957e30fb1eda",
                                "text": "Avant l’établissement de ces barrages, les mariniers étaient obligés, pendant la durée des basses eaux, d’aller réclamer, des usiniers supérieurs, des flots ou lâchures qui ne leur étaient accordés qu’à grand’peine et à un prix fort élevé : un grand flot ne coûtait pas moins de 600 francs."
                            }
                        ]
