                            "target_lang_translations": {
                                "en": "Parliament voted to <w>accede</w> to this international convention.",
                                "ru": "Парламент проголосовал за то, чтобы <w>присоединиться</w> к этой международной конвенции.",
                                "de": "Das Parlament stimmte dafür, dieser internationalen Konvention <w>beizutreten</w>.",
                                "es": "El parlamento votó a favor de <w>acceder</w> a esta convención internacional.",
                                "zh": "议会投票赞成<w>加入</w>这项国际公约。"
                            }
                        }
