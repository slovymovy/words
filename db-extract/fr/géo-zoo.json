                    {
                        "sense_id": "8f77f9cb-ca9e-3ab5-b989-8fef5578e12b",
                        "entry_id": "af8ed091-06a1-3668-b942-824dc2848903",
                        "glosses": [
                            "Type de zoo où les animaux sauvages sont présentés selon leur répartition géographique, par biozone ou par continent."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "89c31380-7196-43f3-9d84-af94cfda3da6",
                                "sense_id": "8f77f9cb-ca9e-3ab5-b989-8fef5578e12b",
                                "text": "Munich possède un « géo-zoo » où les animaux sont logés d'après leur continent d'origine."
                            },
                            {
                                "example_id": "331513df-36bb-472b-be9c-685546832162",
                                "sense_id": "8f77f9cb-ca9e-3ab5-b989-8fef5578e12b",
                                "text": "[…] : plutôt que d’exposer les animaux selon des critères scientifiques et zoologiques (ici, les biongulés, là les félins, là-bas les oiseaux), le zoo de Vincennes a choisi de présenter la flore et la faune de cinq régions du monde : Madagascar, la Patagonie, la Guyane, le Sahel et l’Europe. Ce concept de « géo-zoo » se traduit aussi par la volonté de placer les animaux dans de grands espaces recréant peu ou prou les conditions de leur vie sauvage antérieure."
                            }
                        ]
                    }
