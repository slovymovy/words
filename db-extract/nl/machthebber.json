                ],
                "translations": [
                    {
                        "translation_id": "fe6d2ac8-bf65-4033-8985-4923b1819921",
                        "source_entry_id": "0e5f2e62-feb2-3412-ac13-800bc7d9eae7",
                        "source_sense_id": "acc5548d-24fe-36ed-9a45-1089b48a6a76",
