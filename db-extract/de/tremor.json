                "translations": [
                    {
                        "translation_id": "02e4a9e9-5580-4b3c-95a3-d463e446f42c",
                        "source_entry_id": "fac23af5-4e6f-3907-8ba4-52f422476ad1",
                        "source_sense_id": "2bcbbc1a-e882-3aab-aa6e-69f37d382e2d",
                        "source_sense_description": "Medizin: unfreiwilliges, rhythmisches, wiederholtes Zusammenziehen der Muskeln",
                        "target_lang_word": "tremor",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tremor",
