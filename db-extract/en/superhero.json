                                        "glosses": [
                                            "personaggio di finzione con abilità molto superiori a quelle di un essere umano comune, che usa per affrontare personaggi negativi con gli stessi poteri"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "554fe961-4414-4979-b13c-7828e66a9c57",
                                                "sense_id": "9652fbe2-b297-3957-b559-72f41c010cd8",
                                                "text": "i supereroi, pur avendo sembianze umane, hanno abilità che nel mondo reale vengono ricondotte alla tecnologia"
                                            },
                                            {
                                                "example_id": "7a64e7c3-4c43-4b99-8ab8-632f71585d43",
                                                "sense_id": "9652fbe2-b297-3957-b559-72f41c010cd8",
                                                "text": "fondamento principale per la lotta dei supereroi è la distinzione tra i buoni ed i cattivi"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
