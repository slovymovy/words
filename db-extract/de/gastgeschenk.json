                ],
                "senses": [
                    {
                        "sense_id": "a33d391c-a761-3678-b723-6ea36ca08cd2",
                        "entry_id": "770a5bc1-b1d6-32b9-ac33-6830fcb38563",
                        "glosses": [
                            "ein Geschenk, das der Gast seinem Gastgeber überreicht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cd496f71-3cbb-4cb6-a85d-2a978efb0833",
                                "sense_id": "a33d391c-a761-3678-b723-6ea36ca08cd2",
                                "text": "„Meine Eltern überlegen, was sie Maika als Gastgeschenk mitnehmen sollen.“"
                            },
                            {
                                "example_id": "9cb8518b-8e5f-4038-8240-dc2242b8a657",
                                "sense_id": "a33d391c-a761-3678-b723-6ea36ca08cd2",
                                "text": "„Man begrüßte sich herzlich, Tom übergab ein kleines Gastgeschenk, und aus der Küche trat Emely, eine schlanke, wache Frau in legerer Kleidung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "bd77997d-00ef-3567-999c-1552e6e963ba",
                        "entry_id": "770a5bc1-b1d6-32b9-ac33-6830fcb38563",
                        "glosses": [
                            "ein Geschenk, das der Gastgeber seinem Gast überreicht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "56f5683c-62cc-429d-a4c9-b55d336e9b31",
                                "sense_id": "bd77997d-00ef-3567-999c-1552e6e963ba",
                                "text": "„Hier kann man diese heiter geschriebene Posse als Faksimile käuflich erwerben oder von Annemarie Kellner als freundliches Gastgeschenk verehrt bekommen, wenn man eine etwas größere Feier bestellt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
