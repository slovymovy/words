                        "entry_id": "be80a6e5-af24-3416-860d-a0dd95417de3",
                        "glosses": [
                            "ein zweites, meist kleineres Auto, das eine Person oder eine Familie in Besitz hat und fährt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44cc31a0-bc35-4429-a643-e08acab17cf9",
                                "sense_id": "cb760279-11ee-3259-b993-7a067f3a7678",
                                "text": "Viele Familien haben heutzutage einen Zweitwagen."
                            },
                            {
                                "example_id": "4b1b8e04-e519-4825-b144-46ccd784f897",
                                "sense_id": "cb760279-11ee-3259-b993-7a067f3a7678",
                                "text": "„Doch von der Liebe allein kann der Mensch nicht leben, es gehört auch Brot dazu, Sicherheit, Aufstieg, Pensionsberechtigung, der Zweitwagen neben dem Erstauto des Mannes.“"
                            }
                        ],
