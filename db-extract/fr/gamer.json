                    {
                        "sense_id": "f122a062-f1c3-3fe0-9619-e4d6bdd25d27",
                        "entry_id": "4824bd14-e5c2-3dfe-befe-82cc56b2eece",
                        "glosses": [
                            "Joueur assidu ou fan de jeux vidéo."
                        ],
                        "tags": [
                            "Jeux vidéo"
                        ],
                        "examples": [
                            {
                                "example_id": "86f3abe9-196c-42d3-bcd3-ebd8e7db938b",
                                "sense_id": "f122a062-f1c3-3fe0-9619-e4d6bdd25d27",
                                "text": "L'avenir, c'est confier la sécurité routière à des gamers."
                            },
                            {
                                "example_id": "bc44b0af-8b61-4719-a49b-ffbdd2a15423",
                                "sense_id": "f122a062-f1c3-3fe0-9619-e4d6bdd25d27",
                                "text": "Ce n’est que trois ans plus tard que leurs destins se croisent quand Riot Games, éditeur du jeu, demande à Fortiche de réaliser des présentations de leurs personnages phares. Le succès est tel que l’envie de voir plus grand « spawn », comme disent les gamers, dans l’esprit des deux sociétés."
                            }
                        ]
                    },
                    {
                        "sense_id": "18e0a115-b465-301b-8939-ba4472192aca",
                        "entry_id": "4824bd14-e5c2-3dfe-befe-82cc56b2eece",
                        "glosses": [
                            "Ordinateur portable dont les performances et la carte graphique sont particulièrement adaptées aux jeux vidéo."
                        ],
                        "tags": [
                            "Jeux vidéo"
                        ],
                        "examples": []
                    }
