                "senses": [
                    {
                        "sense_id": "b1ccba25-6b53-37b5-ad54-33c773b7d562",
                        "entry_id": "941cc159-229a-3acb-bde5-4c282f8719c6",
                        "glosses": [
                            "strömungstechnisch geformte äußere Hülle eines Ventilators, in dem das Ventilatorlaufrad Strömungsarbeit leisten kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "927665f3-2d97-42dd-982c-4aee2d03c54f",
                                "sense_id": "b1ccba25-6b53-37b5-ad54-33c773b7d562",
                                "text": "„Die Gerätevarianten mit Ventilatorgehäuse sowie die zugehörigen Kanalkomponenten entsprechen den Hygiene-Anforderungen der Richtlinie VDI 6022.“"
                            },
                            {
                                "example_id": "92a9bbb8-0a24-48cd-b3f2-17a5bc80f569",
                                "sense_id": "b1ccba25-6b53-37b5-ad54-33c773b7d562",
                                "text": "„Die Lagereinheit ist auf dem seitlich am Ventilatorgehäuse angeschraubten Lagerbock befestigt.“"
                            },
                            {
                                "example_id": "ad4f28b1-31ea-4de1-a00c-f2d515854e0f",
                                "sense_id": "b1ccba25-6b53-37b5-ad54-33c773b7d562",
                                "text": "„Ventilatorgehäuse bestehen standardmäßig aus Kunststoff oder Stahl.“"
                            },
                            {
                                "example_id": "5010183e-0688-47b2-be7c-2799c7922776",
                                "sense_id": "b1ccba25-6b53-37b5-ad54-33c773b7d562",
                                "text": "„Ventilator und Ventilatorgehäuse bestehen aus leichtem Aluminium, der Rahmen aus Stahlprofilrohr.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
