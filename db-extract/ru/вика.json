                                        "sense_id": "1f00c0c4-8887-326a-ab3e-2bc857bec46a",
                                        "entry_id": "3c16a28b-81ce-31a5-99a3-01b8665a6c95",
                                        "glosses": [
                                            "A vetch, or the seed of a vetch (genus Vicia, esp. Vicia sativa)"
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d2e7f63b-9f7b-39de-8846-cb8bf86bb7d8",
                                        "entry_id": "3c16a28b-81ce-31a5-99a3-01b8665a6c95",
                                        "glosses": [
                                            "Any of the tufted grasses of genus Lolium; darnel."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "06d4cb37-67f5-3b64-a6d0-563dfb285f52",
                                        "entry_id": "3c16a28b-81ce-31a5-99a3-01b8665a6c95",
                                        "glosses": [
                                            "A damaging weed growing in fields of grain."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e1eab2e1-d1d7-424c-8d7d-0c4c0e583220",
                                                "sense_id": "06d4cb37-67f5-3b64-a6d0-563dfb285f52",
                                                "text": "I saw as I thought an uncle and guardian who has led a sober, industrious and Christian life and finds himself obliged to look on the tares of folly in his own close kin."
                                            },
                                            {
                                                "example_id": "76e45e56-de54-4f08-89c7-1c2293f84e57",
                                                "sense_id": "06d4cb37-67f5-3b64-a6d0-563dfb285f52",
                                                "text": "But while men slept, his enemy came and sowed tares among the wheat, and went his way."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tare",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "57332cd7-14da-3796-bdee-bf8e2fa793ce",
                                        "entry_id": "07a7679b-61f7-36aa-87ca-f1ddb07b24e4",
                                        "glosses": [
                                            "The empty weight of a container; unladen weight."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6cebcf76-5480-4794-9c2e-da0df8e882e5",
                                                "sense_id": "57332cd7-14da-3796-bdee-bf8e2fa793ce",
                                                "text": "What is the neat weight of 4 hogsheads of tobacco, each weighing 10cwt. 3qrs. 10lb. gross; — tare 100lb. per hdd.?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tare",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5a7739fc-7581-3483-b53f-d1a60d640c6a",
                                        "entry_id": "63b4a579-57c7-3646-9997-a81f090010f1",
                                        "glosses": [
                                            "To take into account the weight of the container, wrapping etc. in weighting merchandise."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "94a839a4-0933-45aa-9610-9c65d22c0bca",
                                                "sense_id": "5a7739fc-7581-3483-b53f-d1a60d640c6a",
                                                "text": "he is […] to tare such number of bales as may be deemed necessary to settle the net weight for duty."
                                            },
