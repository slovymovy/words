                        "glosses": [
                            "zwolennik pastafarianizmu, „wyznawca” pastafarianizmu"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "60ac2afe-9a61-4f97-8693-dfaa48837611",
                                "sense_id": "98e3ec87-edb0-3047-9574-21ebce0470dd",
                                "text": "Austriak tłumaczył, że służące do odcedzania makaronu naczynie jest religijnym nakryciem głowy pastafarian. Urzędnicy odrzucili wniosek, jednak po trwającym trzy lata procesie sąd przyznał Almowi rację. Od tamtej pory pastafarianin legitymuje się prawem jazdy, na którym widnieje jego fotografia z durszlakiem na głowie"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "128d24a2-4e64-440c-8534-0aaa1f489463",
                        "source_entry_id": "d79ee474-e61c-331b-a74c-d51305fc0e8d",
                        "source_sense_id": "98e3ec87-edb0-3047-9574-21ebce0470dd",
