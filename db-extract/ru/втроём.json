                                        "examples": []
                                    },
                                    {
                                        "sense_id": "42608df9-1d37-3a0f-bf9b-b15fc480ad18",
                                        "entry_id": "23ff49ee-61f9-326a-b894-34569d0fdcf0",
                                        "glosses": [
                                            "Three o'clock, either a.m. or p.m."
