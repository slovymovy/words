                "forms": [],
                "senses": [
                    {
                        "sense_id": "f2c56c32-81bf-3080-8546-4bd5db4a02da",
                        "entry_id": "8bc1542f-a049-3224-815f-7c6d106071b8",
                        "glosses": [
                            "op een negatieve, verbazingwekkende manier"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ba934f2b-d18d-498f-a7b4-309cc706e498",
                                "sense_id": "f2c56c32-81bf-3080-8546-4bd5db4a02da",
                                "text": "Chelsea-coach Maurizio Sarri heeft zijn spelers gisteravond na de onthutsende nederlaag bij Bournemouth (4-0) opgesloten in de kleedkamer."
                            },
                            {
                                "example_id": "da7672c7-2b05-4784-ae16-a8b3c8226314",
                                "sense_id": "f2c56c32-81bf-3080-8546-4bd5db4a02da",
                                "text": "Dr. Victoria Cann, als docent verbonden aan de universiteit van East Anglia in het Britse Norwich, bestudeerde alle Disneyfilms en kwam tot de onthutsende conclusie dat kinderen er eigenlijk niet mee gebaat zijn, zo vertelde zij tegen The Sun."
                            },
                            {
                                "example_id": "3de1a0d1-eecd-472d-ac5e-3df49428c4d7",
                                "sense_id": "f2c56c32-81bf-3080-8546-4bd5db4a02da",
                                "text": "Onthutsend. Pijnlijk. Figurant. Niet om aan te zien. Daags na de doodeenvoudige zege (0-2) van Manchester City bij rivaal Manchester United voert het verval van de rode club uit de industriestad de boventoon in Britse media."
                            }
                        ]
                    }
