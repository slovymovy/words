                                        "glosses": [
                                            "The act of consulting or deliberating; consultation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d65c7c2b-c83a-4410-96de-a0b44a502009",
                                                "sense_id": "bec48c8a-0007-3030-95ef-7d6b0ae771c7",
                                                "text": "For firſt upon conſult of reaſon, there will bee found no eaſie aſſurance for to faſten a materiall or temperamentall propriety upon any nation; […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aabf93e6-7510-3f14-99db-5446f4fbd713",
                                        "entry_id": "3dc49f02-9dbd-3aa3-8563-f0609596efc7",
                                        "glosses": [
                                            "The result of consultation; determination; decision."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6cb327f6-9107-4bcd-98b2-c59db7d97fe9",
                                                "sense_id": "aabf93e6-7510-3f14-99db-5446f4fbd713",
                                                "text": "[T]he council broke; / And all their grave conſults diſſolv'd in ſmoke."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6fd661cd-767e-3e3d-b7d1-8f2815cdaaa3",
                                        "entry_id": "3dc49f02-9dbd-3aa3-8563-f0609596efc7",
                                        "glosses": [
                                            "A council; a meeting for consultation."
