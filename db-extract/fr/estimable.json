                "senses": [
                    {
                        "sense_id": "1795dc6e-fd07-382f-8a3d-b1f71f887121",
                        "entry_id": "be72bceb-66f9-337c-a63c-4888b1198e6e",
                        "glosses": [
                            "Qui mérite d’être estimé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d91dda99-c284-4541-99f8-211e97293920",
                                "sense_id": "1795dc6e-fd07-382f-8a3d-b1f71f887121",
                                "text": "La vie laborieuse, active, toute estimable, toute positive, d'un conseiller d'État, d'un manufacturier de tissus de coton ou d'un banquier fort alerte pour les emprunts, est récompensée par des millions, et non par des sensations tendres."
                            },
                            {
                                "example_id": "34f069ef-1f8a-41af-8ce0-92d3864b5466",
                                "sense_id": "1795dc6e-fd07-382f-8a3d-b1f71f887121",
                                "text": "Note : Implique souvent l’idée d’un mérite médiocre et limité."
                            },
                            {
                                "example_id": "44d55150-a591-4d0f-bb35-283ce8e990db",
                                "sense_id": "1795dc6e-fd07-382f-8a3d-b1f71f887121",
                                "text": "Écrivain estimable."
                            }
                        ]
                    }
                ],
