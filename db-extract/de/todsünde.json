                        ],
                        "form": "die Todsünde"
                    },
                    {
                        "form_id": "849ece03-1689-4d6e-9c2e-c559bfb47fa5",
                        "entry_id": "b6305c48-892e-321c-aa2c-3fea6da48605",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Todsünden"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d2b5ab96-3178-3262-9384-e78319e036ac",
                        "entry_id": "b6305c48-892e-321c-aa2c-3fea6da48605",
                        "glosses": [
                            "besonders schwerwiegende Sünde"
                        ],
                        "tags": [
                            "katholische Theologie"
                        ],
                        "examples": [
                            {
                                "example_id": "c719ed45-7096-427d-b9e0-5e46fd18d5b0",
                                "sense_id": "d2b5ab96-3178-3262-9384-e78319e036ac",
                                "text": "Die Lehre der Kirche nennt „denjenigen Akt eine Todsünde, durch den ein Mensch bewusst und frei Gott und sein Gesetz sowie den Bund der Liebe, den dieser ihm anbietet, zurückweist, indem er es vorzieht, sich selbst zuzuwenden oder irgendeiner geschaffenen und endlichen Wirklichkeit, irgendeiner Sache, die im Widerspruch zum göttlichen Willen steht“. (Katechismus der Katholischen Kirche)"
                            },
                            {
                                "example_id": "7f2204fa-f1f6-4497-abff-a44cf346a35b",
                                "sense_id": "d2b5ab96-3178-3262-9384-e78319e036ac",
                                "text": "„Amüsiere Dich recht gut und sei lustig, denn wer lacht, kann keine Todsünd’ tun.“"
                            },
                            {
                                "example_id": "9246d873-19a3-4224-bb70-8d9ba1898e57",
                                "sense_id": "d2b5ab96-3178-3262-9384-e78319e036ac",
                                "text": "„Die christliche Überlieferung hat den Kardinaltugenden die sieben Todsünden gegenübergestellt.“"
                            },
                            {
                                "example_id": "2168b287-0e88-4f4a-b6e2-910a28993bba",
                                "sense_id": "d2b5ab96-3178-3262-9384-e78319e036ac",
                                "text": "„Das Ansinnen, wie der Allmächtige von oben auf die Welt zu blicken, ist schiere Hybris und kommt - wie übrigens auch die Neugierde um ihrer selbst willen - fast einer Todsünde gleich.“"
                            },
                            {
                                "example_id": "dbc563f0-148f-4ed9-9b61-778e73383a1d",
                                "sense_id": "d2b5ab96-3178-3262-9384-e78319e036ac",
                                "text": "„Ich habe die Wonnen wie die Todsünden bis zum Grunde ausgeschöpft.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "5fabd9a9-cc49-3902-8e43-7dceb38c4d47",
                        "entry_id": "b6305c48-892e-321c-aa2c-3fea6da48605",
                        "glosses": [
                            "eine große Dummheit"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "7d225f2e-e847-4cce-8fa4-af92ec99240d",
                                "sense_id": "5fabd9a9-cc49-3902-8e43-7dceb38c4d47",
                                "text": "Irrtum ist keine Todsünde!"
                            },
                            {
                                "example_id": "e29fd80a-4052-491f-9d46-f76261d90af5",
                                "sense_id": "5fabd9a9-cc49-3902-8e43-7dceb38c4d47",
                                "text": "„Ich hatte mich vor sie hingesetzt und sagte ihr, sie würde eine Todsünde begehen, wenn sie mich unreiner Gedanken verdächtige, denn da ich ihr Vater sein könne, wäre das ganz unmöglich.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "06e2d3e5-16d1-413d-a879-d6b29b7330ea",
                        "source_entry_id": "b6305c48-892e-321c-aa2c-3fea6da48605",
                        "source_sense_id": "d2b5ab96-3178-3262-9384-e78319e036ac",
