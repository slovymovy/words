                                                "sense_id": "79836913-c407-3bbd-b736-2534d2e864b1",
                                                "text": "Cette imprimante est dotée de cartouches couleur ; elle peut imprimer en couleur."
                                            },
                                            {
                                                "example_id": "b78c9273-e9d2-45fa-80e6-37ef29027160",
                                                "sense_id": "79836913-c407-3bbd-b736-2534d2e864b1",
                                                "text": "Si votre imprimante n’est pas installée sur le bon port, il n’est plus possible d’imprimer."
                                            }
