                "senses": [
                    {
                        "sense_id": "208aab3e-f0f4-3a25-97e6-2987d3bb4ba4",
                        "entry_id": "58515b3a-9a78-3288-bbe8-9d941953e6d9",
                        "glosses": [
                            "Industrie de la construction d’avions."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5c592fb3-69ec-4dcf-99ec-a395b7bc2ef4",
                                "sense_id": "208aab3e-f0f4-3a25-97e6-2987d3bb4ba4",
                                "text": "Là virent le jour quantité d’inventions concernant l’Aviation et une foule de procédés de fabrication, connus seulement par notre personnel et qui constituaient l’industrie naissante de l’Avionnerie."
                            },
                            {
                                "example_id": "e086a875-a39e-4564-a075-e0f172266ccb",
                                "sense_id": "208aab3e-f0f4-3a25-97e6-2987d3bb4ba4",
                                "text": "De plus, le gouvernement fédéral prit le contrôle de certaines entreprises canadiennes en difficulté, dans le domaine de l’avionnerie en particulier."
                            }
                        ]
                    },
                    {
                        "sense_id": "4673c374-7038-3522-b242-d376961491d9",
                        "entry_id": "58515b3a-9a78-3288-bbe8-9d941953e6d9",
                        "glosses": [
                            "Usine construisant des avions."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "91913140-8bc6-4714-a6bf-337cd5433371",
                                "sense_id": "4673c374-7038-3522-b242-d376961491d9",
                                "text": "Pour en arriver à obtenir des facteurs de sécurité aussi bas, une avionnerie procède à des essais sur les pièces en recréant les conditions d’utilisation."
                            },
                            {
                                "example_id": "5781d116-57a1-479f-b4ac-97a07ab16b38",
                                "sense_id": "4673c374-7038-3522-b242-d376961491d9",
                                "text": "Louis Blériot n’échappa pas à cette fièvre des airs : c’est là qu’il installa sa propre « avionnerie » et sortit plusieurs machines à son nom qu’il essaya lui-même entre 1905 et 1909, date à laquelle le Blériot XI traversa la Manche en 37 minutes."
                            }
                        ]
                    },
