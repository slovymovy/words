{
    "word_family": [
        "dig",
        "digging",
        "diggable",
        "undiggable"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4cb20d7d-d272-3c69-a1de-c88f185e99e3",
                    "sense_definition": "A large piece of machinery used for excavating holes or trenches in the ground.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "machinery",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The construction crew used a mechanical <w>digger</w> to prepare the site for the new building.",
                            "target_lang_translations": {
                                "ru": "Строительная бригада использовала механический <w>экскаватор</w>, чтобы подготовить площадку для нового здания."
                            }
                        },
                        {
                            "text": "A large <w>digger</w> was parked on the street, blocking the path of the pedestrians.",
                            "target_lang_translations": {
                                "ru": "На улице был припаркован большой <w>экскаватор</w>, преграждавший путь пешеходам."
                            }
                        }
                    ],
                    "synonyms": [
                        "excavator"
                    ],
                    "common_phrases": [
                        "mechanical digger"
                    ],
                    "target_lang_definitions": {
                        "ru": "Крупная строительная техника, предназначенная для рытья ям или траншей в земле."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "экскаватор",
                                "target_lang_sense_clarification": "строительная машина"
                            },
                            {
                                "target_lang_word": "копатель",
                                "target_lang_sense_clarification": "механизм для копания"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0a59ac77-d16a-38ce-9b35-31c64b0ff9c2",
                    "sense_definition": "A person or animal that digs.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "agent",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My dog is an enthusiastic <w>digger</w> who always leaves holes in the flower beds.",
                            "target_lang_translations": {
                                "ru": "Моя собака — заядлый <w>копатель</w>, который вечно оставляет ямы на клумбах."
                            }
                        },
                        {
                            "text": "The archaeologists were careful <w>diggers</w> as they searched for ancient artifacts.",
                            "target_lang_translations": {
                                "ru": "Археологи были аккуратными <w>копателями</w>, пока искали древние артефакты."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек или животное, которое занимается копанием земли."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "землекоп",
                                "target_lang_sense_clarification": "человек, выполняющий земляные работы"
                            },
                            {
                                "target_lang_word": "копатель",
                                "target_lang_sense_clarification": "тот, кто копает"
                            },
                            {
                                "target_lang_word": "копальщик",
                                "target_lang_sense_clarification": "человек, выкапывающий что-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b1090cbf-bbbc-3e7c-96db-7db2d3c24b75",
                    "sense_definition": "A hand tool designed for making holes in the earth.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "tools",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He used a post hole <w>digger</w> to install the new fence around the garden.",
                            "target_lang_translations": {
                                "ru": "Он использовал <w>бур</w> для столбов, чтобы установить новый забор вокруг сада."
                            }
                        },
                        {
                            "text": "The old <w>digger</w> was rusty but still worked well for planting small trees.",
                            "target_lang_translations": {
                                "ru": "Старая <w>копалка</w> заржавела, но всё ещё хорошо подходила для посадки маленьких деревьев."
                            }
                        }
                    ],
                    "common_phrases": [
                        "post hole digger"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ручной инструмент, предназначенный для проделывания отверстий в почве."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бур",
                                "target_lang_sense_clarification": "инструмент для ям"
                            },
                            {
                                "target_lang_word": "копалка",
                                "target_lang_sense_clarification": "ручной инструмент"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b16ff50f-034f-3b27-874e-dec38b634035",
                    "sense_definition": "An informal term for an Australian or New Zealand soldier.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "military",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The statue was built to honor every <w>digger</w> who served in the Great War.",
                            "target_lang_translations": {
                                "ru": "Статуя была воздвигнута в честь каждого <w>солдата-диггера</w>, служившего в Первой мировой войне."
                            }
                        },
                        {
                            "text": "He spoke proudly of his grandfather, who was a <w>digger</w> during the Vietnam conflict.",
                            "target_lang_translations": {
                                "ru": "Он с гордостью говорил о своём дедушке, который был <w>австралийским солдатом</w> во время вьетнамского конфликта."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Commonly used in Australia and New Zealand"
                        },
                        {
                            "trait_type": "regional",
                            "comment": "Australia and New Zealand"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Разговорное название австралийского или новозеландского солдата."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "диггер",
                                "target_lang_sense_clarification": "австралийский солдат"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "39f2ef9a-345c-39ce-83c7-bb8d2aa689b6",
                    "sense_definition": "A person who mines for gold, especially during a gold rush.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mining",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lucky <w>digger</w> found a massive gold nugget in the creek bed.",
                            "target_lang_translations": {
                                "ru": "Удачливый <w>старатель</w> нашел массивный золотой самородок в русле ручья."
                            }
                        },
                        {
                            "text": "Thousands of <w>diggers</w> flocked to the goldfields in hopes of striking it rich.",
                            "target_lang_translations": {
                                "ru": "Тысячи <w>золотоискателей</w> хлынули на прииски в надежде разбогатеть."
                            }
                        }
                    ],
                    "common_phrases": [
                        "gold digger"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Associated with historical gold rushes"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, добывающий золото, особенно во времена золотой лихорадки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "старатель",
                                "target_lang_sense_clarification": "золотоискатель"
                            },
                            {
                                "target_lang_word": "золотоискатель",
                                "target_lang_sense_clarification": "добытчик золота"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a0498ac2-4f1c-3136-a446-de92cff564eb",
                    "sense_definition": "A friendly or informal way to address a man.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "address",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "How are you doing today, <w>digger</w>?",
                            "target_lang_translations": {
                                "ru": "Как дела сегодня, <w>дружище</w>?"
                            }
                        },
                        {
                            "text": "He greeted his old friend with a cheerful, \"Hello, <w>digger</w>!\"",
                            "target_lang_translations": {
                                "ru": "Он поприветствовал старого друга бодрым: «Привет, <w>приятель</w>!»"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Informal address"
                        },
                        {
                            "trait_type": "regional",
                            "comment": "Primarily Australian"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Дружеское или неформальное обращение к мужчине (преимущественно в Австралии)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дружище",
                                "target_lang_sense_clarification": "неформальное обращение"
                            },
                            {
                                "target_lang_word": "приятель",
                                "target_lang_sense_clarification": "дружеское обращение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "de2f5637-4dd5-303b-a785-301fb9f3cf45",
                    "sense_definition": "A slang term for the spade suit in a deck of playing cards.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "cards",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He realized he held the ace of <w>diggers</w> in his hand during the final round.",
                            "target_lang_translations": {
                                "ru": "В финальном раунде он понял, что держит в руках туза <w>пик</w>."
                            }
                        },
                        {
                            "text": "The player threw down a <w>digger</w> to win the trick.",
                            "target_lang_translations": {
                                "ru": "Игрок выложил <w>пику</w>, чтобы забрать взятку."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Card games"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сленговое название масти пик в колоде игральных карт."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пики",
                                "target_lang_sense_clarification": "карточная масть"
                            },
                            {
                                "target_lang_word": "лопаты",
                                "target_lang_sense_clarification": "сленг для пик"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "0db8f565-8a3d-3ae0-b8fa-082a8e36fc69",
                    "sense_definition": "A user of the news aggregator website Digg.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "internet",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>Diggers</w> voted the story to the front page within minutes of it being posted.",
                            "target_lang_translations": {
                                "ru": "<w>Диггеры</w> вывели историю на главную страницу через несколько минут после публикации."
                            }
                        },
                        {
                            "text": "Many <w>Diggers</w> eventually migrated to other social news platforms like Reddit.",
                            "target_lang_translations": {
                                "ru": "Многие <w>пользователи Digg</w> со временем перешли на другие платформы социальных новостей, такие как Reddit."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Internet culture"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Пользователь новостного агрегатора Digg."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "диггер",
                                "target_lang_sense_clarification": "пользователь сайта Digg"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "353477d7-e7ec-344b-91e7-dd8b685bccc3",
                    "sense_definition": "A member of a 17th-century English group of agrarian communists who advocated for communal land ownership.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "history",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>Diggers</w> began cultivating common land to protest against private property laws.",
                            "target_lang_translations": {
                                "ru": "<w>Диггеры</w> начали возделывать общинные земли в знак протеста против законов о частной собственности."
                            }
                        },
                        {
                            "text": "Gerrard Winstanley was a prominent leader of the <w>Diggers</w> movement in 1649.",
                            "target_lang_translations": {
                                "ru": "Джерард Уинстэнли был видным лидером движения <w>диггеров</w> в 1649 году."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Участник английского движения аграрных коммунистов XVII века, выступавших за общинное землевладение."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "диггер",
                                "target_lang_sense_clarification": "историческое движение"
                            },
                            {
                                "target_lang_word": "истинный левеллер",
                                "target_lang_sense_clarification": "политический термин"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9adf7d90-af9b-3166-a6e7-ee0400ee50d1",
                    "sense_definition": "A historical, often derogatory term for certain Native American tribes in the Western US who gathered roots.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "ethnography",
                    "name_type": "ethnic_group_name",
                    "examples": [
                        {
                            "text": "Early settlers used the term <w>Diggers</w> to describe tribes that relied on digging for edible roots.",
                            "target_lang_translations": {
                                "ru": "Первые поселенцы использовали термин <w>диггеры</w> для описания племен, которые выживали за счет выкапывания съедобных кореньев."
                            }
                        },
                        {
                            "text": "The name <w>Diggers</w> is now considered offensive and inaccurate by modern historians.",
                            "target_lang_translations": {
                                "ru": "Название <w>диггеры</w> сейчас считается оскорбительным и неточным среди современных историков."
                            }
                        }
                    ],
                    "synonyms": [
                        "Shoshokie",
                        "Shoshoko"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Often considered offensive"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Историческое, часто пренебрежительное название некоторых индейских племен Запада США, собиравших коренья."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "диггеры",
                                "target_lang_sense_clarification": "этнографический термин"
                            },
                            {
                                "target_lang_word": "копатели кореньев",
                                "target_lang_sense_clarification": "описательный перевод"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}