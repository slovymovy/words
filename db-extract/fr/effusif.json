                        "entry_id": "b42c7d32-f110-30e5-a8d9-5674ee981158",
                        "glosses": [
                            "Caractérise une roche résultant du refroidissement de l’effusion d’un magma."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "dea5c729-55ba-36ec-be34-79143a97d3b6",
                        "entry_id": "b42c7d32-f110-30e5-a8d9-5674ee981158",
                        "glosses": [
                            "Qui produit des coulées de lave."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c9ca467-b315-42e6-9be4-67be1cf24455",
                                "sense_id": "dea5c729-55ba-36ec-be34-79143a97d3b6",
                                "text": "Un volcan effusif."
                            },
                            {
                                "example_id": "30a280d5-c388-48fe-ad73-6d30bf94ea10",
                                "sense_id": "dea5c729-55ba-36ec-be34-79143a97d3b6",
                                "text": "Le volcanisme basaltique de type effusif, et le volcanisme andésitique de type explosif, sont distincts géographiquement."
                            },
                            {
                                "example_id": "12631727-c4eb-42a2-84e2-a3cc2086c64a",
                                "sense_id": "dea5c729-55ba-36ec-be34-79143a97d3b6",
                                "text": "Un volcan en effusion."
                            }
                        ]
                    },
                    {
                        "sense_id": "a2d65fc3-1451-3dd8-9536-392afa78b83d",
                        "entry_id": "b42c7d32-f110-30e5-a8d9-5674ee981158",
                        "glosses": [
                            "Qui s’effuse, qui se répand."
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "08628731-6c9c-4244-98a0-70336e4564a5",
                                "sense_id": "a2d65fc3-1451-3dd8-9536-392afa78b83d",
                                "text": "Frédéric avait le cœur effusif, si parfois sa tête s’ennuageait."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9591b1e2-d1b5-4db5-ae54-407109ffedab",
