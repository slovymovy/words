                ],
                "senses": [
                    {
                        "sense_id": "66da7457-8a11-30eb-a603-0c39a5ae12c3",
                        "entry_id": "acc6a7b2-2a1a-375a-834b-2a309442be26",
                        "glosses": [
                            "Qualifie une personne à l’intersection des communautés neuroatypique et queer."
                        ],
                        "tags": [
                            "LGBTQ"
                        ],
                        "examples": [
                            {
                                "example_id": "6113b610-648a-4d6c-b2fc-2017acb87ad9",
                                "sense_id": "66da7457-8a11-30eb-a603-0c39a5ae12c3",
                                "text": "Depuis Le Sacre, le jeune comédien a joué dans deux autres pièces, rejoint un collectif d’artistes autistes francophones (Spectre artistique) et écrit un bref mémoire sur « la place et l’impact des identités et vécus neuroqueers dans les arts de la scène », qui lui a permis d’approfondir sa réflexion personnelle sur « comment faire du théâtre quand on est autiste »."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ae6c5756-a240-4e71-9453-3399da2c0da2",
                        "source_entry_id": "acc6a7b2-2a1a-375a-834b-2a309442be26",
                        "source_sense_id": "66da7457-8a11-30eb-a603-0c39a5ae12c3",
                        "target_lang_word": "neuroqueer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "neuroqueer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fea760c9-d49f-35be-9f3e-6520c7dcf861",
                                        "entry_id": "da109e90-711f-328e-a29d-a3d2c1196939",
                                        "glosses": [
                                            "Belonging to, characteristic of, or related to the intersection of neurodivergence and queerness, particularly autism and LGBT identities."
                                        ],
                                        "tags": [
                                            "neologism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c10e33dd-aede-43b2-9993-7932f3cf4737",
                                                "sense_id": "fea760c9-d49f-35be-9f3e-6520c7dcf861",
                                                "text": "Whether discussed in clinical journals or in media accounts, ABA purports to change neural pathways, rewire neuroqueer brains, and ford synapses."
                                            },
                                            {
                                                "example_id": "613cfaad-bf23-4082-8960-0cd76c248919",
                                                "sense_id": "fea760c9-d49f-35be-9f3e-6520c7dcf861",
                                                "text": "Neuroqueer perspectives challenge typical understandings of identity categories through disidentification processes. A neuroqueer project not only questions typical conceptions of gender but also pivots away from normative gender categories altogether."
                                            },
                                            {
                                                "example_id": "088f7c24-d1fa-4571-8e2c-874639448731",
                                                "sense_id": "fea760c9-d49f-35be-9f3e-6520c7dcf861",
                                                "text": "My conceptualization of neuroqueer technoscience is also strongly influenced by 3 my own experiences as a multiply neurodivergent queer femme."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "neuroqueer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c99fe6e1-3063-3eac-9ddb-fd71f2d9c142",
                                        "entry_id": "eb3f7c7d-5119-3a7b-a4a1-94afb1c3e8bd",
                                        "glosses": [
                                            "The state or quality of being neuroqueer."
                                        ],
                                        "tags": [
                                            "neologism",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "65176456-6560-4bb9-adfa-218064b6f9ab",
                                                "sense_id": "c99fe6e1-3063-3eac-9ddb-fd71f2d9c142",
                                                "text": "Neuroqueer is a queer/crip response to normative discussions about gender, sexuality, and disability as pathology."
                                            },
                                            {
                                                "example_id": "ecaa6890-ac67-466d-bdd7-213dcc49954d",
                                                "sense_id": "c99fe6e1-3063-3eac-9ddb-fd71f2d9c142",
                                                "text": "Autistic rhetoric scholar Melanie Yergeau theorizes neuroqueer as a kind of “asocially perverse” motioning."
                                            },
                                            {
                                                "example_id": "3de084ed-ee2d-4cec-a5c5-7c78f2f3410f",
                                                "sense_id": "c99fe6e1-3063-3eac-9ddb-fd71f2d9c142",
                                                "text": "For a primer on the issue of neuroqueer and its roots in multiple discourse fields from queer aversion therapy to antiautistic hate speech, see Yergeau 2018."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8214a82d-8b23-33e3-8214-4bd4c47a9632",
                                        "entry_id": "eb3f7c7d-5119-3a7b-a4a1-94afb1c3e8bd",
                                        "glosses": [
                                            "One who belongs to the neuroqueer community."
                                        ],
                                        "tags": [
                                            "countable",
                                            "neologism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eb01ec4e-d23e-4afb-8395-323bdf3d3ea3",
                                                "sense_id": "8214a82d-8b23-33e3-8214-4bd4c47a9632",
                                                "text": "In this regard, the potential of a prosthetic, specialized environment is the always-now —any change could result in neuroqueers backsliding into neuroqueerity."
                                            },
                                            {
                                                "example_id": "9645c39f-acfd-4d44-afe3-abd9008f9276",
                                                "sense_id": "8214a82d-8b23-33e3-8214-4bd4c47a9632",
                                                "text": "For those of us who inhabit the spaces between the cracks, the neuroqueers who wander outside a prescribed notion of “cognitive normalcy,” we know things are not that simple."
                                            },
                                            {
                                                "example_id": "7279519b-03d8-4d3a-af1b-86396bc6b1f2",
                                                "sense_id": "8214a82d-8b23-33e3-8214-4bd4c47a9632",
                                                "text": "We affirm that there is nomore important queer project than for neuroqueers, crips, and non-normates more generally to survive with an essential flourish (Peers, 2018) in the face of that which would render our most basic needs undesirable, untenable, unreasonable, or “special.”"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "neuroqueer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "89c14ee2-f242-3c6d-8755-f3c52cfebb8a",
                                        "entry_id": "99354032-9a29-3ef7-95ba-b79fbd6330b7",
                                        "glosses": [
                                            "To make or become neuroqueer."
                                        ],
                                        "tags": [
                                            "neologism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5e1f9a14-5631-4b69-92fc-530a6f39701d",
                                                "sense_id": "89c14ee2-f242-3c6d-8755-f3c52cfebb8a",
                                                "text": "I believe in the potentialities of autistic stories and gestures, of neuroqueering what we've come to understand as language and being."
                                            },
                                            {
                                                "example_id": "e6433d05-060a-48bd-9dac-33ddb5f0399f",
                                                "sense_id": "89c14ee2-f242-3c6d-8755-f3c52cfebb8a",
                                                "text": "King’s video neuroqueers the dominant popular cultural image of autistic people always having great powers of visual memory by showing a different version of this."
                                            },
                                            {
                                                "example_id": "bfc9e54d-4b03-4f4b-8d94-2f3bf7d3172f",
                                                "sense_id": "89c14ee2-f242-3c6d-8755-f3c52cfebb8a",
                                                "text": "Listening to autistic narratives reveals possibilities for neuroqueering interpersonal communication theory."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
