{
    "word_family": [
        "prawda",
        "prawdziwy",
        "prawdomówny",
        "prawdziwie"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "8c162c58-5460-3d1f-ba16-001c3d6983b9",
                    "sense_definition": "słowo potwierdzające, że coś jest zgodne z prawdą lub rzeczywistością",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "potwierdzenie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Naprawdę</w> nie wiem, dlaczego nie ma dzisiaj Maćka w szkole.",
                            "target_lang_translations": {
                                "ru": "<w>Действительно</w> не знаю, почему Мачека сегодня нет в школе."
                            }
                        },
                        {
                            "text": "Czego tak <w>naprawdę</w> chcesz?",
                            "target_lang_translations": {
                                "ru": "Чего ты хочешь <w>на самом деле</w>?"
                            }
                        }
                    ],
                    "synonyms": [
                        "rzeczywiście",
                        "istotnie"
                    ],
                    "antonyms": [
                        "na niby"
                    ],
                    "common_phrases": [
                        "tak naprawdę"
                    ],
                    "target_lang_definitions": {
                        "ru": "слово, подтверждающее, что что-то соответствует истине или реальности"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "действительно",
                                "target_lang_sense_clarification": "используется для подтверждения факта или реальности события"
                            },
                            {
                                "target_lang_word": "на самом деле",
                                "target_lang_sense_clarification": "устойчивое выражение для подчеркивания истинного положения дел"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6525cff7-1e84-38d1-8784-09e773db1a86",
                    "sense_definition": "słowo używane do podkreślenia wysokiego stopnia jakiejś cechy",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "intensyfikator",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tu jest <w>naprawdę</w> pięknie!",
                            "target_lang_translations": {
                                "ru": "Здесь <w>действительно</w> красиво!"
                            }
                        },
                        {
                            "text": "To zadanie było <w>naprawdę</w> trudne dla wszystkich uczniów.",
                            "target_lang_translations": {
                                "ru": "Это задание было <w>по-настоящему</w> трудным для всех учеников."
                            }
                        }
                    ],
                    "synonyms": [
                        "doprawdy"
                    ],
                    "target_lang_definitions": {
                        "ru": "слово, используемое для усиления степени какого-либо качества или признака"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "действительно",
                                "target_lang_sense_clarification": "усиливает прилагательное, подчеркивая высокую степень качества"
                            },
                            {
                                "target_lang_word": "очень",
                                "target_lang_sense_clarification": "наиболее распространенный интенсификатор для выражения высокой степени"
                            },
                            {
                                "target_lang_word": "по-настоящему",
                                "target_lang_sense_clarification": "подчеркивает, что качество проявляется в полной мере"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "26b560c9-3bd6-3475-a4c5-d538e9baabc2",
                    "sense_definition": "słowo wyrażające zdziwienie lub niedowierzanie mówiącego",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "zdziwienie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Czy ty <w>naprawdę</w> sądziłeś, że mogłem tak postąpić?",
                            "target_lang_translations": {
                                "ru": "<w>Неужели</w> ты думал, что я мог так поступить?"
                            }
                        },
                        {
                            "text": "<w>Naprawdę</w> wygrałeś ten konkurs wczorajszego wieczoru?",
                            "target_lang_translations": {
                                "ru": "<w>Разве</w> ты выиграл этот конкурс вчера вечером?"
                            }
                        }
                    ],
                    "synonyms": [
                        "doprawdy"
                    ],
                    "target_lang_definitions": {
                        "ru": "слово, выражающее удивление или недоверие говорящего"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неужели",
                                "target_lang_sense_clarification": "выражает сильное удивление или сомнение в возможности чего-либо"
                            },
                            {
                                "target_lang_word": "разве",
                                "target_lang_sense_clarification": "используется в вопросах для выражения сомнения или удивления"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}