                    {
                        "translation_id": "df75c5ac-40a4-4e57-99e7-e0a423d5282d",
                        "source_entry_id": "7c3b48fa-7e26-36b3-a8ec-396b194c67cc",
                        "source_sense_id": "85858900-9894-351b-96f0-7d898b70a5d1",
                        "target_lang_word": "galaxy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "galaxy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a2b27bff-d30b-3936-bdf2-f4ba72ef9d7f",
                                        "entry_id": "84dd44e0-fe77-3281-9e8c-6fcee422d485",
                                        "glosses": [
                                            "The Milky Way; the apparent band of concentrated stars which appears in the night sky over earth."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9a4341d5-5339-4ba8-acc1-4652bd1e7d7d",
                                                "sense_id": "a2b27bff-d30b-3936-bdf2-f4ba72ef9d7f",
                                                "text": "So may thy cheekes red outweare scarlet dye, / And their white, whitenesse of the Galaxie [...]."
                                            },
                                            {
                                                "example_id": "6f04fe6e-7848-4cf2-ac50-3b1a74b80a55",
                                                "sense_id": "a2b27bff-d30b-3936-bdf2-f4ba72ef9d7f",
                                                "text": "Grecian imagination ascribed to the galaxy or milky way an origin in the teeming breast of the queen of heaven[.]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0082f97e-f96b-34bb-8269-e78701f63f8d",
                                        "entry_id": "84dd44e0-fe77-3281-9e8c-6fcee422d485",
                                        "glosses": [
                                            "Any of the collections of many millions or billions of stars, galactic dust, black holes, etc. existing as independent and coherent systems, of which there are billions in the known universe."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "105dc0a1-69e2-3ea2-ac22-4d4097e4e08c",
                                        "entry_id": "84dd44e0-fe77-3281-9e8c-6fcee422d485",
                                        "glosses": [
                                            "An assemblage of things or people seen as luminous or brilliant."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6c62f887-f5e6-4dfe-83ec-96f77eceeaed",
                                                "sense_id": "105dc0a1-69e2-3ea2-ac22-4d4097e4e08c",
                                                "text": "[a] galaxy of science fiction stars."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "de0b766b-86d7-3ddd-9a3b-adb249e8a423",
                                        "entry_id": "84dd44e0-fe77-3281-9e8c-6fcee422d485",
                                        "glosses": [
                                            "Any print or pattern reminiscent of a galaxy, generally consisting of blending, semiopaque patches of vibrant color on a dark background."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bdf8b941-a10f-43d7-b685-0a1506e49a0f",
                                                "sense_id": "de0b766b-86d7-3ddd-9a3b-adb249e8a423",
                                                "text": "Her walls and ceiling were covered with galaxy wallpaper; it was like stepping into space."
                                            },
                                            {
                                                "example_id": "9b4bfa4e-26d5-4a13-bb29-d26d073f0366",
                                                "sense_id": "de0b766b-86d7-3ddd-9a3b-adb249e8a423",
                                                "text": "Her nerdy glasses sat perched on her face, and she wore a May the Force Be With You T-shirt with a black lace skirt, galaxy leggings, and a pair of white Star Wars Vans."
                                            },
                                            {
                                                "example_id": "48aeb8f0-ebf0-4909-8ba4-d480547b5378",
                                                "sense_id": "de0b766b-86d7-3ddd-9a3b-adb249e8a423",
                                                "text": "She hurriedly said that she found an^([sic]) faded galaxy blanket. She loved galaxy patterned things."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "galaxy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cf53aff1-e019-30cd-9065-cfeaaabe3915",
                                        "entry_id": "869fd6b6-f02d-39b3-8b4d-ec7188fa8082",
                                        "glosses": [
                                            "To furnish with galaxies."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "51dc2c3a-82ae-466e-a831-8d1fad2cab32",
                                                "sense_id": "cf53aff1-e019-30cd-9065-cfeaaabe3915",
                                                "text": "[…] how he struggled at one time like a desperate man fiercly ^([sic]) grappling with his mortal foe, and at another like a sanguine lover and noble minded youth, as the cliffy rocks impeded his progress, or dimmed the view he had caught of an aperture, through which the galaxied firmament was seen in its purity and holiness glowing with diamonds and saphires; […]"
                                            },
                                            {
                                                "example_id": "74b114c8-faa6-4174-9329-9163b944861d",
                                                "sense_id": "cf53aff1-e019-30cd-9065-cfeaaabe3915",
                                                "text": "In dazzling light expands the mighty Dome: / Mirror of Heaven,—but Heaven when she doth wear / All galaxied with Stars her flashing hair!"
                                            },
                                            {
                                                "example_id": "dcdcb018-2516-4752-8edf-729fbfd1b50d",
                                                "sense_id": "cf53aff1-e019-30cd-9065-cfeaaabe3915",
                                                "text": "To be dwarfed in a galaxied sky, / doming, arcing, and revolving over / The little space I briefly occupy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3be90333-6aa5-3934-9bb2-e67b5d4fe434",
                                        "entry_id": "869fd6b6-f02d-39b3-8b4d-ec7188fa8082",
                                        "glosses": [
                                            "To gather together into a luminous whole."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c99dfec3-ddee-47c5-96ac-b752ff840dd6",
                                                "sense_id": "3be90333-6aa5-3934-9bb2-e67b5d4fe434",
                                                "text": "Let all their Vertues then be Galaxied into this one Indiſtinct Luſtre, they vvere Faithful Servants of Chriſt, and Sufferers for their being ſo."
                                            },
                                            {
                                                "example_id": "700227d2-a081-4b2b-bb4f-23b33e978fe2",
                                                "sense_id": "3be90333-6aa5-3934-9bb2-e67b5d4fe434",
                                                "text": "The brilliancies on one page of Lalla Roohk ^([sic]) would have sufficed to establish that very reputation which has been in a great measure self-dimned by the galaxied lustre of the entire book."
                                            },
                                            {
                                                "example_id": "6606c0d8-fdf0-4d00-b137-3884710c69bc",
                                                "sense_id": "3be90333-6aa5-3934-9bb2-e67b5d4fe434",
                                                "text": "How dazzling must their brightness be when they are galaxied in a single bosom!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2d01f8c5-0ada-403c-9ce2-5283ba7ee7d0",
                        "source_entry_id": "7c3b48fa-7e26-36b3-a8ec-396b194c67cc",
                        "source_sense_id": "85858900-9894-351b-96f0-7d898b70a5d1",
                        "target_lang_word": "star system",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "star system",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3e62fc26-9ede-35e2-bd06-48ff58d5b52e",
                                        "entry_id": "68a6ec8c-7708-3bc4-84c7-1805945aefd8",
                                        "glosses": [
                                            "A group of stars (and possibly smaller bodies such as planets or asteroids) that orbit one another."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e7e7a845-bdbe-3fcf-ab06-4625d0b72e84",
                                        "entry_id": "68a6ec8c-7708-3bc4-84c7-1805945aefd8",
                                        "glosses": [
                                            "A method of creating, promoting and exploiting movie stars in cinema, emphasizing on their images rather than acting."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c7bff120-2485-440b-864b-122648ebd38e",
                                                "sense_id": "e7e7a845-bdbe-3fcf-ab06-4625d0b72e84",
                                                "text": "Chapters have examined the general structural trends that have defined particular phases in the organisation of the star system, looking at the conditions in which the system emerged, how the studios controlled the ownership of star images, and the power of the star in contemporary Hollywood."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "48c2acb1-9696-4e00-a0e0-423768e6a0e1",
                        "source_entry_id": "7c3b48fa-7e26-36b3-a8ec-396b194c67cc",
                        "source_sense_id": "85858900-9894-351b-96f0-7d898b70a5d1",
                        "target_lang_word": "galaxie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "galaxie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ee75e7f3-6f83-305a-b73d-e2c17d8a143c",
                                        "entry_id": "974dd29e-3203-3cda-8a7c-520693504d43",
                                        "glosses": [
                                            "Ensemble d’étoiles et de matières diffuses constituant un système stellaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a8b42e48-e067-47ef-ba68-2a0e7bf55de2",
                                                "sense_id": "ee75e7f3-6f83-305a-b73d-e2c17d8a143c",
                                                "text": "Tentons de saisir l’énormité des distances impliquées. Il y a environ 200 milliards d’étoiles dans notre galaxie qui a un diamètre de 100 000 années-lumière."
                                            },
                                            {
                                                "example_id": "bdf6a74d-aa57-4ac1-8e2d-e05aa57116ab",
                                                "sense_id": "ee75e7f3-6f83-305a-b73d-e2c17d8a143c",
                                                "text": "Une galaxie spirale barrée est une galaxie spirale dont les bras spiraux n’émergent pas du centre de la galaxie, mais d’une barre constituée d’étoiles traversant ce centre. Comme elle n’appartient à aucun amas ni à un groupe de galaxies, elle est considérée comme gravitationnellement isolée. Il s’agit donc d’une galaxie spirale barrée isolée."
                                            },
                                            {
                                                "example_id": "2e08140e-485f-4656-96b9-859cfa61019d",
                                                "sense_id": "ee75e7f3-6f83-305a-b73d-e2c17d8a143c",
                                                "text": "La galaxie d’Andromède."
                                            },
                                            {
                                                "example_id": "311a3023-d2c9-4412-bf97-6b593ec539b2",
                                                "sense_id": "ee75e7f3-6f83-305a-b73d-e2c17d8a143c",
                                                "text": "NGC 1291 est une galaxie lenticulaire située dans la constellation d’Eridan."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e0b78c15-184d-35c5-ac65-f0e9c6a197dc",
                                        "entry_id": "974dd29e-3203-3cda-8a7c-520693504d43",
                                        "glosses": [
                                            "Ensemble d’étoiles, de gaz et de poussières interstellaires, dont fait partie le Soleil, et qui, observé depuis la Terre, présente l’aspect d’une traînée brillante, appelée Voie lactée."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c71045fe-7cab-3db2-a9ef-5ac1ef4bccf7",
                                        "entry_id": "974dd29e-3203-3cda-8a7c-520693504d43",
                                        "glosses": [
                                            "Terme servant à identifier comme un groupe un ensemble d’entités dont le nombre est considérable et aux frontières peu précises."
