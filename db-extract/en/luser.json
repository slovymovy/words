                "senses": [
                    {
                        "sense_id": "740df3c5-c85d-30ed-9ba5-a8cf4a10254a",
                        "entry_id": "cc82a61b-f571-3ed1-9d8c-cd530b253f8e",
                        "glosses": [
                            "An incompetent computer user."
                        ],
                        "tags": [
                            "derogatory",
                            "slang"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "2cb3f0af-286a-3350-84c8-848e717d8950",
                        "entry_id": "cc82a61b-f571-3ed1-9d8c-cd530b253f8e",
                        "glosses": [
                            "A user (especially in IRC) who disobeys the rules of the servers that they are using and usually resorts to disruptive or offensive behavior."
                        ],
                        "tags": [
                            "derogatory",
                            "slang"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "634385cd-2826-4e70-a6d0-009b736dbef3",
                        "source_entry_id": "cc82a61b-f571-3ed1-9d8c-cd530b253f8e",
                        "source_sense_description": "incompetent computer user",
                        "target_lang_word": "boulet",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "boulet",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1e97d414-18d2-3fea-b039-b78cd63a91d1",
                                        "entry_id": "6d9cc7f9-e548-3941-8e2f-4cfa52d21dc9",
                                        "glosses": [
                                            "Boule de pierre ou de métal fondu, de différentes grosseurs, dont on chargeait les canons."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "150db0f2-24c0-4d89-9101-196b632abca5",
                                                "sense_id": "1e97d414-18d2-3fea-b039-b78cd63a91d1",
                                                "text": "Presque aussitôt, une détonation plus violente se fit entendre, un éclatant jet de vapeur fusa des flancs du brick, et un boulet, frappant le haut des roches qui abritaient Ayrton et Pencroff, les fit voler en éclats, mais les deux tireurs n’avaient pas été touchés."
                                            },
                                            {
                                                "example_id": "23e766c7-eaa4-4e46-8626-8af27a358ad9",
                                                "sense_id": "1e97d414-18d2-3fea-b039-b78cd63a91d1",
                                                "text": "Et, au même instant, je me ressouvins que les boulets et la poudre à canon étaient restés à bord, et d’un coup de hache mettrait le tout à la disposition des scélérats."
                                            },
                                            {
                                                "example_id": "e43bf4d1-523b-4473-ac02-dbc757f8c806",
                                                "sense_id": "1e97d414-18d2-3fea-b039-b78cd63a91d1",
                                                "text": "Les artilleurs savent qu’en donnant à un boulet une vitesse double, son pouvoir de pénétration ou énergie deviendra presque quadruple."
                                            },
                                            {
                                                "example_id": "91f5f312-9ce4-4557-8979-70933eea0703",
                                                "sense_id": "1e97d414-18d2-3fea-b039-b78cd63a91d1",
                                                "text": "C’est pour monsieur Fialin et pour monsieur Mocquart,\nQue Lannes d’un boulet eut la cuisse coupée,"
                                            },
                                            {
                                                "example_id": "e6f342e3-1a11-4815-a889-f802d68199b6",
                                                "sense_id": "1e97d414-18d2-3fea-b039-b78cd63a91d1",
                                                "text": "[…] ; et par un hasard, qui fut accepté alors comme le plus heureux présage, en me débattant pendant la cérémonie, je passai ma petite tête dans un trou de boulet que le pavillon qui nous servait de lange avait reçu dans un combat mémorable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e4a94109-c6f9-3645-a0a9-257f08aead6d",
                                        "entry_id": "6d9cc7f9-e548-3941-8e2f-4cfa52d21dc9",
                                        "glosses": [
                                            "Boule de métal que l’on attachait au pied des forçats."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12d466e2-b0b1-4b4c-b176-f4f3bcdc038b",
                                                "sense_id": "e4a94109-c6f9-3645-a0a9-257f08aead6d",
                                                "text": "Quoi ! ce royal croquant, ce maraud couronné,\nQui, d’un boulet de quatre à la cheville orné,\nDevrait dans un ponton pourrir à fond de cale,"
                                            },
                                            {
                                                "example_id": "f529b116-5731-4baa-99a2-ef4f65992fc0",
                                                "sense_id": "e4a94109-c6f9-3645-a0a9-257f08aead6d",
                                                "text": "On dirait qu’il traîne rivé à ses chevilles un boulet, ou plutôt le souvenir d’un boulet… Est-ce le bagne qu’il rappelle ou le couvent?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a269def0-c6f0-3a57-875b-adddfb01a113",
                                        "entry_id": "6d9cc7f9-e548-3941-8e2f-4cfa52d21dc9",
                                        "glosses": [
                                            "Ce que l'on doit supporter."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "18721e5e-80dc-4400-9d45-24498e6d92a7",
                                                "sense_id": "a269def0-c6f0-3a57-875b-adddfb01a113",
                                                "text": "Ce pestiféré traîne partout avec lui comme autant de boulets son « quotidien », sa T.S.F., son « ciné », sa voiture à pétrole, sa terreur panique du silence et de la solitude, sa nervosité moutonnière, son imbécile respect de la mode, son amour du toc et ses papiers gras."
                                            },
                                            {
                                                "example_id": "87e92bcb-62a3-450b-bde8-51b75872da5a",
                                                "sense_id": "a269def0-c6f0-3a57-875b-adddfb01a113",
                                                "text": "La dame qui s'appelle Sonia m'a informé deux secondes auparavant du boulet qu'elle se trimbale, elle est du clan des Proches, deux frères touchés-coulés par la maladie honteuse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c325c666-02de-353d-97b0-1e54cdef7b52",
                                        "entry_id": "6d9cc7f9-e548-3941-8e2f-4cfa52d21dc9",
                                        "glosses": [
                                            "Aggloméré de charbon de forme arrondie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a75b311-be3f-49a2-ab94-b554f8fd91d0",
                                                "sense_id": "c325c666-02de-353d-97b0-1e54cdef7b52",
                                                "text": "Dans la salle à manger du premier étage, Hector Loursat présentait son dos rond à la cheminée, où des boulets brûlaient sur une grille en répandant une fumée jaunâtre."
                                            },
                                            {
                                                "example_id": "89ced542-9753-4c86-bc1a-c23e8fe406b8",
                                                "sense_id": "c325c666-02de-353d-97b0-1e54cdef7b52",
                                                "text": "Quelques minutes plus tard, les ligots ronflaient sous une pelletée de boulets, et je passai dans un salle pour mettre en torche un vieux numéro du Courrier de l’Ouest : l’assemblage de margotins et de bûchettes, préparé d’avance, pétilla sec et je m’assis en tailleur devant un rideau de jeunes flammes qui n’avaient aucun besoin de soufflet."
                                            },
                                            {
                                                "example_id": "f8bdc5d5-be23-4c3c-91aa-3d6212dc93ee",
                                                "sense_id": "c325c666-02de-353d-97b0-1e54cdef7b52",
                                                "text": "Il faut remplir les sacs de charbon de cinquante kilos sur la bascule en tenant compte des différentes qualités : anthracite, flambant, tête de moineau, boulet, une quinzaine de variétés au moins, et charger la voiture à bras."
                                            },
                                            {
                                                "example_id": "f24f20d9-2cb6-4bfb-a854-9f02cbbbcac1",
                                                "sense_id": "c325c666-02de-353d-97b0-1e54cdef7b52",
                                                "text": "Briquettes ou boulets, ou bien encore en vrac. Le tas de charbon voisine avec le tas de pommes de terre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "57e950f9-4be2-3303-b7bc-ffb6370b9990",
                                        "entry_id": "6d9cc7f9-e548-3941-8e2f-4cfa52d21dc9",
                                        "glosses": [
                                            "Articulation du canon avec le paturon dans le membre (« jambe ») d’un cheval."
                                        ],
                                        "tags": [
                                            "Hippologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "990d9733-9536-40a5-b985-0186c89c3288",
                                                "sense_id": "57e950f9-4be2-3303-b7bc-ffb6370b9990",
                                                "text": "Un cheval blessé au boulet."
                                            },
                                            {
                                                "example_id": "607f1c00-0c1f-4e41-895f-f39f9748a118",
                                                "sense_id": "57e950f9-4be2-3303-b7bc-ffb6370b9990",
                                                "text": "Campés devant elles, ils les examinaient aussi avec les regards et les gestes d’amateurs qui, en arrêt devant un cheval, l’étudient solennellement, dessinent dans l’air, avec le doigt, l’élégante croupe et palpent le boulet comme s’ils lui tâtaient le pouls."
                                            },
                                            {
                                                "example_id": "b94cea84-706c-4585-9d05-79a25d93a3b0",
                                                "sense_id": "57e950f9-4be2-3303-b7bc-ffb6370b9990",
                                                "text": "Un morceau de peau avait été arraché aux abords du boulet par le frottement contre le bois. La chair à vif saignait un peu. Il n’y avait pas d’autre dommage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7b1d632a-0cfc-37f5-b5ab-b22d9768b610",
                                        "entry_id": "6d9cc7f9-e548-3941-8e2f-4cfa52d21dc9",
                                        "glosses": [
                                            "Dans le pays de Liège, sorte de boulette de viande servie en sauce."
                                        ],
                                        "tags": [
                                            "Belgique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d3b4ecc6-9d8f-4c6b-9e38-259008e92d41",
                                                "sense_id": "7b1d632a-0cfc-37f5-b5ab-b22d9768b610",
                                                "text": "Georges commanda un boudin et Marthe un boulet avec des frites."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "19348e56-ac72-358f-bad2-fc81ca5e08b6",
                                        "entry_id": "6d9cc7f9-e548-3941-8e2f-4cfa52d21dc9",
                                        "glosses": [
                                            "Personne inutile, qui empêche d’avancer, souvent utilisé de manière injurieuse."
                                        ],
                                        "tags": [
                                            "metonymically",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "74df329d-2313-4979-a490-d2a8f9c699a9",
                                                "sense_id": "19348e56-ac72-358f-bad2-fc81ca5e08b6",
                                                "text": "Et me voilà comme un con, avec un constat : mon fils aîné, que j’aime énormément, est un boulet pour les gens qui s’occupent de lui."
                                            },
                                            {
                                                "example_id": "07819940-dfa6-4db9-862d-efa22f24ba50",
                                                "sense_id": "19348e56-ac72-358f-bad2-fc81ca5e08b6",
                                                "text": "J’étais une grande sportive, j’étais classée au tennis. Je vis près des montagnes, je ne peux que les regarder. Je ne peux plus faire de rando ni de vélo. Pourtant, je suis pas mal. Mais comment voulez-vous que je refasse ma vie ? Je suis un boulet."
                                            },
                                            {
                                                "example_id": "386a870f-0453-4061-91ad-789a797e8214",
                                                "sense_id": "19348e56-ac72-358f-bad2-fc81ca5e08b6",
                                                "text": "Si Trump a été utile pendant les primaires de 2016 et que sa présidence a permis aux conservateurs d’asseoir leur contrôle sur la Cour suprême pour quelques décennies, il est devenu un boulet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f2dd58ca-d197-3e4a-8b40-84fd7794420f",
                                        "entry_id": "6d9cc7f9-e548-3941-8e2f-4cfa52d21dc9",
                                        "glosses": [
                                            "Personne idiote, gaffeuse, qui commet des boulettes."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1c7f6818-bf70-4766-9280-01a0b8e8e252",
                                                "sense_id": "f2dd58ca-d197-3e4a-8b40-84fd7794420f",
                                                "text": "Ce boulet, au lieu de se dissimuler derrière sa gova. Il l'avait garée, en warning."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "06ce547d-6114-3e60-aaa3-963cdccef8c5",
                                        "entry_id": "6d9cc7f9-e548-3941-8e2f-4cfa52d21dc9",
                                        "glosses": [
                                            "Synonyme de griffon boulet (race de chien)."
                                        ],
                                        "tags": [
                                            "Zootechnie"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ae146338-6c67-3922-9595-79131824a059",
                                        "entry_id": "6d9cc7f9-e548-3941-8e2f-4cfa52d21dc9",
                                        "glosses": [
                                            "Boule de pierre, de verre ou de métal, d’une taille plus grande que celle de la bille, qui sert à des jeux d’enfants."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3f4ebcb-616e-4421-b9ef-262acf5c3ea0",
                                                "sense_id": "ae146338-6c67-3922-9595-79131824a059",
                                                "text": "Je pense que le père Voie a été petit, a joué aux billes et au boulet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "30990765-4b78-355a-bf92-7f9014dfe294",
                                        "entry_id": "6d9cc7f9-e548-3941-8e2f-4cfa52d21dc9",
                                        "glosses": [
                                            "Tir très puissant."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "Hockey"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0bc3e743-d819-4232-a8a3-01c437439abc",
                                                "sense_id": "30990765-4b78-355a-bf92-7f9014dfe294",
                                                "text": "Subban a créé l'égalité 1-1 en touchant la cible grâce à un boulet de la ligne bleue en avantage numérique."
                                            },
                                            {
                                                "example_id": "46b15c01-e9a9-4b84-991d-052ef48a0e88",
                                                "sense_id": "30990765-4b78-355a-bf92-7f9014dfe294",
                                                "text": "Tavares a rapidement mis fin au débat, s’emparant du disque en zone neutre avant d’entrer en zone autrichienne et décocher un boulet qui a déjoué David Madlener."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
