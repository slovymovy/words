{
    "word_family": [
        "beaked"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f3fbed2d-c38f-30c1-afaf-2a93835d4427",
                    "sense_definition": "A rigid structure projecting from the front of a bird's face, used for pecking, grooming, foraging, and eating.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "animal_anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The eagle used its sharp <w>beak</w> to tear the food into smaller pieces.",
                            "target_lang_translations": {
                                "zh": "老鹰用它锋利的<w>喙</w>把食物撕成小块。"
                            }
                        },
                        {
                            "text": "The bird cleaned its <w>beak</w> after finishing its meal.",
                            "target_lang_translations": {
                                "zh": "鸟儿吃完饭后清理了一下自己的<w>嘴</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "bill"
                    ],
                    "common_phrases": [
                        "sharp beak"
                    ],
                    "target_lang_definitions": {
                        "zh": "鸟类面部前方突出的坚硬结构，用于啄食、梳理羽毛、觅食和进食。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "嘴",
                                "target_lang_sense_clarification": "指鸟类的喙，最常用的说法。"
                            },
                            {
                                "target_lang_word": "喙",
                                "target_lang_sense_clarification": "指鸟类的嘴，书面语或生物学用语。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "385ccbbf-5859-3935-9542-faf2e7a6bb95",
                    "sense_definition": "A person's nose, especially one that is large and pointed.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "human_anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He has a very prominent <w>beak</w> that makes him look quite serious.",
                            "target_lang_translations": {
                                "zh": "他长着一个非常突出的<w>鹰钩鼻</w>，这让他看起来很严肃。"
                            }
                        },
                        {
                            "text": "She poked her <w>beak</w> into the room to see what was happening.",
                            "target_lang_translations": {
                                "zh": "她把<w>鼻子</w>探进房间，想看看发生了什么。"
                            }
                        }
                    ],
                    "synonyms": [
                        "schnozzle",
                        "honker"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Often used in a slightly derogatory or humorous way."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "指人的鼻子，尤指又大又尖的鼻子。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "鹰钩鼻",
                                "target_lang_sense_clarification": "形容像鸟喙一样弯曲且突出的鼻子。"
                            },
                            {
                                "target_lang_word": "大鼻子",
                                "target_lang_sense_clarification": "口语中对大鼻子的戏称。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "915a6380-8429-3a81-9894-20ca89ef8766",
                    "sense_definition": "A person's mouth.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "human_anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The angry man told his friend to shut his <w>beak</w> and listen.",
                            "target_lang_translations": {
                                "zh": "那个愤怒的男人叫他的朋友闭上<w>嘴</w>听着。"
                            }
                        },
                        {
                            "text": "He opened his <w>beak</w> to speak but decided to stay silent instead.",
                            "target_lang_translations": {
                                "zh": "他张开<w>嘴</w>想说话，但最终决定保持沉默。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "shut your beak"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Informal and sometimes rude."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "指人的嘴巴（俚语，有时带有粗鲁意味）。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "嘴巴",
                                "target_lang_sense_clarification": "指人的口部，此处用于比喻。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4361996d-97c0-3c59-bf3e-dd7b7d0ae293",
                    "sense_definition": "Cocaine.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "substance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police found evidence of <w>beak</w> during the raid on the apartment.",
                            "target_lang_translations": {
                                "zh": "警方在突袭公寓时发现了<w>可卡因</w>的证据。"
                            }
                        },
                        {
                            "text": "He struggled with an addiction to <w>beak</w> for several years.",
                            "target_lang_translations": {
                                "zh": "他与<w>可卡因</w>成瘾斗争了好几年。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Drug-related slang."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "可卡因（毒品俚语）。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "可卡因",
                                "target_lang_sense_clarification": "毒品名称。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "dd54cb94-9fb4-3a75-bd92-f52e0cc6e023",
                    "sense_definition": "A justice of the peace or a magistrate.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "legal_title",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The young man had to appear before the <w>beak</w> for his minor traffic violation.",
                            "target_lang_translations": {
                                "zh": "那个年轻人因轻微交通违规不得不出庭面对<w>地方法官</w>。"
                            }
                        },
                        {
                            "text": "The local <w>beak</w> was known for being very strict with repeat offenders.",
                            "target_lang_translations": {
                                "zh": "当地的<w>地方法官</w>以对累犯非常严厉而闻名。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "British English, dated."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "治安法官或地方法官（英国旧时俚语）。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "地方法官",
                                "target_lang_sense_clarification": "负责处理轻微案件的法官。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "18b27b04-79ad-3e5a-b1b0-22a1bfc760fe",
                    "sense_definition": "To play truant or skip school without permission.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "school_behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was caught <w>beaking</w> school to go to the cinema with his friends.",
                            "target_lang_translations": {
                                "zh": "他因为<w>逃学</w>去和朋友看电影而被抓住了。"
                            }
                        },
                        {
                            "text": "Many students <w>beaked</w> class on the last day before the holidays.",
                            "target_lang_translations": {
                                "zh": "许多学生在假期前的最后一天<w>旷课</w>了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "skip",
                        "ditch",
                        "play truant"
                    ],
                    "common_phrases": [
                        "beaking school"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "British English."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "逃学或旷课（英国俚语）。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "逃学",
                                "target_lang_sense_clarification": "指无故缺席学校课程。"
                            },
                            {
                                "target_lang_word": "旷课",
                                "target_lang_sense_clarification": "指未请假而缺席课程。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}