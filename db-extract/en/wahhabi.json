                    }
                ],
                "senses": [
                    {
                        "sense_id": "b68e4b0a-8f4f-375e-a246-ffad8e284c7c",
                        "entry_id": "44d8da85-cd88-36af-b0c1-1e5169530cf7",
                        "glosses": [
                            "An adherent of Wahhabism (Sunni Islamic fundamentalist reform movement)."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7912b46a-a54c-40a4-98d6-c531628d45ac",
                        "source_entry_id": "44d8da85-cd88-36af-b0c1-1e5169530cf7",
                        "source_sense_id": "b68e4b0a-8f4f-375e-a246-ffad8e284c7c",
                        "source_sense_description": "adherent of Wahhabism",
                        "target_lang_word": "Wahhabit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wahhabit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "41d9e9af-a9ab-3369-9ede-e35bf1afc5a0",
                                        "entry_id": "7c3316c5-7d8c-3ca8-9f2c-9d1c2e422c49",
                                        "glosses": [
                                            "Angehöriger einer (seit dem 18. Jahrhundert besonders auf der Arabischen Halbinsel verbreiteten) sittenstrengen sunnitisch-hanbalitischen Reformsekte"
                                        ],
                                        "tags": [
                                            "islamische Religion"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bee34c46-062e-46e2-ae66-1ee9f77bb469",
                                                "sense_id": "41d9e9af-a9ab-3369-9ede-e35bf1afc5a0",
                                                "text": "„Die Bewegung der Wahhabiten ist benannt nach ihrem Gründer Muhammad ibn Abd al-Wahhab, der seit etwa 1730 auf der arabischen Halbinsel wirkte. Die Bewegung wird von der Al-Saud-Familie unterstützt und zeichnet sich durch einen extremen Glaubenseifer aus. In Kuwait ist ‚Wahhabiten‘ ein abwertender Begriff.“"
                                            },
                                            {
                                                "example_id": "c8f2fe9c-6a13-414a-87c0-8408ce4266fe",
                                                "sense_id": "41d9e9af-a9ab-3369-9ede-e35bf1afc5a0",
                                                "text": "„Valentina Melnikowa sieht es ebenso: ‚Wir haben es mit einer Instrumentalisierung der Religion zu tun. Seit 1999 beschuldigt der Kreml Wahhabiten und Fundamentalisten, um die wahren Täter zu decken.[…]‘“"
                                            },
                                            {
                                                "example_id": "d8348445-cb93-432c-804d-e0e704cc9305",
                                                "sense_id": "41d9e9af-a9ab-3369-9ede-e35bf1afc5a0",
                                                "text": "„Unter deren Kämpfern, die in einem asymmetrischen Konflikt zunehmend das lukrative ‚Geschäft‘ mit Geiseln betrieben, kursierte das Militärhandbuch des Wahhabiten Tagajew ‚Die aufständische Imamarmee‘, in welchem die Schaffung eines einheitlichen muslimischen Staates Nordkaukasus und die vollständige Vertreibung der dortigen russischen Bevölkerung propagiert wurde.“"
                                            },
                                            {
                                                "example_id": "c1dfc19a-169f-4ebe-99e3-23e8827dd765",
                                                "sense_id": "41d9e9af-a9ab-3369-9ede-e35bf1afc5a0",
                                                "text": "„Welches sind die wirksamsten Gegner von Putins Schergen? Das sind die (jordanischen, saudiarabischen, türkischen und tschetschenischen) Wahhabiten von Schamil Basajew, der die Stellungen der Boiviki kommandiert, die sich in den Bergen im Süden eingenistet haben. Sind die Wahhabiten Befreier? Sollte es geschehen, dass sie in Grosny an die Macht kommen, würde das tschetschenische Volk unter das Joch einer fürchterlichen Theokratie geraten.“"
                                            },
                                            {
                                                "example_id": "de05c2f7-82f4-41bd-9bde-28bed841864e",
                                                "sense_id": "41d9e9af-a9ab-3369-9ede-e35bf1afc5a0",
                                                "text": "„Ich denke dabei zum Beispiel an den saudischen Autor Abdallah Al-Qassimi, der, ich glaube 1996 in Ägypten gestorben ist. Er benützt teilweise Nietzsches Wendungen und wendet sie gegen die arabische und islamische Realität an. Der Unterschied zu Nietzsche liegt darin, dass er selbst ein Prediger, ein Wahhabit, ein Religionsprediger war.“"
                                            },
                                            {
                                                "example_id": "2b9cf0ac-ccb2-4992-8140-569c8730a11a",
                                                "sense_id": "41d9e9af-a9ab-3369-9ede-e35bf1afc5a0",
                                                "text": "„Gultasab erzählte, wie er zum ersten Mal bemerkte, dass sein Bruder Wahhabit geworden war.“"
                                            },
                                            {
                                                "example_id": "839b128d-f80b-41b9-91bd-a75f7d0960ab",
                                                "sense_id": "41d9e9af-a9ab-3369-9ede-e35bf1afc5a0",
                                                "text": "„Die Salafisten widmen sich, wie die saudischen Wahhabiten, dem idschtihad (dem Studium des Koran und der Quellen der Sunna, um ein eigenes Urteil zu gewinnen).“"
                                            },
                                            {
                                                "example_id": "6469fb45-64c2-46b6-943d-7cdfc5be4edd",
                                                "sense_id": "41d9e9af-a9ab-3369-9ede-e35bf1afc5a0",
                                                "text": "„In den letzten Jahren ist der Widerstand gegen die Wahhabiten in Bosnien gewachsen.“"
                                            },
                                            {
                                                "example_id": "3302cb55-2a38-4c5a-84bc-c1fb3fb0c19a",
                                                "sense_id": "41d9e9af-a9ab-3369-9ede-e35bf1afc5a0",
                                                "text": "„Diesen differenziert gezeichneten muslimischen Frauen, die für die moderne Eigenständigkeit gerüstet sind, stellt Jasmila Zbanic jene Frauen gegenüber, die nach den Regeln der Wahhabiten leben.“"
                                            },
                                            {
                                                "example_id": "1e7c1cd2-96b6-4b5c-b0db-82cd6b6c1982",
                                                "sense_id": "41d9e9af-a9ab-3369-9ede-e35bf1afc5a0",
                                                "text": "„Dann spricht er über die Wahhabiten, die Muslim-Bruderschaft und die Unterwanderung des Reform-Islam durch den Wahhabismus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
