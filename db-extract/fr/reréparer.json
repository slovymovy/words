                        "tags": [],
                        "examples": [
                            {
                                "example_id": "93d9753e-35fb-41b2-9b83-3eb435993596",
                                "sense_id": "3670e339-d1d4-359d-8e42-d68cb16a1396",
                                "text": "Bon, on a réussi à reréparer tout ça, avec des coins de métal, des cales etc..."
                            },
                            {
                                "example_id": "6c745079-644e-44ef-acd5-000dd97f8ddd",
                                "sense_id": "3670e339-d1d4-359d-8e42-d68cb16a1396",
                                "text": "Ma seule solution est donc de réparer ma connexion, de me relancer sur metaboli, attendre que ça recoupe, resauvegarder, reréparer, etc."
                            },
                            {
                                "example_id": "544b69df-5715-463b-9eaf-992c709a887f",
                                "sense_id": "3670e339-d1d4-359d-8e42-d68cb16a1396",
                                "text": "Les préparateurs de Nouvelle-Calédonie ont de nouveau perdu des heures de sommeil à reréparer leur bateau blessé."
                            }
                        ]
                    }
