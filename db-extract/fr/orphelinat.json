                "senses": [
                    {
                        "sense_id": "6cc59566-bcac-3de3-8bca-09fc6123f86f",
                        "entry_id": "bf14812b-d1b8-312b-899d-5d53121c4761",
                        "glosses": [
                            "Établissement charitable destiné à élever des orphelins."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7de7912d-db7b-45b0-b095-38eea3bbd2b8",
                                "sense_id": "6cc59566-bcac-3de3-8bca-09fc6123f86f",
                                "text": "À l’orphelinat, elle avait appris à coudre, à faire le ménage."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d39075e7-3769-4831-94e7-843319ccf023",
                        "source_entry_id": "bf14812b-d1b8-312b-899d-5d53121c4761",
                        "source_sense_id": "6cc59566-bcac-3de3-8bca-09fc6123f86f",
                        "source_sense_description": "Établissement destiné à élever des orphelins.",
                        "target_lang_word": "Waisenhaus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Waisenhaus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "af744c9b-9a07-31a0-bbf1-01643bf506c3",
                                        "entry_id": "c9534063-8dd4-313e-8fd5-4b1f78b84c88",
                                        "glosses": [
                                            "Heim für elternlose Kinder"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2130193f-6e70-4169-a9ba-9d8fc29ba657",
                                                "sense_id": "af744c9b-9a07-31a0-bbf1-01643bf506c3",
                                                "text": "Der Junge wurde in einem Waisenhaus untergebracht."
                                            },
                                            {
                                                "example_id": "b4bdcbbf-7856-4c9d-ad91-0e767b64e386",
                                                "sense_id": "af744c9b-9a07-31a0-bbf1-01643bf506c3",
                                                "text": "„Später zog das Waisenhaus in ein größeres Gebäude in der Bolschaja Shitomirskaja, damals noch Uliza Lwowskaja.“"
                                            },
                                            {
                                                "example_id": "5a7be4f1-ae3e-4cb5-901a-8b13e945f5cc",
                                                "sense_id": "af744c9b-9a07-31a0-bbf1-01643bf506c3",
                                                "text": "„Dort muss er zwei Wochen behandelt werden, bevor er in ein Waisenhaus kommt.“"
                                            },
                                            {
                                                "example_id": "48797220-ba78-41fb-a6c5-b1bdc047c69c",
                                                "sense_id": "af744c9b-9a07-31a0-bbf1-01643bf506c3",
                                                "text": "„Joe war hauptsächlich im Waisenhaus aufgewachsen und daher immer von anderen Kindern umgeben gewesen, mehr als die meisten anderen Menschen.“"
                                            },
                                            {
                                                "example_id": "6d747509-e259-44f9-af1f-1bede5a31bbf",
                                                "sense_id": "af744c9b-9a07-31a0-bbf1-01643bf506c3",
                                                "text": "„Wir kamen an einem verlassenen Gebäude vorbei, das Linus als Waisenhaus identifizierte, und einigen weiteren, die wie Pferche aussahen, von denen er aber sagte, es seien Kindergärten, die auf Spendenbasis arbeiteten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c39d4313-ee25-4431-ae36-54d889d040be",
                        "source_entry_id": "bf14812b-d1b8-312b-899d-5d53121c4761",
                        "source_sense_id": "6cc59566-bcac-3de3-8bca-09fc6123f86f",
                        "source_sense_description": "Établissement destiné à élever des orphelins.",
                        "target_lang_word": "Kinderheim",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kinderheim",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "14385727-b80d-3abe-8de8-7c3d7a643404",
                                        "entry_id": "2dd64f7f-2c94-3650-8294-7e9c501c7b98",
                                        "glosses": [
                                            "eine Einrichtung, in der Kinder untergebracht werden, die nicht bei ihrer Familie leben können"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e751a972-d371-4075-b7ff-4b482e8bde12",
                                                "sense_id": "14385727-b80d-3abe-8de8-7c3d7a643404",
                                                "text": "Das Kinderheim ist glücklicherweise nicht voll ausgelastet."
                                            },
                                            {
                                                "example_id": "3372e279-d9cf-456b-893c-fde976528aa1",
                                                "sense_id": "14385727-b80d-3abe-8de8-7c3d7a643404",
                                                "text": "„Alle arbeitenden Frauen ziehen in die Hamburger, die Beamten aus der Hamburger in die »Sonne« (ehemaliges Hotel), Mütter mit Säuglingen ins Säuglingsheim, Kinder ins Kriechlingsheim und ins Kinderheim, größere Mädchen ins Mädchenheim, die Jungen ins Jungenheim und ins Lehrlingsheim.“"
                                            },
                                            {
                                                "example_id": "e111aafc-9a89-428d-bf35-79c3ef61cbb9",
                                                "sense_id": "14385727-b80d-3abe-8de8-7c3d7a643404",
                                                "text": "„Im Herbst werden sie und die beiden Brüder in eines der wenigen russischen Kinderheime der Oblast in der Elchniederung gebracht.“"
                                            },
                                            {
                                                "example_id": "8063b6e0-67c1-4008-8c2c-da25537c9a46",
                                                "sense_id": "14385727-b80d-3abe-8de8-7c3d7a643404",
                                                "text": "„Das Gutshaus in Klenzin, das seit zehn Jahren leerstand, soll ein Kinderheim aufnehmen.“"
                                            },
                                            {
                                                "example_id": "f02cee83-226c-477b-975f-391465a31595",
                                                "sense_id": "14385727-b80d-3abe-8de8-7c3d7a643404",
                                                "text": "„Mit vier Jahren war er in das katholische Kinderheim gekommen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
