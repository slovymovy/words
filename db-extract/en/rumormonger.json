                        "examples": [
                            {
                                "example_id": "02257d24-a70a-4d23-9371-03fbe7997589",
                                "sense_id": "9ddac929-75e3-3206-a8ec-406e934e465b",
                                "text": "Near-synonyms: gossipmonger, newsmonger, scandalmonger; blabbermouth, talebearer, telltale; gossip, gossiper; see also Thesaurus:gossiper"
                            },
                            {
                                "example_id": "1b918743-77ba-476d-b475-543e2f802602",
                                "sense_id": "9ddac929-75e3-3206-a8ec-406e934e465b",
                                "text": "Then the Seventh moved to Fort Ord and practiced—although without full equipment—amphibious landings. The hot poop of the rumor mongers became, “Southwest Pacific for us, fellows.” But when the convoy sailed from San Francisco on April twenty-fourth, the ships turned north."
                            }
                        ]
