                {
                    "sense_id": "ec870226-c3e5-31a7-b953-46d4093a00fc",
                    "sense_definition": "De geest inspannen om iets te begrijpen, een probleem op te lossen of een mening te vormen.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "thinking_process",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij <w>dacht</w> lang <w>na</w> voordat hij antwoord gaf op de vraag.",
                            "target_lang_translations": {
                                "en": "He <w>thought</w> for a long time before he answered the question.",
                                "ru": "Он долго <w>думал</w>, прежде чем ответить на вопрос.",
                                "it": "Ha <w>riflettuto</w> a lungo prima di rispondere alla domanda."
                            }
                        },
                        {
                            "text": "Je moet eerst goed <w>nadenken</w> en dan pas iets doen.",
                            "target_lang_translations": {
                                "en": "You must <w>think</w> carefully first and only then do something.",
                                "ru": "Нужно сначала хорошо <w>подумать</w>, а потом уже что-то делать.",
                                "it": "Devi prima <w>pensare</w> bene e solo dopo fare qualcosa."
                            }
                        }
                    ],
                    "synonyms": [
                        "peinzen",
                        "overpeinzen"
                    ],
                    "common_phrases": [
                        "diep nadenken",
                        "even nadenken",
                        "logisch nadenken",
                        "hardop nadenken"
                    ],
                    "target_lang_definitions": {
                        "en": "To exert the mind to understand something, solve a problem, or form an opinion.",
                        "ru": "Напрягать ум, чтобы что-то понять, решить проблему или сформировать мнение.",
                        "it": "Sforzare la mente per capire qualcosa, risolvere un problema o formarsi un'opinione."
                    },
                    "translations": {
