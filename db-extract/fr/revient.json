                                        "entry_id": "e0de7f50-14d0-3fac-b2d5-5008aefc37a0",
                                        "glosses": [
                                            "Gesamtheit der Kosten, die einem Unternehmer bei der Anschaffung einer Ware oder einer angebotenen Dienstleistung selbst entstehen, bei der er an der Offerte dieser Waren/Dienstleistungen selbst nichts verdient"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee9b535d-7ade-4407-a158-5170015930bd",
                                                "sense_id": "f7492378-5e98-3f5e-8563-56e142d7e080",
                                                "text": "Versandkosten zum Selbstkostenpreis – Anfahrt wird nur zum Selbstkostenpreis berechnet."
                                            },
                                            {
                                                "example_id": "c304c447-d4a0-4379-a318-c318809b7a7d",
                                                "sense_id": "f7492378-5e98-3f5e-8563-56e142d7e080",
                                                "text": "„Diese Gesellschaft betrieb nicht nur den Kanal, sondern auch die Geschäfte, in denen Proviant zum Selbstkostenpreis gekauft werden konnte.“"
                                            },
                                            {
                                                "example_id": "8f89396b-2e0f-485f-889f-575d7862c951",
                                                "sense_id": "f7492378-5e98-3f5e-8563-56e142d7e080",
                                                "text": "„Meukoff hatte sie mir zum Selbstkostenpreis überlassen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
