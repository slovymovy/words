                },
                {
                    "sense_id": "87788b2d-c9fe-325c-8783-11d3c6f4b469",
                    "sense_definition": "Слова, то, что говорят (обычно во множественном числе).",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "words_content",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Не стоит верить его сладким <w>речам</w>, он просто хочет тебя обмануть.",
                            "target_lang_translations": {
                                "en": "You shouldn't believe his sweet <w>words</w>, he just wants to deceive you.",
                                "zh": "别相信他那些甜言蜜语，他只是想骗你。"
                            }
                        },
                        {
                            "text": "Твои <w>речи</w> звучат очень странно в данной ситуации.",
                            "target_lang_translations": {
                                "en": "Your <w>words</w> sound very strange in this situation.",
                                "zh": "在这种情况下，你的<w>言论</w>听起来很奇怪。"
                            }
                        }
                    ],
                    "synonyms": [
                        "слово"
                    ],
                    "antonyms": [
                        "молчание"
                    ],
                    "common_phrases": [
                        "пустые речи",
                        "сладкие речи",
                        "умные речи"
                    ],
                    "target_lang_definitions": {
                        "en": "Words or things that are said (usually plural).",
                        "zh": "指所说的话或言论（通常用复数）。"
                    },
