                "senses": [
                    {
                        "sense_id": "3c36ef83-cea8-3d8a-a196-e25dee5139ec",
                        "entry_id": "4954d751-bc61-3657-b037-39a41e5084f7",
                        "glosses": [
                            "Étude des risques et des situations dangereuses qui prend en compte les aspects techniques, humains et organisationnels liés à une activité donnée."
                        ],
                        "tags": [
                            "Industrie",
                            "Risques"
                        ],
                        "examples": [
                            {
                                "example_id": "e099e434-dfdb-4734-b67f-8217e2b90ce7",
                                "sense_id": "3c36ef83-cea8-3d8a-a196-e25dee5139ec",
                                "text": "La vie, selon les cindyniques, c’est avant tout un art de vivre, une forme de philosophie ; une façon de penser qui permet de ne pas basculer dans la psychose, tout en restant conscient des événements qui nous entourent, donc adultes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6bdf64a4-c163-4c91-86ce-6ad8d45902d8",
                        "source_entry_id": "4954d751-bc61-3657-b037-39a41e5084f7",
                        "source_sense_id": "3c36ef83-cea8-3d8a-a196-e25dee5139ec",
                        "target_lang_word": "Risikowissenschaft",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "177fefa6-3f66-4888-9e7c-2b6ce3cf57c2",
                        "source_entry_id": "4954d751-bc61-3657-b037-39a41e5084f7",
                        "source_sense_id": "3c36ef83-cea8-3d8a-a196-e25dee5139ec",
                        "target_lang_word": "cindynics",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cindynics",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9374fe31-daa2-36db-86a6-f965e3767ba7",
                                        "entry_id": "611b7c36-636e-320d-9246-73660258b7e2",
                                        "glosses": [
                                            "The science of risk analysis."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e29f86fa-f418-4a12-84ef-d605477c9b84",
                                                "sense_id": "9374fe31-daa2-36db-86a6-f965e3767ba7",
                                                "text": "Cindynics: The Science of Danger [article title]"
                                            },
                                            {
                                                "example_id": "3e80f581-83c9-4bfc-94e9-2c52ba4d55e4",
                                                "sense_id": "9374fe31-daa2-36db-86a6-f965e3767ba7",
                                                "text": "[W]e have continued in the four directions announced in 1994: […] The transfer of road safety concepts to other modes of transport and vice-versa (e.g., secondary safety applied to guided transport, the introduction of cindynics and anthropotechnics in road vehicles)."
                                            },
                                            {
                                                "example_id": "364837f7-4f15-48ac-9755-d1022f1ad485",
                                                "sense_id": "9374fe31-daa2-36db-86a6-f965e3767ba7",
                                                "text": "Researchers in cindynics (danger science) have also brought the notion of vulnerability closer to that of \"space of danger\"[…], which is defined as a set of organizational conditions that make a system prone to break-up and disasters."
                                            },
                                            {
                                                "example_id": "d14047db-48a8-4630-9d7d-23f6714e93c5",
                                                "sense_id": "9374fe31-daa2-36db-86a6-f965e3767ba7",
                                                "text": "The cindynics approach therefore primarily monitors the fragility of collective activity situations, that is, the emergence of dangerous zones […] within an organization, thus weakening its capacity for resilience."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
