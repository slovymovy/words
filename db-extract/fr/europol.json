                        "form_id": "cc8cda03-3a4b-46a1-982a-ab903f3bcb68",
                        "entry_id": "eb023a01-8782-3c11-8ce1-037a5dba9185",
                        "tags": [],
                        "form": "EUROPOL"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "31e911fb-4da5-3b17-afa1-ab8e1ce27998",
                        "entry_id": "eb023a01-8782-3c11-8ce1-037a5dba9185",
                        "glosses": [
                            "Agence de l’Union européenne chargée de renforcer la coopération entre les polices des États membres."
                        ],
                        "tags": [
                            "Europe"
                        ],
                        "examples": [
                            {
                                "example_id": "a530e909-6991-405b-b161-9f6afd8f98e5",
                                "sense_id": "31e911fb-4da5-3b17-afa1-ab8e1ce27998",
                                "text": "Depuis son siège situé à La Haye (Pays-Bas), Europol soutient les 28 États membres de l’Union européenne dans leur lutte contre la grande criminalité internationale et le terrorisme."
                            },
                            {
                                "example_id": "ff10f185-1310-486c-9085-ec53ea032a91",
                                "sense_id": "31e911fb-4da5-3b17-afa1-ab8e1ce27998",
                                "text": "La Convention créant Europol est signée le 26 juillet 1995 mais n’entre en vigueur qu’en juillet 1999 en raison de la lenteur des ratifications. La compétence d’Europol est limitée à des infractions de dimensions internationales dont la liste figure en annexe (trafic de drogue, immigration illégale, trafic d’êtres humains, de véhicules, de substances radio-actives, le blanchissement d’argent, le faux-monnayage, le terrorisme…)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "26735b6e-0df0-4fc1-a15e-9abf91194103",
                        "source_entry_id": "eb023a01-8782-3c11-8ce1-037a5dba9185",
                        "source_sense_id": "31e911fb-4da5-3b17-afa1-ab8e1ce27998",
