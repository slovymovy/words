                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0bb38b7f-1cf2-3144-bd27-f684bc92e513",
                                        "entry_id": "2aed6b46-3cec-303c-b765-c7a046ce8b78",
                                        "glosses": [
                                            "The occurrence of something being discontinued; a cessation; an incomplete ending."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aef85f45-3e4f-42ab-ad1d-9a64447350cd",
                                                "sense_id": "0bb38b7f-1cf2-3144-bd27-f684bc92e513",
                                                "text": "The loss I felt when there was nothing in the mail box on Monday morning made me acutely aware how much I looked forward to each new issue! It's discontinuance would certainly leave a deep sense of loss with me."
                                            },
                                            {
                                                "example_id": "c2fb14af-5594-451f-9f33-7eff76241867",
                                                "sense_id": "0bb38b7f-1cf2-3144-bd27-f684bc92e513",
                                                "text": "If any railway official, policeman, or member of the Forces on duty, requests the discontinuance of any particular form of observation or note-taking, it is clearly right to give immediate compliance, especially when it is borne in mind that public authorities now have very wide powers to hold members of the general public in custody while inquiries are being conducted as to their bona fides."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
