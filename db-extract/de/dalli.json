                                "sense_id": "42f30d82-0e61-3847-ae6e-1242fd0c701b",
                                "text": "Wenn er ’n bisschen dalli macht, könnte er’s noch schaffen.",
                                "translation": "If he hurries up a bit, he could still make it.",
                                "english": "If he hurries up a bit, he could still make it."
                            },
                            {
                                "example_id": "acca6c21-5bbc-4a4f-8621-842ba096e907",
                                "sense_id": "42f30d82-0e61-3847-ae6e-1242fd0c701b",
                                "text": "Ja, los! Dalli dalli!",
                                "translation": "Come on! Hurry up!",
                                "english": "Come on! Hurry up!"
                            },
                            {
                                "example_id": "1da56948-fa7a-4685-b0f1-81b650f0cda1",
                                "sense_id": "42f30d82-0e61-3847-ae6e-1242fd0c701b",
                                "text": "Wenn du dich dalli anziehst, nehm ich dich mit.",
                                "translation": "If you get dressed quickly, I can take you with me.",
                                "english": "If you get dressed quickly, I can take you with me."
                            }
                        ]
                    }
