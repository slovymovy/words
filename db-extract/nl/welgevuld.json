                        "tags": [],
                        "examples": [
                            {
                                "example_id": "760f3fba-35ed-42f1-a6f6-7c5b9bc38a9f",
                                "sense_id": "d7d58714-c28b-35ef-a10b-f7079828c738",
                                "text": "Het verzamelen van kunst is in ons land een echte passie. Collectioneurs met een goed oog en een welgevulde beurs kiezen vaak beter en vooral vlugger dan de musea."
                            },
                            {
                                "example_id": "1a6c47b9-7792-4289-9f16-7fe0610e95c8",
                                "sense_id": "d7d58714-c28b-35ef-a10b-f7079828c738",
                                "text": "Voor Van Raemdonck is het een nieuwe stap in een al welgevulde managerscarrière."
                            },
                            {
                                "example_id": "2d91c87c-2728-49fd-a37b-f3bd3019bebe",
                                "sense_id": "d7d58714-c28b-35ef-a10b-f7079828c738",
                                "text": "Elk jaar wil het EP en de EC er meer geld bij hebben, zodat zij kennelijk nog meer uit de welgevulde ruif kunnen halen, waardoor er nog meer appelen van de kar vallen om hun eigen zakken te vullen."
                            },
                            {
                                "example_id": "762768aa-e4af-44fd-a7fd-1424eb222fec",
                                "sense_id": "d7d58714-c28b-35ef-a10b-f7079828c738",
                                "text": "Vorige week bracht ik een welgevuld bliksembezoek aan Londen. Binnen zesentwintig uur zag ik een prachtige voorstelling, bezocht ik de expositie over David Bowie in het Victoria & Albert museum en at ik vier tevredenstemmende maaltijden."
                            }
                        ]
                    }
