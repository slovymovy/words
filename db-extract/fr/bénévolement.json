                                    {
                                        "sense_id": "f725432f-d65d-3803-8aae-36c1c5c48248",
                                        "entry_id": "dac66113-eff5-395d-9a13-195f68541f00",
                                        "glosses": [
                                            "In a free manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "40926010-a1a1-4b2e-b1cd-e784d162b9a1",
                                                "sense_id": "f725432f-d65d-3803-8aae-36c1c5c48248",
                                                "text": "Wine was flowing freely."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "088c57d3-9a72-3868-a378-4d0d6fdbff48",
                                        "entry_id": "dac66113-eff5-395d-9a13-195f68541f00",
                                        "glosses": [
                                            "Without interference or restriction."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "299f734f-7013-486d-840e-5447bdcfccf2",
                                                "sense_id": "088c57d3-9a72-3868-a378-4d0d6fdbff48",
                                                "text": "talk freely"
                                            },
                                            {
                                                "example_id": "b123042b-3199-4f84-b91e-97910fcee21c",
                                                "sense_id": "088c57d3-9a72-3868-a378-4d0d6fdbff48",
                                                "text": "I found that the Chapelon steamed almost too freely, because on a strange locomotive and road one usually tends to overfire a little through a natural lack of confidence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9b6b8144-43d2-3290-85bd-37184f411dde",
                                        "entry_id": "dac66113-eff5-395d-9a13-195f68541f00",
                                        "glosses": [
                                            "Of one's own free will."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b67a765-ec35-403f-a9f1-83e9f041bbbf",
                                                "sense_id": "9b6b8144-43d2-3290-85bd-37184f411dde",
                                                "text": "I will freely help you."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f359c0b5-dd6e-4bb3-9281-1f3fbf256a9a",
                        "source_entry_id": "3eb7ad4b-e677-39e9-b8f6-c8218bf10a8c",
                        "source_sense_description": "sans demander salaire",
                        "target_lang_word": "pro bono",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pro bono",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "86d21350-bc49-30ec-b81a-fcb26203df4a",
                                        "entry_id": "9dcbaf77-7f34-3f3e-babd-54fc59bbef6a",
                                        "glosses": [
                                            "Without charging a fee, done without fee, generally for clients or patients of limited means."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "acc3bc5e-a1c6-4c41-9298-cfd56806e590",
                                                "sense_id": "86d21350-bc49-30ec-b81a-fcb26203df4a",
                                                "text": "The firm currently has about half a dozen pro bono cases at any one time."
                                            },
                                            {
                                                "example_id": "8e31270e-3386-4b05-8bd4-10c6b27f708c",
                                                "sense_id": "86d21350-bc49-30ec-b81a-fcb26203df4a",
                                                "text": "After he retired, he offered representation pro bono from time to time."
                                            },
                                            {
                                                "example_id": "4ed89c73-0bee-44b9-a505-5799386f4124",
                                                "sense_id": "86d21350-bc49-30ec-b81a-fcb26203df4a",
                                                "text": "Esther Lardent, chief consultant to the ABA's Post Conviction Death Penalty Representation Project, which has helped recruit pro bono lawyers for death row appeals since 1987, begs to differ. Finding a lawyer to represent a death row inmate has never been easy, Lardent says. And finding one now, she says, will be harder than ever."
                                            },
                                            {
                                                "example_id": "941dc491-7065-43b3-9f83-d8512b3175fa",
                                                "sense_id": "86d21350-bc49-30ec-b81a-fcb26203df4a",
                                                "text": "While the media sneerocracy only came round to Oliver because of his pro bono project, the huge number of people buying his books and wheeling their Sainsbury's trolleys in his wake had already responded to his charisma."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
