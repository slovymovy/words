                "senses": [
                    {
                        "sense_id": "cb511ec1-cf60-3812-970d-54dffd35d541",
                        "entry_id": "6e792b1a-2a4c-3be4-b6c6-0aad00f7f9a3",
                        "glosses": [
                            "The act of slowing down whilst driving a vehicle, in order to see the scene of an accident."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "585e89bd-8173-4c9a-9ce1-5cb3cafa309f",
                                "sense_id": "cb511ec1-cf60-3812-970d-54dffd35d541",
                                "text": "\"The resulting wreckage blocks the entire southbound side of the Interstate, while the inevitable rubbernecking slows traffic on the northbound side to little more than the speed of a brisk walk.\""
                            }
                        ]
                    },
                    {
                        "sense_id": "d35036dd-4bcc-3d5a-920a-c2b944d879a5",
                        "entry_id": "6e792b1a-2a4c-3be4-b6c6-0aad00f7f9a3",
                        "glosses": [
                            "Generally, any act of observation in a manner considered unduly overt or otherwise unseemly."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "ad5d0338-b1be-46d3-b460-b32d77f0fa71",
                                "sense_id": "d35036dd-4bcc-3d5a-920a-c2b944d879a5",
                                "text": "The children had never been in such a large museum and their rubbernecking was rather amusing."
                            }
                        ]
                    }
                ],
