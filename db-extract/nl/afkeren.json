                        "sense_id": "e8bacf12-2f4e-353a-8685-dcd804ac1b42",
                        "entry_id": "773b6832-9ac2-3afd-bc73-f944ea602446",
                        "glosses": [
                            "to turn away"
                        ],
                        "tags": [
