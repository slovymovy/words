                "senses": [
                    {
                        "sense_id": "197d3cdb-b7ba-3d23-a768-adcd3fadca4f",
                        "entry_id": "a4b1a66c-8c3c-3358-b450-9917283f94e8",
                        "glosses": [
                            "Étude sociologique du cinéma et des films."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "48d54bf1-2526-4cef-bddb-e759ec3648d8",
                                "sense_id": "197d3cdb-b7ba-3d23-a768-adcd3fadca4f",
                                "text": "Louisette Fareignaux était à l’époque professeur de filmologie à Lille 3 (et elle l’est encore)."
                            },
                            {
                                "example_id": "9e968ef7-240e-4d83-93e0-386be0b775c6",
                                "sense_id": "197d3cdb-b7ba-3d23-a768-adcd3fadca4f",
                                "text": "Mes obligations à l’Institut de Filmologie s’achèvent par l’organisation d’un Congrès International qui se tient à la Sorbonne en février 1955."
                            },
                            {
                                "example_id": "64e20fe5-5f29-45fd-ab08-ce14f9dfbadb",
                                "sense_id": "197d3cdb-b7ba-3d23-a768-adcd3fadca4f",
                                "text": "Le sociologue Edgar Morin avait pointé le cinéma comme l'un des plus puissants déterminants des conduites mimétiques au moment où les intervenants du Congrès international de filmologie mettaient l'accent par la voix de Gilbert Cohen-Séat sur l'identification du cinéma avec l'hypnose et l'efficacité exceptionnelle de celui-ci sur le comportement humain en raison de ce que les psychologues appelaient « la loi de la perception sensori-motrice »."
                            }
                        ]
                    }
                ],
