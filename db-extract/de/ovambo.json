                        "glosses": [
                            "Angehöriger einer Ethnie, die in der Grenzregion von Namibia und Angola lebt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "27923bb9-af26-4e17-b6e4-42c1832193b9",
                                "sense_id": "a18bca6a-847c-39b2-8a0d-e938f1bb61af",
                                "text": "„Wie die benachbarten Ovambo und Herero leben die Nhaneca-Humbe wesentlich von der Rinderzucht.“"
                            },
                            {
                                "example_id": "d5340f00-e5f1-4d7b-b6ab-cdda1e98d050",
                                "sense_id": "a18bca6a-847c-39b2-8a0d-e938f1bb61af",
                                "text": "„Im Gegensatz zu den Herero und Ovambo sprechen diese isolierten Afrikaaner nur ihre eigene Sprache.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
