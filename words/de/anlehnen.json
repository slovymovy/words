                {
                    "sense_id": "21a50d7b-da7e-32c0-ae95-2a351914d344",
                    "sense_definition": "eine Tür oder ein Fenster fast ganz schließen, sodass ein schmaler Spalt offen bleibt",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Bitte <w>lehn</w> die Tür nur <w>an</w>, damit die Katze ins Zimmer kommen kann."
                        },
                        {
                            "text": "Er <w>lehnte</w> die Tür vorsichtig <w>an</w>, um das schlafende Kind nicht zu wecken."
                        }
                    ],
                    "antonyms": [
                        "schließen"
                    ],
                    "common_phrases": [
                        "die Tür anlehnen",
                        "das Fenster anlehnen"
                    ]
                },
                {
                    "sense_id": "fe59d802-d3e9-3bd9-a971-7c091f2700a5",
                    "sense_definition": "den eigenen Körper gegen jemanden oder etwas stützen, um Halt zu finden",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "abstuetzen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nach der langen Wanderung <w>lehnte</w> er sich erschöpft an einen Baum <w>an</w>."
                        },
                        {
                            "text": "Während der Fahrt in der Bahn darf man sich nicht an die Türen <w>anlehnen</w>."
                        }
                    ],
                    "synonyms": [
                        "sich stützen"
                    ],
                    "common_phrases": [
                        "sich an die Wand anlehnen"
                    ]
                },
                {
                    "sense_id": "921b937a-93cb-34c9-a0f9-d4b9b4556df1",
                    "sense_definition": "einen Gegenstand schräg an eine Wand oder Fläche stellen, sodass er gestützt wird",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "abstuetzen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er <w>lehnte</w> sein Fahrrad vorsichtig an die Hauswand <w>an</w>."
                        },
                        {
                            "text": "Wenn wir das Bild an die Wand <w>anlehnen</w>, müssen wir keinen Nagel einschlagen."
                        }
                    ],
                    "synonyms": [
                        "anstellen"
                    ],
                    "common_phrases": [
