{
    "word_family": [
        "rearward"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7b7562d0-0876-358c-ae35-8349ea4f547d",
                    "sense_definition": "The back part of something; the part that is behind the others.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "position",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There is a large garden at the <w>rear</w> of the house.",
                            "target_lang_translations": {
                                "ru": "В <w>задней части</w> дома есть большой сад.",
                                "zh": "房子<w>后部</w>有一个大花园。"
                            }
                        },
                        {
                            "text": "He preferred to sit in the <w>rear</w> of the bus.",
                            "target_lang_translations": {
                                "ru": "Он предпочитал сидеть в <w>задней части</w> автобуса.",
                                "zh": "他喜欢坐在公交车的<w>后部</w>。"
                            }
                        }
                    ],
                    "antonyms": [
                        "front"
                    ],
                    "common_phrases": [
                        "in the rear",
                        "at the rear",
                        "bring up the rear"
                    ],
                    "target_lang_definitions": {
                        "ru": "Задняя часть чего-либо; часть, находящаяся позади остальных.",
                        "zh": "某物的后部；位于其他部分之后的部分。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "за́дняя часть",
                                "target_lang_sense_clarification": "общая задняя сторона объекта"
                            },
                            {
                                "target_lang_word": "тыл",
                                "target_lang_sense_clarification": "задняя сторона, часто в военном или формальном контексте"
                            },
                            {
                                "target_lang_word": "за́дняя сторона́",
                                "target_lang_sense_clarification": "поверхность сзади"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "后部",
                                "target_lang_sense_clarification": "物体的后方区域"
                            },
                            {
                                "target_lang_word": "后面",
                                "target_lang_sense_clarification": "位置在后方"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "19be3c34-2ab1-36ec-8a4d-66346df9b41b",
                    "sense_definition": "The part of the body that a person sits on.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "body_part",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She slipped on the ice and landed right on her <w>rear</w>.",
                            "target_lang_translations": {
                                "ru": "Она поскользнулась на льду и приземлилась прямо на <w>зад</w>.",
                                "zh": "她在冰上滑倒，直接摔在了<w>屁股</w>上。"
                            }
                        },
                        {
                            "text": "The dog bit the intruder on his <w>rear</w>.",
                            "target_lang_translations": {
                                "ru": "Собака укусила грабителя за <w>зад</w>.",
                                "zh": "那条狗咬了入侵者的<w>屁股</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "rear end"
                    ],
                    "common_phrases": [
                        "pain in the rear"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "polite informal term"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Часть тела, на которой человек сидит.",
                        "zh": "人坐着时接触地面的身体部位。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зад",
                                "target_lang_sense_clarification": "разговорное название ягодиц"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "屁股",
                                "target_lang_sense_clarification": "口语中指臀部"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "530136d0-2065-3004-b24e-cc9373dd44f4",
                    "sense_definition": "Located at the back or in the hindmost part.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "position",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Passengers in the <w>rear</w> seats must wear seatbelts.",
                            "target_lang_translations": {
                                "ru": "Пассажиры на <w>задних</w> сиденьях должны быть пристегнуты.",
                                "zh": "<w>后排</w>座位的乘客必须系好安全带。"
                            }
                        },
                        {
                            "text": "He checked the <w>rear</w> view mirror before reversing the car.",
                            "target_lang_translations": {
                                "ru": "Он проверил зеркало <w>заднего</w> вида перед тем, как сдать назад.",
                                "zh": "他在倒车前检查了<w>后视</w>镜。"
                            }
                        }
                    ],
                    "antonyms": [
                        "front"
                    ],
                    "common_phrases": [
                        "rear view",
                        "rear window",
                        "rear entrance",
                        "rear wheel"
                    ],
                    "target_lang_definitions": {
                        "ru": "Расположенный сзади или в самой задней части.",
                        "zh": "位于后方或最靠后的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "за́дний",
                                "target_lang_sense_clarification": "находящийся сзади"
                            },
                            {
                                "target_lang_word": "ты́льный",
                                "target_lang_sense_clarification": "относящийся к обратной стороне"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "后部的",
                                "target_lang_sense_clarification": "形容词，指位置在后"
                            },
                            {
                                "target_lang_word": "后面的",
                                "target_lang_sense_clarification": "指处于后方位置的"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5f89d002-0372-3974-8056-cd1bfe248f59",
                    "sense_definition": "To care for young children or animals until they are fully grown.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "development",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her parents <w>reared</w> her with strict discipline and love.",
                            "target_lang_translations": {
                                "ru": "Родители <w>воспитывали</w> её в строгости и любви.",
                                "zh": "她的父母在严厉的管教和爱中将她<w>抚养</w>长大。"
                            }
                        },
                        {
                            "text": "The farmer has been <w>rearing</w> cattle on this land for decades.",
                            "target_lang_translations": {
                                "ru": "Фермер <w>выращивал</w> скот на этой земле десятилетиями.",
                                "zh": "这位农夫在这片土地上<w>饲养</w>牲畜已经几十年了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "born and reared",
                        "rear cattle",
                        "rear children"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заботиться о маленьких детях или животных, пока они не вырастут.",
                        "zh": "抚养孩子或饲养动物直至其成年。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "воспи́тывать",
                                "target_lang_sense_clarification": "растить детей, формировать личность"
                            },
                            {
                                "target_lang_word": "выра́щивать",
                                "target_lang_sense_clarification": "растить животных или растения"
                            },
                            {
                                "target_lang_word": "расти́ть",
                                "target_lang_sense_clarification": "способствовать росту и развитию"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "抚养",
                                "target_lang_sense_clarification": "指养育子女"
                            },
                            {
                                "target_lang_word": "饲养",
                                "target_lang_sense_clarification": "指养育动物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "614cfbd1-2574-3f89-a1ce-f806a6ef8476",
                    "sense_definition": "To rise upright on the hind legs.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "motion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The frightened horse <w>reared</w> up and threw its rider to the ground.",
                            "target_lang_translations": {
                                "ru": "Испуганная лошадь <w>встала на дыбы</w> и сбросила всадника на землю.",
                                "zh": "受惊的马<w>人立</w>起来，把骑手甩到了地上。"
                            }
                        },
                        {
                            "text": "The stallion <w>reared</w> high in the air to show its dominance.",
                            "target_lang_translations": {
                                "ru": "Жеребец высоко <w>встал на дыбы</w>, чтобы продемонстрировать своё превосходство.",
                                "zh": "那匹种马高高<w>人立</w>起来以展示它的统治地位。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "rear up"
                    ],
                    "target_lang_definitions": {
                        "ru": "Подниматься вертикально на задние ноги.",
                        "zh": "（指马等动物）用后腿站立。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "встава́ть на дыбы́",
                                "target_lang_sense_clarification": "о лошади или звере"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "人立",
                                "target_lang_sense_clarification": "指动物用后腿站立"
                            },
                            {
                                "target_lang_word": "扬蹄",
                                "target_lang_sense_clarification": "指马匹前蹄抬起"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "afbad9c6-52d0-3ba6-ba53-ccb8d21b43b5",
                    "sense_definition": "To rise or appear, often referring to something unpleasant.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "motion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The problem of inflation has <w>reared</w> its ugly head again.",
                            "target_lang_translations": {
                                "ru": "Проблема инфляции снова <w>подняла</w> свою уродливую голову.",
                                "zh": "通货膨胀的问题又<w>显露</w>出了它丑陋的一面。"
                            }
                        },
                        {
                            "text": "The monster slowly <w>reared</w> its head from the dark swamp.",
                            "target_lang_translations": {
                                "ru": "Монстр медленно <w>поднял</w> голову из темного болота.",
                                "zh": "怪物从黑暗的沼泽中慢慢<w>探出</w>了头。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "rear its ugly head",
                        "rear its head"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "idiomatic"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Возникать или появляться, часто о чем-то неприятном.",
                        "zh": "出现或显露，常指令人不快的事物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поднима́ть",
                                "target_lang_sense_clarification": "в идиомах типа 'поднимать голову' (о проблеме)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "显露",
                                "target_lang_sense_clarification": "指问题或事物浮现出来"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}