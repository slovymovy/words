        "fr-extract.jsonl": [
            {
                "entry_id": "0a6d581b-5fca-332a-8d8e-3db4a9d1d49e",
                "word": "boustifaille",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "d937bc28-6a1d-4a8f-a0ed-ade798fc4760",
                        "entry_id": "0a6d581b-5fca-332a-8d8e-3db4a9d1d49e",
                        "tags": [
                            "plural"
                        ],
                        "form": "boustifailles"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2fd53589-2154-33c7-84ed-deec2a051424",
                        "entry_id": "0a6d581b-5fca-332a-8d8e-3db4a9d1d49e",
                        "glosses": [
                            "Repas copieux, bombance."
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "4da7ca0b-5d8f-4520-84fb-97c7262fa9c1",
                                "sense_id": "2fd53589-2154-33c7-84ed-deec2a051424",
                                "text": "Mes amis, autrefois, dans cet aimable autrefois, on se mariait savamment ; on faisait un bon contrat, ensuite une bonne boustifaille."
                            },
                            {
                                "example_id": "1b1b7d85-ff6e-4d99-8c95-b3815ad80972",
                                "sense_id": "2fd53589-2154-33c7-84ed-deec2a051424",
                                "text": "Après cette boustifaille une sieste s’impose!"
                            }
                        ]
                    },
                    {
                        "sense_id": "7c97d3d1-3c72-390b-bddb-94f532d6c264",
                        "entry_id": "0a6d581b-5fca-332a-8d8e-3db4a9d1d49e",
                        "glosses": [
                            "Nourriture, mangeaille."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "ad7a0ec5-4667-4876-a33a-729c0f53693f",
                                "sense_id": "7c97d3d1-3c72-390b-bddb-94f532d6c264",
                                "text": "– Bon, il y a de la boustifaille !\n[…], il entra et se mit en devoir d’explorer l’établissement. Il y découvrit plusieurs flacons de lait stérilisé, des bouteilles d’eau minérale, deux énormes boites de biscuits, un grand bocal de gâteaux éventés, […] pour plus de cinquante personnes."
                            },
                            {
                                "example_id": "05758816-bf6d-4ec6-bd48-d3f2ef0315ca",
                                "sense_id": "7c97d3d1-3c72-390b-bddb-94f532d6c264",
                                "text": "On leur avait donné cette boustifaille, c’était bien pour qu’ils l’engouffrent…"
                            },
                            {
                                "example_id": "3ac76876-7f7f-4fcb-9e09-0eadec4c1e9d",
                                "sense_id": "7c97d3d1-3c72-390b-bddb-94f532d6c264",
                                "text": "MILLE MILLIONS ! Ta boustifaille sur ma table à dessin !!"
                            },
                            {
                                "example_id": "a87d61b3-bf91-4ef0-9fde-ebf0939821c6",
                                "sense_id": "7c97d3d1-3c72-390b-bddb-94f532d6c264",
                                "text": "On y mange bien, ce que Michel ne dédaigne pas. Mais l’importance donnée à la boustifaille, par les femmes surtout, dégoûte cet amateur de plats simples."
                            },
                            {
                                "example_id": "17ad1352-0354-4d65-8855-8742de1713b7",
                                "sense_id": "7c97d3d1-3c72-390b-bddb-94f532d6c264",
                                "text": "Il venait nous retrouver, nous ses potes, dans des cafés où c'est que nous causions de boustifaille, de cinoche et de philo."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "33e087c3-a1e9-4fa6-acca-29e2fde112b5",
                        "source_entry_id": "0a6d581b-5fca-332a-8d8e-3db4a9d1d49e",
                        "target_lang_word": "Fressen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fressen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "532fe909-0a14-31f2-8496-c4db92e9c611",
                                        "entry_id": "8e6f663c-ef08-3f89-b905-1a61a16e888f",
                                        "glosses": [
                                            "Vorgang, Handlung, bei dem beziehungsweise bei der gefressen wird"
                                        ],
                                        "tags": [
                                            "von Tieren; salopp oder emotional",
                                            "abwertend von Menschen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0c062985-8f57-41fb-9cab-bc149b1b5b3c",
                                                "sense_id": "532fe909-0a14-31f2-8496-c4db92e9c611",
                                                "text": "„Bei der Untersuchung zeigte sich, dass die Reptilien beim Fressen nicht nur feuchte Augen bekommen, sondern dass es aus den Tränendrüsen mitunter sogar regelrecht sprudelt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f9f78800-28fd-3c93-bcea-1508d14dc174",
                                        "entry_id": "8e6f663c-ef08-3f89-b905-1a61a16e888f",
                                        "glosses": [
                                            "zubereitete Nahrung für bestimmte Haustiere, zur Mahlzeit hergerichtete, vorbereitete Speise"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef8acdd3-2fa7-4008-99cd-051356c51919",
                                                "sense_id": "f9f78800-28fd-3c93-bcea-1508d14dc174",
                                                "text": "Sie gab der Katze ihr Fressen."
                                            },
                                            {
                                                "example_id": "4b9b4f24-f4e3-4fb9-ab6b-fd4e6c860318",
                                                "sense_id": "f9f78800-28fd-3c93-bcea-1508d14dc174",
                                                "text": "Er schüttete seinem Hund das Fressen in den Fressnapf."
                                            },
                                            {
                                                "example_id": "f9416857-2dda-4728-8a51-25b07294dc27",
                                                "sense_id": "f9f78800-28fd-3c93-bcea-1508d14dc174",
                                                "text": "Das Fressen in der Kaschemme war mies."
                                            },
                                            {
                                                "example_id": "2b19a5c0-9d5b-485f-9962-179fd347e909",
                                                "sense_id": "f9f78800-28fd-3c93-bcea-1508d14dc174",
                                                "text": "„Vater sitzt zum ’zigsten Male, / wegen „Hm“ in Plötzensee, / und sein Schatz, der schimpft sich Male, / und der Mutter tut’s so weh! / Ja so gut wie der hat’s Keener, / Fressen kriegt er und noch mehr, / und er baumelt mit de Beene, / mit de Beene vor sich her.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "06912856-e4ec-3fd4-82df-c3a15d01dc0c",
                                        "entry_id": "8e6f663c-ef08-3f89-b905-1a61a16e888f",
                                        "glosses": [
                                            "infolge mangelhafter Schmierung und einer daraus entstehenden starken Reibungswärme sowie durch kontinuierliches mechanisches Bewegen, wiederholt entstehendes Verschweißen und Losreißen zweier Gleitpartner"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d1c5521-effb-4f40-b888-dfe6aa1877a7",
                                                "sense_id": "06912856-e4ec-3fd4-82df-c3a15d01dc0c",
                                                "text": "Nicht ganz so schön aber auch nicht weiter kritisch ist das Fressen der oberen Pleuelaugen am Kolbenbolzen, das bei allen FZR Motoren festzustellen ist."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            },
