                ],
                "senses": [
                    {
                        "sense_id": "795b5d99-2b17-3fe3-8e0f-c420a94b535c",
                        "entry_id": "b6adf853-be94-374d-b745-7660e8022326",
                        "glosses": [
                            "in Bezug auf den Hexameter; in Hexametern geschrieben; als Vers aus sechs Daktylen oder Spondeen bestehend, wobei der letzte um eine Silbe gekürzt (katalektisch) ist"
                        ],
                        "tags": [
                            "Metrik"
                        ],
                        "examples": [
                            {
                                "example_id": "37ac84c4-f544-42ac-9655-a23966ed1229",
                                "sense_id": "795b5d99-2b17-3fe3-8e0f-c420a94b535c",
                                "text": "„Es ist vielmehr anzunehmen, dass Livius ganz bewusst sein Werk hexametrisch beginnen wollte.“"
                            },
                            {
                                "example_id": "8e7056da-6aba-49a4-a279-351262d26d0b",
                                "sense_id": "795b5d99-2b17-3fe3-8e0f-c420a94b535c",
                                "text": "„Der Archipelagus ist, bei allen elegischen Zügen, eher als klassische hexametrische Hymne gestaltet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
