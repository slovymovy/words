                    },
                    {
                        "translation_id": "ee580581-e395-4517-b1bb-71ab80e089d5",
                        "source_entry_id": "434ef5f1-ce5a-39a6-8b1e-8eb92b1628f5",
                        "source_sense_id": "fa2fc17b-4125-3222-8129-dea3c3066ba4",
                        "target_lang_word": "misbruik",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "misbruik",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "68ede547-c948-3e6c-964e-e299f164218b",
                                        "entry_id": "745cbec1-5fc2-37c5-a36b-f1c9a4747b68",
                                        "glosses": [
                                            "verkeerd gebruik door overdaad (van drank, drugs, een toegewezen voorrecht, e.d.)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1cd33114-9347-4347-ae0d-93a5003f62fc",
                                                "sense_id": "68ede547-c948-3e6c-964e-e299f164218b",
                                                "text": "zoo dat wy zwarigheit Godt voor het verhoeden dezer zwarigheit, die door misbruik des dranks veeltyts voorvalt"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0fcba55f-9aa6-34c9-9186-999edbbfb7ee",
                                        "entry_id": "745cbec1-5fc2-37c5-a36b-f1c9a4747b68",
                                        "glosses": [
                                            "mishandeling en uitbuiting (van personen)"
                                        ],
                                        "tags": [
                                            "seksuele"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "803db6de-309c-475e-88ca-21c599e13660",
                                                "sense_id": "0fcba55f-9aa6-34c9-9186-999edbbfb7ee",
                                                "text": "Vijftien jaar na het misbruik laat hij zich opnemen in een afkickkliniek in Zuid-Afrika. In de ontwenningskliniek komt het seksueel misbruik aan het licht. Eind 2015 doet hij alsnog aangifte tegen zijn voormalige coach."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bdbe0c3e-10eb-3639-953f-698b90a8403d",
                                        "entry_id": "745cbec1-5fc2-37c5-a36b-f1c9a4747b68",
                                        "glosses": [
                                            "het laakbare gebruik van iets voor een doel waarvoor het niet bedoeld was (van naamgeving, macht e.d.)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "05f1486e-f70c-41d6-a87b-0d369e661384",
                                                "sense_id": "bdbe0c3e-10eb-3639-953f-698b90a8403d",
                                                "text": "Het is geheel ongerijmd, dat sommige met een alhier voorgeven, dat wy dan ook den naem van Iesus Christus niet en behoorden te houden, maer in den Duytschen naem van Saligmaker ende Gesalfde te veranderen: want dit is de eygen naem, ende toenaem onses Heeren: ook most men dan op gelijken voet niet alleen geen Petrus, maer ook geen Pieter, maer a) Steen seggen: ende waer sullen wy dan ook eyndelijk met alle de Bibelsche namen, voornamelijk in den Ouden Testamente, blijven, die vast alle by sekere gelegenheyd van ampten, plaetzen, tijden, geschiedeniszen, ende andere omstandigheden sijn gegeven? Maer dit overgeslagen. Dit misbruyk gaet ook noch so verre, dat wy die eyge namen, die wy naer de Duytsche aant.wijse in de gevallen buygen, evenwel op de Latijnsche maniere gebruyken,"
                                            },
                                            {
                                                "example_id": "5c82e8e9-f3bd-4038-8b5b-891b3e930396",
                                                "sense_id": "bdbe0c3e-10eb-3639-953f-698b90a8403d",
                                                "text": "Het is een doordachte zet in The Favourite, een kostelijke kostuumfilm over manipulatie, macht en misbruik."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "59d11651-a654-3ae2-9f6c-d2b6a275bd03",
                                        "entry_id": "745cbec1-5fc2-37c5-a36b-f1c9a4747b68",
                                        "glosses": [
                                            "misdaad, misstap"
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3fb286b3-67db-4080-8634-d7833a77dcde",
                                                "sense_id": "59d11651-a654-3ae2-9f6c-d2b6a275bd03",
                                                "text": "Deze volkeren volgden hier in zekerlyk de zeden der Lacedemoners, die gewoon waeren hunne dieven te pryzen en het stelen voor eene konst hielden, gelyk hier vooren gezeyd is. Zy waeren afgoden-dienaeren, en daerom is het min te verwonderen dat hunne staetkunde dit misbruyk begunstigde; maer dat dit rooven in zommige gewesten van hun land nog plaets gehad heeft lang naer dat zy tot het christen geloof bekeerd."
                                            },
                                            {
                                                "example_id": "439fce54-3f30-4aae-9e66-848fdd9253ab",
                                                "sense_id": "59d11651-a654-3ae2-9f6c-d2b6a275bd03",
                                                "text": "Dit Tucht-huys … om de misbruycken der boosaerdige menschen te tuchtigen,"
                                            }
                                        ]
                                    }
                                ]
                            },
