                "senses": [
                    {
                        "sense_id": "d96d555b-55fe-3dd5-91be-609a6c57e885",
                        "entry_id": "54492e54-dc90-3646-8e49-b02545e77705",
                        "glosses": [
                            "Petite cloche attachée au cou des bêtes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e1b79a1-d31a-41d3-8044-89a36622f859",
                                "sense_id": "d96d555b-55fe-3dd5-91be-609a6c57e885",
                                "text": "Il accrocha la lampe tempête à son clou près du pilier. Elle se balança longtemps, brassant les ombres, allumant des kyrielles de reflets sur la grappe de platelles, de bourdons, de clarines qui pendait de la poutre maîtresse."
                            },
                            {
                                "example_id": "6cfaf1ab-9fd4-4f97-9d80-e3c86139fda6",
                                "sense_id": "d96d555b-55fe-3dd5-91be-609a6c57e885",
                                "text": "Depuis le redon que l’on met au floucat, le bélier meneur et qui ne s’utilise que durant le temps de la transhumance, puis les platelles qui sont celles des brebis calmes, et les piques plus longues que l’on met généralement aux chèvres jusqu’au grelot qui accompagne les déplacements de chiens."
                            },
                            {
                                "example_id": "bb494fc9-f733-4743-9149-c2e04e4889c0",
                                "sense_id": "d96d555b-55fe-3dd5-91be-609a6c57e885",
                                "text": "Les brebis portaient la pique, au timbre cristallin, et les ânes la platelle, à la sonorité à la fois grave et cristalline."
                            },
                            {
                                "example_id": "b85f9c0f-7c96-42a2-a16b-6d66b1311a8e",
                                "sense_id": "d96d555b-55fe-3dd5-91be-609a6c57e885",
                                "text": "Étrange symphonie ambulante que ce carillon de piques, clavelles et platelles accompagné du foulage de milliers de sabots."
                            }
                        ]
                    }
                ],
