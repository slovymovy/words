                                "target_senses": [
                                    {
                                        "sense_id": "01e1dfa4-8e8c-3c6f-af3d-3f294d244e13",
                                        "entry_id": "3c1f8b63-79bf-3e54-aaf2-06f8561ef04c",
                                        "glosses": [
                                            "A type of ice cream made with vanilla, cream, eggs, and sugar."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b105ad9d-a4de-4f38-bd67-8e980589d59d",
                                                "sense_id": "01e1dfa4-8e8c-3c6f-af3d-3f294d244e13",
                                                "text": "There were Russian hors d’oeuvres of black caviar, a roasted pheasant as an entrée, and cream plombir for dessert."
                                            },
                                            {
                                                "example_id": "95a1f8d1-b0a5-4f92-8ad7-9875f5d2e549",
                                                "sense_id": "01e1dfa4-8e8c-3c6f-af3d-3f294d244e13",
                                                "text": "There are two dessert choices, baklava and plombir, a creamy almond ice."
                                            },
                                            {
                                                "example_id": "0e5e4e9d-0065-4797-8957-3a904deae4c8",
                                                "sense_id": "01e1dfa4-8e8c-3c6f-af3d-3f294d244e13",
                                                "text": "For desserts there were “airy pie,” charlottes, mousses, kissel, plombir and “zephyrs.”"
                                            },
                                            {
                                                "example_id": "9ce332a2-7763-4bfd-8a85-e7fe9b0794bc",
                                                "sense_id": "01e1dfa4-8e8c-3c6f-af3d-3f294d244e13",
                                                "text": "[W]arm plombir drops drip on the pavement, on her bag and shoes."
                                            },
                                            {
                                                "example_id": "f23902f0-1edf-4ce7-868f-85c4e65b0ff7",
                                                "sense_id": "01e1dfa4-8e8c-3c6f-af3d-3f294d244e13",
                                                "text": "You can also use silicone baking molds or silicone ice cube trays, which allow the plombir to be easily popped out after freezing."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
