                        "target_lang_word": "reconfiguration",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "reconfiguration",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b309bcc0-7f02-367a-bb4c-571f9c8dd7ff",
                                        "entry_id": "ef9f0e0a-177a-3bbc-aabe-9155e16d1d64",
                                        "glosses": [
                                            "A reconfigured state."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cb13fed2-256a-4664-9049-c282318d5d1a",
                                                "sense_id": "b309bcc0-7f02-367a-bb4c-571f9c8dd7ff",
                                                "text": "This reconfiguration is much faster than the old setting."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "949b30b9-72bd-38d7-923b-c09481ff5ede",
                                        "entry_id": "ef9f0e0a-177a-3bbc-aabe-9155e16d1d64",
                                        "glosses": [
                                            "The act of reconfiguring."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6e49cf7e-8d2f-4e77-99bd-0a7b4d5efd19",
                                                "sense_id": "949b30b9-72bd-38d7-923b-c09481ff5ede",
                                                "text": "Reconfiguration will require a while, but then the new form will make the computer much faster."
                                            },
                                            {
                                                "example_id": "eedb09d9-25dc-4190-8b42-85deaa765238",
                                                "sense_id": "949b30b9-72bd-38d7-923b-c09481ff5ede",
                                                "text": "This involves the reconfiguration of the current track layout at the site, plus the extension of the North Shed and installation of overhead line equipment so that the new fleet can be easily tested."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
