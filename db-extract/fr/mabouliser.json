                "senses": [
                    {
                        "sense_id": "b05b3c99-bc8f-3d9d-902f-f5fdf0bb0843",
                        "entry_id": "759f4920-2887-3ff2-b98b-5bf5f5298523",
                        "glosses": [
                            "Rendre maboul."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "564adb96-9dad-4baa-a32d-0804098d064d",
                                "sense_id": "b05b3c99-bc8f-3d9d-902f-f5fdf0bb0843",
                                "text": "Ça, le blanc n’y croit pas, mais c’est ça l’Afrique : les Indiens, les Béninois, les Sénégalais… ils sont plein pour nous mabouliser."
                            },
                            {
                                "example_id": "97cc2f86-6a1b-44ea-ab90-c63f59317063",
                                "sense_id": "b05b3c99-bc8f-3d9d-902f-f5fdf0bb0843",
                                "text": "Ce régime chante 24/24 D'émergence, réquisitionne les chaines publiques pour mabouliser les citoyens sur ce slogan d'émergence."
                            },
                            {
                                "example_id": "353fc7ce-e6f5-4b3e-8968-4fdc748c1060",
                                "sense_id": "b05b3c99-bc8f-3d9d-902f-f5fdf0bb0843",
                                "text": "Bref « MABOULISER – EXPLOITER – APPAUVRIR » le peuple et le pays pour s'enrichir, dominer et se « dynastiser » en PAIX."
                            }
                        ]
                    }
