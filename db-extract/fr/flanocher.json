                                "example_id": "c16cddf5-de22-45ae-9029-e43d4b8230a8",
                                "sense_id": "a8418a1c-6990-36a8-a968-c14ce98be43a",
                                "text": "On s’en veut d'être forcé d’aller vite en besogne et de ne pouvoir s’attarder et flanocher selon son plaisir dans ce ravissant Carpentras !"
                            },
                            {
                                "example_id": "284e50dc-7c23-4614-8f8b-064d8149a984",
                                "sense_id": "a8418a1c-6990-36a8-a968-c14ce98be43a",
                                "text": "Maintenant, ajoutait-il, il ne s’agit pas de flanocher…"
                            },
                            {
                                "example_id": "bc0f2c06-5bf5-496a-8858-f6743a420a9f",
                                "sense_id": "a8418a1c-6990-36a8-a968-c14ce98be43a",
                                "text": "Et j’ai été flanocher aux Champs-Elysées."
                            }
