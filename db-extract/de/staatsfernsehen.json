                "senses": [
                    {
                        "sense_id": "f3eb62a8-d241-304e-bb19-0df30943c3a5",
                        "entry_id": "c457af53-2eef-3ba5-a88d-bd15c693c4fa",
                        "glosses": [
                            "staatlich kontrolliertes oder betriebenes Fernsehen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b378e83-d569-4085-854e-01f5eaa0c64a",
                                "sense_id": "f3eb62a8-d241-304e-bb19-0df30943c3a5",
                                "text": "„Aufnahmen des ägyptischen Staatsfernsehens zeigen den Sturm der Al-Masri-Fans in Richtung Gästeblock, während die Einsatzkräfte dem Gewaltausbruch scheinbar hilflos gegenüberzustehen.“"
                            },
                            {
                                "example_id": "7cb0e3e7-7d29-4ba8-87f7-37e72c77db7a",
                                "sense_id": "f3eb62a8-d241-304e-bb19-0df30943c3a5",
                                "text": "„Erst als alle ausländischen Sender, inklusive des chinesischen Staatsfernsehens, über die Proteste berichteten, beendeten die größten Fernsehanstalten der Türkei ihre Kochshows und Tiersendungen.“"
                            },
                            {
                                "example_id": "78057144-ba9c-4c6c-971d-ba4ca3f0bd9a",
                                "sense_id": "f3eb62a8-d241-304e-bb19-0df30943c3a5",
                                "text": "„Kulturschaffende schauen zum Staatsfernsehen als Standard hinauf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
