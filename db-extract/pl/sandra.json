                                "target_senses": [
                                    {
                                        "sense_id": "48dfde99-dd83-361c-9f77-27d5b3e1f43e",
                                        "entry_id": "f08a5ad6-7a49-3c09-8b1a-002779b4e843",
                                        "glosses": [
                                            "Prénom féminin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d950488-ae73-4378-8971-e519d31613f2",
                                                "sense_id": "48dfde99-dd83-361c-9f77-27d5b3e1f43e",
                                                "text": "La soirée d’ouverture aura lieu ce mercredi 3 août, à partir de 21 h, avec, en point d’orgue, de 22 h à 23 h, dans une mélango, la participation du couple de maestros Sandra Messina et Ricardo Calvo."
                                            },
                                            {
                                                "example_id": "7b67f599-6f7f-46a8-ad2c-31bc201d2c5b",
                                                "sense_id": "48dfde99-dd83-361c-9f77-27d5b3e1f43e",
                                                "text": "Sous le choc, Sandra Lorenzo ne pense même pas à un éventuel arrêt maladie."
                                            },
                                            {
                                                "example_id": "cb6ae7fc-4a74-4d94-9ced-5b11b3f62daa",
                                                "sense_id": "48dfde99-dd83-361c-9f77-27d5b3e1f43e",
                                                "text": "Sandra Métayer, coordinatrice de Coalition eau, fédération d’ONG françaises, prévient tout de suite : cette conférence n’accouchera d’aucun accord contraignant pour les 193 États participants."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1364e919-4eaa-46b8-80d5-66fed0b597b4",
                        "source_entry_id": "e6560535-2cd2-36c4-b22c-4fd7b6941f49",
