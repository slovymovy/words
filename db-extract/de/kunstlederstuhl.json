                        "examples": [
                            {
                                "example_id": "4818edd6-140c-422b-a0cf-1b204d871343",
                                "sense_id": "08500de0-8852-3f90-a384-421b3757b733",
                                "text": "„Claube erhob sich aus einem Kunstlederstuhl, und wir umarmten uns.“"
                            },
                            {
                                "example_id": "76b16fd6-1ff5-4ed1-8efb-a80383ea009f",
                                "sense_id": "08500de0-8852-3f90-a384-421b3757b733",
                                "text": "„Ich trotte wieder ins Wohnzimmer, das spärlich möbliert ist: ein Glastisch mit sechs Kunstlederstühlen, ein großes und ein kleines Sofa, beide grün und beide hässlich, zwei Sitzsäcke, auf denen zur Not jemand schlafen könnte.“"
                            }
                        ],
