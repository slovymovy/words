                ],
                "senses": [
                    {
                        "sense_id": "2bac279d-67b2-35ba-8864-b1f82ec75750",
                        "entry_id": "08946b10-9c8c-3dc0-894a-c6e0c89a3e46",
                        "glosses": [
                            "Sorte de ménestrelle qui allait, chantant des poèmes ou récitant des contes, dans les cours des princes et dans les maisons des grands seigneurs."
                        ],
                        "tags": [
                            "Middle-Ages"
                        ],
                        "examples": [
                            {
                                "example_id": "b58a3e81-5d44-4441-9411-8db1f9a6b3c7",
                                "sense_id": "2bac279d-67b2-35ba-8864-b1f82ec75750",
                                "text": "Dans les quadrilobes de Cologne, le joueur de vièle fait danser une femme aux cheveux dénoués, peut-être une jongleresse."
                            },
                            {
                                "example_id": "c3b12118-0261-4095-abce-9b87d6577806",
                                "sense_id": "2bac279d-67b2-35ba-8864-b1f82ec75750",
                                "text": "Outre les jongleresses itinérantes, il y avait également des jongleresses sédentaires dans les riches cours ou les grandes villes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7ed115e0-d06f-4503-ba35-e12c0cbd5fd6",
                        "source_entry_id": "08946b10-9c8c-3dc0-894a-c6e0c89a3e46",
                        "source_sense_id": "2bac279d-67b2-35ba-8864-b1f82ec75750",
                        "target_lang_word": "entertainer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "entertainer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a7cd900b-a5d1-3e62-9d17-a8f6ac59097c",
                                        "entry_id": "4702327b-5aaf-354c-8867-86d20b05164c",
                                        "glosses": [
                                            "A person who entertains others, esp. as a profession, as a singer, actor, presenter, dancer, musician, magician, comedian, etc."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1d88351a-b63d-3947-b055-b0f7b3e56bb3",
                                        "entry_id": "4702327b-5aaf-354c-8867-86d20b05164c",
                                        "glosses": [
                                            "Someone who puts on a show for the entertainment or enjoyment of others."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "532c6804-1835-3e03-87cf-1c4a6d6daaa8",
                                        "entry_id": "4702327b-5aaf-354c-8867-86d20b05164c",
                                        "glosses": [
                                            "One who accommodates guests."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1c07bad-19dc-4214-b347-23cfc34d491b",
                                                "sense_id": "532c6804-1835-3e03-87cf-1c4a6d6daaa8",
                                                "text": "During my sickness I was constantly and tenderly cared for by Mrs. Anderson, and at short intervals I received visits from both my children, so that upon the whole, I do not regard this as the least unpleasant portion of my life. I had the fullest sympathy of my entertainer—a blessing which had been denied for me many long years."
                                            },
                                            {
                                                "example_id": "36a89436-d374-4d2d-8410-fe1540597016",
                                                "sense_id": "532c6804-1835-3e03-87cf-1c4a6d6daaa8",
                                                "text": "I am not an entertainer by any means. I do not own coasters or wine glasses and I’d rather spend a Saturday night figuring out what to do with my sourdough starter discard than playing hostess."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8c8b476b-35b4-49e4-8b63-8cc667a909d4",
                        "source_entry_id": "08946b10-9c8c-3dc0-894a-c6e0c89a3e46",
                        "source_sense_id": "2bac279d-67b2-35ba-8864-b1f82ec75750",
                        "target_lang_word": "joculatrix",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "joculatrix",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "65042f8e-9252-3ef4-bd46-2bfd83c029a2",
                                        "entry_id": "047a5a6b-18f6-360e-a3cb-a457118bcf89",
                                        "glosses": [
                                            "A female joculator; a female jester, comedian or entertainer."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fbb913e0-81d7-4b0d-b507-4655f9e909de",
                                                "sense_id": "65042f8e-9252-3ef4-bd46-2bfd83c029a2",
                                                "text": "Joculator Regis is an officer holding no less than three vills in the return of the Domesday Survey for Gloucestershire; and in the same survey, in Surrey, we have a Joculatrix."
                                            },
                                            {
                                                "example_id": "e10a50bc-c93c-4870-bb4c-f6f7e9bf85d9",
                                                "sense_id": "65042f8e-9252-3ef4-bd46-2bfd83c029a2",
                                                "text": "He had heard that in far-away France the motley was not confined to men. Had not Jeanne, queen of Charles I, possessed her jestress, Artaude de Puy, \"folle to our dear companion,\" as said the king? Had not Madame d'Or, wearer of the bells, kept the nobles laughing? Had not the haughty, eccentric Don John, his handsome, merry joculatrix, attached to his princely household?"
                                            },
                                            {
                                                "example_id": "4db4e2df-80d7-4012-8381-494a2cda53b0",
                                                "sense_id": "65042f8e-9252-3ef4-bd46-2bfd83c029a2",
                                                "text": "Other artistic endeavours such as dance or musical performances are lost at the moment they are completed: how Adelina the 'joculatrix' mentioned in the Domesday Book came by her surname is now impossible to discover—the term may mean 'singer' or 'entertainer'."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
