                                "sense_id": "bf59724f-ec71-35b6-8062-6f788c34f5d5",
                                "text": "Afrykatami są np. polskie spółgłoski „c” oraz „cz”."
                            },
                            {
                                "example_id": "2bc74065-1321-4971-9b0c-d5be4e976079",
                                "sense_id": "bf59724f-ec71-35b6-8062-6f788c34f5d5",
                                "text": "Artykulacja każdej afrykaty składa się z dwu faz: zwartej i szczelinowej."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
