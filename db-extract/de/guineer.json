                            {
                                "example_id": "9da13910-7096-4442-80b8-c96b58bea869",
                                "sense_id": "2b2f0aad-ecd3-353e-b517-5ffd3250c790",
                                "text": "„Die Migration stellt daher für die Generation der untersuchten Guineer die einzige Gewähr für eine realistische berufliche Perspektive dar.“"
                            },
                            {
                                "example_id": "c9f9b17c-78fd-4c8f-8b24-2985791c47b0",
                                "sense_id": "2b2f0aad-ecd3-353e-b517-5ffd3250c790",
                                "text": "„Private Apotheken verfügten über Medikamente, doch seien diese für viele Guineer unerschwinglich.“"
                            },
                            {
                                "example_id": "66fd2e1e-1eb8-4961-98ae-7063205c4983",
                                "sense_id": "2b2f0aad-ecd3-353e-b517-5ffd3250c790",
                                "text": "„Er trieb eine halbe Million Guineer ins Exil.“"
                            }
                        ],
