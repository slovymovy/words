                                "target_senses": [
                                    {
                                        "sense_id": "a3388bc1-0f8b-311a-b1d7-28431aa1a60d",
                                        "entry_id": "ce169d71-2c53-3642-abf6-be16b9d1c6c7",
                                        "glosses": [
                                            "in het geheugen bewaren"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "94810529-c6a5-47d0-88df-ba5cd2c28b24",
                                                "sense_id": "a3388bc1-0f8b-311a-b1d7-28431aa1a60d",
                                                "text": "Een olifant onthoudt alles."
                                            },
                                            {
                                                "example_id": "fd0af7e4-5e93-4e52-a92e-ca4dc7cb4959",
                                                "sense_id": "a3388bc1-0f8b-311a-b1d7-28431aa1a60d",
                                                "text": "Maar word je wel onthouden zoals je echt was? Gijs Het woord 'wandelen' werd in het jaar 1201 voor het eerst opgeschreven door een ijverige monnik, maar het is zeker veel ouder."
                                            },
                                            {
                                                "example_id": "29f938ac-d5cd-480c-81c1-9efc0258d31e",
                                                "sense_id": "a3388bc1-0f8b-311a-b1d7-28431aa1a60d",
                                                "text": "Ze had al drie keer dezelfde droom gehad en dat verontrustte haar, niet alleen vanwege de inhoud, maar ook omdat ze zich dromen normaal gesproken niet herinnerde, terwijl deze droom heel gemakkelijk te onthouden was."
                                            },
                                            {
                                                "example_id": "722d4a87-c5e2-437b-b1ee-19230f8849e5",
                                                "sense_id": "a3388bc1-0f8b-311a-b1d7-28431aa1a60d",
                                                "text": "In een oude National Geographic had ik ooit als kind een artikel over deze trail gelezen, 4.286 kilometer door Amerika. Dit heb ik altijd onthouden, maar ik had nooit gedacht dat zo’n lange wandeltocht voor mij weggelegd zou zijn."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fde11a9b-411e-31c9-87f8-51777514ec34",
                                        "entry_id": "ce169d71-2c53-3642-abf6-be16b9d1c6c7",
                                        "glosses": [
                                            "zich ~: bewust iets niet doen of van iets afzien, hoewel er een wens of behoefte naar is"
                                        ],
                                        "tags": [
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "78c5a9ba-6508-4012-ac5b-241558f86649",
                                                "sense_id": "fde11a9b-411e-31c9-87f8-51777514ec34",
                                                "text": "Zij onthielden zich van geslachtsgemeenschap."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d0472f36-f8b3-3e0a-809b-54e40e911e8c",
                                        "entry_id": "ce169d71-2c53-3642-abf6-be16b9d1c6c7",
                                        "glosses": [
                                            "zich ~: bewust iets niet doen of van iets afzien, hoewel er een wens of behoefte naar is",
                                            "zich ~: bewust niet gebruikmaken van het recht om aan een stemming deel te nemen"
                                        ],
                                        "tags": [
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "00a87ed1-105d-4c76-aca2-6a524cc4300e",
                                                "sense_id": "d0472f36-f8b3-3e0a-809b-54e40e911e8c",
                                                "text": "Zij onthielden zich van geslachtsgemeenschap."
                                            },
                                            {
                                                "example_id": "f92a8acd-b09c-48c3-8f54-13292d8345d5",
                                                "sense_id": "d0472f36-f8b3-3e0a-809b-54e40e911e8c",
                                                "text": "Zij onthielden zich van stemming."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "76074797-889a-3804-b041-24d9ae53512c",
                                        "entry_id": "ce169d71-2c53-3642-abf6-be16b9d1c6c7",
