                "senses": [
                    {
                        "sense_id": "de3c4461-2177-35a2-9e35-72454b54c7a9",
                        "entry_id": "1bc00201-570a-33d5-adef-4e9601d18824",
                        "glosses": [
                            "het beantwoorden van (levens)vragen met behulp van een pendel, een vaak druppelvormig metalen, glazen of houten voorwerp aan een draad of kettinkje."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "663523b9-bd05-4268-821d-81ff0dabcc56",
                                "sense_id": "de3c4461-2177-35a2-9e35-72454b54c7a9",
                                "text": "Er is geen wetenschappelijk bewijs dat pendelen werkt."
                            }
                        ]
                    },
                    {
                        "sense_id": "de9e3872-c250-303e-a8c4-c64ccd58e026",
                        "entry_id": "1bc00201-570a-33d5-adef-4e9601d18824",
                        "glosses": [
                            "regelmatig heen en weer reizen tussen woon- en werkplaats (forensisme)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ef5a422-84bf-4def-8d16-5ed1623f6147",
                                "sense_id": "de9e3872-c250-303e-a8c4-c64ccd58e026",
                                "text": "Veen mensen pendelen tussen Zoetermeer en Den Haag."
                            }
                        ]
                    },
                    {
                        "sense_id": "19ff3e94-999c-3cbc-8e89-8c5710b772a3",
