                        "glosses": [
                            "Faire cesser d’être irradié."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a568e08-3fdc-4816-a683-97e5613a683a",
                                "sense_id": "1f28d6a3-adeb-37e7-9322-afd9086fa55f",
                                "text": "Et d’entreprendre des recherches pour « désirradier » les déchets nucléaires existants."
                            },
                            {
                                "example_id": "d8329f66-618e-4f0d-825f-d6d7e670e750",
                                "sense_id": "1f28d6a3-adeb-37e7-9322-afd9086fa55f",
                                "text": "Va chez Belon, il a besoin de courir la nuit sur la plage pour se désirradier…"
                            },
                            {
                                "example_id": "8c96893a-4fdb-4a9d-9321-3e30149d11c7",
                                "sense_id": "1f28d6a3-adeb-37e7-9322-afd9086fa55f",
                                "text": "On comprend aisément pourquoi il est possible de décontaminer et impossible de désirradier."
                            }
                        ]
                    }
