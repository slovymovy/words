                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e513d8f7-f106-45af-be21-ee68ff8c58e8",
                                "sense_id": "9600d548-a57b-3bc3-a7cd-f3b7fc755811",
                                "text": "Hij koesterde een grote genegenheid voor die rakker van een buurjongen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3fe0d715-7d3c-401e-bbaf-3eba8f0e536e",
                        "source_entry_id": "0a886d39-e36c-3a99-a6da-fd504ea6a846",
                        "source_sense_id": "9600d548-a57b-3bc3-a7cd-f3b7fc755811",
                        "source_sense_description": "het gesteld zijn op iemand",
                        "target_lang_word": "Zuneigung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zuneigung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8812788d-6dd2-36b9-a419-44a83c476134",
                                        "entry_id": "911ef1e8-73a0-3eb5-8b56-2b0a94c7c432",
                                        "glosses": [
                                            "Gefühl der Freundschaft, Liebe für jemanden"
                                        ],
                                        "tags": [
                                            "Plural selten"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9096685c-867a-440d-98ef-fd2f64a7e3ba",
                                                "sense_id": "8812788d-6dd2-36b9-a419-44a83c476134",
                                                "text": "Sein Stehvermögen hat ihm erst Respekt und jetzt sogar Zuneigung eingebracht."
                                            },
                                            {
                                                "example_id": "3b3777ae-b212-4752-810d-71fc7b5c770a",
                                                "sense_id": "8812788d-6dd2-36b9-a419-44a83c476134",
                                                "text": "„Man muß diese Zuneigung viel zu hoch bezahlen, wenn man nicht gerade ein Objekt ihrer Leidenschaft ist.“"
                                            },
                                            {
                                                "example_id": "83282b05-8669-4be9-9fb5-ae0c5c084fba",
                                                "sense_id": "8812788d-6dd2-36b9-a419-44a83c476134",
                                                "text": "„Genau so sah man aus, wenn man das Glück hatte, Vals Zuneigung geschenkt zu bekommen.“"
                                            },
                                            {
                                                "example_id": "a76f7dd5-307f-4640-872c-9713cc9e6f00",
                                                "sense_id": "8812788d-6dd2-36b9-a419-44a83c476134",
                                                "text": "„Da war für leidenschaftliche Zuneigung kein Platz.“"
                                            },
                                            {
                                                "example_id": "68810106-ad0b-45e4-96e6-f95a3340899f",
                                                "sense_id": "8812788d-6dd2-36b9-a419-44a83c476134",
                                                "text": "„Da ich eine ganz besondere Zuneigung für die Tiere empfand, beglückten mich meine Eltern gern mit allerlei Lieblingen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6ec9f10a-8285-490e-aee7-dc2cd01c422f",
                        "source_entry_id": "0a886d39-e36c-3a99-a6da-fd504ea6a846",
                        "source_sense_id": "9600d548-a57b-3bc3-a7cd-f3b7fc755811",
                        "source_sense_description": "het gesteld zijn op iemand",
                        "target_lang_word": "fondness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fondness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "868fafde-d864-3b9b-b616-44c815df2f51",
                                        "entry_id": "25107829-ae68-3eb6-8549-3c848b3f94b2",
                                        "glosses": [
                                            "The quality of being fond: liking something, foolishness; doting affection; propensity."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fe20465a-1606-48f8-8b9d-b396450038a9",
                                                "sense_id": "868fafde-d864-3b9b-b616-44c815df2f51",
                                                "text": "I stopped taking the sweets and condiments I had got from home. The mind having taken a different turn, the fondness for condiments wore away, and I now relished the boiled spinach which in Richmond tasted insipid, cooked without condiments. Many such experiments taught me that the real seat of taste was not the tongue but the mind."
                                            },
                                            {
                                                "example_id": "d767654f-e62d-471e-b137-676c976c4cd8",
                                                "sense_id": "868fafde-d864-3b9b-b616-44c815df2f51",
                                                "text": "Britain's contribution to railway film history has been very great and can be almost entirely laid at the door of that very fine producer Sir Michael Balcon, who I suspect has a secret fondness for trains himself, so many railway pictures has he caused to be made."
                                            },
                                            {
                                                "example_id": "03c1125e-48e2-4858-8dad-229b59ea40ef",
                                                "sense_id": "868fafde-d864-3b9b-b616-44c815df2f51",
                                                "text": "Trump’s grotesque and incomprehensible fondness for Putin makes the details of any deal highly dangerous for Europe and the NATO alliance, founded to confront Russia."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "91c4e970-6cca-4a33-b0cf-c494f4f0f2ad",
                        "source_entry_id": "0a886d39-e36c-3a99-a6da-fd504ea6a846",
                        "source_sense_id": "9600d548-a57b-3bc3-a7cd-f3b7fc755811",
                        "source_sense_description": "het gesteld zijn op iemand",
                        "target_lang_word": "affection",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "affection",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "aa02b624-ab71-362f-877a-36f29a75b54d",
                                        "entry_id": "a44cd4cd-7351-31cd-9927-7c1bbb80d09c",
                                        "glosses": [
                                            "Sentiment d’aimer quelqu’un avec attachement ou tendresse, et qui nous porte à vouloir son bien-être ou son bonheur ; amitié ou amour non passionnel ou romantique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "702b5747-5e7d-493a-a272-fa34a454695a",
                                                "sense_id": "aa02b624-ab71-362f-877a-36f29a75b54d",
                                                "text": "Et si les sentiments de jalousie demeurent dans le cœur de chacun vis-à-vis de l’autre, ce n’est pas dans la douleur d’une affection déçue qu’ils résident ; c’est dans l’instinct de propriété."
                                            },
                                            {
                                                "example_id": "07144d7e-2c6e-4b04-b94a-6ddb42296e26",
                                                "sense_id": "aa02b624-ab71-362f-877a-36f29a75b54d",
                                                "text": "Il s’était excusé sur sa peur des amitiés nouvelles, ce qu’il avait appelé, par galanterie, sa peur d’être malheureux. « Vous avez peur d’une affection ? comme c’est drôle, moi qui ne cherche que cela, qui donnerais ma vie pour en trouver une, avait-elle dit d’une voix si naturelle, si convaincue, qu’il en avait été remué."
                                            },
                                            {
                                                "example_id": "8c0a88e7-85ab-43fc-809c-51b44ef55b5a",
                                                "sense_id": "aa02b624-ab71-362f-877a-36f29a75b54d",
                                                "text": "Thomyra est l’amie et l’amante de la belle fille qui se nomme Penthésilée, et elle craint de perdre une affection qui lui est chère, si elle devient grosse des œuvres du captif."
                                            },
                                            {
                                                "example_id": "d95f44f4-d0b8-4b46-87be-376b3aee51bd",
                                                "sense_id": "aa02b624-ab71-362f-877a-36f29a75b54d",
                                                "text": "Avec beaucoup de tact, ce vieillard, qui savait n’être ni autoritaire ni égoïste, s’efforçait de gagner l’affection de Nazira et de se faire pardonner d’être vieux."
                                            },
                                            {
                                                "example_id": "cc25b598-4cd4-4415-b01d-38ece9e7c78a",
                                                "sense_id": "aa02b624-ab71-362f-877a-36f29a75b54d",
                                                "text": "À ses remerciements, Olga avait répondu : « Mais, madame, c’est par affection. » Maman répéta plusieurs fois d’un air rêveur et pénétré : « Elle m’a dit : c’est par affection. »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "49e9e804-106b-3eff-ad52-c61bdeb7c997",
                                        "entry_id": "a44cd4cd-7351-31cd-9927-7c1bbb80d09c",
                                        "glosses": [
                                            "Divers mouvements de l’âme."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4f8023a4-bcd9-40ef-b671-485bc725624f",
                                                "sense_id": "49e9e804-106b-3eff-ad52-c61bdeb7c997",
                                                "text": "Les affections de l’âme."
                                            },
                                            {
                                                "example_id": "2eb6771d-2f7f-4aac-99ef-dc5a4dc7c332",
                                                "sense_id": "49e9e804-106b-3eff-ad52-c61bdeb7c997",
                                                "text": "Affections humaines, naturelles."
                                            },
                                            {
                                                "example_id": "d1e40cae-b5b4-4c56-80c6-aeb85d2dbdda",
                                                "sense_id": "49e9e804-106b-3eff-ad52-c61bdeb7c997",
                                                "text": "Toutes ses affections sont douces."
                                            },
                                            {
                                                "example_id": "8a507577-7727-4c5e-99da-dcb3d05268a1",
                                                "sense_id": "49e9e804-106b-3eff-ad52-c61bdeb7c997",
                                                "text": "Affections déréglées."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "86b7c318-9ccf-3513-b3e2-9ec8cfdebe3d",
                                        "entry_id": "a44cd4cd-7351-31cd-9927-7c1bbb80d09c",
                                        "glosses": [
                                            "Maladie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec098611-5b07-4415-967b-57f0854cb9d9",
                                                "sense_id": "86b7c318-9ccf-3513-b3e2-9ec8cfdebe3d",
                                                "text": "Maxime eut soin de se placer à une certaine distance de quelques vieillots qui par habitude se mettent en espalier, dès une heure après midi, pour sécher leurs affections rhumatiques."
                                            },
                                            {
                                                "example_id": "03c205d0-d60b-4ce2-b182-301350bb4653",
                                                "sense_id": "86b7c318-9ccf-3513-b3e2-9ec8cfdebe3d",
                                                "text": "Ce troupeau appartenait au juge de Werst, le biró Koltz, lequel payait à la commune un gros droit de brébiage, et qui appréciait fort son pâtour Frik, le sachant très habile à la tonte, et très entendu au traitement des maladies, muguet, affilée, avertin, douve, encaussement, falère, clavelée, piétin, rabuze et autres affections d’origine pécuaire."
                                            },
                                            {
                                                "example_id": "f2ea946d-0ec3-44b3-ba49-2dc3299f5896",
                                                "sense_id": "86b7c318-9ccf-3513-b3e2-9ec8cfdebe3d",
                                                "text": "Outre les traumatismes et brûlures par produits chimiques, les affections de la langue les plus fréquentes chez les bovins sont l’actinobacillose ou langue de bois et la nécrobacillose."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "deafe52b-8b8b-42fb-ab9f-78ff3d22a8b9",
                        "source_entry_id": "0a886d39-e36c-3a99-a6da-fd504ea6a846",
                        "source_sense_id": "9600d548-a57b-3bc3-a7cd-f3b7fc755811",
