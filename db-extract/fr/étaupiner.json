                        "glosses": [
                            "Débarrasser des taupinières."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "73c47a03-b137-4d46-a208-e3ca56d04578",
                                "sense_id": "608749ea-64bf-3dbf-91ad-c1600ff0a73e",
                                "text": "Il eût été bien difficile de le rejoindre quand, par-dessus les échaliers, il était passé d’un champ à un autre, échardonnant ici, étaupinant là, coupant les vipères en deux."
                            },
                            {
                                "example_id": "36dd280a-37d4-4fef-99cc-fbbf52f74864",
                                "sense_id": "608749ea-64bf-3dbf-91ad-c1600ff0a73e",
                                "text": "L’abbé Souillet doit donc travailler et, après la messe et le catéchisme, il cultive, bêche, retourne la terre et étaupine sans perdre de temps."
                            }
                        ]
                    }
