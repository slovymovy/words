                "senses": [
                    {
                        "sense_id": "e713ee01-a72a-341b-b33a-070fec4bf62f",
                        "entry_id": "0e7169b6-88dc-37ed-b950-2adbcfb381af",
                        "glosses": [
                            "ehemalige Stadt in Mexiko, heute Bezirk von Mexiko-Stadt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b5fed220-6019-4cfc-a38f-1b73a3fa2fcd",
                                "sense_id": "e713ee01-a72a-341b-b33a-070fec4bf62f",
                                "text": "„Beide hatten gehört, dass die Spanier ihre riesigen Doggen in den schönen Städten von Texcoco und Xochimilco auf die Menschen hetzten und sie sogar manchmal von den Hunden töten ließen, wenn jemand leugnete, etwas über den Verleib der Goldschätze zu wissen.“"
                            },
                            {
                                "example_id": "8b88fc8f-3213-446c-beaa-395e9998ecdd",
                                "sense_id": "e713ee01-a72a-341b-b33a-070fec4bf62f",
                                "text": "„Das am Südufer des Texcoco-Sees gelegene Xochimilco beantragte zum Beispiel 1563 bei der Krone Tributbefreiung mit der Begründung, die Spanier nie bekriegt und ihrem Encomendero Jorge de Alvarado 2500 Krieger und Träger sowie Proviant für die Eroberung von Honduras und Guatemala gestellt zu haben.“"
                            },
                            {
                                "example_id": "947fd48a-7af1-425a-9d93-d832b493ac5b",
                                "sense_id": "e713ee01-a72a-341b-b33a-070fec4bf62f",
                                "text": "„Manche Stadtstaaten oder ethnische Gruppen waren berühmt für bestimmte Erzeugnisse und Fertigkeiten, so etwa Xochimilco für Edelsteine, Texcoco für polychrome Töpferwaren oder Coyoacán für seine Maurer.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
