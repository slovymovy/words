                        "form": "der Erotik"
                    },
                    {
                        "form_id": "372332dc-7e53-40ec-8709-b0d5bbb74e5c",
                        "entry_id": "f0099ef9-3316-3a33-8860-d6126c83fb7d",
                        "tags": [
                            "accusative",
