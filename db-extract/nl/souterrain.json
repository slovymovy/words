                                            {
                                                "example_id": "cccb8f49-62bb-4e75-8a2b-1808bbb352b4",
                                                "sense_id": "f4707eda-c5ff-35d4-8c2f-2ff1da9106a5",
                                                "text": "The Tigers have been in the cellar all year long, and I'm tired of it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "db3f6d09-67f6-3a62-92a1-0147ad9c25b2",
                                        "entry_id": "a9e93ab0-4edb-3a77-becf-cc26d3100fcf",
                                        "glosses": [
                                            "A basement."
