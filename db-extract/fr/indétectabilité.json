                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e46e0a03-6762-48fb-8746-e687b515dd4b",
                                                "sense_id": "4e24cb0a-a65a-3658-b8cc-a7ee20fcd346",
                                                "text": "In particular, embedding capacity, robustness, and undetectability are mutually conflicting and cannot all be achieved by the same algorithm."
                                            },
                                            {
                                                "example_id": "50b7cf64-3666-4f0f-aa26-6a2745925050",
                                                "sense_id": "4e24cb0a-a65a-3658-b8cc-a7ee20fcd346",
                                                "text": "The highest degrees of anonymity are undetectability and unobservability."
                                            },
                                            {
                                                "example_id": "516971b8-4a9e-47f8-ad03-b82d299ad4f2",
                                                "sense_id": "4e24cb0a-a65a-3658-b8cc-a7ee20fcd346",
                                                "text": "On a high level, undetectability means that no efficient algorithm can distinguish between inter-packet delays of the legitimate traffic and steganographic traffic."
                                            }
