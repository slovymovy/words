                                        "entry_id": "7c3e7a62-3457-31c4-b795-f60c561d0003",
                                        "glosses": [
                                            "A tall, cylindrical Eastern European Easter bread, traditional in the Orthodox Christian faith."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4409d30d-2a8f-4708-af05-71ab95d73359",
                                                "sense_id": "6521b55f-20b7-3efa-ab59-bc8e5a97d2e5",
                                                "text": "One of the most famous of all Easter breads is the Russian kulich, a tall but delicate sweet yeasted bread that is sugared and decorated with the initials XB, which stand for “Christ is risen.”"
                                            }
                                        ]
                                    }
                                ]
