                "senses": [
                    {
                        "sense_id": "a4734f16-8392-3007-80a8-39987dd1a5e5",
                        "entry_id": "101958da-7f21-3cb3-ae97-bf413082d3df",
                        "glosses": [
                            "Bereich, der sich in Feindeshand befindet; Zone, die der Gegner vereinnahmt hat, besitzt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "18ca7fd0-368c-494c-824f-2d19d056bb67",
                                "sense_id": "a4734f16-8392-3007-80a8-39987dd1a5e5",
                                "text": "Er kommt nicht lebendig in die Stadt, sie liegt im Feindesland."
                            },
                            {
                                "example_id": "460a1a30-6597-43bc-910a-8129fab3f815",
                                "sense_id": "a4734f16-8392-3007-80a8-39987dd1a5e5",
                                "text": "Die Spähtruppe ist tief in Feindesland eingedrungen."
                            },
                            {
                                "example_id": "bda3163f-6c74-4008-8fe7-fccc7f10f4d6",
                                "sense_id": "a4734f16-8392-3007-80a8-39987dd1a5e5",
                                "text": "„Noch stand die Wehrmacht zu Jahresbeginn 1945 tief in Feindesland.“"
                            },
                            {
                                "example_id": "a09ee52e-1399-4bb5-86c7-3c1b89268213",
                                "sense_id": "a4734f16-8392-3007-80a8-39987dd1a5e5",
                                "text": "„Diese riss ich mir als rechtmäßige Prise unter den Nagel, denn schließlich befand ich mich in Feindesland.“"
                            },
                            {
                                "example_id": "2d9de168-08e3-4622-942a-c35aba718579",
                                "sense_id": "a4734f16-8392-3007-80a8-39987dd1a5e5",
                                "text": "„Die nicht mehr benötigte Munition und anderes militärisches Gerät ließen sie einfach auf den Wiesen liegen, um Platz zu schaffen für die Mitbringsel aus dem Feindesland.“"
                            },
                            {
                                "example_id": "08ca6e57-0dfc-4f4e-913d-4989dc710d8d",
                                "sense_id": "a4734f16-8392-3007-80a8-39987dd1a5e5",
                                "text": "„So zieht man gern durch Feindesland.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
