                "senses": [
                    {
                        "sense_id": "29e55ec9-cca2-3d60-a03c-f91bcb0fff48",
                        "entry_id": "fb882dfe-df9f-328e-8a91-b0ba6b2ba0ab",
                        "glosses": [
                            "Beseitigung von Mehrdeutigkeit bei sprachlichen Ausdrücken durch den Zusammenhang mit anderen Ausdrücken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "36921b7a-bb63-4c8f-871a-77642f553969",
                                "sense_id": "29e55ec9-cca2-3d60-a03c-f91bcb0fff48",
                                "text": "Ein Ausdruck wie „Die Bank ist groß“ ist ambig (mehrdeutig): „Bank“ kann hier als Möbel oder als Geldinstitut verstanden werden. Disambiguierung erfolgt dann, wenn der sprachliche Kontext nur noch eine Bedeutung für „Bank“ zulässt, z.B. in: „Ich setze mich auf die Bank“ oder „Ich hebe in der Bank Geld ab.“"
                            },
                            {
                                "example_id": "e574e6df-0fb2-461b-9e89-038538e5ed80",
                                "sense_id": "29e55ec9-cca2-3d60-a03c-f91bcb0fff48",
                                "text": "„Fraglich ist, inwieweit das lateinische Alphabet eine solche Disambiguierung zu leisten vermag.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9d114de9-e518-434b-b92e-d89357b3e6cc",
                        "source_entry_id": "fb882dfe-df9f-328e-8a91-b0ba6b2ba0ab",
                        "source_sense_id": "29e55ec9-cca2-3d60-a03c-f91bcb0fff48",
                        "source_sense_description": "Beseitigung von Mehrdeutigkeit bei sprachlichen Ausdrücken durch Verbindung mit anderen Ausdrücken",
                        "target_lang_word": "disambiguation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "disambiguation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "64f4de21-0c70-3b7a-97f6-85a277d3e81d",
                                        "entry_id": "09e05570-a2ba-3629-9693-536288e4a2e1",
                                        "glosses": [
                                            "The removal of ambiguity."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7aad4b0c-43d0-4a5f-88cf-b9f871136f32",
                                                "sense_id": "64f4de21-0c70-3b7a-97f6-85a277d3e81d",
                                                "text": "The lexical disambiguation relies on looking ahead to identify possible senses."
                                            },
                                            {
                                                "example_id": "8825bd8e-0787-4c42-97d7-a135ff4a37b2",
                                                "sense_id": "64f4de21-0c70-3b7a-97f6-85a277d3e81d",
                                                "text": "Disambiguation — where it is to fix the sense of an ambiguous term. This operation has been termed distinction by some Logicians, and erroneously reckoned as a species of division."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3b1c666a-cd74-3e98-9619-b5746851cc2f",
                                        "entry_id": "09e05570-a2ba-3629-9693-536288e4a2e1",
                                        "glosses": [
                                            "A page on a wiki containing links to two or more topics with the same name."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f7bdebc3-1340-4965-bd07-42a887624c4c",
                        "source_entry_id": "fb882dfe-df9f-328e-8a91-b0ba6b2ba0ab",
                        "source_sense_id": "29e55ec9-cca2-3d60-a03c-f91bcb0fff48",
                        "source_sense_description": "Beseitigung von Mehrdeutigkeit bei sprachlichen Ausdrücken durch Verbindung mit anderen Ausdrücken",
                        "target_lang_word": "désambiguïsation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "désambiguïsation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "587ada2d-9036-37f0-82ef-beab61fb7755",
                                        "entry_id": "db3e76c8-70e1-3041-bfbf-f0dabe8e23a6",
                                        "glosses": [
                                            "Action de désambiguïser ou résultat de cette action."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a48be204-15d5-4405-a07f-def004dcfaba",
                                                "sense_id": "587ada2d-9036-37f0-82ef-beab61fb7755",
                                                "text": "Mais le locuteur court le risque de l’ambiguïté. Dans ces conditions, le rétablissement ou le réajustement du sens exige des moyens linguistiques et extralinguistiques de désambiguïsation."
                                            },
                                            {
                                                "example_id": "a4f0662e-7ac5-46f9-a8d3-ac7a960599bf",
                                                "sense_id": "587ada2d-9036-37f0-82ef-beab61fb7755",
                                                "text": "La position de Kripke, très fortement influencée par Grice, est claire sur ce point. Selon lui, deux processus pragmatiques (et deux seulement) interviennent dans la détermination de ce qui est dit, à savoir :\n(i) la désambiguïsation lexicale (par ex. le mot anglais « bank » peut signifier la berge ou l’établissement bancaire) ;\n(ii) la saturation indexicale (par ex. le pronom anglais « it » peut désigner des choses différentes selon son contexte d’utilisation)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
