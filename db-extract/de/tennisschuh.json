                "senses": [
                    {
                        "sense_id": "c883747a-e42a-3a67-b6d7-8938bbf2473d",
                        "entry_id": "b9cab41b-9cb5-3e2c-ba44-c16fdc8a61d6",
                        "glosses": [
                            "flexibler, absatzloser, meist weißer Sportschuh, der vor allem beim Tennis getragen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "87acba8c-7677-43fd-bc8d-406c78e37c97",
                                "sense_id": "c883747a-e42a-3a67-b6d7-8938bbf2473d",
                                "text": "„Eric Hansen wählt die altmodische Methode. Er drückt seinen weißen Tennisschuh in den Rasen, hebt den Fuß und wartet, ob sich die Grashalme wieder aufstellen.“"
                            },
                            {
                                "example_id": "e093ca51-882c-4bb7-aa41-494e55161531",
                                "sense_id": "c883747a-e42a-3a67-b6d7-8938bbf2473d",
                                "text": "„Puma legte den Tennisschuh, den Boris Becker bei seinem Wimbledon-Sieg trug, als Freizeitmodell neu auf.“"
                            },
                            {
                                "example_id": "d67acc9a-f03b-4de6-9d1b-e83e0bcb8df2",
                                "sense_id": "c883747a-e42a-3a67-b6d7-8938bbf2473d",
                                "text": "„Sie trug weiße Tennisschuhe, eine enge Trainingshose, die ihre stämmigen Waden betonte, und einen violetten Pulli.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
