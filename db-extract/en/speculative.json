                        "form": "more speculative"
                    },
                    {
                        "form_id": "53461e25-ffa6-4db1-a3c0-6d808672c2c4",
                        "entry_id": "6f2ee8af-7ac2-39a7-977a-0c2a730ba1e7",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most speculative"
