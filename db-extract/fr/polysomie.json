                        "entry_id": "562b0b35-ea7e-3e93-9e5b-87eb3e487b8f",
                        "glosses": [
                            "Situation dans laquelle une cellule ou un organisme possède un ou plusieurs chromosomes en excès par rapport au nombre caractéristique de son espèce ou de son type cellulaire."
                        ],
                        "tags": [
                            "Génétique"
                        ],
                        "examples": [
                            {
                                "example_id": "0d6a6c0e-eefd-492d-b1f1-26a41c34a54a",
                                "sense_id": "89839d68-a97f-3697-88f4-decec577e74e",
                                "text": "Elle peut être liée à une polysomie, sans augmentation de l’expression de la protéine."
                            },
                            {
                                "example_id": "69f2dc66-a9f7-45fb-a748-658665e51164",
                                "sense_id": "89839d68-a97f-3697-88f4-decec577e74e",
                                "text": "Chez la levure haploïde Saccharomyces cerevisiae, une polysomie peut survenir spontanément, avec la présence de deux copies d’un chromosome dans un génome normalement haploïde."
                            }
                        ]
                    }
                ],
