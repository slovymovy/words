                "senses": [
                    {
                        "sense_id": "a97f5622-3374-3f8f-ad46-7ad0604d8629",
                        "entry_id": "da993044-aa2a-3115-9839-c0617a94c07d",
                        "glosses": [
                            "предназначенный, приспособленный для чтения"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "38b573e2-9499-42aa-962f-0b47f3f2cb51",
                                "sense_id": "a97f5622-3374-3f8f-ad46-7ad0604d8629",
                                "text": "Встала, взяла с полки один из цилиндров, вынула из него костяной валик и вложила в читальный, с экраном, столик."
                            },
                            {
                                "example_id": "6643131d-c9ee-4a2c-b85a-857282b4bea4",
                                "sense_id": "a97f5622-3374-3f8f-ad46-7ad0604d8629",
                                "text": "Здесь превосходная библиотека и хороший читальный зал."
                            }
                        ]
                    }
                ],
