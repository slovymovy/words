                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0733f303-267c-4fee-94be-103ea040f563",
                                                "sense_id": "ef923acb-3b3f-32e7-9e28-f936f62e3964",
                                                "text": "In den Ferien fahren wir nach Peking."
                                            },
                                            {
                                                "example_id": "059a526f-5cdb-44f2-99de-1443428731a7",
                                                "sense_id": "ef923acb-3b3f-32e7-9e28-f936f62e3964",
                                                "text": "„Google hatte mit der Regierung in Peking Anfang des Jahres im Streit gelegen, weil der Konzern nach einer Hacker-Attacke die übliche Zensur von offizieller Seite nicht mehr hinnehmen wollte.“"
                                            },
                                            {
                                                "example_id": "c533b1cf-a712-4998-9a5c-256a73566b83",
                                                "sense_id": "ef923acb-3b3f-32e7-9e28-f936f62e3964",
                                                "text": "„Optisch wird sich der neue Crossover am Allroad Concept orientieren, der in diesem Frühjahr in Peking präsentiert wurde.“"
                                            },
                                            {
                                                "example_id": "08a911c0-5af1-4c0e-9dd6-ddf63c642150",
                                                "sense_id": "ef923acb-3b3f-32e7-9e28-f936f62e3964",
                                                "text": "„Auf dem Volkskongress in Peking hat der Staatspräsident die Begrenzung seiner Amtszeit aufheben lassen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
