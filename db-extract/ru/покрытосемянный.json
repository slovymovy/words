                "translations": [
                    {
                        "translation_id": "ec18348e-7a41-4840-ab89-d24ae26582b6",
                        "source_entry_id": "3808c1e9-7c2a-35a1-90c2-466aad63c6db",
                        "source_sense_id": "e9b2cf02-eab6-39fb-9410-15f2a5607e90",
                        "target_lang_word": "angiospermous",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "angiospermous",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "444fa361-3f7b-3b3e-8f2e-c9c6e7bff0da",
                                        "entry_id": "aeb24747-1703-3d5a-87cb-56066fbeaaa0",
                                        "glosses": [
                                            "angiospermic"
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
