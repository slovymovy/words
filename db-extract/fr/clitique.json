                        "source_sense_description": "(Linguistique) Mot syntaxiquement séparé mais phonétiquement rattaché",
                        "target_lang_word": "clítico",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "clítico",
