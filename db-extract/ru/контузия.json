                                        "sense_id": "215e534e-78d4-3457-aa5e-601e94240691",
                                        "entry_id": "11aec737-6b2f-3ac1-90e2-87ca83fff1ea",
                                        "glosses": [
                                            "een onderhuidse beschadiging van het zachte weefsel, veelal veroorzaakt door een bot voorwerp of een val"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "488410e9-a776-4c0d-99dd-896d24e04fb9",
                                                "sense_id": "215e534e-78d4-3457-aa5e-601e94240691",
                                                "text": "Hij kwam er met een kneuzing vanaf; er was niets gebroken."
                                            }
                                        ]
