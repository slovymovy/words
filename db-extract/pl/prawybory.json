                        "entry_id": "8e48ebf1-583b-3336-ad51-0f00322e1e68",
                        "glosses": [
                            "wstępne wybory, które odbywają się na niewielkim obszarze kraju i są organizowane w ramach kampanii wyborczej jako rodzaj sondażu"
                        ],
