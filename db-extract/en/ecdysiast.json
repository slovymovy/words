                        "entry_id": "cbad68a2-1c54-333b-9229-d28a24ca2ee2",
                        "glosses": [
                            "An erotic dancer who removes their clothes as a form of entertainment; a stripper."
                        ],
                        "tags": [
                            "uncommon"
                        ],
                        "examples": [
                            {
                                "example_id": "9dd61f6f-2152-4728-942b-bc8c7bb14e95",
                                "sense_id": "8aa4b9a8-e614-32cd-a349-8a81afa9d285",
                                "text": "I had never seen an ecdysiast before; toward the end she was wearing nothing but seven beads, four of them sweat."
                            },
                            {
                                "example_id": "10018d65-0d88-436e-9369-fee1f1af05f7",
                                "sense_id": "8aa4b9a8-e614-32cd-a349-8a81afa9d285",
                                "text": "However, the Queen of Ecdysiasts, Gypsy Rose Lee, was not amused. In a 1940 interview, she leveled her guns against Mencken: \"Ecdysiast, he calls me! Why, the man... has been reading books! Dictionaries! We don't wear feathers and molt them off... What does he know about stripping?\""
                            }
                        ]
                    }
