                "senses": [
                    {
                        "sense_id": "d0da5d5e-5f14-39c2-b53c-d6d3fd97eaea",
                        "entry_id": "051d383f-3bf7-3e10-af3b-229de94678cf",
                        "glosses": [
                            "freie, unkontrollierte Lüftung über undichte, offene Stellen im umbauten Raum"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d075f463-4713-49e5-9e52-e265e0e10a6b",
                                "sense_id": "d0da5d5e-5f14-39c2-b53c-d6d3fd97eaea",
                                "text": "„Trotz moderner Klimatechnik mit Zu- und Abluftsystem ist eine natürliche Lüftung über Fenster bzw. eine windkraftsichere Schlitzlüftung in den Obergeschossen möglich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "ec403112-fa06-3fbb-b516-0fe1f75023b6",
                        "entry_id": "051d383f-3bf7-3e10-af3b-229de94678cf",
                        "glosses": [
                            "gezielte Zuführung von Zuluft über Schlitzauslass in den Raum"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "93e89bf2-fd53-4aa3-9ce8-2d08e3d9438d",
                                "sense_id": "ec403112-fa06-3fbb-b516-0fe1f75023b6",
                                "text": "„Bei dieser Zuluftvariante wird die Frischluft in Form einer \"Schlitzlüftung\" von der Decke in die geschlossenen Füttergänge geführt.“"
                            },
                            {
                                "example_id": "9cc973df-ac60-4202-ae1c-fa2a4a6103a3",
                                "sense_id": "ec403112-fa06-3fbb-b516-0fe1f75023b6",
                                "text": "„Grundsätzlich kann die Schlitzlüftung in allen Bereichen der Schweinehaltung eingesetzt werden.“"
                            },
                            {
                                "example_id": "aa0e5db3-d4a4-4894-ab49-8c7ad3bb6358",
                                "sense_id": "ec403112-fa06-3fbb-b516-0fe1f75023b6",
                                "text": "„Wichtig für eine gleichmäßige Verteilung der Zuluft in den Abteilen bei der Schlitzlüftung ist, dass die seitlichen Führungsbretter der Elemente oben in den Zuluftkanal hinein reichen.“"
                            },
                            {
                                "example_id": "7ff9a301-d3d6-477b-907a-a83edf4645d1",
                                "sense_id": "ec403112-fa06-3fbb-b516-0fe1f75023b6",
                                "text": "„In der Planung neuer Stallungen wird dabei vermehrt die Schlitzlüftung in unterschiedlichen Bauformen eingebaut.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
