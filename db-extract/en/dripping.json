                "senses": [
                    {
                        "sense_id": "edea48c5-0dd5-3ba7-971f-98df88be6111",
                        "entry_id": "27780472-8a0b-35a5-9a42-a4a02c52f7eb",
                        "glosses": [
                            "very wet."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "796b7233-5bf3-429a-aef7-a7458d7bee7b",
                                "sense_id": "edea48c5-0dd5-3ba7-971f-98df88be6111",
                                "text": "I am sure that the whole scene, with its dripping bamboo forest, every tree festooned with fern, orchid and creeper, filled him with disgust—all so different from the deserts and oases of his lost Bokhara."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "8c90148d-ab72-3cbf-b90d-eb85a3aeda95",
                "word": "dripping",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "30ed3391-c780-482c-86e2-dad2b431c0c2",
                        "entry_id": "8c90148d-ab72-3cbf-b90d-eb85a3aeda95",
                        "tags": [
                            "plural"
                        ],
                        "form": "drippings"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a8db7173-be0c-3c80-a999-1b2592144222",
                        "entry_id": "8c90148d-ab72-3cbf-b90d-eb85a3aeda95",
                        "glosses": [
                            "Solid animal fat, traditionally collected from dripping off roasting meat."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "53e67f13-0c53-4c95-82ed-dcaec3e7d14c",
                                "sense_id": "a8db7173-be0c-3c80-a999-1b2592144222",
                                "text": "They were pleased because he was not above drinking a cup of tea with them, and when the dawn came and they were still waiting they offered him a slice of bread and dripping; he was not squeamish and could eat most things now with a good appetite."
                            }
                        ]
                    },
                    {
                        "sense_id": "6becc1fd-6c02-3019-9485-fd5ebbedbc4a",
                        "entry_id": "8c90148d-ab72-3cbf-b90d-eb85a3aeda95",
                        "glosses": [
                            "The sound or action of something that drips."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "659fbf67-7331-4576-93d0-7779d5ab32d1",
                                "sense_id": "6becc1fd-6c02-3019-9485-fd5ebbedbc4a",
                                "text": "Lying in bed, I could hear drippings from the leaky roof."
                            }
                        ]
                    },
                    {
                        "sense_id": "6d35197d-2ba8-351e-a433-ee570a10feef",
                        "entry_id": "8c90148d-ab72-3cbf-b90d-eb85a3aeda95",
                        "glosses": [
                            "The use of a drip tip to drip e-liquid directly onto the atomizer of an e-cigarette."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "37323bc1-52ad-4ffd-8fd4-3f124831d593",
                                "sense_id": "6d35197d-2ba8-351e-a433-ee570a10feef",
                                "text": "When dripping, it can be eaiser to flood your atomizer. I suggest to only add the amount of E-liquid that you plan on vaping at that particular moment."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1d804459-cfe0-4ab0-8b27-9643fe031d1e",
                        "source_entry_id": "8c90148d-ab72-3cbf-b90d-eb85a3aeda95",
                        "source_sense_description": "fat",
                        "target_lang_word": "dégoulinade",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dégoulinade",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d93f82aa-a493-3796-8c5e-9f6844531092",
                                        "entry_id": "f4b85bc6-ca54-3832-9b73-2b6b33a3392b",
                                        "glosses": [
                                            "Liquide pâteux ou visqueux qui s'écoule lentement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "57c7232b-398d-4aa9-9f9b-6550f34fd3a6",
                                                "sense_id": "d93f82aa-a493-3796-8c5e-9f6844531092",
                                                "text": "C’est quoi ça? s'exclama-t-elle, montrant du doigt une dégoulinade de vomi qui séchait sur la manche."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c8fbd6a-beae-3981-96c4-23e2a732b986",
                                        "entry_id": "f4b85bc6-ca54-3832-9b73-2b6b33a3392b",
                                        "glosses": [
                                            "Trace laissée par la coulure de ce liquide."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "171df8b2-6fb3-46b8-a3a4-939408e025b6",
                                                "sense_id": "7c8fbd6a-beae-3981-96c4-23e2a732b986",
                                                "text": "« Tu feras un excellent garçon de café, me confia le vieil homme en vérifiant l’état de son verre plein à ras bord sans aucune dégoulinade."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cfd8772f-4b0a-3596-be4d-d16bac421ad2",
                                        "entry_id": "f4b85bc6-ca54-3832-9b73-2b6b33a3392b",
                                        "glosses": [
                                            "Excès dans un sens péjoratif."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "60df20dd-0701-4664-b51e-75120ba1ace0",
                                                "sense_id": "cfd8772f-4b0a-3596-be4d-d16bac421ad2",
                                                "text": "Ce film est une dégoulinade de bons sentiments."
                                            },
                                            {
                                                "example_id": "011e8a83-0456-412e-bc0e-d2197ba36c03",
                                                "sense_id": "cfd8772f-4b0a-3596-be4d-d16bac421ad2",
                                                "text": "La dégoulinade de choix, impossible de trouver quelque chose simplement, il y a vingt mayonnaises, trente huiles d’olive, cent types de yaourts différents."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2c6ce57a-47f1-4474-99ab-3d0a5f1c8a79",
                        "source_entry_id": "8c90148d-ab72-3cbf-b90d-eb85a3aeda95",
                        "source_sense_description": "fat",
                        "target_lang_word": "ruissellement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ruissellement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fcb04701-b02b-3a65-bb1d-e2bee9c71a7c",
                                        "entry_id": "6ea9e024-9c3d-3ec3-bde8-36ac5d9bf648",
                                        "glosses": [
                                            "Le fait de ruisseler ; le produit de cette action."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b7e233a-d47e-44f6-8b1d-ec01960ce707",
                                                "sense_id": "fcb04701-b02b-3a65-bb1d-e2bee9c71a7c",
                                                "text": "À partir d’un échantillon du sol prélevé là où s’écoulaient des ruissellements émanant d’une fabrique de molinate, près d’Estoril, l’équipe a identifié un groupe de bactéries très intéressantes car dégradant totalement le molinate en résidus non toxiques."
                                            },
                                            {
                                                "example_id": "ccefed5f-2f12-4b80-a145-c6528e157118",
                                                "sense_id": "fcb04701-b02b-3a65-bb1d-e2bee9c71a7c",
                                                "text": "Si le ruissellement est très chargé en sédiments, on aura par exemple autant de transferts de diflufénicanil que d’isoproturon (en % des quantités appliquées) alors qu’ils ont deux GUS extrêmement éloignés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "64d7f255-3bde-3996-ac72-0afda352b5de",
                                        "entry_id": "6ea9e024-9c3d-3ec3-bde8-36ac5d9bf648",
                                        "glosses": [
                                            "Action des eaux qui ruissellent à la surface de la terre."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "37cdde74-6be5-3318-a880-7124b769510d",
                                        "entry_id": "6ea9e024-9c3d-3ec3-bde8-36ac5d9bf648",
                                        "glosses": [
                                            "Cascade, étalage surabondant."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "04c4941d-a55e-4b09-bbfb-a5ea8a68fe23",
                                                "sense_id": "37cdde74-6be5-3318-a880-7124b769510d",
                                                "text": "Sous ce ruissellement de pierreries, la forme et le fond disparaissent : ils s’en inquiètent peu."
                                            },
                                            {
                                                "example_id": "69f80a7c-2e85-44a4-a76a-33c437eeaf8b",
                                                "sense_id": "37cdde74-6be5-3318-a880-7124b769510d",
                                                "text": "Il s'en faut malheureusement de beaucoup que la pièce se maintienne jusqu'au bout dans ce ruissellement d’inouïsme; les auteurs ont voulu ménager au spectateur de longs intervalles de repos dont il profite pour s'assoupir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "60bafc78-6b00-30c6-8662-75c7d7f124fd",
                                        "entry_id": "6ea9e024-9c3d-3ec3-bde8-36ac5d9bf648",
                                        "glosses": [
                                            "Expression imagée d’une théorie selon laquelle la fortune des plus riches finit par profiter aux couches les plus défavorisées (voir théorie du ruissellement)."
                                        ],
                                        "tags": [
                                            "Économie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "de50ec44-75db-4132-94c1-d0782f14638f",
                                                "sense_id": "60bafc78-6b00-30c6-8662-75c7d7f124fd",
                                                "text": "Le gouvernement britannique a dû renoncer ce lundi à une baisse d’impôts sur les plus riches sous la pression des marchés. Une preuve de la vacuité du ruissellement auquel s’accroche pourtant le président français."
                                            },
                                            {
                                                "example_id": "7ba904d7-2443-49f9-b9df-2b3b5a1b2135",
                                                "sense_id": "60bafc78-6b00-30c6-8662-75c7d7f124fd",
                                                "text": "Car les embardées trussiennes découlent de la théorie du « ruissellement » : arrosons les riches, et les pauvres auront de quoi remplir leur dé à coudre."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
