                        "source_sense_id": "725eaa39-f673-3cc8-b17d-cb8b06570ff7",
                        "source_sense_description": "the property of being universal",
                        "target_lang_word": "universalité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "universalité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5b8d851e-60be-37c0-9ff3-505f043e8d0c",
                                        "entry_id": "fdd6d87d-9fcf-3969-8119-5c0566aea1bf",
                                        "glosses": [
                                            "Ensemble, totalité, ce qui embrasse les différentes espèces."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b07b07ba-259a-4b58-ad94-b64d50053201",
                                                "sense_id": "5b8d851e-60be-37c0-9ff3-505f043e8d0c",
                                                "text": "L’universalité des êtres, des sciences, des arts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0cb5f25c-c806-3d19-978e-51197976df8c",
                                        "entry_id": "fdd6d87d-9fcf-3969-8119-5c0566aea1bf",
                                        "glosses": [
                                            "Totalité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15d145ba-8469-4908-b2db-b054fffcb719",
                                                "sense_id": "0cb5f25c-c806-3d19-978e-51197976df8c",
                                                "text": "L’universalité des biens."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e871c239-b741-376a-b6f2-e9e662b4b0aa",
                                        "entry_id": "fdd6d87d-9fcf-3969-8119-5c0566aea1bf",
                                        "glosses": [
                                            "Caractère de ce qui est universel, de ce qui s’étend à un très grand nombre de pays, de civilisations, d’hommes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "777a52c5-fa23-40d5-b6a8-ccd749da1c73",
                                                "sense_id": "e871c239-b741-376a-b6f2-e9e662b4b0aa",
                                                "text": "Il n’est pas question d’entamer ici une enquête anthropologique sur la question de l’universalité des fictions ni de prendre parti en leur faveur ou en leur défaveur."
                                            },
                                            {
                                                "example_id": "d07a53ce-bf0c-49d9-ad74-7ed96af5b9ec",
                                                "sense_id": "e871c239-b741-376a-b6f2-e9e662b4b0aa",
                                                "text": "On peut sans doute soutenir aujourd'hui que les dénominateurs de l'industrialisation, de la technologie et autres variables analogues ont la force de l’universalité."
                                            },
                                            {
                                                "example_id": "da78e868-898d-46f9-b32a-9344944adfd2",
                                                "sense_id": "e871c239-b741-376a-b6f2-e9e662b4b0aa",
                                                "text": "L’universalité des Droits de l'Homme."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "76f5e15d-7290-3469-8eaa-e1a6924f77de",
                                        "entry_id": "fdd6d87d-9fcf-3969-8119-5c0566aea1bf",
                                        "glosses": [
                                            "Qualité d’une proposition dont l’attribut convient à la totalité du sujet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fffa2d51-1caa-4bc1-b501-1b1d65d2194f",
                                                "sense_id": "76f5e15d-7290-3469-8eaa-e1a6924f77de",
                                                "text": "L’universalité d’une proposition."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e33cf3c1-81ef-46df-b6e7-b40f87badbd1",
                        "source_entry_id": "e2ec78b1-03f9-3402-9dd8-0be0e65f9892",
                        "source_sense_id": "725eaa39-f673-3cc8-b17d-cb8b06570ff7",
                        "source_sense_description": "the property of being universal",
                        "target_lang_word": "Allgemeingültigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Allgemeingültigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dd770767-ebcf-3d81-b2e5-377fa975bc20",
                                        "entry_id": "85a4485e-e3e2-3186-8544-97f73aacda05",
                                        "glosses": [
                                            "das allgemein Geltende, Gültige, Verbindliche"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "07b34534-4950-46ca-a185-9e7af551e9f4",
                                                "sense_id": "dd770767-ebcf-3d81-b2e5-377fa975bc20",
                                                "text": "„Murr ist viel zu persönlich, um die Allgemeingültigkeit des Charakters zu haben, wie sie den Tieren in der Fabel eigentümlich ist.“"
                                            },
                                            {
                                                "example_id": "37657b15-aadf-496e-a096-0e223464c741",
                                                "sense_id": "dd770767-ebcf-3d81-b2e5-377fa975bc20",
                                                "text": "Meine Ausführungen erheben keinen Anspruch auf Allgemeingültigkeit."
                                            },
                                            {
                                                "example_id": "807c0829-6dde-4f4f-ac6b-7cb1d23ec84f",
                                                "sense_id": "dd770767-ebcf-3d81-b2e5-377fa975bc20",
                                                "text": "„Ein weiteres Kriterium der Wissenschaftlichkeit von Erkenntnissen ist deren Allgemeingültigkeit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "cd6ef649-bf3f-3184-ba22-06d6e91faad3",
                                        "entry_id": "85a4485e-e3e2-3186-8544-97f73aacda05",
                                        "glosses": [
                                            "die Eigenschaft einer Formel allgemeingültig, also unter jeder Belegung wahr zu sein"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "866bb6a5-5223-49cb-b513-4fc18b95aed9",
                                                "sense_id": "cd6ef649-bf3f-3184-ba22-06d6e91faad3",
                                                "text": "Die Allgemeingültigkeit ist also ein spezieller Fall der Erfüllbarkeit einer Formel."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "36e1ed07-11c7-40d1-9b93-23d4a91c24dc",
                        "source_entry_id": "e2ec78b1-03f9-3402-9dd8-0be0e65f9892",
                        "source_sense_id": "725eaa39-f673-3cc8-b17d-cb8b06570ff7",
                        "source_sense_description": "the property of being universal",
                        "target_lang_word": "Allgemeinheit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Allgemeinheit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "73a94c8b-71b4-3858-94ac-e4d4e1d4373a",
                                        "entry_id": "c1fcbd22-e78b-3b2b-ae43-96372990b802",
                                        "glosses": [
                                            "Gesamtheit, alle"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a78e90c8-ea34-4a33-b5a8-ed1fb1d31aab",
                                                "sense_id": "73a94c8b-71b4-3858-94ac-e4d4e1d4373a",
                                                "text": "Das ist für die Allgemeinheit."
                                            },
                                            {
                                                "example_id": "5e71e0ff-18fe-4980-a8f3-d22642ec9d61",
                                                "sense_id": "73a94c8b-71b4-3858-94ac-e4d4e1d4373a",
                                                "text": "Aber Gewerkschaften und Arbeitgeber fanden es leicht, Fehlentscheidungen und Zukunftslasten abzuwälzen auf die Allgemeinheit, und die politischen Parteien konnten und wollten nicht Spielverderber sein."
                                            },
                                            {
                                                "example_id": "58466dc2-5c70-4a46-a428-f0f37c08ed1c",
                                                "sense_id": "73a94c8b-71b4-3858-94ac-e4d4e1d4373a",
                                                "text": "„Kein medizinisches Fach ist so sehr auf eine sachliche Berichterstattung, auf behutsamen Umgang mit Fachworten und eine wohlwollende Einstellung der Allgemeinheit angewiesen wie die Psychiatrie.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d5848c7e-a9e9-3681-a68b-a1e3849088f1",
                                        "entry_id": "c1fcbd22-e78b-3b2b-ae43-96372990b802",
                                        "glosses": [
                                            "allgemeine Redensarten"
                                        ],
                                        "tags": [
                                            "plural-normally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9b80f441-25f4-4571-90b4-add6eb1c7b2b",
                                                "sense_id": "d5848c7e-a9e9-3681-a68b-a1e3849088f1",
                                                "text": "Ich finde Diskussionen mit ihm ermüdend, er trägt doch nie mehr als Allgemeinheiten bei."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b5589c3e-ba2d-449c-9b8a-258680ae2ef1",
                        "source_entry_id": "e2ec78b1-03f9-3402-9dd8-0be0e65f9892",
                        "source_sense_id": "725eaa39-f673-3cc8-b17d-cb8b06570ff7",
                        "source_sense_description": "the property of being universal",
                        "target_lang_word": "Universalität",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Universalität",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7d2f41cf-c38b-3c4d-bf02-bffc4d2f0dda",
                                        "entry_id": "c01f858a-9fb4-3df3-899f-a6a625d604d9",
                                        "glosses": [
                                            "Eigenschaft, (so gut wie) immer und überall (universal) zu gelten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d882f4af-d3aa-4621-a08f-82c038a90882",
                                                "sense_id": "7d2f41cf-c38b-3c4d-bf02-bffc4d2f0dda",
                                                "text": "„Universalität gerät immer in Konfrontation mit lokalen, kulturellen und rechtsphilosophischen Spezifitäten. Strittig ist dabei auch, ob Menschenrechte schon positive Grundrechte oder nur vorstaatliche Naturrechte sind.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ea719316-a89d-3058-b9a9-ddd91c7f8d7b",
                                        "entry_id": "c01f858a-9fb4-3df3-899f-a6a625d604d9",
                                        "glosses": [
                                            "Eigenschaft einer Person, Bildung, Kenntnisse, Wissen oder Kreativität zu besitzen, die sich auf alle/viele Gebiete ausdehnen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "806a9ebe-c3c4-4d79-b280-f7003e313d78",
                                                "sense_id": "ea719316-a89d-3058-b9a9-ddd91c7f8d7b",
                                                "text": "„Daß die Universalität Göthes mit dem Gesagten nicht erschöpft ist, weiß Jeder, der mit deutscher Literatur bekannt ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "5e80d6fd-c124-388f-89ff-cdc8c6241ca3",
                                        "entry_id": "c01f858a-9fb4-3df3-899f-a6a625d604d9",
                                        "glosses": [
                                            "Eigenschaft einer Sache oder eines Verfahrens, für viele Zwecke eingesetzt werden zu können"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0618d703-c0ec-4605-a059-d4cfae7abfbe",
                                                "sense_id": "5e80d6fd-c124-388f-89ff-cdc8c6241ca3",
                                                "text": "„Beide Methoden zeichnen sich durch Einfachheit und Universalität der Anwendung aus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
