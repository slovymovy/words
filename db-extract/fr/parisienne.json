                        "examples": [
                            {
                                "example_id": "04b3b6b0-8b13-4eb3-9565-cf6e4ca8ebe5",
                                "sense_id": "81ec82af-c0b9-3693-901f-f96c19dc8304",
                                "text": "[…] , comme si elle eût voulu rappeler à Solange que la châtelaine de Scaër ne devait pas mener en province la vie d'une cocodette parisienne."
                            },
                            {
                                "example_id": "d2760a35-1ace-4b5c-b2c3-8be7deeb82b9",
                                "sense_id": "81ec82af-c0b9-3693-901f-f96c19dc8304",
                                "text": "En terme de territoire, c’est presque revenir au département de la Seine et porter un regard inversé sur la périphérie : polycentrer la métropole parisienne."
                            }
                        ]
                    }
                ],
