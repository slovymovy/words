                ],
                "senses": [
                    {
                        "sense_id": "aa0f820e-588f-3289-9974-11a64b70ef21",
                        "entry_id": "777f1317-4ef4-3f23-a8ae-2ef5a7ede6dc",
                        "glosses": [
                            "Beginn der Nachtruhe, Ende der Ausgehzeit, Ende der Aktivitäten für den Tag"
                        ],
                        "tags": [
                            "auch übertragen und auf das zivile Leben verwendet"
                        ],
                        "examples": [
                            {
                                "example_id": "1c3fc192-04af-49c4-938d-cc8320aefc4a",
                                "sense_id": "aa0f820e-588f-3289-9974-11a64b70ef21",
                                "text": "Nach dem Nachtschießen mit dem G36 ersehnte er den Zapfenstreich."
                            },
                            {
                                "example_id": "9c14b571-b3c5-4834-a944-35d4dd69d3a3",
                                "sense_id": "aa0f820e-588f-3289-9974-11a64b70ef21",
                                "text": "Gut, wir schauen noch eine Folge an, aber dann ist Zapfenstreich für heute."
                            },
                            {
                                "example_id": "dfd1c0c6-39b1-4e17-a5d8-cd27fbd91641",
                                "sense_id": "aa0f820e-588f-3289-9974-11a64b70ef21",
                                "text": "Du darfst noch aufbleiben, aber um zehn ist Zapfenstreich!"
                            },
                            {
                                "example_id": "6449e3c2-4755-4f6b-b1b9-d23c9a1b4387",
                                "sense_id": "aa0f820e-588f-3289-9974-11a64b70ef21",
                                "text": "„Die Treppen der Kaserne waren leer; es war nach dem Zapfenstreich.“"
                            },
                            {
                                "example_id": "003c20f2-5162-4f03-b6d2-d4609ec2ac21",
                                "sense_id": "aa0f820e-588f-3289-9974-11a64b70ef21",
                                "text": "„Der Zapfenstreich für die Bevölkerung ist vorverlegt worden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "d68dd4ff-1b9c-3069-a892-cd620a4c0aa6",
                        "entry_id": "777f1317-4ef4-3f23-a8ae-2ef5a7ede6dc",
                        "glosses": [
                            "Signal, das den Beginn der Nachtruhe ankündigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "17063e29-5922-483b-8cb8-40657df1f304",
                                "sense_id": "d68dd4ff-1b9c-3069-a892-cd620a4c0aa6",
                                "text": "Die Artillerie hatte früher einen Kanonenschuss als Zapfenstreich."
                            },
                            {
                                "example_id": "7b2849bc-ad30-4bab-9ee2-6917b14461be",
                                "sense_id": "d68dd4ff-1b9c-3069-a892-cd620a4c0aa6",
                                "text": "„Dann schlugen die Trommler den Zapfenstreich, die Leute traten zum Appell an, verzehrten ihr Abendbrot und legten sich für die Nacht an die Feuer; einige brachten ihr Schuhwerk in Ordnung, andere rauchten eine Pfeife, wieder andere zogen sich ganz nackt aus, um ihre Läuse auszuräuchern.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "741ae183-c1ea-3c75-89e3-caca2f685ba6",
                        "entry_id": "777f1317-4ef4-3f23-a8ae-2ef5a7ede6dc",
                        "glosses": [
                            "Großer Zapfenstreich, die feierlichste militärische Zeremonie der Bundeswehr"
                        ],
                        "tags": [
                            "Abkürzung für"
                        ],
                        "examples": [
                            {
                                "example_id": "4487598b-9350-4560-ad23-6231b938b5d0",
                                "sense_id": "741ae183-c1ea-3c75-89e3-caca2f685ba6",
                                "text": "Der Zapfenstreich war für die Wulffs ein Kraftakt."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
