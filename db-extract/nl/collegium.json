                        "glosses": [
                            "instantie meestal verbonden met de rooms-katholieke kerk"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d7f2a39e-8c8c-4816-9e27-d45777899788",
                                "sense_id": "d6b0a77f-af57-3a88-bcbb-c8dcf9754088",
                                "text": "Op initiatief van de Culturele Raad Wierden geeft het Collegium Musicum Amsterdam (CMA) dat onder leiding staat van Anthony Zielhorst, morgenmiddag om 15.30 uur een passieconcert in de rk-kerk aan de Stationsstraat."
                            },
                            {
                                "example_id": "e25968d5-6963-4276-9dac-9af2eacb412d",
                                "sense_id": "d6b0a77f-af57-3a88-bcbb-c8dcf9754088",
                                "text": "In het internaat St. Josef Gronau-Glanerbrug zijn jongeren in de jaren vijftig en zestig seksueel misbruikt door paters redemptoristen. Het jongensinternaat, dat in 1967 gesloten werd, was een vooropleiding voor het Collegium Josefinum in Bonn, waaraan ook een internaat verbonden was."
                            }
                        ]
                    }
