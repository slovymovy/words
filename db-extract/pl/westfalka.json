                        "glosses": [
                            "gw. (Poznań i Chełmża) rodzaj metalowego pieca kuchennego"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "37d76309-7daf-43b3-ae74-17f75de0a336",
                                "sense_id": "47deeaea-3e0a-3bed-ba61-1c46295a1e0b",
                                "text": "Na środku pomieszczenia stał kwadratowy stół, a przy nim dwa krzesła. Pod ścianą, na prawo, nędzny kredens, pomalowany na biało, z którego łuszczyła się farba. Przy przeciwległej ścianie westfalka pozbawiona fajerek, z czterema ziejącymi otworami"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
