                        "glosses": [
                            "een (verouderd) dieet dat veel melk bevat, speciaal voor patiënten met een maagzweer gegeven"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ce52cb2-5475-4040-ab2e-00576a5be65e",
                                "sense_id": "d94312dc-a54e-323f-858f-ac86d20f66b0",
                                "text": "Boerhaave kreeg het veel te druk en wist dat dat zijn gezondheid ondermijnde. Hij adviseerde zijn patiënten rust, wandelen, paardrijden, goede wijn en soms een melkdieet. Maar zelf had hij er de tijd niet voor. ‘Het is treurig dat een mens zich zo weinig kan veroorloven als hij gezond wil blijven’, citeert Kooijmans hem. Dat ging over eten, drank en werken - en is een moderne wijsheid."
                            }
                        ]
                    }
