                "senses": [
                    {
                        "sense_id": "b7051a02-a329-3fd3-9494-47551bd96040",
                        "entry_id": "d8ef4506-8b3e-3df1-a6ee-d198a914282f",
                        "glosses": [
                            "jemanden blenden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d2feb73a-f6be-41fc-9eed-f9b0a3b90af7",
                                "sense_id": "b7051a02-a329-3fd3-9494-47551bd96040",
                                "text": "„The word abacinate, in Latin and Italian, has furnished Ducange Gloss. Latin with an opportunity to review the various modes of blinding: the more violent were scooping, burning with an iron, or hot vinegar, and binding the head with a strong cord till the eyes burst from their sockets. Ingenious tyrants!“",
                                "translation": "Das Wort abacinate auf Latein und Italienisch hat dem Du Cange Glossarium Latein die Gelegenheit geliefert, die verschiedenen Arten des Blendens vorzustellen: Die gewaltsameren waren Schaufeln, Brennen mit einem Eisen oder heißem Essig und Binden des Kopfes mit einer starken Schnur, bis die Augen aus ihren Höhlen platzen. Geniale Tyrannen!"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4b880080-70e4-47a1-9628-1bf45c7d29bb",
                        "source_entry_id": "d8ef4506-8b3e-3df1-a6ee-d198a914282f",
                        "source_sense_id": "b7051a02-a329-3fd3-9494-47551bd96040",
                        "source_sense_description": "jemanden blenden",
                        "target_lang_word": "blenden",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "blenden",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a7413db8-ea81-380d-a110-abf008977c7c",
                                        "entry_id": "e700a0a1-f7e4-3c9e-9a28-06cd804df8b6",
                                        "glosses": [
                                            "mittels hellen Lichtes jemandes Sehvermögen beeinträchtigen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3529d9da-2d00-411e-abb7-c398bf485c46",
                                                "sense_id": "a7413db8-ea81-380d-a110-abf008977c7c",
                                                "text": "Autofahrer werden oft von der tiefstehenden Sonne geblendet."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "40630f7e-a326-309b-958d-3f68c67895f9",
                                        "entry_id": "e700a0a1-f7e4-3c9e-9a28-06cd804df8b6",
                                        "glosses": [
                                            "durch Äußerlichkeiten beeindrucken, Schein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f9088ba5-56ec-43f7-850f-6993124cd1a4",
                                                "sense_id": "40630f7e-a326-309b-958d-3f68c67895f9",
                                                "text": "Sein selbstsicheres Auftreten blendete die potenziellen Investoren."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "d086aa38-41d2-3384-a179-9083c8b80d4f",
                                        "entry_id": "e700a0a1-f7e4-3c9e-9a28-06cd804df8b6",
                                        "glosses": [
                                            "jemandem das Augenlicht nehmen, die Augen ausstechen"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d711f10f-be04-4574-8925-49ef0b170b77",
                                                "sense_id": "d086aa38-41d2-3384-a179-9083c8b80d4f",
                                                "text": "Und er blendete die Augen Zedekias, und er band ihn mit ehernen Fesseln, um ihn nach Babel zu bringen."
                                            },
                                            {
                                                "example_id": "40d10ff8-8740-4f09-9c9c-2c099e191008",
                                                "sense_id": "d086aa38-41d2-3384-a179-9083c8b80d4f",
                                                "text": "„Doch stellte sich diese Lösung schnell als konfliktträchtig heraus: Homayun stellte als erstgeborener Sohn Timurs solch eine Bedrohung für Zaman Schah dar, dass er diesen nach einer Revolte 1793 blenden ließ – eine übliche Methode, um einen legitimen Konkurrenten auszuschalten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    }
