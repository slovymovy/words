                                        "examples": [
                                            {
                                                "example_id": "ecb1db84-9eff-42d0-8647-b8d924b71ffb",
                                                "sense_id": "ddaae7ba-a5ff-30f5-8477-50943d534fca",
                                                "text": "Mein Notebook ist defekt."
                                            },
                                            {
                                                "example_id": "9b3dbb5d-b0fe-4ca9-bacf-f162c3933905",
                                                "sense_id": "ddaae7ba-a5ff-30f5-8477-50943d534fca",
                                                "text": "„Gibt es für ein eigentlich perfekt geeignetes Notebook kein hübsches Case, dann wird der Rechner nicht gekauft.“"
                                            },
                                            {
                                                "example_id": "fe151ed3-1c24-4f41-ace1-8358e5c62c2e",
                                                "sense_id": "ddaae7ba-a5ff-30f5-8477-50943d534fca",
                                                "text": "Bis zur Erscheinung des ersten Smartphones im Jahr 2007 war das Notebook die einzige Möglichkeit im Zug oder im Freien zu arbeiten oder sonst die Freizeit zu verbringen."
                                            },
                                            {
                                                "example_id": "9bd38490-a679-42de-aa28-fb8c5ddb0b27",
                                                "sense_id": "ddaae7ba-a5ff-30f5-8477-50943d534fca",
                                                "text": "„Die Internetnutzer greifen dabei aus unterschiedlichsten Gründen über Smartphones, Tablets und Notebooks auf verschiedene digitale Plattformen zu.“"
                                            },
                                            {
                                                "example_id": "4e8315c7-8451-439d-a3a6-3ab71dd12ba9",
                                                "sense_id": "ddaae7ba-a5ff-30f5-8477-50943d534fca",
                                                "text": "„Kein Mobiltelefon, kein Notebook, kein GPS wäre je erfunden worden, wenn nicht Querdenker wie Einstein, Bohr oder Planck ihre Genialität darauf verwendet hätten, jahrhundertealte Vorstellungen über Raum und Zeit umzustürzen.“"
                                            }
