                "senses": [
                    {
                        "sense_id": "16c6c3ab-7ad6-334b-ba9d-768f603141b3",
                        "entry_id": "06c859e3-bac7-3492-8aff-44a87e0876d8",
                        "glosses": [
                            "van iets dat het nog niet tot volle wasdom is ontwikkeld"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "86f0c0ab-ee5a-4480-9efa-c56cafa5bdab",
                                "sense_id": "16c6c3ab-7ad6-334b-ba9d-768f603141b3",
                                "text": "Wat beklijfde er van haar bravoure? Onder haar zorgvuldig verknipte spijkerrok liet zich niets anders raden dan een nog onvolgroeid tienerlijfje, met kinderbilletjes."
                            },
                            {
                                "example_id": "78fbf5f2-5cca-44e5-b695-198cd7ef8434",
                                "sense_id": "16c6c3ab-7ad6-334b-ba9d-768f603141b3",
                                "text": "Op Texel is gisteren een levende bruinvis aangespoeld. Het gaat om een jong onvolgroeid vrouwtje. Ze had een grote wond op haar hoofd en haar rugvin was aangepikt door meeuwen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d0135325-6ea7-43da-81ea-7ea038d0d4d4",
                        "source_entry_id": "06c859e3-bac7-3492-8aff-44a87e0876d8",
                        "source_sense_id": "16c6c3ab-7ad6-334b-ba9d-768f603141b3",
                        "source_sense_description": "van iets dat het nog niet tot volle wasdom is ontwikkeld",
                        "target_lang_word": "immature",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "immature",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3211bb80-a50e-3147-ae25-85e0d58107b7",
                                        "entry_id": "289865a7-1609-3ca5-9db7-dc5275c8ad72",
                                        "glosses": [
                                            "Occurring before the proper time; untimely, premature (especially of death)."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "80b18c4b-aaa4-4d5a-aaef-e8daffbce6bd",
                                                "sense_id": "3211bb80-a50e-3147-ae25-85e0d58107b7",
                                                "text": "And thou also canst best account for the causes of her immature death […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5ffab571-fcc9-3ead-a56c-b55b024a2f34",
                                        "entry_id": "289865a7-1609-3ca5-9db7-dc5275c8ad72",
                                        "glosses": [
                                            "Not fully formed or developed; not grown."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4ff0832f-0cc0-344b-b157-0da13de9db89",
                                        "entry_id": "289865a7-1609-3ca5-9db7-dc5275c8ad72",
                                        "glosses": [
                                            "Childish in behavior; juvenile."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c7d9d064-7516-49cf-b786-179077e8256a",
                                                "sense_id": "4ff0832f-0cc0-344b-b157-0da13de9db89",
                                                "text": "You're only young once, but you can be immature the rest of your life."
                                            },
                                            {
                                                "example_id": "d2d776d2-e3ef-46c2-872b-c06dbabfbc38",
                                                "sense_id": "4ff0832f-0cc0-344b-b157-0da13de9db89",
                                                "text": "The man was immature for throwing a tantrum."
                                            },
                                            {
                                                "example_id": "5c234732-7258-4433-8482-738223e81687",
                                                "sense_id": "4ff0832f-0cc0-344b-b157-0da13de9db89",
                                                "text": "Wilhelm Stekel - As quoted in The Catcher in the Rye (1951) by J. D. Salinger.\nThe mark of the immature man is that he wants to die nobly for a cause, while the mark of a mature man is that he wants to live humbly for one."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "immature",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f3d7de82-42a8-3e69-a72d-f09a8416a670",
                                        "entry_id": "9c5e3eb6-47b9-3171-91bc-039281ede11d",
                                        "glosses": [
                                            "An immature member of a species."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4358a132-b2ea-4e02-a36f-bab3fe1106d9",
                                                "sense_id": "f3d7de82-42a8-3e69-a72d-f09a8416a670",
                                                "text": "There are many genera and even families of Brachypylina for which immatures are not yet known, and thus numerous examples of adult convergence and misclassification remain to be revealed: such is the case with Hypozetes."
                                            },
                                            {
                                                "example_id": "b9ad48d4-563d-451e-b95a-82a6da5cd2c3",
                                                "sense_id": "f3d7de82-42a8-3e69-a72d-f09a8416a670",
                                                "text": "While on a walk the next morning I found what looked like a patch of old growth habitat - perhaps somewhere the fires had missed - and to my astonishment saw a female Red-lored Whistler accompanied by an immature."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
