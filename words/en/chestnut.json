                            {
                                "target_lang_word": "кашта́н",
                                "target_lang_sense_clarification": "дерево"
                            },
                            {
                                "target_lang_word": "кашта́новое де́рево",
                                "target_lang_sense_clarification": "дерево"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "栗树",
                                "target_lang_sense_clarification": "树木"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0d860c54-e073-34ac-9e5c-d10d0a7f833a",
                    "sense_definition": "A deep reddish-brown colour.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "colour",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist used a rich <w>chestnut</w> for the background of the portrait.",
                            "target_lang_translations": {
                                "ru": "Художник использовал насыщенный <w>каштановый</w> цвет для фона портрета.",
                                "zh": "艺术家用浓郁的<w>栗色</w>作为肖像画的背景。"
                            }
                        },
                        {
                            "text": "She dyed her hair a warm <w>chestnut</w> to match the season.",
                            "target_lang_translations": {
                                "ru": "Она покрасила волосы в теплый <w>каштановый</w> цвет, чтобы соответствовать сезону.",
                                "zh": "她把头发染成了温暖的<w>栗色</w>以应景。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Глубокий красновато-коричневый цвет.",
                        "zh": "深红褐色。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кашта́новый цвет",
                                "target_lang_sense_clarification": "цвет"
                            },
                            {
                                "target_lang_word": "кашта́новый",
                                "target_lang_sense_clarification": "субстантивированное прилагательное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "栗色",
                                "target_lang_sense_clarification": "颜色"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "61006ac9-e25e-382e-ae45-70d6879a2399",
                    "sense_definition": "An old joke, story, or subject that has been repeated so often that it is no longer interesting or funny.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "figurative_joke",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He told that old <w>chestnut</w> about the fisherman again at the party.",
                            "target_lang_translations": {
                                "ru": "На вечеринке он снова рассказал тот <w>бородатый анекдот</w> про рыбака.",
                                "zh": "他在聚会上又讲了那个关于渔夫的<w>老掉牙的笑话</w>。"
                            }
                        },
                        {
                            "text": "The journalist avoided the political <w>chestnut</w> regarding tax reform.",
                            "target_lang_translations": {
                                "ru": "Журналист избегал этой <w>избитой темы</w> касательно налоговой реформы.",
                                "zh": "记者避开了关于税制改革的政治<w>陈词滥调</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "cliché",
                        "platitude"
                    ],
                    "common_phrases": [
                        "old chestnut"
                    ],
                    "target_lang_definitions": {
                        "ru": "Старая шутка, история или тема, которую повторяли так часто, что она перестала быть интересной.",
                        "zh": "指被重复过多次而不再有趣或好笑的陈旧笑话、故事或话题。"
                    },
                    "translations": {
                        "ru": [
