                "senses": [
                    {
                        "sense_id": "959ffd48-7e0a-35f3-a740-0160e650046c",
                        "entry_id": "17d54da6-8076-3d70-8572-4950d5fdffd6",
                        "glosses": [
                            "Gruppe von Musikern, die gemeinsam Jazz spielen"
                        ],
                        "tags": [
                            "Musik"
                        ],
                        "examples": [
                            {
                                "example_id": "49331113-7216-4719-9453-170f2c45c78f",
                                "sense_id": "959ffd48-7e0a-35f3-a740-0160e650046c",
                                "text": "Seit Jahren spielt er in einer Jazzband."
                            },
                            {
                                "example_id": "cd8b287a-cf5e-4cf4-89e7-fd37b8257232",
                                "sense_id": "959ffd48-7e0a-35f3-a740-0160e650046c",
                                "text": "„In den Gärten etablierten sich Jazzbands, die mitgebracht wurden.“"
                            },
                            {
                                "example_id": "3d91f721-4a33-4cca-a893-05e43b4bd7b3",
                                "sense_id": "959ffd48-7e0a-35f3-a740-0160e650046c",
                                "text": "„Prestons kanadischer Schnaps war gut, aber nicht so genug, um meinen Kopf lauter als die Jazzband brummen zu lassen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
