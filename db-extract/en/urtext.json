                "senses": [
                    {
                        "sense_id": "c537fb74-fb20-3449-ad32-c239c5c78602",
                        "entry_id": "3efb87ac-ab66-38ce-9cf0-9f75c4b8fcc4",
                        "glosses": [
                            "A primitive, seminal, or prototypical example of an artistic genre or the basis of an ideological movement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "56379356-99e4-4993-9fb3-2ba9831b350a",
                                "sense_id": "c537fb74-fb20-3449-ad32-c239c5c78602",
                                "text": "Nearly coinciding with the publication of Thomas’s work was what, in many ways, stands as the ur-text of Turkish denialist “scholarship”: Esat Uras’s Tarihte Ermeniler ve Ermeni Meselesi. Uras, born Ahmed Essad, was an important figure in the CUP administration and was heavily involved in the planning and execution of the Armenian Genocide as a high official in the “directorate for public security.”"
                            },
                            {
                                "example_id": "740d47dc-e44d-41a2-ac78-587f1ce853ab",
                                "sense_id": "c537fb74-fb20-3449-ad32-c239c5c78602",
                                "text": "The Weekly Standard ran an interminable series of essays lauding manliness and lamenting its demise at the hands of liberalism. Perhaps the Ur-text of this movement was a 2003 Jay Nordlinger op-ed in The Wall Street Journal."
                            },
                            {
                                "example_id": "02e5e34e-58e8-4647-90c4-f6fa9c61c4b6",
                                "sense_id": "c537fb74-fb20-3449-ad32-c239c5c78602",
                                "text": "Paramount Television also produced the 2016 Vanessa Hudgens showcase Grease: Live for Fox, which had good ratings, was a critical success, and was the most exposure Jessie J had had in years. So it seems like this Ur-text of American horny teendom is in good hands."
                            }
                        ]
                    },
                    {
                        "sense_id": "a2898571-5bd0-383a-a701-af7805858a31",
                        "entry_id": "3efb87ac-ab66-38ce-9cf0-9f75c4b8fcc4",
                        "glosses": [
                            "The original version of a piece of music or text, as created by the composer or writer."
                        ],
