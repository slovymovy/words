        "ru-extract.jsonl": [
            {
                "entry_id": "d193137a-40c6-3389-bbef-222924054940",
                "word": "доходчиво",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "505bc0fd-a364-36af-bc87-3ed2e77dde19",
                        "entry_id": "d193137a-40c6-3389-bbef-222924054940",
                        "glosses": [
                            "наречие к доходчивый"
                        ],
                        "tags": [
                            "adverb"
                        ],
                        "examples": [
                            {
                                "example_id": "8b719477-dea3-4513-ad41-728257803f05",
                                "sense_id": "505bc0fd-a364-36af-bc87-3ed2e77dde19",
                                "text": "Он удивительно доходчиво объяснил мне, почему клетка делится."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "33a4c2dd-2e19-4a8b-b333-203d54ca17dd",
                        "source_entry_id": "d193137a-40c6-3389-bbef-222924054940",
                        "source_sense_id": "505bc0fd-a364-36af-bc87-3ed2e77dde19",
                        "target_lang_word": "understandably",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "understandably",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dc891245-be27-3c04-a6f3-24b532f5fb20",
                                        "entry_id": "511a9d64-1df8-3c4e-a864-f4bd0dc523d4",
                                        "glosses": [
                                            "For reasons that are easy to understand or sympathise with."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9b9f482-7d29-42f5-97e6-cd2dbcf2fc8e",
                                                "sense_id": "dc891245-be27-3c04-a6f3-24b532f5fb20",
                                                "text": "Understandably, he was too embarrassed to speak."
                                            },
                                            {
                                                "example_id": "4eb8329b-e3a0-4d7d-9c5b-ffabc981f932",
                                                "sense_id": "dc891245-be27-3c04-a6f3-24b532f5fb20",
                                                "text": "Embarrassed, he understandably refused to speak."
                                            },
                                            {
                                                "example_id": "d783dc17-b7e2-48eb-bc4e-dba1f1c7efe3",
                                                "sense_id": "dc891245-be27-3c04-a6f3-24b532f5fb20",
                                                "text": "He was understandably embarrassed, and could not speak."
                                            },
                                            {
                                                "example_id": "86f578ad-61f7-427d-b367-aac99bcc1e11",
                                                "sense_id": "dc891245-be27-3c04-a6f3-24b532f5fb20",
                                                "text": "Everton were, perhaps understandably, deflated at the setback and it was no surprise when Suarez added Liverpool's second after 82 minutes. Distin and Baines were involved in a mix-up as the Uruguayan advanced into the area, and he was not about to pass up the gift to shoot low past Howard."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ead5e2a2-473a-3451-975d-743267eb83ef",
                                        "entry_id": "511a9d64-1df8-3c4e-a864-f4bd0dc523d4",
                                        "glosses": [
                                            "In an understandable manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e856a179-6eaa-4f03-a03f-7ee1ac6696c7",
                                                "sense_id": "ead5e2a2-473a-3451-975d-743267eb83ef",
                                                "text": "When presenting in front of the class, take care to speak clearly and understandably."
                                            },
                                            {
                                                "example_id": "dd805714-2288-4c68-af48-39c8b7cc366a",
                                                "sense_id": "ead5e2a2-473a-3451-975d-743267eb83ef",
                                                "text": "Accordingly, even though readers always and understandably speak of the theories adumbrated by Socrates here as \"Plato's theories\", one ought not to speak of them so without some compunction--the writing itself, and also Plato the author, present these always in a spirit of open-ended exploration, and sometimes there are contextual clues indicating that Socrates exaggerates or goes what the argument truly justifies, and so on."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "76c090ef-1bf6-4ca1-9979-24c8134099ce",
                        "source_entry_id": "d193137a-40c6-3389-bbef-222924054940",
                        "source_sense_id": "505bc0fd-a364-36af-bc87-3ed2e77dde19",
                        "target_lang_word": "clearly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "clearly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4253b384-f07d-3c18-adcd-ebafed18575a",
                                        "entry_id": "6b38cf32-5bed-3254-8e3e-855638a91e71",
                                        "glosses": [
                                            "In a clear manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "695f2aec-9e34-4b70-ad5a-60b7557941e6",
                                                "sense_id": "4253b384-f07d-3c18-adcd-ebafed18575a",
                                                "text": "He enunciated every syllable clearly."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dafa2904-8780-34d6-92c4-ac9245674a8b",
                                        "entry_id": "6b38cf32-5bed-3254-8e3e-855638a91e71",
                                        "glosses": [
                                            "Without a doubt; obviously."
                                        ],
                                        "tags": [
                                            "modal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7744b0e0-d2f5-43ee-88ca-65eef287f79f",
                                                "sense_id": "dafa2904-8780-34d6-92c4-ac9245674a8b",
                                                "text": "Clearly, the judge erred in his opinion."
                                            },
                                            {
                                                "example_id": "ebcc9eea-220f-4d40-829a-f7630f78b950",
                                                "sense_id": "dafa2904-8780-34d6-92c4-ac9245674a8b",
                                                "text": "While Gunners boss Arsene Wenger had warned his players against letting the pre-match festivities distract them from the task at hand, they clearly struggled for fluency early on."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ce4011fe-dd32-370f-b6f7-c07ed377d1c6",
                                        "entry_id": "6b38cf32-5bed-3254-8e3e-855638a91e71",
                                        "glosses": [
                                            "To a degree clearly discernible."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4633d05-925e-4e13-9124-451a88013cab",
                                                "sense_id": "ce4011fe-dd32-370f-b6f7-c07ed377d1c6",
                                                "text": "He was clearly wrong on all points but one."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "36951c8a-bdc8-45ae-9eb9-e4332884f311",
                        "source_entry_id": "d193137a-40c6-3389-bbef-222924054940",
