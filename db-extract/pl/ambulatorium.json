                    {
                        "sense_id": "a3c1b439-70ce-368b-bad3-f23fbb785019",
                        "entry_id": "d7158556-d6ee-317f-8e8c-1f4d1b304023",
                        "glosses": [
                            "miejsce lekarskiej pomocy doraźnej przy szpitalu, sanatorium lub w zakładzie pracy"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59cbac21-0a46-4f03-a127-1ee532f1ddab",
                                "sense_id": "a3c1b439-70ce-368b-bad3-f23fbb785019",
                                "text": "Zrobiłaś już swoje. Udaj się do ambulatorium. Możesz stać?"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "40808366-66e9-4600-8041-c5b9426abce6",
                        "source_entry_id": "d7158556-d6ee-317f-8e8c-1f4d1b304023",
                        "source_sense_id": "a3c1b439-70ce-368b-bad3-f23fbb785019",
                        "target_lang_word": "ambulatoire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ambulatoire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7c6d49f6-e021-3d42-a251-ff36c1b303d3",
                                        "entry_id": "6fb108dd-911b-3fc9-ba9e-7439ebe152a3",
                                        "glosses": [
                                            "Dont le siège n’était pas fixe et qui se tenait tantôt dans un endroit, tantôt dans un autre ; en parlant d’une juridiction."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a18a650f-c161-492c-82f9-d148df07435a",
                                                "sense_id": "7c6d49f6-e021-3d42-a251-ff36c1b303d3",
                                                "text": "Le Parlement, à son origine, était ambulatoire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "999682e1-55ce-3dc9-8a55-55780be8fb06",
                                        "entry_id": "6fb108dd-911b-3fc9-ba9e-7439ebe152a3",
                                        "glosses": [
                                            "Qui est propre au fait que quelqu’un se déplace, particulièrement en marchant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "30894339-9c95-4707-a4bf-e1ee54e1b56c",
                                                "sense_id": "999682e1-55ce-3dc9-8a55-55780be8fb06",
                                                "text": "Il marchait de long en large, surexcité et absurde. Cette éloquence ambulatoire irritait Jean-Marc."
                                            },
                                            {
                                                "example_id": "79da2e6c-4493-4a88-a390-85811cc6cd24",
                                                "sense_id": "999682e1-55ce-3dc9-8a55-55780be8fb06",
                                                "text": "Procurateur à la main lourde, Pilate n’apprécie pas de tout ce Jésus qui déambule du nord au sud de la Palestine et de l’est à l’ouest, en prêchant une doctrine et un royaume qui n’ont pas leur place en l’ordre romain, et surtout en traînant derrière lui, en cette manie ambulatoire, une foule de gens sans aveu, où se dissimulent de nombreux meurtriers zélotes."
                                            },
                                            {
                                                "example_id": "19ad5e34-321e-4803-89eb-bbbd858aaa78",
                                                "sense_id": "999682e1-55ce-3dc9-8a55-55780be8fb06",
                                                "text": "Entre-temps, […], ma bien-aimée avait repris sa solitude ambulatoire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d467ed1-20dd-33c7-91da-c7edb55391af",
                                        "entry_id": "6fb108dd-911b-3fc9-ba9e-7439ebe152a3",
                                        "glosses": [
                                            "Sujet au changement."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a35e023b-9883-4c66-b1c5-cbe127f67fb7",
                                                "sense_id": "2d467ed1-20dd-33c7-91da-c7edb55391af",
                                                "text": "La volonté de l’homme est ambulatoire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1eead1f7-aeeb-3f2a-9b61-4fd73f737cb3",
                                        "entry_id": "6fb108dd-911b-3fc9-ba9e-7439ebe152a3",
                                        "glosses": [
                                            "Qualifie le typhus quand ceux qui en sont atteints ne se sentent pas assez malades pour ne pas vaquer à leurs occupations."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ab679514-0912-37c0-a619-0695ae944894",
                                        "entry_id": "6fb108dd-911b-3fc9-ba9e-7439ebe152a3",
                                        "glosses": [
                                            "Sans hospitalisation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "434a7f25-b444-4760-b039-6dd242a2239e",
                                                "sense_id": "ab679514-0912-37c0-a619-0695ae944894",
                                                "text": "Mais les retours des praticiens sur le terrain établissent un lien entre le nombre de passages aux urgences et le développement de la médecine ambulatoire, qui veut que les patients sortent de l’hôpital le jour même de leur opération."
                                            },
                                            {
                                                "example_id": "28dbebe6-0c64-41c4-9a85-b5eef5a7892c",
                                                "sense_id": "ab679514-0912-37c0-a619-0695ae944894",
                                                "text": "Ce regroupement des diagnostics reprend les soins habituels prodigués à tous les clients et leurs familles en chirurgie ambulatoire."
                                            },
                                            {
                                                "example_id": "28fb0ce0-ab3c-4f20-8755-a175f1f05a98",
                                                "sense_id": "ab679514-0912-37c0-a619-0695ae944894",
                                                "text": "Son PDG, Martin Beaumont, calcule qu'environ 4000 rendez-vous ambulatoires et près de 300 interventions chirurgicales seront reportés ou annulés par semaine."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ambulatoire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3296dc93-3e74-3772-b6e0-995db479d496",
                                        "entry_id": "e97e1254-c249-30dd-9264-4e1a2850f4e0",
                                        "glosses": [
                                            "Pratique médicale consistant à procéder à une intervention suivie dans la même journée d'un retour au domicile, sans hospitalisation : forme abrégée de médecine ambulatoire ou chirurgie ambulatoire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d5b1645-81a4-4e8c-a429-d1b733e388ab",
                                                "sense_id": "3296dc93-3e74-3772-b6e0-995db479d496",
                                                "text": "La cryothérapie et la RAD sont les deux techniques recommandées pour traiter les lésions précancéreuses en ambulatoire."
                                            },
                                            {
                                                "example_id": "8ad4e5dd-ef54-4787-9efe-4530587f9ac7",
                                                "sense_id": "3296dc93-3e74-3772-b6e0-995db479d496",
                                                "text": "Le principal problème de l'ambulatoire est l'absence de traitement efficace des douleurs post-opératoires par antalgiques oraux alors qu'une hospitalisation avec injection permanente de produits analgésiques par perfusion intra-veineuse permet de pallier cette insuffisance de prise en charge de la douleur."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ec14de0b-483b-4fbd-97f1-65b246e659bb",
                        "source_entry_id": "d7158556-d6ee-317f-8e8c-1f4d1b304023",
                        "source_sense_id": "a3c1b439-70ce-368b-bad3-f23fbb785019",
                        "target_lang_word": "амбулатория",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "амбулатория",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "57ae6869-d316-3aa0-b12d-334c50601adc",
                                        "entry_id": "ab71ee28-85f3-3dc7-bcea-de3a3fbf0cc6",
                                        "glosses": [
                                            "медицинское учреждение, оказывающее лечебно-профилактическую помощь по основным лечебным специальностям и на дому"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df332a7d-5d83-42ac-94ff-d856451354ff",
                                                "sense_id": "57ae6869-d316-3aa0-b12d-334c50601adc",
                                                "text": "Миновав раймаг, чайную, амбулаторию, почту, райисполком, райком под шифером, дом культуры под камышом, — грузовик наш останавливается около дома МВД-МГБ."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
