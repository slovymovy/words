                            },
                            {
                                "target_lang_word": "bram yelkeni",
                                "target_lang_sense_clarification": "denizcilik terimi"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "de471e81-b404-38c4-a022-40c17ee6e062",
                    "sense_definition": "Iemand die veel drukte maakt of opschept.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wat een <w>bram</w> is hij toch, altijd aan het opscheppen over zijn auto.",
                            "target_lang_translations": {
                                "en": "What a <w>show-off</w> he is, always bragging about his car.",
                                "ru": "Ну и <w>хвастун</w> же он, вечно хвастается своей машиной.",
                                "tr": "Ne <w>gösterişçi</w> biri ama, her zaman arabasıyla böbürlenip duruyor."
                            }
                        },
                        {
                            "text": "Doe niet zo als een <w>bram</w> en gedraag je gewoon.",
                            "target_lang_translations": {
                                "en": "Don't act like such a <w>show-off</w> and just behave yourself.",
                                "ru": "Не веди себя как <w>выпендрежник</w> и веди себя нормально.",
                                "tr": "<w>Hava atan</w> biri gibi davranma da düzgün davran."
                            }
                        }
                    ],
                    "synonyms": [
                        "druktemaker",
                        "opschepper"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Someone who makes a lot of fuss or brags.",
                        "ru": "Человек, который много суетится или хвастается.",
                        "tr": "Çok gürültü patırtı koparan veya böbürlenen kimse."
                    },
