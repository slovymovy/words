                                                "sense_id": "9fad4c6e-5bab-35c0-bd57-c8018426ebd3",
                                                "text": "Er ist heute wieder ein richtiger Dickkopf."
                                            },
                                            {
                                                "example_id": "7db773ff-c157-4ed7-870c-bda5bb0648d2",
                                                "sense_id": "9fad4c6e-5bab-35c0-bd57-c8018426ebd3",
                                                "text": "„Einmal sollte er sagen, ob er ein Dickkopf ist, ein Reinfuchser und Durchbeißer.“"
                                            },
                                            {
                                                "example_id": "b70cf58e-92a1-4d26-8db7-e5a4a59200f9",
                                                "sense_id": "9fad4c6e-5bab-35c0-bd57-c8018426ebd3",
                                                "text": "„Nach einer Weile höre ich wieder, was der kleine Dickkopf redet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0dd6b890-65ac-3b22-b958-95a218336f26",
