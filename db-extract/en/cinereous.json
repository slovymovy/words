                                                "sense_id": "f95cefae-bdd8-38e1-9cf8-a167ab457f28",
                                                "text": "Sein Gesicht war aschgrau."
                                            },
                                            {
                                                "example_id": "f046f2ef-1e1f-4fe8-8215-0a836fc35e2e",
                                                "sense_id": "f95cefae-bdd8-38e1-9cf8-a167ab457f28",
