                "senses": [
                    {
                        "sense_id": "7e8c3534-98b2-301e-ba44-b7efd6b8cc11",
                        "entry_id": "e0293f38-7173-3794-ac98-b210b39bbb75",
                        "glosses": [
                            "Vernichtung von Kleinstlebewesen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25d41ef3-a31a-4da5-b3fa-d09c240bc1cd",
                                "sense_id": "7e8c3534-98b2-301e-ba44-b7efd6b8cc11",
                                "text": "Die Abtötung der Bakterien gelang nicht vollständig."
                            },
                            {
                                "example_id": "255868aa-6897-4d5c-8ad1-73456894ce0e",
                                "sense_id": "7e8c3534-98b2-301e-ba44-b7efd6b8cc11",
                                "text": "„In seiner Lehre geht Buddha von den vier edlen Wahrheiten aus: 1) alles Leben ist leidvoll; 2) Ursache des Leidens ist der ›Durst‹, die Begierde, der Lebenswille; die Menschen bewegen sich in einem Netz von Konventionen und Illusionen, durch das sie die Welt und sich wahrnehmen; 3) die Leiden können überwunden werden durch die Abtötung von Begierden und Leidenschaften…“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "b070a4e4-72bf-3809-8a88-0d4b8ebbf8ba",
                        "entry_id": "e0293f38-7173-3794-ac98-b210b39bbb75",
                        "glosses": [
                            "Unterdrückung (von Gefühlen, Trieben…)"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "2cbeca86-997b-48fb-a6fd-dcb97743ec07",
                                "sense_id": "b070a4e4-72bf-3809-8a88-0d4b8ebbf8ba",
                                "text": "Die Abtötung von Gefühlen mit Alkohol scheitert fast immer."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
