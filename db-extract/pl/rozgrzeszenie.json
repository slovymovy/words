                                        "sense_id": "7eac7169-5589-3a29-9f47-b258d4d93b54",
                                        "entry_id": "96e19841-2e38-331f-9a72-4d084e68fb78",
                                        "glosses": [
                                            "An absolving of sins from ecclesiastical penalties by an authority."
                                        ],
