                                                "example_id": "b10380e2-cd95-4069-a708-e5f19ff6fcb0",
                                                "sense_id": "f95733a7-a2c4-3b72-9c3b-fcd3f324a733",
                                                "text": "„Erpreß du mal 'n Toten.“"
                                            }
