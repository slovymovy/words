                "senses": [
                    {
                        "sense_id": "fa9423bc-a45c-3261-8351-921f6b70c8ba",
                        "entry_id": "aeedfbe4-ca82-3d29-a824-79760d0d0485",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4b0b6038-248b-4ee0-8478-fa2e9bc444f8",
                                "sense_id": "fa9423bc-a45c-3261-8351-921f6b70c8ba",
                                "text": "Frau Bechtle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "756b954b-c52c-4518-a676-2cdabdb09d26",
                                "sense_id": "fa9423bc-a45c-3261-8351-921f6b70c8ba",
                                "text": "Herr Bechtle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "6201a94b-deb1-46a6-aae8-b8c803a96715",
                                "sense_id": "fa9423bc-a45c-3261-8351-921f6b70c8ba",
                                "text": "Die Bechtles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "aac142cc-0be6-41b7-b484-031da2588ec5",
                                "sense_id": "fa9423bc-a45c-3261-8351-921f6b70c8ba",
                                "text": "Der Bechtle trägt nie die Schals, die die Bechtle ihm strickt."
                            },
                            {
                                "example_id": "acb96bf2-5132-4a71-b1d1-bbdff7a084e9",
                                "sense_id": "fa9423bc-a45c-3261-8351-921f6b70c8ba",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Bechtle kommt, geht der Herr Bechtle.“"
                            },
                            {
                                "example_id": "cc11752c-b999-43db-b116-8668784c4d8c",
                                "sense_id": "fa9423bc-a45c-3261-8351-921f6b70c8ba",
                                "text": "Bechtle kommt und geht."
                            },
                            {
                                "example_id": "fb676da1-0f4d-45e8-b8d5-ba8e15a80c58",
                                "sense_id": "fa9423bc-a45c-3261-8351-921f6b70c8ba",
                                "text": "Bechtles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
