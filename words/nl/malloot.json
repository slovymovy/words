{
    "word_family": [
        "mallotig",
        "malloterig"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4ac3cb74-356d-3f76-bcbe-1c7df72e2b8c",
                    "sense_definition": "iemand die zich erg dom, onhandig of dwaas gedraagt",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "dwaas persoon",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Welke <w>malloot</w> heeft dit nu weer gedaan?",
                            "target_lang_translations": {
                                "en": "Which <w>idiot</w> did this again?"
                            }
                        },
                        {
                            "text": "Doe niet zo raar, je gedraagt je als een <w>malloot</w>.",
                            "target_lang_translations": {
                                "en": "Don't be so weird, you're acting like a <w>fool</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "halve gare",
                        "hansworst",
                        "dwaas"
                    ],
                    "common_phrases": [
                        "een grote malloot"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informeel taalgebruik"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "someone who behaves very stupidly, clumsily, or foolishly"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "idiot",
                                "target_lang_sense_clarification": "informal, person behaving stupidly"
                            },
                            {
                                "target_lang_word": "fool",
                                "target_lang_sense_clarification": "person lacking judgment"
                            },
                            {
                                "target_lang_word": "buffoon",
                                "target_lang_sense_clarification": "person who acts ridiculously"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aec9464c-5196-377f-a7e6-610ff5bc1b80",
                    "sense_definition": "een uitgelaten, hyperactieve of dwaze vrouw",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "dwaas persoon",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij is echt een <w>malloot</w> als ze te veel suiker heeft gehad.",
                            "target_lang_translations": {
                                "en": "She is a real <w>madcap</w> when she's had too much sugar."
                            }
                        },
                        {
                            "text": "Die vrolijke <w>malloot</w> danst de hele avond door de kamer.",
                            "target_lang_translations": {
                                "en": "That cheerful <w>silly person</w> is dancing through the room all evening."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informeel taalgebruik"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "an exuberant, hyperactive, or foolish woman"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "madcap",
                                "target_lang_sense_clarification": "reckless or impulsive person"
                            },
                            {
                                "target_lang_word": "silly person",
                                "target_lang_sense_clarification": "someone acting in a lighthearted, foolish way"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "e160fcb4-3549-3f24-9866-3c4a7efe4478",
                    "sense_definition": "op een lachwekkende manier dwaas of vreemd",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wat een <w>malloot</w> idee om midden in de nacht te gaan zwemmen.",
                            "target_lang_translations": {
                                "en": "What a <w>daft</w> idea to go swimming in the middle of the night."
                            }
                        },
                        {
                            "text": "Hij droeg een <w>malloot</w> pak tijdens het formele diner.",
                            "target_lang_translations": {
                                "en": "He wore a <w>wacky</w> suit during the formal dinner."
                            }
                        }
                    ],
                    "synonyms": [
                        "dwaas",
                        "mal",
                        "malloterig",
                        "mallotig"
                    ],
                    "common_phrases": [
                        "een malloot idee"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informeel taalgebruik"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "foolish or strange in a laughable way"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "silly",
                                "target_lang_sense_clarification": "lacking seriousness"
                            },
                            {
                                "target_lang_word": "daft",
                                "target_lang_sense_clarification": "informal, foolish or eccentric"
                            },
                            {
                                "target_lang_word": "wacky",
