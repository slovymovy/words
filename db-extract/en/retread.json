    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "e1e64fee-5734-3194-8b74-3a57d9ccaecc",
                "word": "retread",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "ec46afcc-ec54-4ee6-9a87-203ced8a13ad",
                        "entry_id": "e1e64fee-5734-3194-8b74-3a57d9ccaecc",
                        "tags": [
                            "plural"
                        ],
                        "form": "retreads"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b8a325d5-66db-36b7-ac7b-5d8354211bfc",
                        "entry_id": "e1e64fee-5734-3194-8b74-3a57d9ccaecc",
                        "glosses": [
                            "A used tire whose surface, the tread, has been replaced to extend its life and use."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "88e91ff5-3c3c-384e-baab-15210dc38c7e",
                        "entry_id": "e1e64fee-5734-3194-8b74-3a57d9ccaecc",
                        "glosses": [
                            "A person who re-entered military service in World War II after serving in World War I."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "083d523c-b5d7-4602-b6e7-dcbe1930d287",
                                "sense_id": "88e91ff5-3c3c-384e-baab-15210dc38c7e",
                                "text": "In Our War the Retreads usually slinked in over-aged, over-weight and overcautious in the face of a new generation."
                            },
                            {
                                "example_id": "dd237172-bf11-4c23-8315-60d6b3c11438",
                                "sense_id": "88e91ff5-3c3c-384e-baab-15210dc38c7e",
                                "text": "They were retreads and recruits under a small cadre of Regular Army officers and noncoms."
                            },
                            {
                                "example_id": "d5ef2dd4-a72c-4570-9b09-674f31010474",
                                "sense_id": "88e91ff5-3c3c-384e-baab-15210dc38c7e",
                                "text": "We retreads upset everybody."
                            },
                            {
                                "example_id": "44579153-3e85-4125-b8ea-07f975ec252c",
                                "sense_id": "88e91ff5-3c3c-384e-baab-15210dc38c7e",
                                "text": "As with the 100th Division, many of the replacements joining the 103d were \"retreads\" from the technical services or antiaircraft and aviation troops..."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "fc3db8e5-a187-328f-afb2-f8b2dfb24fce",
                "word": "retread",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "a50fa4ae-e91c-4bd4-ace7-868bada31578",
                        "entry_id": "fc3db8e5-a187-328f-afb2-f8b2dfb24fce",
                        "tags": [
                            "plural"
                        ],
                        "form": "retreads"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "83581406-f6ba-3d25-b0ad-d86a6abfe0f6",
                        "entry_id": "fc3db8e5-a187-328f-afb2-f8b2dfb24fce",
                        "glosses": [
                            "A return over ground previously covered; a retraversal or repetition."
                        ],
                        "tags": [
                            "figuratively",
                            "sometimes"
                        ],
                        "examples": [
                            {
                                "example_id": "f0fc2edb-0285-430f-860e-6c0c7b4fa0d5",
                                "sense_id": "83581406-f6ba-3d25-b0ad-d86a6abfe0f6",
                                "text": "But The West Side Waltz is otherwise a tedious retread of Mr. Thompson's previous effort, On Golden Pond."
                            },
                            {
                                "example_id": "18bb0385-6d20-48ee-9704-869518c29b2c",
                                "sense_id": "83581406-f6ba-3d25-b0ad-d86a6abfe0f6",
                                "text": "It uses a howitzer to shoot drugged fish in a barrel, inserts flabby lite-surrealism where the comedy might otherwise go and the plot turns out to be a retread of JM Barrie’s stage-play The Admirable Crichton."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
