                "senses": [
                    {
                        "sense_id": "0f44e4ec-cdf7-34bf-9fe4-54bceb18d80c",
                        "entry_id": "dcbe08fb-e332-324e-a007-67d1e56d97c3",
                        "glosses": [
                            "Gesamtheit der inneren Vorgänge im Menschen, bezogen auf seine Gefühle, Gedanken und Empfindungen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9243233b-37ff-429d-ac59-12db10ca3dfb",
                                "sense_id": "0f44e4ec-cdf7-34bf-9fe4-54bceb18d80c",
                                "text": "Psychoanalytiker analysieren für gewöhnlich das Seelenleben ihrer Klienten."
                            },
                            {
                                "example_id": "3206435d-e443-4cb8-94dc-59be968c2d74",
                                "sense_id": "0f44e4ec-cdf7-34bf-9fe4-54bceb18d80c",
                                "text": "„Dabei fällt das Seelenleben ebenso ins Gewicht wie die Pflege des Körpers.“"
                            },
                            {
                                "example_id": "ae7e3e3d-f8cb-497f-acba-ce8024f0bfae",
                                "sense_id": "0f44e4ec-cdf7-34bf-9fe4-54bceb18d80c",
                                "text": "„Die älteren Theorien hatten, wie Stern darlegt, den Anfang des kindlichen Seelenlebens im Empfangen von Sinneseindrücken und im Verknüpfen der Empfindungen und ihrer Nachwirkungen zu Vorstellungskomplexen gesehen, die auf Grund des Assoziationsmechanismus möglich wird.“"
                            },
                            {
                                "example_id": "5848226c-0352-4d6b-b78d-2878bac28bdf",
                                "sense_id": "0f44e4ec-cdf7-34bf-9fe4-54bceb18d80c",
                                "text": "„Björgvin schluckt das kalte Wasser, Steinunn setzt sich mit dem Heft zu ihm, ihr grobknochiges Gesicht, das selten die Witterungsumschwünge ihres Seelenlebens verbirgt, steht vor Staunen offen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
