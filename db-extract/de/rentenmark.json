                "senses": [
                    {
                        "sense_id": "b0235d9d-1b79-3253-9922-b4d156d8c813",
                        "entry_id": "5a4318f3-7fcd-3f76-bbc3-91dfbd2c3937",
                        "glosses": [
                            "Übergangswährung in Deutschland von 1923 bis 1948, eingeführt auf dem Höhepunkt der damaligen Inflation"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "1c4adbbb-8d7b-4632-9092-0e3c2d926480",
                                "sense_id": "b0235d9d-1b79-3253-9922-b4d156d8c813",
                                "text": "Die Rentenmark sollte die Geldinflation in Deutschland stoppen."
                            },
                            {
                                "example_id": "fc00512b-b5e3-441e-9aae-df1c7fc84605",
                                "sense_id": "b0235d9d-1b79-3253-9922-b4d156d8c813",
                                "text": "„Die Rentenmark war gekommen, die Flut verrann, und wie es ja meistens nach einer Flut ist: Sie hinterließ Schlamm, Zerstörung.“"
                            },
                            {
                                "example_id": "b2392b8a-e36a-49d9-9c04-94a4462d640b",
                                "sense_id": "b0235d9d-1b79-3253-9922-b4d156d8c813",
                                "text": "„Für eine Billion Papiermark erhielten die Menschen nun eine Rentenmark - die dem Wert von 15,4 Pfennigen des Jahres 1914 entsprach.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
