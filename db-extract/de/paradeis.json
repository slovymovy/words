                ],
                "senses": [
                    {
                        "sense_id": "d4f1dfb2-8f2b-3b67-a8d7-5f2c48a31cbb",
                        "entry_id": "b3357c05-2410-308a-a75b-abde45624d8a",
                        "glosses": [
                            "Pflanzenart aus der Familie der Nachtschattengewächse"
                        ],
                        "tags": [
                            "regional am Ost- und Südrand des deutschsprachigen Raumes (Burgenland über Steiermark bis Südtirol)",
                            "Lycopersicon esculentum"
                        ],
                        "examples": [
                            {
                                "example_id": "d28ed209-8d8d-4327-b56e-59a2a7fa2168",
                                "sense_id": "d4f1dfb2-8f2b-3b67-a8d7-5f2c48a31cbb",
                                "text": "»Die Paradeis ist die drittintelligenteste Pflanze der Welt. Die wächst fast überall, auch ohne Gießen.« (Feldbach/Steiermark)"
                            },
                            {
                                "example_id": "b010c276-e408-4eef-aadf-bb4a33fa911b",
                                "sense_id": "d4f1dfb2-8f2b-3b67-a8d7-5f2c48a31cbb",
                                "text": "»Vergangenen Samstag fand zum ersten Mal unsere Veranstaltung ›Paradeis trifft Wein‹ bei uns am Hof in Jamm statt.« (Jamm/Steiermark)"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e0d5b210-05a6-3508-a2e2-75590e7f35a7",
                        "entry_id": "b3357c05-2410-308a-a75b-abde45624d8a",
                        "glosses": [
                            "als Gemüse verwendete rote Frucht des Tomatenstrauchs; Tomate"
                        ],
                        "tags": [
                            "regional am Ost- und Südrand des deutschsprachigen Raumes (Burgenland über Steiermark bis Südtirol)"
                        ],
                        "examples": [
                            {
                                "example_id": "57be13c4-da46-42bb-b8c9-119abb314f8a",
                                "sense_id": "e0d5b210-05a6-3508-a2e2-75590e7f35a7",
                                "text": "»Vergangenen Samstag fand zum ersten Mal unsere Veranstaltung ›Paradeis trifft Wein‹ bei uns am Hof in Jamm statt.« (Jamm/Steiermark)"
                            },
                            {
                                "example_id": "f5cb6cab-f9ba-4f18-91c3-d3f8a5d993c8",
                                "sense_id": "e0d5b210-05a6-3508-a2e2-75590e7f35a7",
                                "text": "»„Das ist die originale Paradeis, die Kolumbus aus Amerika mitgebracht hat“, sagt der 39-Jährige.« (Frauenkirchen/Burgenland)"
                            },
                            {
                                "example_id": "2389f448-7df6-46b1-a0c8-5fdfde357da3",
                                "sense_id": "e0d5b210-05a6-3508-a2e2-75590e7f35a7",
                                "text": "»Zutaten Ebly mit Paradeis: 25 dag Ebly, 2-3 Ochsenherz-Paradeis« (Graz/Steiermark)"
                            },
                            {
                                "example_id": "cfd24471-e60f-4cfc-b942-86da1d467aeb",
                                "sense_id": "e0d5b210-05a6-3508-a2e2-75590e7f35a7",
                                "text": "»In Südtirol hat die Paradeis von Juli bis spätestens September Saison.« (Haslach/Südtirol)"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
