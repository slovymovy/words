                            "past"
                        ],
                        "form": "загреме́в"
                    },
                    {
                        "form_id": "ff79577f-40cc-470f-9bc3-aa060d248d91",
                        "entry_id": "0b79e442-c4c8-3e91-8309-644e7dbf09d4",
                        "tags": [
                            "adverbial",
                            "participle",
                            "past"
                        ],
                        "form": "загреме́вши"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "22b4da26-b0e4-3b84-a4a4-8ec1ea63feb9",
                        "entry_id": "0b79e442-c4c8-3e91-8309-644e7dbf09d4",
                        "glosses": [
                            "перен., разг. упасть, свалиться"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1004224e-ea11-45be-8f75-5448a83c4521",
                                "sense_id": "22b4da26-b0e4-3b84-a4a4-8ec1ea63feb9",
                                "text": "Можно ведь загреметь вниз непроизвольно: просто обломится одна скоба, другая ― и каюк!"
                            },
                            {
                                "example_id": "e62e98fc-f2c1-4427-ae43-3a0e1a3bb489",
                                "sense_id": "22b4da26-b0e4-3b84-a4a4-8ec1ea63feb9",
                                "text": "Тоже видимость ни к чёрту, но всё-таки без колдовства и обманов, да и пойдем мы теперь по равнине, а не куполу, с которого можно загреметь на полкилометра вниз."
                            }
                        ]
                    },
                    {
                        "sense_id": "6c1b34af-8889-332f-bd70-3c80366bbb83",
                        "entry_id": "0b79e442-c4c8-3e91-8309-644e7dbf09d4",
                        "glosses": [
                            "перен., разг. попасть, угодить (в тюрьму, под суд)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eaaf29ca-07fe-451b-ac6b-e879d5009d35",
                                "sense_id": "6c1b34af-8889-332f-bd70-3c80366bbb83",
                                "text": "Логика подсказывает им: если я это опубликую, то могу загреметь в тюрьму или со мной ещё что-нибудь может случиться."
                            },
                            {
                                "example_id": "af61e77b-5129-4cf6-840b-36fa1b8af410",
                                "sense_id": "6c1b34af-8889-332f-bd70-3c80366bbb83",
                                "text": "И упаси бог назвать это «воровством»: запросто можно самому загреметь под суд за оскорбление чести и достоинства того, кто прокручивает деньги."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1f220ba0-afd4-498a-936f-39b93801eb6e",
                        "source_entry_id": "0b79e442-c4c8-3e91-8309-644e7dbf09d4",
                        "source_sense_description": "свалиться",
                        "target_lang_word": "tumble down",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tumble down",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9de169a9-537a-3b2e-b8b7-f7b9f40152a1",
                                        "entry_id": "71ba7229-f169-3364-b09a-3711454a91af",
                                        "glosses": [
                                            "To topple, collapse."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "051dcdc4-cdbd-4299-8b3d-5cadb3831ec1",
                                                "sense_id": "9de169a9-537a-3b2e-b8b7-f7b9f40152a1",
                                                "text": "After its tournament dreams came tumbling down in shocking fashion last March, the Harvard men’s hockey team has high hopes of improving upon the disappointing up-and-down 2008-09 season and making it back to the NCAA Tournament for the first time since 2006."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            },
