        "nl-extract.jsonl": [
            {
                "entry_id": "1d6651f4-ccba-39c5-9581-5d7d7f00dfe2",
                "word": "groei",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "e51fb3ba-43d6-3f72-a07d-7a93e41696e5",
                        "entry_id": "1d6651f4-ccba-39c5-9581-5d7d7f00dfe2",
                        "glosses": [
                            "het groter worden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e68b6aa8-bb1c-41fe-a28f-77cd3f157399",
                                "sense_id": "e51fb3ba-43d6-3f72-a07d-7a93e41696e5",
                                "text": "Zijn groei schokte de wereld."
                            },
                            {
                                "example_id": "487a4b66-1e0a-4b85-b701-3ae805f49d20",
                                "sense_id": "e51fb3ba-43d6-3f72-a07d-7a93e41696e5",
                                "text": "In 1972 verscheen het rapport \"Grenzen aan de groei\" van de Club van Rome, vijftig jaar later streven politici nog altijd naar een zo hoog mogelijke jaarlijkse economische groei"
                            },
                            {
                                "example_id": "cf031a63-8d2f-477b-90c4-a8d688a2e8b9",
                                "sense_id": "e51fb3ba-43d6-3f72-a07d-7a93e41696e5",
                                "text": "Ze beargumenteren op basis van hun onderzoeken onder meer dat je voor economische groei in een land vaak politieke stabiliteit nodig hebt."
                            }
                        ]
                    },
                    {
                        "sense_id": "1730f362-95ac-3569-8b2a-abf3f6bc0d6a",
                        "entry_id": "1d6651f4-ccba-39c5-9581-5d7d7f00dfe2",
                        "glosses": [
                            "toename in aantal"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa63d8a5-6799-43e3-ab4d-59a5caa0ea66",
                                "sense_id": "1730f362-95ac-3569-8b2a-abf3f6bc0d6a",
                                "text": "Volgens Rico Luman, sectoreconoom transport en automotive van ING, moeten de heffingen ook niet gezien worden als een middel om Chinese auto's van de Europese markt te weren. \"In het Verenigd Koninkrijk zijn er geen heffingen op Chinese auto's en daar zie je een nog grotere groei van Chinese auto's. Het werkt eerder als een kleine rem dan als een blokkade.\""
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e1a5336f-f968-40a0-a4ad-397908df0380",
                        "source_entry_id": "1d6651f4-ccba-39c5-9581-5d7d7f00dfe2",
                        "source_sense_id": "e51fb3ba-43d6-3f72-a07d-7a93e41696e5",
                        "source_sense_description": "het groter worden",
                        "target_lang_word": "Wuchs",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wuchs",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3c6c59ff-75dc-3508-9530-5e5c68b30b16",
                                        "entry_id": "5debd954-6e07-3a2b-ab59-bbeccad3d98f",
                                        "glosses": [
                                            "die Entwicklung, das Größerwerden von Pflanzen, Tieren, Menschen"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "943d9837-edfe-4746-8f64-636d9fd885bd",
                                                "sense_id": "3c6c59ff-75dc-3508-9530-5e5c68b30b16",
                                                "text": "„Für einen guten Wuchs des neuen Rasens gab es noch eine spezielle Düngung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "071e9f1d-9db0-3407-9013-5d088442e616",
                                        "entry_id": "5debd954-6e07-3a2b-ab59-bbeccad3d98f",
                                        "glosses": [
                                            "die Art, das Erscheinungsbild von etwas Gewachsenem"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "661301fb-b45f-4b5a-809e-871dd937fe85",
                                                "sense_id": "071e9f1d-9db0-3407-9013-5d088442e616",
                                                "text": "„Dank kräftigem Wuchs und blauer Augen besteht der Siebzehnjährige mit Auszeichnung und schleicht sich, das strikte Verbot seines Vaters missachtend, im Morgengrauen aus dem Elternhaus.“"
                                            },
                                            {
                                                "example_id": "ba426bc0-0ecf-4fd6-a78f-588cc3d9744c",
                                                "sense_id": "071e9f1d-9db0-3407-9013-5d088442e616",
                                                "text": "„Er war von mässig hohem Wuchs und hatte ein kluges Gesicht, in das der vorspringende Unterkiefer einen Zug von Schroffheit und Härte brachten, ohne dass dieser Zug das Gesicht entstellte, dem er vielmehr etwas besonders Lebendiges und Ausdrucksvolles verlieh.“"
                                            },
                                            {
                                                "example_id": "4f47f866-95c9-454d-92b3-02dba6895bf3",
                                                "sense_id": "071e9f1d-9db0-3407-9013-5d088442e616",
                                                "text": "„Aus seinem harten Wuchs heraus heilten die Wunden.“"
                                            },
                                            {
                                                "example_id": "68b537ac-dc18-48d0-9a93-093c784b2559",
                                                "sense_id": "071e9f1d-9db0-3407-9013-5d088442e616",
                                                "text": "„Deutschlands Krieger waren von riesigem Wuchs, mit wunderlichen Helmen mit Spitzen oben, wie Spieße geformt, und hatten Knebelbärte, die Widderhörnern glichen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "78b0bc78-81ee-303a-b4f8-5bf21aef3fac",
                                        "entry_id": "5debd954-6e07-3a2b-ab59-bbeccad3d98f",
                                        "glosses": [
                                            "die Gesamtheit der gewachsenen Anpflanzung"
                                        ],
                                        "tags": [
                                            "Forstwirtschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fe503dff-c069-494b-b143-c465d1cc86a2",
                                                "sense_id": "78b0bc78-81ee-303a-b4f8-5bf21aef3fac",
                                                "text": "Der ganze Wuchs junger Thujen erlitt durch Hagel großen Schaden."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a3e4c8da-3e25-4476-8076-d3ce35fb2b85",
                        "source_entry_id": "1d6651f4-ccba-39c5-9581-5d7d7f00dfe2",
                        "source_sense_id": "e51fb3ba-43d6-3f72-a07d-7a93e41696e5",
                        "source_sense_description": "het groter worden",
                        "target_lang_word": "Zunahme",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zunahme",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "77f8317a-6848-387a-8856-585b81eadac6",
                                        "entry_id": "83559532-0d67-31ed-98ce-dbed623e54fa",
                                        "glosses": [
                                            "der Vorgang, bei dem etwas in der Menge oder im Volumen zunimmt, anwächst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e86691b-835e-420a-93b1-20313e214c2e",
                                                "sense_id": "77f8317a-6848-387a-8856-585b81eadac6",
                                                "text": "Die Lehrer der hiesigen Schule glauben eine Zunahme der Übergriffe von Schülern auf Schüler ausgemacht zu haben."
                                            },
                                            {
                                                "example_id": "42972488-49ec-4430-bd70-f9a01fcb08e5",
                                                "sense_id": "77f8317a-6848-387a-8856-585b81eadac6",
                                                "text": "Ein Krebsexperte der chinesischen Akademie der Wissenschaften führte die Zunahme auf \"ungesunden Lebensstil\" zurück - wozu er neben ungesunder Ernährung und wachsendem Stress auch die Umweltverschmutzung zählte."
                                            },
                                            {
                                                "example_id": "f8e17635-55aa-4eec-a1a1-550caf7944cc",
                                                "sense_id": "77f8317a-6848-387a-8856-585b81eadac6",
                                                "text": "Die deutlichsten Zunahmen [der Kinderkriminalität] seien in Rheinland-Pfalz (plus 17 Prozent), Bayern (14 Prozent), Baden-Württemberg (neun Prozent) sowie Hessen und Sachsen (je acht Prozent) festzustellen."
                                            },
                                            {
                                                "example_id": "3aab0029-72c7-4de9-93a0-c422c22f99e2",
                                                "sense_id": "77f8317a-6848-387a-8856-585b81eadac6",
                                                "text": "„Das Phänomen, eine deutliche Zunahme präfigierter Verben in unserem Sprachgebrauch, läßt sich nicht bestreiten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e1f0a97c-886b-46b0-b0be-36b44cade61e",
                        "source_entry_id": "1d6651f4-ccba-39c5-9581-5d7d7f00dfe2",
                        "source_sense_id": "e51fb3ba-43d6-3f72-a07d-7a93e41696e5",
                        "source_sense_description": "het groter worden",
                        "target_lang_word": "growth",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "growth",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "04e7dcf2-82e6-3dd5-9d59-747774a45e83",
                                        "entry_id": "36801bc0-447a-3065-a800-d313712d0a3f",
                                        "glosses": [
                                            "An increase in size, number, value, or strength."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b02be64-b50e-4174-8707-4cb23c413e65",
                                                "sense_id": "04e7dcf2-82e6-3dd5-9d59-747774a45e83",
                                                "text": "It may be that a free society as we have known it carries in itself the forces of its own destruction, that once freedom has been achieved it is taken for granted and ceases to be valued, and that the free growth of ideas which is the essence of a free society will bring about the destruction of the foundations on which it depends."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "449d4ad8-a473-301e-ac05-efbcf67f7fb0",
                                        "entry_id": "36801bc0-447a-3065-a800-d313712d0a3f",
                                        "glosses": [
                                            "Ellipsis of economic growth."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "countable",
                                            "ellipsis",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c5bf1b06-a372-44b9-99ae-f5503cc759f0",
                                                "sense_id": "449d4ad8-a473-301e-ac05-efbcf67f7fb0",
                                                "text": "Growth was dampened by a softening of the global economy in 2001, but picked up in the subsequent years due to strong growth in China."
                                            },
                                            {
                                                "example_id": "417ab00b-cd9a-405e-bc29-d3f02a744ea6",
                                                "sense_id": "449d4ad8-a473-301e-ac05-efbcf67f7fb0",
                                                "text": "Private-equity nabobs bristle at being dubbed mere financiers.[…]Much of their pleading is public-relations bluster. Clever financial ploys are what have made billionaires of the industry’s veterans. “Operational improvement” in a portfolio company has often meant little more than promising colossal bonuses to sitting chief executives if they meet ambitious growth targets. That model is still prevalent today."
                                            },
                                            {
                                                "example_id": "c345634e-9ed6-4e8d-b718-f9f0c9ed47fe",
                                                "sense_id": "449d4ad8-a473-301e-ac05-efbcf67f7fb0",
                                                "text": "Liz Truss has promised Britons she has “got your back” and set out a plan for “growth, growth and growth” in a conference speech disrupted by protesters asking who voted for her plan."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "99d6ecc0-18b0-3bc8-8bce-b9c3d7a075cf",
                                        "entry_id": "36801bc0-447a-3065-a800-d313712d0a3f",
                                        "glosses": [
                                            "An increase in psychological strength or resilience; an increased ability to overcome adversity."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a1b852a-0c29-4102-b2a3-8b0960194512",
                                                "sense_id": "99d6ecc0-18b0-3bc8-8bce-b9c3d7a075cf",
                                                "text": "Struggle, disappointment, and criticism all contribute to a person's growth."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "acdfb455-e211-3902-82fe-24abb24566bf",
                                        "entry_id": "36801bc0-447a-3065-a800-d313712d0a3f",
                                        "glosses": [
                                            "The act of growing, getting bigger or higher."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d3f95cda-fc03-3ac6-a6e3-c4ef1d813652",
                                        "entry_id": "36801bc0-447a-3065-a800-d313712d0a3f",
                                        "glosses": [
                                            "Something that grows or has grown."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "79d83188-ff55-4cdf-88e3-bc9bc12d9f27",
                                                "sense_id": "d3f95cda-fc03-3ac6-a6e3-c4ef1d813652",
                                                "text": "Scary-looking rabbits were hopping around Fort Collins. These weren’t your standard cute, fluffy bunnies; they had horn-like growths protruding from their faces and bodies."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "079e84b8-f486-3df6-a5b6-20c519b970bb",
                                        "entry_id": "36801bc0-447a-3065-a800-d313712d0a3f",
                                        "glosses": [
                                            "An abnormal mass such as a tumor."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c87cc12c-5a88-4a49-bfa7-ef98c027cdda",
                        "source_entry_id": "1d6651f4-ccba-39c5-9581-5d7d7f00dfe2",
                        "source_sense_id": "e51fb3ba-43d6-3f72-a07d-7a93e41696e5",
                        "source_sense_description": "het groter worden",
                        "target_lang_word": "croissance",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "croissance",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8cb0e351-f361-3367-84fa-08b3c6bd4f63",
                                        "entry_id": "57805760-b527-3b5b-95f2-3ec3cd56534c",
                                        "glosses": [
                                            "Processus par lequel un être vivant croît, augmente en taille, en masse ou en complexité."
                                        ],
                                        "tags": [
                                            "Biologie fonctionnelle"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "883be84f-dfbb-4ce8-bafa-370b7e5508e9",
                                                "sense_id": "8cb0e351-f361-3367-84fa-08b3c6bd4f63",
                                                "text": "Cet ouvrage présente les connaissances actuelles sur l’écophysiologie du pois protéagineux : développement végétatif et reproducteur, croissance en condition non limitante, nutrition azotée."
                                            },
                                            {
                                                "example_id": "4e302eb9-7cf7-44a5-ad8f-4cc8f64c5a90",
                                                "sense_id": "8cb0e351-f361-3367-84fa-08b3c6bd4f63",
                                                "text": "[…] ; parmi les écotypes, la croissance de la luzerne maritime sur les plages de la plaine orientale et du plantain des sables sur celles de la Balagne, est conditionnée par la teneur locale de la salinité du sol ;[…]."
                                            },
                                            {
                                                "example_id": "990ee2d3-542a-4b90-8a87-3d9223fe55fe",
                                                "sense_id": "8cb0e351-f361-3367-84fa-08b3c6bd4f63",
                                                "text": "L’ossification de membrane concerne la plus grande part de la voûte et de la face. La croissance des os de la voûte répond à l’augmentation du volume de l’encéphale sous-jacent."
                                            },
                                            {
                                                "example_id": "cfbc2f3d-7ab7-4a03-964c-24036e4fc4f7",
                                                "sense_id": "8cb0e351-f361-3367-84fa-08b3c6bd4f63",
                                                "text": "Sa croissance lente lui donne toujours une allure d’arbuste ou de petit arbre un rien contrarié. En cas de conditions extrêmes de froid ou de vent, il a même tendance à se « bonsaïfier »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5ee0de67-a80d-32fb-ab4b-e6a4860b275e",
                                        "entry_id": "57805760-b527-3b5b-95f2-3ec3cd56534c",
                                        "glosses": [
                                            "Fait d’augmenter, de se développer, de propager."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ccc7bdf4-4ae1-446e-adc4-7b8848cc2c87",
                                                "sense_id": "5ee0de67-a80d-32fb-ab4b-e6a4860b275e",
                                                "text": "La croissance de cette ville est remarquable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a88d0a1e-1943-33e1-9089-31f85585ea47",
                                        "entry_id": "57805760-b527-3b5b-95f2-3ec3cd56534c",
                                        "glosses": [
                                            "Pente d’une courbe dont on qualifie l’évolution."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ce68e46-e96b-459d-b17b-623a8be43f15",
                                                "sense_id": "a88d0a1e-1943-33e1-9089-31f85585ea47",
                                                "text": "Cette fonction a une croissance positive."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ad9fbbc9-30cd-3863-83bc-4f0d75ac3168",
                                        "entry_id": "57805760-b527-3b5b-95f2-3ec3cd56534c",
                                        "glosses": [
                                            "Augmentation sur le long terme de la production de biens et de services d’une économie, qui se mesure généralement année par année grâce au PIB."
                                        ],
                                        "tags": [
                                            "Économie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3bf4f41d-f3e0-40ea-91c8-4f5f4191e273",
                                                "sense_id": "ad9fbbc9-30cd-3863-83bc-4f0d75ac3168",
                                                "text": "Il est convaincu que le retour de la croissance est une bonne nouvelle alors que la croissance signifie seulement de plus en plus de production vaine, « une immense accumulation de marchandises » (Karl Marx), une montagne d’objets supplémentaires pour nous ensevelir."
                                            },
                                            {
                                                "example_id": "137c14e1-56c6-42df-9475-ca10c01f7dde",
                                                "sense_id": "ad9fbbc9-30cd-3863-83bc-4f0d75ac3168",
                                                "text": "Nous devons rompre avec le mythe de la croissance économique, et avec l’idée qu’elle est la solution pour réduire les inégalités. C’est faux, c’est même l’inverse. La croissance détruit les écosystèmes comme les humains."
                                            },
                                            {
                                                "example_id": "66795b21-2bc8-4d85-9002-de10e12209aa",
                                                "sense_id": "ad9fbbc9-30cd-3863-83bc-4f0d75ac3168",
                                                "text": "Quand on parle d’hypercroissance, on parle de plusieurs années de suite avec des croissances à plus de 100 %."
                                            },
                                            {
                                                "example_id": "f5e285f6-63e8-4cfa-b0b4-a3fa54751ec9",
                                                "sense_id": "ad9fbbc9-30cd-3863-83bc-4f0d75ac3168",
                                                "text": "Les gouvernements croassaient : croissance !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
