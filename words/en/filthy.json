                                "target_lang_word": "ensuciar",
                                "target_lang_sense_clarification": "hacer que algo pierda su limpieza"
                            },
                            {
                                "target_lang_word": "manchar",
                                "target_lang_sense_clarification": "dejar una marca de suciedad en algo"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}