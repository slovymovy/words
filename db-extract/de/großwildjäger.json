                "senses": [
                    {
                        "sense_id": "33b834dd-d34c-3b29-b328-579c45456d3c",
                        "entry_id": "2f854566-908d-30b7-9f9c-19272a79bb0e",
                        "glosses": [
                            "Jäger, der sich auf die Jagd von Großwild spezialisiert hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "49b517e8-53db-4936-87a0-744684dc0414",
                                "sense_id": "33b834dd-d34c-3b29-b328-579c45456d3c",
                                "text": "Die Großwildjäger waren hatten schon wieder im Naturpark zugeschlagen."
                            },
                            {
                                "example_id": "56b9ca67-ce16-4668-bb65-2739e3844fa1",
                                "sense_id": "33b834dd-d34c-3b29-b328-579c45456d3c",
                                "text": "„Viele Gipfelsammler empfinden sich als Bezwinger der Bergriesen, die sie bestiegen haben. In Heldenpose stellen sie ihren Fuß auf den Gipfelpunkt wie der Großwildjäger auf das Haupt des erlegten Löwen.“"
                            },
                            {
                                "example_id": "b230138c-62a5-4c47-ae17-357b160d1a26",
                                "sense_id": "33b834dd-d34c-3b29-b328-579c45456d3c",
                                "text": "„Ein Großwildjäger bekommt Besuch.“"
                            },
                            {
                                "example_id": "911f74d1-bbaf-447b-a605-a56a6128c517",
                                "sense_id": "33b834dd-d34c-3b29-b328-579c45456d3c",
                                "text": "„Ungleich den meisten Großwildjägern war er ein ausgezeichneter und unermüdlicher Tänzer.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
