                "translations": [
                    {
                        "translation_id": "7841bc6c-34c9-475d-bc79-75af5cde29e6",
                        "source_entry_id": "3a9c2ab0-e6a7-37f5-b9d0-f94263b46b1e",
                        "source_sense_id": "69c61590-4abf-38c8-b442-0096b605fabb",
                        "source_sense_description": "een onderwerp dat bijzondere aandacht verdient of krijgt",
                        "target_lang_word": "Schwerpunkt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schwerpunkt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ce44cb44-ec63-3240-b2bf-333aad57a1e5",
                                        "entry_id": "7241006e-45d8-3ebd-8e6a-a408a36ac1ff",
                                        "glosses": [
                                            "(gedachter) Punkt, an dem die gesamte Masse eines Körpers oder Systems gleichmäßig verteilt erscheint"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "48a5250c-af0c-4c54-b87b-cdbec8b982b6",
                                                "sense_id": "ce44cb44-ec63-3240-b2bf-333aad57a1e5",
                                                "text": "Den Schwerpunkt einer Fläche kann man mit geometrischen Verfahren bestimmen."
                                            },
                                            {
                                                "example_id": "80cff713-1861-4d55-80f7-def051c22bfc",
                                                "sense_id": "ce44cb44-ec63-3240-b2bf-333aad57a1e5",
                                                "text": "„ Die Seitenhalbierenden eines Dreiecks schneiden sich in dem Punkt S, welcher ‚Schwerpunkt‘ genannt wird.“"
                                            },
                                            {
                                                "example_id": "71f815d8-8944-4e7f-b346-413099782803",
                                                "sense_id": "ce44cb44-ec63-3240-b2bf-333aad57a1e5",
                                                "text": "„Der Drachenflieger klinkt sich im Schwerpunkt seines Delta ein, um sein Fluggerät in einer schwebenden Liegendposition durch Gleichgewichtsveränderungen zu den Seiten, nach vorn oder nach hinten über ein Trapez steuern zu können.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e2a6ae9a-41a4-3c59-a0f7-e2270f3e1509",
                                        "entry_id": "7241006e-45d8-3ebd-8e6a-a408a36ac1ff",
                                        "glosses": [
                                            "vorrangiges Thema"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d174042a-4344-4638-b400-4ae630552240",
                                                "sense_id": "e2a6ae9a-41a4-3c59-a0f7-e2270f3e1509",
                                                "text": "Den Schwerpunkt des Vortrags bildeten die Ideen zur Bewältigung der Wirtschaftskrise."
                                            },
                                            {
                                                "example_id": "fc8edfb5-5c62-4646-9b93-9300d176b35a",
                                                "sense_id": "e2a6ae9a-41a4-3c59-a0f7-e2270f3e1509",
                                                "text": "„Dabei liegt der Schwerpunkt naturgemäß auf technischen, teilweise historischen Detailangaben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aa13fc2d-be3f-4b20-a66b-b7433281a4fc",
                        "source_entry_id": "3a9c2ab0-e6a7-37f5-b9d0-f94263b46b1e",
                        "source_sense_id": "69c61590-4abf-38c8-b442-0096b605fabb",
