                ],
                "senses": [
                    {
                        "sense_id": "003214d5-e742-31b9-ab56-5757da036d16",
                        "entry_id": "f2a0088d-2f1b-3fbd-9b6f-fe550ace46de",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ba29b2a1-98c7-416e-bf84-ed919831ba0b",
                                "sense_id": "003214d5-e742-31b9-ab56-5757da036d16",
                                "text": "Frau Gerstle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "d416519e-d51b-4bf9-99d5-73624315ed03",
                                "sense_id": "003214d5-e742-31b9-ab56-5757da036d16",
                                "text": "Herr Gerstle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "44b7b928-ee06-4eb3-b37f-2d9b25963579",
                                "sense_id": "003214d5-e742-31b9-ab56-5757da036d16",
                                "text": "Die Gerstles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "6218a530-c81c-4e38-98ae-21a64564dcd9",
                                "sense_id": "003214d5-e742-31b9-ab56-5757da036d16",
                                "text": "Der Gerstle trägt nie die Pullover, die die Gerstle ihm strickt."
                            },
                            {
                                "example_id": "ba2dd39d-cd4d-4409-8d50-437d3f717662",
                                "sense_id": "003214d5-e742-31b9-ab56-5757da036d16",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Gerstle kommt, geht der Herr Gerstle.“"
                            },
                            {
                                "example_id": "780eba33-8ade-42f1-b9e9-adbb0f327c41",
                                "sense_id": "003214d5-e742-31b9-ab56-5757da036d16",
                                "text": "Gerstle kommt und geht."
                            },
                            {
                                "example_id": "63fb0e5c-dbcb-4cbf-b586-c9a0b889644f",
                                "sense_id": "003214d5-e742-31b9-ab56-5757da036d16",
                                "text": "Gerstles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
