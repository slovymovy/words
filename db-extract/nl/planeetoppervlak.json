                            {
                                "example_id": "907b775c-93ff-46f5-9ff2-3d1f1a940305",
                                "sense_id": "d822e559-d96f-3878-925a-06e9f0e8929a",
                                "text": "De marinebasis lag op dit moment aan de nachtzijde van Jupiter, en de stalen bergclusters lagen stil te slapen onder de fosforescentie van het planeetoppervlak en het zilveren maanlicht van Europa aan de hemel."
                            },
                            {
                                "example_id": "6383bdf1-f22e-432f-96f3-34875cc4b004",
                                "sense_id": "d822e559-d96f-3878-925a-06e9f0e8929a",
                                "text": "Zandhozen zijn wervelwinden die de Marsbodem een paar minuten lang de lucht in werpen voor ze weer verdwijnen. Elke dag bewegen er miljoenen van over het planeetoppervlak. Verschillende landers hebben ze dan ook al opgemerkt."
                            }
