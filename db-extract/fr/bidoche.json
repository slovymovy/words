        "fr-extract.jsonl": [
            {
                "entry_id": "5d4ea193-87c0-3d9d-9f85-3ac89261b14b",
                "word": "bidoche",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "32e89aef-bba2-459b-8382-b63237d61c07",
                        "entry_id": "5d4ea193-87c0-3d9d-9f85-3ac89261b14b",
                        "tags": [
                            "plural"
                        ],
                        "form": "bidoches"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7aeb29b1-7cb2-3eb7-886f-7712a314d00d",
                        "entry_id": "5d4ea193-87c0-3d9d-9f85-3ac89261b14b",
                        "glosses": [
                            "Viande, souvent de mauvaise qualité."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "4e87875c-a4f0-417b-ad39-3efe74fdada7",
                                "sense_id": "7aeb29b1-7cb2-3eb7-886f-7712a314d00d",
                                "text": "Ces saloperies-là m’ont encore boulotté ma bidoche. Attends, que je réappâte."
                            },
                            {
                                "example_id": "a600fc30-776f-4218-9598-aa2730b4a4cf",
                                "sense_id": "7aeb29b1-7cb2-3eb7-886f-7712a314d00d",
                                "text": "Il était tard, près de 6 heures, et il n’aurait pas faim pour la bidoche bouillie de l’instituteur, mais il s’en moquait, gavé de sucreries, et d’autres douceurs encore jusqu’à l’écœurement."
                            },
                            {
                                "example_id": "71d8650e-6ad5-4b04-b150-fccba9e7155a",
                                "sense_id": "7aeb29b1-7cb2-3eb7-886f-7712a314d00d",
                                "text": "Mais pour l’Africain, l’éléphant n’avait d’autre beauté que le poids de sa bidoche et, quant à la dignité humaine, elle était avant tout celle d’un ventre plein."
                            },
                            {
                                "example_id": "0c422104-399d-4ce9-8356-193df4255697",
                                "sense_id": "7aeb29b1-7cb2-3eb7-886f-7712a314d00d",
                                "text": "Hugues était résigné comme un morceau de bidoche, paniqué, pétrifié."
                            }
                        ]
                    },
                    {
                        "sense_id": "7e82650f-2cfd-3628-87ed-fe8a060a186e",
                        "entry_id": "5d4ea193-87c0-3d9d-9f85-3ac89261b14b",
                        "glosses": [
                            "Chair. Corps humain."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "5722e0af-e25a-4fb9-9eac-a5441aa029e3",
                                "sense_id": "7e82650f-2cfd-3628-87ed-fe8a060a186e",
                                "text": "Je n’en perdais pas une broquille de toute cette bidoche exposée, de ces mamelles volumineuses, de ces cuisses grasses, vergeturées, s’entrouvrant sur des paysages insoupçonnés."
                            },
                            {
                                "example_id": "63fdde02-d722-443d-a859-a9880bb68e7d",
                                "sense_id": "7e82650f-2cfd-3628-87ed-fe8a060a186e",
                                "text": "Pour eux, les femmes étaient des pièces de viande, dans lesquelles ils mordaient à pleines dents et qu’ils recrachaient aussi sec si la bidoche n’était pas à leur goût."
                            }
                        ]
                    }
                ],
