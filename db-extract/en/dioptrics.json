                                        "entry_id": "e56e9005-9164-3ad5-a130-5387808e2c3e",
                                        "glosses": [
                                            "Partie de l’optique, qui détermine les directions que prennent les rayons lumineux, après avoir subi une ou plusieurs réfractions."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
