                "senses": [
                    {
                        "sense_id": "43b4bc92-1d14-3fe8-b96a-569baaf9ff56",
                        "entry_id": "ade95edb-2f9d-3e51-92c5-a2b81a47694c",
                        "glosses": [
                            "ausgestorbener Vogel, welcher zur Familie der Alken gehört; der größte flugunfähige Vogel in seinem Verbreitungsgebiet (Nordhalbkugel)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fec87f65-b2e2-47e3-a786-3f3334cbcd86",
                                "sense_id": "43b4bc92-1d14-3fe8-b96a-569baaf9ff56",
                                "text": "Früher wurde der Riesenalk als Pinguin bezeichnet, ist jedoch mit dieser Art nicht verwandt."
                            },
                            {
                                "example_id": "1c4e894b-10e8-40a0-9531-7934f14315b4",
                                "sense_id": "43b4bc92-1d14-3fe8-b96a-569baaf9ff56",
                                "text": "„Im Frühsommer waren die Riesenalke besonders gefährdet: Wenn die Weibchen an Land gingen, um zu brüten – wie die Königspinguine legten sie nur einziges Ei –, blieben sie Verfolgern wehrlos ausgeliefert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
