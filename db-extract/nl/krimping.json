                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dc46ca96-14c4-4c17-bc68-052a46d388cc",
                                                "sense_id": "cde02217-639d-3dd6-afbd-6e3b5f9bed1d",
                                                "text": "How far progress has been made in liquidating the locomotive stock of the old companies may be judged from the shrinkage in their numbers, by some 50 per cent. at the end of 1931, to about 35 per cent. in 1938."
                                            },
                                            {
                                                "example_id": "e9d076a3-09e5-4042-a356-7773ffec30d4",
                                                "sense_id": "cde02217-639d-3dd6-afbd-6e3b5f9bed1d",
                                                "text": "An emergency South Western Railway (SWR) timetable came into force on September 5, in response to the shrinkage of clay embankments on the nine miles between Gillingham and Tisbury. The shrinkage has been caused by the driest summer since 1936, with a severe 40mph speed restriction having to be imposed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "642fa9fc-a9ab-35c4-a331-aa98f649e7c9",
                                        "entry_id": "97c1261f-eaf6-3679-999d-6865cbe3c07d",
                                        "glosses": [
                                            "The act of shrinking, or the proportion by which something shrinks.",
                                            "The loss of merchandise through theft, spoilage, and obsolescence: the shrinking of inventory."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1ed26740-d6cb-3ead-8e20-645519e2f725",
                                        "entry_id": "97c1261f-eaf6-3679-999d-6865cbe3c07d",
                                        "glosses": [
                                            "The act of shrinking, or the proportion by which something shrinks.",
                                            "The reduction in size of the male genitalia when cold, such as from immersion in cold water."
                                        ],
                                        "tags": [
