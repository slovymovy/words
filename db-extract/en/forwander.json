                "senses": [
                    {
                        "sense_id": "0b3c9128-a78b-33dd-b612-3a9fe91de348",
                        "entry_id": "8e92f2d8-c1f4-3000-aff8-613bfd6b2068",
                        "glosses": [
                            "To wander until weary; wander far and wide."
                        ],
                        "tags": [
                            "UK",
                            "dialectal",
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "cbe0cba9-e6bf-4ef2-b2da-8e2893a497ed",
                                "sense_id": "0b3c9128-a78b-33dd-b612-3a9fe91de348",
                                "text": "Ah, I am full weary, lief, let me sleep, Forwandered and walked in this forest."
                            }
                        ]
                    },
                    {
                        "sense_id": "c98f128f-0251-327c-aece-87f496e51e91",
                        "entry_id": "8e92f2d8-c1f4-3000-aff8-613bfd6b2068",
                        "glosses": [
                            "To weary with wandering; cause to wander until weary."
                        ],
                        "tags": [
                            "UK",
                            "dialectal",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "d3f86e0a-14cb-41f3-ae73-9e08a8d81d75",
                                "sense_id": "c98f128f-0251-327c-aece-87f496e51e91",
                                "text": "[…] His courage, His purity, His meekness; His daily wakefulness to God's voice, the swiftness and brilliance of His speech for others, His silence under His own torments; His resorts—among the bruised, the prisoners, the forwandered of Israel, […]"
                            },
                            {
                                "example_id": "d3afc542-7767-4c4a-bb91-2c3ba42991bd",
                                "sense_id": "c98f128f-0251-327c-aece-87f496e51e91",
                                "text": "The Lent term had pulled me down, a week of modest enjoyment thereafter in town had finished the work; and I drank in the sharp moorish air like a thirsty man who has been forwandered among deserts."
                            }
                        ]
                    }
