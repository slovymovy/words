                        "entry_id": "8d4f4faa-29e6-318f-b83c-9317d708b74f",
                        "glosses": [
                            "Any enzyme that catalyzes the reduction of a substrate by the reversible oxidation of hydrogen."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8bf37137-2a81-4772-bb9f-fec7809fd239",
                                "sense_id": "fbe9b4c2-a996-3cdb-be64-122a68b810ec",
                                "text": "It is clear from the experiments cited already that we are dealing with a bacterial enzyme comparable with the dehydrogenases, the substrate in this case being molecular hydrogen. […] In order to conform with the accepted terminology we suggest that this enzyme be called \"hydrogenase.\""
                            }
                        ]
                    }
                ],
