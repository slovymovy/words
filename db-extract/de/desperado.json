                "senses": [
                    {
                        "sense_id": "94d0e02e-40d9-380f-b5a8-e7363c3cd1ff",
                        "entry_id": "b602fb6e-ce80-3f45-a9d1-682931107ed4",
                        "glosses": [
                            "gesetzloser, rücksichtsloser Mensch"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2bb10315-4615-412b-a3f8-bf160d34f6ea",
                                "sense_id": "94d0e02e-40d9-380f-b5a8-e7363c3cd1ff",
                                "text": "„Damit der Leser aus dem Osten sich eine klare Vorstellung davon machen kann, was es mit einem Desperado der Rocky Mountains auf sich hat, der sich auf dem Höhepunkt seiner Karriere befindet, will ich die Berge von Überland-Klatsch auf eine gedrängte Schilderung reduzieren, und sie in der folgenden Form darbieten:…“"
                            },
                            {
                                "example_id": "dfdf2b3f-be96-4cdd-a984-209df8bd0a13",
                                "sense_id": "94d0e02e-40d9-380f-b5a8-e7363c3cd1ff",
                                "text": "„Schließlich muß auch noch eine Horde politischer Desperados genannt werden, nämlich alle diejenigen, deren politisches Strebertum in anderen Parteien nicht befriedigt worden war, die sich nicht hatten durchsetzen können oder die aus meist recht eindeutigen Gründen mehr oder weniger zwangsweise ausgeschieden waren.“"
                            },
                            {
                                "example_id": "c1e6ac83-4a0b-4846-b236-6a5a66a10033",
                                "sense_id": "94d0e02e-40d9-380f-b5a8-e7363c3cd1ff",
                                "text": "„Diese Siedlung war neu und beherbergte Neuankömmlinge, Landbesetzer und Hüttenbauer und Desperados.\""
                            },
                            {
                                "example_id": "0d46b6fe-9637-4eba-b080-376577899099",
                                "sense_id": "94d0e02e-40d9-380f-b5a8-e7363c3cd1ff",
                                "text": "„Wenn man ein großer Desperado ist, sind nach oben keine Grenzen gesetzt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
