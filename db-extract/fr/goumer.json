                                "sense_id": "bb1896ce-1ede-3556-90fb-c0a2557d8602",
                                "text": "Ils l’ont goumé, n’est-ce-pas ?"
                            },
                            {
                                "example_id": "1648f6c5-a5e4-46e2-a1bf-7cb80d56f30e",
                                "sense_id": "bb1896ce-1ede-3556-90fb-c0a2557d8602",
                                "text": "J'suis pas un gentil, j'ai goumé Rocky j'réclame un trophy."
                            },
                            {
                                "example_id": "6e788bc6-2beb-4a30-8b93-e5318fee0add",
                                "sense_id": "bb1896ce-1ede-3556-90fb-c0a2557d8602",
                                "text": "On se goume encore, Madame ?"
                            },
                            {
                                "example_id": "cec2c1e0-10fa-4655-8c0e-bfe99b540261",
                                "sense_id": "bb1896ce-1ede-3556-90fb-c0a2557d8602",
                                "text": "Je me fais goumer par la vie et ca a l'air sans fin"
                            }
