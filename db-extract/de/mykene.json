                                        "sense_id": "754c41d5-f646-396f-ae0f-b7a1b4fa0883",
                                        "entry_id": "882b770f-3167-3ba6-91b7-6a657711c24a",
                                        "glosses": [
                                            "An ancient Greek city in the NE Peloponnesus on the plain of Argos, inhabited since about 4000 B.C.E."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de9d46cf-c1a5-4d6b-982c-ec6aa7496b57",
                                                "sense_id": "754c41d5-f646-396f-ae0f-b7a1b4fa0883",
                                                "text": "1958, Alan John Bayard Wace, Elizabeth Bayard French, The Mycenae Tablets II, American Philosophical Society, page 1,\nThe excavators of Mycenae added in 1953 and 1954 important new materials to the small but excellent archives of Mycenae."
                                            },
                                            {
                                                "example_id": "a36f6643-d4e1-4c13-b898-931d79f19830",
                                                "sense_id": "754c41d5-f646-396f-ae0f-b7a1b4fa0883",
                                                "text": "1992 [Routledge], Richard Tomlinson, From Mycenae to Constantinople, 2003, Taylor & Francis e-Library, page 31,\nIn 479 BC the citizen army of Mycenae marched to Plataea in Boeotia to join the other mainland Greek cities in inflicting the final defeat which terminated Xerxes' invasion of Greece."
                                            },
                                            {
                                                "example_id": "1bf0fb94-db78-49eb-89c0-a51e2a3a02cd",
                                                "sense_id": "754c41d5-f646-396f-ae0f-b7a1b4fa0883",
                                                "text": "The Prehistoric Cemetery at Mycenae provides our most coherent glimpse of the Middle Hellenic period at Mycenae."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
