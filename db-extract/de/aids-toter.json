                ],
                "senses": [
                    {
                        "sense_id": "980a2262-5697-3984-82f7-e3db1906eaef",
                        "entry_id": "ca1da1d1-285c-3412-979a-a77648d93329",
                        "glosses": [
                            "Person, die an AIDS gestorben ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9b5cdb9-f13f-49aa-8710-4304b5a4c4dc",
                                "sense_id": "980a2262-5697-3984-82f7-e3db1906eaef",
                                "text": "„Nach Jahren der Rückschläge scheint endlich ein Wendepunkt erreicht: Die Zahl der Aids-Toten und HIV-Infektionen sinkt deutlich.“"
                            },
                            {
                                "example_id": "06b198dd-1ac6-4adf-b93b-1b072afc60f1",
                                "sense_id": "980a2262-5697-3984-82f7-e3db1906eaef",
                                "text": "„Zum 1. April 2004 wurden offiziell 5751 HIV-Infektionen, 107 AIDS-Fälle und 439 AIDS-Tote in der Republik Weißrussland gemeldet.“"
                            },
                            {
                                "example_id": "55d7e67b-055a-4441-8230-173e8e8c4806",
                                "sense_id": "980a2262-5697-3984-82f7-e3db1906eaef",
                                "text": "„1995 wurde eine regenbogenbunte Grabstätte für Aids-Tote geschaffen, als noch kein Mittel gegen die Krankheit gefunden war und vor allem Homosexuelle an ihr starben, oft von ihren Partnern verlassen und von ihren Familien verstoßen.“"
                            },
                            {
                                "example_id": "a2493ce7-829b-4395-9c8b-b170d4965c39",
                                "sense_id": "980a2262-5697-3984-82f7-e3db1906eaef",
                                "text": "„Acht von zehn Aids-Toten in NRW waren Männer.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
