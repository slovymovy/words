                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0ff33581-a45a-4857-9151-eeb67ddd97c4",
                                "sense_id": "36a59359-4f4f-3a4f-921f-79d6feda7eff",
                                "text": "Polityk nie przestraszył się gróźb szantażysty i od razu poszedł na policję."
                            }
