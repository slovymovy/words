                        "cross_references": [
                            {
                                "target_word": "microcefalie",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "06b01fe3-0f33-3010-8b76-2e98c0838e1c",
                                        "entry_id": "a3d7861f-f876-3035-ac52-cc6d5671e741",
                                        "glosses": [
                                            "afwijking van het centrale zenuwstelsel waarbij de schedelomvang te klein is"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "790d0ccc-05ac-49f4-a18f-119eb15750b2",
                                                "sense_id": "06b01fe3-0f33-3010-8b76-2e98c0838e1c",
                                                "text": "Microcefalie is een aandoening van het centrale zenuwstelsel waarbij de hersenen zich niet volledig ontwikkelen en de schedel te klein blijft."
                                            },
                                            {
                                                "example_id": "d09806f9-463f-446d-8a46-d06441f947fa",
                                                "sense_id": "06b01fe3-0f33-3010-8b76-2e98c0838e1c",
                                                "text": "De Braziliaan Lalo de Almeida viel in de prijzen met een fotoverhaal over slachtoffers van het zika-virus. In Brazilië brak vorig jaar een epidemie uit van de relatief onbekende ziekte. Ineens werden er veel meer baby's geboren met kleine hoofdjes: zij hebben de aandoening microcefalie, veroorzaakt door het zika-virus."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0e7ffe12-94a5-442e-be36-22f3ac514eeb",
                        "source_entry_id": "94377cc7-950b-3ffa-91ff-a2b73f6dc0a3",
                        "source_sense_id": "fd0c0e90-0b3a-3b67-9226-034d461919a4",
                        "source_sense_description": "neurological disorder",
                        "target_lang_word": "microcéphalie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "microcéphalie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a68d30c7-0377-3b86-b460-f118baa44525",
                                        "entry_id": "62547223-0e08-3639-a69d-06732c17b985",
                                        "glosses": [
                                            "Anomalie de la boite crânienne dont le volume est inférieur à la taille moyenne constatée chez un individu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "94eb8231-9b70-4026-a684-6eaa5d907c5f",
                                                "sense_id": "a68d30c7-0377-3b86-b460-f118baa44525",
                                                "text": "Alors que la microcéphalie est rare (un cas sur 6 200 à 8 500 accouchements), son problème diagnostique se pose souvent à l’échographie anténatale."
                                            },
                                            {
                                                "example_id": "7903efd6-69f5-4380-9332-eec734b942d6",
                                                "sense_id": "a68d30c7-0377-3b86-b460-f118baa44525",
                                                "text": "Si elle n'a pas encore été scientifiquement prouvée à 100%, l'association entre le virus Zika et la microcéphalie « est de plus en plus évidente », selon l'OMS."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "35c26792-ab68-3d5e-a163-7e951f9f96b3",
                                        "entry_id": "62547223-0e08-3639-a69d-06732c17b985",
                                        "glosses": [
                                            "Nom donné quelquefois à l’idiotisme, les idiots ayant généralement la tête très petite."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8ae0bee8-4e15-4283-93d7-cda23dd26e1b",
                                                "sense_id": "35c26792-ab68-3d5e-a163-7e951f9f96b3",
                                                "text": "Le bas de l’échelle est occupé par l’idiotie (microcéphalie), l’imbécillité, l’épilepsie ; le milieu, par la manie et la pellagre ; le sommet, par la mélancolie : là, surtout chez l’homme, sont les plus grands crânes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
