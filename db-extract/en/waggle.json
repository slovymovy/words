                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee2433e2-9488-4ce3-b3c4-64f790e122f5",
                                                "sense_id": "cccad657-6c1c-32a4-aa6d-57cb182401b0",
                                                "text": "Der Sturm war so stark, dass das Haus wackelte."
                                            }
                                        ],
