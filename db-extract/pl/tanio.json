                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "billig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "87d3a093-c194-35a6-ac30-710d91d1cf4c",
                                        "entry_id": "e5ec3f80-0bba-3aa4-89e5-ab8907743105",
                                        "glosses": [
                                            "angemessen (recht und billig)"
                                        ],
                                        "tags": [
                                            "ursprünglich"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9c55e1c7-c4fd-4d7e-8263-da752382ab75",
                                                "sense_id": "87d3a093-c194-35a6-ac30-710d91d1cf4c",
                                                "text": "Es ist nur billig, so zu entscheiden."
                                            },
                                            {
                                                "example_id": "862067e2-c380-4367-8398-7419ab68cdff",
                                                "sense_id": "87d3a093-c194-35a6-ac30-710d91d1cf4c",
                                                "text": "„[…]; wer dagegen nur kraft seiner natürlichen Freiheit handelt, darf diese nicht zum Schaden Anderer mißbrauchen; ein Mißbrauch ist es aber, wenn seine Handlungsweise den in den guten Sitten sich ausprägenden Auffassungen und dem Anstandsgefühle aller billig und gerecht Denkenden widerspricht.“"
                                            },
                                            {
                                                "example_id": "7d5c9ef1-b983-43c0-8721-41137b0618bb",
                                                "sense_id": "87d3a093-c194-35a6-ac30-710d91d1cf4c",
                                                "text": "„Es ist in der Regel zumindest dann, wenn der Berechtigte auf die sofortige Zahlung nicht angewiesen ist, dem Ausgleichspflichtigen aber wegen seiner wirtschaftlichen Möglichkeit eine sich über viele Jahre erstreckende Teilzahlungsmöglichkeit eingeräumt wird, billig, ihm eine Wertsicherung oder Verzinsung auch dann aufzuerlegen, wenn der Ausgleichszahlungsberechtigte wegen der nicht sofortigen Leistung der Ausgleichszahlung keinen verzinsten Kredit aufnehmen muß.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9975e4df-8d79-3f32-a9f0-22fc3ec41f6c",
                                        "entry_id": "e5ec3f80-0bba-3aa4-89e5-ab8907743105",
                                        "glosses": [
                                            "einen niedrigen Preis oder niedrige Kosten habend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b6194993-8edc-46e8-aedc-1de0cdaf3e25",
                                                "sense_id": "9975e4df-8d79-3f32-a9f0-22fc3ec41f6c",
                                                "text": "Sie haben die billigste Lösung gewählt."
                                            },
                                            {
                                                "example_id": "b3db1a5b-69ce-4ff0-8606-4e9edb020775",
                                                "sense_id": "9975e4df-8d79-3f32-a9f0-22fc3ec41f6c",
                                                "text": "Den gleichen Staubsauger gibt es im anderen Laden 20 € billiger."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "d8a7b852-0ff4-30d2-bb20-2b62126e3568",
                                        "entry_id": "e5ec3f80-0bba-3aa4-89e5-ab8907743105",
