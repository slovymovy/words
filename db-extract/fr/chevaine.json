                "senses": [
                    {
                        "sense_id": "825f4801-6c6b-3cee-9fc3-a2241a42eb3c",
                        "entry_id": "6b93c1da-9c92-3f15-9383-dca0a20c9dbe",
                        "glosses": [
                            "Variante orthographique de chevesne."
                        ],
                        "tags": [
                            "alt-of"
                        ],
                        "examples": [
                            {
                                "example_id": "adb59634-7b6b-49cc-a761-6ae9d4097afa",
                                "sense_id": "825f4801-6c6b-3cee-9fc3-a2241a42eb3c",
                                "text": "Alors les chevaines bondissaient à la surface des flots, happant les insectes du soir, et leurs sauts faisaient à la surface de la rivière de grands cercles lumineux, qui allaient mourir sur les bords."
                            },
                            {
                                "example_id": "76e77bc0-efb4-41c6-9ee5-bc5b5fc403c8",
                                "sense_id": "825f4801-6c6b-3cee-9fc3-a2241a42eb3c",
                                "text": "Dans les zones dites à ombre ou à barbeaux, certains poissons blancs comme le chevaine, la vandoise, le blageon partagent le même habitat que les truites."
                            },
                            {
                                "example_id": "c85170be-c125-441f-be11-834d8db0f08e",
                                "sense_id": "825f4801-6c6b-3cee-9fc3-a2241a42eb3c",
                                "text": "Après les crues, les conditions sont propices aux poissons qui fraient dans les graviers, comme la chevaine."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
