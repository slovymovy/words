                "senses": [
                    {
                        "sense_id": "7cb00844-2c31-340e-a146-fa12c174f7e3",
                        "entry_id": "fec4c338-f536-37c8-9861-14d932e7436d",
                        "glosses": [
                            "durch Fett vergrößerte Männerbrust"
                        ],
                        "tags": [
                            "derogatory",
                            "plural-normally",
                            "vulgar"
                        ],
                        "examples": [
                            {
                                "example_id": "c0ed2039-3070-4f61-813f-d585eadca87c",
                                "sense_id": "7cb00844-2c31-340e-a146-fa12c174f7e3",
                                "text": "„Oft haben sich die Opfer die Rundungen, die sie so quälen, schlicht angefuttert - die Brust zeigt spitz nach vorn oder hängt euterartig durch, weil sich unter der Haut ein zähes Fettpolster angesammelt hat; der Volksmund spricht von \"Biertitte\", der Fachmann von \"Lipomastie\".“"
                            },
                            {
                                "example_id": "94653bf8-1115-4256-9a30-516d848f5472",
                                "sense_id": "7cb00844-2c31-340e-a146-fa12c174f7e3",
                                "text": "„Mir brannte das Herz unter der bleichen Biertitte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
