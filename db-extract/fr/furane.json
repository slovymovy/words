            {
                "entry_id": "e6341ab0-517b-3979-8255-dad7411a27b5",
                "word": "furane",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "c92d9767-28a5-43e1-a7ff-0f04c48a4ed5",
                        "entry_id": "e6341ab0-517b-3979-8255-dad7411a27b5",
