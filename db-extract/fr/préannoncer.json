                "senses": [
                    {
                        "sense_id": "40a4b761-bf9d-3899-88fd-fb176657b163",
                        "entry_id": "82e70524-6e7c-3378-a701-1528325eafe7",
                        "glosses": [
                            "Annoncer à l’avance, avant l’annonce normale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "285774db-e567-4263-9ff0-5becbdac12b1",
                                "sense_id": "40a4b761-bf9d-3899-88fd-fb176657b163",
                                "text": "Je sais bien que c'est un mal plaisant discours à celui qui aime et honore son pays et sa nation, d'en vouloir préannoncer les chutes, ce qui ne se peut faire, sans aussi en découvrir les turpitudes."
                            },
                            {
                                "example_id": "a71b6d84-a55c-473c-a514-932d2f17bcc8",
                                "sense_id": "40a4b761-bf9d-3899-88fd-fb176657b163",
                                "text": "Je crois que Mussolini partira par avion, sans rien préannoncer, et qu'il apparaîtra au public le moins possible, entouré par une cuirasse de sbires.="
                            }
                        ]
                    }
