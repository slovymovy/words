                        "source_sense_description": "(intransitive) (archaic or dialectal) To wait; to be in expectation; to stay; to remain",
                        "target_lang_word": "ждать",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ждать",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "0d76e847-5ca2-3aed-857d-bd9e9fa68ff4",
                                        "entry_id": "6aff14ad-64bb-396c-90aa-db0729fad5a6",
                                        "glosses": [
                                            "испытывать чувство по отношению к чему-либо, что должно произойти, наступить; настраивать себя на это предстоящее событие"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f64f6706-ead5-427e-8a45-be428082e5b7",
                                                "sense_id": "0d76e847-5ca2-3aed-857d-bd9e9fa68ff4",
                                                "text": "Ждать конца войны."
                                            },
                                            {
                                                "example_id": "afafc42a-90e7-49eb-9b39-e17f296e08fc",
                                                "sense_id": "0d76e847-5ca2-3aed-857d-bd9e9fa68ff4",
                                                "text": "Ждать писем от кого-либо."
                                            },
                                            {
                                                "example_id": "b8cea06a-d755-49f2-b111-d70d9bd4fbf1",
                                                "sense_id": "0d76e847-5ca2-3aed-857d-bd9e9fa68ff4",
                                                "text": "Ждём вас завтра к обеду."
                                            },
                                            {
                                                "example_id": "bcf9d602-ed8b-4d93-af37-70d8ac5905fc",
                                                "sense_id": "0d76e847-5ca2-3aed-857d-bd9e9fa68ff4",
                                                "text": "Ждём от вас решительных действий."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9051f15f-f2d7-31a5-8a56-36b060eb9865",
                                        "entry_id": "6aff14ad-64bb-396c-90aa-db0729fad5a6",
                                        "glosses": [
                                            "проводить время, рассчитывая на появление кого-либо или чего-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed121052-3bd2-4673-9c31-42461533150b",
                                                "sense_id": "9051f15f-f2d7-31a5-8a56-36b060eb9865",
                                                "text": "Ждать поезда."
                                            },
                                            {
                                                "example_id": "13af3044-8924-4753-b0ff-264333b24660",
                                                "sense_id": "9051f15f-f2d7-31a5-8a56-36b060eb9865",
                                                "text": "Ждать прихода родителей."
                                            },
                                            {
                                                "example_id": "b168e0e9-cdfd-406e-8344-e55bfe5ded11",
                                                "sense_id": "9051f15f-f2d7-31a5-8a56-36b060eb9865",
                                                "text": "Ждать своей очереди."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3c72077b-0d7b-39e8-8a90-066f83d07cda",
                                        "entry_id": "6aff14ad-64bb-396c-90aa-db0729fad5a6",
                                        "glosses": [
                                            "перен. надеяться на что-либо, предполагать (наступление) чего-либо"
                                        ],
                                        "tags": [
                                            "иногда употр. с предлогом с + тв. п."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e4572234-2391-4bb1-a0b3-74fa95055f97",
                                                "sense_id": "3c72077b-0d7b-39e8-8a90-066f83d07cda",
                                                "text": "Я жду от него извинений."
                                            },
                                            {
                                                "example_id": "81c85eee-7cf0-4c6b-9f41-bf25717e9412",
                                                "sense_id": "3c72077b-0d7b-39e8-8a90-066f83d07cda",
                                                "text": "От эгоистичного человека помощи ждать нечего."
                                            },
                                            {
                                                "example_id": "b5c1db9b-d1e5-4b72-8e84-882899fc154a",
                                                "sense_id": "3c72077b-0d7b-39e8-8a90-066f83d07cda",
                                                "text": "Не жди, что всё решится само собой."
                                            },
                                            {
                                                "example_id": "28aef673-f72e-483b-9857-ed5436a6d719",
                                                "sense_id": "3c72077b-0d7b-39e8-8a90-066f83d07cda",
                                                "text": "Я жду, что ты изменишь свою точку зрения"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dc4bba33-a69a-3bc5-acb1-0597fd6cc1e9",
                                        "entry_id": "6aff14ad-64bb-396c-90aa-db0729fad5a6",
                                        "glosses": [
                                            "медлить, откладывать что-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1d14d20-26a2-4680-a9b9-30afe12aa8fd",
                                                "sense_id": "dc4bba33-a69a-3bc5-acb1-0597fd6cc1e9",
                                                "text": "Хватит ждать уже, начинай действовать!"
                                            },
                                            {
                                                "example_id": "63292938-e21d-4bf2-a397-c8b7a868b295",
                                                "sense_id": "dc4bba33-a69a-3bc5-acb1-0597fd6cc1e9",
                                                "text": "Чего ты ждёшь? Пробуй!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a00d4509-b39d-3c9e-bac7-bd13349f7272",
                                        "entry_id": "6aff14ad-64bb-396c-90aa-db0729fad5a6",
                                        "glosses": [
                                            "быть неминуемым, быть уготованным, предстоять кому-либо"
                                        ],
                                        "tags": [
                                            "только в 3л."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ef948882-b1fe-4708-94d2-9e391f4c9182",
                                                "sense_id": "a00d4509-b39d-3c9e-bac7-bd13349f7272",
                                                "text": "На этом пути нас ждут препятствия."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c9a58f6c-3d2b-382c-a1ae-fc286af63662",
                                        "entry_id": "6aff14ad-64bb-396c-90aa-db0729fad5a6",
                                        "glosses": [
                                            "то же, что предназначаться"
                                        ],
                                        "tags": [
                                            "только в 3л."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ee411892-869d-4aff-93e8-64638a5dfd98",
                                                "sense_id": "c9a58f6c-3d2b-382c-a1ae-fc286af63662",
                                                "text": "Гостей ждал обед."
                                            },
                                            {
                                                "example_id": "a3ffaf3e-eeca-4603-8b14-7d340bdba59d",
                                                "sense_id": "c9a58f6c-3d2b-382c-a1ae-fc286af63662",
                                                "text": "Ваша комната свободна и ждёт вас."
                                            },
                                            {
                                                "example_id": "8b849a6b-4d79-4713-8bbc-4814488d180c",
                                                "sense_id": "c9a58f6c-3d2b-382c-a1ae-fc286af63662",
                                                "text": "Победителей конкурса ждут премии."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
