                "senses": [
                    {
                        "sense_id": "ca8e257b-c939-33dd-a702-f2b37d35c54c",
                        "entry_id": "3f6d24a6-9223-3854-b67a-57d6b769720f",
                        "glosses": [
                            "Personne de l’administration d’un État ou d’un gouvernement qui est pronucléaire, qui est partisane de l’utilisation de l’énergie nucléaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "95c91b3f-c391-4f3e-be1f-8cd60f0ad226",
                                "sense_id": "ca8e257b-c939-33dd-a702-f2b37d35c54c",
                                "text": "Le premier nucléocrate que j’ai rencontré était un des figurants de la commission Péon."
                            },
                            {
                                "example_id": "2043eb4a-f91a-4334-aba6-5aff5d20dab5",
                                "sense_id": "ca8e257b-c939-33dd-a702-f2b37d35c54c",
                                "text": "« Besson est un nucléocrate ». Depuis deux jours, Éric Besson et Nathalie Kosciusko-Morizet courent les plateaux télé pour tenter de rassurer sur les dangers du nucléaire. Une tache qu'Eric Besson accomplit d'ailleurs avec zèle."
                            },
                            {
                                "example_id": "d897a9e2-c477-4b80-92c2-fdf27500f2a5",
                                "sense_id": "ca8e257b-c939-33dd-a702-f2b37d35c54c",
                                "text": "L’inventaire des déchets qui pourraient être stockés dans cette installation n’est même pas encore arrêté. Les nucléocrates eux-mêmes l’admettent. Et l’on ne peut que s’amuser de constater que derrière leur résolution à lancer Cigéo des doutes existent."
                            }
                        ]
                    }
                ],
