                "senses": [
                    {
                        "sense_id": "fc98746c-c17c-36af-a5fe-e3def13b4ef9",
                        "entry_id": "086a6966-8979-3e14-9337-4a2b777b8f94",
                        "glosses": [
                            "Saucissonner à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1889c22e-30c1-4413-8f2a-4dbf1be1aa2c",
                                "sense_id": "fc98746c-c17c-36af-a5fe-e3def13b4ef9",
                                "text": "Aujourd'hui, je vais bien resaucissonner le faisceau et l'isoler, puis aller faire mon petit tour ds la rue!"
                            },
                            {
                                "example_id": "621f8eea-5124-41fd-9bbd-6b2ec4bdcedf",
                                "sense_id": "fc98746c-c17c-36af-a5fe-e3def13b4ef9",
                                "text": "J'ai peur que le véto veuille la resaucissonner demain."
                            },
                            {
                                "example_id": "ec220aa2-42aa-4f91-a964-1cb1ea32443e",
                                "sense_id": "fc98746c-c17c-36af-a5fe-e3def13b4ef9",
                                "text": "Bien entendu, si on rajoute qu’on n’est pas capable de construire une unité d’enseignement qui associe les mathématiques et la physique, il faudra resaucissonner en unités disciplinaires."
                            }
                        ]
                    }
