                                    {
                                        "sense_id": "e5e6c9f9-bb00-3ebc-8976-e4aa44ff46b6",
                                        "entry_id": "c35c40e8-2bfa-37e9-9273-93ef4b45c9ca",
                                        "glosses": [
                                            "An indigenous Melanesian inhabitant of New Caledonia."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb5c8fe9-3956-4e0c-85be-d6ada93e3b2e",
                                                "sense_id": "e5e6c9f9-bb00-3ebc-8976-e4aa44ff46b6",
                                                "text": "In the working-class districts of Nouméa, which have a high population of indigenous Kanak residents, buildings were burned and wrecked vehicles remained in the middle of the road."
                                            }
                                        ]
                                    }
                                ]
                            }
