                ],
                "senses": [
                    {
                        "sense_id": "4e6d7519-8f00-39e4-b62d-34680351d867",
                        "entry_id": "a2bfbc8f-5af5-3c89-8590-5b8a0a37da3d",
                        "glosses": [
                            "Tätigkeit, Vorgang, Prozess zur Handhabung und Entsorgung des regionalen Müllaufkommens"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b9863eb-051a-48a9-a01a-feca10c58287",
                                "sense_id": "4e6d7519-8f00-39e4-b62d-34680351d867",
                                "text": "„Gemeinsam mit der Firma Abfallmanagement Peters wurde Mitte 2009 das Pilotprojekt „Müllmanagement“ ins Leben gerufen.“"
                            },
                            {
                                "example_id": "d25a0efb-51da-4645-b11b-de905534f770",
                                "sense_id": "4e6d7519-8f00-39e4-b62d-34680351d867",
                                "text": "„Dabei werden diese Kosten nicht nur von unserem Geldbeutel, sondern auch durch die Umwelt getragen und somit gibt es schon mindestens zwei triftige Gründe, warum sich Müllmanagement lohnt.“"
                            },
                            {
                                "example_id": "c028f1b8-f133-41ab-8328-4e478b1e9e64",
                                "sense_id": "4e6d7519-8f00-39e4-b62d-34680351d867",
                                "text": "„Wichtig zu verantwortbarem Müllmanagement sind drei Dinge: Der Wille den Müll umweltschonend zu entsorgen, das Mitführen von Müllsäcken, möglichst oben mit Schnurzug, eine Schaufel zum Vergraben.“"
                            },
                            {
                                "example_id": "6a8fdcbd-ab09-4804-8c7b-02550e7fa88a",
                                "sense_id": "4e6d7519-8f00-39e4-b62d-34680351d867",
                                "text": "„Der Mieter wehrt sich gegen die Umlage der Kosten für das Müllmanagement durch einen externen Dienstleister, die der Vermieter unter der Position „Müllabfuhr“ abrechnet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
