                    {
                        "translation_id": "f9688aae-98a5-40ca-a9d0-03899f068409",
                        "source_entry_id": "622f3106-fba7-3353-9743-436dd827f5e6",
                        "source_sense_id": "ea0310b8-f78d-35eb-bf7d-46e7180b67a0",
                        "target_lang_word": "свиязь",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "свиязь",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "b795fd77-7fa8-38bb-8b1c-dccca02e621d",
                                        "entry_id": "75e0e1be-45f0-3c86-9848-0cee6756ab04",
                                        "glosses": [
                                            "орнитол. небольшая пестроватая утка (Anas penelope)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a5a0b31c-38db-43b2-bf47-a3f9a664c840",
                                                "sense_id": "b795fd77-7fa8-38bb-8b1c-dccca02e621d",
                                                "text": "Нырки, чернь и свиязь чаще всех машут крыльями и быстрее рассекают воздух: шум от их полёта сливается в один дребезжащий, пронзительный свист."
                                            },
                                            {
                                                "example_id": "de538a70-885f-4f36-b86e-490edbdcc910",
                                                "sense_id": "b795fd77-7fa8-38bb-8b1c-dccca02e621d",
                                                "text": "Над курганом с тугим и дробным свистом пронеслась стайка свиязей."
                                            },
                                            {
                                                "example_id": "f10b5df0-5deb-4f1b-8c53-48b644cc2e51",
                                                "sense_id": "b795fd77-7fa8-38bb-8b1c-dccca02e621d",
                                                "text": "На отмелях, в траве и песках роются утки, поплавками задранных задов усеяв прибрежье. Серухи, шилохвостки, свиязи совсем не боятся лодки."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
