                    },
                    {
                        "translation_id": "e8ccdbaa-e26e-498f-ac78-81847b27d8a3",
                        "source_entry_id": "d197b1a8-2a07-3070-bbc4-0a9b110cd39a",
                        "target_lang_word": "der brennende Dornbusch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "9674b208-c243-4688-a64f-b1f9c73a0259",
                        "source_entry_id": "d197b1a8-2a07-3070-bbc4-0a9b110cd39a",
                        "target_lang_word": "buisson",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "buisson",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "afe754e1-9bd8-39fd-9b7a-ab325079735c",
                                        "entry_id": "3987c7bc-4e5a-31f4-b8b0-f5fd86fa97d7",
                                        "glosses": [
                                            "Touffe d’arbustes sauvages."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fecb86d7-0044-44c2-855e-302af5f21ff1",
                                                "sense_id": "afe754e1-9bd8-39fd-9b7a-ab325079735c",
                                                "text": "Nous reçûmes l’ordre de côtoyer en le remontant le ruisseau de la Tourbe, qui arrose la plus triste vallée du monde, entre des collines basses, sans arbres et sans buissons."
                                            },
                                            {
                                                "example_id": "accb4a60-c9a5-42a5-839b-b23c559e9a53",
                                                "sense_id": "afe754e1-9bd8-39fd-9b7a-ab325079735c",
                                                "text": "Les silhouettes des buissons frangeaient son chemin et il allait, tête levée, respirant large."
                                            },
                                            {
                                                "example_id": "bc819497-2e61-4b46-b2bf-72a65a4ce33b",
                                                "sense_id": "afe754e1-9bd8-39fd-9b7a-ab325079735c",
                                                "text": "Des lavandes faisaient bordure devant une touffe de sauge, deux ou trois rosiers pomponnants et un épais buisson d'herbe de la pampa arborant ses plumets vaniteusement décoratifs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "15d840a9-3a31-379c-ab51-a7ab03da98a5",
                                        "entry_id": "3987c7bc-4e5a-31f4-b8b0-f5fd86fa97d7",
                                        "glosses": [
                                            "Nuage de poussière soulevé par une tornade."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
