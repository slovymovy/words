                                        "sense_id": "9a99c9b7-fb47-379c-a5a6-5f9d95464d3e",
                                        "entry_id": "ecfc6e10-a93a-3cab-9a3a-fb0dd478dd70",
                                        "glosses": [
                                            "de situatie waarbij alle partijen het met elkaar eens zijn"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "74755c97-7b5a-4d72-9e64-b3ebe88b97b3",
                                                "sense_id": "9a99c9b7-fb47-379c-a5a6-5f9d95464d3e",
                                                "text": "Gelukkig was er na 3 uur zwaar onderhandelen eindelijk overeenstemming en konden de stakende arbeiders naar huis."
                                            },
                                            {
                                                "example_id": "531a2df2-b1af-4e32-bf2d-4a086f6faa4d",
                                                "sense_id": "9a99c9b7-fb47-379c-a5a6-5f9d95464d3e",
                                                "text": "Erger dan dat werd het niet, ik heb die angst voor de socialisten nooit begrepen. Je kunt altijd tot overeenstemming komen. Ik heb er in elk geval nooit problemen mee gehad."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1247bb84-3e69-410d-8b04-b75a2884bf01",
                        "source_entry_id": "b5cddaf9-ca97-305c-86d0-854e03951b17",
                        "source_sense_description": "capability to exist without mutual interference",
                        "target_lang_word": "compatibilité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "compatibilité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "91b974eb-bed9-3747-800a-3a24d1d49a27",
                                        "entry_id": "20d62015-90b6-3689-8945-f25defc07337",
                                        "glosses": [
                                            "Qualité de ce qui est compatible."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b11f6bd-ffe2-4b18-9101-daee36678d92",
                                                "sense_id": "91b974eb-bed9-3747-800a-3a24d1d49a27",
                                                "text": "Il y a une grande compatibilité d’humeur entre ces deux personnes."
                                            },
                                            {
                                                "example_id": "bdf6c882-806d-4fe0-8423-dbfb0193dade",
                                                "sense_id": "91b974eb-bed9-3747-800a-3a24d1d49a27",
                                                "text": "Il n’y a pas compatibilité entre ces deux fonctions."
                                            },
                                            {
                                                "example_id": "0830513a-8606-4fea-97c6-1ef3afa562b5",
                                                "sense_id": "91b974eb-bed9-3747-800a-3a24d1d49a27",
                                                "text": "La deuxième possibilité conduit à supposer que les firmes peuvent avoir intérêt à développer la compatibilité de leurs technologies ou de leurs produits."
                                            },
                                            {
                                                "example_id": "ef729ec4-460e-462b-96cd-e6652e97f4ec",
                                                "sense_id": "91b974eb-bed9-3747-800a-3a24d1d49a27",
                                                "text": "Compatibilité des logiciels informatiques."
                                            },
                                            {
                                                "example_id": "cbc26606-732e-42ed-83e1-fa3e3e2ccff5",
                                                "sense_id": "91b974eb-bed9-3747-800a-3a24d1d49a27",
                                                "text": "[…] un rapport de compatibilité, tel qu’il est notamment pratiqué en matière d’urbanisme, tolère un écart avec la norme de référence, du moment qu’elle ne s’en trouve pas remise en cause, tandis qu’un rapport de conformité exige une adéquation parfaite […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "57bba5de-7075-3f4e-a2f5-426746807cc9",
                                        "entry_id": "20d62015-90b6-3689-8945-f25defc07337",
                                        "glosses": [
                                            "Capacité de deux plasmides à coexister de façon stable à l’intérieur d'un hôte commun."
                                        ],
                                        "tags": [
                                            "Génétique"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "88975099-fbd5-4ad9-ad9a-c0d8a800507f",
                        "source_entry_id": "b5cddaf9-ca97-305c-86d0-854e03951b17",
                        "source_sense_description": "capability to exist without mutual interference",
                        "target_lang_word": "Vereinbarkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vereinbarkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7e655c2b-c463-3c3f-abb9-958e0c943379",
                                        "entry_id": "3d4d943a-93a7-36e8-a669-8c74d41f3ce0",
                                        "glosses": [
                                            "Möglichkeit, Etwas mit etwas Anderem in Übereinstimmung zu bringen"
                                        ],
                                        "tags": [
                                            "meist Singular"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5f244720-ce8a-425e-8df7-cd8a1b710fb7",
                                                "sense_id": "7e655c2b-c463-3c3f-abb9-958e0c943379",
                                                "text": "„Gesetzestexte, die sich auf Vorgänge des modernen Wirtschafts-, Finanz- und Alltagslebens beziehen, werden von islamischen Rechtsgelehrten auf ihre Vereinbarkeit mit der Scharia geprüft, bevor sie durch königliches Dekret wirksam werden.“"
                                            },
                                            {
                                                "example_id": "27a40f3f-fae8-4ec0-93b8-cf91b45ba520",
                                                "sense_id": "7e655c2b-c463-3c3f-abb9-958e0c943379",
                                                "text": "„Drei Monate zuvor glaubte [Einstein] noch, die Vereinbarkeit dieses Prinzips mit dem Relativitätsprinzip – also mit der Gleichberechtigung aller Inertialsysteme – erst nachweisen zu müssen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5dbdf401-813b-4e73-aa91-0f2a19ee3fb9",
                        "source_entry_id": "b5cddaf9-ca97-305c-86d0-854e03951b17",
                        "source_sense_description": "capability to exist without mutual interference",
                        "target_lang_word": "Kompatibilität",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kompatibilität",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2b3a44e7-7445-39c2-9f12-82e1d69485e6",
                                        "entry_id": "8ae90ea4-18a7-3c96-bb9d-7d9cb911256a",
                                        "glosses": [
                                            "die Eigenschaft kompatibel zu sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8945dd49-f8a1-4e89-a866-0c01bf027219",
                                                "sense_id": "2b3a44e7-7445-39c2-9f12-82e1d69485e6",
                                                "text": "Bevor man die Bauteile in den Computer einbaut, sollte man auf deren Kompatibilität achten."
                                            },
                                            {
                                                "example_id": "de0dba87-1b73-44a0-b621-94a6415868cc",
                                                "sense_id": "2b3a44e7-7445-39c2-9f12-82e1d69485e6",
                                                "text": "„Allerdings ist das so eine Sache mit der Kompatibilität von Sehnsucht und Realität.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3f10e37d-0ae9-3287-b5b2-f6d7e733d5c9",
                                        "entry_id": "8ae90ea4-18a7-3c96-bb9d-7d9cb911256a",
                                        "glosses": [
                                            "Verträglichkeit, Kombinierbarkeit sprachlicher Elemente im Satz"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c843ee15-745c-4a88-b1f0-bdbcb74a9ae0",
                                                "sense_id": "3f10e37d-0ae9-3287-b5b2-f6d7e733d5c9",
                                                "text": "„Auf semantischen Merkmalen als bedeutungskonstitutiven Elementen beruhen Kompatibilität oder Inkompatibilität lexikalischer Einheiten.“"
                                            },
                                            {
                                                "example_id": "15e001d2-59d7-40dd-afb1-9c68657d4b3a",
                                                "sense_id": "3f10e37d-0ae9-3287-b5b2-f6d7e733d5c9",
                                                "text": "„Die Kompatibilität, die in den soeben genannten Forschungsrichtungen als eine primär semantische Erscheinung gewertet wurde, muß auf der Ausdrucksseite der Sprache eine irgendwie geartete Entsprechung haben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
