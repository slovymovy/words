            {
                "entry_id": "446b0c99-0f2f-3593-af6a-68a301acc79c",
                "word": "ashfield",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "529fd523-bea1-4c10-9b0c-55b43d0348bc",
                        "entry_id": "446b0c99-0f2f-3593-af6a-68a301acc79c",
                        "tags": [
                            "plural"
                        ],
                        "form": "ashfields"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e78f8896-d598-358d-afeb-fe1852ce68b6",
                        "entry_id": "446b0c99-0f2f-3593-af6a-68a301acc79c",
                        "glosses": [
                            "A field that is covered in ash."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6e55bff0-e331-4477-993d-3fb1a3b1b5ff",
                                "sense_id": "e78f8896-d598-358d-afeb-fe1852ce68b6",
                                "text": "The ashfield of ten square miles above Nicolosi, created by the eruption of 1669, which was entirely barren in 1835, is now planted with vines almost to the summits of Mone Rosso, at a height of three thousand feet."
                            },
                            {
                                "example_id": "9c5d8c1b-d188-4d3f-9be6-16924739f8ad",
                                "sense_id": "e78f8896-d598-358d-afeb-fe1852ce68b6",
                                "text": "Components of oil-shale ash deposited on ashfields, consumed or ejected with exhaust gases."
                            },
                            {
                                "example_id": "7583ff7a-87e6-403c-92e8-f67f6f52b0d2",
                                "sense_id": "e78f8896-d598-358d-afeb-fe1852ce68b6",
                                "text": "His mind was a field of ashes, most of his hope gone. But there were hot coals of anger under the ashfield, and any indication that she still respected him as an adversary would feed his ego and fan flames from those coals."
                            }
                        ]
                    }
                ],
