                        "examples": [
                            {
                                "example_id": "32f2c890-ef61-4e0f-87fc-949fe06e18ae",
                                "sense_id": "c078ddbf-ff60-3dbe-b559-e86400c6bcbd",
                                "text": "„Bei im Freiland gefangenen Zellen fehlt der Symbiont nur selten, einige Symbionten sind jedoch nicht voll entwickelt, was über den Lebenszyklus erklärt werden könnte.“"
                            }
                        ],
