                    },
                    {
                        "translation_id": "aee4eaf2-5203-47a0-b512-eb420c3e49bf",
                        "source_entry_id": "9a55fa77-c1eb-3f90-bdb3-ecf7efbaf20e",
                        "source_sense_id": "6a4d47f6-9295-3299-be66-c0f46f0ef944",
                        "source_sense_description": "de mate waarin iets of iemand verdient geloofd te worden",
                        "target_lang_word": "Glaubwürdigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Glaubwürdigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "103c918d-f7cf-3b6a-b976-b81b67a4299b",
                                        "entry_id": "b92440bd-6716-39ce-8527-ba16aeb087a9",
                                        "glosses": [
                                            "Glaubwürdigsein; glaubwürdige Eigenschaft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e0da5a0-bc7d-47a7-b997-f0979149de62",
                                                "sense_id": "103c918d-f7cf-3b6a-b976-b81b67a4299b",
                                                "text": "„Glaubwürdigkeit und Vertrauen sind ein überaus hohes Gut und bilden die Grundlage für einen ernsthaften und lebendigen Glauben an Gott, aber ebenso für Demokratie und erfolgreiches, nachhaltiges Wirtschaften.“"
                                            },
                                            {
                                                "example_id": "1c7f6204-0987-4510-ac11-0dd977ad406e",
                                                "sense_id": "103c918d-f7cf-3b6a-b976-b81b67a4299b",
                                                "text": "„Ich zeige ihr grinsend meine Bücher, berühmte Namen und wahre Zitate, die ich mit Blaustift unterstrichen habe und deren Glaubwürdigkeit unantastbar ist.“"
                                            },
                                            {
                                                "example_id": "9808055d-0947-4bfe-baea-e2fb94e9615e",
                                                "sense_id": "103c918d-f7cf-3b6a-b976-b81b67a4299b",
                                                "text": "„Er wusste nicht, ob das stimmte, aber kaum dass er es ausgesprochen hatte, wusste er, dass er jetzt seine letzte Glaubwürdigkeit verspielt hatte.“"
                                            },
                                            {
                                                "example_id": "df52e2db-afe1-4662-b101-c02ad8c3ae89",
                                                "sense_id": "103c918d-f7cf-3b6a-b976-b81b67a4299b",
                                                "text": "„Diese Einschätzungen haben dadurch an Glaubwürdigkeit gewonnen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "36e1e095-6ac6-433e-9f21-05684385120f",
                        "source_entry_id": "9a55fa77-c1eb-3f90-bdb3-ecf7efbaf20e",
                        "source_sense_id": "6a4d47f6-9295-3299-be66-c0f46f0ef944",
                        "source_sense_description": "de mate waarin iets of iemand verdient geloofd te worden",
                        "target_lang_word": "reliability",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "reliability",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9ae25e9b-a451-3467-82d4-b0312102d095",
                                        "entry_id": "0e3f7234-8342-30e2-a934-a76fccbf68d1",
                                        "glosses": [
                                            "The quality of being reliable, dependable, or trustworthy."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba539dd9-5697-4224-8e60-0813b8e8046d",
                                                "sense_id": "9ae25e9b-a451-3467-82d4-b0312102d095",
                                                "text": "Above all, rail needs to be boring. By that, I mean that it must run its timetable reliably, day-in and day-out. Punctuality and reliability remain the bedrock of a successful railway."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a847e270-ceb0-3f66-a8e5-41dafc40b725",
                                        "entry_id": "0e3f7234-8342-30e2-a934-a76fccbf68d1",
                                        "glosses": [
                                            "the ability to measure the same thing consistently (of a measurement indicating the degree to which the measure is consistent); that is, repeated measurements would give the same result (See also validity)."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6c7bbb57-684f-319a-bc21-f2014305a483",
                                        "entry_id": "0e3f7234-8342-30e2-a934-a76fccbf68d1",
                                        "glosses": [
                                            "measurable time of work before failure"
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1921f682-c75f-4b2d-8565-0709dc0415fa",
                        "source_entry_id": "9a55fa77-c1eb-3f90-bdb3-ecf7efbaf20e",
                        "source_sense_id": "6a4d47f6-9295-3299-be66-c0f46f0ef944",
                        "source_sense_description": "de mate waarin iets of iemand verdient geloofd te worden",
                        "target_lang_word": "credibility",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "credibility",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e22499fd-78b4-3d3c-9958-3bf2bd85be98",
                                        "entry_id": "5a537695-5ce3-3508-904d-74b519161e01",
                                        "glosses": [
                                            "Reputation impacting one's ability to be believed."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c9457ab-03e0-43e2-b347-998d4fafc1c4",
                                                "sense_id": "e22499fd-78b4-3d3c-9958-3bf2bd85be98",
                                                "text": "After weeks of blowing smoke, her credibility with me was next to nil."
                                            },
                                            {
                                                "example_id": "8e4ca38b-7e25-4ebd-b8cc-0bcc028dbaa8",
                                                "sense_id": "e22499fd-78b4-3d3c-9958-3bf2bd85be98",
                                                "text": "The inability of Trump's own spokespeople to speak authoritatively on the president's thinking and actions -- a challenge even Trump himself has acknowledged -- has left the White House with an enormous credibility gap, and has tarnished the reputations of many of its most visible spokespeople."
                                            },
                                            {
                                                "example_id": "786c593d-a49d-4782-aa56-e7b580c1422c",
                                                "sense_id": "e22499fd-78b4-3d3c-9958-3bf2bd85be98",
                                                "text": "The 'partygate' controversy has played a major part in undermining the credibility of Boris Johnson and his Government and has led to calls from senior MPs for him to resign."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a6041b0c-5678-3995-8a47-649ed634ce01",
                                        "entry_id": "5a537695-5ce3-3508-904d-74b519161e01",
                                        "glosses": [
                                            "Believability of statements by a witness, as measured by whether the testimony is probable or improbable when judged by common experience."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "57b66ac2-a1fe-4446-91e6-a77898f3aab1",
                        "source_entry_id": "9a55fa77-c1eb-3f90-bdb3-ecf7efbaf20e",
                        "source_sense_id": "6a4d47f6-9295-3299-be66-c0f46f0ef944",
                        "source_sense_description": "de mate waarin iets of iemand verdient geloofd te worden",
                        "target_lang_word": "crédibilité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "crédibilité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2f58de14-bd9d-350f-b17e-d10e66ad39b7",
                                        "entry_id": "112df902-0261-3446-bf38-2d3fc3de7603",
                                        "glosses": [
                                            "Ce qui rend une chose digne d’être crue. Sérieux d'une information qui la rend digne de confiance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3c29097-6130-44ea-8afe-007ca4a8d6b6",
                                                "sense_id": "2f58de14-bd9d-350f-b17e-d10e66ad39b7",
                                                "text": "Il a commencé par nous dire qu’il allait nous donner un exemple de la crédibilité due aux attestations que nous présentions."
                                            },
                                            {
                                                "example_id": "7992c762-d043-462e-bfcd-19407a28b975",
                                                "sense_id": "2f58de14-bd9d-350f-b17e-d10e66ad39b7",
                                                "text": "Certes il est facile de comprendre qu’un accusé ait tout intérêt à nier son crime et à mettre en cause la victime, et qu’il puisse bénéficier de la présomption d’innocence (mais il faudrait en miroir que la victime puisse bénéficier de la présomption de crédibilité)."
                                            },
                                            {
                                                "example_id": "3ab2b14b-e6c7-4e00-921a-f2f954ee53c9",
                                                "sense_id": "2f58de14-bd9d-350f-b17e-d10e66ad39b7",
                                                "text": "La crédibilité d’une encyclopédie, d’un dictionnaire de langue. — Les conditions sur lesquelles se fonde la crédibilité d’un fait."
                                            },
                                            {
                                                "example_id": "7ff293b2-3bc0-4afc-abe8-3e15b577f783",
                                                "sense_id": "2f58de14-bd9d-350f-b17e-d10e66ad39b7",
                                                "text": "La crédibilité de l’histoire des premiers siècles de Rome a donné lieu à de savantes discussions."
                                            },
                                            {
                                                "example_id": "c275ebc1-737c-4b3a-98b0-c1fca22f5414",
                                                "sense_id": "2f58de14-bd9d-350f-b17e-d10e66ad39b7",
                                                "text": "La crédibilité est, dans un roman de mœurs, une condition nécessaire."
                                            },
                                            {
                                                "example_id": "c9625351-45c8-457f-be49-ce6a359963e3",
                                                "sense_id": "2f58de14-bd9d-350f-b17e-d10e66ad39b7",
                                                "text": "Très bon résumé.... que c'est triste de perdre un mec comme Griezmann. Deschamps a perdu encore en crédibilité."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
