                ],
                "senses": [
                    {
                        "sense_id": "841c6c2a-979c-36a8-ab2d-333c2a5054fb",
                        "entry_id": "a5f294ce-6e52-31c8-9c42-409c100cac26",
                        "glosses": [
                            "Redonner un nouveau départ."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "12f3094e-df34-4c93-935c-f83f0dd3eb8d",
                                "sense_id": "841c6c2a-979c-36a8-ab2d-333c2a5054fb",
                                "text": "Sitôt arrivés, la première chose que nous avons faite a été de réallumer le feu dans la cheminée."
                            },
                            {
                                "example_id": "79f903a5-cb7d-45ed-a0d7-13be000319f5",
                                "sense_id": "841c6c2a-979c-36a8-ab2d-333c2a5054fb",
                                "text": "C’est quand je ne suis plus arrivé à réallumer l’ordinateur que je me suis rendu compte que l’alimentation avait rendu l’âme."
                            },
                            {
                                "example_id": "260f9ada-012c-4b93-b8d0-7edf7f81a267",
                                "sense_id": "841c6c2a-979c-36a8-ab2d-333c2a5054fb",
                                "text": "Dans un couple, il est parfois très difficile de réallumer la flamme de l’amour, surtout lorsque les conflits se sont accumulés au cours des années."
                            }
                        ]
                    }
