                                        "glosses": [
                                            "зоол., энтомол. хищное летающее насекомое с длинным тонким телом и двумя парами прозрачных крыльев, производящих при полёте характерный шум (Odonata)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
