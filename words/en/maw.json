                },
                {
                    "sense_id": "8a3ee87e-e666-3267-90fe-7a97c5dd8a6f",
                    "sense_definition": "The stomach of an animal.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "stomach",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The predator filled its <w>maw</w> with the remains of its hunt.",
                            "target_lang_translations": {
                                "de": "Das Raubtier füllte seinen <w>Magen</w> mit den Überresten seiner Jagd."
                            }
                        },
                        {
                            "text": "Death was forced to satisfy his ravenous <w>maw</w>.",
                            "target_lang_translations": {
                                "de": "Der Tod war gezwungen, seinen gefräßigen <w>Schlund</w> zu stillen."
                            }
