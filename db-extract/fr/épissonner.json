                        "glosses": [
                            "Enlever sur une plante les petites pousses inutiles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "97f9971f-1afc-4089-bdfb-4aac49373ed6",
                                "sense_id": "8b1df0d4-8165-39fb-8ec8-4b163fa0a07d",
                                "text": "Épissonner les lentilles vertes françaises, également appelées lentilles du Puy."
                            },
                            {
                                "example_id": "bbd4bccf-66c7-4c71-9fbb-76759389c7f4",
                                "sense_id": "8b1df0d4-8165-39fb-8ec8-4b163fa0a07d",
                                "text": "la semaine prochaine je vais épissonner les jeunes plants, je marcherai comme les canards pour pas avoir mal à mon dos..."
                            },
                            {
                                "example_id": "0141ed3d-f58d-4d86-9f92-25056b4d2a7e",
                                "sense_id": "8b1df0d4-8165-39fb-8ec8-4b163fa0a07d",
                                "text": "« Epissonner », c’est-à-dire enlever toutes les petites pousses (les « gits ») qui sont sur les souches pour ne pas fatiguer la vigne."
                            }
                        ]
