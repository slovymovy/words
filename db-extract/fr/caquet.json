                                    {
                                        "sense_id": "656a9722-fede-36d8-ada4-491cb447abb9",
                                        "entry_id": "fe4ac5c9-2bdf-3f4a-9f59-476b0ca3e00f",
                                        "glosses": [
                                            "aanhoudend kakelen door kippen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a56ef08-a96a-4f52-8839-6ef04d8a4662",
                                                "sense_id": "656a9722-fede-36d8-ada4-491cb447abb9",
                                                "text": "Alles van de kip, in een kippenhok vol gekakel"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5be9b907-eddc-30f2-b364-7a88a6303542",
                                        "entry_id": "fe4ac5c9-2bdf-3f4a-9f59-476b0ca3e00f",
                                        "glosses": [
                                            "aanhoudend babbelen door mensen / zinloos geklets"
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5e43d2fc-22b3-4283-ae0a-d0692b63f823",
                                                "sense_id": "5be9b907-eddc-30f2-b364-7a88a6303542",
                                                "text": "Als ik onzeker word van dat gekakel, dan zeg ik dan naderhand tegen productie, dan spreken zij de anderen erop aan.’’"
                                            },
                                            {
                                                "example_id": "d92c6716-b86b-40ef-816f-6be5b574bcb7",
                                                "sense_id": "5be9b907-eddc-30f2-b364-7a88a6303542",
                                                "text": "Wat blijven we als samenleving toch moeite houden met het overbruggen van verschillen tussen mensen; keer op keer schiet deze gedachte door mijn hoofd als ik de laatste populistische klaagzang over de 'mislukte integratie'met weerzin tot me neem. Leiders zouden juist het niveau van het oppervlakkige gekakel over de negatieve aspecten van culturele diversiteit moeten overstijgen. En dan vooral politieke leiders."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e5f95085-1364-45cf-befa-9e7b58b21594",
                        "source_entry_id": "0e915661-6281-3303-9310-88be5c20a610",
                        "source_sense_description": "(Sens propre) Gloussement de la poule.",
                        "target_lang_word": "gebabbel",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gebabbel",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "aa7fcb24-9dde-3ca8-b408-da443b9857c7",
                                        "entry_id": "864f824a-7008-3bff-bfca-71f1711bc40e",
                                        "glosses": [
                                            "het praten over onbeduidende onderwerpen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6bffe25-56ab-4294-a09f-c8ad6b213044",
                                                "sense_id": "aa7fcb24-9dde-3ca8-b408-da443b9857c7",
                                                "text": "Het gezellige gebabbel van de kinderen op de achtergrond was zeer rustgevend."
                                            },
                                            {
                                                "example_id": "55ab5181-6ede-4a59-a982-97c20f0fd5b4",
                                                "sense_id": "aa7fcb24-9dde-3ca8-b408-da443b9857c7",
                                                "text": "Ik ging in een hoekje zitten, uit de tocht, en keek naar de druppels die van mijn haarpunten gleden, terwijl ik verlangde naar onze warme haard en het gebabbel van mijn zuster."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b975e58b-d108-3408-8546-ecd8141fdaee",
                                        "entry_id": "864f824a-7008-3bff-bfca-71f1711bc40e",
                                        "glosses": [
                                            "ongunstig over iemand praten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc927730-a4b8-4c1d-b59e-e438779a13f4",
                                                "sense_id": "b975e58b-d108-3408-8546-ecd8141fdaee",
                                                "text": "Het gebabbel over de buurvrouw die bij haar man was weggelopen was na enkele dagen weer voorbij, al snel had men weer een nieuw onderwerp om over te roddelen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
