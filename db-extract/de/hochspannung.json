                ],
                "senses": [
                    {
                        "sense_id": "18334d72-005f-3a6a-aa4d-1009df8ca0d4",
                        "entry_id": "740219c8-063a-3e67-8f6c-aee8fd9e343c",
                        "glosses": [
                            "elektrische Spannung über 1.000 Volt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "11cb4e95-2aa4-48d9-9126-19ce6835f7d7",
                                "sense_id": "18334d72-005f-3a6a-aa4d-1009df8ca0d4",
                                "text": "Das Kabel steht unter Hochspannung."
                            },
                            {
                                "example_id": "d702548d-3d71-4233-92ec-b29b5ee704ef",
                                "sense_id": "18334d72-005f-3a6a-aa4d-1009df8ca0d4",
                                "text": "Stomstärken oberhalb von 1.000 Volt galten bisher als Hochspannung; wobei es auch noch Niederspannung und Mittelspannung gibt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "90add139-8990-3a79-a68b-74eef5014d3a",
                        "entry_id": "740219c8-063a-3e67-8f6c-aee8fd9e343c",
                        "glosses": [
                            "eine besonders aufregende Situation; Erwartung der Auflösung in besonders ungewissen Situationen"
                        ],
                        "tags": [
                            "figurative",
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "e23a7203-b5a1-424c-a4ef-d7a55f2f12a6",
                                "sense_id": "90add139-8990-3a79-a68b-74eef5014d3a",
                                "text": "Das Wahlergebnis wurde mit Hochspannung erwartet."
                            },
                            {
                                "example_id": "54139371-4b4b-4788-ad7b-311ec2780edb",
                                "sense_id": "90add139-8990-3a79-a68b-74eef5014d3a",
                                "text": "„Der Zwischenfall ereignete sich in einer Zeit politischer Hochspannung, unmittelbar vor Beginn der sogenannten »Pariser Gipfelkonferenz«, an welcher Eisenhower, Chruschtschow, Macmillan und de Gaulle über den Frieden der Welt beraten wollten.“"
                            },
                            {
                                "example_id": "6102c4af-e295-413f-983c-3a89f03c1372",
                                "sense_id": "90add139-8990-3a79-a68b-74eef5014d3a",
                                "text": "„In ihrem neuen ungewohnten Zustand der Hochspannung hätte Miss Mouse beinahe gewünscht, kostümiert statt im Abendkleid gekommen zu sein.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
