                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3279451d-c9e3-433a-b35e-8c5135fdf089",
                                "sense_id": "a6464c95-98a1-3a69-be75-9570f17c8099",
                                "text": "„Auch sog. Tea-Rooms sind etwas für den Appetit zwischendurch, in denen es keineswegs nur Tee, sondern auch ‚Kaffee‘ genannte Heißwassergetränke, Kuchen, Quiches, Minipizzas und Sandwiches gibt.“"
                            },
                            {
                                "example_id": "5d6a31f1-c795-42cb-857a-d891ad301e04",
                                "sense_id": "a6464c95-98a1-3a69-be75-9570f17c8099",
                                "text": "„Schon Rubner hat auf den Wert von kalkreichem Wasser bei Kochwasser und Heißwassergetränken hingewiesen.“"
                            },
                            {
                                "example_id": "7f0f6b67-f971-4101-b152-e869410d5c1f",
                                "sense_id": "a6464c95-98a1-3a69-be75-9570f17c8099",
                                "text": "„Weitere Versuche bezogen sich schließlich auf Heißwassergetränke, bei denen die bessere Geschmacks- und Aromabildung besonders in Erscheinung treten soll.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
