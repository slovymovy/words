                "senses": [
                    {
                        "sense_id": "854fa8eb-e7cd-3686-bd83-c7219b7f4e57",
                        "entry_id": "eea87718-0b1d-32aa-8d26-61a46923a96c",
                        "glosses": [
                            "Donner un caractère juif à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c04f9dc7-f19b-4a05-92da-fab3f6769b71",
                                "sense_id": "854fa8eb-e7cd-3686-bd83-c7219b7f4e57",
                                "text": "On nous réduit à juiviser notre vie ! Juifs et chrétiens, ils ont tort."
                            },
                            {
                                "example_id": "742e6266-2913-4f84-a591-bf96d126264b",
                                "sense_id": "854fa8eb-e7cd-3686-bd83-c7219b7f4e57",
                                "text": "Et d'ailleurs tous ces gens de religions minoritaires n'ont jamais voulu protestantiser, bouddhistiser, juiviser, sikhiser notre société."
                            },
                            {
                                "example_id": "870ce78d-ea5b-4ae8-9eff-664ce80014fb",
                                "sense_id": "854fa8eb-e7cd-3686-bd83-c7219b7f4e57",
                                "text": "Serais-je en train de me « juiviser » ?"
                            }
                        ]
                    }
