                        "glosses": [
                            "Déclaration anticipée sur Internet d’une plainte judiciaire, simplifiant les démarches auprès de l’officier qui enregistrera la plainte définitive."
                        ],
                        "tags": [
                            "France",
                            "Justice"
                        ],
                        "examples": [
