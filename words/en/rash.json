{
    "word_family": [
        "rashly",
        "rashness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "d64ca013-36cb-3eb4-9249-2bb13301f2f1",
                    "sense_definition": "Acting too quickly without considering the consequences and risks; not careful; hasty.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "hasty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He regretted his <w>rash</w> decision to quit his job without having another one lined up.",
                            "target_lang_translations": {
                                "zh": "他后悔自己没找好下家就辞职，这个决定太<w>鲁莽</w>了。"
                            }
                        },
                        {
                            "text": "It was a <w>rash</w> thing to say during such a heated argument.",
                            "target_lang_translations": {
                                "zh": "在那种激烈的争吵中说出那样的话，实在太<w>轻率</w>了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "impulsive",
                        "reckless",
                        "imprudent",
                        "heedless"
                    ],
                    "antonyms": [
                        "prudent",
                        "cautious",
                        "careful"
                    ],
                    "common_phrases": [
                        "rash decision",
                        "rash action"
                    ],
                    "target_lang_definitions": {
                        "zh": "指做事不考虑后果，鲁莽、轻率的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "鲁莽",
                                "target_lang_sense_clarification": "形容人做事不顾后果，缺乏深思熟虑。"
                            },
                            {
                                "target_lang_word": "轻率",
                                "target_lang_sense_clarification": "形容态度不严肃，做事草率。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "dfe9a797-c12a-398f-8263-6e05780ac6ee",
                    "sense_definition": "An area of inflamed and irritated skin characterized by reddened spots.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "skin_condition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He developed a painful <w>rash</w> after walking through the tall grass.",
                            "target_lang_translations": {
                                "zh": "他在高草丛中走过之后，身上长出了疼痛的<w>皮疹</w>。"
                            }
                        },
                        {
                            "text": "She applied cream to soothe the <w>rash</w> on her arm.",
                            "target_lang_translations": {
                                "zh": "她在手臂上涂了药膏来缓解<w>疹子</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "skin rash",
                        "develop a rash"
                    ],
                    "target_lang_definitions": {
                        "zh": "皮肤上出现的红肿、发炎的斑点或区域。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "皮疹",
                                "target_lang_sense_clarification": "医学上指皮肤上出现的红斑或丘疹。"
                            },
                            {
                                "target_lang_word": "疹子",
                                "target_lang_sense_clarification": "口语中对皮疹的通俗称呼。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "39796fc7-4a39-399a-912e-43335d94f7b0",
                    "sense_definition": "An outbreak or sudden surge in a series of similar, usually negative, events.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "outbreak",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There has been a <w>rash</w> of burglaries in the neighborhood this month.",
                            "target_lang_translations": {
                                "zh": "这个月社区里发生了一<w>连串</w>入室盗窃案。"
                            }
                        },
                        {
                            "text": "The company is facing a <w>rash</w> of complaints regarding their new product.",
                            "target_lang_translations": {
                                "zh": "公司正面临着针对其新产品的<w>频发</w>投诉。"
                            }
                        }
                    ],
                    "synonyms": [
                        "epidemic"
                    ],
                    "common_phrases": [
                        "rash of complaints",
                        "rash of incidents"
                    ],
                    "target_lang_definitions": {
                        "zh": "指一系列类似事件（通常是负面的）在短时间内集中发生。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "一连串",
                                "target_lang_sense_clarification": "形容一系列事件接连发生。"
                            },
                            {
                                "target_lang_word": "频发",
                                "target_lang_sense_clarification": "指某种现象在短时间内频繁出现。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "68c288ce-41ca-3003-af58-01b19b40dbd2",
                    "sense_definition": "To fall or descend heavily and suddenly, often referring to rain.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "fall",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Thunder rumbled and a light rain <w>rashed</w> down as we ran for cover.",
                            "target_lang_translations": {
                                "zh": "雷声隆隆，当我们跑去避雨时，小雨开始<w>倾泻</w>而下。"
                            }
                        },
                        {
                            "text": "The heavy rain <w>rashed</w> down, flooding the streets within minutes.",
                            "target_lang_translations": {
                                "zh": "大雨<w>倾泻</w>而下，几分钟内街道就被淹了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "rashed down"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Usage is primarily literary or archaic."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "指雨水猛烈地倾泻而下。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "倾泻",
                                "target_lang_sense_clarification": "形容雨水像瀑布一样猛烈落下。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}