                ],
                "senses": [
                    {
                        "sense_id": "130d75f3-cf79-3a24-bbec-cf2614532a32",
                        "entry_id": "ac2ce070-8c0d-3a5f-a69b-87e3af4e01ff",
                        "glosses": [
                            "A selection from the books of Nevi'im and Ketuvim of the Tanach, usually corresponding to the week's parashah, publicly read in synagogue following the parashah."
                        ],
                        "tags": [
                            "Judaism"
                        ],
                        "examples": [
                            {
                                "example_id": "1ecb9051-d92d-4a8b-95fb-33b1501770c2",
                                "sense_id": "130d75f3-cf79-3a24-bbec-cf2614532a32",
                                "text": "Recent scholars, on the other hand, without much show of reason, as it would appear, variously hold the Haftarah to have sprung from the sermon or homiletic exercise which accompanied the reading in the Pentateuch, and took its exordium (as Haftarah, by an extraordinary linguistic passage, adapted in a manner to the Mosaic text under consideration; or, again, they imagine the Haftarah to have taken its rise spontaneously during the exile itself, and that Ezra retained and enforced it in Palestine."
                            },
                            {
                                "example_id": "21401dcf-d5d0-4aba-a05d-d6df707d4753",
                                "sense_id": "130d75f3-cf79-3a24-bbec-cf2614532a32",
                                "text": "Every year between Tisha B'av and Rosh Hashanah, we read the Seven Haftarot of Consolation from Isaiah 40-61."
                            }
                        ]
                    }
                ],
