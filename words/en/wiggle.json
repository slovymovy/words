{
    "word_family": [
        "wiggler",
        "wiggly"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b3ab51a0-2933-3e3c-8918-a8a9b1b145ab",
                    "sense_definition": "To move with irregular, back and forward or side to side motions; to shake or jiggle.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The little puppy began to <w>wiggle</w> its tail with excitement when it saw the treat.",
                            "target_lang_translations": {
                                "ru": "Маленький щенок начал радостно <w>вилять</w> хвостом, когда увидел лакомство."
                            }
                        },
                        {
                            "text": "You need to <w>wiggle</w> your toes to make sure the new shoes are not too tight.",
                            "target_lang_translations": {
                                "ru": "Тебе нужно <w>пошевелить</w> пальцами ног, чтобы убедиться, что новые туфли не слишком жмут."
                            }
                        }
                    ],
                    "synonyms": [
                        "jiggle",
                        "squirm",
                        "twitch",
                        "waggle",
                        "shake"
                    ],
                    "common_phrases": [
                        "wiggle your toes",
                        "wiggle your ears",
                        "wiggle out of"
                    ],
                    "target_lang_definitions": {
                        "ru": "Двигаться нерегулярными движениями вперед-назад или из стороны в сторону; трястись или покачиваться."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вилять",
                                "target_lang_sense_clarification": "хвостом"
                            },
                            {
                                "target_lang_word": "шевелить",
                                "target_lang_sense_clarification": "пальцами или ушами"
                            },
                            {
                                "target_lang_word": "ерзать",
                                "target_lang_sense_clarification": "беспокойно двигаться"
                            },
                            {
                                "target_lang_word": "покачивать",
                                "target_lang_sense_clarification": "из стороны в сторону"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "bbfc51e4-7528-35cc-9b30-128e17db4e0a",
                    "sense_definition": "A rapid movement in alternating opposite directions, not necessarily regular.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The toddler gave a little <w>wiggle</w> and managed to slip out of his mother's arms.",
                            "target_lang_translations": {
                                "ru": "Малыш немного <w>извернулся</w> и сумел выскользнуть из рук матери."
                            }
                        },
                        {
                            "text": "She walked with a slight <w>wiggle</w> in her step as she crossed the room.",
                            "target_lang_translations": {
                                "ru": "Она шла через комнату, слегка <w>покачивая</w> бедрами при каждом шаге."
                            }
                        }
                    ],
                    "synonyms": [
                        "jiggle",
                        "twitch",
                        "shake",
                        "squirm",
                        "wobble"
                    ],
                    "common_phrases": [
                        "give a wiggle",
                        "slight wiggle"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быстрое движение в чередующихся противоположных направлениях, не обязательно регулярное."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "покачивание",
                                "target_lang_sense_clarification": "ритмичное движение"
                            },
                            {
                                "target_lang_word": "извивание",
                                "target_lang_sense_clarification": "телом"
                            },
                            {
                                "target_lang_word": "движение",
                                "target_lang_sense_clarification": "короткое и резкое"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7edcdb5c-c695-31cb-87c3-a393119c82a9",
                    "sense_definition": "A plural form or variation of <w>wiggles</w>, often referring to nervous or restless movement.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children had a case of the <w>wiggle</w> after sitting still for the long assembly.",
                            "target_lang_translations": {
                                "ru": "Дети начали <w>ерзать</w> после того, как просидели неподвижно все долгое собрание."
                            }
                        },
                        {
                            "text": "It is hard to focus on the lecture when you have a constant <w>wiggle</w> in your legs.",
                            "target_lang_translations": {
                                "ru": "Трудно сосредоточиться на лекции, когда в ногах постоянная <w>непоседливость</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "restlessness",
                        "fidgeting"
                    ],
                    "target_lang_definitions": {
                        "ru": "Нервное или беспокойное движение, часто во множественном числе."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ерзанье",
                                "target_lang_sense_clarification": "неспособность усидеть на месте"
                            },
                            {
                                "target_lang_word": "непоседливость",
                                "target_lang_sense_clarification": "состояние беспокойства"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0ce189c1-2f80-317b-9fd5-de6c83377d69",
                    "sense_definition": "An alternating state or characteristic, often used in technical or abstract contexts.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The graph showed a small <w>wiggle</w> in the data right before the main trend emerged.",
                            "target_lang_translations": {
                                "ru": "На графике было видно небольшое <w>колебание</w> данных прямо перед появлением основного тренда."
                            }
                        },
                        {
                            "text": "There is some <w>wiggle</w> in the final budget figures that we need to account for.",
                            "target_lang_translations": {
                                "ru": "В итоговых цифрах бюджета есть некоторый <w>люфт</w>, который нам нужно учесть."
                            }
                        }
                    ],
                    "synonyms": [
                        "fluctuation",
                        "variation"
                    ],
                    "antonyms": [
                        "stability"
                    ],
                    "common_phrases": [
                        "wiggle room"
                    ],
                    "target_lang_definitions": {
                        "ru": "Колебание или отклонение, часто используемое в техническом или абстрактном контексте."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "колебание",
                                "target_lang_sense_clarification": "в данных или графиках"
                            },
                            {
                                "target_lang_word": "запас",
                                "target_lang_sense_clarification": "свобода маневра (wiggle room)"
                            },
                            {
                                "target_lang_word": "отклонение",
                                "target_lang_sense_clarification": "небольшое изменение"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}