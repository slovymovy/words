                    "sense_definition": "present participle and gerund of <w>bubble</w>",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The water was <w>bubbling</w> on the stove as she prepared the pasta.",
                            "target_lang_translations": {
                                "ru": "Вода <w>бурлила</w> на плите, пока она готовила пасту."
                            }
                        },
                        {
                            "text": "He could feel a sense of excitement <w>bubbling</w> up inside him.",
                            "target_lang_translations": {
                                "ru": "Он чувствовал, как внутри него <w>закипает</w> чувство восторга."
                            }
                        }
                    ],
                    "common_phrases": [
                        "bubbling water",
                        "bubbling up"
                    ],
                    "target_lang_definitions": {
