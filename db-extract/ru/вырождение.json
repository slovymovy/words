                                "target_senses": [
                                    {
                                        "sense_id": "d99c5558-2d98-334a-bba5-a5075b396519",
                                        "entry_id": "24af9ab6-09bc-30b6-a6aa-db71d3c07060",
                                        "glosses": [
                                            "État de ce qui dégénère."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e7483a5b-96d0-4db2-b55a-8c1b55ff3007",
                                                "sense_id": "d99c5558-2d98-334a-bba5-a5075b396519",
                                                "text": "La dégénération des races, des espèces."
                                            },
                                            {
                                                "example_id": "2db06915-c5c5-4572-8757-4468df06ccd7",
                                                "sense_id": "d99c5558-2d98-334a-bba5-a5075b396519",
                                                "text": "Membre de l’Académie des sciences à vingt-six ans, il est l'auteur d’une Histoire naturelle, ouvrage colossal de trente-six volumes dont un chapitre est consacré à la « dégénération des animaux »."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
