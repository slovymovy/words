                "senses": [
                    {
                        "sense_id": "20451d76-04c9-35b2-b19e-f6dc6b63c881",
                        "entry_id": "e3ce150b-a96c-357a-bf9f-50cb1d0295c3",
                        "glosses": [
                            "Dachventilator"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "152bf6ba-30cf-4ae3-a5ca-45b7c556c9f7",
                                "sense_id": "20451d76-04c9-35b2-b19e-f6dc6b63c881",
                                "text": "„Der Dachventilator DV wird angetrieben durch spannungssteuerbare Aussenläufermotoren.“"
                            },
                            {
                                "example_id": "26867bc1-2342-476f-b137-b869c3b72bab",
                                "sense_id": "20451d76-04c9-35b2-b19e-f6dc6b63c881",
                                "text": "„Der DV EC…Pro wurde zum Absaugen (auch verunreinigter) Luft entwickelt, die diagonal ausgeblasen wird.“"
                            },
                            {
                                "example_id": "2ef2f23f-6934-4945-a83f-104b1bfee00f",
                                "sense_id": "20451d76-04c9-35b2-b19e-f6dc6b63c881",
                                "text": "„Die Dachventilatoren mit EC-Motorantrieb sind eine Weiterentwicklung der bewährten Rosenberg Standardbaureihe DV.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "1b769d34-382c-35d7-a1ce-706f2600b258",
                        "entry_id": "e3ce150b-a96c-357a-bf9f-50cb1d0295c3",
                        "glosses": [
                            "Direktverdampfer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "480e7bde-cb27-4de8-afaf-6eb46ec65977",
                                "sense_id": "1b769d34-382c-35d7-a1ce-706f2600b258",
                                "text": "„Aufgrund ihrer geringen Marktrelevanz von unter 2% [BWP 2010a] werden die DV in diesem Bericht nicht weiter berücksichtigt.“"
                            },
                            {
                                "example_id": "742ad49b-a9c5-446b-a0d4-926e357276e2",
                                "sense_id": "1b769d34-382c-35d7-a1ce-706f2600b258",
                                "text": "„Das flüssige Medium wird dem Direktverdampfer (DV 2 Adrop) durch den LFC dosiert zugeführt und auf die Verdampferfläche gesprüht.“"
                            },
                            {
                                "example_id": "83bb7692-e87f-4dcb-9e20-3b14a67ed08b",
                                "sense_id": "1b769d34-382c-35d7-a1ce-706f2600b258",
                                "text": "„Hier findet Ihr Bilder über Flächenkollektoren, aber auch von Anlagen, die einen DV-FK als WQ haben.“"
                            },
                            {
                                "example_id": "21156494-c21a-4759-a8ee-1eeb178c3d39",
                                "sense_id": "1b769d34-382c-35d7-a1ce-706f2600b258",
                                "text": "„Kombiniertes Zu- und Abluftgerät in vertikaler Ausführung, energieoptimierte Ventilatoren mit EC-Antrieb, Standard-Taschenfilter Außenluft F 5, Abluft G 4 (Filterklasse F 7 möglich),Wärmerückgewinnung durch Aluminium-Plattenwärmetauscher mit integriertem Bypass, Warmwasser- (W) oder Elektro-Nacherhitzer (E), wahlweise auch mit Kaltwasser-Luftkühler (K) oder mit Direktverdampfer (DV).“"
                            },
                            {
                                "example_id": "9bd2fabd-5c39-4d03-9d4d-a61a07fb3986",
                                "sense_id": "1b769d34-382c-35d7-a1ce-706f2600b258",
                                "text": "„Erdreich (bleibt meistens auch bei Austausch der Wärmepumpe bestehen!, Soleumwälzpumpe wird sicher auch einmal ausgetauscht!) a. Flächenkollektor (DV oder Sole; bei DV gibt es keine Sole-Umwälzpumpe!) b. Tiefensonde“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
