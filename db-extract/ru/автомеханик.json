                                                "example_id": "0073be83-5c1c-44ac-ae6c-d6d965ba2e5c",
                                                "sense_id": "c10c86c6-b65a-3eaa-a3ad-c82fd7d16ae0",
                                                "text": "Mein Vater ist Automechaniker und hat eine eigene Werkstatt."
                                            },
                                            {
                                                "example_id": "d12fafa6-6238-40f1-aef4-2b37f2e09385",
