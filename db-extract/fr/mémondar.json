                        "examples": [
                            {
                                "example_id": "0377d423-3a55-4a22-afc1-463845b978bc",
                                "sense_id": "185d6683-2f3a-358f-bfeb-defca85f8f95",
                                "text": "On appelle en Perse Mémondar, celui qui a soin de recevoir les étrangers. Mémondar Bachi, est celui qui a soin de recevoir les ambassadeurs."
                            },
                            {
                                "example_id": "45718ef3-6636-4db0-b6ee-f619cb7af410",
                                "sense_id": "185d6683-2f3a-358f-bfeb-defca85f8f95",
                                "text": "Je trouvai mieux mon compte à me joindre au neveu de notre mémondar, qui étoit aussi incommodé que moi."
                            }
                        ]
                    }
