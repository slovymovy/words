                ],
                "senses": [
                    {
                        "sense_id": "d2facde3-e4b6-3a73-8e8e-125b3a0e48da",
                        "entry_id": "9b8eedc3-4cb3-35a3-8420-9f53cab0cb73",
                        "glosses": [
                            "Divertissement, occupation légère et agréable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10b4493e-8a91-444a-9a1b-7c3b994ab2a4",
                                "sense_id": "d2facde3-e4b6-3a73-8e8e-125b3a0e48da",
                                "text": "Cette occupation est plutôt pour lui un passetemps."
                            },
                            {
                                "example_id": "92b514ac-fe11-4621-b886-8eda2b61adbd",
                                "sense_id": "d2facde3-e4b6-3a73-8e8e-125b3a0e48da",
                                "text": "Prendre des espions et les pendre, faire des expéditions hasardeuses sur la digue ou sur la mer, imaginer des folies, les exécuter froidement, tel était le passetemps qui faisait trouver courts à l’armée ces jours si longs, non seulement pour les Rochelois, rongés par la famine et l’anxiété, mais encore pour le cardinal, qui les bloquait si vivement."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "94532887-830b-4629-8b9f-880e1ffe1c7d",
                        "source_entry_id": "9b8eedc3-4cb3-35a3-8420-9f53cab0cb73",
                        "source_sense_id": "d2facde3-e4b6-3a73-8e8e-125b3a0e48da",
                        "target_lang_word": "Kurzweil",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kurzweil",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d74a2d22-da20-31c3-bfa8-4ebcfacd75cc",
                                        "entry_id": "b164fec8-488f-3153-9959-b0356ee16d5a",
                                        "glosses": [
                                            "leichte, angenehme, bisweilen lustige Unterhaltung"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0ba02833-5f0d-4c31-b70f-c9a7b49c87e0",
                                                "sense_id": "d74a2d22-da20-31c3-bfa8-4ebcfacd75cc",
                                                "text": "„Seien es nun landschaftliche, kulturelle oder tierische Attraktionen - der Ort samt Umland wartet mit jeder Menge touristischer Kurzweil auf.“"
                                            },
                                            {
                                                "example_id": "28c76885-f2e7-40d7-9d59-b309a3cbda2e",
                                                "sense_id": "d74a2d22-da20-31c3-bfa8-4ebcfacd75cc",
                                                "text": "„Schiebt meine Vernunft nicht im Kurzweil herum.“"
                                            },
                                            {
                                                "example_id": "906b84e3-b7dd-42b5-ad2e-8e0dbcffd4ba",
                                                "sense_id": "d74a2d22-da20-31c3-bfa8-4ebcfacd75cc",
                                                "text": "„Unter den nackten Göttern und Göttinnen, die sich dort bei Nektar und Ambrosia erlustigen, seht Ihr eine Göttin, die, obgleich umgeben von lauter Fröhlichkeit und Kurzweil, dennoch immer einen Panzer trägt und den Helm auf dem Kopf und den Speer in der Hand behält. Es ist die Göttin der Weisheit.“"
                                            },
                                            {
                                                "example_id": "c3ce1515-62c8-41e6-aab0-dae3872716b6",
                                                "sense_id": "d74a2d22-da20-31c3-bfa8-4ebcfacd75cc",
                                                "text": "„Freilich, du willst sie bei Namen nennen und liebkosen; du willst sie am Ohre zupfen und Kurzweil mit ihr treiben.“"
                                            },
                                            {
                                                "example_id": "de9f876e-a78d-4437-88ed-63ecff97222c",
                                                "sense_id": "d74a2d22-da20-31c3-bfa8-4ebcfacd75cc",
                                                "text": "„Und da gab’s in diesem vornehmen Kreise mancherlei Kurzweil.“"
                                            },
                                            {
                                                "example_id": "cb1a3c4b-b927-4bb9-9a57-69d41d5bbe7b",
                                                "sense_id": "d74a2d22-da20-31c3-bfa8-4ebcfacd75cc",
                                                "text": "„Indessen scheint es, daß sie keinerlei Neigung besitzt, unserer Schäferstunde den Verlauf bloßer Kurzweil zu geben.“"
                                            },
                                            {
                                                "example_id": "2abf4a6d-1de8-45b2-af07-20100111db91",
                                                "sense_id": "d74a2d22-da20-31c3-bfa8-4ebcfacd75cc",
                                                "text": "„Handwerksstände zum Mitmachen und ein attraktives Kinderprogramm bieten Kurzweil für Groß und Klein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0a42423c-af43-4fa8-9267-154ab48e0b20",
                        "source_entry_id": "9b8eedc3-4cb3-35a3-8420-9f53cab0cb73",
                        "source_sense_id": "d2facde3-e4b6-3a73-8e8e-125b3a0e48da",
                        "target_lang_word": "Zeitvertreib",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zeitvertreib",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "64248a74-4e4d-3bf6-88dd-eb5db7326e33",
                                        "entry_id": "be2330b3-3529-3dd5-a73f-05dd07e3331b",
                                        "glosses": [
                                            "Tätigkeit, die man tut, um sich die Zeit zu vertreiben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7df26c8a-880e-4fbc-8bd8-c96ca1d1cc22",
                                                "sense_id": "64248a74-4e4d-3bf6-88dd-eb5db7326e33",
                                                "text": "Zum Zeitvertreib schaute er sich im Fernsehen die Nachrichten an."
                                            },
                                            {
                                                "example_id": "da83bc52-8fcc-43ea-b60e-3adeeec6d78f",
                                                "sense_id": "64248a74-4e4d-3bf6-88dd-eb5db7326e33",
                                                "text": "„Sobald wir mit dem Begriff Zeit zu experimentieren beginnen, und sei es auch nur als Gedankenexperiment oder zum rein intellektuellen Zeitvertreib, müssen wir feststellen, daß unsere Sprache und mit ihr unsere Denkprozesse uns sehr bald im Stich lassen.“"
                                            },
                                            {
                                                "example_id": "aa418205-367c-43d9-9dea-2be45219c2e8",
                                                "sense_id": "64248a74-4e4d-3bf6-88dd-eb5db7326e33",
                                                "text": "„Für die Kinder wurde das zu einem Zeitvertreib.“"
                                            },
                                            {
                                                "example_id": "d602e5da-748b-4815-b113-c321ce4dbf38",
                                                "sense_id": "64248a74-4e4d-3bf6-88dd-eb5db7326e33",
                                                "text": "„Diese nächtliche Szene, eigentlich bloß als Zeitvertreib gedacht, hat unerwartete Folgen.“"
                                            },
                                            {
                                                "example_id": "721a811d-fc3d-44eb-b0e5-6b6f3035b85f",
                                                "sense_id": "64248a74-4e4d-3bf6-88dd-eb5db7326e33",
                                                "text": "„Ich ließ alle meine Papiere und alle verbotenen Bücher, die ich besaß, bei Signora Manzoni, die zwanzig Jahre älter war als ich, daran glaubte, daß alles Geschehen vorherbestimmt sei, und zu ihrem Zeitvertreib in dem großen Schicksalsbuch blätterte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9d7fc74c-c66e-4d0c-9fad-96bf5b83c01e",
                        "source_entry_id": "9b8eedc3-4cb3-35a3-8420-9f53cab0cb73",
                        "source_sense_id": "d2facde3-e4b6-3a73-8e8e-125b3a0e48da",
                        "target_lang_word": "pastime",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pastime",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9d311c6b-9d74-376f-87f2-3a0675fc6bc4",
                                        "entry_id": "725f17ec-ad57-3ff8-b811-2213dfcde5cf",
                                        "glosses": [
                                            "Something which amuses, and serves to make time pass agreeably."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b6dddf03-b797-4fba-b846-66b78f1bce91",
                                                "sense_id": "9d311c6b-9d74-376f-87f2-3a0675fc6bc4",
                                                "text": "Chatting is a pleasant pastime."
                                            },
                                            {
                                                "example_id": "f81c6e4f-c6e5-4707-ae72-4faa81ea8eac",
                                                "sense_id": "9d311c6b-9d74-376f-87f2-3a0675fc6bc4",
                                                "text": "Hunting and fishing, the most important employments of mankind in the rude state of society, become in its advanced state their most agreeable amusements, and they pursue for pleasure what they once followed from necessity. In the advanced state of society, therefore, they are all very poor people who follow as a trade what other people pursue as a pastime."
                                            },
                                            {
                                                "example_id": "938ee823-306b-44de-9bbb-4a7bb9798944",
                                                "sense_id": "9d311c6b-9d74-376f-87f2-3a0675fc6bc4",
                                                "text": "[…]lax court morals and the absurd chivalry business were in full feather, and the joust and the tournament were the frequent pastime of titled fine gentlemen who could fight better than they could spell..."
                                            },
                                            {
                                                "example_id": "649854b3-30ff-4af7-a89c-d52380cc6f75",
                                                "sense_id": "9d311c6b-9d74-376f-87f2-3a0675fc6bc4",
                                                "text": "An indulgent playmate, Grannie would lay aside the long scratchy-looking letter she was writing (heavily crossed ‘to save notepaper’) and enter into the delightful pastime of ‘a chicken from Mr Whiteley's’."
                                            },
                                            {
                                                "example_id": "0fcff769-0a45-47da-b7f7-9968ea9740ef",
                                                "sense_id": "9d311c6b-9d74-376f-87f2-3a0675fc6bc4",
                                                "text": "And your pastimes, consisted of the strange\nAnd twisted and deranged\nAnd I hate that little game you had called\n\"Crying Lightning\""
                                            },
                                            {
                                                "example_id": "69ccfd09-7f9a-42b6-b0ec-631d6dcee994",
                                                "sense_id": "9d311c6b-9d74-376f-87f2-3a0675fc6bc4",
                                                "text": "Nor would there be an opportunity for the media's favorite pastime of exposing conflict among his advisors."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
