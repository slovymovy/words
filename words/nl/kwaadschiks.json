{
    "word_family": [
        "kwaad",
        "goedschiks"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "ed6b68d0-f209-32fd-a0be-dc02cb911a3d",
                    "sense_definition": "Op een onwillige, gedwongen of niet-coöperatieve manier.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Als je niet vrijwillig meewerkt, dan moet het maar <w>kwaadschiks</w> gebeuren.",
                            "target_lang_translations": {
                                "en": "If you do not cooperate voluntarily, then it will have to happen <w>by force</w>."
                            }
                        },
                        {
                            "text": "We moesten de ruzie uiteindelijk <w>kwaadschiks</w> oplossen omdat niemand wilde toegeven.",
                            "target_lang_translations": {
                                "en": "In the end, we had to resolve the argument <w>the hard way</w> because no one wanted to give in."
                            }
                        }
                    ],
                    "synonyms": [
                        "onwillig",
                        "gedwongen"
                    ],
                    "antonyms": [
                        "goedschiks"
                    ],
                    "common_phrases": [
                        "goedschiks of kwaadschiks"
                    ],
                    "target_lang_definitions": {
                        "en": "In an unwilling, forced, or uncooperative manner; by force or with ill grace."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "by force",
                                "target_lang_sense_clarification": "done unwillingly or through compulsion"
                            },
                            {
                                "target_lang_word": "with an ill grace",
                                "target_lang_sense_clarification": "done reluctantly or uncooperatively"
                            },
                            {
                                "target_lang_word": "the hard way",
                                "target_lang_sense_clarification": "referring to resolving something through conflict or force"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "796c3e6b-7181-3d77-87a8-1fadc7cca104",
                    "sense_definition": "Onwillig of met tegenzin handelend.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>kwaadschikse</w> houding van de verdachte hielp het onderzoek niet vooruit.",
                            "target_lang_translations": {
                                "en": "The suspect's <w>uncooperative</w> attitude did not help the investigation move forward."
                            }
                        },
                        {
                            "text": "Zelfs de meest <w>kwaadschikse</w> medewerkers moesten uiteindelijk akkoord gaan met het nieuwe beleid.",
                            "target_lang_translations": {
                                "en": "Even the most <w>reluctant</w> employees eventually had to agree to the new policy."
                            }
                        }
                    ],
                    "synonyms": [
                        "onwillig",
                        "tegenstribbelend"
                    ],
                    "antonyms": [
                        "goedschiks"
                    ],
                    "target_lang_definitions": {
                        "en": "Acting unwillingly, reluctantly, or uncooperatively."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "unwilling",
                                "target_lang_sense_clarification": "not ready or eager to do something"
                            },
                            {
                                "target_lang_word": "reluctant",
                                "target_lang_sense_clarification": "unwilling and hesitant"
                            },
                            {
                                "target_lang_word": "uncooperative",
                                "target_lang_sense_clarification": "not willing to work with others"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}