                ],
                "senses": [
                    {
                        "sense_id": "044cff0d-2b38-34b9-bfeb-f20d620d6564",
                        "entry_id": "bc195cf7-2c66-3fdb-816c-b0f429358801",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ccedf3d1-2a75-41ab-88d2-0f122fc01a9c",
                                "sense_id": "044cff0d-2b38-34b9-bfeb-f20d620d6564",
                                "text": "Frau Gibert ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "3dec36e7-6ac6-4b57-b7a6-7babf8f55aa5",
                                "sense_id": "044cff0d-2b38-34b9-bfeb-f20d620d6564",
                                "text": "Herr Gibert wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "e92e34ec-259b-49fd-ba05-0a3a5825f7fb",
                                "sense_id": "044cff0d-2b38-34b9-bfeb-f20d620d6564",
                                "text": "Die Giberts fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "bc1e3b5a-b4e4-4ed1-9d4a-7e2305efe144",
                                "sense_id": "044cff0d-2b38-34b9-bfeb-f20d620d6564",
                                "text": "Der Gibert trägt nie die Schals, die die Gibert ihm strickt."
                            },
                            {
                                "example_id": "300c1775-9621-404e-a22c-b94d85d3f757",
                                "sense_id": "044cff0d-2b38-34b9-bfeb-f20d620d6564",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Gibert kommt, geht der Herr Gibert.“"
                            },
                            {
                                "example_id": "1aa3c0d0-be65-4de1-a758-b2b52e042120",
                                "sense_id": "044cff0d-2b38-34b9-bfeb-f20d620d6564",
                                "text": "Gibert kommt und geht."
                            },
                            {
                                "example_id": "a6ff81da-07fa-4811-89b2-c1cdfbd1ab8a",
                                "sense_id": "044cff0d-2b38-34b9-bfeb-f20d620d6564",
                                "text": "Giberts kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
