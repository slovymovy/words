                                        "glosses": [
                                            "eine Angleichung, bzw. kleinere Übereinkunft von Gesprächs- oder Verhandlungspartnern"
                                        ],
                                        "tags": [
                                            "im übertragenen Sinne"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f4da4303-f4f3-4b04-b1d2-0390631c82a1",
                                                "sense_id": "25fa16ae-2e7f-3d9a-a6bc-11c207d4b64d",
                                                "text": "Die zwei Parteien haben eine Annäherung gewagt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "f94002b0-bb09-35a3-91ab-836ff06151ac",
                                        "entry_id": "fa102fa0-fa6f-3e5a-b75d-cbdd1d676547",
                                        "glosses": [
                                            "ein Versuch, eine intimere Ebene zu erreichen"
                                        ],
                                        "tags": [
                                            "zwischen Mann und Frau"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0725732b-cf2c-4346-8208-560eddec3e2d",
                                                "sense_id": "f94002b0-bb09-35a3-91ab-836ff06151ac",
                                                "text": "Sie war sehr verärgert über seine Annäherungen."
                                            },
                                            {
                                                "example_id": "55de1022-25e3-49e0-85cb-84f8764c65ef",
                                                "sense_id": "f94002b0-bb09-35a3-91ab-836ff06151ac",
                                                "text": "„Es klang übermütig und spöttisch, und sie bog sich bei seiner Annäherung unwillkürlich zur Seite.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
