                "senses": [
                    {
                        "sense_id": "50e715bd-d03f-3d14-b3db-9228726a1bbf",
                        "entry_id": "15a1db4a-77d1-3548-933c-09ad8fa65397",
                        "glosses": [
                            "Gesamtheit des jährlich von einem Konzern (Konzernmuttergesellschaft) zu erstellenden Rechenwerks, bestehend aus Konzernbilanz, Anlagespiegel, Konzern-Gewinn- und Verlustrechnung und Konzernanhang oder sonstigen Erläuterungen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f40369c4-abf1-46d0-9cca-32aca69d63a9",
                                "sense_id": "50e715bd-d03f-3d14-b3db-9228726a1bbf",
                                "text": "„Die Intensität des Einflusses des Mutterunternehmens bestimmt die Art der Einbeziehung der zum Konzernverbund gehörenden Unternehmen in den Konzernjahresabschluss.“"
                            },
                            {
                                "example_id": "3e8514d5-6a8d-4849-88ff-446746e7759a",
                                "sense_id": "50e715bd-d03f-3d14-b3db-9228726a1bbf",
                                "text": "„Um den Interessenten des Konzerns respektive einzelner Konzernunternehmen dennoch aussagekräftige Informationen an die Hand zu geben, sind die Muttergesellschaften solcher Konzernverflechtungen unter bestimmten Voraussetzungen verpflichtet einen Konzernjahresabschluss – im Folgenden kurz Konzernabschluss genannt – aufzustellen, prüfen zu lassen und zu publizieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
