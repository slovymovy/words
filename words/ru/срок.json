{
    "word_family": [
        "срочный",
        "досрочный",
        "просрочить",
        "срочность"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "aae24867-8627-343e-bdba-468a94711f59",
                    "sense_definition": "Определённый промежуток времени, отведенный для выполнения чего-либо.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "time_span",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Проект рассчитан на длительный <w>срок</w>.",
                            "target_lang_translations": {
                                "en": "The project is designed for a long <w>period</w>."
                            }
                        },
                        {
                            "text": "У нас остался короткий <w>срок</w> для завершения работы.",
                            "target_lang_translations": {
                                "en": "We have a short <w>span</w> of time left to finish the work."
                            }
                        }
                    ],
                    "synonyms": [
                        "период",
                        "промежуток"
                    ],
                    "common_phrases": [
                        "короткий срок",
                        "длительный срок"
                    ],
                    "target_lang_definitions": {
                        "en": "A specific period of time allocated for the completion of something."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "period",
                                "target_lang_sense_clarification": "A length of time."
                            },
                            {
                                "target_lang_word": "span",
                                "target_lang_sense_clarification": "A brief portion or extent of time."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e3b13acf-3716-3066-9986-cf391d2c9b66",
                    "sense_definition": "Определённый момент времени, когда должно что-то произойти.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "time_point",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Наступил <w>срок</w> возвращения долга.",
                            "target_lang_translations": {
                                "en": "The <w>deadline</w> for repaying the debt has arrived."
                            }
                        },
                        {
                            "text": "Все документы нужно сдать в установленный <w>срок</w>.",
                            "target_lang_translations": {
                                "en": "All documents must be submitted by the <w>due date</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "установленный срок",
                        "истечение срока"
                    ],
                    "target_lang_definitions": {
                        "en": "A specific point in time when something is scheduled to happen or is due."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "deadline",
                                "target_lang_sense_clarification": "The latest time or date by which something should be completed."
                            },
                            {
                                "target_lang_word": "due date",
                                "target_lang_sense_clarification": "The date on which something is expected or required."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dc43096d-34d0-3da1-a37d-e60002f270e3",
                    "sense_definition": "Тюремное заключение определённой продолжительности по приговору суда.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "legal_punishment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он отбывал свой <w>срок</w> во Владимире.",
                            "target_lang_translations": {
                                "en": "He served his <w>sentence</w> in Vladimir."
                            }
                        },
                        {
                            "text": "Преступник получил большой <w>срок</w> за кражу.",
                            "target_lang_translations": {
                                "en": "The criminal received a long prison <w>term</w> for theft."
                            }
                        }
                    ],
                    "common_phrases": [
                        "отбывать срок",
                        "получить срок"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "используется в контексте уголовного наказания"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A fixed duration of imprisonment served as a court-ordered punishment."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sentence",
                                "target_lang_sense_clarification": "The punishment assigned by a court to a person convicted of an offense."
                            },
                            {
                                "target_lang_word": "term",
                                "target_lang_sense_clarification": "A fixed period of time served in prison."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}