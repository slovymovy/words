            {
                "entry_id": "a1736237-85eb-3e2f-bfee-ba9642cfbe6f",
                "word": "yuan",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "23f5ce4a-fccc-4610-a3c5-bd0490755b77",
                        "entry_id": "a1736237-85eb-3e2f-bfee-ba9642cfbe6f",
                        "tags": [
                            "plural"
                        ],
                        "form": "yuans"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4bcbe7d6-237e-3669-bd0e-ba558d48637c",
                        "entry_id": "a1736237-85eb-3e2f-bfee-ba9642cfbe6f",
                        "glosses": [
                            "Devise officielle de la Chine. Un yuan vaut 10 jiaos et 100 fens. Code ISO 4217 : CNY."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2f40641c-0346-427a-a7a4-cab5534e1d98",
                                "sense_id": "4bcbe7d6-237e-3669-bd0e-ba558d48637c",
                                "text": "Pour une pareille action de résistance, pour les risques pris et par peur de l’être, parce qu’il fallait faire vite, j’ai acheté toutes les cartes en couvrant de yuans mon vendeur."
                            },
                            {
                                "example_id": "b0d50a20-28a3-4f30-a763-abd7609e6e81",
                                "sense_id": "4bcbe7d6-237e-3669-bd0e-ba558d48637c",
                                "text": "La Chine accélère l’internationalisation du yuan."
                            },
                            {
                                "example_id": "0fb86a75-8bff-4037-a1d7-afbb30d524dc",
                                "sense_id": "4bcbe7d6-237e-3669-bd0e-ba558d48637c",
                                "text": "Il avait bu son thé à trois cent mille yuans la livre, […]. Pourtant il l'avait entendu affirmer que chaque tasse valait dans les deux mille huit cents yuans. Soit deux bœufs ou un motoculteur pour les gens des Balou."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "77a4d8a3-0029-4142-b208-b22fddb2d7cd",
                        "source_entry_id": "a1736237-85eb-3e2f-bfee-ba9642cfbe6f",
                        "source_sense_id": "4bcbe7d6-237e-3669-bd0e-ba558d48637c",
                        "target_lang_word": "Yuan",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Yuan",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6d586776-22c0-33b6-8fb8-49f78b5e69f8",
                                        "entry_id": "5c5f3c4a-b130-3fc2-95f0-941b7fd49c23",
                                        "glosses": [
                                            "Währungseinheit der Volksrepublik China"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e34f947e-9aa7-45f3-825e-d2af6c72ab2e",
                                                "sense_id": "6d586776-22c0-33b6-8fb8-49f78b5e69f8",
                                                "text": "„Erneut kritisierte Obama auch, dass der Yuan zum Nachteil des US-Handels unterbewertet sei.“"
                                            },
                                            {
                                                "example_id": "b7da75e4-2516-4b08-8e75-99b561c18836",
                                                "sense_id": "6d586776-22c0-33b6-8fb8-49f78b5e69f8",
                                                "text": "„Zum Yuan hieß es, China werde weiter an einer \"größeren Flexibilität beim Wechselkurs\" arbeiten.“"
                                            },
                                            {
                                                "example_id": "35abbcb5-2190-4281-9a9c-508b0cbd7535",
                                                "sense_id": "6d586776-22c0-33b6-8fb8-49f78b5e69f8",
                                                "text": "„Infolge der global schwachen Nachfrage sowie der Aufwertung des Yuan gegenüber dem Euro wird die Wettbewerbsfähigkeit chinesischer Güter geschwächt.“"
                                            },
                                            {
                                                "example_id": "56da7b25-9652-4e4f-a5e6-96638a337048",
                                                "sense_id": "6d586776-22c0-33b6-8fb8-49f78b5e69f8",
                                                "text": "„Mittlerweile kaufen unter anderem die EZB oder die Bundesbank Yuan als Reservewährung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "de6b2c92-f289-4609-83ff-567fe12cd1d5",
                        "source_entry_id": "a1736237-85eb-3e2f-bfee-ba9642cfbe6f",
                        "source_sense_id": "4bcbe7d6-237e-3669-bd0e-ba558d48637c",
                        "target_lang_word": "yuan",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "yuan",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "20235525-0da3-360c-8d9b-105b6f1cb520",
                                        "entry_id": "c8cba905-ec5c-3390-b9ff-070ae38da177",
                                        "glosses": [
                                            "The basic unit of money in China."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "34e9616c-bf0e-4375-af62-1efe6fa4d318",
                                                "sense_id": "20235525-0da3-360c-8d9b-105b6f1cb520",
                                                "text": "Sung paused to show me some of the notes. They were in issues of five yuan (a Chinese dollar, equal at this time to a little less than one American dollar), one yuan, twenty and ten cent denominations."
                                            },
                                            {
                                                "example_id": "fa0293e6-bf06-4299-84b6-59642cf36fda",
                                                "sense_id": "20235525-0da3-360c-8d9b-105b6f1cb520",
                                                "text": "The Nanchiaoshan Co-operative in Kuangling County originally had 14 households. But they became dissatisfied and 7 withdrew because nothing was done when the production-team leader (a rich peasant) and the bookkeeper made away with some 60 yuan of public money.",
                                                "translation": "中国农村的社会主义高潮（选本）",
                                                "english": "中国农村的社会主义高潮（选本）"
                                            },
                                            {
                                                "example_id": "55a3b0f5-2b0c-4ebd-9bed-842b2cc547c6",
                                                "sense_id": "20235525-0da3-360c-8d9b-105b6f1cb520",
                                                "text": "A ticket to these Saturday and Sunday night dances costs 15 yuan, or $5.35, which is a lot when one considers that the average Peking worker makes 60 to 70 yuan ($21 to $25) a month."
                                            },
                                            {
                                                "example_id": "90673934-a4a8-4367-a48e-43368c66c127",
                                                "sense_id": "20235525-0da3-360c-8d9b-105b6f1cb520",
                                                "text": "Donations to the mosque come from a village considered fairly poor by regional standards, with an average annual income of 300 yuan (about U.S. $100) per household. The 1982 average per capita annual income in Yongning County was substantially higher, 539 yuan according to the Population Census Office (1987:206)."
                                            },
                                            {
                                                "example_id": "928b6ca5-ec77-45b0-95b6-995de9149b3f",
                                                "sense_id": "20235525-0da3-360c-8d9b-105b6f1cb520",
                                                "text": "The provincial government has designated thirty-four counties in Henan as officially impoverished (pinkun xian) according to the provincial criterion: an average annual per capita income below 500 yuan and total household assets valued at less than 8,000 yuan, based on 1990 prices."
                                            },
                                            {
                                                "example_id": "679ae80d-d6ba-4797-ba5e-ff5fea9f71b0",
                                                "sense_id": "20235525-0da3-360c-8d9b-105b6f1cb520",
                                                "text": "In Pinggu, a suburb of Beijing, residents were told that they would receive 50-yuan ($7.60) prizes in cash or merchandise once they had been fully vaccinated."
                                            },
                                            {
                                                "example_id": "0b35e245-ad28-4b9a-9fd8-2a63cbacbf05",
                                                "sense_id": "20235525-0da3-360c-8d9b-105b6f1cb520",
                                                "text": "The popular Chinese coffee chain rolled out the so-called “sauce-flavored latte” with a jolt of liquor for 38 yuan ($5.20) on Monday. Customers who order with an online coupon will be able to receive 50% off for a limited time, it said."
                                            },
                                            {
                                                "example_id": "ad792093-7dda-45fa-a168-1795247746a2",
                                                "sense_id": "20235525-0da3-360c-8d9b-105b6f1cb520",
                                                "text": "The drink is priced at 68 yuan ($9.45), according to the app."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "yuan",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cd8f4a6e-c47f-3286-b0b1-a0bf860e91a4",
                                        "entry_id": "b306b7f7-b29a-30aa-9ca3-c3cdefed0203",
                                        "glosses": [
                                            "One of the five branches of the government of the Republic of China."
                                        ],
                                        "tags": [
                                            "Taiwan"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
