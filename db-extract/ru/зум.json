                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "84d836f6-7ab7-3666-b29c-e54b30162145",
                                        "entry_id": "c0d78569-7277-34bc-878c-b9a24795e200",
