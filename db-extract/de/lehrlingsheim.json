                        "tags": [],
                        "examples": [
                            {
                                "example_id": "63c090a8-ce3f-406d-af81-d3c40ddbf58c",
                                "sense_id": "fcc744fa-6f55-3698-9013-4948ed649581",
                                "text": "„Auch Fried war begeistert von seinen Bildern, und als er es wagte, sie in der Herberge und der Gärtnerei zu zeigen und der Herbergsvater ihm sogar ein Aquarell des Lehrlingsheims abkaufte, da war er zum ersten Mal in seinem Leben richtig stolz gewesen.“"
                            },
                            {
                                "example_id": "b61c45ba-85b9-4eda-97f6-8fd767ccd1ab",
                                "sense_id": "fcc744fa-6f55-3698-9013-4948ed649581",
                                "text": "„Neulich, sieben Jahre nach dieser Zeit im Lehrlingsheim, sah ich Frau Wietzel an einer Straßenbahnstation stehen, und ich stoppte meinen Wagen, stieg aus und bot ihr an, sie in die Stadt zu bringen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
