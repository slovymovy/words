    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "dd9bdac2-ff5f-34c6-b55a-1d6b99a471e0",
                    "sense_definition": "Qui est indispensable pour accomplir une action ou atteindre un but.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "utilite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Prenez tout le matériel <w>nécessaire</w> avant de commencer votre travail."
                        },
                        {
                            "text": "Il est <w>nécessaire</w> de boire régulièrement de l'eau en été."
                        }
                    ],
                    "synonyms": [
                        "essentiel",
                        "indispensable",
                        "primordial",
                        "vital"
                    ],
                    "common_phrases": [
