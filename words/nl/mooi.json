                {
                    "sense_id": "af14bb23-8523-3cc2-b6df-a8954f93aea4",
                    "sense_definition": "Vervelend, tegenvallend of onaangenaam (ironisch gebruikt).",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "ironic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nou wordt 'ie <w>mooi</w>, dat had ik totaal niet verwacht!",
                            "target_lang_translations": {
                                "en": "Now that's a <w>fine</w> one, I didn't expect that at all!",
                                "ru": "Ну это просто <w>прекрасно</w>, я этого совсем не ожидал!",
                                "pl": "No to <w>pięknie</w>, zupełnie się tego nie spodziewałem!",
                                "de": "Das ist ja jetzt <w>schön</w>, das hätte ich überhaupt nicht erwartet!",
                                "fr": "Elle est bien <w>bonne</w> celle-là, je ne m'y attendais pas du tout !",
                                "it": "Questa sì che è <w>bella</w>, non me lo aspettavo proprio!",
                                "cs": "No to je <w>pěkné</w>, to jsem vůbec nečekal!",
                                "tr": "Şimdi <w>iyi</w> oldu işte, bunu hiç beklemiyordum!",
                                "es": "¡Ah, <w>bueno</w>, eso sí que no me lo esperaba para nada!"
                            }
                        },
                        {
                            "text": "Dat is een <w>mooie</w> boel, nu zitten we met de problemen.",
                            "target_lang_translations": {
                                "en": "That is a <w>fine</w> mess, now we are stuck with the problems.",
                                "ru": "Это <w>хорошенькое</w> дело, теперь у нас проблемы.",
                                "pl": "To <w>ładny</w> gips, teraz mamy same problemy.",
                                "de": "Das ist ja eine <w>schöne</w> Bescherung, jetzt haben wir den Salat.",
                                "fr": "C'est un <w>joli</w> pétrin, nous voilà maintenant avec des problèmes.",
                                "it": "Questa è una <w>bella</w> gatta da pelare, adesso siamo nei guai.",
                                "cs": "To je <w>pěkná</w> nadílka, teď máme problémy.",
                                "tr": "Bu da <w>güzel</w> bir iş, şimdi sorunlarla baş başa kaldık.",
                                "es": "¡Menudo <w>bonito</w> panorama, ahora estamos metidos en problemas!"
                            }
                        }
