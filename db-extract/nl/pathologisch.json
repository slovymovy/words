                    },
                    {
                        "translation_id": "189f5099-c6e3-4875-a852-c329fe9f0aac",
                        "source_entry_id": "303d3b76-26c8-3e7a-862a-efa76eca5a42",
                        "source_sense_id": "c4b40515-f683-341b-b7ac-33f09619c86c",
                        "source_sense_description": "ziekte betreffend",
                        "target_lang_word": "pathological",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pathological",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c88641ad-53ec-3fff-8298-c5c7b7368e73",
                                        "entry_id": "5f472bc3-f214-37f6-ab47-8ff58ae64826",
                                        "glosses": [
                                            "Pertaining to pathology."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d019a123-36b2-4089-8163-8cef07ece91d",
                                                "sense_id": "c88641ad-53ec-3fff-8298-c5c7b7368e73",
                                                "text": "But we can no longer regard the mere fact of these diffuse condensations of the lung becoming yellow and caseous as an evidence of their tuberculous nature, especially since the pathological anatomists, and among them Virchow, have shown that formations of the most different kind, having not the slightest connection with tubercule— as, for example, old cancerous masses, lymphatic glands swollen by a hyperplasia of cells, hæmorrhagical infarctions, abscesses, &c.— undergo exactly the same caseous transformation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2b168aad-8f22-3b8d-8287-ad56ba95a23e",
                                        "entry_id": "5f472bc3-f214-37f6-ab47-8ff58ae64826",
                                        "glosses": [
                                            "Relating to, amounting to, or caused by a physical or mental disorder."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21ffbf3b-7c3e-4908-92a1-854bfeae6523",
                                                "sense_id": "2b168aad-8f22-3b8d-8287-ad56ba95a23e",
                                                "text": "Paul Canning's performance as Julian gives the character an emotional center that is not in the script: He is vulnerable without being pathological, needy without being pathetic."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "be9bc3fe-e76d-3cc5-9cb4-84517038ed1f",
                                        "entry_id": "5f472bc3-f214-37f6-ab47-8ff58ae64826",
                                        "glosses": [
                                            "Having properties which are counterintuitive or difficult to handle."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "82a26e10-5443-3706-b031-c4c965a573e7",
                                        "entry_id": "5f472bc3-f214-37f6-ab47-8ff58ae64826",
                                        "glosses": [
                                            "Having properties that cause unusually bad behaviour, especially regarding correctness or performance."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ed0210e1-a726-4436-8dd0-4094f0e8899b",
                        "source_entry_id": "303d3b76-26c8-3e7a-862a-efa76eca5a42",
                        "source_sense_id": "c4b40515-f683-341b-b7ac-33f09619c86c",
                        "source_sense_description": "ziekte betreffend",
                        "target_lang_word": "pathologique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pathologique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "424ca5d7-4849-3cff-a47d-add7f0b3ccc5",
                                        "entry_id": "71522b84-0107-31e8-a222-e9e15add2ffb",
                                        "glosses": [
                                            "Qui appartient à la pathologie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c20b90a2-5fb8-4c09-ae24-56c715ece42a",
                                                "sense_id": "424ca5d7-4849-3cff-a47d-add7f0b3ccc5",
                                                "text": "Il serait superflu de rappeler ici le tableau de l’alcoolisme […] ; mais nous voulons appeler l’attention sur la ressemblance que présentent avec lui le caféisme, le théisme, le cocaïsme, états pathologiques beaucoup plus rares et beaucoup moins connus, mais pourtant réels."
                                            },
                                            {
                                                "example_id": "7eaf41dd-9f8d-473c-8bcb-d1cdcecc6b5c",
                                                "sense_id": "424ca5d7-4849-3cff-a47d-add7f0b3ccc5",
                                                "text": "La sérine du sang ressemble beaucoup à l’albumine de l’œuf ; elle constitue également l’albumine pathologique des urines."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2f7ab203-76e5-3e88-b4f8-e1c1dd680a1d",
                                        "entry_id": "71522b84-0107-31e8-a222-e9e15add2ffb",
                                        "glosses": [
                                            "Qui confine à l’anomalie, à la pathologie ; maladif."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7abd00f2-5e71-45db-92ba-7178a6f8a1df",
                                                "sense_id": "2f7ab203-76e5-3e88-b4f8-e1c1dd680a1d",
                                                "text": "Chez les nations de langue anglaise Hitler et Goering ont été aisément reconnus comme des cas pathologiques étalant leur anormalité dans chacun de leurs actes, dans tous les gestes de leur vie."
                                            },
                                            {
                                                "example_id": "91fd1d82-f7f6-489e-9448-353f5b28f54e",
                                                "sense_id": "2f7ab203-76e5-3e88-b4f8-e1c1dd680a1d",
                                                "text": "Même et surtout si le criminel est un demi-responsable pour des motifs d’ordre pathologique (et cela est presque la règle, car, en somme, la criminalité est le plus souvent presque une maladie dont la délinquance est la forme atténuée), la peine sévère aura sur lui une action plus forte que la demi-peine."
                                            },
                                            {
                                                "example_id": "0f9801e9-b594-4492-958d-b976a41d0654",
                                                "sense_id": "2f7ab203-76e5-3e88-b4f8-e1c1dd680a1d",
                                                "text": "Je ne vais pas lui tresser des lauriers, reprend-il, il faut juste montrer qu'elle n'était pas une baiseuse pathologique ni une obsédée du pouvoir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e80a0541-e486-39d8-a004-4d47abbfd799",
                                        "entry_id": "71522b84-0107-31e8-a222-e9e15add2ffb",
                                        "glosses": [
                                            "Se dit d’un cas particulier contre-intuitif d’un raisonnement qui ne peut être traité avec les autres."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2d8c5201-f928-49fc-990d-21d63db56f7f",
                                                "sense_id": "e80a0541-e486-39d8-a004-4d47abbfd799",
                                                "text": "Cette géométrie permet d’étudier des objets a priori pathologiques."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "47ac3a0f-92ed-3353-803b-c1b1ef5e4f8b",
                                        "entry_id": "71522b84-0107-31e8-a222-e9e15add2ffb",
                                        "glosses": [
                                            "Qui révèle une passivité résultant d'une simple affection de la sensibilité."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
