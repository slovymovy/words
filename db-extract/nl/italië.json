                                "target_senses": [
                                    {
                                        "sense_id": "7ea26ac6-bfcd-3306-b5e0-f8696cd26f56",
                                        "entry_id": "ecf84a5c-7ca7-3b55-b853-f9386859c9ae",
                                        "glosses": [
                                            "Land in Südeuropa"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "780dfd74-53c7-4e95-85b5-b3c8fa2dfe20",
                                                "sense_id": "7ea26ac6-bfcd-3306-b5e0-f8696cd26f56",
                                                "text": "Italien kann auf eine ereignisreiche Geschichte zurückblicken."
                                            },
                                            {
                                                "example_id": "c4213599-235e-4b56-8fa7-aa256d938bb9",
                                                "sense_id": "7ea26ac6-bfcd-3306-b5e0-f8696cd26f56",
                                                "text": "„1871 – Rom wird zur Hauptstadt des vereinten Italien.“"
                                            },
                                            {
                                                "example_id": "e92f9118-ec34-4995-bad0-7da10cf7602c",
                                                "sense_id": "7ea26ac6-bfcd-3306-b5e0-f8696cd26f56",
                                                "text": "„Das Gebiet des heutigen Italiens war in der Antike die Kernregion des Römischen Reiches mit Rom als Hauptstadt.“"
                                            },
                                            {
                                                "example_id": "bef963db-a865-49de-aac0-b9031fd332d0",
                                                "sense_id": "7ea26ac6-bfcd-3306-b5e0-f8696cd26f56",
                                                "text": "„Italien, so Antonio Brilli in seinem Buch über die Grand Tour, war über lange Zeit der Ort, an dem sich die Jugend Europas begegnete.“"
                                            },
                                            {
                                                "example_id": "6250e6eb-4a50-43d3-b80b-600663b86415",
                                                "sense_id": "7ea26ac6-bfcd-3306-b5e0-f8696cd26f56",
                                                "text": "„Soweit ich weiß, war er aus Seattle nach Italien gekommen, um dort Familienangehörige zu besuchen, und hatte sich freiwillig gemeldet, als Italien in den Krieg eintrat.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0ee8af00-0df5-4948-83d4-5fb70391ed48",
                        "source_entry_id": "9496babf-8ddd-3d3b-af2d-35ff63334fc6",
                        "source_sense_id": "fbab5dbe-44c0-30a7-8dd5-50578bd4655d",
