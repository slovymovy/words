                {
                    "sense_id": "bd93acc1-a04f-336e-b015-835a9835c705",
                    "sense_definition": "Tweede persoon enkelvoud tegenwoordige tijd van <w>roepen</w> (bij inversie).",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Waarom <w>roep</w> je zo hard in de bibliotheek?",
