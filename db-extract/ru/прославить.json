                    {
                        "form_id": "b8f85ea3-1294-4a67-a92b-f416e7a8375d",
                        "entry_id": "9e2d8c6e-7604-35bb-815a-3c1edc74913e",
                        "tags": [
                            "adverbial",
                            "participle",
                            "past"
                        ],
                        "form": "просла́вив"
                    },
                    {
                        "form_id": "ac40a1ab-9388-45af-85af-4c8512385174",
                        "entry_id": "9e2d8c6e-7604-35bb-815a-3c1edc74913e",
                        "tags": [
                            "adverbial",
                            "participle",
                            "past"
                        ],
                        "form": "просла́вивши"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "aaa0c62d-a2cd-3b82-81f1-abe02073b48d",
                        "entry_id": "9e2d8c6e-7604-35bb-815a-3c1edc74913e",
                        "glosses": [
                            "сделать известным, знаменитым, славным"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0539dd70-453e-468d-94fc-9397d3aeb935",
                                "sense_id": "aaa0c62d-a2cd-3b82-81f1-abe02073b48d",
                                "text": "Огневых ударов сила нас прославила давно у подножья Измаила, на холмах Бородино."
                            }
                        ]
                    },
                    {
                        "sense_id": "98d7664c-8656-349d-8964-29b4fc8d950b",
                        "entry_id": "9e2d8c6e-7604-35bb-815a-3c1edc74913e",
                        "glosses": [
                            "воздать хвалу кому-либо, восхвалить"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a7375c7-9c75-4d4e-b9d7-a6581c58d2d5",
                                "sense_id": "98d7664c-8656-349d-8964-29b4fc8d950b",
                                "text": "Прославим в мире женщину — Мать, единую силу, пред которой покорно склоняется Смерть!"
                            }
                        ]
                    },
                    {
                        "sense_id": "a4e56485-617f-335c-a8c6-2c4ee9827cac",
                        "entry_id": "9e2d8c6e-7604-35bb-815a-3c1edc74913e",
                        "glosses": [
                            "описать или изобразить в художественном произведении, создавая известность кому-либо, чему-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "70f56e86-4002-458c-bda7-f75b79b11385",
                                "sense_id": "a4e56485-617f-335c-a8c6-2c4ee9827cac",
                                "text": "Давно бы нашим поэтам следовало прославить бархатные луга за Окой."
                            }
                        ]
                    },
                    {
                        "sense_id": "dcef37fa-8604-3af6-98fe-7a5629fce3da",
                        "entry_id": "9e2d8c6e-7604-35bb-815a-3c1edc74913e",
                        "glosses": [
                            "пропеть кому-либо величальную песню"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3dd8ca44-4786-46dd-8825-82a7e4b3d17b",
                                "sense_id": "dcef37fa-8604-3af6-98fe-7a5629fce3da",
                                "text": "Девушки, став полукругом, прославили молодых — и пошли плясать."
                            }
                        ]
                    },
                    {
                        "sense_id": "352207ac-2d7c-3d9e-b802-3845f6cba0e7",
                        "entry_id": "9e2d8c6e-7604-35bb-815a-3c1edc74913e",
                        "glosses": [
                            "разг. распространить о ком-либо дурные слухи, сплетни, клевету; ославить"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8cc8f66e-e7ae-438b-9f1b-a5953a850718",
                                "sense_id": "352207ac-2d7c-3d9e-b802-3845f6cba0e7",
                                "text": "Безумным вы меня прославили всем хором."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4716580f-2cac-4236-a252-14355e8c6d63",
                        "source_entry_id": "9e2d8c6e-7604-35bb-815a-3c1edc74913e",
                        "source_sense_description": "сделать известным, знаменитым, славным",
                        "target_lang_word": "rendre célèbre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "06493131-99ce-4793-bf8b-198412e77c78",
                        "source_entry_id": "9e2d8c6e-7604-35bb-815a-3c1edc74913e",
                        "source_sense_description": "воздать хвалу кому-либо, восхвалить",
                        "target_lang_word": "glorify",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "glorify",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "35d5f3f4-8a36-35d8-ac21-0bbf62f38da0",
                                        "entry_id": "050cea9e-d1d1-3d84-8796-0c6d11648e58",
                                        "glosses": [
                                            "To exalt, or give glory or praise to (something or someone)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "22d96ed4-3668-3a97-81c0-85b8f6445f4d",
                                        "entry_id": "050cea9e-d1d1-3d84-8796-0c6d11648e58",
                                        "glosses": [
                                            "To make (something) appear to be more glorious than it is; regard something or someone as excellent baselessly."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "adb51daf-9f0c-42a8-8aed-1c0e88387e14",
                                                "sense_id": "22d96ed4-3668-3a97-81c0-85b8f6445f4d",
                                                "text": "Some movies glorify mobsters by making them seem like the cool kids around the block."
                                            },
                                            {
                                                "example_id": "7ded1e07-afe1-4e6b-8c7f-a3bd95019f00",
                                                "sense_id": "22d96ed4-3668-3a97-81c0-85b8f6445f4d",
                                                "text": "Historical dictators are glorified in some countries that are dictatorships and by some political radicals."
                                            },
                                            {
                                                "example_id": "ee7949bd-84bf-4357-b320-1086ef27997a",
                                                "sense_id": "22d96ed4-3668-3a97-81c0-85b8f6445f4d",
                                                "text": "Thursday's long-awaited relocation fulfils a key pledge of the socialist government, which said Spain should not continue to glorify a fascist who ruled the country for nearly four decades."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8954ca6a-0130-3b64-a800-c7bd95aae742",
                                        "entry_id": "050cea9e-d1d1-3d84-8796-0c6d11648e58",
                                        "glosses": [
                                            "To worship or extol."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "217c8e44-4137-409f-8579-b20c4728e0ed",
                        "source_entry_id": "9e2d8c6e-7604-35bb-815a-3c1edc74913e",
                        "source_sense_description": "воздать хвалу кому-либо, восхвалить",
                        "target_lang_word": "glorifier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "glorifier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7ec1c935-017a-38e0-89b0-2b684136bcf3",
                                        "entry_id": "629b0d12-cb8b-31b0-8bcc-34988d39d032",
                                        "glosses": [
                                            "Honorer, célébrer par de grandes louanges."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dda9dbcd-4144-4f4f-aa00-2308e325863a",
                                                "sense_id": "7ec1c935-017a-38e0-89b0-2b684136bcf3",
                                                "text": "En décortiquant les modes d'action de nos adversaires, [ce livre] nous rend plus méfiants, plus capables de saisir quand nous courons le risque d'être manipulés. Il les expose et lève le voile sur leur hypocrisie : quand ils prétendent glorifier le passé, ils le réécrivent ; quand ils nous accusent de crimes, ils les fabriquent, s'ils utilisent des vérités comme point de départ de leurs narratifs, c'est pour mieux les travestir après ; quand ils prétendent nous informer, c'est pour mieux nous manipuler."
                                            },
                                            {
                                                "example_id": "5c0d30f4-6599-4cbf-a919-29fddbacc824",
                                                "sense_id": "7ec1c935-017a-38e0-89b0-2b684136bcf3",
                                                "text": "Glorifier la victoire de la Marne."
                                            },
                                            {
                                                "example_id": "04a9f027-2e8f-4983-9fe8-e308f5394737",
                                                "sense_id": "7ec1c935-017a-38e0-89b0-2b684136bcf3",
                                                "text": "C’est en compagnie de mon ami photographe Karl Tremblay que je l’ai rencontré chez lui, au travers de tous ses souvenirs qui l’entourent. Le but de l’entrevue était de le connaître un peu plus et non pas pour le glorifier."
                                            },
                                            {
                                                "example_id": "2bc201fe-ac1d-4b00-a7ba-4f918e5e6f69",
                                                "sense_id": "7ec1c935-017a-38e0-89b0-2b684136bcf3",
                                                "text": "Ces cours ne se bornent pas à glorifier les sacrifices des soldats russes ou à dénoncer les « fascistes de Kiev », ils insistent sur l’idée que la Russie est une forteresse assiégée par l’Occident, où chaque citoyen doit être prêt à défendre la patrie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "64def475-c007-3a53-a3c2-8eba8c7f52c0",
                                        "entry_id": "629b0d12-cb8b-31b0-8bcc-34988d39d032",
                                        "glosses": [
                                            "Honorer la divinité dans toute sa gloire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb84cd3c-d5da-46f3-bbdc-bc8f271563d5",
                                                "sense_id": "64def475-c007-3a53-a3c2-8eba8c7f52c0",
                                                "text": "La joie de cette servante, plutôt taciturne, consistait à glorifier la Vierge pour laquelle elle professait un culte ; […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0556763b-52c9-3b07-86e7-a3fa084a9171",
                                        "entry_id": "629b0d12-cb8b-31b0-8bcc-34988d39d032",
                                        "glosses": [
                                            "En parlant de Dieu, faire participer à sa gloire."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ea5c36c5-11c6-41b8-86d8-7d2886bb83ae",
                                                "sense_id": "0556763b-52c9-3b07-86e7-a3fa084a9171",
                                                "text": "Dieu glorifie les saints."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "233415e1-4ccf-359b-bcc3-75f9d65abc7f",
                                        "entry_id": "629b0d12-cb8b-31b0-8bcc-34988d39d032",
                                        "glosses": [
                                            "Se faire gloire de quelque chose, en tirer vanité."
                                        ],
                                        "tags": [
                                            "pronominal",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5b3cd94e-65a5-4578-85b7-414864a5957d",
                                                "sense_id": "233415e1-4ccf-359b-bcc3-75f9d65abc7f",
                                                "text": "Un Anglais nommé Frick s’était glorifié d’avoir instauré la crinoline; un autre Anglais se glorifia d’en avoir « désemprisonné la femme »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f3697ffb-f16a-3a4a-b6d2-4ecff7fd8adc",
                                        "entry_id": "629b0d12-cb8b-31b0-8bcc-34988d39d032",
                                        "glosses": [
                                            "Mettre son honneur, sa gloire en quelqu’un, en quelque chose."
                                        ],
                                        "tags": [
                                            "pronominal",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "00ac9516-d533-48dd-a7bb-f76f7a50a9a9",
                                                "sense_id": "f3697ffb-f16a-3a4a-b6d2-4ecff7fd8adc",
                                                "text": "Dieu se glorifie dans ses saints."
                                            },
                                            {
                                                "example_id": "0866c2d2-aee6-42ba-9390-21e9a5aa65b4",
                                                "sense_id": "f3697ffb-f16a-3a4a-b6d2-4ecff7fd8adc",
                                                "text": "Un père se glorifie dans ses enfants."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "60d5a4de-304c-4bb6-ba9d-9588f1d0f3c7",
                        "source_entry_id": "9e2d8c6e-7604-35bb-815a-3c1edc74913e",
                        "source_sense_description": "описать или изобразить в художественном произведении",
                        "target_lang_word": "célébrer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "célébrer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7eb9dd5e-2c95-33e6-84d0-11a520a0a982",
                                        "entry_id": "45e75338-8c0b-3713-a0e9-51dce9edd846",
                                        "glosses": [
                                            "Louer avec éclat ; publier avec éloge."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2ad16dc9-24e9-48ce-8036-5d3a1fb22ce4",
                                                "sense_id": "7eb9dd5e-2c95-33e6-84d0-11a520a0a982",
                                                "text": "La bouche grasse, les pommettes rouges, les yeux injectés de bourgogne, Guillaume-Adolphe Porcellet célébra la grève, la sainte grève!... Avec une rare éloquence, il parla des exploiteurs de peuples, des affameurs de pauvres."
                                            },
                                            {
                                                "example_id": "12caf12d-39f4-450d-8fa6-9d1f9a696de6",
                                                "sense_id": "7eb9dd5e-2c95-33e6-84d0-11a520a0a982",
                                                "text": "Les flûtes, l’une après l’autre, inventent et modulent de gracieuses variations, comme pour célébrer joyeusement la virtuosité du vainqueur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6148f12d-bcf0-3b3c-ab88-11747e42612b",
                                        "entry_id": "45e75338-8c0b-3713-a0e9-51dce9edd846",
                                        "glosses": [
                                            "Marquer un évènement ou le retour périodique d’un évènement d’un certain éclat, d’une certaine pompe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "02bf3197-99db-41e7-b21c-76e66db846ea",
                                                "sense_id": "6148f12d-bcf0-3b3c-ab88-11747e42612b",
                                                "text": "[…]; c’est sur cette même place où son union avec Marie-Antoinette d’Autriche fut célébrée par une fête qu’enlaidirent des présages sinistres."
                                            },
                                            {
                                                "example_id": "bca8aae3-144e-45bb-a30b-8640faed50ad",
                                                "sense_id": "6148f12d-bcf0-3b3c-ab88-11747e42612b",
                                                "text": "Cheikh Gaafar se montra généreux pour la dot et les cadeaux. Il fit célébrer de belles fêtes pour le mariage. […] Le village entier fut en liesse."
                                            },
                                            {
                                                "example_id": "0aa85eef-e5da-4a81-a6b9-4e04f9b023a3",
                                                "sense_id": "6148f12d-bcf0-3b3c-ab88-11747e42612b",
                                                "text": "Dans la soirée, sur la terrasse de l’ambassade, au milieu de la ville muette et hostile, on tira le feu d’artifice emporté de Tanger pour célébrer la signature du traité de protectorat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "29982edd-76b5-3ecd-99c5-f7e61d1b1eb5",
                                        "entry_id": "45e75338-8c0b-3713-a0e9-51dce9edd846",
                                        "glosses": [
                                            "Accomplir les rites ou les cérémonies d’un culte."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e3467f7a-9900-425a-868a-38c294cfdf15",
                                                "sense_id": "29982edd-76b5-3ecd-99c5-f7e61d1b1eb5",
                                                "text": "Cette cérémonie fut célébrée avec toute la pompe que l’Église romaine sait donner à ses solennités."
                                            },
                                            {
                                                "example_id": "8311588c-fe61-4006-92ab-56846ce24951",
                                                "sense_id": "29982edd-76b5-3ecd-99c5-f7e61d1b1eb5",
                                                "text": "Ils célébrèrent le 20 prairial (8 juin) la fête de l’Être suprême. Robespierre, président de la Convention, servit de pontife à cette fête […]"
                                            },
                                            {
                                                "example_id": "b106294a-1914-4c1c-8fe0-f65939f77e56",
                                                "sense_id": "29982edd-76b5-3ecd-99c5-f7e61d1b1eb5",
                                                "text": "Le bruit court que c’est dimanche. Ce n’est pas le curé qui le confirmera. Il a refusé de dire la grand’messe et a célébré l’office dans sa chambre, tout seul."
                                            },
                                            {
                                                "example_id": "92c67416-b733-4185-b9cd-2e8aa45e3abf",
                                                "sense_id": "29982edd-76b5-3ecd-99c5-f7e61d1b1eb5",
                                                "text": "Nous avons, en effet, de lui, un sermon composé pour le jour de l’Ascension et prononcé dans la ville d’Antioche avant son épiscopat et il n'y a aucun motif de prétendre que cette fête ait été célébrée un autre jour que le quarantième après Pâques, par conséquent un jeudi."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "815dc9bf-6d41-3742-b418-77be86e67270",
                                        "entry_id": "45e75338-8c0b-3713-a0e9-51dce9edd846",
                                        "glosses": [
                                            "Faire la fête."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
