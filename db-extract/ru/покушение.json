                ],
                "translations": [
                    {
                        "translation_id": "dc482781-342a-4dd2-a923-956d83785153",
                        "source_entry_id": "dd607150-d1b5-3c1e-ad6c-ec200ec0a766",
                        "target_lang_word": "Attentat",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Attentat",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "beae8c7d-1b36-3e88-8f30-a4050f9d6f09",
                                        "entry_id": "5cfeb37e-757c-39e7-b075-dfbd60903326",
                                        "glosses": [
                                            "Mord oder versuchter Mord an einem öffentlich bekannten, meist politisch einflussreichen Menschen beziehungsweise an einer bestimmten Menschengruppe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e23461b1-8be9-4e90-90c0-cce4a6376189",
                                                "sense_id": "beae8c7d-1b36-3e88-8f30-a4050f9d6f09",
                                                "text": "Eine Organisation plant ein Attentat auf den finnischen Ministerpräsidenten."
                                            },
                                            {
                                                "example_id": "b41cb0c1-8cca-4606-b9ce-c11efc896684",
                                                "sense_id": "beae8c7d-1b36-3e88-8f30-a4050f9d6f09",
                                                "text": "„Durch das fehlgeschlagene Attentat auf Hitler am 20. Juli 1944 wurden sie zu Märtyrern, deren Vermächtnis für das Nachkriegsdeutschland der Bundesrepublik symbolhafte Bedeutung hat.“"
                                            },
                                            {
                                                "example_id": "476d7af1-0aec-4a86-a9b9-7d85e2fa3c73",
                                                "sense_id": "beae8c7d-1b36-3e88-8f30-a4050f9d6f09",
                                                "text": "„Das Attentat war kein Werk von Anfängern.“"
                                            },
                                            {
                                                "example_id": "68154fe1-b713-4dea-8fce-5addb1ca92ce",
                                                "sense_id": "beae8c7d-1b36-3e88-8f30-a4050f9d6f09",
                                                "text": "„Es war die Witwe eines der Verschwörer, die in jenem Sommer 1944 nach dem Attentat auf Hitler hingerichtet worden waren.“"
                                            },
                                            {
                                                "example_id": "c56c9a2c-cc25-4ec4-9195-0a35042cc64f",
                                                "sense_id": "beae8c7d-1b36-3e88-8f30-a4050f9d6f09",
                                                "text": "„Im Juni fand das unselige Attentat auf den österreichischen Thronfolger statt, dem der Erzherzog und seine Gemahlin zum Opfer fielen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "57dd00e1-b1d4-3f8e-9ace-87bc1b713292",
                                        "entry_id": "5cfeb37e-757c-39e7-b075-dfbd60903326",
                                        "glosses": [
                                            "No glosses available"
                                        ],
                                        "tags": [
                                            "no-gloss"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "81066775-26f4-4bda-87f6-63cd56f7fb51",
                                                "sense_id": "57dd00e1-b1d4-3f8e-9ace-87bc1b713292",
                                                "text": "„Nach dem gescheiterten Attentat vom 20. Juli 1944 gegen Hitler musste Böckler untertauchen, da er Kontakte zum Widerstandskreis um Wilhelm Leuschner hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1d5b7e80-004a-4ae1-92ca-ca04288dbbf5",
                        "source_entry_id": "dd607150-d1b5-3c1e-ad6c-ec200ec0a766",
                        "target_lang_word": "attentat",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "attentat",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "66b7f7c4-de08-338f-914a-462ded9a85d5",
                                        "entry_id": "3367a176-6ef4-39e2-99ac-ab6e98bec7b9",
                                        "glosses": [
                                            "Entreprise criminelle contre les personnes ou les choses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "308e1ca2-2d11-4533-84c4-009489e44c93",
                                                "sense_id": "66b7f7c4-de08-338f-914a-462ded9a85d5",
                                                "text": "Dorénavant, conclut Gilles Malandain, «écrasé par le poids de l’horreur terroriste, l’attentat, après avoir longtemps servi de terme générique, équivalent savant de crime, et susceptible de modulations très diverses, en est venu à désigner spécifiquement une forme de violence très répulsive et injustifiable»."
                                            },
                                            {
                                                "example_id": "b62c894d-4eaf-47b1-bfd6-8df286366049",
                                                "sense_id": "66b7f7c4-de08-338f-914a-462ded9a85d5",
                                                "text": "Il en est de même des victimes des attentats et des exactions qui ont marqué la période qui a suivi les accords d’Évian le 18 mars jusqu’à la déclaration d’indépendance de l’Algérie le 5 juillet, et parfois au-delà."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "43cb8389-a2be-383f-9089-12ae45589210",
                                        "entry_id": "3367a176-6ef4-39e2-99ac-ab6e98bec7b9",
                                        "glosses": [
                                            "Acte qui s’oppose à des droits inscrits dans la loi ou à des principes généralement admis."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b10de68-9d06-4221-a46d-597a8b30371d",
                                                "sense_id": "43cb8389-a2be-383f-9089-12ae45589210",
                                                "text": "C’est un attentat contre nos droits, contre nos privilèges."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "64360d91-7eba-3f61-995a-dafdb1e22edb",
                                        "entry_id": "3367a176-6ef4-39e2-99ac-ab6e98bec7b9",
                                        "glosses": [
                                            "(Par analogie) Acte qui heurte les conventions artistiques, morales, le bon sens, les traditions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "433bd6c2-a9c4-41fe-9953-78ed01ba1fa9",
                                                "sense_id": "64360d91-7eba-3f61-995a-dafdb1e22edb",
                                                "text": "C’est un attentat contre le bon goût."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
