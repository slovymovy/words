                "senses": [
                    {
                        "sense_id": "30a18cae-c0d8-3018-989a-814b1ebf4a69",
                        "entry_id": "849b8783-7b60-3a26-93a1-edcd69d61e3b",
                        "glosses": [
                            "Engaged in piracy or plunder"
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "e54c5785-6775-4e56-9381-0fb91d42a0d7",
                                "sense_id": "30a18cae-c0d8-3018-989a-814b1ebf4a69",
                                "text": "In one respect, as I hinted above, it is only too good, so sure of success, I mean, that you are no longer secure of any respect to your property in our freebooting America."
                            }
                        ]
                    }
                ],
                "translations": [],
