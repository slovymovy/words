                "senses": [
                    {
                        "sense_id": "b8d59400-0912-37cc-a97c-d33e2b4d344b",
                        "entry_id": "3c84dec4-d4d2-3b10-b587-161df54ac8e7",
                        "glosses": [
                            "Dégager des mailles emmêlées."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cc65e3bd-58c0-49e0-8340-94ba2560103d",
                                "sense_id": "b8d59400-0912-37cc-a97c-d33e2b4d344b",
                                "text": "Coincé dans le filet, toutes ailes écartées, et comme un poisson, il essayait de se dégager, mais déjà Gutti l’a saisi délicatement et a commencé à le « désemmailler »."
                            },
                            {
                                "example_id": "d92d87f7-75eb-44b6-8387-60f2ab94181d",
                                "sense_id": "b8d59400-0912-37cc-a97c-d33e2b4d344b",
                                "text": "Sous les mailles du filet il ne retrouvera que les trois alouettes qui s’étaient posées et les “semets” qui battent des ailes. Les gros doigts de Guy ont la précision de ceux d’un pêcheur d’alose à l’instant de “désemmailler” les captives."
                            },
                            {
                                "example_id": "2a00a11a-126d-482f-abf4-bf44a9aa1c57",
                                "sense_id": "b8d59400-0912-37cc-a97c-d33e2b4d344b",
                                "text": "Il y a des familles fermées, imperméables, des frères et des sœurs qui ont eu des enfances si mêlées qu’ils n’ont jamais pu les désemmailler."
                            }
                        ]
                    }
