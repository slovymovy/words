                        "entry_id": "1f9f5418-0158-3d81-9bc4-dac3d6db727b",
                        "glosses": [
                            "To send (someone) an e-mail using Gmail."
                        ],
                        "tags": [
                            "ditransitive",
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "ef7ace42-7b4b-4f7b-b566-9b5f8e45f816",
                                "sense_id": "c7b90a92-adf5-39f1-9204-9a9755cbb1bb",
                                "text": "Gmail me!"
                            },
                            {
                                "example_id": "187b158e-dcfb-4553-a676-17700da2584c",
                                "sense_id": "c7b90a92-adf5-39f1-9204-9a9755cbb1bb",
                                "text": "I Googled my professor and found his home page . . . I Gmailed him my report."
                            }
                        ]
                    }
                ],
