{
    "word_family": [
        "agitate",
        "agitation",
        "agitator",
        "agitative"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "035c1109-87f1-30a4-a4a1-55b6fd337a42",
                    "sense_definition": "Feeling or appearing troubled, nervous, or annoyed.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emotional_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She became increasingly <w>agitated</w> as she waited for the delayed train.",
                            "target_lang_translations": {
                                "ru": "Она становилась все более <w>взволнованной</w>, ожидая задерживающийся поезд."
                            }
                        },
                        {
                            "text": "His <w>agitated</w> state of mind made it difficult for him to focus on the exam.",
                            "target_lang_translations": {
                                "ru": "Его <w>встревоженное</w> душевное состояние мешало ему сосредоточиться на экзамене."
                            }
                        }
                    ],
                    "synonyms": [
                        "anxious",
                        "perturbed",
                        "restless",
                        "worked up"
                    ],
                    "antonyms": [
                        "calm",
                        "relaxed",
                        "serene"
                    ],
                    "common_phrases": [
                        "agitated state of mind",
                        "become increasingly agitated"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чувствующий или выглядящий встревоженным, нервным или раздраженным."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "взволнованный",
                                "target_lang_sense_clarification": "встревоженный, нервничающий"
                            },
                            {
                                "target_lang_word": "возбужденный",
                                "target_lang_sense_clarification": "в состоянии нервного подъема или беспокойства"
                            },
                            {
                                "target_lang_word": "встревоженный",
                                "target_lang_sense_clarification": "обеспокоенный"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "23a44015-327a-3d59-b569-f80832669f59",
                    "sense_definition": "Moving around violently, chaotically, or rapidly, often as a result of being shaken or stirred.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "physical_motion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>agitated</w> water in the washing machine quickly cleaned the dirty clothes.",
                            "target_lang_translations": {
                                "ru": "<w>Бурлящая</w> вода в стиральной машине быстро отстирала грязную одежду."
                            }
                        },
                        {
                            "text": "The chemist observed the <w>agitated</w> liquid as it began to bubble and change color.",
                            "target_lang_translations": {
                                "ru": "Химик наблюдал за <w>взболтанной</w> жидкостью, когда она начала пузыриться и менять цвет."
                            }
                        }
                    ],
                    "synonyms": [
                        "turbulent",
                        "churning",
                        "shaken"
                    ],
                    "antonyms": [
                        "still",
                        "placid"
                    ],
                    "common_phrases": [
                        "agitated liquid",
                        "agitated water"
                    ],
                    "target_lang_definitions": {
                        "ru": "Движущийся бурно, хаотично или быстро, часто в результате встряхивания или перемешивания."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бурлящий",
                                "target_lang_sense_clarification": "о жидкости, находящейся в сильном движении"
                            },
                            {
                                "target_lang_word": "взболтанный",
                                "target_lang_sense_clarification": "подвергшийся перемешиванию или встряхиванию"
                            },
                            {
                                "target_lang_word": "встревоженный",
                                "target_lang_sense_clarification": "о водной поверхности, неспокойный"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c9145e7c-9a30-30f5-862a-64fdbbb5c714",
                    "sense_definition": "Simple past tense and past participle of <w>agitate</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The protesters <w>agitated</w> for better working conditions outside the city hall.",
                            "target_lang_translations": {
                                "ru": "Протестующие <w>агитировали</w> за улучшение условий труда перед зданием ратуши."
                            }
                        },
                        {
                            "text": "He gently <w>agitated</w> the mixture to ensure the powder dissolved completely.",
                            "target_lang_translations": {
                                "ru": "Он аккуратно <w>взбалтывал</w> смесь, чтобы порошок полностью растворился."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense and past participle form"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Форма прошедшего времени и причастие прошедшего времени от глагола agitate (агитировать, будоражить, перемешивать)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "агитировал",
                                "target_lang_sense_clarification": "прошедшее время, призывал к действиям"
                            },
                            {
                                "target_lang_word": "взбалтывал",
                                "target_lang_sense_clarification": "прошедшее время, перемешивал жидкость"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}