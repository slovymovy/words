                                "target_lang_sense_clarification": "persönlicher Leitsatz oder Handlungsregel"
                            },
                            {
                                "target_lang_word": "der Grundsatz",
                                "target_lang_sense_clarification": "feste Handlungsregel, Richtlinie"
                            },
                            {
                                "target_lang_word": "die Richtschnur",
                                "target_lang_sense_clarification": "orientierende Leitlinie"
                            },
                            {
                                "target_lang_word": "die Faustregel",
                                "target_lang_sense_clarification": "vereinfachte, praktische Handlungsregel"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "428e7649-eefb-3378-9746-3aceebe98ab6",
                    "sense_definition": "Een fundamentele grondslag of een algemeen geldend principe.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "regel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De wetenschapper bouwde zijn theorie op een wiskundige <w>stelregel</w>.",
                            "target_lang_translations": {
                                "de": "Der Wissenschaftler baute seine Theorie auf einem mathematischen <w>Lehrsatz</w> auf."
                            }
                        },
                        {
                            "text": "Deze juridische <w>stelregel</w> vormt de basis van het huidige procesrecht.",
                            "target_lang_translations": {
                                "de": "Dieser juristische <w>Grundsatz</w> bildet die Basis des heutigen Prozessrechts."
                            }
                        }
                    ],
                    "synonyms": [
                        "beginsel",
                        "fundament",
                        "grondslag",
                        "principe"
                    ],
                    "target_lang_definitions": {
                        "de": "Eine grundlegende Basis oder ein allgemein gültiges Prinzip (z. B. in Wissenschaft oder Recht)."
                    },
                    "translations": {
