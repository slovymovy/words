                "senses": [
                    {
                        "sense_id": "230f4de2-ef9b-3740-ad96-30c84fd9ed76",
                        "entry_id": "5ee4f9b5-9a1c-397d-a28e-1155c7ad3afc",
                        "glosses": [
                            "An act of disrespect or impiety towards something considered sacred."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "d82af0fa-69c6-495c-9861-e931b9531a17",
                                "sense_id": "230f4de2-ef9b-3740-ad96-30c84fd9ed76",
                                "text": "It seemed a desecration and an unhallowed thing to touch that sleeping image of the live man by my side."
                            },
                            {
                                "example_id": "892df796-fe70-4f15-9fc4-5704fca644b9",
                                "sense_id": "230f4de2-ef9b-3740-ad96-30c84fd9ed76",
                                "text": "In the same year as the Furness objection, sadder tidings befell St Pancras Priory at Lewes, in East Sussex. Despite it having the distinction of being the earliest Cluniac monastery in Great Britain, petitions to prevent the Brighton Lewes & Hastings Railway from imposing on its site with its Lewes line failed. The line was approved and, as if as an act of deliberate desecration and assertion of the railways' power, passed over the site of the high altar."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ca47bb54-784f-4e8e-bf61-9c046d1245e9",
                        "source_entry_id": "5ee4f9b5-9a1c-397d-a28e-1155c7ad3afc",
                        "source_sense_id": "230f4de2-ef9b-3740-ad96-30c84fd9ed76",
