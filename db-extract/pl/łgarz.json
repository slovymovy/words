                ],
                "senses": [
                    {
                        "sense_id": "1826e683-3034-3288-804c-41f13e18aca2",
                        "entry_id": "632eedfe-d31c-36f0-8eec-85a9d8fb6260",
                        "glosses": [
                            "osoba, która łże"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e9a28dff-386d-4b33-b693-f7f8da77b020",
                                "sense_id": "1826e683-3034-3288-804c-41f13e18aca2",
                                "text": "Po tym, jak po raz drugi przyłapano Józefa na kłamstwie, przylgnęła do niego opinia łgarza."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e2639679-dce9-469a-9bdc-1a6678416237",
                        "source_entry_id": "632eedfe-d31c-36f0-8eec-85a9d8fb6260",
                        "source_sense_id": "1826e683-3034-3288-804c-41f13e18aca2",
                        "target_lang_word": "lhář",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lhář",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "2628c074-1e2e-3337-821e-f19e665c14b5",
                                        "entry_id": "961f101c-7eb8-3541-ab05-58c632f7d70e",
                                        "glosses": [
                                            "kdo záměrně říká něco, o čem se domnívá, že je to nepravda"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "90cf00e1-22e2-469d-bf92-5270cf162845",
                                                "sense_id": "2628c074-1e2e-3337-821e-f19e665c14b5",
                                                "text": "Po celou dobu byl vězněn ve stejných podmínkách jako ostatní vězni a žádné úlevy nebo výhody oproti nim neměl. Nabídku na emigraci a propuštění odmítl. Klapání psacího stroje a údajný asistent jsou jen v hlavách lhářů, kteří nesnesou pomyšlení, že Václav Havel ve svých životních zkouškách obstál. Psací stroj a asistent mohou být pomníkem lidské nízkosti a také ničemnosti lživých kampaní, jejichž cílem je zamíchat do jedné šedivé kaše všechny. Hrdiny, zbabělce a nuly."
                                            },
                                            {
                                                "example_id": "fe2b8214-022e-430c-9765-72927ecc2e4d",
                                                "sense_id": "2628c074-1e2e-3337-821e-f19e665c14b5",
                                                "text": "Já mu žita vyprodala, ozim i tu jař, nakoupila kanafasu, a ten žid byl lhář."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9a09f7af-0d15-41fb-85e9-4530fbef6ec2",
                        "source_entry_id": "632eedfe-d31c-36f0-8eec-85a9d8fb6260",
                        "source_sense_id": "1826e683-3034-3288-804c-41f13e18aca2",
                        "target_lang_word": "лгун",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "лгун",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "cc7e4881-92bd-3632-a18a-afddce390e0e",
                                        "entry_id": "92756009-dcd1-3773-9604-e9771f33a6d5",
                                        "glosses": [
                                            "тот, кто лжёт, говорит неправду"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1bcb0dcb-e122-4f97-8eca-b830ccadc851",
                                                "sense_id": "cc7e4881-92bd-3632-a18a-afddce390e0e",
                                                "text": "Вот как я стал лгуном."
                                            },
                                            {
                                                "example_id": "7dc5fa6c-1075-4321-ae14-18f239754ce5",
                                                "sense_id": "cc7e4881-92bd-3632-a18a-afddce390e0e",
                                                "text": "Он был невежествен без границ, сутяга, лгун, пустослов и, в довершение всего, боялся черта"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ba89f8b1-4722-4e56-9f23-47ba2d08d8e3",
                        "source_entry_id": "632eedfe-d31c-36f0-8eec-85a9d8fb6260",
                        "source_sense_id": "1826e683-3034-3288-804c-41f13e18aca2",
                        "target_lang_word": "лжец",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "лжец",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "017f4cca-5386-3d2b-b725-c0a2aa1c50e0",
                                        "entry_id": "b6e02713-89cf-3aba-a3ef-933e39ad8498",
                                        "glosses": [
                                            "тот, кто говорит неправду, лжёт"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2bd19d4e-6a80-4095-93cc-90e2855e6794",
                                                "sense_id": "017f4cca-5386-3d2b-b725-c0a2aa1c50e0",
                                                "text": "— Вы считаете меня лжецом? — Я вас не считаю лжецом, но вас просто ограбили."
                                            },
                                            {
                                                "example_id": "a7b20844-d1b4-4bde-97c1-aeb9133ffe7e",
                                                "sense_id": "017f4cca-5386-3d2b-b725-c0a2aa1c50e0",
                                                "text": "А он талантливейший лжец… Не лгун, — думаю, — а лжец."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
