        "fr-extract.jsonl": [
            {
                "entry_id": "158d8683-ce28-3369-9247-8ad7058f6f7d",
                "word": "irruption",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "3fd31b6f-3b2b-4ce2-9253-33dd6ce6f900",
                        "entry_id": "158d8683-ce28-3369-9247-8ad7058f6f7d",
                        "tags": [
                            "plural"
                        ],
                        "form": "irruptions"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8768bb74-22ce-321e-a7c6-0d2983b9f64e",
                        "entry_id": "158d8683-ce28-3369-9247-8ad7058f6f7d",
                        "glosses": [
                            "Entrée soudaine et imprévue des ennemis dans un pays, ordinairement accompagnée de dégât et de ravage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0cad396c-58b4-4e5c-bed3-f040cb0e7d67",
                                "sense_id": "8768bb74-22ce-321e-a7c6-0d2983b9f64e",
                                "text": "Au reste c'est sans aucune preuve qu'un historien moderne avance, que le prince de Galles dans cette irruption s'avança jusqu'à Fabregues auprès de Montpellier, qu'il tenta le sìége de Beziers, qu'il fit brèche aux murailles."
                            },
                            {
                                "example_id": "56a1573a-6d5a-420d-837a-cbaaa3d8d1f0",
                                "sense_id": "8768bb74-22ce-321e-a7c6-0d2983b9f64e",
                                "text": "Thêophane semble rapporter à ce tems-ci une irruption des Arabes sur les terres de l'Empire, dans laquelle ils pénétrèrent jusqu'à Amorium en Phrygie avec des forces considérables."
                            },
                            {
                                "example_id": "3a6979e4-45fd-4fa3-bae3-8d6d36ade904",
                                "sense_id": "8768bb74-22ce-321e-a7c6-0d2983b9f64e",
                                "text": "La soudaine irruption d’un ennemi prêt à l’offensive n’eut d’autre effet immédiat sur New York que d’accroître sa véhémence habituelle."
                            }
                        ]
                    },
                    {
                        "sense_id": "73b9593b-9e06-3f8c-ba4e-4ab3b01cf05f",
                        "entry_id": "158d8683-ce28-3369-9247-8ad7058f6f7d",
                        "glosses": [
                            "Toute entrée ou intrusion brusque, inattendue ou malvenue."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "2a1e9962-e207-407d-94db-548fc8b5cbe9",
                                "sense_id": "73b9593b-9e06-3f8c-ba4e-4ab3b01cf05f",
                                "text": "L'assureur n'avait pas compris ce qui avait provoqué l’irruption de l'énergumène, mais commençait à s'en douter. Une basse vengeance du député sans doute !"
                            }
                        ]
                    },
                    {
                        "sense_id": "c127b33a-9cde-35ea-96ed-26dd284e3dcb",
                        "entry_id": "158d8683-ce28-3369-9247-8ad7058f6f7d",
                        "glosses": [
                            "Débordement, envahissement de la mer, d’un fleuve sur les terres."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "072913f1-d2ea-4b40-8616-2f6e44160df1",
                                "sense_id": "c127b33a-9cde-35ea-96ed-26dd284e3dcb",
                                "text": "Il est vrai qu'il fait mention d'une irruption violente, des eaux de la mer dont Harlem & l'Ecluse, villes de Hollande furent submergées ; mais outre que cette irruption précéda de deux mois, elle ne fut pas accompagnée de tremblement ; & si i'inondation fut l'effet d'une explosion, ce qui est vraisemblable, cette explosion se fit dans la mer."
                            }
                        ]
                    },
                    {
                        "sense_id": "bfc8ee6a-8cf9-34a2-9425-8f6bca686c1b",
                        "entry_id": "158d8683-ce28-3369-9247-8ad7058f6f7d",
                        "glosses": [
                            "Arrivée massive, invasion d'oiseaux hors de leur aire de répartition habituelle."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "4baed6c7-27b7-45ba-85a9-7a0c5d3dbc86",
                                "sense_id": "bfc8ee6a-8cf9-34a2-9425-8f6bca686c1b",
                                "text": "Dans ces conditions, d’aucuns ont pu juger surprenant que l'apparition de Mouettes tridactyles dans la région parisienne en février dernier nous ait incité à une enquête détaillée : mais en fait l’irruption de février 1957 présente des modalités qui la distinguent des cas d’erratisme hivernal notés habituellement çà et là."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "94f74650-e4bb-41be-98b6-39d57dfecf0f",
                        "source_entry_id": "158d8683-ce28-3369-9247-8ad7058f6f7d",
