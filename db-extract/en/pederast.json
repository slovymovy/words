                                            {
                                                "example_id": "2d48640a-1ef9-4af8-b040-71e7482dbe6e",
                                                "sense_id": "ba3f7f01-4caa-3061-9157-834027299405",
                                                "text": "Zatímco klasický pedofil bývá často pederast, což znamená, že se zajímá o chlapečky, projevuje druhý typ větší zájem o děvčata."
                                            },
                                            {
                                                "example_id": "80596942-8918-40f8-8e73-367f7f2f9f34",
                                                "sense_id": "ba3f7f01-4caa-3061-9157-834027299405",
                                                "text": "Peníze od strany v té době dostával i tak zvaný Svaz homosexuálů, pederastů a transvestitů, který požadoval zrušení věkového limitu pro pohlavní styk. „Když se pak Zelení profesionalizovali a dostali do parlamentu, prozkoumali znovu přihlášky a pederasti byli ze strany vypuzeni,“ vysvětluje spoluzakladatel Zelených Ludger Volmer."
                                            },
                                            {
                                                "example_id": "7aecca48-c6b1-49a8-af40-6dfb2353db4f",
                                                "sense_id": "ba3f7f01-4caa-3061-9157-834027299405",
                                                "text": "Zbyněk se nám cestou svěřil, s jakými rozpaky si den předtím znovu přečetl kultovní knihu o Bobří řece. „On to je, hoši, tak trochu návod pro pederasta,“ stěžoval si."
                                            },
                                            {
                                                "example_id": "cb6f9419-6030-4d9e-856f-0c775cbdf7b5",
                                                "sense_id": "ba3f7f01-4caa-3061-9157-834027299405",
                                                "text": "Co to šustí, co to chrastí?/ Z houští lezou pederasti./ Znásilnili za lesem/ tajemníka SSM."
                                            },
                                            {
                                                "example_id": "8d77cbd8-6d38-4e2c-9eb9-2ceb9321b14f",
                                                "sense_id": "ba3f7f01-4caa-3061-9157-834027299405",
                                                "text": "Zazněly i další urážky jako „Pederasti“ nebo „Vrazi“."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
