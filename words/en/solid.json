                            },
                            {
                                "target_lang_word": "单色",
                                "target_lang_sense_clarification": "无花纹"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8c59f888-b5e0-3e80-a98c-e685395bf699",
                    "sense_definition": "Large or significant in amount, size, or value.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "quantity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company reported a <w>solid</w> amount of profit this quarter.",
                            "target_lang_translations": {
                                "ru": "Компания отчиталась о <w>солидной</w> прибыли в этом квартале.",
                                "tr": "Şirket bu çeyrekte <w>kayda değer</w> miktarda kâr bildirdi.",
                                "zh": "公司本季度报告了<w>可观</w>的利润。"
                            }
                        },
                        {
                            "text": "He spent a <w>solid</w> hour cleaning the kitchen.",
                            "target_lang_translations": {
                                "ru": "Он потратил <w>целый</w> час на уборку кухни.",
                                "tr": "Mutfağı temizlemek için <w>tam</w> bir saat harcadı.",
                                "zh": "他花了<w>整整</w>一个小时打扫厨房。"
                            }
                        }
