                    {
                        "sense_id": "95927563-76a5-39a8-9507-6fb42d3a77ff",
                        "entry_id": "aa2ef0b3-5784-3e6b-8e3b-2b9636885b95",
                        "glosses": [
                            "Relatif aux relations."
