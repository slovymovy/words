                        ],
                        "examples": [
                            {
                                "example_id": "72c57a7e-e950-4b05-8fa0-e86f7e5cad2b",
                                "sense_id": "0c1fa4cb-3122-39f1-aca2-636551da9789",
                                "text": "Przed Łukaszowym domem rosną rosochate orzechy."
                            },
                            {
                                "example_id": "1fde7296-34ef-49ab-abea-117690881b2a",
                                "sense_id": "0c1fa4cb-3122-39f1-aca2-636551da9789",
                                "text": "W opisie bogacza z Łukaszowej przypowieści uderza to, że jest on całkowicie skupiony na sobie"
                            },
                            {
                                "example_id": "68a7b9c1-bb63-4fac-9c22-9489317e8da7",
                                "sense_id": "0c1fa4cb-3122-39f1-aca2-636551da9789",
                                "text": "Sąsiadował z Mateuszową zagrodą z jednej strony i z Łukaszowym polem z drugiej."
                            },
                            {
                                "example_id": "6055023c-c07d-450f-a052-d7f328fa7a70",
                                "sense_id": "0c1fa4cb-3122-39f1-aca2-636551da9789",
                                "text": "Łukaszowi synowie wyrośli na dorodnych mężczyzn."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
