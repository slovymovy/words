                "senses": [
                    {
                        "sense_id": "0fe8a8cf-890c-3572-a424-6940ada02038",
                        "entry_id": "e7c3fde1-c76a-3931-8e94-3c8c83daf1be",
                        "glosses": [
                            "Talocher à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df1a3402-e201-4706-8990-3e8f7753eb61",
                                "sense_id": "0fe8a8cf-890c-3572-a424-6940ada02038",
                                "text": "De plus, une fois le coffrage glissant levé, le béton doit être encore maniable tout du moins à sa surface, pour pouvoir venir retalocher celle-ci et ainsi boucher et refermer les inclusions ou pores créés par une éventuelle accroche au coffrage."
                            },
                            {
                                "example_id": "1e8e3cb2-3853-473d-89c5-0c0d3f62444e",
                                "sense_id": "0fe8a8cf-890c-3572-a424-6940ada02038",
                                "text": "Talocher, lisser... attendre un peu retalocher, relisser... je le faisais 3 fois."
                            },
                            {
                                "example_id": "c2e7734d-01c6-4766-aed6-020b68460b3e",
                                "sense_id": "0fe8a8cf-890c-3572-a424-6940ada02038",
                                "text": "J'y suis revenu quelques heures après pour retalocher, mais c'était pire que mieux."
                            }
                        ]
                    }
                ],
