                "senses": [
                    {
                        "sense_id": "54b046e8-fff5-3ef0-be3b-fa71e1730838",
                        "entry_id": "ce465a90-62c3-3b0d-9ad0-90af35f4b1d1",
                        "glosses": [
                            "niewielkie urządzenie przenośne podłączane do komputera poprzez port USB, zawierające pamięć trwałą"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "588db3a4-8aec-4a63-84ea-b7c7033a3ea6",
                                "sense_id": "54b046e8-fff5-3ef0-be3b-fa71e1730838",
                                "text": "Zapomniałam pendrive'a z moim projektem."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0321fb92-f7ac-478b-b42c-d7f359ee7a79",
                        "source_entry_id": "ce465a90-62c3-3b0d-9ad0-90af35f4b1d1",
                        "source_sense_id": "54b046e8-fff5-3ef0-be3b-fa71e1730838",
                        "target_lang_word": "pen drive",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pen drive",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "166854fb-54b3-3505-bfc6-4eb2f1b354ee",
                                        "entry_id": "8c33eb3a-eb37-348c-aee4-d1a56c13db8e",
                                        "glosses": [
                                            "A small electronic device used to store digital data, more portable and robust than a hard drive; a flash drive."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5acf09d0-937b-4ecd-87fe-7912d3086ab1",
                                                "sense_id": "166854fb-54b3-3505-bfc6-4eb2f1b354ee",
                                                "text": "After Peter finished checking the operating system setup, he carefully unscrewed his pen drive and plugged the USB connection into the computer."
                                            },
                                            {
                                                "example_id": "7d3f0765-8abd-459b-9869-c7c307c1b615",
                                                "sense_id": "166854fb-54b3-3505-bfc6-4eb2f1b354ee",
                                                "text": "So if you find yourself trapped in a pendrive/thumbdrive industry where everyone is basically making the same thing and copying patents whilst dishing out discounts, it's time to move on and separate yourself via a new identity."
                                            },
                                            {
                                                "example_id": "b8f70f84-1629-4bf8-8329-33a3f2335389",
                                                "sense_id": "166854fb-54b3-3505-bfc6-4eb2f1b354ee",
                                                "text": "Pen drives have replaced the old floppy disks as the modern way to physically transport files from one computer to another. Yes, you can always email a file or burn it to a CD or DVD disc, but sometimes you just want to carry a copy of a file with you, and pen drives are so easy to use. You simply plug it into the USB port, and Windows treats it as just another storage location."
                                            },
                                            {
                                                "example_id": "5049fbd9-6d74-49a7-bd21-11988ea1ab4a",
                                                "sense_id": "166854fb-54b3-3505-bfc6-4eb2f1b354ee",
                                                "text": "‘What the fuck is this?’ Sen examined and almost laughed upon recognizing it. ‘A pendrive! A fucking pendrive! That's what the planter calls a bomb? Is he fucking kidding me?’"
                                            },
                                            {
                                                "example_id": "6f92c26d-f3cf-4c02-bf70-306d5d49f1e9",
                                                "sense_id": "166854fb-54b3-3505-bfc6-4eb2f1b354ee",
                                                "text": "“If you don't mind, please give us the details in this pendrive,” I said, looking at his bald head."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
