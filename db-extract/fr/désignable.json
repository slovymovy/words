                        "entry_id": "e54e005c-b7b7-3ca8-a261-ccbb9217ee65",
                        "glosses": [
                            "Que l’on peut désigner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c50a1b4f-2f70-4270-bdfe-df6b79b37fed",
                                "sense_id": "e3b74bce-39ee-3c5c-9cec-cd3a73089c06",
                                "text": "De même qu’il n’y a pas sur le sol de la terre un lieu désignable comme le paradis, de même il n’y a, dans l’organisation d’une psychologie humaine, aucun lieu particulier qui soit désignable comme celui de la vérité."
                            },
                            {
                                "example_id": "024dd6f3-9dc0-4437-8cfa-b0260fafe914",
                                "sense_id": "e3b74bce-39ee-3c5c-9cec-cd3a73089c06",
                                "text": "Le mystère de l’image, ce qui en elle n’est ni désigné ni désignable par le commentaire, pointe vers le mystère de la religion."
                            },
                            {
                                "example_id": "4f5ce336-7d64-41c0-bec6-6861093c52dd",
                                "sense_id": "e3b74bce-39ee-3c5c-9cec-cd3a73089c06",
                                "text": "La pénurie d’arbitres est un souci, avec seulement 346 arbitres dont 240 désignables."
                            }
                        ]
                    }
