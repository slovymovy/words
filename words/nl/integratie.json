            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9c650964-552b-344a-b1aa-474d4e42f1e3",
                    "sense_definition": "Het proces waarbij verschillende bevolkingsgroepen samengaan in een samenleving.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "sociale_integratie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>integratie</w> van nieuwkomers in de Nederlandse maatschappij kost vaak veel tijd en moeite.",
                            "target_lang_translations": {
                                "en": "The <w>integration</w> of newcomers into Dutch society often takes a lot of time and effort."
                            }
                        },
                        {
                            "text": "Een goede beheersing van de taal is essentieel voor een succesvolle <w>integratie</w> in de buurt.",
                            "target_lang_translations": {
                                "en": "A good command of the language is essential for successful <w>integration</w> into the neighborhood."
                            }
                        }
                    ],
                    "synonyms": [
                        "inburgering",
                        "assimilatie"
                    ],
                    "antonyms": [
                        "segregatie",
                        "uitsluiting"
                    ],
                    "common_phrases": [
                        "succesvolle integratie",
                        "maatschappelijke integratie"
                    ],
                    "target_lang_definitions": {
                        "en": "The process by which different population groups merge into a society."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "integration",
                                "target_lang_sense_clarification": "social and community fitting"
                            },
                            {
                                "target_lang_word": "inclusion",
                                "target_lang_sense_clarification": "the act of including people in a group"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0422dc1f-d93d-346a-a255-ec011d475583",
                    "sense_definition": "Het samenvoegen van verschillende onderdelen tot één harmonieus geheel.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "samenvoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>integratie</w> van wonen en zorg in dit nieuwe gebouw is een groot succes.",
                            "target_lang_translations": {
                                "en": "The <w>integration</w> of housing and care in this new building is a great success."
                            }
                        },
                        {
                            "text": "Bij dit project draait alles om de volledige <w>integratie</w> van verschillende technieken.",
                            "target_lang_translations": {
                                "en": "This project is all about the full <w>integration</w> of different techniques."
                            }
                        }
                    ],
                    "synonyms": [
