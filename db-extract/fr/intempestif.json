                                        ]
                                    },
                                    {
                                        "sense_id": "477a0d0b-a39d-3fab-a46c-40d1d59be412",
                                        "entry_id": "9be7a671-363e-34d8-88f3-535bdc0dcc48",
                                        "glosses": [
                                            "Early; premature."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11cef776-b92e-424f-aa9a-d424c82cee57",
                                                "sense_id": "477a0d0b-a39d-3fab-a46c-40d1d59be412",
                                                "text": "an untimely death"
                                            },
                                            {
                                                "example_id": "6a9b47c7-b01e-4146-b916-fb136e765f16",
                                                "sense_id": "477a0d0b-a39d-3fab-a46c-40d1d59be412",
                                                "text": "The heroes of literary as well as civil history have been very often no less remarkable for what they have suffered, than for what they have atchieved^([sic]); and volumes have been written only to enumerate the miseries of the learned, and relate their unhappy lives, and untimely deaths."
                                            },
                                            {
                                                "example_id": "a4623517-0bcf-45e8-9841-89ffd37b9f39",
                                                "sense_id": "477a0d0b-a39d-3fab-a46c-40d1d59be412",
                                                "text": "Untimely blossom! Poor, impatient thing, / ⁠That, starting rashly from the sheltering mould, / ⁠Bravest the peevish wind and sullen cold, / ⁠Mistaking thine own ardors for the spring"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "untimely",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8ad51616-9769-3eb2-9c46-a3b9eca7dbc5",
                                        "entry_id": "e36e185d-52c0-3115-84a8-d7429824642a",
                                        "glosses": [
                                            "Prematurely."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5a813948-e7c1-45ab-bf69-7695042cf898",
                                                "sense_id": "8ad51616-9769-3eb2-9c46-a3b9eca7dbc5",
                                                "text": "Tell thee, Macduffe was from his Mothers womb / Untimely ript."
                                            },
                                            {
                                                "example_id": "1cda3c31-c8c0-4180-a134-cf435a5c7e7c",
                                                "sense_id": "8ad51616-9769-3eb2-9c46-a3b9eca7dbc5",
                                                "text": "They light fires under fruit trees to keep the fruit from falling untimely."
                                            },
                                            {
                                                "example_id": "0910462f-692e-4012-ba92-3f827001d11b",
                                                "sense_id": "8ad51616-9769-3eb2-9c46-a3b9eca7dbc5",
                                                "text": "Couldst thou go from us, in thy beauteous June, / Leaving a sense of joy untimely perished, / ⁠Of music stilled too soon?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
