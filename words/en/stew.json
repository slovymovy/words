                    "common_phrases": [
                        "in a stew"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in the phrase 'in a stew'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние сильного волнения, беспокойства или замешательства.",
                        "zh": "处于一种焦虑、担忧或混乱的状态。"
                    },
                    "translations": {
