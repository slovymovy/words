                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13db59ed-f9c0-4b9b-8281-71a75016ddfc",
                                                "sense_id": "d0a43323-6139-3545-8e45-465c23fce1b9",
                                                "text": "Petruchio.Good morrow, Kate; for that's your name, I hear.\nKatharina.Well have you heard, but something hard of hearing:\nThey call me Katharine that do talk of me."
                                            }
                                        ]
                                    }
                                ]
