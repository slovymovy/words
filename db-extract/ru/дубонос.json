                "senses": [
                    {
                        "sense_id": "5c077e5b-edde-30b2-ae66-00935839c7ed",
                        "entry_id": "86b8f992-af30-3d3b-9f40-9391accb99a2",
                        "glosses": [
                            "орнитол. зерноядная птица (Coccothraustes)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a1624310-81f4-4c4d-9463-4f020e99d750",
                                "sense_id": "5c077e5b-edde-30b2-ae66-00935839c7ed",
                                "text": "Мы вместе когда-то, в осеннее время, ловили щеглов, чижей и дубоносов и продавали их на базаре рано утром, когда еще наши родители спали."
                            },
                            {
                                "example_id": "fd3ef5bc-912c-4bee-a1e7-78e9e45bbb23",
                                "sense_id": "5c077e5b-edde-30b2-ae66-00935839c7ed",
                                "text": "В клетке над дверью дремал на жёрдочке дубонос, мокропёрый, бесхвостый, нахохленный."
                            }
                        ]
                    }
                ],
