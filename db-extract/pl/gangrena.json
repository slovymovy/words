                                        "sense_id": "436a3542-c14d-367e-a2e5-c8d1af5bf55c",
                                        "entry_id": "2322ce6c-9841-3cd6-a434-558976c60849",
                                        "glosses": [
                                            "Muerte de un tejido producida por la falta de circulación del flujo sanguíneo."
                                        ],
