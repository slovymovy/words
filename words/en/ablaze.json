                },
                {
                    "sense_id": "6448bc9d-b48a-3f10-a0bf-cff1031e2686",
                    "sense_definition": "Filled or radiant with bright light or vibrant color.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the middle of autumn, the park is <w>ablaze</w> with vibrant red and gold leaves.",
                            "target_lang_translations": {
                                "ru": "В середине осени парк <w>пламенеет</w> яркими красными и золотыми листьями."
                            }
                        },
                        {
                            "text": "The city center was <w>ablaze</w> with colorful holiday lights.",
                            "target_lang_translations": {
                                "ru": "Центр города <w>сверкал</w> разноцветными праздничными огнями."
                            }
                        }
                    ],
                    "synonyms": [
                        "aflame"
                    ],
                    "common_phrases": [
                        "ablaze with light",
                        "ablaze with color"
                    ],
                    "target_lang_definitions": {
                        "ru": "Залитый ярким светом или наполненный сиянием насыщенных, ярких красок."
