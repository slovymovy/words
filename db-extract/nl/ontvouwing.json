                    {
                        "sense_id": "34faa9ee-21e0-3969-938e-fb06486f6baa",
                        "entry_id": "ffd09be9-a886-3e32-9de7-3cd4dfc08b64",
                        "glosses": [
                            "het openvouwen van een opgevouwen voorwerp"
