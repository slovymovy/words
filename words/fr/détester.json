    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8125ea48-dd2d-3210-974e-467ddd49b20e",
                    "sense_definition": "Éprouver un vif dégoût ou un déplaisir marqué envers quelque chose ; ne pas aimer du tout.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "sentiment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je <w>déteste</w> faire la queue pendant des heures au supermarché."
                        },
                        {
                            "text": "Mon frère <w>déteste</w> le café sans sucre et préfère toujours le thé."
                        }
                    ],
                    "antonyms": [
                        "apprécier",
                        "supporter"
                    ],
                    "common_phrases": [
                        "détester faire la queue",
                        "ne pas détester"
                    ]
                },
                {
                    "sense_id": "a16a4508-ff04-36fc-925f-feba36dfc9ec",
                    "sense_definition": "Ressentir une aversion profonde ou de l'hostilité envers une personne ; haïr.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "sentiment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les deux rivaux se <w>détestent</w> depuis leur première rencontre au lycée."
                        },
                        {
                            "text": "Ce politicien a fini par se faire <w>détester</w> de tous ses collègues."
                        }
                    ],
                    "synonyms": [
                        "haïr",
                        "abhorrer"
                    ],
                    "antonyms": [
                        "aimer"
                    ],
                    "common_phrases": [
                        "se faire détester"
                    ]
                },
                {
                    "sense_id": "b86929e6-ed50-3c1c-9f9c-8ebf2f20e56e",
                    "sense_definition": "Vouer à l'exécration par des imprécations ; maudire solennellement.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans son sermon, le prédicateur <w>détesta</w> les crimes odieux des impies."
                        },
                        {
                            "text": "Le vieillard mourant <w>détesta</w> les injustices qui avaient ruiné sa patrie."
