                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "gram",
                                "target_lang_sense_clarification": "unit of mass"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f545f367-8de9-3e2b-95dc-334da2a6c27d",
                    "sense_definition": "Een gevoel van diepe boosheid of verontwaardiging.",
