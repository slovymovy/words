    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9e3620c8-65d5-32d2-8cf7-969d4f7bdbc4",
                    "sense_definition": "Either of the two fleshy halves of the buttocks that form the lower back part of the human body.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He landed hard on his right <w>buttock</w> after slipping on the ice.",
                            "target_lang_translations": {
                                "zh": "他在冰上滑倒后，右侧<w>臀部</w>重重地着了地。"
                            }
                        },
                        {
                            "text": "She felt a sudden cramp in her left <w>buttock</w> during the run.",
                            "target_lang_translations": {
                                "zh": "她在跑步时感到左侧<w>臀部</w>突然抽筋。"
                            }
                        }
                    ],
                    "synonyms": [
                        "cheek"
                    ],
                    "common_phrases": [
                        "left buttock",
                        "right buttock"
                    ],
                    "target_lang_definitions": {
                        "zh": "人体后部下方的两块肌肉组织，即臀部。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "臀部",
                                "target_lang_sense_clarification": "指人体后部下方的部位，较为正式。"
                            },
                            {
                                "target_lang_word": "屁股",
                                "target_lang_sense_clarification": "指人体后部下方的部位，口语中常用。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5ffbfbce-1723-36ba-ac9d-27d69e313eec",
                    "sense_definition": "The rounded overhang of a ship's hull above the waterline toward the stern.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The waves slapped hard against the ship's <w>buttock</w> as it left the harbor.",
                            "target_lang_translations": {
                                "zh": "当船只离开港口时，海浪猛烈地拍打着<w>船尾外壳</w>。"
                            }
                        },
                        {
                            "text": "Inspectors examined the damage to the stern and the ship's <w>buttock</w>.",
                            "target_lang_translations": {
                                "zh": "检查员查看了船尾和<w>船尾外壳</w>的受损情况。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "船体水线以上、靠近船尾的圆弧形外壳部分。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "船尾外壳",
                                "target_lang_sense_clarification": "指船体后部靠近水线以上的结构。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}