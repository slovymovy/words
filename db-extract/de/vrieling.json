                "senses": [
                    {
                        "sense_id": "f16b7772-ee3a-3f19-9cf7-e2d3a497b9f4",
                        "entry_id": "33db09a8-5b62-3df3-a0c5-777c0de6ff97",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c449237-2a50-4954-a794-fe9ec96f3497",
                                "sense_id": "f16b7772-ee3a-3f19-9cf7-e2d3a497b9f4",
                                "text": "Der Vrieling trägt nie die Schals, die die Vrieling ihm strickt."
                            },
                            {
                                "example_id": "b7d97acb-92a3-4fe2-a707-a103e9b3b4bc",
                                "sense_id": "f16b7772-ee3a-3f19-9cf7-e2d3a497b9f4",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Vrieling kommt, geht der Herr Vrieling.“"
                            },
                            {
                                "example_id": "53a88c90-968b-477b-bb57-329eb9c10730",
                                "sense_id": "f16b7772-ee3a-3f19-9cf7-e2d3a497b9f4",
                                "text": "Vrieling kommt und geht."
                            },
                            {
                                "example_id": "0661042c-e496-4382-8d52-d104f9375614",
                                "sense_id": "f16b7772-ee3a-3f19-9cf7-e2d3a497b9f4",
                                "text": "Vrielings kamen, sahen und siegten."
                            },
                            {
                                "example_id": "79db2bf4-1e71-432f-ac8c-ffac4c560ccb",
                                "sense_id": "f16b7772-ee3a-3f19-9cf7-e2d3a497b9f4",
                                "text": "Die Vrielings fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "22a10547-189b-479d-8ab4-8bfc41d4f925",
                                "sense_id": "f16b7772-ee3a-3f19-9cf7-e2d3a497b9f4",
                                "text": "Frau Vrieling ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "47e46e5c-1c0f-4310-950b-ef2c3aac6a5c",
                                "sense_id": "f16b7772-ee3a-3f19-9cf7-e2d3a497b9f4",
                                "text": "Herr Vrieling wollte uns kein Interview geben."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
