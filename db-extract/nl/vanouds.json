                "senses": [
                    {
                        "sense_id": "3162043a-b49b-3c11-a7ef-ec752da84c3b",
                        "entry_id": "7bbd87b8-3fe8-3c4b-bee7-94421960d0f2",
                        "glosses": [
                            "traditioneel gesproken; sinds zeer lange tijd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "83191a10-94fd-4a4b-a5ea-bc1c697c7167",
                                "sense_id": "3162043a-b49b-3c11-a7ef-ec752da84c3b",
                                "text": "En de volgende dag ging het werk weer als vanouds."
                            },
                            {
                                "example_id": "8c8a0bf1-14e3-4017-a6f3-ca7a64847672",
                                "sense_id": "3162043a-b49b-3c11-a7ef-ec752da84c3b",
                                "text": "In sommige plaatsen zoals Siddeburen is het vanouds het gebruik op oudjaarsavond de 'klok te smeren'; de kerkklok wordt dan vele uren zonder ophouden geluid."
                            },
                            {
                                "example_id": "23388720-0537-459d-a899-288696b6340e",
                                "sense_id": "3162043a-b49b-3c11-a7ef-ec752da84c3b",
                                "text": "Start en finish van de toertocht waren als vanouds op het terrein van PH aan de Veenelandenweg."
                            },
                            {
                                "example_id": "e8e2c103-b917-4cfb-b9aa-cccb31edcc9d",
                                "sense_id": "3162043a-b49b-3c11-a7ef-ec752da84c3b",
                                "text": "Ik begon de schoonheid om mij heen weer te zien en de prachtige uitzichten te waarderen en bijna als vanouds sprong ik in elk meertje dat ik tegenkwam."
                            }
                        ]
                    }
                ],
