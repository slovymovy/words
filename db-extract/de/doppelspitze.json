                ],
                "senses": [
                    {
                        "sense_id": "f6057f9d-70b2-3941-af62-cae96fb535ac",
                        "entry_id": "40848784-baba-3235-bf7e-de9059ed1af7",
                        "glosses": [
                            "Führung einer Organisation durch zwei Personen; in Deutschland bekannt sind Beispiele"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3aeca601-dad8-40b6-a47c-65ecd5b8c865",
                                "sense_id": "f6057f9d-70b2-3941-af62-cae96fb535ac",
                                "text": "Eine Doppelspitze kann gut funktionieren, wenn die Aufgaben klar aufgeteilt sind."
                            },
                            {
                                "example_id": "5cd43e17-7afe-46f2-b143-1c38b16c4c53",
                                "sense_id": "f6057f9d-70b2-3941-af62-cae96fb535ac",
                                "text": "„Obwohl die Doppelspitze aus Saskia Esken und Norbert Walter-Borjans sich seitdem häufig politisch zu Wort gemeldet hat, sind beide in der Bevölkerung noch weitgehend unbekannt.“"
                            },
                            {
                                "example_id": "ec64e14c-f33e-4c43-8fe4-b3b9db4b24bc",
                                "sense_id": "f6057f9d-70b2-3941-af62-cae96fb535ac",
                                "text": "[Der Aufsichtsratsvorsitzende Paul] „Achleitner installierte die Doppelspitze Anshu Jain und Jürgen Fitschen.“"
                            },
                            {
                                "example_id": "1cfe1a40-4f4d-486e-8dc6-aaa5c898581d",
                                "sense_id": "f6057f9d-70b2-3941-af62-cae96fb535ac",
                                "text": "„Die Doppelspitze aus Jennifer Morgan und Christian Klein muss bei SAP nun früher übernehmen als geplant […]“"
                            },
                            {
                                "example_id": "7a49ab1e-e9fc-4fb2-ae80-e5dc1cb567d8",
                                "sense_id": "f6057f9d-70b2-3941-af62-cae96fb535ac",
                                "text": "„Die EADS strukturiert ihre Führungsspitze um. Die bisher vorhandene Doppelspitze wird abgeschafft, und der Franzose Louis Gallois wird alleiniger Chef des Konzerns.“"
                            },
                            {
                                "example_id": "22997082-60da-41e6-baaa-1f62d1010fa0",
                                "sense_id": "f6057f9d-70b2-3941-af62-cae96fb535ac",
                                "text": "„[…] die Lösung, die Berlinale künftig mit einer Doppelspitze auszustatten, ist auch nicht verkehrt.“"
                            },
                            {
                                "example_id": "cd48c052-3ec2-43b1-8db1-cb954ed2a3b0",
                                "sense_id": "f6057f9d-70b2-3941-af62-cae96fb535ac",
                                "text": "„Die kommende und 70. Jubiläumsausgabe der Berlinale findet unter der Doppelspitze von Carlo Chatrian als künstlerischem Leiter und Mariette Rissenbeek als Geschäftsführerin vom 20. Februar bis 1. März 2020 statt.“"
                            },
                            {
                                "example_id": "bcbfa272-ab5e-4b7e-bf95-00d3027bd0f4",
                                "sense_id": "f6057f9d-70b2-3941-af62-cae96fb535ac",
                                "text": "„Das Mecklenburgische Staatstheater Schwerin wird künftig nicht mehr von einem Generalintendanten geleitet, sondern von zwei gleichberechtigten Leitern. Als Nachfolger des jetzigen Intendanten Lars Tietje soll es von 2021 an eine Doppelspitze aus künstlerischem sowie kaufmännischem Leiter geben.“"
                            },
                            {
                                "example_id": "8f7410c6-62d7-4edb-b862-07f56b7fdcea",
                                "sense_id": "f6057f9d-70b2-3941-af62-cae96fb535ac",
                                "text": "[Michael] „Skibbe war zusammen mit Rudi Völler […] in den Jahren 2000 bis 2004 als Doppelspitze bei der deutschen Nationalmannschaft im Einsatz.“ [Anmerkung: Michael Skibbe und Rudi Völler waren im Jahr 2000 Trainer, und nicht mehr Spieler, daher in Bedeutung [1]]"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "bc623030-a9fe-3acb-abcb-e89f72f1b3c1",
                        "entry_id": "40848784-baba-3235-bf7e-de9059ed1af7",
                        "glosses": [
                            "in Parteien (AfD, Die Linke, Bündnis 90/Die Grünen, SPD)"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "7ebb6092-c02b-3f43-b9a2-66123a8b0862",
                        "entry_id": "40848784-baba-3235-bf7e-de9059ed1af7",
                        "glosses": [
                            "in Unternehmen (Airbus/EADS, Deutsche Bank, SAP, Thyssenkrupp)"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "f58029ab-5e83-3729-9947-59249c29b357",
                        "entry_id": "40848784-baba-3235-bf7e-de9059ed1af7",
                        "glosses": [
                            "beim Deutschen Fußballbund"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "2c95206e-702f-33b3-a668-2b32cebdaac4",
                        "entry_id": "40848784-baba-3235-bf7e-de9059ed1af7",
                        "glosses": [
                            "Spielweise mit zwei vordersten Stürmern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf503cbc-e5a6-406a-87ae-4cda088ae8f8",
                                "sense_id": "2c95206e-702f-33b3-a668-2b32cebdaac4",
                                "text": "„»Gut möglich also«, sagt der Trainer, »dass wir in Berghofen mit zwei Spitzen beginnen werden.« Doppelspitzen sind ja angesagt, aber auch in Budberg fragt man sich, wer‘s denn machen soll.“"
                            },
                            {
                                "example_id": "cd6525b2-6a11-4409-aa0c-72cea85746d7",
                                "sense_id": "2c95206e-702f-33b3-a668-2b32cebdaac4",
                                "text": "„Die Knappen agierten in einem 4-4-2-System, in dem Neuzugang Michael Gregoritsch gemeinsam mit Benito Raman die Doppelspitze bildete.“"
                            },
                            {
                                "example_id": "77f8b0aa-fae7-4ef1-a97a-47b7b9ea337a",
                                "sense_id": "2c95206e-702f-33b3-a668-2b32cebdaac4",
                                "text": "[Der Trainer des Hamburger Sport Vereins] „Dieter Hecking […] plant am Sonnabend gegen Dynamo Dresden […] wohl erstmals mit einer Doppelspitze.“"
                            },
                            {
                                "example_id": "4be43fe7-fee5-46ad-a337-6a16a967a300",
                                "sense_id": "2c95206e-702f-33b3-a668-2b32cebdaac4",
                                "text": "„Leverkusen muss auf Atleticos brandgefährliche französische Doppelspitze aufpassen. Antoine Griezmann netzte 2017 in 12 Spielen 7 Mal ein. Sein kongenialer Sturmpartner Kevin Gameiro sorgte am Wochenende gegen Gijon für Furore […]“"
                            },
                            {
                                "example_id": "3d1ab88a-7497-4f35-8ca5-aa51382d6445",
                                "sense_id": "2c95206e-702f-33b3-a668-2b32cebdaac4",
                                "text": "„Wer im Sturm spielt, hängt nicht zuletzt davon ab, wie Vladimir Petkovic seine Offensivreihe ausrichtet. Denkbar wären diverse Optionen wie ein Mittel- und 2 Aussenstürmer, eine Doppelspitze oder ein Mittelstürmer und eine hängende Spitze.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "9a293e21-ece8-3998-84a2-20a1aac5b53c",
                        "entry_id": "40848784-baba-3235-bf7e-de9059ed1af7",
                        "glosses": [
                            "Form mit zwei Spitzen/Peaks, beispielsweise bei Bergen mit zwei nahe beieinander liegenden Gipfeln, bei Kurven in einem Diagramm"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d56ad3c-b3c3-4e25-af52-d44480d41cef",
                                "sense_id": "9a293e21-ece8-3998-84a2-20a1aac5b53c",
                                "text": "„Markant ist er [Anmerkung: der Willinger Berg] in der Landschaft durch seine Doppelspitze.“"
                            },
                            {
                                "example_id": "53d77552-bd89-4a80-ab84-acf8be123b7e",
                                "sense_id": "9a293e21-ece8-3998-84a2-20a1aac5b53c",
                                "text": "„Eine Art Doppelspitze bildend liegt rund 150 Meter nordwestlich der Korab-Spitze innerhalb albanischen Gebiets ein weiterer Gipfel, Korab II genannt, mit fast gleicher Höhe.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
