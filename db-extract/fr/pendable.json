                        "examples": [
                            {
                                "example_id": "1857299b-ab63-4188-a666-3a1f03dfb29b",
                                "sense_id": "dd6c812e-3870-3423-8248-e2760c85723d",
                                "text": "La Louve, cette péripatéticienne de la rue Pierre-Lescot, épousera son Martial et en aura beaucoup d'enfants. Il suffit d'avoir fait quelque infamie pendable et d'avoir rencontré M. Rodolphe de Gérolslein pour se remettre à flot."
                            },
                            {
                                "example_id": "25623d52-9104-4586-96df-945bf7ac0284",
                                "sense_id": "dd6c812e-3870-3423-8248-e2760c85723d",
                                "text": "Certes on sentait bien que l'envie n'en manquait pas à ces saute-buissons qui par ailleurs comptaient à leur actif plus d'un tour pendable."
                            }
                        ]
                    }
