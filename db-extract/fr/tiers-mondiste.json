                        "entry_id": "4213997d-6acc-3519-b844-134fc4809911",
                        "glosses": [
                            "Qui se rapporte au tiers-monde, qui relève du tiers-mondisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eab144e3-a38c-4f13-8c0b-7249671e6c9a",
                                "sense_id": "0804ada7-7425-3118-ba35-2eb6c2540ffe",
                                "text": "Conception, nationalisme, orientation, position, révolution tiers-mondiste."
                            },
                            {
                                "example_id": "4c7c7abb-8fed-4895-a3b8-1ef31ff7d753",
                                "sense_id": "0804ada7-7425-3118-ba35-2eb6c2540ffe",
                                "text": "Les plus idéalistes [des coopérants] voient souvent le fossé s'agrandir entre leur projet initial, humaniste et tiers-mondiste, et la réalité politique."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "203306be-5681-4984-b4ea-37c0b31945bf",
                        "source_entry_id": "4213997d-6acc-3519-b844-134fc4809911",
                        "source_sense_id": "0804ada7-7425-3118-ba35-2eb6c2540ffe",
                        "target_lang_word": "Third World",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Third World",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d6488a8b-9471-3b8e-97f8-d0e1dc0f88e9",
                                        "entry_id": "286c2a9f-3189-30dc-bd72-ed08491c18d6",
                                        "glosses": [
                                            "Those countries not aligned with the west or the east during the Cold War."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a6efb515-d398-37bd-a2c2-0fcfc883cb80",
                                        "entry_id": "286c2a9f-3189-30dc-bd72-ed08491c18d6",
                                        "glosses": [
                                            "developing countries, especially that of Africa, Asia and Latin America"
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "sometimes"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "089a2318-31a1-4fee-b312-30c035e740ad",
                                                "sense_id": "a6efb515-d398-37bd-a2c2-0fcfc883cb80",
                                                "text": "Our district has many immigrants from Third World countries"
                                            },
                                            {
                                                "example_id": "f6ab2c6a-8130-4c93-8396-8602f7acae3c",
                                                "sense_id": "a6efb515-d398-37bd-a2c2-0fcfc883cb80",
                                                "text": "How about — take a deep breath — eliminating the subsidies to American farmers that keep Third World farmers from being able to make a living selling their products?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5080113f-f65b-33b3-b718-cba478808815",
                                        "entry_id": "286c2a9f-3189-30dc-bd72-ed08491c18d6",
                                        "glosses": [
                                            "Any developing country, or a country lacking the perceived internationally respected ideal standards of a society (e.g. sufficient rule of law and internationally respected level of prosperity)."
                                        ],
                                        "tags": [
                                            "attributive",
                                            "derogatory",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "49c63ca1-5c02-4a1d-b190-f0fd803e74e9",
                                                "sense_id": "5080113f-f65b-33b3-b718-cba478808815",
                                                "text": "In some instances, the U.S.’s performance is downright abysmal, far below foreign countries that are snidely looked-down-upon as “third world.”"
                                            },
                                            {
                                                "example_id": "d42cb1cc-1d6e-4ac5-927f-2581ab04565b",
                                                "sense_id": "5080113f-f65b-33b3-b718-cba478808815",
                                                "text": "[…] \"IT IS LIKEWISE A CONTINUING ATTACK ON OUR ONCE FREE AND FAIR ELECTIONS. THE USA IS NOW A THIRD WORLD NATION, A NATION IN SERIOUS DECLINE. SO SAD!\"[…]\"The ruling party is trying to jail the opposition leader like a third world dictatorship! It's happening before your very eyes,\" Trump Jr. said in a tweet.[…]Meanwhile, Eric Trump condemned the indictment as \"third world prosecutorial misconduct […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "89fa7012-300c-380c-a0c2-479528f0400c",
                                        "entry_id": "286c2a9f-3189-30dc-bd72-ed08491c18d6",
                                        "glosses": [
                                            "People of marginalized or exploited races, collectively."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a1d2b5f-4024-45bc-b2de-94c5cceeb6a6",
                                                "sense_id": "89fa7012-300c-380c-a0c2-479528f0400c",
                                                "text": "Although it has been publicized that 1/3 of the musicians are women of color. these women were chosen without consulting the Third World Women's community."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
