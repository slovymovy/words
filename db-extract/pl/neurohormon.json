                                        "glosses": [
                                            "Any hormone that stimulates the nervous system."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c9f4e55-8fed-45c8-a225-a65ccb4530c2",
                                                "sense_id": "a1c7d7ad-f725-30a7-b6f2-338f80da78df",
                                                "text": "Together with this is the influence of an infinite number of neurotransmitters, neurohormones, environmental hazards, and accidental programmings."
                                            }
                                        ]
