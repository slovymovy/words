                "senses": [
                    {
                        "sense_id": "808f54f2-71ac-3428-a0be-07a0d080d454",
                        "entry_id": "fa761f80-9501-3a7a-97cf-e77bfc21857b",
                        "glosses": [
                            "Autointoxikation, die durch den Abbau körpereigener Stoffe verursacht wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "81deafaa-e54e-42e0-b924-7805d379f1cf",
                                "sense_id": "808f54f2-71ac-3428-a0be-07a0d080d454",
                                "text": "„Nur zum geringen Teil dürfte indessen die Ursache in einer Überschwemmung des Körpers mit Gallenbestandteilen beruhen, während in der Hauptsache die infolge von ausgedehnter Zerstörung von Lebergewebe entstehende Leberinsuffizienz (Hepatargie) und die daraus resultierende Autointoxikation mit den von der Leber normal verarbeiteten Produkten des Stoffwechsels oder der Darmfäulnis, aber auch mit den Produkten der autolytischen Zersetzung des Lebergewebes selbst die Ursache des Krankheitsbildes (sog. Abbauintoxikation) darstellen, zumal dieses auch bei Lebererkrankungen ohne Ikterus beobachtet wird.“"
                            }
                        ],
