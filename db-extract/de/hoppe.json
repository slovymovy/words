                    }
                ],
                "senses": [
                    {
                        "sense_id": "8d53b483-494a-3769-bcdc-380aa64e9dac",
                        "entry_id": "7960ed3c-7be9-339d-8d93-10894f36e32b",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94a85ad7-d6af-4574-be5a-c08254d6d9e2",
                                "sense_id": "8d53b483-494a-3769-bcdc-380aa64e9dac",
                                "text": "Frau Hoppe ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "d10c1bf3-34a3-457b-9900-8c83c473261c",
                                "sense_id": "8d53b483-494a-3769-bcdc-380aa64e9dac",
                                "text": "Herr Hoppe wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "02867215-30a1-4951-8cf1-dbb97fb4f537",
                                "sense_id": "8d53b483-494a-3769-bcdc-380aa64e9dac",
                                "text": "Die Hoppes kommen heute aus dem Erzgebirge."
                            },
                            {
                                "example_id": "b85cc175-1d5e-4e59-aceb-3efea32a2d8a",
                                "sense_id": "8d53b483-494a-3769-bcdc-380aa64e9dac",
                                "text": "Der Hoppe trägt nie die Schals, die die Hoppe ihm strickt."
                            },
                            {
                                "example_id": "bbaf9f5c-15df-48c8-8c1f-9cb5d3ed23eb",
                                "sense_id": "8d53b483-494a-3769-bcdc-380aa64e9dac",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Hoppe kommt, geht der Herr Hoppe.“"
                            },
                            {
                                "example_id": "e75b30a0-5739-4d92-96d5-eb8ef3e782e2",
                                "sense_id": "8d53b483-494a-3769-bcdc-380aa64e9dac",
                                "text": "Hoppe kommt und geht."
                            },
                            {
                                "example_id": "8460475d-30f7-4748-a91e-6bd4d031ce23",
                                "sense_id": "8d53b483-494a-3769-bcdc-380aa64e9dac",
                                "text": "Hoppes kamen, sahen und siegten."
                            },
                            {
                                "example_id": "5cbf24ce-e9f9-4f69-977c-211a9dc15b0c",
                                "sense_id": "8d53b483-494a-3769-bcdc-380aa64e9dac",
                                "text": "An verregneten Herbsttagen ist Familie Hoppes liebste Beschäftigung das Bemalen von Hühnereiern."
                            },
                            {
                                "example_id": "22b1ad80-f729-48aa-9b5a-8f8b65cdb2c2",
                                "sense_id": "8d53b483-494a-3769-bcdc-380aa64e9dac",
                                "text": "An verschneiten Wintertagen ist die liebste Beschäftigung von Familie Hoppe das Schmücken von Weihnachtsbäumen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
