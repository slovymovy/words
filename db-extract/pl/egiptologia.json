                                        "entry_id": "7ccb2935-ca3c-33d2-b78c-14532d4e3812",
                                        "glosses": [
                                            "Branche de l’archéologie se préoccupant des antiquités égyptiennes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9827ca3-3a5d-4313-ac62-449efc1d0305",
                                                "sense_id": "1404c7e4-6b0b-3ba4-a9c3-090948eccc0f",
                                                "text": "Les études démotiques n’en occupent pas moins une place quelque peu isolée entre l’égyptologie, d’une part, et la papyrologie, d’autre part."
                                            },
                                            {
                                                "example_id": "b87dcee3-ff8e-4b28-9895-27bf8daa6181",
                                                "sense_id": "1404c7e4-6b0b-3ba4-a9c3-090948eccc0f",
                                                "text": "Ce dernier même n’ouvrit pas à l’égyptologie une carrière tracée."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b375ffc8-19d1-4497-b458-f778e2042128",
                        "source_entry_id": "1f824f8e-fe8b-3b0d-8a6b-00d71ca25bba",
