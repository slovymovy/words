                                        "entry_id": "eafc6bfb-1d5a-3f2b-aebe-0eaef02f6a74",
                                        "glosses": [
                                            "bogini mądrości, wojny sprawiedliwej i rękodzieła, utożsamiana z rzymską Minerwą"
                                        ],
                                        "tags": [
                                            "Ancient-Greek"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d8d89080-ddba-44d0-9ab7-22db87ab5335",
                                                "sense_id": "4077fb8c-ddd0-3135-afe6-85b4e1d2904d",
                                                "text": "Według mitu Atena wyskoczyła z głowy swojego ojca Zeusa."
                                            },
                                            {
                                                "example_id": "1d7abb8c-b58d-4e33-8f4c-7e1869bd4f5c",
                                                "sense_id": "4077fb8c-ddd0-3135-afe6-85b4e1d2904d",
                                                "text": "Atrybutami Ateny były: egida, hełm, włócznia, sowa i oliwka."
                                            },
                                            {
                                                "example_id": "9d134bb7-7a72-4d88-9080-153344da3d41",
                                                "sense_id": "4077fb8c-ddd0-3135-afe6-85b4e1d2904d",
                                                "text": "Uwieńczano także posągi bogów, zwykle roślinami, jakie były im poświęcone, np. wawrzyn Apollinowi, dąb Zeusowi, mirt Afrodycie, winorośl albo platan Dionizosowi, kłosy zboża Demeter, oliwka Atenie"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "3124de2d-83cb-361a-8dc3-03ba53f44177",
                                        "entry_id": "eafc6bfb-1d5a-3f2b-aebe-0eaef02f6a74",
                                        "glosses": [
                                            "imię żeńskie; imię mitologiczne"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "26ce7046-f956-4d24-9252-822398c9aa4e",
                                                "sense_id": "3124de2d-83cb-361a-8dc3-03ba53f44177",
                                                "text": "Mam na imię Atena i jestem córką polskich emigrantów w Grecji."
                                            }
                                        ],
