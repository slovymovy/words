    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e047f3b6-22c0-329a-a667-550707aec7ac",
                    "sense_definition": "Faire de quelque chose sa propriété, attribuer à soi-même un bien ou une idée de manière légitime ou indue.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "possession",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a tenté de s'<w>approprier</w> les terres de son voisin sans aucun droit légal."
                        },
                        {
                            "text": "Le directeur cherche à s'<w>approprier</w> le mérite du travail accompli par son équipe."
                        }
                    ],
                    "synonyms": [
                        "s'accaparer",
                        "usurper"
                    ],
                    "common_phrases": [
                        "s'approprier le mérite",
                        "s'approprier un bien"
                    ]
                },
                {
                    "sense_id": "4faf159a-a1e2-30f7-809a-e3ad17e9451d",
                    "sense_definition": "Adapter ou ajuster quelque chose pour le rendre propre à un usage ou à une destination précise.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "adaptation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous devons <w>approprier</w> notre méthode d'enseignement aux besoins réels de chaque élève."
                        },
                        {
                            "text": "L'architecte a su <w>approprier</w> les espaces intérieurs aux contraintes du bâtiment ancien."
                        }
                    ],
                    "common_phrases": [
                        "approprier aux besoins"
                    ]
                },
                {
                    "sense_id": "3b2ab0e9-fef2-34bd-b609-16cf3e72829b",
                    "sense_definition": "Nettoyer, ranger ou remettre en ordre un lieu pour le rendre propre.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "nettoyage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Avant l'arrivée des invités, il a fallu <w>approprier</w> rapidement toutes les pièces du rez-de-chaussée."
                        },
                        {
                            "text": "La servante venait chaque matin <w>approprier</w> la chambre et changer les draps."
                        }
                    ],
                    "common_phrases": [
                        "approprier une chambre"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Sens vieilli ou régional pour nettoyer ou ranger"
                        }
                    ]
                }
            ]
        }
    ]
