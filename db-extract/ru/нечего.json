        "ru-extract.jsonl": [
            {
                "entry_id": "725417c2-8ccf-3f4a-a866-623411f05953",
                "word": "нечего",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "7d4283c0-8f28-301e-b7c5-6c70b8a50b76",
                        "entry_id": "725417c2-8ccf-3f4a-a866-623411f05953",
                        "glosses": [
                            "предик. разг. то же, что не́ча; не приходится, не следует; не полагается"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "454d3188-53a4-460a-b304-bbe3b28b5114",
                                "sense_id": "7d4283c0-8f28-301e-b7c5-6c70b8a50b76",
                                "text": "Они не подозревают, что в наших сердцах действо любви проявляется внезапно и что, следовательно, нечего тут думать о чистке носов, когда любовь с электрическою быстротою пронизывает нас насквозь."
                            }
                        ]
                    },
                    {
                        "sense_id": "39ff9ca7-4fb4-3923-b8ae-8392040f7693",
                        "entry_id": "725417c2-8ccf-3f4a-a866-623411f05953",
                        "glosses": [
                            "предик. нет смысла, не нужно; незачем"
                        ],
                        "tags": [
                            "об отсутствии надобности"
                        ],
                        "examples": []
                    }
                ],
                "translations": [],
                "word_linkages": [
                    {
