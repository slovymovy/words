                "senses": [
                    {
                        "sense_id": "994259ef-57aa-3fbe-b74a-7a76f1ebf196",
                        "entry_id": "b3dfaa83-d21f-3ec7-875c-60d6c91c52a1",
                        "glosses": [
                            "Qui s’est éloigné de la droiture morale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a1f8c14f-4947-4ab6-8644-d52450831f19",
                                "sense_id": "994259ef-57aa-3fbe-b74a-7a76f1ebf196",
                                "text": "Raté, débauché, dévoyé, dévoué, tout s’expliquait, se justifiait et s’harmonisait en somme."
                            },
                            {
                                "example_id": "e256aca7-9a5e-4919-ae0f-e99aa3bc8dfe",
                                "sense_id": "994259ef-57aa-3fbe-b74a-7a76f1ebf196",
                                "text": "[Il] n'est peut-être pas moins dévoyé que le fils du notaire, à Rouen, qui comparaît devant les Assises pour un vol d'auto, une affaire de carambouillage ou un trafic de stupéfiants."
                            },
                            {
                                "example_id": "028b0a0a-7126-4eb5-8001-2d13514efa50",
                                "sense_id": "994259ef-57aa-3fbe-b74a-7a76f1ebf196",
                                "text": "Je suppose que c’est cette ambition héritée et dévoyée qui m’empêchait d’admettre ma défaite sur la Calotte de glace de Stikine après l’échec de ma première tentative et même après avoir presque mis le feu à ma tente."
                            }
                        ]
                    }
                ],
