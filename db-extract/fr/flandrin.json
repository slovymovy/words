                    {
                        "sense_id": "429d0a0a-c194-3677-9008-1ba065e03cac",
                        "entry_id": "b201e641-969d-3e92-93d2-3d05d59f0d29",
                        "glosses": [
                            "Habitant de la Flandre."
                        ],
                        "tags": [
                            "Très rare"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "9599fc38-8320-392a-91cc-b8da17e8a74b",
                        "entry_id": "b201e641-969d-3e92-93d2-3d05d59f0d29",
                        "glosses": [
                            "Sobriquet qui désigne un homme de haute taille, mince et d’allure molle."
                        ],
                        "tags": [
                            "dated",
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "702288a7-3747-4e25-95b8-e5448d3c954b",
                                "sense_id": "9599fc38-8320-392a-91cc-b8da17e8a74b",
                                "text": "L’orfèvre, s’approchant. – Vous parlez en patriote, ami ; je vous conseille de prendre garde à ce flandrin.\nPasse un officier allemand."
                            },
                            {
                                "example_id": "6b63ed93-bc6c-4ad2-97e1-99cf946612cb",
                                "sense_id": "9599fc38-8320-392a-91cc-b8da17e8a74b",
                                "text": "Et les paysans, ces grands flandrins qui tremblaient quelques mois auparavant comme des lièvres, lorsqu’on les regardait de travers… eh bien, je les ai vus traiter d’un air d’arrogance de vieux soldats, […]."
                            },
                            {
                                "example_id": "a181f5e9-7d95-4c06-bec4-443bb4132508",
                                "sense_id": "9599fc38-8320-392a-91cc-b8da17e8a74b",
                                "text": "— Maintenant que ce grand flandrin se croit libéré, se dit-il, il est capable de vouloir se mettre au travers de mon chemin pour me jouer quelque mauvais tour."
                            },
                            {
                                "example_id": "fe906e84-25fc-4aff-9e5d-e93262c9e6a6",
                                "sense_id": "9599fc38-8320-392a-91cc-b8da17e8a74b",
                                "text": "Certain long flandrin, d'âge indécis, mais qui s'exprimait avec précision en fronçant un museau de fouine, s'était amené un joyeux matin, porteur d'une lettre pour madame la concierge et escorté d'une voiture de déménagement."
                            },
                            {
                                "example_id": "686fbf1d-74eb-4e84-83a4-dc38f3a91cb1",
                                "sense_id": "9599fc38-8320-392a-91cc-b8da17e8a74b",
                                "text": "— Si ce n’est pas malheureux de voir un grand flandrin ne penser qu’à son plaisir, quand de plus jeunes que lui se font massacrer, disait Mme Blondel."
                            }
                        ]
                    }
                ],
