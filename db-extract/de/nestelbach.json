                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a9442966-42c2-4b32-878a-0d0b38180585",
                                "sense_id": "93cae260-444b-3622-8583-e4ab5b0d07d8",
                                "text": "Nestelbach im Ilztal war eine Gemeinde im Bezirk Hartberg-Fürstenfeld in der Steiermark."
                            },
                            {
                                "example_id": "c5c44291-2837-4436-a1df-c013e23c49f2",
                                "sense_id": "93cae260-444b-3622-8583-e4ab5b0d07d8",
                                "text": "Die Gemeinde Nestelbach bei Graz im Bezirk Graz-Umgebung in der Steiermark existiert heute noch."
                            },
                            {
                                "example_id": "450b8f48-ca9d-4329-b5e6-3037e5769227",
                                "sense_id": "93cae260-444b-3622-8583-e4ab5b0d07d8",
                                "text": "Es gibt auch eine Ortschaft Nestelbach in der Marktgemeinde Großklein im Bezirk Leibnitz, ebenfalls in der Steiermark."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
