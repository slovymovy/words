                "senses": [
                    {
                        "sense_id": "14bc79b7-2f51-3b7e-915a-e8c55f4e11d9",
                        "entry_id": "8d577329-16e5-3eb8-a97b-c4a76c9d1ccc",
                        "glosses": [
                            "bewegliche Brücke, über die ein gegnerisches Schiff geentert, überfallen werden kann"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "a8abadef-20b1-451d-b109-6287f222f218",
                                "sense_id": "14bc79b7-2f51-3b7e-915a-e8c55f4e11d9",
                                "text": "„Seekrieg heißt, über eine schmale Enterbrücke das feindliche Schiff zu stürmen.“"
                            },
                            {
                                "example_id": "afa9c7d3-6cb1-406d-a2d9-4891594d8978",
                                "sense_id": "14bc79b7-2f51-3b7e-915a-e8c55f4e11d9",
                                "text": "„Der ‚corvus‘, den Polybios als Symbol der römischen Kriegskunst vorstellt, hätte ungefähr eine Höhe von 7,2 Metern gehabt, die Enterbrücke wäre sogar fast elf Meter lang und 1,2 Meter breit gewesen.“"
                            }
                        ],
