                    {
                        "sense_id": "02de3b40-4cdd-3a3f-aca4-832013552c81",
                        "entry_id": "c5046bfa-f594-3daf-aeff-02cf967408ea",
                        "glosses": [
                            "in Versen verfasste Chronik"
