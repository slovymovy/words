                        "examples": [
                            {
                                "example_id": "7f4fdfa6-9500-4429-8de1-3efbe74e1bdd",
                                "sense_id": "5a8935cb-7562-3439-8af5-1078527bca72",
                                "text": "Blijft de vraag hoe Oolbekkink weet of ergens water zit. \"Gewoon boren\", zegt hij. \"Overal zit water, het is een kwestie van diepte.\" Het mooist is als je in een groffe grindlaag kunt komen. Dan heb je mooi helder, natuurlijk gefilterd water.\""
                            },
                            {
                                "example_id": "d92818ba-17a9-4ce7-b5ae-62566d9cb063",
                                "sense_id": "5a8935cb-7562-3439-8af5-1078527bca72",
                                "text": "Op verschillende wegen in het buitengebied van Dinkelland is een nieuwe reflecterende grindlaag aangebracht. Die moet zorgen voor een betere zichtbaarheid van de fietsers."
                            }
                        ]
                    }
