                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "b92bcc27-0371-48c1-9b8d-fe42621c60cb",
                        "source_entry_id": "6013a0c8-898c-3036-ae12-e7f77bc0096b",
                        "source_sense_description": "the beating of a drum",
                        "target_lang_word": "Trommelschlag",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Trommelschlag",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6e9b123b-9466-3f99-b5e0-2483df583cfd",
                                        "entry_id": "8f244dc9-1d4d-3082-aabb-f0a09ecbc8af",
                                        "glosses": [
                                            "Schlag auf eine Trommel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f859fa17-7a3e-4bfa-a7d8-ad3571693704",
                                                "sense_id": "6e9b123b-9466-3f99-b5e0-2483df583cfd",
                                                "text": "„Trommelschläge dröhnen durch die Nacht, seit Stunden schon, ein stampfendes Stakkato, der Klang eines angekündigten Krieges.“"
                                            },
                                            {
                                                "example_id": "55cc454b-f1fd-4980-9786-ad74912b9d30",
                                                "sense_id": "6e9b123b-9466-3f99-b5e0-2483df583cfd",
                                                "text": "„Von der dunklen Küste drangen Trommelschläge herüber.“"
                                            },
                                            {
                                                "example_id": "f182f1af-49b1-4e98-b1f0-505eed73126a",
                                                "sense_id": "6e9b123b-9466-3f99-b5e0-2483df583cfd",
                                                "text": "„Die Trommelschläge, die die Regimenter zur Frontlinie führten, leiteten das Schauspiel ein.“"
                                            },
                                            {
                                                "example_id": "df5b45b3-566c-4d32-8e8e-dea55b98af89",
                                                "sense_id": "6e9b123b-9466-3f99-b5e0-2483df583cfd",
                                                "text": "„Rechts und links wurden plötzlich einige Trommeln geschlagen, und Pierre hatte eine Empfindung, als würde ihm mit diesen Trommelschlägen ein Stück von seiner Seele weggerissen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
