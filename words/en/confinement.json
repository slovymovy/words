                                "target_lang_sense_clarification": "zeitweise Isolierung zum Infektionsschutz"
                            },
                            {
                                "target_lang_word": "die Isolation",
                                "target_lang_sense_clarification": "Abschirmung zur Seuchen- oder Gefahrenabwehr"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1fa95c8d-aad8-3adc-ac12-1be33d23f772",
