{
    "word_family": [],
    "entries": [
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "c6c58f46-69f1-344f-9f1a-b2f46297e444",
                    "sense_definition": "A school of Mahayana Buddhism that emphasizes meditation, intuition, and the direct transmission of teachings rather than studying scriptures.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "zen_religion",
                    "name_type": "religion_or_philosophy_name",
                    "examples": [
                        {
                            "text": "Many people practice <w>Zen</w> to find inner peace and clarity.",
                            "target_lang_translations": {
                                "ru": "Многие люди практикуют <w>дзен</w>, чтобы обрести внутренний покой и ясность.",
                                "de": "Viele Menschen praktizieren <w>Zen</w>, um inneren Frieden und Klarheit zu finden."
                            }
                        },
                        {
                            "text": "<w>Zen</w> originated in China before becoming widely established in Japan.",
                            "target_lang_translations": {
                                "ru": "<w>Дзен</w> зародился в Китае, прежде чем получил широкое распространение в Японии.",
                                "de": "<w>Zen</w> hat seinen Ursprung in China, bevor es sich in Japan weit verbreitete."
                            }
                        }
                    ],
                    "common_phrases": [
                        "Zen Buddhism",
                        "Zen garden",
                        "Zen master"
                    ],
                    "target_lang_definitions": {
                        "ru": "Школа буддизма махаяны, делающая упор на медитацию, интуицию и прямую передачу учения, а не на изучение писаний.",
                        "de": "Eine Strömung des Mahayana-Buddhismus, die Meditation, Intuition und die unmittelbare Weitergabe der Lehre anstelle des Studiums von Schriften betont."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дзен",
                                "target_lang_sense_clarification": "школа буддизма"
                            },
                            {
                                "target_lang_word": "дзэн",
                                "target_lang_sense_clarification": "вариант написания"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Zen",
                                "target_lang_sense_clarification": "buddhistische Strömung"
                            },
                            {
                                "target_lang_word": "Zen-Buddhismus",
                                "target_lang_sense_clarification": "vollständige Bezeichnung der Glaubensrichtung"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "fe787207-fb97-371e-bd15-3d9f75d0c353",
                    "sense_definition": "Extremely relaxed, calm, and free of worry; displaying a peaceful kind of wisdom.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "zen_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Even though he lost his keys, he remained completely <w>zen</w> about the situation.",
                            "target_lang_translations": {
                                "ru": "Хотя он потерял ключи, он оставался совершенно <w>невозмутимым</w> в этой ситуации.",
                                "de": "Obwohl er seine Schlüssel verloren hatte, blieb er angesichts der Situation völlig <w>gelassen</w>."
                            }
                        },
                        {
                            "text": "You need to stay <w>zen</w> and focused when dealing with angry customers.",
                            "target_lang_translations": {
                                "ru": "Нужно сохранять <w>спокойствие</w> и сосредоточенность при общении с рассерженными клиентами.",
                                "de": "Im Umgang mit verärgerten Kunden muss man <w>entspannt</w> und fokussiert bleiben."
                            }
                        }
                    ],
                    "synonyms": [
                        "calm",
                        "relaxed"
                    ],
                    "antonyms": [
                        "stressed",
                        "anxious"
                    ],
                    "common_phrases": [
                        "stay zen",
                        "very zen"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used to describe a person's demeanor"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Чрезвычайно расслабленный, спокойный и свободный от беспокойства; демонстрирующий умиротворенную мудрость.",
                        "de": "Äußerst entspannt, gelassen und frei von Sorgen; eine friedliche Weisheit und Ruhe ausstrahlend."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "невозмутимый",
                                "target_lang_sense_clarification": "спокойный"
                            },
                            {
                                "target_lang_word": "спокойный",
                                "target_lang_sense_clarification": "расслабленный"
                            },
                            {
                                "target_lang_word": "умиротворённый",
                                "target_lang_sense_clarification": "в состоянии покоя"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "zen",
                                "target_lang_sense_clarification": "tiefenentspannt, umgangssprachlich"
                            },
                            {
                                "target_lang_word": "gelassen",
                                "target_lang_sense_clarification": "ruhig und unerschütterlich"
                            },
                            {
                                "target_lang_word": "tiefenentspannt",
                                "target_lang_sense_clarification": "völlig ruhig und gelöst"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f83b7b6b-fb91-3634-bfea-1eaec9764d8e",
                    "sense_definition": "Of or related to the Buddhist school of Zen.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "zen_religion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>Zen</w> monk sat in silence for several hours during the ceremony.",
                            "target_lang_translations": {
                                "ru": "<w>Дзен</w>-монах сидел в тишине несколько часов во время церемонии.",
                                "de": "Der <w>Zen-</w>Mönch saß während der Zeremonie mehrere Stunden lang schweigend da."
                            }
                        },
                        {
                            "text": "She enjoys the simplicity and balance of <w>Zen</w> architecture.",
                            "target_lang_translations": {
                                "ru": "Ей нравится простота и гармония архитектуры <w>дзен</w>.",
                                "de": "Sie schätzt die Schlichtheit und Ausgewogenheit der <w>Zen-</w>Architektur."
                            }
                        }
                    ],
                    "common_phrases": [
                        "Zen meditation",
                        "Zen monk"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к буддийской школе дзен.",
                        "de": "Die buddhistische Schule des Zen betreffend oder zu ihr gehörend."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дзен-",
                                "target_lang_sense_clarification": "первая часть сложных слов"
                            },
                            {
                                "target_lang_word": "дзенский",
                                "target_lang_sense_clarification": "прилагательное"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Zen-",
                                "target_lang_sense_clarification": "als Erstglied von Zusammensetzungen"
                            },
                            {
                                "target_lang_word": "buddhistisch",
                                "target_lang_sense_clarification": "im Sinne der Zen-Tradition"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c526141c-d632-301b-9695-6a2b00dade70",
                    "sense_definition": "An approach to an activity that emphasizes simplicity, intuition, and focus rather than strict logic.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "zen_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is trying to master the <w>zen</w> of cooking by relying on his senses.",
                            "target_lang_translations": {
                                "ru": "Он пытается постичь <w>дзен</w> кулинарии, полагаясь на свои чувства.",
                                "de": "Er versucht, die <w>Kunst</w> des Kochens zu meistern, indem er sich auf seine Sinne verlässt."
                            }
                        },
                        {
                            "text": "The book explains the <w>zen</w> of programming in a very accessible way.",
                            "target_lang_translations": {
                                "ru": "Книга объясняет <w>дзен</w> программирования очень доступным языком.",
                                "de": "Das Buch erklärt das <w>Zen</w> des Programmierens auf sehr verständliche Weise."
                            }
                        }
                    ],
                    "synonyms": [
                        "tao"
                    ],
                    "common_phrases": [
                        "the zen of"
                    ],
                    "target_lang_definitions": {
                        "ru": "Подход к деятельности, подчеркивающий простоту, интуицию и сосредоточенность, а не строгую логику.",
                        "de": "Eine Herangehensweise an eine Tätigkeit, die Einfachheit, Intuition und Fokus anstelle von strenger Logik betont."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дзен",
                                "target_lang_sense_clarification": "философия подхода"
                            },
                            {
                                "target_lang_word": "искусство",
                                "target_lang_sense_clarification": "мастерство"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Zen",
                                "target_lang_sense_clarification": "Geisteshaltung oder Kunstfertigkeit"
                            },
                            {
                                "target_lang_word": "Geist",
                                "target_lang_sense_clarification": "innere Philosophie einer Disziplin"
                            },
                            {
                                "target_lang_word": "Kunst",
                                "target_lang_sense_clarification": "intuitives Meistertum"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "65a1ce75-c9d1-312d-8192-a23f9a6cd510",
                    "sense_definition": "A state of calm attentiveness and enlightenment, often associated with meditation.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "zen_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After years of practice, she finally achieved a moment of pure <w>zen</w>.",
                            "target_lang_translations": {
                                "ru": "После многих лет практики она наконец достигла момента чистого <w>дзена</w>.",
                                "de": "Nach jahrelanger Übung erlebte sie schließlich einen Moment reiner <w>innerer Ruhe</w>."
                            }
                        },
                        {
                            "text": "Meditation helps the mind reach <w>zen</w> amidst the chaos of daily life.",
                            "target_lang_translations": {
                                "ru": "Медитация помогает разуму достичь <w>дзена</w> посреди хаоса повседневной жизни.",
                                "de": "Meditation hilft dem Geist, inmitten des alltäglichen Chaos <w>Ruhe</w> zu finden."
                            }
                        }
                    ],
                    "synonyms": [
                        "enlightenment"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние спокойной внимательности и просветления, часто ассоциируемое с медитацией.",
                        "de": "Ein Zustand ruhiger Aufmerksamkeit und Erleuchtung, der oft mit Meditation verbunden ist."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дзен",
                                "target_lang_sense_clarification": "состояние"
                            },
                            {
                                "target_lang_word": "просветление",
                                "target_lang_sense_clarification": "духовное состояние"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Zen",
                                "target_lang_sense_clarification": "Zustand innerer Ruhe"
                            },
                            {
                                "target_lang_word": "innere Ruhe",
                                "target_lang_sense_clarification": "seelischer Frieden"
                            },
                            {
                                "target_lang_word": "Erleuchtung",
