                "senses": [
                    {
                        "sense_id": "05abeacc-b874-3c8f-8081-d66c01626efb",
                        "entry_id": "6265f2d4-79bc-327f-b076-14ec7131c895",
                        "glosses": [
                            "свойственный сыну, характерный для него"
