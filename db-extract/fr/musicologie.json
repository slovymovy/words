                "senses": [
                    {
                        "sense_id": "3d05fdf3-2835-367b-92c8-883a63663416",
                        "entry_id": "a462c347-a651-3b5f-ac30-84c03d3727db",
                        "glosses": [
                            "Science de la musique (histoire, esthétique, théorie)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f066500-8b9f-4295-bc70-8cdace9ce761",
                                "sense_id": "3d05fdf3-2835-367b-92c8-883a63663416",
                                "text": "M. Brebisson fils continue avec succès la publication des mousses de la Normandie, collection destinée à faciliter l'étude de la musicologie de la France, et qui se composera de 8 fascicules, in-8° ; prix, 3 fr."
                            },
                            {
                                "example_id": "238b8c4a-2e08-453e-b96d-8af1a1a55dad",
                                "sense_id": "3d05fdf3-2835-367b-92c8-883a63663416",
                                "text": "Monk avait-il de la « technique » ? Notons au passage que le simple énoncé de la question illustre un fait affligeant mais pourtant incontestable : la musicologie est de toutes les sciences d’analyse artistique de loin la plus réactionnaire et obtuse. Questionne-t-on la « technique » du Douanier rousseau ? De Paul Klee ?"
                            },
                            {
                                "example_id": "ee44f235-8a96-40b3-aa40-a4796724a785",
                                "sense_id": "3d05fdf3-2835-367b-92c8-883a63663416",
                                "text": "Ce nouvel et multiple apport a pour effet immédiat de modifier la signification même de la musicologie qui devient dès lors une science multiforme à part entière (ou du moins devrait l’être)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d72c2816-3490-4999-9d93-4691cef64742",
                        "source_entry_id": "a462c347-a651-3b5f-ac30-84c03d3727db",
