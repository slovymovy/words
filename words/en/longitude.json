{
    "word_family": [
        "longitudinal",
        "longitudinally"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1a40e3cf-0a53-3856-bd70-8cbc2821e3d6",
                    "sense_definition": "The angular distance of a place east or west of the prime meridian, usually expressed in degrees and minutes.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "geographic coordinate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The navigator calculated the ship's <w>longitude</w> by comparing local time with the time at the prime meridian."
                        },
                        {
                            "text": "To find the exact location on a map, you must provide both the latitude and the <w>longitude</w>."
                        }
                    ],
                    "common_phrases": [
                        "degrees of longitude",
                        "east longitude",
                        "west longitude"
                    ]
                },
                {
                    "sense_id": "203cc2ec-d0a8-361b-bc29-0dee0d00fd39",
                    "sense_definition": "An imaginary great circle on the Earth's surface passing through the North and South Poles.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "geographic coordinate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Each line of <w>longitude</w> meets at the poles and is widest at the equator."
                        },
                        {
                            "text": "The prime <w>longitude</w> passes through Greenwich, England, serving as the starting point for time zones."
                        }
                    ],
                    "synonyms": [
                        "meridian"
                    ],
                    "common_phrases": [
                        "line of longitude",
                        "terrestrial longitude"
                    ]
                },
                {
                    "sense_id": "18634c6d-eff9-3b14-bedf-8ede2a4454cd",
                    "sense_definition": "The linear extent or measurement of something from end to end; length.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "measurement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The unusual <w>longitude</w> of his limbs made him appear much taller than he actually was."
                        },
                        {
                            "text": "In older texts, the word was sometimes used to describe the great <w>longitude</w> of a physical object."
                        }
                    ],
                    "common_phrases": [
                        "great longitude"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used in modern English to mean physical length"
                        }
                    ]
                }
            ]
        }
    ]
}