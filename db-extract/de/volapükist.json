                ],
                "senses": [
                    {
                        "sense_id": "e991a16b-e6d9-3200-bc88-69884681d6d7",
                        "entry_id": "12d12863-8900-34b3-861b-e14a638307f4",
                        "glosses": [
                            "Person, die die Kunstsprache Volapük beherrscht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c07a177-c754-487e-bf8b-807cc2bda04f",
                                "sense_id": "e991a16b-e6d9-3200-bc88-69884681d6d7",
                                "text": "„Besonders stolz sind die Volapükisten auf ihr Verbum; es hat eine einzige Konjugation und ist absolut regelmäßig gebildet.“"
                            },
                            {
                                "example_id": "88e625f9-6640-49d7-91d4-72b857eec99b",
                                "sense_id": "e991a16b-e6d9-3200-bc88-69884681d6d7",
                                "text": "„Wie etwa der bekannte deutsche Volapükist Rupert Kniele berichtete, weckte der Import von Volapük-Literatur bei den zaristischen Behörden den Verdacht, dass es sich um Propaganda für revolutionäre Ideen handeln könnte.“"
                            },
                            {
                                "example_id": "f0538822-6f0b-4148-bee3-6a366cc8f42e",
                                "sense_id": "e991a16b-e6d9-3200-bc88-69884681d6d7",
                                "text": "„Ein deutscher Volapükist wird also das Wort tiä (Lehre) tit sprechen und damit seinem englischen oder italienischen Kollegen sofort unverständlich werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
