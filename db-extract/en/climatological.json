                    {
                        "translation_id": "9af5efbd-54f5-49e7-ba1c-8df06cc73f2b",
                        "source_entry_id": "6464c247-9662-3707-9201-87fe315bd657",
                        "source_sense_id": "247758f7-4138-3826-ae48-048af4daa2c5",
                        "source_sense_description": "of or pertaining to climatology",
                        "target_lang_word": "klimatologisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "klimatologisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "10ba13ee-fa39-33ef-9032-eb50ce9c54f4",
                                        "entry_id": "e82b94f4-98ce-3a0d-989e-ec3346372898",
                                        "glosses": [
                                            "die Klimatologie betreffend"
                                        ],
                                        "tags": [
                                            "Klimatologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c5a3a962-babe-4fc6-b533-51ac1a7eb8ac",
                                                "sense_id": "10ba13ee-fa39-33ef-9032-eb50ce9c54f4",
                                                "text": "„Auch jede vollständige Landesflora bietet in gesonderter oder gemischter Behandlung diese drei (bez. vier) verschiedenartigen Gesichtspunkte: sie beginnt zumeist mit dem statistischen Katalog aller dort wild wachsenden oder eingeführten Pflanzensippen, erörtert dann die Biologie aller derselben im Anschluss an die durch die geographische Lage gebotene Jahresperiodizität und an die besonderen Bedingungen der orographischen Gliederung und aller klimatologischen Einzelheiten, und sie knüpft daran die Schilderung der die Erdoberfläche und die Meeresküsten bedeckenden Pflanzenbestände von einer bestimmten Physiognomie, welche sich nach der Tracht und Lebensweise der häufigsten und in dichter Geselligkeit vorherrschenden Sippen richtet. Man pflegt den ersten, der Pflanzensystematik entlehnten und das gesamte Sippenmaterial von Ordnungen, Gattungen, Arten darstellenden Teil als \"Flora\" kurz zu bezeichnen, während man die biologischen Eigentümlichkeiten und die hauptsächlich durch letztere in ihrer Allgemeinheit beeinflusste Erscheinungsweise der Pflanzendecke unter \"Vegetation\" zusammenfasst.“"
                                            },
                                            {
                                                "example_id": "8edf98c0-fa7c-4262-8fba-22b484e3bfea",
                                                "sense_id": "10ba13ee-fa39-33ef-9032-eb50ce9c54f4",
                                                "text": "„Würden kosmische Strahlen und Wolkendecke in jedem Sonnenfleckenzyklus einfach zu- und abnähmen, gliche sich die Wirkung klimatologisch gesehen aus, und nichts würde geschehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
