                    }
                ],
                "senses": [
                    {
                        "sense_id": "639a793d-88f9-389e-8c47-2c65ae6d4d29",
                        "entry_id": "5cf63ab8-ab7b-3af2-adee-dd7629b03a2a",
                        "glosses": [
                            "moeite kostend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d1eee07-a94c-4c6e-a473-84579248f7eb",
                                "sense_id": "639a793d-88f9-389e-8c47-2c65ae6d4d29",
                                "text": "De economie maakt een moeizaam herstel door."
                            },
                            {
                                "example_id": "3d0ce512-b964-441b-aaac-90fb291870da",
                                "sense_id": "639a793d-88f9-389e-8c47-2c65ae6d4d29",
                                "text": "Het moeizaam verlopen contact met de Belastingdienst is geen incident. Honderdduizenden Nederlanders kregen de afgelopen jaren te maken met chaotische informatieverstrekking, onjuiste gegevensverwerking en slechte bereikbaarheid"
                            },
                            {
                                "example_id": "3fcb6352-67c9-4452-8a58-73d64f8b2fc7",
                                "sense_id": "639a793d-88f9-389e-8c47-2c65ae6d4d29",
                                "text": "De vrachtwagen vorderde moeizaam en er moest vaak worden gestopt."
                            },
                            {
                                "example_id": "eb9b5ce2-f5d6-4d95-983c-5fcd5b5f05ac",
                                "sense_id": "639a793d-88f9-389e-8c47-2c65ae6d4d29",
                                "text": "Hij schudde zijn hoofd, duwde zijn terrasstoel naar achteren, stond moeizaam op en liep onvast onze woonkamer binnen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "40d8dc39-d862-45a1-958d-3ded8ca2a1f5",
                        "source_entry_id": "5cf63ab8-ab7b-3af2-adee-dd7629b03a2a",
                        "source_sense_id": "639a793d-88f9-389e-8c47-2c65ae6d4d29",
                        "target_lang_word": "mühsam",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mühsam",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c3c94989-f702-334d-8458-db7ca2b96fdf",
                                        "entry_id": "d45affe0-fb3d-3fa9-8eeb-be00b477b4fd",
                                        "glosses": [
                                            "mit viel Mühe verbunden, mit großer Anstrengung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f06a0bd-c76b-4b55-a11e-eca59dd5fb90",
                                                "sense_id": "c3c94989-f702-334d-8458-db7ca2b96fdf",
                                                "text": "Putzen ist eine mühsame Arbeit."
                                            },
                                            {
                                                "example_id": "596538c4-1bbb-4db8-b546-ec69a376a43a",
                                                "sense_id": "c3c94989-f702-334d-8458-db7ca2b96fdf",
                                                "text": "„Der direkte Weg in die Kinderzimmer ist für die Modelleisenbahner nämlich nach wie vor mühsam; nur etwa zehn Prozent des Umsatzes erwirtschaftet Märklin mit Einsteigersets für Kinder.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "17385f57-e49c-4b0f-863b-fc8502ff6742",
                        "source_entry_id": "5cf63ab8-ab7b-3af2-adee-dd7629b03a2a",
                        "source_sense_id": "639a793d-88f9-389e-8c47-2c65ae6d4d29",
                        "target_lang_word": "laborious",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "laborious",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f5cabcb9-8170-38ef-8e8a-8c7ae15456e2",
                                        "entry_id": "ee17816c-e943-3ab5-8bb3-59874374b8ae",
                                        "glosses": [
                                            "Requiring much physical effort; toilsome."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e05c69c4-5a05-4161-b634-5a9c873f813d",
                                                "sense_id": "f5cabcb9-8170-38ef-8e8a-8c7ae15456e2",
                                                "text": "Let us face it, our lives are miserable, laborious, and short."
                                            },
                                            {
                                                "example_id": "e2fbd3dd-c85a-4a30-a26e-5bfdec212501",
                                                "sense_id": "f5cabcb9-8170-38ef-8e8a-8c7ae15456e2",
                                                "text": "The coal is then transferred to broad-gauge wagons for transport to Dublin. The transhipment is a rather laborious business, the coal being shovelled by hand from one wagon to another."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d780b02d-3437-3eb7-bc5d-5c03fe08b164",
                                        "entry_id": "ee17816c-e943-3ab5-8bb3-59874374b8ae",
                                        "glosses": [
                                            "Mentally difficult; painstaking."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d4b034b6-ccb0-3700-aa18-d223eb5a770b",
                                        "entry_id": "ee17816c-e943-3ab5-8bb3-59874374b8ae",
                                        "glosses": [
                                            "Industrious."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b5ff890-02c7-4e11-be0d-55f3f2c0014e",
                                                "sense_id": "d4b034b6-ccb0-3700-aa18-d223eb5a770b",
                                                "text": "All, with united Force, combine to drive / The lazy Drones from the laborious Hive."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e373a2c3-95e5-44d7-b16d-56027c89cacc",
                        "source_entry_id": "5cf63ab8-ab7b-3af2-adee-dd7629b03a2a",
                        "source_sense_id": "639a793d-88f9-389e-8c47-2c65ae6d4d29",
                        "target_lang_word": "with effort",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "fcfaef5d-3db2-4e8c-a679-435a07ec03fb",
                        "source_entry_id": "5cf63ab8-ab7b-3af2-adee-dd7629b03a2a",
                        "source_sense_id": "639a793d-88f9-389e-8c47-2c65ae6d4d29",
                        "target_lang_word": "laborieux",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "laborieux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "42f5ca2b-7a9e-39c6-b7d8-02aaca3b669f",
                                        "entry_id": "3b365aa1-7998-356f-ba16-b4b889c587f8",
                                        "glosses": [
                                            "Qui travaille beaucoup, qui aime le travail."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f39923d-013f-401a-9637-fc527f542f13",
                                                "sense_id": "42f5ca2b-7a9e-39c6-b7d8-02aaca3b669f",
                                                "text": "Le P. du Han était fort laborieux, et l'on peut dire qu'il consomma autant d'huile que de vin pendant le cours de sa vie."
                                            },
                                            {
                                                "example_id": "f5ac0d0d-9653-4d4d-b6c5-7862297794ae",
                                                "sense_id": "42f5ca2b-7a9e-39c6-b7d8-02aaca3b669f",
                                                "text": "C’est aussi l’époque où les écureuils laborieux courent et bondissent partout désespérément, essayant de récolter le maximum de provisions pour tenir durant l’hiver."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e10b7d1e-385d-3fcb-acf6-a5f468359949",
                                        "entry_id": "3b365aa1-7998-356f-ba16-b4b889c587f8",
                                        "glosses": [
                                            "Qui est pénible, qui oblige à beaucoup de travail, de fatigue, d’efforts."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "72188dcf-dd67-46c5-af6d-3e01ad98d553",
                                                "sense_id": "e10b7d1e-385d-3fcb-acf6-a5f468359949",
                                                "text": "L'hôpital est, en effet, dans l'esprit de la solide bourgeoisie, le « couronnement » naturel d'une vie désintéressée de poète et d'une vie laborieuse de pauvre homme."
                                            },
                                            {
                                                "example_id": "4dc95536-1585-4c1f-b28b-f57951d46488",
                                                "sense_id": "e10b7d1e-385d-3fcb-acf6-a5f468359949",
                                                "text": "Cette existence, si laborieuse et si monotone, du marcaire vosgien, au début du XVIIIᵉ siècle, était cependant moins pénible que celle de ses émules de certaines régions des Alpes."
                                            },
                                            {
                                                "example_id": "8dfcbd6c-22c2-482f-9057-51e0dbdb8560",
                                                "sense_id": "e10b7d1e-385d-3fcb-acf6-a5f468359949",
                                                "text": "Certaines thèses avancées par les théoriciens du complot font appel à de nombreux faits troublants que seules de laborieuses analyses poussées pourraient clairement réfuter."
                                            },
                                            {
                                                "example_id": "e8028a25-b143-4c12-80ee-4fc9598f1abd",
                                                "sense_id": "e10b7d1e-385d-3fcb-acf6-a5f468359949",
                                                "text": "Auteurs d’une prestation collective laborieuse, les joueurs parisiens avaient du mal à se montrer réalistes, efficaces, voire même dangereux face aux Gunners."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "37d59c76-ac68-3cf8-9fef-8034e1200b57",
                                        "entry_id": "3b365aa1-7998-356f-ba16-b4b889c587f8",
                                        "glosses": [
                                            "Relatif à la classe sociale des travailleurs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c0089fe-a140-42e8-8a82-f80beb160063",
                                                "sense_id": "37d59c76-ac68-3cf8-9fef-8034e1200b57",
                                                "text": "C'est ainsi que pour Sheila Delany (1987), La Cité des Dames serait l'œuvre d’une misogyne, d’une réactionnaire pudibonde pro censura et d'une exploitante éhontée de la classe laborieuse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9fb2d2e5-efe1-354d-a0eb-06a2a25be220",
                                        "entry_id": "3b365aa1-7998-356f-ba16-b4b889c587f8",
                                        "glosses": [
                                            "Qualifie les productions de l’esprit où l’effort paraît."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
