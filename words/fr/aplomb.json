            "pos": "noun",
            "senses": [
                {
                    "sense_id": "147c4cee-100a-30e2-9e87-c4a6ddec853d",
                    "sense_definition": "Grande assurance dans la manière de se comporter, de s'exprimer ou d'agir.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "attitude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle a répondu à toutes les questions difficiles du jury avec un remarquable <w>aplomb</w>."
                        },
                        {
                            "text": "Le suspect a eu l'<w>aplomb</w> de nier les faits malgré les preuves accablantes présentées par la police."
                        }
                    ],
                    "synonyms": [
                        "assurance",
                        "audace",
                        "sang-froid"
                    ],
                    "antonyms": [
                        "hésitation",
                        "timidité"
                    ],
                    "common_phrases": [
                        "avoir de l'aplomb",
                        "garder son aplomb",
                        "perdre son aplomb"
                    ]
                },
                {
                    "sense_id": "e7aa1b2a-3a12-35e8-8054-a33860c4da4d",
                    "sense_definition": "État d'équilibre et de stabilité d'un corps solide ou d'une construction.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "equilibre",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Avec les infiltrations d'eau répétées, ce vieux mur de pierre a fini par perdre son <w>aplomb</w>."
                        },
                        {
                            "text": "Après avoir trébuché sur la première marche, le danseur a rapidement retrouvé son <w>aplomb</w>."
                        }
                    ],
                    "synonyms": [
                        "équilibre",
                        "stabilité"
                    ],
                    "antonyms": [
                        "déséquilibre",
                        "instabilité"
                    ],
                    "common_phrases": [
                        "perdre son aplomb",
                        "garder son aplomb",
                        "être d'aplomb"
                    ]
                },
                {
                    "sense_id": "852b32cd-cc2d-3506-b1db-f4ab20d18b63",
                    "sense_definition": "Direction verticale perpendiculaire à l'horizon, déterminée à l'aide d'un fil à plomb.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "verticalite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le maçon vérifie méticuleusement l'<w>aplomb</w> de la façade avant de poursuivre la construction."
                        },
                        {
                            "text": "Au zénith, le soleil brille exactement à l'<w>aplomb</w> du clocher du village."
