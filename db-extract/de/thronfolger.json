                "senses": [
                    {
                        "sense_id": "34b92484-6005-3e58-a7be-6413cb27ef3d",
                        "entry_id": "2c99c615-46bb-3348-83e0-18f9b90736ba",
                        "glosses": [
                            "Person, die als Nächste den Thron besteigt/besteigen soll"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0956ba98-ff68-4fe1-8629-d7acc72f1a01",
                                "sense_id": "34b92484-6005-3e58-a7be-6413cb27ef3d",
                                "text": "„Beim Besuch des Thronfolgers in Sarajevo hatte es tatsächlich zwei Angriffe auf Franz Ferdinand und seine Frau Sophie gegeben.“"
                            },
                            {
                                "example_id": "3bf70fbe-5c54-4656-9b2c-e3fce80a24ab",
                                "sense_id": "34b92484-6005-3e58-a7be-6413cb27ef3d",
                                "text": "„Längst hat er daher damit begonnen, Schritt für Schritt sicherzustellen, dass er, der Thronfolger, auch wirklich der nächste Kaiser wird.“"
                            },
                            {
                                "example_id": "cfc45291-eb26-474f-96ee-eb434a295c0f",
                                "sense_id": "34b92484-6005-3e58-a7be-6413cb27ef3d",
                                "text": "„Berg war aufgestanden und zeigte, wie er, die Hand am Mützenschirm, vor den Thronfolger hingetreten war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8dc65e03-1da1-465d-94d6-4279b2f491ca",
                        "source_entry_id": "2c99c615-46bb-3348-83e0-18f9b90736ba",
                        "source_sense_id": "34b92484-6005-3e58-a7be-6413cb27ef3d",
                        "source_sense_description": "Person, die als Nächste den Thron besteigt/besteigen soll",
                        "target_lang_word": "heir apparent",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "heir apparent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1f83ce95-d20c-349e-b8e8-f358c4a6a690",
                                        "entry_id": "5716d03d-226c-3faf-a78e-7bc832072ea0",
                                        "glosses": [
                                            "Someone who will definitely inherit if surviving the one whose property is to be inherited."
                                        ],
                                        "tags": [
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b6b18081-ffd2-41cb-a88d-ed9eefa71107",
                                                "sense_id": "1f83ce95-d20c-349e-b8e8-f358c4a6a690",
                                                "text": "[…] for Mary, though perfectly resolved against ever attaching herself to a younger brother again, was long in finding among the dashing representatives, or idle heir apparents, who were at the command of her beauty, and her 20,000l. any one who could satisfy the better taste she had acquired at Mansfield, whose character and manners could authorise a hope of the domestic happiness she had there learnt to estimate, or put Edmund Bertram sufficiently out of her head."
                                            },
                                            {
                                                "example_id": "7be4262b-9b4d-4c9c-b0f3-7ba653265baf",
                                                "sense_id": "1f83ce95-d20c-349e-b8e8-f358c4a6a690",
                                                "text": "LeBron James, heir apparent to MJ’s throne, seems on paper like a dream trade—he stole plenty of laughs in Trainwreck a few summers ago."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
