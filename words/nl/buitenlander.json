{
    "word_family": [
        "buitenland",
        "buitenlands"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d5f71b1c-cc60-3f43-a416-aa403e41800b",
                    "sense_definition": "Iemand die uit een ander land komt of in een ander land woont.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "herkomst",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In deze internationale stad wonen veel <w>buitenlanders</w> uit verschillende werelddelen.",
                            "target_lang_translations": {
                                "en": "Many <w>foreigners</w> from different continents live in this international city."
                            }
                        },
                        {
                            "text": "Als <w>buitenlander</w> in een nieuw land moet je vaak wennen aan de lokale gewoontes.",
                            "target_lang_translations": {
                                "en": "As a <w>foreigner</w> in a new country, you often have to get used to the local customs."
                            }
                        }
                    ],
                    "synonyms": [
                        "vreemdeling",
                        "uitlander"
                    ],
                    "antonyms": [
                        "landgenoot"
                    ],
                    "common_phrases": [
                        "buitenlander in Nederland",
                        "veel buitenlanders"
                    ],
                    "target_lang_definitions": {
                        "en": "Someone who comes from or lives in another country."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "foreigner",
                                "target_lang_sense_clarification": "a person from a different country"
                            },
                            {
                                "target_lang_word": "alien",
                                "target_lang_sense_clarification": "legal term for a non-citizen"
                            },
                            {
                                "target_lang_word": "expatriate",
                                "target_lang_sense_clarification": "someone living outside their native country"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fc1828ec-fba9-326e-8755-2ab0c34e1b8e",
                    "sense_definition": "Een persoon van niet-Europese afkomst.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "herkomst",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De socioloog deed onderzoek naar de integratie van <w>buitenlanders</w> in de grote steden.",
                            "target_lang_translations": {
                                "en": "The sociologist conducted research into the integration of <w>immigrants</w> in the large cities."
                            }
                        },
                        {
                            "text": "In sommige contexten wordt het woord <w>buitenlander</w> gebruikt voor mensen met een migratieachtergrond.",
                            "target_lang_translations": {
                                "en": "In some contexts, the word <w>foreigner</w> is used for people with a migration background."
                            }
                        }
                    ],
                    "synonyms": [
                        "allochtoon"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Vaak gebruikt in een sociaal-politieke context."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A person of non-European descent or with a migration background."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "immigrant",
                                "target_lang_sense_clarification": "person who has come to live permanently in a foreign country"
                            },
                            {
                                "target_lang_word": "person with a migration background",
                                "target_lang_sense_clarification": "sociological term for someone whose parents were born abroad"
                            },
                            {
                                "target_lang_word": "non-native",
                                "target_lang_sense_clarification": "someone not originally from the local population"
                            }
                        ]
                    }
                }
            ]
        }
    ]
