                        "glosses": [
                            "Qui peut être municipalisé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "21a4c759-a450-43e7-a247-0c91232b8e68",
                                "sense_id": "7702d7fd-8c65-38fe-aca1-1cdb5614e6f7",
                                "text": "L’énumération de l’article 3 n’est pas limitative. Théoriquement, le domaine municipalisable semble atteindre aussi loin que la notion de service public."
                            },
                            {
                                "example_id": "bae17128-e5ba-4446-ada0-e08bdb9b63f3",
                                "sense_id": "7702d7fd-8c65-38fe-aca1-1cdb5614e6f7",
                                "text": "Ou, en d’autres termes, tout ce qui est municipalisable par le détour d’une concession est légal."
                            },
                            {
                                "example_id": "0c5eb8ea-cc04-4d3a-9031-f4cb62290b57",
                                "sense_id": "7702d7fd-8c65-38fe-aca1-1cdb5614e6f7",
                                "text": "C’est sous la poussée de l’évolution sociale et du progrès économique que des services monopolisés par le capitalisme privé deviennent de plus en plus municipalisables et sont municipalisés."
                            }
                        ]
                    }
