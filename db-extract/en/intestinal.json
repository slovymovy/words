                        "examples": [
                            {
                                "example_id": "b1891c7c-6151-4481-bf46-f0f0f71dbaac",
                                "sense_id": "d5f35567-ba27-3ee8-997e-399436102548",
                                "text": "She died as a result of complications after surgery for intestinal bleeding.",
                                "translation": "Sie starb infolge von Komplikationen nach einem operativen Eingriff für eine Darmblutung."
