                        "source_sense_description": "excessive number of occupants in a particular area; specifically, when the number of occupants exceeds the ability of that area to provide for them",
                        "target_lang_word": "surpopulation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "surpopulation",
