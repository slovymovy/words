                    "frequency": "High",
                    "semantic_group_id": "necessite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Si tu ne te reposes pas suffisamment, tu seras <w>forcément</w> fatigué demain matin. Ce n'est pas <w>forcément</w> la meilleure solution pour résoudre ce problème délicat."
                        }
                    ],
                    "synonyms": [
                        "inévitablement",
                        "nécessairement",
                        "obligatoirement",
                        "automatiquement"
                    ],
                    "antonyms": [
