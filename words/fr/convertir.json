                    "sense_definition": "Changer la forme, la nature ou le format d'une chose en une autre.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce logiciel permet de <w>convertir</w> facilement des documents texte en fichiers multimédias."
                        },
                        {
                            "text": "L'usine a réussi à <w>convertir</w> ses déchets industriels en énergie propre pour la ville."
                        }
                    ],
                    "synonyms": [
