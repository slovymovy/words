                "translations": [
                    {
                        "translation_id": "4d98b2fc-8826-4ad5-899d-b1bdffa24f9d",
                        "source_entry_id": "20e88c74-b93a-343d-9ff2-349cd7045475",
                        "source_sense_id": "20da49aa-983b-3775-9536-de64677e00b8",
                        "target_lang_word": "Auktionator",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Auktionator",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d5443b54-2b54-323e-afaf-2afecb495e34",
                                        "entry_id": "aed47f01-22c0-380c-b436-434b0e1f92aa",
                                        "glosses": [
                                            "jemand, der eine Versteigerung, eine Auktion, leitet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70683e6d-4444-4d93-af4e-abc97430558e",
                                                "sense_id": "d5443b54-2b54-323e-afaf-2afecb495e34",
                                                "text": "Der Auktionator kündigte nun das nächste Los an, ein Gemälde von T. Schwablinsky."
                                            },
                                            {
                                                "example_id": "b5d60159-9afc-4219-a2f6-07f4801aff95",
                                                "sense_id": "d5443b54-2b54-323e-afaf-2afecb495e34",
                                                "text": "Das höchste Gebot, dass der Auktionator an dem Tag annahm, waren 35 000 € für eine Halskette."
                                            },
                                            {
                                                "example_id": "24e7cae6-3f6c-480e-a763-a17e9d996f13",
                                                "sense_id": "d5443b54-2b54-323e-afaf-2afecb495e34",
                                                "text": "„Der Auktionator hatte sie betrogen.“"
                                            },
                                            {
                                                "example_id": "48e31b03-b1aa-423d-bd16-d2e03aabefb5",
                                                "sense_id": "d5443b54-2b54-323e-afaf-2afecb495e34",
                                                "text": "„Es war noch zu früh, als wir ankamen; der Auktionator war noch nicht da.“"
                                            },
                                            {
                                                "example_id": "b4910eba-1bf1-4a0f-91e4-e48f4ba23412",
                                                "sense_id": "d5443b54-2b54-323e-afaf-2afecb495e34",
                                                "text": "„Jetzt ruft der Auktionator die Nummer 17 des Programms auf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
