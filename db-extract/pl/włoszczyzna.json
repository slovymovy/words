                "senses": [
                    {
                        "sense_id": "dc127b65-de2f-3232-bd69-82069fc0783e",
                        "entry_id": "49c17014-8926-3cd0-80c8-9a0c7cfc89dd",
                        "glosses": [
                            "warzywa używane do przygotowania zupy lub wywaru z warzyw"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd6f91a5-32f1-4ecf-baf9-bb16d8689a51",
                                "sense_id": "dc127b65-de2f-3232-bd69-82069fc0783e",
                                "text": "Królowa Bona może i była starą zołzą, intrygantką i trucicielką, ale zawdzięczamy jej włoszczyznę i renesans."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "45be2554-dcf6-3786-822c-b373e338fe45",
                        "entry_id": "49c17014-8926-3cd0-80c8-9a0c7cfc89dd",
                        "glosses": [
                            "język włoski"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "369b142f-0e26-4eba-b6be-a9275846a4e3",
                                "sense_id": "45be2554-dcf6-3786-822c-b373e338fe45",
                                "text": "Ojciec opowiadał, że mówił po włosku wyśmienicie. Ale w różnych okolicznościach, po przedłużających się ceremoniach czy przeciągających się posiedzeniach naukowych, akcent jego włoszczyzny twardniał"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "ec962220-4620-3aee-a7a6-ded2eab7f353",
                        "entry_id": "49c17014-8926-3cd0-80c8-9a0c7cfc89dd",
                        "glosses": [
                            "to, co włoskie"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1.3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "551820ea-971a-4fe6-9ba8-092f55f5c505",
                        "source_entry_id": "49c17014-8926-3cd0-80c8-9a0c7cfc89dd",
                        "source_sense_id": "dc127b65-de2f-3232-bd69-82069fc0783e",
                        "target_lang_word": "mirepoix",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mirepoix",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "adeab4bb-f22d-3a2b-a808-4e6fddd961f2",
                                        "entry_id": "c52953a9-8f4f-3e0e-b2c4-0e2496480b7b",
                                        "glosses": [
                                            "A combination of diced onions, carrots, celery and herbs sautéed in oil or butter as used in French cooking."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "747ca2ed-8183-4578-a7da-b16000b91830",
                                                "sense_id": "adeab4bb-f22d-3a2b-a808-4e6fddd961f2",
                                                "text": "The Mirepoix is from this moment complete."
                                            },
                                            {
                                                "example_id": "2bc7d8ed-0e6c-45bb-90cd-b6d41623204c",
                                                "sense_id": "adeab4bb-f22d-3a2b-a808-4e6fddd961f2",
                                                "text": "Trim off superfluous fat, rub over the outside of the meat with salt and flour, and set it upon the mirepoix."
                                            },
                                            {
                                                "example_id": "25dfa581-719d-4611-8909-0ed89407d5bd",
                                                "sense_id": "adeab4bb-f22d-3a2b-a808-4e6fddd961f2",
                                                "text": "Classic seasoning combinations include mirepoix, matignon, marinades, oignon piqué, and oignon brûlé."
                                            },
                                            {
                                                "example_id": "133d753f-a2a0-4541-b05d-e7aedab2fbdb",
                                                "sense_id": "adeab4bb-f22d-3a2b-a808-4e6fddd961f2",
                                                "text": "Most European cultures use a patiently chopped, heated and stirred vegetable mixture, such as a mirepoix or soffritto, always including members of the onion family, and Pollan explores the chemistry of these, as well as their adaptive value."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b2355ca4-4594-36c5-82f0-4591dc5beac6",
                                        "entry_id": "c52953a9-8f4f-3e0e-b2c4-0e2496480b7b",
                                        "glosses": [
                                            "A mixture."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "47aab8b3-18b0-410d-839d-4d1b574c1fa9",
                                                "sense_id": "b2355ca4-4594-36c5-82f0-4591dc5beac6",
                                                "text": "To this mirepoix of contradictory news, add another Pew survey from earlier this month, which found that 54 percent of respondents said they believe that Americans are seeking out more-healthy food than they did 20 years ago—even though they are eating less healthfully than they did in that same timeframe."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
