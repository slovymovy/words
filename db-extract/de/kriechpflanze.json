                ],
                "senses": [
                    {
                        "sense_id": "6db706a6-a12a-3812-a055-76369493d18a",
                        "entry_id": "2569512e-a2c6-395e-b66b-c355d79d811f",
                        "glosses": [
                            "am Boden wachsende, sich nicht nach oben ausbreitende Pflanze"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2270efbd-7637-499d-b57c-0438c0fc4fb3",
                                "sense_id": "6db706a6-a12a-3812-a055-76369493d18a",
                                "text": "„Die Erde war dicht von welkem Laub und gefallenen Zweigen bedeckt, zwischen denen junge Palmen, frische Farne und Kriechpflanzen wuchsen.“"
                            },
                            {
                                "example_id": "d98aca80-adff-44b6-9114-8660a284a736",
                                "sense_id": "6db706a6-a12a-3812-a055-76369493d18a",
                                "text": "„In der relativen Kühle der Gehölze gedeihen mit zynischer Fruchtbarkeit Graurindenreben und Muskatellertrauben, und der Waldboden - übersät mit alten, bemoosten Stämmen, bevölkert mit Giftpilzen, die, fremd und ernst unter den Farnen und Kriechpflanzen, zur Seite geneigt ihre zarten, leberfarbenen Lamellen zeigen - hat etwas Uranfängliches, etwas von einem dampfenden, karbonischen Sumpf, wo in vorgetäuschtem Schlaf vorzeitliche Echsen lauern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3766ee38-bbc4-4bec-be30-91db91fb8db3",
                        "source_entry_id": "2569512e-a2c6-395e-b66b-c355d79d811f",
                        "source_sense_id": "6db706a6-a12a-3812-a055-76369493d18a",
