                        "sense_id": "93e5bfa0-ad40-308b-8f7c-9f8b2d889167",
                        "entry_id": "ffe49eec-282e-3db0-9def-bcc96a9db47a",
                        "glosses": [
                            "Relatif à Niccolò Paganini."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "29cc01ab-e200-4867-ae40-9860116f563d",
                                "sense_id": "93e5bfa0-ad40-308b-8f7c-9f8b2d889167",
                                "text": "Lucide et passionné, Liszt cerne le problème paganinien : psychologique : « quel homme ! » ; musical : « quel artiste ! » ; instrumental : « quel violon ! »."
                            },
                            {
                                "example_id": "82103f18-43c0-4eae-94fd-86b85b06a812",
                                "sense_id": "93e5bfa0-ad40-308b-8f7c-9f8b2d889167",
                                "text": "Stan consulta sa montre, il était presque minuit, le violoniste hirsute se débattait comme un gladiateur, à grand coups d’archet dans la partition paganinienne, quand une détonation retentit du côté de Notre-Dame, une fusée verte explosa en bouquet à la verticale du concert."
                            },
                            {
                                "example_id": "a3b8d65c-8346-41a3-8735-b869b4bbd2fa",
                                "sense_id": "93e5bfa0-ad40-308b-8f7c-9f8b2d889167",
                                "text": "Un luthier, clownesque, découpera des chanterelles \"paganiniennes\" dans les boyaux extrinsèquement vierges."
                            }
                        ]
                    }
                ],
