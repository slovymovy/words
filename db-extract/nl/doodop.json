                "senses": [
                    {
                        "sense_id": "85060b5d-009c-332a-ab50-b30ab3431f67",
                        "entry_id": "38ad3b8b-cb23-35e9-a6e6-3f1583928afe",
                        "glosses": [
                            "zo sterk vermoeid dat men in levensgevaar of althans gevaar voor de gezondheid is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc8e8e40-406e-4866-88cc-64151b27b5f9",
                                "sense_id": "85060b5d-009c-332a-ab50-b30ab3431f67",
                                "text": "Hij veroorzaakte een verkeersongeluk omdat hij doodop was van die lange reis en toch achter het stuur klom."
                            },
                            {
                                "example_id": "6bd39df7-8e19-4d94-9f13-6bce8b3db659",
                                "sense_id": "85060b5d-009c-332a-ab50-b30ab3431f67",
                                "text": "Toen ik voor de laatste keer mijn tent in de gierende wind en sneeuw opzette, trok ik al mijn natte kleren uit en kroop naakt mijn slaapzak in om weer op temperatuur te komen. Ik was doodop en kon niet geloven dat het morgen na al die maanden voorbij zou zijn."
                            }
                        ]
                    }
