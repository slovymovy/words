                ],
                "senses": [
                    {
                        "sense_id": "31861a47-e173-3af8-aeee-f5b1d0330949",
                        "entry_id": "38559946-a7a8-3edd-bc5a-b713808fc16f",
                        "glosses": [
                            "meist dem Apostel Philippus ^(→ WP) geweihtes Gotteshaus"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2bbebe91-ccad-4ce8-b552-b9e4982238ee",
                                "sense_id": "31861a47-e173-3af8-aeee-f5b1d0330949",
                                "text": "„‚Beim Bau der Philippuskirche 1963 gehörten der Gemeinde im Osten Frankfurts 4000 Mitglieder an, heute sind es 1350.“"
                            },
                            {
                                "example_id": "eceabc48-0e8f-4ba6-83a5-6d770b56f413",
                                "sense_id": "31861a47-e173-3af8-aeee-f5b1d0330949",
                                "text": "„‚Sie spricht über das Thema vor Schülern und in der Philippuskirche vor Besuchern.“"
                            },
                            {
                                "example_id": "c6e294d0-ad97-4a63-9264-623668437727",
                                "sense_id": "31861a47-e173-3af8-aeee-f5b1d0330949",
                                "text": "„Zum Auftakt der Predigtreihe in der Fastenzeit ‚Kirche in der Stadt – Gemeinde für den Stadtteil‘ in der evangelischen Philippuskirche, Raiffeisenstraße 70, tritt am morgigen Sonntag, 22. Februar, um 17 Uhr der Frankfurter Oberbürgermeister Peter Feldmann (SPD) vor die Gemeinde.“"
                            },
                            {
                                "example_id": "1a415882-078a-44ce-b4ce-9c9433bc0326",
                                "sense_id": "31861a47-e173-3af8-aeee-f5b1d0330949",
                                "text": "„‚Mitglieder der evangelischen Gemeinde Gröpelingen und Oslebshausen feierten ihren vorerst letzten Gottesdienst in der Philippuskirche an der Seewenjestraße, die in den 1960er Jahren gebaut wurde.“"
                            },
                            {
                                "example_id": "bd6d1bab-e1ec-4a8e-ad29-d97d8b9c6ddb",
                                "sense_id": "31861a47-e173-3af8-aeee-f5b1d0330949",
                                "text": "„Seit der Entwidmung Ende Oktober 2005 steht das Schicksal der Kirche fest. Die Gemeinde hatte sich aus Personal- und Kostengründen für die Philippuskirche entschieden.“"
                            },
                            {
                                "example_id": "8b605a94-57d4-4c70-a650-3c0876b140f3",
                                "sense_id": "31861a47-e173-3af8-aeee-f5b1d0330949",
                                "text": "„‚Pfarrerin Anne Bickhardt war seit dem 1. Oktober 2001 in der Philippuskirche Markt Schwaben tätig, bis zur Verselbständigung Poings im Jahr 2009 auch für die Christuskirche Poing.“"
                            },
                            {
                                "example_id": "9055ef0f-0209-40b7-b269-d9308bea9e3c",
                                "sense_id": "31861a47-e173-3af8-aeee-f5b1d0330949",
                                "text": "„‚Seit dem Jahr 2004 versteht sich die Wehlener Philippuskirche als Radfahrerkirche.“"
                            },
                            {
                                "example_id": "69dcf418-1f94-4215-bee5-35af1fa6e516",
                                "sense_id": "31861a47-e173-3af8-aeee-f5b1d0330949",
                                "text": "„‚In der Philippuskirche, nicht weit von hier, habe ich oft gelesen.“"
                            },
                            {
                                "example_id": "30d7f628-cf1b-443a-b114-0f2f8d325fdc",
                                "sense_id": "31861a47-e173-3af8-aeee-f5b1d0330949",
                                "text": "„‚Die hübsche Philippuskirche ist in den vergangenen Jahren umfangreich saniert worden.“"
                            },
                            {
                                "example_id": "37416eff-ef11-4c4e-9dc4-feaf30fb8d71",
                                "sense_id": "31861a47-e173-3af8-aeee-f5b1d0330949",
                                "text": "„Wasser war das Thema des Familiengottesdienstes in der Philippuskirche in Schöneberg.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
