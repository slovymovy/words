                        "entry_id": "a3426c69-15e0-3954-8fc0-f2d5339d06f9",
                        "glosses": [
                            "Qui désire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "00fbc3fe-d981-4329-a74c-ec88078782ea",
                                "sense_id": "ba03f1b0-aee2-3143-94ce-281c6bc2298c",
                                "text": "Ces temps d’échange s’adressaient aux structures de l’économie sociale et solidaire (ESS) mais également aux acteurs hors ESS, privés ou publics, désireux de connaître et de collaborer avec des entreprises de l’ESS."
                            },
                            {
                                "example_id": "fe1a69fc-bedf-4537-8cc5-f94601f12a8c",
                                "sense_id": "ba03f1b0-aee2-3143-94ce-281c6bc2298c",
                                "text": "L'argent a toujours été un problème. Mais avec Elliott plus que désireux d'aider... Je sais que c'est dur pour toi d'accepter de l'aide."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bdddd446-2e59-4c59-bad2-6e38edbad5f2",
                        "source_entry_id": "a3426c69-15e0-3954-8fc0-f2d5339d06f9",
                        "source_sense_id": "ba03f1b0-aee2-3143-94ce-281c6bc2298c",
                        "target_lang_word": "eager (for+nom,.to+verbe)",
                        "target_lang_code": "en",
