                            "comment": "technical medical term"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к начальной стадии разрушения зуба или кариесу.",
                        "tr": "Başlangıç aşamasındaki diş çürümesi veya çürük ile ilgili."
                    },
                    "translations": {
