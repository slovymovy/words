                ],
                "translations": [
                    {
                        "translation_id": "65d7f9b7-451a-4e5a-935e-21dc25d3e7bd",
                        "source_entry_id": "b1fb4930-dc15-3ee0-a9f7-cd9e02dbecb7",
                        "source_sense_id": "114934d3-cadf-3824-a4b9-a50831a18ea9",
                        "target_lang_word": "schüchtern",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "schüchtern",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "77147b11-6d41-3a2e-b10f-f475de4e1f28",
                                        "entry_id": "fd2c0037-da84-39ab-8888-265a85c4d156",
                                        "glosses": [
                                            "anderen gegenüber gehemmt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b17166fb-fcb0-4d26-be15-2096407f90a3",
                                                "sense_id": "77147b11-6d41-3a2e-b10f-f475de4e1f28",
                                                "text": "„Dreimal hebt das Mädchen zögernd an, und nur schüchtern, aber desto überzeugender kommt über ihre Lippen, was sie sagen will oder sagen muß, bis es am Ende, wenn auch kaum ausgesprochen, doch ganz deutlich geworden ist.“"
                                            },
                                            {
                                                "example_id": "3970fa67-8b64-44dc-b885-8ae10cc28a3e",
                                                "sense_id": "77147b11-6d41-3a2e-b10f-f475de4e1f28",
                                                "text": "„Was die Kinder angeht, so sind sie in der fremden Umgebung und infolge der sprachlichen Schwierigkeiten in der Unterhaltung mit den schottischen Damen und Herren zunächst schüchtern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d8890274-fee5-44df-8247-8f0387d092be",
                        "source_entry_id": "b1fb4930-dc15-3ee0-a9f7-cd9e02dbecb7",
                        "source_sense_id": "114934d3-cadf-3824-a4b9-a50831a18ea9",
                        "target_lang_word": "tímido",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tímido",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "38e648e4-b9e0-3e85-a7b3-7a756ba82144",
                                        "entry_id": "ee9ba3d0-27e6-3b7c-8d65-ef11fda9861f",
                                        "glosses": [
                                            "Que reacciona de forma insegura y con vergüenza ante el contacto o la presencia de otros, que siente timidez."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "191634cf-bc88-4b16-998e-8e7144bdbb81",
                                                "sense_id": "38e648e4-b9e0-3e85-a7b3-7a756ba82144",
                                                "text": "Como era tímido, cuando se le hablaba no encontraba respuesta y permanecía silencioso o respondía mal."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6ef32e1a-7023-34cc-8b47-955db95691b0",
                                        "entry_id": "ee9ba3d0-27e6-3b7c-8d65-ef11fda9861f",
                                        "glosses": [
                                            "Relativo a la timidez o propio de ella."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c31f240a-0263-4d75-b59d-f9e1be5ef518",
                                                "sense_id": "6ef32e1a-7023-34cc-8b47-955db95691b0",
                                                "text": "Tener un carácter tímido."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "df3b05f0-4acd-3f81-a4a5-34ed87d2bf3a",
                                        "entry_id": "ee9ba3d0-27e6-3b7c-8d65-ef11fda9861f",
                                        "glosses": [
                                            "Se dice del fenómeno que se manifiesta débilmente."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff4c6b6c-a1fd-46b9-a36a-cc011f427de8",
                                                "sense_id": "df3b05f0-4acd-3f81-a4a5-34ed87d2bf3a",
                                                "text": "Un tímido sol se asomó entre las nubes."
                                            }
                                        ],
