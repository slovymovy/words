                        "entry_id": "5a9f0e7a-e7e5-326b-bad6-e1b045720bb4",
                        "glosses": [
                            "Grande libellule du genre Aeshna."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "01961f28-d682-4903-a2be-dda101709ee8",
                                "sense_id": "e953870a-d753-3b86-a1c4-3ec29638fd63",
                                "text": "Parfois, un æschne énorme vrombissant, passait dans un rai de soleil. Le vieux le suivait du regard."
                            },
                            {
                                "example_id": "6970f9fa-e679-4a81-ba75-a8dc29b297fd",
                                "sense_id": "e953870a-d753-3b86-a1c4-3ec29638fd63",
                                "text": "J'ai trouvé en France un æshne que l'on pourroit prendre pour une variété de la précédente, par la masse des rapports ; mais les côtés du corselet, sous les ailes, ont une ligne et deux taches noires très-distinctes ; l'abdomen est plus menu."
                            }
                        ]
                    }
