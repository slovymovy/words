                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3d708997-54b0-4392-9aaa-6ce064659518",
                        "source_entry_id": "ba62fae6-8c93-3e77-8860-caa681344c57",
                        "source_sense_id": "321b180d-35b7-3889-81d4-110c1b008fd1",
                        "target_lang_word": "oposicionista",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "bed2fb36-6069-42ac-a4c5-eccf2d32af76",
                        "source_entry_id": "ba62fae6-8c93-3e77-8860-caa681344c57",
                        "source_sense_id": "321b180d-35b7-3889-81d4-110c1b008fd1",
                        "target_lang_word": "Oppositions-",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "a03f1a86-d43e-4666-9a68-8831a88d405d",
                        "source_entry_id": "ba62fae6-8c93-3e77-8860-caa681344c57",
                        "source_sense_id": "321b180d-35b7-3889-81d4-110c1b008fd1",
                        "target_lang_word": "oppositionell",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "oppositionell",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0ec01479-70c4-3f4c-b1b1-6cf1cc117141",
                                        "entry_id": "72fc6579-fe19-3863-8f2b-6a7d81d0a4de",
                                        "glosses": [
                                            "zu den politischen Parteien gehörend, die nicht die Regierung stellen (= der Opposition), gegen die Positionen der aktuellen Regierung; zu den Personen/Gruppen gehörend, die die herrschenden Personen und deren System der Machterhaltung ablehnen"
                                        ],
                                        "tags": [
                                            "in Demokratien",
                                            "von anderen Organisationen/Medien",
                                            "in autoritären Systemen/Diktaturen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "78af851a-4ff5-44ab-ad2c-832d327d4bfb",
                                                "sense_id": "0ec01479-70c4-3f4c-b1b1-6cf1cc117141",
                                                "text": "„Erst die Aussicht der oppositionellen Minderheit, bei künftigen Wählerstimmengewinnen zur Mehrheit zu werden, garantiert die volle Funktionsfähigkeit einer Demokratie.“"
                                            },
                                            {
                                                "example_id": "34bc395d-907f-43f0-a800-41eafdc9067b",
                                                "sense_id": "0ec01479-70c4-3f4c-b1b1-6cf1cc117141",
                                                "text": "[17. Dezember 1917:] „Kandidaten der oppositionellen Liberalen Partei, die zu ihrem Parteivorsitzenden Wilfrid Laurier halten, werden überwiegend in der französischsprachigen Provinz Québec gewählt, wo die Wehrpflicht auf einhellige Ablehnung stößt.“"
                                            },
                                            {
                                                "example_id": "93522606-7f44-4a8f-8c48-b640f91c8f05",
                                                "sense_id": "0ec01479-70c4-3f4c-b1b1-6cf1cc117141",
                                                "text": "[Bundespräsidentenwahl 1968:] „Als der SPD-Mann [Anmerkung: Gustav Heinemann] mithilfe der oppositionellen FDP gewählt wird, ist für Kiesinger klar: Die Große Koalition ist am Ende.“"
                                            },
                                            {
                                                "example_id": "c444d98c-5d39-4610-8466-e07f074ed5a6",
                                                "sense_id": "0ec01479-70c4-3f4c-b1b1-6cf1cc117141",
                                                "text": "„Die oppositionelle CDU forderte vom rot-grünen Senat prompt eine einheitliche Richtlinie.“"
                                            },
                                            {
                                                "example_id": "45150b7b-cca9-4857-b909-185d049e47bd",
                                                "sense_id": "0ec01479-70c4-3f4c-b1b1-6cf1cc117141",
                                                "text": "[Bundesrepublik, 1952:] „Mit der Montanunion forcierte Adenauer zudem die von ihm angestrebte Westbindung. Die oppositionelle SPD hingegen wünschte sich lieber ein neutrales Deutschland.“"
                                            },
                                            {
                                                "example_id": "cd301c63-9552-4d70-a04e-fd3d25578cda",
                                                "sense_id": "0ec01479-70c4-3f4c-b1b1-6cf1cc117141",
                                                "text": "„Die folgenden Gegendemonstrationen wurden vom Militär auf ihren Befehl hin niedergeschossen und oppositionelle Führer inhaftiert.“"
                                            },
                                            {
                                                "example_id": "315730e4-244c-41fa-82de-47513194cbab",
                                                "sense_id": "0ec01479-70c4-3f4c-b1b1-6cf1cc117141",
                                                "text": "[DDR:] „Bei den Kommunalwahlen am 7. Mai 1989 gelang es oppositionellen Gruppen erstmals zu belegen, dass die Wahlergebnisse manipuliert waren.“"
                                            },
                                            {
                                                "example_id": "fab83ccf-eb74-4bd7-893c-aa0cbfa1fb21",
                                                "sense_id": "0ec01479-70c4-3f4c-b1b1-6cf1cc117141",
                                                "text": "[DDR:] „Ab Ende der 1970er Jahre entstanden erste oppositionelle Gruppen. Besonders misstrauisch beobachtete das SED-Regime die inoffizielle Friedens- und Umweltbewegung, die sich mit Unterstützung der Kirche bildete.“"
                                            },
                                            {
                                                "example_id": "2218d1fd-0dee-47b0-837e-8cf7ab4d62dc",
                                                "sense_id": "0ec01479-70c4-3f4c-b1b1-6cf1cc117141",
                                                "text": "[DDR:] „So kann zum Beispiel eine Bürgerin, die sich in der oppositionellen Friedensbewegung engagiert, mit der Anwendung von Paragraph 249 als \"Asoziale\" im Gefängnis landen.“"
                                            },
                                            {
                                                "example_id": "331844e1-085e-40c0-8c3b-7a9c0ce8ef2b",
                                                "sense_id": "0ec01479-70c4-3f4c-b1b1-6cf1cc117141",
                                                "text": "[Weiße Rose, 1942:] „Die Medizinstudentin Traute Lafrenz hatte bereits im November 1942 Flugblätter von München nach Hamburg mitgebracht. Ihr Freund Heinz Kucharski, ein Student der Philosophie und Orientalistik, verteilte sie dort mit Hilfe anderer oppositioneller Studenten.“"
                                            },
                                            {
                                                "example_id": "93e7f757-1a85-40f8-b537-33664bdc0de9",
                                                "sense_id": "0ec01479-70c4-3f4c-b1b1-6cf1cc117141",
                                                "text": "„In den Kellerräumen wurden illegale Untergrundzeitungen gedruckt und [an] oppositionelle Kreise […] weitergegeben.“"
                                            },
                                            {
                                                "example_id": "7c90090d-df1c-4103-8a9d-42218664ab1e",
                                                "sense_id": "0ec01479-70c4-3f4c-b1b1-6cf1cc117141",
                                                "text": "[Taiwan:] „Jegliche oppositionelle Regungen wurden rigoros unterdrückt.“"
                                            },
                                            {
                                                "example_id": "3ab1302d-fd9d-4a53-b93a-9253171b334c",
                                                "sense_id": "0ec01479-70c4-3f4c-b1b1-6cf1cc117141",
                                                "text": "„Im Sommer 1922 tritt Clara Zetkin für die Komintern als Anklägerin im 1. Moskauer Schauprozess auf und verlangt hohe Bestrafungen für eine Gruppe von oppositionellen Sozialrevolutionären.“"
                                            },
                                            {
                                                "example_id": "2f2136e7-3494-467f-bdbb-96dac0470403",
                                                "sense_id": "0ec01479-70c4-3f4c-b1b1-6cf1cc117141",
                                                "text": "[Karl Marx:] „Geboren in Trier als Sohn eines Anwalts, vertritt er bereits als Chefredakteur der oppositionellen \"Rheinischen Zeitung\" radikale Standpunkte und legt sich mit der preußischen Obrigkeit an.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9adb2f17-8158-3f19-b404-f7ce9f29130f",
                                        "entry_id": "72fc6579-fe19-3863-8f2b-6a7d81d0a4de",
                                        "glosses": [
                                            "widerständig sein, eine ablehnende oder gegensätzliche Haltung zu etwas einnehmend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f0a02f6-7da8-4726-8afa-b09aab1393c8",
                                                "sense_id": "9adb2f17-8158-3f19-b404-f7ce9f29130f",
                                                "text": "„Störung des Sozialverhaltens mit oppositionellem, aufsässigen Verhalten: Typisch ist diese Form der Störung bei Kindern unter 10 Jahren.“"
                                            },
                                            {
                                                "example_id": "f8be1dd3-7af6-47fa-a36f-f9e32cbf301a",
                                                "sense_id": "9adb2f17-8158-3f19-b404-f7ce9f29130f",
                                                "text": "„Legt man die akzeptierten diagnostischen Standards zugrunde, dann liegen die Prävalenzraten für Störungen des Sozialverhaltens bei 2–10 % und für Störungen mit oppositionellem Trotzverhalten bei 1–11 %.“"
                                            },
                                            {
                                                "example_id": "07efa396-aa04-42f3-ab77-b2ab803ba02a",
                                                "sense_id": "9adb2f17-8158-3f19-b404-f7ce9f29130f",
                                                "text": "Oppositionelle und dissoziale Verhaltensstörungen zählen zu den häufigsten Vorstellungsanlässen in kinderpsychiatrischen und -psychotherapeutischen Einrichtungen."
                                            },
                                            {
                                                "example_id": "4ce0e9f4-8f88-4579-b88e-059bfdbf5428",
                                                "sense_id": "9adb2f17-8158-3f19-b404-f7ce9f29130f",
                                                "text": "[Heimskandal in Brandenburg – Tod im Kinderheim:] „Weiter heißt es rechtfertigend, dass sie mit »oppositionellem Trotzverhalten und eigengefährdendem Verhalten reagierte«.“"
                                            },
                                            {
                                                "example_id": "da9d9035-544c-417a-9432-aaf5ec3f53b3",
                                                "sense_id": "9adb2f17-8158-3f19-b404-f7ce9f29130f",
                                                "text": "„Beatrice Gnaegi, psychosoziale Beraterin und Autismus-Expertin, beschreibt die zwei Haupttypen folgendermassen: Der oppositionelle Typ stört in der Schule und wird auffällig, Abklärungen kommen oft auf Anraten der Lehrpersonen in Gang. Der ruhige Typ hingegen «funktioniert» in der Schule, weiss, was von ihm verlangt wird, […].“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
