                "senses": [
                    {
                        "sense_id": "61d4beb2-abad-3b85-a17e-edab76d828dc",
                        "entry_id": "77d31add-1c1d-32a6-88f0-26c3c0260412",
                        "glosses": [
                            "Qui effare."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "667a1363-54a0-4d40-b683-9f09d122a8cb",
                                "sense_id": "61d4beb2-abad-3b85-a17e-edab76d828dc",
                                "text": "Mais il y a folkloristes et folkloristes. J'en ai vu de singuliers, quelques-uns d’effarants. On se fait un folklore à sa convenance. On attend des fées. On part à leur rencontre, le bâton de pèlerin à la main."
                            },
                            {
                                "example_id": "036a5a4d-ba35-4c1d-b96e-ee734b9e7b5b",
                                "sense_id": "61d4beb2-abad-3b85-a17e-edab76d828dc",
                                "text": "Le Journal de Montréal documente ces jours-ci l’effarant déclin du français dans la région métropolitaine."
                            }
                        ]
                    },
                    {
                        "sense_id": "3b6421ef-34e9-3611-b71e-0c24ca626a7b",
                        "entry_id": "77d31add-1c1d-32a6-88f0-26c3c0260412",
                        "glosses": [
                            "Extrême."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "64852a2a-7150-4813-b4b7-19a23ed5625c",
                                "sense_id": "3b6421ef-34e9-3611-b71e-0c24ca626a7b",
                                "text": "La structure du message est toujours la même, dans son effarante simplicité."
                            }
                        ]
