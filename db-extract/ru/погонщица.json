                ],
                "senses": [
                    {
                        "sense_id": "d51f73ac-1c40-3e8f-98cd-639291d9d476",
                        "entry_id": "e9791e4f-da45-3a76-997b-cb8a035bf199",
                        "glosses": [
                            "женск. к погонщик"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d1e8b055-be8c-43ad-86c4-5f918d05b5c9",
                                "sense_id": "d51f73ac-1c40-3e8f-98cd-639291d9d476",
                                "text": "Расстегнув палаточные молнии и выбравшись наружу, американцы увидели рядом погонщицу стада, которая копалась в их пожитках."
                            },
                            {
                                "example_id": "e63d5bc7-4ba1-4f77-b282-4598cfaa9222",
                                "sense_id": "d51f73ac-1c40-3e8f-98cd-639291d9d476",
                                "text": "Весело звенели колокольчики на косматых шеях, резкие гортанные крики погонщицы, а также удары палкой заставляли зверей двигаться быстрее."
                            }
                        ]
                    }
