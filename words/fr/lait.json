            "pos": "noun",
            "senses": [
                {
                    "sense_id": "57e762db-0641-301a-a9c6-9d50671ef0f6",
                    "sense_definition": "Liquide blanc et nutritif produit par les glandes mammaires des femelles de mammifères, consommé comme aliment ou boisson.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "alimentation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Chaque matin, je bois un bol de café au <w>lait</w> avec des tartines."
                        },
                        {
                            "text": "N'oublie pas d'acheter une bouteille de <w>lait</w> frais en rentrant du travail."
                        }
                    ],
                    "common_phrases": [
                        "café au lait",
                        "verre de lait",
                        "bouteille de lait",
                        "lait de vache"
                    ]
                },
                {
                    "sense_id": "6fdf8001-d682-3dd3-bc09-d1037ba45569",
                    "sense_definition": "Boisson ou émulsion d'origine végétale dont la consistance ou la couleur rappelle celle du lait d'origine animale.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "alimentation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle préfère ajouter du <w>lait</w> d'amande dans ses céréales pour le petit déjeuner."
                        },
                        {
                            "text": "Ce curry traditionnel est préparé avec des épices et du <w>lait</w> de coco."
                        }
                    ],
                    "common_phrases": [
                        "lait d'amande",
                        "lait de coco",
                        "lait de soja"
                    ]
                },
                {
                    "sense_id": "8563381f-e2e2-3536-8f4b-5a14335db00b",
                    "sense_definition": "Émulsion fluide utilisée pour nettoyer, hydrater ou protéger la peau.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "cosmetique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après la douche, elle applique toujours un <w>lait</w> hydratant sur tout le corps."
                        },
                        {
                            "text": "Ce <w>lait</w> démaquillant nettoie la peau en douceur sans irriter les yeux."
                        }
                    ],
                    "common_phrases": [
