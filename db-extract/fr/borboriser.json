                "senses": [
                    {
                        "sense_id": "58d1b43a-596b-3761-b0d3-e7a5d0e86dfc",
                        "entry_id": "fa483b3b-b1a9-3761-b230-e7371aac95d9",
                        "glosses": [
                            "Administrer du borbor à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2729c89d-14b5-4c82-9998-5a9314ad4d2b",
                                "sense_id": "58d1b43a-596b-3761-b0d3-e7a5d0e86dfc",
                                "text": "Je me suis laissé abrutir, borboriser par cette Targuia…"
                            },
                            {
                                "example_id": "c799e826-5766-4f4e-873f-8838213644c1",
                                "sense_id": "58d1b43a-596b-3761-b0d3-e7a5d0e86dfc",
                                "text": "Que Tâllit borborise Brevannes prouve surtout qu’elle n’est pas sûre de lui, de ses sentiments, de sa fidélité."
                            },
                            {
                                "example_id": "4fda258d-6111-4a37-8b68-feb32b30945d",
                                "sense_id": "58d1b43a-596b-3761-b0d3-e7a5d0e86dfc",
                                "text": "On continue à t’appâter et à te borboriser. Petit à petit ton manque de réaction augmente, ta volonté diminue."
                            }
                        ]
                    }
