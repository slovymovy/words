                        ],
                        "examples": [
                            {
                                "example_id": "3e7bc6b6-0ad2-42e6-90f2-9157ef49f0df",
                                "sense_id": "895947e4-3199-3c41-a351-8c87d4a6bd26",
                                "text": "By 1969, the flower district had under cultivation over 13 hectares of rosebeds alone, 10,000 pots of osmanthus, 50,000 pots of magnolias, camellias and jasmine and several hundred thousand pots of chrysanthemums, as well as thousands of pine, pomegranate and iron trees."
                            }
