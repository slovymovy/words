                                    {
                                        "sense_id": "51db246f-f440-308e-85df-89bce6f68967",
                                        "entry_id": "54d1f8aa-03cb-3ba5-86d5-cbf1f10ab858",
                                        "glosses": [
                                            "The quality of being changeable; changeableness."
