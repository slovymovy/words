                    "frequency": "High",
                    "semantic_group_id": "ingestion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Prends un grand verre d'eau pour <w>avaler</w> ce comprimé plus facilement."
                        },
                        {
                            "text": "L'enfant a toussé fort après avoir <w>avalé</w> de travers en buvant son jus."
                        }
                    ],
                    "synonyms": [
                        "déglutir",
                        "ingérer"
                    ],
                    "antonyms": [
                        "recracher",
                        "vomir"
                    ],
                    "common_phrases": [
