                                "pl": "Ochroniarz był postawnym <w>facetem</w>, który zatrzymywał każdego przy drzwiach.",
                                "de": "Der Türsteher war ein breiter <w>Kerl</w>, der jeden an der Tür aufhielt.",
                                "fr": "Le videur était un <w>costaud</w> qui arrêtait tout le monde à la porte.",
                                "it": "Il buttafuori era un <w>tipo robusto</w> che fermava tutti alla porta.",
                                "cs": "Vyhazovač byl široký <w>pořízek</w>, který každého u dveří zastavil.",
                                "tr": "Kapıdaki görevli, herkesi durduran iri yarı bir <w>adamdı</w>.",
                                "es": "El portero era un <w>tipo</w> ancho que detenía a todos en la puerta.",
                                "zh": "那个保镖是个身材魁梧的<w>壮汉</w>，把所有人都拦在门口。"
                            }
                        }
