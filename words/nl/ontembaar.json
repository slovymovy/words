                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "untamable",
                                "target_lang_sense_clarification": "impossible to restrain or control"
                            },
                            {
                                "target_lang_word": "indomitable",
                                "target_lang_sense_clarification": "impossible to subdue or defeat"
                            },
                            {
                                "target_lang_word": "uncontrollable",
                                "target_lang_sense_clarification": "cannot be managed or reined in"
                            },
                            {
                                "target_lang_word": "unruly",
                                "target_lang_sense_clarification": "disorderly and uncontrollable"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8f774f03-0e0a-32fa-92c0-32528348f83d",
                    "sense_definition": "niet tam te maken of te domesticeren",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "dieren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Veel wilde roofdieren blijven zelfs in gevangenschap volkomen <w>ontembaar</w>.",
                            "target_lang_translations": {
                                "en": "Many wild predators remain completely <w>untamable</w> even in captivity."
                            }
                        },
                        {
                            "text": "Een zebra bleek door zijn schrikachtige karakter een vrijwel <w>ontembaar</w> dier te zijn.",
                            "target_lang_translations": {
                                "en": "Due to its skittish nature, a zebra proved to be an almost <w>untamable</w> animal."
                            }
                        }
                    ],
                    "synonyms": [
                        "onhandelbaar"
                    ],
                    "antonyms": [
                        "tembaar"
                    ],
                    "common_phrases": [
                        "ontembaar dier"
                    ],
                    "target_lang_definitions": {
                        "en": "incapable of being tamed or domesticated"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "untamable",
                                "target_lang_sense_clarification": "incapable of being domesticated"
