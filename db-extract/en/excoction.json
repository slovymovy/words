                        "examples": [
                            {
                                "example_id": "bac33a6c-365e-4662-a102-25c81c893ffb",
                                "sense_id": "b708d695-d30c-3174-8046-d84fa56920bd",
                                "text": "For in the excoctions and depurations of Metalls it is a familiar error that to advance excoction , they augment the heate of the Fornace , or the Quantity of the Iniection"
                            },
                            {
                                "example_id": "20205586-715c-4bcf-a51e-99b3121fef92",
                                "sense_id": "b708d695-d30c-3174-8046-d84fa56920bd",
                                "text": "This much is in agreement with what many earlier mechanists had recognized, but Leigniz adds a further principle from the chemical tradition, arguing that it is not just a hydraulico-pneumatical machine, but also a 'pyrotechnical' machine, to the extent that its first motion is generated out of the production of heat in the excoction of chyle from the aliment it takes in."
                            }
                        ]
