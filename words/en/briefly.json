                {
                    "sense_id": "e82da8f4-d89e-38d4-baf5-3b8c95af90d5",
                    "sense_definition": "Used to introduce a summary or a short explanation of something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "discourse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Briefly</w>, the plan is to reduce costs by optimizing our supply chain.",
                            "target_lang_translations": {
                                "ru": "<w>Короче говоря</w>, план состоит в том, чтобы сократить расходы за счет оптимизации нашей цепочки поставок.",
                                "zh": "<w>简而言之</w>，该计划旨在通过优化供应链来降低成本。",
                                "nl": "<w>Kortom</w>, het plan is om de kosten te verlagen door onze toeleveringsketen te optimaliseren.",
                                "pl": "<w>Krótko mówiąc</w>, plan polega na obniżeniu kosztów poprzez optymalizację naszego łańcucha dostaw.",
                                "de": "<w>Kurz gesagt</w> besteht der Plan darin, die Kosten durch die Optimierung unserer Lieferkette zu senken.",
                                "fr": "<w>En bref</w>, le plan consiste à réduire les coûts en optimisant notre chaîne d'approvisionnement.",
                                "it": "<w>In breve</w>, il piano consiste nel ridurre i costi ottimizzando la nostra catena di distribuzione.",
                                "cs": "<w>Zkrátka</w>, plánem je snížit náklady optimalizací našeho dodavatelského řetězce.",
                                "tr": "<w>Kısacası</w>, plan tedarik zincirimizi optimize ederek maliyetleri düşürmektir.",
                                "es": "<w>En resumen</w>, el plan es reducir los costos optimizando nuestra cadena de suministro."
                            }
                        },
                        {
                            "text": "To put it <w>briefly</w>, the project was a huge success despite the initial problems.",
                            "target_lang_translations": {
                                "ru": "Если говорить <w>кратко</w>, проект имел огромный успех, несмотря на первоначальные проблемы.",
                                "zh": "<w>简而言之</w>，尽管起初遇到了一些问题，但该项目还是取得了巨大的成功。",
                                "nl": "<w>In het kort</w>, het project was een groot succes ondanks de aanvankelijke problemen.",
                                "pl": "Mówiąc <w>w skrócie</w>, projekt odniósł ogromny sukces pomimo początkowych problemów.",
                                "de": "<w>Kurz gesagt</w> war das Projekt trotz der anfänglichen Probleme ein großer Erfolg.",
                                "fr": "Pour le dire <w>brièvement</w>, le projet a été un immense succès malgré les problèmes initiaux.",
                                "it": "Per dirla <w>brevemente</w>, il progetto è stato un enorme successo nonostante i problemi iniziali.",
                                "cs": "<w>Stručně řečeno</w>, projekt byl navzdory počátečním problémům obrovským úspěchem.",
                                "tr": "<w>Özetle</w>, başlangıçtaki sorunlara rağmen proje büyük bir başarıydı.",
                                "es": "Para decirlo <w>en pocas palabras</w>, el proyecto fue un gran éxito a pesar de los problemas iniciales."
                            }
                        }
