        "nl-extract.jsonl": [
            {
                "entry_id": "a3e67895-2cbb-3f9f-9480-5a3f4b31194c",
                "word": "bauxiet",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "8f7153a3-5adf-368e-b227-1c5461a2a17d",
                        "entry_id": "a3e67895-2cbb-3f9f-9480-5a3f4b31194c",
                        "glosses": [
                            "een mineraal dat een belangrijk erts van aluminium vormt. Bauxiet bestaat voor een groot deel uit aluminiumoxide; daarnaast bevat het, afhankelijk van de oorsprong, ook verbindingen van titanium, ijzer en silicium"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4dc75a23-2c5d-4d91-a214-bd12192744d0",
                                "sense_id": "8f7153a3-5adf-368e-b227-1c5461a2a17d",
                                "text": "Alcoa splitst zich later dit jaar op in twee beursgenoteerde bedrijven. Een gaat zich toeleggen op de productie van hoogwaardige materialen voor de vliegtuigindustrie en de automotive-industrie en de ander op het delven van bauxiet en het produceren van aluminium."
                            },
                            {
                                "example_id": "baba4599-8da2-49e8-9efa-e108e9ee67c8",
                                "sense_id": "8f7153a3-5adf-368e-b227-1c5461a2a17d",
                                "text": "Eerst het milieu. Aluin is een aluminiumverbinding, meestal via elektrolyse uit bauxiet gemaakt. Is deo met dat ene stofje ‘beter’ voor bodem, lucht en water dan een spuitbus met een cocktail van chemicaliën? De briefschrijver geeft het antwoord niet."
                            }
                        ]
                    }
