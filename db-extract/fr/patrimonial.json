                                        "entry_id": "526c28e8-45f5-3b3c-b506-2da22ab33b30",
                                        "glosses": [
                                            "Of or pertaining to patrimony."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
