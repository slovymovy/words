    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d9ead7e9-fe92-3692-9e1b-4a7396ff4b19",
                    "sense_definition": "Aveu sincère d'une faute, d'un acte secret ou d'un sentiment intime.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "aveu",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après plusieurs heures d'interrogatoire, le suspect a finalement fait une <w>confession</w> complète."
                        },
                        {
                            "text": "Elle a décidé de lui faire une <w>confession</w> sur ses véritables sentiments."
                        }
                    ],
                    "synonyms": [
                        "aveu",
                        "déclaration"
                    ],
                    "antonyms": [
                        "dénégation",
                        "dissimulation"
                    ],
                    "common_phrases": [
                        "faire une confession",
                        "confession complète"
                    ]
                },
                {
                    "sense_id": "c9932412-f9bf-3cb0-844a-9a753e4baa33",
                    "sense_definition": "Aveu de ses péchés à un prêtre pour recevoir le sacrement de pénitence et obtenir l'absolution.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "religion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le fidèle va régulièrement à la <w>confession</w> avant de participer à la messe."
                        },
                        {
                            "text": "Le prêtre est strictement tenu de respecter le secret de la <w>confession</w>."
                        }
                    ],
                    "synonyms": [
                        "pénitence"
                    ],
                    "common_phrases": [
                        "aller à la confession",
                        "secret de la confession"
                    ]
                },
                {
                    "sense_id": "712170b2-0230-336e-8aab-48251fc6ced1",
                    "sense_definition": "Appartenance à une religion, à une église ou à une foi déterminée.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "religion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette association accueille des personnes de toute <w>confession</w> religieuse sans aucune distinction."
                        },
                        {
                            "text": "Dans cette ville cosmopolite, des citoyens de différentes <w>confessions</w> vivent en harmonie."
                        }
                    ],
                    "synonyms": [
                        "croyance",
                        "culte",
                        "religion"
                    ],
                    "common_phrases": [
