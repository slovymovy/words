                        "sense_id": "34104347-04da-3edf-8190-b07c98277833",
                        "entry_id": "20c6df37-2f28-3368-87c3-272f52a1b4ec",
                        "glosses": [
                            "Voiture de chemin de fer équipée d’une cabine de conduite et qui permet au conducteur de télécommander le ou les véhicules moteur d’un train."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "5927c895-e3db-3422-baa9-793b15105d8d",
                        "entry_id": "20c6df37-2f28-3368-87c3-272f52a1b4ec",
                        "glosses": [
                            "Voiture que l’on suit un certain temps sur la route pour des raisons de commodité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1f62b2c9-d1d9-4ff5-aa6b-972be9a5e93a",
                                "sense_id": "5927c895-e3db-3422-baa9-793b15105d8d",
                                "text": "Elle ne nous suivait pas ; elle nous avait sans doute pris comme voiture-pilote, tout simplement ! Je fais souvent cela moi aussi, pas vous ? Lorsqu’on doit faire une longue route, surtout de nuit, on s’accroche de temps en temps aux feux de la voiture qui précède, c’est plus reposant ; et s’il y a un radar..."
                            },
                            {
                                "example_id": "ae11cc16-434d-4798-bdd5-12b12a70d01a",
                                "sense_id": "5927c895-e3db-3422-baa9-793b15105d8d",
                                "text": "Les caractéristiques du convoi (masse et dimensions) dans sa configuration en charge imposent un accompagnement par un véhicule pilote et un véhicule de protection arrière, conformément à l’article 13 de l’arrêté du 4 mai 2006"
                            }
                        ]
                    }
