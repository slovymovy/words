            "senses": [
                {
                    "sense_id": "d4705ac2-b9ab-33d1-ad33-3bfbcaa66a7f",
                    "sense_definition": "Sortilège ou puissance surnaturelle néfaste qui voue une personne, un lieu ou un objet au malheur.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "surnaturel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Selon la légende locale, une terrible <w>malédiction</w> pèse sur ce vieux château abandonné."
                        },
                        {
                            "text": "Le jeune prince doit trouver un moyen rapide pour lever la <w>malédiction</w> avant minuit."
                        }
                    ],
                    "antonyms": [
                        "bénédiction"
                    ],
                    "common_phrases": [
                        "lever la malédiction",
                        "victime d'une malédiction"
                    ]
                },
                {
                    "sense_id": "e4f06135-cbc5-3cc0-b934-37e6c3f48dc4",
                    "sense_definition": "Action d'appeler la colère céleste ou le malheur sur quelqu'un ; paroles par lesquelles on maudit.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "parole",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans cette tragédie classique, le héros s'enfuit accablé par la <w>malédiction</w> paternelle."
                        },
                        {
                            "text": "L'homme furieux a lancé de violentes <w>malédictions</w> contre ses ennemis en plein tribunal."
                        }
                    ],
                    "synonyms": [
                        "maudition"
                    ],
                    "antonyms": [
                        "bénédiction"
                    ],
                    "common_phrases": [
                        "malédiction paternelle",
                        "lancer des malédictions"
                    ]
                },
                {
                    "sense_id": "bd88479b-640e-3b61-b91f-e0302933bf19",
                    "sense_definition": "Grand malheur ou fatalité persistante qui accable une personne ou une collectivité.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "malheur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La sécheresse prolongée est devenue une véritable <w>malédiction</w> pour les agriculteurs du village."
                        },
                        {
                            "text": "Le ministre cherche des solutions concrètes pour échapper enfin à la <w>malédiction</w> du surendettement."
