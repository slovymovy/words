                                                "example_id": "590bdcb8-db3e-4445-bb5e-aa263a9652af",
                                                "sense_id": "bb2e12b3-bf28-3274-adb8-3cdff1a661ce",
                                                "text": "runaway prices"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9da6b0ef-e005-3f9f-98a0-99ddf2c07356",
                                        "entry_id": "1240e09c-a898-3d2b-862c-36ad03b2d237",
                                        "glosses": [
                                            "Deserting or revolting against one's group, duties, expected conduct, or the like, especially to establish or join a rival group, change one's life drastically, etc."
                                        ],
                                        "tags": [
