                {
                    "sense_id": "817e099d-bb73-33ec-bcf8-1c705f04db04",
                    "sense_definition": "Iemand die vrijwillig afgezonderd van de samenleving leeft, vaak om religieuze of persoonlijke redenen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "afzondering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij leeft als een <w>kluizenaar</w> in de bergen."
                        },
                        {
                            "text": "De oude man koos ervoor om als <w>kluizenaar</w> te leven in een klein bos."
                        },
                        {
                            "text": "Na het pensioen werd hij een echte <w>kluizenaar</w> en sprak hij bijna niemand meer."
                        }
                    ],
                    "synonyms": [
                        "heremiet",
                        "anachoreet",
                        "kluisbroeder"
                    ],
                    "common_phrases": [
