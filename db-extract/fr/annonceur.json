                "forms": [
                    {
                        "form_id": "9932ea70-216f-40bd-af82-2122f5fa5743",
                        "entry_id": "94c9020d-2bf9-39b8-ae0e-9f8319f2a874",
                        "tags": [
                            "plural"
                        ],
                        "form": "annonceurs"
                    },
                    {
                        "form_id": "452f2f91-158a-4e3d-bc5b-6c87a59326c6",
                        "entry_id": "94c9020d-2bf9-39b8-ae0e-9f8319f2a874",
                        "tags": [
                            "feminine"
                        ],
                        "form": "annonceuse"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "46af6168-bfd9-322c-a23b-a424c37709df",
                        "entry_id": "94c9020d-2bf9-39b8-ae0e-9f8319f2a874",
                        "glosses": [
                            "Dans la publicité, personne qui fait la réclame de son produit (par opposition à l’agence qui conçoit la publicité et aux médias qui la diffusent)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fed1dd6c-2e4c-4aff-94df-ec433a394f2a",
                                "sense_id": "46af6168-bfd9-322c-a23b-a424c37709df",
                                "text": "Dans la presse, vous pouvez dire des horreurs sur des personnes humaines mais essayez un peu de descendre un annonceur et vous risquez très vite de faire perdre à votre journal des millions d’euros de rentrées publicitaires."
                            },
                            {
                                "example_id": "225f1677-b8f4-4a92-9dec-5692b2e638be",
                                "sense_id": "46af6168-bfd9-322c-a23b-a424c37709df",
                                "text": "L’annonceur, chef de produit ou de la division Marketing Research, négocie, sur base d’un briefing, l’étude à réaliser."
                            },
                            {
                                "example_id": "b09f1db4-ba6b-438f-b18f-aed217504b35",
                                "sense_id": "46af6168-bfd9-322c-a23b-a424c37709df",
                                "text": "L’affichage grand format est le plus utilisé des annonceurs. Il se présente le plus souvent sous la forme de panneaux de 4 × 3 mètres."
                            }
                        ]
                    },
                    {
                        "sense_id": "7ccc348e-4ba0-3c66-ae1d-00feba62f269",
                        "entry_id": "94c9020d-2bf9-39b8-ae0e-9f8319f2a874",
                        "glosses": [
                            "Personne qui fait les annonces au cours d’une rencontre sportive."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "aa10bffe-364f-394e-82b5-7b64dded3a93",
                        "entry_id": "94c9020d-2bf9-39b8-ae0e-9f8319f2a874",
                        "glosses": [
                            "Comédien qui venait, à la fin du spectacle, faire l’annonce des pièces qu’on devait jouer le lendemain."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "210b1845-1410-3846-81bb-b0b39df399f4",
                        "entry_id": "94c9020d-2bf9-39b8-ae0e-9f8319f2a874",
                        "glosses": [
                            "Personne qui présente ou lance à la radio une émission publicitaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e582de2-3dad-48e9-a5b7-170fe7391ff6",
                                "sense_id": "210b1845-1410-3846-81bb-b0b39df399f4",
                                "text": "L’annonceur est (…), à la radio, celui qui donne des conseils utiles, mais aussi qui fait prendre conscience d'un besoin, au moment même où il y répond."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "79f02023-c569-4eac-9cc5-7a56144b7315",
                        "source_entry_id": "94c9020d-2bf9-39b8-ae0e-9f8319f2a874",
                        "target_lang_word": "advertiser",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "advertiser",
