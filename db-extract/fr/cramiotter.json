                        "examples": [
                            {
                                "example_id": "72988fa1-366b-4b14-ade9-8bd9f6dfd5fd",
                                "sense_id": "62ec9411-bd1e-371d-af87-6de9148b6971",
                                "text": "Le carton qui s’inscrit juste pour cramiotter sur ce topic, pas grillé le mec"
                            },
                            {
                                "example_id": "c78e6431-8f6e-4401-9236-d6c7b5d71e0f",
                                "sense_id": "62ec9411-bd1e-371d-af87-6de9148b6971",
                                "text": "Ah ! Tu me l’as bien arrangé ! rugit-elle en cramiottant sur le pauvre Paul, bien mal récompensé de ses efforts."
                            },
                            {
                                "example_id": "6b7d4018-40b7-4149-9feb-6630dfba9c59",
                                "sense_id": "62ec9411-bd1e-371d-af87-6de9148b6971",
                                "text": "Pour cela tu cramiottes sur la valve et si présence de bulles cela veut dire qu’elle fuit."
                            }
                        ]
                    }
