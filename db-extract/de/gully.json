                        "sense_id": "54dca693-5227-3db2-8c0a-7d507b71db7c",
                        "entry_id": "8d1afaea-868e-3433-a027-43d9984b9eae",
                        "glosses": [
                            "mit einem Deckel abgedeckter Schacht, der in eine Straße eingelassen ist und durch den Regenwasser in die Kanalisation abläuft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cc45d24d-ed07-4dad-bfec-edc4592076b7",
                                "sense_id": "54dca693-5227-3db2-8c0a-7d507b71db7c",
                                "text": "Mein Schlüssel ist mir versehentlich in den Gully gefallen."
                            },
                            {
                                "example_id": "0d218f64-18f8-48eb-8109-42e07c4cf770",
                                "sense_id": "54dca693-5227-3db2-8c0a-7d507b71db7c",
                                "text": "„Ich wollte ihn erst gar nicht in meinen vier Wänden haben, war mit ihm gleich auf die Straße gelaufen, hatte auch diese Botschaft abgewandten Gesichts vernichtet und die Fetzen in den Gully bei der Mauritiuskirche nebenan gestopft.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
