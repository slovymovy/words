                    {
                        "form_id": "d157cf07-2a5f-48dc-8afe-9e4cc49a5d98",
                        "entry_id": "223f73b8-80e1-379b-a58c-53559825bf3d",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Infamitäten"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0bb1543e-b8d3-3957-bc5b-7894c7b6fa6f",
                        "entry_id": "223f73b8-80e1-379b-a58c-53559825bf3d",
                        "glosses": [
                            "die Eigenschaft, infam (niederträchtig) zu sein"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "75ae56d1-aba4-4115-80f1-b92cdff7a06d",
                                "sense_id": "0bb1543e-b8d3-3957-bc5b-7894c7b6fa6f",
                                "text": "Er blickte in einen Abgrund von Infamität."
                            },
                            {
                                "example_id": "d8b5012c-1554-4e4c-8035-2bcc30a8d722",
                                "sense_id": "0bb1543e-b8d3-3957-bc5b-7894c7b6fa6f",
                                "text": "„Wer kann nur hinter einem solchen Verbrechen stecken, […] Wie kann aber eine solche Infamität nur möglich sein!!“ (1886)"
                            },
                            {
                                "example_id": "73a1eba8-b3b6-419a-8821-8bdc113153ff",
                                "sense_id": "0bb1543e-b8d3-3957-bc5b-7894c7b6fa6f",
                                "text": "„‚Frost […] beschwor die Sicherung des Krankenhausstandortes, als er längst wusste, dass er Staßfurt verlässt‘, sagte Bieling. Dieses Verhalten sei aus seiner Sicht an Infamität nicht mehr zu überbieten.“"
                            },
                            {
                                "example_id": "ed047955-ab6d-44b8-ad69-e73afdc22c51",
                                "sense_id": "0bb1543e-b8d3-3957-bc5b-7894c7b6fa6f",
                                "text": "„Die Infamität der Stadt bestehe darin, dass sie ein Programm, das eher einem schlecht sortierten Gemischtwarenlager entspriche, mit dem guten Namen ‚Magazin 4‘ zu verkaufen versuche.“"
                            },
                            {
                                "example_id": "c2b3544d-1ebc-4b02-9cff-28dbfb7d5a82",
                                "sense_id": "0bb1543e-b8d3-3957-bc5b-7894c7b6fa6f",
                                "text": "„Die Behauptung, dass unser Gemeinwesen auf christlichen Werten beruhe, ist an Infamität kaum zu überbieten: es bedurfte Jahrhunderte des Kampfes gegen Klerus und Adel, um diese Werte von Freiheit und Demokratie durchzusetzen.“"
                            },
                            {
                                "example_id": "a8554fee-91c4-4d89-9677-354b9706727b",
                                "sense_id": "0bb1543e-b8d3-3957-bc5b-7894c7b6fa6f",
                                "text": "„Auch ein Richter ist natürlich nicht in der Lage, anhand der Rechnungslegung der Banken auch nur irgend etwas im Detail selbst nachzuprüfen oder gerade die deliktische Infamität des Systems zu durchschauen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "a4854dc5-4938-328b-8ec3-ea387d4d005f",
                        "entry_id": "223f73b8-80e1-379b-a58c-53559825bf3d",
                        "glosses": [
                            "infame, niederträchtige Handlung"
                        ],
                        "tags": [
                            "meistens Plural"
                        ],
                        "examples": [
                            {
                                "example_id": "ab4b4a7f-8fe3-479b-8f1a-3e8b1157706b",
                                "sense_id": "a4854dc5-4938-328b-8ec3-ea387d4d005f",
                                "text": "Diese Infamität würde sie ihm nie verzeihen."
                            },
                            {
                                "example_id": "23c9d99b-f8dd-4ce6-809c-e0e6aa9a6933",
                                "sense_id": "a4854dc5-4938-328b-8ec3-ea387d4d005f",
                                "text": "„Gegen die Infamitäten des Lebens sind die besten Waffen: Tapferkeit, Eigensinn und Geduld.“"
                            },
                            {
                                "example_id": "2c9d1cfc-fd68-4302-879c-a6aba7a44552",
                                "sense_id": "a4854dc5-4938-328b-8ec3-ea387d4d005f",
                                "text": "„Dieser Schuft will, dass ich die grössten Schweinhunde zu Gaste lade! In meinem Palast sollen sie Tag und Nacht – Infamitäten ausbrüten!“ (1904)"
                            },
                            {
                                "example_id": "4e693737-7619-405d-b6ba-ab93a6fecd22",
                                "sense_id": "a4854dc5-4938-328b-8ec3-ea387d4d005f",
                                "text": "„Da prahlen wir mit unserem Licht, mit unserer Verfeinerung, mit unserer Menschenveredelung, und sind ärgere Wilden, als unsere Vorfahren, […] vor denen wir schaudern; und begehen Infamitäten, die so recht das Tiegerartige zeigen, das um und an uns ist, […]“ (1804)"
                            },
                            {
                                "example_id": "4f648f63-28f9-4d93-85da-35453e259bd0",
                                "sense_id": "a4854dc5-4938-328b-8ec3-ea387d4d005f",
                                "text": "„Das Gespräch fiel auf den unglücklichen Feldzug in der Champagne. Ich äußerte meine Neugierde, […] die eigentlichen Ursachen von dem Rückzuge des preussischen Heeres zu erfahren, indem man so mancherley darüber spräche, unter andern auch von großen Summen, die der H..... von B........... empfangen hätte. ‚Das sind Infamitäten,‘ sagte Herr W......“ (1816)"
                            },
                            {
                                "example_id": "978b4e60-5179-43e9-be66-95a96a353212",
                                "sense_id": "a4854dc5-4938-328b-8ec3-ea387d4d005f",
                                "text": "„Man verbittet sich solche Infamitäten, widrigenfalls man sich nothgedrungen sehen würde, den Namen dieses Boshaften öffentlich zu nennen.“ (1823)"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
