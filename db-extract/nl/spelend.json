                        "examples": [
                            {
                                "example_id": "3297aeb8-9d25-40d2-a6cb-e338f823c579",
                                "sense_id": "a16a1982-bca0-3425-a091-66657a10674f",
                                "text": "Jeugdinternational Chong kwam in het FA Cup-duel met Reading FC (2-0) in de 62ste minuut in het veld voor Juan Mata. Onder luid applaus van het publiek op Old Trafford liet hij meteen zijn klasse zien met een rush. De linkspoot, spelend met rugnummer 44, geldt sinds zijn komst van de jeugdopleiding van Feyenoord in 2016 als een van de grootste talenten van de club."
                            },
                            {
                                "example_id": "bae90b61-0d0b-43dd-bd9a-f3b9477b0f46",
                                "sense_id": "a16a1982-bca0-3425-a091-66657a10674f",
                                "text": "Grohl en de band traden op tijdens een privéfeest dat speakerfabrikant JBL had georganiseerd als onderdeel van de Consumer Electronics Show die momenteel in de Amerikaanse gokstad aan de gang is. Tijdens het optreden kreeg Grohl een blikje fris van iemand in het publiek. Hij nam, spelend op zijn gitaar, een slok en probeerde vervolgens weer het podium op te klimmen. Mogelijk struikelde hij daarbij over kabels. Of de muzikant gewond raakte, is onduidelijk. Hij speelde en liep gewoon door."
                            }
                        ]
                    }
