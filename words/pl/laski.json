                {
                    "sense_id": "220558ae-27c9-33f0-ba47-1bd68d15a3fc",
                    "sense_definition": "Forma liczby mnogiej rzeczownika <w>laska</w> (atrakcyjna dziewczyna lub kobieta).",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "laska_girl",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na wczorajszej imprezie były same fajne <w>laski</w>.",
                            "target_lang_translations": {
                                "ru": "На вчерашней вечеринке были одни классные <w>девчонки</w>.",
                                "en": "At yesterday's party, there were only cool <w>chicks</w>."
                            }
                        },
                        {
                            "text": "Te <w>laski</w> z sąsiedztwa często chodzą razem do kina.",
                            "target_lang_translations": {
                                "ru": "Эти <w>девчонки</w> по соседству часто ходят вместе в кино.",
                                "en": "Those <w>girls</w> from the neighborhood often go to the cinema together."
