                "senses": [
                    {
                        "sense_id": "74354ea1-a4fc-39ae-a88f-23c857f01615",
                        "entry_id": "d7fd4db8-2a3d-3047-b365-f9f11f283c17",
                        "glosses": [
                            "Zeitraum von 45 Minuten, das sind drei Viertel einer vollen Stunde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a026fd1a-12d0-49f7-9832-f6d36a959453",
                                "sense_id": "74354ea1-a4fc-39ae-a88f-23c857f01615",
                                "text": "„Eine gute Dreiviertelstunde redet sie.“"
                            },
                            {
                                "example_id": "c76b66b5-4de3-48d4-a7e5-74291c9623bd",
                                "sense_id": "74354ea1-a4fc-39ae-a88f-23c857f01615",
                                "text": "„Nun laufen wir schon ungefähr eine Dreiviertelstunde über einen schwarzen Strand im Süden Islands.“"
                            },
                            {
                                "example_id": "fc3fd3b5-cf46-48f4-a423-6e4a4236972d",
                                "sense_id": "74354ea1-a4fc-39ae-a88f-23c857f01615",
                                "text": "„Das Störhaus ist eine Alpenvereinshütte knapp eine Dreiviertelstunde vom Höhleneingang entfernt.“"
                            },
                            {
                                "example_id": "2a01b2b0-5267-4632-9bd2-973d7df4bbb6",
                                "sense_id": "74354ea1-a4fc-39ae-a88f-23c857f01615",
                                "text": "„Für die nächste Dreiviertelstunde gab es nichts zu reden und noch weniger zu streiten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
