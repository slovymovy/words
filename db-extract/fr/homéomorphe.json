                                                "sense_id": "ac50d585-5de5-3554-8964-69d7e888fd8f",
                                                "text": "Any infinite-dimensional Fréchet space homeomorphic with its countable product is topologically a Hilbert space."
                                            },
                                            {
                                                "example_id": "e857d9de-bbc9-4fc7-9a41-43f1abea2de6",
                                                "sense_id": "ac50d585-5de5-3554-8964-69d7e888fd8f",
                                                "text": "A Vitali set can be homeomorphic to its complement."
                                            },
                                            {
                                                "example_id": "59eec412-207e-4a24-b586-6091ba75e84a",
                                                "sense_id": "ac50d585-5de5-3554-8964-69d7e888fd8f",
                                                "text": "A pair of non-homeomorphic product measures on the Cantor set."
                                            }
