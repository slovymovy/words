                    "sense_definition": "действующий субъект, группа людей или фактор, влияющий на события",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "meanings",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Вооружённые <w>силы</w> страны были приведены в полную боевую готовность.",
