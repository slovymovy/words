                    {
                        "sense_id": "6ad7184c-d463-35b9-98fc-09a113cfb1c8",
                        "entry_id": "cbeb0df0-4947-36c3-866e-e19af1e699a0",
                        "glosses": [
                            "iemand die een winkel of andere gelegendheid draaiende en open houdt"
                        ],
                        "tags": [
                            "beroep"
                        ],
                        "examples": [
                            {
                                "example_id": "61460d96-2c58-4771-8593-831d22d3c7b0",
                                "sense_id": "6ad7184c-d463-35b9-98fc-09a113cfb1c8",
                                "text": "De uitbater van het café zorgt voor de inkoop en verkoop van dranken en dat het café schoon blijft."
                            },
                            {
                                "example_id": "65fe94bb-1dc0-493d-97b5-b774d5e859c4",
                                "sense_id": "6ad7184c-d463-35b9-98fc-09a113cfb1c8",
                                "text": "De uitbater van een winkel is vaak ook de eigenaar van de zaak."
                            },
                            {
                                "example_id": "12e24d6b-eba5-4edd-a995-af3ec48b14d7",
                                "sense_id": "6ad7184c-d463-35b9-98fc-09a113cfb1c8",
                                "text": "Het is een hart onder de riem in een moeilijke periode, ervaren ze. Anwar en Jolanda Abdellaziz, die moeten stoppen als uitbaters van leescafé De Meridiaan in de bibliotheek, zijn bedolven onder steunbetuigingen."
                            },
                            {
                                "example_id": "d5caf1ac-f658-428f-be55-feca884b6732",
                                "sense_id": "6ad7184c-d463-35b9-98fc-09a113cfb1c8",
                                "text": "Vraag het aan Gentenaar Geert Claus, uitbater van frituur Emily’s, hoe zwaar het is. Hij legt de laatste meters te voet af, met de fiets aan de hand."
                            }
                        ]
                    }
                ],
