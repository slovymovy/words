                "senses": [
                    {
                        "sense_id": "28c2dc74-68b8-3a3a-9461-b498668c25a1",
                        "entry_id": "b17313da-83e5-395e-a1df-1304e3da02aa",
                        "glosses": [
                            "Ensemble de liens concrets entre des textes ou discours littéraires."
                        ],
                        "tags": [
                            "Études culturelles",
                            "Sémiotique"
                        ],
                        "examples": [
                            {
                                "example_id": "15e85648-a195-40b2-a1d6-98ae675d5a4f",
                                "sense_id": "28c2dc74-68b8-3a3a-9461-b498668c25a1",
                                "text": "Le professeur de littérature demande à ses étudiants d’analyser l’intertextualité entre les œuvres d’Herman Melville et les récits bibliques."
                            },
                            {
                                "example_id": "325350e3-9e34-4e1c-971b-4f6d065a4aab",
                                "sense_id": "28c2dc74-68b8-3a3a-9461-b498668c25a1",
                                "text": "Ce n’est un mystère pour personne que les mots intertexte et intertextualité prennent des sens différents selon les contextes théoriques dans lesquels ils interviennent."
                            }
                        ]
                    },
                    {
                        "sense_id": "16842c56-92be-35f9-bc1f-00ce25ed4e88",
                        "entry_id": "b17313da-83e5-395e-a1df-1304e3da02aa",
                        "glosses": [
                            "Plagiat."
                        ],
                        "tags": [
                            "euphemism"
                        ],
                        "examples": [
                            {
                                "example_id": "3a1e56b5-81c6-4252-bf3c-d13d67c91cec",
                                "sense_id": "16842c56-92be-35f9-bc1f-00ce25ed4e88",
                                "text": "On y trouve plus particulièrement 28 phrases où les similitudes sont de mot à mot, relevant dès lors d’une évidente intertextualité."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e74b861f-e2db-400f-880e-89cc41a52572",
                        "source_entry_id": "b17313da-83e5-395e-a1df-1304e3da02aa",
