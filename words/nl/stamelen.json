                        {
                            "text": "Toen hij de prijs won, kon hij alleen maar een paar woorden <w>stamelen</w> van geluk.",
                            "target_lang_translations": {
                                "en": "When he won the prize, he could only <w>stammer</w> a few words of happiness."
                            }
                        },
                        {
                            "text": "De zenuwachtige jongen begon te <w>stamelen</w> toen de leraar hem een vraag stelde.",
                            "target_lang_translations": {
                                "en": "The nervous boy began to <w>stutter</w> when the teacher asked him a question."
                            }
