                    {
                        "translation_id": "ecf8e878-3a5f-45f5-bf39-20bd360fcbbe",
                        "source_entry_id": "69b50d09-2300-3af3-bbbd-214e3f54df75",
                        "source_sense_id": "a37227cc-c686-30e0-b976-208a9f0108ad",
                        "source_sense_description": "mixture of fat (usually butter) and flour used to thicken sauces and stews",
                        "target_lang_word": "roux",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "roux",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "9102edde-9ed7-3db1-bd8f-b051e8189069",
                                        "entry_id": "df4f6e5c-77f4-3e7a-acaa-b1aa2cbdf2ce",
                                        "glosses": [
                                            "mengsel van bruin gebraden boter en bloem"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "680aa978-21ca-4538-afde-4cdec4a7ae1b",
                                                "sense_id": "9102edde-9ed7-3db1-bd8f-b051e8189069",
                                                "text": "Maak een roux van boter en bloem en giet er de witte wijn (mag ook een lichte sherry zijn) en bouillon bij, blijf kloppen tot je een mooie gebonden soep hebt."
                                            },
                                            {
                                                "example_id": "a2fc5c01-7a76-497d-9c0d-61ab92cf0425",
                                                "sense_id": "9102edde-9ed7-3db1-bd8f-b051e8189069",
                                                "text": "Fruit ondertussen de sjalot in de boter glazig en voeg de bloem toe en laat deze roux garen."
                                            },
                                            {
                                                "example_id": "6a115bcc-0769-45fc-80b2-a815d6fd76ff",
                                                "sense_id": "9102edde-9ed7-3db1-bd8f-b051e8189069",
                                                "text": "Het kookwater van de witlof heb je toch bewaard? Doe wat boter in een pannetje, de bloem erbij, roeren tot een roux."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c6fe168e-25d3-4c94-a68a-d97a6b1c397b",
                        "source_entry_id": "69b50d09-2300-3af3-bbbd-214e3f54df75",
                        "source_sense_id": "a37227cc-c686-30e0-b976-208a9f0108ad",
                        "source_sense_description": "mixture of fat (usually butter) and flour used to thicken sauces and stews",
                        "target_lang_word": "roux",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "roux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e1c6ca0f-0f09-3ec5-8b14-8aacaaa13b7c",
                                        "entry_id": "7f7784b9-1698-37fe-9dde-25a5a2f1726c",
                                        "glosses": [
                                            "D’une couleur proche de l’orange, souvent en parlant des cheveux. #AD4F09"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "25803903-6e4b-4e4e-a5e9-176251f0ab52",
                                                "sense_id": "e1c6ca0f-0f09-3ec5-8b14-8aacaaa13b7c",
                                                "text": "Sous son chapeau, à bords retroussés, apparaissaient, riches et crépus, des cheveux plutôt roux que blonds […]"
                                            },
                                            {
                                                "example_id": "5e705aba-b2b0-43db-b68a-5133f186b291",
                                                "sense_id": "e1c6ca0f-0f09-3ec5-8b14-8aacaaa13b7c",
                                                "text": "Vingt-six à vingt-sept ans, de taille moyenne, mince, nerveux, les yeux énergiques, les cheveux roux, il a moustache rousse retombant à la gauloise."
                                            },
                                            {
                                                "example_id": "6c5e62f2-6d37-4fef-817d-ab38ab05ee91",
                                                "sense_id": "e1c6ca0f-0f09-3ec5-8b14-8aacaaa13b7c",
                                                "text": "Sous sa brosse de cheveux roux, il avait l’air doré sur tranches."
                                            },
                                            {
                                                "example_id": "d1fa3cc5-c857-4161-94ea-88118a028f3a",
                                                "sense_id": "e1c6ca0f-0f09-3ec5-8b14-8aacaaa13b7c",
                                                "text": "Il mesurait un mètre soixante-dix et, note son livret militaire consigné lui aussi dans la boîte à chaussures, avait les yeux roux. Roux ? Grand-père se dit qu’à travers de tels iris toutes les épouses ont sans doute ce beau hâle cuivré qu’il cherchait lui-même sur le corps nu des femmes du Levant."
                                            },
                                            {
                                                "example_id": "f13f5ebc-1a28-4238-84e2-df4f3b2f4cea",
                                                "sense_id": "e1c6ca0f-0f09-3ec5-8b14-8aacaaa13b7c",
                                                "text": "On distingue sept teintes naturelles de cheveux, réparties, en France, selon les proportions suivantes : 50 % de cheveux châtains, 20 % de cheveux gris, 10 % de cheveux blonds et noirs, 5% de cheveux roux et 2,5% de cheveux bruns et blancs."
                                            },
                                            {
                                                "example_id": "1f752d47-e537-4d47-958a-7e2148cdb5c0",
                                                "sense_id": "e1c6ca0f-0f09-3ec5-8b14-8aacaaa13b7c",
                                                "text": "Le noir et blanc de la photographie ne permet pas de voir les « yeux roux » dont fait état sa fiche d’incorporation à l’Inscription maritime de l’Aber-Wrac’h."
                                            },
                                            {
                                                "example_id": "a798cad4-80d1-46e5-9bd0-63839ee3a05f",
                                                "sense_id": "e1c6ca0f-0f09-3ec5-8b14-8aacaaa13b7c",
                                                "text": "Les sièges derrière eux étaient occupés par un vieux couple qui transportait une grosse poule rousse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7254257b-3814-3475-8d48-58fb374c3cbd",
                                        "entry_id": "7f7784b9-1698-37fe-9dde-25a5a2f1726c",
                                        "glosses": [
                                            "Qui a les cheveux roux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de1ac3c6-90fd-4354-bcbe-1f7f24bb8877",
                                                "sense_id": "7254257b-3814-3475-8d48-58fb374c3cbd",
                                                "text": "L’une de ces filles avait les cheveux d’un roux très véhément, couleur qui est très fréquente en Espagne, où il y a beaucoup de blondes et surtout beaucoup de rousses, contre l’idée généralement reçue."
                                            },
                                            {
                                                "example_id": "41ff11e1-c403-400d-a480-a8f2c481ee85",
                                                "sense_id": "7254257b-3814-3475-8d48-58fb374c3cbd",
                                                "text": "C’est M. Lefèvre, l’ancien acteur des Variétés, qui a fait éclore un jour cette phrase dans la bouche de mademoiselle Juliette, une figurante laide et rousse qu’Odry, par antiphrase, appelait Joliette."
                                            },
                                            {
                                                "example_id": "e421a011-d9fc-4f91-ae2e-0f727d460cdb",
                                                "sense_id": "7254257b-3814-3475-8d48-58fb374c3cbd",
                                                "text": "C’est une couleur nette, au moins : je suis content d’être roux. […] J’ai encore de la chance : si mon front portait une de ces chevelures ternes qui n’arrivent pas à se décider entre le châtain et le blond, ma figure se perdrait dans le vague, elle me donnerait le vertige."
                                            },
                                            {
                                                "example_id": "2f4e229f-6a17-4064-819b-8e6b23c44a7f",
                                                "sense_id": "7254257b-3814-3475-8d48-58fb374c3cbd",
                                                "text": "Malgré elle il lui parut beau, bien qu’il fût roux. C’était cela qui la troublait, cette chevelure de flamme, ce teint d’une blancheur laiteuse, et elle se domina pour qu’il ne comprît pas l’espèce de répulsion qu’il lui inspirait."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9ec00ced-73ad-3460-aa17-63b43f9cd39f",
                                        "entry_id": "7f7784b9-1698-37fe-9dde-25a5a2f1726c",
                                        "glosses": [
                                            "Fondu et cuit jusqu’à obtenir une couleur rousse en cuisine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb278f5c-3a62-4b2c-a113-0ed9dd1277c2",
                                                "sense_id": "9ec00ced-73ad-3460-aa17-63b43f9cd39f",
                                                "text": "Beurre roux."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "roux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "af9daa1a-e4e1-3421-aedc-68204912a1ef",
                                        "entry_id": "7ae64605-5df1-3c9f-a3ae-17b256aa3246",
                                        "glosses": [
                                            "Couleur rousse. #AD4F09"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d69edfc6-26f3-4494-85d8-72ba2bcae32c",
                                                "sense_id": "af9daa1a-e4e1-3421-aedc-68204912a1ef",
                                                "text": "Il est d’un roux ardent, d’un vilain roux, d’un roux désagréable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b9b0fab-8faf-3c49-a547-bbb64e025239",
                                        "entry_id": "7ae64605-5df1-3c9f-a3ae-17b256aa3246",
                                        "glosses": [
                                            "Préparation obtenue en faisant fondre du beurre avec de la farine, et en ajoutant un peu de liquide."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a066d5c-8edb-4115-9131-2f729ebb9c4f",
                                                "sense_id": "4b9b0fab-8faf-3c49-a547-bbb64e025239",
                                                "text": "Faire un roux."
                                            },
                                            {
                                                "example_id": "235dd22a-ea46-4e25-86d7-63ba7888e08b",
                                                "sense_id": "4b9b0fab-8faf-3c49-a547-bbb64e025239",
                                                "text": "Léon Pavoine répondait en chantant du Franz Lehar, son musicien favori, puis tous deux passaient à la cuisine et faisaient en surveillant le roux des andouillettes la première escale d’un vol amoureux qui tout l’après-midi allait ceinturer la terre."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "roux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5e0e5344-c899-3e13-b696-f7061df46fe9",
                                        "entry_id": "c4fe21d2-310e-35fc-92c3-ed9811de6081",
                                        "glosses": [
                                            "Homme ou garçon qui a les cheveux roux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f5f0802-10bd-48b7-a60e-1aaf291c8702",
                                                "sense_id": "5e0e5344-c899-3e13-b696-f7061df46fe9",
                                                "text": "Le roux est un isolé."
                                            },
                                            {
                                                "example_id": "6aa98cc6-0fd9-4228-8330-0bc24d7415f2",
                                                "sense_id": "5e0e5344-c899-3e13-b696-f7061df46fe9",
                                                "text": "Un roux."
                                            },
                                            {
                                                "example_id": "3f16f4c2-7544-44b3-b365-b74e14859f72",
                                                "sense_id": "5e0e5344-c899-3e13-b696-f7061df46fe9",
                                                "text": "« Je ne peux pourtant pas le renvoyer parce qu’il est roux », se dit-elle. Elle observa ses chaussures poudreuses et supposa qu’il était venu à pied de la gare, par économie. De nouveau elle s’interrogea : « Je me demande s’il sent. Les roux sentent très fort quelquefois. Ça, je ne le supporterais pas. Je dois reconnaître que d’ici, je ne sens rien. »"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
