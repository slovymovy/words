        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "3302bb81-0fde-3013-ac79-f9b868a1ddbd",
                "word": "unlawfulness",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "0439ac94-bdf9-4074-862a-9269dc832a99",
