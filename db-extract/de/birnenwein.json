                "senses": [
                    {
                        "sense_id": "2b38f01f-ad5e-3322-b204-20572f59a27e",
                        "entry_id": "24bd7adb-a23a-3f61-b5e3-43a4f4717505",
                        "glosses": [
                            "Obstwein, der aus Birnen hergestellt wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ace27f3-0735-4761-893b-44f175212378",
                                "sense_id": "2b38f01f-ad5e-3322-b204-20572f59a27e",
                                "text": "„Brand aus Apfel- / Birnenwein ist die Bezeichnung für Spirituosen, die ausschließlich durch Destillation von Apfel- / Birnenwein hergestellt und bis maximal 86% vol. ausdestilliert werden, sodass der Geschmack der Ausgangsfrucht erhalten bleibt.“"
                            },
                            {
                                "example_id": "1064f854-fdca-4d8f-97c9-9b14d2c1bead",
                                "sense_id": "2b38f01f-ad5e-3322-b204-20572f59a27e",
                                "text": "„In den nördlicheren Gefilden des römischen Reiches waren zweifellos Apfelwein und Birnenwein die wichtigsten Obstweintypen.“"
                            },
                            {
                                "example_id": "917bce71-93f4-46de-9d62-f678c113a6b4",
                                "sense_id": "2b38f01f-ad5e-3322-b204-20572f59a27e",
                                "text": "Ich trinke gerne einen Birnenwein."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
