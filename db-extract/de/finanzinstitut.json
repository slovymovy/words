                "senses": [
                    {
                        "sense_id": "32dc95ad-d20b-323a-966b-2c3c3ca272cf",
                        "entry_id": "b5e54f89-236c-3328-a399-666ace3966ac",
                        "glosses": [
                            "Unternehmen für Geldgeschäfte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "74c9f818-91d4-46fe-a00f-70178964b129",
                                "sense_id": "32dc95ad-d20b-323a-966b-2c3c3ca272cf",
                                "text": "„Irlands viertgrößtes Finanzinstitut Irish Life & Permanent werden gute Chancen eingeräumt, von der steigenden Nachfrage nach Altersvorsorgeprodukten zu profitieren.“"
                            },
                            {
                                "example_id": "abac491d-dbbd-45a4-863e-97b18780a959",
                                "sense_id": "32dc95ad-d20b-323a-966b-2c3c3ca272cf",
                                "text": "„Das britische Finanzinstitut Abbey National wird dem Übernahmeangebot der spanischen Großbank Banco Santander Central Hispano vermutlich zustimmen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "96d19ad5-a670-4da0-b870-8872538cade7",
                        "source_entry_id": "b5e54f89-236c-3328-a399-666ace3966ac",
                        "source_sense_id": "32dc95ad-d20b-323a-966b-2c3c3ca272cf",
                        "source_sense_description": "Unternehmen für Geldgeschäfte",
                        "target_lang_word": "banque",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "banque",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2ab45872-3bfc-30a7-bc9b-59f85fcfbba4",
                                        "entry_id": "66da3461-298c-3b07-8deb-d3307673d3ca",
                                        "glosses": [
                                            "Commerce de l'argent et du crédit qui consiste à recevoir des capitaux en compte courant avec ou sans intérêt ; à échanger des effets ou à les escompter avec des espèces, à des taux et moyennant des commissions variables ; à exécuter pour le compte de tiers toutes opérations de ce genre et à se charger de tous services financiers ; à créer et à émettre des lettres de change ; d’une façon générale, commercer de l’argent, ainsi que des titres et valeurs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "930993ff-447a-4914-831f-ebd7f389abf5",
                                                "sense_id": "2ab45872-3bfc-30a7-bc9b-59f85fcfbba4",
                                                "text": "Ce négociant fait la banque, entend bien la banque."
                                            },
                                            {
                                                "example_id": "154da50c-d956-4561-9707-090146b7831b",
                                                "sense_id": "2ab45872-3bfc-30a7-bc9b-59f85fcfbba4",
                                                "text": "Tenir banque ouverte."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7742ee77-6ceb-35cd-9554-c742ce0b7cb2",
                                        "entry_id": "66da3461-298c-3b07-8deb-d3307673d3ca",
                                        "glosses": [
                                            "Entreprise ou société qui fait ce commerce."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "38ad7ab1-1d7e-4560-ae70-53456e43e09b",
                                                "sense_id": "7742ee77-6ceb-35cd-9554-c742ce0b7cb2",
                                                "text": "Dans toutes les Bourses de la terre, ce fut une avalanche de titres que les porteurs voulaient vendre ; les banques suspendirent leurs paiements, les affaires furent paralysées et cessèrent ; […]."
                                            },
                                            {
                                                "example_id": "f990a2f2-d782-426f-b68d-7cd5dac79bde",
                                                "sense_id": "7742ee77-6ceb-35cd-9554-c742ce0b7cb2",
                                                "text": "Il fut démontré qu'il avait touché pour ne rien dire des agissements d'une banque, laquelle, comme toutes les banques, des plus falotes aux plus omnipotentes, saignait cruellement le troupeau des épargnants cupides et malfaisants."
                                            },
                                            {
                                                "example_id": "7d88d4ef-093c-49d8-aa1e-61cb18d5b2cf",
                                                "sense_id": "7742ee77-6ceb-35cd-9554-c742ce0b7cb2",
                                                "text": "Le crédit conso n'est plus en effet seulement l'affaire des filiales spécialisées des banques, des hypermarchés ou des constructeurs automobiles. De nouveaux acteurs sont apparus : les banques en ligne, notamment, qui désormais s'intéressent toutes à ce produit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b7608cc-ab9a-397c-b678-72b9f7b9faab",
                                        "entry_id": "66da3461-298c-3b07-8deb-d3307673d3ca",
                                        "glosses": [
                                            "Établissement où se fait ce commerce."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b186d79-ab97-49d0-9b38-d4e5cc5068b8",
                                                "sense_id": "4b7608cc-ab9a-397c-b678-72b9f7b9faab",
                                                "text": "Porter son argent à la banque. —Action de la banque."
                                            },
                                            {
                                                "example_id": "f742f7e8-5a1e-4dac-92b3-ea9b641c0c2e",
                                                "sense_id": "4b7608cc-ab9a-397c-b678-72b9f7b9faab",
                                                "text": "Banques d’escompte, de dépôt et de virement. — Banques agricoles, hypothécaires, foncières, mobilières, immobilières. — Banques industrielles, populaires, coloniales."
                                            },
                                            {
                                                "example_id": "c4aa90eb-cb06-44f8-ad2f-4b50941150af",
                                                "sense_id": "4b7608cc-ab9a-397c-b678-72b9f7b9faab",
                                                "text": "Les banques particulières et les banques publiques sont ordinairement sous la surveillance de l’autorité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "272b8c72-71df-3109-85a6-cf2b17748462",
                                        "entry_id": "66da3461-298c-3b07-8deb-d3307673d3ca",
                                        "glosses": [
                                            "Négociants mêmes qui font ce commerce."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "36d4b7f2-d379-475a-886b-3dba40b975a3",
                                                "sense_id": "272b8c72-71df-3109-85a6-cf2b17748462",
                                                "text": "Les frères Van Untel sont la meilleure maison de banque d’Amsterdam."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "49e18b2c-cd59-390d-81d4-35003fe3114b",
                                        "entry_id": "66da3461-298c-3b07-8deb-d3307673d3ca",
                                        "glosses": [
                                            "Paiement qui se faisait aux ouvriers, chaque semaine, ou tous les quinze jours, ordinairement le samedi."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "93eb19bf-a65d-46a3-8f0d-e4f65799b144",
                                                "sense_id": "49e18b2c-cd59-390d-81d4-35003fe3114b",
                                                "text": "Jour de banque. — Livre de banque."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea709cec-08d0-3a56-bb5e-8a57261662ab",
                                        "entry_id": "66da3461-298c-3b07-8deb-d3307673d3ca",
                                        "glosses": [
                                            "Somme que celui qui tient le jeu devant lui utilise pour payer ceux qui gagnent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad2158b3-438d-4721-9f1c-78eb06fd3421",
                                                "sense_id": "ea709cec-08d0-3a56-bb5e-8a57261662ab",
                                                "text": "Faire une bonne, une mauvaise banque, gagner ou perdre en tenant le jeu."
                                            },
                                            {
                                                "example_id": "33349f03-c794-4346-b7f3-81b95215ab07",
                                                "sense_id": "ea709cec-08d0-3a56-bb5e-8a57261662ab",
                                                "text": "Faire sauter la banque, gagner tout l’argent que le banquier a mis au jeu."
                                            },
                                            {
                                                "example_id": "bd3e3b73-5dff-467c-b739-1ca6c3f91ab4",
                                                "sense_id": "ea709cec-08d0-3a56-bb5e-8a57261662ab",
                                                "text": "Le découragement qui n’est jamais de longue durée chez le joueur, a suscité l’idée de forcer la banque à paroliser en organisant contre elle des martingales."
                                            },
                                            {
                                                "example_id": "e256d7ec-de5c-41c7-a740-f3bd787c4977",
                                                "sense_id": "ea709cec-08d0-3a56-bb5e-8a57261662ab",
                                                "text": "Moi, je vais tailler une banque au baccarat. Depuis que Margot m'a lâché, je dois être en veine, à moins que le proverbe..."
                                            },
                                            {
                                                "example_id": "b4b4e370-7439-4112-af9a-163fecfe3cc6",
                                                "sense_id": "ea709cec-08d0-3a56-bb5e-8a57261662ab",
                                                "text": "– J'avais donc la banque. Bon. Je donne, après avoir réclamé l'égalité des tableaux., naturellement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3b3d33f3-c6af-3ca5-b4c0-f3d6317b2dbd",
                                        "entry_id": "66da3461-298c-3b07-8deb-d3307673d3ca",
                                        "glosses": [
                                            "Sorte de jeu de cartes."
                                        ],
                                        "tags": [
                                            "Cartes à jouer"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "92ab3623-e273-49fb-86e4-87f66248e2ec",
                                                "sense_id": "3b3d33f3-c6af-3ca5-b4c0-f3d6317b2dbd",
                                                "text": "La Banque, qui à l'origine s'appelait Banco, est l'un des plus anciens jeux de cartes pratiqués en France, avant d'envahir l'Europe. Comme son nom l’indique, il est d'origine italienne et il pénétra en France sous Charles VIII, à la suite de guerres d'Italie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0de3dc6b-03e9-3191-9302-553f2915b50f",
                                        "entry_id": "66da3461-298c-3b07-8deb-d3307673d3ca",
                                        "glosses": [
                                            "Table ou banc devant lesquels travaillent les ouvriers, dans certains corps de métiers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "72f2ba1a-7a2d-4fe9-870f-da585cefc7ae",
                                                "sense_id": "0de3dc6b-03e9-3191-9302-553f2915b50f",
                                                "text": "Angelo trouva un magasin de drapier ouvert. À travers la vitrine, il vit même un monsieur bien habillé, assis sur une banque à mesurer le drap."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "34d55fd1-1ed2-3509-b23e-0204ab91ce0f",
                                        "entry_id": "66da3461-298c-3b07-8deb-d3307673d3ca",
                                        "glosses": [
                                            "Étal, comptoir chez un commerçant ou dans une bibliothèque."
                                        ],
                                        "tags": [
                                            "Régionalisme"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fbb64866-dab1-3bcd-be6c-d97f92b5cced",
                                        "entry_id": "66da3461-298c-3b07-8deb-d3307673d3ca",
                                        "glosses": [
                                            "Endroit où l'on peut entreposer en toute sécurité, toute sorte de choses."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "646d9fe5-f455-4bf2-a771-f364167366b9",
                                                "sense_id": "fbb64866-dab1-3bcd-be6c-d97f92b5cced",
                                                "text": "Banque de sperme."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "942299eb-33a1-34cb-ba9c-6851789f0011",
                                        "entry_id": "66da3461-298c-3b07-8deb-d3307673d3ca",
                                        "glosses": [
                                            "Boniment, flatterie."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fc562923-afc6-42c3-9d65-2f6641116805",
                                                "sense_id": "942299eb-33a1-34cb-ba9c-6851789f0011",
                                                "text": "— Quel magnifique tableau !\n— Nous le mettrons au musée…\n— De Versailles ?\n— Non, de Paris…\n— Ah ! oui… à l’Exposition !\n— Et nous inscrirons sur le livret cette notice…\n— Non ! pas de banque ! pas de réclame !"
                                            }
                                        ]
                                    }
                                ]
                            },
