                "senses": [
                    {
                        "sense_id": "16450c98-f58e-3ef9-989d-3bc776716643",
                        "entry_id": "e59020d7-6bc7-39b4-8128-2bcc835c6c16",
                        "glosses": [
                            "Person, die sich mit dem Thema Vögel besonders gut auskennt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa70a513-4237-4c7d-85cb-1e8a0b60b663",
                                "sense_id": "16450c98-f58e-3ef9-989d-3bc776716643",
                                "text": "„Über mir kreisen Raubvögel, wahrscheinlich Bussarde oder Habichte, ich bin kein großer Vogelexperte.“"
                            },
                            {
                                "example_id": "2e8d67f4-7e27-428a-a2ff-9d2c92f9e5c3",
                                "sense_id": "16450c98-f58e-3ef9-989d-3bc776716643",
                                "text": "„Der amerikanische Naturforscher und Vogelexperte Jon Young brachte es auf den Punkt: Die Vögel zeichnen praktisch eine Karte ihrer unmittelbaren Umgebung, die wir nutzen können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
