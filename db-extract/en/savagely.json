                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "c8f0c7a6-d231-375f-9a67-96ab4933fe97",
                                        "entry_id": "a98bcbd3-e123-3650-9ea8-5c6ab31221bf",
                                        "glosses": [
