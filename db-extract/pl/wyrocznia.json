                "translations": [
                    {
                        "translation_id": "bda3374b-dd81-4e9f-be3d-e9e2b8e2095d",
                        "source_entry_id": "794f3943-78a3-3d51-81d5-d04cddfa35af",
                        "source_sense_id": "4ecaeb14-b4bd-3501-976e-887fd8b0cd77",
                        "target_lang_word": "oracle",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "oracle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8a421e5e-a5bd-3f3e-884e-2725aee6f383",
                                        "entry_id": "55513232-6790-3c7d-acda-86b8103e6c47",
                                        "glosses": [
                                            "A shrine dedicated to some prophetic deity."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0582bfba-eb29-4c56-8902-9e7faa325cc2",
                                                "sense_id": "8a421e5e-a5bd-3f3e-884e-2725aee6f383",
                                                "text": "The oracles are dumb; / No voice or hideous hum / Runs through the arched roof in words deceiving."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ad8a5df5-ac94-3663-a08e-a5869555d405",
                                        "entry_id": "55513232-6790-3c7d-acda-86b8103e6c47",
                                        "glosses": [
                                            "A person such as a priest through whom the deity is supposed to respond with prophecy or advice."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bd2b8153-92be-3e4c-85b9-61c215f45f98",
                                        "entry_id": "55513232-6790-3c7d-acda-86b8103e6c47",
                                        "glosses": [
                                            "A prophetic response, often enigmatic or allegorical, so given."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd1eb9a4-ddd4-487d-9794-51cd18f27a48",
                                                "sense_id": "bd2b8153-92be-3e4c-85b9-61c215f45f98",
                                                "text": "The several oracles included in this haftarah presumably were uttered at different times to the people in exile, presenting diverse themes and using distinct styles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "02318338-5cdd-3e82-952d-eb66c5932505",
                                        "entry_id": "55513232-6790-3c7d-acda-86b8103e6c47",
                                        "glosses": [
                                            "Something said that must come true or cannot be countermanded; an inexorable command or declaration."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "38e8ad4b-76f1-46cd-85f1-60d850c71d9b",
                                                "sense_id": "02318338-5cdd-3e82-952d-eb66c5932505",
                                                "text": "Fight all couragiouſly and be you kings,\nI ſpeake it, and my words are oracles."
                                            },
                                            {
                                                "example_id": "dc7f7270-60ff-4bec-96dd-de5fdf657679",
                                                "sense_id": "02318338-5cdd-3e82-952d-eb66c5932505",
                                                "text": "Shee ſtiles her ſelfe their Chiefe, and ſweares ſhee will command; / And, what-ſo-ere ſhee ſaith, for Oracles muſt ſtand."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea10ca8b-4fb0-358a-8bb7-e43c8e7f5d24",
                                        "entry_id": "55513232-6790-3c7d-acda-86b8103e6c47",
                                        "glosses": [
                                            "A person considered to be a source of wisdom."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "418982dc-d69e-422c-8c5f-56fc724c15af",
                                                "sense_id": "ea10ca8b-4fb0-358a-8bb7-e43c8e7f5d24",
                                                "text": "a literary oracle"
                                            },
                                            {
                                                "example_id": "591c721e-7c2c-4f24-bed8-1c8f15b9c9f9",
                                                "sense_id": "ea10ca8b-4fb0-358a-8bb7-e43c8e7f5d24",
                                                "text": "oracles of mode"
                                            },
                                            {
                                                "example_id": "f7f84de6-fa1e-46af-86ef-59024952af52",
                                                "sense_id": "ea10ca8b-4fb0-358a-8bb7-e43c8e7f5d24",
                                                "text": "The country rectors […] thought him an oracle on points of learning."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3d6cea83-52ad-3e66-8246-c5d0dd05b76b",
                                        "entry_id": "55513232-6790-3c7d-acda-86b8103e6c47",
                                        "glosses": [
                                            "A wise sentence or decision of great authority."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f8e3addb-4efa-30ac-a8e2-8fa1893af18e",
                                        "entry_id": "55513232-6790-3c7d-acda-86b8103e6c47",
                                        "glosses": [
                                            "A fortune-teller."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2e7c1f9-af7c-467f-a723-698f01da4aee",
                                                "sense_id": "f8e3addb-4efa-30ac-a8e2-8fa1893af18e",
                                                "text": "\"Madame de l'Hôpital has been quite la fée bienfaisante\" said Lauzun, who, like others, had been consulting the oracle. \"I am bewildered by my future good fortune. I quite anticipate being married, if it is to bring me all that she predicts.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eefbeb79-aeb2-360d-bbb7-7c20bc7d94f9",
                                        "entry_id": "55513232-6790-3c7d-acda-86b8103e6c47",
                                        "glosses": [
                                            "One who communicates a divine command; an angel; a prophet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "765c0ee3-8dff-4cb2-96f1-141bc11643eb",
                                                "sense_id": "eefbeb79-aeb2-360d-bbb7-7c20bc7d94f9",
                                                "text": "God hath now sent his living oracle / Into the world to teach his final will."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f111fd60-0027-3eec-a488-7459959dc30b",
                                        "entry_id": "55513232-6790-3c7d-acda-86b8103e6c47",
                                        "glosses": [
                                            "The sanctuary, or most holy place in the temple; also, the temple itself."
                                        ],
                                        "tags": [
                                            "Jewish",
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dd3d8eb5-400c-425e-a0b4-3127f07834de",
                                                "sense_id": "f111fd60-0027-3eec-a488-7459959dc30b",
                                                "text": "And the oracle he prepared in the house within, to set there the ark of the covenant of the Lord."
                                            },
                                            {
                                                "example_id": "7713c32f-9a94-4e67-be23-22fb9ddd8d5a",
                                                "sense_id": "f111fd60-0027-3eec-a488-7459959dc30b",
                                                "text": "Siloa's brook, that flow'd / Fast by the oracle of God."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cec5f827-7a64-3275-b836-bda5b2c79111",
                                        "entry_id": "55513232-6790-3c7d-acda-86b8103e6c47",
                                        "glosses": [
                                            "A theoretical entity capable of answering some collection of questions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ea953fb-f35b-454e-aee4-6d924a9d85c5",
                                                "sense_id": "cec5f827-7a64-3275-b836-bda5b2c79111",
                                                "text": "Thus, an oracle machine (which enacts an oracle algorithm) would be like an ordinary Turing machine, except that adjoined to its ordinary computational operations would be another operation: ‘Call in the oracle and ask it whether C_q(n) stops; […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "263da348-91d0-3ac2-a15d-f49e86994463",
                                        "entry_id": "55513232-6790-3c7d-acda-86b8103e6c47",
                                        "glosses": [
                                            "A third-party service that provides smart contracts with information from the outside world."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c29e6d4-5e32-4d5e-aa4f-eeaac13df4b7",
                                                "sense_id": "263da348-91d0-3ac2-a15d-f49e86994463",
                                                "text": "For example, an oracle may send temperature data reported by the National Weather Service or report the daily LIBOR rate to a smart contract."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "oracle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "893fb953-c072-3813-b5f2-7fd770d801e9",
                                        "entry_id": "52408674-6c5c-3282-a58c-7a0f5b6aa824",
                                        "glosses": [
                                            "To utter oracles or prophecies."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "50736301-6ac3-4b8d-af77-518c824c629b",
                                                "sense_id": "893fb953-c072-3813-b5f2-7fd770d801e9",
                                                "text": "But this thy glory shall be soon retrench'd;\nNo more shalt thou by oracling abuse\nThe Gentiles; henceforth Oracles are ceast"
                                            },
                                            {
                                                "example_id": "0005812f-8b8a-4353-a11b-ab7a9c6a04b1",
                                                "sense_id": "893fb953-c072-3813-b5f2-7fd770d801e9",
                                                "text": "Primarily seen as a publicity vehicle for late-year releases, the awards show and its promoters have lately made pretensions to Oscar oracling: Jamie Foxx won the “breakthrough actor of the year” prize for “Ray” in 2004, after all, and Paul Haggis and his ensemble cast were honored for “Crash” four months before it won best picture."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
