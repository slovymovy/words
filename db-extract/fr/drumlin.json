                "senses": [
                    {
                        "sense_id": "180cff88-fe7c-3f42-8c70-536e4c2d398e",
                        "entry_id": "ef76db4c-da0d-33f5-a887-3ae859b5a7d3",
                        "glosses": [
                            "Relief d’origine glaciaire caractérisé par une crête rectiligne et allongée dont la longueur varie de plusieurs dizaines de mètres à plus d’un kilomètre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "761eee6f-ef40-404f-b01f-8653e6395328",
                                "sense_id": "180cff88-fe7c-3f42-8c70-536e4c2d398e",
                                "text": "À l’est, on distinguait les sommets de Snowdonia, le drumlin chauve de Holy Island, à l’entrée de Holyhead."
                            },
                            {
                                "example_id": "bb804d9a-b851-42f1-8bdf-74bd8f7f45f8",
                                "sense_id": "180cff88-fe7c-3f42-8c70-536e4c2d398e",
                                "text": "Les moraines terminales sont vallonnées d’une façon qui semble raisonnable, pas aussi lisses que les drumlins mais encore harmonieuses, rythmiques, tandis que les moraines kames sont toutes chaotiques, semées de creux et de bosses, imprévisibles, avec dans leur apparence quelque chose de fortuit et des secrets."
                            }
                        ]
                    }
                ],
