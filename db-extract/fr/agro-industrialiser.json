                "senses": [
                    {
                        "sense_id": "315f4112-17af-3a35-899c-e3e05c59ab23",
                        "entry_id": "21618854-2751-324f-a5aa-2a16acea397f",
                        "glosses": [
                            "Donner un caractère agro-industriel à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f4a31498-656b-413c-b668-97f0c62f5442",
                                "sense_id": "315f4112-17af-3a35-899c-e3e05c59ab23",
                                "text": "Ces mutations s'articulent avec la stratégie de l'Etat, qui entend agro-industrialiser la région et l'insérer dans les marchés régionaux et mondiaux."
                            },
                            {
                                "example_id": "a9030d6a-5046-4818-a4bd-a89ba5572ad3",
                                "sense_id": "315f4112-17af-3a35-899c-e3e05c59ab23",
                                "text": "Entre 1963 et 1970, on poursuit à Cuba une politique qui tend à convertir l’île en un pays agro-industrialisé."
                            },
                            {
                                "example_id": "e68a8bb8-3d8d-4e4e-8506-267dcbdfe057",
                                "sense_id": "315f4112-17af-3a35-899c-e3e05c59ab23",
                                "text": "L'occasion d'interroger, une fois de plus, la logique de notre système alimentaire agro-industrialisé et ultra-mondialisé."
                            }
                        ]
                    }
