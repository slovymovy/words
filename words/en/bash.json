                                "target_lang_word": "fiesta",
                                "target_lang_sense_clarification": "reunión festiva grande"
                            },
                            {
                                "target_lang_word": "juerga",
                                "target_lang_sense_clarification": "fiesta animada o bulliciosa"
                            },
                            {
                                "target_lang_word": "fiestón",
                                "target_lang_sense_clarification": "fiesta muy grande o memorable (coloquial)"
