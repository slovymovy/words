                                        "entry_id": "0f95c963-4dbf-3ce3-80c8-a3403a2a680c",
                                        "glosses": [
                                            "příslušník povolání zabývajícího se likvidací zvířat, zejména psů a koček"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e127298c-729f-460a-bac5-d576c6c24797",
                                                "sense_id": "7f871900-88e9-3441-bbe1-8c788daadd42",
                                                "text": "„Ras má na něho právo.“ — „Rasu ho nevydáme,“ prohlásil stručně, ale rozhodně hospodář."
                                            },
                                            {
                                                "example_id": "46ef2b62-539c-49e2-ac8b-b97134e0ccfd",
                                                "sense_id": "7f871900-88e9-3441-bbe1-8c788daadd42",
                                                "text": "A nyní, když jsem už stár a nemocen, když už se ani hýbat ani štěkat nemohu, vyvedli mě sem a přivázali ke plotu, aby mě ras zabil."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ebec7bd7-6e82-35e1-bf05-f57542810f85",
                                        "entry_id": "0f95c963-4dbf-3ce3-80c8-a3403a2a680c",
                                        "glosses": [
                                            "nemilosrdný člověk"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "13a5b857-f697-46d5-8add-fbce3df76388",
                                                "sense_id": "ebec7bd7-6e82-35e1-bf05-f57542810f85",
                                                "text": "„Vojsko na nás! Střílet do nás!“ odpovídal ze dvora zuřivý hlahol. „Vojsko na nás! Ten ras!“"
                                            },
                                            {
                                                "example_id": "77a9904d-679b-4fbf-99df-8fb47e319aab",
                                                "sense_id": "ebec7bd7-6e82-35e1-bf05-f57542810f85",
                                                "text": "Ten byl ras na svý podřízený a tejral je, kde moh, a nejvíc si zalez na nějakýho vejhybkáře Jungwirta, až ten chudák se ze zoufalství šel utopit do řeky."
                                            }
                                        ]
                                    }
                                ]
                            },
