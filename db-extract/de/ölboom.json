                "senses": [
                    {
                        "sense_id": "68eeb2cf-25ac-366b-9a50-dd3fb8fb16f8",
                        "entry_id": "2d7e35dd-8947-3ada-b751-7b01eab44e84",
                        "glosses": [
                            "wirtschaftlicher Aufschwung als Folge von entdecktem Erdöl"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4f632a28-4a1e-4bd3-86d1-a832a2012964",
                                "sense_id": "68eeb2cf-25ac-366b-9a50-dd3fb8fb16f8",
                                "text": "„Der Boden ist recht fruchtbar und der Ölboom hat diesen Teil des Bundesstaates noch nicht erreicht.“"
                            },
                            {
                                "example_id": "129628ef-15ac-4a81-8819-65c93ebf7c95",
                                "sense_id": "68eeb2cf-25ac-366b-9a50-dd3fb8fb16f8",
                                "text": "„Hinzu kam eine mit dem Ölboom der 1970er Jahre wachsende Arbeitsmigration, insbesondere in die arabischen Golfstaaten.“"
                            },
                            {
                                "example_id": "26e43c3e-6aad-4a1e-97bb-0a897ccfca59",
                                "sense_id": "68eeb2cf-25ac-366b-9a50-dd3fb8fb16f8",
                                "text": "„Die Bewegung begann mit Abdul Wahab (1703–1792) und sollte arabische Beduinen vom Einfluss des Sufismus läutern; nach dem Ölboom in den 1970ern wurde die Unterstützung des Wahhabismus zum Schwerpunkt saudischer Außenpolitik.“"
                            },
                            {
                                "example_id": "460c4a75-7102-4ca9-a20a-4e691e407e8c",
                                "sense_id": "68eeb2cf-25ac-366b-9a50-dd3fb8fb16f8",
                                "text": "„Kuwait war in vieler Hinsicht ein hässliches Land, und der Ölboom hatte es nicht schöner gemacht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
