                        "examples": [
                            {
                                "example_id": "b42d296f-5c0c-49d6-b227-4e6c0896fff2",
                                "sense_id": "f91fd88d-0d3b-3a58-b254-89e4fe05ad47",
                                "text": "[…] some of our modern chemists by their strange limbecks, by their spells, philosopher's stones and charms."
                            },
                            {
                                "example_id": "a1c20c2a-c82d-41cf-9def-75b1d7de42cd",
                                "sense_id": "f91fd88d-0d3b-3a58-b254-89e4fe05ad47",
                                "text": "I, by loves limbecke, am the grave / Of all, that's nothing."
                            },
                            {
                                "example_id": "00206fe8-7804-4270-808a-7245e5e79d5f",
                                "sense_id": "f91fd88d-0d3b-3a58-b254-89e4fe05ad47",
                                "text": "Her strong enchantments failing,\nHer towers of fear in wreck,\nHer limbecks dried of poisons\nAnd the knife at her neck,\nThe Queen of air and darkness\nBegins to shrill and cry,\n‘O young man, O my slayer,\nTo-morrow you shall die.’"
                            }
                        ]
                    }
