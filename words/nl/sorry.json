                    "examples": [
                        {
                            "text": "<w>Sorry</w>, ik wist niet dat dit jouw stoel was.",
                            "target_lang_translations": {
                                "en": "<w>Sorry</w>, I didn't know this was your chair.",
                                "ru": "<w>Извини</w>, я не знал, что это твой стул.",
                                "pl": "<w>Przepraszam</w>, nie wiedziałem, że to twoje krzesło.",
                                "de": "<w>Entschuldigung</w>, ich wusste nicht, dass das dein Stuhl war.",
