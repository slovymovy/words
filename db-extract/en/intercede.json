                        "target_lang_word": "verwenden",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verwenden",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "20c36b08-92f4-3bd4-819a-ed7c1a62a6b7",
                                        "entry_id": "8481a19f-76e5-3dce-933b-a07c9b0b74ea",
                                        "glosses": [
                                            "etwas benutzen, zu einem bestimmten Zweck einsetzen"
                                        ],
                                        "tags": [
                                            "konkret oder abstrakt"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6b71e09d-e96c-4101-b900-bff473328157",
                                                "sense_id": "20c36b08-92f4-3bd4-819a-ed7c1a62a6b7",
                                                "text": "Die Worte, die ich verwendete, schienen mir angemessen."
                                            },
                                            {
                                                "example_id": "b532d7ef-c442-48a0-b271-0c0b760109c4",
                                                "sense_id": "20c36b08-92f4-3bd4-819a-ed7c1a62a6b7",
                                                "text": "Ich konnte mein Fahrrad wieder verwenden."
                                            },
                                            {
                                                "example_id": "f6d1e914-44f0-4e4f-af3d-215f346d9300",
                                                "sense_id": "20c36b08-92f4-3bd4-819a-ed7c1a62a6b7",
                                                "text": "„Nur für obergärige Biere darf Weizen anstelle von Gerste verwendet werden.“"
                                            },
                                            {
                                                "example_id": "2497d0d1-dd99-4f64-86f4-130af181e9ad",
                                                "sense_id": "20c36b08-92f4-3bd4-819a-ed7c1a62a6b7",
                                                "text": "„Bei Morphinisten wurde Insulin gegen die Entziehungserscheinungen verwandt […].“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0b33694d-6eb4-3779-a971-12bf97fef36b",
                                        "entry_id": "8481a19f-76e5-3dce-933b-a07c9b0b74ea",
                                        "glosses": [
                                            "sich um jemandes Interessen kümmern"
                                        ],
                                        "tags": [
                                            "sich für jemanden oder etwas verwenden"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "02d18ff0-cb87-48ce-bc79-7611ba9f498e",
                                                "sense_id": "0b33694d-6eb4-3779-a971-12bf97fef36b",
                                                "text": "Könntest du dich nicht bei deiner Firmenleitung für mich verwenden?"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1284d98e-94a7-48bc-a63a-160c552f0b2e",
                        "source_entry_id": "02f3f924-5362-3328-b567-d908f7c4fac9",
                        "source_sense_description": "to plea on someone else's behalf",
                        "target_lang_word": "eingreifen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "eingreifen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "508ef2d3-ef7d-3156-92ba-910a5d02494f",
                                        "entry_id": "a6ec8fbc-9cc2-3d76-ae00-e6d05535a08d",
                                        "glosses": [
                                            "eine Handlung oder Entwicklung (an der man nicht direkt beteiligt ist) lenken, stören oder stoppen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0996fe47-516b-4062-bb2b-e3f094e5bcdb",
                                                "sense_id": "508ef2d3-ef7d-3156-92ba-910a5d02494f",
                                                "text": "Wenn die Streitereien in der Mannschaft so weitergehen, wird der Trainer eingreifen müssen."
                                            },
                                            {
                                                "example_id": "b3fa964d-4696-4f24-a9af-c07a17d37e07",
                                                "sense_id": "508ef2d3-ef7d-3156-92ba-910a5d02494f",
                                                "text": "„Sie dürfen auch nicht in die Programmautonomie von ARD und ZDF eingreifen.“"
                                            },
                                            {
                                                "example_id": "4ca86e89-e483-4d8c-a22b-ba78b9e70b71",
                                                "sense_id": "508ef2d3-ef7d-3156-92ba-910a5d02494f",
                                                "text": "Hätte man nicht rechtzeitig eingegriffen, wäre es zu einer Katastrophe gekommen."
                                            },
                                            {
                                                "example_id": "1b18c0b3-da44-40b7-98be-dbbf90e21243",
                                                "sense_id": "508ef2d3-ef7d-3156-92ba-910a5d02494f",
                                                "text": "„Der Angelsachse begnügte sich mit sprachlichen Korrekturen am Text der Vulgata, während der Westgote tiefer in die textliche Gestaltung eingriff.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "819ea40c-9c55-3c71-9efa-1281f6640dcf",
                                        "entry_id": "a6ec8fbc-9cc2-3d76-ae00-e6d05535a08d",
                                        "glosses": [
                                            "als ein herausstehendes Teil in die passende Öffnung eines anderen Teils hineingleiten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc18ae84-8f33-4cf4-8530-3c0ef8fcd085",
                                                "sense_id": "819ea40c-9c55-3c71-9efa-1281f6640dcf",
                                                "text": "„William Spears Simpson erfindet die Simpson-Hebelkette, eine Konstruktion, bei der das Kettenblatt an den inneren Bolzen und das Ritzel an den äußeren Bolzen der dreieckförmigen Kettenglieder eingreifen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
