                                    {
                                        "sense_id": "0e5c125e-e79d-35dc-9153-156cc3498f8b",
                                        "entry_id": "8edda81e-2bef-32c6-8919-e55131560ed0",
                                        "glosses": [
                                            "als nieuw, weer geheeld, opnieuw tot leven gekomen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d4c24bc-4d03-4dd3-b6bd-89d6e54692ae",
                                                "sense_id": "0e5c125e-e79d-35dc-9153-156cc3498f8b",
                                                "text": "De tiener wil daarom af van haar familienaam al-Qunun, en enkel nog Rahaf Mohammed heten. De vrouw is van plan om Engels te leren en werk te zoeken. ‘Ik heb het gevoel dat ik herboren ben, zeker nu ik al die liefde voel. Zeg aan de Canadezen dat ik van hen hou.’"
                                            },
                                            {
                                                "example_id": "53705817-e714-4848-9b60-a5f02d1c35cc",
                                                "sense_id": "0e5c125e-e79d-35dc-9153-156cc3498f8b",
                                                "text": "Wetenschappers meldden een herboren 30.000 jaar oude ijsplant."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "07160300-d19f-477e-9d08-675c7769a62e",
                        "source_entry_id": "f2075fd1-77e3-3210-996c-19a9ca0a5c0a",
                        "source_sense_description": "revived or regenerated, especially emotionally or spiritually",
                        "target_lang_word": "rené",
