                        "sense_id": "c726f195-731f-3760-906d-7bdbc7e28f91",
                        "entry_id": "6d8d7d04-599d-34db-aa13-21b34947a7ae",
                        "glosses": [
                            "Plan für den/einen Krieg"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1966cd4f-7984-410f-a8e6-b48c5f7340ee",
                                "sense_id": "c726f195-731f-3760-906d-7bdbc7e28f91",
                                "text": "„Aus dem Generalstab, wo man inzwischen realisiert hatte, dass der eigene Kriegsplan auch in Frankreich gescheitert war, drangen vor allem Desinformationen.“"
                            },
                            {
                                "example_id": "aea66e9e-56f2-41e1-aa8c-47471a370344",
                                "sense_id": "c726f195-731f-3760-906d-7bdbc7e28f91",
                                "text": "„Der Kaiser war einen Monat im Hauptquartier, und dabei schwankte man jetzt sogar noch mehr als früher, welcher von den vielen vorgeschlagenen Kriegsplänen angenommen werden sollte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
