                "senses": [
                    {
                        "sense_id": "e9729140-b8e2-3d2e-844f-e051efbb6bad",
                        "entry_id": "66981331-2e49-3bc9-ba7c-477625c923dc",
                        "glosses": [
                            "Ville française, chef-lieu du département des Hautes-Pyrénées."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0347f3ea-d013-46d2-9a61-ee473674ea2d",
                                "sense_id": "e9729140-b8e2-3d2e-844f-e051efbb6bad",
                                "text": "Avec 37,2°C, la ville de Tarbes, au pied des Pyrénées, n'avait pas eu aussi chaud en septembre depuis près de 60 ans (35,8°C en 1964)."
                            },
                            {
                                "example_id": "830a437c-5b78-4d4d-84c7-91e566f6b4ee",
                                "sense_id": "e9729140-b8e2-3d2e-844f-e051efbb6bad",
                                "text": "Fourniture et installation de meubles-bar au « foyer du soldat » et au « mess mixte » du quartier Soult, à Tarbes (Hautes-Pyrénées)."
                            },
                            {
                                "example_id": "a485eb87-b78b-41df-b245-2b3539e4c768",
                                "sense_id": "e9729140-b8e2-3d2e-844f-e051efbb6bad",
                                "text": "Natif de Tarbes, Ferdinand Foch est une figure bien connue des Ploujeannais."
                            }
                        ]
                    }
