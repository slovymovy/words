                "senses": [
                    {
                        "sense_id": "c351f3ca-8ea8-3085-b892-e6936e0da211",
                        "entry_id": "2b3578b8-6b82-3067-afcf-1d55693ae2cc",
                        "glosses": [
                            "Rendre fini."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "910fbf3c-438c-42b5-b313-42896da96dd0",
                                "sense_id": "c351f3ca-8ea8-3085-b892-e6936e0da211",
                                "text": "A tel point que l'on pouvait douter que la phénoménologie puisse penser l'infini comme tel, sans aussitôt le «phénoménaliser», c'est-à-dire le «finitiser» ou l'«indéfiniser»."
                            },
                            {
                                "example_id": "63c4be22-235a-46fb-8c2a-a8e528569d09",
                                "sense_id": "c351f3ca-8ea8-3085-b892-e6936e0da211",
                                "text": "Parce qu'elle est infiniment surpassée par la puissance de l'Un, l'Intelligence ne peut que finitiser cette infinité."
                            }
                        ]
                    }
                ],
