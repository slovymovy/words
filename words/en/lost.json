{
    "word_family": [
        "lose",
        "loser",
        "loss"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "93a8b810-d6f5-3d14-803d-f6329b0078e7",
                    "sense_definition": "Simple past and past participle of <w>lose</w>.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I <w>lost</w> my wallet on the bus yesterday.",
                            "target_lang_translations": {
                                "ru": "Я вчера <w>потерял</w> свой кошелек в автобусе.",
                                "zh": "我昨天在公交车上<w>丢了</w>钱包。"
                            }
                        },
                        {
                            "text": "She has <w>lost</w> a lot of weight recently.",
                            "target_lang_translations": {
                                "ru": "Она недавно <w>сбросила</w> много веса.",
                                "zh": "她最近<w>减掉</w>了很多体重。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "lost the game",
                        "lost my mind",
                        "lost weight",
                        "lost touch"
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время и причастие прошедшего времени от <w>lose</w>.",
                        "zh": "动词 lose 的过去式和过去分词。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "потерял",
                                "target_lang_sense_clarification": "форма прошедшего времени"
                            },
                            {
                                "target_lang_word": "проиграл",
                                "target_lang_sense_clarification": "в игре или соревновании"
                            },
                            {
                                "target_lang_word": "потерянный",
                                "target_lang_sense_clarification": "причастие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "丢失",
                                "target_lang_sense_clarification": "遗失物品"
                            },
                            {
                                "target_lang_word": "输掉",
                                "target_lang_sense_clarification": "在比赛或竞争中失败"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "2f83b14b-416c-3494-b19f-59f804c94686",
                    "sense_definition": "Unable to find one's way; not knowing where one is.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "missing_disoriented",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children were soon <w>lost</w> in the forest.",
                            "target_lang_translations": {
                                "ru": "Дети вскоре <w>заблудились</w> в лесу.",
                                "zh": "孩子们很快就在森林里<w>迷路</w>了。"
                            }
                        },
                        {
                            "text": "I got <w>lost</w> while trying to find the hotel.",
                            "target_lang_translations": {
                                "ru": "Я <w>заблудился</w>, пытаясь найти отель.",
                                "zh": "我在找酒店的时候<w>迷路</w>了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "disoriented",
                        "astray"
                    ],
                    "antonyms": [
                        "found",
                        "oriented"
                    ],
                    "common_phrases": [
                        "get lost",
                        "lost in the woods"
                    ],
                    "target_lang_definitions": {
                        "ru": "Неспособный найти дорогу; не знающий, где находится.",
                        "zh": "无法找到方向；不知道自己身处何处。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заблудившийся",
                                "target_lang_sense_clarification": "сбившийся с пути"
                            },
                            {
                                "target_lang_word": "потерявшийся",
                                "target_lang_sense_clarification": "о человеке или животном"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "迷路",
                                "target_lang_sense_clarification": "找不到方向"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "233bda9f-fb86-34a4-9b7d-4a1e758ab622",
                    "sense_definition": "Missing and unable to be found; in an unknown location.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "missing_disoriented",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My keys are <w>lost</w> somewhere in the house.",
                            "target_lang_translations": {
                                "ru": "Мои ключи <w>потерялись</w> где-то в доме.",
                                "zh": "我的钥匙<w>丢</w>在屋里的某个地方了。"
                            }
                        },
                        {
                            "text": "The <w>lost</w> dog was finally returned to its owner.",
                            "target_lang_translations": {
                                "ru": "<w>Пропавшую</w> собаку наконец вернули владельцу.",
                                "zh": "那只<w>走失</w>的狗终于被送回了主人身边。"
                            }
                        }
                    ],
                    "synonyms": [
                        "missing",
                        "misplaced",
                        "gone"
                    ],
                    "antonyms": [
                        "found",
                        "recovered"
                    ],
                    "common_phrases": [
                        "lost and found",
                        "lost property"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отсутствующий и не поддающийся нахождению; находящийся в неизвестном месте.",
                        "zh": "遗失且无法找到；处于未知位置。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "потерянный",
                                "target_lang_sense_clarification": "об утраченном предмете"
                            },
                            {
                                "target_lang_word": "пропавший",
                                "target_lang_sense_clarification": "исчезнувший"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "丢失的",
                                "target_lang_sense_clarification": "指遗失的物品"
                            },
                            {
                                "target_lang_word": "走失的",
                                "target_lang_sense_clarification": "指走失的人或动物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "64434578-3dc2-3f9e-aa7b-5670853b7a4d",
                    "sense_definition": "Not used effectively or enjoyed; wasted or squandered.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "wasted_ruined",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We need to work hard to make up for <w>lost</w> time.",
                            "target_lang_translations": {
                                "ru": "Нам нужно усердно работать, чтобы наверстать <w>упущенное</w> время.",
                                "zh": "我们需要努力工作以弥补<w>浪费</w>的时间。"
                            }
                        },
                        {
                            "text": "It was a <w>lost</w> opportunity to make a good impression.",
                            "target_lang_translations": {
                                "ru": "Это была <w>упущенная</w> возможность произвести хорошее впечатление.",
                                "zh": "那是一个<w>错过</w>的好机会，没能给人留下好印象。"
                            }
                        }
                    ],
                    "synonyms": [
                        "wasted",
                        "squandered",
                        "missed",
                        "gone",
                        "forfeited"
                    ],
                    "antonyms": [
                        "utilized",
                        "seized"
                    ],
                    "common_phrases": [
                        "lost time",
                        "lost opportunity",
                        "make up for lost time"
                    ],
                    "target_lang_definitions": {
                        "ru": "Не использованный эффективно или с удовольствием; потраченный впустую.",
                        "zh": "未被有效利用或享受；被浪费或挥霍。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "упущенный",
                                "target_lang_sense_clarification": "о возможности или времени"
                            },
                            {
                                "target_lang_word": "потерянный",
                                "target_lang_sense_clarification": "потраченный зря"
                            },
                            {
                                "target_lang_word": "напрасный",
                                "target_lang_sense_clarification": "бесполезный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "错过的",
                                "target_lang_sense_clarification": "指机会"
                            },
                            {
                                "target_lang_word": "浪费的",
                                "target_lang_sense_clarification": "指时间或资源"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2a744d26-c883-356b-ac38-3cf97af039ca",
                    "sense_definition": "Deeply absorbed in thought or an activity, ignoring surroundings.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mental_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She was <w>lost</w> in thought and didn't hear the phone ring.",
                            "target_lang_translations": {
                                "ru": "Она была <w>погружена</w> в мысли и не услышала звонка телефона.",
                                "zh": "她<w>沉浸</w>在思考中，没听见电话响。"
                            }
                        },
                        {
                            "text": "He sat in the corner, completely <w>lost</w> in his book.",
                            "target_lang_translations": {
                                "ru": "Он сидел в углу, полностью <w>погруженный</w> в свою книгу.",
                                "zh": "他坐在角落里，完全<w>沉浸</w>在书本中。"
                            }
                        }
                    ],
                    "synonyms": [
                        "absorbed",
                        "engrossed",
                        "preoccupied"
                    ],
                    "antonyms": [
                        "alert",
                        "attentive"
                    ],
                    "common_phrases": [
                        "lost in thought",
                        "lost in translation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Глубоко погруженный в мысли или занятие, не замечающий окружающего.",
                        "zh": "全神贯注于思考或某项活动，忽略了周围环境。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "погружённый",
                                "target_lang_sense_clarification": "ушедший в себя или дело"
                            },
                            {
                                "target_lang_word": "углублённый",
                                "target_lang_sense_clarification": "сосредоточенный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "沉浸在",
                                "target_lang_sense_clarification": "专注于某事"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "001f70f0-b8d5-307b-bc94-e7783e02b1a9",
                    "sense_definition": "No longer possessed, retained, or held.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "missing_disoriented",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old man often spoke about his <w>lost</w> youth.",
                            "target_lang_translations": {
                                "ru": "Старик часто говорил о своей <w>утраченной</w> молодости.",
                                "zh": "老人经常谈起他那<w>失去</w>的青春。"
                            }
                        },
                        {
                            "text": "They fought bravely to regain their <w>lost</w> honor.",
                            "target_lang_translations": {
                                "ru": "Они храбро сражались, чтобы вернуть свою <w>утраченную</w> честь.",
                                "zh": "他们英勇奋战，试图夺回<w>失去</w>的荣誉。"
                            }
                        }
                    ],
                    "synonyms": [
                        "gone",
                        "forfeited"
                    ],
                    "antonyms": [
                        "retained",
                        "kept"
                    ],
                    "common_phrases": [
                        "lost art",
                        "lost love"
                    ],
                    "target_lang_definitions": {
                        "ru": "Больше не принадлежащий, не удержанный или не сохраненный.",
                        "zh": "不再拥有、保留或持有。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "утраченный",
                                "target_lang_sense_clarification": "лишившийся чего-либо ценного"
                            },
                            {
                                "target_lang_word": "потерянный",
                                "target_lang_sense_clarification": "об исчезнувшем чувстве или качестве"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "失去的",
                                "target_lang_sense_clarification": "指不再拥有的事物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4f1e548b-c0a6-3b34-b6b3-9259ed7cbcc4",
                    "sense_definition": "Physically destroyed, dead, or morally ruined; beyond hope.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "wasted_ruined",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ship was <w>lost</w> at sea during the terrible storm.",
                            "target_lang_translations": {
                                "ru": "Корабль <w>погиб</w> в море во время ужасного шторма.",
                                "zh": "那艘船在可怕的暴风雨中<w>沉没</w>了。"
                            }
                        },
                        {
                            "text": "He felt like a <w>lost</w> soul wandering through the city.",
                            "target_lang_translations": {
                                "ru": "Он чувствовал себя <w>заблудшей</w> душой, бродящей по городу.",
                                "zh": "他感觉自己像个<w>迷茫</w>的灵魂在城市中游荡。"
                            }
                        }
                    ],
                    "synonyms": [
                        "destroyed",
                        "ruined",
                        "doomed"
                    ],
                    "antonyms": [
                        "saved"
                    ],
                    "common_phrases": [
                        "lost at sea",
                        "lost cause",
                        "lost soul"
                    ],
                    "target_lang_definitions": {
                        "ru": "Физически уничтоженный, погибший или морально опустившийся; безнадежный.",
                        "zh": "物理上被摧毁、死亡或道德上堕落；毫无希望。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "погибший",
                                "target_lang_sense_clarification": "умерший или уничтоженный"
                            },
                            {
                                "target_lang_word": "падший",
                                "target_lang_sense_clarification": "морально опустившийся"
                            },
                            {
                                "target_lang_word": "пропавший",
                                "target_lang_sense_clarification": "без вести или безнадежно"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "丧生的",
                                "target_lang_sense_clarification": "指生命消逝"
                            },
                            {
                                "target_lang_word": "绝望的",
                                "target_lang_sense_clarification": "指毫无希望的境地"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f27480bd-3ca1-3026-b612-8ea5ce30f4a2",
                    "sense_definition": "No longer visible or perceptible; hidden by surroundings.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "missing_disoriented",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The small cottage was almost <w>lost</w> in the dense fog.",
                            "target_lang_translations": {
                                "ru": "Маленький коттедж почти <w>скрылся</w> в густом тумане.",
                                "zh": "那间小屋几乎<w>淹没</w>在浓雾中。"
                            }
                        },
                        {
                            "text": "I felt completely <w>lost</w> in the crowd of strangers.",
                            "target_lang_translations": {
                                "ru": "Я чувствовал себя совершенно <w>потерянным</w> в толпе незнакомцев.",
                                "zh": "在陌生的人群中，我感到完全<w>迷失</w>了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "hidden",
                        "obscured"
                    ],
                    "antonyms": [
                        "visible",
                        "distinct"
                    ],
                    "common_phrases": [
                        "lost in the crowd"
                    ],
                    "target_lang_definitions": {
                        "ru": "Больше не видимый или не ощутимый; скрытый окружением.",
                        "zh": "不再可见或可察觉；被周围环境遮蔽。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "затерявшийся",
                                "target_lang_sense_clarification": "среди множества других"
                            },
                            {
                                "target_lang_word": "скрытый",
                                "target_lang_sense_clarification": "невидимый"
                            },
                            {
                                "target_lang_word": "исчезнувший",
                                "target_lang_sense_clarification": "пропавший из виду"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "淹没在",
                                "target_lang_sense_clarification": "被周围事物遮盖"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "70ab0248-ab12-312f-ac8a-7af038b49761",
                    "sense_definition": "Hardened beyond sensibility or recovery; indifferent.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mental_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He seemed <w>lost</w> to all sense of shame after the incident.",
                            "target_lang_translations": {
                                "ru": "После этого случая он, казалось, <w>потерял</w> всякий стыд.",
                                "zh": "那件事之后，他似乎<w>丧失</w>了所有的羞耻感。"
                            }
                        },
                        {
                            "text": "The tyrant was <w>lost</w> to any feeling of compassion.",
                            "target_lang_translations": {
                                "ru": "Тиран был <w>лишен</w> какого-либо чувства сострадания.",
                                "zh": "那个暴君<w>丧失</w>了任何同情心。"
                            }
                        }
                    ],
                    "synonyms": [
                        "insensible",
                        "indifferent"
                    ],
                    "common_phrases": [
                        "lost to shame"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "often literary or archaic usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Очерствевший, не поддающийся чувствам или исправлению; безразличный.",
                        "zh": "变得麻木不仁或无法挽回；冷漠。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лишенный",
                                "target_lang_sense_clarification": "утративший способность чувствовать"
                            },
                            {
                                "target_lang_word": "потерявший",
                                "target_lang_sense_clarification": "утративший стыд или совесть"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "丧失",
                                "target_lang_sense_clarification": "指失去某种情感或能力"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}