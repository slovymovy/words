                                        "tags": [
                                            "vlinders"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "883280f0-3a0c-4797-b294-c60450128f8e",
                                                "sense_id": "b516965d-b602-3513-b9f3-794d210fb755",
                                                "text": "De rupsen van de hyena doen hun naam eer aan: ze eten andere rupsen."
