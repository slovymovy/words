                                "target_senses": [
                                    {
                                        "sense_id": "c5432b01-4dfe-3ac1-bec4-315426916330",
                                        "entry_id": "04913368-ed3d-37b9-b5d9-0e507b620f7c",
                                        "glosses": [
                                            "vuur in de buitenlucht waaromheen mensen zich (voor de gezelligheid) verzamelen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f0b3bc4-93db-4880-8959-fbb61ac2b26e",
                                                "sense_id": "c5432b01-4dfe-3ac1-bec4-315426916330",
                                                "text": "De naad in mijn onderbroek veroorzaakte zoveel pijn dat ik hem uittrok en die avond op het kampvuur ritueel verbrandde. De resterende vijf maanden heb ik nooit meer een onderbroek aan gehad."
                                            },
                                            {
                                                "example_id": "28450b3b-b93d-42c6-8364-6f32193277be",
                                                "sense_id": "c5432b01-4dfe-3ac1-bec4-315426916330",
                                                "text": "‘Sinds de hotsprings heb ik je niet meer gezien.’ Met stralende ogen vertelde hij wat ik daar allemaal gemist had: een leuke groep meiden, een kampvuurtje en tot diep in de nacht in het warme water."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
