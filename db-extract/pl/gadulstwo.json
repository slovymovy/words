                "senses": [
                    {
                        "sense_id": "a0430286-4d8b-39eb-9f6c-55eeea45998f",
                        "entry_id": "42962df7-7b26-3862-9658-b1e5f33240e0",
                        "glosses": [
                            "mówienie zbyt dużo, zbędne gadanie"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "4b6cbdf7-1481-4edf-b14b-8beaf880bfbb",
                                "sense_id": "a0430286-4d8b-39eb-9f6c-55eeea45998f",
                                "text": "…unikaj zbędnego gadulstwa, nie wdawaj się w plotki, nie oceniaj bez sprawdzania, nie podpisuj bez czytania - a będziesz spokojny i zadowolony"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "e610d950-29ff-3cee-85b9-7d6538b8eedf",
                        "entry_id": "42962df7-7b26-3862-9658-b1e5f33240e0",
