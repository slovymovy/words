                                            {
                                                "example_id": "80dffc2b-e944-4cfe-b2a1-5a7d1c25f89a",
                                                "sense_id": "7c38a728-92d5-357a-91e9-f4efbdede61a",
                                                "text": "Klaus stört es, dass er einen so großen Adamsapfel hat."
                                            },
                                            {
                                                "example_id": "8fcc751f-db70-440e-b0bd-0d0f79183b01",
                                                "sense_id": "7c38a728-92d5-357a-91e9-f4efbdede61a",
                                                "text": "„Als auch Mutter und Brüder schwiegen, erhob Ludwig sich, stand eine Weile mit zuckendem Adamsapfel da, als wolle er noch etwas sagen, und entschwand dann aufatmend ins Freie.“"
                                            },
                                            {
                                                "example_id": "dafa539a-be78-4b31-958a-809bd546db8b",
                                                "sense_id": "7c38a728-92d5-357a-91e9-f4efbdede61a",
                                                "text": "„Ich war ganz besonders darüber erstaunt, wie sich der Adamsapfel bei Bässen auf und ab bewegte.“"
                                            },
                                            {
                                                "example_id": "a9d487c2-ab3e-4452-b782-a9f0c4758242",
                                                "sense_id": "7c38a728-92d5-357a-91e9-f4efbdede61a",
                                                "text": "„Bertram nickte, schluckte, sein Adamsapfel hüpfte die magere Jungenkehle hinauf und hinunter.“"
                                            },
                                            {
                                                "example_id": "5446cdd6-3c90-4c79-8fbd-392631ab687d",
                                                "sense_id": "7c38a728-92d5-357a-91e9-f4efbdede61a",
                                                "text": "„Ein langer, vornehmer Hals ragte weit aus dem Kragen, und wenn er kaute, bewegte sich der Adamsapfel hastig auf und ab.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
