                        "examples": [
                            {
                                "example_id": "333db05f-a66d-4836-a92f-0e57709a048d",
                                "sense_id": "3e343bab-043e-3be7-af32-4f55a03425b2",
                                "text": "Daarbij komt nog een fikse boete."
                            },
                            {
                                "example_id": "06fe63f4-2990-4efc-b436-13dcbce869ae",
                                "sense_id": "3e343bab-043e-3be7-af32-4f55a03425b2",
                                "text": "Daar hoort mosterd bij."
                            },
                            {
                                "example_id": "8eaf6065-f65b-43d0-b3dc-6717c2e5e74e",
                                "sense_id": "3e343bab-043e-3be7-af32-4f55a03425b2",
                                "text": "Daarbij opgeteld dat het personeel zich keurig aan de regels had gehouden, kon hij enkel tot de slotsom komen dat het hotel in deze zaak geen enkele blaam trof. Een geruststellende gedachte."
                            },
                            {
                                "example_id": "fc9a4b05-2dcc-4228-8193-f66ce84adba3",
                                "sense_id": "3e343bab-043e-3be7-af32-4f55a03425b2",
                                "text": "En daarbij, ik heb ook een tuchtzaak te bevechten."
                            }
                        ]
                    }
