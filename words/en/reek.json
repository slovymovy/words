                {
                    "sense_id": "78769e04-ba61-34f8-92f5-b19a35bc4b49",
                    "sense_definition": "To be evidently associated with something unpleasant.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "smell",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden change in policy <w>reeks</w> of corruption.",
                            "target_lang_translations": {
                                "cs": "Ta náhlá změna politiky <w>smrdí</w> korupcí.",
                                "zh": "政策的突然改变<w>透着</w>腐败的气息。",
                                "es": "El cambio repentino en la política <w>huele</w> a corrupción.",
                                "nl": "De plotselinge beleidswijziging <w>stinkt</w> naar corruptie.",
                                "pl": "Ta nagła zmiana polityki <w>śmierdzi</w> korupcją.",
                                "de": "Die plötzliche Änderung der Politik <w>stinkt</w> nach Korruption.",
                                "fr": "Le changement soudain de politique <w>pue</w> la corruption.",
                                "it": "L'improvviso cambio di politica <w>puzza</w> di corruzione.",
                                "tr": "Politikadaki ani değişiklik yolsuzluk <w>kokuyor</w>.",
                                "ru": "Эта внезапная смена политики <w>попахивает</w> коррупцией."
                            }
                        },
                        {
                            "text": "His excuse <w>reeks</w> of dishonesty.",
                            "target_lang_translations": {
                                "cs": "Jeho výmluva <w>zavání</w> nepoctivostí.",
                                "zh": "他的借口<w>带有</w>不诚实的嫌疑。",
                                "es": "Su excusa <w>apesta</w> a deshonestidad.",
                                "nl": "Zijn excuus <w>ruikt</w> naar onoprechtheid.",
                                "pl": "Jego wymówka <w>śmierdzi</w> nieuczciwością.",
                                "de": "Seine Ausrede <w>stinkt</w> vor Unehrlichkeit.",
                                "fr": "Son excuse <w>pue</w> la malhonnêteté.",
                                "it": "La sua scusa <w>puzza</w> di disonestà.",
                                "tr": "Onun bahanesi samimiyetsizlik <w>kokuyor</w>.",
                                "ru": "Его оправдание <w>попахивает</w> нечестностью."
                            }
                        }
