                                        "entry_id": "eb759252-d062-3722-af51-1c43e3a6004f",
                                        "glosses": [
                                            "deutsche Bezeichnung für Geographie, der Wissenschaft von der Erde, insbesondere der Erdoberfläche; in Deutschland auch Bezeichnung für das entsprechende Schulfach"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89ed7243-e627-4c93-9168-1dfe1378e42d",
                                                "sense_id": "385e8a9f-3557-3a6e-8327-5882dcfc6d3c",
                                                "text": "Erdkunde war eines meiner Lieblingsfächer."
                                            },
                                            {
                                                "example_id": "9bea29ee-aa15-4137-8981-0fd52603dc50",
                                                "sense_id": "385e8a9f-3557-3a6e-8327-5882dcfc6d3c",
                                                "text": "„Da hat meine Mutter zwei alte deutsche Schulbücher gefunden, daraus unterrichtet sie mich in Erdkunde und Geschichte.“"
                                            },
                                            {
                                                "example_id": "4b30aab0-599f-47ba-a5c1-816272ad2032",
                                                "sense_id": "385e8a9f-3557-3a6e-8327-5882dcfc6d3c",
                                                "text": "„In Erdkunde legte Liesing auf die Wasserscheide besonderes Gewicht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
