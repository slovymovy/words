                        "examples": [
                            {
                                "example_id": "0b5c59f8-d421-483e-b547-cb1764f55cab",
                                "sense_id": "958d17d2-298d-3843-aa60-e37c135e832a",
                                "text": "The year 1866 was signalised by a remarkable incident, [...]"
                            },
                            {
                                "example_id": "121dde5b-70ae-411d-8b29-08db4395b946",
                                "sense_id": "958d17d2-298d-3843-aa60-e37c135e832a",
                                "text": "With the bad permanent way check at Standish and signals before Preston, it was not until after this that No. 10203 got her opportunity, and signalised it by running the 90.1 miles over Shap from Preston to Carlisle in 87 min. 32 sec., or 84½ min. net, the latter 14½ min. inside schedule."
                            }
                        ]
                    }
