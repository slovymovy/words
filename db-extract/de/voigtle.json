                "senses": [
                    {
                        "sense_id": "ce4b0c0b-7aac-3e42-a066-2719130f02ec",
                        "entry_id": "c9e61e68-9c05-37ec-b2f7-6d0237386366",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d8fa25b7-c981-4b16-a390-50b5e82051c3",
                                "sense_id": "ce4b0c0b-7aac-3e42-a066-2719130f02ec",
                                "text": "Frau Voigtle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "3361c744-4e0f-44ee-95f4-b04b54ca7d2f",
                                "sense_id": "ce4b0c0b-7aac-3e42-a066-2719130f02ec",
                                "text": "Herr Voigtle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "2af760a7-99ab-48e8-ad63-bbfcb5ec1ace",
                                "sense_id": "ce4b0c0b-7aac-3e42-a066-2719130f02ec",
                                "text": "Die Voigtles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "d0192685-2407-4ce2-b9d8-244ff82a381c",
                                "sense_id": "ce4b0c0b-7aac-3e42-a066-2719130f02ec",
                                "text": "Der Voigtle trägt nie die Schals, die die Voigtle ihm strickt."
                            },
                            {
                                "example_id": "e4e79eb2-2679-4f6f-83ef-64b18b17aed7",
                                "sense_id": "ce4b0c0b-7aac-3e42-a066-2719130f02ec",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Voigtle kommt, geht der Herr Voigtle.“"
                            },
                            {
                                "example_id": "0790456d-cf4c-46ac-b2f1-860e9e2f18bd",
                                "sense_id": "ce4b0c0b-7aac-3e42-a066-2719130f02ec",
                                "text": "Voigtle kommt und geht."
                            },
                            {
                                "example_id": "2645d23e-bea8-44ee-8362-c3d58703e832",
                                "sense_id": "ce4b0c0b-7aac-3e42-a066-2719130f02ec",
                                "text": "Voigtles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
