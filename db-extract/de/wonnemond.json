                                "target_senses": [
                                    {
                                        "sense_id": "ad3dd06c-ecb1-3d54-aef2-a1392245adec",
                                        "entry_id": "0c0351dd-b214-3c05-8732-4139a2b01b23",
                                        "glosses": [
                                            "pátý měsíc v roce, následující po dubnu"
                                        ],
                                        "tags": [
                                            "poetic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4ee7768c-6f0c-4065-9ac9-020a9eb26371",
                                                "sense_id": "ad3dd06c-ecb1-3d54-aef2-a1392245adec",
                                                "text": "Na prvního máje rozkvétaly šeříky."
                                            },
                                            {
                                                "example_id": "bef0493d-c5b9-43e9-ae01-1e992c864600",
                                                "sense_id": "ad3dd06c-ecb1-3d54-aef2-a1392245adec",
                                                "text": "Dech máje láskou vše naplnil Jde průvod všech pracujcích sil První máj dnes vzdáme práci zdar První máj dnes vzdáme práci zdar"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "máj",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "1a03eabd-094e-32d2-a078-f90a09759a54",
                                        "entry_id": "72a92560-45c2-3ad4-b742-c6f611584910",
                                        "glosses": [
                                            "pokácený strom s odstraněnými spodními větvemi a oloupanou kůrou, ozdobený stuhami, vztyčený na jaře na návsi či před obydlím milované dívky"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17830897-f1ad-4d73-b746-b428ec6d0ff7",
                                                "sense_id": "1a03eabd-094e-32d2-a078-f90a09759a54",
                                                "text": "Chlapci postavili na návsi máj a celou noc u ní bděli."
                                            },
                                            {
                                                "example_id": "9f0d62e1-325e-4957-b6c1-baedd16cc6bb",
                                                "sense_id": "1a03eabd-094e-32d2-a078-f90a09759a54",
                                                "text": "Jen kdyby Dorla také veselejší byla a štěstí došla. Té zajisté že Pavel máj postavil, viz, její je nejvyšší, a pentle na něm vlaje, jako prapor."
                                            },
                                            {
                                                "example_id": "e8f1efe4-6a80-4ec8-8dc8-551043e6c07d",
                                                "sense_id": "1a03eabd-094e-32d2-a078-f90a09759a54",
                                                "text": "Veselou scénku pod májem pak sehráli mladí hasiči s podporou ostřílených divadelních mistrů Antonína Sokola a Vítězslava Sokola, který se již tradičně ujal režie představení. A pak již došlo na samotné kácení máje a lítý boj v soutěži o to, kdo si máj odveze domů."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
