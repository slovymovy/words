                "senses": [
                    {
                        "sense_id": "18bae7c2-a3fa-38d2-8189-8591d3421db0",
                        "entry_id": "ffdb98f1-9379-36d8-aff7-45f6114093bd",
                        "glosses": [
                            "een teken waarmee de gever duidelijk maakt iets of iemand te bewonderen of diegene dankbaar te zijn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a952fb28-a457-4d20-bb33-ab5cca68b758",
                                "sense_id": "18bae7c2-a3fa-38d2-8189-8591d3421db0",
                                "text": "Daarnaast hekelt de commissie het feit dat er geen draagvlakpeiling onder de buurtbewoners is gehouden. 'De discussie die daaruit kan ontstaan, kan voorts afbreuk doen aan het eerbewijs dat met de naamstoekenning wordt beoogd.'"
                            },
                            {
                                "example_id": "4e8248c0-5070-494b-95c8-7b95f6e7305f",
                                "sense_id": "18bae7c2-a3fa-38d2-8189-8591d3421db0",
                                "text": "Het Singel is een gracht die loopt vanaf het IJ tot het Muntplein, waar die uitmondt in de Binnen Amstel. In de zeventiende eeuw werd de gracht wel tijdelijk de Koningsgracht genoemd, als eerbewijs aan Koning Hendrik IV van Frankrijk. In die tijd was dat een belangrijke bondgenoot van de Republiek. Het Koningsplein herinnert nog aan die periode."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b311da87-118d-4e0f-a972-b1930ba5653d",
                        "source_entry_id": "ffdb98f1-9379-36d8-aff7-45f6114093bd",
                        "source_sense_id": "18bae7c2-a3fa-38d2-8189-8591d3421db0",
