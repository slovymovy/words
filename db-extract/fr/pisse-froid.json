                            {
                                "target_word": "wet blanket",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bd669cae-da69-3143-a0eb-4c9b4cfe9b50",
                                        "entry_id": "b3ae6ca4-1af8-3167-a8ca-95b93f3d1293",
                                        "glosses": [
                                            "Alternative form of wet-blanket."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6c09019c-d5e6-49a9-ae9e-8f43b76744f1",
                                                "sense_id": "bd669cae-da69-3143-a0eb-4c9b4cfe9b50",
                                                "text": "I say almost because I could still hear Ted trying his best to wet blanket Webster's Halloween costume idea."
                                            },
                                            {
                                                "example_id": "fa832768-91a0-4f23-b17d-b02c2ac86848",
                                                "sense_id": "bd669cae-da69-3143-a0eb-4c9b4cfe9b50",
                                                "text": "The secretary of the state retail association recently seen wet blanketed the whole thing, doubting the possibility of representative figures, or of getting the dealers to tell the truth, at least when business was poor and they begin to cut the prices of their competitors."
                                            },
                                            {
                                                "example_id": "205f8851-a5e6-4413-b0dd-e2a3234a129c",
                                                "sense_id": "bd669cae-da69-3143-a0eb-4c9b4cfe9b50",
                                                "text": "Nevertheless there is a certain handicap to the child who has been snubbed, mocked, jeered, wet blanketed and undervalued."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7de46830-88e4-4242-83b3-077102647d5d",
                        "source_entry_id": "a8999d73-b437-3198-b021-c60dc5ede0f4",
                        "source_sense_id": "035a5a20-69a0-36a4-9611-fd6d105b6048",
                        "target_lang_word": "cold fish",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cold fish",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3c64d9ff-7a08-3a4b-b5d0-f518f319fb42",
                                        "entry_id": "d7206de0-a331-3db1-98de-d744e44043da",
                                        "glosses": [
                                            "A heartless individual; a person lacking empathy and emotion."
                                        ],
                                        "tags": [
                                            "endearing",
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "06ae56d0-6e63-4289-bfa6-d9a7cde2674a",
                                                "sense_id": "3c64d9ff-7a08-3a4b-b5d0-f518f319fb42",
                                                "text": "[…]it was thought ſhe was a Woman, and was turn'd into a cold fiſh, for ſhe wold not exchange fleſh with one that lou'd her: […]"
                                            },
                                            {
                                                "example_id": "08baf46d-eb11-4c2f-b83c-83e01fae0aea",
                                                "sense_id": "3c64d9ff-7a08-3a4b-b5d0-f518f319fb42",
                                                "text": "He wouldn't have thought her such a cold fish. Pity. Still, there was plenty of time. Perhaps when she got used to his company she would thaw a little."
                                            },
                                            {
                                                "example_id": "6bb001c2-f643-4536-8878-d6483852093e",
                                                "sense_id": "3c64d9ff-7a08-3a4b-b5d0-f518f319fb42",
                                                "text": "You're a cold fish. You have no heart."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8418dbe7-3671-3156-b708-84f604334306",
                                        "entry_id": "d7206de0-a331-3db1-98de-d744e44043da",
                                        "glosses": [
                                            "A sexual partner who, during sex, lacks vigor or emotional reciprocity."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ac4cf2dd-c4da-4128-b308-b9cb8c363b9d",
                                                "sense_id": "8418dbe7-3671-3156-b708-84f604334306",
                                                "text": "Ah, don't be such a cold fish!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4e3e9a3e-4797-497f-95c9-a9b75fba319d",
                        "source_entry_id": "a8999d73-b437-3198-b021-c60dc5ede0f4",
                        "source_sense_id": "035a5a20-69a0-36a4-9611-fd6d105b6048",
                        "target_lang_word": "killjoy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "killjoy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e8a57dc4-90f0-3007-a89e-dde29d6c56e8",
                                        "entry_id": "d33d1f20-0fa7-315f-8387-275114cd0231",
                                        "glosses": [
                                            "A person who is anti-fun, or prevents others from having fun."
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "55b66a9a-1eba-46c8-9a2f-06f7ecc98a20",
                                                "sense_id": "e8a57dc4-90f0-3007-a89e-dde29d6c56e8",
                                                "text": "“If you mean me, sir, I call you and every one else to the inspection of my professional life. As to Christian or unchristian, I repudiate your canting palavering Christianity; and as to the way in which I spend my income, it is not my principle to maintain thieves and cheat offspring of their due inheritance in order to support religion and set myself up as a saintly Killjoy....”"
                                            },
                                            {
                                                "example_id": "ae80950f-27cd-45dc-bc94-8c6295dee629",
                                                "sense_id": "e8a57dc4-90f0-3007-a89e-dde29d6c56e8",
                                                "text": "What kill-joy have we here? […] I feel it in my bones some rascal is come to Galing, one that bringeth ill hap in his pocket and a shadow athwart the sun on this our day of festival."
                                            },
                                            {
                                                "example_id": "b566b090-a33e-4b64-b0ed-3a04b3637a46",
                                                "sense_id": "e8a57dc4-90f0-3007-a89e-dde29d6c56e8",
                                                "text": "He stalked behind her simple narrative, a kill-joy parent, hasty, intolerant, keeping a special cane to enforce the authority of his sadistic God[.]"
                                            },
                                            {
                                                "example_id": "91d332e1-af5d-4818-88eb-f10bc93d23f9",
                                                "sense_id": "e8a57dc4-90f0-3007-a89e-dde29d6c56e8",
                                                "text": "December 10 2005, Sam Murphy in The Guardian, A sober thought\nJust in time for the party season, some old killjoys at the journal Medicine & Science In Sports & Exercise have released their findings on the effects on muscle of prolonged heavy alcohol intake (six weeks is prolonged, apparently). The bad news is that it seems too much boozing puts all that effort in the gym to waste - in the study, alcohol prevented the usual resistance-training-induced muscle response that leads to increased size and strength."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7d729c8f-e6b8-4832-9b4c-e56cea207203",
                        "source_entry_id": "a8999d73-b437-3198-b021-c60dc5ede0f4",
                        "source_sense_id": "035a5a20-69a0-36a4-9611-fd6d105b6048",
                        "target_lang_word": "party pooper",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "party pooper",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5f7a6528-608f-3d1a-8ae2-94f9f93aaf3d",
                                        "entry_id": "689c5cef-3492-332c-9612-137c305f725b",
                                        "glosses": [
                                            "One who dampens fun; especially, one who declines to participate in or enjoy a party or some other group activity; one who does not agree with the opinions of a group."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "80d1e853-207d-4001-b448-b98eacc68754",
                                                "sense_id": "5f7a6528-608f-3d1a-8ae2-94f9f93aaf3d",
                                                "text": "Call me anti-social, call me a holiday-hater, call me Scrooge, call me a party-pooper—call me anything, but please don't call me about a party you're giving because I won't come."
                                            },
                                            {
                                                "example_id": "aa077cd9-f055-43c0-9668-bcb9f83e6d25",
                                                "sense_id": "5f7a6528-608f-3d1a-8ae2-94f9f93aaf3d",
                                                "text": "Still, it's not something that any country can easily walk away from—not even a Bush administration that has made a habit of being the party pooper in international forums."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c48a2826-47ce-4750-87dd-c58dc8ba1733",
                        "source_entry_id": "a8999d73-b437-3198-b021-c60dc5ede0f4",
                        "source_sense_id": "035a5a20-69a0-36a4-9611-fd6d105b6048",
                        "target_lang_word": "spoilsport",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "spoilsport",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "de36dbff-493f-3e61-a143-c36ff5620459",
                                        "entry_id": "e74eeec6-7fc9-35b4-8340-a3abf6ccc16e",
                                        "glosses": [
                                            "Someone who puts an end to others' fun, especially harmless fun."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ff96a45-3c60-42c7-984e-76d918f931de",
                                                "sense_id": "de36dbff-493f-3e61-a143-c36ff5620459",
                                                "text": "I know I am a sad spoilsport, but it would make me wretched."
                                            },
                                            {
                                                "example_id": "1bfd4711-224c-4fa2-9b43-b2d1fc5a3e78",
                                                "sense_id": "de36dbff-493f-3e61-a143-c36ff5620459",
                                                "text": "He looks a spoilsport. There are men in whose presence it is impossible to have any fun: men who are a sort of walking conscience."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "spoilsport",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "79922354-9271-35ed-bc2f-f85f2d67a8c3",
                                        "entry_id": "8546e938-6784-36d5-9635-8fdabfb829f3",
                                        "glosses": [
                                            "Like a spoilsport."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ec26bf3-4914-435d-a907-5ceb71439328",
                                                "sense_id": "79922354-9271-35ed-bc2f-f85f2d67a8c3",
                                                "text": "It may seem somewhat spoilsport to focus in on this negative after another important victory but to ignore it would be delusion. Southgate will not be letting it escape his attention."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "76a02788-a1da-4adb-91c0-496bd37aacb0",
                        "source_entry_id": "a8999d73-b437-3198-b021-c60dc5ede0f4",
                        "source_sense_id": "035a5a20-69a0-36a4-9611-fd6d105b6048",
                        "target_lang_word": "stick in the mud",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stick in the mud",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0e9b3fd0-7630-30b8-b1f8-ccbc687c66f0",
                                        "entry_id": "15924487-5ba6-316e-ab16-a0d2a4ca469a",
                                        "glosses": [
                                            "A person unwilling to participate in activities; a curmudgeon or party pooper."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "62ed0e34-b283-4624-9ae8-4034cbc6309e",
                                                "sense_id": "0e9b3fd0-7630-30b8-b1f8-ccbc687c66f0",
                                                "text": "Have a little fun sometimes and don't be such a stick-in-the-mud."
                                            },
                                            {
                                                "example_id": "9df69942-ade6-4698-b38f-02730cab6403",
                                                "sense_id": "0e9b3fd0-7630-30b8-b1f8-ccbc687c66f0",
                                                "text": "\"I don't hold back like you do. Even Tedd's dad can tell you're a stick-in-the-mud. That's why he made you the supervisor of this party.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "75963f41-e44f-38aa-96e4-b8774ce7c10d",
                                        "entry_id": "15924487-5ba6-316e-ab16-a0d2a4ca469a",
                                        "glosses": [
                                            "More generally, one who is slow, old-fashioned, or unprogressive; an old fogey."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "idiomatic"
                                        ],
                                        "examples": [
