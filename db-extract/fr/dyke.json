                                            "UK"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c83414ec-8c63-3afe-8b90-0b4974a799fd",
                                        "entry_id": "23d7a040-54f6-34b5-b3f6-301f9de30b97",
                                        "glosses": [
                                            "A jetty; a pier."
