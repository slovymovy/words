                        "examples": [
                            {
                                "example_id": "201f8169-d2ca-423b-b745-5cc8ecc0ae42",
                                "sense_id": "a5170bf3-afcf-31c8-8b3a-0ee236bb3eb7",
                                "text": "Volgens de traditie zouden ze er nu een uur blijven zitten, noten kraken, dadels, vijgen en marsepeinen varkentjes eten en misschien wat conserveren over de geslaagde kerstcadeaus, de heerlijke schapenworst uit Osteroy en meer van dat soort onschuldige onderwerpen."
                            },
                            {
                                "example_id": "75e00625-3dee-45c3-980f-61067a0b783d",
                                "sense_id": "a5170bf3-afcf-31c8-8b3a-0ee236bb3eb7",
                                "text": "De waarheidscommissie die nu was begonnen zou niet alleen onschuldige slachtoffers van de politieke processen van een kwade tijd vrijspreken. Ze zou ook schurken brandmerken en niet alleen Tsjecho-Slowaakse schurken."
                            }
                        ]
