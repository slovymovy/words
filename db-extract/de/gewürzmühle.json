                ],
                "senses": [
                    {
                        "sense_id": "df5c7ef0-8215-344a-ae32-eeb9f7d1b6c1",
                        "entry_id": "263310a7-c244-3b5c-a10a-4db3de9ce06a",
                        "glosses": [
                            "Mühle, die Gewürze verarbeitet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4b4b6d2f-b573-47f7-a1ed-ea772e8724ab",
                                "sense_id": "df5c7ef0-8215-344a-ae32-eeb9f7d1b6c1",
                                "text": "„Die alte Gewürzmühle in dem heute zu den Mainzer Stadtteilen Bretzenheim und Oberstadt gehörenden Zahlbach wurde in den 1930er Jahren bezogen und ist seit 2001 stillgelegt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "d5497a47-fb03-39e6-bd2f-b9fdaaa73178",
                        "entry_id": "263310a7-c244-3b5c-a10a-4db3de9ce06a",
                        "glosses": [
                            "Küchengerät zum Zermahlen von Gewürzen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae6494fe-e487-46b8-a859-d91199645ac4",
                                "sense_id": "d5497a47-fb03-39e6-bd2f-b9fdaaa73178",
                                "text": "„Die unzerkleinerten Zutaten werden üblicherweise zunächst trocken in einer Pfanne geröstet, damit die ätherischen Öle und Geschmacksstoffe freigesetzt werden und nach Abkühlung anschließend im Mörser zerstoßen oder in einer Gewürzmühle gemahlen, sie kann aber auch unzerkleinert mit ganzen Gewürzen verwendet werden. Die Mischung ist gut verschlossen mehrere Monate haltbar.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
