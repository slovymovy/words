                        "sense_id": "c05ae361-517e-3a61-9d6b-450c446671e2",
                        "entry_id": "36863975-7490-385b-9796-952e1b0a1fcf",
                        "glosses": [
                            "Plat traditionnel québécois fait avec de la viande, des pâtes et des patates originaire des régions du Bas-Saint-Laurent et de la Gaspésie."
                        ],
                        "tags": [
                            "Québec"
                        ],
                        "examples": [
                            {
                                "example_id": "18313d6c-8869-49e3-b6eb-6dba8d8f2613",
                                "sense_id": "c05ae361-517e-3a61-9d6b-450c446671e2",
                                "text": "Dans la maison, ça sentait bon le cipaille, les oreilles de Christ, la flique et les tracas tout frais sortis des fourneaux embraisés."
                            },
                            {
                                "example_id": "b1cf5d2c-9939-4d10-ad17-9e346290af59",
                                "sense_id": "c05ae361-517e-3a61-9d6b-450c446671e2",
                                "text": "Passionnant ! Une recette de la région, la cipaille, nous intéresse. Elle rappelle les « pies » anglaises et est capable de nourrir une grande famille gaspésienne."
                            }
                        ]
                    }
