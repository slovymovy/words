{
    "word_family": [
        "создать",
        "создатель",
        "воссоздание",
        "пересоздание"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "049ab217-3539-377e-b1cb-62524cb4d237",
                    "sense_definition": "Действие по значению глагола создавать; процесс сотворения, организации или основания чего-либо.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "На <w>создание</w> этого проекта ушло несколько лет упорного труда.",
                            "target_lang_translations": {
                                "en": "The <w>creation</w> of this project took several years of hard work.",
                                "zh": "<w>创建</w>这个项目花费了几年艰苦的努力。"
                            }
                        },
                        {
                            "text": "Главной целью было <w>создание</w> комфортных условий для жизни людей.",
                            "target_lang_translations": {
                                "en": "The main goal was the <w>creation</w> of comfortable living conditions for people.",
                                "zh": "主要目标是为人们的生活<w>建立</w>舒适的条件。"
                            }
                        }
                    ],
                    "synonyms": [
                        "сотворение",
                        "созидание"
                    ],
                    "antonyms": [
                        "разрушение",
                        "уничтожение"
                    ],
                    "common_phrases": [
                        "создание семьи",
                        "создание условий",
                        "история создания",
                        "год создания",
                        "создание мира"
                    ],
                    "target_lang_definitions": {
                        "en": "The act or process of making, organizing, or establishing something.",
                        "zh": "制造、组织或建立某事物的行为或过程。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "creation",
                                "target_lang_sense_clarification": "process"
                            },
                            {
                                "target_lang_word": "founding",
                                "target_lang_sense_clarification": "establishment"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "创建",
                                "target_lang_sense_clarification": "建立、设立"
                            },
                            {
                                "target_lang_word": "建立",
                                "target_lang_sense_clarification": "使某种事物从无到有"
                            },
                            {
                                "target_lang_word": "制作",
                                "target_lang_sense_clarification": "制造、创作"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fd6a5740-56bb-3f9b-9dd7-0462b803e27c",
                    "sense_definition": "То, что создано; результат творческого труда или работы.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Это архитектурное <w>создание</w> привлекает туристов со всего мира.",
                            "target_lang_translations": {
                                "en": "This architectural <w>creation</w> attracts tourists from all over the world.",
                                "zh": "这座建筑<w>作品</w>吸引了来自世界各地的游客。"
                            }
                        },
                        {
                            "text": "Поэт с гордостью представил публике своё новое <w>создание</w>.",
                            "target_lang_translations": {
                                "en": "The poet proudly presented his new <w>creation</w> to the public.",
                                "zh": "诗人自豪地向公众展示了他的新<w>作品</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "творение",
                        "произведение"
                    ],
                    "common_phrases": [
                        "удивительное создание",
                        "великое создание"
                    ],
                    "target_lang_definitions": {
                        "en": "Something that has been created; the result of creative work.",
                        "zh": "被创造出来的东西；创造性劳动的成果。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "creation",
                                "target_lang_sense_clarification": "result or object"
                            },
                            {
                                "target_lang_word": "work",
                                "target_lang_sense_clarification": "artistic production"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "作品",
                                "target_lang_sense_clarification": "艺术或文学创作的成果"
                            },
                            {
                                "target_lang_word": "产物",
                                "target_lang_sense_clarification": "某种过程产生的结果"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6423bc89-dc83-3eb4-8538-22f711111b59",
                    "sense_definition": "Живое существо, организм (человек или животное).",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Она была очень милым и добрым <w>созданием</w>.",
                            "target_lang_translations": {
                                "en": "She was a very sweet and kind <w>creature</w>.",
                                "zh": "她是一个非常可爱又善良的<w>生物</w>。"
                            }
                        },
                        {
                            "text": "Каждое живое <w>создание</w> нуждается в заботе и любви.",
                            "target_lang_translations": {
                                "en": "Every living <w>creature</w> needs care and love.",
                                "zh": "每一个活着的<w>生物</w>都需要关爱。"
                            }
                        }
                    ],
                    "synonyms": [
                        "существо́",
                        "тварь"
                    ],
                    "common_phrases": [
                        "милое создание",
                        "невинное создание",
                        "юное создание",
                        "божье создание",
                        "прелестное создание"
                    ],
                    "target_lang_definitions": {
                        "en": "A living being, such as a human or an animal.",
                        "zh": "活的生物，如人或动物。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "creature",
                                "target_lang_sense_clarification": "living being"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "生物",
                                "target_lang_sense_clarification": "具有生命的物体"
                            },
                            {
                                "target_lang_word": "生命",
                                "target_lang_sense_clarification": "指代活着的个体"
                            }
                        ]
                    }
                }
            ]
        }
    ]
