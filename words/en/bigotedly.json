                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>bigotedly</w> refused to listen to any opposing viewpoints during the debate.",
                            "target_lang_translations": {
                                "pl": "Podczas debaty <w>fanatycznie</w> odmawiał wysłuchania jakichkolwiek przeciwnych punktów widzenia."
                            }
                        },
                        {
                            "text": "The politician spoke <w>bigotedly</w> about minority groups, causing widespread public outrage.",
                            "target_lang_translations": {
                                "pl": "Polityk wypowiadał się <w>nietolerancyjnie</w> o grupach mniejszościowych, wywołując powszechne oburzenie opinii publicznej."
