                                                "example_id": "5e04d4a9-307d-4049-8abf-d03b9e9b1e3e",
                                                "sense_id": "fd40966a-9cb5-3ca4-bbba-38c762e7b253",
                                                "text": "Y acertándole con los pies en el ombligo resvaláronse, y fuesse deslizando hasta que se hincó el miembro de Satilario por el culo."
                                            }
