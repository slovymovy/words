                "senses": [
                    {
                        "sense_id": "2a5e3ba9-abb4-30d5-84ba-7adf88aa5e04",
                        "entry_id": "2dc7b554-1168-3e0c-81f4-7871693a1027",
                        "glosses": [
                            "kleine Pfütze aus Wasser"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "40bba9e6-c28f-45c4-bf30-285957a65286",
                                "sense_id": "2a5e3ba9-abb4-30d5-84ba-7adf88aa5e04",
                                "text": "„Die Pferde gingen über das Feld wie über einen weichen Teppich, ab und zu, wenn man über Wegekreuzungen kam, durch Wasserlachen patschend.“"
                            },
                            {
                                "example_id": "723bd4b0-9c6c-46f7-9422-6607ce0c5eba",
                                "sense_id": "2a5e3ba9-abb4-30d5-84ba-7adf88aa5e04",
                                "text": "„Zum ersten Mal seit langer Zeit fühle ich wieder, dass etwas schön ist, dass dieses hier einfach schön ist, schön und rein, dieses Bild in der Wasserlache vor mir – und in diesem Erschauern steigt mir das Herz hoch, alles fällt für einen Augenblick ab, und jetzt spüre ich es zum ersten Male: Frieden – sehe es: Frieden – empfinde es ganz: Frieden.“"
                            },
                            {
                                "example_id": "8aa3db28-a1d9-4dd6-a847-10de6629db25",
                                "sense_id": "2a5e3ba9-abb4-30d5-84ba-7adf88aa5e04",
                                "text": "„Sie erreichten die Steilküste, und fünf Minuten später drückten sie sich dicht an ihr entlang, um einer großen Wasserlache auszuweichen, die sich wie ein Golf mitten in den Strand hineinschob.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
