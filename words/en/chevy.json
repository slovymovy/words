{
    "word_family": [
        "Chevrolet",
        "chivvy"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a88eca21-b858-36c3-94a2-059e69dbe424",
                    "sense_definition": "A vehicle manufactured by the Chevrolet brand.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "vehicle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He drove his old <w>Chevy</w> to the lake every weekend during the summer.",
                            "target_lang_translations": {
                                "ru": "Каждые выходные летом он ездил на озеро на своем старом <w>шевике</w>."
                            }
                        },
                        {
                            "text": "I saw a late-model <w>Chevy</w> parked in the driveway last night.",
                            "target_lang_translations": {
                                "ru": "Вчера вечером я видел припаркованный на подъездной дорожке новый <w>шевроле</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "Chevrolet"
                    ],
                    "common_phrases": [
                        "late-model Chevy",
                        "old Chevy"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Commonly used informal name for the car brand."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Автомобиль марки Chevrolet."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шевроле",
                                "target_lang_sense_clarification": "название марки"
                            },
                            {
                                "target_lang_word": "шевик",
                                "target_lang_sense_clarification": "разговорное сокращение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8f5e4f5e-d64d-3189-8baf-95b4c153d142",
                    "sense_definition": "A hunt, pursuit, or a chase.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "chase",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The boys enjoyed a good <w>chevy</w> across the fields before dinner.",
                            "target_lang_translations": {
                                "ru": "Мальчишки с удовольствием устроили <w>погоню</w> по полям перед ужином."
                            }
                        },
                        {
                            "text": "The long <w>chevy</w> through the woods left the hunters exhausted.",
                            "target_lang_translations": {
                                "ru": "Долгая <w>охота</w> в лесу измотала охотников."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Mainly found in older literature or specific dialects."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Охота, преследование или погоня."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "погоня",
                                "target_lang_sense_clarification": "преследование"
                            },
                            {
                                "target_lang_word": "охота",
                                "target_lang_sense_clarification": "процесс преследования дичи"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "1ae349d3-6e74-31de-89b4-21b3c8a7e4fe",
                    "sense_definition": "A shortened name for <w>Chevrolet</w>, a car brand produced by General Motors.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "brand",
                    "name_type": "brand_or_product_name",
                    "examples": [
                        {
                            "text": "<w>Chevy</w> has introduced a new model for the upcoming year.",
                            "target_lang_translations": {
                                "ru": "<w>Шевроле</w> представила новую модель на следующий год."
                            }
                        },
                        {
                            "text": "Many people prefer <w>Chevy</w> trucks because of their reliability.",
                            "target_lang_translations": {
                                "ru": "Многие предпочитают грузовики <w>Шеви</w> из-за их надежности."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Standard informal name for the brand."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сокращенное название автомобильного бренда Chevrolet."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Шевроле",
                                "target_lang_sense_clarification": "бренд"
                            },
                            {
                                "target_lang_word": "Шеви",
                                "target_lang_sense_clarification": "транслитерация названия"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e8b53bf9-c382-307e-af8a-cffb80525057",
                    "sense_definition": "A unisex given name.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "name",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "My friend <w>Chevy</w> is coming over to help me with the project.",
                            "target_lang_translations": {
                                "ru": "Мой друг <w>Чеви</w> придет помочь мне с проектом."
                            }
                        },
                        {
                            "text": "The name <w>Chevy</w> is quite unique for a child these days.",
                            "target_lang_translations": {
                                "ru": "Имя <w>Чеви</w> довольно необычно для ребенка в наши дни."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Имя собственное (унисекс)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Чеви",
                                "target_lang_sense_clarification": "имя"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b417d125-9415-3f9c-8d3c-46d6892101cc",
                    "sense_definition": "To nag, pester, or urge someone to do something; a variant of <w>chivvy</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "annoy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She had to <w>chevy</w> him along to make sure he finished his chores.",
                            "target_lang_translations": {
                                "ru": "Ей пришлось <w>подгонять</w> его, чтобы он закончил свои дела по дому."
                            }
                        },
                        {
                            "text": "The manager would <w>chevy</w> the staff whenever a deadline approached.",
                            "target_lang_translations": {
                                "ru": "Менеджер <w>донимал</w> сотрудников всякий раз, когда приближался дедлайн."
                            }
                        }
                    ],
                    "synonyms": [
                        "badger",
                        "pester",
                        "bug"
                    ],
                    "common_phrases": [
                        "chevy along"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "More common in British English contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Изводить, подгонять или докучать кому-либо просьбами; вариант слова chivvy."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подгонять",
                                "target_lang_sense_clarification": "понукать"
                            },
                            {
                                "target_lang_word": "донимать",
                                "target_lang_sense_clarification": "надоедать просьбами"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "59fd36b1-2ebd-3ca4-8e59-3daf3de62855",
                    "sense_definition": "To annoy, harass, or vex someone with small, repeated attacks.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "annoy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The older children would <w>chevy</w> the younger ones on the playground.",
                            "target_lang_translations": {
                                "ru": "Старшие дети <w>изводили</w> младших на игровой площадке."
                            }
                        },
                        {
                            "text": "It is unkind to <w>chevy</w> that poor animal when it is trying to sleep.",
                            "target_lang_translations": {
                                "ru": "Нехорошо <w>донимать</w> бедное животное, когда оно пытается поспать."
                            }
                        }
                    ],
                    "synonyms": [
                        "harass",
                        "harry",
                        "vex",
                        "persecute",
                        "bedevil"
                    ],
                    "target_lang_definitions": {
                        "ru": "Раздражать, изводить или досаждать мелкими нападками."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "изводить",
                                "target_lang_sense_clarification": "мучить придирками"
                            },
                            {
                                "target_lang_word": "травить",
                                "target_lang_sense_clarification": "преследовать нападками"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "97eabbaa-1d03-307e-951b-31b88447593b",
                    "sense_definition": "To chase or hunt someone or something.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "chase",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The stray dog was <w>chevied</w> up and down the street by the local boys.",
                            "target_lang_translations": {
                                "ru": "Местные мальчишки <w>гоняли</w> бездомную собаку вверх и вниз по улице."
                            }
                        },
                        {
                            "text": "They would <w>chevy</w> the deer through the thick brush for hours.",
                            "target_lang_translations": {
                                "ru": "Они часами <w>загоняли</w> оленя через густой кустарник."
                            }
                        }
                    ],
                    "synonyms": [
                        "pursue",
                        "hound"
                    ],
                    "common_phrases": [
                        "chevy up and down"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Used more frequently in historical or literary contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Гнаться за кем-либо или охотиться."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гнать",
                                "target_lang_sense_clarification": "преследовать"
                            },
                            {
                                "target_lang_word": "загонять",
                                "target_lang_sense_clarification": "охотиться"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b6fe9616-04ff-3c94-a371-fefc0d81c55d",
                    "sense_definition": "To move quickly or scurry.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "move",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The small mouse would <w>chevy</w> across the floor the moment the lights went out.",
                            "target_lang_translations": {
                                "ru": "Маленькая мышка <w>шмыгала</w> по полу, как только гас свет."
                            }
                        },
                        {
                            "text": "We watched the rabbits <w>chevy</w> into their burrows as we approached.",
                            "target_lang_translations": {
                                "ru": "Мы наблюдали, как кролики <w>удирают</w> в свои норы при нашем приближении."
                            }
                        }
                    ],
                    "synonyms": [
                        "scamper"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быстро двигаться или удирать."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шмыгать",
                                "target_lang_sense_clarification": "быстро перемещаться"
                            },
                            {
                                "target_lang_word": "удирать",
                                "target_lang_sense_clarification": "быстро убегать"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}