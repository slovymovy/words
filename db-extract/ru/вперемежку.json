        "ru-extract.jsonl": [
            {
                "entry_id": "b184ff1e-f220-30da-964f-6a6e869ce25f",
                "word": "вперемежку",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "c23fb5fc-7815-39dc-a21d-de87d5f1e821",
                        "entry_id": "b184ff1e-f220-30da-964f-6a6e869ce25f",
                        "glosses": [
                            "разг. чередуясь в определённом порядке; перемежаясь"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "91bad2ed-af47-4e97-bc45-26e89c72d85f",
                                "sense_id": "c23fb5fc-7815-39dc-a21d-de87d5f1e821",
                                "text": "Долго перетасовывали места, чтобы дамы сидели непременно вперемежку с кавалерами."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "90b20105-a122-463e-8738-be2cf28019f9",
                        "source_entry_id": "b184ff1e-f220-30da-964f-6a6e869ce25f",
                        "source_sense_id": "c23fb5fc-7815-39dc-a21d-de87d5f1e821",
                        "target_lang_word": "alternately",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "alternately",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "df2e8e84-b59e-3253-96cd-53db667bf15a",
                                        "entry_id": "bd988ddd-af6b-31b3-93cf-774746694f64",
                                        "glosses": [
                                            "In reciprocal succession; succeeding by turns; in alternate order."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "60ba0ab5-f5d8-4716-b2b2-6acaeb9b926b",
                                                "sense_id": "df2e8e84-b59e-3253-96cd-53db667bf15a",
                                                "text": "All night Katerina and I watched alternately, though, I shame to say, I slept more than I watched; and, having first ascertained that there was no change, I came directly hither."
                                            },
                                            {
                                                "example_id": "1fc7d224-f8d8-4ad1-91ae-88fa973bddce",
                                                "sense_id": "df2e8e84-b59e-3253-96cd-53db667bf15a",
                                                "text": "Tired with the heat and my walk, I threw myself down on the grass in the shadow of the house, where I lay half-asleep enjoying a quiet rest, when I was startled by an unpleasant clamour, the jarring voice of a woman, who was trying by alternately scolding and using pet names to pacify a litter of grunting pigs on the farm."
                                            },
                                            {
                                                "example_id": "2980d7a1-8f09-48a4-92e2-ebecaf883bc4",
                                                "sense_id": "df2e8e84-b59e-3253-96cd-53db667bf15a",
                                                "text": "Well, I can't help noticing that you insult me and then you're polite to me alternately."
                                            },
                                            {
                                                "example_id": "72665851-2e0a-42eb-a4b8-a39a3457518f",
                                                "sense_id": "df2e8e84-b59e-3253-96cd-53db667bf15a",
                                                "text": "The 2025 timetable would feature two trains per hour, alternately routed via Kirkcaldy (with 11 intermediate stops) and Dunfermline (14 stops), with journey times ranging between 65 and 81 minutes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "08483303-905f-35b7-ba6a-6f65a8e3978b",
                                        "entry_id": "bd988ddd-af6b-31b3-93cf-774746694f64",
                                        "glosses": [
                                            "By alternation; when, in a proportion, the antecedent term is compared with antecedent, and consequent."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4dbad339-06ba-3637-8b5c-679f73ec0afe",
                                        "entry_id": "bd988ddd-af6b-31b3-93cf-774746694f64",
                                        "glosses": [
                                            "Alternatively."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US",
                                            "not-comparable",
                                            "proscribed",
                                            "sometimes"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5fe98cab-4ab7-4c73-9e31-bfc4fac19197",
                                                "sense_id": "4dbad339-06ba-3637-8b5c-679f73ec0afe",
                                                "text": "Downstairs, he was informed. That is, down the escalators, where there is both a women’s room (often with a line) and a men’s room (almost never with a line). Or alternately, he could ask the station master to buzz him into the “family” bathroom. He opted to go downstairs."
                                            },
                                            {
                                                "example_id": "a62d62b2-8db3-4a48-9aef-40aa48945558",
                                                "sense_id": "4dbad339-06ba-3637-8b5c-679f73ec0afe",
                                                "text": "Westerners have never quite understood the reverence in Japan for fugu, alternately known in English as puffer fish, globefish or blowfish, of the family Tetraodontidae."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c6e2e7eb-b7f9-4a25-ac53-25847f5a686e",
                        "source_entry_id": "b184ff1e-f220-30da-964f-6a6e869ce25f",
                        "source_sense_id": "c23fb5fc-7815-39dc-a21d-de87d5f1e821",
                        "target_lang_word": "interspersed",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "interspersed",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b29c9469-d5cf-3463-ba7a-189c6e119481",
                                        "entry_id": "27a22d23-c373-380d-bb3d-ecae606ce9c1",
                                        "glosses": [
                                            "Placed at intervals amongst other things."
