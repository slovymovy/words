                    {
                        "sense_id": "2f4dd963-8ae4-3e1e-ac23-1ebca2720dea",
                        "entry_id": "5d680d18-dd98-339c-aa95-90c659c547c1",
                        "glosses": [
                            "Huissier de justice, nommément désigné par le Président de la juridiction civile ou pénale à laquelle il est rattaché, qui assure le service intérieur auprès des cours et tribunaux."
                        ],
                        "tags": [
                            "Justice"
                        ],
                        "examples": [
                            {
                                "example_id": "cad156d6-948c-46fb-91a5-ca3b8cdef210",
                                "sense_id": "2f4dd963-8ae4-3e1e-ac23-1ebca2720dea",
                                "text": "Ses deux mains, croisées sous le menton, n’ont fait aucun geste lorsque je me suis approché de la barre des témoins, précédé de l’annonce claironnée par l’huissier-audiencier."
                            },
                            {
                                "example_id": "31962735-58d8-400f-86fc-615b79523d08",
                                "sense_id": "2f4dd963-8ae4-3e1e-ac23-1ebca2720dea",
                                "text": "Toutes citations, notifications et significations requises pour l’instruction des procès, ainsi que tous actes et exploits nécessaires pour l’exécution des ordonnances de justice, jugemens et arrêts, seront faits concurremment par les huissiers-audienciers et les huissiers ordinaires, chacun dans l’étendue du ressort du Tribunal civil de première instance de sa résidence, sauf les restrictions portées par les articles suivans."
                            },
                            {
                                "example_id": "7db0eb40-ea13-4202-9085-1e871648c031",
                                "sense_id": "2f4dd963-8ae4-3e1e-ac23-1ebca2720dea",
                                "text": "nᵒ 1 l’acte d’appel a été signifié par un huissier-audiencier du tribunal d’appel de Paris dans le département de la Seine-Inférieure."
                            }
                        ]
                    }
