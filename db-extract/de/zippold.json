                "senses": [
                    {
                        "sense_id": "b4040886-60ad-34fc-9ee2-984b7bc4c472",
                        "entry_id": "2f250473-1cc2-355c-abf5-cb9d0282098f",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fcd58087-68f8-4a70-8134-e2b49485d0d0",
                                "sense_id": "b4040886-60ad-34fc-9ee2-984b7bc4c472",
                                "text": "Frau Zippold ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "c564708a-6275-41c7-99c8-9a6fb8ede5c2",
                                "sense_id": "b4040886-60ad-34fc-9ee2-984b7bc4c472",
                                "text": "Herr Zippold wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "e20e2024-bed8-4e88-be97-4c7e862100cf",
                                "sense_id": "b4040886-60ad-34fc-9ee2-984b7bc4c472",
                                "text": "Die Zippolds fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "f33f64ff-16dc-4f6d-b612-f13eda4beeac",
                                "sense_id": "b4040886-60ad-34fc-9ee2-984b7bc4c472",
                                "text": "Der Zippold trägt nie die Schals, die die Zippold ihm strickt."
                            },
                            {
                                "example_id": "6ef003ea-b231-4e0e-8d56-d3df56aa04c3",
                                "sense_id": "b4040886-60ad-34fc-9ee2-984b7bc4c472",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Zippold kommt, geht der Herr Zippold.“"
                            },
                            {
                                "example_id": "fbad4104-da6d-4a66-99ee-fcd308be150d",
                                "sense_id": "b4040886-60ad-34fc-9ee2-984b7bc4c472",
                                "text": "Zippold kommt und geht."
                            },
                            {
                                "example_id": "54b3ad68-77e2-4cec-8d16-62670dce2684",
                                "sense_id": "b4040886-60ad-34fc-9ee2-984b7bc4c472",
                                "text": "Zippolds kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
