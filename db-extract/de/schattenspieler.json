                "senses": [
                    {
                        "sense_id": "7fc827b0-7d32-3c95-9161-30624d932820",
                        "entry_id": "b5ec6641-5737-3cb6-a51a-89e65245c57e",
                        "glosses": [
                            "Person, die auf einer beleuchteten Fläche Schatten von Figuren erzeugt und mit ihnen Geschichten erzählt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "67efef07-e829-4b5a-800b-0de26bd15e0d",
                                "sense_id": "7fc827b0-7d32-3c95-9161-30624d932820",
                                "text": "„Eine Kombination aus Tensor Flow sowie TPUs und künstlicher Intelligenz erfasst die Bewegungen des menschlichen Schattenspielers und setzt sie in eine detaillierte, voll animierte digitale Figur um.“"
                            },
                            {
                                "example_id": "e623d604-ecbc-411f-aed1-85540af62b96",
                                "sense_id": "7fc827b0-7d32-3c95-9161-30624d932820",
                                "text": "„Schattenspieler sind diejenigen Künstler, die auf der Bühne vor dem Scheinwerfer stehen.“"
                            },
                            {
                                "example_id": "92b119f5-75c1-4f45-b6db-6556234fb8e7",
                                "sense_id": "7fc827b0-7d32-3c95-9161-30624d932820",
                                "text": "„Das Spiel der menschlichen Schattenspieler kann durch Fingerfiguren und Gestalten aus Pappe bereichert werden.“"
                            },
                            {
                                "example_id": "2f810fe0-5610-48f8-8701-4ca320c0552f",
                                "sense_id": "7fc827b0-7d32-3c95-9161-30624d932820",
                                "text": "„Ein Schattenspieler erschafft verblüffende und entsetzliche Schattenspiele mit Hilfe übernatürlicher Effekte, welche Schatten erschaffen und manipulieren.“"
                            },
                            {
                                "example_id": "f52f15e9-5158-4eeb-bc8c-2e86acd83f8c",
                                "sense_id": "7fc827b0-7d32-3c95-9161-30624d932820",
                                "text": "„Der indische Schattenspieler Prasanna Rao zeigt beim Just vor Laughs-Festival einen Ausschnitt seiner Kunst, leider sind die Videos hier vieeeeel zu kurz.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
