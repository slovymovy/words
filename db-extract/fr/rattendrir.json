                "senses": [
                    {
                        "sense_id": "e14d9c48-1ae5-35b7-87f3-528ecb74900a",
                        "entry_id": "126059fd-7315-3393-bf2e-5eba881d4ae5",
                        "glosses": [
                            "Faire redevenir tendre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ca470a33-f997-4a0f-9f2c-99e3b04787b7",
                                "sense_id": "e14d9c48-1ae5-35b7-87f3-528ecb74900a",
                                "text": "je ne saurais bonnement dire le sujet que j'ai de me rattendrir pour elle;"
                            },
                            {
                                "example_id": "0b02d1b7-f80d-4079-ac95-e7565fa87896",
                                "sense_id": "e14d9c48-1ae5-35b7-87f3-528ecb74900a",
                                "text": "Comme ma lettre était fort tendre pour M. de Lauzun, j’étais bien aise de la lui montrer [au roi], pour lui faire connaître que je ne changerais point, et dans l’espérance de le rattendrir et de lui faire pitié de mon état pour le finir, Mémoires de Mademoiselle, t. IV, p. 269."
                            },
                            {
                                "example_id": "9440ec88-7ff0-4f54-8736-704b9c582ba5",
                                "sense_id": "e14d9c48-1ae5-35b7-87f3-528ecb74900a",
                                "text": "Le collégien a « rattendri » et ses mains collectionnent échardes et ampoules !"
                            }
                        ]
                    }
