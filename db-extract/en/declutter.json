                                "sense_id": "4210cb44-b5e5-357f-b4a2-3bbe42be73ca",
                                "text": "I decluttered my living room."
                            },
                            {
                                "example_id": "86c4a159-2753-497e-8c47-c409ca3d87b6",
                                "sense_id": "4210cb44-b5e5-357f-b4a2-3bbe42be73ca",
                                "text": "The first phase of the station facelift includes decluttering the ticket office, a brighter concourse, and a longer London-bound platform canopy."
                            }
                        ]
