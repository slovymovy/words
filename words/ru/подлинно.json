{
    "word_family": [
        "подлинный",
        "подлинник",
        "подлинность",
        "неподлинный"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "ba1f701d-6734-308d-9d4c-b3ad15af1d44",
                    "sense_definition": "Действительно, на самом деле, в высшей степени искренне или истинно.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "really_truly",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Это произведение искусства было <w>подлинно</w> прекрасным и трогало зрителей до глубины души.",
                            "target_lang_translations": {
                                "pl": "To dzieło sztuki było <w>prawdziwie</w> piękne i poruszało widzów do głębi duszy."
                            }
                        },
                        {
                            "text": "Они стремились создать <w>подлинно</w> народный театр, понятный каждому зрителю.",
                            "target_lang_translations": {
                                "pl": "Dążyli do stworzenia <w>autentycznie</w> ludowego teatru, zrozumiałego dla każdego widza."
                            }
                        }
                    ],
                    "synonyms": [
                        "истинно",
                        "действительно",
                        "поистине"
                    ],
                    "antonyms": [
                        "ложно",
                        "притворно",
                        "фальшиво"
                    ],
                    "common_phrases": [
                        "подлинно великий",
                        "подлинно научный"
                    ],
                    "target_lang_definitions": {
                        "pl": "Naprawdę, rzeczywiście, w sposób autentyczny, prawdziwy i szczery."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "prawdziwie",
                                "target_lang_sense_clarification": "autentycznie, w pełni szczerze lub rzeczywiście"
                            },
                            {
                                "target_lang_word": "naprawdę",
                                "target_lang_sense_clarification": "w rzeczywistości, bez wątpienia"
                            },
                            {
                                "target_lang_word": "autentycznie",
                                "target_lang_sense_clarification": "niepodrabianie, rdzennie"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "56fbb622-d935-3618-9591-a311873c0515",
                    "sense_definition": "Вводное слово, выражающее подтверждение: в самом деле, поистине.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "really_truly",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Его слова звучали убедительно, и, <w>подлинно</w>, никто не посмел с ним спорить.",
                            "target_lang_translations": {
                                "pl": "Jego słowa brzmiały przekonująco i <w>zaiste</w> nikt nie śmiał się z nim spierać."
                            }
                        },
                        {
                            "text": "В этой тишине, <w>подлинно</w>, можно было услышать даже биение собственного сердца.",
                            "target_lang_translations": {
                                "pl": "W tej ciszy <w>istotnie</w> można było usłyszeć nawet bicie własnego serca."
                            }
                        }
                    ],
                    "synonyms": [
                        "поистине",
                        "впрямь",
                        "вправду"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "в роли вводного слова встречается преимущественно в книжной или устаревшей речи"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Wyrażenie wtrącone potwierdzające stan rzeczy: zaiste, zaprawdę, istotnie."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "zaiste",
                                "target_lang_sense_clarification": "podniosłe lub książkowe: zaprawdę, istotnie"
                            },
                            {
                                "target_lang_word": "zaprawdę",
                                "target_lang_sense_clarification": "archaiczne lub uroczyste potwierdzenie"
                            },
                            {
                                "target_lang_word": "istotnie",
                                "target_lang_sense_clarification": "wtrącenie potwierdzające fakt"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "cfe9ebc2-63e4-3c8e-92c4-cc580bead926",
                    "sense_definition": "Краткая форма среднего рода единственного числа прилагательного <w>подлинный</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Было не сразу понятно, насколько <w>подлинно</w> найденное археологами древнее письмо.",
                            "target_lang_translations": {
                                "pl": "Nie od razu było jasne, na ile <w>autentyczne</w> jest starożytne pismo odnalezione przez archeologów."
                            }
                        },
                        {
                            "text": "Это свидетельство вполне <w>подлинно</w> и заверено официальной печатью нотариуса.",
                            "target_lang_translations": {
                                "pl": "To zaświadczenie jest w pełni <w>prawdziwe</w> i poświadczone urzędową pieczęcią notariusza."
                            }
                        }
                    ],
                    "synonyms": [
                        "аутентично"
                    ],
                    "antonyms": [
                        "поддельно",
                        "фальшиво"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "краткая форма прилагательного"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Krótka forma rodzaju nijakiego przymiotnika „подлинный”: autentyczne, prawdziwe, oryginalne."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "autentyczne",
                                "target_lang_sense_clarification": "oryginalne, niebędące fałszerstwem (r. nijaki)"
                            },
                            {
                                "target_lang_word": "prawdziwe",
                                "target_lang_sense_clarification": "zgodne z rzeczywistością, oryginalne (r. nijaki)"
                            },
                            {
                                "target_lang_word": "oryginalne",
                                "target_lang_sense_clarification": "pochodzące ze źródła, niebędące kopią (r. nijaki)"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}