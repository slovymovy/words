    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "a61ffa2c-ed14-3b33-adaa-a26d961e058a",
                    "sense_definition": "Честно, искренне, ничего не утаивая от собеседника или окружающих.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я хочу поговорить с тобой совершенно <w>откровенно</w>.",
                            "target_lang_translations": {
                                "en": "I want to speak with you completely <w>frankly</w>.",
                                "de": "Ich möchte ganz <w>offen</w> mit dir sprechen."
                            }
                        },
                        {
                            "text": "<w>Откровенно</w> говоря, мне не очень понравилась эта идея.",
                            "target_lang_translations": {
                                "en": "<w>Frankly</w> speaking, I didn't really like this idea.",
                                "de": "<w>Offen</w> gesagt hat mir diese Idee nicht besonders gefallen."
                            }
                        }
                    ],
                    "synonyms": [
                        "честно",
                        "искренне",
                        "открыто",
                        "как на духу",
                        "без утайки"
                    ],
                    "antonyms": [
                        "скрытно"
                    ],
                    "common_phrases": [
                        "откровенно говоря",
                        "вести себя откровенно",
                        "смотреть откровенно"
                    ],
                    "target_lang_definitions": {
                        "en": "Honestly, sincerely, without hiding anything from the interlocutor or others.",
                        "de": "Ehrlich, aufrichtig, ohne dem Gesprächspartner oder anderen etwas zu verheimlichen."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "frankly",
                                "target_lang_sense_clarification": "used when speaking in a direct and honest way, often about something unpleasant"
                            },
                            {
                                "target_lang_word": "openly",
                                "target_lang_sense_clarification": "without concealment; publicly or visibly"
                            },
                            {
                                "target_lang_word": "candidly",
                                "target_lang_sense_clarification": "in a way that is truthful, straightforward, and sincere"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "offen",
                                "target_lang_sense_clarification": "ehrlich und ohne Zurückhaltung"
                            },
                            {
                                "target_lang_word": "aufrichtig",
                                "target_lang_sense_clarification": "ehrlich gemeint, ohne Verstellung"
                            },
                            {
                                "target_lang_word": "offenherzig",
                                "target_lang_sense_clarification": "bereitwillig die eigenen Gefühle und Gedanken zeigend"
                            },
                            {
                                "target_lang_word": "geradeheraus",
                                "target_lang_sense_clarification": "direkt und ohne Umschweife"
                            }
                        ]
                    }
                }
            ]
        },
        {
