                        "examples": [
                            {
                                "example_id": "0cc03cd1-4829-4bad-9e83-f2eb9bd0606c",
                                "sense_id": "5ab84704-bf72-386f-b677-228e29875abf",
                                "text": "For wisedome is most riches: fooles therefore / They are which fortunes doe by vowes devize, / Sith each unto himselfe his life may fortunize."
                            },
                            {
                                "example_id": "9bfe74c4-1c59-421f-a7e8-08727ad35410",
                                "sense_id": "5ab84704-bf72-386f-b677-228e29875abf",
                                "text": "I am going out to fortunize my own life; and you are staying at home to fortunize yours."
                            }
                        ]
                    }
