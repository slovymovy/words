                "senses": [
                    {
                        "sense_id": "319df7f7-01cc-3bfd-9c64-fa370318293f",
                        "entry_id": "2d857bc6-3781-3fa7-9e1c-0cf43f80d616",
                        "glosses": [
                            "monotonous (having an unvarying tone or pitch)"
                        ],
                        "tags": [
                            "literally"
                        ],
                        "examples": [
                            {
                                "example_id": "610a61db-b2cb-4343-8121-fbf1d154ac0a",
                                "sense_id": "319df7f7-01cc-3bfd-9c64-fa370318293f",
                                "text": "Hij wist niet waar de eentonige brom vandaan kwam.",
                                "translation": "He did not know from where the monotonous hum originated.",
                                "english": "He did not know from where the monotonous hum originated."
                            }
                        ]
                    },
                    {
                        "sense_id": "60133b95-6a0c-3332-b6a7-55eec404046b",
                        "entry_id": "2d857bc6-3781-3fa7-9e1c-0cf43f80d616",
                        "glosses": [
                            "monotone, tedious(ly unvaried); boring, dull"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "ba1590d4-dc07-4ffc-bf0d-3b3b34249f49",
                                "sense_id": "60133b95-6a0c-3332-b6a7-55eec404046b",
                                "text": "Ze vond het leven in de lockdown eentonig.",
                                "translation": "She thought that life during the lockdown was monotonous.",
                                "english": "She thought that life during the lockdown was monotonous."
                            },
                            {
                                "example_id": "7a5f3299-8716-4885-a466-c0eac28491d4",
                                "sense_id": "60133b95-6a0c-3332-b6a7-55eec404046b",
                                "text": "Eentalig is eentonig.",
                                "translation": "Being monolingual is monotonous.",
                                "english": "Being monolingual is monotonous."
                            }
                        ]
                    }
