                ],
                "senses": [
                    {
                        "sense_id": "40a7e5ff-2370-38cc-adb2-206f133279de",
                        "entry_id": "28122aa6-027a-31f3-929d-15f90568ed5f",
                        "glosses": [
                            "Regime der Besatzungsmacht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "81595475-3006-4e2e-b47a-8bd62b7ec71a",
                                "sense_id": "40a7e5ff-2370-38cc-adb2-206f133279de",
                                "text": "„Am 2. Okober trommelte er im Czernin-Palais die Oberlandräte und andere hochrangige Funktionsträger des Besatzungsregimes zusammen.“"
                            },
                            {
                                "example_id": "16ccb051-1bfd-4b03-8e20-add2fc5c574c",
                                "sense_id": "40a7e5ff-2370-38cc-adb2-206f133279de",
                                "text": "„Sie kam zu keiner einheitlichen Ansicht, was eigentlich auf das Besatzungsregime folgen solle.“"
                            },
                            {
                                "example_id": "d5f9e6fe-4043-4901-9d34-aee9fe011d95",
                                "sense_id": "40a7e5ff-2370-38cc-adb2-206f133279de",
                                "text": "„Diese Situation hat Palästinenserinnen und Palästinenser und zunehmend auch israelische und internationale Vertreterinnen und Vertreter aus Wissenschaft, Politik und Zivilgesellschaft dazu veranlasst, das Besatzungsregime mit der Apartheid zu vergleichen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
