                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8806be09-76cd-416e-9d4f-accc77a6b3e6",
                                "sense_id": "61823258-91f7-31bd-b2f8-ea18fde28b02",
                                "text": "Vouloir que les quelques gays de la population soient traités normalement ne veut pas dire \"pédéiser\" la société, ça fleure bon la lecture primaire."
                            },
                            {
                                "example_id": "2d6277ca-d756-4c28-a2ec-bbddf2096584",
                                "sense_id": "61823258-91f7-31bd-b2f8-ea18fde28b02",
                                "text": "Et arrêtez de \"pédéiser\" l'affaire, ça va vous faire plus de mal que de bien."
                            },
                            {
                                "example_id": "04af2d7e-767e-4791-8256-8af1ac60f8fa",
                                "sense_id": "61823258-91f7-31bd-b2f8-ea18fde28b02",
                                "text": "Vous avez pu pédéiser mon peuple mais mon ptit cul vous ne l'aurez jamais, mais mon ptit cul vous ne l'aurez jamais."
                            }
                        ]
                    }
