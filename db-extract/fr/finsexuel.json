                        "glosses": [
                            "Se dit de quelqu’un qui est attirée par la féminité, et ce, quelque soit le genre de la personne en question."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "762c6dae-00a1-467c-a2ec-9033c9e12d3d",
                                "sense_id": "24894389-f058-399d-bb58-1af25ecea039",
                                "text": "Cela signifie que les personnes finsexuel·les sont attirées par les femmes, les femmes aligné·es et/ou féminines présentant des personnes non-binaires et les hommes potentiellement féminins. Finsexuel n'est pas synonyme d'attirance pour les femmes, c'est l'attirance pour la féminité."
                            }
                        ]
