                        "sense_id": "528a2b16-c5f9-371d-ae7f-8fd319ea1403",
                        "entry_id": "9b741bf5-f063-3df2-a465-6106fa7c01c1",
                        "glosses": [
                            "относящийся к двору (отгороженному от улицы участку земли)"
                        ],
                        "tags": [],
