    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "768ed55d-2b0c-3a36-b5dd-7e51d7c5ed7c",
                    "sense_definition": "gwałtownie, odruchowo wypuszczać powietrze przez nos i usta z powodu podrażnienia błony śluzowej",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "odruchy fizjologiczne",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Od samego rana ciągle <w>kicham</w> i chyba złapałem przeziębienie.",
                            "target_lang_translations": {
                                "ru": "С самого утра я постоянно <w>чихаю</w> и, кажется, простудился."
                            }
                        },
                        {
                            "text": "Gdy sprzątała zakurzony strych, bez przerwy <w>kichała</w>.",
                            "target_lang_translations": {
                                "ru": "Убирая пыльный чердак, она не переставая <w>чихала</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "kichać od kurzu"
                    ],
                    "target_lang_definitions": {
                        "ru": "непроизвольно с резким звуком выдыхать воздух через нос и рот из-за раздражения слизистой оболочки"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чихать",
                                "target_lang_sense_clarification": "физиологический рефлекс"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "efd44cca-40b7-342f-aaa5-8384f67c6ea3",
                    "sense_definition": "traktować coś lekceważąco, nie przejmować się czymś zupełnie",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "lekceważenie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "On zupełnie <w>kicha</w> na moje dobre rady i zawsze robi po swojemu.",
                            "target_lang_translations": {
                                "ru": "Он совершенно <w>чихает</w> на мои добрые советы и всегда делает по-своему."
                            }
                        },
                        {
                            "text": "Na takie puste obietnice to ja po prostu <w>kicham</w>.",
                            "target_lang_translations": {
                                "ru": "На такие пустые обещания мне просто <w>плевать</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "bagatelizować",
                        "bimbać",
                        "gwizdać"
                    ],
                    "common_phrases": [
                        "kichać na wszystko",
                        "kichać na zasady"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "potoczne określenie lekceważenia"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "относиться к чему-либо пренебрежительно, совершенно не беспокоиться о чём-либо"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чихать",
                                "target_lang_sense_clarification": "проявлять пренебрежение, обычно с предлогом «на»"
                            },
                            {
                                "target_lang_word": "плевать",
                                "target_lang_sense_clarification": "быть совершенно безразличным"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2d186fa6-6fd5-3cf2-a33e-257f858c91b0",
                    "sense_definition": "o silniku lub pojeździe: wydawać głośne, urywane dźwięki przypominające kichnięcie z powodu usterki",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "dźwięki maszyn",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Stary traktor głośno <w>kichał</w>, ale w końcu ruszył z miejsca.",
                            "target_lang_translations": {
                                "ru": "Старый трактор громко <w>чихал</w>, но в конце концов тронулся с места."
                            }
                        },
                        {
                            "text": "Zepsuty silnik <w>kichał</w> przez kilka minut, po czym nagle zgasł.",
                            "target_lang_translations": {
                                "ru": "Неисправный двигатель <w>чихал</w> пару минут, после чего внезапно заглох."
                            }
                        }
                    ],
                    "synonyms": [
                        "parskać",
                        "prychać"
                    ],
                    "common_phrases": [
                        "silnik kicha"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "potoczne określenie dźwięków niesprawnego silnika"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "о двигателе или механизме: издавать прерывистые, резкие звуки из-за неисправности"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чихать",
                                "target_lang_sense_clarification": "о моторе, издавать глухие хлопки или перебои"
                            },
                            {
                                "target_lang_word": "пыхтеть",
                                "target_lang_sense_clarification": "о неисправно работающем механизме"
                            }
                        ]
                    }
                }
            ]
        }
    ]
