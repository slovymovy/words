{
    "word_family": [
        "prick",
        "prickly"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6b6e2244-1c88-3a52-97bf-8088f7ecd0aa",
                    "sense_definition": "A sharp, hard outgrowth on the stem of a plant, such as a rose.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sharp_object",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The gardener was careful to avoid the <w>prickle</w> on the rose stem.",
                            "target_lang_translations": {
                                "zh": "园丁小心地避开了玫瑰茎上的<w>刺</w>。"
                            }
                        },
                        {
                            "text": "She felt a sharp <w>prickle</w> when she grabbed the branch.",
                            "target_lang_translations": {
                                "zh": "她抓住树枝时，被上面尖锐的<w>刺</w>扎了一下。"
                            }
                        }
                    ],
                    "synonyms": [
                        "thorn",
                        "spine"
                    ],
                    "common_phrases": [
                        "sharp prickle"
                    ],
                    "target_lang_definitions": {
                        "zh": "植物茎上尖锐、坚硬的突起，如玫瑰上的刺。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "刺",
                                "target_lang_sense_clarification": "指植物表面的尖刺"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b80f9bb8-e2e7-3283-a184-f1e8e99fc036",
                    "sense_definition": "A small, sharp, pointed object.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "sharp_object",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A tiny <w>prickle</w> of glass was stuck in his finger.",
                            "target_lang_translations": {
                                "zh": "一根小小的玻璃<w>尖刺</w>扎进了他的手指。"
                            }
                        },
                        {
                            "text": "He removed the <w>prickle</w> from his skin with tweezers.",
                            "target_lang_translations": {
                                "zh": "他用镊子拔出了皮肤里的<w>尖刺</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "spike",
                        "needle"
                    ],
                    "target_lang_definitions": {
                        "zh": "细小、尖锐的物体。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "尖刺",
                                "target_lang_sense_clarification": "指细小的尖锐异物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6354fb8e-46a6-3902-8567-9d79f04de80e",
                    "sense_definition": "A tingling or stinging sensation on the skin.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "sensation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A sudden <w>prickle</w> of fear ran down her spine.",
                            "target_lang_translations": {
                                "zh": "一阵突如其来的恐惧感让她脊背<w>发麻</w>。"
                            }
                        },
                        {
                            "text": "The cold wind caused a <w>prickle</w> on his cheeks.",
                            "target_lang_translations": {
                                "zh": "冷风吹得他的脸颊感到一阵<w>刺痛</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "tingle",
                        "sting"
                    ],
                    "common_phrases": [
                        "prickle of fear"
                    ],
                    "target_lang_definitions": {
                        "zh": "皮肤上的一种刺痛或麻刺感。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "刺痛感",
                                "target_lang_sense_clarification": "指皮肤受刺激产生的轻微痛感"
                            },
                            {
                                "target_lang_word": "麻刺感",
                                "target_lang_sense_clarification": "指皮肤受冷或情绪影响产生的发麻感"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "50cc37ad-b76e-3fc1-8c7b-bceacfe53b76",
                    "sense_definition": "A collective noun for a group of hedgehogs or porcupines.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "collective_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We spotted a <w>prickle</w> of hedgehogs crossing the road at night.",
                            "target_lang_translations": {
                                "zh": "我们晚上看到一<w>群</w>刺猬正在过马路。"
                            }
                        },
                        {
                            "text": "The documentary showed a <w>prickle</w> foraging in the garden.",
                            "target_lang_translations": {
                                "zh": "纪录片展示了一<w>群</w>刺猬在花园里觅食。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "用于称呼一群刺猬或豪猪的集合名词。"
                    },
                    "translations": {
                        "zh": []
                    }
                },
                {
                    "sense_id": "432417d6-53de-3024-a84d-6aabee659cae",
                    "sense_definition": "A type of willow basket used for transporting goods.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "container",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The merchant filled the <w>prickle</w> with fresh walnuts.",
                            "target_lang_translations": {
                                "zh": "商人把<w>柳条筐</w>装满了新鲜核桃。"
                            }
                        },
                        {
                            "text": "Old records mention using a <w>prickle</w> to carry produce to market.",
                            "target_lang_translations": {
                                "zh": "古老的记录提到曾用<w>柳条筐</w>把农产品运往市场。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Refers to a historical type of basket."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "一种用于运输货物的柳条筐。"
                    },
                    "translations": {
                        "zh": []
                    }
                },
                {
                    "sense_id": "dd23e62b-df55-3525-895e-5f8134a53520",
                    "sense_definition": "A specific measure or container for hazelnuts, weighing about fifty pounds.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "container",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The shipment arrived in a large <w>prickle</w> of hazelnuts.",
                            "target_lang_translations": {
                                "zh": "这批货物是以一大<w>筐</w>榛子的形式运到的。"
                            }
                        },
                        {
                            "text": "They measured the harvest by the <w>prickle</w>.",
                            "target_lang_translations": {
                                "zh": "他们按<w>筐</w>来衡量收获量。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Historical unit of measurement."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "一种历史上的榛子计量单位或容器，约重五十磅。"
                    },
                    "translations": {
                        "zh": []
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8d3b1199-fec4-3aef-bebf-96907420d0a3",
                    "sense_definition": "To experience a tingling or stinging sensation.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sensation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My skin began to <w>prickle</w> in the cold air.",
                            "target_lang_translations": {
                                "zh": "在冷空气中，我的皮肤开始<w>发麻</w>。"
                            }
                        },
                        {
                            "text": "Her scalp started to <w>prickle</w> with nervous anticipation.",
                            "target_lang_translations": {
                                "zh": "由于紧张的期待，她的头皮开始<w>发麻</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "tingle"
                    ],
                    "target_lang_definitions": {
                        "zh": "感到刺痛或发麻。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "发麻",
                                "target_lang_sense_clarification": "指皮肤因冷或紧张而产生的感觉"
                            },
                            {
                                "target_lang_word": "刺痛",
                                "target_lang_sense_clarification": "指皮肤产生轻微的刺痛感"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dbe7ab3f-9966-306e-b9a3-33117c0bb3d8",
                    "sense_definition": "To cause a tingling or stinging sensation.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sensation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The wool sweater began to <w>prickle</w> my sensitive skin.",
                            "target_lang_translations": {
                                "zh": "羊毛衫开始<w>扎</w>我敏感的皮肤。"
                            }
                        },
                        {
                            "text": "Guilt continued to <w>prickle</w> his conscience throughout the day.",
                            "target_lang_translations": {
                                "zh": "内疚感整天都在<w>刺痛</w>着他的良心。"
                            }
                        }
                    ],
                    "synonyms": [
                        "sting"
                    ],
                    "target_lang_definitions": {
                        "zh": "使感到刺痛或发麻。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "扎",
                                "target_lang_sense_clarification": "指物体接触皮肤引起刺痛"
                            },
                            {
                                "target_lang_word": "刺痛",
                                "target_lang_sense_clarification": "指引起心理或生理上的刺痛感"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}