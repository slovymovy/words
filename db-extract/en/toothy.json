                        "sense_id": "4675c788-45ef-3c84-b168-c888e5e8fcf2",
                        "entry_id": "a0d0ebc7-1cac-3215-ab14-5f0499c6848d",
                        "glosses": [
                            "Having prominent teeth."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4541790f-159c-4c6a-9409-4312bfad2821",
                                "sense_id": "4675c788-45ef-3c84-b168-c888e5e8fcf2",
                                "text": "Their ties were tidier, their houndsteeth toothier … they ended up looking more Windsorian than Windsor."
                            },
                            {
                                "example_id": "a6503704-2893-492e-9bed-28eecd45c0fc",
                                "sense_id": "4675c788-45ef-3c84-b168-c888e5e8fcf2",
                                "text": "Throughout the period, toothy giants persisted in the oceans. Perhaps the most spectacular was the megalodon shark."
                            },
                            {
                                "example_id": "5a49118f-7861-4bd4-abf1-01ccc8d8f478",
                                "sense_id": "4675c788-45ef-3c84-b168-c888e5e8fcf2",
                                "text": "Frances Tiafoe is coming for tennis once more. The tongue-wagging and the fist-pumping and the glare; the toothiest you-know-what-eating grin in the game; the high-energy vibes that can bring any tennis crowd into his corner."
                            }
                        ]
                    }
