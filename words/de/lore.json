                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nissen hat uns am Morgen mit der <w>Lore</w> auf einem Betriebshof bei Dagebüll abgeholt."
                        },
                        {
                            "text": "Bei Niedrigwasser fahren die Inselbewohner mit einer motorisierten <w>Lore</w> über den Damm."
                        }
                    ],
                    "common_phrases": [
