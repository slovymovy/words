                                        "entry_id": "0ec7fe02-4666-3256-a909-75dc537be9ba",
                                        "glosses": [
                                            "Liqueur composée d’eau-de-vie, de sucre et de jus de certains fruits ou d’arôme de quelques fleurs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b328dcbb-18c6-4321-9731-c8819ccca3ee",
                                                "sense_id": "bc8ad76a-2927-3e17-9a81-e518fe01e736",
                                                "text": "Son petit verre de ratafia bu, (…) il en vida un second."
                                            },
                                            {
                                                "example_id": "69abb05c-9666-4a17-9291-8272eb3b3451",
                                                "sense_id": "bc8ad76a-2927-3e17-9a81-e518fe01e736",
                                                "text": "Pour Henri Vincenot, cette « trempusse » se pratique aussi en Bourgogne sous une autre forme « pour faire durer les vieux » : une soupière de ratafia qu’on pose sur la table de nuit & qui s’avale à la cuillère."
                                            },
                                            {
                                                "example_id": "c00e98b6-52a5-4553-acb6-cee8c5be2d1d",
                                                "sense_id": "bc8ad76a-2927-3e17-9a81-e518fe01e736",
                                                "text": "Ratafia de cerises."
                                            },
                                            {
                                                "example_id": "9c794583-ad20-4a80-854c-0054b79cd108",
                                                "sense_id": "bc8ad76a-2927-3e17-9a81-e518fe01e736",
                                                "text": "Ratafia de fleurs d’oranger."
                                            }
                                        ]
