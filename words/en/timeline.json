{
    "word_family": [
        "time",
        "line",
        "timelining"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "09c024e9-bb40-390b-8f6c-09d7f01909c0",
                    "sense_definition": "A schedule of activities or a plan showing when things are expected to happen.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "planning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The project manager needs to establish a clear <w>timeline</w> for the new product launch.",
                            "target_lang_translations": {
                                "ru": "Менеджеру проекта необходимо составить четкий <w>график</w> запуска нового продукта.",
                                "zh": "项目经理需要为新产品发布制定清晰的<w>时间表</w>。"
                            }
                        },
                        {
                            "text": "We must follow the <w>timeline</w> for completion to ensure the building is ready by summer.",
                            "target_lang_translations": {
                                "ru": "Мы должны соблюдать <w>сроки</w> завершения работ, чтобы здание было готово к лету.",
                                "zh": "我们必须遵守<w>进度表</w>，以确保大楼能在夏天前完工。"
                            }
                        }
                    ],
                    "synonyms": [
                        "schedule",
                        "timetable"
                    ],
                    "common_phrases": [
                        "timeline for completion",
                        "project timeline",
                        "strict timeline"
                    ],
                    "target_lang_definitions": {
                        "ru": "График мероприятий или план, показывающий ожидаемые сроки выполнения задач.",
                        "zh": "一系列活动的计划或时间表，显示预期发生的时间。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "график",
                                "target_lang_sense_clarification": "план работ или мероприятий"
                            },
                            {
                                "target_lang_word": "сроки",
                                "target_lang_sense_clarification": "временные рамки выполнения"
                            },
                            {
                                "target_lang_word": "календарный план",
                                "target_lang_sense_clarification": "официальный график проекта"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "时间表",
                                "target_lang_sense_clarification": "工作或活动的计划安排"
                            },
                            {
                                "target_lang_word": "进度表",
                                "target_lang_sense_clarification": "项目执行的阶段性计划"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a8bc18d7-78a5-32d3-bbe0-f1f1ef66bc8f",
                    "sense_definition": "A graphical representation or list showing a chronological sequence of events.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "representation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The history book includes a <w>timeline</w> of the major events of the twentieth century.",
                            "target_lang_translations": {
                                "ru": "В учебнике истории есть <w>хронологическая шкала</w> основных событий двадцатого века.",
                                "zh": "这本历史书包含了一份二十世纪重大事件的<w>时间轴</w>。"
                            }
                        },
                        {
                            "text": "You can scroll through your social media <w>timeline</w> to see posts from your friends.",
                            "target_lang_translations": {
                                "ru": "Вы можете прокрутить свою <w>ленту</w> в социальных сетях, чтобы увидеть посты друзей.",
                                "zh": "你可以滚动浏览社交媒体的<w>信息流</w>来查看朋友们的动态。"
                            }
                        }
                    ],
                    "synonyms": [
                        "chronology"
                    ],
                    "antonyms": [
                        "timepoint"
                    ],
                    "common_phrases": [
                        "historical timeline",
                        "social media timeline",
                        "event timeline"
                    ],
                    "target_lang_definitions": {
                        "ru": "Графическое представление или список, отображающий хронологическую последовательность событий.",
                        "zh": "以图形或列表形式展示事件发生的先后顺序。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "временная шкала",
                                "target_lang_sense_clarification": "линия времени с событиями"
                            },
                            {
                                "target_lang_word": "хронология",
                                "target_lang_sense_clarification": "последовательность исторических событий"
                            },
                            {
                                "target_lang_word": "лента",
                                "target_lang_sense_clarification": "в контексте социальных сетей"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "时间轴",
                                "target_lang_sense_clarification": "展示事件顺序的图形化线条"
                            },
                            {
                                "target_lang_word": "信息流",
                                "target_lang_sense_clarification": "社交媒体中按时间排列的内容"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e684628f-da74-3caa-a934-0bc58563214f",
                    "sense_definition": "An individual universe or reality, especially a parallel or alternate one where history differs.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "fiction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In this alternate <w>timeline</w>, the Roman Empire never collapsed and still rules the world.",
                            "target_lang_translations": {
                                "ru": "В этой альтернативной <w>временной линии</w> Римская империя так и не распалась и до сих пор правит миром.",
                                "zh": "在这条替代的<w>时间线</w>中，罗马帝国从未灭亡，至今仍统治着世界。"
                            }
                        },
                        {
                            "text": "The characters traveled to a different <w>timeline</w> to prevent the disaster from happening.",
                            "target_lang_translations": {
                                "ru": "Герои отправились в другую <w>реальность</w>, чтобы предотвратить катастрофу.",
                                "zh": "角色们穿越到了另一条<w>时间线</w>以阻止灾难发生。"
                            }
                        }
                    ],
                    "synonyms": [
                        "timestream",
                        "time track"
                    ],
                    "common_phrases": [
                        "alternate timeline",
                        "parallel timeline",
                        "darkest timeline"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отдельная вселенная или реальность, особенно параллельная или альтернативная, с иной историей.",
                        "zh": "一个独立的宇宙或现实，尤指历史走向不同的平行或替代世界。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "временная линия",
                                "target_lang_sense_clarification": "вариант развития истории во вселенной"
                            },
                            {
                                "target_lang_word": "таймлайн",
                                "target_lang_sense_clarification": "сленговый термин в фантастике"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "时间线",
                                "target_lang_sense_clarification": "科幻作品中特定的历史发展路径"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "59d35582-2f65-3974-98ae-5d661fa90dca",
                    "sense_definition": "To analyze or organize a sequence of events or activities in chronological order.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "analysis",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The detectives spent hours trying to <w>timeline</w> the suspect's movements on the night of the crime.",
                            "target_lang_translations": {
                                "ru": "Детективы часами пытались <w>восстановить хронологию</w> передвижений подозреваемого в ночь преступления.",
                                "zh": "侦探们花了数小时试图<w>梳理</w>嫌疑人在案发当晚的行踪。"
                            }
                        },
                        {
                            "text": "It is helpful to <w>timeline</w> the events to understand how the conflict started.",
                            "target_lang_translations": {
                                "ru": "Полезно <w>выстроить события по порядку</w>, чтобы понять, как начался конфликт.",
                                "zh": "将事件按<w>时间顺序排列</w>有助于理解冲突是如何开始的。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "timeline the events"
                    ],
                    "target_lang_definitions": {
                        "ru": "Анализировать или организовывать последовательность событий или действий в хронологическом порядке.",
                        "zh": "按时间顺序分析或整理一系列事件或活动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "восстановить хронологию",
                                "target_lang_sense_clarification": "установить порядок событий по времени"
                            },
                            {
                                "target_lang_word": "выстроить во времени",
                                "target_lang_sense_clarification": "распределить действия по порядку"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "梳理",
                                "target_lang_sense_clarification": "整理事件的先后顺序"
                            },
                            {
                                "target_lang_word": "还原",
                                "target_lang_sense_clarification": "重现事件发生的经过"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a3271139-3042-325b-87a4-c8a456d29057",
                    "sense_definition": "To display a sequence of events graphically.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "representation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The software allows users to <w>timeline</w> their data for better visual clarity.",
                            "target_lang_translations": {
                                "ru": "Программное обеспечение позволяет пользователям <w>визуализировать</w> свои данные <w>на шкале времени</w> для большей наглядности.",
                                "zh": "该软件允许用户将数据<w>制作成时间轴</w>，以便更直观地查看。"
                            }
                        },
                        {
                            "text": "We need to <w>timeline</w> the project milestones for the presentation tomorrow.",
                            "target_lang_translations": {
                                "ru": "Нам нужно <w>нанести</w> этапы проекта <w>на график</w> для завтрашней презентации.",
                                "zh": "我们需要为明天的演示文稿将项目里程碑<w>标注在时间轴上</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Отображать последовательность событий в графическом виде.",
                        "zh": "以图形方式展示事件序列。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "визуализировать на шкале времени",
                                "target_lang_sense_clarification": "представить данные графически"
                            },
                            {
                                "target_lang_word": "наносить на график",
                                "target_lang_sense_clarification": "отмечать этапы на временной оси"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "制作时间轴",
                                "target_lang_sense_clarification": "将数据可视化为时间序列"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}