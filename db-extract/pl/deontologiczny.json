                "translations": [
                    {
                        "translation_id": "79c7e2d8-f331-4665-90da-25cde9f9865f",
                        "source_entry_id": "e3f1997d-4580-3f0d-9fcd-6e385dd46cd7",
                        "source_sense_id": "d834cfa9-f409-3d64-bc32-5d976a762315",
                        "target_lang_word": "deontological",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "deontological",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "63121659-e0db-3f86-924b-e24e251b2a3d",
                                        "entry_id": "b44f8fc2-1f55-30af-8165-533cd9bf7e05",
                                        "glosses": [
                                            "Of or relating to deontology."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1face96a-43ac-47df-875e-e33217b07053",
                                                "sense_id": "63121659-e0db-3f86-924b-e24e251b2a3d",
                                                "text": "Deontological theories hold that there are ethical propositions of the form: 'Such and such a kind of action would always be right (or wrong) in such and such circumstances, no matter what its consequences might be.'"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e5ab4b68-e234-4d74-a058-c5d83b5572bb",
                        "source_entry_id": "e3f1997d-4580-3f0d-9fcd-6e385dd46cd7",
                        "source_sense_id": "d834cfa9-f409-3d64-bc32-5d976a762315",
                        "target_lang_word": "déontologique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "déontologique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a39a984c-dd45-3375-816a-292895fdb5ba",
                                        "entry_id": "9638b896-381f-370a-8110-0fd1f1d01028",
                                        "glosses": [
                                            "Relatif à la déontologie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cab4a402-faad-495c-979e-77b045861554",
                                                "sense_id": "a39a984c-dd45-3375-816a-292895fdb5ba",
                                                "text": "Si cette confusion des genres a beaucoup nui à l’image du journalisme, il est une autre question qui soulève des problèmes déontologiques mal résolus : l’information peut-elle être volée ou, plus largement, avoir été obtenue par des moyens illégaux ?"
                                            },
                                            {
                                                "example_id": "c4cfd4e6-9ef1-4dbf-ac47-a8c5f0054690",
                                                "sense_id": "a39a984c-dd45-3375-816a-292895fdb5ba",
                                                "text": "Tout élu local peut consulter un référent déontologue chargé de lui apporter tout conseil utile au respect des principes déontologiques consacrés dans la charte de l'élu local."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
