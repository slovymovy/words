                "senses": [
                    {
                        "sense_id": "3207c7c0-f8ad-39a6-b3dc-d75c33a34e33",
                        "entry_id": "baea3778-fda9-3b4a-bbb5-7b9646ddfcc4",
                        "glosses": [
                            "Se pardonner à soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d83f9cf1-ab89-457e-8f19-0b8d02f5334e",
                                "sense_id": "3207c7c0-f8ad-39a6-b3dc-d75c33a34e33",
                                "text": "Je fais des fautes et je m'autopardonne... ou alors je me verbalise et je me paye une amende, mais l'argent reste dans la famille... ça revient au même que l'autopardon..."
                            },
                            {
                                "example_id": "03643e97-f474-4c13-bbad-4dfc9a59c15b",
                                "sense_id": "3207c7c0-f8ad-39a6-b3dc-d75c33a34e33",
                                "text": "Pardonner à l'autre n'est envisageable que dans la mesure où l'on peut déjà s'autopardonner."
                            }
                        ]
                    }
