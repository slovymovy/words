                    {
                        "sense_id": "9350597c-1da3-318e-92fa-9a5989080aa4",
                        "entry_id": "2e4e9cad-757f-3a0d-9504-32c010d2d0aa",
                        "glosses": [
                            "Arbrisseau qui porte des groseilles et en particulier Ribes rubrum."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "acdecba9-dd77-4cb5-9d36-bf999d6efdc2",
                                "sense_id": "9350597c-1da3-318e-92fa-9a5989080aa4",
                                "text": "Nous rencontrons dans la banlieue de pauvres jardinets où les indigènes cultivent quelques légumes, et qu'ils ornent de saules , de sureaux et de groseilliers ; […]."
                            },
                            {
                                "example_id": "63f040eb-e0d0-4ab5-85d7-d26f26ea95de",
                                "sense_id": "9350597c-1da3-318e-92fa-9a5989080aa4",
                                "text": "Ils ne remarquèrent pas la maison Bonvin et durent prendre pour des groseilliers ses fameux arbres du Japon."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c86a515c-ef1b-4f49-a9b3-abbcc41ed829",
                        "source_entry_id": "2e4e9cad-757f-3a0d-9504-32c010d2d0aa",
                        "source_sense_id": "9350597c-1da3-318e-92fa-9a5989080aa4",
