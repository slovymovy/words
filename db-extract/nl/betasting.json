                "senses": [
                    {
                        "sense_id": "8d630386-03d2-3053-b926-6975fd17acf0",
                        "entry_id": "cef52906-58c2-3c66-962d-9a832d2c5f51",
                        "glosses": [
                            "een onprettige, onzedelijke aanraking"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a00d257e-0abd-4836-8779-7b8ff99dacfe",
                                "sense_id": "8d630386-03d2-3053-b926-6975fd17acf0",
                                "text": "Een woordvoerder van de politie bevestigt desgevraagd dat een vrouw melding heeft gemaakt van betasting door een taxichauffeur. De beschuldiging bleek echter onvoldoende hard om er gelijk ook het predicaat aangifte aan te hangen."
                            },
                            {
                                "example_id": "54f5fe08-8cad-4888-8a3f-e3da755e51e8",
                                "sense_id": "8d630386-03d2-3053-b926-6975fd17acf0",
                                "text": "De politie heeft het onderzoek naar de onzedelijke betasting van een meisje afgerond. Een jongeman is als verdachte, maar hij ontkent. Hij is weer op vrije voeten gesteld. Het is aan de officier van justitie te beslissen of tot vervolging wordt overgegaan."
                            },
                            {
                                "example_id": "0a384a39-6160-4731-8372-84e5e35a3f73",
                                "sense_id": "8d630386-03d2-3053-b926-6975fd17acf0",
                                "text": "Een omstreden priester die in België in 2008 werd veroordeeld en ontslagen na betasting van een minderjarige, gaat niet als pastoor aan de slag in de West-Vlaamse gemeente Middelkerke."
                            }
                        ]
                    },
