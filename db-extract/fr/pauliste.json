                "senses": [
                    {
                        "sense_id": "dff782da-7eba-3283-a688-2b0de20e54b0",
                        "entry_id": "f0c7e8d4-99a6-34fb-b728-df35dca52626",
                        "glosses": [
                            "Habitant de l’État de São Paulo au Brésil."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "543f10e2-b315-4680-821e-6b0d81eae660",
                                "sense_id": "dff782da-7eba-3283-a688-2b0de20e54b0",
                                "text": "Mais les Amazoniens pousseraient trop loin l’amour de la symétrie, s’ils voulaient imiter les erreurs économiques, heureusement passagères, des Paulistes."
                            },
                            {
                                "example_id": "da2ef903-b8ec-416f-905f-cb6b326b6dee",
                                "sense_id": "dff782da-7eba-3283-a688-2b0de20e54b0",
                                "text": "Celui-ci n’a encore aucune idée de ce qu’on lui demandera, il sait seulement qu’il court un risque à cause d’Augusta, de ses bras nus, de la jolie robe en surah orange qui découvre les épaules et la gorge, de la musicalité des voix brésiliennes autour de lui : la Bahianaise, le maître d’hôtel, un Carioca, le sommelier, un Pauliste."
                            }
                        ]
                    }
