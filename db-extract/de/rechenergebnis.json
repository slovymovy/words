                "senses": [
                    {
                        "sense_id": "aa1a5edb-0b8c-3ab3-9753-1b8512b9b3b4",
                        "entry_id": "30a5e066-06b9-3ff3-9e60-9820928ba6da",
                        "glosses": [
                            "Ergebnis, das durch Rechnen erzielt wird/wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b1522ff0-e2e7-4107-970c-ca204a242a29",
                                "sense_id": "aa1a5edb-0b8c-3ab3-9753-1b8512b9b3b4",
                                "text": "„Also muss er die Rechtschreibung neu erfinden, so wie Leibniz die Integralrechnung erfand, weil er ein Rechenergebnis benötigte, das man bis dato nicht ausrechnen konnte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d9a2aa67-f285-4e56-946c-0b75405b1ee1",
                        "source_entry_id": "30a5e066-06b9-3ff3-9e60-9820928ba6da",
                        "source_sense_id": "aa1a5edb-0b8c-3ab3-9753-1b8512b9b3b4",
                        "source_sense_description": "Ergebnis, das durch Rechnen erzielt wird/wurde",
                        "target_lang_word": "compte",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "compte",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8bd79624-a879-387c-8275-37c7d905817b",
                                        "entry_id": "1520a85a-74f7-3992-ad47-eebb00f1d3af",
                                        "glosses": [
                                            "Action de compter, dénombrement, calcul opéré sur tel ou tel ensemble de choses ; résultat de cette action."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "185ef2a0-5a02-4eb6-8970-664be2242c0a",
                                                "sense_id": "8bd79624-a879-387c-8275-37c7d905817b",
                                                "text": "Il sait le compte de son argent."
                                            },
                                            {
                                                "example_id": "7ae76650-5314-45e1-8973-111f54dbadc3",
                                                "sense_id": "8bd79624-a879-387c-8275-37c7d905817b",
                                                "text": "Faire le compte du linge qu’on donne à la blanchisseuse."
                                            },
                                            {
                                                "example_id": "92e242e1-dd61-4552-a896-e0d2a00629e4",
                                                "sense_id": "8bd79624-a879-387c-8275-37c7d905817b",
                                                "text": "Je vous ferai votre compte."
                                            },
                                            {
                                                "example_id": "433d3831-7c40-409b-9398-5b61528c2e56",
                                                "sense_id": "8bd79624-a879-387c-8275-37c7d905817b",
                                                "text": "Vous ne lui avez pas donné son compte."
                                            },
                                            {
                                                "example_id": "9c68ec6f-d9b3-47a8-af24-b7b1bc1304f6",
                                                "sense_id": "8bd79624-a879-387c-8275-37c7d905817b",
                                                "text": "S’il fallait rappeler toutes ses folies, le compte en serait long."
                                            },
                                            {
                                                "example_id": "db0e3843-f242-4335-b7ea-dae54d8c6813",
                                                "sense_id": "8bd79624-a879-387c-8275-37c7d905817b",
                                                "text": "Inscrire régulièrement tous les jours le compte de ses recettes et de ses dépenses."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "51b578db-a928-3ad1-8264-3dfcc2593861",
                                        "entry_id": "1520a85a-74f7-3992-ad47-eebb00f1d3af",
                                        "glosses": [
                                            "État de ce qui a été reçu, ce qui est dû, dépensé, avancé ou fourni."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bddd9c3a-af6f-48e2-b666-b79f947bb533",
                                                "sense_id": "51b578db-a928-3ad1-8264-3dfcc2593861",
                                                "text": "Des créanciers récalcitrants ont obtenu un jugement contre moi et mon compte est bloqué chez Hachette."
                                            },
                                            {
                                                "example_id": "dd5a29fd-7118-4764-a1dd-66203717446f",
                                                "sense_id": "51b578db-a928-3ad1-8264-3dfcc2593861",
                                                "text": "Le total d’un compte."
                                            },
                                            {
                                                "example_id": "896f84b7-01f3-403e-81c7-36b0e312d7c2",
                                                "sense_id": "51b578db-a928-3ad1-8264-3dfcc2593861",
                                                "text": "Compte de pertes et profits."
                                            },
                                            {
                                                "example_id": "37c19d2f-c8f8-430c-95ce-50d0e3fd48a7",
                                                "sense_id": "51b578db-a928-3ad1-8264-3dfcc2593861",
                                                "text": "Tenir les comptes chez un marchand."
                                            },
                                            {
                                                "example_id": "9dfb64b3-ebfa-44d9-b2d2-10f0a9650b9d",
                                                "sense_id": "51b578db-a928-3ad1-8264-3dfcc2593861",
                                                "text": "Donner son compte à un ouvrier, lui payer ce qui lui est dû."
                                            },
                                            {
                                                "example_id": "11e79274-5972-42e7-9eee-f05d11f39bb6",
                                                "sense_id": "51b578db-a928-3ad1-8264-3dfcc2593861",
                                                "text": "Donner son compte à un domestique, lui donner ce qui lui est dû en le renvoyant. Le congédier."
                                            },
                                            {
                                                "example_id": "c5c4e2de-e554-4746-9a57-a0e11a501068",
                                                "sense_id": "51b578db-a928-3ad1-8264-3dfcc2593861",
                                                "text": "Cela est à son compte, au compte d’un tel, c’est à lui à le payer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d664b241-856d-33e7-9eba-56931280d428",
                                        "entry_id": "1520a85a-74f7-3992-ad47-eebb00f1d3af",
                                        "glosses": [
                                            "Écrit contenant l’énumération, le calcul, la supputation de cet état."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4cf242f5-460c-41f5-870f-ab50824d74f2",
                                                "sense_id": "d664b241-856d-33e7-9eba-56931280d428",
                                                "text": "À l’exemple des grands capitaines, il avait admis l’imprévu en ligne de compte, et il avait espéré qu’un heureux hasard lui offrirait quelque occasion pour entrer en matière."
                                            },
                                            {
                                                "example_id": "09568acd-e464-4d00-b7cd-20a7338854eb",
                                                "sense_id": "d664b241-856d-33e7-9eba-56931280d428",
                                                "text": "Le Capitaine, […], s’était fâché rouge lorsque son fils avait réclamé ses comptes de tutelle, et même lui avait coupé les vivres, tout net."
                                            },
                                            {
                                                "example_id": "448605c3-df52-4142-a5b6-6a3ec56744d4",
                                                "sense_id": "d664b241-856d-33e7-9eba-56931280d428",
                                                "text": "Les comptes nationaux sont une construction sociale, en perpétuelle évolution, reflétant toujours les préoccupations d'une époque. Les chiffres qui en sont issus ne doivent pas être fétichisés."
                                            },
                                            {
                                                "example_id": "10c20890-f082-4132-9373-7116c6c90227",
                                                "sense_id": "d664b241-856d-33e7-9eba-56931280d428",
                                                "text": "Un article de compte."
                                            },
                                            {
                                                "example_id": "4e0f3eb5-c15f-40a5-aeaa-b1334a242c50",
                                                "sense_id": "d664b241-856d-33e7-9eba-56931280d428",
                                                "text": "Livre de compte."
                                            },
                                            {
                                                "example_id": "3602f259-a09c-488f-9d55-938d7bb12d8d",
                                                "sense_id": "d664b241-856d-33e7-9eba-56931280d428",
                                                "text": "Passer, mettre quelque chose en compte."
                                            },
                                            {
                                                "example_id": "a2d777ca-6d4f-4acd-92f1-94d602a52233",
                                                "sense_id": "d664b241-856d-33e7-9eba-56931280d428",
                                                "text": "Revoir, vérifier, examiner, recevoir, apurer un compte."
                                            },
                                            {
                                                "example_id": "0307d145-a698-4dca-9cb7-aeefdf968d35",
                                                "sense_id": "d664b241-856d-33e7-9eba-56931280d428",
                                                "text": "Régler, valider, balancer un compte."
                                            },
                                            {
                                                "example_id": "3b0965fa-fd86-408f-833a-f3dda2a2c2e6",
                                                "sense_id": "d664b241-856d-33e7-9eba-56931280d428",
                                                "text": "Arrêter, clore, solder un compte."
                                            },
                                            {
                                                "example_id": "b7ab1cec-33d4-4ad1-947f-e84675c22aed",
                                                "sense_id": "d664b241-856d-33e7-9eba-56931280d428",
                                                "text": "Débiter, créditer un compte."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "42f89d52-fd4b-3e29-a268-99bf4a209e01",
                                        "entry_id": "1520a85a-74f7-3992-ad47-eebb00f1d3af",
                                        "glosses": [
                                            "Écrit contenant l’énumération, le calcul, la supputation de cet état.",
                                            "Livret, solde chez un tiers avec lequel s’opèrent des échanges économiques."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "983d870f-d803-4768-afe6-369f7f5b7fd0",
                                                "sense_id": "42f89d52-fd4b-3e29-a268-99bf4a209e01",
                                                "text": "Cet argent sera prélevé sur le compte que j'ai ouvert pour Hector afin qu'il puisse ouvrir un cabinet quand Sarah prendra les commandes du cabinet d'expertise comptable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3c547c47-d792-38d0-9341-a36cdc2c5757",
                                        "entry_id": "1520a85a-74f7-3992-ad47-eebb00f1d3af",
                                        "glosses": [
                                            "Action de rapporter ce qu’on a fait, ce qu’on a vu, etc., et d’en rendre raison, de l’expliquer. Dans ce sens, il s’emploie ordinairement avec les verbes « rendre », « devoir » et « demander »."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2842a353-8f09-43b5-acf1-c09ee7ef44f3",
                                                "sense_id": "3c547c47-d792-38d0-9341-a36cdc2c5757",
                                                "text": "On nous demandera compte de nos actions."
                                            },
                                            {
                                                "example_id": "9dccf601-29b4-4d77-8458-501d879a65b2",
                                                "sense_id": "3c547c47-d792-38d0-9341-a36cdc2c5757",
                                                "text": "Je ne vous dois aucun compte de mes actions."
                                            },
                                            {
                                                "example_id": "d73a3fe9-b31c-4ae1-951b-3d699df53734",
                                                "sense_id": "3c547c47-d792-38d0-9341-a36cdc2c5757",
                                                "text": "Il ne doit compte à personne de son administration."
                                            },
                                            {
                                                "example_id": "fbd3bd23-ad27-4464-a478-570ad7d7bc30",
                                                "sense_id": "3c547c47-d792-38d0-9341-a36cdc2c5757",
                                                "text": "— Puisque vous m’avez demandé, dit-elle, d’être votre intermédiaire auprès de mon mari et de ma belle-fille, je vous dois compte de ce que j’ai pu faire."
                                            },
                                            {
                                                "example_id": "d3ae0955-f54f-4e67-b462-be8265ba6eba",
                                                "sense_id": "3c547c47-d792-38d0-9341-a36cdc2c5757",
                                                "text": "Il est riche, estimé, on ne lui demande pas compte de la manière dont il a pu acquérir sa fortune."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea040592-c4c7-3434-bdff-6cb5196993fc",
                                        "entry_id": "1520a85a-74f7-3992-ad47-eebb00f1d3af",
                                        "glosses": [
                                            "Avoir une chose en compte, l’administrer, en disposer, à la charge d’en rendre compte à qui de droit."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8ad19823-8c49-3b24-a19b-e67e04927659",
                                        "entry_id": "1520a85a-74f7-3992-ad47-eebb00f1d3af",
                                        "glosses": [
                                            "Ensemble des ressources informatiques attribuées à un utilisateur, qui ne peut les utiliser qu’en s’identifiant sur le système avec son nom d’utilisateur et son mot de passe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ebc87c35-1349-4f21-8ad9-6e3151163c4a",
                                                "sense_id": "8ad19823-8c49-3b24-a19b-e67e04927659",
                                                "text": "On peut utiliser un média social en se créant un compte."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "compte",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "04dcf699-610c-3e75-a79f-fb1bfdb9866c",
                                        "entry_id": "44db1cb8-7e47-3c23-a8fb-de1be6eadff4",
                                        "glosses": [
                                            "Première personne du singulier de l’indicatif présent de compter."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "58c3588c-48ca-4f26-b8d5-611100db5b81",
                                                "sense_id": "04dcf699-610c-3e75-a79f-fb1bfdb9866c",
                                                "text": "Je compte une biche, un cygneau, une grenouille, un ours, un lynx, cinq chiens et trois anguipèdes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "de3ac68e-777b-3ad0-aca3-d542ed4362d2",
                                        "entry_id": "44db1cb8-7e47-3c23-a8fb-de1be6eadff4",
                                        "glosses": [
                                            "Troisième personne du singulier de l’indicatif présent de compter."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "60d5a2d8-c17c-4e75-9e2f-af268a6ad510",
                                                "sense_id": "de3ac68e-777b-3ad0-aca3-d542ed4362d2",
                                                "text": "Cette ville, située à une altitude de mille toises sur le revers oriental des Rocheuses, au bord d’un torrent tributaire du Missouri, forme un vaste entrepôt pour les produits miniers de la région, et compte de quatorze à quinze mille habitants."
                                            },
                                            {
                                                "example_id": "413e53bc-1a43-4971-8481-7a5e190d742b",
                                                "sense_id": "de3ac68e-777b-3ad0-aca3-d542ed4362d2",
                                                "text": "Travaillez, prenez de la peine, le comptable compte pour vous. Et recompte et balance, et bilanise et expertise."
                                            },
                                            {
                                                "example_id": "b29b14da-a486-4cec-a3a5-46aa8074e68d",
                                                "sense_id": "de3ac68e-777b-3ad0-aca3-d542ed4362d2",
                                                "text": "Ici, le bois se compte par cordes, dont l’unité de mesure peut varier d’un canton à l’autre, une corde, aux Crozets, vaut quatre stères."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bb09fa6d-f462-3c33-a842-e67e27b6d488",
                                        "entry_id": "44db1cb8-7e47-3c23-a8fb-de1be6eadff4",
                                        "glosses": [
                                            "Première personne du singulier du subjonctif présent de compter."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f2fa16b6-5e6c-328e-8ed5-232c81e8467b",
                                        "entry_id": "44db1cb8-7e47-3c23-a8fb-de1be6eadff4",
                                        "glosses": [
