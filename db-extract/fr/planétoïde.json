        "fr-extract.jsonl": [
            {
                "entry_id": "1b332ad5-f9ea-398e-bbb6-50a6e61c60dd",
                "word": "planétoïde",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "47ece929-de4a-4869-b100-21242c4d7cd0",
                        "entry_id": "1b332ad5-f9ea-398e-bbb6-50a6e61c60dd",
                        "tags": [
                            "plural"
                        ],
                        "form": "planétoïdes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0cfea0a8-4bc0-37db-99c8-e3eb56474af7",
                        "entry_id": "1b332ad5-f9ea-398e-bbb6-50a6e61c60dd",
                        "glosses": [
                            "Synonyme de astéroïde."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c8bb7731-c221-4738-91b7-cfd36d5aa521",
                                "sense_id": "0cfea0a8-4bc0-37db-99c8-e3eb56474af7",
                                "text": "Au siècle suivant, les astronomes ont observé une nouvelle classe d'objets célestes qu'ils ont qualifiés d'« astéroïdes », et non de « planétoïdes », en dépit du fait qu'ils orbitaient autour du Soleil comme les planètes."
                            }
                        ]
                    },
                    {
                        "sense_id": "fff7e9c4-b494-3349-94eb-a69a3388bff6",
                        "entry_id": "1b332ad5-f9ea-398e-bbb6-50a6e61c60dd",
                        "glosses": [
                            "Corps de faible masse, précurseurs des planètes, qui seraient apparus lors de la naissance du système solaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25dd4963-ee6e-46a1-8630-2ce12793b091",
                                "sense_id": "fff7e9c4-b494-3349-94eb-a69a3388bff6",
                                "text": "Les collisions inélastiques dans le plan équatorial ont aussi pour effet d’accélérer la croissance des planétoïdes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "02094eeb-6096-4eb7-ae4a-9326cca25a54",
                        "source_entry_id": "1b332ad5-f9ea-398e-bbb6-50a6e61c60dd",
                        "target_lang_word": "planetoid",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "planetoid",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a9adb6b1-fcd0-3721-9801-d0174e415a75",
                                        "entry_id": "a8b282b6-e0ca-38e0-9e4b-46f8e8978d4c",
                                        "glosses": [
                                            "An asteroid of any size"
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ffbeb2a9-aef8-4081-98e6-d0ed3c9843cf",
                                                "sense_id": "a9adb6b1-fcd0-3721-9801-d0174e415a75",
                                                "text": "The group of small bodies that circle round the Sun, outside the orbit of Mars, are known under the designation of the planetoids."
                                            },
                                            {
                                                "example_id": "06b36edf-5008-4162-a3cf-81f857d50c7e",
                                                "sense_id": "a9adb6b1-fcd0-3721-9801-d0174e415a75",
                                                "text": "Numbering of the Planetoids or Asteroidal Planets.—In numbering the planetoids a difficulty has arisen [...]"
                                            },
                                            {
                                                "example_id": "f34cf409-2073-45a6-8b3a-d82d2acbbfcd",
                                                "sense_id": "a9adb6b1-fcd0-3721-9801-d0174e415a75",
                                                "text": "if one can argue for the early existence of a few largely molten planetoids with dimension of kilometers or tens of kilometers, one can quite as easily argue for very large numbers of such planetoids."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "95858837-ab67-3e83-bed2-75e84e0a8e66",
                                        "entry_id": "a8b282b6-e0ca-38e0-9e4b-46f8e8978d4c",
                                        "glosses": [
                                            "An asteroid-like body in an orbit beyond the asteroid belt, such as a centaur or Kuiper belt object"
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fb4d82d7-cbb3-3694-b247-79374fee1971",
                                        "entry_id": "a8b282b6-e0ca-38e0-9e4b-46f8e8978d4c",
                                        "glosses": [
                                            "A larger, planetary, body in orbit around the Sun, such as Vesta or (candidate) dwarf planets such Eris or Sedna"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1cd1d5b6-4f7c-41b7-832e-b5c741cf1d6a",
                                                "sense_id": "fb4d82d7-cbb3-3694-b247-79374fee1971",
                                                "text": "After discovering \"planetoids\", bodies orbiting the Sun, even larger than Pluto's moon Charon ... the question of how Sedna and other planetoids came to be."
                                            },
                                            {
                                                "example_id": "e95ad7b4-6719-43a2-9f36-9bdd1aa67d37",
                                                "sense_id": "fb4d82d7-cbb3-3694-b247-79374fee1971",
                                                "text": "Eris [...] was the upstart planetoid that knocked Pluto off the planetary lists"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c398d720-f51a-368a-8859-e838243a0452",
                                        "entry_id": "a8b282b6-e0ca-38e0-9e4b-46f8e8978d4c",
                                        "glosses": [
                                            "Any planetary body, including classical planets and moons: a planetary-mass object"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "347d7ac8-0ac4-49c9-b914-cb568f9c0c17",
                                                "sense_id": "c398d720-f51a-368a-8859-e838243a0452",
                                                "text": "Plate tectonics is a style of convection for an active planetoid where lid fragment (plate) motions reflect sinking of dense lithosphere in subduction zones […] In 2015 humanity completed a 50+ year effort to survey the 30 largest planets, asteroids, satellites, and inner Kuiper Belt objects, which we informally call “planetoids”."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "76fbe27c-80d7-31c7-823d-001dda4152b1",
                                        "entry_id": "a8b282b6-e0ca-38e0-9e4b-46f8e8978d4c",
                                        "glosses": [
                                            "A dwarf planet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "826c9af5-2840-49af-bdd8-36cf88c3b141",
                                                "sense_id": "76fbe27c-80d7-31c7-823d-001dda4152b1",
                                                "text": "We prefer the word \"planetoid\" as a new word to describe round objects orbiting the sun."
                                            },
                                            {
                                                "example_id": "f3629c6b-f343-44af-b5bc-7f7cc43a7df6",
                                                "sense_id": "76fbe27c-80d7-31c7-823d-001dda4152b1",
                                                "text": "A dwarf planet or a planetoid is a celestial body that [...]"
                                            },
                                            {
                                                "example_id": "13ce1a8f-8514-4b7a-a18b-8d8de6a4f3db",
                                                "sense_id": "76fbe27c-80d7-31c7-823d-001dda4152b1",
                                                "text": "'Dwarf planet' is a dumb phrase. For years we've called things like Pluto and Xena 'planetoids'—planetlike."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e69934e2-4df9-4ccf-90ac-3ed002471ac9",
                        "source_entry_id": "1b332ad5-f9ea-398e-bbb6-50a6e61c60dd",
