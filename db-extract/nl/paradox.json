                ],
                "senses": [
                    {
                        "sense_id": "86940c93-10ea-3ab4-bffc-005427b8a785",
                        "entry_id": "f926ae70-fbd3-3fd3-a867-2f9dc474926e",
                        "glosses": [
                            "schijnbare tegenspraak"
                        ],
                        "tags": [],
