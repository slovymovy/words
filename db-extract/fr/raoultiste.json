                "senses": [
                    {
                        "sense_id": "8562c9de-b193-3d9a-9a02-4de13d10fed4",
                        "entry_id": "adfbdd64-1c99-39ce-85c8-0b18622ea42e",
                        "glosses": [
                            "Partisan de Didier Raoult et particulièrement de son protocole thérapeutique sur la Covid-19."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "16ca55f1-7f29-492b-92d7-fb200f686a9e",
                                "sense_id": "8562c9de-b193-3d9a-9a02-4de13d10fed4",
                                "text": "Il n’en fallait pas plus pour encourager Raoult et les raoultistes à entrer en résistance. Bravant le confinement dicté par un Etat français failli, le professeur propose à tous les malades qui se massent devant l’IHU de Marseille de leur administrer son antidote."
                            },
                            {
                                "example_id": "b287d71e-9ac6-4306-8e05-e1e162137ad9",
                                "sense_id": "8562c9de-b193-3d9a-9a02-4de13d10fed4",
                                "text": "Renaud Muselier, “raoultiste” convaincu, ne désarme pas pour défendre son “nobélisable” ami de plus de trente ans."
                            },
                            {
                                "example_id": "6b330333-8e34-4bc1-82dc-814c0dc454c4",
                                "sense_id": "8562c9de-b193-3d9a-9a02-4de13d10fed4",
                                "text": "Vous me décevez. Vous encensez Lancet et NEJM parce qu'ils sont critiqués par les raoultistes. C'est quand même assez curieux. Vous confondez les procédures éditoriales et l'éthique médicale."
                            }
                        ]
                    }
