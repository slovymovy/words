                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "036e98a8-a311-4017-bced-3d4d3c399364",
                                "sense_id": "6de59ee0-ca84-3d7a-a555-67e6ff866896",
                                "text": "Si l'on y tient vraiment, il est toujours loisible de le bataviser..."
                            },
                            {
                                "example_id": "494b35c0-d9d8-46bd-a0b8-6f2273d84713",
                                "sense_id": "6de59ee0-ca84-3d7a-a555-67e6ff866896",
                                "text": "Comparer mon stage initiatique à une simple beuverie orgiaque est attentatoire au respect dont mérite mon maître, Jackie Chan Von Pelt (un Chinois expatrié aux Pays-Bas suite à la répression communiste de la révolte de 1989 et qui a voulu, afin de mieux s'intégrer, bataviser son nom ; sa couleur de peau l'a trahi...)."
                            },
                            {
                                "example_id": "c6ce7a18-c5f3-4e45-9895-1c9fbbbf0496",
                                "sense_id": "6de59ee0-ca84-3d7a-a555-67e6ff866896",
                                "text": "L'Etat batavisé additionne les trahisons."
