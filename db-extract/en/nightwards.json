                        "glosses": [
                            "Toward night."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "24b3386b-5b49-4759-8ba5-a5cbe3f352f1",
                                "sense_id": "7ff0866f-2ed6-3d0b-9946-833b0cb68dff",
                                "text": "The world is swinging nightwards; ’tis October,\nAnd twilight’s on the heights;\nThe Bluffs, like silent sentries gray and sober,\nStand lonely in the fading evening lights."
                            },
                            {
                                "example_id": "34155d69-de1d-4788-b950-1d9b2b6a7fcd",
                                "sense_id": "7ff0866f-2ed6-3d0b-9946-833b0cb68dff",
                                "text": "Even the call, which grew stronger the further nightwards she walked, and the press of earthwarmth it brought with it, even that was a compromise she wasn’t entirely comfortable with. And yet she couldn’t fight it. She couldn’t shut it out like she could the urge to reach, so she knew she’d have to learn to accept it. Perhaps in time she’d even be able to draw strength from it again. She took a small drink from her water-skin, which was still half full, thanks to careful rationing."
                            }
                        ]
                    }
