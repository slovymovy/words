    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "68c09c73-bb0e-3e54-8ee5-94b6b3dcb3a7",
                "word": "Eunice",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "60020682-57ee-3447-8d1b-8274b4b2efe7",
                        "entry_id": "68c09c73-bb0e-3e54-8ee5-94b6b3dcb3a7",
                        "glosses": [
                            "A female given name from Ancient Greek."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6733d5a1-b07f-4e43-bac3-5c3d9a73b28e",
                                "sense_id": "60020682-57ee-3447-8d1b-8274b4b2efe7",
                                "text": "When I call to remembrance the unfeigned faith that is in thee, which dwelt first in thy grandmother Lois, and thy mother Eunice; and I am persuaded that in thee also."
                            },
                            {
                                "example_id": "e395981e-8017-49d7-a5f3-bd89df857cd5",
                                "sense_id": "60020682-57ee-3447-8d1b-8274b4b2efe7",
                                "text": "\"Eunice,\" he said consideringly.\nShe paused in the midst of licking a dab of frosting off one finger.\n\"Properly speaking,\" he said, \"it should be 'You-nike-ee'. That's the way Greeks would have said it.\"\n\"You-niss is bad enough,\" she told him. \"I've always hated my name.\"\n\"Oh, it's a fine name. It means 'victorious'.\""
                            }
                        ]
                    },
