                    "frequency": "Middle",
                    "semantic_group_id": "lieu",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les vaches passent tout l'été dans un grand <w>pâturage</w> verdoyant au pied des montagnes."
                        },
                        {
                            "text": "Le berger rassemble ses moutons pour les ramener du <w>pâturage</w> avant la tombée de la nuit."
                        }
                    ],
                    "synonyms": [
