                ],
                "senses": [
                    {
                        "sense_id": "847e12aa-d400-3f70-a00b-af5caf573234",
                        "entry_id": "99ccec36-d0cf-327f-b9c5-43913969baf8",
                        "glosses": [
                            "Celle qui fait, qui concourt à un résultat."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f630f39-fdd1-4eaf-a90f-065c2a78df5d",
                                "sense_id": "847e12aa-d400-3f70-a00b-af5caf573234",
                                "text": "L’instinct naturel des peuples va droit au nécessaire et néglige l’accessoire ; il demande avant tout l’autorité créatrice d’ordre, factrice de prospérité."
                            }
                        ]
                    },
                    {
                        "sense_id": "968127a2-8e8a-35b4-9208-4e621d16c376",
                        "entry_id": "99ccec36-d0cf-327f-b9c5-43913969baf8",
                        "glosses": [
                            "Femme qui fabrique des instruments de musique autres que les instruments de la famille du luth et les instruments de la famille du violon."
                        ],
                        "tags": [
                            "Métier"
                        ],
                        "examples": [
                            {
                                "example_id": "bacbc41b-dc7a-4654-acb7-c0237dcf9b2c",
                                "sense_id": "968127a2-8e8a-35b4-9208-4e621d16c376",
                                "text": "En cette année de célébration du 250e anniversaire de Beethoven, on entend beaucoup de noms d’artistes et de personnalités ayant compté dans la constellation du compositeur, mais pas, ou trop peu, celui de Nannette Streicher, l’une des grandes factrices de piano de la Vienne du début du 19e siècle."
                            }
                        ]
                    },
                    {
                        "sense_id": "91e59d75-05ae-3cde-90ce-8184a381a86e",
                        "entry_id": "99ccec36-d0cf-327f-b9c5-43913969baf8",
                        "glosses": [
                            "Fonctionnaire chargée de distribuer, de remettre à leurs destinataires les lettres, objets et valeurs expédiés par la poste."
                        ],
                        "tags": [
                            "Métier",
                            "Poste"
                        ],
                        "examples": [
                            {
                                "example_id": "9f627461-386b-41c5-ac76-ff34e8be252a",
                                "sense_id": "91e59d75-05ae-3cde-90ce-8184a381a86e",
                                "text": "Par sa bonne conduite, mon père avait obtenu une place à la Messagerie de Lyon ; il y était facteur ; ma mère y était factrice."
                            },
                            {
                                "example_id": "a76e4dc9-8134-431d-8c2f-3433b7edeaa0",
                                "sense_id": "91e59d75-05ae-3cde-90ce-8184a381a86e",
                                "text": "Dans ton petit village, cependant, tu avais une factrice, féminin de facteur, employé postal chargé de la distribution du courrier."
                            },
                            {
                                "example_id": "f97b225a-5ecb-4ed0-8580-fb1c7a9993f6",
                                "sense_id": "91e59d75-05ae-3cde-90ce-8184a381a86e",
                                "text": "Kayla Berridge est factrice dans une petite ville du New Hampshire aux États-Unis."
                            }
                        ]
                    },
                    {
                        "sense_id": "6979f24c-19a6-300e-8a3a-ea33c3f7d224",
                        "entry_id": "99ccec36-d0cf-327f-b9c5-43913969baf8",
                        "glosses": [
                            "Employée qui, dans une gare de chemin de fer ou dans une entreprise de messagerie, charge, décharge, porte à leur destination les colis."
                        ],
                        "tags": [
                            "Métier"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "31b32e20-3341-3167-b68c-ccfa5fcc790a",
                        "entry_id": "99ccec36-d0cf-327f-b9c5-43913969baf8",
                        "glosses": [
                            "Celle qui est chargée de la vente en gros à la criée des denrées apportées aux halles."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "82fa97cc-5504-43ed-ab58-07b06db32087",
                                "sense_id": "31b32e20-3341-3167-b68c-ccfa5fcc790a",
                                "text": "Madame est là dès le matin, elle est Factrice aux halles et gagne à ce métier douze mille francs par an, dit-on."
                            }
                        ]
                    },
                    {
                        "sense_id": "bb9383a7-1d00-30ba-9d60-b5e117139c3e",
                        "entry_id": "99ccec36-d0cf-327f-b9c5-43913969baf8",
                        "glosses": [
                            "Celle qui agit pour le compte d’autrui dans un trafic, dans un négoce."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "a7f40cee-a43f-4edb-8a2c-2de916da4807",
                                "sense_id": "bb9383a7-1d00-30ba-9d60-b5e117139c3e",
                                "text": "La femme ne peut pas non plus obliger la communauté par aucune emplette ou emprunt, si ce n’est lorsqu’elle est factrice de son mari, ou qu’au vû & au sçu de son mari elle fait un commerce séparé, auquel cas elle oblige son mari & la communauté."
                            }
                        ]
                    }
                ],
