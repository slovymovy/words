                        "examples": [
                            {
                                "example_id": "4d5c1e24-eeb1-4551-95bc-db17b239b597",
                                "sense_id": "4c84d350-3775-367d-89ca-b57cd0473c7a",
                                "text": "Afgelopen seizoen ontving Limbombe de Ebbenhouten Schoen, de trofee die jaarlijks wordt uitgereikt aan de beste speler van Afrikaanse afkomst in de Belgische hoogste klasse."
                            },
                            {
                                "example_id": "7c5b241b-e076-47d7-b3fe-5de99ffc0ac6",
                                "sense_id": "4c84d350-3775-367d-89ca-b57cd0473c7a",
                                "text": "Omdat een deurkruk minder ingrijpend is dan een nieuwe deur, kun je daarmee best experimenteren, denkt zij. Er zijn bijvoorbeeld jaren 30-modellen, met mooie details en een ebbenhouten grip, of modellen die zich kenmerken door een robuuste vormgeving, die mooi past bij een industrieel interieur."
                            }
                        ]
                    }
