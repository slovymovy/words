                "senses": [
                    {
                        "sense_id": "22f5c9f0-fc22-3ddf-b120-26aea21e982f",
                        "entry_id": "acfc5d10-9fd8-3598-b646-1fdb7ca67d4d",
                        "glosses": [
                            "in Worten ausgedrückte Beleidigung, üble Nachrede"
                        ],
                        "tags": [
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "ec8e4d5c-dea9-4a98-bc80-ec213b9d401b",
                                "sense_id": "22f5c9f0-fc22-3ddf-b120-26aea21e982f",
                                "text": "„Unser Rhinoceros Sumatranus ist alles andere, nur kein Geistesathlet. Man fügt ihm wohl eine Verbalinjurie zu, trifft aber dennoch den Nagel auf den Kopf, wenn man es als ungewöhnlich stupid bezeichnet. Im allgemeinen ist es ein recht harmloses, friedliches Tier.“"
                            },
                            {
                                "example_id": "17f25b0e-8194-455a-9913-2a82b656c3f3",
                                "sense_id": "22f5c9f0-fc22-3ddf-b120-26aea21e982f",
                                "text": "„Es ist nichts Ungewohntes, daß im Bayerischen Wahlkampf harte Worte gefallen sind, die bis zu Verbalinjurien reichten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
