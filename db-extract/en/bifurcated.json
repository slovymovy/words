    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "e3b87562-f393-34dd-ba3c-71bb8f205e7c",
                "word": "bifurcated",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "f1ec9972-ba3b-37d3-af37-7ebf4335f35e",
                        "entry_id": "e3b87562-f393-34dd-ba3c-71bb8f205e7c",
                        "glosses": [
                            "Divided into two branches."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "a837765e-15e4-4a30-b028-9e2ee014b6b4",
                                "sense_id": "f1ec9972-ba3b-37d3-af37-7ebf4335f35e",
                                "text": "Near-synonyms: bifid, bipartite, bilobar, bilobular, split, forked"
                            },
                            {
                                "example_id": "f164cbe8-abc7-47d0-9e79-c3c41885412e",
                                "sense_id": "f1ec9972-ba3b-37d3-af37-7ebf4335f35e",
                                "text": "Elizabeth's disturbing presentation of herself as both virginal and sexual bifurcated after her death into opinion about whether she was virginal or sexual, so that on the one hand Elizabeth was apotheosized as the saint who through her refusal to marry had kept England Protestant and free, while on the other hand she was still the object of detraction by persons such as “one Sheapheard, a barrister of Lincolns Inn, [and] a base Jesuited papist,” who during James I's reign uttered ”base and scandalous” words regarding the late queen's honor."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "120159b9-7bbd-429f-9333-24dfd54165d1",
                        "source_entry_id": "e3b87562-f393-34dd-ba3c-71bb8f205e7c",
                        "source_sense_id": "f1ec9972-ba3b-37d3-af37-7ebf4335f35e",
                        "source_sense_description": "Divided into two branches — see also bipartite",
                        "target_lang_word": "zweigeteilt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zweigeteilt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9840311e-4cfe-3785-974c-0d5ce757dbfd",
                                        "entry_id": "ce8f60f7-a3ba-3b45-97c9-86a91d873901",
                                        "glosses": [
                                            "in zwei Teile geteilt"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "24983545-2524-4b1b-89da-84e5767ac17e",
                                                "sense_id": "9840311e-4cfe-3785-974c-0d5ce757dbfd",
                                                "text": "Drück dich hinten gegen die Gitterstange, bis sie dich fast zweiteilt, du wirst den Grund nicht finden."
                                            },
                                            {
                                                "example_id": "240eb745-13b1-4aca-81ba-2e0fe867a440",
                                                "sense_id": "9840311e-4cfe-3785-974c-0d5ce757dbfd",
                                                "text": "Aristoteles geht davon aus, dass der Körper des Menschen, aber auch der meisten Tiere zweigeteilt ist."
                                            },
                                            {
                                                "example_id": "c764da11-63dc-4e46-882e-a2d70fe0531c",
                                                "sense_id": "9840311e-4cfe-3785-974c-0d5ce757dbfd",
                                                "text": "Thomas Mann wollte das zweigeteilte Deutschland als solches nicht gutheißen, seine Ein-Deutschland-Idee ließ das nicht zu."
                                            },
                                            {
                                                "example_id": "f0b2f640-f66c-4af9-a47c-6776507f0141",
                                                "sense_id": "9840311e-4cfe-3785-974c-0d5ce757dbfd",
                                                "text": "Zu den relativ häufigen Fehlbildungen der Gebärmutter gehören die unterteilte oder zweigeteilte Gebärmutter und die einseitige (nur zu einem Eileiter/Eierstock reichende) Gebärmutter."
                                            },
                                            {
                                                "example_id": "c830102a-5f3d-4acd-b281-c4fa520f8c7d",
                                                "sense_id": "9840311e-4cfe-3785-974c-0d5ce757dbfd",
                                                "text": "Deren Hütte war zweigeteilt, weil sie Auguste unter demselben Dache haben, aber nicht im gleichen Raum mit ihr schlafen wollte."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
