                                        "entry_id": "9c5922f0-3156-3bf5-a708-0becd10bad34",
                                        "glosses": [
                                            "Lack of care; the state or quality of being careless."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "85f118fc-1bea-4103-a803-4d6c11bfa708",
                                                "sense_id": "c7ffb173-b3be-3f09-9b1d-991540e3e154",
                                                "text": "This accident was caused by carelessness."
                                            },
                                            {
                                                "example_id": "b499bc2f-2998-4cf9-882e-a837f25310de",
                                                "sense_id": "c7ffb173-b3be-3f09-9b1d-991540e3e154",
                                                "text": "There were, however, 34 deaths among passengers in movement accidents, due mainly to misadventure and carelessness when entering and leaving trains in motion, falling off platforms and out of carriages, and opening and closing carriage doors."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "29513423-d3dd-4718-a25a-69cd74932d6e",
                        "source_entry_id": "196fb75f-714c-3048-bd5b-da5bb64e660b",
                        "source_sense_id": "1f8ee0c5-3f9d-3136-892a-ac393728c776",
                        "source_sense_description": "een gedraging die gemakkelijk tot ongelukken kan leiden",
                        "target_lang_word": "imprudence",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "imprudence",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8fd651dd-e371-3279-953b-f18c4c5deb83",
                                        "entry_id": "dab64d31-d1cd-31f8-aa5b-5b6a72068920",
                                        "glosses": [
                                            "Défaut de prudence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f702b13-405e-4403-9595-f4667a2d9b18",
                                                "sense_id": "8fd651dd-e371-3279-953b-f18c4c5deb83",
                                                "text": "Il s’est conduit en cela avec une grande imprudence, avec une extrême imprudence."
                                            },
                                            {
                                                "example_id": "5b316fc8-9620-4c45-a3d6-f8b9f4de05a7",
                                                "sense_id": "8fd651dd-e371-3279-953b-f18c4c5deb83",
                                                "text": "Il y a bien de l’imprudence à se conduire ainsi."
                                            },
                                            {
                                                "example_id": "75fdecf6-c14a-4469-8df7-4a6830fdc26a",
                                                "sense_id": "8fd651dd-e371-3279-953b-f18c4c5deb83",
                                                "text": "Un moment d’imprudence peut tout perdre."
                                            },
                                            {
                                                "example_id": "decca1c9-b56e-41bb-b79d-f949c88a2667",
                                                "sense_id": "8fd651dd-e371-3279-953b-f18c4c5deb83",
                                                "text": "Quelle imprudence !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "637d5895-3ddb-3031-a54c-d740a8d28947",
                                        "entry_id": "dab64d31-d1cd-31f8-aa5b-5b6a72068920",
                                        "glosses": [
                                            "Action ou parole imprudentes."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b749f944-73dd-464e-8450-5e53760c12dd",
                                                "sense_id": "637d5895-3ddb-3031-a54c-d740a8d28947",
                                                "text": "Il a commis une légère imprudence."
                                            },
                                            {
                                                "example_id": "eba40f5e-daa2-40bf-a76e-29d2ea17e0ba",
                                                "sense_id": "637d5895-3ddb-3031-a54c-d740a8d28947",
                                                "text": "Il fait souvent des imprudences."
                                            },
                                            {
                                                "example_id": "070d7ee1-93ed-4eba-aeab-49dbe06b5633",
                                                "sense_id": "637d5895-3ddb-3031-a54c-d740a8d28947",
                                                "text": "Ne pas sourire avec respect au seul nom de M. le préfet passe, aux yeux des paysans de Franche-Comté, pour une imprudence : or, l'imprudence chez le pauvre est rapidement punie par le manque de pain."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
