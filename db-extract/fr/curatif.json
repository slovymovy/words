                    },
                    {
                        "form_id": "4e2c207a-c3bb-4d98-83b8-0e2c6e8d77b7",
                        "entry_id": "4443f4bc-3633-3362-87e9-14c3b68595e3",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "curatives"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "572921bc-81d4-3dd9-9e7b-61f862167227",
                        "entry_id": "4443f4bc-3633-3362-87e9-14c3b68595e3",
                        "glosses": [
                            "Qui est propre à la cure, à la guérison d’une maladie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da0b9f4e-07cc-4711-8f80-8c0fbe7574ef",
                                "sense_id": "572921bc-81d4-3dd9-9e7b-61f862167227",
                                "text": "L’emploi des chocolatines au tannate de quinine (modèle de Celli) a marqué une amélioration notable dans les techniques du service antipaludique algérien pour le traitement préventif ou curatif des jeunes enfants."
                            },
                            {
                                "example_id": "149e1da9-db72-4f0f-a509-69798d904126",
                                "sense_id": "572921bc-81d4-3dd9-9e7b-61f862167227",
                                "text": "Paradoxalement, il est recommandé d’anticoaguler à dose curative afin d’éviter la formation de thrombus intracarotidien [20, 21]."
                            },
                            {
                                "example_id": "8afc4c36-8829-4e04-a7c3-078457d0429f",
                                "sense_id": "572921bc-81d4-3dd9-9e7b-61f862167227",
                                "text": "Qui n’a même reconnu un vestige des anciens cultes païens dans ces libations faites à des fontaines sacrées que leurs propriétés curatives ont rendues célèbres ?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cbbaf711-ad80-476a-be5a-0cb62be15250",
                        "source_entry_id": "4443f4bc-3633-3362-87e9-14c3b68595e3",
                        "source_sense_id": "572921bc-81d4-3dd9-9e7b-61f862167227",
                        "target_lang_word": "curative",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "curative",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e7b77de1-c0c4-34d7-b1e1-11c7eb82b462",
                                        "entry_id": "c44b6d63-827e-3161-bb01-217f4baca810",
                                        "glosses": [
                                            "Possessing the ability to cure, to heal or treat illness."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a5aa2290-dfcd-4e8a-9921-7a8c3c9ec218",
                                                "sense_id": "e7b77de1-c0c4-34d7-b1e1-11c7eb82b462",
                                                "text": "The curative power of the antibiotics introduced in the 1950s was amazing at the time."
                                            },
                                            {
                                                "example_id": "c49a516f-e163-487b-96bc-43b016fdea32",
                                                "sense_id": "e7b77de1-c0c4-34d7-b1e1-11c7eb82b462",
                                                "text": "Making this request is not considered a curative measure but only for preventive purposes, as the Rambam rights, \"A healthy man may read scriptural passages and psalms in order to merit of this reading and be with him and protect him from danger and hurtful influences.\""
                                            },
                                            {
                                                "example_id": "18b995a1-c6cd-4219-949d-0f4dd3f0d887",
                                                "sense_id": "e7b77de1-c0c4-34d7-b1e1-11c7eb82b462",
                                                "text": "He was just as interested in preventive care as he was in curative measures."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d5bd5bff-673f-3d0a-b0c7-97701fd11279",
                                        "entry_id": "c44b6d63-827e-3161-bb01-217f4baca810",
                                        "glosses": [
                                            "Remediative."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a25b5f43-bc30-489d-bbaf-4c55900d67f9",
                                                "sense_id": "d5bd5bff-673f-3d0a-b0c7-97701fd11279",
                                                "text": "a curative jury instruction to disregard the sheriff's testimony"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "curative",
                                "target_lang_code": "en",
                                "target_senses": [
