                        "glosses": [
                            "книжн. вызывать (вызвать) что-либо внушением, подстрекательством, наущением"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a493a6b9-7973-49e7-9688-f0fb8136e135",
                                "sense_id": "0ea1c65a-f613-3354-ac34-1421a4ee2768",
                                "text": "Инспирировать беспорядки."
                            }
                        ]
                    },
                    {
                        "sense_id": "76ae392f-322d-3dd4-b5bb-c80e8850c74b",
                        "entry_id": "8a7c2697-4ebb-38ed-8ea7-220aa2c67eca",
                        "glosses": [
                            "книжн. внушать (внушить) кому-либо какой-либо образ действий, мыслей"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0e82c13-39b5-4dcb-a6d5-c7d28e85f724",
                                "sense_id": "76ae392f-322d-3dd4-b5bb-c80e8850c74b",
