                        "translation_id": "96531dcc-30be-49da-8b35-ffbecd0c5353",
                        "source_entry_id": "efe74ece-0c65-3bef-8d1c-d3673b72874f",
                        "source_sense_description": "one who conserves, preserves or protects something",
