                                ]
                            },
                            {
                                "target_word": "underhand",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cc1d694e-a270-3a39-bbb2-d19e11d944e9",
                                        "entry_id": "9a1fa54e-8022-34b1-a39e-801487d1f50e",
                                        "glosses": [
                                            "To toss or lob with an underhand movement."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b1ab385e-0a8a-4aea-ad1e-1d50bbaa8707",
                                                "sense_id": "cc1d694e-a270-3a39-bbb2-d19e11d944e9",
                                                "text": "Couture made straight for the refrigerator and returned with cold beer, underhanding them in turn to each of the team members, Sergeant Thi included."
                                            },
                                            {
                                                "example_id": "389fee08-0239-4c42-bdcd-ea428b33005f",
                                                "sense_id": "cc1d694e-a270-3a39-bbb2-d19e11d944e9",
                                                "text": "Michael underhanded his half-dozen sticks into the audience as the stage lights went dark and house lights came up at the rear of the auditorium."
                                            },
                                            {
                                                "example_id": "c97cba9f-5a5b-4e4e-b551-b75199871c89",
                                                "sense_id": "cc1d694e-a270-3a39-bbb2-d19e11d944e9",
                                                "text": "In that era, a pitcher's job was to initiate play by underhanding the ball to the batter in a way that would prevent hard hits but not necessarily in hopes of a strikeout."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "382a2788-2f0c-3808-9465-d6f49d0eaf26",
                                        "entry_id": "9a1fa54e-8022-34b1-a39e-801487d1f50e",
                                        "glosses": [
                                            "To trick, deceive or gull."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fc274143-7ae3-4498-9268-cd34118f9a6c",
                                                "sense_id": "382a2788-2f0c-3808-9465-d6f49d0eaf26",
                                                "text": "The time has arrived when monkeying with the public must cease, when lying and underhanding your competitor in the baking business must be banished from the plan of business development."
                                            },
                                            {
                                                "example_id": "d2c85a64-fe51-432e-9fbf-0000374fc60f",
                                                "sense_id": "382a2788-2f0c-3808-9465-d6f49d0eaf26",
                                                "text": "The other was that the majority of the purchasing contracts represented “good deals” because suppliers would not wish to be caught underhanding this company due to its size and influence in the market."
                                            },
                                            {
                                                "example_id": "7c9e7fd7-bbd9-4eda-ac14-5cff3e055fa9",
                                                "sense_id": "382a2788-2f0c-3808-9465-d6f49d0eaf26",
                                                "text": "Many have been underhanded by fate and occasionally made to ask, like I once did, if there is a God, and if there is, how could they experience His power."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9bea9af4-16e6-3499-b34a-9ef08f823d5f",
                                        "entry_id": "9a1fa54e-8022-34b1-a39e-801487d1f50e",
                                        "glosses": [
                                            "To excavate downward in successive steps or horizontal slices while positioned above on unbroken ore."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f25c2c4b-3e35-496f-8bf7-61e52bd0f87e",
                                                "sense_id": "9bea9af4-16e6-3499-b34a-9ef08f823d5f",
                                                "text": "About one-half the body has been mined by underhanding into mill holes; but with the adoption of the water drill, shrinkage stoping is being largely used and the larger stopes are mined as at Levack."
                                            },
                                            {
                                                "example_id": "cc709097-7c56-4cca-9aa2-5d081d63e70e",
                                                "sense_id": "9bea9af4-16e6-3499-b34a-9ef08f823d5f",
                                                "text": "The floors are then extracted by underhanding, and finally the pillars at the levels are trimmed to the minimum size necessary to support the walls."
                                            },
                                            {
                                                "example_id": "e07d6eaf-42a9-45ca-ab0a-68ec2ef12cda",
                                                "sense_id": "9bea9af4-16e6-3499-b34a-9ef08f823d5f",
                                                "text": "This method is used only in a one-set panel mined from level to level by underhanding into the chute at the foot- wall end of the previous panel."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "underhand",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2aaf84a7-0374-39f4-aea3-351627ac1488",
                                        "entry_id": "974bb635-8d67-388b-954c-89c76a690416",
                                        "glosses": [
                                            "The lower of two hands, the hand under the work."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "67abf656-e842-48af-962a-a2268165bf07",
                                                "sense_id": "2aaf84a7-0374-39f4-aea3-351627ac1488",
                                                "text": "Your underhand should be entirely under the quilt."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "444f3b8f-b337-467a-b822-b199d257e848",
                        "source_entry_id": "ce65e70c-c3cd-3cfa-b72b-04b91ceda634",
                        "source_sense_id": "86646c1b-f922-3c8d-805b-c18227b7ed5e",
                        "target_lang_word": "unaufrichtig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unaufrichtig",
