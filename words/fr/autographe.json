    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f84d0846-c3de-3b68-bca4-e313e36849fd",
                    "sense_definition": "Signature ou dédicace manuscrite d'une personnalité connue, généralement demandée en souvenir par un admirateur.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "signature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après le concert, le chanteur a pris le temps de signer des <w>autographes</w> pour ses admirateurs."
                        },
                        {
                            "text": "Elle s'est avancée timidement vers l'acteur pour lui demander un <w>autographe</w> dans son carnet."
                        }
                    ],
                    "synonyms": [
                        "dédicace",
                        "signature"
                    ],
                    "common_phrases": [
                        "demander un autographe",
                        "signer des autographes",
                        "séance d'autographes"
                    ]
                },
                {
                    "sense_id": "6455512b-4cdc-30c9-b537-a99df22436d6",
                    "sense_definition": "Document ou texte manuscrit rédigé de la main même de son auteur.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "manuscrit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La bibliothèque municipale conserve un précieux <w>autographe</w> du célèbre poète du dix-neuvième siècle."
                        },
                        {
                            "text": "Cet <w>autographe</w> historique a été adjugé à un prix record lors de la vente aux enchères."
                        }
                    ],
                    "synonyms": [
                        "manuscrit",
                        "holographe"
                    ],
                    "antonyms": [
                        "apographe"
                    ],
                    "common_phrases": [
                        "collectionneur d'autographes"
                    ]
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "acd2fd13-e9b7-3e8f-b1ca-1892429e4311",
                    "sense_definition": "Qui est écrit directement de la propre main de l'auteur.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "manuscrit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'historien a découvert une lettre <w>autographe</w> envoyée autrefois par le général à son état-major."
                        },
                        {
                            "text": "Un testament <w>autographe</w> présente une valeur juridique majeure lorsqu'il est authentifié par des experts."
                        }
                    ],
                    "synonyms": [
                        "manuscrit",
                        "holographe"
                    ],
                    "antonyms": [
                        "apographe"
                    ],
                    "common_phrases": [
                        "lettre autographe",
                        "testament autographe"
                    ]
                }
            ]
        }
    ]
