                        "tags": [],
                        "examples": [
                            {
                                "example_id": "22eea2a3-ece5-4da5-881f-4836ea02690c",
                                "sense_id": "480cc03b-1a13-3c8b-8fdc-0ea4337ae945",
                                "text": "C’est donc l’œnophile qu’on verra dans une œnothèque, lieu de dégustation et de vente de vin."
                            }
                        ]
                    }
                ],
