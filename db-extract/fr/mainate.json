                "entry_id": "983ce5ea-57d3-30b4-81dd-9f33b2e533fc",
                "word": "mainate",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "4d900abf-fa76-45e7-8578-5d189a101ca4",
                        "entry_id": "983ce5ea-57d3-30b4-81dd-9f33b2e533fc",
                        "tags": [
                            "plural"
                        ],
                        "form": "mainates"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "200f6db2-38e8-391c-be32-633c605d45d9",
                        "entry_id": "983ce5ea-57d3-30b4-81dd-9f33b2e533fc",
                        "glosses": [
                            "Espèce d’oiseau passereau conirostre habitant la Malaisie, de la famille des sturnidés."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "09787513-2e1a-40bb-9e21-90491d8ec3cd",
                                "sense_id": "200f6db2-38e8-391c-be32-633c605d45d9",
                                "text": "Avant d’entrer dans le détail de ces variétés, je dois ajouter que le mainate a beaucoup de talent pour siffler, pour chanter et pour parler, qu’il a même la prononciation plus franche que le perroquet, nommé l’oiseau parleur par excellence, et qu’il se plaît à exercer son talent jusqu'à l’importunité."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d0dc6917-bdc3-45c9-bb02-74d2d02d8c91",
                        "source_entry_id": "983ce5ea-57d3-30b4-81dd-9f33b2e533fc",
                        "source_sense_id": "200f6db2-38e8-391c-be32-633c605d45d9",
                        "source_sense_description": "espèce d’oiseau",
                        "target_lang_word": "Beo",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Beo",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "488851db-65ca-336b-b5d6-7cdb67b990f6",
                                        "entry_id": "e03efa7e-6c8a-3159-a14b-394f682117a2",
                                        "glosses": [
                                            "ein Vogel, der wie ein Rabe aussieht und sehr gut Sprachlaute nachahmen kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6265f73b-ac44-4e3b-8f54-07f818031248",
                                                "sense_id": "488851db-65ca-336b-b5d6-7cdb67b990f6",
                                                "text": "Beos sind in Südostasien zu Hause."
                                            },
                                            {
                                                "example_id": "fd23b5ce-16bd-4901-b890-78df4571dbaa",
                                                "sense_id": "488851db-65ca-336b-b5d6-7cdb67b990f6",
                                                "text": "Der Beo kann bis zu 20 Jahre alt werden."
                                            },
                                            {
                                                "example_id": "969381c1-6a4a-44ef-81a7-8f900d308085",
                                                "sense_id": "488851db-65ca-336b-b5d6-7cdb67b990f6",
                                                "text": "Beos können viele Geräusche nachahmen und sogar ganze Sätze sprechen."
                                            },
                                            {
                                                "example_id": "0e497bf6-4cef-4c76-880e-1ed3f7f85784",
                                                "sense_id": "488851db-65ca-336b-b5d6-7cdb67b990f6",
                                                "text": "„Beos fressen hauptsächlich Waldfrüchte und -beeren und sind wild auf bestimmte Wildfeigensorten.“"
                                            },
                                            {
                                                "example_id": "aceca124-9d21-4df0-a613-add45fcf762c",
                                                "sense_id": "488851db-65ca-336b-b5d6-7cdb67b990f6",
                                                "text": "„Als äußerst gesellige Tiere versammeln sich Beos tagsüber in Gruppen von fünf bis zehn Vögeln, ständig miteinander rufend und schwatzend.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ad2ffa11-7434-464e-b5f8-cda0c101057f",
                        "source_entry_id": "983ce5ea-57d3-30b4-81dd-9f33b2e533fc",
