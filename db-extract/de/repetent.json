                ],
                "senses": [
                    {
                        "sense_id": "481252f9-a264-3d6f-8211-37703f0bfb63",
                        "entry_id": "a0477bed-9996-3b19-b2e4-c19e616f982e",
                        "glosses": [
                            "Wiederholer einer Schulstufe oder Prüfung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9376f3d-f328-4212-96ed-27ea2cf45b1a",
                                "sense_id": "481252f9-a264-3d6f-8211-37703f0bfb63",
                                "text": "„Andererseits befürchten sie auch, dass durch die modulare Oberstufe zwar die Zahl der Repetenten sinken, im Gegensatz aber jene der Drop-outs steigen werde.“"
                            },
                            {
                                "example_id": "dcf97e49-3039-45bc-b3ad-9de722831a43",
                                "sense_id": "481252f9-a264-3d6f-8211-37703f0bfb63",
                                "text": "„Gefordert wird außerdem eine Prognose, ab wann die Maßnahmen wirken werden und wie stark sie die Zahl der Repetenten verringern könnten.“"
                            },
                            {
                                "example_id": "ade46292-2675-42be-bef1-6404704672cf",
                                "sense_id": "481252f9-a264-3d6f-8211-37703f0bfb63",
                                "text": "„Ähnliche Ergebnisse für Österreich hat kürzlich eine Erhebung der Statistik Austria gezeigt, wonach viele der jährlich rund 27.000 heimischen Repetenten auch beim Wiederholen einer Klasse nicht erfolgreich sind.“"
                            },
                            {
                                "example_id": "ee68550c-b52e-4510-a403-056f59ff8ccb",
                                "sense_id": "481252f9-a264-3d6f-8211-37703f0bfb63",
                                "text": "„Zwei Drittel der Repetenten sind Buben, in der Real- und Oberschule bilden die Jungen eine Mehrheit von 70 Prozent.“"
                            },
                            {
                                "example_id": "e0fb00ab-503e-411f-9934-bb849d6fd17c",
                                "sense_id": "481252f9-a264-3d6f-8211-37703f0bfb63",
                                "text": "„Andererseits erhalten Repetentinnen und Repetenten, die den Textteil bereits besitzen, nur mehr den Arbeitsteil.“"
                            },
                            {
                                "example_id": "e5467d7a-8c29-4025-8583-7a079eace875",
                                "sense_id": "481252f9-a264-3d6f-8211-37703f0bfb63",
                                "text": "„Repetenten: Studierende, welche die Modulprüfung nicht bestanden haben, haben folgende 2 Möglichkeiten: …“"
                            },
                            {
                                "example_id": "f761fcf1-29be-4e30-8e61-d3ba19034674",
                                "sense_id": "481252f9-a264-3d6f-8211-37703f0bfb63",
                                "text": "„Das Gruppencoaching bietet Repetenten fachliche Beratung, psychologische Unterstützung und den hilfreichen Erfahrungsaustausch mit anderen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "86a42933-c7d0-3442-bd29-13b3d07566a5",
                        "entry_id": "a0477bed-9996-3b19-b2e4-c19e616f982e",
                        "glosses": [
                            "Lehrkraft, die Unterricht zur Wiederholung/Prüfungsvorbereitung erteilt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "67ea34e3-10d7-4d91-8d04-db2e54f0ff34",
                                "sense_id": "86a42933-c7d0-3442-bd29-13b3d07566a5",
                                "text": "„Der 1766 Geborene hatte als Repetent den Stiftsstudenten die theologische Orthodoxie nahe zu bringen, die er doch in eigenen Studien und Schriften aus dem Geiste Kants anzugreifen begann.“"
                            },
                            {
                                "example_id": "5357449b-8bea-4490-857e-5d714930ff15",
                                "sense_id": "86a42933-c7d0-3442-bd29-13b3d07566a5",
                                "text": "„Mahn […] lehrte zunächst ab 1809 als Repetent in der Theologischen Fakultät und erwarb sich mit der Magisterpromotion in der Philosophischen Fakultät 1812 die Venia dieser Fakultät.“"
                            },
                            {
                                "example_id": "4843a0ac-dd1d-4213-a17e-753cf63e59ce",
                                "sense_id": "86a42933-c7d0-3442-bd29-13b3d07566a5",
                                "text": "„[Anton Wilhelm Gustermann w]ar 8 Jahre Repetent des Professors des Staats- und Lehensrechts Heinrich von der Heyden an der Universität Wien, …“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
