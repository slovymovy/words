                ],
                "senses": [
                    {
                        "sense_id": "0f08865d-cdf4-36f2-b442-3bbf42bfdc43",
                        "entry_id": "c0fbc932-8652-3d74-951c-a80b42a808c6",
                        "glosses": [
                            "A trembling or shaking."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ec32de3-48a3-4ab5-bd48-f624e9ed1eb1",
                                "sense_id": "0f08865d-cdf4-36f2-b442-3bbf42bfdc43",
                                "text": "We felt a quake in the apartment every time the train went by."
                            }
                        ]
                    },
                    {
                        "sense_id": "64246f2a-46d1-3f95-be4c-3d5449831dcf",
                        "entry_id": "c0fbc932-8652-3d74-951c-a80b42a808c6",
                        "glosses": [
                            "An earthquake, a trembling of the ground with force."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a69271b-b440-4b90-80aa-c53e644be3c3",
                                "sense_id": "64246f2a-46d1-3f95-be4c-3d5449831dcf",
                                "text": "California is plagued by quakes; there are a few minor ones almost every month."
                            },
                            {
                                "example_id": "895b78bd-7766-4b2b-abdf-6e58471fecc0",
                                "sense_id": "64246f2a-46d1-3f95-be4c-3d5449831dcf",
                                "text": "Well, everybody talks about the California quakes\nBut the first time I ever felt the earth shake\nWas in Miami, when Amy touched me."
                            }
                        ]
                    },
                    {
                        "sense_id": "a15c0a30-d5fb-3d6a-8437-4badf4aab691",
                        "entry_id": "c0fbc932-8652-3d74-951c-a80b42a808c6",
                        "glosses": [
                            "Something devastating, like a strong earthquake."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "e0c55a12-f8df-4b0b-a33f-847a088bbf7f",
                                "sense_id": "a15c0a30-d5fb-3d6a-8437-4badf4aab691",
                                "text": "But HS1 was more exposed to the COVID quake than most given its inherent reliance on international travel, which had collapsed, leaving cross-Channel operator Eurostar stacked with millions of debt."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e4945813-9ef6-408b-89ed-2dc3bb75af74",
                        "source_entry_id": "c0fbc932-8652-3d74-951c-a80b42a808c6",
