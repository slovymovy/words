                "senses": [
                    {
                        "sense_id": "b8821f30-727a-3e5e-9dc0-d1898c50548e",
                        "entry_id": "a6983eb9-6e7a-3bd3-b72f-dd5aa11ddf73",
                        "glosses": [
                            "Gartenanlage, in der Schmetterlinge gehalten werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "baf2b921-0d7e-479e-8286-4790378f7eef",
                                "sense_id": "b8821f30-727a-3e5e-9dc0-d1898c50548e",
                                "text": "„Während Leland Babbitt im Freien in einem Schmetterlingsgarten nahe dem US-Kapitol auf einer Parkbank saß, auf die Armbanduhr starrte und sich fragte, wann dieser verdammte Denny Carmichael endlich auftauchte, saß dieser knapp neun Kilometer westlich davon in seinem CIA-Büro im siebten Stock, nippte an seinem Kaffee und las den morgendlichen Bericht der Violator Working Group durch.“"
                            },
                            {
                                "example_id": "a9d6906c-8233-4961-8ae3-242f5e7f9f6e",
                                "sense_id": "b8821f30-727a-3e5e-9dc0-d1898c50548e",
                                "text": "„›Butterfly World‹, fragte Cupido. ›Ja, dem Schmetterlingsgarten an der N1‹, erklärte sie.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
