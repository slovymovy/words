                    }
                ],
                "translations": [
                    {
                        "translation_id": "e1c89a25-362b-4674-8dce-1035aba933d7",
                        "source_entry_id": "521ff0ac-f31d-35d9-8170-36703040c1b4",
                        "target_lang_word": "resist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "resist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b8b7018f-f3c8-3cf1-a478-bea1e9a14138",
                                        "entry_id": "ee7c2d73-b151-3b41-aeb9-dffb7e20989b",
                                        "glosses": [
                                            "To attempt to counter the actions or effects of."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "501550cd-e7cc-4425-884b-ec7ab0b0e500",
                                                "sense_id": "b8b7018f-f3c8-3cf1-a478-bea1e9a14138",
                                                "text": "Shepard: You could have resisted. You could have fought! Instead, you surrendered. You quit."
                                            },
                                            {
                                                "example_id": "6c30f576-1cb3-4bc4-9083-b8d09c0e3eec",
                                                "sense_id": "b8b7018f-f3c8-3cf1-a478-bea1e9a14138",
                                                "text": "Seeing the British establishment struggle with the financial sector is like watching an alcoholic who still resists the idea that something drastic needs to happen for him to turn his life around."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0773fca0-a9aa-37e7-8004-95014568040a",
                                        "entry_id": "ee7c2d73-b151-3b41-aeb9-dffb7e20989b",
                                        "glosses": [
                                            "To withstand the actions of."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3fb9c5b0-f159-4a33-83ca-ccb0b7487205",
                                                "sense_id": "0773fca0-a9aa-37e7-8004-95014568040a",
                                                "text": "At length, one night, when the company by ſome accident broke up much ſooner than ordinary, ſo that the candles were not half burnt out, ſhe was not able to reſiſt the temptation, but reſolved to have them ſome way or other. Accordingly, as ſoon as the hurry was over, and the ſervants, as ſhe thought, all gone to ſleep, ſhe ſtole out of her bed, and went down ſtairs, naked to her ſhift as ſhe was, with a deſign to ſteal them […]"
                                            },
                                            {
                                                "example_id": "9eaa4126-56a3-4d9e-90a8-512289693aa0",
                                                "sense_id": "0773fca0-a9aa-37e7-8004-95014568040a",
                                                "text": "The preposterous altruism too![…]Resist not evil. It is an insane immolation of self—as bad intrinsically as fakirs stabbing themselves or anchorites warping their spines in caves scarcely large enough for a fair-sized dog."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ac3a7fae-0c95-328a-9642-f0897af221e0",
                                        "entry_id": "ee7c2d73-b151-3b41-aeb9-dffb7e20989b",
                                        "glosses": [
