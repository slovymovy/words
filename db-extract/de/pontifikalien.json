                "senses": [
                    {
                        "sense_id": "800e1c07-d455-3238-a5e6-f7b014b8d363",
                        "entry_id": "69e73d09-145d-3379-bfce-1e5c59140aa6",
                        "glosses": [
                            "die dem Bischof oder Würdenträgern mit eigener Jurisdiktion, das sind zum Beispiel Äbte, vorbehaltenen Insignien"
                        ],
                        "tags": [
                            "Katholische Kirche"
                        ],
                        "examples": [
                            {
                                "example_id": "7e34c702-3dff-4cd2-b8f7-47e86f644a06",
                                "sense_id": "800e1c07-d455-3238-a5e6-f7b014b8d363",
                                "text": "Die wichtigsten Pontifikalien für Bischöfe sind Mitra, Stab, Brustkreuz, Ring und Pileolus."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "325d023e-6a08-308d-a0f1-ee266bc543b1",
                        "entry_id": "69e73d09-145d-3379-bfce-1e5c59140aa6",
                        "glosses": [
                            "Amtshandlungen, bei denen die Insignien laut [1], insbesondere Mitra und Stab, benutzt werden"
                        ],
                        "tags": [
                            "Katholische Kirche"
                        ],
                        "examples": [
                            {
                                "example_id": "e8ad8793-f37a-405d-8ba1-355df03d5259",
                                "sense_id": "325d023e-6a08-308d-a0f1-ee266bc543b1",
                                "text": "Mit Pontifikalien bezeichnet man Amtshandlungen, bei denen der Bischof (oder der berechtigte Würdenträger) gemäß der liturgischen Vorschrift Mitra und Stab benutzt; Dies ist insbesondere bei Pontifikalämtern und Weihehandlungen der Fall."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
