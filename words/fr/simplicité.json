            "senses": [
                {
                    "sense_id": "37a71f43-a819-3c02-a011-05c997b66536",
                    "sense_definition": "Caractère de ce qui n'est pas compliqué, facile à comprendre ou à exécuter.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "facilite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les utilisateurs apprécient la <w>simplicité</w> de cette nouvelle application mobile."
                        },
                        {
                            "text": "Ce problème mathématique est pourtant d'une grande <w>simplicité</w> à résoudre."
                        }
                    ],
                    "synonyms": [
                        "facilité",
                        "clarté"
                    ],
                    "antonyms": [
                        "complexité",
                        "complication"
                    ],
                    "common_phrases": [
