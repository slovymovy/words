                ],
                "senses": [
                    {
                        "sense_id": "2a0dbc40-6c93-380d-b854-a49fd4c09ce4",
                        "entry_id": "f3f3c7f1-e4aa-36e3-acf6-e4c88cd8e534",
                        "glosses": [
                            "Laien-Seelsorger oder Diakon, der eine katholische Pfarrgemeinde ohne eigenen Priester betreut"
                        ],
                        "tags": [
                            "Austrian German"
                        ],
                        "examples": [
                            {
                                "example_id": "89151efa-915a-4041-adda-dc7a36c2da5e",
                                "sense_id": "2a0dbc40-6c93-380d-b854-a49fd4c09ce4",
                                "text": "„Das ›Silberne Verdienstzeichen des Landes Oberösterreich‹ erhielten neun Katholiken, unter anderem ein Pfarrassistent, der stellvertretende Referatsleiter im Kirchenbeitragsreferat der Diözesanfinanzkammer Linz sowie die Leiterin der Kirchenbeitragsstelle Braunau im Inn.“"
                            },
                            {
                                "example_id": "3e05b3a1-69fe-4876-8f38-d67097601b8a",
                                "sense_id": "2a0dbc40-6c93-380d-b854-a49fd4c09ce4",
                                "text": "„Dem Bezirk gehen langsam die Priester aus – Seelsorgeteams und Pfarrassistenten halten die Pfarren am Leben.“"
                            },
                            {
                                "example_id": "ece14e46-2398-4bde-8d7b-e8f850767b98",
                                "sense_id": "2a0dbc40-6c93-380d-b854-a49fd4c09ce4",
                                "text": "„Thomas Pree wird als Pfarrassistent die Geschicke der Pfarre leiten und die Nachfolge von Pfarrer Johann Fürst antreten.“"
                            },
                            {
                                "example_id": "17efd751-0bc7-4b59-a11a-dadb5d1488fb",
                                "sense_id": "2a0dbc40-6c93-380d-b854-a49fd4c09ce4",
                                "text": "„Pfarrassistent Christian Schober sprach im Namen der Pfarre einen besonderen Dank an die ehemalige Leiterin Katharina Stiegler aus, die neun Jahre lang mit viel Kreativität und unzähligen Veranstaltungen das Katholische Bildungswerk in St. Margarethen lebendig machte.“"
                            },
                            {
                                "example_id": "745712c6-19ac-4c76-8a92-8dbe4b61434f",
                                "sense_id": "2a0dbc40-6c93-380d-b854-a49fd4c09ce4",
                                "text": "„Der Priester kann und wird nicht mehr überall dabei sein, der Diakon und der Pfarrassistent als Ansprechpartner sind keine Notlösungen, sondern eigentlich der Normalfall im alltäglichen Pfarrleben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "26e3d756-b8fd-3b12-bb4a-55d458e1822e",
                        "entry_id": "f3f3c7f1-e4aa-36e3-acf6-e4c88cd8e534",
                        "glosses": [
                            "unterstützender Laien-Seelsorger in einer katholischen Pfarrgemeinde"
                        ],
                        "tags": [
                            "Belgien",
                            "Luxemburg"
                        ],
                        "examples": [
                            {
                                "example_id": "5843d513-1b3a-4026-bee3-837ed69063c4",
                                "sense_id": "26e3d756-b8fd-3b12-bb4a-55d458e1822e",
                                "text": "„Bischof Jousten bestätigte der Zeitung, es gehe um einen Konflikt mit dem Pfarrassistenten von Baelen.“"
                            },
                            {
                                "example_id": "c5407173-0e06-4718-a904-c1a68163856c",
                                "sense_id": "26e3d756-b8fd-3b12-bb4a-55d458e1822e",
                                "text": "„Unter den Mitgliedern sind Priester, Jugendseelsorger, Pfarrassistenten, Religionslehrer, Jugendleiter, Firmkatecheten, Vertreter von Pfarrverbänden und andere Aktive aus kirchlichen Gruppen.“"
                            },
                            {
                                "example_id": "6d50ee48-9ce9-47af-b9ef-9f227df204bc",
                                "sense_id": "26e3d756-b8fd-3b12-bb4a-55d458e1822e",
                                "text": "„Die Priester und die Pfarrassistenten sind selbstverständlich Mitglieder dieser Kontaktgruppe.“"
                            },
                            {
                                "example_id": "4fa0bd79-9383-4ca4-ab36-36c6180b8c9c",
                                "sense_id": "26e3d756-b8fd-3b12-bb4a-55d458e1822e",
                                "text": "„Priester, Diakone und Pfarrassistent(-inn)-en werden aufgefordert, mit ihren Nachbarn und engen Kollegen in Kontakt zu bleiben.“"
                            },
                            {
                                "example_id": "a9f0ca41-b91c-4e4b-b7e5-668d5b3950e6",
                                "sense_id": "26e3d756-b8fd-3b12-bb4a-55d458e1822e",
                                "text": "„In den letzten Wochen und Monaten waren neben Differenzen mit seinem Pfarrassistenten auch Gerüchte in Bezug auf seine Kontakte im Internet zu einem jungen Mädchen aufgekommen.“"
                            },
                            {
                                "example_id": "5bad4373-dd8e-40c3-b5db-23898cf2492d",
                                "sense_id": "26e3d756-b8fd-3b12-bb4a-55d458e1822e",
                                "text": "„Ein entsprechendes psychiatrisch-psychologisches Gutachten, welches Auskunft über die emotionale und sexuelle Reife des Kandidaten gibt, wird gefordert von den Priesteramtskandidaten, den Kandidaten für den ständigen Diakonat, den Kandidaten für den Dienst des/der Pastoralreferenten/in, des/der Pfarrassistenten/in und des/der Titularkatecheten/in.“"
                            },
                            {
                                "example_id": "6016d449-5600-4e73-b399-cb2256d4a79e",
                                "sense_id": "26e3d756-b8fd-3b12-bb4a-55d458e1822e",
                                "text": "„Vorbereitet wurde die Firmungsfeier von Pfarrassistent Änder Wolter.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "f150d933-73a8-35b9-8add-ca99e1501c45",
                        "entry_id": "f3f3c7f1-e4aa-36e3-acf6-e4c88cd8e534",
                        "glosses": [
                            "evangelischer Geistlicher, der in einer Pfarrgemeinde assistiert"
                        ],
                        "tags": [
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "635362a3-96ca-4c60-8071-1345ea7844ba",
                                "sense_id": "f150d933-73a8-35b9-8add-ca99e1501c45",
                                "text": "„Das Dienstalter wird von der Zeit an gerechnet, zu welcher der betreffende Geistliche in den Dienst der Hessischen evangelischen Kirche als Pfarrassistent, Pfarrvikar, Pfarrverwalter eingetreten oder mit Zustimmung des Oberconsistoriums als Lehrer verwendet worden ist.“"
                            },
                            {
                                "example_id": "6d035fa6-f282-4ae4-b4f4-2d15d1285081",
                                "sense_id": "f150d933-73a8-35b9-8add-ca99e1501c45",
                                "text": "„1937 trat er als Pfarrassistent in Worms aus dem nassau-hessischen Kirchendienst aus und wechselte in den thüringischen Kirchendienst.“"
                            },
                            {
                                "example_id": "c0805551-5404-4556-9ba4-b02e9043e80c",
                                "sense_id": "f150d933-73a8-35b9-8add-ca99e1501c45",
                                "text": "„Er wirkte von 1979–1981 als Pfarrassistent in Oetwil am See, 1981–1983 an der befristeten Pfarrstelle in Wettswil am Albis, 1983–1987 als Pfarrer in Wila, 1987–1995 an der befristeten Pfarrstelle in Oberwinterthur und 1995 bis zu seiner Abwahl 2005 als Pfarrer in Bürglen TG.“"
                            },
                            {
                                "example_id": "be020aac-87a3-4e31-ac55-a9b14ca08925",
                                "sense_id": "f150d933-73a8-35b9-8add-ca99e1501c45",
                                "text": "„Bevor er 2008 nach Namibia kam, war er als Pfarrassistent der deutschsprachigen ev.-luth. Gemeinden in Mittelengland, als Pastor der Nottingham Chinese Christian Church und als Lutheran & International Chaplain an der University of Nottingham tätig.“"
                            },
                            {
                                "example_id": "c11e6fcb-2798-44e0-88f8-ce015684b65d",
                                "sense_id": "f150d933-73a8-35b9-8add-ca99e1501c45",
                                "text": "„Mit seiner Ordination am 14. Juni 1931 in Offenbach am Main wurde er Pfarrassistent an zwei Offenbacher Gemeinden.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
