                {
                    "sense_id": "90a963bf-0e8a-32ea-b1b5-603150150985",
                    "sense_definition": "Force d'attraction exercée par la Terre ou un autre astre sur les corps.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les astronautes s'entraînent à vivre sans <w>pesanteur</w> avant chaque mission spatiale."
                        },
                        {
                            "text": "La force de la <w>pesanteur</w> attire tous les corps vers le centre de la Terre."
                        }
                    ],
                    "synonyms": [
                        "gravité",
                        "gravitation",
                        "attraction gravitationnelle"
                    ],
                    "common_phrases": [
