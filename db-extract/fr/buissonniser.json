                "senses": [
                    {
                        "sense_id": "5deb0dee-5058-36ed-888b-47ef098508e0",
                        "entry_id": "c318011c-11ad-332f-a37a-c26ec174aa0c",
                        "glosses": [
                            "Donner un caractère de buisson à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ce5ad96d-77fc-4b86-be0a-5a30a2b9c274",
                                "sense_id": "5deb0dee-5058-36ed-888b-47ef098508e0",
                                "text": "Les plantes sous leds ont une forte tendance à produire un max de branches et à se buissonniser rapidement."
                            }
                        ]
                    },
                    {
                        "sense_id": "b8685874-7706-387d-8527-1591abf2decb",
                        "entry_id": "c318011c-11ad-332f-a37a-c26ec174aa0c",
                        "glosses": [
                            "Donner un caractère buissonnier à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3337622d-d033-41ca-8dee-23c52e44c96b",
                                "sense_id": "b8685874-7706-387d-8527-1591abf2decb",
                                "text": "Moi je buissonnise l’école et je mets ma chérie à la crèche."
                            }
                        ]
                    },
                    {
                        "sense_id": "d1af588f-fe81-3587-bca5-03e9f5ba5b66",
                        "entry_id": "c318011c-11ad-332f-a37a-c26ec174aa0c",
                        "glosses": [
                            "Rendre proche de la pensée de Patrick Buisson."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6122965c-2732-4265-bf14-23dfc2006179",
                                "sense_id": "d1af588f-fe81-3587-bca5-03e9f5ba5b66",
                                "text": "Je m’en réjouis : cela veut dire qu’il n’est pas « buissonnisé » jusqu’au trognon, que la campagne sera peut-être plus mesurée que je ne le redoutais."
                            },
                            {
                                "example_id": "c74e0ccd-776c-4c54-a457-d4de07cce486",
                                "sense_id": "d1af588f-fe81-3587-bca5-03e9f5ba5b66",
                                "text": "« L’affaire du bijoutier de Nice » en dit long sur l’état de notre société et les comportements inacceptables de l’UMP « buissonnisée »."
                            }
                        ]
                    }
