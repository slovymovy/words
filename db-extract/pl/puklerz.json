                ],
                "senses": [
                    {
                        "sense_id": "0c3b3842-9ca3-331c-b2ae-494962fccee5",
                        "entry_id": "3f55cd77-936f-3e06-aec7-cd90dda3f235",
                        "glosses": [
                            "wypukła tarcza używana przez piechotę i jezdnych"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b86f4f91-1640-495f-b650-69c31ce096fb",
                                "sense_id": "0c3b3842-9ca3-331c-b2ae-494962fccee5",
                                "text": "Średnica puklerzów na ogół nie przekraczała pięćdziesięciu centymetrów."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "2517f84d-1111-3409-8956-f2aee1a3aa9a",
                        "entry_id": "3f55cd77-936f-3e06-aec7-cd90dda3f235",
                        "glosses": [
                            "obrona, osłona"
                        ],
                        "tags": [
                            "metaphoric"
                        ],
                        "examples": [
                            {
                                "example_id": "48bbaa3f-6cec-4662-994b-3f0a6896b0ce",
                                "sense_id": "2517f84d-1111-3409-8956-f2aee1a3aa9a",
                                "text": "Bo puklerz nasz należy do Pana, / a król nasz - do Świętego Izraela"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "30e3ec09-ad6b-4c56-a36c-37b5f75790d3",
                        "source_entry_id": "3f55cd77-936f-3e06-aec7-cd90dda3f235",
                        "source_sense_id": "0c3b3842-9ca3-331c-b2ae-494962fccee5",
                        "target_lang_word": "buckler",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "buckler",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e9c46606-9c9c-361e-b606-cc0b54884b07",
                                        "entry_id": "063c9868-3e95-3cc6-96dd-89432d3cf5ce",
                                        "glosses": [
                                            "One who buckles something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7840c6c0-b202-497c-ba14-d21760dd8afc",
                                                "sense_id": "e9c46606-9c9c-361e-b606-cc0b54884b07",
                                                "text": "Bucklers will be assigned to buckle up drivers in the morning and make sure they stay buckled up."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f359f55-61f6-355d-b188-4afa9c71a713",
                                        "entry_id": "063c9868-3e95-3cc6-96dd-89432d3cf5ce",
                                        "glosses": [
                                            "A kind of shield, of various shapes and sizes, held in the hand or worn on the arm (usually the left), for protecting the front of the body. In the sword and buckler play of the Middle Ages in England, the buckler was a small shield, used not to cover the body but to stop or parry blows."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "33d2d425-7e6f-4b67-b449-602e360c60c9",
                                                "sense_id": "5f359f55-61f6-355d-b188-4afa9c71a713",
                                                "text": "I am eight times thrust through the doublet, four through the hose, my buckler cut through and through; my sword hacked like a hand-saw -- ecce signum!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "083c9099-b883-3f14-a5ee-cd5d77802ba2",
                                        "entry_id": "063c9868-3e95-3cc6-96dd-89432d3cf5ce",
                                        "glosses": [
                                            "A shield resembling the Roman scutum. In modern usage, a smaller variety of shield is usually implied by this term."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "965d1f1a-b0aa-4042-a7ec-aefc24293e87",
                                                "sense_id": "083c9099-b883-3f14-a5ee-cd5d77802ba2",
                                                "text": "The target or buckler was carried by the heavy armed foot, it answered to the scutum of the Romans; its form was sometimes that of a rectangular parallelogram, but more commonly had it's bottom rounded off; it was generally convex, being curved in it's breadth."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d1876848-3bd4-322d-a141-3b8bbd6c565f",
                                        "entry_id": "063c9868-3e95-3cc6-96dd-89432d3cf5ce",
                                        "glosses": [
                                            "One of the large, bony, external plates found on many ganoid fishes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe15c2b5-055c-4ec2-878c-cc7dd085e7c7",
                                                "sense_id": "d1876848-3bd4-322d-a141-3b8bbd6c565f",
                                                "text": "Most zeids have spiny projections or bucklers at the dorsal- and anal-fin bases and bony plates on the ventral surface of the abdomen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d5e64726-887a-3674-a400-1ddbfbd9d6ea",
                                        "entry_id": "063c9868-3e95-3cc6-96dd-89432d3cf5ce",
                                        "glosses": [
                                            "The anterior segment of the shell of a trilobite."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "80af8fd4-8a96-3abf-b18b-66203a1e2455",
                                        "entry_id": "063c9868-3e95-3cc6-96dd-89432d3cf5ce",
                                        "glosses": [
                                            "A block of wood or plate of iron made to fit a hawse hole, or the circular opening in a half-port, to prevent water from entering when the vessel pitches."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "buckler",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1c908104-3357-3beb-88cd-5e81dc4522d2",
                                        "entry_id": "7b9b03e8-c5a3-3657-a47b-438d9dc4fd49",
                                        "glosses": [
                                            "To shield; to defend."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "22f2ca47-3702-45ac-8fa8-0b8d6742b9d0",
                                                "sense_id": "1c908104-3357-3beb-88cd-5e81dc4522d2",
                                                "text": "Can Oxford, that did ever fence the right, / Now buckler falsehood with a pedigree?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "52fc96e1-aab6-43ef-8493-8752fe297127",
                        "source_entry_id": "3f55cd77-936f-3e06-aec7-cd90dda3f235",
                        "source_sense_id": "0c3b3842-9ca3-331c-b2ae-494962fccee5",
                        "target_lang_word": "pukléř",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "144f5a29-da44-4b1b-837f-4ca728a188ff",
                        "source_entry_id": "3f55cd77-936f-3e06-aec7-cd90dda3f235",
                        "source_sense_id": "0c3b3842-9ca3-331c-b2ae-494962fccee5",
                        "target_lang_word": "bouclier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bouclier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "11ad683b-79a9-35a2-af5c-b6b906d19135",
                                        "entry_id": "815f04f7-3e5d-3420-922f-71e2e55992f0",
                                        "glosses": [
                                            "Arme défensive portée par un combattant pour se protéger des traits ou des coups."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c6b3cbcf-d6ac-4b5e-b1f8-ca4d6000bd51",
                                                "sense_id": "11ad683b-79a9-35a2-af5c-b6b906d19135",
                                                "text": "Le même portait, en outre, le petit bouclier triangulaire, assez large à son sommet pour protéger la poitrine, et, à partir de là, s’amincissant en pointe ;…."
                                            },
                                            {
                                                "example_id": "25a85f79-3844-4d01-8e78-d927d43ca504",
                                                "sense_id": "11ad683b-79a9-35a2-af5c-b6b906d19135",
                                                "text": "Mentor montre dans ses yeux une audace qui étonne les plus fiers combattants. Il prend un bouclier, un casque, une épée, une lance; il range les soldats d’Aceste ; il marche à leur tête et s’avance en bon ordre vers les ennemis."
                                            },
                                            {
                                                "example_id": "5e44aa8c-0353-4caf-b368-5c26725b7316",
                                                "sense_id": "11ad683b-79a9-35a2-af5c-b6b906d19135",
                                                "text": "— […], Mme Hyde braqua sur eux le volumineux parapluie qu'elle tenait à la main et l'ouvrit subitement; tandis que la surprise clouait sur place les deux hommes, occupés à se dépêtrer de l'énorme dôme de cotonnade bombée, Hyde, à l'abri de ce bouclier improvisé, battait en retraite, […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bfcb4bce-1c17-3385-89a9-1677221fbd69",
                                        "entry_id": "815f04f7-3e5d-3420-922f-71e2e55992f0",
                                        "glosses": [
                                            "Ce que l’on considère comme une sauvegarde, une protection, une défense."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "97f9ebb8-a229-4edb-9da0-1deec7812d95",
                                                "sense_id": "bfcb4bce-1c17-3385-89a9-1677221fbd69",
                                                "text": "Ce député a proposé la création d'un bouclier législatif pour les nouveaux investisseurs."
                                            },
                                            {
                                                "example_id": "78a39ba1-5a0c-46c6-a423-07c166e49c9e",
                                                "sense_id": "bfcb4bce-1c17-3385-89a9-1677221fbd69",
                                                "text": "Les faibles ont pour bouclier, bien plus que leur droit, leur faiblesse : quel est l’orphelin que délaisse le cœur le moins hospitalier ? — (Sully Prudhomme, La justice)"
                                            },
                                            {
                                                "example_id": "7ec92640-247f-42eb-89e6-c660a3220f07",
                                                "sense_id": "bfcb4bce-1c17-3385-89a9-1677221fbd69",
                                                "text": "Démocratie et transmission, deux exigences complémentaires qui arriment l'Europe à son passé déchiré. Double bouclier contre les passions mortifères toujours susceptibles de ressurgir ici ou là."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0bbf5420-66ba-3b54-b1a4-e7731e9a579d",
                                        "entry_id": "815f04f7-3e5d-3420-922f-71e2e55992f0",
                                        "glosses": [
                                            "Système de protection mobile pour les opérations de construction en sous-sol d’une galerie ou d’un tunnel."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f6005020-90ea-3d32-b2c2-4bd3f083ef42",
                                        "entry_id": "815f04f7-3e5d-3420-922f-71e2e55992f0",
                                        "glosses": [
                                            "Élytre de certains insectes, convexe et relevé sur les bords, dont la forme rappelle celle d’un bouclier"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9dc19ebc-0370-3e75-99a4-56a999424841",
                                        "entry_id": "815f04f7-3e5d-3420-922f-71e2e55992f0",
                                        "glosses": [
                                            "Sorte de pare-chocs."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9fa6d4af-3a80-38dc-8261-4dc490e2c231",
                                        "entry_id": "815f04f7-3e5d-3420-922f-71e2e55992f0",
                                        "glosses": [
                                            "Blindage entourant le cœur d'un réacteur nucléaire."
                                        ],
                                        "tags": [
                                            "Nucléaire",
                                            "Radioprotection"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e8838f7e-d3a7-3947-956f-5e31f035f470",
                                        "entry_id": "815f04f7-3e5d-3420-922f-71e2e55992f0",
                                        "glosses": [
                                            "Région stable du socle ancien, de type craton, composée de roches d'origine magmatique et métamorphique datant du Précambrien."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ec91971-36b1-4e00-963f-b9e97b2a9c30",
                                                "sense_id": "e8838f7e-d3a7-3947-956f-5e31f035f470",
                                                "text": "Dans la partie protérozoïque (entre –2,5 et –0,5 milliards d'années) du bouclier guyanais, au Venezuela, en Guyana et au Brésil, les diamants des gisements alluvionnaires actuels (placers) proviennent de l'érosion de gisements secondaires anciens (paléoplacers) de la formation détritique continentale Roraima, âgée de 1,65 milliard d'années."
                                            },
                                            {
                                                "example_id": "c11bc1de-05a8-40a7-a760-c6420a2df008",
                                                "sense_id": "e8838f7e-d3a7-3947-956f-5e31f035f470",
                                                "text": "Or, ces roches couvrent une large superficie de la surface de la Terre, et forment l’armature des boucliers, en particulier dans les zones chaudes (boucliers africain, brésilien, indien, australien) où les roches plutoniques et métamorphiques affleurent largement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8fdc7a2c-7e77-3836-b45f-cd4c694f5ed5",
                                        "entry_id": "815f04f7-3e5d-3420-922f-71e2e55992f0",
                                        "glosses": [
                                            "Ensemble des plumes de l’aile d’un pigeon."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "65adacfc-dca3-380f-92e4-c0b03a91d971",
                                        "entry_id": "815f04f7-3e5d-3420-922f-71e2e55992f0",
                                        "glosses": [
                                            "Meuble représentant l’arme défensive du même nom dans les armoiries. Il ne doit pas être confondu avec l’écu qui est le périmètre souvent utilisé pour représenter des armoiries. Il est parfois confondu avec l’écusson qui adopte la même géométrie que l’écu et qui est, lui, une pièce et non un meuble. Il peut adopter n'importe quelle forme visuelle qui pourra être précisée dans le blasonnement si nécessaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e2304380-cdb0-461c-9625-a7483d3e6890",
                                                "sense_id": "65adacfc-dca3-380f-92e4-c0b03a91d971",
                                                "text": "Coupé : au 1ᵉʳ d’azur au sceptre fleurdelisé passé en sautoir avec une croisette recroisetée au pied fiché, surmontés d’un chardon, le tout d’or, au 2ᵉ d’or au bouclier de gueules échancré du chef et chargé d’une croix tréflée d’argent, qui est de Brabant-le-Roi de la Meuse → voir illustration « armoiries avec un bouclier »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5367d6e4-bb5c-3539-82e2-3493c870888c",
                                        "entry_id": "815f04f7-3e5d-3420-922f-71e2e55992f0",
                                        "glosses": [
                                            "Attribut représentant un bouclier ajouté à un meuble qui n’en porte pas d’ordinaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "958704ad-1c7a-4efb-8857-1e41e04475cd",
                                                "sense_id": "5367d6e4-bb5c-3539-82e2-3493c870888c",
                                                "text": "Écartelé au premier d’azur à quatre chevrons superposés d’or, au deuxième des barons tirés de l’armée ; au troisième d’argent à la fasce de gueules chargée de deux étoiles du champ et surmontée d’une grenade de sable, allumée de gueules au second point ; au quatrième d’azur au lion d’or tenant de la dextre un sabre et de la sénestre un bouclier d’argent, qui est de Charles Stanislas Marion → voir illustration « armoiries avec un lion portant un bouclier »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c7ed59d7-a249-3161-834a-c9907a7cb9f5",
                                        "entry_id": "815f04f7-3e5d-3420-922f-71e2e55992f0",
                                        "glosses": [
                                            "Une des quatre enseignes d’un jeu de cartes suisse, ainsi nommée parce que les cartes de cette couleur sont marquées de boucliers stylisés."
                                        ],
                                        "tags": [
                                            "Cartes à jouer"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "83b693d8-67d2-3ce0-94b2-502231b5aca5",
                                        "entry_id": "815f04f7-3e5d-3420-922f-71e2e55992f0",
                                        "glosses": [
                                            "Race de pigeon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4fd54a24-01a1-4457-b638-601b1b960531",
                                                "sense_id": "83b693d8-67d2-3ce0-94b2-502231b5aca5",
                                                "text": "C'est une race qui a servi souvent en croisement chez les boucliers c'est pour cela que ça ressort"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0872efb6-e788-4f57-a649-58016c7ba8b9",
