                    "frequency": "Low",
                    "semantic_group_id": "droit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les parents ont choisi de <w>constituer</w> une dot importante pour aider leur fille."
                        },
                        {
                            "text": "Cet investisseur prudent cherche à <w>constituer</w> une rente viagère afin de garantir sa retraite."
                        }
                    ],
                    "synonyms": [
