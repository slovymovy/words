                                    }
                                ]
                            },
                            {
                                "target_word": "fairing",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "89c8324b-81b3-37f0-97fc-547d0409b092",
                                        "entry_id": "72e44cec-1b26-3017-8a00-04b61852dfb3",
                                        "glosses": [
                                            "A covering on various parts of a vehicle, for example an aircraft, automobile, or motorcycle, that streamlines it (i.e., produces a smooth exterior and reduces drag)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4928335b-2e99-4037-a3ac-5af72228eede",
                                                "sense_id": "89c8324b-81b3-37f0-97fc-547d0409b092",
                                                "text": "The fairing over the driving motion of this engine, and of the 4-6-2s, was removed subsequently, to give greater accessibility to the working parts."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
