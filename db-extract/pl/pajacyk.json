                "forms": [],
                "senses": [
                    {
                        "sense_id": "391aeced-915a-348e-9f3c-fbe9ecf75336",
                        "entry_id": "68451880-8d63-397b-8bef-48ddcefce8cf",
                        "glosses": [
                            "od: pajac"
                        ],
                        "tags": [
                            "diminutive"
                        ],
                        "examples": [
                            {
                                "example_id": "29b9bbf2-8ac3-4910-a276-e8191d85fa66",
                                "sense_id": "391aeced-915a-348e-9f3c-fbe9ecf75336",
                                "text": "Bóg sobie zrobił dwa pajacyki"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "6377846b-e451-3b8c-b9d7-1edd8b0daa6a",
                        "entry_id": "68451880-8d63-397b-8bef-48ddcefce8cf",
                        "glosses": [
                            "ćwiczenie gimnastyczne wykonywane w podskoku, z wykonaniem rozkroku i klaśnięciem nad głową"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "37665cf1-28b0-4dfb-92ae-dfc95b2041a0",
                                "sense_id": "6377846b-e451-3b8c-b9d7-1edd8b0daa6a",
                                "text": "W ramach rozgrzewki zróbcie trzydzieści pajacyków."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "5008b676-a59b-35b6-812b-939fb5083913",
                        "entry_id": "68451880-8d63-397b-8bef-48ddcefce8cf",
                        "glosses": [
                            "dziecięce ubranie z połączonych rajtuz i koszulki, rozpinane z przodu"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5eb6aef1-8a66-4584-a75b-436e641e56ec",
                                "sense_id": "5008b676-a59b-35b6-812b-939fb5083913",
                                "text": "Rampers, czyli letni pajacyk z krótkimi rękawkami i krótkimi nogawkami to doskonały element garderoby na ciepłe dni"
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4b677a75-2318-4456-b9e8-6f5c8ee17f60",
                        "source_entry_id": "68451880-8d63-397b-8bef-48ddcefce8cf",
                        "source_sense_id": "6377846b-e451-3b8c-b9d7-1edd8b0daa6a",
                        "target_lang_word": "jumping jack",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jumping jack",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c443fba4-c083-3479-ba8f-0f4f1a2b7f03",
                                        "entry_id": "ef3d778b-bca3-3302-afa7-03d37f010fe3",
                                        "glosses": [
                                            "A physical exercise performed by jumping to a position with the legs spread wide and the hands touching overhead and then returning to a position with the feet together and the arms at the sides."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "05f7e640-17e7-31cf-9f7b-a52236d575fb",
                                        "entry_id": "ef3d778b-bca3-3302-afa7-03d37f010fe3",
                                        "glosses": [
                                            "A machine, roughly the size of a three-year-old child, the foot of which vibrates forcefully, causing it to \\\"jump\\\" rapidly, pounding the ground to compact it."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ce662525-f624-3512-b5b7-6c947c9a2a14",
                                        "entry_id": "ef3d778b-bca3-3302-afa7-03d37f010fe3",
                                        "glosses": [
                                            "A toy figure of a person with jointed limbs that can be made to appear to dance or jump by pulling an attached string."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7287f7ea-81ae-4aac-8ac2-ce47bb850098",
                        "source_entry_id": "68451880-8d63-397b-8bef-48ddcefce8cf",
                        "source_sense_id": "6377846b-e451-3b8c-b9d7-1edd8b0daa6a",
                        "target_lang_word": "Hampelmann",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hampelmann",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "18913906-a35d-3779-8d04-a39b491f211d",
                                        "entry_id": "955a2fc5-cff7-3513-bfd4-eba03f8f3040",
                                        "glosses": [
                                            "Figur, deren Arme und Beine mittels einer Schnur bewegt werden können"
                                        ],
                                        "tags": [
                                            "Spielzeug"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5a8a609f-49d5-4ef0-be8d-87dcc67f8214",
                                                "sense_id": "18913906-a35d-3779-8d04-a39b491f211d",
                                                "text": "Wenn man an der Schnur zieht, hampelt der Hampelmann."
                                            },
                                            {
                                                "example_id": "88989613-5953-48f6-94e9-8cd58242c5ed",
                                                "sense_id": "18913906-a35d-3779-8d04-a39b491f211d",
                                                "text": "„Wie fast alle Liebhaber von Puppen und Hampelmännern fühlt er Kindern gegenüber eine große Indifferenz.“"
                                            },
                                            {
                                                "example_id": "d79f09fd-1e7a-417a-94d8-9a57a5bde665",
                                                "sense_id": "18913906-a35d-3779-8d04-a39b491f211d",
                                                "text": "„Sie haßte mich nicht, und sie liebte ich nicht, das war ganz einfach; und da sie sehr jung war und Grund zum Lachen haben mußte, hatte sie mich auserkoren, um sich über mich wie über einen Hampelmann lustig zu machen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "91d2a44a-25a6-3073-a943-e76c43ee4dca",
                                        "entry_id": "955a2fc5-cff7-3513-bfd4-eba03f8f3040",
                                        "glosses": [
                                            "willensschwacher Mann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8cbe8f41-1cbe-4958-870e-461a493a7503",
                                                "sense_id": "91d2a44a-25a6-3073-a943-e76c43ee4dca",
                                                "text": "Der Hampelmann hat ja keine eigene Meinung – es gilt immer, was sie sagt."
                                            },
                                            {
                                                "example_id": "6882881c-e399-4163-8538-13e2634d3f9c",
                                                "sense_id": "91d2a44a-25a6-3073-a943-e76c43ee4dca",
                                                "text": "„»Er war in gewisser Hinsicht ein Clown, aber kein Hampelmann, der sich manipulieren ließ«, meint der Dali-Experte Ignacio Gomez de Liano.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "061d22cf-3820-3860-8d9e-b5d858e82779",
                                        "entry_id": "955a2fc5-cff7-3513-bfd4-eba03f8f3040",
                                        "glosses": [
                                            "zappelige (hyperaktive) Person"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de6de99c-bf95-45f9-b04a-9977bc4d957c",
                                                "sense_id": "061d22cf-3820-3860-8d9e-b5d858e82779",
                                                "text": "Es ist nicht leicht den kleinen Hampelmann zu kämmen – er will nicht stillhalten."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "4177db53-8c37-369c-a424-0f34b2aa4a6c",
                                        "entry_id": "955a2fc5-cff7-3513-bfd4-eba03f8f3040",
                                        "glosses": [
                                            "Turnübung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4acc4feb-92b0-4830-b6df-e79c0899aba9",
                                                "sense_id": "4177db53-8c37-369c-a424-0f34b2aa4a6c",
                                                "text": "Zum Aufwärmen ist der Hampelmann gut geeignet."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
