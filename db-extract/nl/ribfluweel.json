                "senses": [
                    {
                        "sense_id": "9a5aa203-1ea9-3c7e-9238-7b4448fefd32",
                        "entry_id": "da9340b9-6789-3a4d-8619-2bbe907c8478",
                        "glosses": [
                            "katoenen, geweven stof met ribbels"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2f14ac84-581f-4f95-b0a3-c78f3d828cdc",
                                "sense_id": "9a5aa203-1ea9-3c7e-9238-7b4448fefd32",
                                "text": "Iedereen kent hem wel, de slordige vent met de broek van ribfluweel, de lamswollen pullover met ellebooglapjes, de afgedragen veterschoenen en de nooit gewassen Land Rover."
                            },
                            {
                                "example_id": "acff54cf-4352-456c-87fd-05dced16eb51",
                                "sense_id": "9a5aa203-1ea9-3c7e-9238-7b4448fefd32",
                                "text": "Thierry Baudet beproefde zijn geluk aanvankelijk bij D66, de universiteit en NRC Handelsblad. Martin Bosma probeerde het eerst bij Trouw en de Wereldomroep, Joost Niemöller in de literaire grachtengordel, Pritt van GeenStijl bij 'de linkse media', en ook Filip Dewinter en Pim Fortuyn zijn ooit gezien met baard en ribfluweel."
                            }
                        ]
                    }
