                "senses": [
                    {
                        "sense_id": "8d1ffc07-a594-3a05-8623-4076d9ccafb7",
                        "entry_id": "0a43c88e-6d19-3289-826e-14c1d2411597",
                        "glosses": [
                            "участвовать в параде"
