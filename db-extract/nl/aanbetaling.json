                                "target_senses": [
                                    {
                                        "sense_id": "08642efd-02af-3256-a3cc-1bc3098843c2",
                                        "entry_id": "e152e7c6-cac2-3687-8fae-597d7ecc3766",
                                        "glosses": [
                                            "Somme d’argent versée dès la signature d’un contrat, et enlevant toute possibilité de dédit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "08b6ef36-293a-4f33-85b4-ebff0ebf16bf",
                                                "sense_id": "08642efd-02af-3256-a3cc-1bc3098843c2",
                                                "text": "Un acompte implique un engagement ferme."
                                            },
                                            {
                                                "example_id": "fa809e77-5b1a-416e-b4f9-ff9474048eb0",
                                                "sense_id": "08642efd-02af-3256-a3cc-1bc3098843c2",
                                                "text": "L’acompte est un premier versement à valoir sur l’achat."
                                            },
                                            {
                                                "example_id": "54a0ff1e-e170-417e-849a-4ae7eccc146a",
                                                "sense_id": "08642efd-02af-3256-a3cc-1bc3098843c2",
                                                "text": "Je ne peux annuler cette réservation, j’ai versé un acompte."
                                            },
                                            {
                                                "example_id": "e18fbdd1-16e1-4972-9bcd-93cdd29002c3",
                                                "sense_id": "08642efd-02af-3256-a3cc-1bc3098843c2",
                                                "text": "Au moment du paiement du prix, l’acompte a vocation à représenter une partie du prix, payée de façon anticipée, qui vient en déduction du montant total du contrat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a601e334-11d3-36b1-904b-6b1fca95a8bc",
                                        "entry_id": "e152e7c6-cac2-3687-8fae-597d7ecc3766",
                                        "glosses": [
                                            "Prémices d’une action encore à venir."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fb8665bf-56d6-4aaa-a869-ad5788ba37b7",
                                                "sense_id": "a601e334-11d3-36b1-904b-6b1fca95a8bc",
                                                "text": "La marche et ce premier effort l’avaient creusé, il pouvait bien prendre un petit acompte sur son repas de midi."
                                            },
                                            {
                                                "example_id": "282e9d1f-1352-4c5e-a6af-a094723bd196",
                                                "sense_id": "a601e334-11d3-36b1-904b-6b1fca95a8bc",
                                                "text": "Il a surgi dans la cour en nous annonçant qu’il montait à Bruxelles casser la tronche de Lucas. Colombe s’est cabrée et Mehdi a décoché une droite à Paul, le meilleur ami de Lucas, comme s’il s’agissait d’un acompte."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
