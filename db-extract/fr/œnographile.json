                "senses": [
                    {
                        "sense_id": "1819322e-15d0-3da5-9d5d-c693cbb26a61",
                        "entry_id": "9c2b0a6e-5bde-3bef-b466-92575161786e",
                        "glosses": [
                            "Personne qui collectionne les étiquettes de bouteilles de vin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0fdcb68-f6de-4854-b4e2-35a131ca4728",
                                "sense_id": "1819322e-15d0-3da5-9d5d-c693cbb26a61",
                                "text": "Arlette Feld est œnographile. Et non, ce n’est pas une maladie. Elle fait simplement collection d’étiquettes de vins."
                            },
                            {
                                "example_id": "65ece42b-08b7-4408-9945-fdb32e10d406",
                                "sense_id": "1819322e-15d0-3da5-9d5d-c693cbb26a61",
                                "text": "Un œnographile averti ne pourra certainement pas avoir bu chaque bouteille correspondant à ses précieuses étiquettes. Heureusement pour lui, il existe de nombreuses communautés, cette passion étant bien plus répandue qu’elle n’y paraît. Ainsi, des sites internet mettent en relation les œnographiles à travers le monde, pour que ceux-ci puissent échanger le fameux sésame."
                            },
                            {
                                "example_id": "698d2f3e-934a-4053-9761-64c9f03d3d5a",
                                "sense_id": "1819322e-15d0-3da5-9d5d-c693cbb26a61",
                                "text": "C’est un peu par hasard que Jean-Paul Pierre, habitant de Séné (Morbihan), est devenu œnographile. En trente ans, il a collecté 120 000 étiquettes de vin."
                            }
                        ]
                    }
