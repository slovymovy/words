                        "target_lang_word": "я́рость",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "я́рость",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "701ceda9-f380-3ca4-8156-31a1d6dcb14c",
