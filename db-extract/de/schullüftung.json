                "senses": [
                    {
                        "sense_id": "2f055571-2153-3d4a-816c-6504b356e10e",
                        "entry_id": "33ded117-7911-3942-afff-419280f6e0fe",
                        "glosses": [
                            "Lüftungskonzept, lüftungstechnische Einrichtungen und Anlagen für eine Schule"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94dda18f-4403-476d-a5cd-815e63b33733",
                                "sense_id": "2f055571-2153-3d4a-816c-6504b356e10e",
                                "text": "Der Entwurf der Richtlinie zur Schullüftung (VDI 6040 Blatt 2- Ausführungshinweise) wird im Januar 2014 der Fachöffentlichkeit vorgestellt und knüpft an Pettenkofer´s Ziel von 1858 an."
                            },
                            {
                                "example_id": "cb948bed-1776-43c1-b802-14f10521c7f9",
                                "sense_id": "2f055571-2153-3d4a-816c-6504b356e10e",
                                "text": "„Dem Angebot nach zu urteilen, könnte die Schullüftung an den Erfolg der Wohnungslüftung anknüpfen.“"
                            },
                            {
                                "example_id": "0aca22b1-985d-480c-9db9-b1549ca0272f",
                                "sense_id": "2f055571-2153-3d4a-816c-6504b356e10e",
                                "text": "„Schullüftung mit der Comfort Line sorgt für saubere, frische und komfortable Klassenzimmer.“"
                            },
                            {
                                "example_id": "849301ed-7146-4290-9815-fe67b3cd06e5",
                                "sense_id": "2f055571-2153-3d4a-816c-6504b356e10e",
                                "text": "„Wie sich die heutige Situation in Schulen darstellt, welche Anforderungen an die Raumluftqualität bestehen und wie ein beispielhaftes Konzept für eine effiziente Schullüftung umgesetzt werden kann, beleuchtet der nachfolgende Artikel“"
                            },
                            {
                                "example_id": "cf5c85b5-f77f-4aaa-972e-7ec94e37a8cc",
                                "sense_id": "2f055571-2153-3d4a-816c-6504b356e10e",
                                "text": "„Ein bewährtes Frischluftklimamanagement soll für Schullüftung modifiziert werden.“"
                            },
                            {
                                "example_id": "7cec9b13-909a-4637-a0a2-dae490e11bde",
                                "sense_id": "2f055571-2153-3d4a-816c-6504b356e10e",
                                "text": "„Bei den technischen Themen ist für uns die Schullüftung immer noch aktuell, künftig werden wir aber vor allem das Thema Hygiene verstärkt angreifen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
