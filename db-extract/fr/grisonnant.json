                ],
                "senses": [
                    {
                        "sense_id": "2e50089a-1cbf-3124-ac4c-543dde330433",
                        "entry_id": "797feffd-a0e1-39ad-af70-8f3985008051",
                        "glosses": [
                            "Qui grisonne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "128f430c-b7d3-4ba8-a5c8-16e646644e66",
                                "sense_id": "2e50089a-1cbf-3124-ac4c-543dde330433",
                                "text": "Le grand maître était un homme d’un âge avancé, comme le prouvaient sa longue barbe blanche et ses sourcils déjà grisonnants."
                            },
                            {
                                "example_id": "9b6c7888-109e-4521-a85a-0804257f621d",
                                "sense_id": "2e50089a-1cbf-3124-ac4c-543dde330433",
                                "text": "…; des cheveux grisonnants couvraient à peine son crâne jaune et le faisaient vieux avant le temps ; …."
                            },
                            {
                                "example_id": "d72edb42-5f33-4b4b-9b35-88ffbe87d8d0",
                                "sense_id": "2e50089a-1cbf-3124-ac4c-543dde330433",
                                "text": "La femme assise sur les marches de sa maison, une femme petite et douce, le teint basané, les cheveux grisonnants, qui se regarde dans une glace de quatre sous et parle sans arrêt, vite et bas."
                            },
                            {
                                "example_id": "87dc23cc-13d9-48a5-97b2-99ea6cfe5b7d",
                                "sense_id": "2e50089a-1cbf-3124-ac4c-543dde330433",
                                "text": "Rien ne vieillit plus mal qu’un militant grisonnant qui s’accroche désespérément aux causes qui le faisaient vibrer quand il avait 15 ans et qui passe son temps à pester contre « l’indolence des jeunes »..."
                            }
                        ]
                    }
