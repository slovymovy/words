        "nl-extract.jsonl": [
            {
                "entry_id": "2f22da5d-6606-3ade-ac6f-cc3b9a7b34e8",
                "word": "voorstellingsvermogen",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "64814d6e-653e-4b46-bf77-6d725437939c",
                        "entry_id": "2f22da5d-6606-3ade-ac6f-cc3b9a7b34e8",
                        "tags": [
                            "plural"
                        ],
                        "form": "voorstellingsvermogens"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5a2db874-3154-3235-a673-1ffea041e93d",
                        "entry_id": "2f22da5d-6606-3ade-ac6f-cc3b9a7b34e8",
                        "glosses": [
                            "het vermogen zich dingen voor te stellen die er als zodanig niet zijn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54df2340-cda6-4757-9fd2-f1dbda079f1e",
                                "sense_id": "5a2db874-3154-3235-a673-1ffea041e93d",
                                "text": "Lord Henley was een man met weinig voorstellingsvermogen, iemand voor wie het onmogelijk was om de wereld door andermans ogen te beschouwen."
                            },
                            {
                                "example_id": "f244bf5d-2c2b-4d1d-ad0d-db0c5c69b0fe",
                                "sense_id": "5a2db874-3154-3235-a673-1ffea041e93d",
                                "text": "De antwoorden van Shell getuigen van een \"gebrek aan voorstellingsvermogen buiten olie en gas\", zegt Van Baal. Volgens hem moet Shell op zoek naar nieuwe verdienmodellen. \"Waar visie ontbreekt, grijpen de boekhouders de macht om ieder nieuw initiatief stuk te rekenen.\""
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9bacc373-d367-417a-972b-fe63fabc5ed0",
                        "source_entry_id": "2f22da5d-6606-3ade-ac6f-cc3b9a7b34e8",
                        "source_sense_id": "5a2db874-3154-3235-a673-1ffea041e93d",
                        "source_sense_description": "het vermogen zich dingen voor te stellen die er als zodanig niet zijn",
                        "target_lang_word": "ingenuity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ingenuity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "54847872-61f2-37a0-8998-1892139da889",
                                        "entry_id": "6ea49a8c-94c8-379b-995a-f77f365fb619",
                                        "glosses": [
                                            "The ability to solve difficult problems in original, clever, and inventive ways; ingeniousness."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "13f9234a-e383-4bde-87f4-3cdae7976792",
                                                "sense_id": "54847872-61f2-37a0-8998-1892139da889",
                                                "text": "The pyramids demonstrate the ingenuity of the ancient Egyptians."
                                            },
                                            {
                                                "example_id": "540e2a03-12bf-465e-aaa1-8c1833be717d",
                                                "sense_id": "54847872-61f2-37a0-8998-1892139da889",
                                                "text": "Poverty is the mother of ingenuity."
                                            },
                                            {
                                                "example_id": "c819cb24-7389-4f50-a197-2454a7a6f04b",
                                                "sense_id": "54847872-61f2-37a0-8998-1892139da889",
                                                "text": "Ingenuity is one of the characteristics of a beaver."
                                            },
                                            {
                                                "example_id": "1433c4ff-0771-4d62-8d1a-dec0cc870c41",
                                                "sense_id": "54847872-61f2-37a0-8998-1892139da889",
                                                "text": "Half the ingenuity lavished on news—by news we mean the topics of the day as connected with their own circle—half this ingenuity would set up a whole Society of Antiquaries, and immortalise at least a dozen of them."
                                            },
                                            {
                                                "example_id": "ca01a1f2-caa9-4c16-9963-29258bbd9b99",
                                                "sense_id": "54847872-61f2-37a0-8998-1892139da889",
                                                "text": "The heavy freight traffic which shares the double line between Paddington and Wolverhampton with the passenger traffic has taxed the ingenuity of the timetable planners."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "52c1c48e-5cb6-34f0-beb4-efa8ab2a109b",
                                        "entry_id": "6ea49a8c-94c8-379b-995a-f77f365fb619",
                                        "glosses": [
                                            "An ingenuous action or thought."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1448c930-b5b1-4a6b-a26e-dfad2d6a5374",
                                                "sense_id": "52c1c48e-5cb6-34f0-beb4-efa8ab2a109b",
                                                "text": "Virility is sustained, preserved, even recaptured, by man's ingenuities, by exotic foods and drinks, by rare herbal compounds, by fantastical manipulations, goetic periapts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5bd37c08-b1b1-3911-8cee-d337fa1ccfaf",
                                        "entry_id": "6ea49a8c-94c8-379b-995a-f77f365fb619",
                                        "glosses": [
                                            "Ingenuousness; honesty, straightforwardness"
                                        ],
                                        "tags": [
                                            "archaic",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "288e0685-d8bb-4580-82f1-27b8fc8aa601",
                                                "sense_id": "5bd37c08-b1b1-3911-8cee-d337fa1ccfaf",
                                                "text": "And therefore I apply my selfe to ingenuitie, and ever to speake truth and what I think[…]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f22d8149-56ac-4170-881c-6a6373166d02",
                        "source_entry_id": "2f22da5d-6606-3ade-ac6f-cc3b9a7b34e8",
                        "source_sense_id": "5a2db874-3154-3235-a673-1ffea041e93d",
                        "source_sense_description": "het vermogen zich dingen voor te stellen die er als zodanig niet zijn",
                        "target_lang_word": "imagination",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "imagination",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "02e47274-73ce-37d0-bf5a-a8a273b43043",
                                        "entry_id": "27cec5dd-9613-38ba-a2fe-149e45fe5eee",
                                        "glosses": [
                                            "The image-making power of the mind; the act of mentally creating or reproducing an object not previously perceived; the ability to create such images."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f8f1134e-7f50-4d7f-856b-b11b4d1ab197",
                                                "sense_id": "02e47274-73ce-37d0-bf5a-a8a273b43043",
                                                "text": "Imagination is one of the most advanced human faculties."
                                            },
                                            {
                                                "example_id": "b01536b0-8ea7-42da-ba24-7bbe02f5430f",
                                                "sense_id": "02e47274-73ce-37d0-bf5a-a8a273b43043",
                                                "text": "She removed Stranleigh’s coat with a dexterity that aroused his imagination."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cf48a79f-224d-3e2f-8319-e041881aea42",
                                        "entry_id": "27cec5dd-9613-38ba-a2fe-149e45fe5eee",
                                        "glosses": [
                                            "Particularly, construction of false images; fantasizing."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8cc823f2-2110-4cc0-b990-273b004fdde9",
                                                "sense_id": "cf48a79f-224d-3e2f-8319-e041881aea42",
                                                "text": "You think someone's been following you? That's just your imagination."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "66657a7b-6a39-396c-9020-81f32c3f15eb",
                                        "entry_id": "27cec5dd-9613-38ba-a2fe-149e45fe5eee",
                                        "glosses": [
                                            "Creativity; resourcefulness."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7cc5ca4a-986c-4166-9da8-abdc372d5310",
                                                "sense_id": "66657a7b-6a39-396c-9020-81f32c3f15eb",
                                                "text": "His imagination makes him a valuable team member."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3e7066f6-be62-393e-821d-31e36d3c302b",
                                        "entry_id": "27cec5dd-9613-38ba-a2fe-149e45fe5eee",
                                        "glosses": [
                                            "A mental image formed by the action of the imagination as a faculty; something imagined."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d7f63785-8161-4bd3-a609-841bea614b93",
                                                "sense_id": "3e7066f6-be62-393e-821d-31e36d3c302b",
                                                "text": "And yet the invention of young men, is more lively than that of old; and imaginations stream into their minds better, and, as it were, more divinely."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
