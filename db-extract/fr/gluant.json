                    {
                        "translation_id": "62f64f8e-bcdd-4b8f-8826-de213e9af142",
                        "source_entry_id": "0ab0c4b5-514d-35a5-95ef-b9dac4d7a2c0",
                        "target_lang_word": "sticky",
