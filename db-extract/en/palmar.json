                                        "entry_id": "e56cbb90-6966-353b-a79e-65b65de500c9",
                                        "glosses": [
                                            "zu hohlen Hand gehörig; die Handfläche betreffend; auf der Hohlhandseite befindlich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a043135-a90c-444e-8994-28cfa0003dff",
                                                "sense_id": "62d8a98b-8189-3163-bbf8-3371ef342063",
                                                "text": "Der distal gestielte Sehnenanteil des Xtensor carpi radialis wird dorsal durch den Os triquetrum durchgezogen und palmar herausgeleitet, wobei er wiederum palmar in das Os lunatum eingezogen und nach dorsal herausgeleitet wird."
                                            },
                                            {
                                                "example_id": "deba5b4b-28b8-4049-acb5-3ee71753ac2e",
                                                "sense_id": "62d8a98b-8189-3163-bbf8-3371ef342063",
                                                "text": "Weiterhin besteht die Möglichkeit, sowohl dorsal als auch palmar die beiden Methoden miteinander zu kombinieren."
                                            },
                                            {
                                                "example_id": "16b01b10-46ae-4d49-b395-b91079e849c9",
                                                "sense_id": "62d8a98b-8189-3163-bbf8-3371ef342063",
                                                "text": "An der Hand wird die Mittelhand v. a. palmar bis zur Handbeugefalte herangezogen, die Finger können dorsal und palmar belastet werden."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
