                            {
                                "example_id": "99e7347b-929d-4843-a4ce-4bd1f1ba06be",
                                "sense_id": "5edcd914-5eb7-3c08-be05-7bd80833c89f",
                                "text": "Autre exemple, une sténo-dactylo doit savoir prendre un texte en sténo, taper à la machine, faire du classement, etc."
