                    "sense_id": "0242225b-35fe-38f8-925d-8a5cff9bb6e1",
                    "sense_definition": "A person who is kept in custody or confined by authorities, especially for political or security reasons.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lawyer was finally permitted to speak with the <w>detainee</w> after several days.",
                            "target_lang_translations": {
                                "fr": "L'avocat a enfin été autorisé à s'entretenir avec le <w>détenu</w> après plusieurs jours.",
                                "zh": "几天后，律师终于获准与该<w>被拘留者</w>交谈。"
                            }
                        },
                        {
                            "text": "Human rights organizations expressed serious concern about the treatment of each <w>detainee</w> in the facility.",
                            "target_lang_translations": {
                                "fr": "Les organisations de défense des droits de l'homme ont exprimé de vives inquiétudes quant au traitement de chaque <w>détenu</w> dans l'établissement.",
                                "zh": "人权组织对该设施内每位<w>被关押者</w>的待遇表示严重关切。"
                            }
                        }
                    ],
                    "synonyms": [
                        "captive",
                        "prisoner"
                    ],
                    "common_phrases": [
                        "political detainee",
                        "release a detainee"
                    ],
                    "target_lang_definitions": {
                        "fr": "Personne gardée à vue, incarcérée ou privée de liberté par les autorités, en particulier pour des motifs politiques ou de sécurité.",
                        "zh": "被官方拘留、关押或扣押的人，尤指因政治或安全原因被拘留者。"
                    },
