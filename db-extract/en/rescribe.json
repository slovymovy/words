                        "glosses": [
                            "To write back; to write in reply."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "70d5e555-5a53-4cd4-bfdb-b9fd4341d433",
                                "sense_id": "30cc9713-c099-3d6e-b295-f93a56173020",
                                "text": "Whenever a Prince on his being consulted by any one rescribes or writes back in this manner, he seems to dispense with that act."
                            }
                        ]
                    },
