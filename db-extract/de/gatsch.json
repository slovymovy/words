                                "sense_id": "b8025707-73b7-3fc5-8978-a7ec384769e0",
                                "text": "Der ganze Boden ist voller Gatsch!"
                            },
                            {
                                "example_id": "641598ec-568f-4c47-be64-83ce89ac61b8",
                                "sense_id": "b8025707-73b7-3fc5-8978-a7ec384769e0",
                                "text": "Durch das zu starke Bewässern der Wiese war diese nun nur mehr Gatsch."
                            },
                            {
                                "example_id": "51c97d04-0543-4895-9ed9-fbe2bf4032ee",
                                "sense_id": "b8025707-73b7-3fc5-8978-a7ec384769e0",
                                "text": "Er rutschte aus und fiel in den Gatsch."
                            }
                        ],
