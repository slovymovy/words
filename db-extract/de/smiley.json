                "senses": [
                    {
                        "sense_id": "2360146d-79ad-39c2-a4bc-d54a35139898",
                        "entry_id": "dd7b7d90-92a8-3a51-8547-cd5a9c14552e",
                        "glosses": [
                            "ein minimalistisch gezeichnetes lächelndes Gesicht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4297c9c8-6a31-4d39-ae37-9c1ac1ca137a",
                                "sense_id": "2360146d-79ad-39c2-a4bc-d54a35139898",
                                "text": "Er hat ein Smiley auf dem T-Shirt."
                            },
                            {
                                "example_id": "76cd5a74-0ba0-4243-8110-50f3f1afa4d0",
                                "sense_id": "2360146d-79ad-39c2-a4bc-d54a35139898",
                                "text": "„Ich widerstehe dem Impuls, einen Smiley in die Staubschicht auf dem Glastisch zu malen.“"
                            },
                            {
                                "example_id": "82267eea-5cc8-48ba-a0e1-d12684f2f907",
                                "sense_id": "2360146d-79ad-39c2-a4bc-d54a35139898",
                                "text": "„Ich freute mich über ihre gut gemeinten Bemerkungen, denn ich wusste, dass sie mir auf diese Weise ihre Sympathie zeigten, so, wie ich ihre Texte mit Smileys am Rand verzierte, wenn ich sie zurückgab.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "4e39fe52-0962-315d-b2b0-c9c406e0ab5d",
                        "entry_id": "dd7b7d90-92a8-3a51-8547-cd5a9c14552e",
                        "glosses": [
                            "(angelehnt an [1]) jede Art von Piktogramm, die Gesichtsausdrücke (und mehr) darstellt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "72a9c9db-1abd-41b7-960e-51d5a17960bb",
                                "sense_id": "4e39fe52-0962-315d-b2b0-c9c406e0ab5d",
                                "text": "Im Message-Fenster gibt es eine Auswahl an bunten Smileys."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "95185bad-2828-3c16-8b74-7492dc9736f2",
                        "entry_id": "dd7b7d90-92a8-3a51-8547-cd5a9c14552e",
                        "glosses": [
                            "Darstellung von [2] durch ASCII (oder auch andere Schrift auf dem Computer)"
                        ],
                        "tags": [
                            "Internetkommunikation",
                            "Chat",
                            "SMS",
                            "Messenger"
                        ],
                        "examples": [
                            {
                                "example_id": "b5f53dd4-5faa-4f9d-af8b-c9e3d125f5bd",
                                "sense_id": "95185bad-2828-3c16-8b74-7492dc9736f2",
                                "text": "Das am besten bekannte Smiley im Chat ist wohl :)."
                            },
                            {
                                "example_id": "dff1c357-2592-4c30-95bb-3b8ab8b33ced",
                                "sense_id": "95185bad-2828-3c16-8b74-7492dc9736f2",
                                "text": "„Emoticons, insbesondere Smileys, sind besonders augenfällig und lassen sich in den Freizeittexten überaus zahlreich und in verschiedenen Variationen belegen.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
