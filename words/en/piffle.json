{
    "word_family": [
        "piffler",
        "piffling"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "502797db-7f69-3b3f-acaf-b46accb99676",
                    "sense_definition": "Nonsense; foolish or trivial talk or ideas.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "nonsense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The entire argument presented by the opposition was dismissed as complete <w>piffle</w>.",
                            "target_lang_translations": {
                                "ru": "Весь аргумент, представленный оппозицией, был отвергнут как полнейшая <w>чепуха</w>."
                            }
                        },
                        {
                            "text": "Do not waste your time reading that article because it is utter <w>piffle</w>.",
                            "target_lang_translations": {
                                "ru": "Не тратьте время на чтение этой статьи, потому что это чистейший <w>вздор</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "balderdash",
                        "drivel",
                        "nonsense",
                        "poppycock",
                        "twaddle"
                    ],
                    "antonyms": [
                        "sense",
                        "wisdom"
                    ],
                    "common_phrases": [
                        "pure piffle",
                        "utter piffle"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Чепуха, ерунда; глупые, пустые или бессмысленные разговоры, идеи."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чепуха",
                                "target_lang_sense_clarification": "нечто бессмысленное, глупое"
                            },
                            {
                                "target_lang_word": "вздор",
                                "target_lang_sense_clarification": "несерьёзные слова, нелепица"
                            },
                            {
                                "target_lang_word": "ерунда",
                                "target_lang_sense_clarification": "пустяки, бессмыслица"
                            },
                            {
                                "target_lang_word": "болтовня",
                                "target_lang_sense_clarification": "пустой, никчёмный разговор"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0b4c42c1-af39-30a7-95d2-dca2c2b16acf",
                    "sense_definition": "To act or speak in a futile, ineffective, or foolish manner.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "nonsense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Stop <w>piffling</w> around and finish the report before the deadline expires.",
                            "target_lang_translations": {
                                "ru": "Хватит <w>заниматься ерундой</w> и допиши отчёт до истечения крайнего срока."
                            }
                        },
                        {
                            "text": "The politician continued to <w>piffle</w> on instead of answering the direct question.",
                            "target_lang_translations": {
                                "ru": "Политик продолжал <w>нести чушь</w> вместо того, чтобы ответить на прямой вопрос."
                            }
                        }
                    ],
                    "synonyms": [
                        "trifle",
                        "twaddle"
                    ],
                    "common_phrases": [
                        "piffle around",
                        "piffle on"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Заниматься ерундой, действовать или говорить неэффективно, попусту или глупо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нести чушь",
                                "target_lang_sense_clarification": "говорить бессмыслицу, ерунду"
                            },
                            {
                                "target_lang_word": "болтать вздор",
                                "target_lang_sense_clarification": "говорить глупости"
                            },
                            {
                                "target_lang_word": "заниматься ерундой",
                                "target_lang_sense_clarification": "тратить время на пустяки, валять дурака"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "263c0302-7040-30b2-b0f3-9b6595a3f862",
                    "sense_definition": "To waste or fritter away time or money.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "waste",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He managed to <w>piffle</w> away his entire inheritance on frivolous luxury items.",
                            "target_lang_translations": {
                                "ru": "Он умудрился <w>промотать</w> всё своё наследство на легкомысленные предметы роскоши."
                            }
                        },
                        {
                            "text": "We cannot afford to <w>piffle</w> away any more valuable hours on this task.",
                            "target_lang_translations": {
                                "ru": "Мы не можем позволить себе <w>тратить попусту</w> драгоценные часы на эту задачу."
                            }
                        }
                    ],
                    "synonyms": [
                        "fritter"
                    ],
                    "common_phrases": [
                        "piffle away"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Тратить впустую, транжирить (время или деньги)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "растрачивать",
                                "target_lang_sense_clarification": "без пользы расходовать деньги или ресурсы"
                            },
                            {
                                "target_lang_word": "транжирить",
                                "target_lang_sense_clarification": "безрассудно тратить деньги"
                            },
                            {
                                "target_lang_word": "проматывать",
                                "target_lang_sense_clarification": "растрачивать состояние или время попусту"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d4351306-a2df-3865-8dbc-5b880e205877",
                    "sense_definition": "To act squeamish, fastidious, or overly delicate.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She tended to <w>piffle</w> whenever she had to handle raw meat in the kitchen.",
                            "target_lang_translations": {
                                "ru": "Она обычно <w>брезговала</w>, когда ей приходилось иметь дело с сырым мясом на кухне."
                            }
                        },
                        {
                            "text": "Do not <w>piffle</w> at every minor inconvenience you encounter on the trail.",
                            "target_lang_translations": {
                                "ru": "Не <w>привередничай</w> из-за каждого мелкого неудобства, с которым сталкиваешься на маршруте."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "regional or dialectal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Брезговать, проявлять чрезмерную привередливость, щепетильность или жеманность."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "брезговать",
                                "target_lang_sense_clarification": "проявлять чувство брезгливости"
                            },
                            {
                                "target_lang_word": "жеманиться",
                                "target_lang_sense_clarification": "вести себя чересчур деликатно или капризно"
                            },
                            {
                                "target_lang_word": "привередничать",
                                "target_lang_sense_clarification": "быть излишне разборчивым"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}