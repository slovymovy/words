                "senses": [
                    {
                        "sense_id": "4d6f0d9f-ab4a-3d2f-ad10-39e781d5ea58",
                        "entry_id": "832cb023-00a8-3450-b8af-add39cae32be",
                        "glosses": [
                            "истор. сосуд для хранения и переноски небольших количеств пороха"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef6cbb1f-debe-437b-8483-1a06e9b7e190",
                                "sense_id": "4d6f0d9f-ab4a-3d2f-ad10-39e781d5ea58",
                                "text": "Все начали снаряжаться: пробовали сабли и палаши, насыпали порох из мешков в пороховницы, откатывали и становили возы и выбирали коней."
                            },
                            {
                                "example_id": "9dd7b99c-79d1-469d-a8fa-d120e825637d",
                                "sense_id": "4d6f0d9f-ab4a-3d2f-ad10-39e781d5ea58",
                                "text": "Пока он, кряхтя, укладывался, я снял с ремня лядунку, посыпал из пороховницы его рану и запалил трут."
                            }
                        ]
                    },
                    {
                        "sense_id": "ef0361b1-36be-323e-97bd-8b6975e0536e",
                        "entry_id": "832cb023-00a8-3450-b8af-add39cae32be",
                        "glosses": [
                            "воен. помещение для хранения пороха и иных взрывчатых веществ"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a76ccf36-b6f0-49f8-bf21-00bef307aa97",
                        "source_entry_id": "832cb023-00a8-3450-b8af-add39cae32be",
                        "source_sense_description": "сосуд",
                        "target_lang_word": "powder flask",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
