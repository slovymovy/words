                    }
                ],
                "translations": [
                    {
                        "translation_id": "ac229a70-9991-4b8d-be11-74f74da01cd4",
                        "source_entry_id": "9c2f8083-a419-3b71-bc3a-50e0edb8eb42",
                        "source_sense_id": "bd81214b-43a0-32f9-a6ed-45867e392cd3",
                        "source_sense_description": "sdÜ",
                        "target_lang_word": "Unart",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Unart",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "72e2b650-ef30-31ab-8d0d-ee263435433c",
                                        "entry_id": "dbc18842-fa71-3ccc-8cec-65bb663e6f44",
                                        "glosses": [
                                            "schlechte Eigenart, die sich negativ bei anderen bemerkbar macht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a18c97d-72e3-45e5-be17-e2f6c2ab8b9f",
                                                "sense_id": "72e2b650-ef30-31ab-8d0d-ee263435433c",
                                                "text": "„Christa hatte die Unart angenommen, während des Gesprächs Zeichnungen und Einfälle auf ein Stück Papier zu kritzeln, als ob sie ihre Gedanken mehr beschäftigten als die Unterhaltung.“"
                                            },
                                            {
                                                "example_id": "213248b9-1a99-434f-a665-e444a30fb6ff",
                                                "sense_id": "72e2b650-ef30-31ab-8d0d-ee263435433c",
                                                "text": "„Während des letzten halben Jahres hat sie nur noch über seine Sauferei und seine Unarten geredet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Unart",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2d436f19-0692-3235-8c01-736329916fa8",
                                        "entry_id": "33cebda7-37b0-3f3a-bbc8-63809aea713f",
                                        "glosses": [
                                            "nicht folgsames, nicht gehorchendes Kind"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "87cee0b8-5407-4fba-9db3-7a1e4a3fac09",
                                                "sense_id": "2d436f19-0692-3235-8c01-736329916fa8",
                                                "text": "„Der Unart hat verschiedene Briefe verschiedener Mitglieder dieses Hauses sehr unbeantwortet gelassen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8b7e49b4-2d66-4684-b685-d0edf7d16a1b",
                        "source_entry_id": "9c2f8083-a419-3b71-bc3a-50e0edb8eb42",
                        "source_sense_id": "bd81214b-43a0-32f9-a6ed-45867e392cd3",
                        "source_sense_description": "sdÜ",
                        "target_lang_word": "Unartigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "184a6a3e-9095-4c04-accf-bef84833f567",
                        "source_entry_id": "9c2f8083-a419-3b71-bc3a-50e0edb8eb42",
                        "source_sense_id": "bd81214b-43a0-32f9-a6ed-45867e392cd3",
                        "source_sense_description": "sdÜ",
                        "target_lang_word": "Ungezogenheit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ungezogenheit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ffc702b4-a46c-39c4-8c00-de08ea800d04",
                                        "entry_id": "512fbcab-3502-3ecd-af3f-0fc028f5a165",
                                        "glosses": [
                                            "Eigenschaft, ungezogen zu sein"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3aeab19b-5e85-38fd-b7f9-59344af4777c",
                                        "entry_id": "512fbcab-3502-3ecd-af3f-0fc028f5a165",
                                        "glosses": [
                                            "Verhalten, gesellschaftliche Regeln zu verletzen, sich ungezogen aufzuführen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6268363c-7f3b-4823-b08b-de7d8631b258",
                                                "sense_id": "3aeab19b-5e85-38fd-b7f9-59344af4777c",
                                                "text": "„Bald meinte sie, nach allem, was er für sie getan habe, könnte das als Ungezogenheit wirken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "468329ee-3b27-4e62-bbdf-deb9423bec49",
                        "source_entry_id": "9c2f8083-a419-3b71-bc3a-50e0edb8eb42",
                        "source_sense_id": "bd81214b-43a0-32f9-a6ed-45867e392cd3",
                        "source_sense_description": "sdÜ",
                        "target_lang_word": "Frechheit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Frechheit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "603139c8-be40-3439-a9a8-f1265e01a11c",
                                        "entry_id": "57f07cd0-688f-3fc6-913c-fb90208004cd",
                                        "glosses": [
                                            "freche Art; das Frechsein"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d28eb1e7-86ff-4e71-a32d-b1c46d6094b5",
                                                "sense_id": "603139c8-be40-3439-a9a8-f1265e01a11c",
                                                "text": "„Sie mochte wohl glauben, ihr Verhalten müsse mir als Geistesstärke, Charakterfestigkeit und hohes Vertrauen erscheinen, während ich es nur als maßlose Frechheit empfand.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c4a73a55-b252-31f7-b575-f0b7c6d7348b",
                                        "entry_id": "57f07cd0-688f-3fc6-913c-fb90208004cd",
                                        "glosses": [
                                            "eine respektlose, dreiste, freche Aussage oder Handlung; etwas Freches"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a962ed09-bd80-4c51-b6ec-e0d62ccff5bf",
                                                "sense_id": "c4a73a55-b252-31f7-b575-f0b7c6d7348b",
                                                "text": "Es ist eine Frechheit, dass Sie sich hier alle Liegestühle mit Handtüchern reservieren!"
                                            },
                                            {
                                                "example_id": "e2b6e524-d090-4f14-8a97-f43277adcc14",
                                                "sense_id": "c4a73a55-b252-31f7-b575-f0b7c6d7348b",
                                                "text": "„Als Pécuchet den Vorschlag machte, einen Klub zu gründen, hatte Foureu die Frechheit zu antworten, so was würde es niemals geben in Chavignolles.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a2d12fa7-c873-48c2-b175-5342201beb31",
                        "source_entry_id": "9c2f8083-a419-3b71-bc3a-50e0edb8eb42",
                        "source_sense_id": "bd81214b-43a0-32f9-a6ed-45867e392cd3",
                        "source_sense_description": "sdÜ",
                        "target_lang_word": "Dreistigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dreistigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6034831d-98a8-3e3e-91ec-45b8ba5df7b7",
                                        "entry_id": "07ea6311-6a7a-37e6-bda9-037e5cf9e3b4",
                                        "glosses": [
                                            "dreiste Art; das Dreistsein"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dd23e683-910d-4659-84ad-23387ca453da",
                                                "sense_id": "6034831d-98a8-3e3e-91ec-45b8ba5df7b7",
                                                "text": "Dreistigkeit siegt."
                                            },
                                            {
                                                "example_id": "3884112a-adbc-4a2e-955d-186d91a08dd1",
                                                "sense_id": "6034831d-98a8-3e3e-91ec-45b8ba5df7b7",
                                                "text": "Sie trat mit einer Dreistigkeit ohnegleichen auf."
                                            },
                                            {
                                                "example_id": "de5d9047-5178-4e28-9282-695a0636f2a8",
                                                "sense_id": "6034831d-98a8-3e3e-91ec-45b8ba5df7b7",
                                                "text": "Er besaß die Dreistigkeit, einfach den Raum zu verlassen."
                                            },
                                            {
                                                "example_id": "e6c52bef-6e72-4ff4-89f5-e3d4f6c4a9c6",
                                                "sense_id": "6034831d-98a8-3e3e-91ec-45b8ba5df7b7",
                                                "text": "„Ihre Dreistigkeit und ihr Selbstvertrauen gingen schließlich so weit, daß sie nicht mehr warteten, bis die Eltern die Wohnung verlassen hatten.“"
                                            },
                                            {
                                                "example_id": "431e2393-96e8-47c9-a82b-8a6f034ca7c3",
                                                "sense_id": "6034831d-98a8-3e3e-91ec-45b8ba5df7b7",
                                                "text": "„Bei der Erinnerung daran fing Jay laut an zu lachen über Sabinas Dreistigkeit.“"
                                            },
                                            {
                                                "example_id": "2dacb5bf-f11a-424a-9a44-fb993c983bce",
                                                "sense_id": "6034831d-98a8-3e3e-91ec-45b8ba5df7b7",
                                                "text": "„Die Bedeckung, die bei Tuchins Kanonen gestanden hatte, war auf irgendeinen von irgend jemand gegebenen Befehl hin zur Verwendung im Brennpunkt des Gefechts abmarschiert; aber die Batterie feuerte trotzdem weiter und wurde nur deshalb nicht von den Franzosen genommen, weil der Feind es sich nicht vorstellen konnte, dass vier gänzlich ungeschützte Kanonen die Dreistigkeit haben sollten, ihn in dieser Weise zu beschiessen.“"
                                            },
                                            {
                                                "example_id": "0a8b2bb1-4c0c-46dd-bc3b-d4913e145e57",
                                                "sense_id": "6034831d-98a8-3e3e-91ec-45b8ba5df7b7",
                                                "text": "„Er lud mich ein, jeden Donnerstag bei ihm zu Mittag zu speisen, und versprach mir, einen Janitscharen zu schicken, der mich vor der Dreistigkeit der Menge schützen und mir alles Sehenswerte zeigen würde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "fd17be70-5574-3e0d-95d1-0b33007a3648",
                                        "entry_id": "07ea6311-6a7a-37e6-bda9-037e5cf9e3b4",
                                        "glosses": [
                                            "dreiste Aussage oder Handlung; etwas Dreistes"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
