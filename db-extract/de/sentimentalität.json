                        "source_sense_id": "4bd52eab-d8f3-3b80-b7da-b771c0fb5e5a",
                        "source_sense_description": "ohne Plural, oft abwertend: zu große Empfindsamkeit",
                        "target_lang_word": "sentimentality",
