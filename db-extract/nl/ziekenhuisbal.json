                                "target_senses": [
                                    {
                                        "sense_id": "af920c0f-99a1-31ae-91f5-df14d4e16300",
                                        "entry_id": "1d5e044a-770d-3b6f-974d-63b49cebc357",
                                        "glosses": [
                                            "A pass (for schools, military, etc.) exempting one from regular activities, to instead visit a hospital for treatment"
                                        ],
                                        "tags": [
                                            "literally"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a9ed0027-6654-3ff0-893f-ad0ae873eaa4",
                                        "entry_id": "1d5e044a-770d-3b6f-974d-63b49cebc357",
                                        "glosses": [
                                            "A poorly executed pass to a team-mate, who is likely to lose the ball as a result. (Originally rugby union, where the recipient of a hospital pass is a sitting duck for a hard tackle.)"
                                        ],
                                        "tags": [
                                            "Australia",
                                            "British",
                                            "Ireland",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d055a40d-8224-4b17-b2f6-8ecff47b0264",
                                                "sense_id": "a9ed0027-6654-3ff0-893f-ad0ae873eaa4",
                                                "text": "His first touch was horrid – a hospital pass to Juliano Belletti – but from that moment on his eye-catching football was wonderful to witness."
                                            },
                                            {
                                                "example_id": "e050cd04-50da-460d-9226-3b6236a9e0a8",
                                                "sense_id": "a9ed0027-6654-3ff0-893f-ad0ae873eaa4",
                                                "text": "Flood popped out a careless off-load deep in the French 22 to allow a clearing kick to snuff out the danger, and when Nick Easter tried to rumble from deep within his own 22 his hospital pass to Tuilagi triggered another knock-on."
                                            },
                                            {
                                                "example_id": "4b2cd14e-ed63-4ada-bfe3-0fb77ef96f15",
                                                "sense_id": "a9ed0027-6654-3ff0-893f-ad0ae873eaa4",
                                                "text": "Brian Maguire is booked for the challenge on Leo McLoone, who was chasing a hospital pass from Mark McHugh."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3aafadf9-4451-347e-9437-ed2979dead94",
                                        "entry_id": "1d5e044a-770d-3b6f-974d-63b49cebc357",
                                        "glosses": [
                                            "a promotion or delegation which is likely to end in failure or ignominy; a poisoned chalice"
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dcd3a4d3-08c4-4030-a9ba-bf83fcb2d964",
                                                "sense_id": "3aafadf9-4451-347e-9437-ed2979dead94",
                                                "text": "Having identified a problem, he took no action to deal with it. Lacking the courage of our convictions, he gave a hospital pass to the Bank of England, which then had little option but to step in and raise interest rates"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1f8f3f34-201e-3199-9f93-fa44b9b4d42a",
                                        "entry_id": "1d5e044a-770d-3b6f-974d-63b49cebc357",
                                        "glosses": [
                                            "A throw that stays in the air long enough that it allows too many people to get underneath it, increasing the risk of injury and a trip to the hospital."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
