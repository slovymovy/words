                    {
                        "translation_id": "1a9bc3a9-3c3d-4f7b-9958-a552baa26206",
                        "source_entry_id": "c10d40d4-3e4b-38b0-89b1-a11104d28a9a",
                        "source_sense_id": "37b10dc6-a121-3c96-b801-a1f89309cb30",
                        "source_sense_description": "de goederen die in het ruim van een vrachtschip vervoerd worden",
                        "target_lang_word": "cargaison",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cargaison",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "852c6ed2-1c24-35ac-81f9-910adc9871fa",
                                        "entry_id": "795d124f-bd10-3418-98b3-76ebb5a183ff",
                                        "glosses": [
                                            "L’ensemble de toutes les marchandises qui composent la charge principale d’un navire, d'un train ou d'un camion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b028e585-1ae7-4c7c-9c2d-c6d14600955e",
                                                "sense_id": "852c6ed2-1c24-35ac-81f9-910adc9871fa",
                                                "text": "Nous prîmes un bâtiment dont la cargaison était fort riche. Le navire a péri, mais on a sauvé l’équipage et la cargaison."
                                            },
                                            {
                                                "example_id": "0d3fca50-2d3a-43a2-84bd-337fe39afadc",
                                                "sense_id": "852c6ed2-1c24-35ac-81f9-910adc9871fa",
                                                "text": "Alors que la première équipe parachevait l’assemblage extrêmement délicat de la machine sur la plateforme du site A, un second groupe était chargé de réceptionner sur les docks de la baie une cargaison très particulière."
                                            },
                                            {
                                                "example_id": "91c486b7-1bba-48b2-962e-6ade8046104f",
                                                "sense_id": "852c6ed2-1c24-35ac-81f9-910adc9871fa",
                                                "text": "Le véhicule roulait au ralenti et il avait piètre allure avec un pneu à plat, le pare-chocs tordu, la bâche protégeant sa cargaison soufflée par la bourrasque et emmêlée dans les amarres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b5c0cd38-3bf3-3bee-9065-91fa1a56f766",
                                        "entry_id": "795d124f-bd10-3418-98b3-76ebb5a183ff",
                                        "glosses": [
                                            "La valeur de ces marchandises."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d9c204d0-6220-396e-9411-3ce1fe5b0bfa",
                                        "entry_id": "795d124f-bd10-3418-98b3-76ebb5a183ff",
                                        "glosses": [
                                            "Temps de chargement de ces marchandises."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "dated",
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9dc4b069-53c3-496a-93fe-f433f99b7112",
                        "source_entry_id": "c10d40d4-3e4b-38b0-89b1-a11104d28a9a",
                        "source_sense_id": "37b10dc6-a121-3c96-b801-a1f89309cb30",
                        "source_sense_description": "de goederen die in het ruim van een vrachtschip vervoerd worden",
                        "target_lang_word": "chargement",
