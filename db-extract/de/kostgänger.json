                "senses": [
                    {
                        "sense_id": "f3a40097-feea-315a-8bdd-ca54c9a06753",
                        "entry_id": "6b13c7cd-dab6-3a93-a663-43d4a5329753",
                        "glosses": [
                            "Person, zumeist Untermieter, die über die Miete eines Zimmers oder einer Schlafstätte hinaus von dem sie aufnehmenden Vermieter beziehungsweise Hauptmieter auch verpflegt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "31cf4f41-ac3d-4c53-8e5f-86be13ff4496",
                                "sense_id": "f3a40097-feea-315a-8bdd-ca54c9a06753",
                                "text": "Die übrigen Hausgenossen, der Kostgänger, der Diener, Lehrjunge und Ausläufer sagten im Allgemeinen Dasselbe, was die Magd angegeben."
                            },
                            {
                                "example_id": "c06689ad-9f54-4b92-914c-d0d1ccb75605",
                                "sense_id": "f3a40097-feea-315a-8bdd-ca54c9a06753",
                                "text": "In Leeds fanden wir Brüder und Schwestern und Kostgänger beider Geschlechter, die dasselbe Schlafzimmer mit den Eltern teilten; daraus entstehen denn Folgen, vor deren Betrachtung das menschliche Gefühl zurückschaudert."
                            },
                            {
                                "example_id": "f762b4b1-895b-4021-b854-3f659385d348",
                                "sense_id": "f3a40097-feea-315a-8bdd-ca54c9a06753",
                                "text": "„Er lebte damals als Kostgänger in einem Kloster oberhalb von Rapallo.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "103074bd-dca1-3c7f-b36d-4d716085a4e4",
                        "entry_id": "6b13c7cd-dab6-3a93-a663-43d4a5329753",
                        "glosses": [
                            "Person, die sich aushalten lässt"
                        ],
                        "tags": [
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "235f623c-5f66-4949-b4bd-67946be65991",
                                "sense_id": "103074bd-dca1-3c7f-b36d-4d716085a4e4",
                                "text": "Er ging, und ich öffnete, sobald er draußen war, die Türe zum Nebenzimmer und rief meiner Frau zu: »Therese, das war wieder einer von denen, die weder säen noch ernten, und der himmlische Vater ernährt sie doch, hoffentlich bewahrt uns das Schicksal vor solchen Kostgängern bis zur nächsten Premiere!«"
                            },
                            {
                                "example_id": "6112201d-6f41-4a14-a25f-05cbb7903d89",
                                "sense_id": "103074bd-dca1-3c7f-b36d-4d716085a4e4",
                                "text": "Schon zuvor hatte Bismarck geklagt, das Reich sei zu einem \"Kostgänger der Einzelstaaten\" verkommen."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a510b9a2-b60f-49ef-bc97-2a3167ba5cf6",
                        "source_entry_id": "6b13c7cd-dab6-3a93-a663-43d4a5329753",
                        "source_sense_id": "f3a40097-feea-315a-8bdd-ca54c9a06753",
                        "target_lang_word": "boarder",
