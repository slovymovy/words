                                "target_senses": [
                                    {
                                        "sense_id": "4192eb2d-03b1-35bd-a16f-d921f8a0607a",
                                        "entry_id": "2b5c8915-98f3-3921-a8c6-96f91836e94f",
                                        "glosses": [
                                            "наречие к горький; имея горький, свойственный полыни, хине, горчице и т. п., вкус"
                                        ],
                                        "tags": [
                                            "adverb"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ba9f8fcf-74ce-3a9a-bbc3-04cc1cb69fe6",
                                        "entry_id": "2b5c8915-98f3-3921-a8c6-96f91836e94f",
                                        "glosses": [
                                            "сильно воздействуя на обоняние, на слизистую оболочку носа, рта"
                                        ],
                                        "tags": [
                                            "о запахе, дыме и т. п."
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0074a4bf-17ad-3645-b6bc-209137e215f3",
                                        "entry_id": "2b5c8915-98f3-3921-a8c6-96f91836e94f",
                                        "glosses": [
                                            "перен. преисполнившись горя, обид, разочарований, проникшись ими; тяжело, печально"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6366242d-2507-46ce-911e-a265c218eb41",
                                                "sense_id": "0074a4bf-17ad-3645-b6bc-209137e215f3",
                                                "text": "Лопухов возвратился домой даже опечаленный: горько было увидеть такую сторону в человеке, которого он так любил."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "79d5972e-b22a-3b3d-95ce-8b54f89f21b4",
                                        "entry_id": "2b5c8915-98f3-3921-a8c6-96f91836e94f",
                                        "glosses": [
                                            "выражая горе, печаль или свидетельствуя о них; горестно"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f027fea-c942-4225-984d-e0c952f35969",
                                                "sense_id": "79d5972e-b22a-3b3d-95ce-8b54f89f21b4",
                                                "text": "И долго я лежал неподвижно и плакал горько, не стараясь удерживать слёз и рыданий; я думал, грудь моя разорвётся; вся моя твёрдость, всё моё хладнокровие ― исчезли как дым."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3ff7e853-0e72-34ad-a82f-9b92d99859dc",
                                        "entry_id": "2b5c8915-98f3-3921-a8c6-96f91836e94f",
                                        "glosses": [
                                            "вызывая сильное огорчение, разочарование"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3273788-3450-4472-803c-29e88b84b494",
                                                "sense_id": "3ff7e853-0e72-34ad-a82f-9b92d99859dc",
                                                "text": "Я, к несчастью, дозволил себя убедить и имел потом причину горько в этом раскаиваться."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bdb6e054-3740-3940-867c-9f21bd5f57d0",
                                        "entry_id": "2b5c8915-98f3-3921-a8c6-96f91836e94f",
                                        "glosses": [
                                            "предик. об ощущении горечи, горького вкуса во рту"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "986ca635-18a8-3a35-8e6e-d4406795b2da",
                                        "entry_id": "2b5c8915-98f3-3921-a8c6-96f91836e94f",
                                        "glosses": [
                                            "предик. о чувстве горя, испытываемом кем-либо, о гнетущем состоянии, в котором находится кто-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "69e67baf-3bba-4aae-bcea-314d45d50048",
                                                "sense_id": "986ca635-18a8-3a35-8e6e-d4406795b2da",
                                                "text": "Я улыбался, потирал руки, удивлялся случаю, внезапно подтвердившему мои догадки (я ни на одно мгновение не усомнился в их справедливости), а между тем на сердце у меня было очень горько."
                                            },
                                            {
                                                "example_id": "83f14c56-b8a0-4370-9a34-fe1240f1a150",
                                                "sense_id": "986ca635-18a8-3a35-8e6e-d4406795b2da",
                                                "text": "То она стоит, осуждённая, так просто, удивительно просто; кругом сумасшедшие, ― их называют судьи, ― и мне становилось горько: никто из них не может понять, что с этим лицом и с этим голосом нельзя быть виноватой."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "27871f48-ef24-3eaf-8bd6-ef3e997f46d2",
                                        "entry_id": "2b5c8915-98f3-3921-a8c6-96f91836e94f",
                                        "glosses": [
                                            "разг. возглас гостей на свадьбе, призывающий молодых поцеловаться"
                                        ],
                                        "tags": [
                                            "межд."
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
