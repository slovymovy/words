                "senses": [
                    {
                        "sense_id": "d4a38a60-4d9e-3b1b-b117-5e43760d59da",
                        "entry_id": "7e5bbb7a-3166-31b3-9f0d-39409c9b2a35",
                        "glosses": [
                            "weibliches Verdingkind"
                        ],
                        "tags": [
                            "Swiss Standard German"
                        ],
                        "examples": [
                            {
                                "example_id": "22b08b83-4fc1-4b0c-83ef-ab30175a3a68",
                                "sense_id": "d4a38a60-4d9e-3b1b-b117-5e43760d59da",
                                "text": "„1864 machte sich auch die zehnjährige Regina das erste Mal für eine Saison als Verdingmädchen auf die Wanderschaft. Ihr Ziel war Berg, oberhalb Friedrichshafen, wo sie einige Saisons als Gänsemagd, Kindermädchen und Magd arbeitete. […]“"
                            },
                            {
                                "example_id": "e5c705a2-56f0-4c51-9ad7-c9fc53194d1e",
                                "sense_id": "d4a38a60-4d9e-3b1b-b117-5e43760d59da",
                                "text": "„Weiter berichtet Zullinger (1952) von einem Verdingmädchen von 15 1/2 Jahren, welches mit einem älteren Knecht mehrmals geschlechtlich verkehrte, worauf die Jugendanwaltschaft wissen möchte, ob die Jugendliche „dirnenhafte Wesenszüge zeige […]“.“"
                            },
                            {
                                "example_id": "e009d884-7b11-40ab-bdab-8b71a203fdc3",
                                "sense_id": "d4a38a60-4d9e-3b1b-b117-5e43760d59da",
                                "text": "„Ein von der täglichen Sklavenarbeit völlig erschöpftes dreizehnjähriges Verdingmädchen muss nachts auch noch den Säugling der Wirtsleute wiegen, bis Schlafbedürfnis und Tötungswunsch übermächtig werden: […]“"
                            },
                            {
                                "example_id": "cb372103-c5fb-49b0-96d7-0a5548f85d76",
                                "sense_id": "d4a38a60-4d9e-3b1b-b117-5e43760d59da",
                                "text": "„Das Herz krampfte sich ihm zusammen, wenn er sah, wie ein hustendes Männchen, mit dem Atem ringend, sich über den Haspel beugte, wie ein Verdingmädchen mit triefenden Augen die Fäden spannen mußte, […].“"
                            },
                            {
                                "example_id": "3923df78-c481-4883-8636-f3916ec89f25",
                                "sense_id": "d4a38a60-4d9e-3b1b-b117-5e43760d59da",
                                "text": "„Es war mein unabänderliches Schicksal, Dienstmädchen zu sein mein Leben lang, weil kein Mensch etwas anderes erwartete von einem unehelichen Verdingmädchen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
