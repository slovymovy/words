                        "glosses": [
                            "a northwestern German, especially Westphalian, kind of yeast-based pancake, comparable to a crumpet, traditionally eaten on Fridays, now especially on Good Friday"
                        ],
                        "tags": [
                            "feminine"
                        ],
                        "examples": [
