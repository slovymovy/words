                                        "sense_id": "2b54f5b4-2057-35b2-b407-157d58cbf165",
                                        "entry_id": "11b935b3-d8cc-33fb-bf3e-5e41ce25cfb2",
                                        "glosses": [
                                            "To express with great emotion."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4e306284-ee5e-4fa3-9879-699e517c0e98",
                                                "sense_id": "2b54f5b4-2057-35b2-b407-157d58cbf165",
                                                "text": "Thy niece and I, poor creatures, want our hands / And cannot passionate our tenfold grief / with folded arms."
