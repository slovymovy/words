                "senses": [
                    {
                        "sense_id": "d84d34c3-1281-38c6-ab2e-41b22a2999ec",
                        "entry_id": "68f947a0-1d4c-337e-a813-b1d23b5422c0",
                        "glosses": [
                            "katalanischsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "89eb786c-2dd5-4373-afbb-17448c90ad75",
                                "sense_id": "d84d34c3-1281-38c6-ab2e-41b22a2999ec",
                                "text": "Frau Puigdemont ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "625cc6fc-ac12-454f-b412-4d3a9043439d",
                                "sense_id": "d84d34c3-1281-38c6-ab2e-41b22a2999ec",
                                "text": "Herr Puigdemont wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "035231ef-d262-46c1-a282-294491fde394",
                                "sense_id": "d84d34c3-1281-38c6-ab2e-41b22a2999ec",
                                "text": "Die Puigdemonts fahren heute nach Rotterdam."
                            },
                            {
                                "example_id": "d6d42acf-0121-433a-833c-7b2079677257",
                                "sense_id": "d84d34c3-1281-38c6-ab2e-41b22a2999ec",
                                "text": "Der Puigdemont trägt nie die Pullover, die die Puigdemont ihm strickt."
                            },
                            {
                                "example_id": "58f9b6a2-78fb-478c-853b-aa81079f6834",
                                "sense_id": "d84d34c3-1281-38c6-ab2e-41b22a2999ec",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Puigdemont kommt, geht der Herr Puigdemont.“"
                            },
                            {
                                "example_id": "afafb14d-cab1-4c0b-bc8f-2866120f0ac4",
                                "sense_id": "d84d34c3-1281-38c6-ab2e-41b22a2999ec",
                                "text": "Puigdemont kommt und geht."
                            },
                            {
                                "example_id": "a7bd220c-3b39-4dfb-ba4a-b33e06f25666",
                                "sense_id": "d84d34c3-1281-38c6-ab2e-41b22a2999ec",
                                "text": "Puigdemonts kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
