                {
                    "sense_id": "1d71efea-a1e3-35c9-ab92-96ec97dd1a01",
                    "sense_definition": "Given or bestowed as a gift or gratuity rather than earned.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "gift",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The institution relied heavily on <w>beneficiary</w> gifts from wealthy patrons.",
                            "target_lang_translations": {
                                "ru": "Учреждение сильно зависело от <w>благотворительных</w> пожертвований богатых покровителей.",
                                "tr": "Kurum, büyük ölçüde zengin hamilerden gelen <w>bağış niteliğindeki</w> hediyelere dayanıyordu."
                            }
                        },
                        {
                            "text": "These <w>beneficiary</w> payments were distributed to the poor during the festival.",
                            "target_lang_translations": {
                                "ru": "Эти <w>безвозмездные</w> выплаты распределялись среди бедных во время фестиваля.",
                                "tr": "Bu <w>karşılıksız</w> ödemeler festival sırasında yoksullara dağıtıldı."
                            }
