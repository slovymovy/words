                                        "glosses": [
                                            "een in het Zuid-Frankrijk van weleer, langs kastelen en vorstenhoven rondreizend kunstenaar, musicus, zanger van liederen en voordrager van gedichten, balladen e.d."
                                        ],
                                        "tags": [
                                            "Middle-Ages",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "96494f0d-b2e9-4512-9625-f29f234885c4",
                                                "sense_id": "29cdfd02-121c-35fa-9f2d-eddc2b0d0059",
                                                "text": "De onbekende speelman maakte met z'n voordracht een diepe indruk op de gasten."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7b2e1763-04b1-36cd-8c97-dc4374a61a24",
                                        "entry_id": "e78d7646-a1e4-3364-807e-b42a4f09afe3",
                                        "glosses": [
                                            "een langs herbergen, jaarmarkten rondtrekkend artiest, muzikant, zanger van liedjes en komediant"
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cc632110-21fd-4ca5-ac79-69acbecfd317",
                                                "sense_id": "7b2e1763-04b1-36cd-8c97-dc4374a61a24",
                                                "text": "Met z'n grappen en vrolijke wijsjes bracht de speelman het publiek in een uitgelaten stemming."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e3520c25-bdb1-4f59-aca6-92efab2c16d5",
                        "source_entry_id": "be0ba445-8119-3183-8294-624a291db156",
                        "source_sense_description": "one who plays the fiddle",
                        "target_lang_word": "Geiger",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Geiger",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c20267b3-9dba-30e2-9763-520d56fb8186",
                                        "entry_id": "3fb22f66-8cb1-3597-bb90-269c2c0c2ab3",
                                        "glosses": [
                                            "Person, die Geige spielt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dbddc30e-48f5-4901-a44c-2581115fde44",
                                                "sense_id": "c20267b3-9dba-30e2-9763-520d56fb8186",
                                                "text": "Ihnen fehlt noch ein guter Geiger."
                                            },
                                            {
                                                "example_id": "d21385b3-a96a-4ca1-9100-129f1511c8c8",
                                                "sense_id": "c20267b3-9dba-30e2-9763-520d56fb8186",
                                                "text": "„Ihr Vater war ein jüdischer Geiger aus Prag, der Anfang der 30er Jahre erfolgreich in Berlin tätig war, Deutschland aber 1935 verlassen musste.“"
                                            },
                                            {
                                                "example_id": "c18b3c0f-7245-4b99-9681-c2a72f347c38",
                                                "sense_id": "c20267b3-9dba-30e2-9763-520d56fb8186",
                                                "text": "„Serana hatte zu der Zeit einen Geiger zur Seite, einen jener unwirklichen Bewohner der Pußta, der ungarischen Flachlandschaften, wo zu allen Zeiten die jungen Herren aufbrechen, um die Welt kennenzulernen, und nie kehren sie nach Hause zurück.“"
                                            },
                                            {
                                                "example_id": "d53675ae-ea3a-4bfb-ab19-24bade0d6b2e",
                                                "sense_id": "c20267b3-9dba-30e2-9763-520d56fb8186",
                                                "text": "„In weniger als acht Tagen stand ich ohne einen Soldo da; da entschloß ich mich, Geiger zu werden.“"
                                            },
                                            {
                                                "example_id": "bba0c4f8-337e-41f5-b1e8-1885fff2d6db",
                                                "sense_id": "c20267b3-9dba-30e2-9763-520d56fb8186",
                                                "text": "„Als der Geiger in der sinkenden Nacht eine Romanze spielte, stieg ihr eine Weichheit aus dem Atem in die Stirn, daß die Augen schwer wurden vor plötzlich dahinter stehenden Tränen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Geiger",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4f93c5b1-72af-3355-a46e-68940a8ac4f0",
                                        "entry_id": "954f8977-3f17-366c-b28b-0bab387be220",
                                        "glosses": [
                                            "deutscher Nachname, Familienname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "faea2517-90dd-456b-9b61-1f62e49bcd1c",
                                                "sense_id": "4f93c5b1-72af-3355-a46e-68940a8ac4f0",
                                                "text": "Frau Geiger ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "65eceb9c-603e-406f-bf0e-872e9c07a172",
                                                "sense_id": "4f93c5b1-72af-3355-a46e-68940a8ac4f0",
                                                "text": "Herr Geiger wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "f684289a-71cc-426d-b98d-e8f64c6a30f3",
                                                "sense_id": "4f93c5b1-72af-3355-a46e-68940a8ac4f0",
                                                "text": "Die Geigers fliegen heute nach La Paz."
                                            },
                                            {
                                                "example_id": "c9817563-9624-4ef4-a51a-969cbb805973",
                                                "sense_id": "4f93c5b1-72af-3355-a46e-68940a8ac4f0",
                                                "text": "Der Geiger trägt nie die Schals, die die Geiger ihm strickt."
                                            },
                                            {
                                                "example_id": "c71c600b-7f23-4a08-a91b-a2fcdb1cc76f",
                                                "sense_id": "4f93c5b1-72af-3355-a46e-68940a8ac4f0",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Geiger kommt, geht der Herr Geiger.“"
                                            },
                                            {
                                                "example_id": "c59d2695-ccb9-41fd-95dc-c476c33b7cc5",
                                                "sense_id": "4f93c5b1-72af-3355-a46e-68940a8ac4f0",
                                                "text": "Geiger kommt und geht."
                                            },
                                            {
                                                "example_id": "758142f2-7cfb-47ce-83ce-91a202d0b325",
                                                "sense_id": "4f93c5b1-72af-3355-a46e-68940a8ac4f0",
                                                "text": "Geigers kamen, sahen und siegten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
