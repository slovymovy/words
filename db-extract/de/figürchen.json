                ],
                "senses": [
                    {
                        "sense_id": "366bb056-c5fc-36d1-8ab1-4bd522909329",
                        "entry_id": "624b2c67-09cf-3e83-8a53-932e09d795e7",
                        "glosses": [
                            "kleine Figur"
                        ],
                        "tags": [
                            "diminutive"
                        ],
                        "examples": [
                            {
                                "example_id": "2efad3d6-b700-400a-bb16-8d8b4d4bf197",
                                "sense_id": "366bb056-c5fc-36d1-8ab1-4bd522909329",
                                "text": "Ich habe dieses schöne Figürchen selber gestaltet."
                            },
                            {
                                "example_id": "0d407ddd-3e8b-4636-875a-d097c7c45665",
                                "sense_id": "366bb056-c5fc-36d1-8ab1-4bd522909329",
                                "text": "„Er könne sich vorstellen, dass die Polizei das Figürchen für gefährlich gehalten habe, sagt ein ehemaliger Schüler.“"
                            },
                            {
                                "example_id": "0036b9ec-e701-4b85-b2a9-bca105bb4642",
                                "sense_id": "366bb056-c5fc-36d1-8ab1-4bd522909329",
                                "text": "„Auf der rechten Körperseite des Figürchens (Abb.2) ist die Oberfläche beschädigt, das rechte Bein und der Fuß sind abgebrochen und fehlen ganz.“"
                            },
                            {
                                "example_id": "3c7a71e3-591e-44ba-ab59-4551271e1380",
                                "sense_id": "366bb056-c5fc-36d1-8ab1-4bd522909329",
                                "text": "„Oft fertigten die Beschwörer Figürchen der Dämonen an und stellten ihnen Gaben und Speisen hin, damit sie davon äßen und sich – nachdem ihr Hunger gestillt war – nicht mehr an dem Menschen vergriffen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "ed7418d4-3272-3753-87f5-3b34b3a09b1e",
                        "entry_id": "624b2c67-09cf-3e83-8a53-932e09d795e7",
                        "glosses": [
                            "ansprechender Körperbau"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e53054f6-3340-4027-8759-2372db4b370b",
                                "sense_id": "ed7418d4-3272-3753-87f5-3b34b3a09b1e",
                                "text": "„Du hattest doch immer so ein nettes Figürchen.“"
                            },
                            {
                                "example_id": "bbca39b5-446e-44b9-89d3-1ac2a5e4bc69",
                                "sense_id": "ed7418d4-3272-3753-87f5-3b34b3a09b1e",
                                "text": "„Die junge Dame besaß ein hübsches Figürchen, hübsche Stiefelchen und ein hübsches Sonnenschirmchen.“"
                            },
                            {
                                "example_id": "3eef1fe7-c760-401e-9e6b-dc255d758219",
                                "sense_id": "ed7418d4-3272-3753-87f5-3b34b3a09b1e",
                                "text": "„»Ihre Cousine hat ja ein tolles Figürchen, Lucy«, bemerkte er.“"
                            },
                            {
                                "example_id": "556d126c-3501-4550-b837-d9bf61e18987",
                                "sense_id": "ed7418d4-3272-3753-87f5-3b34b3a09b1e",
                                "text": "„Sie rief über den Kopf des Mädchens der Tochter zu, die ihr Figürchen vor dem Stehspiegel wippen ließ.“"
                            },
                            {
                                "example_id": "8bedae78-4471-4c9e-9a50-ba8da07712a4",
                                "sense_id": "ed7418d4-3272-3753-87f5-3b34b3a09b1e",
                                "text": "„Ihr Figürchen straffte sich, wurde größer vor dem Gestrüpp von Jasmin- und Fliederbüschen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
