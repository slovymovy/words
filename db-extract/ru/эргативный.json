                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "a7d0b758-f89d-47d5-a581-2c499c9288da",
                        "source_entry_id": "a440f978-6a0c-34b4-85fa-f902d559bb4a",
                        "source_sense_id": "a30e2224-aacc-3836-b1a9-20db0cf309d0",
                        "target_lang_word": "Ergativ",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ergativ",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "69bf77dd-701b-331d-99c0-d1146a7171a2",
                                        "entry_id": "c2327473-023e-39f4-a48f-141c36208a98",
                                        "glosses": [
                                            "Kasus des Agens transitiver Verben in Ergativsprachen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc916efe-d87a-47ce-91d6-5e1fc52d7323",
                                                "sense_id": "69bf77dd-701b-331d-99c0-d1146a7171a2",
                                                "text": "„Der Ergativ ist der Kasus des Agens-Arguments in transitiven Sätzen, wenn das einzige Argument in intransitiven Sätzen mit demselben Kasus wie das Patiens-Argument in transitiven Sätzen markiert wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3047ade5-55a4-3936-8340-b1684ac28d8f",
