                        "examples": [
                            {
                                "example_id": "68ec4f72-f9d1-4abd-ae96-664409a27f23",
                                "sense_id": "fdc8f1fa-c8a5-3a87-8d04-c0e39bdd8cf5",
                                "text": "Het is weer de achtenzeventig die het niet doet, kunnen we die niet simpel vervangen?"
                            },
                            {
                                "example_id": "17a6b20e-aa85-44da-b331-a949e02ad71b",
                                "sense_id": "fdc8f1fa-c8a5-3a87-8d04-c0e39bdd8cf5",
                                "text": "Haar negenenzeventigste verjaardag was een belangrijk moment, want haar leven werd heel anders toen ze de achtenzeventig eenmaal voorbij was."
                            }
                        ]
                    },
                    {
                        "sense_id": "2504332b-9608-3796-89e1-b20f556f19ea",
                        "entry_id": "0fe73798-a330-3d4d-a838-dc7be6cb8c18",
                        "glosses": [
                            "groep van 78 eenheden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef745d20-2db2-41fc-a8fa-982e7e9fe4d2",
                                "sense_id": "2504332b-9608-3796-89e1-b20f556f19ea",
                                "text": "De achtenzeventig zijn natuurlijk blij, maar laten we ook denken aan het verdriet van de vier die zijn afgewezen."
                            }
                        ]
                    }
                ],
