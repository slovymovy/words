                "senses": [
                    {
                        "sense_id": "eb8b7560-1298-3eb7-ad88-2b6568683b95",
                        "entry_id": "1cc0df3b-d55b-37a9-bc45-8bf4fae0516e",
                        "glosses": [
                            "gleichzeitiger Durchlass mehrerer Fahrzeuge in einer Fahrtrichtung, während die Gegenseite warten muss"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "09d13321-7883-4e85-b744-4a8e5e997e03",
                                "sense_id": "eb8b7560-1298-3eb7-ad88-2b6568683b95",
                                "text": "„Vorliegend blieb unbestritten, dass die Beschuldigte zur vorgeworfenen Tatzeit an der auf der Gasteiner Bundesstraße in Fahrtrichtung Bad Gastein am rechten Fahrstreifen im Zuge einer Blockabfertigung wartenden Fahrzeugkolonne vorbeigefahren ist.“"
                            },
                            {
                                "example_id": "6a6e6fa9-b426-46ef-9830-3fa188143337",
                                "sense_id": "eb8b7560-1298-3eb7-ad88-2b6568683b95",
                                "text": "„Die Landesregierung in Tirol hat wieder eine ihrer umstrittenen Blockabfertigungen angekündigt.“"
                            },
                            {
                                "example_id": "bcb08eda-4228-4a30-94eb-d28cb376f9f3",
                                "sense_id": "eb8b7560-1298-3eb7-ad88-2b6568683b95",
                                "text": "„Tirol will diese Zahl mit diversen Maßnahmen wie etwa Blockabfertigungen senken, was wiederum von Deutschland kritisiert wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
