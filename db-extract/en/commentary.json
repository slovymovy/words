                        ]
                    },
                    {
                        "sense_id": "891c4b07-6595-3cf1-8913-baca128e4ab0",
                        "entry_id": "708ba272-e678-3f34-861a-decfa954aeca",
                        "glosses": [
                            "An oral relation of an event, especially broadcast by television or radio, as it occurs."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "2c98ea51-6b4c-4811-9666-1b5482fcc904",
                                "sense_id": "891c4b07-6595-3cf1-8913-baca128e4ab0",
                                "text": "We listened to the football commentary while watching the match."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cc68e557-fdfc-4d31-bd33-1d76af72f9dd",
                        "source_entry_id": "708ba272-e678-3f34-861a-decfa954aeca",
                        "source_sense_description": "A series of comments or annotations",
                        "target_lang_word": "Kommentar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kommentar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2600f921-a313-3f35-b282-0b4e2aa7649f",
                                        "entry_id": "746c8468-4ec0-321c-856a-419f7f0225ea",
                                        "glosses": [
                                            "nähere Erläuterung eines Sachverhaltes von einem bestimmten Standpunkt aus, Auslegung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "09e3f33e-df0a-417b-bd09-f2bc99ddb98d",
                                                "sense_id": "2600f921-a313-3f35-b282-0b4e2aa7649f",
                                                "text": "Dein Kommentar ist jetzt aber überflüssig."
                                            },
                                            {
                                                "example_id": "55ade896-7c98-4783-94b3-ba7af6ed820d",
                                                "sense_id": "2600f921-a313-3f35-b282-0b4e2aa7649f",
                                                "text": "„Grenfeld hatte die bösartigsten Kommentare auf der Zunge, doch um ihretwillen beherrschte er sich.“"
                                            },
                                            {
                                                "example_id": "5a3d4c39-e618-4cf3-89e1-93d1da75d066",
                                                "sense_id": "2600f921-a313-3f35-b282-0b4e2aa7649f",
                                                "text": "„Wir wissen nicht, ob die in Raschis Kommentaren vorhandenen jiddischen Glossen von ihm selbst stammen oder von seinen Schülern, die an der Niederschrift beteiligt waren.“"
                                            },
                                            {
                                                "example_id": "6a363941-412d-488a-86c3-cf57f72c2495",
                                                "sense_id": "2600f921-a313-3f35-b282-0b4e2aa7649f",
                                                "text": "„Letzteres beruht darauf, dass sich der Autor bei den Beschreibungen der Kriegsgräuel eines Kommentars enthält.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7ad3df1e-bbbf-340f-a788-cbeccb5be510",
                                        "entry_id": "746c8468-4ec0-321c-856a-419f7f0225ea",
                                        "glosses": [
                                            "bewertende Darstellung in Form von Artikeln, Kolumnen, erläuternden Beiträgen in Rundfunk und Fernsehen durch Kommentatoren"
                                        ],
                                        "tags": [
                                            "jargon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b0ffc532-460a-4dc4-b0e5-00004d0cc796",
                                                "sense_id": "7ad3df1e-bbbf-340f-a788-cbeccb5be510",
                                                "text": "Der Kommentar in der FAZ war meiner Meinung nach etwas übertrieben."
                                            },
                                            {
                                                "example_id": "b2fe32aa-f0ad-4f79-b76c-4710775c9ee6",
                                                "sense_id": "7ad3df1e-bbbf-340f-a788-cbeccb5be510",
                                                "text": "„Vereinfachend könnte man feststellen, daß in Nachrichten eine deskriptive und in Kommentaren eine argumentative Themenbehandlung zu beobachten ist.“"
                                            },
                                            {
                                                "example_id": "59b84f26-8df1-4e19-b262-bc8f35049c59",
                                                "sense_id": "7ad3df1e-bbbf-340f-a788-cbeccb5be510",
                                                "text": "„Trotz solcher Kommentare in traditionell eher regierungsskeptischen Blättern stand aber noch keineswegs fest, dass das deutsche Volk tatsächlich mehrheitlich dem Ruf des Reiches folgen und willig kämpfen würde.“"
                                            },
                                            {
                                                "example_id": "3296226d-8241-49c3-a31a-c80df20d24fa",
                                                "sense_id": "7ad3df1e-bbbf-340f-a788-cbeccb5be510",
                                                "text": "„Der »Merkur« sollte Nachrichten bringen, Kommentare, Berichte aller Arten, besonders Reiseberichte, Informationen über die Entwicklung der Technik, der Wissenschaften, der politischen Ereignisse in der Welt.“"
                                            },
                                            {
                                                "example_id": "4f9aff24-30b0-4f50-87e4-04a0b4e02c7e",
                                                "sense_id": "7ad3df1e-bbbf-340f-a788-cbeccb5be510",
                                                "text": "„Im anschließenden Kommentar wird festgestellt, dass die Bombardierung der chinesischen Botschaft zu einem Zeitpunkt erfolgt sei, als Präsident Clinton mit Russland, europäischen Ländern und UN-Generalsekretär Kofi Annan intensiv an einer diplomatischen Lösung des Balkankriegs gearbeitet habe.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "13280bf0-bb21-398e-8fc0-cb1b323b80f5",
                                        "entry_id": "746c8468-4ec0-321c-856a-419f7f0225ea",
                                        "glosses": [
                                            "Zeichenketten im Programmcode, die bei der Übersetzung des Programms ignoriert werden, sie dienen dem Verständnis des Programmcodes und werden auch für die Angabe zusätzlicher Informationen niedergeschrieben"
                                        ],
                                        "tags": [
                                            "jargon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "669152d6-6fa9-480f-9963-df179891a848",
                                                "sense_id": "13280bf0-bb21-398e-8fc0-cb1b323b80f5",
                                                "text": "Die Programmierer sind angehalten, ihre Programme mit Kommentaren zu versehen, damit ihre Kollegen später leichter Änderungen am Code vornehmen können."
                                            },
                                            {
                                                "example_id": "524c0031-de32-482b-98b4-89f11f11c67f",
                                                "sense_id": "13280bf0-bb21-398e-8fc0-cb1b323b80f5",
                                                "text": "„Kommentare dienen dazu, den Quelltext für den Menschen leichter verständlich zu machen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
