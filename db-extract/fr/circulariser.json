                "senses": [
                    {
                        "sense_id": "c1720e4c-b3f5-3cf8-9851-ac9dcc5c5ae4",
                        "entry_id": "30c39cd8-17a6-31be-8738-858d26da5bf1",
                        "glosses": [
                            "Rendre circulaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b7fb028-791b-4993-bece-2225bc621a2a",
                                "sense_id": "c1720e4c-b3f5-3cf8-9851-ac9dcc5c5ae4",
                                "text": "Les satellites d'application sont munis de moteurs d'appoint qui circularisent l’orbite et la rendent géostationnaire."
                            },
                            {
                                "example_id": "8394c8d4-d9a2-484b-a489-437a8168b0be",
                                "sense_id": "c1720e4c-b3f5-3cf8-9851-ac9dcc5c5ae4",
                                "text": "Il apparait ainsi, que dans ce cas, l’excentricité e des planètes subit des variations périodiques, de sorte que les corps en présence ont des trajectoires dont la forme varient périodiquement, autrement dit leur orbite se circularisent un peu pour se décirculariser après et en général ces variations sont faibles (c’est le cas lune-terre-soleil)."
                            }
                        ]
                    }
                ],
