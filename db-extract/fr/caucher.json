                "senses": [
                    {
                        "sense_id": "3117f713-b5e4-3421-99bd-721ecdbc2972",
                        "entry_id": "1d2cf4b3-b1af-3e56-8712-1e911c2d484a",
                        "glosses": [
                            "Cahier de vélin ou de parchemin servant à battre les feuilles d'or au marteau une fois mis dans un fourreau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2dad0d6a-7432-456b-9d0b-a90bf8f02456",
                                "sense_id": "3117f713-b5e4-3421-99bd-721ecdbc2972",
                                "text": "Un autre ouvrier, muni d'un marteau plat pesant 5 kilogrammes, va battre alors le caucher dont les feuilles s'égaliseront en quelques minutes sous ses coups."
                            },
                            {
                                "example_id": "d6b74cd9-0fa8-420f-bb5c-763e7420473f",
                                "sense_id": "3117f713-b5e4-3421-99bd-721ecdbc2972",
                                "text": "… ensuite ils sont placés dans un premier outil appelé premier caucher. Cet outil est composé de 160 feuilles de vélin ou de papier parcheminé ayant 108 millimètres de côté."
                            }
                        ]
                    },
                    {
                        "sense_id": "f8aa7f8d-9589-32ed-9a2d-a9787e8b26f0",
                        "entry_id": "1d2cf4b3-b1af-3e56-8712-1e911c2d484a",
                        "glosses": [
                            "Cahier de feuilles de vélin où les doreurs rangent les feuilles d’or, il à généralement de 8 à 10cm de coté."
                        ],
