                                    },
                                    {
                                        "sense_id": "b4f3ea01-e8a9-322c-8c12-4fa00d628d7b",
                                        "entry_id": "d4319739-eb64-3afc-8bb1-1988ac63a433",
                                        "glosses": [
                                            "Dans une paroisse, église succursale desservie par un vicaire ^([2])."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f77b94f6-376a-47b7-a8dd-82fc993d39ed",
                                                "sense_id": "b4f3ea01-e8a9-322c-8c12-4fa00d628d7b",
                                                "text": "La châtellenie de Niort absorba plus ou moins complètement le ressort de la vicairie de Bessac et Bessac donna naissance à un faubourg de Niort (45)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "28ec249d-124d-3106-92f0-0a0ff9cf0b24",
                                        "entry_id": "d4319739-eb64-3afc-8bb1-1988ac63a433",
                                        "glosses": [
                                            "Bénéfice attaché à certaines églises cathédrale ^([3])."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
