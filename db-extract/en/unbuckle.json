                                "target_senses": [
                                    {
                                        "sense_id": "ef2b6687-e899-3d2f-a73d-51d1f059f51c",
                                        "entry_id": "5604d3e0-af77-3172-aa0e-929f71dce1e8",
                                        "glosses": [
                                            "Dégager de ce qui boucle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "30821893-192b-47ad-9787-984830266d96",
                                                "sense_id": "ef2b6687-e899-3d2f-a73d-51d1f059f51c",
                                                "text": "Déboucler un ceinturon."
                                            },
                                            {
                                                "example_id": "c299cb45-52ab-4dfc-9641-ee33bad3631a",
                                                "sense_id": "ef2b6687-e899-3d2f-a73d-51d1f059f51c",
                                                "text": "Déboucler une cuirasse."
                                            },
                                            {
                                                "example_id": "1131d092-f440-41ab-b618-49074528a834",
                                                "sense_id": "ef2b6687-e899-3d2f-a73d-51d1f059f51c",
                                                "text": "Déboucler des souliers."
                                            },
                                            {
                                                "example_id": "11fe32f6-12ad-4fad-aaff-de6e838faa47",
                                                "sense_id": "ef2b6687-e899-3d2f-a73d-51d1f059f51c",
                                                "text": "Ma ceinture s’est débouclée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "76188591-3545-33b5-a3a7-fa47799cfce7",
                                        "entry_id": "5604d3e0-af77-3172-aa0e-929f71dce1e8",
                                        "glosses": [
                                            "Dégarnir de ses boucles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "285a4381-54d6-4acf-b088-7ce66eeb9302",
                                                "sense_id": "76188591-3545-33b5-a3a7-fa47799cfce7",
                                                "text": "Les cheveux du Bressan, débouclés par la pluie, lui collaient au front."
                                            },
                                            {
                                                "example_id": "2b3c0dee-eeb9-4e17-bec2-7a139c1670af",
                                                "sense_id": "76188591-3545-33b5-a3a7-fa47799cfce7",
                                                "text": "Déboucler des cheveux."
                                            },
                                            {
                                                "example_id": "b026ef10-e25c-44b9-b891-0364f12ba05c",
                                                "sense_id": "76188591-3545-33b5-a3a7-fa47799cfce7",
                                                "text": "Sa chevelure s’est toute débouclée."
                                            },
                                            {
                                                "example_id": "8bee056c-d78e-46df-ac47-a9b73fe21dbb",
                                                "sense_id": "76188591-3545-33b5-a3a7-fa47799cfce7",
                                                "text": "Il était là depuis vingt minutes ; la neige fraîche emplissait ses sabots ; le vent soufflait dans sa jaquette et lui faisait arrondir le dos ; la philosophie schématique faisait courir dans ses cheveux un frisson qui les débouclait au-dessus de ses lunettes ; avec les basques de sa jaquette, on eût dit un gros hanneton."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "19defd10-d89e-3987-a821-08052055dd3d",
                                        "entry_id": "5604d3e0-af77-3172-aa0e-929f71dce1e8",
                                        "glosses": [
                                            "Fermer en raison des congés."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0fd3eb6c-d4aa-4078-8a82-e4cb6415f5f2",
                                                "sense_id": "19defd10-d89e-3987-a821-08052055dd3d",
                                                "text": "Gontran. — Je dis : mon four-à-bac fait relâche ! autrement dit : mon institution est en congé.\nMoricet. — Ah ! bon ! c’est qu’aussi vous avez un argot : \"Mon four-à-bac fait relâche\", qu’est-ce que ça veut dire !… De mon temps, nous, nous disions \"la guimbarde déboucle\"… tout simplement.\nGontran, pirouettant pour gagner l’extrême gauche. — Qu’est-ce que vos voulez ! Ce sont les évolutions de la langue française."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
