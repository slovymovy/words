                "senses": [
                    {
                        "sense_id": "f972cf67-eb25-3e5f-ba47-0be59ac8a068",
                        "entry_id": "c8f5b64c-18ce-381e-80bf-28a1da1298e1",
                        "glosses": [
                            "Sortir du silo."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "701e7b92-7dc2-40ee-85bb-d2df5150baa4",
                                "sense_id": "f972cf67-eb25-3e5f-ba47-0be59ac8a068",
                                "text": "Pour désensiler, ayant chassé les goupilles, on retire deux ou trois planches (au-dessus de la porte, quand il en existe une) ; ensuite on rétablit la pression sur la partie restant couverte, et on retire le silage du haut en bas."
                            },
                            {
                                "example_id": "bfd62a80-dde5-4b37-be37-cb7666f7733b",
                                "sense_id": "f972cf67-eb25-3e5f-ba47-0be59ac8a068",
                                "text": "Des portes à coulisses EE, pour l’introduction du grain, présentent de plus petites ouvertures pour désensiler le blé, lorsque, par la rotation du tambour, on les amène à la partie inférieure de l’appareil."
                            }
                        ]
                    }
                ],
