                        "entry_id": "ce1c0290-4469-3ea8-8b3c-4bfe119a1c20",
                        "glosses": [
                            "Royaume de la péninsule Ibérique durant la période médiévale, plus tard intégré à la couronne de Castille."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "515d5a56-c2a5-4869-9a9a-c534573dc301",
                                "sense_id": "c65a7081-91ea-36f2-b75a-b14d58244667",
                                "text": "La cour célébrait les noces de madame Marguerite de Valois, fille du roi Henri II et sœur du roi Charles IX, avec Henri de Bourbon, roi de Navarre."
                            }
                        ]
                    },
                    {
                        "sense_id": "8894a39d-0c5a-36d8-82bd-ad0d2f9408ed",
