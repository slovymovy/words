                    {
                        "translation_id": "242a0623-cc67-44c6-997f-5d33b7ec51c5",
                        "source_entry_id": "fd13a51c-bc3d-3d5e-9a00-bc4c122cd577",
                        "source_sense_id": "02018875-3418-3a57-836e-0714ee056f65",
                        "source_sense_description": "male given name",
                        "target_lang_word": "Δημήτριος",
                        "target_lang_code": "el",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Δημήτριος",
                                "target_lang_code": "el",
                                "target_senses": [
                                    {
                                        "sense_id": "17a0fa10-5bfe-388e-b7cc-6e0528a2466b",
                                        "entry_id": "9a89213c-35d1-3b95-a607-9e6c8a7e40f2",
                                        "glosses": [
                                            "ανδρικό όνομα"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8afe0c4b-6e1f-4670-8196-6b7e5a34fa68",
                                                "sense_id": "17a0fa10-5bfe-388e-b7cc-6e0528a2466b",
                                                "text": "Ο Δημήτριος ο Πολιορκητής ήταν γιος του Αντίγονου και βασιλιάς της Μακεδονίας στο διάστημα 306 - 283 π.Χ."
                                            },
                                            {
                                                "example_id": "274cef47-9129-4eb6-ae9b-8990b17dcad9",
                                                "sense_id": "17a0fa10-5bfe-388e-b7cc-6e0528a2466b",
                                                "text": "Ο Δημήτριος ο Φαληρεύς ήταν φιλόσοφος, ρήτορας και πολιτικός που γεννήθηκε γύρω στο 360 π.Χ."
                                            },
                                            {
                                                "example_id": "dd965306-50a7-4a56-89d9-8e7c7c0f4ddb",
                                                "sense_id": "17a0fa10-5bfe-388e-b7cc-6e0528a2466b",
                                                "text": "Ο Δημήτριος Δημητράκος ήταν συγγραφέας και εκδότης (1875-1966)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7dcd7787-edc9-359c-84ee-21e8adb5820c",
                                        "entry_id": "9a89213c-35d1-3b95-a607-9e6c8a7e40f2",
                                        "glosses": [
                                            "όνομα αγίου ο οποιος κατά την ελληνορθόδοξη Εκκλησία γιορτάζει στις 26 Οκτωβρίου"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b733f156-7f46-4525-ad78-b2883dbdda51",
                                                "sense_id": "7dcd7787-edc9-359c-84ee-21e8adb5820c",
                                                "text": "Ο άγιος Δημήτριος είναι πολιούχος της Θεσσαλονίκης -προστάτης της- και έζησε στο διάστημα 260 ή 280-305 μ.Χ."
                                            },
                                            {
                                                "example_id": "4f9b6adf-3daa-4666-8040-9d2dcee1624a",
                                                "sense_id": "7dcd7787-edc9-359c-84ee-21e8adb5820c",
                                                "text": "Ο άγιος Δημήτριος λέγεται και Μυροβλύτης επειδή μοσχοβολούσε ο τάφος του και περιγράφεται ένα σχετικό θαύμα"
                                            },
                                            {
                                                "example_id": "33e6bb40-a58c-45ed-bdec-ff7f06c43e37",
                                                "sense_id": "7dcd7787-edc9-359c-84ee-21e8adb5820c",
                                                "text": "Στην Αθήνα ο ναός Αγιος Δημήτρης Λουμπαρδιάρης ονομάστηκε έτσι επειδή το 1821 εξερράγησαν τα πυρομαχικά των Τούρκων στα χέρια τους ενώ τα έβαζαν στο κανόνι (λουμπάρδα) τους για να σημαδέψουν τους Χριστιανούς που είχαν καταφύγει στην εκκλησία του Άη Δημήτρη."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
