                    {
                        "translation_id": "5c4651c7-24a3-4bad-909e-38ba9bf6c032",
                        "source_entry_id": "a209a01b-c49a-345a-8816-4a911a14584a",
                        "source_sense_id": "5f1e9608-f566-3083-a442-80090cb6f1b2",
                        "source_sense_description": "again; afterwards",
                        "target_lang_word": "по́сле",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "по́сле",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "3d37e90a-1487-3e90-99d2-f041c232eff6",
                                        "entry_id": "0811cd5c-d0b5-3d2f-9755-cbb30fb75e00",
                                        "glosses": [
                                            "в будущем, спустя некоторое время, потом, позже (также о расположении в пространстве)"
                                        ],
                                        "tags": [
                                            "нареч."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b32ec6d2-f1bc-4dbd-90a2-61266991f694",
                                                "sense_id": "3d37e90a-1487-3e90-99d2-f041c232eff6",
                                                "text": "Сейчас я занят, перезвоню после."
                                            },
                                            {
                                                "example_id": "d0c9cef0-eedd-4d8b-a35f-8a8e0674989a",
                                                "sense_id": "3d37e90a-1487-3e90-99d2-f041c232eff6",
                                                "text": "После уж будет поздно."
                                            },
                                            {
                                                "example_id": "cd1e33fc-4e24-4840-8be3-6c81ec115ca2",
                                                "sense_id": "3d37e90a-1487-3e90-99d2-f041c232eff6",
                                                "text": "— Ну да об этом после поговорим, — прибавила она, оглянув Соню взглядом, показывавшим, что она при ней не желает говорить об этом."
                                            },
                                            {
                                                "example_id": "eab0f10e-ebed-4c4f-a062-5bb60bee4c61",
                                                "sense_id": "3d37e90a-1487-3e90-99d2-f041c232eff6",
                                                "text": "Сообразив, куда прежде, куда после ехать, чтобы не возвращаться, Нехлюдов прежде всего направился в сенат."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "73bfe703-ece5-3183-a488-50b33aafc3cb",
                                        "entry_id": "0811cd5c-d0b5-3d2f-9755-cbb30fb75e00",
                                        "glosses": [
                                            "по окончании чего-либо, позднее чего-либо; вслед за кем-чем-нибудь (также о расположении в пространстве)"
                                        ],
                                        "tags": [
                                            "предлог, с род. п."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "09843d6d-a18e-4cd2-ab96-fec709de62b5",
                                                "sense_id": "73bfe703-ece5-3183-a488-50b33aafc3cb",
                                                "text": "После «Херувимской» поют «Верую», потом «Достойно и праведно», поют чувствительно, гладенько — и так до «Отче наш»."
                                            },
                                            {
                                                "example_id": "f72f2f06-ccae-486b-90d6-2a70ccc3b097",
                                                "sense_id": "73bfe703-ece5-3183-a488-50b33aafc3cb",
                                                "text": "Встретимся после занятий."
                                            },
                                            {
                                                "example_id": "78f0681e-0efe-4f24-896a-a1be3158e29c",
                                                "sense_id": "73bfe703-ece5-3183-a488-50b33aafc3cb",
                                                "text": "После обеда."
                                            },
                                            {
                                                "example_id": "b967f082-4ca0-4590-befb-e08dacad6fa7",
                                                "sense_id": "73bfe703-ece5-3183-a488-50b33aafc3cb",
                                                "text": "После службы."
                                            },
                                            {
                                                "example_id": "909925cf-bfaf-406e-b9e7-e70feb48bc64",
                                                "sense_id": "73bfe703-ece5-3183-a488-50b33aafc3cb",
                                                "text": "Прийти после всех."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "af4e1403-ed7a-3477-b759-47503bc2850b",
                                        "entry_id": "0811cd5c-d0b5-3d2f-9755-cbb30fb75e00",
                                        "glosses": [
                                            "по отъезду, уходу или по смерти кого-нибудь"
                                        ],
                                        "tags": [
                                            "предлог, с род. п."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6eb2acfc-3d1a-4a71-a399-0e8cbd682d7b",
                                                "sense_id": "af4e1403-ed7a-3477-b759-47503bc2850b",
                                                "text": "После него осталась вдова, Матильда, четверо детей и три заведения — аустерия, мельница и ювелирная лавка."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "по́сле",
