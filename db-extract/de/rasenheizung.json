                "senses": [
                    {
                        "sense_id": "befb5443-40f5-3e7a-a4b9-6c5f9ce00449",
                        "entry_id": "fc0a31bd-82de-3957-881c-12325fa7bb58",
                        "glosses": [
                            "Technik unter einer Rasenfläche, die diese im Winter schneefrei hält (meist in Fußballstadien)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cd108293-797e-4937-83e3-a675af455aef",
                                "sense_id": "befb5443-40f5-3e7a-a4b9-6c5f9ce00449",
                                "text": "„Im Sommer 2007 wurde eine Rasenheizung verlegt.“"
                            },
                            {
                                "example_id": "26f9cec4-4c8f-465e-ae3b-5c3d19d45f2d",
                                "sense_id": "befb5443-40f5-3e7a-a4b9-6c5f9ce00449",
                                "text": "„1998 wurde im Stadion eine Rasenheizung installiert.“"
                            },
                            {
                                "example_id": "faad4208-59aa-4daa-a0f0-6497968b57b9",
                                "sense_id": "befb5443-40f5-3e7a-a4b9-6c5f9ce00449",
                                "text": "„Die Erneuerung des Spielfelds mit Einbau einer Rasenheizung war mit 2,2 Mio. Euro veranschlagt.“"
                            },
                            {
                                "example_id": "78eb1540-0de2-4031-938c-63f5fcbdc90a",
                                "sense_id": "befb5443-40f5-3e7a-a4b9-6c5f9ce00449",
                                "text": "„»Wir haben in Braunschweig auch bei winterlichen Witterungsverhältnissen super Bedingungen, einer unserer Trainingsplätze ist mit einer Rasenheizung ausgestattet«, erklärte Eintracht-Sportdirektor Benjamin Kessel.“"
                            },
                            {
                                "example_id": "97effc75-63e0-4751-8bc9-b605a64ba5d9",
                                "sense_id": "befb5443-40f5-3e7a-a4b9-6c5f9ce00449",
                                "text": "„Anders als in den drei Topligen üblich gibt es im altehrwürdigen Waldstadion keine Rasenheizung.“"
                            },
                            {
                                "example_id": "e97d55c7-14d3-4144-a4e1-6bc6136dfc2e",
                                "sense_id": "befb5443-40f5-3e7a-a4b9-6c5f9ce00449",
                                "text": "„Rasenheizung, Flutlicht, die An- und Abreise der Fans – die Bundesliga verbraucht viel Energie.“"
                            },
                            {
                                "example_id": "78a8187f-0f0b-4a81-a3c0-fe02035a6615",
                                "sense_id": "befb5443-40f5-3e7a-a4b9-6c5f9ce00449",
                                "text": "[Schlagzeile:] „Bundesliga: Rasenheizung als Klimasünder“"
                            },
                            {
                                "example_id": "4874a4ef-2dce-42c5-b304-35ae79104d91",
                                "sense_id": "befb5443-40f5-3e7a-a4b9-6c5f9ce00449",
                                "text": "„Laut Rettig verbraucht eine Rasenheizung ölbetrieben circa 2000 Liter Heizöl am Tag: »Das ist ungefähr so viel wie ein Einfamilienhaus im ganzen Jahr.«“"
                            },
                            {
                                "example_id": "09e7d1c0-2d09-49e5-83c3-8d4e05fcb6de",
                                "sense_id": "befb5443-40f5-3e7a-a4b9-6c5f9ce00449",
                                "text": "„Der deutsche Rekordmeister FC Bayern München betreibt seine Rasenheizung mit einer Luft-Wärme-Pumpe, deren Energiebedarf größtenteils mit Solarstrom gedeckt wird.“"
                            },
                            {
                                "example_id": "26e9bb73-4ef6-49a3-8ebb-22f6eda7f720",
                                "sense_id": "befb5443-40f5-3e7a-a4b9-6c5f9ce00449",
                                "text": "„Die TSG Hoffenheim greift auf Holzpellets zurück, um den Wärmebedarf für seine Rasenheizung zu decken.“"
                            },
                            {
                                "example_id": "5d28a0e2-ce88-48df-96d1-bc05e8dcb51c",
                                "sense_id": "befb5443-40f5-3e7a-a4b9-6c5f9ce00449",
                                "text": "„Auch die Rasenheizungen der Arena und eines Trainingsplatzes des VfL Wolfsburg werden mit Fernwärme aus dem Rücklauf der Stadionheizung versorgt.“"
                            },
                            {
                                "example_id": "08fb73f6-477a-437a-8a3d-805d20b50600",
                                "sense_id": "befb5443-40f5-3e7a-a4b9-6c5f9ce00449",
                                "text": "„Die meisten Klubs“ […] „wollen zudem ihre Rasenheizungen so wenig wie nur irgend möglich einsetzen, nicht nur im Stadion, sondern auch auf ihren Trainingsanlagen.“"
                            },
                            {
                                "example_id": "435b4286-8757-4a48-80b3-e6ca5b12b3e4",
                                "sense_id": "befb5443-40f5-3e7a-a4b9-6c5f9ce00449",
                                "text": "„Weil die Rasenheizung im Bayreuther Hans-Walter-Wild-Stadion noch nicht funktioniert, stehen die Heimspiele der SpVgg Bayreuth in der 3. Fußball-Liga im März auf der Kippe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
