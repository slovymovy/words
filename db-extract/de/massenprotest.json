                ],
                "senses": [
                    {
                        "sense_id": "69a3bff4-5ff6-3409-a5ed-e77e43d1dd96",
                        "entry_id": "326f2980-fc6c-36f9-9171-8b9f64f5119e",
                        "glosses": [
                            "Aktion sehr vieler Personen gegen etwas, das als negativ angesehen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fae441c4-7e0b-4959-bca5-138d43bc6af8",
                                "sense_id": "69a3bff4-5ff6-3409-a5ed-e77e43d1dd96",
                                "text": "„Der Massenprotest hatte noch nicht genügend Durchschlagskraft und konnte nur einen Teil der Arbeiter mobilisieren.“"
                            },
                            {
                                "example_id": "5ae5847a-cf30-4db4-929a-3b9014b9d2bf",
                                "sense_id": "69a3bff4-5ff6-3409-a5ed-e77e43d1dd96",
                                "text": "„Ebenso wie ihre Vorbilder im Reich organisierten sie Massenproteste gegen den Film, störten die Aufführungen und erreichten am 2. Januar 1931 schließlich auch in Wien ein Verbot.“"
                            },
                            {
                                "example_id": "0bdb8402-b453-49c2-ad95-40ca22a95991",
                                "sense_id": "69a3bff4-5ff6-3409-a5ed-e77e43d1dd96",
                                "text": "„Die jüngsten Massenproteste initiierte Muhammad Tahir-ul-Qadri, ein bis vor kurzem nahezu unbekannter Politiker, der 2012 aus dem Exil nach Pakistan zurückgekehrt ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
