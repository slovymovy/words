                        "source_sense_id": "7b157dd7-0cfa-397a-95a3-c139b743b720",
                        "target_lang_word": "despicable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "despicable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e516a09a-9134-3299-a0d2-04995f66ca80",
                                        "entry_id": "58f74669-a985-34e2-82a5-39fd380bc03f",
                                        "glosses": [
                                            "Fit or deserving to be despised; contemptible; mean."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6ae0b135-c835-4d4c-9131-8fde4968238d",
                                                "sense_id": "e516a09a-9134-3299-a0d2-04995f66ca80",
                                                "text": "The physical penis is consumed by despicable fish, animals of the turgid depths, but the higher phallus, the image of resurrection through the goddess, is fashioned as a sacred icon."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "despicable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "eb3ff939-70e9-3107-a519-0d811ab857c7",
                                        "entry_id": "18e55d87-234e-3717-84b7-9fab0199b07c",
                                        "glosses": [
                                            "A wretched or wicked person."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0cb59853-1268-4f93-b428-1bc9f93b37b5",
                                                "sense_id": "eb3ff939-70e9-3107-a519-0d811ab857c7",
                                                "text": "Robbers assemble other robbers for the purpose of robbery; but Christians gather thieves, bandits, and other despicables for the purpose of spiritual transformation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ef0b77dc-7547-47ea-9b0e-36b590409ae4",
                        "source_entry_id": "e26f9932-97b6-3e17-9d7b-eb2baadfb0f1",
                        "source_sense_id": "7b157dd7-0cfa-397a-95a3-c139b743b720",
                        "target_lang_word": "despisable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "despisable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a0c205b7-3791-3987-b3aa-5edf25790acd",
                                        "entry_id": "ec844112-a9a5-3ace-ab94-17b92376dc9d",
                                        "glosses": [
                                            "Worthy to be despised."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ff85ae43-3549-4d48-bb0b-6d3b982b8b50",
                                                "sense_id": "a0c205b7-3791-3987-b3aa-5edf25790acd",
                                                "text": "c. 1530, uncredited translator, The Dialoges of Creatures Moralysed, Dialogue 110,\nAnd forasmoche as we be so Noble of owr natyf kynde / let vs pursewe such beastis as be vyle & despisable."
                                            },
                                            {
                                                "example_id": "b174e5cf-568d-42c2-8e4b-0bbc93a077cb",
                                                "sense_id": "a0c205b7-3791-3987-b3aa-5edf25790acd",
                                                "text": "the Jewish Nation, though scattered through the whole World, are not therefore a despisable people, but as a Plant worthy to be planted in the whole world"
                                            },
                                            {
                                                "example_id": "798d7840-49f7-474e-a60d-ee47dbbecb1c",
                                                "sense_id": "a0c205b7-3791-3987-b3aa-5edf25790acd",
                                                "text": "[…] Meekness, Condescension, Forbearance, are so far from being despisable Qualities in our Sex, that they are the Glory of it."
                                            },
                                            {
                                                "example_id": "320ec2d3-b60a-4df1-81b1-c3c8bdbdca2b",
                                                "sense_id": "a0c205b7-3791-3987-b3aa-5edf25790acd",
                                                "text": "1821, James Fenimore Cooper, The Spy, London: G. and W.B. Whittaker, 1822, Volume 1, Chapter 11, p. 297,\n“but now he is nothing more than despisable, or what’s the same thing, a pedlar without house, pack, or money.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "06d6cc03-eaa6-446a-b1c1-9da112ffa71a",
                        "source_entry_id": "e26f9932-97b6-3e17-9d7b-eb2baadfb0f1",
