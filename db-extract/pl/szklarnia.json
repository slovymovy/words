                "translations": [
                    {
                        "translation_id": "426407f6-dd46-4038-90ba-e5e7bcbecc50",
                        "source_entry_id": "0bbba459-686b-35b6-9840-d37e0c06318a",
                        "source_sense_id": "ec7d78f0-9591-3348-bd7e-164c7e34043b",
                        "target_lang_word": "greenhouse",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "greenhouse",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4a09dddf-02c7-3e65-ad24-181c91ecdb47",
                                        "entry_id": "e90d6688-5880-37f9-bd7d-37e6d7fe8539",
                                        "glosses": [
                                            "A building used to grow plants, particularly one with large glass windows or plastic sheeting to trap heat from sunlight even in intemperate seasons or climates."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ac8448e-b156-4b89-af19-8bdf696799a5",
                                                "sense_id": "4a09dddf-02c7-3e65-ad24-181c91ecdb47",
                                                "text": "The royal party had dined in the greenhouse, the coup d'œil of which was as striking as it was new. Vast stands of the most costly exotics reached to the glass roof, which was partly covered by a luxuriant vine, or by a small scarlet creeper."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b4584af4-aa58-3d5c-92b3-03c3ce5213b1",
                                        "entry_id": "e90d6688-5880-37f9-bd7d-37e6d7fe8539",
                                        "glosses": [
                                            "The glass of a plane's cockpit."
                                        ],
                                        "tags": [
                                            "UK",
                                            "dated",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ee095b06-9f19-4fd4-b66a-cda56c717fe3",
                                                "sense_id": "b4584af4-aa58-3d5c-92b3-03c3ce5213b1",
                                                "text": "In the slang of the Royal Air Force man, the cockpit of his plane is the ‘pulpit’ or ‘office’, the glass covering over it the ‘greenhouse’."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0e91acc0-3c99-3e63-8c46-974e7b74103b",
                                        "entry_id": "e90d6688-5880-37f9-bd7d-37e6d7fe8539",
                                        "glosses": [
                                            "A structure that shields the operating table to protect against bacteria."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e2bd5e5-7b65-4733-87f3-f2866080a432",
                                                "sense_id": "0e91acc0-3c99-3e63-8c46-974e7b74103b",
                                                "text": "Figure 2.6 shows the diagram Charnley published of the airflow in the 'greenhouse'; it can be seen that reasonable downward unidirectional airflow was achieved close to the operating table."
                                            },
                                            {
                                                "example_id": "ae5063f3-a41d-44cc-877e-5adfb35c8cfe",
                                                "sense_id": "0e91acc0-3c99-3e63-8c46-974e7b74103b",
                                                "text": "The greenhouse system for providing a nearly bacteria-free operating environment consists of a 10 by 10-foot aluminum frame with plexiglass panes forming three sides and a polyvinyl curtain forming the fourth side. […] However, the greenhouse contains its own light supply, while this is an extra with the air curtain unit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "70349db0-58c6-319e-b71e-f0796136e36b",
                                        "entry_id": "e90d6688-5880-37f9-bd7d-37e6d7fe8539",
                                        "glosses": [
                                            "A hot state in global climate."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "greenhouse",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "86fa9fbb-825d-36c4-ab08-d0266d61ef92",
                                        "entry_id": "fea15026-f65e-3b60-b642-f1133781bf5d",
                                        "glosses": [
                                            "To place (plants) in a greenhouse."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fd68a76a-c58f-3a96-9713-b759164b6e4c",
                                        "entry_id": "fea15026-f65e-3b60-b642-f1133781bf5d",
                                        "glosses": [
                                            "To nurture in order to promote growth."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d5b2ae94-8aa0-49a7-8f8c-2fa822c7dfcd",
                                                "sense_id": "fd68a76a-c58f-3a96-9713-b759164b6e4c",
                                                "text": "It's almost impossible to make judgements when you're being playful – as by definition it's spontaneous activity – so your baby ideas get nurtured and greenhoused better."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
