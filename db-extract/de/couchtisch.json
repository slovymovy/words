                "senses": [
                    {
                        "sense_id": "bb65187a-a93a-3b75-962a-970af554a395",
                        "entry_id": "746a2e11-2e72-3581-9e7b-2829e88fd509",
                        "glosses": [
                            "Tisch, der an/vor einer Couch oder einem Sofa platziert wird und entsprechend eine relativ niedrige Tischplatte hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "525ced4c-e2e7-49a1-ba31-06515c613f3e",
                                "sense_id": "bb65187a-a93a-3b75-962a-970af554a395",
                                "text": "„Er sitzt auf seinem Thron aus rotem Leder, aufrechter Oberkörper, den linken Fuß auf den rustikalen Couchtisch gestellt.“"
                            },
                            {
                                "example_id": "5ee58b0d-4499-40dd-a98c-f222256e0232",
                                "sense_id": "bb65187a-a93a-3b75-962a-970af554a395",
                                "text": "„Brümmer sitzt jetzt vor seinem Couchtisch und hat backtechnologische Informationen ausgebreitet.“"
                            },
                            {
                                "example_id": "5f1cbb26-fd89-4f0e-9a75-c03eb381dd69",
                                "sense_id": "bb65187a-a93a-3b75-962a-970af554a395",
                                "text": "„Joyce zieht ihr Staubtuch wieder hervor, bückt sich und poliert einen Flecken vom Couchtisch weg.“"
                            },
                            {
                                "example_id": "7b52779b-3066-4379-ad7f-cd787ffb7ca5",
                                "sense_id": "bb65187a-a93a-3b75-962a-970af554a395",
                                "text": "„Sie saßen an einem Couchtisch, und Cindy unterschrieb gerade irgendeinen Vordruck.“"
                            },
                            {
                                "example_id": "7c8b0714-1732-48f8-bc2d-c81189ecff18",
                                "sense_id": "bb65187a-a93a-3b75-962a-970af554a395",
                                "text": "„Sie setzten sich auf das Sofa in der Ecke des Büros, und Chigurh legte den Aktenkoffer auf den Couchtisch und wies mit dem Kopf darauf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
