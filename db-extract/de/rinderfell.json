                "senses": [
                    {
                        "sense_id": "10fce592-cb2f-3275-b749-aa2a13465828",
                        "entry_id": "5a926e55-abfb-34d8-8a62-e2c26cb6f6a6",
                        "glosses": [
                            "(abgezogenes) Fell eines Rinds"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "242d61e4-769f-4471-adc6-8aaf33527d09",
                                "sense_id": "10fce592-cb2f-3275-b749-aa2a13465828",
                                "text": "„Die Decke gab sie jedoch wieder zurück: ›Ach, ich möchte die Decke nicht haben. Ich möchte lieber ein hartes Rinderfell. Solche weichen Decken vertrage ich nicht‹, sagte sie.“"
                            },
                            {
                                "example_id": "8cdbbe8e-84b7-41bc-b3d6-0142883073ee",
                                "sense_id": "10fce592-cb2f-3275-b749-aa2a13465828",
                                "text": "„Sie nehmen Rinderfelle mit sich, und wenn der Sturm losbricht und sie auf das Meer treibt, nimmt jeder sein Rinderfell, kriecht hinein und näht es so fest zu, daß kein Wasser eindringen kann.“"
                            },
                            {
                                "example_id": "1516e38e-b1eb-4638-868b-db7367211515",
                                "sense_id": "10fce592-cb2f-3275-b749-aa2a13465828",
                                "text": "„Selbst die Haarwurzeln sind bei der Überzahl erhalten, so daß angenommen werden muß, daß beim Gerben eines Rinderfelles die Haare abgestoßen worden sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
