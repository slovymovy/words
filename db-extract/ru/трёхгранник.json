                        ]
                    },
                    {
                        "translation_id": "7fa45ca9-aa34-4172-ae23-69980409ec0f",
                        "source_entry_id": "29354e07-bd62-3952-8c21-561614cd919f",
                        "source_sense_id": "46b5e664-c98a-3bc5-ad6e-e0088b27fc6d",
                        "target_lang_word": "trièdre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "trièdre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cbe14a9c-0535-389e-96b9-e5fead7dc146",
                                        "entry_id": "25fa6ec4-075f-314d-981f-2e61f537c8d6",
                                        "glosses": [
                                            "Objet géométrique qui forme, dans l'espace, trois angles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "87ff7376-def6-437c-95c6-0d1fcea81adb",
                                                "sense_id": "cbe14a9c-0535-389e-96b9-e5fead7dc146",
                                                "text": "En géométrie différentielle classique euclidienne, on a été conduit à attacher aux courbes et aux surfaces en chacun de leurs points des trièdres de référence particuliers : le repère de Frenet, le repère de Darboux."
                                            },
                                            {
                                                "example_id": "5b367034-d376-4991-adc4-ca63f9abaff7",
                                                "sense_id": "cbe14a9c-0535-389e-96b9-e5fead7dc146",
                                                "text": "Les trois nobles vérités qui viennent d'illuminer nos regards doivent donc être considérées comme le trièdre générateur d'une pyramide de sagesse qui, inédite merveille, survolera d'une aile légère les océans désagrégés du doute."
                                            },
                                            {
                                                "example_id": "d9f30361-73a8-4eea-ab9a-5d62577f6657",
                                                "sense_id": "cbe14a9c-0535-389e-96b9-e5fead7dc146",
                                                "text": "Je me représente ces trois ensembles d'idées comme les trois faces d'un trièdre possédant un même socle et un même sommet."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "trièdre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7f0155f9-81c4-3773-84d8-7e0b3108659c",
                                        "entry_id": "c15f1e5c-f6bd-3b9a-99f0-8634e001f9ee",
                                        "glosses": [
                                            "Qui a trois faces planes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a81dc6f5-68b0-448e-ae69-90d26dbfe11a",
                                                "sense_id": "7f0155f9-81c4-3773-84d8-7e0b3108659c",
                                                "text": "Pyramide trièdre."
                                            },
                                            {
                                                "example_id": "3f5a512d-3f22-4e91-9b3a-fe24d9cd943f",
                                                "sense_id": "7f0155f9-81c4-3773-84d8-7e0b3108659c",
                                                "text": "Prisme trièdre."
                                            },
                                            {
                                                "example_id": "b3f3db65-93a3-4dd1-8565-918004e0afbd",
                                                "sense_id": "7f0155f9-81c4-3773-84d8-7e0b3108659c",
                                                "text": "Angle trièdre, angle formé par l’intersection de trois plans."
                                            }
                                        ]
