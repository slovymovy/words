                ],
                "senses": [
                    {
                        "sense_id": "005b7cd8-1f41-3a2d-b7e4-3c77e628ba8a",
                        "entry_id": "406d43a8-e697-3c9d-b2b0-59ea40de79c7",
                        "glosses": [
                            "massale migratie naar pas ontdekte goudvelden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd93ad08-28fe-492c-88cf-ef179efec2d7",
                                "sense_id": "005b7cd8-1f41-3a2d-b7e4-3c77e628ba8a",
                                "text": "Nadat ongeveer 100.000 à 150.000 Chinezen in de periode 1850-1880 naar zowel Noord- als Zuid-Amerika waren getrokken, onder meer gelokt door de goldrush in Californië, besloten de Verenigde Staten, op de voet gevolgd door blanke vestigingskolonies als Australië, om de vrije migratie van Aziaten – Chinezen en Indiërs – te verbieden."
                            }
                        ]
                    },
                    {
                        "sense_id": "3e2a8b8c-ed32-3cb5-bccb-d7d2f73aaaec",
                        "entry_id": "406d43a8-e697-3c9d-b2b0-59ea40de79c7",
                        "glosses": [
                            "het behalen van meerdere gouden medailles op een toernooi"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b411d31c-4d9a-4f8b-b385-f5bdfab370c6",
                                "sense_id": "3e2a8b8c-ed32-3cb5-bccb-d7d2f73aaaec",
                                "text": "Minder dan een jaar voor de Winterspelen van Pyeongchang 2018 lijkt zich voor Nederland al voorzichtig een massale olympische goldrush af te tekenen. Voor de schaatsers en coaches is dat een prachtig vooruitzicht."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "db3b7b5d-2198-46bf-ad2a-165bc9187c81",
                        "source_entry_id": "406d43a8-e697-3c9d-b2b0-59ea40de79c7",
                        "target_lang_word": "gold rush",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gold rush",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "94f32f9b-770a-3124-9645-13502ed6c22f",
                                        "entry_id": "ba471d08-c804-3e95-85b7-95d884302fb9",
                                        "glosses": [
                                            "Any period of feverish migration into an area in which gold has been discovered."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b2ea5d35-6339-4e46-abb6-e196fb527f76",
                                                "sense_id": "94f32f9b-770a-3124-9645-13502ed6c22f",
                                                "text": "Here Grey Beaver stopped. A whisper of the gold-rush had reached his ears, and he had come with several bales of furs, and another of gut-sewn mittens and moccasins. He would not have ventured so long a trip had he not expected generous profits."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "19227aee-735f-3cce-8974-bf44e2fe08c9",
                                        "entry_id": "ba471d08-c804-3e95-85b7-95d884302fb9",
                                        "glosses": [
                                            "A feverish obsession with seeking profits, especially in new markets."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "65178bd8-6796-4297-981d-72ab7c19a18a",
                                                "sense_id": "19227aee-735f-3cce-8974-bf44e2fe08c9",
                                                "text": "That’s because I’ve decided to enter the freewheeling world of nonfungible tokens, or NFTs, the newest frontier in the cryptocurrency gold rush."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2e2be861-48d7-3c6d-8500-b3a3223e4677",
                                        "entry_id": "ba471d08-c804-3e95-85b7-95d884302fb9",
                                        "glosses": [
                                            "A cocktail made from bourbon, honey, and lemon juice."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15ec654c-281b-4150-98fe-3b311bf2c0c1",
                                                "sense_id": "2e2be861-48d7-3c6d-8500-b3a3223e4677",
                                                "text": "The Gold Rush is one of my favorite cocktails, invented at Sasha Petraske's famed Milk & Honey bar and now served all over the world. Basically a cold toddy, it's a shaken drink with bourbon, fresh lemon, and honey."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "89e5f7bc-b858-37bb-8834-8bd967c45f6a",
                                        "entry_id": "ba471d08-c804-3e95-85b7-95d884302fb9",
                                        "glosses": [
                                            "The urge to win gold medals, as in the Olympic Games."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5024198d-7d3f-4027-b7f3-66c2e49430b1",
