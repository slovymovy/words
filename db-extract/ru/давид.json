                                    {
                                        "sense_id": "9962869c-c9cc-3358-a507-ec14164dbdff",
                                        "entry_id": "f582d8ba-1990-3293-9c01-81b01581837b",
                                        "glosses": [
                                            "A place name:",
                                            "A barangay of Mangaldan, Pangasinan, Philippines."
                                        ],
                                        "tags": [
