                ],
                "senses": [
                    {
                        "sense_id": "e238b778-d3cb-3a07-8b40-aae00387345a",
                        "entry_id": "18ea3fb5-49b4-3a44-82b5-23ea65606857",
                        "glosses": [
                            "кусая, разделять надвое"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a197b815-b7c8-43e9-b7e1-106eaa9eb686",
                                "sense_id": "e238b778-d3cb-3a07-8b40-aae00387345a",
                                "text": "Она подкатилась вплотную к нему, и он стал своими крепкими зубами расщеплять и нить за нитью перекусывать её верёвку."
                            }
                        ]
                    },
                    {
                        "sense_id": "6b1db890-17c7-3be4-bd00-60f5eefe211b",
                        "entry_id": "18ea3fb5-49b4-3a44-82b5-23ea65606857",
                        "glosses": [
                            "техн. разрывать, разделять надвое специальным инструментом"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c6873f0-d59c-4ed8-b757-066fe98a275d",
                                "sense_id": "6b1db890-17c7-3be4-bd00-60f5eefe211b",
                                "text": "Кусачки плотно подогнаны и хорошо заточены — ими можно перекусывать и провода и даже нитки."
                            }
                        ]
                    }
                ],
