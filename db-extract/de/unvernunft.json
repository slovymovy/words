                "senses": [
                    {
                        "sense_id": "1e495197-160f-3bf5-9ccb-67878cb9c0a3",
                        "entry_id": "6b8117a8-6a82-3bf9-83b1-089627342ebf",
                        "glosses": [
                            "unbedachte Verhaltensweise, mangelnde Vernunft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5acb4038-b41f-4d04-9feb-51e72dc54762",
                                "sense_id": "1e495197-160f-3bf5-9ccb-67878cb9c0a3",
                                "text": "„Was wundern wir uns also, dass Gott auch Adam, den Geist, der die unheilbare Krankheit der Unvernunft sich zugezogen hat, für alle Zeit aus der Stätte der Tugenden hinausgetrieben und ihm nicht gestattet hat, wieder zurückzukehren?“"
                            },
                            {
                                "example_id": "062e51f0-b6fb-40c6-b85f-f7888684af8d",
                                "sense_id": "1e495197-160f-3bf5-9ccb-67878cb9c0a3",
                                "text": "„Die ganze Sache wäre ohne viel Aufhebens erledigt gewesen, wenn sie nicht aus Unvernunft bekannnt geworden wäre.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f796bba6-4c0e-4916-8da2-3f613986b25f",
                        "source_entry_id": "6b8117a8-6a82-3bf9-83b1-089627342ebf",
                        "source_sense_id": "1e495197-160f-3bf5-9ccb-67878cb9c0a3",
                        "source_sense_description": "unbedachte Verhaltensweise, mangelnde Vernunft",
                        "target_lang_word": "déraison",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "déraison",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "738ac1e1-53c0-3f17-8ffd-8fed5673b31e",
                                        "entry_id": "362e258f-4d3c-358d-a42a-b5483384cbee",
                                        "glosses": [
                                            "Manière de penser dénuée de raison ; état d’esprit contraire à la raison ou au bon sens commun."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed8ab55b-c9cf-4c9b-b3e3-5d772d4d12bd",
                                                "sense_id": "738ac1e1-53c0-3f17-8ffd-8fed5673b31e",
                                                "text": "Pathétique Vertu qui argumente et, dans sa naïveté, va jusqu'à opposer à la mort la parole d'un philosophe, comme si la raison pouvait lui dicter sa conduite, à elle qui est liberté entière parce qu'elle est entière déraison. C'est l'homme face à l'absurde."
                                            },
                                            {
                                                "example_id": "b21c2154-d1d2-48b5-bcc5-58f22a57a530",
                                                "sense_id": "738ac1e1-53c0-3f17-8ffd-8fed5673b31e",
                                                "text": "Chevallier, décidément, était et agissait en pleine déraison. Malgré son intelligence qui lui disait de rentrer pour affronter lʼadversité, il fit tout le contraire."
                                            },
                                            {
                                                "example_id": "d310a407-f801-4669-8c2c-4e084a85080f",
                                                "sense_id": "738ac1e1-53c0-3f17-8ffd-8fed5673b31e",
                                                "text": "Dans la première partie de ce livre, je me suis livré à la critique de ces déraisons qui enferment l'homme dans sa solitude et qui le condamnent à l'effritement du sens de sa vie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9d9ef614-ed98-475d-92db-03307269acde",
                        "source_entry_id": "6b8117a8-6a82-3bf9-83b1-089627342ebf",
                        "source_sense_id": "1e495197-160f-3bf5-9ccb-67878cb9c0a3",
                        "source_sense_description": "unbedachte Verhaltensweise, mangelnde Vernunft",
                        "target_lang_word": "irraison",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "irraison",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3fb0ccfa-3340-339e-ac28-b3cbc4e56e93",
                                        "entry_id": "d740fb50-f923-3c99-8823-382ac115fbdd",
                                        "glosses": [
                                            "Déraison."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a051fb48-c645-4e4f-aa76-ff5e45f894d4",
                                                "sense_id": "3fb0ccfa-3340-339e-ac28-b3cbc4e56e93",
                                                "text": "L’homme apporte la raison dans le monde de la nature en détruisant la lutte irraisonnable et la dépense d’énergie, mais cette activité est extérieure, lointaine, seulement reflétée. L’homme ne voit cette irraison que par l’intelligence."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
