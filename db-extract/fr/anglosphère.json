                        "glosses": [
                            "Monde anglo-saxon ou anglophone."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cea8e768-d258-4400-8dfd-4eceb317bdd7",
                                "sense_id": "32c0a3b0-d3b8-3c5f-8f8a-1aef20225396",
                                "text": "On pourrait dire que, aujourd’hui, l’Amérique (ou l’“anglosphère”, si l’on souhaite y inclure la Grande-Bretagne) joue le rôle que Goethe envisageait autrefois pour l’Allemagne."
                            }
