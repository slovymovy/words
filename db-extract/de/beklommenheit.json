                        ],
                        "form": "der Beklommenheit"
                    },
                    {
                        "form_id": "c162124a-b912-4bfb-81df-b10af0e1e46b",
                        "entry_id": "ddcc459e-fda2-3c6a-adb9-b3de0092d807",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "die Beklommenheit"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "118d4ef5-9ab5-3a87-97c3-a23376bd37ca",
                        "entry_id": "ddcc459e-fda2-3c6a-adb9-b3de0092d807",
                        "glosses": [
                            "bedrückte, ängstliche Stimmung oder Gefühl"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "48b596cd-66ba-4598-ae3e-7604878f63b7",
                                "sense_id": "118d4ef5-9ab5-3a87-97c3-a23376bd37ca",
                                "text": "In der Gedenkstätte herrscht eine düstere Stimmung, Beklommenheit überkommt dem Besucher."
                            },
                            {
                                "example_id": "b8b31ec8-deb7-4283-88af-bfc68cfd904d",
                                "sense_id": "118d4ef5-9ab5-3a87-97c3-a23376bd37ca",
                                "text": "Seit ihr Ehemann in Haft ist herrscht in Erika das Gefühl der Beklommenheit vor."
                            },
                            {
                                "example_id": "c4b524f1-22a4-494d-8714-69c5f9c5c512",
                                "sense_id": "118d4ef5-9ab5-3a87-97c3-a23376bd37ca",
                                "text": "Angesichts der anstehenden Massenentlassungen breitet sich im Betrieb Beklommenheit aus."
                            },
                            {
                                "example_id": "f1dafdba-d0bb-41f0-a1e4-dc9b29b5276a",
                                "sense_id": "118d4ef5-9ab5-3a87-97c3-a23376bd37ca",
                                "text": "„Je stärker ich von dieser Beklommenheit ergriffen wurde, desto mehr Zeit verbrachte ich damit, über all die neuen Ideenschmieden, Neugründungen und Innovationszentren zu lesen.“"
                            },
                            {
                                "example_id": "be9b26ed-2ce1-4125-a309-2b221d0a9f24",
                                "sense_id": "118d4ef5-9ab5-3a87-97c3-a23376bd37ca",
                                "text": "„Sobald das Tor durchschritten war, fiel alle Beklommenheit von mir ab - gerettet.“"
                            },
                            {
                                "example_id": "791d7b10-12d2-45f4-9d4e-03517e0a4fe5",
                                "sense_id": "118d4ef5-9ab5-3a87-97c3-a23376bd37ca",
                                "text": "„Nur erschien mit diesem auch eine gewisse Beklommenheit, eine Ängstlichkeit, die in demselben Maße zunahm, als er sich den Niederlassungen der Weißen näherte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "15f4b564-c9af-4196-a958-d45e1543d46b",
                        "source_entry_id": "ddcc459e-fda2-3c6a-adb9-b3de0092d807",
                        "source_sense_id": "118d4ef5-9ab5-3a87-97c3-a23376bd37ca",
                        "source_sense_description": "bedrückte, ängstliche Stimmung oder Gefühl",
                        "target_lang_word": "trepidation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "trepidation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5d884199-5ecf-355a-953e-f9b62e6d17c6",
                                        "entry_id": "0f5119e6-1d9d-3724-a968-60e3404edd83",
                                        "glosses": [
                                            "Anxiety over the uncertain future or possible ill-occurrence."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c61a125a-9aba-4a5f-abc3-e239511d3845",
                                                "sense_id": "5d884199-5ecf-355a-953e-f9b62e6d17c6",
                                                "text": "I decided, with considerable trepidation, to let him drive my car without me."
                                            },
                                            {
                                                "example_id": "23111661-513d-4af0-8d41-3e8614005b1a",
                                                "sense_id": "5d884199-5ecf-355a-953e-f9b62e6d17c6",
                                                "text": "She reached it soon after half-past two. She found its gloomy nineteenth-century façade, black with the smuts of ninety years, a little daunting, and mounted its broad steps in some trepidation. But she rang the bell hard and knocked firmly."
                                            },
                                            {
                                                "example_id": "2348ea3e-1ff2-414b-828a-f871717dde5d",
                                                "sense_id": "5d884199-5ecf-355a-953e-f9b62e6d17c6",
                                                "text": "She opened the drawing-room door in trepidation. Would she find Esther drowned with her head in the goldfish bowl, or hanged from the chandelier by her stay-lace?"
                                            },
                                            {
                                                "example_id": "20eec917-a177-4f74-87d1-e6447ee47f1a",
                                                "sense_id": "5d884199-5ecf-355a-953e-f9b62e6d17c6",
                                                "text": "When I went, I left from the station / With a haversack and some trepidation"
                                            },
                                            {
                                                "example_id": "5aaf609a-670b-4a67-a127-647615dcd332",
                                                "sense_id": "5d884199-5ecf-355a-953e-f9b62e6d17c6",
                                                "text": "The Midlanders will hope the victory will kickstart a campaign that looked to have hit the buffers, but the sense of trepidation enveloping the Reebok Stadium heading into the new year underlines the seriousness of the predicament facing Owen Coyle's men."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f45c2a08-282c-3dda-abe1-918bddb6744e",
                                        "entry_id": "0f5119e6-1d9d-3724-a968-60e3404edd83",
                                        "glosses": [
                                            "An involuntary trembling, sometimes an effect of paralysis, but usually caused by terror or fear."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "53898500-de1b-3878-a2bc-74620731c582",
                                        "entry_id": "0f5119e6-1d9d-3724-a968-60e3404edd83",
                                        "glosses": [
                                            "A libration of the starry sphere in the Ptolemaic system; a motion ascribed to the firmament, to account for certain small changes in the position of the ecliptic and of the stars."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
