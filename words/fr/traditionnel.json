{
    "word_family": [
        "tradition",
        "traditionalisme",
        "traditionaliste",
        "traditionnellement"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "d5e9d88c-e815-379c-bec9-e25c3e040dbb",
                    "sense_definition": "Qui est fondé sur la tradition, qui se transmet de génération en génération.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "tradition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce restaurant sert un plat <w>traditionnel</w> préparé selon une vieille recette familiale."
                        },
                        {
                            "text": "Pour le festival, les danseurs portent un costume <w>traditionnel</w> très coloré."
                        }
                    ],
                    "antonyms": [
                        "moderne"
                    ],
                    "common_phrases": [
                        "plat traditionnel",
                        "costume traditionnel",
                        "musique traditionnelle",
                        "fête traditionnelle"
                    ]
                },
                {
                    "sense_id": "31927772-10c5-3ff5-af75-c0a83a41f454",
                    "sense_definition": "Classique ou conventionnel, par opposition aux méthodes ou technologies modernes.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "classique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette nouvelle machine consomme beaucoup moins d'énergie qu'un modèle <w>traditionnel</w>."
                        },
                        {
                            "text": "Certains artisans préfèrent utiliser une méthode <w>traditionnelle</w> plutôt que des outils numériques."
                        }
                    ],
                    "antonyms": [
                        "moderne",
                        "innovant"
                    ],
                    "common_phrases": [
                        "méthode traditionnelle",
                        "système traditionnel"
                    ]
                },
                {
                    "sense_id": "f567541e-4a9e-3956-b705-00da5be9aea5",
                    "sense_definition": "Qui se répète régulièrement selon une habitude établie ; habituel ou coutumier.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "habituel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après la réunion, nous avons partagé le <w>traditionnel</w> café avec tous les collègues."
                        },
                        {
                            "text": "Le maire a prononcé son <w>traditionnel</w> discours devant les habitants rassemblés sur la place."
                        }
                    ],
                    "antonyms": [
                        "inhabituel"
                    ],
                    "common_phrases": [
                        "discours traditionnel",
                        "rendez-vous traditionnel"
                    ]
                },
                {
                    "sense_id": "e1765e00-3179-30a4-9d2c-83cd48c880f3",
                    "sense_definition": "Qui reste fermement attaché aux traditions et aux coutumes anciennes.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "attachement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ses grands-parents sont très <w>traditionnels</w> et refusent d'adopter les nouvelles coutumes."
                        },
                        {
                            "text": "Elle a grandi dans une famille <w>traditionnelle</w> où le respect des aînés était primordial."
                        }
                    ],
                    "antonyms": [
                        "progressiste"
                    ],
                    "common_phrases": [
                        "famille traditionnelle",
                        "esprit traditionnel"
                    ]
                }
            ]
        }
    ]
}