                ],
                "senses": [
                    {
                        "sense_id": "a969740e-ebca-364c-8570-d01407074bb4",
                        "entry_id": "afcb8be0-6487-31b3-9f23-5f1b22b1bf67",
                        "glosses": [
                            "Communiquer quelque chose, sans en parler explicitement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6e2fc34b-fa2d-4fc0-abc8-413eb2c4784c",
                                "sense_id": "a969740e-ebca-364c-8570-d01407074bb4",
                                "text": "Un outil tout simple pour subcommuniquer vos arguments."
                            },
                            {
                                "example_id": "c2255b49-cc85-4b08-80ca-94495b1c74f9",
                                "sense_id": "a969740e-ebca-364c-8570-d01407074bb4",
                                "text": "Non seulement, vous allez gagner du temps mais en plus, vous allez subcommuniquer que vous êtes surchargé de travail."
                            },
                            {
                                "example_id": "dac65f61-54ef-4404-8f58-23a5f878585d",
                                "sense_id": "a969740e-ebca-364c-8570-d01407074bb4",
                                "text": "Notez bien l'enchainement : on continue directement après le Salut, sans attendre de réponse au \"Salut\" (qui joue le rôle technique d'Intruder, le mot qui vise à requérir l'attention des personnes abordées, même si je vous recommande de ne pas le subcommuniquer comme tel : lorsque vous abordez, rappelez-vous que c'est naturel, et que vous allez apporter quelque chose aux personnes que vous abordez)."
                            }
                        ]
                    }
