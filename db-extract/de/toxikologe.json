                "senses": [
                    {
                        "sense_id": "9022ae5e-8c76-3b82-a172-6e34eeb29720",
                        "entry_id": "06904b7f-a527-3801-a49c-41f1cf1a2604",
                        "glosses": [
                            "jemand, der Gift- beziehungsweise Schadstoffe erforscht, unter anderem deren Wirkungsweise auf Organismen und Ökosysteme"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5064af51-5178-49a4-969a-571192568de5",
                                "sense_id": "9022ae5e-8c76-3b82-a172-6e34eeb29720",
                                "text": "„Die einst so hoch gelobte Nanotechnik ist längst nicht mehr unumstritten. Allmählich mehren sich Hinweise von Toxikologen, wonach viele Wundermaterialien der Nanowelt für Organismen schädlich sein könnten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "303e7a95-d5ce-4b96-bf62-44a7e811a431",
                        "source_entry_id": "06904b7f-a527-3801-a49c-41f1cf1a2604",
                        "source_sense_id": "9022ae5e-8c76-3b82-a172-6e34eeb29720",
                        "source_sense_description": "jemand, der Gift- beziehungsweise Schadstoffe erforscht",
                        "target_lang_word": "toxicologist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "toxicologist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6f81fe8a-6c7b-392c-a882-66f701bccaa3",
                                        "entry_id": "75f9e0b7-b7e6-3619-80da-e0092cdcda37",
                                        "glosses": [
                                            "A scientist or physician who specializes in toxicology."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ebea8c9-abed-4931-884b-375611bd053d",
                                                "sense_id": "6f81fe8a-6c7b-392c-a882-66f701bccaa3",
                                                "text": "Toxicologists at the Taft Laboratory at the National Institute of Occupational Safety and Health (NIOSH) here are dosing mice with poppers to solve the baffling mystery of diseases which are killing gay men."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0933a565-c904-4822-91d1-3177ddd63572",
                        "source_entry_id": "06904b7f-a527-3801-a49c-41f1cf1a2604",
                        "source_sense_id": "9022ae5e-8c76-3b82-a172-6e34eeb29720",
                        "source_sense_description": "jemand, der Gift- beziehungsweise Schadstoffe erforscht",
                        "target_lang_word": "toxicologue",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "toxicologue",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6c7bdeb6-d1ff-306f-9845-9d5c5fcd2dac",
                                        "entry_id": "eb23ffd7-000c-3b5a-b068-59e80fad7998",
                                        "glosses": [
                                            "Scientifique qui a pour spécialité la toxicologie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6cf9f55d-efd3-4d2f-b695-5fdb15c37294",
                                                "sense_id": "6c7bdeb6-d1ff-306f-9845-9d5c5fcd2dac",
                                                "text": "Les toxicologues s’arrachent les cheveux pour évaluer la dangerosité des cocktails d’additifs."
                                            },
                                            {
                                                "example_id": "d41ec22a-f7ba-4aa7-9976-6b47d1d1d6ac",
                                                "sense_id": "6c7bdeb6-d1ff-306f-9845-9d5c5fcd2dac",
                                                "text": "La constitution de ces dizaines de milliers de dossiers, et leur mise en ligne, est sans contest un grand acquis. Et une grande opportunité pour la science : l’opération s’est accompagnée d’un vrai pic de recherche avec le recrutement de nombreux toxicologues, la réalisation d’études, et un coup de projecteur bienvenu sur les questions négligées de santé et d’environnement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
