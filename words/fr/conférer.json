{
    "word_family": [
        "conférence",
        "conférencier",
        "conférencière"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1d84cf91-eca3-346d-9f64-e0a609cc1431",
                    "sense_definition": "Donner, accorder ou attribuer un pouvoir, un titre, un droit ou une qualité.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "attribution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette nouvelle loi lui <w>confère</w> des responsabilités importantes au sein du comité de direction."
                        },
                        {
                            "text": "La robe sombre de cet acteur lui <w>conférait</w> une allure mystérieuse et impressionnante."
                        }
                    ],
                    "synonyms": [
                        "accorder",
                        "attribuer",
                        "octroyer"
                    ],
                    "antonyms": [
                        "enlever",
                        "retirer"
                    ],
                    "common_phrases": [
                        "conférer un pouvoir",
                        "conférer un titre",
                        "conférer un avantage"
                    ]
                },
                {
                    "sense_id": "74213b86-8d8b-31a9-9d4c-5773a0d44e53",
                    "sense_definition": "S'entretenir avec une ou plusieurs personnes afin de délibérer ou de prendre une décision.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "discussion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les ministres doivent encore <w>conférer</w> avant de faire une annonce officielle à la presse."
                        },
                        {
                            "text": "L'avocat a demandé un temps de pause pour <w>conférer</w> avec son client."
                        }
                    ],
                    "synonyms": [
                        "délibérer",
                        "discuter",
                        "s'entretenir"
                    ],
                    "common_phrases": [
                        "conférer ensemble",
                        "conférer avec quelqu'un"
                    ]
                },
                {
                    "sense_id": "d220fe45-2d69-3624-bda5-abd6809b463d",
                    "sense_definition": "Mettre en parallèle et comparer des textes ou des documents pour relever leurs ressemblances et leurs différences.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "comparaison",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'historien a pris le temps de <w>conférer</w> deux manuscrits anciens afin d'établir la version exacte."
                        },
                        {
                            "text": "En <w>conférant</w> ces récits avec les archives, les spécialistes ont relevé plusieurs incohérences majeures."
                        }
                    ],
                    "synonyms": [
                        "collationner",
                        "comparer",
                        "confronter"
                    ],
                    "common_phrases": [
                        "conférer deux manuscrits",
                        "conférer deux textes"
                    ]
                }
            ]
        }
    ]
}