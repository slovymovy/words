    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b18d0c4e-f162-3c7c-b29d-ff7fc73d65a3",
                    "sense_definition": "Present participle and gerund of <w>breathe</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The patient is <w>breathing</w> on his own now.",
                            "target_lang_translations": {
                                "ru": "Пациент теперь <w>дышит</w> самостоятельно.",
                                "tr": "Hasta artık kendi kendine <w>nefes alıyor</w>."
                            }
                        },
                        {
                            "text": "She was <w>breathing</w> heavily after running up the stairs.",
                            "target_lang_translations": {
                                "ru": "Она тяжело <w>дышала</w>, взбежав по лестнице.",
                                "tr": "Merdivenleri koştuktan sonra ağır ağır <w>soluyordu</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "stopped breathing",
                        "difficulty breathing",
                        "barely breathing"
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени и герундий от глагола <w>breathe</w> (дышать).",
                        "tr": "Breathe fiilinin şimdiki zaman ortacı veya isim-fiil hali."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дышать",
                                "target_lang_sense_clarification": "глагол, действие"
                            },
                            {
                                "target_lang_word": "дышащий",
                                "target_lang_sense_clarification": "причастие"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "nefes alan",
                                "target_lang_sense_clarification": "sıfat veya ortaç olarak"
                            },
                            {
                                "target_lang_word": "soluyan",
                                "target_lang_sense_clarification": "nefes alıp verme eylemi"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c30edc20-28cb-332b-be69-32f66acc2f85",
                    "sense_definition": "The act or process of taking air into the lungs and letting it out.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "physical_process",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Deep <w>breathing</w> can help you relax during stressful situations.",
                            "target_lang_translations": {
                                "ru": "Глубокое <w>дыхание</w> может помочь вам расслабиться в стрессовых ситуациях.",
                                "tr": "Derin <w>nefes almak</w> stresli durumlarda rahatlamanıza yardımcı olabilir."
                            }
                        },
                        {
                            "text": "His <w>breathing</w> became shallow as he fell asleep.",
                            "target_lang_translations": {
                                "ru": "Его <w>дыхание</w> стало поверхностным, когда он заснул.",
                                "tr": "Uykuya dalarken <w>nefes alışverişi</w> sığlaştı."
                            }
                        }
                    ],
                    "synonyms": [
                        "respiration"
                    ],
                    "common_phrases": [
                        "heavy breathing",
                        "deep breathing",
                        "shallow breathing"
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт или процесс вдыхания воздуха в легкие и его выдыхания.",
                        "tr": "Havanın akciğerlere alınıp dışarı verilmesi eylemi veya süreci."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дыхание",
                                "target_lang_sense_clarification": "физиологический процесс"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "nefes",
                                "target_lang_sense_clarification": "fiziksel süreç"
                            },
                            {
                                "target_lang_word": "soluk",
                                "target_lang_sense_clarification": "nefes alıp verme"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9bd858e0-1eb4-34b7-b374-73d03a42c255",
                    "sense_definition": "A short period of time to rest or recover one's breath; a pause.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We took a short <w>breathing</w> before continuing our journey up the mountain.",
                            "target_lang_translations": {
                                "ru": "Мы сделали короткую <w>передышку</w>, прежде чем продолжить путь в гору.",
                                "tr": "Dağa tırmanışımıza devam etmeden önce kısa bir <w>nefes molası</w> verdik."
                            }
                        },
                        {
                            "text": "The soldiers were granted a <w>breathing</w> after the long march.",
                            "target_lang_translations": {
                                "ru": "Солдатам дали <w>передышку</w> после долгого марша.",
                                "tr": "Askerlere uzun yürüyüşten sonra bir <w>nefes alma</w> süresi tanındı."
                            }
                        }
                    ],
                    "synonyms": [
                        "pause",
                        "respite",
                        "rest"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used in older texts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Короткий промежуток времени для отдыха или восстановления дыхания; пауза.",
                        "tr": "Dinlenmek veya nefes tazelemek için verilen kısa süre; mola."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "передышка",
                                "target_lang_sense_clarification": "короткий отдых"
                            },
                            {
                                "target_lang_word": "перерыв",
                                "target_lang_sense_clarification": "пауза"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "nefes alma",
                                "target_lang_sense_clarification": "dinlenme molası"
                            },
                            {
                                "target_lang_word": "mola",
                                "target_lang_sense_clarification": "kısa ara"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f0def706-b704-3d77-a665-7eaa0566a379",
                    "sense_definition": "A diacritical mark used in languages like Ancient Greek to indicate aspiration (the presence or absence of an 'h' sound).",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The student forgot to write the rough <w>breathing</w> on the initial vowel.",
                            "target_lang_translations": {
                                "ru": "Студент забыл написать знак густого <w>придыхания</w> над начальной гласной.",
                                "tr": "Öğrenci, ilk sesli harfin üzerine <w>kalın soluk işaretini</w> koymayı unuttu."
                            }
                        },
                        {
                            "text": "In this text, the smooth <w>breathing</w> indicates that the vowel is not aspirated.",
                            "target_lang_translations": {
                                "ru": "В этом тексте знак тонкого <w>придыхания</w> указывает на то, что гласная не аспирируется.",
                                "tr": "Bu metinde, <w>ince soluk işareti</w> sesli harfin aspirasyonlu olmadığını gösterir."
                            }
                        }
                    ],
                    "common_phrases": [
                        "rough breathing",
                        "smooth breathing"
                    ],
                    "target_lang_definitions": {
                        "ru": "Диакритический знак, используемый в таких языках, как древнегреческий, для обозначения придыхания (наличия или отсутствия звука 'h').",
                        "tr": "Eski Yunanca gibi dillerde aspirasyonu (h sesinin varlığını veya yokluğunu) belirtmek için kullanılan bir işaret."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "придыхание",
                                "target_lang_sense_clarification": "лингвистический термин"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "soluk işareti",
                                "target_lang_sense_clarification": "dilbilgisi terimi"
                            },
                            {
                                "target_lang_word": "nefes işareti",
                                "target_lang_sense_clarification": "dilbilgisi terimi"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a01dfb0d-90af-3c16-a2ca-bfa9cb73acc3",
                    "sense_definition": "A gentle influence, whisper, or inspiration.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "figurative_influence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She felt the soft <w>breathing</w> of the wind against her face.",
                            "target_lang_translations": {
                                "ru": "Она почувствовала мягкое <w>дуновение</w> ветра на своем лице.",
                                "tr": "Yüzünde rüzgarın hafif <w>esintisini</w> hissetti."
                            }
                        },
                        {
                            "text": "The poet described the <w>breathings</w> of nature in spring.",
                            "target_lang_translations": {
                                "ru": "Поэт описал весеннее <w>дыхание</w> природы.",
                                "tr": "Şair, baharda doğanın <w>esintilerini</w> betimledi."
                            }
                        }
                    ],
                    "synonyms": [
                        "whisper",
                        "inspiration"
                    ],
                    "target_lang_definitions": {
                        "ru": "Мягкое влияние, шепот или вдохновение.",
                        "tr": "Hafif bir etki, esinti veya ilham."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дуновение",
                                "target_lang_sense_clarification": "ветра или воздуха"
                            },
                            {
                                "target_lang_word": "веяние",
                                "target_lang_sense_clarification": "переносное значение"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "esinti",
                                "target_lang_sense_clarification": "hafif rüzgar"
                            },
                            {
                                "target_lang_word": "esinti",
                                "target_lang_sense_clarification": "mecazi anlamda"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c3782732-c27b-3648-8960-1d796d31dd27",
                    "sense_definition": "A quiet, earnest desire or secret prayer.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "figurative_influence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His silent <w>breathings</w> for help were eventually answered.",
                            "target_lang_translations": {
                                "ru": "Его безмолвные <w>мольбы</w> о помощи в конце концов были услышаны.",
                                "tr": "Sessiz yardım <w>yakarışları</w> sonunda yanıt buldu."
                            }
                        },
                        {
                            "text": "She sent up daily <w>breathings</w> for the safety of her family.",
                            "target_lang_translations": {
                                "ru": "Она ежедневно возносила <w>молитвы</w> о безопасности своей семьи.",
                                "tr": "Ailesinin güvenliği için her gün <w>dualar</w> gönderiyordu."
                            }
                        }
                    ],
                    "synonyms": [
                        "prayer",
                        "aspiration"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "religious or literary context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Тихое, искреннее желание или тайная молитва.",
                        "tr": "Sessiz, içten bir arzu veya gizli bir dua."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "воздыхание",
                                "target_lang_sense_clarification": "устаревшее, поэтическое"
                            },
                            {
                                "target_lang_word": "мольба",
                                "target_lang_sense_clarification": "просьба"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "yakarış",
                                "target_lang_sense_clarification": "içten dua"
                            },
                            {
                                "target_lang_word": "ah",
                                "target_lang_sense_clarification": "derin bir dilek veya üzüntü"
                            }
                        ]
                    }
                }
            ]
        }
    ]
