                                "target_senses": [
                                    {
                                        "sense_id": "c3f0e086-7b80-3f15-95be-7ed91b138339",
                                        "entry_id": "a1c6997f-1687-3289-bbc5-420db4f4e9ec",
                                        "glosses": [
                                            "Qui appartient, qui a rapport à la cosmogonie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5135f44-1070-47e8-8bdf-8ab91cf7599c",
                                                "sense_id": "c3f0e086-7b80-3f15-95be-7ed91b138339",
                                                "text": "L'être pur, c'est Bouddha, […]. Il produit tous les mondes par une irradiation éternelle. […]; de là tout un édifice cosmogonique, le plus gigantesque sans doute que l'imagination humaine ait jamais élevé."
                                            },
                                            {
                                                "example_id": "13afc13c-3643-41f8-ab9f-5a77c8344172",
                                                "sense_id": "c3f0e086-7b80-3f15-95be-7ed91b138339",
                                                "text": "Je viens de donner, avec son contour général seulement, mais aussi avec tout le détail nécessaire pour l’intelligence, un tableau de la Théorie cosmogonique de Laplace telle que son auteur lui-même l’a conçue."
                                            },
                                            {
                                                "example_id": "e3a2bd71-c24d-4eaa-bbee-89a9e1ab7864",
                                                "sense_id": "c3f0e086-7b80-3f15-95be-7ed91b138339",
                                                "text": "Le « cercle » a une dimension cosmogonique symbolisant une constellation organisée autour d'un point fixe comme l'étoile polaire"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
