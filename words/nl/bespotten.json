                    "sense_definition": "Iemand of iets belachelijk maken of uitlachen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "spotten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het is niet netjes om anderen te <w>bespotten</w> om hun uiterlijk.",
                            "target_lang_translations": {
                                "en": "It is not polite to <w>mock</w> others for their appearance."
                            }
                        },
                        {
                            "text": "De menigte begon de spreker te <w>bespotten</w> toen hij zijn fouten toegaf.",
                            "target_lang_translations": {
                                "en": "The crowd began to <w>ridicule</w> the speaker when he admitted his mistakes."
                            }
                        }
                    ],
                    "synonyms": [
                        "uitlachen",
                        "bespotten",
                        "schimpen"
                    ],
                    "common_phrases": [
                        "openlijk bespotten",
                        "meedogenloos bespotten"
                    ],
                    "target_lang_definitions": {
                        "en": "To make someone or something look ridiculous or to laugh at them in a mocking way."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "mock",
                                "target_lang_sense_clarification": "To tease or laugh at in a scornful or contemptuous manner."
                            },
                            {
                                "target_lang_word": "ridicule",
                                "target_lang_sense_clarification": "To subject someone or something to derision or mockery."
                            },
                            {
                                "target_lang_word": "deride",
                                "target_lang_sense_clarification": "To express contempt for; to ridicule."
                            }
                        ]
                    }
