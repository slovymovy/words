                                        "sense_id": "cf8aede8-62e1-3c38-b022-b64ed7f7b87e",
                                        "entry_id": "1e371667-ff6e-359f-87b1-085419bded52",
                                        "glosses": [
                                            "обсц., уничиж. человек со странностями, чудак"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc908d88-e6e1-4669-a4cf-417d0dd1eaee",
                                                "sense_id": "cf8aede8-62e1-3c38-b022-b64ed7f7b87e",
                                                "text": "Было бы проще бы, Летов я будь ебанат. Было бы ясно, виновен кто в том, что вокруг."
                                            }
                                        ]
                                    }
                                ]
