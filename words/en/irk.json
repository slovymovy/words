{
    "word_family": [
        "irksome"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3d942c65-2489-3c4e-9479-19009417cbc4",
                    "sense_definition": "To irritate, annoy, or bother someone.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "annoyance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It <w>irks</w> me when people talk loudly during a movie.",
                            "target_lang_translations": {
                                "ru": "Меня <w>раздражает</w>, когда люди громко разговаривают во время фильма."
                            }
                        },
                        {
                            "text": "The constant noise from the construction site <w>irked</w> the neighbors all day.",
                            "target_lang_translations": {
                                "ru": "Постоянный шум со стройплощадки весь день <w>досаждал</w> соседям."
                            }
                        }
                    ],
                    "synonyms": [
                        "annoy",
                        "irritate",
                        "bother",
                        "vex"
                    ],
                    "antonyms": [
                        "please",
                        "delight"
                    ],
                    "target_lang_definitions": {
                        "ru": "Раздражать, вызывать досаду или докучать кому-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "раздражать",
                                "target_lang_sense_clarification": "вызывать недовольство, досаду"
                            },
                            {
                                "target_lang_word": "досаждать",
                                "target_lang_sense_clarification": "причинять неприятность, докучать"
                            },
                            {
                                "target_lang_word": "злить",
                                "target_lang_sense_clarification": "вызывать злость или нервозность"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3bbe2030-1453-3df5-8717-bceb50fb10ec",
                    "sense_definition": "A source of annoyance or irritation.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "annoyance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The slow internet connection was a major <w>irk</w> for the office staff.",
                            "target_lang_translations": {
                                "ru": "Медленное интернет-соединение было главным <w>раздражителем</w> для сотрудников офиса."
                            }
                        },
                        {
                            "text": "One minor <w>irk</w> about the new software is its complex user interface.",
                            "target_lang_translations": {
                                "ru": "Один незначительный <w>повод для раздражения</w> в новой программе — это её сложный пользовательский интерфейс."
                            }
                        }
                    ],
                    "synonyms": [
                        "annoyance",
                        "irritation",
                        "nuisance"
                    ],
                    "target_lang_definitions": {
                        "ru": "Источник раздражения, досады или беспокойства."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "раздражитель",
                                "target_lang_sense_clarification": "то, что вызывает раздражение"
                            },
                            {
                                "target_lang_word": "повод для раздражения",
                                "target_lang_sense_clarification": "причина досады"
                            },
                            {
                                "target_lang_word": "досада",
                                "target_lang_sense_clarification": "неприятность, огорчение"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "32f9b18d-ee0d-3764-8526-6c6e5b6d7787",
                    "sense_definition": "A river in Greater Manchester, England.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "geographical_feature",
                    "examples": [
                        {
                            "text": "The River <w>Irk</w> flows through the northern part of Manchester.",
                            "target_lang_translations": {
                                "ru": "Река <w>Эрк</w> протекает через северную часть Манчестера."
                            }
                        },
                        {
                            "text": "Historically, the <w>Irk</w> was an important waterway for local industry.",
                            "target_lang_translations": {
                                "ru": "Исторически <w>Эрк</w> была важной водной артерией для местной промышленности."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Река в Большом Манчестере, Англия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Эрк",
                                "target_lang_sense_clarification": "река в Англии"
                            },
                            {
                                "target_lang_word": "Ирк",
                                "target_lang_sense_clarification": "река в Англии (вариант транслитерации)"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}