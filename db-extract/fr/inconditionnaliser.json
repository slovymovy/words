                "senses": [
                    {
                        "sense_id": "55c034d0-433e-381e-9525-9e93b55da082",
                        "entry_id": "cf01725d-f1b2-346b-bd2c-dfb8c935353e",
                        "glosses": [
                            "Donner un caractère inconditionnel à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7db57ea2-51f6-4d13-8918-05ecd4af6b50",
                                "sense_id": "55c034d0-433e-381e-9525-9e93b55da082",
                                "text": "Il est bien évident que les « engagements » qui sont subordonnés à une « opinion » (littéraire, politique, etc) sont, par essence, conditionnels; je ne pourrais les inconditionnaliser que par une démarche illégitime."
                            },
                            {
                                "example_id": "aea334b2-c3c1-45d0-90b8-7fc410896870",
                                "sense_id": "55c034d0-433e-381e-9525-9e93b55da082",
                                "text": "Dans un premier temps, la Loi apparaît donc comme ce qui suspend le désir et l’oblige ainsi à s’«inconditionnaliser» en volonté libre;"
                            }
                        ]
                    }
                ],
