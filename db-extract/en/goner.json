                                            {
                                                "example_id": "c7458b4e-d0ff-42ec-9a13-1b6e750c34fe",
                                                "sense_id": "729c1890-55d3-3533-9235-6f84fef3d75d",
                                                "text": "O comandante do Bope não acredita em balas perdidas e acusa os traficantes pelo assassinato da criança."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c8033262-dfa9-3f2e-8bcd-3f81fb202621",
                                        "entry_id": "416f3f58-af54-31a2-92b9-c5de563793a7",
