                        "entry_id": "13a331cf-6afd-3eca-ad76-f3eb77f38613",
                        "glosses": [
                            "indoarische Sprache, die sich aus den beiden standardisierten Varietäten Urdu und Hindi zusammensetzt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ca4387f2-5f75-45ae-80cf-993a682970a8",
                                "sense_id": "883c9ade-5210-3bc0-ab2c-208c3f144ca3",
                                "text": "„Kommandos wurden in Hindustani gegeben, diesen begrenzten Wortschatz konnte man sich aneignen.“"
                            },
                            {
                                "example_id": "177aa68d-c66c-4096-ae99-49c3f643889f",
                                "sense_id": "883c9ade-5210-3bc0-ab2c-208c3f144ca3",
                                "text": "„Auch Gandhi mußte sich eifrig Mühe geben, Hindustani und Hindi zu lernen. Denn seine Muttersprache war Gujarati, sonst Englisch.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
