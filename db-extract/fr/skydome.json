                    {
                        "sense_id": "85308ee1-b158-3b2e-a74c-e946ad05b6f3",
                        "entry_id": "59684231-9dc0-3a94-957a-7c048579e730",
                        "glosses": [
                            "Hublot de toit servant de puits de lumière ainsi que de trappe de désenfumage lors des incendies."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "85e555ff-00aa-4cb6-becd-bf637be0aa14",
                                "sense_id": "85308ee1-b158-3b2e-a74c-e946ad05b6f3",
                                "text": "Quatre étages de plus ça compte en matière de luminosité, surtout que cette antichambre dont il se sert pour recevoir ses visiteurs est en prise directe avec le ciel, seulement séparé d’un skydome de bonne dimension."
                            },
                            {
                                "example_id": "9e80aba9-4409-431a-8cea-63b5cadeae98",
                                "sense_id": "85308ee1-b158-3b2e-a74c-e946ad05b6f3",
                                "text": "Dormir à la belle étoile sans les inconvénients est désormais possible ! Ces petits cubes en bois, équipés d’un skydome, vous promettent une nuit des plus étincelantes !"
                            },
                            {
                                "example_id": "d6c29799-ea19-4bf1-9e9b-06e5d5d6f009",
                                "sense_id": "85308ee1-b158-3b2e-a74c-e946ad05b6f3",
                                "text": "La masse de tissu, pourrissante et éphémère, subissait les flots des pluies qui ruisselaient par les fissures des skydomes en Plexiglas."
                            }
                        ]
                    }
                ],
