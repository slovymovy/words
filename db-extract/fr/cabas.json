                                    {
                                        "sense_id": "e412144a-c461-3c8d-9648-4c72e12fde92",
                                        "entry_id": "53177c1a-1928-3069-b0b7-fa0682c78dfd",
                                        "glosses": [
                                            "fester, tragbarer Behälter mit Tragegriff(en), um eingekaufte Waren zu transportieren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e8bbde2-23c0-49b6-b087-77e32fd9214b",
                                                "sense_id": "e412144a-c461-3c8d-9648-4c72e12fde92",
                                                "text": "„Reizl sah zu ihrem Einkaufskorb hinunter.“"
                                            },
                                            {
                                                "example_id": "52aaa064-b5f1-4404-b4be-90ab015fa549",
                                                "sense_id": "e412144a-c461-3c8d-9648-4c72e12fde92",
                                                "text": "„Val und Bobby nahmen sich einen Einkaufskorb und füllten ihn mit Schokoladenriegeln und anderen Süßigkeiten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dcb0e0c7-1cf2-48db-af24-ed72c1e3a726",
                        "source_entry_id": "73bee13a-1631-3376-9f84-c51fdaf1a58d",
                        "source_sense_id": "f060a234-8499-394a-907f-f114902761a6",
                        "source_sense_description": "Einkaufskorb; Einkaufstasche; Plastikbeutel; Strohkorb",
                        "target_lang_word": "Einkaufstasche",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Einkaufstasche",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8bb8b7a3-1c9a-3801-852b-3b6a13efc635",
                                        "entry_id": "23f033d8-96b3-30df-b105-0c342099342a",
                                        "glosses": [
                                            "Tasche für den Transport von eingekauften Waren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3397e038-b550-470b-8ebb-784e82843672",
                                                "sense_id": "8bb8b7a3-1c9a-3801-852b-3b6a13efc635",
                                                "text": "„Eine Frau mit einer geräumigen Einkaufstasche in der Hand öffnet die Tür, starrt herein und sucht nach Worten.“"
                                            },
                                            {
                                                "example_id": "c830eeaf-fb3f-484c-8cd8-198432695e27",
                                                "sense_id": "8bb8b7a3-1c9a-3801-852b-3b6a13efc635",
                                                "text": "„Ehe sie ausstiegen, holte der Major eine große, offene Einkaufstasche unter dem Sitz hervor, und Frau Holle konnte sehen, daß dort nicht nur Konserven, sondern auch Whisky verstaut war.“"
                                            },
                                            {
                                                "example_id": "20caacc0-d580-41c9-b05c-7ca3e42bc20d",
                                                "sense_id": "8bb8b7a3-1c9a-3801-852b-3b6a13efc635",
                                                "text": "„Auf dem fleckigen Spiegel stand der Schatten ihrer Mutter und trug eine Einkaufstasche, trug die fahlen Kleider der Selbstauslöschung, die Uniform der Güte.“"
                                            },
                                            {
                                                "example_id": "56396afe-3ae6-489d-b576-5573c4918549",
                                                "sense_id": "8bb8b7a3-1c9a-3801-852b-3b6a13efc635",
                                                "text": "„Sie grüßt kurz und legt Dosenmilch, Öl und Hefe in ihre Einkaufstasche.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e44281b6-9c54-4505-8fa9-44bc20827fa6",
                        "source_entry_id": "73bee13a-1631-3376-9f84-c51fdaf1a58d",
