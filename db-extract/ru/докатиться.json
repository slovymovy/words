                "senses": [
                    {
                        "sense_id": "a012d06c-9886-3811-a67a-dc82bc42af94",
                        "entry_id": "cf0af14c-f52c-3d5f-ac97-41ea5effe2ee",
                        "glosses": [
                            "to roll (to), to go rolling (to)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e364c36-9d48-44fc-a195-f1f7545c6149",
                                "sense_id": "a012d06c-9886-3811-a67a-dc82bc42af94",
                                "text": "Ле́стница была́ высо́кая, крута́я, но он докати́лся до́низу благополу́чно; встал и потро́гал себя́ за нос: це́лы ли очки́?",
                                "translation": "The staircase was high and steep, but he rolled to the bottom unhurt, got up, and touched his nose to see whether his spectacles were all right.",
                                "english": "The staircase was high and steep, but he rolled to the bottom unhurt, got up, and touched his nose to see whether his spectacles were all right."
                            }
                        ]
                    },
