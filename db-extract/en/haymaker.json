                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "5dc49273-9d7d-34c8-a95a-8ce871bb2533",
                                        "entry_id": "a77e128d-934c-3b51-a289-a19fa29e24d3",
                                        "glosses": [
                                            "hele krachtige slag"
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b3ad546d-5130-4be7-bfa8-ff62a80bd420",
                                                "sense_id": "5dc49273-9d7d-34c8-a95a-8ce871bb2533",
                                                "text": "‘Ze moeten niet proberen hier het pad op te komen,’ zei Wolf. ‘Ik geef ze meteen een rotklap op hun grote rotkop.’ Hij zwaaide een zware tak (want hij had altijd een of andere stok bij zich) door de lucht."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4e24e2fd-8ef2-3913-ae38-cbc198a1ed04",
                                        "entry_id": "a77e128d-934c-3b51-a289-a19fa29e24d3",
                                        "glosses": [
                                            "hele harde botsing"
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c09c2070-bf23-4a76-bf49-2f954fa40afb",
                                                "sense_id": "4e24e2fd-8ef2-3913-ae38-cbc198a1ed04",
                                                "text": "Het gaat om de grote drukte op de Waal, 70 schepen per uur is al te veel, hier komt nog eens een rotklap."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d7216de6-b6c2-394d-9b32-aee7c1da99db",
                                        "entry_id": "a77e128d-934c-3b51-a289-a19fa29e24d3",
                                        "glosses": [
                                            "luide knal"
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "12fc3bfb-72fd-4622-a992-400a94ed48f4",
                                                "sense_id": "d7216de6-b6c2-394d-9b32-aee7c1da99db",
                                                "text": "Hij zet de verfbus op de schoorsteenmantel, drukt er de deksel stevig op... en laat ie me nou de hele schoorsteenmantel naar beneden drukken! En een rotklap dat ’t gaf!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
