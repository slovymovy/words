    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a1c6cfd3-46cb-36f0-badb-e0071b2c1f41",
                    "sense_definition": "present participle and gerund of <w>faint</w>",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "faint_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She suddenly felt dizzy and fell to the floor, <w>fainting</w> from the intense heat.",
                            "target_lang_translations": {
                                "de": "Ihr wurde plötzlich schwindelig und sie fiel zu Boden, wobei sie vor der großen Hitze <w>in Ohnmacht fiel</w>."
                            }
                        },
                        {
                            "text": "Several people were <w>fainting</w> in the crowded room due to lack of fresh air.",
                            "target_lang_translations": {
                                "de": "In dem überfüllten Raum <w>wurden</w> mehrere Personen wegen des Mangels an frischer Luft <w>ohnmächtig</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "swooning",
                        "blacking out",
                        "passing out"
                    ],
                    "common_phrases": [
                        "fainting from exhaustion",
                        "fainting from heat"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle and gerund"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Partizip Präsens und Gerundium von „faint“; in Ohnmacht fallend"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "in Ohnmacht fallen",
                                "target_lang_sense_clarification": "Verbalhandlung: das Bewusstsein verlieren"
                            },
                            {
                                "target_lang_word": "ohnmächtig werden",
                                "target_lang_sense_clarification": "Verbalhandlung: das Bewusstsein verlieren"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "82761623-59a9-3a47-85a1-f57aa0a62208",
                    "sense_definition": "An act of collapsing into a state of temporary unconsciousness.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "faint_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His sudden <w>fainting</w> alarmed everyone in the doctor's waiting room.",
                            "target_lang_translations": {
                                "de": "Seine plötzliche <w>Ohnmacht</w> beunruhigte alle im Wartezimmer des Arztes."
                            }
                        },
                        {
                            "text": "She suffered a sudden <w>fainting</w> fit brought on by severe dehydration.",
                            "target_lang_translations": {
                                "de": "Sie erlitt einen plötzlichen <w>Ohnmachtsanfall</w>, der durch schwere Dehydratation ausgelöst wurde."
                            }
                        }
                    ],
                    "synonyms": [
                        "swoon",
                        "syncope",
                        "blackout"
                    ],
                    "common_phrases": [
                        "fainting fit",
                        "fainting spell"
                    ],
                    "target_lang_definitions": {
                        "de": "Der Vorgang des Zusammensackens in einen Zustand vorübergehender Bewusstlosigkeit."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Ohnmacht",
                                "target_lang_sense_clarification": "vorübergehende Bewusstlosigkeit"
                            },
                            {
                                "target_lang_word": "Ohnmachtsanfall",
                                "target_lang_sense_clarification": "plötzliches Eintreten von Bewusstlosigkeit"
                            },
                            {
                                "target_lang_word": "Synkope",
                                "target_lang_sense_clarification": "medizinischer Fachbegriff für kurzen Kreislaufkollaps mit Bewusstlosigkeit"
                            }
                        ]
                    }
                }
            ]
        }
    ]
