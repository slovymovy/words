                    {
                        "translation_id": "5cdf7667-9fe7-498a-ba2f-7475fd665dde",
                        "source_entry_id": "eaf6fcb5-4028-3344-93f7-ba0a01db1c3d",
                        "source_sense_id": "685659b9-9100-3ffe-bb36-dc17d360a101",
                        "target_lang_word": "Logbuch",
