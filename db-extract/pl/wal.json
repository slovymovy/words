                            },
                            {
                                "target_word": "whale",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1f94f2a1-1458-3546-bb41-49e532525131",
                                        "entry_id": "d77e554c-e874-3c31-a57e-d98e6797b0f8",
                                        "glosses": [
                                            "To thrash, to flog, to beat vigorously or soundly."
                                        ],
                                        "tags": [
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "52c33cfe-5883-48b9-9b68-5684b726d473",
                                                "sense_id": "1f94f2a1-1458-3546-bb41-49e532525131",
                                                "text": "Brought him back, put him in the stall—low stable—got out of his reach, and then begun to whale him. Then he kicked up agin; […]"
                                            },
                                            {
                                                "example_id": "4c6980c6-d46f-42aa-b58a-d25d1a99b366",
                                                "sense_id": "1f94f2a1-1458-3546-bb41-49e532525131",
                                                "text": "\"I wouldn't let him. When you were a boy in your part of the country, and other boys told tales about you, what did you do with them?\" \"Whaled 'em like time, Captin',\" answered the man; \"and if ye'll only shet yer eyes to 't, I'll whale him.\" \"I can't allow such things in the prison,\" said the Captain; \"and besides, the fellow will be lame for a fortnight, and wouldn't be a match for you in that condition. Let him get limber, and then, if you don't whale him, I'll make you walk the ladder for a month.\" The result was, the conscript officer received a sound thrashing; and did not commit another act worthy of punishment for a week."
                                            },
                                            {
                                                "example_id": "601edf41-2f72-47d2-b38d-089fdee9ee9f",
                                                "sense_id": "1f94f2a1-1458-3546-bb41-49e532525131",
                                                "text": "They beat him down and kept whaling him after he was flat."
                                            },
                                            {
                                                "example_id": "35aa6142-e105-4f9c-b149-0b3a857fbfe1",
                                                "sense_id": "1f94f2a1-1458-3546-bb41-49e532525131",
                                                "text": "For quotations using this term, see Citations:whale."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f83fd4c0-a686-497c-a0e5-46800f7fe43e",
                        "source_entry_id": "674e5d2f-b402-3934-abbe-356d6b36ee35",
                        "source_sense_id": "0d773d4c-20d9-3882-9226-1fde1655c8d0",
                        "target_lang_word": "Wal",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wal",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e29c2492-7340-3846-a115-17777824fbc6",
                                        "entry_id": "36e3ec19-893f-3c6e-8cba-8644e969f783",
                                        "glosses": [
                                            "oft sehr großes, im Wasser lebendes Säugetier (Ordnung Cetacea)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6d85c40-8b6c-454a-887e-4bb39eb89738",
                                                "sense_id": "e29c2492-7340-3846-a115-17777824fbc6",
                                                "text": "Wale sind die größten Säugetiere."
                                            },
                                            {
                                                "example_id": "d3fc2ae6-8939-46f6-9117-2f0345613786",
                                                "sense_id": "e29c2492-7340-3846-a115-17777824fbc6",
                                                "text": "Die meisten Wale sind vom Aussterben bedroht."
                                            },
                                            {
                                                "example_id": "a96fbc50-5f96-4af6-be25-f3f01add7f03",
                                                "sense_id": "e29c2492-7340-3846-a115-17777824fbc6",
                                                "text": "„Auch die Inuit sind sprachlos, wenn sie zum ersten Mal einen Wal sehen.“"
                                            },
                                            {
                                                "example_id": "ca15b453-1008-4d2f-b685-79194237282e",
                                                "sense_id": "e29c2492-7340-3846-a115-17777824fbc6",
                                                "text": "„Wie die Fledermäuse stoßen die Wale kurze Klicklaute aus, deren Echo ihnen dann ein Hörbild vermittelt.“"
                                            },
                                            {
                                                "example_id": "a49ae60e-00e2-423d-9638-2898fdd29660",
                                                "sense_id": "e29c2492-7340-3846-a115-17777824fbc6",
                                                "text": "„Ja, der Wal kommt als Steak auf den Teller.“"
                                            },
                                            {
                                                "example_id": "4281d467-07cb-4d94-b0b5-a8eed81fc4d5",
                                                "sense_id": "e29c2492-7340-3846-a115-17777824fbc6",
                                                "text": "„Die Wale verfügen über eine Technik, ihre Lunge fast vollständig zu entleeren und sie kollabieren zu lassen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "62717ba7-1ae8-354b-9753-8f81b3c45100",
                                        "entry_id": "36e3ec19-893f-3c6e-8cba-8644e969f783",
                                        "glosses": [
                                            "Person, die für eine Sache (meist Onlinespiele, Glücksspiel oder ähnliches) extreme Summen an Geld ausgibt, teilweise bis zum finanziellen Ruin"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5eb6d265-ea16-41b7-8e92-20e203e0894d",
                                                "sense_id": "62717ba7-1ae8-354b-9753-8f81b3c45100",
                                                "text": "„Kajiyama war ein »Wal«. So nennt man in Vegas Prominente, die viel Geld ausgeben.“"
                                            },
                                            {
                                                "example_id": "eaebcc24-79e0-4a46-b153-77dd01d1930c",
                                                "sense_id": "62717ba7-1ae8-354b-9753-8f81b3c45100",
                                                "text": "Als Wal bezeichnet man in der Branche einen Spieler, der bereit ist, mehr für ein Spiel auszugeben."
                                            },
                                            {
                                                "example_id": "048dab06-8ac4-4e88-8e1d-787d4f010c72",
                                                "sense_id": "62717ba7-1ae8-354b-9753-8f81b3c45100",
                                                "text": "\"Wale\" sind für Spielehersteller besonders wertvoll, da es sich um besonders spendierfreudige Nutzer handelt, die für einen Großteil der Einnahmen verantwortlich sind."
                                            },
                                            {
                                                "example_id": "9214e6cf-5a8f-4a0f-9ed0-93afb901070e",
                                                "sense_id": "62717ba7-1ae8-354b-9753-8f81b3c45100",
                                                "text": "Während der sogenannte \"Wal\" (ein Spieler, der besonders viel Geld ausgibt) seine imaginären Wunden leckt, reagiert die Community lediglich mit Spott, da er eine stärkere Klasse spielt."
                                            },
                                            {
                                                "example_id": "8c34ccb7-ae8d-419c-bc8d-043ba026939b",
                                                "sense_id": "62717ba7-1ae8-354b-9753-8f81b3c45100",
                                                "text": "Fiedler sieht die Idee vom Pay2Win-Gaming als Ursache für das Symptom Lootbox, weil das Geschäftsmodell dahinter darauf basiert, dass ganz wenige Spieler - die sogenannten Wale - sehr viel Geld ausgeben, \"ähnlich wie beim Glücksspiel\"."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
