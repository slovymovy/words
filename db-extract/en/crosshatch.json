                                                "example_id": "c247ba4d-7c48-472a-9d22-40ea37da3726",
                                                "sense_id": "f8cd5ff2-76b9-3213-a88a-174e4f62dc51",
                                                "text": "Schnittzeichnungen werden häufig schraffiert."
                                            }
                                        ],
                                        "sense_index_json": "\"1a\""
                                    },
                                    {
                                        "sense_id": "e81b88a9-4d18-392a-834f-2249f2058618",
                                        "entry_id": "27b0e466-3fcc-3fa6-b0ea-df26f6484b30",
                                        "glosses": [
                                            "mit einer nach DIN 201 festgelegten und genormten Schraffur kennzeichnen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9fc21ba3-f87e-44d7-8c2f-ce8d1bc92f8a",
                                                "sense_id": "e81b88a9-4d18-392a-834f-2249f2058618",
                                                "text": "Gase werden in technischen Zeichnungen gesondert durch parallel angeordnete Kreise schraffiert."
                                            }
                                        ],
                                        "sense_index_json": "\"1b\""
                                    },
                                    {
                                        "sense_id": "ddf5a11e-f717-3f21-b82a-0760d86ab8c8",
                                        "entry_id": "27b0e466-3fcc-3fa6-b0ea-df26f6484b30",
                                        "glosses": [
                                            "mittels eng aneinander gesetzten Strichen Grauwerte, Farbtöne und Schattierungen in einer bildlichen Darstellung erzeugen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "631124ff-e914-4eae-80d4-efac766da4e6",
                                                "sense_id": "ddf5a11e-f717-3f21-b82a-0760d86ab8c8",
                                                "text": "Sie schraffierte die Zeichnung, um ihren Figuren noch mehr Plastizität und Tiefe zu verleihen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "a511888b-0058-3b58-b836-ed8d2cf0756e",
                                        "entry_id": "27b0e466-3fcc-3fa6-b0ea-df26f6484b30",
                                        "glosses": [
                                            "auf angewandten Karten, Gebiete mit bestimmten geographischen Eigenschaften mittels feinen, in unterschiedlicher Stärke, Dichte und Richtung angeordneten Schraffen plastisch hervorheben"
                                        ],
                                        "tags": [
                                            "outdated",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1289c7fc-5392-447e-b741-bcd25051b1df",
                                                "sense_id": "a511888b-0058-3b58-b836-ed8d2cf0756e",
                                                "text": "Auf älteren Landkarten wurden Berge, Täler, Hügel, Senken, Sümpfe, Moore usw. usf. schraffiert dargestellt."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "28bc8792-5d6d-30c9-b226-98d4789182ee",
                                        "entry_id": "27b0e466-3fcc-3fa6-b0ea-df26f6484b30",
                                        "glosses": [
                                            "die Wappenfarben, etwa einer Schwarz-Weiß-Tinktur oder bei Metallarbeiten, codiert mittels dicht nebeneinander gesetzter Punkte und Striche darstellen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6a4d9741-db1b-45e2-975e-59cc87485f8d",
                                                "sense_id": "28bc8792-5d6d-30c9-b226-98d4789182ee",
                                                "text": "Möchte man von einem Wappen etwa ein Briefstempel erstellen, so muss man die Farben des Wappens beim Anfertigen des Stempels schraffiert wiedergeben."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
