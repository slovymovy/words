                    },
                    {
                        "translation_id": "f32a49f8-f14a-4567-9deb-1f7d85ced040",
                        "source_entry_id": "ddbd9ff1-61e9-3dd5-a7d5-199603cdad8a",
                        "source_sense_id": "f5766e34-4723-39b3-81f3-637cf95e447c",
                        "source_sense_description": "einen Berg hinauf",
                        "target_lang_word": "en amont",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "en amont",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "79e6deda-7c14-3364-9900-cb0ed1771198",
                                        "entry_id": "c25eed89-6e85-3e29-b8ee-258d2d47f015",
                                        "glosses": [
                                            "Plus haut, en remontant un cours d’eau vers sa source."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a213d31a-e195-40d0-9537-b60a27f63eb1",
                                                "sense_id": "79e6deda-7c14-3364-9900-cb0ed1771198",
                                                "text": "Nous faisons route vers notre prochaine étape, dix kilomètres en amont."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b06f17da-c88b-3a03-abcc-a54a4bef089e",
                                        "entry_id": "c25eed89-6e85-3e29-b8ee-258d2d47f015",
                                        "glosses": [
                                            "Avant ; en remontant vers la cause, l’origine, le sommet de l’enchaînement ou de la hiérarchie."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "85186098-f674-4c15-bf1e-442ee8f9bff8",
                                                "sense_id": "b06f17da-c88b-3a03-abcc-a54a4bef089e",
                                                "text": "Autour du véhicule s’affairent les équipes de sapeurs-pompiers, les uns s’attachant à mettre en sécurité le lieu de l’intervention avec balisage, ambulance en amont, fourgon en aval et même VPR (véhicule de protection routière), utilisé sur les 2x2 voies, tandis que d’autres, d’abord autour du véhicule, s’occupent de la victime."
                                            },
                                            {
                                                "example_id": "405106db-5b40-4fee-93b4-9da330526ac1",
                                                "sense_id": "b06f17da-c88b-3a03-abcc-a54a4bef089e",
                                                "text": "Les conducteurs de taxis ignorent que nous travaillons en amont avec l’administration centrale et en aval avec le procureur de la république qui reste d’une manière incontestable le directeur de la police judiciaire comme le stipule l’article 12 du code de procédure pénale."
                                            },
                                            {
                                                "example_id": "0093d3b7-2c75-4e8a-9411-c3ccaf203e6a",
                                                "sense_id": "b06f17da-c88b-3a03-abcc-a54a4bef089e",
                                                "text": "J'avais l'impression que la France avait été informée très en amont que le contrat (de sous-marins qu'elle avait avec l'Australie) ne se ferait pas."
                                            },
                                            {
                                                "example_id": "a17273ce-1a55-4054-9a8e-07c265230fb1",
                                                "sense_id": "b06f17da-c88b-3a03-abcc-a54a4bef089e",
                                                "text": "En l’absence de censure en amont, il fallait qu’un livre soit d’abord publié pour pouvoir être ensuite interdit, ce qui permettait, si on jouait serré, de mettre un bon nombre d’exemplaires en circulation avant que les censeurs ne frappent."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
