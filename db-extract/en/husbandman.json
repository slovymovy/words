                ],
                "senses": [
                    {
                        "sense_id": "42e5068b-a02f-3696-843b-13f956622dba",
                        "entry_id": "752c6b93-de45-3336-96dc-3c4c7fc27e16",
                        "glosses": [
                            "a person who raises crops and tends animals; a farmer"
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "4fc67a51-7b6d-49a3-bd28-bbcf51a9a11e",
                                "sense_id": "42e5068b-a02f-3696-843b-13f956622dba",
                                "text": "The xviii day of May in the fourth yeare of the Raigne of the kinge most excellent Monarche and in the year of our lord god 1606 I Thomas Knages of Lythe within the county of york husbandman sicke in body but whole in mynde and in perfect remembrance praised be to god do make and ordayne this my last will and testament in manner and forme following . . -"
                            },
                            {
                                "example_id": "69a477a7-cff0-4bf7-8546-061bc23e4691",
                                "sense_id": "42e5068b-a02f-3696-843b-13f956622dba",
                                "text": "1684 Thomas Tusser, born at Riven-hall, was successively a Musician, School-master, Serving-man, and a Speculative Husbandman; - Anglorum Speculum: Or The Worthies of England, in Church and State - Thomas Fuller"
                            },
                            {
                                "example_id": "011d8870-3170-411b-8a30-deab106640b3",
                                "sense_id": "42e5068b-a02f-3696-843b-13f956622dba",
                                "text": "Valiant Wisdom tilling and draining; escorted by owl-eyed Pedantry, by owlish and vulturish and many other forms of Folly; — the valiant husbandman assiduously tilling; the blind greedy enemy too assiduously sowing tares!"
                            },
                            {
                                "example_id": "75765b69-4603-43d5-a243-e7e660aa0e87",
                                "sense_id": "42e5068b-a02f-3696-843b-13f956622dba",
                                "text": "The husbandman must labour before he receives the fruits"
                            },
                            {
                                "example_id": "463803c2-f469-4677-8b93-c58f001aff3e",
                                "sense_id": "42e5068b-a02f-3696-843b-13f956622dba",
                                "text": "The 'respected chaste female' is actorialized as a chopping, female husbandman …"
                            }
                        ]
                    }
                ],
