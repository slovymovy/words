                        "sense_id": "cf6f04d5-c6dc-33fe-916f-71df2cabbccf",
                        "entry_id": "7e9fb1c4-627f-3bc0-b6a1-558e114e38c3",
                        "glosses": [
                            "The amount held by a quiver"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8de9e9d6-242a-4b75-b7ff-72639e7712b1",
                                "sense_id": "cf6f04d5-c6dc-33fe-916f-71df2cabbccf",
                                "text": "In the presence of the two delegations the mediating Governor had taken an arrow and shown them with what ease it could be broken; then how impossible he found it to break a quiverful of arrows, thus demonstrating the strength in union."
                            },
                            {
                                "example_id": "f364f9b6-a460-4a76-b636-53b2cbdb3b68",
                                "sense_id": "cf6f04d5-c6dc-33fe-916f-71df2cabbccf",
                                "text": "Long-hafted, slender, bone-barbed throwing-spears lay along the gunwale of the canoe, while a quiverful of arrows hung on each man's back."
                            }
                        ]
                    },
                    {
                        "sense_id": "62efa1b9-86b1-37c4-9915-e53dd37270eb",
                        "entry_id": "7e9fb1c4-627f-3bc0-b6a1-558e114e38c3",
                        "glosses": [
                            "A large amount."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d9a5161f-07b2-44a5-9820-ab24c9f739ea",
                                "sense_id": "62efa1b9-86b1-37c4-9915-e53dd37270eb",
                                "text": "The farm of Sheridan Lawrence, exhibiting its wide-stretching wheat-fields, some heads of which counted seventy-one kernels, with its patches of one-pound potatoes, twelve-foot sunflowers, and its quiverful of happy, tow-headed children, gives as sweet a picture of Canadian thrift and happiness as one would wish to see."
                            }
                        ]
                    }
