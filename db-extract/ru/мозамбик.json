                    },
                    {
                        "translation_id": "50779995-7aa6-4982-a24e-cf180770c652",
                        "source_entry_id": "13a1da84-3693-3a7d-8d2c-a05ad506f25a",
                        "source_sense_id": "f36a7c3c-2200-3cd1-b685-103a70afe1fb",
                        "target_lang_word": "Mozambique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mozambique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "71c247a4-4480-3f0f-82d6-a96ca669e522",
                                        "entry_id": "bef5c917-6369-3632-aab1-0595d46e1030",
                                        "glosses": [
                                            "Pays situé sur la côte orientale de l’Afrique, entouré par l’Afrique du Sud, le Swaziland, le Zimbabwe, la Zambie, le Malawi et la Tanzanie. Sa capitale est Maputo."
                                        ],
                                        "tags": [
                                            "Pays"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ad82eda0-a40b-4e21-bd10-0b5de73a619d",
                                                "sense_id": "71c247a4-4480-3f0f-82d6-a96ca669e522",
                                                "text": "QUILOA, (Géog mod.) île & ville d’Afrique au Zanguebar, sur la côte de Mélinde, à 100 lieues du Mozambique. Les Portugais en firent la découverte en 1498, & rendirent son royaume leur tributaire."
                                            },
                                            {
                                                "example_id": "7261ee71-41b7-423a-bd8f-07c55ed7ed35",
                                                "sense_id": "71c247a4-4480-3f0f-82d6-a96ca669e522",
                                                "text": "Au XVIIIᵉ siècle, un Européen en voyage au Mozambique s’enquiert auprès d’un groupe d’esclaves qu’on s’apprête à charger dans la cale d’un bateau de ce qui, à leur avis, les attend : « Ils nous ont achetés et nous embarquent pour nous manger », répondent les esclaves."
                                            },
                                            {
                                                "example_id": "c0354791-efc0-43c0-af81-8925fbe18bb0",
                                                "sense_id": "71c247a4-4480-3f0f-82d6-a96ca669e522",
                                                "text": "L’Afrique du Sud, avec la fin de l’apartheid a vu ainsi affluer des migrants venus du Mozambique, de Zambie ou d’Angola quand les Afrikaners partaient vers l’Australie ou l’Amérique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
