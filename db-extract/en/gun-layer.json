                        "entry_id": "18795a78-56d6-38bc-a6cb-31ac23caf950",
                        "glosses": [
                            "A soldier who is assigned to aim and fire a mounted machine gun such as that on the turret of a tank."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a79485f-ae33-4c7c-ba90-587610ae3d51",
                                "sense_id": "ff83afb8-1e2e-3ce9-9944-f61502deab15",
                                "text": "A ship carries comparatively small guns to repel attacks by torpedo craft. We carry eight twelve-pounders, three three-pounders for the purpose. Each of these guns has its appointed gun-layer who is supposed to shoot straight."
                            },
                            {
                                "example_id": "f3993061-6786-4a53-96ea-c20b878200ce",
                                "sense_id": "ff83afb8-1e2e-3ce9-9944-f61502deab15",
                                "text": "The breech is opened by hand and the auto-loader primed, after which the gun-layer aims and stamps on the firing pedal."
                            },
                            {
                                "example_id": "a3ee6bd4-fcfb-4abb-ba4f-f9a40d39c12d",
                                "sense_id": "ff83afb8-1e2e-3ce9-9944-f61502deab15",
                                "text": "'Well, comrade Colonel, it's started now!\" said a gun-layer."
                            }
                        ]
                    }
