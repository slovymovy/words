                    "frequency": "Middle",
                    "semantic_group_id": "kennis_verwerven",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij had zich onvoldoende daarover <w>ingelezen</w> en zakte als een baksteen voor zijn examen.",
                            "target_lang_translations": {
                                "en": "He had not <w>read up</w> enough on it and failed his exam miserably."
                            }
                        },
                        {
                            "text": "Voordat de vergadering begint, wil ik me eerst goed <w>inlezen</w> in het nieuwe dossier.",
                            "target_lang_translations": {
