                ],
                "senses": [
                    {
                        "sense_id": "38f640f3-4750-3362-be33-8f18fcbeb5c1",
                        "entry_id": "bc81b40c-67d3-3640-aa62-5c8e4d7625ce",
                        "glosses": [
                            "Variante orthographique de asexualiser."
                        ],
                        "tags": [
                            "alt-of"
                        ],
                        "examples": [
                            {
                                "example_id": "614d5d35-9a2e-41b9-872a-2b32a6dc00f4",
                                "sense_id": "38f640f3-4750-3362-be33-8f18fcbeb5c1",
                                "text": "Quand on veut a-sexualiser, dé-sexualiser et parfois trans-sexualiser l’enfant, débranchant anatomie et psychologie, falsifiant ainsi son intelligence, sapant sa confiance, bousillant finalement son existence, violant sa conscience, et tout viol n’est-il pas violence ?"
                            },
                            {
                                "example_id": "e18dc829-01e7-4671-ab66-3a1b92d5f0d0",
                                "sense_id": "38f640f3-4750-3362-be33-8f18fcbeb5c1",
                                "text": "Fille ou garçon, aucune importance sous les blouses qui a-sexualisent, les cheveux longs retenus par un filet et les yeux cernés des deux côtés."
                            },
                            {
                                "example_id": "eabae0cc-89e1-4ece-aa7c-588546e6ef17",
                                "sense_id": "38f640f3-4750-3362-be33-8f18fcbeb5c1",
                                "text": "Les représentations des sociétés indiennes a-sexualisées, dont la sexualité se canalise et se restreint à un partenaire unique, sont des représentations surfaites démenties par des contre-exemples anthropologiques."
                            }
                        ]
                    }
                ],
