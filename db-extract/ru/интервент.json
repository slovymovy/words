                                    },
                                    {
                                        "sense_id": "138f72b7-50d8-3496-a67c-7d3dbffff2c9",
                                        "entry_id": "fdcde748-af1e-3b86-a711-a9e3b7e4dcc4",
                                        "glosses": [
                                            "Que favorece la intervención estatal."
                                        ],
                                        "tags": [
                                            "Política"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b3d98228-659e-4c4b-9323-571fa5d33cb3",
                                                "sense_id": "138f72b7-50d8-3496-a67c-7d3dbffff2c9",
                                                "text": "Supongamos que estamos en el momento en el que nos alumbrábamos con velas y no había llegado Edison. Obviamente, en el momento en el que aparece Edison con la lamparita, todos los fabricantes de velas van a la quiebra. Naturalmente, si le hubiéramos prestado atención a los intervencionistas, hoy, en lugar de tener esta hermosa conferencia con todas estas luces, seguiríamos con velas."
                                            }
                                        ],
