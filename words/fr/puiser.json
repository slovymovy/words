            "senses": [
                {
                    "sense_id": "dde91716-a56c-3066-bb85-2c94c74646c5",
                    "sense_definition": "Prendre un liquide dans un puits, une source ou un récipient à l'aide d'un ustensile ou d'un contenant.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "puiser_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Chaque matin, les villageois venaient <w>puiser</w> de l'eau fraîche à la fontaine."
                        },
                        {
                            "text": "Le cuisinier <w>puise</w> une grande louche de soupe fumante dans la marmite."
                        }
                    ],
                    "synonyms": [
                        "recueillir"
                    ],
                    "antonyms": [
                        "déverser",
                        "verser"
                    ],
                    "common_phrases": [
                        "puiser de l'eau",
                        "puiser à la source"
                    ]
                },
                {
                    "sense_id": "91ac4f0d-6d3d-3e41-9213-ac3a15b76986",
                    "sense_definition": "Prendre, prélever dans une réserve de biens matériels ou de ressources financières.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "puiser_abstrait",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pour financer ces travaux imprévus, ils ont dû <w>puiser</w> dans leurs économies."
                        },
                        {
                            "text": "Pendant la traversée du désert, l'équipe <w>puisait</w> avec prudence dans ses réserves."
                        }
                    ],
                    "synonyms": [
                        "prélever",
                        "prendre"
                    ],
                    "antonyms": [
                        "alimenter",
                        "approvisionner"
                    ],
                    "common_phrases": [
                        "puiser dans ses économies",
                        "puiser dans ses réserves"
                    ]
                },
                {
                    "sense_id": "86a67646-bd15-37c2-902e-988d3ad317a7",
                    "sense_definition": "Tirer ou emprunter un élément abstrait, tel que de l'inspiration, des connaissances ou de l'énergie, à partir d'une origine.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "puiser_abstrait",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette romancière talentueuse <w>puise</w> son inspiration dans ses souvenirs d'enfance."
                        },
                        {
                            "text": "Face à cette terrible épreuve, le jeune homme a su <w>puiser</w> dans sa foi la force d'avancer."
