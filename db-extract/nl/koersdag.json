                        "examples": [
                            {
                                "example_id": "22b4a3a0-29a6-46a0-820d-5bfcb9c5bc8f",
                                "sense_id": "59dc8b82-786a-3575-8eea-0c9ce9e9caad",
                                "text": "Barry Markus, ook van Vacansoleil, kneep op de tiende koersdag na veertig kilometer vrijwillig in de remmen. De 22-jarige sprinter debuteerde in een grote ronde, maar kon geen rol van betekenis spelen."
                            },
                            {
                                "example_id": "11369ae5-a183-45b5-92ca-2ee22ed8a167",
                                "sense_id": "59dc8b82-786a-3575-8eea-0c9ce9e9caad",
                                "text": "\"Hier heb ik vijf jaar op gewacht\", zei de Belg, die vanwege een knie-operatie pas zijn achttiende koersdag van het seizoen beleefde.\" Ik dacht: als ze terugkomen, komen ze terug, maar ik wilde achteraf geen spijt hebben. Het zag er misschien niet uit, maar het ging wel hard.\""
                            }
                        ]
