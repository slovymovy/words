                        "examples": [
                            {
                                "example_id": "a86abbd4-5e95-4391-86ba-cafda0d321fb",
                                "sense_id": "0c275646-3f23-32ea-a5fd-dacccaf90fcc",
                                "text": "[…] the russet gown and spotless head-gear, so proprietous to the out-of-doors employments, and in-doors aspect of a cottager?"
                            },
                            {
                                "example_id": "a63d6db3-a197-405e-9970-98c198463136",
                                "sense_id": "0c275646-3f23-32ea-a5fd-dacccaf90fcc",
                                "text": "Writers have sought both to observe and to exploit these constraints, and sometimes to flout them, while critics have set themselves up mostly to patrol the perimeters of proprietous expression […]"
                            },
                            {
                                "example_id": "b35f4164-3fe2-4955-b6f4-7feba1587f03",
                                "sense_id": "0c275646-3f23-32ea-a5fd-dacccaf90fcc",
                                "text": "The ancient sages offer this advice: If it is not proprietous, do not look at it. If it is not proprietous, do not do it. If it is in front of you, behave as if you saw nothing. If it is spoken to you, behave as if you heard nothing."
                            }
                        ]
                    }
