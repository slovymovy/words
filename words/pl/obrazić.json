                {
                    "sense_id": "fa5436f9-a515-36d7-a90c-f65f99e127b1",
                    "sense_definition": "Sprawić komuś przykrość, naruszyć czyjąś godność lub dobre imię niegrzecznym zachowaniem albo słowami.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Twoje ostre słowa mogą kogoś niechcący <obrazić>.",
                            "target_lang_translations": {
                                "ru": "Твои резкие слова могут кого-то нечаянно <обидеть>.",
                                "en": "Your harsh words might accidentally <offend> someone.",
                                "nl": "Je scherpe woorden kunnen per ongeluk iemand <beledigen>.",
                                "de": "Deine scharfen Worte können jemanden unabsichtlich <kränken>.",
                                "fr": "Tes paroles dures peuvent <blesser> quelqu'un involontairement.",
                                "it": "Le tue parole taglienti potrebbero <offendere> qualcuno involontariamente.",
                                "cs": "Tvoje ostrá slova mohou někoho nechtěně <urazit>.",
                                "tr": "Sert sözlerin istemeden birini <kırabilir>.",
                                "es": "Tus palabras duras pueden <ofender> a alguien sin querer.",
                                "zh": "你严厉的话语可能会无意中<冒犯>别人。"
                            }
                        },
                        {
                            "text": "Ten artykuł w gazecie <obraził> wielu czytelników.",
                            "target_lang_translations": {
                                "ru": "Эта статья в газете <оскорбила> многих читателей.",
                                "en": "That newspaper article <insulted> many readers.",
                                "nl": "Dat krantenartikel <kwetste> veel lezers.",
                                "de": "Dieser Zeitungsartikel hat viele Leser <beleidigt>.",
                                "fr": "Cet article dans le journal a <offensé> de nombreux lecteurs.",
                                "it": "Questo articolo di giornale ha <offeso> molti lettori.",
                                "cs": "Tento článek v novinách <urazil> mnoho čtenářů.",
                                "tr": "Gazetedeki bu makale birçok okuru <incitti>.",
                                "es": "Ese artículo del periódico <ofendió> a muchos lectores.",
                                "zh": "报纸上的这篇文章<得罪>了许多读者。"
                            }
                        }
