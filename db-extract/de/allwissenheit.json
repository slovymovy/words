                        "tags": [],
                        "examples": [
                            {
                                "example_id": "57d6ac07-e6f2-403a-bb55-eead417e21e1",
                                "sense_id": "c3a6db7d-d8c5-3c28-8db1-a5cbd76fcc91",
                                "text": "\"Gottes Allwissenheit wird zur warnenden Botschaft einer absoluten, heiligen Gerechtigkeit, die nicht auf diese Welt beschränkt bleibt.\""
                            }
