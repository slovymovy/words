                    "sense_id": "f1a4fc51-6211-3ee5-9315-508706f14396",
                    "sense_definition": "Very beautiful or attractive.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "beauty",
                    "name_type": "no",
                    "examples": [
