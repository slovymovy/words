                        "entry_id": "a881a2c5-1499-3f40-8d9e-48c4862acd80",
                        "glosses": [
                            "Catégorisation de l’identité de genre en deux et uniquement deux formes distinctes et complémentaires : feminin et masculin."
                        ],
                        "tags": [
                            "LGBTQ",
                            "Société"
                        ],
                        "examples": [
                            {
                                "example_id": "11916ddd-1fac-40ef-b5c9-ee6ae53ac192",
                                "sense_id": "758cf7fb-85d4-3637-b779-841329381cf5",
                                "text": "Dans la plupart des sociétés occidentales, le binarisme catégorise les genres « femme » et « homme » comme étant la norme."
                            }
                        ]
                    }
                ],
                "translations": [
