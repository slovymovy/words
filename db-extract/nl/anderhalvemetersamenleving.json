                        "entry_id": "e25ae7f9-2295-3af4-8ee8-b328509b38ae",
                        "glosses": [
                            "a society wherein the citizens are able to keep a distance of one and a half metres from each other, for the sake of social distancing"
                        ],
                        "tags": [
                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "a507567a-f51e-478c-a4cd-9474702c3460",
                                "sense_id": "7ff2fdfd-ac8d-3793-94c9-dbd2b578b661",
                                "text": "Meestal zie ik ergens wel een oplossing of een lichtpuntje – maar sport in een anderhalvemetersamenleving: ik zie het niet voor me.",
                                "translation": "Usually, I see a solution somewhere or a silver lining - but sport in a one-and-a-half-meter society: I can't imagine it.",
                                "english": "Usually, I see a solution somewhere or a silver lining - but sport in a one-and-a-half-meter society: I can't imagine it."
                            },
                            {
                                "example_id": "b1222b2c-cbcd-4508-8775-aade6f84dbf1",
                                "sense_id": "7ff2fdfd-ac8d-3793-94c9-dbd2b578b661",
                                "text": "Langzaamaan beginnen we te wennen aan een nieuwe wijze van leven: de spanning tussen afstand en nabijheid, de anderhalvemetersamenleving.",
                                "translation": "Slowly we are starting to get used to a new way of life: the tension between distance and proximity, the one-and-a-half-meter society.",
                                "english": "Slowly we are starting to get used to a new way of life: the tension between distance and proximity, the one-and-a-half-meter society."
                            },
                            {
                                "example_id": "87087e0d-16aa-40ce-9884-87155f798bb9",
                                "sense_id": "7ff2fdfd-ac8d-3793-94c9-dbd2b578b661",
                                "text": "Nu valt het doek voor de anderhalvemetersamenleving.",
                                "translation": "Now the curtain falls for the one-and-a-half-metre society.",
                                "english": "Now the curtain falls for the one-and-a-half-metre society."
                            }
                        ]
                    }
