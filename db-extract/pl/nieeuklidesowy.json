                "senses": [
                    {
                        "sense_id": "f6909b6c-d446-3af1-b4e3-93ad9fc09c46",
                        "entry_id": "ebc7a00d-26dd-3492-b096-5d840a484f04",
                        "glosses": [
                            "niespełniający aksjomatów geometrii opisanych przez Euklidesa w jego traktacie „Elementy”"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "383f9009-98f9-41e9-8303-313c6e8ccf12",
                                "sense_id": "f6909b6c-d446-3af1-b4e3-93ad9fc09c46",
                                "text": "Oznacza to, iż możliwa jest matematyka z hipotezą continuum i całkiem inna – bez niej; sytuacja dość podobna, jak to było ponad stulecie wcześniej z geometrią nieeuklidesową."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "56cc2b97-bed4-40ed-8f4f-62e2a5abdbd9",
                        "source_entry_id": "ebc7a00d-26dd-3492-b096-5d840a484f04",
                        "source_sense_id": "f6909b6c-d446-3af1-b4e3-93ad9fc09c46",
                        "target_lang_word": "non-euclidean",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "93120711-c846-4041-a488-38db0cb4a395",
                        "source_entry_id": "ebc7a00d-26dd-3492-b096-5d840a484f04",
                        "source_sense_id": "f6909b6c-d446-3af1-b4e3-93ad9fc09c46",
                        "target_lang_word": "non-Euclidean",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "non-Euclidean",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1ce393ac-2f4f-3a3a-b6bb-29eee07e9185",
                                        "entry_id": "7c9a906f-c5d2-3c0b-99c8-57849884ab7b",
                                        "glosses": [
                                            "of, or relating to non-Euclidean geometry"
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6d719ee8-9302-4e55-996b-3e7be8a4cfde",
                                                "sense_id": "1ce393ac-2f4f-3a3a-b6bb-29eee07e9185",
                                                "text": "He said that the geometry of the dream-place he saw was abnormal, non-Euclidean, and loathsomely redolent of spheres and dimensions apart from ours."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "26da0822-dbbd-4be8-be6e-33fe7f662ef6",
                        "source_entry_id": "ebc7a00d-26dd-3492-b096-5d840a484f04",
                        "source_sense_id": "f6909b6c-d446-3af1-b4e3-93ad9fc09c46",
                        "target_lang_word": "non-euclidien",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "non-euclidien",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "df729696-2a29-3073-a15c-974326719102",
                                        "entry_id": "dac166a9-42fc-3078-ab42-c625cad7b582",
                                        "glosses": [
                                            "Se dit des branches de la géométrie qui invalident le cinquième postulat d’Euclide selon lequel, par un point extérieur à une droite, il passe toujours une parallèle à cette droite, et une seule."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83c99d9f-227d-4bc2-acec-d854717626fa",
                                                "sense_id": "df729696-2a29-3073-a15c-974326719102",
                                                "text": "La conception des mathématiques est mise en cause par la découverte de l’existence des systèmes non-euclidiens."
                                            },
                                            {
                                                "example_id": "75d151b9-1f0d-4bbf-ae5e-56e98ab3b302",
                                                "sense_id": "df729696-2a29-3073-a15c-974326719102",
                                                "text": "Il développe également ses théories d’avant-garde en mathématiques ; il faudra attendre le XIXᵉ siècle pour que les chercheurs européens reconnaissent en lui un génial précurseur des géométries non euclidiennes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
