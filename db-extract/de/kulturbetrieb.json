                "senses": [
                    {
                        "sense_id": "6aebe1d0-6d1f-3e15-bbd8-d53e59e3eb32",
                        "entry_id": "34db05f5-1e1d-30fc-865f-81c5f48fb4e0",
                        "glosses": [
                            "Gesamtheit der Personen, Institutionen, Einrichtungen, Aktivitäten und Zustände, die im Bereich der Kultur eine Rolle spielen"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "3c54556a-d650-44ab-8436-0ace9c3ae6d6",
                                "sense_id": "6aebe1d0-6d1f-3e15-bbd8-d53e59e3eb32",
                                "text": "„Der von Berlin kontrollierten Marionettenregierung des Marschalls Philippe Pétain in Vichy ist ebenso daran gelegen, im Alltag der Franzosen den Anschein von Normalität zu wahren, und dazu gehört die Aufrechterhaltung des regulären Kulturbetriebs, der freilich einer strengen Zensur seitens der deutschen Propagandaabteilung unterliegt.“"
                            },
                            {
                                "example_id": "ba446629-4c05-4dc5-b240-b6faab4b446a",
                                "sense_id": "6aebe1d0-6d1f-3e15-bbd8-d53e59e3eb32",
                                "text": "„Auch in anderen Bereichen des Kulturbetriebes hört man vergleichbare Ausreden.“"
                            },
                            {
                                "example_id": "6293b637-27d5-4ee3-b5d4-dc7c8c55cb18",
                                "sense_id": "6aebe1d0-6d1f-3e15-bbd8-d53e59e3eb32",
                                "text": "„Annemarie scheint dem offiziellen Kulturbetrieb distanzierter gegenüberzustehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "1a7c7691-c409-3292-a542-e33b7fa3e975",
                        "entry_id": "34db05f5-1e1d-30fc-865f-81c5f48fb4e0",
                        "glosses": [
                            "einzelne Kultureinrichtung, in der Kultur in organisierter Form stattfindet (zum Beispiel Theater, Museum)"
                        ],
                        "tags": [
                            "Kultur"
                        ],
                        "examples": [
                            {
                                "example_id": "39607501-ee10-4746-be5c-b30307ef482b",
                                "sense_id": "1a7c7691-c409-3292-a542-e33b7fa3e975",
                                "text": "„Der Club Manufaktur e. V. ist ein Kulturbetrieb mit alternative[m] Programm von Politik, Musik, Theater bis zu Tanz und einem Programmkino.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
