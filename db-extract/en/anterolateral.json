                                            {
                                                "example_id": "8f54257d-07c4-4364-b02e-143ac7b7b7f1",
                                                "sense_id": "dc7bf576-80b4-3fdd-b27a-c725b4b3b8d1",
                                                "text": "Ecchymoses des muscles antérolatéraux et de leurs gaines aponévrotiques, ruptures du chef antérieur du sterno-cléido-mastoïdien, manchon ecchymotique péricarotidien, spume, exophtalmie et lividités : il ne fait aucun doute que la victime est morte par pendaison !"
                                            },
                                            {
                                                "example_id": "2a966bd8-0ce3-4450-ac4a-706ce139f01f",
                                                "sense_id": "dc7bf576-80b4-3fdd-b27a-c725b4b3b8d1",
                                                "text": "Les rapports entre le bord latéral du muscle droit et le bord médial des muscles antérolatéraux, formant la gaine rectusienne, sont variables en fonction du niveau considéré."
                                            },
                                            {
                                                "example_id": "62c76f6c-c972-4e25-837e-b7150b4955c5",
                                                "sense_id": "dc7bf576-80b4-3fdd-b27a-c725b4b3b8d1",
                                                "text": "La région antérolatérale mandibulaire est une région fréquemment explorée en chirurgie-dentaire."
                                            }
                                        ]
