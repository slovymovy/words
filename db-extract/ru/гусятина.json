                ],
                "translations": [
                    {
                        "translation_id": "b99ba02e-23cc-44be-83f9-08fa5499e19a",
                        "source_entry_id": "2328f755-2efd-387d-8a95-7091cde41540",
                        "source_sense_id": "8b1a43f6-b75b-32f4-9c73-f54769e81fa4",
                        "source_sense_description": "мясо",
                        "target_lang_word": "goose",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "goose",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3784991a-4200-3101-8b4d-a7ac96d9e75e",
                                        "entry_id": "aba9bc50-9229-3ef2-be17-37064ca8fb63",
                                        "glosses": [
                                            "Any of various grazing waterfowl of the family Anatidae, which have feathers and webbed feet and are capable of flying, swimming, and walking on land, and which are generally bigger than ducks."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b2a51246-363d-4215-bde4-3f6b228d0ff7",
                                                "sense_id": "3784991a-4200-3101-8b4d-a7ac96d9e75e",
                                                "text": "There is a flock of geese on the pond."
                                            },
                                            {
                                                "example_id": "fd8b5337-8102-4a2b-80e8-90b706cb7748",
                                                "sense_id": "3784991a-4200-3101-8b4d-a7ac96d9e75e",
                                                "text": "The goose, reputed to possess high generative power, was sacred to Priapus."
                                            },
                                            {
                                                "example_id": "8ac185c2-14ec-4557-bc16-8169792f403f",
                                                "sense_id": "3784991a-4200-3101-8b4d-a7ac96d9e75e",
                                                "text": "A group of geese is called a gaggle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b35e424d-a8e9-3137-b964-dcd93414ef5c",
                                        "entry_id": "aba9bc50-9229-3ef2-be17-37064ca8fb63",
                                        "glosses": [
                                            "A female goose."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "53019cbc-ca4c-4ecb-aa17-786ee4c746ed",
                                                "sense_id": "b35e424d-a8e9-3137-b964-dcd93414ef5c",
                                                "text": "Ganders and geese are at their best for stock from two to ten years old. They live to a great age—it is stated to thirty or more years—but after ten years they cannot be reckoned upon as reliable assets on a farm. Two years old is the best age to mate them, making up pens of a gander and two or three geese at the New Year. It is difficult sometimes to distinguish ganders from geese. A practical man is, however, rarely mistaken."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3cbb8cbe-f293-3f90-bc19-2e1c2d7e3f29",
                                        "entry_id": "aba9bc50-9229-3ef2-be17-37064ca8fb63",
                                        "glosses": [
                                            "The flesh of the goose used as food."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "83f541ff-9a37-4859-af1d-c85c0e5c8c52",
                                                "sense_id": "3cbb8cbe-f293-3f90-bc19-2e1c2d7e3f29",
                                                "text": "Mrs. Cratchit made the gravy (ready beforehand in a little saucepan) hissing hot; Master Peter mashed the potatoes with incredible vigour; Miss Belinda sweetened up the apple-sauce; Martha dusted the hot plates; Bob took Tiny Tim beside him in a tiny corner at the table; the two young Cratchits set chairs for everybody, not forgetting themselves, and mounting guard upon their posts, crammed spoons into their mouths, lest they should shriek for goose before their turn came to be helped."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f3980858-2bf2-3593-a865-0e412a589fcf",
                                        "entry_id": "aba9bc50-9229-3ef2-be17-37064ca8fb63",
                                        "glosses": [
                                            "A silly person."
                                        ],
                                        "tags": [
                                            "countable",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8ce5dc6f-e56c-43f2-97d1-215c35d385cf",
                                                "sense_id": "f3980858-2bf2-3593-a865-0e412a589fcf",
                                                "text": "I'm sorry for you, but you're such a goose."
                                            },
                                            {
                                                "example_id": "2f91e1a7-b244-4226-a706-9f989e057d78",
                                                "sense_id": "f3980858-2bf2-3593-a865-0e412a589fcf",
                                                "text": "Have you stopped to think, you gooses, that Andy might not wish you to give it away?"
                                            },
                                            {
                                                "example_id": "53982938-bada-4c15-93ad-a04b4525e916",
                                                "sense_id": "f3980858-2bf2-3593-a865-0e412a589fcf",
                                                "text": "You gooses. I didn’t accept his proposal. Mrs Plackett did. She did because she would. Don’t you see?"
                                            },
                                            {
                                                "example_id": "6d13a471-b1db-4ede-bf55-238db97a9184",
                                                "sense_id": "f3980858-2bf2-3593-a865-0e412a589fcf",
                                                "text": "Surely I needn’t explain to you gooses that none of you, not even you, Caro, have the sort of dowry or connections or the appeal that such a match would require."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e362b6ac-7274-3094-83cd-543ec0fa4a89",
                                        "entry_id": "aba9bc50-9229-3ef2-be17-37064ca8fb63",
                                        "glosses": [
                                            "A tailor's iron, heated in live coals or embers, used to press fabrics."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e30e172f-309f-4187-a340-29fce0158cda",
                                                "sense_id": "e362b6ac-7274-3094-83cd-543ec0fa4a89",
                                                "text": "Come in, tailor. Here you may roast your goose."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "933b0566-ebdb-36e2-951f-e729d5bd9f39",
                                        "entry_id": "aba9bc50-9229-3ef2-be17-37064ca8fb63",
                                        "glosses": [
                                            "A young woman or girlfriend."
                                        ],
                                        "tags": [
                                            "South-Africa",
                                            "countable",
                                            "dated",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b2488247-a07b-3900-ac4b-b0acf79d4051",
                                        "entry_id": "aba9bc50-9229-3ef2-be17-37064ca8fb63",
                                        "glosses": [
                                            "An old English board game in which players moved counters along a board, earning a double move when they reached the picture of a goose."
                                        ],
                                        "tags": [
                                            "historical",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "goose",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d154a93e-c5bb-3028-b2a9-0392b041a48b",
                                        "entry_id": "7f9d8f21-3d05-319f-807e-d23144b7a4b4",
                                        "glosses": [
                                            "To sharply poke or pinch the buttocks, or prod between the buttocks, of (a person)."
                                        ],
                                        "tags": [
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7d544f62-48cb-4af9-be3b-b61e52043028",
                                                "sense_id": "d154a93e-c5bb-3028-b2a9-0392b041a48b",
                                                "text": "Here are the three strange men have exposed themselves to me, the two obscene phone callers, the time I was goosed by an employer."
                                            },
                                            {
                                                "example_id": "177d4bc3-92ee-4c30-bbed-45860dfa571f",
                                                "sense_id": "d154a93e-c5bb-3028-b2a9-0392b041a48b",
                                                "text": "She greeted Miss Lonelyhearts, then took hold of her husband and shook the breath out of him. When he was quiet, she dragged him into their apartment. Miss Lonelyhearts followed and as he passed her in the dark foyer, she goosed him and laughed."
                                            },
                                            {
                                                "example_id": "9b724d55-098f-4025-99ba-7ed1c1701ccc",
                                                "sense_id": "d154a93e-c5bb-3028-b2a9-0392b041a48b",
                                                "text": "The witness stand. Goldminers giving evidence, sure he's violent didn't I see him with my own peepers chasing those poor kids up on the roof and he goosed my wife last Christmas. Violently. Just a forceful nudge of the knee."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "29e891ff-6525-3d16-bee6-1c183eaf4b8f",
                                        "entry_id": "7f9d8f21-3d05-319f-807e-d23144b7a4b4",
                                        "glosses": [
                                            "To stimulate; to spur."
                                        ],
                                        "tags": [
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5bd1746c-e670-43db-a2b1-5be064048734",
                                                "sense_id": "29e891ff-6525-3d16-bee6-1c183eaf4b8f",
                                                "text": "Almost everyone in McKay’s impossibly starry cast feels like they’re jumping into the SNL host role, game for some light comedic lifting while waiting for the pros to show up and goose the laughs."
                                            },
                                            {
                                                "example_id": "4c31d2eb-cb44-48e3-be37-ed2521a3b6a4",
                                                "sense_id": "29e891ff-6525-3d16-bee6-1c183eaf4b8f",
                                                "text": "The ensuing snarknado also seemed to goose the TV ratings. Hundreds of thousands of viewers switched on the movie after it began, suggesting that they’d gotten wind through Twitter of the bananas spectacle that was unfolding."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "969ee267-5a35-3e6d-b8f4-febdf71447fe",
                                        "entry_id": "7f9d8f21-3d05-319f-807e-d23144b7a4b4",
                                        "glosses": [
                                            "To gently accelerate (an automobile or machine), or give repeated small taps on the accelerator."
                                        ],
                                        "tags": [
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "734993c2-95a5-3d64-a74c-77e233d1dd49",
                                        "entry_id": "7f9d8f21-3d05-319f-807e-d23144b7a4b4",
                                        "glosses": [
                                            "Of private-hire taxi drivers, to pick up a passenger who has not booked a cab, in violation of UK licensing conditions."
                                        ],
                                        "tags": [
                                            "UK",
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1b95c254-5dbc-32a3-9bf1-c8a5d3802f1b",
