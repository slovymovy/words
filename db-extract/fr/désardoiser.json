                "senses": [
                    {
                        "sense_id": "315b9910-5439-3fe6-b455-7a0d0aaf3799",
                        "entry_id": "6096d9e8-b015-3ac0-976e-2fa42477cb14",
                        "glosses": [
                            "Enlever les ardoises de."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e232a66-63bd-47e3-a23c-1dd1ec617b80",
                                "sense_id": "315b9910-5439-3fe6-b455-7a0d0aaf3799",
                                "text": "Vous avez idéalement des connaissances en couverture, vous savez monter sur un toit, désardoiser et réardoiser."
                            },
                            {
                                "example_id": "7ba79521-fbb7-469c-92f3-a46e9a084cef",
                                "sense_id": "315b9910-5439-3fe6-b455-7a0d0aaf3799",
                                "text": "Quant au prix cela dépend surtout de la marque des panneaux, mais pour installation avec des panneaux de qualité comptez en moyenne entre 18 et 20000€, mais dans votre cas c'est légèrement différent dans le sens où il n'y a pas eu à \"détuiler\" ou \"désardoiser\" la couverture donc un coût aux alentours de 13/14000€ me semblerait plus plausible..."
                            },
                            {
                                "example_id": "4f7a0a74-659e-4874-b442-b2f70dc96bec",
                                "sense_id": "315b9910-5439-3fe6-b455-7a0d0aaf3799",
                                "text": "Je pense \"désardoiser\" complètement le pan de toit fatigué."
                            },
                            {
                                "example_id": "ff935611-9eeb-4fbd-98fd-843bc6e89889",
                                "sense_id": "315b9910-5439-3fe6-b455-7a0d0aaf3799",
                                "text": "Préparation de la toiture «Détuiler» ou «désardoiser» (voir Fiche N 12)"
                            }
                        ]
                    }
