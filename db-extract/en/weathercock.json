                                                "sense_id": "e21f48af-c2c5-3978-9a4d-4fb5d1474dc9",
                                                "text": "„Sie bewunderten die mit roten Ziegeln gedeckten und von verspielten Wetterfahnen bekrönten steilen Satteldächer, staunten über das Kopfsteinpflaster und die Granitplatten auf den Wegen.“"
                                            },
                                            {
                                                "example_id": "8b7c3b56-8eb1-44d4-a000-d551581b4cfc",
                                                "sense_id": "e21f48af-c2c5-3978-9a4d-4fb5d1474dc9",
                                                "text": "„Es stand nahe der Straße, trug eine vergoldete Wetterfahne, auf der ein galoppierendes Pferd abgebildet war, und grenzte an eine große rote Scheune.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
