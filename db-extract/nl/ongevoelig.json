                "senses": [
                    {
                        "sense_id": "4eba900e-2cd1-3e5e-a03b-d758a12c1e4e",
                        "entry_id": "0398e26b-2d9f-3174-9be6-1f568a57ddc4",
                        "glosses": [
                            "insensitive, crass, callous"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d66f8ec-488f-4db6-9a3e-084012392b95",
                                "sense_id": "4eba900e-2cd1-3e5e-a03b-d758a12c1e4e",
                                "text": "Haar opmerking was heel ongevoelig en kwetste zijn gevoelens.",
                                "translation": "Her remark was very insensitive and hurt his feelings.",
                                "english": "Her remark was very insensitive and hurt his feelings."
                            },
                            {
                                "example_id": "84884092-a2f2-411f-b033-491665e8eb5c",
                                "sense_id": "4eba900e-2cd1-3e5e-a03b-d758a12c1e4e",
                                "text": "Hij toonde zich steeds ongevoeliger voor de noden van anderen.",
                                "translation": "He became increasingly more callous to the needs of others.",
                                "english": "He became increasingly more callous to the needs of others."
                            },
                            {
                                "example_id": "9e3af65e-b0f2-44a2-8c2f-93788e042a96",
                                "sense_id": "4eba900e-2cd1-3e5e-a03b-d758a12c1e4e",
                                "text": "De manier waarop hij lacht om andermans problemen is gewoon ongevoeligst.",
                                "translation": "The way he laughs at other people's problems is just the most crass.",
                                "english": "The way he laughs at other people's problems is just the most crass."
                            }
                        ]
                    }
                ],
