                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "39018ffd-381b-456d-bcdd-85f35626b106",
                                                "sense_id": "c4b2f53b-e856-3ab6-9f16-7f076736ad50",
                                                "text": "Auffällig unter lauter Fanatikern war seine Milde."
                                            },
                                            {
                                                "example_id": "5122189c-b74a-48c1-971a-26ef55e38fe3",
                                                "sense_id": "c4b2f53b-e856-3ab6-9f16-7f076736ad50",
                                                "text": "„Seine Frömmigkeit wird durch zahlreiche Andachtsübungen bezeugt, und seine Milde zeigt sich darin, daß er die Begnadigung des Generals Debelle durchsetzte, der die Waffen gegen ihn erhoben hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "cec2cb08-2be5-3465-8b51-efa48ff67312",
                                        "entry_id": "bad4b1c9-2fd8-32fe-adbc-c3b17efcd5bd",
                                        "glosses": [
                                            "die Eigenschaft von Speisen und Getränken, keine Reizstoffe zu enthalten (nicht scharf, gewürzt, salzig oder hochalkoholisch zu sein)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e10b2568-1c17-43e4-8b8b-114d302266e6",
                                                "sense_id": "cec2cb08-2be5-3465-8b51-efa48ff67312",
                                                "text": "Die Milde der warmen Milch beruhigte seine Magenschmerzen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Milde",
