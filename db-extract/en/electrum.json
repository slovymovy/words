                            "plural"
                        ],
                        "form": "electrums"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "70dab3b8-c314-3f6d-97f8-d1ad7d30c883",
                        "entry_id": "b1c02c38-a434-3adf-a026-b508fe78273b",
                        "glosses": [
                            "Amber."
                        ],
                        "tags": [
                            "countable",
                            "obsolete",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "d0ed9a50-e4e2-35fc-9349-8ce14526e9e9",
                        "entry_id": "b1c02c38-a434-3adf-a026-b508fe78273b",
                        "glosses": [
                            "An alloy of gold and silver, used by the ancients; now specifically a natural alloy with between 20 and 50 per cent silver."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "72b8abaf-12ef-4d5b-97ea-46487655ec6d",
                                "sense_id": "d0ed9a50-e4e2-35fc-9349-8ce14526e9e9",
                                "text": "Native gold almost always contains silver in amounts varying widely between 5 and 50 per cent. This natural alloy is known as electrum although in classical antiquity where the word originated it seems to have been used for an artificial alloy of the two metals."
                            },
                            {
                                "example_id": "7fa6b56f-e5f9-493a-aca8-c78a7b4a0e96",
                                "sense_id": "d0ed9a50-e4e2-35fc-9349-8ce14526e9e9",
                                "text": "A natural alloy containing more than 20 per cent silver is called electrum, and was regarded by the ancients as a different metal from gold."
                            }
                        ]
                    },
                    {
                        "sense_id": "4205b8de-d48e-31c5-8edb-ad56d9e90fc4",
                        "entry_id": "b1c02c38-a434-3adf-a026-b508fe78273b",
                        "glosses": [
                            "German silver plate."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c604b698-f4da-4b35-995e-52d29f4e4e73",
                        "source_entry_id": "b1c02c38-a434-3adf-a026-b508fe78273b",
                        "source_sense_description": "alloy of gold and silver",
                        "target_lang_word": "elektrum",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "3d711ca4-b123-48e8-9d32-69981981ea38",
                        "source_entry_id": "b1c02c38-a434-3adf-a026-b508fe78273b",
                        "source_sense_description": "alloy of gold and silver",
                        "target_lang_word": "électrum",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "électrum",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dabe06cb-46cc-3f28-8f6c-b4a655df3159",
                                        "entry_id": "a2af767d-ee30-3d0f-83a0-cc73fd7cc62a",
                                        "glosses": [
                                            "Alliage naturel d’or et d’argent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4f8cb0a9-3183-49a1-b147-048963d22c4e",
                                                "sense_id": "dabe06cb-46cc-3f28-8f6c-b4a655df3159",
                                                "text": "L’argent, que l’on trouve parfois à l’état libre, ou en alliage avec l’or (électrum), a surtout été produit (dès 2500 av. J.-C. dans le Pont) à partir de galène (PbS) ^([1]) dans laquelle il accompagne parfois en faible quantité le plomb."
                                            },
                                            {
                                                "example_id": "445a92a4-ca6a-459e-87a4-1b3e92b484fa",
                                                "sense_id": "dabe06cb-46cc-3f28-8f6c-b4a655df3159",
                                                "text": "Les trouvailles antérieures à l’Artémision de Crésus et la frappe des premiers monnayages d’électrum appartiennent donc en partie au « haut archaïsme » sans que l’on connaisse exactement la durée pendant laquelle ces premières monnaies ont été en usage."
                                            },
                                            {
                                                "example_id": "cefd31f6-b0a3-470c-be68-23553882627e",
                                                "sense_id": "dabe06cb-46cc-3f28-8f6c-b4a655df3159",
                                                "text": "les^([sic]) egyptiens^([sic]) ne connaissaient pas encore l’or, le diamant et les pierres précieuses mais ils savaient utiliser déjà des matériaux comme l’électrum qui étaient un mélange d’or et d’argent qui se trouvait à l’état naturel."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "56f0c1fe-da5e-4df7-8966-0b80d1eee78a",
                        "source_entry_id": "b1c02c38-a434-3adf-a026-b508fe78273b",
                        "source_sense_description": "alloy of gold and silver",
                        "target_lang_word": "Elektron",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Elektron",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "74315e74-3344-377a-b02e-df1c7acdf717",
                                        "entry_id": "5a95e9d3-d919-316c-b57d-c2af9cc9381b",
                                        "glosses": [
                                            "negativ geladenes Elementarteilchen"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "05e6fcc0-2a9d-4b6f-abc2-c92f71893f95",
                                                "sense_id": "74315e74-3344-377a-b02e-df1c7acdf717",
                                                "text": "Ein Atom des Heliums besitzt zwei Elektronen."
                                            },
                                            {
                                                "example_id": "b68618f6-9d52-4a23-9781-fb930ae9caf1",
                                                "sense_id": "74315e74-3344-377a-b02e-df1c7acdf717",
                                                "text": "„Früher hatte man jedes Atom für ein Sonnensystem im kleinen gehalten, das aus einem Kern bestand, der von kreisenden Elektronen umgeben war und die Sphärenharmonie in mikroskopischem Maßstab widerspiegelte.“"
                                            },
                                            {
                                                "example_id": "5e843e31-420e-4356-ab44-eaf7ba8d5fce",
                                                "sense_id": "74315e74-3344-377a-b02e-df1c7acdf717",
                                                "text": "„Weder gibt es einen Plus- noch einen Minuspol, sondern nur ein Gefälle von geladenen Teilchen wie Elektronen oder Ionen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "65f3d67b-6c69-32e0-b3f2-a896fb27e3cf",
                                        "entry_id": "5a95e9d3-d919-316c-b57d-c2af9cc9381b",
                                        "glosses": [
                                            "eine Legierung aus Gold und Silber"
                                        ],
                                        "tags": [
                                            "Betonung nur auf der 2. Silbe"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c222caa9-c826-4e6c-a8ce-43943b46a428",
                                                "sense_id": "65f3d67b-6c69-32e0-b3f2-a896fb27e3cf",
                                                "text": "Ursprünglich hielt man Elektron für ein eigenständiges Metall."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
