                    {
                        "translation_id": "8090f5fe-a54a-419f-a5d0-78383f0566f8",
                        "source_entry_id": "361a25dc-2b17-3106-8cf4-7a4d422f224d",
                        "source_sense_description": "a person having a tendency to repeatedly ask help of others",
                        "target_lang_word": "parasiet",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "parasiet",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "c607afd5-2448-3162-b682-409d49fd05f3",
                                        "entry_id": "0ae00758-ce63-3d9c-86ca-7ce69f51bd05",
                                        "glosses": [
                                            "levensvorm die ten koste van een ander organisme zich in stand houdt en vermenigvuldigt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55d663ec-0f07-46d0-9f8b-3d4983d1a118",
                                                "sense_id": "c607afd5-2448-3162-b682-409d49fd05f3",
                                                "text": "De financiële sector begint steeds meer te lijken op een gigantische parasiet die zonder strikte controle tot steeds kwaadaardiger vorm kan uitgroeien"
                                            },
                                            {
                                                "example_id": "234f5f22-f949-4baf-b1ae-8596a32b536d",
                                                "sense_id": "c607afd5-2448-3162-b682-409d49fd05f3",
                                                "text": "Van deze parasieten kun je goed ziek worden."
                                            },
                                            {
                                                "example_id": "6c7d061e-8988-43cc-a30c-bceeca1af6c7",
                                                "sense_id": "c607afd5-2448-3162-b682-409d49fd05f3",
                                                "text": "Het dier kan een parasiet met zich meedragen die rattenlongworm wordt genoemd en hersenvliesontsteking kan veroorzaken bij mensen en vee. Het dier bedreigt met zijn eetlust ook landbouwgewassen, schrijft de Amerikaanse krant USA Today."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fecfa533-0517-35e0-8795-867b9b5635f2",
                                        "entry_id": "0ae00758-ce63-3d9c-86ca-7ce69f51bd05",
                                        "glosses": [
                                            "klaploper, iemand die ten koste van een ander leeft, een profiteur"
                                        ],
                                        "tags": [
                                            "ironic"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "edbbb0f4-50ea-37fa-acde-4fe9ee69bb8d",
                                        "entry_id": "0ae00758-ce63-3d9c-86ca-7ce69f51bd05",
                                        "glosses": [
                                            "persoon met een geestelijke functie die de priesters ondersteunden in de tempel, met name in Athene en het omliggende gebied Attika"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "77ddd753-5de1-4bde-9271-97d016d88589",
                                                "sense_id": "edbbb0f4-50ea-37fa-acde-4fe9ee69bb8d",
                                                "text": "Deze parasieten werden in de Attische dorpen gekozen uit de meest vooraanstaande families. De Griekse literatuur noemt een Atheens college van twaalf parasieten, die een rol speelden bij de tempelverering van Apollo, Pallas, Heracles en Athena. Ze hielpen priesters en bezoekers bij het offeren, waarbij de beloning bestond uit een derde deel van het geofferde. Het voedsel en vlees dat ze op deze manier verkregen, aten ze dus mee ‘aan de tafel’ van de offeraars.\nParasieten komen in de vroege Griekse bronnen ook voor in relatie tot magistraten en (buitenlandse) ambassadeurs. Ze assisteerden een hoogwaardigheidsbekleder en mochten dan, als mee-eters, deelnemen aan de grote publieke maaltijden voor politici."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
