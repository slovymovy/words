        "nl-extract.jsonl": [
            {
                "entry_id": "8eeafd8f-825d-3a3d-aee0-cb98daf15db3",
                "word": "allesbehalve",
                "pos": "adv",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "8e2dd649-16a9-3886-a137-81724ed4d2b2",
                        "entry_id": "8eeafd8f-825d-3a3d-aee0-cb98daf15db3",
                        "glosses": [
                            "duidt aan dat het genoemde juist niet waar is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b9df197f-0abe-4d8b-9f2d-a4fa01bf2db1",
                                "sense_id": "8e2dd649-16a9-3886-a137-81724ed4d2b2",
                                "text": "Hij is allesbehalve een goed experimentator."
                            },
                            {
                                "example_id": "59d76686-0654-4c57-8e84-a3b132288f40",
                                "sense_id": "8e2dd649-16a9-3886-a137-81724ed4d2b2",
                                "text": "Constable weet ons zelfverzekerd mee te voeren naar de dingen die het bekijken waard zijn, zelfs in een allesbehalve onberispelijk tafereel."
                            },
                            {
                                "example_id": "d5dc13f1-c0ac-4cc9-a0b4-950f1bdd03c4",
                                "sense_id": "8e2dd649-16a9-3886-a137-81724ed4d2b2",
                                "text": "Heetten die zo? Veermannen? Dat klonk als iets uit de mythologie, maar de gele stalen schuit die elke dag mensen en goederen tussen Fàrôsund en Fàrô vervoerde, deed allesbehalve mythologisch aan."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "77cc1336-fcc0-44f9-a8ba-2ecb0a3dac34",
                        "source_entry_id": "8eeafd8f-825d-3a3d-aee0-cb98daf15db3",
                        "source_sense_id": "8e2dd649-16a9-3886-a137-81724ed4d2b2",
                        "target_lang_word": "anything but",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anything but",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dc3079ff-16b8-3baa-b8da-869032973663",
                                        "entry_id": "2f5cde90-ac39-3464-8c2e-a162c8aa8595",
                                        "glosses": [
                                            "Not at all; quite the contrary (of)."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2575bbc3-be5d-4665-b048-f2958712d487",
                                                "sense_id": "dc3079ff-16b8-3baa-b8da-869032973663",
                                                "text": "It wasn't cheap. Anything but."
                                            },
                                            {
                                                "example_id": "ade9caee-7f0d-46d7-afc9-a009e279e011",
                                                "sense_id": "dc3079ff-16b8-3baa-b8da-869032973663",
                                                "text": "It started out as a lively party, now it is anything but."
                                            },
                                            {
                                                "example_id": "0ccfc093-d908-47b3-9472-9bd2c22a0f3c",
                                                "sense_id": "dc3079ff-16b8-3baa-b8da-869032973663",
                                                "text": "As a matter of fact, the methods of primitive accumulation are anything but idyllic."
                                            },
                                            {
                                                "example_id": "37b72fff-3055-406d-bf98-7c09e735ca09",
                                                "sense_id": "dc3079ff-16b8-3baa-b8da-869032973663",
                                                "text": "\"They certainly are nice people,\" I assented to my wife's observation, using the colloquial phrase with a consciousness that it was anything but \"nice\" English, \"and I'll bet that their three children are better brought up than most of----\""
                                            },
                                            {
                                                "example_id": "0e0f7b86-b221-47d2-a114-f3b708d53e94",
                                                "sense_id": "dc3079ff-16b8-3baa-b8da-869032973663",
                                                "text": "1893, Fridtjof Nansen, Otto Sinding (illustrator), William Archer (translator), Eskimo Life, Chapter II: Appearance and Dress,\nThe pure-bred Eskimo would at first glance seem to most of us Europeans anything but beautiful."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
