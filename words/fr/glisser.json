            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e1c7c08c-a98a-3dcb-ab9d-4ca1ca620f5f",
                    "sense_definition": "Perdre l'adhérence ou l'équilibre sur une surface lisse ou mouillée, souvent sans le vouloir ; déraper.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "mouvement_sur_surface_lisse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Attention, tu risques de <w>glisser</w> sur le sol mouillé."
                        },
                        {
                            "text": "Hier, j'ai <w>glissé</w> sur une plaque de verglas devant la maison."
                        }
                    ],
                    "synonyms": [
                        "déraper"
                    ],
                    "antonyms": [
                        "adhérer"
                    ],
                    "common_phrases": [
                        "glisser sur le verglas",
                        "glisser sur une peau de banane",
                        "glisser sur le sol mouillé"
                    ]
                },
                {
                    "sense_id": "2c02ff2d-215b-3ee6-b20d-9bf2e902651d",
                    "sense_definition": "Se déplacer en coulant sur une surface lisse ou le long d'un autre corps.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "mouvement_sur_surface_lisse",
                    "name_type": "no",
                    "examples": [
