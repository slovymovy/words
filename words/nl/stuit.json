                                "target_lang_sense_clarification": "The common, informal term for the coccyx."
                            },
                            {
                                "target_lang_word": "coccyx",
                                "target_lang_sense_clarification": "The formal, anatomical term for the tailbone."
                            }
                        ]
                    }
                }
            ]
        },
        {
