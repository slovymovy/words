                                        "sense_id": "01d723c9-0225-3157-88eb-3cb594ddbc1a",
                                        "entry_id": "c9cd3ada-1358-316b-a738-86d26ac4db3b",
                                        "glosses": [
                                            "Fully attended; for everyone's attendance."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f8a1e5fc-5f98-3aaa-b990-f464cbf5a7f5",
                                        "entry_id": "c9cd3ada-1358-316b-a738-86d26ac4db3b",
                                        "glosses": [
                                            "Complete; full; entire; absolute."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f53578a8-662a-4ba6-9a7a-4decca4528fe",
                                                "sense_id": "f8a1e5fc-5f98-3aaa-b990-f464cbf5a7f5",
                                                "text": "The method of treating a subject should be plenary or full."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "plenary",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f48dbefd-2db2-3a29-9d07-f91c9dc7d585",
                                        "entry_id": "9d11dde7-2423-3874-a04e-3a062155e11d",
                                        "glosses": [
                                            "A plenary session."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a92d5306-37bd-4b66-8733-cfd3a7d1b576",
                                                "sense_id": "f48dbefd-2db2-3a29-9d07-f91c9dc7d585",
                                                "text": "After lunch, we will all be in the main auditorium listening to the plenary."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b03b57ea-1042-3afe-8b3d-716c7d4050e7",
                                        "entry_id": "9d11dde7-2423-3874-a04e-3a062155e11d",
                                        "glosses": [
                                            "Part of a lesson, usually at or towards the end, designed to review or evaluate the learning that has taken place."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1eafe80-175e-4fa1-b479-4c901baa09e5",
                                                "sense_id": "b03b57ea-1042-3afe-8b3d-716c7d4050e7",
                                                "text": "Alternatively, the plenary may be used as preparation for the next lesson, and it might support the children to discuss some vocabulary with the TA to help them prepare."
                                            },
                                            {
                                                "example_id": "fe1dc00a-0093-4777-bca5-bd4b5e0c0a51",
                                                "sense_id": "b03b57ea-1042-3afe-8b3d-716c7d4050e7",
                                                "text": "A good plenary doesn't just consolidate learning in that one lesson; it provides feedback for the teacher across a period of time and offers the chance to resolve any misconceptions."
                                            },
                                            {
                                                "example_id": "d9652628-9891-4f69-b5ae-627dfd1d22e0",
                                                "sense_id": "b03b57ea-1042-3afe-8b3d-716c7d4050e7",
                                                "text": "During the plenary the teacher wanted to consolidate this by getting pupils to use and apply what they had learned and also to discuss the calculating strategies they would use in different situations."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a5b3844a-56b9-4fea-904d-e0cc21c28aae",
                        "source_entry_id": "17b30758-c054-3911-8440-d36f2f6ae9c8",
                        "source_sense_id": "d81d0bb7-1c8f-3a3b-8efe-0bd4c6d358ae",
                        "source_sense_description": "in aanwezigheid van allen",
                        "target_lang_word": "plénier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "plénier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "521f0636-e902-3590-9ce3-892f97b6ffbf",
                                        "entry_id": "82573666-237b-30cf-8304-704d7778798f",
                                        "glosses": [
                                            "Qui est complet, entier."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "af583e9d-217f-4c23-84b6-30bf27cbaf23",
                                                "sense_id": "521f0636-e902-3590-9ce3-892f97b6ffbf",
                                                "text": "S. M. l’Empereur & l’Empire sont requis par les parties contractantes de la présente convention d’y accéder, & de donner leur consentement plénier à toutes les stipulations qui y sont contenues."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "03c6ce8f-091b-3576-98c0-45cf52c93b30",
                                        "entry_id": "82573666-237b-30cf-8304-704d7778798f",
                                        "glosses": [
                                            "Qualifie une réunion, une assemblée, etc., de tous les membres d’une organisation, où tous ceux-ci sont censés être physiquement présents."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9a6de3b9-3b67-48e3-9c1d-b0727ed9552c",
                                                "sense_id": "03c6ce8f-091b-3576-98c0-45cf52c93b30",
                                                "text": "Cette réunion plénière viserait à sensibiliser davantage à l’ampleur du problème des accidents de la route avec blessures et à examiner la mise en œuvre du Rapport mondial sur la prévention des traumatismes dus aux accidents de la circulation."
                                            },
                                            {
                                                "example_id": "82225e02-e75e-462a-9665-d1696da08927",
                                                "sense_id": "03c6ce8f-091b-3576-98c0-45cf52c93b30",
                                                "text": "Du coup, le mercredi 21 juin, le patron du CSA leur a fait comprendre, lors d’une séance plénière, qu’il verrait d’un bon œil qu’ils soient assistés par l’avocat de la maison lors de leur audition."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9665cb2b-1205-422c-9fba-b371ec9debdc",
                        "source_entry_id": "17b30758-c054-3911-8440-d36f2f6ae9c8",
                        "source_sense_id": "d81d0bb7-1c8f-3a3b-8efe-0bd4c6d358ae",
