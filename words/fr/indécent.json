                },
                {
                    "sense_id": "b6347309-8381-34d6-bfce-2cc5fba91b3a",
                    "sense_definition": "Qui est contraire aux convenances, à la morale ou choquant par son excès.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "convenance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il est jugé <w>indécent</w> d'afficher une telle richesse face à des personnes démunies."
                        },
                        {
                            "text": "Le directeur a refusé de toucher un salaire <w>indécent</w> pendant la crise économique."
