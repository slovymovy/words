                "senses": [
                    {
                        "sense_id": "febfa8f1-31e7-33b3-9bdb-f63c5c3bf2d4",
                        "entry_id": "38eac85d-68a8-33c9-b19f-b8c23f74a6b0",
                        "glosses": [
                            "Qualifie les mammifères qui marchent sur la plante des pieds et non sur les seuls doigts ou ongles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a3fe738-4b26-4e05-9eb5-c4b2e473fe00",
                                "sense_id": "febfa8f1-31e7-33b3-9bdb-f63c5c3bf2d4",
                                "text": "Les ours, les blaireaux, le panda ou les primates ( singes, lémuriens ) sont des animaux plantigrades. Ils ne sont pas tous omnivores mais peuvent avoir des régimes différents."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "1f402f22-41af-3490-adaa-212ec5d84e3a",
                "word": "plantigrade",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "028879c4-1e67-4646-9281-a585813366d5",
                        "entry_id": "1f402f22-41af-3490-adaa-212ec5d84e3a",
                        "tags": [
