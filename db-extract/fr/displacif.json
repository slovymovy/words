                                "example_id": "c18a56f8-8fd7-4e9e-9d1c-9ad95c375465",
                                "sense_id": "864e40de-bd8b-39d3-9134-6c275654c474",
                                "text": "Dans le cas de la décomposition de lʼausténite lors du refroidissement, cʼest le caractère diffusif ou displacif qui sert de critère."
                            },
                            {
                                "example_id": "9709c947-132e-4057-a372-35c28df8c692",
                                "sense_id": "864e40de-bd8b-39d3-9134-6c275654c474",
                                "text": "La transition displacive du titanate de strontium (SrTiO₃) est peut-être l’une des transitions de phase les plus étudiées en matière condensée depuis plus de 50 ans."
                            }
                        ]
