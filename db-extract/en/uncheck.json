                    {
                        "translation_id": "5d18c386-0ab5-4ba0-ae35-094397825c5c",
                        "source_entry_id": "6447aeac-57c0-3497-bb86-b0251c81c70e",
                        "source_sense_description": "to remove a checkmark",
                        "target_lang_word": "décocher",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "décocher",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "992a8b67-a741-3f47-b264-f97caf3f2015",
                                        "entry_id": "915c5a40-232d-3818-87e0-200d249d807b",
                                        "glosses": [
                                            "Tirer une flèche avec l’arbalète ou avec toute autre arme de trait semblable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d06998fd-0d20-4f20-9d7a-476b1917da6c",
                                                "sense_id": "992a8b67-a741-3f47-b264-f97caf3f2015",
                                                "text": "Et pourtant, quand il s’agissait de monter à cheval ou de décocher ses flèches, Dahteste n’avait pas de rivale."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "54e83dcd-bca2-3630-8256-9cb142489cae",
                                        "entry_id": "915c5a40-232d-3818-87e0-200d249d807b",
                                        "glosses": [
                                            "Lancer ou frapper un objet brusquement."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f09823b2-f4ff-4b51-a968-187af1be7938",
                                                "sense_id": "54e83dcd-bca2-3630-8256-9cb142489cae",
                                                "text": "Décocher un tir, un lancer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c2d58c1f-6107-3150-b119-df515c3173c1",
                                        "entry_id": "915c5a40-232d-3818-87e0-200d249d807b",
                                        "glosses": [
                                            "Lancer."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e07701be-78f8-49f9-bfd4-7f16bc4e8d15",
                                                "sense_id": "c2d58c1f-6107-3150-b119-df515c3173c1",
                                                "text": "Il répondit médiocrement aux pointes, calembours, mots à double entente, compliments et gaillardises que l’on se fit un devoir de lui décocher dès le potage."
                                            },
                                            {
                                                "example_id": "1cfdbe98-1c44-4c26-855a-c1f13201bbd0",
                                                "sense_id": "c2d58c1f-6107-3150-b119-df515c3173c1",
                                                "text": "Les portes s’ouvrent. Miséricorde ! on dirait qu’il n’y a plus de mauvais garnements ! Adam, Tricot, Bonvalot, — d’autres, toute la clique, — vous décochent leur espèce de salut militaire ; c’est dégoûtant de correction."
                                            },
                                            {
                                                "example_id": "942db7ed-997d-41df-bb39-c92ee31466ff",
                                                "sense_id": "c2d58c1f-6107-3150-b119-df515c3173c1",
                                                "text": "Plus d’un mot plaisant lui fut décoché par de petites lèvres fardées auxquelles il ne répondit point."
                                            },
                                            {
                                                "example_id": "2cd041d9-1251-4d4b-864f-781b17baf57e",
                                                "sense_id": "c2d58c1f-6107-3150-b119-df515c3173c1",
                                                "text": "Le Tors fit une belle résistance en décochant de toutes ses forces au digne fonctionnaire des coups de pied dans les jambes, […]."
                                            },
                                            {
                                                "example_id": "682e7718-009d-4cbf-be4c-46901147a712",
                                                "sense_id": "c2d58c1f-6107-3150-b119-df515c3173c1",
                                                "text": "Mais les succès de ces convertisseurs bénévoles devaient être considérables, à en juger par les récriminations qu'il souleva de la part des auteurs des Évangiles et par les flèches que leur décochent les satiriques latins, […]."
                                            },
                                            {
                                                "example_id": "54b1ca8e-8685-498c-9ee5-97ba4f388034",
                                                "sense_id": "c2d58c1f-6107-3150-b119-df515c3173c1",
                                                "text": "Malgré tout, le président Trump persiste à décocher ses tweets à un rythme endiablé pour entretenir le mythe qu’il y a encore moyen de trouver une façon de le maintenir au pouvoir envers et contre tout."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f62dcb66-0318-3a33-b4ec-b3a9602fbbff",
                                        "entry_id": "915c5a40-232d-3818-87e0-200d249d807b",
                                        "glosses": [
                                            "Démouler une pièce de fonderie."
                                        ],
                                        "tags": [
                                            "Fonderie"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "65a1adb6-dae4-35fb-aee7-767400b971c1",
                                        "entry_id": "915c5a40-232d-3818-87e0-200d249d807b",
                                        "glosses": [
                                            "Décaler les points de liage d'une duite à une autre, ou d'un fil de chaîne à un autre."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "82d46678-5434-3feb-8286-3d7407c24828",
                                        "entry_id": "915c5a40-232d-3818-87e0-200d249d807b",
                                        "glosses": [
                                            "Cliquer sur une case cochée dans un formulaire pour qu’elle ne soit plus cochée."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
