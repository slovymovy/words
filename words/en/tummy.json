                },
                {
                    "sense_id": "b6691dab-2f92-3d3f-a15a-3b40bcb5d815",
                    "sense_definition": "The abdomen or womb, particularly when referring to where a baby is carried.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "stomach",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pregnant woman gently rested her hands on her growing <w>tummy</w>.",
                            "target_lang_translations": {
                                "ru": "Беременная женщина осторожно положила руки на свой растущий <w>животик</w>."
                            }
                        },
                        {
                            "text": "He asked his mother if he could feel the baby kicking inside her <w>tummy</w>.",
                            "target_lang_translations": {
                                "ru": "Он спросил маму, можно ли ему почувствовать, как малыш толкается у нее в <w>животике</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "belly"
                    ],
                    "common_phrases": [
                        "baby in the tummy"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Commonly used in informal contexts regarding pregnancy."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Живот или утроба, особенно когда речь идет о вынашивании ребенка."
                    },
                    "translations": {
