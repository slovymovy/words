                        "translation_id": "a9e0bb64-ab4c-4253-a16f-dea3230c6b49",
                        "source_entry_id": "0917427d-d3ce-3883-ba25-d329a727cdf6",
                        "source_sense_id": "08ea18c3-1926-3477-b5bb-8bbc6171b4c2",
                        "target_lang_word": "expression",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "expression",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cb2d3eef-82d3-3f7d-aac7-558b02d53b21",
                                        "entry_id": "f6760577-9d05-360f-8c56-c0ebbeb54b95",
                                        "glosses": [
                                            "The action of expressing thoughts, ideas, feelings, etc."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ab30236c-8b65-4958-8365-0b7f83a40c9a",
                                                "sense_id": "cb2d3eef-82d3-3f7d-aac7-558b02d53b21",
                                                "text": "There are lots of great actresses who dress beautifully, but in the modern day, nearly all of them use stylists. They may know what they like—when they’re presented with gowns and outfits, they’re perfectly equipped to say yes or no—but you rarely get the sense that what they’re wearing is a true expression of who they are."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "54a4a337-b1c5-38d7-8ae1-84a63c9afd77",
                                        "entry_id": "f6760577-9d05-360f-8c56-c0ebbeb54b95",
                                        "glosses": [
                                            "A particular way of phrasing an idea."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7c6c7a05-5ec6-385c-85e4-02f3892de06b",
                                        "entry_id": "f6760577-9d05-360f-8c56-c0ebbeb54b95",
                                        "glosses": [
                                            "A colloquialism or idiom."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ffd1ec38-88d4-4c9c-bfb0-6b1b660c17eb",
                                                "sense_id": "7c6c7a05-5ec6-385c-85e4-02f3892de06b",
                                                "text": "The expression \"break a leg!\" should not be taken literally."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "962577d4-3636-319b-b67e-a38e2a5ae9eb",
                                        "entry_id": "f6760577-9d05-360f-8c56-c0ebbeb54b95",
                                        "glosses": [
                                            "A facial appearance usually associated with an emotion."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "94f35fa5-9740-46fe-9166-34c6e12f14cb",
                                                "sense_id": "962577d4-3636-319b-b67e-a38e2a5ae9eb",
                                                "text": "They stared at the newcomer with a puzzled expression."
                                            },
                                            {
                                                "example_id": "e954fac4-3354-41f2-92ee-1c795098caf1",
                                                "sense_id": "962577d4-3636-319b-b67e-a38e2a5ae9eb",
                                                "text": "The best poker players can tell if the opponents have a good hand by looking at their expression."
                                            },
                                            {
                                                "example_id": "02ee3fa2-45ae-4b86-bee8-ca63f442defd",
                                                "sense_id": "962577d4-3636-319b-b67e-a38e2a5ae9eb",
                                                "text": "Her expression changed from joy to misery after realising her winning lottery ticket had expired."
                                            },
                                            {
                                                "example_id": "f6158085-082d-4092-849a-f0b773afeb3a",
                                                "sense_id": "962577d4-3636-319b-b67e-a38e2a5ae9eb",
                                                "text": "Eustace gaped at him in amazement. When his urbanity dropped away from him, as now, he had an innocence of expression which was almost infantile. It was as if the world had never touched him at all."
                                            },
                                            {
                                                "example_id": "906c5cfe-5727-47a1-9dc7-5853eb0f3e79",
                                                "sense_id": "962577d4-3636-319b-b67e-a38e2a5ae9eb",
                                                "text": "At any other time Jessamy would have laughed at the expressions that chased each other over his freckled face: crossness left over from his struggle with the baby; incredulity; distress; and finally delight."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "14145496-ba67-345e-b0e7-419162a55397",
                                        "entry_id": "f6760577-9d05-360f-8c56-c0ebbeb54b95",
                                        "glosses": [
                                            "An arrangement of symbols denoting values, operations performed on them, and grouping symbols."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "13b2c141-fa58-3b75-b18d-c523c044c812",
                                        "entry_id": "f6760577-9d05-360f-8c56-c0ebbeb54b95",
                                        "glosses": [
                                            "The process of translating a gene into a protein."
                                        ],
                                        "tags": [
                                            "countable",
