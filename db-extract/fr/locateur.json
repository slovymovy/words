                    {
                        "sense_id": "da564301-2fee-3f3b-b0c6-5e317a7f724b",
                        "entry_id": "f8f013e9-30b0-3502-9850-580d50b55e4d",
                        "glosses": [
                            "Celui qui donne à bail."
                        ],
                        "tags": [
                            "Droit de propriété"
                        ],
                        "examples": [
                            {
                                "example_id": "2b6b7e4d-2f76-4216-8529-2dd31e9afb09",
                                "sense_id": "da564301-2fee-3f3b-b0c6-5e317a7f724b",
                                "text": "S'il s'agit d'une location pour une durée déterminée et qu'il reste moins de douze mois à courir à la location, le nouveau locateur ne peut mettre fin au bail et le locataire ne perdra aucun droit."
                            },
                            {
                                "example_id": "9427056c-475e-44ce-be64-b256828f42db",
                                "sense_id": "da564301-2fee-3f3b-b0c6-5e317a7f724b",
                                "text": "Les autres feront, à l’armée, des remplaçants pour le fils du locateur !"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b11e1d20-56d9-49ae-bc89-c780b303064b",
                        "source_entry_id": "f8f013e9-30b0-3502-9850-580d50b55e4d",
                        "source_sense_id": "da564301-2fee-3f3b-b0c6-5e317a7f724b",
                        "target_lang_word": "Mieter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mieter",
