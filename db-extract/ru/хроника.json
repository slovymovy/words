                    }
                ],
                "translations": [
                    {
                        "translation_id": "516043db-d020-4899-bc5c-6c2c3575647d",
                        "source_entry_id": "5db71e3e-35a0-3859-a08c-9c15851641b0",
                        "target_lang_word": "chronicle",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chronicle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6a163cad-6e50-37e7-9220-f71876df4624",
                                        "entry_id": "e4042414-d2c3-3b93-81e2-ec216acc92f9",
                                        "glosses": [
                                            "A written account of events and when they happened, ordered by time."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f41897b-1fab-4c44-a895-3bfc1f48c982",
                                                "sense_id": "6a163cad-6e50-37e7-9220-f71876df4624",
                                                "text": "Also a choice cachinatory chronicle, entitled \"How to Laugh, and what to Laugh at.\""
                                            },
                                            {
                                                "example_id": "63f5e5bc-7474-4f4a-b113-93168b2e998e",
                                                "sense_id": "6a163cad-6e50-37e7-9220-f71876df4624",
                                                "text": "Little disappointed, then, she turned attention to \"Chat of the Social World,\" gossip which exercised potent fascination upon the girl's intelligence. She devoured with more avidity than she had her food those pretentiously phrased chronicles of the snobocracy—[…]—distilling therefrom an acid envy that robbed her napoleon of all its flavor."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "chronicle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "399dd5e7-53bc-3490-99d3-c687d6820c60",
                                        "entry_id": "495c6459-6fdf-33fd-a823-03ff22c3284f",
                                        "glosses": [
                                            "To record in or as in a chronicle."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c8aafef8-daee-474c-a2ca-c6e48708df9f",
                                                "sense_id": "399dd5e7-53bc-3490-99d3-c687d6820c60",
                                                "text": "The posterists of Austin chronicled the changing social landscape and graphically redefined Texas for the rest of the country and the world […]"
                                            },
                                            {
                                                "example_id": "184635c2-4405-4d74-8013-c10524694230",
                                                "sense_id": "399dd5e7-53bc-3490-99d3-c687d6820c60",
                                                "text": "As the board’s director, Ms. Jankowicz, 33, bore the brunt of the attacks, a subject she knows well. Her most recent book, called “How to Be a Woman Online,” chronicles abuses she and other women face from trolls and other malign actors on the internet."
                                            },
                                            {
                                                "example_id": "06ce35ef-cfbe-47e8-a9ba-a23bcbb81f88",
                                                "sense_id": "399dd5e7-53bc-3490-99d3-c687d6820c60",
                                                "text": "The stars also worked on a Disney+ docuseries chronicling the purchase and stewardship of the club, who currently play in the National League, which was being filmed when the King and Queen Consort visited."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
