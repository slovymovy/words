                "senses": [
                    {
                        "sense_id": "dca83f93-d60c-3af9-84a1-ba9c412309fa",
                        "entry_id": "72510a8d-aac9-378b-bafe-383f9df9a1a7",
                        "glosses": [
                            "Beherrschung, Steuerung des eigenen Verhaltens"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "a4d95864-e68b-4ef4-80cb-7d253f86646e",
                                "sense_id": "dca83f93-d60c-3af9-84a1-ba9c412309fa",
                                "text": "Manch einer verliert nach ein paar Bieren die Selbstkontrolle."
                            },
                            {
                                "example_id": "af2730dd-bb18-4cca-89fb-e6a9b8c319b4",
                                "sense_id": "dca83f93-d60c-3af9-84a1-ba9c412309fa",
                                "text": "„Seine scharf geschnittenen Gesichtszüge signalisieren aber auch bei dieser entspannten Talkrunde Konzentration und Selbstkontrolle.“"
                            },
                            {
                                "example_id": "388044e3-0abc-49e6-936c-52deee256ff6",
                                "sense_id": "dca83f93-d60c-3af9-84a1-ba9c412309fa",
                                "text": "„Auch das lehre Selbstkontrolle, meinte sie schulterzuckend, und dass für Milena der Kurs dann wohl Strafe genug gewesen sei.“"
                            },
                            {
                                "example_id": "84fd35b1-8405-4d3e-bebf-8d192d3a80fe",
                                "sense_id": "dca83f93-d60c-3af9-84a1-ba9c412309fa",
                                "text": "„Ich dachte, es sei nur eine Frage der Selbstkontrolle, und ein Seitensprung sei nur die Folge von Willensschwäche oder unverzeihlichem Egoismus und Verantwortungslosigkeit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "6525bd93-dd56-394e-80c1-e69e8f04c62d",
                        "entry_id": "72510a8d-aac9-378b-bafe-383f9df9a1a7",
                        "glosses": [
                            "Überprüfung von Zuständen durch den Betroffenen selbst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "531562bc-6ead-4e91-9613-fc4701a2a2d5",
                                "sense_id": "6525bd93-dd56-394e-80c1-e69e8f04c62d",
                                "text": "Viele Diabetiker führen täglich Selbstkontrollen durch."
                            }
                        ],
