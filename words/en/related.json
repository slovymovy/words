                        "pl": "Związany z konkretną wymienioną rzeczą, często używany w złożeniach."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "связанный",
                                "target_lang_sense_clarification": "имеющий отношение к чему-либо"
