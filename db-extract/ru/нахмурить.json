                    {
                        "form_id": "7f04d8d9-7d98-4310-b283-a314877023dd",
                        "entry_id": "d243e667-7de2-3445-8547-314bb6b204e4",
                        "tags": [
                            "adverbial",
                            "participle",
                            "past"
                        ],
                        "form": "нахму́ривши"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4071ed18-2a14-3fc2-9c0b-bd42442547e2",
                        "entry_id": "d243e667-7de2-3445-8547-314bb6b204e4",
                        "glosses": [
                            "в раздумье, озабоченно или сердито, недовольно наморщить (лоб), сдвинуть (брови)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10307f48-a3a2-4a14-b7ba-ab8863967fbd",
                                "sense_id": "4071ed18-2a14-3fc2-9c0b-bd42442547e2",
                                "text": "Раскольников нахмурил брови и пристально посмотрел на Заметова."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2fe4943a-5b3a-429f-bc37-ca70ed207ec0",
                        "source_entry_id": "d243e667-7de2-3445-8547-314bb6b204e4",
                        "source_sense_id": "4071ed18-2a14-3fc2-9c0b-bd42442547e2",
                        "target_lang_word": "frown",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "frown",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "460a69f6-6b35-396c-be7f-ed22fdcc6628",
                                        "entry_id": "7fb0c2bb-4789-3791-ba8c-2194d29909d4",
                                        "glosses": [
                                            "A wrinkling of the forehead with the eyebrows brought together, typically indicating displeasure, severity, or concentration."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf0ff910-2e5c-4762-bf0e-c7266c6ee10b",
                                                "sense_id": "460a69f6-6b35-396c-be7f-ed22fdcc6628",
                                                "text": "Philip had once told him of a man who had a horse-shoe frown, and Tom had tried with all his frowning-might to make a horse-shoe on his forehead"
                                            },
                                            {
                                                "example_id": "ca9c2e5d-09fd-406a-a5de-ee4624a77780",
                                                "sense_id": "460a69f6-6b35-396c-be7f-ed22fdcc6628",
                                                "text": "He encounters some obstacle in his train of reasoning ... and then a frown passes like a shadow over his brow."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "63747ce8-97a6-3d03-af37-735f5730c550",
                                        "entry_id": "7fb0c2bb-4789-3791-ba8c-2194d29909d4",
                                        "glosses": [
                                            "A downturn of the corners of the mouth, typically expressing sadness."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a5829c92-bcad-46b4-9aea-3a820b61cb02",
                                                "sense_id": "63747ce8-97a6-3d03-af37-735f5730c550",
                                                "text": "The smile and the frown are both indicated and the operation of a motor driven flasher causes the face to look happy and sad in turn."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a53b53fe-3ce5-349a-bbb6-a3ede76a2536",
                                        "entry_id": "7fb0c2bb-4789-3791-ba8c-2194d29909d4",
                                        "glosses": [
                                            "Any facial expression that indicates disapproval or displeasure."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "frown",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0da77da0-21dd-32da-afa2-0d3ddec55086",
                                        "entry_id": "a6728fcd-4efc-3536-8249-42bd8bf51e92",
                                        "glosses": [
                                            "To have a frown on one's face."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0f2004ac-6d80-4298-926d-cf66ad20f12f",
                                                "sense_id": "0da77da0-21dd-32da-afa2-0d3ddec55086",
                                                "text": "She frowned when I told her the news."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3ef4f980-b901-3028-b2ab-f4b909b3c76c",
                                        "entry_id": "a6728fcd-4efc-3536-8249-42bd8bf51e92",
                                        "glosses": [
                                            "To manifest displeasure or disapprobation; to look with disfavour or threateningly."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e433fd59-3062-4c55-a768-d103a39f3ae7",
                                                "sense_id": "3ef4f980-b901-3028-b2ab-f4b909b3c76c",
                                                "text": "Noisy gossip in the library is frowned upon."
                                            },
                                            {
                                                "example_id": "0ce31294-81d2-4837-b6b2-a34a419fd47c",
                                                "sense_id": "3ef4f980-b901-3028-b2ab-f4b909b3c76c",
                                                "text": "The sky doth frown and lower upon our army."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "53f65882-f1bc-35d7-8168-354e91354e7a",
                                        "entry_id": "a6728fcd-4efc-3536-8249-42bd8bf51e92",
                                        "glosses": [
                                            "To repress or repel by expressing displeasure or disapproval; to rebuke with a look."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b35c5937-9064-466e-940f-26ddf9eb9176",
                                                "sense_id": "53f65882-f1bc-35d7-8168-354e91354e7a",
                                                "text": "Let us frown the impudent fellow into silence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1998d435-7d16-38bb-b0b5-6f2de0590871",
                                        "entry_id": "a6728fcd-4efc-3536-8249-42bd8bf51e92",
                                        "glosses": [
                                            "To communicate by frowning."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2d9bfb49-dc7a-4c55-8223-fcdaf86a112b",
                                                "sense_id": "1998d435-7d16-38bb-b0b5-6f2de0590871",
                                                "text": "Frank frowned his displeasure with my proposal."
                                            },
                                            {
                                                "example_id": "95997379-0a28-4f28-9125-7373013b3267",
                                                "sense_id": "1998d435-7d16-38bb-b0b5-6f2de0590871",
                                                "text": "As the band paused between songs, a gust of wind blew a distinctive Worthy Farm odour in the direction of drummer/vocalist Julien Ehrich: “Wow,” he frowned, “this place smells of cow shit.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
