                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "microbiota",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5db1a35c-c571-32f1-887e-3c6886e18853",
                                        "entry_id": "61d35da9-8042-374b-9998-5d502e26ed61",
                                        "glosses": [
                                            "The microbial community that inhabits a multi-cellular organism, whether the entire organism or a specific body surface."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab82263b-6911-4a17-92e8-95844626fd76",
                                                "sense_id": "5db1a35c-c571-32f1-887e-3c6886e18853",
                                                "text": "Caesarean babies eventually acquire the same mix of microbes as those born vaginally — by a year, their microbiota are usually indistinguishable."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
