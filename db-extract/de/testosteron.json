                    {
                        "sense_id": "4d45e0ca-6703-3d63-8a38-3580004751d8",
                        "entry_id": "ae386f12-75a8-3b24-b0d4-9cfc62269124",
                        "glosses": [
                            "Hormon, das für die männlichen Eigenschaften einer Person verantwortlich ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f7d46615-f787-4602-b08e-2e61be5db8a5",
                                "sense_id": "4d45e0ca-6703-3d63-8a38-3580004751d8",
                                "text": "„Vor vielen Jahrhunderten, als das Leben noch Sinn hatte, da zog der junge Mann voller Energie und Testosteron in den Krieg und reagierte sich dort ab, während die Frauen daheim ihm drohten, er solle entweder siegreich oder tot nach Hause kommen.“"
                            },
                            {
                                "example_id": "212d74e7-ecaf-40b5-ae53-8b079c66e9c0",
                                "sense_id": "4d45e0ca-6703-3d63-8a38-3580004751d8",
                                "text": "„Dass Männer sich in jungen Jahren deutlich risikobereiter verhalten und dementsprechend häufiger in tödliche Autounfälle verwickelt sind, führen Wissenschaftler zwar teilweise auf die Wirkung des Testosterons zurück, das die Risikobereitschaft steigert. Aber das ist nur ein Teil der Wahrheit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ffac44fd-6c6e-4a46-8fcc-75da13e2d6a5",
                        "source_entry_id": "ae386f12-75a8-3b24-b0d4-9cfc62269124",
