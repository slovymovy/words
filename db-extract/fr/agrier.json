                        "entry_id": "8178d30a-d90e-3e17-800b-a94aec1786cd",
                        "glosses": [
                            "Cépages de raisin qui croît dans la Corrèze."
                        ],
                        "tags": [
                            "Viticulture",
                            "Viticulture"
                        ],
                        "examples": [
                            {
                                "example_id": "670a3601-b86d-45d6-9f87-b7f240fb1f8a",
                                "sense_id": "9e41120c-e6b3-36d5-b0e9-cc2a38b5608d",
                                "text": "Dans la Corrèze qui ne produite que très peu de vin, on cultive le Petit Piquat et le Chabrillou ou Agrier qui donnent un vin très coloré, spiritueux et de bonne garde. C’est avec son fruit qu’on prépare la moutarde violette de Brives."
                            },
                            {
                                "example_id": "80d554bd-1545-4611-8a88-80c918655bda",
                                "sense_id": "9e41120c-e6b3-36d5-b0e9-cc2a38b5608d",
                                "text": "Agrier noir."
                            },
                            {
                                "example_id": "0ad61d20-9eca-4cc9-baa3-0d7695ede2e8",
                                "sense_id": "9e41120c-e6b3-36d5-b0e9-cc2a38b5608d",
                                "text": "Agrier blanc."
                            }
                        ]
                    }
