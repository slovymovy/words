                ],
                "senses": [
                    {
                        "sense_id": "b4751967-cc65-343b-baa5-056a2a1bb71b",
                        "entry_id": "ba76dc28-23c9-312a-84b3-cbb435401e05",
                        "glosses": [
                            "Variante de tanrec."
                        ],
                        "tags": [
                            "alt-of"
                        ],
                        "examples": [
                            {
                                "example_id": "5c5bd440-e835-4f37-a970-3c0c8ac1377d",
                                "sense_id": "b4751967-cc65-343b-baa5-056a2a1bb71b",
                                "text": "Le tangue ou hérisson malgache, Tenrec ecaudatus, est une espèce de petits mammifères de la famille des Tenrecidae, la seule du genre Tenrec."
                            },
                            {
                                "example_id": "2c81479e-2980-4efb-a955-32ae5ad516b3",
                                "sense_id": "b4751967-cc65-343b-baa5-056a2a1bb71b",
                                "text": "« Hein ? Quoi ? Oui, je dormais. Enfin, je somnolais… C’est rien. Sûrement un tangue ? Dors ma puce… »"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
