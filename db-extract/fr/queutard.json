                                    {
                                        "sense_id": "12b469fc-168a-34ec-838a-2b79adba3156",
                                        "entry_id": "e9b9de47-1505-350c-9da9-cd71b1263fbe",
                                        "glosses": [
                                            "mężczyzna korzystający z usług prostytutek, także: mężczyzna często zmieniającym partnerki seksualne"
                                        ],
