                    {
                        "sense_id": "b44148f5-176a-3806-ba9b-8b97e0a6389d",
                        "entry_id": "ba9efab4-f64b-3341-bc4b-10926ba20e41",
                        "glosses": [
                            "rozdrobniony materiał ścierny wykorzystywany do wyrobu części roboczych narzędzi ściernych, past i płynów szlifierskich"
