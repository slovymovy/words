                        "entry_id": "fa5e6154-c9ed-3faf-889f-0bbc6f20ee63",
                        "glosses": [
                            "The lect spoken by these people, which is a cluster of a large number of lects which are sometimes considered dialects and sometimes separate languages."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "12e7f6fc-d524-4f7d-a5f5-315caa2c43e0",
                        "source_entry_id": "fa5e6154-c9ed-3faf-889f-0bbc6f20ee63",
