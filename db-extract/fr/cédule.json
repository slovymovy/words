                        "entry_id": "5bf1bb52-9b19-38e0-bd47-e30795c0f92f",
                        "glosses": [
                            "Écrit, billet sous seing privé, par lequel on reconnaît devoir quelque somme."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "b92e0081-1fcd-4172-aeba-ba27c87f2c2b",
                                "sense_id": "fcfacd8b-046a-3471-9448-4f6c9fa97640",
                                "text": "On lui a prêté dix mille francs sur sa simple cédule."
                            }
