                                        "sense_id": "3dcfb582-6006-3edc-9d2a-27e6c249fa08",
                                        "entry_id": "797e5bad-a99b-3c25-b3c3-44c0f1d6e97e",
                                        "glosses": [
                                            "To educate, teach, or train (often, but not necessarily, in a school)."
