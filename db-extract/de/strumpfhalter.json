                "senses": [
                    {
                        "sense_id": "8f53cdea-1044-3014-b820-53d8617aa4f7",
                        "entry_id": "501d58c3-0df8-3a69-9b81-67752faec2b5",
                        "glosses": [
                            "elastisches Band mit einer Befestigungsmöglichkeit, an dem man einen Strumpf befestigen kann, damit er nicht rutscht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7441593b-b052-4164-a3d0-974b98adb72e",
                                "sense_id": "8f53cdea-1044-3014-b820-53d8617aa4f7",
                                "text": "„Den Strumpfhalter läßt er an, um ihre Nacktheit zu unterstreichen.“"
                            },
                            {
                                "example_id": "d4f2a74e-c050-49fb-abbf-94368cf0b53e",
                                "sense_id": "8f53cdea-1044-3014-b820-53d8617aa4f7",
                                "text": "„Sie setzte sich auf die linke Kante des Bettes, öffnete die Riemchen der Stöckelschuhe und löste die Nylons von den Strumpfhaltern.“"
                            },
                            {
                                "example_id": "75954d5f-9f14-4888-bcbc-7951245b3e49",
                                "sense_id": "8f53cdea-1044-3014-b820-53d8617aa4f7",
                                "text": "„Robert entfernte die Schuhe, ohne die Bänder zu lösen, rasch von Annas Fuß, zog ungestüm an den Strumpfhaltern, deren Klammern sie stumm selber freigab, und beugte sich tiefer, um das dünne Strumpfgewebe abzustreifen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
