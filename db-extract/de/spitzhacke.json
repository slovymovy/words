                                        "sense_id": "e374194a-bda8-3c31-821c-e07ea16572e0",
                                        "entry_id": "34319ea7-239f-3610-825b-aba1b356dc15",
                                        "glosses": [
                                            "A heavy iron tool with a wooden handle; one end of the head is pointed, the other has a chisel edge."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d374a734-ff91-4d5b-8475-28c48ffdd5b2",
                                                "sense_id": "e374194a-bda8-3c31-821c-e07ea16572e0",
                                                "text": "He was mining stone using a pickaxe."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pickaxe",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cd7b6d9e-9832-3bb2-9ce7-3ca99b6ad0bc",
                                        "entry_id": "59c8a217-4340-3ea9-b63d-45559c73dbaf",
