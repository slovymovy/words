                "senses": [
                    {
                        "sense_id": "a8ffd337-83de-3ed1-b529-c3306c222d2f",
                        "entry_id": "0d253f6d-9c1d-3d8d-b794-7ab43774abb0",
                        "glosses": [
                            "Corps chimique de couleur jaune extrait de la poudre d'Andira araroba nommée aussi \\\"poudre de Goa\\\". Sa formule brute est : C₂₂H₂₆O₇. Aussi nommée 1,8-dihydroxy-3-méthyl-9-androne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "11710a30-cabb-4cb1-b997-6e46d0ab38a9",
                                "sense_id": "a8ffd337-83de-3ed1-b529-c3306c222d2f",
                                "text": "L'oxydation de la chrysarobine donne de l’acide chrisophanique."
                            },
                            {
                                "example_id": "6a925bae-99c3-48b6-b9d3-7ade6001ad15",
                                "sense_id": "a8ffd337-83de-3ed1-b529-c3306c222d2f",
                                "text": "La chrysorabine a été utilisé contre le psoriasis, sa toxicité cutanée et rénale en on fait cessé l’usage."
                            },
                            {
                                "example_id": "caffdfc6-ec6d-41f0-97eb-53180f2ee310",
                                "sense_id": "a8ffd337-83de-3ed1-b529-c3306c222d2f",
                                "text": "Dans le traitement du psoriasis par la chrysarobine, l’on obtient une image connue rappelant la leucodermie, que l’on a nommé pseudo leucodermie ou leucodermie secondaire."
                            }
                        ]
                    }
                ],
