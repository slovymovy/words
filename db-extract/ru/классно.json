                            {
                                "example_id": "9b2d1623-d39f-45a7-b86a-8e697f0e9133",
                                "sense_id": "a95d44ba-f296-398c-a1c7-9783033fabad",
                                "text": "После́дняя дискоте́ка.\nИ ле́нта в крови́, и пла́тье.\nКак кла́ссно, что в э́тот пра́здник\nТы наде́ла всё са́мое кра́сное.",
                                "translation": "The Last Disco",
                                "english": "The Last Disco"
                            }
                        ]
                    }
                ],
