                                                "sense_id": "563768f6-6dca-35a8-a4f4-6f07fc7bc6ef",
                                                "text": "L’industrie fromagère."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fromager",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0731429d-8dbc-3904-bbfb-99c0c58000eb",
                                        "entry_id": "4c0d0295-11d2-39ba-9877-7f18b5103f66",
                                        "glosses": [
                                            "Artisan qui fait des fromages."
                                        ],
                                        "tags": [
                                            "Caséologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bf86644a-bcbf-4489-a050-d1a52b84337d",
                                                "sense_id": "0731429d-8dbc-3904-bbfb-99c0c58000eb",
                                                "text": "C’est vers la fin d’avril que le travail des fromageries commence ; c’est vers la mi-juin que les fromagers conduisent leurs vaches dans la montagne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f4b9cb8b-6954-3b84-8c17-fd572496da3a",
                                        "entry_id": "4c0d0295-11d2-39ba-9877-7f18b5103f66",
                                        "glosses": [
                                            "Commerçant qui vend des fromages."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "fromager",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8f1e5ea8-bfc2-3b54-a355-7868b6004590",
                                        "entry_id": "43c48f18-b371-3c87-9021-224e0f5f8142",
                                        "glosses": [
                                            "Petit récipient percé de trous, dans lequel on met le caillé pour en faire des fromages frais ou mous."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "edf9bac1-71e7-3245-ac5e-1088601b69d2",
                                        "entry_id": "43c48f18-b371-3c87-9021-224e0f5f8142",
                                        "glosses": [
                                            "Petit récipient destiné à contenir du fromage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0551729c-66de-4d55-9446-990455d62364",
                                                "sense_id": "edf9bac1-71e7-3245-ac5e-1088601b69d2",
                                                "text": "La jeune fille apportait justement dans une assiette creuse un amoncellement de spaghetti surmonté d’une épaisse coulée de jus de viande et de tomates. Elle posa à côté le fromager."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fromager",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7318857d-978b-3e3c-bdaf-8bf6b69476ef",
                                        "entry_id": "1f07187c-2724-3ceb-b960-51fdde3491f3",
                                        "glosses": [
                                            "Kapokier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6075a581-a85b-4c61-8638-8f41cf548105",
                                                "sense_id": "7318857d-978b-3e3c-bdaf-8bf6b69476ef",
                                                "text": "On trouve des fromagers dans les Indes, en Afrique, au Brésil et aux Antilles."
                                            },
                                            {
                                                "example_id": "48b1ff2c-80d3-4499-b872-6471f67b7b7d",
                                                "sense_id": "7318857d-978b-3e3c-bdaf-8bf6b69476ef",
                                                "text": "Avec Faralako, on retrouve, dès les premières pages du roman, l’image du fromager, arbre à la frondaison impressionnante, qui étend ses branches protectrices sur le village."
                                            },
                                            {
                                                "example_id": "e9f51ac6-95db-4374-ba71-f0034609b66a",
                                                "sense_id": "7318857d-978b-3e3c-bdaf-8bf6b69476ef",
                                                "text": "Peut-être l’ancien esclave est-il arrivé par les hauteurs de la cité, dominées par un immense fromager que ne manquait jamais de venir saluer le poète Aimé Césaire (1913-2008). L’arbre aurait survécu au souffle assassin de la Soufrière."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fromager",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "17c9a1aa-908f-3191-ae79-8c47c41fbcb5",
                                        "entry_id": "1b744206-574f-3fcc-bf37-700b37fc12ed",
                                        "glosses": [
                                            "Ajouter du fromage à."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2c4043d-25f6-4d63-9e47-27f7898f9b59",
                                                "sense_id": "17c9a1aa-908f-3191-ae79-8c47c41fbcb5",
                                                "text": "Salez, poivrez, persillez et fromagez (hé hé ;-)"
                                            },
                                            {
                                                "example_id": "6fc78e4c-b265-429f-bdfa-f514c667a7ca",
                                                "sense_id": "17c9a1aa-908f-3191-ae79-8c47c41fbcb5",
                                                "text": "Salez, poivrez, beurrez, fromagez à volonté et dégustez."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6bd93562-c296-4f77-b29d-19154437d83e",
                        "source_entry_id": "dfde6a5c-425b-3278-a910-44bf5c0e66cb",
                        "source_sense_id": "a5948c95-1523-353c-b0ef-79bd478c651a",
                        "source_sense_description": "someone who sells cheese",
                        "target_lang_word": "fromagère",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fromagère",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "36578a2a-40a1-3f50-bdea-215e82c266d1",
                                        "entry_id": "0a359c95-4eee-394b-9a9d-eec3f32b6558",
                                        "glosses": [
                                            "Artisane ayant pour activité la fabrication de fromage."
                                        ],
                                        "tags": [
                                            "Caséologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "39f5eda0-bc77-4535-9ce9-f785ca4feff9",
                                                "sense_id": "36578a2a-40a1-3f50-bdea-215e82c266d1",
                                                "text": "C'est le cas de Madeleine Hanssen, l'une des rares fromagères à fabriquer de manière artisanale du herve, ce fromage de vache à pâte molle et croûte lavée qui fait office de seul fromage AOP en Belgique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1d1e25b3-6535-3a32-a7be-804f3a0122a8",
                                        "entry_id": "0a359c95-4eee-394b-9a9d-eec3f32b6558",
                                        "glosses": [
                                            "Commerçante ayant pour activité le commerce des fromages."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f2bcffe-7760-4eba-b48d-113bed21b8c0",
                                                "sense_id": "1d1e25b3-6535-3a32-a7be-804f3a0122a8",
                                                "text": "Les deux qualités qui manquent le plus absolument à ce livre, sont justement celles qui le rendraient pardonnable, et auxquelles, sans doute, l’auteur prétend le plus : l’originalité et la sincérité ; l’originalité, car ce n’était pas la peine de cadavériser, d’éthériser, de macabriser, d’hystériser la poésie française (je parle la langue de M. Maurice Rollinat), pour emboîter le pas à ce pauvre fou de Baudelaire ; la sincérité, fort heureusement ! car, si M. Maurice Rollinat avait franchement ressenti la moitié de ce qu’il exprime ou s’efforce d'exprimer, il serait mort depuis longtemps ; et ce serait vraiment dommage; pour lui d’abord, qui n’aurait pas en ce moment le plaisir d’être le héros de la saison littéraire ; puis pour les élégantes lectrices de Nana, de Pot-Bouille et du Bonjour des Dames, qui y perdraient l’ineffable joie de savourer la Belle Fromagère, la Putréfaction, la Ballade du cadavre et la Vache au taureau."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fromagère",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f103255c-7e1c-3ab4-8843-54b2b5fe3630",
                                        "entry_id": "e7cb4ad5-361e-336c-853a-0d385f924371",
                                        "glosses": [
                                            "Pizza à base de fromage (roquefort, mozzarella, chèvre)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6361ac00-53e1-44d5-be19-4e92c1619cf9",
                                                "sense_id": "f103255c-7e1c-3ab4-8843-54b2b5fe3630",
                                                "text": "J'aimerais bien manger une fromagère."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fromagère",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a6f3703a-ea6f-33ba-9c14-6c60f46c1e93",
                                        "entry_id": "01e1f062-278d-3f42-b167-1c07fceff1c5",
                                        "glosses": [
                                            "Féminin singulier de fromager."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5a4d1f1e-849a-4d9e-be7a-00db73049dac",
                                                "sense_id": "a6f3703a-ea6f-33ba-9c14-6c60f46c1e93",
                                                "text": "D’autre part, certains exploitants (les plus engagés dans la production fromagère) apprécient peu de devoir attendre la montée du troupeau de village sur le communal pour « décrécher » leurs vaches."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
