                                        "entry_id": "5c99a272-8ce8-3250-a2b1-896083a75aa5",
                                        "glosses": [
                                            "Section qui suit le développement dans la forme sonate."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7de1ef9-cd3b-411f-bbd1-ebb770d69c41",
                                                "sense_id": "af6ff9ca-93cf-366d-bff8-674d86ce3908",
                                                "text": "Cette incertitude du sentiment de réexposition est souvent palliée par la longue préparation qu’on donne à celle-ci, en anticipant sur la tonalité retrouvée."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c6314569-be4c-4417-9a48-4b5565a72285",
