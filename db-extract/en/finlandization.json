    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "4c7ec726-c8d4-3660-a7e0-3f9f5b8519f4",
                "word": "Finlandization",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "e4deb182-8b5d-34f0-86ee-1204f9aef981",
                        "entry_id": "4c7ec726-c8d4-3660-a7e0-3f9f5b8519f4",
                        "glosses": [
                            "The process by which a smaller or less powerful sovereign state comes to abide by a more powerful neighbor's foreign policy rules, while retaining its independence."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "6f1cb1da-2e61-4c9a-99d8-31ea572666a4",
                                "sense_id": "e4deb182-8b5d-34f0-86ee-1204f9aef981",
                                "text": "Yet the model surfaced again this week, when President Emmanuel Macron of France was asked by a reporter during his shuttle diplomacy in Moscow whether Finlandization was a possibility for Ukraine. He replied, “Yes, it is one of the options on the table.”"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8f7e4047-1f32-4f9f-93c4-5b4ee4b75155",
                        "source_entry_id": "4c7ec726-c8d4-3660-a7e0-3f9f5b8519f4",
                        "source_sense_id": "e4deb182-8b5d-34f0-86ee-1204f9aef981",
                        "source_sense_description": "the influence of a large state on a smaller one",
                        "target_lang_word": "finlandisering",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "ada22dff-06ed-4ee1-82be-6314d95d977f",
                        "source_entry_id": "4c7ec726-c8d4-3660-a7e0-3f9f5b8519f4",
                        "source_sense_id": "e4deb182-8b5d-34f0-86ee-1204f9aef981",
                        "source_sense_description": "the influence of a large state on a smaller one",
                        "target_lang_word": "finlandisation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "finlandisation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ba0db584-3613-33ac-b275-17c323073da4",
                                        "entry_id": "fbb26347-0882-314b-a31a-b428e9aafb36",
                                        "glosses": [
                                            "Influence que peut avoir un pays puissant sur la politique extérieure d’un plus petit pays voisin, de telle sorte que son autonomie s’en trouve réduite, voire disparaisse."
                                        ],
                                        "tags": [
                                            "Relations internationales"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bcad6939-ee7d-481e-bd07-10066e8d8276",
                                                "sense_id": "ba0db584-3613-33ac-b275-17c323073da4",
                                                "text": "De l’extérieur, ce contexte est entrain^([sic]) de structurer la finlandisation du pays, après la libanisation qu’il vient de traverser tout au long de la crise récente."
                                            },
                                            {
                                                "example_id": "8a35d614-9b0c-457a-b23d-dfc8f42e54d5",
                                                "sense_id": "ba0db584-3613-33ac-b275-17c323073da4",
                                                "text": "Le terme francisé — « finlandisation » — sera utilisé dans les années soixante-dix par les présidents Pompidou et Giscard d’Estaing et par l’assemblée des évêques de France… Puis admis au dictionnaire."
                                            },
                                            {
                                                "example_id": "70a81879-2391-4970-b975-b98e0955a105",
                                                "sense_id": "ba0db584-3613-33ac-b275-17c323073da4",
                                                "text": "Synonyme de neutralité contrainte et de souveraineté limitée, le mot « finlandisation » garde une connotation pour le moins négative, évoquant l’emprise institutionnalisée d’un puissant voisin sur un petit pays."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5f57b816-d084-4381-82ea-064fd8e5e4bc",
                        "source_entry_id": "4c7ec726-c8d4-3660-a7e0-3f9f5b8519f4",
                        "source_sense_id": "e4deb182-8b5d-34f0-86ee-1204f9aef981",
                        "source_sense_description": "the influence of a large state on a smaller one",
                        "target_lang_word": "Finnlandisierung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Finnlandisierung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f9441fab-6e09-31e5-82fc-a85483e1d5f0",
                                        "entry_id": "557907e0-47f4-36dc-9062-68355ecd63e2",
                                        "glosses": [
                                            "die Einschränkung der außenpolitischen Handlungsfähigkeit eines Staates, der einem übermächtigen, Einfluss nehmendem Nachbarstaat gegenübersteht"
                                        ],
                                        "tags": [
                                            "abschätzig"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2cc7b511-7338-49b6-94b7-3c92fd4bd87f",
                                                "sense_id": "f9441fab-6e09-31e5-82fc-a85483e1d5f0",
                                                "text": "„Beträchtlich ist der Schutz, den die EU neuen Mitgliedstaaten an der Grenze zu Osteuropa gegen die Unwägbarkeiten der „Finnlandisierung\" gibt, also gegen die übermächtige Abhängigkeit von einer benachbarten Großmacht.“"
                                            },
                                            {
                                                "example_id": "212d7321-1ea9-4ddc-92b5-a7fb1760cf24",
                                                "sense_id": "f9441fab-6e09-31e5-82fc-a85483e1d5f0",
                                                "text": "„Der Begriff der Finnlandisierung wurde Anfang der siebziger Jahre in der Bundesrepublik geprägt zur Charakterisierung (oder auch Diffamierung) der sozialdemokratischen neuen Ostpolitik aus Angst vor „finnischen Verhältnissen am Rhein“.“"
                                            },
                                            {
                                                "example_id": "c3f5fe34-1055-423d-9d68-23524b2f228f",
                                                "sense_id": "f9441fab-6e09-31e5-82fc-a85483e1d5f0",
                                                "text": "„In einem Interview mit der norwegischen Zeitung »Dagbladet« vom 18. und 20. November November 1978 hat Präsident Kekkonen einmal gesagt: »Ich habe gar nichts dagegen, das Wort Finnlandisierung zu gebrauchen für die Beziehungen zwischen Finnland und der Sowjetunion als ein Beispiel dafür, wie Staaten verschiedener Größe und verschiedenen Gesellschaftssystemen in politischem Frieden und fruchtbarer Zusammenarbeit zusammenleben können.«“"
                                            },
                                            {
                                                "example_id": "0fa4f07b-be59-4839-b1ae-9dd5b1d4f771",
                                                "sense_id": "f9441fab-6e09-31e5-82fc-a85483e1d5f0",
                                                "text": "„Im Grunde meint „Finnlandisierung“ eigentlich „Sowjetisierung“, jedoch nicht mit militärischer Gewalt, sondern mit andern Mitteln durch die Hintertür.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
