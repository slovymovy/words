                            {
                                "example_id": "1957046f-07af-4aa9-9d05-dcef0dcadc9a",
                                "sense_id": "be37c962-7f91-3e96-9fe3-091c39e2b618",
                                "text": "Josépha, c’est de la gnognote ! cria l’ancien commis-voyageur."
                            },
                            {
                                "example_id": "c458cc43-7427-4294-8bcb-912112dda43d",
                                "sense_id": "be37c962-7f91-3e96-9fe3-091c39e2b618",
                                "text": "Lorsque à Bayonne, on joue à la pelote,\nC’est son béret que l’on jette au vainqueur,\nEt ce béret c’est pas de la gnognote\nPuisque dedans on a mis tout son cœur !"
                            }
                        ]
                    },
                    {
                        "sense_id": "fbeb6a96-4a3e-3e60-b8b1-754d089c4dfa",
                        "entry_id": "3e343c23-371b-3d07-b631-b26d3198d0bb",
                        "glosses": [
                            "Chose facile, présentant peu de difficulté."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c469276a-69b0-4b58-8e5a-8ea89dfc4b80",
                                "sense_id": "fbeb6a96-4a3e-3e60-b8b1-754d089c4dfa",
                                "text": "La suite de la démonstration, normalement, c'est de la gnognote."
                            }
                        ]
                    }
