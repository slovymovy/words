                "senses": [
                    {
                        "sense_id": "9d043930-44b9-3890-83a4-2e92f9fbf898",
                        "entry_id": "bcc6d6ed-c0fe-3325-83d6-223ba4dbaa0d",
                        "glosses": [
                            "herumliegen"
                        ],
                        "tags": [
                            "Bavarian"
                        ],
                        "examples": [
                            {
                                "example_id": "1fb9e204-99ea-4dfc-a45c-f06aca2a7e73",
                                "sense_id": "9d043930-44b9-3890-83a4-2e92f9fbf898",
                                "text": "„Ja, seine Stiefel müssen noch wo umeinanderliegen, ja, da san’s.“"
                            },
                            {
                                "example_id": "649d965b-1d91-4e01-8045-3eff022ba71e",
                                "sense_id": "9d043930-44b9-3890-83a4-2e92f9fbf898",
                                "text": "„Den ganzn Dog am Swimming-Pool umanandaliegn und d’Wampn in d’Sun holtn, des is doch ungesund!“"
                            },
                            {
                                "example_id": "0d1713de-5fc4-476e-bf84-2ee6bd6c21e8",
                                "sense_id": "9d043930-44b9-3890-83a4-2e92f9fbf898",
                                "text": "„Dao müssn sie in Stoal nuntagäin, dao wiard a Plotz san, wao ma n Ascha hinschitt und wao sua r oalts Eisnzeich umanandaliegt.“"
                            },
                            {
                                "example_id": "9a5f6277-5bcc-409f-8ad5-433a75e0a770",
                                "sense_id": "9d043930-44b9-3890-83a4-2e92f9fbf898",
                                "text": "„[…] sie täten so gern abglegte Kleider und auch Wasch in die Ostzone schicken, wo es nötig braucht wererd und bei ihnen daheim liegts bloß umandand.“"
                            },
                            {
                                "example_id": "26ee6006-5996-4c9d-9cfd-73308ff6feb9",
                                "sense_id": "9d043930-44b9-3890-83a4-2e92f9fbf898",
                                "text": "„Lauter Leichen liegn umananda.“"
                            },
                            {
                                "example_id": "730755c2-d9dc-46cd-a7a6-7e6358feede1",
                                "sense_id": "9d043930-44b9-3890-83a4-2e92f9fbf898",
                                "text": "„Mein Sohn hat auch so einen Fotzhobel daheim umanander liegen. Aber er spielt schon lang nimmer damit.“"
                            },
                            {
                                "example_id": "a573f754-4514-4225-bcfc-24a791a7b9c5",
                                "sense_id": "9d043930-44b9-3890-83a4-2e92f9fbf898",
                                "text": "„»Da draußen bei euch liegt a Leich umanander!«, rief Rummetshofer.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
