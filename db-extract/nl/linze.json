                                    {
                                        "sense_id": "417f84a8-751e-329e-acae-4e09453308ce",
                                        "entry_id": "a0e51a1a-8d00-339c-81af-75dd329395d3",
                                        "glosses": [
                                            "Any of several plants of the genus Lens, especially Lens culinaris, from southwest Asia, that have edible, lens-shaped seeds within flattened pods."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "369f8e09-fdfa-3d79-87e3-692c8641b56b",
                                        "entry_id": "a0e51a1a-8d00-339c-81af-75dd329395d3",
                                        "glosses": [
                                            "The seed of these plants, used as food."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "640caa8a-f370-4130-a3e8-8b4536404b07",
                                                "sense_id": "369f8e09-fdfa-3d79-87e3-692c8641b56b",
                                                "text": "make a lentil stew"
                                            },
                                            {
                                                "example_id": "d44fd9ce-9f0d-49ac-9786-ecfa7cfea993",
                                                "sense_id": "369f8e09-fdfa-3d79-87e3-692c8641b56b",
                                                "text": "a lentil salad"
                                            },
                                            {
                                                "example_id": "e4a3b02c-330f-4e18-8dd8-03d6e7ceff66",
                                                "sense_id": "369f8e09-fdfa-3d79-87e3-692c8641b56b",
                                                "text": "In ancient Greece, lentils were believed to stimulate desire."
                                            },
                                            {
                                                "example_id": "257e5cf9-2692-4141-87f1-1adc1123acbf",
                                                "sense_id": "369f8e09-fdfa-3d79-87e3-692c8641b56b",
                                                "text": "A couple of vegetables, sambar (spicy and sour lentils and vegetables boiled with masalas and spices), rasam (a hot and fiery lentil soup-like dish) and curds (yoghurt) served with heaps of rice and eaten in that order. A non-vegetarian version of the “meals” can be found in “Military” hotels."
                                            },
                                            {
                                                "example_id": "17f9721b-93f1-439c-bfa5-77d08c0bebca",
                                                "sense_id": "369f8e09-fdfa-3d79-87e3-692c8641b56b",
                                                "text": "Wild nuts, peas, vetch, a legume which had edible seed pods, and grasses were often combined with pulses like beans or lentils, the most commonly identified ingredient, and at times, wild mustard. To make the plants more palatable, pulses, which have a naturally bitter taste, were soaked, coarsely ground or pounded with stones to remove their husk."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3e176d82-fd13-36bb-a88d-1c674005f3bf",
                                        "entry_id": "a0e51a1a-8d00-339c-81af-75dd329395d3",
                                        "glosses": [
                                            "A small chocolate candy in an edible shell."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b2fd2f96-bd13-4308-878f-f15dd60a575b",
                                                "sense_id": "3e176d82-fd13-36bb-a88d-1c674005f3bf",
                                                "text": "An enhanced focus on the brand's iconic color palette and the use of different shapes and sizes of M&M'S lentils across all touchpoints to prove that all together, we're more fun"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
