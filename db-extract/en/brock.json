                    {
                        "sense_id": "41431e1a-7c44-3674-b39e-8bf898e152c4",
                        "entry_id": "16b50728-f96f-30a8-908a-ba5e44216dd0",
                        "glosses": [
                            "An English and Scottish surname from Middle English, a variant of Brook, or originally a nickname for someone thought to resemble a badger (Middle English broc(k))."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "bdba7b3b-6ff5-32ed-a8f4-b9bdc31f6e7b",
                        "entry_id": "16b50728-f96f-30a8-908a-ba5e44216dd0",
                        "glosses": [
                            "A male given name transferred from the surname."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b743cde4-3c39-4534-9ec2-3874ce3356bf",
                                "sense_id": "bdba7b3b-6ff5-32ed-a8f4-b9bdc31f6e7b",
                                "text": "\"I suppose you,\" she said, \"were named for General Clive.\" \"I was. And my father was named for General Brock.\" \"General Brock?\" she asked, mystified. \"General Isaac Brock, you know. The Battle of Queenston Heights, where we defeated the Americans.\" Her puzzled expression showed that she had not heard of the occasion. Young Busby was shocked."
                            }
                        ]
                    },
                    {
                        "sense_id": "1511a7a2-2957-3785-a1b7-8069c13393d5",
