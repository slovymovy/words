{
    "word_family": [
        "cajolement",
        "cajoler",
        "cajolery"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "10edc3ea-8605-3c7f-82c9-967d7686c8d8",
                    "sense_definition": "To persuade someone to do something which they are reluctant to do, especially by flattery or promises.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "persuade",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He managed to <w>cajole</w> his friend into lending him the car for the weekend.",
                            "target_lang_translations": {
                                "ru": "Ему удалось <w>уломать</w> друга одолжить машину на выходные.",
                                "zh": "他设法<w>哄得</w>朋友把车借给他过周末。",
                                "es": "Consiguió <w>engatusar</w> a su amigo para que le prestara el coche el fin de semana."
                            }
                        },
                        {
                            "text": "The manager tried to <w>cajole</w> the committee into approving the controversial budget.",
                            "target_lang_translations": {
                                "ru": "Менеджер попытался <w>улестить</w> комитет, чтобы тот одобрил спорный бюджет.",
                                "zh": "经理试图<w>劝诱</w>委员会批准那项有争议的预算。",
                                "es": "El gerente intentó <w>camelar</w> al comité para que aprobara el controvertido presupuesto."
                            }
                        }
                    ],
                    "synonyms": [
                        "butter up",
                        "coax",
                        "inveigle",
                        "sweet-talk",
                        "wheedle"
                    ],
                    "common_phrases": [
                        "cajole into",
                        "try to cajole"
                    ],
                    "target_lang_definitions": {
                        "ru": "Уговаривать или склонять кого-либо к действию с помощью лести, ласки или обещаний.",
                        "zh": "（尤指通过甜言蜜语、奉承或许诺）哄骗，劝诱",
                        "es": "Convencer o persuadir a alguien para que haga algo que no desea hacer, especialmente mediante halagos, zalamerías o promesas."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "улещивать",
                                "target_lang_sense_clarification": "склонять лестью или уговорами"
                            },
                            {
                                "target_lang_word": "умасливать",
                                "target_lang_sense_clarification": "задабривать, льстить ради выгоды"
                            },
                            {
                                "target_lang_word": "заговаривать зубы",
                                "target_lang_sense_clarification": "убалтывать, уговаривать уловками"
                            },
                            {
                                "target_lang_word": "улещать",
                                "target_lang_sense_clarification": "устаревшая форма от «улещивать»"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "哄骗",
                                "target_lang_sense_clarification": "用甜言蜜语诱使他人顺从"
                            },
                            {
                                "target_lang_word": "劝诱",
                                "target_lang_sense_clarification": "通过劝说或诱导使人做某事"
                            },
                            {
                                "target_lang_word": "讨好笼络",
                                "target_lang_sense_clarification": "用奉承讨好的方式拉拢说服"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "engatusar",
                                "target_lang_sense_clarification": "ganarse la voluntad con halagos o maña"
                            },
                            {
                                "target_lang_word": "camelar",
                                "target_lang_sense_clarification": "persuadir con piropos o promesas engañosas"
                            },
                            {
                                "target_lang_word": "lisonjear",
                                "target_lang_sense_clarification": "adular a alguien para conseguir algo"
                            },
                            {
                                "target_lang_word": "persuadir con halagos",
                                "target_lang_sense_clarification": "convencer mediante zalamerías"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6e27d99d-fa05-3ffa-b345-dd47379cd115",
                    "sense_definition": "An act of flattery or coaxing intended to persuade someone.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "persuade",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "No amount of gentle <w>cajole</w> could change his stubborn refusal to cooperate.",
                            "target_lang_translations": {
                                "ru": "Никакие мягкие <w>уговоры</w> не могли сломить его упрямый отказ сотрудничать.",
                                "zh": "再多温和的<w>哄劝</w>也无法改变他固执拒绝合作的态度。",
                                "es": "Ninguna dosis de suaves <w>zalamerías</w> pudo cambiar su obstinada negativa a cooperar."
                            }
                        },
                        {
                            "text": "Her charming <w>cajoles</w> were completely ineffective against the strict guard.",
                            "target_lang_translations": {
                                "ru": "Её очаровательные <w>заискивания</w> оказались совершенно бессильны против строгого охранника.",
                                "zh": "她那些迷人的<w>甜言蜜语</w>对那位严厉的警卫完全不起作用。",
                                "es": "Sus encantadores <w>halagos</w> resultaron completamente ineficaces frente al estricto guardia."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Проявление лести, заискивания или уговоров с целью убедить кого-либо.",
                        "zh": "用来劝诱或讨好他人的甜言蜜语、诱哄",
                        "es": "Acto de halago, zalamería o persuasión con el fin de convencer a alguien."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лесть",
                                "target_lang_sense_clarification": "угодливое восхваление ради убеждения"
                            },
                            {
                                "target_lang_word": "улещивание",
                                "target_lang_sense_clarification": "попытка уговорить лестью"
                            },
                            {
                                "target_lang_word": "заискивание",
                                "target_lang_sense_clarification": "попытка подольститься"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "甜言蜜语",
                                "target_lang_sense_clarification": "为劝诱他人而说的动听讨好的话"
                            },
                            {
                                "target_lang_word": "哄劝",
                                "target_lang_sense_clarification": "劝诱或讨好的言行"
                            },
                            {
                                "target_lang_word": "谄媚之词",
                                "target_lang_sense_clarification": "奉承讨好以求说服的话"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "zalamería",
                                "target_lang_sense_clarification": "demostración de cariño afectada para conseguir algo"
                            },
                            {
                                "target_lang_word": "halago",
                                "target_lang_sense_clarification": "palabra o muestra de admiración interesada"
                            },
                            {
                                "target_lang_word": "lisonja",
                                "target_lang_sense_clarification": "adulación interesada"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}