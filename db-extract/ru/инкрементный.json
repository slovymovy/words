                "senses": [
                    {
                        "sense_id": "6453d23c-e552-3869-9d76-ceb7dd757d8e",
                        "entry_id": "d9414268-0ec9-36cc-a482-5b8f5df1f575",
                        "glosses": [
                            "книжн. связанный, соотносящийся по значению с существительным инкремент; связанный с приращением, увеличением чего-либо на определённую величину"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f642bfae-6394-40aa-828e-af4159735718",
                                "sense_id": "6453d23c-e552-3869-9d76-ceb7dd757d8e",
                                "text": "Восстановление данных из дифференциального архива будет происходить чуть дольше, чем из полного, но быстрее, чем из инкрементного."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9e00e09a-0427-4e72-9744-01fb0c87f51e",
                        "source_entry_id": "d9414268-0ec9-36cc-a482-5b8f5df1f575",
                        "source_sense_id": "6453d23c-e552-3869-9d76-ceb7dd757d8e",
                        "target_lang_word": "incremental",
