                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "indicator",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "aa4c57a5-ec91-3616-b740-b19f3e6b4493",
                                        "entry_id": "2face951-b79b-39d8-8dce-2bf98cbe1ce1",
                                        "glosses": [
                                            "A pointer or index that indicates something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "315b5da3-3682-426a-a0e1-5e45bfa5bc08",
                                                "sense_id": "aa4c57a5-ec91-3616-b740-b19f3e6b4493",
                                                "text": "The visual indicators are a decided improvement, and have reduced the telephoning by the staff in the signalbox."
                                            },
                                            {
                                                "example_id": "7179b11a-6d76-4597-9ff5-277aa3dbcd39",
                                                "sense_id": "aa4c57a5-ec91-3616-b740-b19f3e6b4493",
                                                "text": "These old indicators [at Earl's Court station] show the destination of the next train by the appearance of an illuminated arrow next to the station name. The arrow may indicate that a train is going to Wimbledon, but it gives no clue as to when. Now, however, the indicators are supplemented by dot matrix panels that not only say where but also when. Why aren't the old ones removed? Because they, like the whole station, are Grade II listed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "53cb403c-3f1c-3057-ab9d-09efb2cb68cb",
                                        "entry_id": "2face951-b79b-39d8-8dce-2bf98cbe1ce1",
                                        "glosses": [
                                            "A meter or gauge."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "54e9aa0f-4398-3b72-9e25-92d5a354c8fb",
                                        "entry_id": "2face951-b79b-39d8-8dce-2bf98cbe1ce1",
                                        "glosses": [
                                            "The needle or dial on such a meter."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f738b20f-dd78-3e01-be5e-3240f7e77404",
                                        "entry_id": "2face951-b79b-39d8-8dce-2bf98cbe1ce1",
                                        "glosses": [
                                            "Any of many substances, such as litmus, used to indicate the concentration of a substance, or the degree of a reaction."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9646b4fb-7840-39f2-9265-b191a10d6cc6",
                                        "entry_id": "2face951-b79b-39d8-8dce-2bf98cbe1ce1",
                                        "glosses": [
                                            "A plant or animal whose presence is indicative of some specific environment."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bd9cac03-d4bf-3812-a1b1-f93ad5759c29",
                                        "entry_id": "2face951-b79b-39d8-8dce-2bf98cbe1ce1",
                                        "glosses": [
                                            "A measure, such as unemployment rate, which can be used to predict economic trends."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "03cc5784-5948-3226-b6d1-e0523606cf61",
                                        "entry_id": "2face951-b79b-39d8-8dce-2bf98cbe1ce1",
                                        "glosses": [
                                            "A turn signal; each of the flashing lights on each side of a vehicle which indicate a turn is being made to left or right, or a lane change etc."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "Ireland",
                                            "New-Zealand",
