                                        "examples": [
                                            {
                                                "example_id": "043d0052-1613-4bbb-989f-25c721ec1d9e",
                                                "sense_id": "c3cf2ad5-ea7c-3f5b-9351-6060c4337eb8",
                                                "text": "Do not let anyone pressure you into buying something you do not want."
                                            }
                                        ]
