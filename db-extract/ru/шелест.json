                                                "sense_id": "cedba1f9-330a-3c28-9888-a53f5bb460c4",
                                                "text": "„Das Rascheln wurde lauter.“"
                                            },
                                            {
                                                "example_id": "c3ea7e17-a947-48be-ba4b-5e23834d2f07",
                                                "sense_id": "cedba1f9-330a-3c28-9888-a53f5bb460c4",
                                                "text": "„Neben Amalias Stimme waren die tickende Wanduhr, die leisen Vogelrufe und das Rascheln der Zeitung die einzigen Geräusche im Haus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
