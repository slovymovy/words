{
    "word_family": [
        "разговор",
        "договор",
        "приговор",
        "уговор",
        "заговор",
        "поговорка",
        "говор",
        "разговорчивый",
        "разговорный",
        "договориться",
        "уговорить",
        "разговориться",
        "переговорить",
        "отговорить"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4b768f67-b178-3920-a0d4-d519760be330",
                    "sense_definition": "Владеть языком, уметь пользоваться устной речью.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "ability",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мой новый друг отлично <говорит> по-русски.",
                            "target_lang_translations": {
                                "en": "My new friend <speaks> Russian perfectly.",
                                "de": "Mein neuer Freund <spricht> perfekt Russisch.",
                                "zh": "我的新朋友俄语<w>说</w>得非常好。"
                            }
                        },
                        {
                            "text": "Маленький ребёнок начал <говорить> очень рано.",
                            "target_lang_translations": {
                                "en": "The small child started to <talk> very early.",
                                "de": "Das kleine Kind hat sehr früh angefangen zu <sprechen>.",
                                "zh": "那个小孩很早就开始<w>说话</w>了。"
                            }
                        }
                    ],
                    "antonyms": [
                        "немотствовать"
                    ],
                    "common_phrases": [
                        "говорить по-русски",
                        "говорить на английском",
                        "научиться говорить",
                        "свободно говорить"
                    ],
                    "target_lang_definitions": {
                        "en": "To be able to communicate in a language or use oral speech.",
                        "de": "Die Fähigkeit besitzen, eine Sprache zu beherrschen oder mündlich zu kommunizieren.",
                        "zh": "掌握一门语言，或具备使用口头语言进行交流的能力。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "speak",
                                "target_lang_sense_clarification": "to know and use a language"
                            },
                            {
                                "target_lang_word": "talk",
                                "target_lang_sense_clarification": "to have the ability of speech"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "sprechen",
                                "target_lang_sense_clarification": "eine Sprache beherrschen oder die Fähigkeit zur Rede besitzen"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "说",
                                "target_lang_sense_clarification": "指掌握并使用某种语言"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3c7bfb52-f851-3432-b267-a2b04eddb78b",
                    "sense_definition": "Произносить слова, выражать мысли вслух, сообщать информацию.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я всегда прошу его <говорить> только правду.",
                            "target_lang_translations": {
                                "en": "I always ask him to <tell> only the truth.",
                                "de": "Ich bitte ihn immer, nur die Wahrheit zu <sagen>.",
                                "zh": "我总是要求他只<w>说</w>真话。"
                            }
                        },
                        {
                            "text": "Учитель <говорит> нам открыть учебники на пятой странице.",
                            "target_lang_translations": {
                                "en": "The teacher <tells> us to open our textbooks to page five.",
                                "de": "Der Lehrer <sagt> uns, dass wir die Lehrbücher auf Seite fünf öffnen sollen.",
                                "zh": "老师<w>告诉</w>我们把课本翻到第五页。"
                            }
                        }
                    ],
                    "synonyms": [
                        "сообщать",
                        "высказывать",
                        "разговаривать",
                        "произносить"
                    ],
                    "antonyms": [
                        "молчать"
                    ],
                    "common_phrases": [
                        "говорить правду",
                        "честно говоря",
                        "говорить громко",
                        "говорить шёпотом"
                    ],
                    "target_lang_definitions": {
                        "en": "To pronounce words, express thoughts aloud, or convey information.",
                        "de": "Wörter aussprechen, Gedanken laut äußern oder Informationen mitteilen.",
                        "zh": "发出声音、表达思想或传达信息。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "say",
                                "target_lang_sense_clarification": "to utter words or express thoughts"
                            },
                            {
                                "target_lang_word": "tell",
                                "target_lang_sense_clarification": "to communicate information or give instructions"
                            },
                            {
                                "target_lang_word": "speak",
                                "target_lang_sense_clarification": "to utter words"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "sagen",
                                "target_lang_sense_clarification": "etwas äußern oder mitteilen"
                            },
                            {
                                "target_lang_word": "sprechen",
                                "target_lang_sense_clarification": "Wörter von sich geben"
                            },
                            {
                                "target_lang_word": "erzählen",
                                "target_lang_sense_clarification": "Informationen oder eine Geschichte vermitteln"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "说",
                                "target_lang_sense_clarification": "表达思想或发出言语"
                            },
                            {
                                "target_lang_word": "告诉",
                                "target_lang_sense_clarification": "传达信息或给予指示"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7282f9e0-4dcc-3ccd-973b-82884c5ae2b5",
                    "sense_definition": "Вести беседу, общаться с кем-либо.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "conversation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы любим <говорить> с друзьями о музыке и кино.",
                            "target_lang_translations": {
                                "en": "We love to <talk> with friends about music and movies.",
                                "de": "Wir lieben es, mit Freunden über Musik und Filme zu <reden>.",
                                "zh": "我们喜欢和朋友们<w>谈论</w>音乐和电影。"
                            }
                        },
                        {
                            "text": "Она может часами <говорить> по телефону.",
                            "target_lang_translations": {
                                "en": "She can <talk> on the phone for hours.",
                                "de": "Sie kann stundenlang am Telefon <reden>.",
                                "zh": "她可以<w>聊天</w>聊上几个小时。"
                            }
                        }
                    ],
                    "synonyms": [
                        "разговаривать",
                        "беседовать",
                        "общаться"
                    ],
                    "antonyms": [
                        "молчать"
                    ],
                    "common_phrases": [
                        "говорить по телефону",
                        "говорить с другом",
                        "говорить о делах",
                        "говорить по душам"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "implies informal conversation"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To engage in conversation or discuss something with someone.",
                        "de": "Sich unterhalten oder mit jemandem über etwas diskutieren.",
                        "zh": "与某人进行交谈或讨论。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "talk",
                                "target_lang_sense_clarification": "to converse informally"
                            },
                            {
                                "target_lang_word": "speak",
                                "target_lang_sense_clarification": "to converse formally or generally"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "reden",
                                "target_lang_sense_clarification": "sich informell unterhalten"
                            },
                            {
                                "target_lang_word": "sprechen",
                                "target_lang_sense_clarification": "ein Gespräch führen (auch formell)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "聊天",
                                "target_lang_sense_clarification": "非正式的交谈"
                            },
                            {
                                "target_lang_word": "谈话",
                                "target_lang_sense_clarification": "正式或一般的交谈"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9c68cf47-0088-3b25-9593-43e140497be9",
                    "sense_definition": "Распространять слухи или сообщать общеизвестную информацию (обычно в 3-м лице множественного числа).",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "rumors",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В нашем городе <говорят>, что скоро построят новый парк.",
                            "target_lang_translations": {
                                "en": "In our city they <say> that a new park will be built soon.",
                                "de": "In unserer Stadt <sagt man>, dass bald ein neuer Park gebaut wird.",
                                "zh": "在我们城市<w>据说</w>很快要建一个新公园。"
                            }
                        },
                        {
                            "text": "Про этого актёра <говорят> много хорошего.",
                            "target_lang_translations": {
                                "en": "They <say> many good things about this actor.",
                                "de": "Man <sagt> viel Gutes über diesen Schauspieler.",
                                "zh": "人们<w>说</w>了很多关于这位演员的好话。"
                            }
                        }
                    ],
                    "synonyms": [
                        "поговаривать",
                        "сплетничать"
                    ],
                    "common_phrases": [
                        "говорят, что",
                        "как говорят",
                        "люди говорят"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "usually impersonal 'говорят'"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To spread rumors or report common knowledge (usually impersonal 'they say').",
                        "de": "Gerüchte verbreiten oder allgemeines Wissen wiedergeben (meist unpersönlich).",
                        "zh": "传播传闻或报告众所周知的信息（通常用非人称形式）。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "say",
                                "target_lang_sense_clarification": "used in 'they say' for rumors or general belief"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "man sagt",
                                "target_lang_sense_clarification": "allgemeine Redewendung für Gerüchte oder allgemeine Ansichten"
                            },
                            {
                                "target_lang_word": "es geht das Gerücht um",
                                "target_lang_sense_clarification": "wenn etwas allgemein behauptet wird"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "据说",
                                "target_lang_sense_clarification": "用于传闻或普遍看法"
                            },
                            {
                                "target_lang_word": "人们说",
                                "target_lang_sense_clarification": "用于表达大众观点"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c6b8894e-3c20-3c9c-bfcd-b82af445384c",
                    "sense_definition": "Свидетельствовать о чём-либо, служить доказательством (в переносном смысле).",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "metaphor",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Его смелые поступки <говорят> сами за себя.",
                            "target_lang_translations": {
                                "en": "His brave deeds <speak> for themselves.",
                                "de": "Seine mutigen Taten <sprechen> für sich selbst.",
                                "zh": "他勇敢的行为本身就<w>说明</w>了一切。"
                            }
                        },
                        {
                            "text": "Эти факты <говорят> о том, что экономика растёт.",
                            "target_lang_translations": {
                                "en": "These facts <indicate> that the economy is growing.",
                                "de": "Diese Fakten <sprechen> dafür, dass die Wirtschaft wächst.",
                                "zh": "这些事实<w>证明</w>经济正在增长。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "факты говорят",
                        "говорить в пользу",
                        "говорить сам за себя"
                    ],
                    "target_lang_definitions": {
                        "en": "To serve as evidence or proof of something.",
                        "de": "Als Beweis oder Hinweis für etwas dienen (im übertragenen Sinne).",
                        "zh": "作为某事的证据或证明（引申义）。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "speak",
                                "target_lang_sense_clarification": "to serve as evidence (e.g., speak for itself)"
                            },
                            {
                                "target_lang_word": "indicate",
                                "target_lang_sense_clarification": "to show or suggest"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "sprechen für",
                                "target_lang_sense_clarification": "als Argument oder Beweis dienen"
                            },
                            {
                                "target_lang_word": "hindeuten auf",
                                "target_lang_sense_clarification": "einen Hinweis auf etwas geben"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "说明",
                                "target_lang_sense_clarification": "显示或暗示某事"
                            },
                            {
                                "target_lang_word": "证明",
                                "target_lang_sense_clarification": "作为证据"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "39d76f9b-19e7-362b-8c3a-77bec5117309",
                    "sense_definition": "Подсказывать или предчувствовать (об интуиции или чувствах).",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "metaphor",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Моё сердце <говорит>, что нужно помочь этому человеку.",
                            "target_lang_translations": {
                                "en": "My heart <tells> me that I need to help this person.",
                                "de": "Mein Herz <sagt> mir, dass ich diesem Menschen helfen muss.",
                                "zh": "我的心<w>告诉</w>我，我应该帮助这个人。"
                            }
                        },
                        {
                            "text": "Интуиция <говорила> мне не соглашаться на это предложение.",
                            "target_lang_translations": {
                                "en": "Intuition <told> me not to agree to this proposal.",
                                "de": "Meine Intuition <sagte> mir, dass ich diesem Vorschlag nicht zustimmen sollte.",
                                "zh": "直觉<w>告诉</w>我不要接受这个提议。"
                            }
                        }
                    ],
                    "synonyms": [
                        "подсказывать",
                        "предсказывать"
                    ],
                    "common_phrases": [
                        "внутренний голос говорит",
                        "интуиция говорит",
                        "сердце говорит"
                    ],
                    "target_lang_definitions": {
                        "en": "To suggest or warn (referring to intuition or feelings).",
                        "de": "Etwas intuitiv spüren oder eine innere Ahnung haben.",
                        "zh": "指直觉或情感上的暗示或预感。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "tell",
                                "target_lang_sense_clarification": "to give an intuitive feeling"
                            },
                            {
                                "target_lang_word": "say",
                                "target_lang_sense_clarification": "to suggest internally"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "sagen",
                                "target_lang_sense_clarification": "im Sinne von 'mein Gefühl sagt mir'"
                            },
                            {
                                "target_lang_word": "ahnen",
                                "target_lang_sense_clarification": "eine intuitive Vorahnung haben"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "告诉",
                                "target_lang_sense_clarification": "指内心的直觉感受"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}