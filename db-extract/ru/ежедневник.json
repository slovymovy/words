                        "translation_id": "00abf179-28e3-41c3-986c-70ca4ed6735a",
                        "source_entry_id": "a98a17e3-6902-3a16-9484-3761461aee7c",
                        "source_sense_description": "блокнот для ежедневных записей",
                        "target_lang_word": "diary",
