{
    "word_family": [
        "masque",
        "démasquer",
        "masquage",
        "mascarade",
        "démasquage"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9da71f53-56ae-3d72-8782-2fa2e3543d58",
                    "sense_definition": "Couvrir le visage d'une personne avec un masque, notamment pour se déguiser ou se protéger.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "couvrir",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pour le carnaval, les enfants aiment se <w>masquer</w> avant d'aller défiler dans la rue."
                        },
                        {
                            "text": "Le médecin a demandé à tous les visiteurs de se <w>masquer</w> dans l'hôpital."
                        }
                    ],
                    "synonyms": [
                        "déguiser"
                    ],
                    "antonyms": [
                        "démasquer"
                    ],
                    "common_phrases": [
                        "se masquer le visage"
                    ]
                },
                {
                    "sense_id": "e4f1bd44-3a92-3b69-af91-e5705f82a9f3",
                    "sense_definition": "Couvrir ou dissimuler un objet à la vue.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "cacher",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ces grands arbres <w>masquent</w> la vue sur les montagnes depuis notre balcon."
                        },
                        {
                            "text": "Le brouillard épais a fini par <w>masquer</w> complètement le phare au loin."
                        }
                    ],
                    "synonyms": [
                        "cacher",
                        "dissimuler",
                        "obstruer"
                    ],
                    "antonyms": [
                        "découvrir",
                        "révéler",
                        "montrer"
                    ],
                    "common_phrases": [
                        "masquer la vue"
                    ]
                },
                {
                    "sense_id": "22837681-60f2-39c8-813f-12ecbea1a69e",
                    "sense_definition": "Dissimuler un sentiment, une intention ou une vérité sous une fausse apparence.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "cacher",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il essayait de <w>masquer</w> son inquiétude derrière un grand sourire rassurant."
                        },
                        {
                            "text": "Ses paroles pleines d'assurance visaient à <w>masquer</w> ses véritables intentions."
                        }
                    ],
                    "synonyms": [
                        "dissimuler",
                        "feindre",
                        "cacher"
                    ],
                    "antonyms": [
                        "avouer",
                        "exprimer",
                        "dévoiler"
                    ],
                    "common_phrases": [
                        "masquer son inquiétude",
                        "masquer la vérité"
                    ]
                },
                {
                    "sense_id": "bf127448-47cc-33fe-a7fc-0c0b617c4ba6",
                    "sense_definition": "Napper ou recouvrir entièrement un mets d'une sauce, d'une crème ou d'une gelée.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "couvrir",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le cuisinier doit <w>masquer</w> le gâteau avec une fine couche de chocolat fondu."
                        },
                        {
                            "text": "Il faut <w>masquer</w> la viande froide de gelée avant de la servir aux invités."
                        }
                    ],
                    "synonyms": [
                        "napper",
                        "enrober"
                    ],
                    "common_phrases": [
                        "masquer de sauce"
                    ]
                },
                {
                    "sense_id": "c5835a95-4273-3743-ac92-c62f45744b2a",
                    "sense_definition": "Placer des forces devant une place forte ou des positions ennemies pour surveiller et neutraliser sans engager de combat direct.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "militaire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le général ordonna à deux régiments de <w>masquer</w> la forteresse pendant la marche."
                        },
                        {
                            "text": "Une division entière était chargée de <w>masquer</w> les troupes ennemies retranchées."
                        }
                    ],
                    "synonyms": [
                        "neutraliser"
                    ],
                    "common_phrases": [
                        "masquer une place"
                    ]
                }
            ]
        }
    ]
}