                ],
                "translations": [
                    {
                        "translation_id": "f689cdb5-6f6f-41f8-bb06-72cca1b46a1e",
                        "source_entry_id": "4e386252-a16f-30ce-9010-bf90b2427308",
                        "source_sense_id": "967df9f5-78d5-373f-a0bf-3254a0281014",
                        "target_lang_word": "predatory",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "predatory",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fffd85bc-99a5-32a6-b592-2cb215c12189",
                                        "entry_id": "2a99ce8c-63cb-34df-8f0c-1bfef3d5629a",
                                        "glosses": [
                                            "Of, or relating to a predator."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ade8d4e7-309a-468a-9ad7-3bbca8ffc171",
                                                "sense_id": "fffd85bc-99a5-32a6-b592-2cb215c12189",
                                                "text": "Harry Kane was back to his predatory best after struggling in the group stage, following up his goal against Germany by poking home a superb pass from Raheem Sterling after only four minutes."
                                            },
                                            {
                                                "example_id": "7b5721da-3b26-45f9-ba5e-41fa54a8cf77",
                                                "sense_id": "fffd85bc-99a5-32a6-b592-2cb215c12189",
                                                "text": "And while there are plenty of benches, there's little shelter from the wind (or predatory seagulls the size of dogs) out on the platforms."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "119774da-9bf6-3681-83f8-2ac48881fdc5",
                                        "entry_id": "2a99ce8c-63cb-34df-8f0c-1bfef3d5629a",
                                        "glosses": [
                                            "Living by preying on other living animals."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "20cc03b1-6a35-4b24-9865-fae78e24cb4c",
                                                "sense_id": "119774da-9bf6-3681-83f8-2ac48881fdc5",
                                                "text": "The mark of his father’s early life was strong upon him and enhanced by months of association with beasts, from whom the imitative faculty of youth had absorbed a countless number of little mannerisms of the predatory creatures of the wild."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9a6883ed-3ef2-39bd-8d61-d3ddb91c04aa",
                                        "entry_id": "2a99ce8c-63cb-34df-8f0c-1bfef3d5629a",
                                        "glosses": [
                                            "Exploiting or victimizing others for personal gain."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c48debe3-a3f5-4edb-af0d-a2949968855d",
                                                "sense_id": "9a6883ed-3ef2-39bd-8d61-d3ddb91c04aa",
                                                "text": "predatory lending"
                                            },
                                            {
                                                "example_id": "5d7cd6e0-338e-4f09-8bbb-f4d136f05e5f",
                                                "sense_id": "9a6883ed-3ef2-39bd-8d61-d3ddb91c04aa",
                                                "text": "predatory inclusion"
                                            },
                                            {
                                                "example_id": "47056a90-4b37-4070-b77d-990f0d6a3c5a",
                                                "sense_id": "9a6883ed-3ef2-39bd-8d61-d3ddb91c04aa",
                                                "text": "One very important section of the denizens of Darkest England are the criminals and the semi-criminals. They are more or less predatory, and are at present shepherded by the police and punished by the gaoler."
                                            },
                                            {
                                                "example_id": "d83f9ab4-ded5-452f-9be0-08fedb7ece9f",
                                                "sense_id": "9a6883ed-3ef2-39bd-8d61-d3ddb91c04aa",
                                                "text": "The purpose of government was the guarding of property-rights, the perpetuation of ancient force and modern fraud. Or was it marriage? Marriage and prostitution were two sides of one shield, the predatory man’s exploitation of the sex-pleasure."
                                            },
                                            {
                                                "example_id": "cd3087ba-0751-4ce2-865e-29d5678ec53f",
                                                "sense_id": "9a6883ed-3ef2-39bd-8d61-d3ddb91c04aa",
                                                "text": "Francis had promised to take the matter seriously, recruiting victims of predatory priests to a Vatican commission he set up to stamp out abuse, but several resigned soon afterwards, judging that he was not prepared to make the changes needed and hand oversight of the church’s handling of such cases to a completely independent body."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
