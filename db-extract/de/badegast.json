                    {
                        "form_id": "4d34661e-956c-4824-932b-7e57abf0c57e",
                        "entry_id": "d130f7a5-a7ce-346c-b917-133f8e3c8e3e",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Badegäste"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fc6863ef-9d7f-327a-aff4-f4043550d0a3",
                        "entry_id": "d130f7a5-a7ce-346c-b917-133f8e3c8e3e",
                        "glosses": [
                            "Person, die sich zum Baden in einem Badeort oder in einer Badeanstalt aufhält"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3532bff2-3ce9-4767-8713-a12dc883049f",
                                "sense_id": "fc6863ef-9d7f-327a-aff4-f4043550d0a3",
                                "text": "Das städtische Freibad hatte in diesem Sommer mehr Badegäste als je zuvor."
                            },
                            {
                                "example_id": "884d3ef8-7dfc-4512-93e5-1670e3f3c5e5",
                                "sense_id": "fc6863ef-9d7f-327a-aff4-f4043550d0a3",
                                "text": "„Die Isländer leiten heißes Wasser ins Meer, um dieses für die Badegäste aufzuwärmen.“"
                            },
                            {
                                "example_id": "fe170370-ce26-47a1-9d91-226407ad080f",
                                "sense_id": "fc6863ef-9d7f-327a-aff4-f4043550d0a3",
                                "text": "„Schneider grüßt in die Runde der Badegäste, unterhält sich kurz mit der Frau, die den kleinen Kiosk bewirtschaftet, und bestellt Kaffee für uns.“"
                            },
                            {
                                "example_id": "69d83dbd-28cd-41b3-b142-ed7c51f1de1e",
                                "sense_id": "fc6863ef-9d7f-327a-aff4-f4043550d0a3",
                                "text": "„Am Ende der Straße, längs der Seepromenade, bewegten sich die Badegäste in entgegengesetzter Richtung langsam durch den hellen Sonnenschein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "bedaf5e7-c933-3a7b-8507-c44c1ffb9c90",
                        "entry_id": "d130f7a5-a7ce-346c-b917-133f8e3c8e3e",
                        "glosses": [
                            "Passagier ohne besondere Funktion an Bord"
                        ],
                        "tags": [
                            "Seemannssprache"
                        ],
                        "examples": [
                            {
                                "example_id": "4127c213-fb57-4b5b-b5d0-2ba25869fc28",
                                "sense_id": "bedaf5e7-c933-3a7b-8507-c44c1ffb9c90",
                                "text": "Wir hatten zwei Badegäste an Bord, die vor Seekrankheit ständig über der Reling hingen."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
