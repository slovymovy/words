                    "name_type": "no",
                    "examples": [
                        {
                            "text": "C'est un personnage <w>étonnant</w> qui a voyagé seul à travers plusieurs continents.",
                            "target_lang_translations": {
                                "en": "This is an <w>extraordinary</w> character who travelled alone across several continents.",
                                "ru": "Это <w>незаурядная</w> личность, которая в одиночку путешествовала по нескольким континентам.",
                                "nl": "Dit is een <w>bijzonder</w> personage dat alleen door verschillende continenten reisde.",
                                "de": "Das ist ein <w>außergewöhnlicher</w> Mensch, der allein durch mehrere Kontinente gereist ist.",
                                "pl": "To <w>niezwykła</w> postać, która samotnie podróżowała po kilku kontynentach.",
                                "it": "È un personaggio <w>straordinario</w> che ha viaggiato da solo attraverso diversi continenti.",
                                "cs": "Je to <w>neobyčejná</w> osobnost, která cestovala sama přes několik kontinentů.",
                                "tr": "Bu, tek başına birkaç kıtayı gezmiş <w>olağanüstü</w> bir insan.",
                                "es": "Es un personaje <w>extraordinario</w> que viajó solo por varios continentes.",
                                "zh": "这是一位<w>非凡</w>的人物，独自周游过好几个大洲。"
                            }
                        },
                        {
                            "text": "Cette artiste est une femme <w>étonnante</w> capable de créer des œuvres monumentales en quelques jours.",
                            "target_lang_translations": {
                                "en": "This artist is an <w>extraordinary</w> woman capable of creating monumental works in just a few days.",
                                "ru": "Эта художница — <w>незаурядная</w> женщина, способная создавать монументальные произведения всего за несколько дней.",
                                "nl": "Deze kunstenares is een <w>bijzondere</w> vrouw die in enkele dagen monumentale werken kan maken.",
                                "de": "Diese Künstlerin ist eine <w>außergewöhnliche</w> Frau, die in wenigen Tagen monumentale Werke schaffen kann.",
                                "pl": "Ta artystka to <w>niezwykła</w> kobieta, zdolna stworzyć monumentalne dzieła w ciągu zaledwie kilku dni.",
                                "it": "Questa artista è una donna <w>straordinaria</w> capace di creare opere monumentali in pochi giorni.",
                                "cs": "Tato umělkyně je <w>neobyčejná</w> žena, schopná vytvořit monumentální díla za několik dní.",
                                "tr": "Bu sanatçı, birkaç gün içinde anıtsal eserler yaratabilen <w>olağanüstü</w> bir kadın.",
                                "es": "Esta artista es una mujer <w>extraordinaria</w> capaz de crear obras monumentales en pocos días.",
                                "zh": "这位艺术家是个<w>非凡</w>的女性，几天之内就能创作出宏伟的作品。"
                            }
                        }
