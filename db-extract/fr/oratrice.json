        "fr-extract.jsonl": [
            {
                "entry_id": "384554cc-e7db-31d8-8e89-5ccc2f075292",
                "word": "oratrice",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "26aa0f23-1169-498e-9d33-62bdfb425028",
                        "entry_id": "384554cc-e7db-31d8-8e89-5ccc2f075292",
                        "tags": [
                            "plural"
                        ],
                        "form": "oratrices"
                    },
                    {
                        "form_id": "dd2fafa4-1273-4199-9101-dbda4f3aad6f",
                        "entry_id": "384554cc-e7db-31d8-8e89-5ccc2f075292",
                        "tags": [
                            "masculine"
                        ],
                        "form": "orateur"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "59bf6834-3cf1-3ef2-9f1c-f679d54be5a6",
                        "entry_id": "384554cc-e7db-31d8-8e89-5ccc2f075292",
                        "glosses": [
                            "Celle qui compose, qui prononce des discours ou des ouvrages d’éloquence."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9b84a5c2-580b-4e1e-9d88-e0859f02beee",
                                "sense_id": "59bf6834-3cf1-3ef2-9f1c-f679d54be5a6",
                                "text": "Elle n’était pas une grande oratrice… On peut même dire qu’elle parlait plat… Mais qu’importe… Elle s’imposait… On la respectait…"
                            }
                        ]
                    },
                    {
                        "sense_id": "614284d4-6055-3391-a763-9bfb2b56654b",
                        "entry_id": "384554cc-e7db-31d8-8e89-5ccc2f075292",
                        "glosses": [
                            "Celle qui parle dans un échange."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7afa3bb2-b16c-46c3-944e-5195217b7e57",
                                "sense_id": "614284d4-6055-3391-a763-9bfb2b56654b",
                                "text": "Dans quel venin tremper nos dards ? lance une voix plus lyrique depuis les premiers rangs. — Et si, ajoute une autre oratrice, nous en revenions au doigt de Dieu ? Silence consterné dans la salle."
                            }
                        ]
                    },
                    {
                        "sense_id": "6a130adc-68db-308f-9b09-3bdc6384dc75",
                        "entry_id": "384554cc-e7db-31d8-8e89-5ccc2f075292",
                        "glosses": [
                            "Celle dont la fonction est de parler dans une assemblée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b9c51c1b-6ce4-4ec2-b6be-8818bf56712e",
                                "sense_id": "6a130adc-68db-308f-9b09-3bdc6384dc75",
                                "text": "Parmi les oratrices (pardon du mot), mentionnons au premier rang la femme Thérèse, âgée de cinquante-huit ans, que l’on avait surnommé, en 1848, l’Amazone de l’insurrection, parce qu’elle avait fait le feu contre la troupe."
                            },
                            {
                                "example_id": "edf3d5c3-9124-4098-9451-4ef240a462ad",
                                "sense_id": "6a130adc-68db-308f-9b09-3bdc6384dc75",
                                "text": "Les municipalités ne peuvent remplir leur mission, que si elles disposent des ressources financières nécessaires et l’oratrice se félicite que cette question ait été abordée lors des interventions précédentes."
                            }
                        ]
                    },
                    {
                        "sense_id": "d74f0a67-2586-34f7-8ccc-58a50d76660a",
                        "entry_id": "384554cc-e7db-31d8-8e89-5ccc2f075292",
                        "glosses": [
                            "Celle qui parle avec facilité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c522a13-b3c2-4d56-bf96-852baa3a4066",
                                "sense_id": "d74f0a67-2586-34f7-8ccc-58a50d76660a",
                                "text": "Et comme maman est une oratrice de talent, elle ne se fait pas prier pour jacasser. D’autant que j’ai encore trois cent kilomètres de route à faire. Il faut bien meubler."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c25fd41b-336c-4856-aecc-8e3ceef43161",
                        "source_entry_id": "384554cc-e7db-31d8-8e89-5ccc2f075292",
                        "target_lang_word": "Rednerin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rednerin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8ea3627f-5344-3be5-8456-9abccd32da64",
                                        "entry_id": "f6b01811-77ce-35c4-b11f-978a932a5c11",
                                        "glosses": [
                                            "Frau, die eine öffentliche Rede oder Ansprache hält"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d91b5a99-072d-4575-8d3f-b40a693285bf",
                                                "sense_id": "8ea3627f-5344-3be5-8456-9abccd32da64",
                                                "text": "Die Rednerin konnte kein Ende finden, sodass nach einer Stunde einige Zuhörer begannen, den Saal zu verlassen."
                                            },
                                            {
                                                "example_id": "651f0a63-ebd3-4f68-8d91-44c7c417e586",
                                                "sense_id": "8ea3627f-5344-3be5-8456-9abccd32da64",
                                                "text": "„So voll, so erfüllt war die Rednerin von ihrer Überzeugung, von ihrer Anschauung der Welt, dass es gleichsam in ihre Stimme überströmte und ihr ganzes Wesen durchdrang.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "45d2a2e7-bb70-4af7-a881-0fd38c00e2b5",
                        "source_entry_id": "384554cc-e7db-31d8-8e89-5ccc2f075292",
                        "target_lang_word": "orator",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "orator",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4d2a0355-99c5-36f9-ab78-5782f89aed13",
                                        "entry_id": "cbf6856d-2d66-3acd-9f2d-ef3608b70024",
                                        "glosses": [
                                            "Someone who orates or delivers an oration."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a0e49b65-8402-34d1-95ae-938e60ecb81a",
                                        "entry_id": "cbf6856d-2d66-3acd-9f2d-ef3608b70024",
                                        "glosses": [
                                            "A skilled and eloquent public speaker."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ec90e0a-f75c-44af-b96b-1cdf210f6a38",
                                                "sense_id": "a0e49b65-8402-34d1-95ae-938e60ecb81a",
                                                "text": "Tam[burlaine]. Then ſhall we fight couragiouſlye with them?\nOr looke you, I ſhould play the Orator?\nTech[elles]. No: cowards and faint-hearted runawaies,\nLooke for orations when the foe is neere.\nOur ſwordes shall play the Orators for vs."
                                            },
                                            {
                                                "example_id": "b3b49544-fbd3-4ca3-96c8-d0b3d3203f3c",
                                                "sense_id": "a0e49b65-8402-34d1-95ae-938e60ecb81a",
                                                "text": "[…] when it becomes obvious that I have not the slightest skill as a speaker – unless, of course, by skilful speaker they mean one who speaks the truth. If that is what they mean, I would agree that I am an orator, though not after their pattern."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b852169d-9f1c-3ecd-8d4e-6e9e76a07422",
                                        "entry_id": "cbf6856d-2d66-3acd-9f2d-ef3608b70024",
                                        "glosses": [
                                            "Someone sent to speak for someone else; an envoy, a messenger."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "51d2a415-a492-3523-b2c4-7528964b082e",
                                        "entry_id": "cbf6856d-2d66-3acd-9f2d-ef3608b70024",
                                        "glosses": [
                                            "A petitioner, a supplicant."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "42666fc7-f883-4e4c-8884-7985bffe2e60",
                        "source_entry_id": "384554cc-e7db-31d8-8e89-5ccc2f075292",
                        "target_lang_word": "speaker",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "speaker",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0e475abc-2d54-3376-8f0f-51cad5df5937",
                                        "entry_id": "09f39362-80e0-3b32-bf38-17dceb2dbd3d",
                                        "glosses": [
                                            "One who speaks."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e2d9f0e-d9ec-47fc-aea7-5db654326f8d",
                                                "sense_id": "0e475abc-2d54-3376-8f0f-51cad5df5937",
                                                "text": "There were three different speakers, but I couldn't make out their accents."
                                            },
                                            {
                                                "example_id": "f5692ef3-a75f-4548-9ded-49575cfb9fb0",
                                                "sense_id": "0e475abc-2d54-3376-8f0f-51cad5df5937",
                                                "text": "This title is derived from the first verse of the book (1.1), which is a heading or colophon informing the reader who this Qoheleth was: he was the author of the book, or at least the speaker of the words which are contained in it ..."
                                            },
                                            {
                                                "example_id": "9fe402ea-2cfa-4ddc-8ff7-32b4cd38a3f3",
                                                "sense_id": "0e475abc-2d54-3376-8f0f-51cad5df5937",
                                                "text": "As [David] Bellos points out, those born as English speakers are now a minority of English speakers: most speak it as a second language. English is the world’s biggest interlanguage."
                                            },
                                            {
                                                "example_id": "4534b1aa-9fcf-4665-8369-11d481d0d803",
                                                "sense_id": "0e475abc-2d54-3376-8f0f-51cad5df5937",
                                                "text": "Each written word when spoken is mutually incomprehensible between a Mandarin speaker in Beijing and a Cantonese speaker in Hong Kong. If you think that’s odd, consider our number system: the symbol “9” is universally recognized but it’s pronounced “nine” in English and “devet” in Slovenian."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3d846129-1116-3bfe-af70-4be9bdccea18",
                                        "entry_id": "09f39362-80e0-3b32-bf38-17dceb2dbd3d",
                                        "glosses": [
                                            "Loudspeaker."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8fc469b6-5c94-4693-a1fe-dda3a6fb6c99",
                                                "sense_id": "3d846129-1116-3bfe-af70-4be9bdccea18",
                                                "text": "She lost her hearing after standing too close to the speaker at the festival."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "479d9d94-0dcf-3f7f-87dd-6b89127e2575",
                                        "entry_id": "09f39362-80e0-3b32-bf38-17dceb2dbd3d",
                                        "glosses": [
                                            "Speakerphone."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d2d89a3-200f-4523-9ee5-c3c6a625c00f",
                                                "sense_id": "479d9d94-0dcf-3f7f-87dd-6b89127e2575",
                                                "text": "you're on speaker"
                                            },
                                            {
                                                "example_id": "b806f216-ade0-4d79-9cd9-eda68c7ba621",
                                                "sense_id": "479d9d94-0dcf-3f7f-87dd-6b89127e2575",
                                                "text": "I'm gonna put you on speaker now"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "43531dd1-0ac0-3955-a88f-628d5913f00b",
                                        "entry_id": "09f39362-80e0-3b32-bf38-17dceb2dbd3d",
                                        "glosses": [
                                            "The chair or presiding officer of certain legislative bodies, such as the U.K. House of Commons or the U.S. House of Representatives."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "33998d6f-9369-36be-9c3b-a584a13c7c13",
                                        "entry_id": "09f39362-80e0-3b32-bf38-17dceb2dbd3d",
                                        "glosses": [
                                            "One who makes a speech to an audience."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c06ae97-eb80-4cf9-ad73-b681533dd53c",
                                                "sense_id": "33998d6f-9369-36be-9c3b-a584a13c7c13",
                                                "text": "Near-synonyms: orator, presenter, announcer"
                                            },
                                            {
                                                "example_id": "4ba59a91-8120-433d-b72d-1b5dc2acaeef",
                                                "sense_id": "33998d6f-9369-36be-9c3b-a584a13c7c13",
                                                "text": "hired speaker;   motivational speaker"
                                            },
                                            {
                                                "example_id": "75c53a82-6ced-44d6-9456-43404ce338be",
                                                "sense_id": "33998d6f-9369-36be-9c3b-a584a13c7c13",
                                                "text": "The company hired a motivational speaker to boost morale."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "adab38ed-fa7e-3de2-a246-6a7e80b73dae",
                                        "entry_id": "09f39362-80e0-3b32-bf38-17dceb2dbd3d",
                                        "glosses": [
                                            "A book containing passages of text for use in speeches."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "71aa6ade-020c-3134-b984-5eeac813234b",
                                        "entry_id": "09f39362-80e0-3b32-bf38-17dceb2dbd3d",
                                        "glosses": [
                                            "The producer of a given utterance, whether speech or text."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5ec4966f-37ed-41bc-b1c7-0a7aa513382e",
                                                "sense_id": "71aa6ade-020c-3134-b984-5eeac813234b",
                                                "text": "The speaker spelled out the words to be communicated, letter by letter, while the reader's hand read the speaker's message. In its original form the hand alphabet assumed that both speaker and reader could already speak and spell the words ..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6595afce-46a5-36fe-a723-624b92c0c78b",
                                        "entry_id": "09f39362-80e0-3b32-bf38-17dceb2dbd3d",
                                        "glosses": [
                                            "The producer of a given utterance, whether speech or text.",
                                            "The literary character uttering the lyrics of a poem or song, as opposed to the author writing the words of that character."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "935a2544-b1bb-4b2a-bfef-6619022a514b",
                                                "sense_id": "6595afce-46a5-36fe-a723-624b92c0c78b",
                                                "text": "Popular culture often incorrectly attributes quotes from the speakers of poems or songs to the authors thereof, as when \"I took the one less traveled by\" is attributed to Robert Frost rather than to the speaker in Frost's \"The Road Not Taken\"."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "89fffa2e-c0c8-39ef-a9c6-8d9d9e61080e",
                                        "entry_id": "09f39362-80e0-3b32-bf38-17dceb2dbd3d",
                                        "glosses": [
                                            "A key on a woodwind instrument of the clarinet family (compare octave key on other instruments) which induces the instrument to overblow."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dc646c44-65a9-3e7c-a486-fb0b62f32ee4",
                                        "entry_id": "09f39362-80e0-3b32-bf38-17dceb2dbd3d",
                                        "glosses": [
                                            "A wooden pole or spike used by hedgers to carry loads on their shoulders. Possibly Dorset dialect."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2b220d34-8813-4c24-85d3-abe1e5afc029",
                                                "sense_id": "dc646c44-65a9-3e7c-a486-fb0b62f32ee4",
                                                "text": "With a speäker, or stake, he tossed the outlying scraps of fuel on the into the conflagration."
                                            }
                                        ]
                                    }
                                ]
                            }
