                                        "entry_id": "4ac25dd2-d9d7-3c47-bed9-f92702170366",
                                        "glosses": [
                                            "A tableau curtain."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
