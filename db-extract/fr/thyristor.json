                                        "entry_id": "2f1d5748-bb3c-3e29-b153-c0321a7eb548",
                                        "glosses": [
                                            "elektronisches einschaltbares Halbleiterbauelement, das durch einen kleinen Gatestrom eingeschaltet wird und so bleibt, bis eine Umkehrung der Stromrichtung eintritt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c7152b4-9acb-4fe1-a189-6b8b605903cd",
                                                "sense_id": "352c1231-f138-38a8-a429-c18133c6aa84",
                                                "text": "Thyristoren werden heute oft durch andere Bauelemente wie Triacs ersetzt."
                                            }
