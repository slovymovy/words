                                        "entry_id": "873c6965-a0b6-39bb-956b-e98a96b27c9e",
                                        "glosses": [
                                            "A lamp that burns a volatile liquid fuel such as alcohol, ethanol or denatured alcohol."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52e3644d-d840-4488-ae98-204e13356608",
                                                "sense_id": "982201bd-0a71-3f3b-aed2-a37d5d42c4b9",
                                                "text": "By way of armoury and utensils, I took a revolver, a little spirit-lamp and pan, a lantern and some halfpenny candles, a jack-knife and a large leather flask."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "66f84df8-7485-4334-abda-89c62e4341e2",
                        "source_entry_id": "a8d815d6-c7a8-33c0-8dbc-c507f3c354cf",
                        "source_sense_id": "ed7b2587-9abb-3b33-89a8-baac3159b257",
                        "target_lang_word": "Spirituskocher",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Spirituskocher",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b6d529ef-d532-3c8d-bd1c-f07f3ba43a42",
                                        "entry_id": "215e718d-3e3c-3049-bb03-8799b8617c7b",
                                        "glosses": [
                                            "mit Spiritus betriebenes Kochgerät"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0e7fed5-aa6a-4a15-8a81-03638b190b27",
                                                "sense_id": "b6d529ef-d532-3c8d-bd1c-f07f3ba43a42",
                                                "text": "„Unter dem Cézanne stand ein Spirituskocher auf dem Tisch.“"
                                            },
                                            {
                                                "example_id": "435336b2-7b16-42f6-bbee-0ee6b0defe9f",
                                                "sense_id": "b6d529ef-d532-3c8d-bd1c-f07f3ba43a42",
                                                "text": "„In der Mitte stand ein Tisch, darauf ein Spirituskocher, auf dem sie Würstchen heißmachte.“"
                                            },
                                            {
                                                "example_id": "ed7ea535-a141-443e-9284-743ed95e4fe3",
                                                "sense_id": "b6d529ef-d532-3c8d-bd1c-f07f3ba43a42",
                                                "text": "„Thomas setzte den Tiegel auf den Spirituskocher und blieb heiter.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
