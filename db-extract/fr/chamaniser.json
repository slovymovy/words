                "senses": [
                    {
                        "sense_id": "9995e63d-1885-3913-81f3-2ecbb1e8844b",
                        "entry_id": "cd4ba8b1-7598-358b-9936-3faae265d7b5",
                        "glosses": [
                            "Se livrer à des pratiques chamaniques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "22c1b4ed-e797-410f-bcb0-2b760f531adb",
                                "sense_id": "9995e63d-1885-3913-81f3-2ecbb1e8844b",
                                "text": "C’est elle qui séduit aujourd’hui les passionnés de néochamanisme, qui veulent à leur tour « chamaniser »."
                            },
                            {
                                "example_id": "0aa7a0bf-57d7-4617-8081-a5a3a4ee59e6",
                                "sense_id": "9995e63d-1885-3913-81f3-2ecbb1e8844b",
                                "text": "J’avais déjà entendu parler de ce cas, mais aucun Toungouse n’avait pu m’expliquer si ces deux chamanes pouvaient chamaniser en même temps en des lieux différents ni si l’un savait quand l’autre chamanisait."
                            }
                        ]
                    }
