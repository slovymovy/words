                    "sense_id": "52cc93f8-8af4-30f2-90ee-22e68d24ca81",
                    "sense_definition": "Feeling or showing great surprise or wonder.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She was <w>astonished</w> at how quickly he solved the puzzle.",
                            "target_lang_translations": {
                                "ru": "Она была <w>изумлена</w> тем, как быстро он решил головоломку.",
                                "nl": "Ze was <w>verbaasd</w> over hoe snel hij de puzzel oploste.",
                                "pl": "Była <w>zdumiona</w> tym, jak szybko rozwiązał tę zagadkę.",
                                "de": "Sie war <w>erstaunt</w> darüber, wie schnell er das Rätsel gelöst hat.",
                                "fr": "Elle a été <w>étonnée</w> de la rapidité avec laquelle il a résolu le puzzle.",
                                "it": "Era <w>sbalordita</w> da quanto velocemente avesse risolto il puzzle.",
                                "cs": "Byla <w>ohromena</w> tím, jak rychle tu hádanku vyřešil.",
                                "tr": "Bulmacayı ne kadar çabuk çözdüğüne <w>şaşırmıştı</w>.",
                                "es": "Ella estaba <w>asombrada</w> de lo rápido que él resolvió el rompecabezas."
                            }
                        },
                        {
                            "text": "He looked <w>astonished</w> when they told him the news.",
                            "target_lang_translations": {
                                "ru": "Он выглядел <w>изумлённым</w>, когда они сообщили ему эту новость.",
                                "nl": "Hij keek <w>verbaasd</w> toen ze hem het nieuws vertelden.",
                                "pl": "Wyglądał na <w>zaskoczonego</w>, kiedy przekazali mu te wieści.",
                                "de": "Er sah <w>verblüfft</w> aus, als sie ihm die Neuigkeit erzählten.",
                                "fr": "Il avait l'air <w>abasourdi</w> quand ils lui ont annoncé la nouvelle.",
                                "it": "Sembrava <w>stupefatto</w> quando gli hanno dato la notizia.",
                                "cs": "Vypadal <w>užasle</w>, když mu tu zprávu oznámili.",
                                "tr": "Ona haberi verdiklerinde <w>şaşkın</w> görünüyordu.",
                                "es": "Él parecía <w>asombrado</w> cuando le dieron la noticia."
                            }
