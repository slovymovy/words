                        "source_entry_id": "0511b072-5646-3613-aca3-f0081c6c3254",
                        "source_sense_description": "(chiefly Britain) a group of sporting activities including track and field, road running, cross country, and racewalking",
                        "target_lang_word": "athlétisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
