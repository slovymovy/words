                "senses": [
                    {
                        "sense_id": "1b0252ef-d934-30cc-9505-688ca5977326",
                        "entry_id": "4914ba46-757b-3efb-8f6a-2f71191d1a21",
                        "glosses": [
                            "Any instrument for viewing objects in the dark or in a faint light."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "81711bab-6345-4507-9c16-2970a732d1bd",
                                "sense_id": "1b0252ef-d934-30cc-9505-688ca5977326",
                                "text": "August 13th 1664, Samuel Pepys, Diary (London: Marshall Cavendish, 1988), 133.\n“Comes Mr. Reeve, with a microscope and scotoscope. […] The other [the scotoscope] he gives me, and is of value; and a curious curiosity it is to discover objects in a dark room with.”"
                            },
                            {
                                "example_id": "284c876f-11fb-4cd4-a51a-1cd307bf14dd",
                                "sense_id": "1b0252ef-d934-30cc-9505-688ca5977326",
                                "text": "At present the scotoscope's field of view and viewing-range requirements are in conflict, and improvement of one results in a decreased capability in the other."
                            },
                            {
                                "example_id": "ee3fcd9f-9778-4eaa-abea-8b5998f51008",
                                "sense_id": "1b0252ef-d934-30cc-9505-688ca5977326",
                                "text": "A scotoscope (night vision device) was the most versatile viewer examined and provided maximum viewing distance for all markers."
                            },
                            {
                                "example_id": "3c315b36-840d-4692-9729-c73ac6fe6e9a",
                                "sense_id": "1b0252ef-d934-30cc-9505-688ca5977326",
                                "text": "However, where the angular field can be below 40°, a scotoscope with a refractive objective becomes a very useful device even with this small cathode diameter."
                            }
                        ]
                    }
                ],
