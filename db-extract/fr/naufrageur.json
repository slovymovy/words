                                    {
                                        "sense_id": "7dcaf899-69c0-38c9-a4a2-62d6fafce2ba",
                                        "entry_id": "5a7d9dc9-9e2c-3d67-a440-3eec309747b4",
                                        "glosses": [
                                            "One who causes a shipwreck."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b27a4341-00e0-49ef-b101-dccfa3b05e8b",
                                                "sense_id": "7dcaf899-69c0-38c9-a4a2-62d6fafce2ba",
                                                "text": "“I've gathered you all here in the accusing parlor because one of you is a miniature shipwrecker.”"
