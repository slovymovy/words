                        "cross_references": [
                            {
                                "target_word": "Кавказ",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "e546fd1a-7e6c-37d7-9d31-b5c261a3796d",
                                        "entry_id": "faada2be-21b7-3c9d-9dac-dde762f117f3",
                                        "glosses": [
                                            "геогр. регион, расположенный к югу от Восточно-Европейской равнины на границе Европы и Азии, преимущественно горная страна между Чёрным, Азовским и Каспийским морями"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47270763-b8ff-4e3c-a6ee-2c090becab54",
                                                "sense_id": "e546fd1a-7e6c-37d7-9d31-b5c261a3796d",
                                                "text": "Главный Кавказский хребет принято делить на Центральный Кавказ ― от Казбека до Эльбруса, Восточный ― к востоку от Казбека и Западный ― к западу от Эльбруса."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c39889bd-6643-391d-979a-8509b93d8e8b",
                                        "entry_id": "faada2be-21b7-3c9d-9dac-dde762f117f3",
                                        "glosses": [
                                            "полит. историко-географический и экономический регион на границе Европы и Азии, на территории Кавказа [1]"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e62dd3d7-d011-4e52-8f58-de73613cd345",
                                                "sense_id": "c39889bd-6643-391d-979a-8509b93d8e8b",
                                                "text": "Вскоре перевели меня на Кавказ: это самое счастливое время моей жизни."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "833c10b2-66b5-350d-9286-416c416895d9",
                                        "entry_id": "faada2be-21b7-3c9d-9dac-dde762f117f3",
                                        "glosses": [
                                            "село в России"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
