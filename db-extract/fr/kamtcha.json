                "senses": [
                    {
                        "sense_id": "dbb03ae1-0cfd-3e2e-a196-42d90c88ca7b",
                        "entry_id": "f488137f-8174-3914-8b0d-9c77b6a13b19",
                        "glosses": [
                            "Fouet court, utilisé par les cavaliers d’Asie centrale, dont les Cosaques ; cravache."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad2f07e2-62d1-48d6-8e13-1f0ffed61793",
                                "sense_id": "dbb03ae1-0cfd-3e2e-a196-42d90c88ca7b",
                                "text": "S’abandonnant à sa mélancolie, la mère, semblait-il, avait consenti aux propositions du brigadier et lui, content d’avoir atteint son but, fouetta le cheval de sa kamtcha et sortit de la cour d’un amble rapide."
                            },
                            {
                                "example_id": "9869be10-788e-4e52-a0cc-128c88edb45f",
                                "sense_id": "dbb03ae1-0cfd-3e2e-a196-42d90c88ca7b",
                                "text": "En tête part le grand chameau barbu …. Il marche bien et rarement on lui fait sentir le kamtcha."
                            }
                        ]
                    }
                ],
