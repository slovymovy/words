                "translations": [
                    {
                        "translation_id": "75230049-5946-435f-b1fc-07ae04d27007",
                        "source_entry_id": "1ec513af-0b9c-3987-9991-76d3b78316c4",
                        "source_sense_id": "99de0330-648e-32b4-916d-d8728d1e49d5",
                        "target_lang_word": "doctoranda",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "75600bf4-ae7a-4e1a-9569-fcadbda44d63",
                        "source_entry_id": "1ec513af-0b9c-3987-9991-76d3b78316c4",
                        "source_sense_id": "99de0330-648e-32b4-916d-d8728d1e49d5",
                        "target_lang_word": "Doktorandin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Doktorandin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0821081d-0f4e-3ced-bd29-f606b9bef63b",
                                        "entry_id": "3a357f0a-79e4-3a41-9839-22dbff5df086",
                                        "glosses": [
                                            "Studentin, die die Doktorwürde anstrebt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "183b0553-d280-41c5-afd3-59d98a5b30df",
                                                "sense_id": "0821081d-0f4e-3ced-bd29-f606b9bef63b",
                                                "text": "Die Doktorandin steht kurz vor der Doktorprüfung."
                                            },
                                            {
                                                "example_id": "4670bf64-cfd5-447a-81b7-85a6aaedb08a",
                                                "sense_id": "0821081d-0f4e-3ced-bd29-f606b9bef63b",
                                                "text": "„Die zuständige Fakultät der Universität Düsseldorf hat das Verfahren zur Aberkennung des Doktortitels einer früheren Doktorandin eingeleitet.“"
                                            },
                                            {
                                                "example_id": "28ecaaf8-9c81-4e50-b902-4f09216d3ff9",
                                                "sense_id": "0821081d-0f4e-3ced-bd29-f606b9bef63b",
                                                "text": "„Die Anspannung, beinah ein Misstrauen gegenüber der Doktorandin, stand spürbar im Raum, erst bei der Schilderung meiner Herkunft schienen sich die Mienen der Anwesenden zu lockern.“"
                                            },
                                            {
                                                "example_id": "a4a72a54-ea2b-4252-82e7-12b39c34ea1f",
                                                "sense_id": "0821081d-0f4e-3ced-bd29-f606b9bef63b",
                                                "text": "„Einer festen Freundin am nächsten kam in jenem Jahr eine sprunghafte Doktorandin namens Pat McEnerney, die kurz zuvor das Ballett aufgegeben und beschlossen hatte, Lehrerin zu werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
