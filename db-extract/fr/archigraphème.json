                        "entry_id": "944b4d9e-0580-38de-a438-be09029cf07b",
                        "glosses": [
                            "Phonogramme principal, représentant un phonème, pouvant être retranscrit avec des variantes positionnelles selon les règles et conventions orthographiques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae3185b1-d994-4105-8354-2f817fc83694",
                                "sense_id": "40212957-8510-3e5a-9c7f-52182155bcc6",
                                "text": "Dans le plurisystème, l’archigraphème est le représentant d’un ensemble de graphèmes qui transcrivent le même phonème, par exemple l’archigraphème O pour o, au, eau, etc. ou CH pour ch (de psychique), sch (de schéma), sh (de shampooing), traduction de l’anglais shampoo!)."
                            }
                        ]
                    },
                    {
                        "sense_id": "45a81bd4-b1cb-3fa6-abe6-ceffc370a2af",
                        "entry_id": "944b4d9e-0580-38de-a438-be09029cf07b",
                        "glosses": [
                            "Unité graphique de base partagée par certains graphèmes sans les éléments permettant de les différentier."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ef11792-448d-4bdc-a687-0c813034aaf5",
                                "sense_id": "45a81bd4-b1cb-3fa6-abe6-ceffc370a2af",
                                "text": "L’épaisseur maximale du trait peut être mesurée sur la partie nord-est du dad* (alternativement on peut employer les archigraphèmes sad* ou taʼ*), entre les points extérieur et intérieur de curvature maximale."
                            }
                        ]
                    }
