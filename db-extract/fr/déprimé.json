                                "target_senses": [
                                    {
                                        "sense_id": "a2861b9a-80b4-3989-8f99-1e6a69416af7",
                                        "entry_id": "c00ac8c6-46d0-30ee-a150-442439f03d96",
                                        "glosses": [
                                            "Unhappy; despondent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47243426-ac59-4e3a-90d3-6eff7e6a50f7",
                                                "sense_id": "a2861b9a-80b4-3989-8f99-1e6a69416af7",
                                                "text": "The mother, Ekaterina Pavlovna, who at one time had been handsome, but now, asthmatic, depressed, vague, and over-feeble for her years, tried to entertain me with conversation about painting. Having heard from her daughter that I might come to Shelkovka, she had hurriedly recalled two or three of my landscapes which she had seen in exhibitions in Moscow, and now asked what I meant to express by them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4568d43f-4b50-33ae-ba7b-6e6a4560640c",
                                        "entry_id": "c00ac8c6-46d0-30ee-a150-442439f03d96",
                                        "glosses": [
                                            "Unhappy; despondent.",
                                            "Suffering from clinical depression."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "490a9c6e-83d2-338f-aaf2-eebc76097d21",
                                        "entry_id": "c00ac8c6-46d0-30ee-a150-442439f03d96",
                                        "glosses": [
                                            "Suffering damaging effects of economic recession."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "debac05d-7713-4fd3-8162-72924c02da7e",
                                                "sense_id": "490a9c6e-83d2-338f-aaf2-eebc76097d21",
                                                "text": "Born in 1980 to hard-working impoverished parents in Newport News, Virginia, Michael Vick grew up in the Ridley public housing project during the Reagan years when funding for such projects was being largely withdrawn. The eastern part of Newport News where Vick grew up became so depressed that it was called 'Bad Newz'."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4a671e1d-3da0-3425-bdac-4f57a6f352fd",
                                        "entry_id": "c00ac8c6-46d0-30ee-a150-442439f03d96",
                                        "glosses": [
                                            "Reduced to a lower degree or form."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "40793d43-50bc-4598-97c7-31b0724f615a",
                                                "sense_id": "4a671e1d-3da0-3425-bdac-4f57a6f352fd",
                                                "text": "The cubic function x³ + cx + d = 0, where one of the terms has a coefficient of zero, is a depressed cubic."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "52267739-dca0-45c6-aedb-68aa387bb64a",
                        "source_entry_id": "48d15424-04e9-3343-afe9-799fa58a4a9a",
