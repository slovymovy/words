                        "sense_id": "6f273fff-4f55-3874-b328-89714c8f61f1",
                        "entry_id": "bea22b0c-c3ba-39c3-93b9-1cb335624b04",
                        "glosses": [
                            "een weg die dwars op één of meerdere wegen staat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "39431ebc-2225-46d4-b706-97288eacc142",
                                "sense_id": "6f273fff-4f55-3874-b328-89714c8f61f1",
                                "text": "Het pompstation aan de Mijdrechtse Dwarsweg werd na de ontdekking van de fout gesloten. In de loop van de ochtend kon er weer getankt worden."
                            },
                            {
                                "example_id": "c8b392bb-43ae-479a-81a7-60c8cb777760",
                                "sense_id": "6f273fff-4f55-3874-b328-89714c8f61f1",
                                "text": "Verder betekent het dat de N35 de Baron van Sternbachlaan, de Westerveenweg, Vossenbosweg en Stegeboersweg ongelijkvloers zal kruisen. De N35 gaat over deze wegen heen. De huidige oversteek bij de Dwarsweg wordt opgeheven. Er komt ook een ecoduct over de nieuwe weg en het spoor tussen het Notterveld"
                            }
                        ]
                    }
