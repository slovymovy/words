                        "cross_references": [
                            {
                                "target_word": "Selbststudium",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "92c7e009-9de7-3df4-847d-c5bf2796691c",
                                        "entry_id": "31b0ed54-ae3b-3459-93aa-91abce29ff46",
                                        "glosses": [
                                            "Betreiben eines Studiums ohne ständige Anwesenheit in einer Hochschule"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e91426df-a85b-4d06-a231-9b64e5d347e5",
                                                "sense_id": "92c7e009-9de7-3df4-847d-c5bf2796691c",
                                                "text": "„Studierende im Selbststudium zu begleiten heißt, einen Rahmen zu schaffen, in dem sie selbständig und eigenverantwortlich an Themen und Fragen arbeiten können.“"
                                            },
                                            {
                                                "example_id": "cd926cfe-fb89-4d85-b1a9-1910f8bdc52a",
                                                "sense_id": "92c7e009-9de7-3df4-847d-c5bf2796691c",
                                                "text": "„Er, der nach der Kulturrevolution einst als Minenarbeiter sein Leben verdienen musste und später einen Bürojob zugewiesen bekam, hatte sich im Selbststudium kundig gemacht über juristische Fragen.“"
                                            },
                                            {
                                                "example_id": "9d6d1e6f-d687-4ec8-85a9-ec130ef4235a",
                                                "sense_id": "92c7e009-9de7-3df4-847d-c5bf2796691c",
                                                "text": "„Zum Selbststudium gehört auch das eigenverantwortliche Arbeiten mit Lehr- und Fachbüchern.“"
                                            },
                                            {
                                                "example_id": "4389cc96-fbb1-43f6-bda6-6c0558bd0481",
                                                "sense_id": "92c7e009-9de7-3df4-847d-c5bf2796691c",
                                                "text": "„Lumumba hat sich alles im Selbststudium angeeignet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
