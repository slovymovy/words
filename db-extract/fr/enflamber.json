                "senses": [
                    {
                        "sense_id": "2978ff76-eba3-3692-a758-8db1639c3359",
                        "entry_id": "9fe23b1e-d11c-3964-93bf-7c42e6ac65fa",
                        "glosses": [
                            "Enflammer."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "ebd30171-9069-40a2-9fe2-5c3855dcf67d",
                                "sense_id": "2978ff76-eba3-3692-a758-8db1639c3359",
                                "text": "Lesquels étoient vêtus parmi le corps de vêtements de toile, couverts et semés de fin lin, chanvre et étouppes, étoffés de souffre, poix et autres choses de léger inflammables, aisées à enflamber, et malaisées à éteindre, et venir danser en tel état par manière de jeux et ébattements."
                            },
                            {
                                "example_id": "41f5ea48-64c2-4771-857c-2615d927580e",
                                "sense_id": "2978ff76-eba3-3692-a758-8db1639c3359",
                                "text": "Et comme M. Calvin remontrait au dit Jean Blanc sa malice, et qu’au lieu de mettre en tort de jeunes pendards qui ne demandent que mal, il enflambait tous les autres par ses paroles, le dit Jean a répondu que non, mais que ce fut M. Cop qui commença."
                            }
                        ]
                    }
