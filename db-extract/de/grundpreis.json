                "senses": [
                    {
                        "sense_id": "7c9a6b9a-01ee-3d93-b7ba-8662a06a1537",
                        "entry_id": "d0af5b4a-2a66-37f8-9435-f91e104c93ac",
                        "glosses": [
                            "Preis von etwas (Preis pro Mengeneinheit), zu dem noch bestimmte Aufschläge hinzukommen können"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be539b36-f501-4da2-82fc-f5c7d0e616b6",
                                "sense_id": "7c9a6b9a-01ee-3d93-b7ba-8662a06a1537",
                                "text": "Die Grundpreisangabe ist in § 2 Preisangabenverordnung (PAngV) geregelt. Eine \"Grundpreisverordnung\", wie bei Wikipedia erwähnt, gibt es nicht.",
                                "translation": "„Ein Grundpreis ist gemäß § 9 Abs. 4 Nr. 1 PangV nicht notwendig bei Waren mit einem Nenngewicht oder Nennvolumen von weniger als 10 g oder ml.“"
                            },
                            {
                                "example_id": "e44a37bc-a6fd-46a2-a59f-d5da4352a5a3",
                                "sense_id": "7c9a6b9a-01ee-3d93-b7ba-8662a06a1537",
                                "text": "„Der Wärmepreis setzt sich aus dem Grundpreis (GP = verbrauchsunabhängiges Entgelt abhängig von der zur Verfügung zu stellenden maximalen Wärmeleistung) und dem Arbeitspreis (AP = verbrauchsabhängiges Entgelt abhängig von der gelieferten Wärmemenge) zusammen.“"
                            },
                            {
                                "example_id": "78448101-1e52-465e-8944-63279efa17ff",
                                "sense_id": "7c9a6b9a-01ee-3d93-b7ba-8662a06a1537",
                                "text": "„Die Grundpreise der Stromtarife werden von den EVU mit diversen Fixkosten (verbrauchsunabhängigen Kosten) gerechtfertigt: mit Kosten für die Lieferbereitschaft, die Messeinrichtung (Stromzähler), die Zählerablesung sowie administrative Aufwendungen (Kundenverwaltung, Rechnungsstellung, Inkasso).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
