{
    "word_family": [
        "riveter",
        "riveting"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "77418656-62ce-387b-8a3f-6c33ed1a1ff0",
                    "sense_definition": "To completely engross or command the attention of someone.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "attention",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The speaker's powerful voice managed to <w>rivet</w> the attention of the entire audience.",
                            "target_lang_translations": {
                                "ru": "Мощному голосу оратора удалось <w>приковать</w> внимание всей аудитории."
                            }
                        },
                        {
                            "text": "She was so <w>riveted</w> by the suspenseful movie that she did not hear her phone ring.",
                            "target_lang_translations": {
                                "ru": "Она была настолько <w>поглощена</w> остросюжетным фильмом, что не услышала звонка своего телефона."
                            }
                        }
                    ],
                    "synonyms": [
                        "engross",
                        "fascinate",
                        "captivate",
                        "enthrall"
                    ],
                    "antonyms": [
                        "bore"
                    ],
                    "common_phrases": [
                        "rivet the attention"
                    ],
                    "target_lang_definitions": {
                        "ru": "Полностью поглощать или приковывать чье-либо внимание."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "приковывать",
                                "target_lang_sense_clarification": "о внимании, взгляде"
                            },
                            {
                                "target_lang_word": "захватывать",
                                "target_lang_sense_clarification": "о внимании, интересе"
                            },
                            {
                                "target_lang_word": "поглощать",
                                "target_lang_sense_clarification": "полностью занимать внимание"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4e4317d9-654c-3015-9e96-889d1005aaac",
                    "sense_definition": "To make firm or immovable, especially of a person's position or gaze due to strong emotion.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "immovable",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sudden terror <w>riveted</w> him to the spot, making it impossible to run away.",
                            "target_lang_translations": {
                                "ru": "Внезапный ужас <w>пригвоздил</w> его к месту, лишив возможности бежать."
                            }
                        },
                        {
                            "text": "She stood with her eyes <w>riveted</w> on the horizon, waiting for any sign of the ship.",
                            "target_lang_translations": {
                                "ru": "Она стояла, <w>приковав</w> взгляд к горизонту в ожидании любого знака от корабля."
                            }
                        }
                    ],
                    "synonyms": [
                        "fix",
                        "root",
                        "paralyze"
                    ],
                    "common_phrases": [
                        "riveted to the spot"
                    ],
                    "target_lang_definitions": {
                        "ru": "Делать неподвижным, заставлять замереть на месте (особенно о человеке или взгляде из-за сильных эмоций)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "приковывать",
                                "target_lang_sense_clarification": "к месту или взглядом"
                            },
                            {
                                "target_lang_word": "парализовать",
                                "target_lang_sense_clarification": "от страха или удивления"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9cd035fe-c59e-3ea4-bd57-2891aa94444e",
                    "sense_definition": "To attach or fasten parts together by using metal pins or rivets.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "fasten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The workers had to <w>rivet</w> the steel plates together to construct the ship's hull.",
                            "target_lang_translations": {
                                "ru": "Рабочим пришлось <w>склепать</w> стальные листы вместе, чтобы построить корпус корабля."
                            }
                        },
                        {
                            "text": "They will <w>rivet</w> the metal sheets securely to ensure the structure can withstand high winds.",
                            "target_lang_translations": {
                                "ru": "Они надежно <w>заклепают</w> металлические листы, чтобы конструкция могла выдержать сильный ветер."
                            }
                        }
                    ],
                    "synonyms": [
                        "fasten",
                        "secure",
                        "bolt"
                    ],
                    "common_phrases": [
                        "rivet steel plates"
                    ],
                    "target_lang_definitions": {
                        "ru": "Соединять или скреплять детали вместе с помощью металлических штифтов или заклепок."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "клепать",
                                "target_lang_sense_clarification": "скреплять заклепками"
                            },
                            {
                                "target_lang_word": "заклепывать",
                                "target_lang_sense_clarification": "соединять металлические детали"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6452cd1e-7199-35ab-a8ba-24e67206cb7e",
                    "sense_definition": "To install rivets.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "fasten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He spent the afternoon learning how to <w>rivet</w> properly during his metalworking class.",
                            "target_lang_translations": {
                                "ru": "Вторую половину дня он провел, обучаясь тому, как правильно <w>клепать</w> на уроке по металлообработке."
                            }
                        },
                        {
                            "text": "The automated machine can <w>rivet</w> at a much faster rate than any human operator.",
                            "target_lang_translations": {
                                "ru": "Автоматический станок может <w>выполнять клепку</w> гораздо быстрее, чем любой человек-оператор."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Устанавливать заклепки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "клепать",
                                "target_lang_sense_clarification": "выполнять клепку"
                            },
                            {
                                "target_lang_word": "производить клепку",
                                "target_lang_sense_clarification": "процесс установки заклепок"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c571c01f-f71e-380b-8c1e-154368de606c",
                    "sense_definition": "A cylindrical mechanical fastener that attaches multiple parts together by fitting through a hole and deforming the head at either end.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fastener",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The engineer inspected each steel <w>rivet</w> on the bridge to ensure structural integrity.",
                            "target_lang_translations": {
                                "ru": "Инженер осмотрел каждую стальную <w>заклепку</w> на мосту, чтобы убедиться в прочности конструкции."
                            }
                        },
                        {
                            "text": "A loose <w>rivet</w> in the aircraft wing was quickly replaced by the maintenance crew.",
                            "target_lang_translations": {
                                "ru": "Ослабленная <w>заклепка</w> в крыле самолета была быстро заменена ремонтной бригадой."
                            }
                        }
                    ],
                    "synonyms": [
                        "fastener",
                        "pin"
                    ],
                    "common_phrases": [
                        "steel rivet",
                        "loose rivet"
                    ],
                    "target_lang_definitions": {
                        "ru": "Цилиндрический механический крепеж, который соединяет несколько деталей, вставляясь в отверстие и деформируясь на концах."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заклепка",
                                "target_lang_sense_clarification": "металлический крепежный элемент"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "21716a96-a823-3c1c-8711-327e69270471",
                    "sense_definition": "Any fixed point or certain basis.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "immovable",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His unwavering faith served as a <w>rivet</w> for his moral decisions throughout his life.",
                            "target_lang_translations": {
                                "ru": "Его непоколебимая вера служила <w>опорой</w> для его нравственных решений на протяжении всей жизни."
                            }
                        },
                        {
                            "text": "We need a solid <w>rivet</w> of truth before we can build a reliable theory.",
                            "target_lang_translations": {
                                "ru": "Нам нужен прочный <w>фундамент</w> истины, прежде чем мы сможем построить надежную теорию."
                            }
                        }
                    ],
                    "synonyms": [
                        "anchor",
                        "foundation",
                        "basis"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used figuratively to mean a firm basis"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Любая фиксированная точка или надежная основа."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "опора",
                                "target_lang_sense_clarification": "надежная основа, фундамент"
                            },
                            {
                                "target_lang_word": "оплот",
                                "target_lang_sense_clarification": "прочная основа чего-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "52177931-6daf-358a-a014-ead8e8fe667a",
                    "sense_definition": "A light kind of footman's plate armour, specifically an almain rivet.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "armour",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The museum displayed a rare sixteenth-century <w>rivet</w> worn by light infantry.",
                            "target_lang_translations": {
                                "ru": "В музее был выставлен редкий <w>доспех</w> шестнадцатого века, который носила легкая пехота."
                            }
                        },
                        {
                            "text": "He wore a protective <w>rivet</w> of white cloth and steel during the historical reenactment.",
                            "target_lang_translations": {
                                "ru": "Во время исторической реконструкции на нем был защитный <w>доспех</w> из белой ткани и стали."
                            }
                        }
                    ],
                    "common_phrases": [
                        "almain rivet"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historical type of armor"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Легкий тип пехотных пластинчатых доспехов, в частности, альмандский доспех."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "доспех",
                                "target_lang_sense_clarification": "исторический тип легкого пластинчатого доспеха"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "25f4665d-28cc-3a9b-977d-5f1d20523148",
                    "sense_definition": "A surname from French.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "We invited Professor <w>Rivet</w> to deliver the keynote lecture on historical linguistics.",
                            "target_lang_translations": {
                                "ru": "Мы пригласили профессора <w>Риве</w> выступить с пленарным докладом по исторической лингвистике."
                            }
                        },
                        {
                            "text": "The genealogical records show that the <w>Rivet</w> family settled in this region in the nineteenth century.",
                            "target_lang_translations": {
                                "ru": "Генеалогические записи показывают, что семья <w>Риве</w> поселилась в этом регионе в девятнадцатом веке."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "family name of French origin"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия французского происхождения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Риве",
                                "target_lang_sense_clarification": "французская фамилия"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}