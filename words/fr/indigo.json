                    "frequency": "Middle",
                    "semantic_group_id": "couleur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'<w>indigo</w> se situe entre le bleu et le violet sur le spectre lumineux visible."
                        },
                        {
                            "text": "Elle a choisi un très bel <w>indigo</w> pour peindre les volets de sa maison."
                        }
                    ],
                    "common_phrases": [
