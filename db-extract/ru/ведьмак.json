                "senses": [
                    {
                        "sense_id": "c6802e55-4622-3e4e-b8a4-b157770896d7",
                        "entry_id": "ebce34c0-4a33-3de8-81aa-cf74599e6542",
                        "glosses": [
                            "male witch, warlock, vedmak"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d6eb7012-8d99-4a2a-9388-08bef20c8ffe",
                                "sense_id": "c6802e55-4622-3e4e-b8a4-b157770896d7",
                                "text": "Вы́летел и́з-за со́сен кру́глый ме́сяц, запры́гал над ведьмако́м — не даёт ему́ звёзд туши́ть. Наце́лится ведьма́к ко́гтем на звезду́, а ме́сяц — тут как ту́т, и заслони́т.",
                                "translation": "Aleksey Nikolayevich Tolstoy",
                                "english": "Aleksey Nikolayevich Tolstoy"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
