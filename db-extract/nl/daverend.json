                                                "example_id": "120e3555-dfe5-4220-8deb-a9e27a4650c9",
                                                "sense_id": "7723e090-94f4-3c85-8afd-ef5fb7f77420",
                                                "text": "He suddenly gave her a resounding kiss, which embarrassed me even more than his violence had done."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "544a6926-a0f8-3d12-85c0-7a1a7b0fc701",
                                        "entry_id": "5aaeafd0-ee24-3cfe-936f-c734414a35ec",
                                        "glosses": [
                                            "Emphatic, noteworthy."
