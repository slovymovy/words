                        ],
                        "examples": [
                            {
                                "example_id": "9d432788-1c16-4c1d-9268-ee3d25861a6b",
                                "sense_id": "0305612e-7613-3cfb-b2ee-ce8d6d0644f6",
                                "text": "Het Tweede Vaticaans Concilie heeft voorzien in een permanent ambt van diaken."
                            }
                        ]
                    },
                    {
                        "sense_id": "ed949cc9-874a-37c6-bbd7-71c4757c0a6d",
                        "entry_id": "36809fbc-fa08-3e7f-87d7-4f0abac38f4a",
                        "glosses": [
                            "persoon die binnen de protestantse kerken gaat over de kerkelijke armenzorg"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "74431b7c-8720-43b3-aa40-16a68a4b396e",
                        "source_entry_id": "36809fbc-fa08-3e7f-87d7-4f0abac38f4a",
                        "target_lang_word": "Diakon",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Diakon",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f70f24ca-a725-313d-9781-36f3790999ab",
                                        "entry_id": "bcc65b8b-cc72-3cea-a220-10c1ce7928a2",
                                        "glosses": [
                                            "Person, die ein geistliches Amt (unterhalb des Priesters) innerhalb der (orthodoxen, anglikanischen, katholischen) Kirche ausübt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e1ede8a2-9c5f-4977-b7fd-6d9a19c65f6b",
                                                "sense_id": "f70f24ca-a725-313d-9781-36f3790999ab",
                                                "text": "Ein Diakon wird durch bischöfliche Weihe in sein Amt erhoben."
                                            },
                                            {
                                                "example_id": "5254e9f0-b466-4218-b78a-bd3d5b6fa819",
                                                "sense_id": "f70f24ca-a725-313d-9781-36f3790999ab",
                                                "text": "„Nur die zum Diakon Geweihten durften am Kapitel teilnehmen.“"
                                            },
                                            {
                                                "example_id": "9f83fbed-6743-4172-9b5e-ea01f352b136",
                                                "sense_id": "f70f24ca-a725-313d-9781-36f3790999ab",
                                                "text": "„Da steht er vor ihnen mit dem Kind, das getauft werden soll, und vielleicht hilft ihm Dr. Deering oder sonst ein anderer Diakon beim Eintauchen des Täuflings.“"
                                            },
                                            {
                                                "example_id": "918fe7d5-1eeb-43ce-a550-b46f6c2c6699",
                                                "sense_id": "f70f24ca-a725-313d-9781-36f3790999ab",
                                                "text": "„In der Hierarchie eine Stufe tiefer stehen die Diakone welche die Handauflegung nicht zum Priestertum sondern zur Dienstleistung empfangen.“"
                                            },
                                            {
                                                "example_id": "ff996304-ddcd-48a1-a88c-1aceedcbd6b7",
                                                "sense_id": "f70f24ca-a725-313d-9781-36f3790999ab",
                                                "text": "„Er bleibt eine Weile, wird Bürgermeister von Hillern vorgestellt und für das offene Amt des Diakons ins Spiel gebracht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "69157ebf-c872-334b-a1d9-4abd00676af5",
                                        "entry_id": "bcc65b8b-cc72-3cea-a220-10c1ce7928a2",
                                        "glosses": [
                                            "Helfer in einer (evangelischen) Gemeinde, der zum Beispiel karitative Aufgaben wahrnimmt oder in schulischen und gesellschaftlichen Arbeitsfeldern aktiv ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "56b661db-ea20-4c77-8885-7dde990f17db",
                                                "sense_id": "69157ebf-c872-334b-a1d9-4abd00676af5",
                                                "text": "„Die evangelischen Diakoninnen und Diakone fühlen sich im Unterschied zu ihren elf katholischen Kollegen in der Regel weniger wertgeschätzt, zu wenig selbstständig und nicht wirklich an Leitungsaufgaben beteiligt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
