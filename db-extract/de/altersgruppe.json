                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b1107508-e01a-4dc0-a4b4-db4f4057d4a8",
                                "sense_id": "1fe4362b-c583-339d-a335-1d7e12289648",
                                "text": "Der Untersuchung zufolge haben Menschen ab einem Alter von 80 Jahren, das höchste Risiko zu sterben: Fast jeder siebte Mensch in dieser Altersgruppe, bei dem eine Infektion mit dem neuartigen Coronavirus nachgewiesen wurde, erlag der Erkrankung."
                            }
