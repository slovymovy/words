                ],
                "senses": [
                    {
                        "sense_id": "bd44969e-b37e-3792-bb09-8db8ce6e30e9",
                        "entry_id": "e342c2ef-3260-3f15-97ca-dbff78ee7a9c",
                        "glosses": [
                            "The process by which a person is typecast, or taken to be a particular stereotype."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "831dceab-824d-45ea-84ae-475367c08c69",
                                "sense_id": "bd44969e-b37e-3792-bb09-8db8ce6e30e9",
                                "text": "Similar in consequence to the ethnological typecastings, these ideologically driven political readings produce a lumping effect."
                            }
                        ]
                    },
                    {
                        "sense_id": "2a8f9302-f877-31a3-b11a-ad6379847f79",
                        "entry_id": "e342c2ef-3260-3f15-97ca-dbff78ee7a9c",
                        "glosses": [
                            "The act of typing out messages with a typewriter and posting images of them online."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "8b578bc2-3d5c-4820-9228-a57cc53fe638",
                                "sense_id": "2a8f9302-f877-31a3-b11a-ad6379847f79",
                                "text": "Matt Cidoni, 16, of East Brunswick, N.J., keeps a picture of his favorite machine, a Royal No. 10, on his iPod Touch so he can show it off to friends. Online, he is a proud member of the \"typosphere,\" a global community of typewriter geeks. Like many of them, he enjoys \"typecasting,\" or tapping out typewritten messages, which he scans and posts to his Web site, Adventures in Typewriterdom."
                            },
                            {
                                "example_id": "fc3cdb5f-468c-480b-a6a9-c132bd2aa7da",
                                "sense_id": "2a8f9302-f877-31a3-b11a-ad6379847f79",
                                "text": "Owning vintage typewriters, attending 'type-ins'—congregations of enthusiasts who have typing competitions with one another—and 'typecasting' (typing posts, scanning them and uploading them on to websites) are some of the activities of a new geeky species."
                            },
                            {
                                "example_id": "0f760360-1a14-4e40-812c-e148ca7d397f",
                                "sense_id": "2a8f9302-f877-31a3-b11a-ad6379847f79",
                                "text": "Having collected typewriters for more than 20 years, Polt decided to join the \"typosphere\" and start \"typecasting\". Simply put, he uses a typewriter to capture his thoughts, then scans the page and uploads it to his blog."
                            }
                        ]
                    }
                ],
