                        "examples": [
                            {
                                "example_id": "921a4d41-bec7-4e1e-83eb-bf3c9b1cdd69",
                                "sense_id": "38aee22f-f897-39b9-9628-1e0b51441558",
                                "text": "„Wie ein aus rot glühendem Kupfer geformter Igel glitt die sinkende Sonne hinter die schwarzblaue Waldkuppe.“"
                            },
