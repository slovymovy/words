                "senses": [
                    {
                        "sense_id": "cf2a2e96-e0da-3d54-b049-d4db8ac177a6",
                        "entry_id": "17ade9bb-1437-36da-938e-fcc4281c610a",
                        "glosses": [
                            "Haut-parleur de graves, haut-parleur produisant des sons de basses fréquences, à savoir les notes de musique les plus basses."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "a6165181-108b-4a94-92f2-f063909bcede",
                                "sense_id": "cf2a2e96-e0da-3d54-b049-d4db8ac177a6",
                                "text": "Gagné. En tout cas pour la catégorie Street Stock 2k, qui n’admet que des véhicules dotés d’un seul ampli de 2 000 watts et d’au plus deux woofers, ces haut-parleurs géants."
                            }
                        ]
                    },
                    {
                        "sense_id": "8db39932-fb30-360d-8ffc-19deaeaa80e8",
                        "entry_id": "17ade9bb-1437-36da-938e-fcc4281c610a",
                        "glosses": [
                            "Voyageur finançant son voyage en travaillant dans des exploitations d’agriculture biologique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7dbbecea-f1f4-4a7a-9a81-d142d1747bf5",
                                "sense_id": "8db39932-fb30-360d-8ffc-19deaeaa80e8",
                                "text": "Pour la récolte, deux « woofers » sont venus lui prêter main-forte."
                            },
                            {
                                "example_id": "6886b9ed-e83a-42c0-8eb9-995205bf23f6",
                                "sense_id": "8db39932-fb30-360d-8ffc-19deaeaa80e8",
                                "text": "Le woofer a accès, en contrepartie de sa force de travail, à un hébergement et des repas sur une courte ou plus longue durée (quelques jours à quelques mois)."
                            }
                        ]
                    }
