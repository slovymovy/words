                ],
                "senses": [
                    {
                        "sense_id": "608d0ec0-7f68-3cd8-a7d0-89dc4b2c5abd",
                        "entry_id": "f91acaa1-43cf-3135-8e57-924f5e316056",
                        "glosses": [
                            "nobility (noble or privileged social class)"
                        ],
                        "tags": [
                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "03db4b4c-b060-4af8-8445-43ccec8e9232",
                                "sense_id": "608d0ec0-7f68-3cd8-a7d0-89dc4b2c5abd",
                                "text": "De adelstand had veel privileges in de middeleeuwen.",
                                "translation": "The nobility had many privileges in the Middle Ages.",
                                "english": "The nobility had many privileges in the Middle Ages."
                            },
                            {
                                "example_id": "a82a7ee9-8baa-4fd0-b96c-9f9dd8baecd9",
                                "sense_id": "608d0ec0-7f68-3cd8-a7d0-89dc4b2c5abd",
                                "text": "Het kasteel werd bewoond door leden van de adelstand.",
                                "translation": "The castle was inhabited by members of the nobility.",
                                "english": "The castle was inhabited by members of the nobility."
                            },
                            {
                                "example_id": "262bdeed-7c59-4d4e-8d44-14d5b7785cc7",
                                "sense_id": "608d0ec0-7f68-3cd8-a7d0-89dc4b2c5abd",
                                "text": "Hij streefde ernaar tot de adelstand te behoren.",
                                "translation": "He aspired to belong to the nobility.",
                                "english": "He aspired to belong to the nobility."
                            }
                        ]
                    },
                    {
                        "sense_id": "c6ac1bcb-d415-37e7-ba3d-1bb0c19af5e9",
                        "entry_id": "f91acaa1-43cf-3135-8e57-924f5e316056",
                        "glosses": [
                            "nobility (the quality of being noble)"
                        ],
                        "tags": [
                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "48dc841d-e9d8-4f78-9128-7025b20a7da4",
                                "sense_id": "c6ac1bcb-d415-37e7-ba3d-1bb0c19af5e9",
                                "text": "Zijn adelstand werd erkend door iedereen die hem kende.",
                                "translation": "His nobility was recognized by everyone who knew him.",
                                "english": "His nobility was recognized by everyone who knew him."
                            },
                            {
                                "example_id": "fea40de6-e72e-4028-a3fd-76c2a0d9ac3f",
                                "sense_id": "c6ac1bcb-d415-37e7-ba3d-1bb0c19af5e9",
                                "text": "Ze toonde ware adelstand in haar daden.",
                                "translation": "She displayed true nobility in her actions.",
                                "english": "She displayed true nobility in her actions."
                            },
                            {
                                "example_id": "8816ffd9-798a-4bc0-8883-7255fadbe961",
                                "sense_id": "c6ac1bcb-d415-37e7-ba3d-1bb0c19af5e9",
                                "text": "Ware adelstand is niet gebaseerd op rijkdom, maar op karakter.",
                                "translation": "True nobility is not based on wealth, but on character.",
                                "english": "True nobility is not based on wealth, but on character."
                            }
                        ]
                    }
                ],
