    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4d227d30-78e3-3e82-a827-343cc4ed38dd",
                    "sense_definition": "Contenu d'un verre, généralement une boisson alcoolisée.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "boisson",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après une dure journée de travail, ils sont allés boire un <w>godet</w> au bistrot du coin."
                        },
                        {
                            "text": "Le vieil homme a terminé son <w>godet</w> de vin rouge avant de rentrer chez lui."
                        }
                    ],
                    "common_phrases": [
                        "boire un godet",
                        "payer un godet"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "terme familier pour désigner un verre d'alcool"
                        }
                    ]
                },
                {
                    "sense_id": "74580551-a07d-3eb8-b8d0-8bc2643ba14b",
                    "sense_definition": "Petit récipient ou gobelet servant à boire, souvent sans pied ni anse.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "recipient",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le café bien chaud coule lentement dans le <w>godet</w> en plastique du distributeur."
                        },
                        {
                            "text": "Pour la fête d'anniversaire, nous avons acheté plusieurs <w>godets</w> jetables et des serviettes."
                        }
                    ],
                    "common_phrases": [
                        "godet en plastique"
                    ]
                },
                {
                    "sense_id": "3dcbce55-d27d-3705-8ebf-7c634c99676f",
                    "sense_definition": "Grande benne articulée à l'extrémité d'un engin de chantier, destinée à creuser ou transporter des matériaux.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "outillage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'ouvrier charge le sable dans le camion à l'aide d'un grand <w>godet</w> de pelleteuse."
                        },
                        {
                            "text": "Le <w>godet</w> de l'excavatrice s'enfonce facilement dans la terre humide pour creuser la tranchée."
                        }
                    ],
                    "common_phrases": [
                        "godet de pelleteuse"
                    ]
                },
                {
                    "sense_id": "a47ae901-29d4-3acf-8436-ccc4ae070582",
                    "sense_definition": "Petit pot souple, en plastique ou en matière biodégradable, utilisé pour faire germer ou cultiver de jeunes plants.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "jardinage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Au début du printemps, elle prépare ses semis de tomates dans des <w>godets</w> individuels."
                        },
                        {
                            "text": "Le pépiniériste vend chaque jeune plant de fleur dans un petit <w>godet</w> en plastique."
                        }
                    ],
                    "common_phrases": [
                        "semis en godet"
                    ]
                },
                {
                    "sense_id": "8c19f868-d93b-3639-8171-2097cd904c0e",
                    "sense_definition": "Petit récipient utilisé par les peintres pour contenir, mélanger ou diluer des couleurs.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "recipient",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'artiste rince son pinceau dans un <w>godet</w> d'eau avant de changer de nuance."
                        },
                        {
                            "text": "Cette boîte d'aquarelle contient douze petits <w>godets</w> de pigments très colorés."
                        }
                    ],
                    "common_phrases": [
                        "godet de peinture"
                    ]
                },
                {
                    "sense_id": "699d18a9-56f8-3397-9156-302b06a14d60",
                    "sense_definition": "Pli évasé ménagé dans une étoffe pour donner de l'ampleur et du mouvement à un vêtement.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "couture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La couturière a confectionné une élégante jupe à <w>godets</w> qui flotte au vent."
                        },
                        {
                            "text": "Les <w>godets</w> disposés autour de cette robe apportent une belle silhouette ondulée."
                        }
                    ],
                    "common_phrases": [
                        "jupe à godets"
                    ]
                },
                {
                    "sense_id": "c362c24c-2525-3cd0-927d-7ad11a04edce",
                    "sense_definition": "Enveloppe ou écaille protectrice en forme de coupe soutenant la base de certains fruits.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "botanique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans la forêt, les enfants ramassent des glands qui sont encore fixés à leur petit <w>godet</w> rugueux."
                        },
                        {
                            "text": "Le <w>godet</w> boisé qui entoure le fruit tombe sur l'herbe à l'automne."
                        }
                    ],
                    "synonyms": [
                        "cupule"
                    ]
                }
            ]
        },
