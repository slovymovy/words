                    {
                        "form_id": "f516cdd9-b17c-4ccf-a155-7407553a9460",
                        "entry_id": "877f5262-073e-31e0-ba15-118f18e2c5d9",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Durchsuchungsbefehle"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c7bd6128-4b3d-35de-93e3-850e5ff0a703",
                        "entry_id": "877f5262-073e-31e0-ba15-118f18e2c5d9",
                        "glosses": [
                            "Anordnung, eine Durchsuchung durchzuführen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7191bc85-b475-45dc-a1d6-080d9b95d74d",
                                "sense_id": "c7bd6128-4b3d-35de-93e3-850e5ff0a703",
                                "text": "„Sie fahren in zwei Wagen vor – Edgerton, Pellegrini, Eddie Brown, Ceruti, Bertina Silver von Stantons Truppe und zwei von der Sonderkommission – ein ziemliches Angebot für einen alten Säufer, aber genau die richtige Anzahl Leute, um sich schnell und gründlich in einer Wohnung umzuschauen, auch wenn man keinen Durchsuchungsbefehl hat.“"
                            },
                            {
                                "example_id": "237e319a-df66-4690-99ad-98ec58abdc96",
                                "sense_id": "c7bd6128-4b3d-35de-93e3-850e5ff0a703",
                                "text": "„ETKAO beansprucht für sich das Recht, jederzeit innerhalb der ursprünglichen Grenzen der Vereinigten Staaten überall hinzugehen, ohne Durchsuchungsbefehl oder auch nur eine gute Ausrede.“"
                            },
                            {
                                "example_id": "a7d0c770-e1f1-4186-bfaa-12c38889a4e4",
                                "sense_id": "c7bd6128-4b3d-35de-93e3-850e5ff0a703",
                                "text": "„In der Eile, die Operation auf den Weg zu bringen, hatte ein Mitarbeiter des Generalstaatsanwalts die Durchsuchungsbefehle unterschrieben, nicht der Generalstaatsanwalt persönlich.“"
                            },
                            {
                                "example_id": "be77ca7d-0603-4286-ae18-987386e9dbd2",
                                "sense_id": "c7bd6128-4b3d-35de-93e3-850e5ff0a703",
                                "text": "„Obwohl sie keinen Durchsuchungsbefehl hatten, beanspruchten sie für sich das Recht, mein Haus zu durchstöbern.“"
                            },
                            {
                                "example_id": "23863525-7bdf-4e7b-a1c8-2d1e18d01fce",
                                "sense_id": "c7bd6128-4b3d-35de-93e3-850e5ff0a703",
                                "text": "„Hast du 'nen Durchsuchungsbefehl?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "75a63507-c31f-4b4a-abbb-cc75148e1a03",
                        "source_entry_id": "877f5262-073e-31e0-ba15-118f18e2c5d9",
                        "source_sense_id": "c7bd6128-4b3d-35de-93e3-850e5ff0a703",
                        "source_sense_description": "Anordnung, eine Durchsuchung durchzuführen",
                        "target_lang_word": "search warrant",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "search warrant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d57340ed-3341-3750-95b5-079bd6013cd5",
                                        "entry_id": "49c08d52-4981-35af-9ba5-731862df8de5",
                                        "glosses": [
                                            "A court order in the form of a warrant, authorizing the search of a home and/or other privacy-protected place(s), notably to seek unlawful possessions, evidence etc. as part of a judicial inquiry"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9233bbe7-49bb-42af-8afc-80e692f49a3c",
                                                "sense_id": "d57340ed-3341-3750-95b5-079bd6013cd5",
                                                "text": "Evidence found without a valid search warrant may be discarded by the courts as null and void"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "566b6e43-1147-4f83-ad46-b6e14b4a2a05",
                        "source_entry_id": "877f5262-073e-31e0-ba15-118f18e2c5d9",
                        "source_sense_id": "c7bd6128-4b3d-35de-93e3-850e5ff0a703",
                        "source_sense_description": "Anordnung, eine Durchsuchung durchzuführen",
                        "target_lang_word": "mandat de perquisition",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mandat de perquisition",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dfdff413-696e-329b-a046-42fd09151956",
                                        "entry_id": "871a5b1f-b30f-39f1-8e6a-fead2a283930",
                                        "glosses": [
                                            "Ordre délivré par un magistrat à la police pour effectuer une perquisition. L'équivalent en droit français est la commission rogatoire."
                                        ],
                                        "tags": [
                                            "Droit anglo-saxon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d9d57d1f-c6ab-4209-bf96-5c82a6d07751",
                                                "sense_id": "dfdff413-696e-329b-a046-42fd09151956",
                                                "text": "…, les Magistrats procèdent à la recherche, dans leur voisinage, des contraventions, délits et crimes de toute espèce. Ils décernent des mandats de perquisition, de comparution et d’arrêt."
                                            },
                                            {
                                                "example_id": "abb69089-db59-42f2-be0e-4632497f41d8",
                                                "sense_id": "dfdff413-696e-329b-a046-42fd09151956",
                                                "text": "– Ce n'est pas très régulier de ma part, car je ne peux rien faire sans un mandat de perquisition…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
