                        "zh": "指雨或雪下得非常小。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "накрапывать",
                                "target_lang_sense_clarification": "о мелком дожде"
                            },
                            {
                                "target_lang_word": "моросить",
                                "target_lang_sense_clarification": "о мелком дожде"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "下毛毛雨",
                                "target_lang_sense_clarification": "形容雨势极小"
                            },
                            {
                                "target_lang_word": "飘雨",
                                "target_lang_sense_clarification": "零星小雨"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6ab2d628-dd6e-3ee5-9ccc-4f6ec49ce98d",
                    "sense_definition": "To utter words quickly and violently, often in anger.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sem_utter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>spat</w> out an insult before turning and walking away.",
                            "target_lang_translations": {
                                "ru": "Он <w>выплюнул</w> оскорбление, прежде чем повернуться и уйти.",
                                "zh": "他<w>吐出</w>一句侮辱的话，然后转身走开了。"
                            }
                        },
                        {
                            "text": "The angry customer <w>spat</w> his complaints at the manager.",
                            "target_lang_translations": {
                                "ru": "Рассерженный клиент <w>выпалил</w> свои жалобы менеджеру.",
                                "zh": "愤怒的顾客向经理<w>迸出</w>了他的抱怨。"
                            }
