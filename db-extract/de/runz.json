                "senses": [
                    {
                        "sense_id": "1dcbc0d2-fefe-3f0b-a5d8-481bf7db16d5",
                        "entry_id": "64dae69a-fd08-3f40-a0f1-06a10e5dbbbe",
                        "glosses": [
                            "rinnendes Gewässer, angelegter Wasserlauf zur Nutz- und Brauchwasserversorgung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c06a2210-ed3f-4ed5-93ad-fa665e92fbbd",
                                "sense_id": "1dcbc0d2-fefe-3f0b-a5d8-481bf7db16d5",
                                "text": "Das alemannische Wort „Runz“ kommt von \"Rinnen\" und wird für einen von Menschen angelegten Wasserlauf verwendet."
                            },
                            {
                                "example_id": "5bb692d6-33a4-4853-81ca-704c30b03e25",
                                "sense_id": "1dcbc0d2-fefe-3f0b-a5d8-481bf7db16d5",
                                "text": "Der mittelalterliche Begriff \"Runz\" steht als Begriff für einen von Menschen gemachten Wasserlauf, also für die Bächle in Freiburg und natürlich für den Gewerbekanal. Über diese Runzen (Wasserläufe) wird das Wasser in die Innenstadt geleitet."
                            },
                            {
                                "example_id": "2afa7a4e-2360-48dc-84db-48f8049990cd",
                                "sense_id": "1dcbc0d2-fefe-3f0b-a5d8-481bf7db16d5",
                                "text": "Drei Runzen gibt es noch. In zweien wird das Wasser für Kleingärten genutzt, in der dritten, der Gewerbebach-Runz, nutzt eine Firma das Wasser zur Stromgewinnung."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
