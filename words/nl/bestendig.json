{
    "word_family": [
        "bestendigen",
        "bestendigheid",
        "onbestendig"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "08b3e3bc-c522-3c37-9ed3-501f23bd0017",
                    "sense_definition": "Duurzaam, blijvend en niet aan verandering onderhevig.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "duurzaamheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na een week van regen genieten we eindelijk van een periode met <w>bestendig</w> weer.",
                            "target_lang_translations": {
                                "en": "After a week of rain, we are finally enjoying a period of <w>steady</w> weather."
                            }
                        },
                        {
                            "text": "Zij hopen op een <w>bestendige</w> vrede in de regio na de onderhandelingen.",
                            "target_lang_translations": {
                                "en": "They hope for a <w>lasting</w> peace in the region after the negotiations."
                            }
                        }
                    ],
                    "synonyms": [
                        "blijvend",
                        "duurzaam",
                        "permanent",
                        "stabiel"
                    ],
                    "antonyms": [
                        "onbestendig"
                    ],
                    "common_phrases": [
                        "bestendig weer",
                        "bestendige relatie"
                    ],
                    "target_lang_definitions": {
                        "en": "Durable, lasting, and not subject to change."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "steady",
                                "target_lang_sense_clarification": "referring to weather or conditions"
                            },
                            {
                                "target_lang_word": "lasting",
                                "target_lang_sense_clarification": "referring to peace or relationships"
                            },
                            {
                                "target_lang_word": "stable",
                                "target_lang_sense_clarification": "referring to a state or situation"
                            },
                            {
                                "target_lang_word": "constant",
                                "target_lang_sense_clarification": "unchanging over time"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9b0409c4-d55a-32bb-9b12-a75898309fbf",
                    "sense_definition": "Goed bestand tegen schadelijke invloeden van buitenaf.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "weerstand",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Deze speciale verf is uitstekend <w>bestendig</w> tegen extreme weersomstandigheden.",
                            "target_lang_translations": {
                                "en": "This special paint is highly <w>resistant</w> to extreme weather conditions."
                            }
                        },
                        {
                            "text": "De nieuwe smartphone is goed <w>bestendig</w> tegen water en stof.",
                            "target_lang_translations": {
                                "en": "The new smartphone is well <w>protected</w> against water and dust."
                            }
                        }
                    ],
                    "synonyms": [
                        "bestand",
                        "resistent"
                    ],
                    "common_phrases": [
                        "bestendig tegen"
                    ],
                    "target_lang_definitions": {
                        "en": "Highly resistant to harmful external influences."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "resistant",
                                "target_lang_sense_clarification": "withstanding external forces or substances"
                            },
                            {
                                "target_lang_word": "proof",
                                "target_lang_sense_clarification": "impervious to damage"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "56923c53-aa95-3074-99c1-14e4207e922e",
                    "sense_definition": "Permanent of vastgesteld, met name gebruikt in de Belgische politieke context.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "politiek",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>bestendige</w> deputatie is het uitvoerend college van een Belgische provincie.",
                            "target_lang_translations": {
                                "en": "The <w>permanent</w> deputation is the executive college of a Belgian province."
                            }
                        },
                        {
                            "text": "De leden van de <w>bestendige</w> commissie kwamen gisteren bijeen voor overleg.",
                            "target_lang_translations": {
                                "en": "The members of the <w>standing</w> committee met yesterday for consultations."
                            }
                        }
                    ],
                    "synonyms": [
                        "permanent",
                        "vast"
                    ],
                    "common_phrases": [
                        "bestendige deputatie"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Voornamelijk gebruikt in België"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Permanent or established, specifically used in the Belgian political context."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "permanent",
                                "target_lang_sense_clarification": "referring to a standing committee or deputation"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a44e7201-0d97-3165-9d47-543d96a37431",
                    "sense_definition": "Als achtervoegsel gebruikt om aan te geven dat iets ergens tegen bestand is.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "weerstand",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Deze moderne stof is zowel waterbestendig als brandbestendig gemaakt.",
                            "target_lang_translations": {
                                "en": "This modern fabric has been made both water-<w>resistant</w> and fire-resistant."
                            }
                        },
                        {
                            "text": "Voor dit experiment hebben we hittebestendig glas nodig in het laboratorium.",
                            "target_lang_translations": {
                                "en": "For this experiment, we need heat-<w>resistant</w> glass in the laboratory."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Meestal gebruikt als achtervoegsel in samenstellingen"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Used as a suffix to indicate that something is resistant to a specific element."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "-resistant",
                                "target_lang_sense_clarification": "suffix indicating resistance"
                            },
                            {
                                "target_lang_word": "-proof",
                                "target_lang_sense_clarification": "suffix indicating complete protection"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a9f8594a-c3f1-392b-bc83-5e26bbaa4a35",
                    "sense_definition": "Eerste persoon enkelvoud tegenwoordige tijd van <w>bestendigen</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>bestendig</w> hiermee onze jarenlange samenwerking.",
                            "target_lang_translations": {
                                "en": "I hereby <w>consolidate</w> our years of cooperation."
                            }
                        },
                        {
                            "text": "Met deze handtekening <w>bestendig</w> ik de gemaakte afspraken.",
                            "target_lang_translations": {
                                "en": "With this signature, I <w>confirm</w> the agreements made."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "First-person singular present tense of 'bestendigen' (to perpetuate, consolidate, or sustain)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "consolidate",
                                "target_lang_sense_clarification": "first-person singular present tense"
                            },
                            {
                                "target_lang_word": "perpetuate",
                                "target_lang_sense_clarification": "first-person singular present tense"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fd89011c-bac3-3bc6-9aec-9b614e9b7263",
                    "sense_definition": "Gebiedende wijs van <w>bestendigen</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Bestendig</w> de vrede in het land, zo luidde de oproep van de president.",
                            "target_lang_translations": {
                                "en": "<w>Preserve</w> the peace in the country, was the president's appeal."
                            }
                        },
                        {
                            "text": "<w>Bestendig</w> uw positie op de markt door voortdurend te innoveren.",
                            "target_lang_translations": {
                                "en": "<w>Consolidate</w> your position in the market by continuously innovating."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Imperative form of 'bestendigen' (to perpetuate, consolidate, or sustain)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "consolidate",
                                "target_lang_sense_clarification": "imperative form"
                            },
                            {
                                "target_lang_word": "perpetuate",
                                "target_lang_sense_clarification": "imperative form"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3b4df348-afd7-3625-997a-92288da9707c",
                    "sense_definition": "Tweede persoon enkelvoud tegenwoordige tijd (in inversie) van <w>bestendigen</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hoe <w>bestendig</w> je een traditie die langzaam dreigt te verdwijnen?",
                            "target_lang_translations": {
                                "en": "How do you <w>perpetuate</w> a tradition that is slowly in danger of disappearing?"
                            }
                        },
                        {
                            "text": "Waarom <w>bestendig</w> je deze ongezonde situatie in plaats van in te grijpen?",
                            "target_lang_translations": {
                                "en": "Why do you <w>perpetuate</w> this unhealthy situation instead of intervening?"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Second-person singular present tense (in inversion) of 'bestendigen' (to perpetuate, consolidate, or sustain)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "consolidate",
                                "target_lang_sense_clarification": "second-person singular present tense in inversion"
                            },
                            {
                                "target_lang_word": "perpetuate",
                                "target_lang_sense_clarification": "second-person singular present tense in inversion"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}