                                                "sense_id": "be55dae4-3f55-3d04-a9bd-a22a76681791",
                                                "text": "Frau Bollinger ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "deb14d43-e77d-429e-b302-3a221e3685ff",
                                                "sense_id": "be55dae4-3f55-3d04-a9bd-a22a76681791",
                                                "text": "Herr Bollinger wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "2ceb6619-32fd-4f80-97a1-ef00f5df0e2f",
                                                "sense_id": "be55dae4-3f55-3d04-a9bd-a22a76681791",
                                                "text": "Die Bollingers fliegen heute nach La Paz."
                                            },
                                            {
                                                "example_id": "73ab39ce-e271-42a3-8583-79281c88f68a",
                                                "sense_id": "be55dae4-3f55-3d04-a9bd-a22a76681791",
                                                "text": "Der Bollinger trägt nie die Schals, die die Bollinger ihm strickt."
                                            },
                                            {
                                                "example_id": "455ef911-19ac-4e2b-b768-f05b3fd75590",
                                                "sense_id": "be55dae4-3f55-3d04-a9bd-a22a76681791",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Bollinger kommt, geht der Herr Bollinger.“"
                                            },
                                            {
                                                "example_id": "24e0bdee-8b51-45cf-b613-9d11f93acda8",
                                                "sense_id": "be55dae4-3f55-3d04-a9bd-a22a76681791",
                                                "text": "Bollinger kommt und geht."
                                            },
                                            {
                                                "example_id": "db81eb35-d899-45c2-8903-ef3673b8a998",
                                                "sense_id": "be55dae4-3f55-3d04-a9bd-a22a76681791",
                                                "text": "Bollingers kamen, sahen und siegten."
                                            }
                                        ],
