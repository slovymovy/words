                ],
                "senses": [
                    {
                        "sense_id": "baa2ea67-48f3-3d74-8b2c-395b12003b82",
                        "entry_id": "4eb07be5-57eb-344a-a1ae-7c62ddc345eb",
                        "glosses": [
                            "główny maszt statku żaglowego"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6de827ca-3ea3-4b44-a64a-241e77391487",
                                "sense_id": "baa2ea67-48f3-3d74-8b2c-395b12003b82",
                                "text": "Czubek grotmasztu Eniela ledwie sięgał pokładu rufówki, a żeglarz wysoko na salingu wydawał się malutki jak mewa."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1a1455a6-b015-40aa-b4ba-9b7f451c71a3",
                        "source_entry_id": "4eb07be5-57eb-344a-a1ae-7c62ddc345eb",
                        "source_sense_id": "baa2ea67-48f3-3d74-8b2c-395b12003b82",
                        "target_lang_word": "mainmast",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mainmast",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "158bd189-4a90-3334-9a16-c63518f6b646",
                                        "entry_id": "4f7b794b-10bb-37be-9028-eace98a9ee16",
                                        "glosses": [
                                            "The tallest mast of a sailing ship that has more than one mast; particularly a full-rigged ship."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b544b8e1-3f71-44b6-9ac5-e971bcb05963",
                                                "sense_id": "158bd189-4a90-3334-9a16-c63518f6b646",
                                                "text": "O, the most piteous cry of the poor souls! sometimes to see ’em, and not to see ’em; now the ship boring the moon with her main-mast, and anon swallowed with yest and froth, as you’ld thrust a cork into a hogshead."
                                            },
                                            {
                                                "example_id": "3c97ba38-5d86-4d61-9b75-a4f3f044e844",
                                                "sense_id": "158bd189-4a90-3334-9a16-c63518f6b646",
                                                "text": "Then turning to his first Minister, who waited behind him with a white Staff near as tall as the Main-mast of the Royal Soveraign, he observed how contemptible a thing was human Grandeur, which could be mimicked by such diminutive Insects as I […]"
                                            },
                                            {
                                                "example_id": "3d2557a9-ced2-457a-991e-1e843a3698be",
                                                "sense_id": "158bd189-4a90-3334-9a16-c63518f6b646",
                                                "text": "When we were in the latitude of Martinico, and near making the land, one morning we had a brisk gale of wind, and, carrying too much sail, the main-mast went over the side."
                                            },
                                            {
                                                "example_id": "ff7ce48e-b70b-4f07-aec7-e19d1b1da1f9",
                                                "sense_id": "158bd189-4a90-3334-9a16-c63518f6b646",
                                                "text": "The try-works are planted between the foremast and mainmast, the most roomy part of the deck."
                                            },
                                            {
                                                "example_id": "9c7e77ba-ced1-4576-8820-5d4bf07ca4c6",
                                                "sense_id": "158bd189-4a90-3334-9a16-c63518f6b646",
                                                "text": "[…] skating farther than their wont that day they reached that part of the river where the ships had anchored and been frozen in midstream. Among them was the ship of the Muscovite Embassy flying its double-headed black eagle from the main mast, which was hung with many-coloured icicles several yards in length."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0acd5403-b6ca-30ff-85d0-97491199d909",
                                        "entry_id": "4f7b794b-10bb-37be-9028-eace98a9ee16",
                                        "glosses": [
                                            "The second-foremost mast of a non-sailing ship with more than one mast."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3119d08f-e5f5-43be-86e7-ff60c004a68a",
                        "source_entry_id": "4eb07be5-57eb-344a-a1ae-7c62ddc345eb",
                        "source_sense_id": "baa2ea67-48f3-3d74-8b2c-395b12003b82",
                        "target_lang_word": "Großmast",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Großmast",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ba97e5ac-9b78-382b-9a29-e8984a13d6e4",
                                        "entry_id": "7983269a-b13f-35ff-b38e-8c49bc848c35",
                                        "glosses": [
                                            "zweiter Mast eines großen Segelschiffes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "607e71c4-09a8-411e-b82e-296c749d5474",
                                                "sense_id": "ba97e5ac-9b78-382b-9a29-e8984a13d6e4",
                                                "text": "„Die Besanmasten waren längst verschwunden, die Großmasten in vierzig Fuß Höhe abgebrochen, die Fockmasten zwar mehr oder weniger intakt, aber ihrer Wanten beraubt.“"
                                            },
                                            {
                                                "example_id": "cf2136f1-aa54-404f-b9e8-851bc0f2cf83",
                                                "sense_id": "ba97e5ac-9b78-382b-9a29-e8984a13d6e4",
                                                "text": "„Eines Tages sah Mr. Marchinton mich fast ganz oben am Flaggenknopf des Großmastes, und nachdem er mir befohlen hatte, herunterzukommen, erhielt ich für meine Geschicklichkeit und Unternehmungslust eine ordentliche Tracht Prügel.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
