                "senses": [
                    {
                        "sense_id": "9a596b85-c121-3bf6-b80a-b7719c63f4df",
                        "entry_id": "b89fbc1b-7e85-39ba-b50c-9109931eb26b",
                        "glosses": [
                            "System zur eindeutigen Benennung von Punkten in einem geometrischen Raum mithilfe von Koordinaten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a67a69b7-365f-4582-bf83-7f31240335c8",
                                "sense_id": "9a596b85-c121-3bf6-b80a-b7719c63f4df",
                                "text": "Er trug den Punkt P(1|3) in das Koordinatensystem ein."
                            },
                            {
                                "example_id": "bd28b792-48d3-4ca1-a1b9-3e88b0409ec4",
                                "sense_id": "9a596b85-c121-3bf6-b80a-b7719c63f4df",
                                "text": "„Sie hoffen, daß sich die Länge des Stabes aus der Differenz der Marken auf dem Koordinatensystem, mit dem die beiden Stabenden zusammenfallen, ermitteln läßt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "395842a5-6989-488b-8ab8-886d5bdec014",
                        "source_entry_id": "b89fbc1b-7e85-39ba-b50c-9109931eb26b",
                        "source_sense_id": "9a596b85-c121-3bf6-b80a-b7719c63f4df",
                        "source_sense_description": "System zur eindeutigen Benennung von Punkten in einem geometrischen Raum mithilfe von Koordinaten",
                        "target_lang_word": "coordinate system",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "coordinate system",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "35ff5625-3a62-3e47-b091-224e7247a830",
                                        "entry_id": "018406dd-0a6d-36e1-9593-5a3b06b40002",
                                        "glosses": [
                                            "A method of representing the position of any individual point in a space of given dimensionality as a tuple of numerical coordinates."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "24a73091-26aa-4deb-b77a-e28ae01c1ee4",
                                                "sense_id": "35ff5625-3a62-3e47-b091-224e7247a830",
                                                "text": "1992, D. H. Maling, Coordinate Systems and Map Projections, 2nd Edition, Pergamon Press, page 27,\nIn this chapter we review some of the fundamental ideas about the plane coordinate systems which are used in surveying and mapping, both from the viewpoint of studying the mathematics of map projections and the practical tasks which arise in cartography."
                                            },
                                            {
                                                "example_id": "83e08037-03da-4620-987b-3183dd8bddd2",
                                                "sense_id": "35ff5625-3a62-3e47-b091-224e7247a830",
                                                "text": "Note that the orientation of Squire's coordinate system relative to the physical coordinate system is changing as a function of wavenumbervector."
                                            },
                                            {
                                                "example_id": "bc74125a-1b41-4cbf-85f3-fb286065cac5",
                                                "sense_id": "35ff5625-3a62-3e47-b091-224e7247a830",
                                                "text": "In Chapter 1 the choice of the origin and orientation of the analysis Cartesian coordinate system was made arbitrarily.[…]Note that nothing was said about the origins of the above two Cartesian coordinate systems."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
