                "senses": [
                    {
                        "sense_id": "9a899816-3a2d-33f6-9d57-7fc18e7f681c",
                        "entry_id": "46c78052-eb6b-3923-9fc5-4b5e84fb88f2",
                        "glosses": [
                            "Position, bei der die Körperhauptachsen von Fötus und Mutter im rechten Winkel zueinander stehen"
                        ],
                        "tags": [
                            "Gynäkologie",
                            "Geburtshilfe"
                        ],
                        "examples": [
                            {
                                "example_id": "2e84402d-9179-4af3-94a8-e3ecd1288b4a",
                                "sense_id": "9a899816-3a2d-33f6-9d57-7fc18e7f681c",
                                "text": "„Sehr selten sind Querlage und Schräglage.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "8aeacc83-fff2-3791-bef4-6a10adce3a30",
                        "entry_id": "46c78052-eb6b-3923-9fc5-4b5e84fb88f2",
                        "glosses": [
                            "Kippen des Flugzeuges von der Horizontallage weg"
                        ],
                        "tags": [
                            "Fliegerei"
                        ],
                        "examples": [
                            {
                                "example_id": "ddeb44e5-ef73-4420-bbd7-73d7fe549110",
                                "sense_id": "8aeacc83-fff2-3791-bef4-6a10adce3a30",
                                "text": "„Hier erhielt der Schüler die Gelegenheit, sich an die Fortbewegung durch die Luft zu gewöhnen. Es folgte das Erlernen des Geradeausfluges mit dem Halten der Querlage und der Richtung sowie dem Einhalten der Flughöhe.“"
                            },
                            {
                                "example_id": "df314068-2f75-4c7e-9ada-2ec68d9136d8",
                                "sense_id": "8aeacc83-fff2-3791-bef4-6a10adce3a30",
                                "text": "„Steuerknüppel, Steuerhorn oder Sidestick dienen zur Steuerung der Querlage und der Längsneigung und steuern das Querruder und das Höhenruder.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
