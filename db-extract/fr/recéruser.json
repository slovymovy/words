                        "glosses": [
                            "Céruser à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "91701aab-6ee4-4da4-b0d7-a226337bb049",
                                "sense_id": "93cf99b0-fced-3ff9-818b-fcdc9ccd8023",
                                "text": "Alors je consacre 60 % de mon temps à mes enfants et à la musique, 30 à recéruser ma cuisine, et le reste à mon mari (le pauvre)..."
                            },
                            {
                                "example_id": "d1ff4d98-445f-4e0a-904b-f57e9f46fdb0",
                                "sense_id": "93cf99b0-fced-3ff9-818b-fcdc9ccd8023",
                                "text": "Il vous faut tout poncer, enlever la céruse avec une brosse métallique, puis recéruser avec du blanc de meudon que vous pouvez teinter ensuite cirez ou vernissez ;"
                            }
                        ]
                    }
