                                    {
                                        "sense_id": "17cd2867-5795-39ba-95b3-ef5d2083d33e",
                                        "entry_id": "a0266ce4-ae54-315d-9c9f-d499597d8605",
                                        "glosses": [
                                            "Pertaining to or based on experience, as opposed to theory."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cb5961fc-caca-4683-87ad-7e325f496478",
                                                "sense_id": "17cd2867-5795-39ba-95b3-ef5d2083d33e",
                                                "text": "The lengths were calculated according to the empirical rules of the trade."
                                            },
                                            {
                                                "example_id": "86152c67-58fb-4a6a-8cfb-aa81002f5923",
                                                "sense_id": "17cd2867-5795-39ba-95b3-ef5d2083d33e",
                                                "text": "For some presumptive diagnoses, empirical antibiotic therapy begins immediately, whereas specific antibiotic therapy must await the results of the culture and sensitivity test."
                                            },
                                            {
                                                "example_id": "69f7ba04-4e4f-4d81-93ae-d5702547368e",
                                                "sense_id": "17cd2867-5795-39ba-95b3-ef5d2083d33e",
                                                "text": "The village carpenter […] lays out his work by empirical rules learnt in his apprenticeship."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "627cd08b-429b-358d-a3ac-1c7c36b68097",
                                        "entry_id": "a0266ce4-ae54-315d-9c9f-d499597d8605",
                                        "glosses": [
                                            "Pertaining to, derived from, or testable by observations made using the physical senses or using instruments which extend the senses."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8aac85f3-5e96-3cbd-856a-a20e13ea0a26",
                                        "entry_id": "a0266ce4-ae54-315d-9c9f-d499597d8605",
                                        "glosses": [
                                            "Verifiable by means of scientific experimentation."
                                        ],
                                        "tags": [
                                            "of science"
                                        ],
                                        "examples": [
