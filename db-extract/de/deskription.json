                    {
                        "sense_id": "009ae5dd-8283-37be-9a47-fe20b925971f",
                        "entry_id": "4fa59104-3bba-3123-b7f4-084106906c02",
                        "glosses": [
                            "Beschreibung, d. h. Darstellung sprachlicher Gegebenheiten unter Verwendung der Fachterminologie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8070613b-f113-4fc8-acd9-eec1d1cc1d55",
                                "sense_id": "009ae5dd-8283-37be-9a47-fe20b925971f",
                                "text": "Beobachtung, Beschreibung (= Deskription) und Erklärung sind die wesentlichen Aufgaben jeder Wissenschaft, so auch der Linguistik."
                            },
                            {
                                "example_id": "a3288988-dc28-4125-8b26-da5a436159d1",
                                "sense_id": "009ae5dd-8283-37be-9a47-fe20b925971f",
                                "text": "Die Linguistik hat Deskription lange als ihre Hauptaufgabe betrachtet und nannte sich entsprechend Deskriptive Linguistik."
                            },
                            {
                                "example_id": "623e5864-c70f-404c-b132-3ed56d483ab7",
                                "sense_id": "009ae5dd-8283-37be-9a47-fe20b925971f",
                                "text": "„Zumindest kann jede wissenschaftliche Deskription auch normativ genutzt werden.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
