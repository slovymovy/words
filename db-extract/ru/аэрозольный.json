                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5587d8ab-fe60-4b7c-8d19-a45ef50b5701",
                                                "sense_id": "d63ce353-5cea-33b8-a259-bf1010d88ad9",
                                                "text": "Examples of common aerosols are mist, fog, and smoke."
                                            },
