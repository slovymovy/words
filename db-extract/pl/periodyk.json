                                        "examples": [
                                            {
                                                "example_id": "1d4cf119-d235-42df-ad78-5fc9533d9941",
                                                "sense_id": "e60e28af-6364-3012-88ac-ae1bad2aae96",
                                                "text": "The periodical times of all the satellites."
                                            },
                                            {
                                                "example_id": "9a6708d1-0b78-4e0f-89ad-bd21b0e7896b",
                                                "sense_id": "e60e28af-6364-3012-88ac-ae1bad2aae96",
                                                "text": "Last spring, the periodical cicadas emerged across eastern North America. Their vast numbers and short above-ground life spans inspired awe and irritation in humans—and made for good meals for birds and small mammals."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "501459d3-0144-314f-a427-38b9a3dc541d",
