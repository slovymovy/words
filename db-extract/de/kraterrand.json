                "senses": [
                    {
                        "sense_id": "d57b569c-a290-3afa-8774-67f2a79c116d",
                        "entry_id": "b3018ae1-75b8-332b-93b3-199d78503e5e",
                        "glosses": [
                            "äußerer, begrenzender Bereich eines Kraters"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "41ecb25b-272f-4053-9fad-bbd82195ce9b",
                                "sense_id": "d57b569c-a290-3afa-8774-67f2a79c116d",
                                "text": "„Unter Keuchen und Stöhnen kämpfte ich mich mit Sam am Kraterrand dem Gipfel zu, vorbei an den Bismarck Towers und Stella Point bis zur Uhuru-Spitze, die damals noch Kaiser-Wilhelm-Spitze hieß.“"
                            },
                            {
                                "example_id": "5689e10e-3833-4fe6-bff5-c31654e0311b",
                                "sense_id": "d57b569c-a290-3afa-8774-67f2a79c116d",
                                "text": "„Schaudernd steht die Reisegesellschaft am Kraterrand eines noch aktiven Vulkans.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
