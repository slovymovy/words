                ],
                "senses": [
                    {
                        "sense_id": "df0e8f4e-996b-3b8e-8ffc-5d19ebe8e963",
                        "entry_id": "52ae23c5-262b-3afc-a064-4b967d682308",
                        "glosses": [
                            "höchstes akzeptables Ausmaß von etwas; höchste erträgliche Beanspruchung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "04de48b2-a8be-45bb-9c87-0b70576ea2b2",
                                "sense_id": "df0e8f4e-996b-3b8e-8ffc-5d19ebe8e963",
                                "text": "„Dort ist die Toleranzschwelle viel höher, und vermeintliche Fehltritte werden viel schneller vom Tisch geräumt.“"
                            },
                            {
                                "example_id": "28760679-35e8-4235-85a8-4973a2b5f73d",
                                "sense_id": "df0e8f4e-996b-3b8e-8ffc-5d19ebe8e963",
                                "text": "„Die Toleranzschwelle verhindert, dass ein System, das seinen kritischen Punkt überschreitet, unmittelbar kollabiert.“"
                            },
                            {
                                "example_id": "da1299ce-886a-44c6-a5a9-166bb8592cbf",
                                "sense_id": "df0e8f4e-996b-3b8e-8ffc-5d19ebe8e963",
                                "text": "„Wenn Sie kleine Mengen des kritischen Lebensmittels vertragen, sollten Sie es regelmäßig zu sich nehmen, damit Ihre Toleranzschwelle nicht absinkt.“"
                            },
                            {
                                "example_id": "2910fd9d-1b2c-47b9-a4d7-20f31b4ef83d",
                                "sense_id": "df0e8f4e-996b-3b8e-8ffc-5d19ebe8e963",
                                "text": "„Hypertaktile Kinder weisen eine niedrigere Toleranzschwelle und möglicherweise schlechte Anpassungsleistungen gegenüber Hitze oder Kälte auf.“"
                            },
                            {
                                "example_id": "1dc71b96-92b2-4783-9e67-53637c68a3a6",
                                "sense_id": "df0e8f4e-996b-3b8e-8ffc-5d19ebe8e963",
                                "text": "„Jedoch währte diese demokratische Phase nur kurz. Denn die demokratische Opposition überschritt die Toleranzschwelle, als sie 1951 die Absetzung der Regierung forderte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
