                "senses": [
                    {
                        "sense_id": "85c15cfc-dfb8-3d95-a1f8-57a03a5c9fac",
                        "entry_id": "838b6426-4334-312a-9124-8320ce9b16f3",
                        "glosses": [
                            "sozology (study of protecting the natural environment from the destructive effects of human civilization)"
                        ],
                        "tags": [
                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "7a8d234f-aa1b-4ac9-9d17-79d94a3a83ce",
                                "sense_id": "85c15cfc-dfb8-3d95-a1f8-57a03a5c9fac",
                                "text": "Sozologia, uważana za dział ekologii, jest nauką zajmującą się problemami ochrony środowiska przyrodniczego i przyczynami oraz skutkami jego przemian spowodowanych przez czynniki naturalne i antropogeniczne, określa także efektywne sposoby zapobiegania degradacji środowiska.",
                                "translation": "Sozology, considered a branch of ecology, is the science concerned with the problem of protecting the natural environment, the causes and effects of its changes caused by natural and anthropogenic factors, and discovering effective ways to prevent environmental degradation.",
                                "english": "Sozology, considered a branch of ecology, is the science concerned with the problem of protecting the natural environment, the causes and effects of its changes caused by natural and anthropogenic factors, and discovering effective ways to prevent environmental degradation."
                            }
                        ]
