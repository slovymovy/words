                ],
                "senses": [
                    {
                        "sense_id": "ec39ba13-cc7e-35d3-b8f5-90fcd048c55e",
                        "entry_id": "bdb996ae-c324-3917-94d3-ea60fcea0002",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0fbcb770-7319-40e6-a767-4f7639fda2b8",
                                "sense_id": "ec39ba13-cc7e-35d3-b8f5-90fcd048c55e",
                                "text": "Frau Boxberg ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "74db5b25-92a0-4f7a-a75f-3079fe2f268c",
                                "sense_id": "ec39ba13-cc7e-35d3-b8f5-90fcd048c55e",
                                "text": "Herr Boxberg wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "6a12ec79-1b98-4cb2-8b5e-f16b2120566b",
                                "sense_id": "ec39ba13-cc7e-35d3-b8f5-90fcd048c55e",
                                "text": "Die Boxbergs fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "fe92fcbe-5b58-49b6-bbcf-3019294cb917",
                                "sense_id": "ec39ba13-cc7e-35d3-b8f5-90fcd048c55e",
                                "text": "Der Boxberg trägt nie die Schals, die die Boxberg ihm strickt."
                            },
                            {
                                "example_id": "935403c0-3e18-4fd6-93a9-50f170862673",
                                "sense_id": "ec39ba13-cc7e-35d3-b8f5-90fcd048c55e",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Boxberg kommt, geht der Herr Boxberg.“"
                            },
                            {
                                "example_id": "1df2d1f7-6bca-4282-b543-66aa192f5f95",
                                "sense_id": "ec39ba13-cc7e-35d3-b8f5-90fcd048c55e",
                                "text": "Boxberg kommt und geht."
                            },
                            {
                                "example_id": "4b68f41a-78fe-47aa-9a58-1c0c3a30f156",
                                "sense_id": "ec39ba13-cc7e-35d3-b8f5-90fcd048c55e",
                                "text": "Boxbergs kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
