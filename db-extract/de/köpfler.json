                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9bd83c36-bd16-4c08-9619-c3ec0fbecbaa",
                                "sense_id": "0531275a-57b6-35f9-9197-d85fb333584a",
                                "text": "„[Veronika Hopfer:] ‚Es würde ja auch niemand einen Köpfler vom Kirschbaum machen.‘“"
                            }
                        ],
