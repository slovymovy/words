                                "target_senses": [
                                    {
                                        "sense_id": "13ee7cdc-c03e-3efd-b9d6-178f47406e2b",
                                        "entry_id": "d70905ee-3af6-3d96-9ae5-13d2cd3090d0",
                                        "glosses": [
                                            "тот, кто жил или живёт, существовал или существует в одно время, в одну эпоху с кем-либо, чем-либо"
                                        ],
                                        "tags": [
                                            "обычно с род. п. или притяж. местоимением"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3caf2907-209c-4541-b3c9-901f10eef767",
                                                "sense_id": "13ee7cdc-c03e-3efd-b9d6-178f47406e2b",
                                                "text": "Объёмистый труд Босуэлла на редкость точно запечатлел незаурядный джонсоновский талант парадоксального остроумия, который современники не колеблясь сравнивали с сократовским."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
