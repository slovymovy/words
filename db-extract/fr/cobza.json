                "senses": [
                    {
                        "sense_id": "14a2df36-cad7-3c30-a628-3e4f99204ab1",
                        "entry_id": "08517718-34bc-3beb-83ce-4c3da61dc5e5",
                        "glosses": [
                            "Instrument à cordes pincées à huit cordes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d62255d-3d93-4098-aae2-cf28a07de8a7",
                                "sense_id": "14a2df36-cad7-3c30-a628-3e4f99204ab1",
                                "text": "Son taraf, composé de violon, flûte de Pan et cobza, exécuta sans relâche les morceaux les plus représentatifs de l’art instrumental populaire."
                            },
                            {
                                "example_id": "53bd866f-5b8b-418c-bdea-b8bc4beeda5b",
                                "sense_id": "14a2df36-cad7-3c30-a628-3e4f99204ab1",
                                "text": "Il était le seul à avoir une cobza, moi, je n’en avais pas... il m’apprenait à poser les doigts, à garder la mesure."
                            },
                            {
                                "example_id": "441ebc87-a0ee-4f2e-a21d-50421d3ec8c7",
                                "sense_id": "14a2df36-cad7-3c30-a628-3e4f99204ab1",
                                "text": "La cobza roumaine, moldave et hongroise se rapproche de l’oud ottoman."
                            }
                        ]
                    }
                ],
