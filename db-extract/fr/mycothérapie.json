                ],
                "senses": [
                    {
                        "sense_id": "e3070611-96bb-3f4d-bcc3-0aa8543bfec5",
                        "entry_id": "327ba4a1-a992-3f8d-9e10-171cc5ffab64",
                        "glosses": [
                            "Traitement médicinal par des produits que sécrètent des champignons, particulièrement les saccharomyces et pénicillium."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "01f12c35-83f0-483f-88f0-e6821ea66897",
                                "sense_id": "e3070611-96bb-3f4d-bcc3-0aa8543bfec5",
                                "text": "La mycothérapie s’entend de l’antigénothérapie par les micro-organismes du groupe des champignons."
                            },
                            {
                                "example_id": "84d17dff-73c9-4b2c-a328-7af2f8d1a5a3",
                                "sense_id": "e3070611-96bb-3f4d-bcc3-0aa8543bfec5",
                                "text": "Ainsi créée, la mycothérapie, ou traitement par des produits que sécrètent des champignons, s’avérait bientôt l’un des plus grands enrichissements de nos moyens curateurs."
                            },
                            {
                                "example_id": "a62da67e-48e3-4a4f-a84b-853fc1fa7c27",
                                "sense_id": "e3070611-96bb-3f4d-bcc3-0aa8543bfec5",
                                "text": "Les auteurs établissent un bilan des résultats obtenus par mycothérapie dans le traitement des abcès collectés du poumon. L’évolution de 27 cas a été étudiée et a été comparée à celle de 35 autres non traités par antibiotiques."
                            },
                            {
                                "example_id": "f43ccc3a-c7a9-4405-9a8e-885f7674e1a7",
                                "sense_id": "e3070611-96bb-3f4d-bcc3-0aa8543bfec5",
                                "text": "L’avènement de la médecine allopathique a rangé aux oubliettes la mycothérapie, même si certains champignons de type saccharomyces (levure) ou pénicillium ont fourni des moyens de traitement largement employés au XXème siècle."
                            }
                        ]
                    },
                    {
                        "sense_id": "83e0d655-eba7-317f-951d-e5782299b37d",
                        "entry_id": "327ba4a1-a992-3f8d-9e10-171cc5ffab64",
                        "glosses": [
                            "Science des soins par l’emploi des champignons médicinaux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2adeaa98-a93b-4273-9ee9-f870da163ac0",
                                "sense_id": "83e0d655-eba7-317f-951d-e5782299b37d",
                                "text": "Cet ouvrage cherche à montrer la diversité de la mycothérapie, science des soins par l’emploi des champignons médicinaux."
                            }
                        ]
                    }
