                        "glosses": [
                            "mit einem goldenen Saum versehen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7cb37a63-911b-41d5-ad94-27bdda2c051c",
                                "sense_id": "a0263f3d-0fe1-30a5-9f5e-907492118811",
                                "text": "„Ich würde auf den Mitternachtssturm warten, der durch die Straßen peitscht und alle Konturen verwischt, und ich würde einem in seiner goldgesäumten Uniform gähnenden Portier mein Messer in den Rücken drücken und ihn zwingen, mich die Treppe hinaufzuführen, wo ich meine Klinge in seinem Leib versenken würde.“"
                            }
                        ],
