    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9da65f00-59ba-3dab-8f48-6333c476602a",
                    "sense_definition": "Entourer complètement quelque chose de manière à l'enclore ou à l'enfermer.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "entourer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De hautes murailles de pierre continuent d'<w>enserrer</w> la vieille ville historique."
                        },
                        {
                            "text": "Les montagnes abruptes qui <w>enserrent</w> la vallée empêchent les vents glacés d'y pénétrer."
                        }
                    ],
                    "synonyms": [
                        "ceinturer",
                        "cerner",
                        "enclore",
                        "entourer"
                    ],
                    "common_phrases": [
                        "enserrer la ville",
                        "enserrer la vallée"
                    ]
                },
                {
                    "sense_id": "674e3835-1162-3d05-b93c-b7438fdaafb0",
                    "sense_definition": "Serrer étroitement une personne ou un objet avec force, étreindre.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "serrer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il <w>enserra</w> vigoureusement son ami dans ses bras avant de lui dire adieu."
                        },
                        {
                            "text": "Une épaisse corde de chanvre lui <w>enserrait</w> les poignets et l'empêchait de bouger."
                        }
                    ],
                    "synonyms": [
                        "comprimer",
                        "étreindre",
                        "serrer"
                    ],
                    "antonyms": [
                        "desserrer",
                        "relâcher"
                    ],
                    "common_phrases": [
                        "enserrer la taille",
                        "enserrer le cou"
                    ]
                },
                {
                    "sense_id": "df6e5dac-6162-3204-86e7-fc872f40d233",
                    "sense_definition": "Mettre des plantes ou des arbustes à l'abri dans une serre.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "horticulture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Avant les premières gelées de l'hiver, le jardinier doit impérativement <w>enserrer</w> les arbustes fragiles."
                        },
                        {
                            "text": "Nous <w>enserrons</w> les orangers dès que la température nocturne chute trop rapidement."
                        }
                    ],
                    "common_phrases": [
                        "enserrer les orangers",
                        "enserrer les plantes"
                    ]
                },
                {
                    "sense_id": "1fa4072a-2bb3-34ab-b17d-058f1c82b55a",
                    "sense_definition": "Saisir ou maintenir une proie entre ses serres, en parlant d'un rapace.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "rapace",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'aigle royal <w>enserra</w> fermement le lièvre avant de reprendre son envol vers les cimes."
                        },
                        {
                            "text": "Le faucon s'est abattu sur le rongeur et l'a <w>enserré</w> sans lui laisser aucune chance."
                        }
                    ]
                }
            ]
        }
    ]
}