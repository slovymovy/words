            "pos": "verb",
            "senses": [
                {
                    "sense_id": "fd92492e-83bc-3d8b-b2a1-aed893a74abb",
                    "sense_definition": "Одерживать верх над противником в битве, соревновании, игре или споре.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "defeat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Любовь всегда <w>побеждает</w> ненависть.",
                            "target_lang_translations": {
                                "en": "Love always <w>conquers</w> hate.",
                                "es": "El amor siempre <w>vence</w> al odio.",
                                "fr": "L'amour <w>vainc</w> toujours la haine."
                            }
                        },
                        {
                            "text": "Наша футбольная команда умеет <w>побеждать</w> сильных соперников.",
                            "target_lang_translations": {
                                "en": "Our football team knows how to <w>beat</w> strong opponents.",
                                "es": "Nuestro equipo de fútbol sabe cómo <w>vencer</w> a oponentes fuertes.",
                                "fr": "Notre équipe de football sait <w>vaincre</w> des adversaires forts."
                            }
                        }
                    ],
                    "synonyms": [
                        "выигрывать",
                        "одолевать",
                        "разбивать"
                    ],
                    "antonyms": [
                        "проигрывать",
                        "уступать"
                    ],
                    "common_phrases": [
                        "побеждать врага",
                        "побеждать в войне",
                        "побеждать в игре",
                        "побеждать соперника"
                    ],
                    "target_lang_definitions": {
                        "en": "To gain the upper hand over an opponent in a battle, competition, game, or argument.",
                        "es": "Obtener la victoria sobre un oponente en una batalla, competición, juego o discusión.",
                        "fr": "Remporter la victoire sur un adversaire dans une bataille, une compétition, un jeu ou une dispute."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "defeat",
                                "target_lang_sense_clarification": "an opponent or enemy"
                            },
                            {
                                "target_lang_word": "win",
                                "target_lang_sense_clarification": "a game, war, or competition"
                            },
                            {
                                "target_lang_word": "beat",
                                "target_lang_sense_clarification": "an opponent in a sport or game"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "vencer",
                                "target_lang_sense_clarification": "superar a un rival en una contienda"
                            },
                            {
                                "target_lang_word": "ganar",
                                "target_lang_sense_clarification": "obtener el mejor resultado en una competición"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "vaincre",
                                "target_lang_sense_clarification": "un ennemi, un rival ou un concurrent"
                            },
                            {
                                "target_lang_word": "gagner",
                                "target_lang_sense_clarification": "un match, une compétition ou un jeu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bf513487-d02b-3353-b295-7f2c86a59cef",
                    "sense_definition": "Справляться с чем-либо трудным, преодолевать препятствия, чувства или болезни.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "overcome",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Человек способен <w>побеждать</w> самые тяжелые болезни.",
                            "target_lang_translations": {
                                "en": "A human is capable of <w>conquering</w> the most severe diseases.",
                                "es": "El ser humano es capaz de <w>vencer</w> las enfermedades más graves.",
                                "fr": "L'homme est capable de <w>vaincre</w> les maladies les plus graves."
                            }
                        },
                        {
                            "text": "Ему пришлось долго учиться <w>побеждать</w> свой страх перед сценой.",
                            "target_lang_translations": {
                                "en": "He had to learn for a long time how to <w>overcome</w> his stage fright.",
                                "es": "Tuvo que aprender durante mucho tiempo a <w>vencer</w> su miedo escénico.",
                                "fr": "Il a dû apprendre longtemps à <w>surmonter</w> son trac avant de monter sur scène."
                            }
                        }
                    ],
                    "synonyms": [
                        "преодолевать",
                        "превозмогать"
                    ],
                    "antonyms": [
                        "поддаваться"
                    ],
                    "common_phrases": [
                        "побеждать страх",
                        "побеждать трудности",
                        "побеждать болезнь",
                        "побеждать себя"
                    ],
                    "target_lang_definitions": {
                        "en": "To succeed in dealing with a difficulty, obstacle, emotion, or illness.",
                        "es": "Lograr superar una dificultad, obstáculo, emoción o enfermedad.",
                        "fr": "Réussir à faire face à une difficulté, un obstacle, une émotion ou une maladie."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "overcome",
                                "target_lang_sense_clarification": "a difficulty, emotion, or illness"
                            },
                            {
                                "target_lang_word": "conquer",
                                "target_lang_sense_clarification": "a fear, habit, or disease"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "vencer",
                                "target_lang_sense_clarification": "sobreponerse a un obstáculo o dificultad"
                            },
                            {
                                "target_lang_word": "superar",
                                "target_lang_sense_clarification": "sobreponerse a una dificultad o emoción"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "surmonter",
                                "target_lang_sense_clarification": "un obstacle, une difficulté ou une peur"
                            },
                            {
                                "target_lang_word": "vaincre",
                                "target_lang_sense_clarification": "une maladie, une passion ou une résistance"
                            }
                        ]
                    }
                }
            ]
        }
