                    {
                        "translation_id": "ab0bef7f-d2e0-48f5-8927-fe028cadb1f9",
                        "source_entry_id": "03657ab2-ba70-3624-a4b3-6e3d2dcb096a",
                        "target_lang_word": "shadowy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
