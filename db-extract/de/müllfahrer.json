                        "glosses": [
                            "Person, die ein Müllfahrzeug fährt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "971f1bec-fe98-45a7-b22f-e0473632de43",
                                "sense_id": "944c9b61-c95b-309d-bbd9-8cbd831f397b",
                                "text": "Der Müllfahrer achtet auf die korrekte Fahrweise seines Müllfahrzeuges im Straßenverkehr, behält seinen Kollegen, den Müllwerker, der die Mülltonnen an den Müllwagen anhängt und in diesen leert, im Blickfeld und fährt später die nächstgelegene Müllentsorgungsstelle zur Leerung an."
                            },
                            {
                                "example_id": "c0e941b7-d35a-4005-bb0e-85abb8d6c81e",
                                "sense_id": "944c9b61-c95b-309d-bbd9-8cbd831f397b",
                                "text": "„Im Prozess um fahrlässige Tötung wurde am Freitag ein Müllfahrer zu einer Strafe von 7200 Euro verurteilt.“"
                            }
                        ],
