                "senses": [
                    {
                        "sense_id": "83822f99-d121-32ef-94b4-e77b03fa96ae",
                        "entry_id": "809538e6-c814-3637-b8b9-7542e4611246",
                        "glosses": [
                            "Qui peut être nivelé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "edc810c7-c6b2-4dce-ad5b-ed15ce581673",
                                "sense_id": "83822f99-d121-32ef-94b4-e77b03fa96ae",
                                "text": "Aussi, une conscience nationale, et d’autant moins que la société est populeuse et fragmentée, est difficilement nivelable."
                            },
                            {
                                "example_id": "ed4e0873-0037-44f5-b750-8200dca5c1a3",
                                "sense_id": "83822f99-d121-32ef-94b4-e77b03fa96ae",
                                "text": "Choisissez un endroit plat ou facilement nivelable. En effet la pose des dalles de cette allée nécessite un niveau égal partout, à moins que vous ayez envie de créer une ou deux marches dans le parcours."
                            },
                            {
                                "example_id": "4de23047-bf80-4606-b40f-9bc5653eab2a",
                                "sense_id": "83822f99-d121-32ef-94b4-e77b03fa96ae",
                                "text": "En obstétrique l’activité est difficilement nivelable, explique le médecin. Il peut y avoir des gros pics d’activité, suivis de périodes plus calmes."
                            }
                        ]
                    }
                ],
