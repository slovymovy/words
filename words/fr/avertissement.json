                {
                    "sense_id": "3ed49ab0-109a-39b6-8bfd-a1f86c9cf37d",
                    "sense_definition": "Avis qui attire l'attention sur un danger ou un risque afin d'inciter à la prudence.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "mise_en_garde",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le service météorologique a diffusé un <w>avertissement</w> avant l'arrivée de la violente tempête."
                        },
                        {
                            "text": "Il est parti subitement sans le moindre <w>avertissement</w>, laissant ses collègues dans l'embarras."
                        }
                    ],
                    "common_phrases": [
                        "sans avertissement",
                        "dernier avertissement",
                        "donner un avertissement"
                    ]
                },
                {
                    "sense_id": "3e66d07a-fc56-3027-903b-6eb7a617a7a0",
                    "sense_definition": "Sanction disciplinaire ou réprimande officielle adressée à une personne pour une faute commise au travail ou à l'école.",
