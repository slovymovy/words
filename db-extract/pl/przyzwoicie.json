                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a5dcfd3-59ff-45e0-83ba-69f34576e72d",
                                                "sense_id": "6f6ee242-224d-3f5e-bf49-38f258137eb5",
                                                "text": "You need to be decently attired to enter the restaurant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "193e4bc4-34d9-31a4-8a55-f7a079fc0ebf",
                                        "entry_id": "c5e90c55-7215-35e5-a95f-3f11b7fe4388",
