                    },
                    {
                        "form_id": "b57656fc-ca17-47cd-aae6-fb4aef8e00f4",
                        "entry_id": "e725c06c-35df-35bd-8539-3a753ac6691a",
                        "tags": [
                            "positive",
                            "predicative",
                            "plural"
                        ],
                        "form": "sie sind konzeptualisierbar"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "58eefaaf-0636-36b1-8baf-0938c002ab66",
                        "entry_id": "e725c06c-35df-35bd-8539-3a753ac6691a",
                        "glosses": [
                            "so, dass es konzeptualisiert werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "09c77ad3-4528-4abf-9827-cf4d6eacbc2f",
                                "sense_id": "58eefaaf-0636-36b1-8baf-0938c002ab66",
                                "text": "„Es wird danach gefragt, inwiefern der Fortschrittsbegriff angesichts der kontemporären gesellschaftlichen Konstellation theoretisch gehaltvoll konzeptualisierbar ist.“"
                            },
                            {
                                "example_id": "4de1c6ee-b1ed-495a-9ffb-a0d443ba7d86",
                                "sense_id": "58eefaaf-0636-36b1-8baf-0938c002ab66",
                                "text": "„Die Praktiken bringen Wissen hervor, das auch im Reflexexperiment Anwendung findet und den Reflex handhabbar bzw. konzeptualisierbar macht.“"
                            },
                            {
                                "example_id": "ac83c291-59a4-4368-a7c9-5d9ec86f522e",
                                "sense_id": "58eefaaf-0636-36b1-8baf-0938c002ab66",
                                "text": "„Es ergibt sich nun mit der skizzierten Konzeption die Möglichkeit, raumliche Veränderungen und zeitliche Verläufe in eine konkrete Beziehung zueinander zu setzen. Wcsentlich dabei ist, dass Objekte selbst keine Zeiteigenschaften besitzen, sondern dass räumliche Veränderungen an Objekten mit zeitlichen Konzepten erst assoziiert werden müssen, damit ein Ereignis als solches konzeptualisierbar ist.“"
                            },
                            {
                                "example_id": "41501a2a-3089-41b8-9be5-ed5dd2894d12",
                                "sense_id": "58eefaaf-0636-36b1-8baf-0938c002ab66",
                                "text": "„»Kognitive Fehler« sind zuweilen besser als motivationale Phänomene konzeptualisierbar.“"
                            },
                            {
                                "example_id": "5d6f2fc9-4d77-4239-a7b3-976a00b52068",
                                "sense_id": "58eefaaf-0636-36b1-8baf-0938c002ab66",
                                "text": "„[Rickert] verweist damit gut kommunitaristisch auf die Bedeutung der Gemeinschaft für das Individuum, das außerhalb dieser weder praktisch lebensfähig noch theoretisch konzeptualisierbar wäre.“"
                            },
                            {
                                "example_id": "f1d7fb24-1a84-482e-a332-f4e71d133bee",
                                "sense_id": "58eefaaf-0636-36b1-8baf-0938c002ab66",
                                "text": "„Ein Stigma wird dann als schwerwiegender wahrgenommen, wenn es von Dauer ist. Für Leichte Sprache würde daraus folgen, dass sie als weniger stigmatisierend wahrgenommen würde, wenn sie als Durchgangsstufe auf dem Weg zum Standard konzeptualisierbar wäre.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
