                "senses": [
                    {
                        "sense_id": "77389790-3e55-33fe-b16b-9e582d6a34ba",
                        "entry_id": "c119be55-f413-33d0-b029-54b988052485",
                        "glosses": [
                            "принадлежащий деду"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e7a4400-6006-4ed1-bcd8-e6a7d79abd3b",
                                "sense_id": "77389790-3e55-33fe-b16b-9e582d6a34ba",
                                "text": "На бабину рожь, // На дедову пшеницу, // На девкин лён // Поливай ведром!.."
                            },
                            {
                                "example_id": "f29d5d35-2396-4f53-92a0-24ce257efc70",
                                "sense_id": "77389790-3e55-33fe-b16b-9e582d6a34ba",
                                "text": "Дед подошёл к молодому, и в тот момент, как тот заносил ногу в седло, наклонился к нему, что-то сообщая по секрету, потом тот, отвалившись от коня, прильнул к дедову плечу и крикнул перервавшимся голосом."
                            }
                        ]
                    }
                ],
