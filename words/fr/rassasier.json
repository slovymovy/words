                    "frequency": "Middle",
                    "semantic_group_id": "nourriture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce repas copieux a suffi pour <w>rassasier</w> tous les invités après la randonnée."
                        },
                        {
                            "text": "Après une longue journée sans manger, ils se sont enfin <w>rassasiés</w> au dîner."
                        }
                    ],
                    "synonyms": [
