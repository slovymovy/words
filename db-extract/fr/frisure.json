        "fr-extract.jsonl": [
            {
                "entry_id": "6789a357-86f4-3351-8705-7d3358934535",
                "word": "frisure",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "8ed4ca23-47f3-4817-8764-4c7129c5011e",
                        "entry_id": "6789a357-86f4-3351-8705-7d3358934535",
                        "tags": [
                            "plural"
                        ],
                        "form": "frisures"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "68826b81-69a6-37f8-a3d0-0eb13fc37fbe",
                        "entry_id": "6789a357-86f4-3351-8705-7d3358934535",
                        "glosses": [
                            "Façon de friser."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "27b87f37-3dca-49e8-ae4e-c87e892a374e",
                                "sense_id": "68826b81-69a6-37f8-a3d0-0eb13fc37fbe",
                                "text": "Cette frisure est belle."
                            },
                            {
                                "example_id": "bcc717ba-2d12-4d3b-8c04-75ed8344e5ed",
                                "sense_id": "68826b81-69a6-37f8-a3d0-0eb13fc37fbe",
                                "text": "En entrant tu pourrais tâter ton gousset et croire qu’on va te demander cinq francs ; mais il n’est extrait de toute espèce de poche que dix sous pour une frisure, et vingt sous pour une coiffure avec taille de cheveux."
                            }
                        ]
                    },
                    {
                        "sense_id": "80809e37-817c-3203-986f-7ff0b7933895",
                        "entry_id": "6789a357-86f4-3351-8705-7d3358934535",
                        "glosses": [
                            "État de ce qui est frisé, en parlant de la chevelure."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a1f217d0-0519-402b-9cca-41f74a283209",
                                "sense_id": "80809e37-817c-3203-986f-7ff0b7933895",
                                "text": "Le vent a dérangé ses frisures."
                            },
                            {
                                "example_id": "6d22be93-6f88-4109-9001-552bf7bc0ee7",
                                "sense_id": "80809e37-817c-3203-986f-7ff0b7933895",
                                "text": "Sa nuque penchée avait surtout une adorable jeunesse, d’une fraîcheur de lait, sous l’or des frisures folles."
                            },
                            {
                                "example_id": "9405b7d1-9f44-4e2e-b602-cdad5e012e39",
                                "sense_id": "80809e37-817c-3203-986f-7ff0b7933895",
                                "text": "Elle a perdu sa frisure de mouton, préparée par tant d’épingles doubles, et sa peau de fillette blonde miroite sur les joues comme une pomme frottée."
                            },
                            {
                                "example_id": "5dcdfcca-4e17-4303-b2d3-df4d1063485e",
                                "sense_id": "80809e37-817c-3203-986f-7ff0b7933895",
                                "text": "Le soleil brûlait le teint de la belle ; les frisures dont elle entourait son front et qu’elle avait chèrement payées chez un coiffeur de la ville, elle ne les avait plus trouvées, un beau matin, dans le tiroir où elle les plaçait chaque soir avant de se coucher."
                            },
                            {
                                "example_id": "e9b16ba9-258c-4a06-aa36-0adebd8b1e16",
                                "sense_id": "80809e37-817c-3203-986f-7ff0b7933895",
                                "text": "Ses vilaines épingles de fer quittèrent son prétentieux petit chignon, elle eut autour de sa tête sa chevelure, pas très longue, mais qu’une frisure vigoureuse répandit et enflamma."
                            },
                            {
                                "example_id": "4960b743-e456-44d9-ac8d-eeb33b94e3a1",
                                "sense_id": "80809e37-817c-3203-986f-7ff0b7933895",
                                "text": "Je voulais aussi des frisures en éponge sur le front, des ceintures de cuir à me couper le souffle, des cols baleinés, de l’essence de violette sur mes mouchoirs."
                            },
                            {
                                "example_id": "e20ba3ce-8d17-40e0-8533-965b91d1c7df",
                                "sense_id": "80809e37-817c-3203-986f-7ff0b7933895",
                                "text": "La frisure des plumes."
                            }
                        ]
                    },
                    {
                        "sense_id": "960ea8df-aa6b-3dc8-8d28-c8c4ea13f692",
                        "entry_id": "6789a357-86f4-3351-8705-7d3358934535",
                        "glosses": [
                            "Ensemble des petites boules de laine qui se forment sur un tissu quand on en frise le poil."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "6da6b95b-5cb1-3af9-8b1a-d7dab131e56f",
                        "entry_id": "6789a357-86f4-3351-8705-7d3358934535",
                        "glosses": [
                            "Fil d'or ou d'argent utilisé dans certaines broderies."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "0ff882c6-85ec-385b-93ab-a169a2fd12b8",
                        "entry_id": "6789a357-86f4-3351-8705-7d3358934535",
                        "glosses": [
                            "Feuille de vigne en gelée. ^([1]) ^([2])"
                        ],
                        "tags": [
                            "Bourgogne"
                        ],
                        "examples": []
