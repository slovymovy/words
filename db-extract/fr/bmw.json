                    {
                        "sense_id": "88d2d96b-3bed-3783-b8b0-2e3d074747ad",
                        "entry_id": "f1c8a2ac-5a65-3f75-b11c-935d2223522d",
                        "glosses": [
                            "Véhicule de la marque BMW."
