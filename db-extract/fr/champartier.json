                        "examples": [
                            {
                                "example_id": "9d5cf3cb-626f-46ad-af72-a288b013808e",
                                "sense_id": "2cc21055-519b-3676-9c76-d6a7846151e5",
                                "text": "Le seigneur champartier ne peut pas empêcher de planter des arbres en terrein tenu en champart"
                            },
                            {
                                "example_id": "cd83aa91-9cb4-494b-a5ed-c78ec8fc15b9",
                                "sense_id": "2cc21055-519b-3676-9c76-d6a7846151e5",
                                "text": "Le partage entre lui & le champartier se faisoit alors sur la totalité des fruits récoltés"
                            },
                            {
                                "example_id": "4ab6643b-3ee4-4edd-90c7-5847ab547842",
                                "sense_id": "2cc21055-519b-3676-9c76-d6a7846151e5",
                                "text": "Il suffit d’avoir appellé le champartier à la comptée des gerbes"
                            }
                        ]
                    },
