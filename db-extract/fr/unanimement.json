        "fr-extract.jsonl": [
            {
                "entry_id": "941ba577-c363-34f8-8f5f-1d6f63713d0c",
                "word": "unanimement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "ba390085-7c19-3542-b137-04490e8b9e7b",
                        "entry_id": "941ba577-c363-34f8-8f5f-1d6f63713d0c",
                        "glosses": [
                            "D’une commune voix, d’un commun sentiment."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "84c8aa1c-d5ff-4104-8cdb-2d29d8ce7912",
                                "sense_id": "ba390085-7c19-3542-b137-04490e8b9e7b",
                                "text": "La clameur fut si forte et si unanimement vocifératrice, qu'il fallut, malgré le froid, ouvrir les portières, car on ne s'entendait plus, […]."
                            },
                            {
                                "example_id": "de85fff3-46a7-48b3-b0cd-e5c7240ee2e1",
                                "sense_id": "ba390085-7c19-3542-b137-04490e8b9e7b",
                                "text": "Ils votèrent unanimement la proposition. — Cette pièce est unanimement saluée par la critique"
                            },
                            {
                                "example_id": "07583714-3b07-4ced-8e46-539832089ea2",
                                "sense_id": "ba390085-7c19-3542-b137-04490e8b9e7b",
                                "text": "La conscience de classe de la bourgeoisie n’est pas unanimement aiguë : elle n’est souvent encore qu’une conscience limitée et obscure. Elle ne saurait se passer de quelques déguisements. Elle s’efforce encore d’être justifiée selon la raison et l’éthique, aux yeux du monde et à ses yeux. Il faut voir enfin que la bourgeoisie ne se conforme pas unanimement à un ordre qu’elle saurait inhumain et nécessaire à sa domination, mais à un ordre qu’elle-même croit juste."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "09b61e00-15e3-4249-afb7-b82dfc581060",
                        "source_entry_id": "941ba577-c363-34f8-8f5f-1d6f63713d0c",
                        "source_sense_id": "ba390085-7c19-3542-b137-04490e8b9e7b",
                        "target_lang_word": "unanimously",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unanimously",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d6299dbc-1e2f-3e30-a57c-c9a7787a54ea",
                                        "entry_id": "52fdc0d0-3a23-3e24-9ebf-8c29cbcea851",
                                        "glosses": [
                                            "In a unanimous manner; without objection."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a64f5de-20c8-40e3-9484-66ab33570271",
                                                "sense_id": "d6299dbc-1e2f-3e30-a57c-c9a7787a54ea",
                                                "text": "The jury decided unanimously to convict the defendant."
                                            },
                                            {
                                                "example_id": "f4fae5cc-1eca-43ce-84f9-4500ce80166e",
                                                "sense_id": "d6299dbc-1e2f-3e30-a57c-c9a7787a54ea",
                                                "text": "The US supreme court has ruled unanimously that natural human genes cannot be patented, a decision that scientists and civil rights campaigners said removed a major barrier to patient care and medical innovation."
                                            },
                                            {
                                                "example_id": "94e2f7bd-6ff1-4b67-a0ca-551af6ecba9a",
                                                "sense_id": "d6299dbc-1e2f-3e30-a57c-c9a7787a54ea",
                                                "text": "The U.S. Congress on Monday presented the Taiwan Allies International Protection and Enhancement Initiative (TAIPEI) Act of 2019 to President Donald Trump for signing into law, after it was passed unanimously by both chambers of Congress earlier this month."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
