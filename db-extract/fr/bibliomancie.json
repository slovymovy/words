                        "translation_id": "098c3965-902e-490e-903b-4266b4fd19a2",
                        "source_entry_id": "79475574-7e25-3a31-bb87-bf8cd5184d9b",
                        "source_sense_id": "990e36ff-afd1-3622-8713-3ade17aee42c",
