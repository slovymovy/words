                            }
                        },
                        {
                            "text": "Dla wszystkich obecnych ta <w>oczywistość</w> była zupełnie zrozumiała.",
                            "target_lang_translations": {
                                "ru": "Для всех присутствующих эта <w>очевидность</w> была совершенно понятна."
                            }
