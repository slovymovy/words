                                        "sense_id": "f0e35757-2ac0-396e-90b7-b1ebbe42cd79",
                                        "entry_id": "ead9c81d-7213-374d-9acd-c1fea7c6ea53",
                                        "glosses": [
                                            "Synonym of quadrivium."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7ca6ccff-81d8-445f-9151-9b2e5c162350",
                                                "sense_id": "f0e35757-2ac0-396e-90b7-b1ebbe42cd79",
                                                "text": "Church music was carefully taught at the universities. IT was of the four sciences of the quadrium, and was a means of promotion in the church and colleges."
                                            },
                                            {
                                                "example_id": "8b3f63d7-e54a-4ef9-b0b0-b73f2b879f0b",
                                                "sense_id": "f0e35757-2ac0-396e-90b7-b1ebbe42cd79",
                                                "text": "He describes how by the late fifteenth century the language arts of the trivium had come to seem useful only for communication, teaching and public debate, and how humanists turned to the mathematical arts of the quadrium - including music - to enable new means and methods of discovery."
                                            },
                                            {
                                                "example_id": "ee67f846-3882-4249-9aeb-476701cc28a6",
                                                "sense_id": "f0e35757-2ac0-396e-90b7-b1ebbe42cd79",
                                                "text": "The classical curriculum distinguishes between trivium and quadrium to classify knowledge fields in education. Trivium deals with the disciplines of language, grammar, rhetoric, dialectic and logic, while quadrium deals with the sciences of arithmetic, geometry and astronomy."
                                            }
                                        ]
                                    }
                                ]
                            },
