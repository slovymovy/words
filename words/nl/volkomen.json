        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e77669a8-a88f-3937-bef9-cb4d5b0efa88",
                    "sense_definition": "Helemaal vol raken.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "fill_up",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De zaal <w>volkwam</w> langzaam met wachtende mensen.",
                            "target_lang_translations": {
                                "ru": "Зал медленно <w>наполнялся</w> ожидающими людьми.",
                                "en": "The hall slowly <w>filled up</w> with waiting people.",
                                "fr": "La salle <w>s'emplissait</w> lentement de personnes qui attendaient."
                            }
                        },
                        {
                            "text": "Door de aanhoudende regen <w>volkwamen</w> de sloten in de polder.",
                            "target_lang_translations": {
                                "ru": "Из-за непрекращающегося дождя канавы в польдере <w>переполнились</w>.",
                                "en": "Due to the persistent rain, the ditches in the polder <w>filled up</w>.",
                                "fr": "À cause de la pluie continue, les fossés du polder <w>se remplirent</w> complètement."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Становиться полностью заполненным.",
                        "en": "To become completely full.",
                        "fr": "Devenir entièrement plein ; se remplir complètement."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наполняться",
                                "target_lang_sense_clarification": "становиться полным"
                            },
