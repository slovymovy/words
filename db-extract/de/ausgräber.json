                ],
                "senses": [
                    {
                        "sense_id": "a6ee8382-9be8-36db-814f-a104123bd23d",
                        "entry_id": "271af897-484a-36c4-ba8a-48c8051f9026",
                        "glosses": [
                            "Archäologe, der eine Ausgrabung vornimmt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a4983499-a194-42ce-ab18-8d421dcfc4c7",
                                "sense_id": "a6ee8382-9be8-36db-814f-a104123bd23d",
                                "text": "„Französische Ausgräber konnten nachweisen, dass der Kaiser innerhalb kurzer Zeit einen 160 mal 110 Meter großen Tempel auf dem Palatin errichten ließ.“"
                            },
                            {
                                "example_id": "cb2c7325-02be-4312-b100-c09151e598c1",
                                "sense_id": "a6ee8382-9be8-36db-814f-a104123bd23d",
                                "text": "„Die undurchsichtigen Vorgänge von der Levanteküste haben bei Althistorikern, Ausgräbern und Kunstgeschichtlern Unbehagen ausgelöst.“"
                            },
                            {
                                "example_id": "93db0c02-b7fa-4cae-9d38-92dfb197170f",
                                "sense_id": "a6ee8382-9be8-36db-814f-a104123bd23d",
                                "text": "„Die Ausgräber deckten rund 275000 Tierknochen auf, den größten Anteil bildeten Reste von Schweinen, Rindern, Schafen, Ziegen, Hunden, Pferden und Hühnern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
