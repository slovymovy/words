                                                "example_id": "ec235223-747b-4899-a2ef-a23286c045a6",
                                                "sense_id": "038128cb-fde5-33dc-97b5-7de3bf889326",
                                                "text": "I can't see near objects very clearly without my glasses."
                                            },
                                            {
                                                "example_id": "1e371721-8702-4ea3-bac1-5ed9db4f040f",
                                                "sense_id": "038128cb-fde5-33dc-97b5-7de3bf889326",
                                                "text": "Stay near at all times."
