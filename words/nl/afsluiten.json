    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9f5a4490-7d17-3643-81ea-1e5f5e4d274c",
                    "sense_definition": "Zorgen dat iets of iemand niet in, uit of door iets kan gaan door openingen dicht te doen of de toegang te blokkeren.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "toegang blokkeren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De politie moest de weg <w>afsluiten</w> na een ernstig ongeluk.",
                            "target_lang_translations": {
                                "en": "The police had to <w>close off</w> the road after a serious accident.",
                                "ru": "Полиции пришлось <w>перекрыть</w> дорогу после серьезной аварии."
                            }
                        },
                        {
                            "text": "De waterkering <w>sluit</w> het IJsselmeer <w>af</w> van de Waddenzee.",
                            "target_lang_translations": {
                                "en": "The flood barrier <w>shuts off</w> the IJsselmeer from the Wadden Sea.",
                                "ru": "Дамба <w>отделяет</w> Эйсселмер от Ваттового моря."
                            }
                        }
                    ],
                    "synonyms": [
                        "dichtdoen",
                        "dichtmaken",
                        "blokkeren"
                    ],
                    "antonyms": [
                        "openen",
                        "openstellen"
                    ],
                    "common_phrases": [
                        "de weg afsluiten",
                        "een gebied afsluiten"
                    ],
                    "target_lang_definitions": {
                        "en": "To ensure that something or someone cannot enter, leave, or pass through by closing openings or blocking access.",
                        "ru": "Обеспечить невозможность входа, выхода или прохода для кого-либо или чего-либо путем закрытия отверстий или блокирования доступа."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "close off",
                                "target_lang_sense_clarification": "to block access to a road or area"
                            },
                            {
                                "target_lang_word": "shut off",
                                "target_lang_sense_clarification": "to block or seal an opening"
                            },
                            {
                                "target_lang_word": "block",
                                "target_lang_sense_clarification": "to obstruct a passage"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "перекрывать",
                                "target_lang_sense_clarification": "блокировать движение по дороге или доступ к территории"
                            },
                            {
                                "target_lang_word": "закрывать",
                                "target_lang_sense_clarification": "преграждать доступ или проход"
                            },
                            {
                                "target_lang_word": "изолировать",
                                "target_lang_sense_clarification": "отделять одну область от другой"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "88e85253-ec13-38e8-8b27-275b3ee87451",
                    "sense_definition": "Een activiteit, periode of proces tot een einde brengen.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "beëindigen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We <w>sluiten</w> het feest <w>af</w> met een prachtig vuurwerk.",
                            "target_lang_translations": {
                                "en": "We are <w>concluding</w> the party with a beautiful fireworks display.",
                                "ru": "Мы <w>завершаем</w> праздник красивым фейерверком."
                            }
                        },
                        {
                            "text": "Zij wil haar studie dit jaar succesvol <w>afsluiten</w>.",
                            "target_lang_translations": {
                                "en": "She wants to <w>finish</w> her studies successfully this year.",
                                "ru": "Она хочет успешно <w>закончить</w> учебу в этом году."
                            }
                        }
                    ],
                    "synonyms": [
                        "besluiten",
                        "voltooien",
                        "beëindigen"
                    ],
                    "antonyms": [
                        "beginnen",
                        "openen"
                    ],
                    "common_phrases": [
                        "een hoofdstuk afsluiten",
                        "de dag afsluiten"
                    ],
                    "target_lang_definitions": {
                        "en": "To bring an activity, period, or process to an end.",
                        "ru": "Довести деятельность, период или процесс до завершения."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "conclude",
                                "target_lang_sense_clarification": "to formally end an event or period"
                            },
                            {
                                "target_lang_word": "finish",
                                "target_lang_sense_clarification": "to complete a task or activity"
                            },
                            {
                                "target_lang_word": "wrap up",
                                "target_lang_sense_clarification": "to bring something to a final close"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "завершать",
                                "target_lang_sense_clarification": "официально или торжественно заканчивать мероприятие"
                            },
                            {
                                "target_lang_word": "заканчивать",
                                "target_lang_sense_clarification": "доводить до конца задачу или период"
                            },
                            {
                                "target_lang_word": "подводить итог",
                                "target_lang_sense_clarification": "финализировать процесс"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "02f5a75d-8bcd-331e-be87-116f1b02498a",
                    "sense_definition": "Een officiële overeenkomst of contract formeel regelen en ondertekenen.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "overeenkomst",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je moet een goede verzekering <w>afsluiten</w> voordat je op reis gaat.",
                            "target_lang_translations": {
                                "en": "You must <w>take out</w> good insurance before you go on a trip.",
                                "ru": "Тебе нужно <w>оформить</w> хорошую страховку перед поездкой."
                            }
                        },
                        {
                            "text": "Zij gaan morgen een nieuw contract <w>afsluiten</w> voor hun woning.",
                            "target_lang_translations": {
                                "en": "They are going to <w>conclude</w> a new contract for their home tomorrow.",
                                "ru": "Завтра они собираются <w>заключить</w> новый контракт на жилье."
                            }
                        }
                    ],
                    "antonyms": [
                        "opzeggen"
                    ],
                    "common_phrases": [
                        "een verzekering afsluiten",
                        "een lening afsluiten",
                        "een contract afsluiten"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vaak gebruikt in zakelijke of juridische context"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To formally arrange and sign an official agreement or contract.",
                        "ru": "Формально оформить и подписать официальное соглашение или контракт."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "take out",
                                "target_lang_sense_clarification": "specifically for insurance or loans"
                            },
                            {
                                "target_lang_word": "conclude",
                                "target_lang_sense_clarification": "to finalize a formal agreement"
                            },
                            {
                                "target_lang_word": "enter into",
                                "target_lang_sense_clarification": "to formally start a contract"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "заключать",
                                "target_lang_sense_clarification": "о договоре, контракте или страховке"
                            },
                            {
                                "target_lang_word": "оформлять",
                                "target_lang_sense_clarification": "официально регистрировать сделку или кредит"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "840dc5fb-311a-32d7-a3b5-6ae51c1811a7",
                    "sense_definition": "De toevoer van nutsvoorzieningen of technische verbindingen verbreken.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "verbinding verbreken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Gas en elektra zijn al <w>afgesloten</w> omdat we gaan verhuizen.",
                            "target_lang_translations": {
                                "en": "Gas and electricity have already been <w>disconnected</w> because we are moving.",
                                "ru": "Газ и электричество уже <w>отключены</w>, так как мы переезжаем."
                            }
                        },
                        {
                            "text": "Het bedrijf dreigt het internet <w>af te sluiten</w> als de rekening niet wordt betaald.",
                            "target_lang_translations": {
                                "en": "The company is threatening to <w>cut off</w> the internet if the bill is not paid.",
                                "ru": "Компания угрожает <w>отключить</w> интернет, если счет не будет оплачен."
                            }
                        }
                    ],
                    "antonyms": [
                        "aansluiten"
                    ],
                    "common_phrases": [
                        "gas en licht afsluiten",
                        "het water afsluiten"
                    ],
                    "target_lang_definitions": {
                        "en": "To sever the supply of utilities or technical connections.",
                        "ru": "Прекратить подачу коммунальных услуг или технических соединений."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "disconnect",
                                "target_lang_sense_clarification": "to sever a connection or utility"
                            },
                            {
                                "target_lang_word": "cut off",
                                "target_lang_sense_clarification": "to stop the supply of gas, water, or electricity"
                            },
                            {
                                "target_lang_word": "shut off",
                                "target_lang_sense_clarification": "to turn off a supply valve or switch"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "отключать",
                                "target_lang_sense_clarification": "прекращать подачу газа, воды или электричества"
                            },
                            {
                                "target_lang_word": "перекрывать",
                                "target_lang_sense_clarification": "останавливать поток воды или газа с помощью крана"
                            },
                            {
                                "target_lang_word": "разрывать соединение",
                                "target_lang_sense_clarification": "о технической связи или интернете"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4d766b9a-e141-38c0-ad55-0146d327c8b2",
                    "sense_definition": "Zichzelf mentaal of sociaal isoleren van de omgeving of van anderen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "isolatie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij <w>sloot</w> zich <w>af</w> voor al het lawaai om zich te concentreren.",
                            "target_lang_translations": {
                                "en": "He <w>shut himself off</w> from all the noise in order to concentrate.",
                                "ru": "Он <w>отгородился</w> от всего шума, чтобы сосредоточиться."
                            }
                        },
                        {
                            "text": "Soms is het nodig om je even <w>af te sluiten</w> van de buitenwereld.",
                            "target_lang_translations": {
                                "en": "Sometimes it is necessary to <w>cut yourself off</w> from the outside world for a moment.",
                                "ru": "Иногда нужно ненадолго <w>изолироваться</w> от внешнего мира."
                            }
                        }
                    ],
                    "antonyms": [
                        "openstellen"
                    ],
                    "common_phrases": [
                        "zich afsluiten voor",
                        "zich afsluiten van"
                    ],
                    "target_lang_definitions": {
                        "en": "To mentally or socially isolate oneself from the environment or from others.",
                        "ru": "Психологически или социально изолировать себя от окружения или других людей."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "shut oneself off",
                                "target_lang_sense_clarification": "to isolate oneself from others"
                            },
                            {
                                "target_lang_word": "cut oneself off",
                                "target_lang_sense_clarification": "to withdraw from social contact"
                            },
                            {
                                "target_lang_word": "close oneself off",
                                "target_lang_sense_clarification": "to become emotionally unavailable"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "отгораживаться",
                                "target_lang_sense_clarification": "создавать психологический барьер"
                            },
                            {
                                "target_lang_word": "замыкаться",
                                "target_lang_sense_clarification": "уходить в себя, переставать общаться"
                            },
                            {
                                "target_lang_word": "изолироваться",
                                "target_lang_sense_clarification": "отстраняться от внешнего мира"
                            }
                        ]
                    }
                }
            ]
        }
    ]
