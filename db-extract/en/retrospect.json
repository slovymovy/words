                                        "sense_id": "6435f405-9fcb-33f8-ba8e-b2b851eccf72",
                                        "entry_id": "52c8f276-699e-3f28-be6d-a17d95355ea7",
                                        "glosses": [
                                            "bewusste Erinnerung an Vergangenes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "afcb3a5e-b6d8-40b1-bd01-1dacb3eed595",
                                                "sense_id": "6435f405-9fcb-33f8-ba8e-b2b851eccf72",
                                                "text": "„Bescheidenheit lehrt ein kurzer Rückblick auf die reichhaltigen Überlieferungen aus früheren Epochen.“"
                                            },
                                            {
                                                "example_id": "85066508-48d6-4486-aea5-ab88ad1c5984",
                                                "sense_id": "6435f405-9fcb-33f8-ba8e-b2b851eccf72",
                                                "text": "„Verständlich werden diese Wendungen erst durch den Rückblick auf das 19. Jahrhundert.“"
                                            },
                                            {
                                                "example_id": "9b6aacb6-86b5-4f56-b97e-cced6464caa9",
                                                "sense_id": "6435f405-9fcb-33f8-ba8e-b2b851eccf72",
                                                "text": "„Das alles denke ich mir im Rückblick auf diese ferne Zeit, und über Spekulationen gelangen meine Gedanken nicht hinaus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b843db62-5bf9-33b0-a59c-78c76fd423d8",
                                        "entry_id": "52c8f276-699e-3f28-be6d-a17d95355ea7",
                                        "glosses": [
                                            "Bericht über etwas Abgeschlossenes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "600a7cc8-4153-4617-b5d5-c7d2402a054f",
                                                "sense_id": "b843db62-5bf9-33b0-a59c-78c76fd423d8",
                                                "text": "Auf der Jahreshauptversammlung gab der Vorsitzende einen Rückblick auf die Aktivitäten des Vereins im vergangenen Jahr."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
