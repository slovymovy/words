                "senses": [
                    {
                        "sense_id": "e180b89e-9955-31d7-9e5b-af5b8a4f4713",
                        "entry_id": "8dd8e193-c1d2-3b8a-ab68-2b896db2a0ce",
                        "glosses": [
                            "Band, das als Schutz um den Unterleib geschlungen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "35e1e6d5-e228-4518-a2df-02c55b8d7ddb",
                                "sense_id": "e180b89e-9955-31d7-9e5b-af5b8a4f4713",
                                "text": "„Sie wollen für Frau Hoppe, die ältere, eine Leibbinde besorgen, weil sie eine Anlage zum Nabelbruch hat.“"
                            },
                            {
                                "example_id": "4992ea8a-36ca-4805-9e61-467b091862ae",
                                "sense_id": "e180b89e-9955-31d7-9e5b-af5b8a4f4713",
                                "text": "„Kurz, nach einem halben Monat machte sich sein kleiner Wicht bei Annäherung weiblicher Wesen derart mausig und benahm sich derart aufgeregt und zappelig, daß er nicht umhin konnte, ihn trotz sengender Hitze in eine Leibbinde zu packen, um ihn etwaigen fürwitzigen Weiberblicken zu entziehen.“"
                            },
                            {
                                "example_id": "8862ecbd-96aa-4829-8073-cc3bbe3024ad",
                                "sense_id": "e180b89e-9955-31d7-9e5b-af5b8a4f4713",
                                "text": "„Gorju, in kurzer blauer Jacke mit einer Leibbinde um die Hüften, führte die Bewegungen aus wie ein Automat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
