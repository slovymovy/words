                    },
                    {
                        "translation_id": "43437996-0c6a-4a50-9705-89fdda593fc8",
                        "source_entry_id": "8dba29a0-dc27-3b7f-9271-abf195d3768f",
                        "source_sense_id": "fff6692f-b2cd-399d-b38b-594383e90225",
                        "source_sense_description": "Frau, die als Zeugin an einer Trauung teilnimmt",
                        "target_lang_word": "témoin de mariage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "2708f426-5d29-49ab-9117-fa21e0dde441",
                        "source_entry_id": "8dba29a0-dc27-3b7f-9271-abf195d3768f",
                        "source_sense_id": "fff6692f-b2cd-399d-b38b-594383e90225",
                        "source_sense_description": "Frau, die als Zeugin an einer Trauung teilnimmt",
                        "target_lang_word": "témoin",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "témoin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2dc5fd5e-e8d3-3e71-9819-f85b9b3a7181",
                                        "entry_id": "a9382a69-291c-3ef2-a3b5-931e2fd50b87",
                                        "glosses": [
                                            "Personne qui certifie ou qui peut certifier une chose qu’elle a vue ou entendue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b4cecb0-2be5-4820-8338-47fa52a1d44f",
                                                "sense_id": "2dc5fd5e-e8d3-3e71-9819-f85b9b3a7181",
                                                "text": "Mais montrez-nous d’abord un louche, un bègue, puis opérez-les, et rendez-nous ensuite témoins des résultats de vos opérations sur ce bègue, sur ce louche; alors, si vous réussissez, il ne pourra plus rester de doute; les plus incrédules seront forcés de rendre les armes et de constater vos succès."
                                            },
                                            {
                                                "example_id": "9fe301a4-7bb2-496c-97b2-b126c23b2e78",
                                                "sense_id": "2dc5fd5e-e8d3-3e71-9819-f85b9b3a7181",
                                                "text": "C’est lui qui, au Palais, dans la salle des témoins, durant les Assises, a eu cette phrase pour faire avouer à un gros type qu’il était bien lui, le gros, l’auteur du crime qu’on imputait à l’autre, entre les deux cipaux."
                                            },
                                            {
                                                "example_id": "6b3c0ce4-9d41-4c0b-8680-f2681dfd3f87",
                                                "sense_id": "2dc5fd5e-e8d3-3e71-9819-f85b9b3a7181",
                                                "text": "« C’est un crime que d’effacer les empreintes successives imprimées dans la pierre par la main et l’âme de nos aïeux. Les pierres neuves taillées dans un vieux style sont de faux témoins. »"
                                            },
                                            {
                                                "example_id": "3bffa3e0-6b28-44fa-86bb-83f0aef51a48",
                                                "sense_id": "2dc5fd5e-e8d3-3e71-9819-f85b9b3a7181",
                                                "text": "Seuls les faux témoins narrent exactement la même histoire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d4402059-ab32-3c20-8e53-993a4eff9906",
                                        "entry_id": "a9382a69-291c-3ef2-a3b5-931e2fd50b87",
                                        "glosses": [
                                            "Chose qui peut servir d’indice, ou d’une sorte de preuve, ordinairement dans une affaire criminelle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "65e6a411-a29e-4b04-8b2d-e2bd46dd3a8b",
                                                "sense_id": "d4402059-ab32-3c20-8e53-993a4eff9906",
                                                "text": "Son épée ensanglantée, trouvée dans la chambre du mort, fut un témoin muet contre lui."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2c4ac510-25f4-3cb5-ad2f-a6ef14a15e30",
                                        "entry_id": "a9382a69-291c-3ef2-a3b5-931e2fd50b87",
                                        "glosses": [
                                            "Personnes dont on se fait assister pour certains actes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ca8ff35-dabf-4458-b36e-e938ae2c80de",
                                                "sense_id": "2c4ac510-25f4-3cb5-ad2f-a6ef14a15e30",
                                                "text": "Il a été à la mairie avec deux témoins pour la déclaration de naissance."
                                            },
                                            {
                                                "example_id": "d9435d04-1a9c-47fb-b5ea-5857c1597c0c",
                                                "sense_id": "2c4ac510-25f4-3cb5-ad2f-a6ef14a15e30",
                                                "text": "Servir de témoin pour un mariage, pour un testament."
                                            },
                                            {
                                                "example_id": "f210091a-2103-439c-9dcb-121fbf16382c",
                                                "sense_id": "2c4ac510-25f4-3cb5-ad2f-a6ef14a15e30",
                                                "text": "En présence de quatre témoins."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "23580529-f356-3306-85c4-b6e93179d33e",
                                        "entry_id": "a9382a69-291c-3ef2-a3b5-931e2fd50b87",
                                        "glosses": [
                                            "Ceux qui accompagnent un homme qui doit se battre en duel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c81fac43-fd8a-42b9-8e06-726f6549aecb",
                                                "sense_id": "23580529-f356-3306-85c4-b6e93179d33e",
                                                "text": "Je me nomme Gaston Meyrol, rue de Provence, 50... demain matin je vous enverrai mes témoins..."
                                            },
                                            {
                                                "example_id": "522e86dd-42bf-4708-bd94-8ea0babb91f7",
                                                "sense_id": "23580529-f356-3306-85c4-b6e93179d33e",
                                                "text": "Les témoins ont arrangé l’affaire, et le duel n’a point eu lieu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dd7e98a1-f314-3c45-bc87-db07944db5a3",
                                        "entry_id": "a9382a69-291c-3ef2-a3b5-931e2fd50b87",
                                        "glosses": [
                                            "Celui ou celle qui voit quelque chose, qui en est spectateur, ou qui l’entend."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e0bb4df-3a20-4e5a-aec3-8caca8f26826",
                                                "sense_id": "dd7e98a1-f314-3c45-bc87-db07944db5a3",
                                                "text": "Cette querelle eut pour témoins un grand nombre de personnes."
                                            },
                                            {
                                                "example_id": "6d74dce4-7432-40f7-938f-3d3e2ef5251e",
                                                "sense_id": "dd7e98a1-f314-3c45-bc87-db07944db5a3",
                                                "text": "Elle a été témoin de cette scène."
                                            },
                                            {
                                                "example_id": "b078217d-2121-44af-a744-65655961fbdb",
                                                "sense_id": "dd7e98a1-f314-3c45-bc87-db07944db5a3",
                                                "text": "Je ne voulus pas être témoin de ces horreurs."
                                            },
                                            {
                                                "example_id": "4de10fe6-84b8-49c3-94d5-b3a992e27cbd",
                                                "sense_id": "dd7e98a1-f314-3c45-bc87-db07944db5a3",
                                                "text": "Leur entrevue devait avoir lieu sans témoins."
                                            },
                                            {
                                                "example_id": "bdc3a86b-2879-401c-b03e-53e2d6587595",
                                                "sense_id": "dd7e98a1-f314-3c45-bc87-db07944db5a3",
                                                "text": "Dieu m’est témoin, Dieu m’en est témoin.",
                                                "translation": "Dieu sait que ce que je dis est véritable."
                                            },
                                            {
                                                "example_id": "7c3c2d5e-21b2-4794-898d-deef92b3be8b",
                                                "sense_id": "dd7e98a1-f314-3c45-bc87-db07944db5a3",
                                                "text": "— Dieu m’est témoin, continua-t-il, que je n’envie et que je ne déteste personne."
                                            },
                                            {
                                                "example_id": "dddc598e-6822-46c6-be24-d50c36172a7f",
                                                "sense_id": "dd7e98a1-f314-3c45-bc87-db07944db5a3",
                                                "text": "Oui, j’ai eu cela dans l’esprit mais Dieu m’en est témoin, pas pour m’en réjouir, parce qu’il était impossible que maman n’y pensât pas, elle aussi, avec sa passion maniaque de la terre, qu’elle n’en fût pas obscurément touchée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "78ac7860-080a-3057-8fe7-9c2de5316dc1",
                                        "entry_id": "a9382a69-291c-3ef2-a3b5-931e2fd50b87",
                                        "glosses": [
                                            "Témoignage, marque, monument, ce qui sert à faire connaître."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "22a872d1-7a46-42fc-9162-62535f839270",
                                                "sense_id": "78ac7860-080a-3057-8fe7-9c2de5316dc1",
                                                "text": "Telles et telles églises sont les témoins de la piété."
                                            },
                                            {
                                                "example_id": "859fca4a-e96e-4ee4-96be-9dcc2e3beaa6",
                                                "sense_id": "78ac7860-080a-3057-8fe7-9c2de5316dc1",
                                                "text": "Le Colisée est encore aujourd’hui un témoin de la magnificence romaine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "263c4c28-8f45-3d74-b25f-7e05f23c6075",
                                        "entry_id": "a9382a69-291c-3ef2-a3b5-931e2fd50b87",
                                        "glosses": [
                                            "Personne, typiquement de l’extérieur, qui assiste devant certaines instances (telles qu’un comité parlementaire) pour y exposer des faits ou opinions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1bd3978f-398e-4859-a981-e0aec77d59f4",
                                                "sense_id": "263c4c28-8f45-3d74-b25f-7e05f23c6075",
                                                "text": "Afin de recueillir le plus d’information possible sur un sujet à l’étude, les comités invitent régulièrement des particuliers, des experts dans différents domaines, des représentants de groupes ou d’organisations, des lobbyistes, des fonctionnaires et des ministres à témoigner devant eux… Les comités choisissent leurs témoins en fonction d’un certain nombre de critères, notamment leurs connaissances de la question et l’intérêt qu’ils portent à celle-ci."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5b52d424-bf5a-39b6-a8ef-d5a8724d4618",
                                        "entry_id": "a9382a69-291c-3ef2-a3b5-931e2fd50b87",
                                        "glosses": [
                                            "Chose qui sert à prouver ce qu’on vient d’avancer ; il est alors invariable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ecedb03a-4bc1-461b-a307-22f84090dcd8",
                                                "sense_id": "5b52d424-bf5a-39b6-a8ef-d5a8724d4618",
                                                "text": "Témoin ce qui est arrivé."
                                            },
                                            {
                                                "example_id": "ea4d9efb-7771-4812-b084-1530970d879e",
                                                "sense_id": "5b52d424-bf5a-39b6-a8ef-d5a8724d4618",
                                                "text": "Témoin les blessures dont il est encore tout couvert."
                                            },
                                            {
                                                "example_id": "a7a854df-65de-4109-8419-71a3413815c6",
                                                "sense_id": "5b52d424-bf5a-39b6-a8ef-d5a8724d4618",
                                                "text": "Et ces soldats, tant glorifiés depuis, étaient menés comme des forçats, à cela près qu’on leur donnait rarement à manger. Il est vrai qu’ils étaient parfois d’humeur difficile. Témoin les trois cents canonniers de la 33e demi-brigade qui, l’an IV, à Mantoue, réclamèrent leur solde en braquant leurs pièces sur leurs généraux."
                                            },
                                            {
                                                "example_id": "0b990216-11d6-48f0-a1a0-e2480424723f",
                                                "sense_id": "5b52d424-bf5a-39b6-a8ef-d5a8724d4618",
                                                "text": "Suivant le diplomate, il n’était pas difficile d’accepter la mort, témoin ceux qui se battent en duel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "27615100-efbd-3346-8f5f-ea470f9be794",
                                        "entry_id": "a9382a69-291c-3ef2-a3b5-931e2fd50b87",
                                        "glosses": [
                                            "Objet ou partie qui sert de témoignage, de marque. Il se dit spécialement de petits morceaux de tuile, d’ardoise, etc., qu’on enterre sous les bornes d’un champ afin de connaître dans la suite si ces bornes n’ont point été déplacées."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2475c0b7-b587-4e4d-b378-ac62ab2a4632",
                                                "sense_id": "27615100-efbd-3346-8f5f-ea470f9be794",
                                                "text": "On a retrouvé les véritables limites de ce champ, par le moyen des témoins."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e3d32921-9eb3-3b84-b94d-7fb6fe3424b4",
                                        "entry_id": "a9382a69-291c-3ef2-a3b5-931e2fd50b87",
                                        "glosses": [
                                            "Certaines buttes ou élévations de terre, qu’on laisse pour faire voir de quelle hauteur étaient les terres qu’on a enlevées tout autour."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f44c01e9-a726-4ad7-b3ee-662a617a2d68",
                                                "sense_id": "e3d32921-9eb3-3b84-b94d-7fb6fe3424b4",
                                                "text": "Les témoins qu’on a laissés marquent quel travail il a fallu faire pour mettre toutes ces terres de niveau."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f86494c1-bb0f-32da-9b37-7b32592f48a0",
                                        "entry_id": "a9382a69-291c-3ef2-a3b5-931e2fd50b87",
                                        "glosses": [
                                            "Il se dit d’arbres qu’il est défendu d’abattre, dans les ventes."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f1c91a37-f604-39f9-bbdf-a19bdc75bc3a",
                                        "entry_id": "a9382a69-291c-3ef2-a3b5-931e2fd50b87",
                                        "glosses": [
                                            "Marque placée sur une pièce d’usure (industrie, technique) ou une partie d’un bâtiment pour permettre de constater les progrès de certaines détériorations, telles que l’usure, des lézardes, des fléchissements, etc."
                                        ],
                                        "tags": [
                                            "Industrie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "23272eb5-bed4-489c-b2c5-a9caca87afd8",
                                                "sense_id": "f1c91a37-f604-39f9-bbdf-a19bdc75bc3a",
                                                "text": "L’état des pneus et des plaquettes de frein est indiqué par leurs témoins d’usure."
                                            },
                                            {
                                                "example_id": "a71c3a1e-dd47-414c-beca-eed772146546",
                                                "sense_id": "f1c91a37-f604-39f9-bbdf-a19bdc75bc3a",
                                                "text": "Les témoins sur le mur attestent la progression des fissures."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "77f3f471-71e8-3249-bcf4-aebfa410715d",
                                        "entry_id": "a9382a69-291c-3ef2-a3b5-931e2fd50b87",
                                        "glosses": [
                                            "Échantillon (normalement plusieurs) servant de référence, de comparaison pour une expérience (en biologie : animaux ou plantes)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "67831fd0-2c27-4e33-8cfc-2dfa16a05ba5",
                                                "sense_id": "77f3f471-71e8-3249-bcf4-aebfa410715d",
                                                "text": "On a constaté après traitement de surface une forte amélioration de la résistance à la corrosion par rapport aux échantillons témoins non traités."
                                            },
                                            {
                                                "example_id": "4c89378e-96eb-4113-a95e-9cfc886b9512",
                                                "sense_id": "77f3f471-71e8-3249-bcf4-aebfa410715d",
                                                "text": "Un cobaye témoin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "710f6f30-d3b3-3d9a-80f9-1d4fd7152f03",
                                        "entry_id": "a9382a69-291c-3ef2-a3b5-931e2fd50b87",
                                        "glosses": [
                                            "Feuillets d’un livre qui n’ont pas été rognés par le relieur et qui montrent quelle était la marge du volume."
                                        ],
                                        "tags": [
                                            "Livre"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "497a3285-dc2c-3cfd-832c-ceb112aac23c",
                                        "entry_id": "a9382a69-291c-3ef2-a3b5-931e2fd50b87",
                                        "glosses": [
                                            "Sur une machine ou dans un logiciel, affichage ou signal (typiquement un bloc à diodes électroluminescentes appelé témoin lumineux ou un avertisseur sonore – bip, alarme ou autre) qui donne une information particulière (niveau, état, activité ou autre)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96cada1c-1a67-4205-942f-f4aaf2787303",
                                                "sense_id": "497a3285-dc2c-3cfd-832c-ceb112aac23c",
                                                "text": "Maintenez la touche marche/arrêt enfoncée pendant trois secondes pour activer le mode appariement. Le témoin lumineux clignote alors en vert et vous pouvez entrer le code situé au dos du second récepteur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "28e56bac-8fdb-3c4b-a5b0-aabe7a99a0b2",
                                        "entry_id": "a9382a69-291c-3ef2-a3b5-931e2fd50b87",
                                        "glosses": [
                                            "Information temporairement envoyée à un client HTTP par un serveur HTTP, qui sera retournée à chaque connexion au même serveur."
                                        ],
                                        "tags": [
                                            "Canada"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2b7c3d08-b670-4ad6-a62c-7f7a904c53d8",
                                                "sense_id": "28e56bac-8fdb-3c4b-a5b0-aabe7a99a0b2",
                                                "text": "Un témoin est un fichier texte informatique transmis au navigateur Web […] d’un visiteur par un serveur Web (ordinateur hôte du site Web) pour mémoriser certains éléments d'information."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c4f0550b-4b69-3017-8094-bef8aec5bc3a",
                                        "entry_id": "a9382a69-291c-3ef2-a3b5-931e2fd50b87",
                                        "glosses": [
                                            "Objet transmis lors d’une course de relais."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "79109887-7ddd-44b7-9cd4-59b9cb18881d",
                                                "sense_id": "c4f0550b-4b69-3017-8094-bef8aec5bc3a",
                                                "text": "Ces épreuves sont courues en équipes de quatre athlètes qui doivent tour à tour porter le témoin le plus rapidement possible. Huit équipes s’affrontent en finale. Dans les relais, c’est le témoin, et non le coureur, qui est chronométré."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9f749a78-ff25-31d1-be5b-b7c2a9a833c2",
                                        "entry_id": "a9382a69-291c-3ef2-a3b5-931e2fd50b87",
                                        "glosses": [
                                            "Sujet, cause transmise tel un témoin dans une course d’athlétisme."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0306cca3-5ea5-4085-bf04-a0307e44bdeb",
                                                "sense_id": "9f749a78-ff25-31d1-be5b-b7c2a9a833c2",
                                                "text": "Comme dans une course de relais, les syndicats des différentes professions se transmettent le témoin de la grève contre la réforme des retraites, espérant ainsi maintenir la pression sur le gouvernement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
