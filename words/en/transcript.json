{
    "word_family": [
        "transcribe",
        "transcription",
        "transcriptionist",
        "transcriptive"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "92e678ed-31fa-3ef5-b0c9-84a632602765",
                    "sense_definition": "An official record of a student's academic performance, including courses taken and grades received.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "academic_records",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You need to submit an official <w>transcript</w> from your previous university to complete your application.",
                            "target_lang_translations": {
                                "ru": "Для завершения подачи заявления вам необходимо предоставить официальную <w>академическую справку</w> из вашего предыдущего университета."
                            }
                        },
                        {
                            "text": "The student requested a copy of her <w>transcript</w> to show her high grades to the employer.",
                            "target_lang_translations": {
                                "ru": "Студентка запросила копию своего <w>транскрипта</w>, чтобы показать работодателю свои высокие оценки."
                            }
                        }
                    ],
                    "synonyms": [
                        "academic record",
                        "grade report"
                    ],
                    "common_phrases": [
                        "official transcript",
                        "academic transcript",
                        "college transcript"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официальный документ об успеваемости студента, включающий список прослушанных курсов и полученных оценок."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "академическая справка",
                                "target_lang_sense_clarification": "официальный документ с оценками"
                            },
                            {
                                "target_lang_word": "выписка из зачётно-экзаменационной ведомости",
                                "target_lang_sense_clarification": "полный список оценок за период обучения"
                            },
                            {
                                "target_lang_word": "транскрипт",
                                "target_lang_sense_clarification": "в контексте зарубежного образования"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "028540ea-7bcc-3931-b931-fb1d6e127136",
                    "sense_definition": "A written or printed version of material originally presented orally, such as a speech or interview.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "written_records",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The court reporter provided a full <w>transcript</w> of the trial to the lawyers.",
                            "target_lang_translations": {
                                "ru": "Секретарь суда предоставил адвокатам полную <w>стенограмму</w> судебного процесса."
                            }
                        },
                        {
                            "text": "I read the interview <w>transcript</w> because I didn't have time to watch the whole video.",
                            "target_lang_translations": {
                                "ru": "Я прочитал <w>расшифровку</w> интервью, так как у меня не было времени смотреть видео целиком."
                            }
                        }
                    ],
                    "synonyms": [
                        "record",
                        "minutes"
                    ],
                    "common_phrases": [
                        "trial transcript",
                        "interview transcript",
                        "verbatim transcript"
                    ],
                    "target_lang_definitions": {
                        "ru": "Письменная или печатная версия материала, изначально представленного в устной форме, например, речи или интервью."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стенограмма",
                                "target_lang_sense_clarification": "дословная запись речи"
                            },
                            {
                                "target_lang_word": "расшифровка",
                                "target_lang_sense_clarification": "текст аудио- или видеозаписи"
                            },
                            {
                                "target_lang_word": "транскрипт",
                                "target_lang_sense_clarification": "письменная фиксация устного текста"
                            },
                            {
                                "target_lang_word": "протокол",
                                "target_lang_sense_clarification": "официальная запись хода заседания или суда"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0067d7ac-0576-3a93-acc1-d17d3ea8f296",
                    "sense_definition": "A written copy of a document or composition that consists of the same words as the original.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "written_records",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The historian carefully examined the handwritten <w>transcript</w> of the medieval manuscript.",
                            "target_lang_translations": {
                                "ru": "Историк внимательно изучил рукописную <w>копию</w> средневекового манускрипта."
                            }
                        },
                        {
                            "text": "He made a <w>transcript</w> of the original letter to ensure the text was preserved.",
                            "target_lang_translations": {
                                "ru": "Он сделал <w>список</w> с оригинального письма, чтобы обеспечить сохранность текста."
                            }
                        }
                    ],
                    "synonyms": [
                        "copy",
                        "duplicate",
                        "reproduction"
                    ],
                    "antonyms": [
                        "original"
                    ],
                    "common_phrases": [
                        "written transcript",
                        "accurate transcript"
                    ],
                    "target_lang_definitions": {
                        "ru": "Письменная копия документа или сочинения, в точности повторяющая текст оригинала."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "копия",
                                "target_lang_sense_clarification": "точное воспроизведение текста"
                            },
                            {
                                "target_lang_word": "список",
                                "target_lang_sense_clarification": "рукописная копия документа"
                            },
                            {
                                "target_lang_word": "дубликат",
                                "target_lang_sense_clarification": "повторный экземпляр документа"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d170577a-7037-308a-b6f2-4d9bc2f68c41",
                    "sense_definition": "A molecule of RNA produced during the process of transcription from a DNA template.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "biology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The researchers analyzed the RNA <w>transcript</w> to understand how the gene was being expressed.",
                            "target_lang_translations": {
                                "ru": "Исследователи проанализировали РНК-<w>транскрипт</w>, чтобы понять, как происходит экспрессия гена."
                            }
                        },
                        {
                            "text": "Some <w>transcripts</w> were found only in specific organs of the insect during the study.",
                            "target_lang_translations": {
                                "ru": "В ходе исследования некоторые <w>транскрипты</w> были обнаружены только в определенных органах насекомого."
                            }
                        }
                    ],
                    "common_phrases": [
                        "RNA transcript",
                        "gene transcript"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "scientific"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Молекула РНК, образующаяся в процессе транскрипции на основе матрицы ДНК."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "транскрипт",
                                "target_lang_sense_clarification": "биологический термин, молекула РНК"
                            },
                            {
                                "target_lang_word": "продукт транскрипции",
                                "target_lang_sense_clarification": "результат синтеза РНК"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e56aa2bf-951b-3254-8053-8b33a71e77fe",
                    "sense_definition": "To create a written version of something; to <w>transcribe</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The secretary was asked to <w>transcript</w> the recorded notes from the board meeting.",
                            "target_lang_translations": {
                                "ru": "Секретаря попросили <w>расшифровать</w> записанные заметки с заседания совета директоров."
                            }
                        },
                        {
                            "text": "He spent the afternoon <w>transcripting</w> the audio files into a digital document.",
                            "target_lang_translations": {
                                "ru": "Вторую половину дня он провел, <w>транскрибируя</w> аудиофайлы в цифровой документ."
                            }
                        }
                    ],
                    "synonyms": [
                        "transcribe"
                    ],
                    "target_lang_definitions": {
                        "ru": "Создавать письменную версию чего-либо; записывать устную речь текстом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "транскрибировать",
                                "target_lang_sense_clarification": "переводить из звуковой формы в текстовую"
                            },
                            {
                                "target_lang_word": "расшифровывать",
                                "target_lang_sense_clarification": "записывать текст с аудионосителя"
                            },
                            {
                                "target_lang_word": "стенографировать",
                                "target_lang_sense_clarification": "записывать речь в реальном времени"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}