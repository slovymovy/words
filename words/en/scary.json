                {
                    "sense_id": "76d19256-2968-351f-bb3c-6256af2ca393",
                    "sense_definition": "Subject to sudden alarm; easily frightened.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "fear_feeling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Don't be so <w>scary</w>; it was just the wind blowing the door shut.",
                            "target_lang_translations": {
                                "ru": "Не будь таким <w>пугливым</w>; это просто ветер захлопнул дверь.",
                                "de": "Sei nicht so <w>schreckhaft</w>; es war nur der Wind, der die Tür zugeschlagen hat.",
                                "fr": "Ne sois pas si <w>trouillard</w> ; c'était juste le vent qui a claqué la porte.",
                                "nl": "Wees niet zo <w>schrikachtig</w>; het was alleen de wind die de deur dichtblies."
                            }
                        },
                        {
                            "text": "The horse is a bit <w>scary</w> and might run if it hears a loud noise.",
                            "target_lang_translations": {
                                "ru": "Лошадь немного <w>пугливая</w> и может убежать, если услышит громкий шум.",
                                "de": "Das Pferd ist ein bisschen <w>schreckhaft</w> und könnte losrennen, wenn es ein lautes Geräusch hört.",
                                "fr": "Le cheval est un peu <w>peureux</w> et risque de s'enfuir s'il entend un bruit fort.",
                                "nl": "Het paard is een beetje <w>schrikachtig</w> en kan wegrennen als het een hard geluid hoort."
                            }
                        }
