                "senses": [
                    {
                        "sense_id": "003e9f4a-89b8-32b5-8b6c-cf62b944c6ee",
                        "entry_id": "05a805c0-7055-349b-98b8-d15deb6ccf3e",
                        "glosses": [
                            "een lege ruimte ingesloten in iets anders"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "922c736a-cd97-40c2-b7c7-a3df9f0c86e0",
                                "sense_id": "003e9f4a-89b8-32b5-8b6c-cf62b944c6ee",
                                "text": "Er is een holte achter deze wand."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6a188beb-c623-4168-adc1-339660b75eba",
                        "source_entry_id": "05a805c0-7055-349b-98b8-d15deb6ccf3e",
                        "source_sense_id": "003e9f4a-89b8-32b5-8b6c-cf62b944c6ee",
                        "source_sense_description": "een lege ruimte ingesloten is iets anders",
                        "target_lang_word": "Höhle",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Höhle",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "296efca0-ad25-3b18-87a1-ea77d0c5a695",
                                        "entry_id": "1e9de9dd-1748-36b8-aafa-305702fc61fc",
                                        "glosses": [
                                            "durch natürliche Prozesse entstandener, für Menschen zugänglicher hohler Raum in der Erdkruste, der relativ nah an der Oberfläche ist und teilweise oder ganz von Gestein umgeben ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a3fe7140-85b7-4989-bb2c-02f9540fd730",
                                                "sense_id": "296efca0-ad25-3b18-87a1-ea77d0c5a695",
                                                "text": "„Die Höhlen wurden vom Karstfluss Reka geschaffen. Die Reka sammelt ihr Wasser im undurchlässigen Flysch.“"
                                            },
                                            {
                                                "example_id": "465ce257-3af1-420b-96bf-30775131c71d",
                                                "sense_id": "296efca0-ad25-3b18-87a1-ea77d0c5a695",
                                                "text": "Vorsicht! In der Höhle dort lebt ein Bär."
                                            },
                                            {
                                                "example_id": "7ce3c051-4a29-4428-922b-3fe642b7989f",
                                                "sense_id": "296efca0-ad25-3b18-87a1-ea77d0c5a695",
                                                "text": "Die Wanderer suchten während des Regens in der Höhle Schutz."
                                            },
                                            {
                                                "example_id": "1f3de4e4-39ee-4392-8284-ac4953b8829f",
                                                "sense_id": "296efca0-ad25-3b18-87a1-ea77d0c5a695",
                                                "text": "„Sie lag in der Höhle auf einem Lager aus Blättern.“"
                                            },
                                            {
                                                "example_id": "3031fc6a-4184-4741-9bd2-fd571c5bfffc",
                                                "sense_id": "296efca0-ad25-3b18-87a1-ea77d0c5a695",
                                                "text": "„Dann sahen sie einen Gewölbebogen, der den Eingang zu einer tiefen Grotte bildete; darin hallten ihre Stimmen wider, es war sehr hell, und mit den von unten bis zur Decke emporragenden Säulen und den mit einem Teppich aus Algen ganz belegten Bodenplatten machte die Höhle den Eindruck einer Kirche.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e11be9d5-fbff-31d4-9585-851a5630e869",
                                        "entry_id": "1e9de9dd-1748-36b8-aafa-305702fc61fc",
                                        "glosses": [
                                            "Erdloch oder -tunnel, meist als Behausung für Tiere, Wohnung"
                                        ],
                                        "tags": [
                                            "auch übertragen für"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "34869a8f-5ca1-4779-b43a-3251a7414a1f",
                                                "sense_id": "e11be9d5-fbff-31d4-9585-851a5630e869",
                                                "text": "„Die Weibchen graben sich irgendwo im Schnee eine Höhle, in der sie mitten im Winter ihre Jungen gebären und aufziehen.“"
                                            },
                                            {
                                                "example_id": "3aa80536-07a6-43a0-83d4-3a7e45c88190",
                                                "sense_id": "e11be9d5-fbff-31d4-9585-851a5630e869",
                                                "text": "Die Dachse hatten sich unter der Scheune eine Höhle gegraben."
                                            },
                                            {
                                                "example_id": "1be1ed34-91c5-42dc-afd5-55cb0e2f134f",
                                                "sense_id": "e11be9d5-fbff-31d4-9585-851a5630e869",
                                                "text": "Irgendwann verließ Tommy seine Höhle nur noch für die dringendsten Besorgungen."
                                            },
                                            {
                                                "example_id": "031bedbb-591d-4780-95a9-3a2764757478",
                                                "sense_id": "e11be9d5-fbff-31d4-9585-851a5630e869",
                                                "text": "„Die Jungen hatten sie selbst gebuddelt, aber jetzt brauchten sie die Höhle nicht mehr, weil sie von der Horchheimer Höhe wegzogen, und sie wollten uns die Höhle schenken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "61614a11-ae72-3359-b91b-01b4dddadfc1",
                                        "entry_id": "1e9de9dd-1748-36b8-aafa-305702fc61fc",
                                        "glosses": [
                                            "Hohlraum in einem Feststoff, ein Raum, an dem man den Feststoff nicht antrifft (meist mit mindestens einer Öffnung), Augenhöhle, Bauchhöhle"
                                        ],
                                        "tags": [
                                            "besonders auch für"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ea498954-b3df-44ce-a54f-e7640ea2b93c",
                                                "sense_id": "61614a11-ae72-3359-b91b-01b4dddadfc1",
                                                "text": "Ihre Augen lagen tief in den Höhlen."
                                            },
                                            {
                                                "example_id": "9fbbda0a-ab76-4315-84a1-811476dc4913",
                                                "sense_id": "61614a11-ae72-3359-b91b-01b4dddadfc1",
                                                "text": "„Das Licht in der Höhle seiner Hand erlosch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5f88ea85-b497-4c5f-9e99-717fdc18db7d",
                        "source_entry_id": "05a805c0-7055-349b-98b8-d15deb6ccf3e",
