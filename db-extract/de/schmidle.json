                ],
                "senses": [
                    {
                        "sense_id": "6f2fcbdf-ca9b-39b1-9127-e694aa346984",
                        "entry_id": "14da4f54-6a81-3926-a5a1-2a8bee1b43d4",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b0b63b5f-40c8-41e3-82ef-9973b0b7e019",
                                "sense_id": "6f2fcbdf-ca9b-39b1-9127-e694aa346984",
                                "text": "Frau Schmidle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "66c5bad9-460b-4027-9e8a-a351823f89d5",
                                "sense_id": "6f2fcbdf-ca9b-39b1-9127-e694aa346984",
                                "text": "Herr Schmidle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "5643ca5e-15d9-402b-994f-2686eb5f55c7",
                                "sense_id": "6f2fcbdf-ca9b-39b1-9127-e694aa346984",
                                "text": "Die Schmidles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "fe000cfe-90cc-499b-9fd2-31d8bd127482",
                                "sense_id": "6f2fcbdf-ca9b-39b1-9127-e694aa346984",
                                "text": "Der Schmidle trägt nie die Pullover, die die Schmidle ihm strickt."
                            },
                            {
                                "example_id": "8507ce32-3fa4-48a8-9345-58bbe114513f",
                                "sense_id": "6f2fcbdf-ca9b-39b1-9127-e694aa346984",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Schmidle kommt, geht der Herr Schmidle.“"
                            },
                            {
                                "example_id": "3c634317-1e7b-4329-9e53-243f99510337",
                                "sense_id": "6f2fcbdf-ca9b-39b1-9127-e694aa346984",
                                "text": "Schmidle kommt und geht."
                            },
                            {
                                "example_id": "47c0a45a-1421-4821-9a14-78c96524fcab",
                                "sense_id": "6f2fcbdf-ca9b-39b1-9127-e694aa346984",
                                "text": "Schmidles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
