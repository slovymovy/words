                        "entry_id": "99bea78a-89db-3bd5-8b4d-09e5a0750559",
                        "glosses": [
                            "A solitary, fierce mammal of the Mustelidae family, Gulo gulo."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b440ced3-7b94-4b4b-93b5-9ccbc7321e82",
                                "sense_id": "b7bf1fa6-ad46-3ec1-9260-7650459f2fcf",
                                "text": "“Wish I'd been more polite to that girl,” the sheriff remarked regretfully. “ I ain't had a bite to eat since four o'clock this morning, and I'm hungry as a wolverine. … I know she'd have give me another drink of that old moonshine she has.”"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "be65c787-f9cb-489c-b020-41a6251b93a0",
                        "source_entry_id": "99bea78a-89db-3bd5-8b4d-09e5a0750559",
                        "source_sense_id": "b7bf1fa6-ad46-3ec1-9260-7650459f2fcf",
                        "source_sense_description": "Gulo gulo",
