                                "target_lang_word": "arranque",
                                "target_lang_sense_clarification": "aceleración o esfuerzo súbito"
                            },
                            {
                                "target_lang_word": "oleada",
                                "target_lang_sense_clarification": "aumento breve y repentino"
                            }
                        ]
