                "senses": [
                    {
                        "sense_id": "205ac8b9-0a21-3c72-a49d-d719e13f8285",
                        "entry_id": "7fa0358a-a6cb-3cba-b250-7de9806147a3",
                        "glosses": [
                            "een gebied waarop een militair treffen tussen twee legers plaatsvindt of plaatsgevonden heeft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a905833-f72d-4e54-b81f-c6ce2b9713bf",
                                "sense_id": "205ac8b9-0a21-3c72-a49d-d719e13f8285",
                                "text": "De slagvelden van de Eerste Wereldoorlog zijn berucht om hun loopgraven."
                            },
                            {
                                "example_id": "625a3761-b320-44fb-b0b2-dff09ebfc5c6",
                                "sense_id": "205ac8b9-0a21-3c72-a49d-d719e13f8285",
                                "text": "Het slagveld dat van schoonheid werd vervuld, het boomloze landschap dat baadde in de ochtendzon, wilde bloemen die de loopgraven vulden met hun warme geurflarden, de schoonheid van de natuur die alleen ervaren kon worden in aanwezigheid van de dood en met mannelijke deugden die alleen tot uitdrukking kwamen door het doden."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dbc68ae9-5feb-41df-875f-c62b2db1b1d0",
                        "source_entry_id": "7fa0358a-a6cb-3cba-b250-7de9806147a3",
                        "source_sense_id": "205ac8b9-0a21-3c72-a49d-d719e13f8285",
                        "source_sense_description": "een gebied waarop een militair treffen tussen twee legers plaatsvindt of plaatsgevonden heeft",
                        "target_lang_word": "Schlachtfeld",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schlachtfeld",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ca5c01b2-4c87-3c52-8867-d402e5ada9bd",
                                        "entry_id": "b9baa161-9233-36d1-a645-8a22540ae8f8",
                                        "glosses": [
                                            "Gebiet, in dem ein Kampf beziehungsweise eine Schlacht stattgefunden hat."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "564930f4-49c3-44e2-a33f-83d46f26016b",
                                                "sense_id": "ca5c01b2-4c87-3c52-8867-d402e5ada9bd",
                                                "text": "Das Schlachtfeld ist mit Blut getränkt."
                                            },
                                            {
                                                "example_id": "7a95df55-a3e8-4130-8726-fa28de313dc3",
                                                "sense_id": "ca5c01b2-4c87-3c52-8867-d402e5ada9bd",
                                                "text": "„Schon Napoleon umging die Festungen und suchte den Kampf auf dem Schlachtfeld mit dem gegnerischen Führer.“"
                                            },
                                            {
                                                "example_id": "b43a5199-65f3-4e84-8ef9-72de64131a6f",
                                                "sense_id": "ca5c01b2-4c87-3c52-8867-d402e5ada9bd",
                                                "text": "Dort erzählten sie sich ihre Erinnerungen an die Schlachtfelder, von denen ihre Familien nichts hören wollten.“"
                                            },
                                            {
                                                "example_id": "9bcaa8af-85d8-497e-af5c-9806bc6cb4ad",
                                                "sense_id": "ca5c01b2-4c87-3c52-8867-d402e5ada9bd",
                                                "text": "„Er erinnerte sich daran, daß der Brief vom Herbst 1938, in dem er seinem Vater einen Besuch der flandrischen Schlachtfelder geschildert hatte, sein letzter Brief nach Frankfurt gewesen war.“"
                                            },
                                            {
                                                "example_id": "2cd50de0-aa6d-45b5-bf52-ffb11ab9a340",
                                                "sense_id": "ca5c01b2-4c87-3c52-8867-d402e5ada9bd",
                                                "text": "„Wir sehen die Abbildungen der Schlachtfelder hinter dem Heer.“"
                                            },
                                            {
                                                "example_id": "8719cb85-a687-45e0-b9c4-e5f26588d3af",
                                                "sense_id": "ca5c01b2-4c87-3c52-8867-d402e5ada9bd",
                                                "text": "„Die Initiative auf dem Schlachtfeld ist vollständig auf die russische Armee übergegangen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0b1d6bb5-124a-4806-94b0-0b068489c6b8",
                        "source_entry_id": "7fa0358a-a6cb-3cba-b250-7de9806147a3",
                        "source_sense_id": "205ac8b9-0a21-3c72-a49d-d719e13f8285",
                        "source_sense_description": "een gebied waarop een militair treffen tussen twee legers plaatsvindt of plaatsgevonden heeft",
                        "target_lang_word": "battlefield",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "battlefield",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fa2f7e37-75a7-34ca-9d35-06d9b98fdaf9",
                                        "entry_id": "905539c4-ee5b-3531-a5ba-658843c0b169",
                                        "glosses": [
                                            "The area where a land battle is fought, which may not necessarily be a field."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "76372a44-e855-4fc0-a5ad-5bbf6c02ff4a",
                                                "sense_id": "fa2f7e37-75a7-34ca-9d35-06d9b98fdaf9",
                                                "text": "The night of the 16th of May found McPherson's command bivouacked from two to six miles west of the battlefield, along the line of the road to Vicksburg"
                                            },
                                            {
                                                "example_id": "e64384e3-1547-4cd1-a8e4-2bda3d7bf4ed",
                                                "sense_id": "fa2f7e37-75a7-34ca-9d35-06d9b98fdaf9",
                                                "text": "Though in the past it saw much of the unhappiness and strife of Border warfare—the great battlefields of Pilleth and Mortimer's Cross are nearby—it is now a quiet and happy place."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
