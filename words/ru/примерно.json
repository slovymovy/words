{
    "word_family": [
        "пример",
        "примерный"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "85205cfe-0616-38d9-ae58-1a4c9ba1671d",
                    "sense_definition": "Указывает на неточное, приблизительное количество, время или качество.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "approx",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы приедем домой <w>примерно</w> через час.",
                            "target_lang_translations": {
                                "en": "We will arrive home in <w>about</w> an hour.",
                                "zh": "我们<w>大约</w>一小时后到家。"
                            }
                        },
                        {
                            "text": "В зале собралось <w>примерно</w> пятьдесят человек.",
                            "target_lang_translations": {
                                "en": "<w>Approximately</w> fifty people gathered in the hall.",
                                "zh": "大厅里聚集了<w>大约</w>五十人。"
                            }
                        }
                    ],
                    "synonyms": [
                        "около",
                        "приблизительно"
                    ],
                    "antonyms": [
                        "точно",
                        "ровно"
                    ],
                    "common_phrases": [
                        "примерно так",
                        "примерно в это время",
                        "примерно столько же"
                    ],
                    "target_lang_definitions": {
                        "en": "Indicates an inexact, approximate quantity, time, or quality.",
                        "zh": "用于表示不精确、大约的数量、时间或程度。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "approximately",
                                "target_lang_sense_clarification": "formal or standard"
                            },
                            {
                                "target_lang_word": "about",
                                "target_lang_sense_clarification": "common, colloquial"
                            },
                            {
                                "target_lang_word": "roughly",
                                "target_lang_sense_clarification": "inexactly"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "大约",
                                "target_lang_sense_clarification": "最常用的表示近似的词"
                            },
                            {
                                "target_lang_word": "大概",
                                "target_lang_sense_clarification": "用于推测或估算"
                            },
                            {
                                "target_lang_word": "左右",
                                "target_lang_sense_clarification": "置于数量词后表示近似"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1f74d9bb-ede3-37d7-96b5-df1ed02c1e3d",
                    "sense_definition": "Так, как следует; образцово, отлично, служа примером для других.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "exemplary",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Весь вечер ребёнок вёл себя <w>примерно</w>.",
                            "target_lang_translations": {
                                "en": "The child behaved <w>exemplarily</w> all evening.",
                                "zh": "整个晚上孩子都表现得很<w>乖</w>。"
                            }
                        },
                        {
                            "text": "За этот проступок он был <w>примерно</w> наказан.",
                            "target_lang_translations": {
                                "en": "For this misconduct, he was <w>exemplarily</w> punished.",
                                "zh": "他因这次过错受到了<w>严厉</w>的惩罚。"
                            }
                        }
                    ],
                    "antonyms": [
                        "плохо",
                        "безобразно"
                    ],
                    "common_phrases": [
                        "вести себя примерно",
                        "примерно наказать"
                    ],
                    "target_lang_definitions": {
                        "en": "In a way that is excellent, exemplary, or serves as a model for others.",
                        "zh": "指行为表现得很好，可以作为他人的榜样。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "exemplarily",
                                "target_lang_sense_clarification": "serving as a model"
                            },
                            {
                                "target_lang_word": "admirably",
                                "target_lang_sense_clarification": "deserving praise"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "乖",
                                "target_lang_sense_clarification": "形容孩子听话、表现好"
                            },
                            {
                                "target_lang_word": "规矩",
                                "target_lang_sense_clarification": "形容行为端正、守纪律"
                            }
                        ]
                    }
                }
            ]
        },
        {
