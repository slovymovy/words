                        "sense_id": "ed104313-e383-3294-ae2b-176157934254",
                        "entry_id": "0b0f1c42-2009-3e6c-9be8-0bea5137f889",
                        "glosses": [
                            "Qui est banni, interdit de séjour."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e83cd3c2-5ee8-49bb-a5a9-5c699dc82dc3",
                                "sense_id": "ed104313-e383-3294-ae2b-176157934254",
                                "text": "Insulteurs des foules proscrites,\nQui chantez au bruit des écus,\nCachez vos lyres hypocrites :\nNous sommes avec les vaincus!"
                            },
                            {
                                "example_id": "afc70a20-5698-471f-91b7-4484a019deaa",
                                "sense_id": "ed104313-e383-3294-ae2b-176157934254",
                                "text": "La Belgique est le troisième pays qui possède, au lendemain de mai 1871, une nombreuse colonie de communards proscrits."
                            }
                        ]
                    },
                    {
                        "sense_id": "6a26a801-1db7-3390-8ab7-d2504712ccfa",
                        "entry_id": "0b0f1c42-2009-3e6c-9be8-0bea5137f889",
                        "glosses": [
                            "Qui est banni, écarté de l’usage."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "c39c1026-c54a-4e6e-a3b2-e76a71e8f4dd",
                                "sense_id": "6a26a801-1db7-3390-8ab7-d2504712ccfa",
                                "text": "Ce mot est proscrit."
                            },
                            {
                                "example_id": "1cb8de8d-3fc1-4255-b0bb-e40fd7bd05e8",
                                "sense_id": "6a26a801-1db7-3390-8ab7-d2504712ccfa",
                                "text": "Cette façon d’agir est proscrite."
                            }
                        ]
                    }
