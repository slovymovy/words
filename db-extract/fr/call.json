                "senses": [
                    {
                        "sense_id": "c1a921a3-6a0c-38bf-a336-89376e28cc20",
                        "entry_id": "43082d5a-e33a-319f-b77f-4d1f8f522086",
                        "glosses": [
                            "Quartier juif, séparé de la ville chrétienne, en Catalogne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "635388ee-bb39-44d0-9bd1-8f1cdb52779e",
                                "sense_id": "c1a921a3-6a0c-38bf-a336-89376e28cc20",
                                "text": "À la suite du terrible massacre des juifs de la péninsule ibérique, en 1391, le Call de Perpignan fut envahi, en 1392, et devint la proie du meurtre et du pillage."
                            },
                            {
                                "example_id": "9673f137-6f66-4fa2-8747-3bbe5b1eb22b",
                                "sense_id": "c1a921a3-6a0c-38bf-a336-89376e28cc20",
                                "text": "Ainsi le Call, inoccupé et complètement fermé sur lui-même, demeura enterré sous les couches successives de construction, sous une forme de « Belle au Bois dormant » pendant près de cinq cent ans, jusqu’à ce qu’un processus de gentrification le ramenât de nouveau à la vie."
                            },
                            {
                                "example_id": "65b13698-29a3-4020-82da-9902eed30ca7",
                                "sense_id": "c1a921a3-6a0c-38bf-a336-89376e28cc20",
                                "text": "La valorisation du patrimoine juif est un processus de grande ampleur en Catalogne où la restauration des calls (nom hébreu désignant les quartiers juifs au Moyen Âge) et la récupération des témoignages du passé, ont donné des résultats notoires."
                            }
                        ]
                    }
