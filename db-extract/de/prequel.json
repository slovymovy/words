                                        "glosses": [
                                            "Antépisode, œuvre contant l’histoire de ce qui est arrivé avant l’histoire contée dans une autre œuvre."
                                        ],
                                        "tags": [
                                            "Anglicism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "74ec21b0-5240-481f-8191-04600ac31316",
                                                "sense_id": "a349d35a-97a1-3b66-9135-7c3429af5598",
                                                "text": "Par rapport à Star Wars, épisode IV, les épisodes 5 et 6 sont des suites, et les épisodes 1, 2 et 3 sont des prequels."
                                            },
                                            {
                                                "example_id": "cd7d632b-913f-4687-8453-d21950cb9717",
                                                "sense_id": "a349d35a-97a1-3b66-9135-7c3429af5598",
                                                "text": "Le premier prequel du film de Kubrick, Doctor Sleep, de Mike Flanagan avec Ewan McGregor sorti en 2019, a tellement floppé que Warner a renoncé à en faire un deuxième."
                                            }
                                        ]
                                    }
