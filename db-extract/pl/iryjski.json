                                        "glosses": [
                                            "The Gaelic language indigenous to Ireland, also known as Irish Gaelic."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd3114d7-d44f-4227-a415-73ea4a70a8e0",
                                                "sense_id": "65c7c4c3-688f-3fd5-af1f-2c27a5a40fdf",
                                                "text": "Irish is the first official and national language of Ireland."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "89b189ab-f386-39e2-8d96-d6d56f11b3bd",
                                        "entry_id": "874e3318-7576-343a-b99b-3c45863a9e6c",
                                        "glosses": [
                                            "The Irish people."
                                        ],
                                        "tags": [
                                            "as plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5470cb2e-477d-40a9-8531-29e0907c786d",
                                                "sense_id": "89b189ab-f386-39e2-8d96-d6d56f11b3bd",
                                                "text": "Many Irish are actually darkhaired as a result of the many invaders and migrants over the centuries."
                                            },
                                            {
                                                "example_id": "73adf2d8-0d12-40d3-b6ae-e98b7bbf36f3",
                                                "sense_id": "89b189ab-f386-39e2-8d96-d6d56f11b3bd",
                                                "text": "America used to love dams... Yes, and we built those dams with ingenuity and brawn and, of course, piles and piles of dead Irish."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f875f1b0-6e73-352d-86cd-d7d997fe6968",
                                        "entry_id": "874e3318-7576-343a-b99b-3c45863a9e6c",
                                        "glosses": [
                                            "A surname originating as an ethnonym."
