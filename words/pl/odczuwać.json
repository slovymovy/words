                                "ru": "Я <w>воспринимаю</w> эту ситуацию как необычную.",
                                "nl": "Ik <w>ervaar</w> deze situatie als bijzonder.",
                                "de": "Ich <w>empfinde</w> diese Situation als außergewöhnlich.",
                                "fr": "Je <w>perçois</w> cette situation comme extraordinaire.",
                                "it": "<w>Percepisco</w> questa situazione come insolita.",
                                "cs": "<w>Vnímám</w> tuto situaci jako neobvyklou.",
                                "tr": "Bu durumu olağandışı <w>olarak algılıyorum</w>.",
                                "es": "<w>Percibo</w> esta situación como algo extraordinario.",
                                "zh": "我<w>觉得</w>这种情况非同寻常。"
                            }
                        },
                        {
                            "text": "Wszyscy <w>odczuwają</w> tę zmianę jako niesprawiedliwą.",
                            "target_lang_translations": {
                                "en": "Everyone <w>feels</w> this change is unfair.",
                                "ru": "Все <w>воспринимают</w> это изменение как несправедливое.",
                                "nl": "Iedereen <w>ervaart</w> deze verandering als oneerlijk.",
                                "de": "Alle <w>empfinden</w> diese Veränderung als ungerecht.",
                                "fr": "Tout le monde <w>ressent</w> ce changement comme injuste.",
                                "it": "Tutti <w>percepiscono</w> questo cambiamento come ingiusto.",
                                "cs": "Všichni <w>pociťují</w> tuto změnu jako nespravedlivou.",
                                "tr": "Herkes bu değişikliği haksızlık <w>olarak görüyor</w>.",
                                "es": "Todos <w>perciben</w> este cambio como injusto.",
                                "zh": "大家都<w>觉得</w>这项变动不公平。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to perceive, interpret, or have a subjective impression or feeling about something",
                        "ru": "интерпретировать что-либо, иметь субъективное впечатление о чем-либо",
                        "nl": "iets interpreteren; een subjectieve indruk of beleving van iets hebben",
