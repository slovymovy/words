                ],
                "senses": [
                    {
                        "sense_id": "bd53e28f-0026-312f-980e-0cc3a0e50a22",
                        "entry_id": "f12f285d-91a0-3d1c-a029-d2826144af9c",
                        "glosses": [
                            "недостаточно пропечь"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d0b3d39-e4d0-4e9f-810e-b4df1f9b0938",
                                "sense_id": "bd53e28f-0026-312f-980e-0cc3a0e50a22",
                                "text": "Агафья, ты забыла посолить суп!.. пережарила жаркое!.. недопекла пирог!.. Что с тобой? — Извините, барыня, виновата, — отвечала Агафья и уходила к себе за перегородку всплакнуть."
                            }
                        ]
                    },
                    {
                        "sense_id": "6aa1a92d-3305-3ab7-a394-9dc1c0e9b8b0",
                        "entry_id": "f12f285d-91a0-3d1c-a029-d2826144af9c",
                        "glosses": [
                            "перен. недоделать"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "42ca7165-df28-4bd4-ae5a-a85931afe333",
                                "sense_id": "6aa1a92d-3305-3ab7-a394-9dc1c0e9b8b0",
                                "text": "Гертруду Шекспир недопёк в той же мере, в какой перепёк Леди Макбет…"
                            }
                        ]
                    },
                    {
                        "sense_id": "fb5f6518-ba8a-3ebb-8625-dffe091d0593",
                        "entry_id": "f12f285d-91a0-3d1c-a029-d2826144af9c",
                        "glosses": [
                            "выпечь меньше, чем следует, требуется"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e3ca7a71-daca-4c23-a0a3-9057123b3d8b",
                                "sense_id": "fb5f6518-ba8a-3ebb-8625-dffe091d0593",
                                "text": "Булочек на кухне недопекли, и на весь отряд не хватило."
                            }
                        ]
                    }
                ],
