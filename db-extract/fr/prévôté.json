                "senses": [
                    {
                        "sense_id": "666854d7-144e-3b03-ab48-e4e883cc8a89",
                        "entry_id": "79901903-d06f-3595-a138-a3f79e51a899",
                        "glosses": [
                            "Qualité, fonction, juridiction de prévôt."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "58b8353a-c179-4e85-b053-aa1b525fa8de",
                                "sense_id": "666854d7-144e-3b03-ab48-e4e883cc8a89",
                                "text": "Juge de la prévôté."
                            }
                        ]
                    },
                    {
                        "sense_id": "76e394f1-5504-3afa-9ee5-bc1e6ba8f532",
                        "entry_id": "79901903-d06f-3595-a138-a3f79e51a899",
                        "glosses": [
                            "Territoire où s’exerçait cette juridiction."
                        ],
                        "tags": [
                            "Justice"
                        ],
                        "examples": [
                            {
                                "example_id": "3b10eab0-b34a-4a50-89a5-6ecd5b61fb2b",
                                "sense_id": "76e394f1-5504-3afa-9ee5-bc1e6ba8f532",
                                "text": "La prévôté de Dordives s'étendait sur Dordives, partie de Mez-le-Maréchal, Thurelle et les Aulnois, Souppes, Besigny, la Cloisière, le Bois-d'Aix, Champs-sur-les-Bois, Bougligny, Maisoncelles, Chenou, Trémainville, Mézinville et Mondreville."
                            },
                            {
                                "example_id": "7b8231de-eb50-41ba-9bc9-729ae5a608b0",
                                "sense_id": "76e394f1-5504-3afa-9ee5-bc1e6ba8f532",
                                "text": "Par l'édit du 31 août 1698, le duc Léopold réorganisa l'administration de la Lorraine : la prévôté de Bruyères devint alors le siège bailliager de Bruyères, sans que sa consistance en soit affectée."
                            }
                        ]
                    },
                    {
                        "sense_id": "a0a0316e-6e52-37ec-8eb0-3868de8eff4e",
                        "entry_id": "79901903-d06f-3595-a138-a3f79e51a899",
                        "glosses": [
                            "En termes militaires, corps de gendarmes chargé de la surveillance dans une grande unité mobilisée."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "b420059e-940f-49be-9b3b-85819ce54f25",
                                "sense_id": "a0a0316e-6e52-37ec-8eb0-3868de8eff4e",
                                "text": "En imagination, ils se virent arrêtés par la prévôté, ramenés au quartier entre deux gendarmes, enfermés au cachot..."
                            }
                        ]
                    }
