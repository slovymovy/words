                "senses": [
                    {
                        "sense_id": "e2c6ed50-a57c-38c1-81a1-a21cbb9cca77",
                        "entry_id": "969c4e90-77d6-3664-ba9f-8e68aa7b0d96",
                        "glosses": [
                            "auf dilettantische, pseudowissenschaftliche Art"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "463c636f-f48d-40d5-bb8e-7a9ae34ce315",
                                "sense_id": "e2c6ed50-a57c-38c1-81a1-a21cbb9cca77",
                                "text": "„Als er in der Finsternis seiner merkwürdigen Lage immer wieder über diese ganze Angelegenheit nachdachte, fragte er sich allmählich, ob sein Erlebnis mit dem Kristallkubus - und sogar dessen Existenz - nicht bloß ein Albtraum sei, der von der unterbewussten Erinnerung an dieses groteske alte Stückchen überspannter, quacksalberischer Lektüre heraufbeschworen worden war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
