                                    {
                                        "sense_id": "1e2c910a-9deb-39bb-9276-315cfd11afb4",
                                        "entry_id": "1bfbe9a8-4a46-3081-99dd-8290390dcdca",
                                        "glosses": [
                                            "Région de la côte de la mer Baltique où vivaient les Lives, au nord de la Lituanie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb5af91a-ebe8-408f-9d86-5535e87752bd",
                                                "sense_id": "1e2c910a-9deb-39bb-9276-315cfd11afb4",
                                                "text": "LIVONIE, la (Géog.) province de l’empire russien, avec titre de duché, sur la mer Baltique, qui la borne au couchant, & sur le golfe de Finlande, qui la borne au nord.\nCette province peut avoir environ cent milles germaniques de longueur, en la prenant depuis les frontières de la Prusse jusqu’à Riga, & quarante milles dans sa plus grande largeur, sans y comprendre les îles."
                                            },
                                            {
                                                "example_id": "ad5fba73-167b-4314-8c94-5a3ec414b56c",
                                                "sense_id": "1e2c910a-9deb-39bb-9276-315cfd11afb4",
                                                "text": "Son père à lui s’est établi en Livonie après la mort du roi de Suède ; mais il a perdu sa fortune lors de la campagne de 1812, et il est mort, laissant le pauvre enfant, à l’âge de huit ans, sans ressources."
                                            }
                                        ]
                                    }
                                ]
