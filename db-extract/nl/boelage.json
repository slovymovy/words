                "senses": [
                    {
                        "sense_id": "25a6c9ff-5518-3e92-a6ee-5fba55c56579",
                        "entry_id": "3a3675b2-7b4e-3360-9a80-3111a0cf9b81",
                        "glosses": [
                            "ongeoorloofd erotisch plezier"
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "a756ae3f-f45a-476b-ac40-0fb415dc682b",
                                "sense_id": "25a6c9ff-5518-3e92-a6ee-5fba55c56579",
                                "text": "Het verhaal van de boelage van Mars en Venus (…) is typerend voor het primair-sexuele, voor de ongeremde hartstocht van de louter lichamelijke liefde. De overspelsituatie is daarvan duidelijke manifestatie."
                            },
                            {
                                "example_id": "d798f879-ed63-4599-a5e8-0c23a86beca8",
                                "sense_id": "25a6c9ff-5518-3e92-a6ee-5fba55c56579",
                                "text": "«Correctheid», is de vorm, waarin men vader en moeder vermoorden en allerlei misdrijven, misdaden en boelage begaan kan, en toch door-en-door fatsoenlijk blijft, zelfs in z'n recht."
                            }
                        ]
                    },
                    {
                        "sense_id": "c53fd74b-6d75-37af-99ae-783a37dd7654",
                        "entry_id": "3a3675b2-7b4e-3360-9a80-3111a0cf9b81",
                        "glosses": [
                            "erotisch plezier"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "4fec0420-91d9-4d83-ba69-106e5df940f5",
                                "sense_id": "c53fd74b-6d75-37af-99ae-783a37dd7654",
                                "text": "Maar 't schijnt wel wie geen rust en waagt,\nkan kwalijk lust gewinnen.\nOf ik hem ook lichtvaardig von'\nen 't bleef in dit bosschage?\nIndien dit bosje klappen kon,\nwat meldde 't al boelage!"
                            }
                        ]
                    },
                    {
                        "sense_id": "beb9955b-72bd-3377-b2c9-94e18058b0ce",
                        "entry_id": "3a3675b2-7b4e-3360-9a80-3111a0cf9b81",
                        "glosses": [
                            "vrouw waarmee men buiten het huwelijk erotisch plezier heeft"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": []
                    }
