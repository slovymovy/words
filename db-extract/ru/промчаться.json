                "senses": [
                    {
                        "sense_id": "71d30bf8-2090-30ee-863a-4fe45eaeb282",
                        "entry_id": "b34adf6f-1177-3664-aabc-aa021ed494ae",
                        "glosses": [
                            "пронестить, быстро переместиться"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d728f389-b604-4c44-8c8b-60036a8bfe57",
                                "sense_id": "71d30bf8-2090-30ee-863a-4fe45eaeb282",
                                "text": "Промчались, пронеслись облака, спустились к земле и исчезли."
                            }
                        ]
                    },
                    {
                        "sense_id": "e6f9016e-4976-3db7-bf8c-50bfa28ddf47",
                        "entry_id": "b34adf6f-1177-3664-aabc-aa021ed494ae",
                        "glosses": [
                            "быстро, незаметно пройти (о времени, событии и т. п.)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "482e7a4e-95fa-4630-a10e-14cee0278057",
                                "sense_id": "e6f9016e-4976-3db7-bf8c-50bfa28ddf47",
                                "text": "Медленно дотащилась она до дома, в котором промчались такие счастливые минуты."
                            },
                            {
                                "example_id": "fdcfba07-8b8c-4b3a-a7a8-d83384f0c507",
                                "sense_id": "e6f9016e-4976-3db7-bf8c-50bfa28ddf47",
                                "text": "И страх и грусть Мариорицы промчались, как мимолетные видения."
                            }
                        ]
                    }
                ],
