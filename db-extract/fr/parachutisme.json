                        "entry_id": "fcd3951e-8a12-3cae-a6d2-7f492fc6f157",
                        "glosses": [
                            "Sport consistant à se larguer d’un aéronef (avion, hélicoptère, montgolfière, …) avec un parachute et parfois d’autres accessoires d’une hauteur qui peut être de 1 000 à 4 000 mètres du sol."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "36ff68c0-344b-4ac8-aa07-7a9d585dd206",
                                "sense_id": "6f4a888b-47be-3cab-b4d9-1b4cd79667d1",
                                "text": "Le parachutisme naît le 22 octobre 1797, lors du saut de Garnerin au-dessus du parc Monceau à Paris d’une montgolfière."
                            }
                        ]
                    }
                ],
