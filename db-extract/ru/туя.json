                                    {
                                        "sense_id": "8a598234-6c20-35a2-9b9d-5c1b34f54560",
                                        "entry_id": "f2e9bc68-0d5f-3732-ac81-0053bf33afa1",
                                        "glosses": [
                                            "Conifère qui se rapproche beaucoup du cyprès et dont le feuillage, aplati et toujours vert, s’élève en pyramide."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2abafd32-f687-41f9-ba61-c9da69d53ecd",
                                                "sense_id": "8a598234-6c20-35a2-9b9d-5c1b34f54560",
                                                "text": "Mᵐᵉ Saint-Alban quittait, pour venir voir ma mère, sa maison du coin de la rue, son étroit jardin où les clématites pâlissaient dans l’ombre des thuyas."
                                            },
                                            {
                                                "example_id": "4ed6763a-0cb8-4c4f-9405-567163e2214c",
                                                "sense_id": "8a598234-6c20-35a2-9b9d-5c1b34f54560",
                                                "text": "Ses lettres, aussitôt lues, –et avec quelle rapidité,– étaient jetées par Galswinthe dans une coffret de thuya qu’elle avait sur la commode de sa chambre."
                                            },
                                            {
                                                "example_id": "ca636172-51a7-4011-a293-ee9685783de2",
                                                "sense_id": "8a598234-6c20-35a2-9b9d-5c1b34f54560",
                                                "text": "Éviter de planter une haie composée uniquement de thuyas. Les épidémies y sont beaucoup plus fréquentes et intenses que dans une haie composite ou mixte."
                                            }
                                        ]
                                    }
                                ]
                            }
