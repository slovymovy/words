                    {
                        "translation_id": "bae8a100-4431-4f79-a871-15daa7dff17a",
                        "source_entry_id": "4af31d65-50e1-3d63-86be-2549dc4e1f66",
                        "source_sense_id": "83a8bccd-1ad6-3a9c-a4ac-bd424cc73623",
                        "source_sense_description": "voorstel",
                        "target_lang_word": "offer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
