                                        "glosses": [
                                            "Eau-de-vie très renommée de couleur jaune d’or, tirée de certains vins blancs du terroir d’Armagnac."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cce872f2-04b6-4ce6-b5b7-e54e022ae825",
                                                "sense_id": "b5fa4cca-7641-3ffd-b6c5-ee0d1f110fc4",
                                                "text": "La dégustation d’un cognac, d’un armagnac ou d’une autre eau-de-vie suit les principes généraux de celle des vins."
                                            },
                                            {
                                                "example_id": "098dcf46-c984-4fef-8df2-237eb39df23b",
                                                "sense_id": "b5fa4cca-7641-3ffd-b6c5-ee0d1f110fc4",
                                                "text": "Monsieur Daste, flatté, appuya son menton sur sa cravate, lissa ses cheveux sur la tempe en passant la main par-desus son oreille et but coquettement une gorgée d’armagnac, qu’il avala de travers."
                                            }
