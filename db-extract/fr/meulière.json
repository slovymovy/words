                    {
                        "sense_id": "c3785543-b7b1-33da-83d0-e782441d5126",
                        "entry_id": "c57699ae-b87f-3949-9f0a-e19a72167ceb",
                        "glosses": [
                            "Pierre rocailleuse dont on fait des meules de moulin et qu’on emploie aussi comme moellon pour bâtir."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b71b2556-21a6-4e1b-aa1d-b0bbfa715e6f",
                                "sense_id": "c3785543-b7b1-33da-83d0-e782441d5126",
                                "text": "Mur bâti en meulière."
                            },
                            {
                                "example_id": "5a56b3f1-8d83-4a8b-8448-ca1b48e6feb4",
                                "sense_id": "c3785543-b7b1-33da-83d0-e782441d5126",
                                "text": "Des pavillons en pierres meulières, trouées comme des éponges, remarquait Gérard de Nerval, auxquelles s’accrochent des rosiers grimpants."
                            },
                            {
                                "example_id": "e21cee9a-8f76-4305-997e-1b6e83ee3235",
                                "sense_id": "c3785543-b7b1-33da-83d0-e782441d5126",
                                "text": "On ne dessinait pas vraiment la maison de ses rêves, mais celle qu’on savait peindre, avec des meulières faciles à reproduire."
                            },
                            {
                                "example_id": "483b246f-6db0-408b-ade0-a0ffa837e857",
                                "sense_id": "c3785543-b7b1-33da-83d0-e782441d5126",
                                "text": "En fin de journée, la banlieue aligne déjà ses pavillons de meulières entre les platanes."
                            }
                        ]
                    },
                    {
                        "sense_id": "f82cb993-c19d-3532-9b96-b5a30fbb5a06",
                        "entry_id": "c57699ae-b87f-3949-9f0a-e19a72167ceb",
                        "glosses": [
                            "La carrière d’où l’on tire ces sortes de pierre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc1ee6d2-950d-441c-a534-13cb55585183",
                                "sense_id": "f82cb993-c19d-3532-9b96-b5a30fbb5a06",
                                "text": "Il y a une meulière près de ce village."
                            }
                        ]
                    },
