                "translations": [
                    {
                        "translation_id": "4573730e-1d3f-4527-851f-de8c3e598313",
                        "source_entry_id": "2214a698-13ad-3c0a-977a-99f33cd95255",
                        "source_sense_id": "7f490de5-266e-3137-8d58-cb33d8bc45d8",
                        "target_lang_word": "Freistaat",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Freistaat",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "aa2b6f21-c148-3913-9571-d970e53c5c67",
                                        "entry_id": "e4613fa6-5dab-30d1-a93c-71f55e584c4c",
                                        "glosses": [
                                            "ein Staat, in dem die Staatsgewalt vom Volk ausgeht"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a15812c0-5a7a-4435-ba3c-fee62ec760fc",
                                                "sense_id": "aa2b6f21-c148-3913-9571-d970e53c5c67",
                                                "text": "„Am 11. November 1918 verzichtete der letzte Großherzog auf den Thron und Oldenburg wurde ein Freistaat innerhalb der Weimarer Republik.“"
                                            },
                                            {
                                                "example_id": "3f0b4e89-af6b-4cb7-968d-ce811d6f0c93",
                                                "sense_id": "aa2b6f21-c148-3913-9571-d970e53c5c67",
                                                "text": "„Und doch nennen wir Schweden eine Monarchie, Venedig war eine Aristokratie und Nordamerika ist ein Freistaat.“"
                                            },
                                            {
                                                "example_id": "2bf47fd6-465e-492c-85b0-8dd7430ad2dc",
                                                "sense_id": "aa2b6f21-c148-3913-9571-d970e53c5c67",
                                                "text": "„Die vom Freistaat ursprünglich für solche Arbeiten zugesagten Fördermittel in Höhe von einer Million DM sind angesichts leerer Kassen auf 50000 Mark geschrumpft.“"
                                            },
                                            {
                                                "example_id": "70c74b79-381a-49c1-b7a7-8787208b0d87",
                                                "sense_id": "aa2b6f21-c148-3913-9571-d970e53c5c67",
                                                "text": "„Die Siegermächte des Ersten Weltkriegs legten im Versailler Vertrag fest, dass Danzig zum Freistaat unter Aufsicht des Völkerbundes werden sollte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Freistaat",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a281db1b-4812-3335-9817-6957b702ebdc",
                                        "entry_id": "8b55a0b6-9f0e-3026-a432-9893298bb978",
                                        "glosses": [
                                            "südafrikanische Provinz"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2667a3b3-ba71-4231-a73a-958d200611f4",
                                                "sense_id": "a281db1b-4812-3335-9817-6957b702ebdc",
                                                "text": "„Er hatte eine bewaffnete Rebellion von Teilen der Afrikaaner-Bevölkerung im Norden des Freistaats und im Südwesten des Transvaal zur Folge, die sich gegen Südafrikas Kriegsbeteiligung als Teil des Empire wandten und ihre alten Republiken wiederherzustellen hofften.“"
                                            },
                                            {
                                                "example_id": "9eb92a76-8380-4bb8-a93f-02efea60cfc6",
                                                "sense_id": "a281db1b-4812-3335-9817-6957b702ebdc",
                                                "text": "„Es war ein Spätnachmittag im Freistaat, und die Sonne warf einen scharfen Lichtstrahl auf den Schreibtisch, einen magischen Sonnenkegel auf den Pappkarton.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
