                ],
                "senses": [
                    {
                        "sense_id": "9f6c4e6a-609f-3068-8162-6f1f3ff2cc61",
                        "entry_id": "af39d6a0-bf97-3461-8e12-c0a7a0bb00bf",
                        "glosses": [
                            "Raum eines Hauses, in dem Seminare abgehalten werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "737e853c-697b-4e4a-b402-a6a1add2cc95",
                                "sense_id": "9f6c4e6a-609f-3068-8162-6f1f3ff2cc61",
                                "text": "Im Seminarraum funktioniert die Klimaanlage derzeit leider nicht."
                            },
                            {
                                "example_id": "5e02cb05-393f-4d5d-9d37-85c47956274a",
                                "sense_id": "9f6c4e6a-609f-3068-8162-6f1f3ff2cc61",
                                "text": "„Die Wände der Hochschulgebäude sind mit Tafeln behängt, auf denen die Namen ehemaliger Studenten stehen, weil sie etwa Stühle und Tische für Seminarräume gestiftet haben.“"
                            },
                            {
                                "example_id": "5be4823f-083e-4a96-a465-0bfb55be948e",
                                "sense_id": "9f6c4e6a-609f-3068-8162-6f1f3ff2cc61",
                                "text": "„Das war hier am Teich nicht anders als im Seminarraum.“"
                            },
                            {
                                "example_id": "a30458bf-82bb-4f55-9e2b-e29535009b4b",
                                "sense_id": "9f6c4e6a-609f-3068-8162-6f1f3ff2cc61",
                                "text": "„Sobald man den Seminarraum betritt, sieht man, dass diese Frau entweder mehr weiß oder mehr wissen will.“"
                            },
                            {
                                "example_id": "3fc7282c-b276-4ce0-9d4e-e15bd5ae88c0",
                                "sense_id": "9f6c4e6a-609f-3068-8162-6f1f3ff2cc61",
                                "text": "„Sie verschulten die Universität und machten die Seminarräume mit den Anwesenheitslisten zu den langweiligsten Orten der Bundesrepublik.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
