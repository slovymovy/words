                ],
                "senses": [
                    {
                        "sense_id": "62fc07f5-d560-320c-8d2d-153c2fc92f4f",
                        "entry_id": "cb83ed69-34f5-3588-a102-3a7eaddddb1c",
                        "glosses": [
                            "reiche Person; Person, die über erhebliche finanzielle Ressourcen/Vermögenswerte verfügt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "79a1029d-b637-4afb-a495-afcbcc07ef96",
                                "sense_id": "62fc07f5-d560-320c-8d2d-153c2fc92f4f",
                                "text": "„Vermögende dürfen heute beliebig ungebildet sein; meistens sind sie es auch und häufig sogar stolz darauf.“"
                            },
                            {
                                "example_id": "a3ca55e6-fb9f-4e31-997f-fd357062ab71",
                                "sense_id": "62fc07f5-d560-320c-8d2d-153c2fc92f4f",
                                "text": "„Wenige Vermögende verfügen über fast 60 Prozent der Kapitalmittel und bleiben unangetastet.“"
                            },
                            {
                                "example_id": "0bfd97b6-b811-4a2b-b4e4-b7ed9dddc59b",
                                "sense_id": "62fc07f5-d560-320c-8d2d-153c2fc92f4f",
                                "text": "„Die Interessen der weniger Vermögenden, schreibt er, würden von der Bundesregierung »häufig ignoriert und oft auch konterkariert«.“"
                            },
                            {
                                "example_id": "1aab820e-5a3b-405f-b9cc-c51c3ceea5df",
                                "sense_id": "62fc07f5-d560-320c-8d2d-153c2fc92f4f",
                                "text": "„Auch Vermögende spüren die Geldentwertung, sofern sie finanzielle Vermögenswerte haben, die vor Inflation schlecht geschützt sind.“"
                            },
                            {
                                "example_id": "aa0f6f40-7e80-4164-bc69-df11c2f37b0d",
                                "sense_id": "62fc07f5-d560-320c-8d2d-153c2fc92f4f",
                                "text": "„Viele Vermögende zeigen sich von der anhaltenden Diskussion um die Wiedereinführung der Vermögenssteuer zunehmend besorgt.“"
                            },
                            {
                                "example_id": "77f94aae-478f-4d24-8752-561ddc6addb7",
                                "sense_id": "62fc07f5-d560-320c-8d2d-153c2fc92f4f",
                                "text": "„Da Geld nicht arbeitet, bekommt der Vermögende es von jemanden, der dafür echte körperliche bzw. geistige Arbeit leistet.“"
                            },
                            {
                                "example_id": "226a6921-f84c-4eaa-927e-a8da45d54418",
                                "sense_id": "62fc07f5-d560-320c-8d2d-153c2fc92f4f",
                                "text": "„Zugleich gibt es in unserem Land auch Vermögende, die auch ohne staatliche Förderung entsprechende Maßnahmen vornehmen können.“"
                            },
                            {
                                "example_id": "c6b0b502-1ce9-48d1-bf4d-464a7265aca6",
                                "sense_id": "62fc07f5-d560-320c-8d2d-153c2fc92f4f",
                                "text": "„Wir haben den perfekten Diamanten, beispielsweise für das Schliessfach für Vermögende.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
