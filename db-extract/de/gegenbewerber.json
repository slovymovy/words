                "senses": [
                    {
                        "sense_id": "8cb605f5-a3ac-31d5-839e-bb7a67af2642",
                        "entry_id": "aef61c9e-8f59-3833-8bda-e380d3c80692",
                        "glosses": [
                            "Person, die sich zu einer Wahl stellt, wenn es bereits einen Kandidaten (Bewerber) gibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e940763-296a-47c0-b25c-c8ba420a6fad",
                                "sense_id": "8cb605f5-a3ac-31d5-839e-bb7a67af2642",
                                "text": "„In der großen Mehrheit der Nominierungskonferenzen (91,3%) trat der Amtsinhaber unumstritten und ohne Gegenbewerber an.“"
                            },
                            {
                                "example_id": "aef3c02b-d0a0-4771-9096-d53021fefa56",
                                "sense_id": "8cb605f5-a3ac-31d5-839e-bb7a67af2642",
                                "text": "„Jetzt aber trat der Vetter Maximilians, der Osnabrücker Bischof Franz Wilhelm von Wartenberg, als gefährlicher Gegenbewerber auf. Für ihn hatte sich bereits im Dezember 1627 der päpstliche Nuntius in Brüssel erklärt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
