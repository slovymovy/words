                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He will live until he dies <w>perhaps</w>, and then lie down in clover.",
                            "target_lang_translations": {
                                "ru": "Он проживёт, пока не умрёт, <w>быть может</w>, а затем упокоится в клевере.",
                                "nl": "Hij zal leven tot hij sterft <w>wellicht</w>, en dan in weelde rusten.",
                                "pl": "Będzie żył, dopóki <w>przypadkiem</w> nie umrze, a potem spocznie na płatkach róż.",
                                "de": "Er wird leben, bis er stirbt, <w>vielleicht</w>, und sich dann ins süße Nichtstun betten.",
                                "fr": "Il vivra jusqu'à sa mort <w>peut-être</w>, puis se reposera dans le trèfle.",
                                "it": "Vivrà finché non muore, <w>forse</w>, e poi riposerà nel trifoglio.",
                                "cs": "Bude žít, dokud <w>snad</w> neumře, a pak spočine v jeteli.",
                                "tr": "<w>Belki de</w> ölene kadar yaşayacak ve sonra rahata erecek.",
                                "es": "Vivirá hasta que muera, <w>tal vez</w>, y luego descansará en el trébol.",
                                "zh": "他<w>或许</w>会一直活到寿终正寝，然后安享晚年。"
                            }
                        },
                        {
                            "text": "If <w>perhaps</w> you find my lost keys, please call me.",
                            "target_lang_translations": {
                                "ru": "Если <w>вдруг</w> вы найдёте мои потерянные ключи, пожалуйста, позвоните мне.",
                                "nl": "Als u <w>toevallig</w> mijn verloren sleutels vindt, bel me dan alstublieft.",
                                "pl": "Jeśli <w>przypadkiem</w> znajdziesz moje zgubione klucze, zadzwoń do mnie.",
                                "de": "Wenn Sie <w>zufällig</w> meine verlorenen Schlüssel finden, rufen Sie mich bitte an.",
                                "fr": "Si <w>par hasard</w> vous trouvez mes clés perdues, s'il vous plaît, appelez-moi.",
                                "it": "Se <w>per caso</w> trovi le mie chiavi smarrite, per favore chiamami.",
                                "cs": "Pokud <w>náhodou</w> najdete mé ztracené klíče, zavolejte mi prosím.",
                                "tr": "Eğer <w>olur da</w> kayıp anahtarlarımı bulursan, lütfen beni ara.",
                                "es": "Si <w>por casualidad</w> encuentras mis llaves perdidas, por favor llámame.",
                                "zh": "如果<w>万一</w>你找到了我丢失的钥匙，请给我打电话。"
                            }
                        }
