                                "target_senses": [
                                    {
                                        "sense_id": "ed804956-1a79-3ddc-bfc4-b1972fe634bb",
                                        "entry_id": "065c6761-febb-3d33-90f9-37dbfa01bddd",
                                        "glosses": [
                                            "Eindruck machend, gut aussehend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "479f1877-7528-4c5b-8235-4413a06c2076",
                                                "sense_id": "ed804956-1a79-3ddc-bfc4-b1972fe634bb",
                                                "text": "Sie war eine sehr ansehnliche Person."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "77755a5d-0033-3291-84f8-050b5da8e20c",
                                        "entry_id": "065c6761-febb-3d33-90f9-37dbfa01bddd",
                                        "glosses": [
                                            "von beträchtlicher Größe, von beträchtlichem Umfang"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9cba159-78f2-4248-b721-880e0e6d188f",
                                                "sense_id": "77755a5d-0033-3291-84f8-050b5da8e20c",
                                                "text": "Der Berg Arbeit war ganz ansehnlich."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0c63596b-230f-473e-9bc0-605fffa8c16c",
                        "source_entry_id": "58c71932-e94e-32a6-81db-5d1002cd0c1d",
                        "source_sense_id": "b6c5ca53-d7ed-324f-8af6-0b526ff47f71",
                        "target_lang_word": "considerable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "considerable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fa80b9eb-552c-3b1a-8d37-4c41d4bcb4f1",
                                        "entry_id": "35cd78f7-aed9-36fa-bb54-e01c87a68100",
                                        "glosses": [
                                            "Significant; worth considering."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "59e09f7c-747b-42a3-8068-8ac50608e449",
                                                "sense_id": "fa80b9eb-552c-3b1a-8d37-4c41d4bcb4f1",
                                                "text": "Soon I became a considerable figure in the music industry."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "adf6063c-e55e-3034-a4bd-932b7c8700e3",
                                        "entry_id": "35cd78f7-aed9-36fa-bb54-e01c87a68100",
                                        "glosses": [
                                            "Large in amount."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13c3c949-950d-4cc6-8ff8-0dec530b70b4",
                                                "sense_id": "adf6063c-e55e-3034-a4bd-932b7c8700e3",
                                                "text": "Then there came a reg'lar terror of a sou'wester same as you don't get one summer in a thousand, and blowed the shanty flat and ripped about half of the weir poles out of the sand. We spent consider'ble money getting 'em reset, and then a swordfish got into the pound and tore the nets all to slathers, right in the middle of the squiteague season."
                                            },
                                            {
                                                "example_id": "c9cc18a9-776e-4008-ac62-caf7b4902177",
                                                "sense_id": "adf6063c-e55e-3034-a4bd-932b7c8700e3",
                                                "text": "With the cutting out of the previous recovery times for electrification work, curtailment of station times and acceleration, considerable reductions have been made in the overall schedules."
                                            },
                                            {
                                                "example_id": "99ed914a-aca6-4904-8be9-1b96e37feadd",
                                                "sense_id": "adf6063c-e55e-3034-a4bd-932b7c8700e3",
                                                "text": "When Timothy and Julia hurried up the staircase to the bedroom floor, where a considerable commotion was taking place, Tim took Barry Leach with him. He had him gripped firmly by the arm, since he felt it was not safe to let him loose, and he had no immediate idea what to do with him."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "considerable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8bd4a28c-6c6f-3377-b70d-30884c477fb7",
                                        "entry_id": "dd47e0da-1962-321f-90a3-1425eb8b337c",
                                        "glosses": [
                                            "A thing to be considered, consideration."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "644474ef-b215-4d5c-bd43-83634d59a3a2",
                                                "sense_id": "8bd4a28c-6c6f-3377-b70d-30884c477fb7",
                                                "text": "Statistes and Politicians, unto whom Ragione di Stato, is the first considerable, as though it were their businesse to deceive people, as a Maxime, do hold, that truth is to be concealed from them […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "31e34541-98b6-46e7-ba9b-80cc4a8025d6",
                        "source_entry_id": "58c71932-e94e-32a6-81db-5d1002cd0c1d",
                        "source_sense_id": "b6c5ca53-d7ed-324f-8af6-0b526ff47f71",
                        "target_lang_word": "considérable",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "considérable",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7f7c6f07-f297-34be-acdc-ca5385c40ee1",
                                        "entry_id": "8517a0dc-2c40-3e9f-a642-f977f420d2f3",
                                        "glosses": [
                                            "Qui attire la considération par l’autorité, l’influence morale ou sociale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3aea214e-89cb-4617-b8bb-384cac0565f2",
                                                "sense_id": "7f7c6f07-f297-34be-acdc-ca5385c40ee1",
                                                "text": "Elle prend du tabac, se tient roide comme un pieu, se pose en femme considérable, et ressemble parfaitement à une momie à laquelle le galvanisme aurait rendu la vie pour un instant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "98b129f1-fd44-358e-bcb2-bb96917ce919",
                                        "entry_id": "8517a0dc-2c40-3e9f-a642-f977f420d2f3",
                                        "glosses": [
                                            "Qui mérite d’être considéré en raison de l’importance, de la grandeur, du nombre, de la quantité, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a3be20fb-d57f-4575-af65-d84d5ee8c8ce",
                                                "sense_id": "98b129f1-fd44-358e-bcb2-bb96917ce919",
                                                "text": "Or, un matin, à quelques pas de ma demeure, une famille de ces ouvriers de la scie et de la hache s’empressait autour d'un amas considérable de bûches que le livreur juré venait d’aligner."
                                            },
                                            {
                                                "example_id": "ece43144-9997-4998-ab3f-33ea8031a6fc",
                                                "sense_id": "98b129f1-fd44-358e-bcb2-bb96917ce919",
                                                "text": "Des impôts considérables accablaient les vilains, écrasait les pauvres gens, épargnant les princes et les ducs, les comtes et les marquis."
                                            },
                                            {
                                                "example_id": "b10826e6-4e92-4c74-84a8-4c7412c5de6e",
                                                "sense_id": "98b129f1-fd44-358e-bcb2-bb96917ce919",
                                                "text": "Â sa plus simple expression, ce plan consistait à remanier les impôts de manière à les diminuer sans que l’État perdît ses revenus, et à obtenir, avec un budget égal au budget qui soulevait alors tant de folles discussions, des résultats deux fois plus considérables que les résultats actuels."
                                            },
                                            {
                                                "example_id": "72e9e5a8-b73c-4fe2-b17a-1e7de3c01bfb",
                                                "sense_id": "98b129f1-fd44-358e-bcb2-bb96917ce919",
                                                "text": "Tous nos étudiants de japonais nous ont apporté une aide considérable par leurs questions franches et pénétrantes."
                                            },
                                            {
                                                "example_id": "ffe963bd-ff19-431b-b541-161f4c1256e2",
                                                "sense_id": "98b129f1-fd44-358e-bcb2-bb96917ce919",
                                                "text": "Pendant la longue durée de son administration il avait amassé une fortune considérable, si considérable, en effet, qu'un jour le gouvernement chérifien jugea le moment venu de s’en emparer."
                                            },
                                            {
                                                "example_id": "882ef495-501d-4474-b698-58b26adb1517",
                                                "sense_id": "98b129f1-fd44-358e-bcb2-bb96917ce919",
                                                "text": "La distribution des récompenses suivit dans la salle du conseil municipal, à la mairie. La foule était considérable à cette heure dans les rues de Bourgtheroulde et dans l’enceinte du concours."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
