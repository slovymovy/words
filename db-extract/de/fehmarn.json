                                "sense_id": "a1eb616a-4742-3c13-8f33-efe29bfec94a",
                                "text": "Fehmarn liegt in der Ostsee."
                            },
                            {
                                "example_id": "0135671b-af66-4a27-81db-986232080640",
                                "sense_id": "a1eb616a-4742-3c13-8f33-efe29bfec94a",
                                "text": "Das Lagerfeuer auf Fehmarn erlosch erst am frühen Morgen."
                            },
                            {
                                "example_id": "d2de22e1-f975-4bb1-b5df-d3def1b06406",
                                "sense_id": "a1eb616a-4742-3c13-8f33-efe29bfec94a",
                                "text": "Unseren letzten Urlaub verbrachten wir auf Fehmarn."
                            },
                            {
                                "example_id": "b79cd40e-c714-42c3-a718-693fed911df2",
                                "sense_id": "a1eb616a-4742-3c13-8f33-efe29bfec94a",
                                "text": "Fehmarn ist ein beliebtes Urlaubsziel."
                            }
