                        "examples": [
                            {
                                "example_id": "67b80dba-4142-4047-9895-4683d0febd90",
                                "sense_id": "3be196d0-631e-343e-8d47-35c3e53b23dd",
                                "text": "Von Plauens hoopt dat hij niet door een banbliksem uit het Nederlandse Koninklijk Huis wordt getroffen, zei hij."
                            },
                            {
                                "example_id": "b1e18e80-a4d9-4baf-b5e0-96fd9e9174a4",
                                "sense_id": "3be196d0-631e-343e-8d47-35c3e53b23dd",
                                "text": "Als we de banbliksems van de industrie en Fost Plus over ons heen krijgen, is dat maar zo.’ De intercommunale wil de telling jaarlijks herhalen."
                            },
                            {
                                "example_id": "a09cc789-d570-482c-bcf0-eb049f629ec6",
                                "sense_id": "3be196d0-631e-343e-8d47-35c3e53b23dd",
                                "text": "Maar er zijn natuurlijk ook veel Polen die, zoals president Lech Kaczynski of zijn tweelingbroer Jaroslaw, de premier, menen dat het zeventien jaar na de val van het communisme hoog tijd is om eindelijk af te rekenen met het communistische verleden. Dat heeft de europarlementariërs deze week evenwel niet belet om hun banbliksem te slingeren naar de Poolse machtshebbers."
                            }
                        ]
                    }
