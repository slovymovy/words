                        ],
                        "examples": [
                            {
                                "example_id": "9dbdc846-c413-4912-a813-8da7d8c863c5",
                                "sense_id": "695e1fb5-fa60-380a-a184-95bcafbf1db9",
                                "text": "„Während sich dies vollkommen aus dem düstern Sinn erklärt, der in so manchen etruskischen Werken herrscht, während die Lugubrität dieser Sphinxdarstellungen ihre Analogie in einer ganzen Reihe von Mord-, Schlacht- und Verderbensscenen etruskischer Aschenkisten findet.“(1853)"
                            },
                            {
                                "example_id": "e8f57426-a8ed-466e-83f4-321048cb8b64",
                                "sense_id": "695e1fb5-fa60-380a-a184-95bcafbf1db9",
                                "text": "„[…] besitzt eine so vortreffliche, helle, glockenartige Stimme, wie wir gestehen, wenige zu kennen, eine Klarheit des Klanges, die den eigentlichen Sopran bezeichnet, ohne Beymischung jener Lugubrität, die der Altstimme wieder so wohl ansteht.“ (1823)"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
