                                        "examples": [
                                            {
                                                "example_id": "585adb7a-951e-45b9-bcdc-cc808aa53322",
                                                "sense_id": "ef594b54-ee4b-3c91-9e4a-16b45996e1e5",
                                                "text": "A characteristic of a field. A data domain specifies a data type and applies the minimum and maximum values allowed and other constraints."
