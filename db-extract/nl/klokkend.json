        "nl-extract.jsonl": [
            {
                "entry_id": "0555d451-4800-38ed-965e-2e4db425d6d6",
                "word": "klokkend",
                "pos": "adj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "e56f9570-7527-343c-9d5c-f99327f44325",
                        "entry_id": "0555d451-4800-38ed-965e-2e4db425d6d6",
                        "glosses": [
                            "klokrond, wijd uitvallend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3cdffd66-49e7-42b3-a4ce-7e874d10941e",
                                "sense_id": "e56f9570-7527-343c-9d5c-f99327f44325",
                                "text": "In het befaamde Clardige’s hotel in Londen showde Mulberry klokkende jassen met een ruit, bruine leren capes, rechte jurken met pailletten en truien met en royale col en wijde mouwen."
                            },
                            {
                                "example_id": "e84a45ad-d717-41ed-b41f-3fe0dcda6322",
                                "sense_id": "e56f9570-7527-343c-9d5c-f99327f44325",
                                "text": "De klokkende mantels en gerende (uitwaaierende) en asymmetrische rokken van stug wol tot over de knie oogden vloeiend en elegant."
                            },
                            {
                                "example_id": "12fcee54-839f-413f-83d5-029e3cb56933",
                                "sense_id": "e56f9570-7527-343c-9d5c-f99327f44325",
                                "text": "En er zaten ook juweeltjes bij. Zoals een blouse van organza met een volumineuze strik, een smaakvolle combinatie van een bruin bouclé jasje met een lichtblauwe leren kokerrok en bovenstukken met een klokkende rug."
                            }
                        ]
                    },
