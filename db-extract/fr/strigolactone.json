                                    {
                                        "sense_id": "5258b835-bbd2-3ec1-bef9-fa52d8d37833",
                                        "entry_id": "ff53a3a9-1dd9-3f0e-9016-33d519ae2a9a",
                                        "glosses": [
                                            "Any of a family of terpenoid lactones that stimulate germination in parasitic plants of the genus Striga, and that inhibit shoot branching."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5230d656-4a38-46e0-bf29-4ff9c60a386d",
                                                "sense_id": "5258b835-bbd2-3ec1-bef9-fa52d8d37833",
                                                "text": "2004, Christine A. Beveridge, Catherine Rameau, E2A: Strigolactones: The New Class of Branching Hormones, Peter J. Davies (editor), Plant Hormones: Biosynthesis, Signal Transduction, Action!, page 513,\nOrthologous strigolactone response mutants (max2/ore9 in Arabidopsis, rms4 in pea, d3 in rice) have been of major value to demonstrate the specificity of action of strigolactones (13, 22)."
                                            },
                                            {
                                                "example_id": "dd528548-cd1a-40f3-9b1d-fa763e8ed3c9",
                                                "sense_id": "5258b835-bbd2-3ec1-bef9-fa52d8d37833",
                                                "text": "Strigolactones are produced by the non-mycorrhizal plant Arabidopsis thaliana (Westwood 2000; Goldwasser and Yoder 2001), and plant mutants defective for strigolactone production have not yet been obtained."
                                            },
                                            {
                                                "example_id": "0113ee57-2e0e-4821-b4f6-b17e3a9eeb67",
                                                "sense_id": "5258b835-bbd2-3ec1-bef9-fa52d8d37833",
                                                "text": "The first strigolactone isolated from root exudates was strigol (Cook et al. 1966)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
