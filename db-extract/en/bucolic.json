                    {
                        "translation_id": "439e5d18-ed9c-4b94-b554-59c13d44a494",
                        "source_entry_id": "83b47f9e-b1e8-3586-8919-86773168b2d9",
                        "source_sense_description": "pertaining to herdsmen or peasants",
                        "target_lang_word": "pastoraal",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pastoraal",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "3b5c1d97-384b-3155-91cd-8c23efa4c23c",
                                        "entry_id": "b9764cb8-1c08-349f-8b89-cfdb5b173376",
                                        "glosses": [
                                            "landelijk, herderlijk"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "698a0f89-29a5-49f5-95f8-c27f98f0ff77",
                                                "sense_id": "3b5c1d97-384b-3155-91cd-8c23efa4c23c",
                                                "text": "Klinkt naar scènes vol dood en verschrikking, explosies en kapotgeschoten ruïnes, en zulke scènes zijn er óók in Robert Morins vrije bewerking van Hubert Mingarelli's roman Quatre soldats (2003). Maar generieke oorlogsgruwelen vormen minder de kern van de film alswel de omlijsting van een teder, haast pastoraal relaas over vier jonge strijders die te midden van het geweld een harmonieuze alternatieve familie vormen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "acc79454-d859-3f7d-af9f-6efd89f14583",
                                        "entry_id": "b9764cb8-1c08-349f-8b89-cfdb5b173376",
                                        "glosses": [
                                            "betrekking hebbend op iemand (vaak de pastoor of kapelaan) die als een goede herder voor het zielenheil van de aan zijn zorgen toevertrouwde gelovigen zorgt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf0cb426-e956-4cf4-a9f3-8e686512b3ce",
                                                "sense_id": "acc79454-d859-3f7d-af9f-6efd89f14583",
                                                "text": "‘Eerst ging hij aan de slag in Aarschot, daarna in twee Genkse wijken. Hij hielp ontwrichte arbeidersgezinnen met hun administratie, bouwde een pastoraal netwerkje uit, stak de handen uit de mouwen waar hij maar kon.’"
                                            },
                                            {
                                                "example_id": "a77f5776-2e67-4a1f-9a28-9258d700db83",
                                                "sense_id": "acc79454-d859-3f7d-af9f-6efd89f14583",
                                                "text": "Hij benadrukt dat er al geruime tijd geen sprake meer is van een pastorale relatie. ,,Het is nu een onderlinge vriendschap. De priester ontving het geld als privépersoon en niet uit hoofde van zijn functie. De priester wil volgens de woordvoerder niet zeggen waar het geld aan is besteed. ,,Maar gezien de hoogte van de bedragen en omdat het niet past bij de priesterlijke spiritualiteit is nu deze maatregel genomen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "63cf37cd-1c50-4bc9-b275-3cd6254e74cf",
                        "source_entry_id": "83b47f9e-b1e8-3586-8919-86773168b2d9",
                        "source_sense_description": "pertaining to herdsmen or peasants",
                        "target_lang_word": "pastoral",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pastoral",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6e119788-ce26-32a2-a8db-0b64cf8575b6",
                                        "entry_id": "6a0041ee-ceb4-3519-a097-01a47000e3ac",
                                        "glosses": [
                                            "Qui appartient aux pasteurs, aux bergers, à leurs pratiques d'élevage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "959acda4-5df6-403f-bc36-91c46203c40d",
                                                "sense_id": "6e119788-ce26-32a2-a8db-0b64cf8575b6",
                                                "text": "L'espace pastoral est constitué par les pâturages d'utilisation extensive et saisonnière."
                                            },
                                            {
                                                "example_id": "12b2b261-10e8-4b68-b08e-b8a475523e35",
                                                "sense_id": "6e119788-ce26-32a2-a8db-0b64cf8575b6",
                                                "text": "Dans les régions délimitées en application de l'article L. 113-2, des groupements dits \"groupements pastoraux\" peuvent être créés (..), en vue de l'exploitation de pâturages."
                                            },
                                            {
                                                "example_id": "ce1fabb3-0a08-4868-9910-85342a0f33cb",
                                                "sense_id": "6e119788-ce26-32a2-a8db-0b64cf8575b6",
                                                "text": "Les systèmes pastoraux se caractérisent par un recours important (sinon exclusif) aux parcours naturels comme source d’alimentation des animaux. Ils concernent essentiellement les herbivores domestiques (bovins, ovins, caprins). On trouve aussi à la marge, les animaux utilisés le plus souvent comme monture ou pour le transport de marchandises : ânes, chevaux et dromadaires."
                                            },
                                            {
                                                "example_id": "762d50a6-1be7-4cde-acfa-3633492e2457",
                                                "sense_id": "6e119788-ce26-32a2-a8db-0b64cf8575b6",
                                                "text": "En Cévennes, comme partout dans l’Hexagone, le repli des activités pastorales provoquera l’enfrichement et la dégradation des habitats d'une kyrielle d'autres espèces."
                                            },
                                            {
                                                "example_id": "be2d63c8-6daa-49ca-b874-ee4f0cb0fed0",
                                                "sense_id": "6e119788-ce26-32a2-a8db-0b64cf8575b6",
                                                "text": "En prairies permanentes, des modes de gestion adaptés (pâturage tournant notamment) peuvent favoriser la présence de légumineuses et leur diversité, indicateur de valeur pastorale et de qualité fourragère."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d109c7af-59d9-32e4-a756-05ad92eeb9fb",
                                        "entry_id": "6a0041ee-ceb4-3519-a097-01a47000e3ac",
                                        "glosses": [
                                            "Qui retrace ou évoque la vie, les mœurs des pasteurs, des bergers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c15c6c2a-b5f8-4097-bd7f-da34e5680754",
                                                "sense_id": "d109c7af-59d9-32e4-a756-05ad92eeb9fb",
                                                "text": "Dans un souvenir pastoral, les vers d'une triste idylle écrite par La Fontaine flottèrent devant sa mémoire rêveuse,.."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0d342a6b-250d-3d2b-aa2c-3aa683c7ee8b",
                                        "entry_id": "6a0041ee-ceb4-3519-a097-01a47000e3ac",
                                        "glosses": [
                                            "Qui appartient aux pasteurs spirituels."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64180c7e-39c6-4389-9c1f-79ba00cd3f34",
                                                "sense_id": "0d342a6b-250d-3d2b-aa2c-3aa683c7ee8b",
                                                "text": "Francis Comby, maire de Beyssenac, très honoré de cette visite pastorale, a chaleureusement remercié Monseigneur Bestion qui a pris le temps de dialoguer avec les Beyssenacois, ce qui marque ainsi son attention auprès des communes rurales et de leurs habitants."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
