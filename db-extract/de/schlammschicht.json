                "senses": [
                    {
                        "sense_id": "3225b696-c41f-38b8-977a-beeeb045c219",
                        "entry_id": "77964757-7d0a-354f-99df-3dc48baf512c",
                        "glosses": [
                            "Schicht von Schlamm"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "698ba5a6-481a-4887-997d-b7e71506416e",
                                "sense_id": "3225b696-c41f-38b8-977a-beeeb045c219",
                                "text": "„Überall, wo das Wasser hinkam, wuchs eine dicke Schlammschicht, die die Farbe von Blutegeln hatte.“"
                            },
                            {
                                "example_id": "a22fbcd9-31bc-4be9-9f43-dc0d8c2fa12e",
                                "sense_id": "3225b696-c41f-38b8-977a-beeeb045c219",
                                "text": "„Wie alle Männer an Bord von Capitana war Pierre von der Sonne gebräunt, seine Kleider, Gesicht und Haare waren von einer dünnen Öl- und Schlammschicht bedeckt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
