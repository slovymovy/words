                "translations": [
                    {
                        "translation_id": "e2fc6053-af29-4aaa-ae48-124daededa52",
                        "source_entry_id": "61528545-1151-327f-9862-45d1f98be5ed",
                        "source_sense_id": "0b721687-b42e-3a38-a879-9d8a1802622c",
                        "source_sense_description": "toename",
                        "target_lang_word": "Zuwachs",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zuwachs",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7859afb8-37b8-36c6-ab65-5bc8dcbb3bce",
                                        "entry_id": "38091536-04a7-3f18-9eeb-e331b5385a76",
                                        "glosses": [
                                            "der Anstieg in Größe oder an Wert von etwas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f6f054d-f5bf-4883-b5aa-07fe69a4197d",
                                                "sense_id": "7859afb8-37b8-36c6-ab65-5bc8dcbb3bce",
                                                "text": "„Zuwächse erwartet das Unternehmen aus Hannover allerdings von den Märkten in Asien und Osteuropa.“"
                                            },
                                            {
                                                "example_id": "40a2cbaa-7e15-4a43-a49a-beeccbb96d1d",
                                                "sense_id": "7859afb8-37b8-36c6-ab65-5bc8dcbb3bce",
                                                "text": "„Der Ifo-Geschäftsklimaindex ist im Januar zum nunmehr zehnten Mal in Folge gestiegen. Experten hatten mit einem schwächeren Zuwachs gerechnet.“"
                                            },
                                            {
                                                "example_id": "74a6d783-1ccf-41a6-8faa-251b7d7a9f6e",
                                                "sense_id": "7859afb8-37b8-36c6-ab65-5bc8dcbb3bce",
                                                "text": "„So entfällt mehr als ein Drittel des Zuwachses auf die Q-Modelle.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "56ec6b05-606e-3885-a66d-69b3c9d6ef07",
                                        "entry_id": "38091536-04a7-3f18-9eeb-e331b5385a76",
                                        "glosses": [
                                            "(künftige) Geburt eines Kindes, Nachwuchs"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "humorous"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "09eba93a-1d1d-40fc-b1fd-710690c690e7",
                                                "sense_id": "56ec6b05-606e-3885-a66d-69b3c9d6ef07",
                                                "text": "Haben Deine Schäferhunde schon wieder Zuwachs bekommen?"
                                            },
                                            {
                                                "example_id": "69a03d5e-df17-49cb-930c-ee2cc22079b3",
                                                "sense_id": "56ec6b05-606e-3885-a66d-69b3c9d6ef07",
                                                "text": "„Wie der Ernst denn beabsichtige, seine Familie zu ernähren, nun, da Zuwachs erwartet werde?, fragte Papa, als Ida ihm die Neuigkeiten überbrachte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "21760604-2126-3611-a2e5-591b0d76eb13",
                                        "entry_id": "38091536-04a7-3f18-9eeb-e331b5385a76",
                                        "glosses": [
                                            "die Vergrößerung des Bestandes durch das Wachstum der Bäume"
                                        ],
                                        "tags": [
                                            "Forstwirtschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f671b80-f797-4e29-bd5a-24e4fc5ca23a",
                                                "sense_id": "21760604-2126-3611-a2e5-591b0d76eb13",
                                                "text": "Unsere Baumschule hat dieses Jahr einen guten Zuwachs."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "98cb2e1f-de21-4ac9-a812-8be2ccbdfb83",
                        "source_entry_id": "61528545-1151-327f-9862-45d1f98be5ed",
                        "source_sense_id": "0b721687-b42e-3a38-a879-9d8a1802622c",
                        "source_sense_description": "toename",
                        "target_lang_word": "Zunahme",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zunahme",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "77f8317a-6848-387a-8856-585b81eadac6",
                                        "entry_id": "83559532-0d67-31ed-98ce-dbed623e54fa",
                                        "glosses": [
                                            "der Vorgang, bei dem etwas in der Menge oder im Volumen zunimmt, anwächst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e86691b-835e-420a-93b1-20313e214c2e",
                                                "sense_id": "77f8317a-6848-387a-8856-585b81eadac6",
                                                "text": "Die Lehrer der hiesigen Schule glauben eine Zunahme der Übergriffe von Schülern auf Schüler ausgemacht zu haben."
                                            },
                                            {
                                                "example_id": "42972488-49ec-4430-bd70-f9a01fcb08e5",
                                                "sense_id": "77f8317a-6848-387a-8856-585b81eadac6",
                                                "text": "Ein Krebsexperte der chinesischen Akademie der Wissenschaften führte die Zunahme auf \"ungesunden Lebensstil\" zurück - wozu er neben ungesunder Ernährung und wachsendem Stress auch die Umweltverschmutzung zählte."
                                            },
                                            {
                                                "example_id": "f8e17635-55aa-4eec-a1a1-550caf7944cc",
                                                "sense_id": "77f8317a-6848-387a-8856-585b81eadac6",
                                                "text": "Die deutlichsten Zunahmen [der Kinderkriminalität] seien in Rheinland-Pfalz (plus 17 Prozent), Bayern (14 Prozent), Baden-Württemberg (neun Prozent) sowie Hessen und Sachsen (je acht Prozent) festzustellen."
                                            },
                                            {
                                                "example_id": "3aab0029-72c7-4de9-93a0-c422c22f99e2",
                                                "sense_id": "77f8317a-6848-387a-8856-585b81eadac6",
                                                "text": "„Das Phänomen, eine deutliche Zunahme präfigierter Verben in unserem Sprachgebrauch, läßt sich nicht bestreiten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3acb7b82-b1c9-4312-90c6-813759a2975a",
                        "source_entry_id": "61528545-1151-327f-9862-45d1f98be5ed",
                        "source_sense_id": "0b721687-b42e-3a38-a879-9d8a1802622c",
                        "source_sense_description": "toename",
                        "target_lang_word": "growth",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "growth",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "04e7dcf2-82e6-3dd5-9d59-747774a45e83",
                                        "entry_id": "36801bc0-447a-3065-a800-d313712d0a3f",
                                        "glosses": [
                                            "An increase in size, number, value, or strength."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b02be64-b50e-4174-8707-4cb23c413e65",
                                                "sense_id": "04e7dcf2-82e6-3dd5-9d59-747774a45e83",
                                                "text": "It may be that a free society as we have known it carries in itself the forces of its own destruction, that once freedom has been achieved it is taken for granted and ceases to be valued, and that the free growth of ideas which is the essence of a free society will bring about the destruction of the foundations on which it depends."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "449d4ad8-a473-301e-ac05-efbcf67f7fb0",
                                        "entry_id": "36801bc0-447a-3065-a800-d313712d0a3f",
                                        "glosses": [
                                            "Ellipsis of economic growth."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "countable",
                                            "ellipsis",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c5bf1b06-a372-44b9-99ae-f5503cc759f0",
                                                "sense_id": "449d4ad8-a473-301e-ac05-efbcf67f7fb0",
                                                "text": "Growth was dampened by a softening of the global economy in 2001, but picked up in the subsequent years due to strong growth in China."
                                            },
                                            {
                                                "example_id": "417ab00b-cd9a-405e-bc29-d3f02a744ea6",
                                                "sense_id": "449d4ad8-a473-301e-ac05-efbcf67f7fb0",
                                                "text": "Private-equity nabobs bristle at being dubbed mere financiers.[…]Much of their pleading is public-relations bluster. Clever financial ploys are what have made billionaires of the industry’s veterans. “Operational improvement” in a portfolio company has often meant little more than promising colossal bonuses to sitting chief executives if they meet ambitious growth targets. That model is still prevalent today."
                                            },
                                            {
                                                "example_id": "c345634e-9ed6-4e8d-b718-f9f0c9ed47fe",
                                                "sense_id": "449d4ad8-a473-301e-ac05-efbcf67f7fb0",
                                                "text": "Liz Truss has promised Britons she has “got your back” and set out a plan for “growth, growth and growth” in a conference speech disrupted by protesters asking who voted for her plan."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "99d6ecc0-18b0-3bc8-8bce-b9c3d7a075cf",
                                        "entry_id": "36801bc0-447a-3065-a800-d313712d0a3f",
                                        "glosses": [
                                            "An increase in psychological strength or resilience; an increased ability to overcome adversity."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a1b852a-0c29-4102-b2a3-8b0960194512",
                                                "sense_id": "99d6ecc0-18b0-3bc8-8bce-b9c3d7a075cf",
                                                "text": "Struggle, disappointment, and criticism all contribute to a person's growth."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "acdfb455-e211-3902-82fe-24abb24566bf",
                                        "entry_id": "36801bc0-447a-3065-a800-d313712d0a3f",
                                        "glosses": [
                                            "The act of growing, getting bigger or higher."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d3f95cda-fc03-3ac6-a6e3-c4ef1d813652",
                                        "entry_id": "36801bc0-447a-3065-a800-d313712d0a3f",
                                        "glosses": [
                                            "Something that grows or has grown."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "79d83188-ff55-4cdf-88e3-bc9bc12d9f27",
                                                "sense_id": "d3f95cda-fc03-3ac6-a6e3-c4ef1d813652",
                                                "text": "Scary-looking rabbits were hopping around Fort Collins. These weren’t your standard cute, fluffy bunnies; they had horn-like growths protruding from their faces and bodies."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "079e84b8-f486-3df6-a5b6-20c519b970bb",
                                        "entry_id": "36801bc0-447a-3065-a800-d313712d0a3f",
                                        "glosses": [
                                            "An abnormal mass such as a tumor."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "be6c09de-e1dc-4394-8c35-9ea6712e5872",
                        "source_entry_id": "61528545-1151-327f-9862-45d1f98be5ed",
                        "source_sense_id": "0b721687-b42e-3a38-a879-9d8a1802622c",
                        "source_sense_description": "toename",
                        "target_lang_word": "fouling",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fouling",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "56f99c0f-5439-3f67-afa0-7be18f1b2670",
                                        "entry_id": "2d63a938-3a92-30a5-abf3-76e4b0864a75",
                                        "glosses": [
                                            "present participle and gerund of foul"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "gerund",
                                            "participle",
                                            "present"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1ae703b9-70a4-4d3f-b56c-d96e085f8178",
                                                "sense_id": "56f99c0f-5439-3f67-afa0-7be18f1b2670",
                                                "text": "A new type of fouling point indicator is being tried out by the London Transport Executive. Until now the standard method of indicating the point nearest to a junction of two stabling roads where a train can stand without fouling the adjacent road has been by fixing the letters \"FP\" [fouling point] to the sleepers of the road concerned."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fouling",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cfb9c0e8-b4a8-3b59-bb7c-e1297ac55e83",
                                        "entry_id": "9255acf2-58b9-30d5-9f8b-39fcc00cc237",
                                        "glosses": [
                                            "The adhesion of a foreign material onto a surface, especially so as to reduce its functionality."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a6182d8-6b1d-4816-9996-ee026533d66c",
                                                "sense_id": "cfb9c0e8-b4a8-3b59-bb7c-e1297ac55e83",
                                                "text": "Probably, rifling evolved from the early observation of the feathers on an arrow-and from the practical results of cutting channels in a musket, originally to reduce fouling, then because it was found to improve accuracy of the shot."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "24d053af-2f4c-4c72-91e6-65b23b80298c",
                        "source_entry_id": "61528545-1151-327f-9862-45d1f98be5ed",
                        "source_sense_id": "0b721687-b42e-3a38-a879-9d8a1802622c",
                        "source_sense_description": "toename",
                        "target_lang_word": "accroissement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "accroissement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9d4dd493-025b-3ab4-b529-90253d8db6ca",
                                        "entry_id": "83e602c2-e84d-30cf-a91b-f7a3fb928538",
                                        "glosses": [
                                            "Action de croître, de se développer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21c21c28-6f8e-46a9-a12d-917da6efa0ed",
                                                "sense_id": "9d4dd493-025b-3ab4-b529-90253d8db6ca",
                                                "text": "Le développement de cette espèce est de type hétérométabole : l’accroissement de la taille se fait progressivement au cours de quatre mues juvéniles et d'une mue imaginale et s'accompagne de changements dans les proportions du corps."
                                            },
                                            {
                                                "example_id": "6b16193a-735e-4650-902e-68584427df49",
                                                "sense_id": "9d4dd493-025b-3ab4-b529-90253d8db6ca",
                                                "text": "… hélas ! tes vingt ans rendront paisible le sommeil des parvenus sexagénaires, à moins que ton sang n’aille, dans les pays équatoriaux, engraisser le territoire enlevé par violence aux peuples indigènes, pour l’accroissement des larrons, prêtres, soudards ou financiers."
                                            },
                                            {
                                                "example_id": "e3b14260-9f4b-4b34-a385-ffabc8bc7ca3",
                                                "sense_id": "9d4dd493-025b-3ab4-b529-90253d8db6ca",
                                                "text": "L’accroissement de la longueur des linéaires s'est accompagné d'une plus grande diversité des références: progression de 11% dans les hypers et de 9% dans les supers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "53521fb3-f5be-3816-8713-032829714f00",
                                        "entry_id": "83e602c2-e84d-30cf-a91b-f7a3fb928538",
                                        "glosses": [
                                            "L’augmentation que reçoit la personne ou l’objet qui s’accroît."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c20dd656-8dcd-49f3-b211-65a13b0913eb",
                                                "sense_id": "53521fb3-f5be-3816-8713-032829714f00",
                                                "text": "L’accroissement d’un état."
                                            },
                                            {
                                                "example_id": "c0d4f31c-0c20-4095-80a3-49dd4e63f4f8",
                                                "sense_id": "53521fb3-f5be-3816-8713-032829714f00",
                                                "text": "L’accroissement des rivières."
                                            },
                                            {
                                                "example_id": "416bf38f-e981-41ac-9475-7f376eb37dbc",
                                                "sense_id": "53521fb3-f5be-3816-8713-032829714f00",
                                                "text": "Un accroissement, des accroissements de biens, d’honneurs, de fortune."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "646de7f7-5783-3a5d-881c-13ceb1acd58e",
                                        "entry_id": "83e602c2-e84d-30cf-a91b-f7a3fb928538",
                                        "glosses": [
                                            "Droit par lequel une chose accroît à quelque personne ou à quelque fonds."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ece7e96d-dd82-440d-95b1-a91700bca26a",
                                                "sense_id": "646de7f7-5783-3a5d-881c-13ceb1acd58e",
                                                "text": "La loi attribue aux héritiers et aux légataires survivants, capables et acceptants, la part des cohéritiers morts, devenus incapables ou renonçants en vertu d’un droit d’accroissement."
                                            },
                                            {
                                                "example_id": "8e611d30-5484-451b-b5c9-d9f532f6e41c",
                                                "sense_id": "646de7f7-5783-3a5d-881c-13ceb1acd58e",
                                                "text": "Les terres que l’eau ajoute peu à peu au bord des fleuves ou des rivières appartiennent aux riverains par droit d’accroissement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c2592891-5fca-39d6-a941-952b4a7ff9f4",
                                        "entry_id": "83e602c2-e84d-30cf-a91b-f7a3fb928538",
                                        "glosses": [
                                            "Droit établi dans une société civile sur la part des membres ayant cessé de faire partie de la société, qui augmente la part des membres restants."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9c1b470c-d49e-3def-b1a9-21312331c12e",
                                        "entry_id": "83e602c2-e84d-30cf-a91b-f7a3fb928538",
                                        "glosses": [
                                            "Augmentation du volume de bois ou de la surface terrière d’un peuplement du fait de la croissance naturelle des arbres."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61dabb61-8fdb-47d1-9b78-dd09c21642d7",
                                                "sense_id": "9c1b470c-d49e-3def-b1a9-21312331c12e",
                                                "text": "En effet, outre cette approche individuelle des arbres lors du martelage, le niveau de prélèvement est guidé par le capital sur pied (existant et souhaité) et l’accroissement courant du peuplement, évalués de plus en plus souvent en surface terrière, mais qui peuvent l’être aussi en volume."
                                            }
                                        ]
                                    }
