                "senses": [
                    {
                        "sense_id": "a9845bfd-b3e0-30f5-bb9c-45d335044247",
                        "entry_id": "51315986-2dba-3bf3-9c95-2c511c76217c",
                        "glosses": [
                            "aus Plastik bestehender Behälter"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a90224ec-e8af-4920-869c-c75a797c66d6",
                                "sense_id": "a9845bfd-b3e0-30f5-bb9c-45d335044247",
                                "text": "„Die entnommene Staubprobe und der Filter sind anschließend in ein steriles Kunststoffbehältnis zu geben.“"
                            },
                            {
                                "example_id": "8a9ebd52-a145-4a35-b9a7-140aa853d2b8",
                                "sense_id": "a9845bfd-b3e0-30f5-bb9c-45d335044247",
                                "text": "„Heute sind um die zehn Euro aufzuwenden für ein ummanteltes Kunststoffbehältnis von zwei Litern Fassungsvermögen.“"
                            },
                            {
                                "example_id": "70d1606b-f4e8-4345-ab6d-f7077ed4bb9b",
                                "sense_id": "a9845bfd-b3e0-30f5-bb9c-45d335044247",
                                "text": "„Kunststoffbehältnisse sind aus einem oder mehreren Polymeren und eventuell aus bestimmten Hilfsstoffen zusammengesetzt.“"
                            },
                            {
                                "example_id": "d4950969-02f4-4c1a-9850-1723d5ff9be5",
                                "sense_id": "a9845bfd-b3e0-30f5-bb9c-45d335044247",
                                "text": "„Als sie den Mann durchsuchten, fanden die Beamten ein kleines Kunststoffbehältnis mit Marihuana.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
