                        "examples": [
                            {
                                "example_id": "1079de2d-673d-46b1-b0b8-bf6d62576856",
                                "sense_id": "3b49abfe-0c77-302a-b37c-c62aa0c77040",
                                "text": "⧖ De Heer Huskisson, zegt hij, is, gelijk zijn vriend Canning was, een voorstander van een vrijzinnig stelsel van buiten- en binnenlandsche staatkunde, maar zij waren beide even ver verwijderd van de overdrevene gevoelens der Whigs."
                            }
                        ]
                    },
                    {
                        "sense_id": "d277689e-fd24-3d8f-8c47-cac93bdbf698",
                        "entry_id": "d6fa7c1b-cc4c-314d-8c17-b4d9eaabb579",
                        "glosses": [
                            "gelovig, niet aan dogma's gebonden, maar met de opdracht zelf de waarheid te ontdekken"
                        ],
                        "tags": [
                            "Nederland"
                        ],
