                    "sense_id": "6768b68f-e8ca-3b19-bdeb-6fbb6d680699",
                    "sense_definition": "Zich kunnen inleven in wat iemand anders voelt, denkt of wil.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "mental_grasp",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik kan heel goed <w>begrijpen</w> dat je teleurgesteld bent.",
                            "target_lang_translations": {
                                "en": "I can fully <w>understand</w> that you are disappointed.",
                                "ru": "Я очень хорошо <w>понимаю</w>, что ты разочарован.",
                                "pl": "Doskonale potrafię <w>zrozumieć</w>, że jesteś rozczarowany.",
                                "de": "Ich kann sehr gut <w>verstehen</w>, dass du enttäuscht bist.",
                                "fr": "Je peux tout à fait <w>comprendre</w> que tu sois déçu.",
                                "it": "Posso <w>capire</w> benissimo che tu sia deluso.",
                                "cs": "Dokážu velmi dobře <w>pochopit</w>, že jsi zklamaný.",
                                "tr": "Hayal kırıklığına uğramanı çok iyi <w>anlayabiliyorum</w>.",
                                "es": "Puedo <w>entender</w> perfectamente que estés decepcionado."
                            }
                        },
                        {
                            "text": "Zij <w>begrijpen</w> elkaar zonder woorden.",
                            "target_lang_translations": {
                                "en": "They <w>understand</w> each other without words.",
                                "ru": "Они <w>понимают</w> друг друга без слов.",
                                "pl": "Oni <w>rozumieją</w> się bez słów.",
                                "de": "Sie <w>verstehen</w> sich ohne Worte.",
                                "fr": "Ils se <w>comprennent</w> sans mots.",
                                "it": "Si <w>capiscono</w> senza parole.",
                                "cs": "Oni si <w>rozumějí</w> beze slov.",
                                "tr": "Onlar birbirlerini sözsüz <w>anlıyorlar</w>.",
                                "es": "Ellos se <w>entienden</w> sin palabras."
                            }
                        }
