                ],
                "senses": [
                    {
                        "sense_id": "7172309a-71fd-383a-891b-8911151806e4",
                        "entry_id": "4a8bb45f-86be-37d0-8527-558e92ebe794",
                        "glosses": [
                            "устар. управление кем-либо, чем-либо; способ управления"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99eb9e0a-f8ea-4a1f-905c-0f8223f94112",
                                "sense_id": "7172309a-71fd-383a-891b-8911151806e4",
                                "text": "[Пимен:] В часы, // Свободные от подвигов духовных, // Описывай, не мудрствуя лукаво, // Всё то, чему свидетель в жизни будешь: // Войну и мир, управу государей, // Угодников святые чудеса .."
                            },
                            {
                                "example_id": "7de09977-2124-46eb-af41-cf81672b2e4f",
                                "sense_id": "7172309a-71fd-383a-891b-8911151806e4",
                                "text": "Всё занимало их [Остапа и Андрия]: разгульные обычаи Сечи и немногосложная управа и законы .."
                            }
                        ]
                    },
                    {
                        "sense_id": "18ae2329-2afb-3591-8863-afbb84c54f12",
                        "entry_id": "4a8bb45f-86be-37d0-8527-558e92ebe794",
                        "glosses": [
                            "устар. удовлетворение за причинённую обиду, преимущественно в форме судебного приговора"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b0d2470a-f458-46df-93ed-78f957f4e3dd",
                                "sense_id": "18ae2329-2afb-3591-8863-afbb84c54f12",
                                "text": "[Альбер:] Проклятое житьё! // Нет, решено — пойду искать управы // У герцога: пускай отца заставят // Меня держать как сына, не как мышь, // Рождённую в подполье."
                            }
                        ]
                    }
                ],
