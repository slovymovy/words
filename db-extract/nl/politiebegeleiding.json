                        "examples": [
                            {
                                "example_id": "64652403-18ff-447f-ab6e-48d1f7854b31",
                                "sense_id": "8a4778fd-76fc-352b-aeff-42222a79475c",
                                "text": "Ongeveer elk kwartier vertrekt vandaag een vrachtwagen met vier patiënten onder politiebegeleiding. Langs de route zijn verkeersregelaars ingezet. De snelheid op de route is aangepast, zodat de voertuigen in één keer kunnen doorrijden en niet hoeven te stoppen bij kruisingen."
                            },
                            {
                                "example_id": "d93ec9c9-5200-41cb-9c09-b6b6eda50e0f",
                                "sense_id": "8a4778fd-76fc-352b-aeff-42222a79475c",
                                "text": "Volgens een politiewoordvoerder zijn de arrestaties verricht vanwege belediging en openlijke geweldpleging, omdat er met stenen naar de politie werd gegooid. In de wijk waren de politie en de ME aanwezig, onder meer rond het Tesselseplein. Ook hing er de hele avond een helikopter boven de wijk. De brandweer had politiebegeleiding nodig om brandjes te blussen."
                            }
                        ]
                    }
