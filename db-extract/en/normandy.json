                                    {
                                        "sense_id": "f5121c5f-6a9f-30ae-beaa-a4e2d37791c1",
                                        "entry_id": "753aeceb-63f1-341d-977e-e14b25ee1d93",
                                        "glosses": [
                                            "een streek in het noorden van Frankrijk"
                                        ],
                                        "tags": [
                                            "toponymic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9b2c6db3-0049-497a-aa6c-9915cb7a6a13",
                                                "sense_id": "f5121c5f-6a9f-30ae-beaa-a4e2d37791c1",
                                                "text": "De Kanaaleilanden liggen voor de kust van Normandië."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "de21f8a6-0b98-4f37-a5bc-5f99caeb6af7",
                        "source_entry_id": "5b4ba49b-1cc3-3d4c-a67d-6d9d2c2cb76d",
                        "source_sense_description": "region of France",
                        "target_lang_word": "Normandie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Normandie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "25cc662f-619b-3db7-bed0-953b1d2d2cce",
                                        "entry_id": "17f364e1-1085-3ec3-9c19-b51441c0741b",
                                        "glosses": [
                                            "Ancienne province de France qui correspond à la région administrative actuelle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "76f2f76e-12cf-40a8-9ec4-61aaea0c04f2",
                                                "sense_id": "25cc662f-619b-3db7-bed0-953b1d2d2cce",
                                                "text": "Quelle différence, en effet, entre le cheval arabe léger, vif, sanguin, et les gros chevaux du Danemarck, du Hanovre, de la Hollande et de la Normandie aux formes lourdes et empâtées et au tempérament essentiellement lymphatique."
                                            },
                                            {
                                                "example_id": "b5b3261e-20e0-4290-b93f-8a5936b17384",
                                                "sense_id": "25cc662f-619b-3db7-bed0-953b1d2d2cce",
                                                "text": "J’effraye Michal comme on effraye une cousine en Normandie, avec l’aide d'une rainette, d’une araignée."
                                            },
                                            {
                                                "example_id": "ee5f333a-616d-4b42-b4ca-5dbf14605a12",
                                                "sense_id": "25cc662f-619b-3db7-bed0-953b1d2d2cce",
                                                "text": "Le Sapin (Abies pectinata) se rencontre aussi en Normandie ; sa spontanéité paraît certaine."
                                            },
                                            {
                                                "example_id": "ec729dec-211d-498f-9ff2-a9d6499abfa6",
                                                "sense_id": "25cc662f-619b-3db7-bed0-953b1d2d2cce",
                                                "text": "[…] la Normandie avait adopté un régime dotal qu’[…]on ne peut faire provenir du régime romain : les règles des deux sont très différentes, l’influence romaine est d’ailleurs douteuse sur la coutume normande : la dot ne désigne pas l’apport au mari par la femme, mais un apport du mari à la femme comme dans la dos ex marito du droit franc."
                                            },
                                            {
                                                "example_id": "a2b4bfec-bb64-4749-8a61-f31711847f24",
                                                "sense_id": "25cc662f-619b-3db7-bed0-953b1d2d2cce",
                                                "text": "Situé au confluent de la Bresle et de la Méline, Guémicourt comme Beaucamps-le-Jeune était en Normandie et fut rattaché au district d'Amiens en 1790."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6cd95096-03ac-39f9-891c-c0638196b17e",
                                        "entry_id": "17f364e1-1085-3ec3-9c19-b51441c0741b",
                                        "glosses": [
                                            "Région administrative française créée le 1ᵉʳ janvier 2016 de la fusion des régions de Haute-Normandie et Basse-Normandie."
                                        ],
                                        "tags": [
                                            "toponymic"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "075613cd-039a-4eef-ac61-6daaa69d4e54",
                        "source_entry_id": "5b4ba49b-1cc3-3d4c-a67d-6d9d2c2cb76d",
                        "source_sense_description": "region of France",
                        "target_lang_word": "Normandie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Normandie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d815b076-75e1-32d3-8d77-fa9db0581020",
                                        "entry_id": "2f5c4f02-f805-351e-a620-a4bdc3d0ac73",
                                        "glosses": [
                                            "Region (ehemalige Provinz) in Frankreich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a8ef037d-1e05-48c1-a58d-5f222f81b446",
                                                "sense_id": "d815b076-75e1-32d3-8d77-fa9db0581020",
                                                "text": "Ich war schon dreimal im Urlaub in der Normandie."
                                            },
                                            {
                                                "example_id": "e20b3ee5-1f0c-4133-9daa-754177561fb2",
                                                "sense_id": "d815b076-75e1-32d3-8d77-fa9db0581020",
                                                "text": "„Gans’ Einheit hilft den alliierten Truppen bei der Invasion in der Normandie 1944 mit geheimdienstlichen Methoden.“"
                                            },
                                            {
                                                "example_id": "3ecc62a1-d1ab-4ee0-a290-5f70134850e9",
                                                "sense_id": "d815b076-75e1-32d3-8d77-fa9db0581020",
                                                "text": "„Die Hecken und Obstbaumgärten der Normandie flogen vorüber.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
