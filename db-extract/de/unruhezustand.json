                ],
                "senses": [
                    {
                        "sense_id": "30dd1e83-a8d6-3100-ab3d-2421bcd5391b",
                        "entry_id": "5068defb-0271-3e62-b94e-baa9723f9ac5",
                        "glosses": [
                            "Mangel an Ruhe; andauernde Ruhelosigkeit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "454c224f-129d-4f3f-90e8-ce6b47b7e753",
                                "sense_id": "30dd1e83-a8d6-3100-ab3d-2421bcd5391b",
                                "text": "„Hilft die Medikation nicht, kann man dem Unruhezustand mit den anderen, schon genannten Mitteln auf die Pelle rücken.“"
                            },
                            {
                                "example_id": "92387e0d-5d9d-42ca-a58d-9cdf5c0299b1",
                                "sense_id": "30dd1e83-a8d6-3100-ab3d-2421bcd5391b",
                                "text": "„Dann entsteht eine Übererregung, ein Unruhezustand, in dem der Säugling zu zappeln, zu schreien anfängt und nur schwer zu beruhigen ist.“"
                            },
                            {
                                "example_id": "66fa340d-9344-4bbe-9ab7-3f6094bc6f85",
                                "sense_id": "30dd1e83-a8d6-3100-ab3d-2421bcd5391b",
                                "text": "„Die Zeit des Waldbadens bietet uns eine wunderbare Möglichkeit, diesem Unruhezustand und der inneren Zerrissenheit zu entfliehen und ganz bei uns selbst zu sein.“"
                            },
                            {
                                "example_id": "ace29461-f289-4fcd-bb92-370edacf1812",
                                "sense_id": "30dd1e83-a8d6-3100-ab3d-2421bcd5391b",
                                "text": "„Auch wenn es unwahrscheinlich ist, dass das Unternehmen am Abend anruft – allein das Bewusstsein, dass es passieren könnte, versetzt den Arbeitnehmer schon in einen Unruhezustand.“"
                            },
                            {
                                "example_id": "494df090-9af0-47bd-8dde-536ccc5aa072",
                                "sense_id": "30dd1e83-a8d6-3100-ab3d-2421bcd5391b",
                                "text": "„Selbstmordgedanken hegte ich nicht wirklich (wenn ich alleine gewesen wäre, dann hätte ich diesen unerträglichen Unruhezustand beendet), denn meinen Freund wollte ich niemals unglücklich machen.“"
                            },
                            {
                                "example_id": "422bd23c-fd49-4bfd-94aa-0f2d4ac319d3",
                                "sense_id": "30dd1e83-a8d6-3100-ab3d-2421bcd5391b",
                                "text": "„Motorische Unruhezustände sind sehr eng mit dem Auftreten von aggressivem Verhalten verknüpft.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
