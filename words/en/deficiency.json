    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4746c8d0-797e-3fd5-b6d7-cec541d03a6e",
                    "sense_definition": "A lack or shortage of something necessary, especially for health or completeness.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "shortage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A severe vitamin <w>deficiency</w> can lead to serious health problems over time.",
                            "target_lang_translations": {
                                "ru": "Сильный <w>дефицит</w> витаминов со временем может привести к серьезным проблемам со здоровьем."
                            }
                        },
                        {
                            "text": "The doctor recommended supplements to address the iron <w>deficiency</w> found in the blood test.",
                            "target_lang_translations": {
                                "ru": "Врач рекомендовал добавки, чтобы восполнить <w>недостаток</w> железа, обнаруженный в анализе крови."
                            }
                        }
                    ],
                    "synonyms": [
                        "lack",
                        "want"
                    ],
                    "antonyms": [
                        "sufficiency",
                        "excess"
                    ],
                    "common_phrases": [
                        "vitamin deficiency",
                        "iron deficiency",
                        "nutritional deficiency"
                    ],
                    "target_lang_definitions": {
                        "ru": "Нехватка или отсутствие чего-либо необходимого, особенно для здоровья или полноты состава."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дефицит",
                                "target_lang_sense_clarification": "нехватка ресурсов или веществ"
                            },
                            {
                                "target_lang_word": "недостаток",
                                "target_lang_sense_clarification": "отсутствие нужного количества"
                            },
                            {
                                "target_lang_word": "нехватка",
                                "target_lang_sense_clarification": "недостаточное наличие"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2d786e1c-9295-3ad6-9601-56a38c90b251",
                    "sense_definition": "A failure, fault, or shortcoming in a system, person, or thing.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "shortage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The audit identified a significant <w>deficiency</w> in the company's internal security protocols.",
                            "target_lang_translations": {
                                "ru": "Аудит выявил значительный <w>изъян</w> в протоколах внутренней безопасности компании."
                            }
                        },
                        {
                            "text": "Despite his talent, his main <w>deficiency</w> as a leader was his lack of patience.",
                            "target_lang_translations": {
                                "ru": "Несмотря на талант, его главным <w>недостатком</w> как лидера было отсутствие терпения."
                            }
                        }
                    ],
                    "synonyms": [
                        "lack",
                        "lackingness"
                    ],
                    "common_phrases": [
                        "serious deficiency",
                        "mental deficiency",
                        "structural deficiency"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сбой, изъян или несовершенство в системе, человеке или предмете."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "недостаток",
                                "target_lang_sense_clarification": "изъян или несовершенство"
                            },
                            {
                                "target_lang_word": "дефект",
                                "target_lang_sense_clarification": "повреждение или отклонение от нормы"
                            },
                            {
                                "target_lang_word": "недочёт",
                                "target_lang_sense_clarification": "ошибка или упущение в работе"
                            },
                            {
                                "target_lang_word": "порок",
                                "target_lang_sense_clarification": "серьезный изъян или физический недостаток"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6e3ada3f-4ea8-38f4-a480-9adf46095e69",
                    "sense_definition": "The codimension of a linear system in the corresponding complete linear system.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mathematics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In algebraic geometry, calculating the <w>deficiency</w> of a linear system is essential for understanding curve properties.",
                            "target_lang_translations": {
                                "ru": "В алгебраической геометрии вычисление <w>дефицита</w> линейной системы необходимо для понимания свойств кривых."
                            }
                        },
                        {
                            "text": "The researcher focused on the <w>deficiency</w> of the system to determine its completeness.",
                            "target_lang_translations": {
                                "ru": "Исследователь сосредоточился на <w>дефиците</w> системы, чтобы определить её полноту."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Коразмерность линейной системы в соответствующей полной линейной системе."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дефицит",
                                "target_lang_sense_clarification": "в алгебраической геометрии"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "78e9511a-ec55-3b28-a24f-60077a234816",
                    "sense_definition": "The amount by which the number of double points on a curve is less than the maximum possible for curves of that degree.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mathematics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>deficiency</w> of the algebraic curve was calculated to be zero, meaning it was rational.",
                            "target_lang_translations": {
                                "ru": "<w>Дефект</w> алгебраической кривой оказался равен нулю, что означало её рациональность."
                            }
                        },
                        {
                            "text": "The professor explained how the <w>deficiency</w> relates to the genus of the Riemann surface.",
                            "target_lang_translations": {
                                "ru": "Профессор объяснил, как <w>дефект</w> связан с родом римановой поверхности."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Величина, на которую число двойных точек кривой меньше максимально возможного для кривых данной степени."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дефект",
                                "target_lang_sense_clarification": "геометрическая характеристика кривой"
                            }
                        ]
                    }
                }
            ]
        }
    ]
