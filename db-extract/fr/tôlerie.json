                                "target_senses": [
                                    {
                                        "sense_id": "80ab357a-7e16-3f93-9b13-d88ea046a1e2",
                                        "entry_id": "2fbf6a3c-62d0-3dcf-b80e-89f8d5d56de6",
                                        "glosses": [
                                            "bedrijf waar men de metalen platen van de carrosserie van een auto verwerkt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43c034d9-6cd1-4fa7-8bd2-1520da7ad0df",
                                                "sense_id": "80ab357a-7e16-3f93-9b13-d88ea046a1e2",
                                                "text": "'Ik hoor verhalen dat vooral jongens in de plaatwerkerij gewoon worden weggekocht door de concurrent. Heel veel jongens zwichten voor meer salaris. Zo erg is het al', zegt eigenaar Hans Sieverink van S+S Tuning in Haaksbergen. 'Ik heb hier een grote groep jonge mensen, dus ik hoop voorlopig nog wel twintig jaar goed te zitten.'"
                                            },
                                            {
                                                "example_id": "9dfebe8e-c69a-4c10-ae00-767e882c6843",
                                                "sense_id": "80ab357a-7e16-3f93-9b13-d88ea046a1e2",
                                                "text": "Het Britse bedrijf claimt zelf nog eens 50 miljoen euro te hebben uitgegeven aan extra aanpassingen, maar op kosten van Mercedes waren al meer dan 250 nieuwe robots geplaatst, verscheen er een nieuwe plaatwerkerij, werd de fabriek voorzien van een kakelfrisse lakstraat en kan Ineos meteen al over een hypermoderne kwaliteitscontrole beschikken. Beter kan een startende autofabrikant zich eigenlijk niet wensen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3fad40b6-0beb-489b-9b2c-1c422834d7c1",
                        "source_entry_id": "a043f1cb-b56f-3cb7-8a4e-a460b683ed04",
                        "source_sense_description": "Ensemble des parties en tôle",
                        "target_lang_word": "plaatwerk",
