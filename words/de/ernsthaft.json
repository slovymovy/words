                        "ein ernsthafter Blick"
                    ]
                },
                {
                    "sense_id": "4ec79efc-2b0a-3084-97bb-fa81849a84f7",
                    "sense_definition": "aufrichtig gemeint und mit Entschlossenheit verfolgt; nicht leichtfertig oder nur zum Schein",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "aufrichtigkeit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nach langem Zögern unternahm er einen <w>ernsthaften</w> Versuch, die Sprache zu lernen."
                        },
                        {
                            "text": "Sie fragte ihn direkt, ob er <w>ernsthafte</w> Absichten bei diesem Projekt verfolge."
                        }
                    ],
                    "common_phrases": [
                        "ein ernsthafter Versuch",
                        "ernsthafte Absichten haben"
                    ]
                },
                {
                    "sense_id": "11e58782-f72d-303f-b97d-3b2b1eb06028",
                    "sense_definition": "von bedrohlicher, besorgniserregender oder schwerer Art; erhebliche Folgen nach sich ziehend",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "gefahr",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die Ärzte konnten bei der Untersuchung glücklicherweise keine <w>ernsthaften</w> Verletzungen feststellen."
                        },
                        {
                            "text": "Starker Schneefall stellt auf den Bergstraßen derzeit eine <w>ernsthafte</w> Gefahr dar."
                        }
                    ],
                    "antonyms": [
                        "geringfügig"
                    ],
                    "common_phrases": [
                        "eine ernsthafte Gefahr",
                        "eine ernsthafte Bedrohung",
                        "ernsthafte Verletzungen"
                    ]
                }
            ]
        },
        {
