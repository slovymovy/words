                            {
                                "example_id": "64bd4a22-7f8e-40eb-a673-37408bae4a25",
                                "sense_id": "8fc4df1a-00c2-39e7-b346-a1b3b19682b2",
                                "text": "„Alle verfügbaren Räume haben sich in Massenquartiere mit Strohlagern verwandelt, doch Mutter und ich bekommen sogar ein kleines Zimmer mit zwei Betten zugewiesen.“"
                            },
                            {
                                "example_id": "81f25edf-729a-4d3c-973e-ca4cfec9c79b",
                                "sense_id": "8fc4df1a-00c2-39e7-b346-a1b3b19682b2",
                                "text": "„Es gab Erbsensuppe und ein großes Strohlager für die Überlebenden.“"
                            }
                        ],
