                        "glosses": [
                            "Jeu de piste, chasse au trésor, rallie-papier, rallye."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "51c122a1-1b28-4452-a6f5-46b476db513e",
                                "sense_id": "e2ecec57-a9a8-323f-a65c-13e81f7ec045",
                                "text": "Ganz im Sinne einer klassischen Schnitzeljagd können die Teilnehmer durch das Auffinden von zehn Orten und der Beantwortung von Bonusfragen zum Thema Energie und Wien Punkte sammeln.",
                                "translation": "Tout à fait comme dans une chasse au trésor classique, les participants peuvent collectionner des points en retrouvant dix endroits et en répondant à des questions bonus sur le thème de l’énergie et Vienne."
                            },
                            {
                                "example_id": "afbfb27a-d7e4-42be-a0bb-5e0027c3146f",
                                "sense_id": "e2ecec57-a9a8-323f-a65c-13e81f7ec045",
                                "text": "Diese Art von Schnitzeljagden findet meist im Freien statt und wird gerne an Kindergeburtstagen veranstaltet.",
                                "translation": "Cette forme de chasse au trésor se déroule principalement à l’extérieur, et s’organise volontiers à l’occasion d’anniversaires d’enfants."
                            }
                        ]
                    }
