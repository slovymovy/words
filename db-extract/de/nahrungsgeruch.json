                ],
                "senses": [
                    {
                        "sense_id": "01aac846-111c-3230-b600-6763b3c2be5b",
                        "entry_id": "60b5294b-5617-314e-94cc-83db76b482f0",
                        "glosses": [
                            "wahrnehmbarer Geruch, den etwas Essbares von sich gibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "143fcd7c-7f48-4441-b0a0-d3d7d3e2b6d5",
                                "sense_id": "01aac846-111c-3230-b600-6763b3c2be5b",
                                "text": "Nach der Exposition gegenüber Parathion wirkte der Nahrungsgeruch nicht mehr anlockend, sondern wurde gemieden."
                            },
                            {
                                "example_id": "588d16dd-4056-4366-bd8c-d00cb7ea6b63",
                                "sense_id": "01aac846-111c-3230-b600-6763b3c2be5b",
                                "text": "Befindet sich der Maulwurf in der Nähe eines solchen Behälters, aus dem Nahrungsgerüche dringen, so veranlaßt ihn das, regelmäßig hineinzukriechen und das Objekt herauszuholen."
                            },
                            {
                                "example_id": "b9d30f58-e058-415d-bd27-5b2e314c327c",
                                "sense_id": "01aac846-111c-3230-b600-6763b3c2be5b",
                                "text": "Es wurde wohl noch nie bedacht, daß Kinder in der Regel in einem Haushalt aufgezogen werden, in dem sie alle die unterschiedlichen Nahrungsgerüche Monate und Jahre früher auskosten, bevor es ihnen erlaubt wird, diese Gerichte selbst zu essen."
                            },
                            {
                                "example_id": "dd009943-549b-452b-94a3-f54ed654c97b",
                                "sense_id": "01aac846-111c-3230-b600-6763b3c2be5b",
                                "text": "Ein Schakal, der von dem Nahrungsgeruch angezogen worden war, obwohl Hassan das Essen sorgfältig eingepackt hatte, oder ein Junge aus dem Dorf, der Böses im Schilde führte."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
