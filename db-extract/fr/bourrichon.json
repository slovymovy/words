                                                "sense_id": "92719487-ce6c-367c-b40e-6cc5f9e0b4dc",
                                                "text": "Een kop koffie drinken"
                                            },
                                            {
                                                "example_id": "bc29bf6a-99d9-4276-ae5c-52eded9143c2",
                                                "sense_id": "92719487-ce6c-367c-b40e-6cc5f9e0b4dc",
                                                "text": "Ze bladerde verder totdat ze op een dubbele pagina met tekeningen van haar broer stuitte: Isaac hakt hout, Isaac met een kop koffie."
                                            },
                                            {
                                                "example_id": "579a69a0-ccfd-4dc8-877c-be295999cfde",
                                                "sense_id": "92719487-ce6c-367c-b40e-6cc5f9e0b4dc",
                                                "text": "Overal ter wereld was de lokale bevolking gastvrij en verwelkomde vermoeide lopers met een warme kop thee of een bed voor de nacht."
                                            }
                                        ]
                                    },
