                "senses": [
                    {
                        "sense_id": "a64b65dd-f7d6-32f7-9609-b5f0b5f12281",
                        "entry_id": "36c454af-d81f-358e-9112-e00cb14502cf",
                        "glosses": [
                            "воен. связанный, соотносящийся по значению с существительным марш (в знач. движение в строю, передвижение войск)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ce40fbaf-7288-44d1-aaeb-34b9b55481b8",
                                "sense_id": "a64b65dd-f7d6-32f7-9609-b5f0b5f12281",
                                "text": "У меня маршевые пополнения на фронт, срочная первоочередность."
                            },
                            {
                                "example_id": "1b676727-812e-4012-ad8d-5d7cfdcdd5c5",
                                "sense_id": "a64b65dd-f7d6-32f7-9609-b5f0b5f12281",
                                "text": "Пять километров в час ― это маршевая скорость пехотной роты по асфальту."
                            }
                        ]
                    },
                    {
                        "sense_id": "5c025eb8-1ed1-3474-b426-094e4ad6d028",
                        "entry_id": "36c454af-d81f-358e-9112-e00cb14502cf",
                        "glosses": [
                            "техн. относящийся к основному участку траектории полёта ракеты"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "90d35650-6e02-43e0-878b-edeefb5bfd7a",
