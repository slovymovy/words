        "fr-extract.jsonl": [
            {
                "entry_id": "5f88dc89-7b2d-353a-bd7b-fef823555ca0",
                "word": "copilote",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "37228388-9078-4514-b1b5-67f73881a8b7",
                        "entry_id": "5f88dc89-7b2d-353a-bd7b-fef823555ca0",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "copilotes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "62f99584-db7d-3da1-8db6-aecc9041178f",
                        "entry_id": "5f88dc89-7b2d-353a-bd7b-fef823555ca0",
                        "glosses": [
                            "Personne qui pilote un véhicule, un avion, etc., conjointement avec un pilote principal."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "14ec19a6-83f0-4b52-8228-4633b1c1ae82",
                                "sense_id": "62f99584-db7d-3da1-8db6-aecc9041178f",
                                "text": "Le copilote de l’avion de Northwest Airlines qui avait dépassé l’aéroport de Minneapolis de 240 km avant de faire demi-tour pour atterrir a refusé d’expliquer ce qui s’était passé, assurant toutefois que les pilotes ne s’étaient pas endormis, ni disputés, et que la sécurité n’avait pas été menacée."
                            },
                            {
                                "example_id": "fc950f39-2828-44bc-b851-576f3662d24f",
                                "sense_id": "62f99584-db7d-3da1-8db6-aecc9041178f",
                                "text": "Le Boeing est enfumé et secoué de vibrations ; son commandant de bord, Mohammed Kabbaj, a du mal à tenir les commandes. Il fait transmettre par radio un message aux pilotes des F-5 indiquant que le pilote est tué, le copilote et le souverain grièvement blessés."
                            },
                            {
                                "example_id": "859f59a2-8322-413f-939e-eab5e5e85c64",
                                "sense_id": "62f99584-db7d-3da1-8db6-aecc9041178f",
                                "text": "Il sera accompagné du major William Brooks, comme copilote, du commandant John Wycliffe Iseman comme navigateur, et du capitaine Arthur Finch, radiotélégraphiste, qui recueillera toutes sortes de données scientifiques sur la route du Sud et sur les frais d’exploitation de grands avions employés pour les vols transatlantiques."
                            }
                        ]
                    },
                    {
                        "sense_id": "6b0f099f-729b-3fec-b0e6-b603461b201f",
                        "entry_id": "5f88dc89-7b2d-353a-bd7b-fef823555ca0",
                        "glosses": [
                            "Membre d’une équipe chargée de piloter un projet."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1314c4ab-6e2b-4dd3-bf9d-5753148da106",
                                "sense_id": "6b0f099f-729b-3fec-b0e6-b603461b201f",
                                "text": "L’objectif est de « proposer [aux participants] la rencontre la plus originale et le plus sincère possible avec les pays traversés », insiste Karim Binon, devenu copilote du projet après avoir fait partie de ses premiers aventuriers."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "17bcc1fa-e589-4a59-84b3-2581b268059f",
                        "source_entry_id": "5f88dc89-7b2d-353a-bd7b-fef823555ca0",
                        "target_lang_word": "Copilot",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Copilot",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "474e09fe-49f1-397c-a4ab-feecd2884a5e",
                                        "entry_id": "80f62d57-f30c-3ef1-a3a3-4228f2b0da61",
                                        "glosses": [
                                            "No glosses available"
                                        ],
                                        "tags": [
                                            "no-gloss"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "15f47f2b-e38f-4dcf-bac3-e403b011511f",
                                                "sense_id": "474e09fe-49f1-397c-a4ab-feecd2884a5e",
                                                "text": "„Früher habe ich in kleinen Flugzeugen Gelegenheit gehabt, dem Piloten und dem Copiloten beim Start durch die geöffnete Kabinentür über die Schulter zu schauen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
