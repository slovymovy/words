                        "sense_id": "68ce9eb6-e286-3670-976e-af5c1186d173",
                        "entry_id": "555fd88b-5a1c-303d-a963-45efc1c7ca3d",
                        "glosses": [
                            "Donner un caractère franchouillard à."
                        ],
                        "tags": [],
                        "examples": [
