                ],
                "senses": [
                    {
                        "sense_id": "86c58bb4-5ff4-399d-aeac-2f141c637699",
                        "entry_id": "d55468ba-273d-3f84-b604-46fea8189056",
                        "glosses": [
                            "Couvrir de carreaux de faïence."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c18e7f4c-d10d-4a49-97a7-aa4c9720d352",
                                "sense_id": "86c58bb4-5ff4-399d-aeac-2f141c637699",
                                "text": "Les Russes ont eu l'excellente idée de faire faïencer les parois extérieures de leur calorifère en terre réfractaire, et cette modification donne les meilleurs résultats."
                            }
                        ]
                    },
                    {
                        "sense_id": "940e912f-8dfa-3d3c-be3d-2ebb05700631",
                        "entry_id": "d55468ba-273d-3f84-b604-46fea8189056",
                        "glosses": [
                            "Faire ressembler à de la faïence."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a93aa6a-45af-43a6-8b9a-afb10ed54a80",
                                "sense_id": "940e912f-8dfa-3d3c-be3d-2ebb05700631",
                                "text": "Des sillons blafards, des raies crayeuses y couraient comme des sutures, et le bleu des yeux — naguère qualifiés de céruléens — commençait visiblement à se faïencer sous les cuites sans nombre du libertinage."
                            }
                        ]
                    }
