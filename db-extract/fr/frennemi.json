                "senses": [
                    {
                        "sense_id": "f489a8fb-b931-34bd-9e1d-0b1902249708",
                        "entry_id": "146f8760-3000-39a5-b56b-464815d58c1b",
                        "glosses": [
                            "Qui est à la fois ami et ennemi de quelqu’un ou quelque chose."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "c7fd0f6b-7326-43a9-9cf6-8ac7f6765b62",
                                "sense_id": "f489a8fb-b931-34bd-9e1d-0b1902249708",
                                "text": "Pas Manu qui boude son parti frennemi préféré"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5330f611-587b-45ed-8ba7-230894ed8d1e",
                        "source_entry_id": "146f8760-3000-39a5-b56b-464815d58c1b",
                        "source_sense_id": "f489a8fb-b931-34bd-9e1d-0b1902249708",
                        "target_lang_word": "frenemy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "frenemy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cac5c24d-1cde-3d01-a52d-6d8e77ef0a86",
                                        "entry_id": "f7ddb119-31a6-3876-a3a8-7e79cc6707f7",
                                        "glosses": [
                                            "Someone who has traits of an enemy and a friend."
                                        ],
                                        "tags": [
                                            "humorous",
                                            "sometimes"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6c25fe38-9602-4096-bb32-518c2bca9394",
                                                "sense_id": "cac5c24d-1cde-3d01-a52d-6d8e77ef0a86",
                                                "text": "In France the Seine has all the advantages of Northernness (a quality underrated by our Gallic frenemy) but it is too fatally interested in Paris […]"
                                            },
                                            {
                                                "example_id": "84d6a8e4-6dd9-4a8a-b8cf-096aa94f1f9f",
                                                "sense_id": "cac5c24d-1cde-3d01-a52d-6d8e77ef0a86",
                                                "text": "You know when you dump a guy, only to discover years later that he's evolved into the perfect boyfriend—for the high-school frenemy who convinced you to dump him in the first place...?"
                                            },
                                            {
                                                "example_id": "812b0c5d-0c93-4495-95e1-82e72631958b",
                                                "sense_id": "cac5c24d-1cde-3d01-a52d-6d8e77ef0a86",
                                                "text": "Another enemy / Not even a frenemy."
                                            },
                                            {
                                                "example_id": "087e6bf6-5063-4c26-8dd4-8c72ce99a6cb",
                                                "sense_id": "cac5c24d-1cde-3d01-a52d-6d8e77ef0a86",
                                                "text": "Frenemies who when you're down ain't your friend"
                                            },
                                            {
                                                "example_id": "8433f2bd-2f00-470e-82e5-8cffc95ae419",
                                                "sense_id": "cac5c24d-1cde-3d01-a52d-6d8e77ef0a86",
                                                "text": "So why did we break up? Enter Blaize St. John, frenemy extraordinaire. She came, she saw, she stole my boyfriend."
                                            },
                                            {
                                                "example_id": "7e57b044-c0d8-42ec-ac06-be4e9f42d97b",
                                                "sense_id": "cac5c24d-1cde-3d01-a52d-6d8e77ef0a86",
                                                "text": "Gates made a rare and instructive appearance with his longtime frenemy Steve Jobs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "de2edd74-9e2c-34eb-9c97-5dba9d7bce37",
                                        "entry_id": "f7ddb119-31a6-3876-a3a8-7e79cc6707f7",
                                        "glosses": [
                                            "A fair-weather friend who is also a rival."
                                        ],
                                        "tags": [
                                            "humorous",
                                            "sometimes"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "36d12696-4e61-489c-9cc4-3b46981433f3",
                                                "sense_id": "de2edd74-9e2c-34eb-9c97-5dba9d7bce37",
                                                "text": "So, we're definitely not going to be friends with Ferguson? Maybe we can be frenemies. A love-hate relationship's the next best thing."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
