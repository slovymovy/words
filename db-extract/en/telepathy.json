                    {
                        "translation_id": "07550570-8af4-4e7d-ab8a-d2c90b1a70a1",
                        "source_entry_id": "49f07c8b-b52e-3a36-8e53-4a06f785b962",
                        "source_sense_id": "402f5abe-ea52-3604-a510-357c748a4c16",
                        "source_sense_description": "communication by psychic means",
                        "target_lang_word": "télépathie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "télépathie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9525d3c9-a9ac-30cc-811c-0e3e1b7a86c4",
                                        "entry_id": "8a3e20bc-a3d4-3771-b866-b87f526ca750",
                                        "glosses": [
                                            "Faculté de sentir à distance, extrasensorielle."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d557e33d-0230-3c68-b7f0-91472714e5da",
                                        "entry_id": "8a3e20bc-a3d4-3771-b866-b87f526ca750",
                                        "glosses": [
                                            "Correspondance de pensée, de sentiments entre deux personnes éloignées."
                                        ],
                                        "tags": [
                                            "Science-fiction"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "adfd8b36-bfd2-4042-a024-673760387f44",
                                                "sense_id": "d557e33d-0230-3c68-b7f0-91472714e5da",
                                                "text": "La télépathie leur avait révélé sur Saturne des choses stupéfiantes. Sur Terre, ils ne découvraient que des faits incompréhensibles ou les faisant pouffer de rire."
                                            },
                                            {
                                                "example_id": "6ac9213f-e188-4fa9-89d4-ca4e4bd95ac8",
                                                "sense_id": "d557e33d-0230-3c68-b7f0-91472714e5da",
                                                "text": "La faculté psi ne doit pas servir à transformer le monde en une vaste fourmilière, à unifier les personnalités, mais à permettre des échanges enrichissants, librement consentis. Or, en télépathie, s’il n’y a pas équilibre des forces, il y a domination. C’est pourquoi nous ne l’utilisons qu’en privé."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cd13be8c-a7de-4c5a-b853-645c7944f2e0",
                        "source_entry_id": "49f07c8b-b52e-3a36-8e53-4a06f785b962",
                        "source_sense_id": "402f5abe-ea52-3604-a510-357c748a4c16",
                        "source_sense_description": "communication by psychic means",
                        "target_lang_word": "Telepathie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Telepathie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8b900d3f-b2f7-30df-92ec-ee212df01710",
                                        "entry_id": "2ede6abe-f28e-3a83-8692-bd2246d58233",
                                        "glosses": [
                                            "Wahrnehmung von Gedanken anderer oder anderen Dingen ohne Hilfe der Sinnesorgane"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b73768bb-5e7a-46c6-a2a5-b47cb129b9b4",
                                                "sense_id": "8b900d3f-b2f7-30df-92ec-ee212df01710",
                                                "text": "Die Parapsychologie unterscheidet im Bereich der übersinnlichen Wahrnehmung drei Formen: die Telepathie, das Hellsehen und die Präkognition."
                                            },
                                            {
                                                "example_id": "3db6122e-75e4-48f0-8145-a2dfd45cf500",
                                                "sense_id": "8b900d3f-b2f7-30df-92ec-ee212df01710",
                                                "text": "„Es war fast wie Telepathie, denn Lea hatte kein Geräusch vernommen, als sie noch im Finstern, etwa gegen drei Uhr früh, leise aufstand und durch Zimmer und Küche zu dem kleinen Raum bei der Haustür gelangte.“"
                                            },
                                            {
                                                "example_id": "bf7f8235-323a-48d2-8b8c-5dbe1bac1082",
                                                "sense_id": "8b900d3f-b2f7-30df-92ec-ee212df01710",
                                                "text": "„Sie hatte ihm Vorträge über Telepathie und Magnetismus gehalten, die sie offensichtlich wortgleich aus einem ihrer esoterischen Bücher entnommen hatte.“"
                                            },
                                            {
                                                "example_id": "365a4773-5a37-466a-8498-e2cec93db077",
                                                "sense_id": "8b900d3f-b2f7-30df-92ec-ee212df01710",
                                                "text": "„Nur Telepathie ist noch günstiger.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "706f4abb-03d2-4beb-bb4f-eea819c0245b",
                        "source_entry_id": "49f07c8b-b52e-3a36-8e53-4a06f785b962",
                        "source_sense_id": "402f5abe-ea52-3604-a510-357c748a4c16",
