                        "entry_id": "3e638494-ec44-3d78-8f88-a933c024e5c0",
                        "tags": [
                            "plural"
                        ],
                        "form": "documentalisten"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "558533a8-f81d-3299-b2bb-093433105f89",
                        "entry_id": "3e638494-ec44-3d78-8f88-a933c024e5c0",
                        "glosses": [
                            "iemand die belast is met het bijhouden van het archief"
                        ],
                        "tags": [
                            "beroep"
                        ],
                        "examples": [
                            {
                                "example_id": "5a7eefa0-0cd5-4a31-8246-177b3e8afc43",
                                "sense_id": "558533a8-f81d-3299-b2bb-093433105f89",
                                "text": "Van oorsprong ben ik bibliothecaris en documentalist. In 1982 ben ik begonnen als documentalist bij een nieuwe opleiding aan de Erasmus Universiteit."
                            }
                        ]
                    },
                    {
                        "sense_id": "5f614c3a-403c-3745-8c45-bdc1dd362ef2",
                        "entry_id": "3e638494-ec44-3d78-8f88-a933c024e5c0",
                        "glosses": [
                            "iemand die een documentaire film maakt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "95e67b5e-2f37-431d-86e0-37defbd6cc84",
                                "sense_id": "5f614c3a-403c-3745-8c45-bdc1dd362ef2",
                                "text": "Sinds 2002 houdt hij zich met het onderwerp bezig, als fotograaf, documentalist, én als de sympathieke, geëngageerde kunstenaar die andere kunstenaars bij zijn project betrekt. Zo is de multi-mediale, interactieve website en blog Waterfonie.nl ontstaan, waar Ulay zijn projecten documenteert en waar anderen hun eigen ‘waterwerken’ kunnen uploaden."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4e6a01d3-7f53-4b4f-aef0-e10c10e20e80",
                        "source_entry_id": "3e638494-ec44-3d78-8f88-a933c024e5c0",
                        "source_sense_id": "5f614c3a-403c-3745-8c45-bdc1dd362ef2",
                        "source_sense_description": "iemand die een documentaire film maakt",
                        "target_lang_word": "documentarian",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "documentarian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7eae2ef3-a129-393a-9fcc-6146623ecd0f",
                                        "entry_id": "2d5e2fc7-5853-3cab-a46e-68b75c90bde8",
                                        "glosses": [
                                            "A person whose profession is to create documentary films."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47ed2330-769a-4a03-8489-e56ff6d363c3",
                                                "sense_id": "7eae2ef3-a129-393a-9fcc-6146623ecd0f",
                                                "text": "As film tourism becomes a rising field of interest, this portion of documentary history is in danger of repetition unless documentarians utilize the nobler ideas of documentary in order to cultivate a deeper understanding between people, filmmaker, and audience."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ee477ae5-11e8-36e1-b7df-5bb087e42d18",
                                        "entry_id": "2d5e2fc7-5853-3cab-a46e-68b75c90bde8",
                                        "glosses": [
                                            "A person who writes software documentation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7e2c194-79c5-4eec-b746-0d251c010eea",
                                                "sense_id": "ee477ae5-11e8-36e1-b7df-5bb087e42d18",
                                                "text": "After you have gone through all these steps, you are ready to tackle your company's documentation problems. You have also become an experienced systems documentarian..."
                                            },
                                            {
                                                "example_id": "d3c78f62-464b-42e2-bfa8-d5ba2b4cc528",
                                                "sense_id": "ee477ae5-11e8-36e1-b7df-5bb087e42d18",
                                                "text": "Have you considered hiring a technical writer or documentarian to assist in the production of user manuals?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ba14020f-206b-3d3b-a83e-cde3e8865105",
                                        "entry_id": "2d5e2fc7-5853-3cab-a46e-68b75c90bde8",
                                        "glosses": [
                                            "A person who cares about communication and documentation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf2908cd-d8ab-42ff-8b72-cf87ce80e8dc",
                                                "sense_id": "ba14020f-206b-3d3b-a83e-cde3e8865105",
                                                "text": "Expanding the meaning of documentarian to include folks of any job title is important. Historically, people writing documentation might be called either a tech writer or a programmer, but there wasn’t a name for someone who cares about communication and documentation. We hope to change this."
                                            },
                                            {
                                                "example_id": "3a2c1a12-beed-433c-9898-6b7caa034934",
                                                "sense_id": "ba14020f-206b-3d3b-a83e-cde3e8865105",
                                                "text": "...the developer with an aptitude for or an interest in writing assumes the task of documentarian."
                                            },
                                            {
                                                "example_id": "0b50d8fc-06b1-4fd4-9b1a-7c512a85c9a9",
                                                "sense_id": "ba14020f-206b-3d3b-a83e-cde3e8865105",
                                                "text": "I recently co-organised the Build your Docs career conference together with the Write the Docs (WTD) community. This was the fourth collaboration between the organisations and focused on the technical writing profession ... The talks provided lots of practical advice on how we can, as documentarians, learn in such a way as to maximise our potential for development in the future."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e3e52255-0fee-3bdc-a99d-73b503c8bf18",
                                        "entry_id": "2d5e2fc7-5853-3cab-a46e-68b75c90bde8",
                                        "glosses": [
                                            "Somebody who advocates the documentary hypothesis."
                                        ],
                                        "tags": [
                                            "attributive",
                                            "sometimes"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
