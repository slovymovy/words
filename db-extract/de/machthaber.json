                ],
                "senses": [
                    {
                        "sense_id": "e57713de-5b3f-32d2-84e2-6ad4671957ef",
                        "entry_id": "4ad6eaad-b60e-3059-b1dc-a1806749373a",
                        "glosses": [
                            "Person, die Macht und/oder Regierungsgewalt innehat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fdad82a9-be4e-49d4-86b8-b19d9d767bb9",
                                "sense_id": "e57713de-5b3f-32d2-84e2-6ad4671957ef",
                                "text": "„Doch statt für die braunen Machthaber zu werben, protzte der Korsar in eigener Sache.“"
                            },
                            {
                                "example_id": "a62217e4-2c74-42d2-a632-00a34288f1b1",
                                "sense_id": "e57713de-5b3f-32d2-84e2-6ad4671957ef",
                                "text": "„Ein Militärgouverneur ist der Machthaber in einem von fremden Truppen besetzten, annektierten oder sonst wie nicht unter Eigen-, sondern fremder Militärregierung stehenden Land.“"
                            },
                            {
                                "example_id": "9e455d7c-4551-4ff7-8f7d-daee2dad6477",
                                "sense_id": "e57713de-5b3f-32d2-84e2-6ad4671957ef",
                                "text": "„Für mehr als ein Jahr nach dem Ende der Kampfhandlungen blieben die Militärs die alleinigen Machthaber auf diesem Territorium.“"
                            },
                            {
                                "example_id": "70446563-2eff-43ed-9fbc-5bf602780da3",
                                "sense_id": "e57713de-5b3f-32d2-84e2-6ad4671957ef",
                                "text": "„Als Machthaber der Insel gaben die Deutschen auch Briefmarken heraus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e7e275b2-ed3c-42e1-aea6-37fe7d4563db",
                        "source_entry_id": "4ad6eaad-b60e-3059-b1dc-a1806749373a",
                        "source_sense_id": "e57713de-5b3f-32d2-84e2-6ad4671957ef",
                        "source_sense_description": "Person, die Macht und/oder Regierungsgewalt innehat",
                        "target_lang_word": "power broker",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "power broker",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f3db8f01-68de-3f90-a73b-9d716f320654",
                                        "entry_id": "d0de5969-48ce-3bf1-a195-7471078ca7c9",
                                        "glosses": [
                                            "A person or group having the ability to influence important decisions, especially in public policy, politics, and business."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6cbe8a2f-0592-4bfc-8be7-ba80e4d2fe09",
                                                "sense_id": "f3db8f01-68de-3f90-a73b-9d716f320654",
                                                "text": "In France, a near-revolution by students and workers came close to toppling Charles de Gaulle in May; its economic aftermath in November almost certainly discredited forever Gaullism's vaunted role as the power broker of Europe."
                                            },
                                            {
                                                "example_id": "e80b5a5a-ff0c-4a94-a77f-fbe0aa9364be",
                                                "sense_id": "f3db8f01-68de-3f90-a73b-9d716f320654",
                                                "text": "Gen Ali Murtopo—vice chairman of Indonesia's Supreme Advisory Council, former information minister, a major power broker in and out of the army—declared after a meeting with the president that the killings were justified."
                                            },
                                            {
                                                "example_id": "874a3015-b25f-42f4-a690-a7ff7b34da27",
                                                "sense_id": "f3db8f01-68de-3f90-a73b-9d716f320654",
                                                "text": "The Qatar government, which runs the QIA, will become a major power-broker in determining the future of the London exchange."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "767186a5-48d9-462e-9210-8f6305aa863a",
                        "source_entry_id": "4ad6eaad-b60e-3059-b1dc-a1806749373a",
                        "source_sense_id": "e57713de-5b3f-32d2-84e2-6ad4671957ef",
                        "source_sense_description": "Person, die Macht und/oder Regierungsgewalt innehat",
                        "target_lang_word": "power holder",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "1b7e689c-ad49-4168-8d11-266496d99557",
                        "source_entry_id": "4ad6eaad-b60e-3059-b1dc-a1806749373a",
                        "source_sense_id": "e57713de-5b3f-32d2-84e2-6ad4671957ef",
                        "source_sense_description": "Person, die Macht und/oder Regierungsgewalt innehat",
                        "target_lang_word": "strongman",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "strongman",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d1a6ff3c-cced-394d-9603-ac3ceecf9376",
                                        "entry_id": "368daac2-8811-3f93-9ce9-9d114c1daf4a",
                                        "glosses": [
                                            "A man who performs feats of strength, as in competitions or as an attraction in a circus."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a8095d4-7854-44a6-865c-3a5caae14f2e",
                                                "sense_id": "d1a6ff3c-cced-394d-9603-ac3ceecf9376",
                                                "text": "Giovanni Battista Belzoni, the famous Egyptian archeologist, who was a man of gigantic stature, began his public career as a strongman at the Bartholomew Fair, under the management of Gyngell, the conjuror, who dubbed him The Young Hercules."
                                            },
                                            {
                                                "example_id": "f69313b4-1e3e-46be-99b9-63c9a5489b47",
                                                "sense_id": "d1a6ff3c-cced-394d-9603-ac3ceecf9376",
                                                "text": "Opposite him was the Fat Lady, red-faced and laughing. Beside her, the India-rubber Man wound spaghetti on to a fork with an expression of deepest melancholy. Further down the table, the Strong Man, an overcoat covering his leopard-skin, talked garrulously."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "254392e0-4666-3085-adb5-33c470a67d92",
                                        "entry_id": "368daac2-8811-3f93-9ce9-9d114c1daf4a",
                                        "glosses": [
                                            "A forceful or brutal person, usually a ruler or tyrant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "539bab71-df90-474a-867d-738f51a31970",
                                                "sense_id": "254392e0-4666-3085-adb5-33c470a67d92",
                                                "text": "Since the Cold War’s end, a staggering 70 percent of governments headed by strongmen collapsed after the ruler departed, according to one data set."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
