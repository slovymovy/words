{
    "word_family": [
        "enmity",
        "inimical"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4913c2ce-d848-374f-8193-2a6e3253055c",
                    "sense_definition": "Someone who is hostile to, feels hatred towards, opposes the interests of, or intends injury to someone else.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "hostile_person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He made a lot of <w>enemies</w> after reducing the working hours in his department.",
                            "target_lang_translations": {
                                "ru": "Он нажил много <w>врагов</w> после сокращения рабочих часов в своем отделе."
                            }
                        },
                        {
                            "text": "If you are not with me, then you are my <w>enemy</w>.",
                            "target_lang_translations": {
                                "ru": "Если ты не со мной, значит ты мой <w>враг</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "foe",
                        "adversary",
                        "nemesis"
                    ],
                    "antonyms": [
                        "friend",
                        "ally",
                        "pal"
                    ],
                    "common_phrases": [
                        "bitter enemy",
                        "worst enemy",
                        "make an enemy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тот, кто враждебно относится к кому-либо, испытывает ненависть, противодействует чьим-либо интересам или намерен причинить вред."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "враг",
                                "target_lang_sense_clarification": "человек, находящийся в состоянии вражды"
                            },
                            {
                                "target_lang_word": "недруг",
                                "target_lang_sense_clarification": "недоброжелатель"
                            },
                            {
                                "target_lang_word": "противник",
                                "target_lang_sense_clarification": "тот, кто противодействует"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "866d18ad-fbc3-3e87-9645-d2c39d3909c8",
                    "sense_definition": "A hostile force or nation; a fighting member of such a force or nation.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "hostile_force",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soldiers were ordered to rally together against a common <w>enemy</w>.",
                            "target_lang_translations": {
                                "ru": "Солдатам приказали сплотиться против общего <w>врага</w>."
                            }
                        },
                        {
                            "text": "The building was destroyed by <w>enemy</w> bombing during the night.",
                            "target_lang_translations": {
                                "ru": "Здание было разрушено <w>вражеской</w> бомбардировкой в течение ночи."
                            }
                        }
                    ],
                    "synonyms": [
                        "foe",
                        "adversary",
                        "opponent"
                    ],
                    "antonyms": [
                        "ally",
                        "supporter"
                    ],
                    "common_phrases": [
                        "common enemy",
                        "enemy lines",
                        "enemy fire"
                    ],
                    "target_lang_definitions": {
                        "ru": "Враждебная сила или нация; участник боевых действий со стороны такой силы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "враг",
                                "target_lang_sense_clarification": "военный противник"
                            },
                            {
                                "target_lang_word": "противник",
                                "target_lang_sense_clarification": "вражеские войска"
                            },
                            {
                                "target_lang_word": "неприятель",
                                "target_lang_sense_clarification": "враг на войне"
                            },
                            {
                                "target_lang_word": "вражеский",
                                "target_lang_sense_clarification": "относящийся к врагу"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f9e6b95d-8250-3d8e-b1f8-d910007760c3",
                    "sense_definition": "A non-player character in a video game that tries to harm the player.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "gaming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The player must defeat every <w>enemy</w> in the room to unlock the door.",
                            "target_lang_translations": {
                                "ru": "Игрок должен победить каждого <w>врага</w> в комнате, чтобы открыть дверь."
                            }
                        },
                        {
                            "text": "A powerful <w>enemy</w> appeared at the end of the level.",
                            "target_lang_translations": {
                                "ru": "В конце уровня появился сильный <w>противник</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "mob",
                        "antagonist"
                    ],
                    "common_phrases": [
                        "defeat the enemy",
                        "spawn an enemy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Неигровой персонаж в видеоигре, который пытается нанести вред игроку."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "враг",
                                "target_lang_sense_clarification": "противник в игре"
                            },
                            {
                                "target_lang_word": "противник",
                                "target_lang_sense_clarification": "оппонент в игре"
                            },
                            {
                                "target_lang_word": "моб",
                                "target_lang_sense_clarification": "игровой сленг для враждебного существа"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "016324b6-3a73-33bc-9db2-b24e800c3ad3",
                    "sense_definition": "Something harmful or threatening to another person or thing.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "harmful_thing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the freezing mountains, the cold weather quickly became the <w>enemy</w>.",
                            "target_lang_translations": {
                                "ru": "В ледяных горах холодная погода быстро стала <w>врагом</w>."
                            }
                        },
                        {
                            "text": "Time is the <w>enemy</w> when you are trying to finish a difficult project.",
                            "target_lang_translations": {
                                "ru": "Время — твой <w>враг</w>, когда ты пытаешься закончить сложный проект."
                            }
                        }
                    ],
                    "synonyms": [
                        "bane",
                        "nemesis"
                    ],
                    "common_phrases": [
                        "time is the enemy",
                        "natural enemy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Что-то вредное или угрожающее другому человеку или вещи."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "враг",
                                "target_lang_sense_clarification": "переносное значение: то, что приносит вред"
                            },
                            {
                                "target_lang_word": "угроза",
                                "target_lang_sense_clarification": "опасный фактор"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6121daa8-412d-3ddb-be0c-888a50cb251f",
                    "sense_definition": "To make an <w>enemy</w> of someone.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He has befriended and <w>enemied</w> many people throughout his long political career.",
                            "target_lang_translations": {
                                "ru": "За свою долгую политическую карьеру он заводил друзей и <w>наживал врагов</w> среди многих людей."
                            }
                        },
                        {
                            "text": "The game mechanics involved friending or <w>enemying</w> other players for points.",
                            "target_lang_translations": {
                                "ru": "Механика игры предполагала добавление в друзья или <w>объявление врагами</w> других игроков ради очков."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сделать кого-либо своим врагом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "враждовать",
                                "target_lang_sense_clarification": "находиться в отношениях врага"
                            },
                            {
                                "target_lang_word": "наживать врагов",
                                "target_lang_sense_clarification": "делать людей своими врагами"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}