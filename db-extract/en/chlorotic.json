                        "sense_id": "8ff2f733-ce80-3765-9063-3dfc9c3c9ce8",
                        "entry_id": "2b795c97-797c-3c74-9fb9-784b612ea03b",
                        "glosses": [
                            "Of, pertaining to, or afflicted with chlorosis, anaemic."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3be8880f-592b-4dc5-b07c-2023a0d5e2c0",
                                "sense_id": "8ff2f733-ce80-3765-9063-3dfc9c3c9ce8",
                                "text": "“I don't mean all of your friends—only a small proportion—which, however, connects your circle with that deadly, idle, brainless bunch—the insolent chatterers at the opera,[…]the chlorotic squatters on huge yachts, the speed-mad fugitives from the furies of ennui, the neurotic victims of mental cirrhosis,[…]!”"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9178e65d-6971-4400-bf0d-d6cb126503e0",
                        "source_entry_id": "2b795c97-797c-3c74-9fb9-784b612ea03b",
                        "source_sense_id": "8ff2f733-ce80-3765-9063-3dfc9c3c9ce8",
                        "source_sense_description": "afflicted with chlorosis",
                        "target_lang_word": "chlorotique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chlorotique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d936486b-26a2-3fb0-987f-f326ffcbbb5e",
                                        "entry_id": "96edf031-5d6c-373a-bb24-55abaa290e9e",
                                        "glosses": [
                                            "Qui est affecté de chlorose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d28f63e5-1a60-44fb-87e9-fc8dd2c1b477",
                                                "sense_id": "d936486b-26a2-3fb0-987f-f326ffcbbb5e",
                                                "text": "Angèle acceptait la misère avec cette mollesse de femme chlorotique."
                                            },
                                            {
                                                "example_id": "6457e6ac-cd4e-4f7b-b20c-44b6e8ec4836",
                                                "sense_id": "d936486b-26a2-3fb0-987f-f326ffcbbb5e",
                                                "text": "— Moi, disait Berthe, j’ai perdu ma mère à seize ans. Elle est morte quand j’étais à l’hôpital. On n’a pas voulu que je la voie. Moi, j’étais anémie-chlorotique et ce n’est pas ça qui m’a guérie."
                                            },
                                            {
                                                "example_id": "fe9a639f-450b-49fe-ba70-976340e12afd",
                                                "sense_id": "d936486b-26a2-3fb0-987f-f326ffcbbb5e",
                                                "text": "Elles sont dix dans la classe qui se ressemblent comme des sœurs : visage vieux, allongé, chlorotique, grand nez, grand menton, physionomie d’une laideur triste vraiment pauvre, corps maigre sans grâce et même agaçant par trop d’apathie."
                                            },
                                            {
                                                "example_id": "4c0c6258-1f54-4ae8-935a-47c1f67c59de",
                                                "sense_id": "d936486b-26a2-3fb0-987f-f326ffcbbb5e",
                                                "text": "Oh ! dad, on a eu de nouveau si peur ! dit enfin le plus âgé des trois, un gamin chlorotique mais au regard très éveillé."
                                            },
                                            {
                                                "example_id": "4cd935e0-e0dd-4d12-83a7-0da5b94502e0",
                                                "sense_id": "d936486b-26a2-3fb0-987f-f326ffcbbb5e",
                                                "text": "Quelques plantes vertes chlorotiques habillaient une vitrine que laquelle s’étalaient ne lettres d’émail les services offerts : soins à domicile, piqûres, massages."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b6c99153-2db3-347c-8253-db23d42efe39",
                                        "entry_id": "96edf031-5d6c-373a-bb24-55abaa290e9e",
                                        "glosses": [
                                            "Qui a rapport à la chlorose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c290b812-6074-4671-ab10-bb7dcf0cdb84",
                                                "sense_id": "b6c99153-2db3-347c-8253-db23d42efe39",
                                                "text": "À côté, les prunes transparentes montraient des douceurs chlorotiques de vierge"
                                            },
                                            {
                                                "example_id": "68227085-cddf-46a6-8e3b-939f8d2a8635",
                                                "sense_id": "b6c99153-2db3-347c-8253-db23d42efe39",
                                                "text": "Les hommes devront particulièrement se défier des blondes fades, chlorotiques, molles dans leurs allures…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
