                    "frequency": "Middle",
                    "semantic_group_id": "instrument",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le cocher fait claquer son <w>fouet</w> en l'air pour encourager les chevaux à avancer."
                        },
                        {
                            "text": "Le dresseur tient un grand <w>fouet</w> dans sa main droite au milieu de la piste."
                        }
                    ],
                    "common_phrases": [
