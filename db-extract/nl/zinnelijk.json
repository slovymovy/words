                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e016e06-7f9d-44eb-91c9-fc1f0f6924b5",
                                "sense_id": "0f725a6a-9278-3533-a527-c856df3fbaab",
                                "text": "De zinnelijke geur van het parfum trok ieders aandacht.",
                                "translation": "The sensual scent of the perfume caught everyone's attention.",
                                "english": "The sensual scent of the perfume caught everyone's attention."
                            },
                            {
                                "example_id": "5b7c8d99-7ad9-42e6-921a-be0c2bff67be",
                                "sense_id": "0f725a6a-9278-3533-a527-c856df3fbaab",
                                "text": "Ze verleidde hem met haar zinnelijke uitstraling.",
                                "translation": "She seduced him with her sensual allure.",
                                "english": "She seduced him with her sensual allure."
                            },
                            {
                                "example_id": "46cf737a-5267-4070-a2d1-2a3de9bf4df6",
                                "sense_id": "0f725a6a-9278-3533-a527-c856df3fbaab",
                                "text": "Het schilderij straalt een zinnelijke schoonheid uit.",
                                "translation": "The painting exudes a sensual beauty.",
                                "english": "The painting exudes a sensual beauty."
                            }
                        ]
                    }
