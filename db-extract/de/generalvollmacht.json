                "senses": [
                    {
                        "sense_id": "fe92b4f6-2a09-320f-bdcc-346fb3cdd5a0",
                        "entry_id": "402f98f3-4012-3934-9953-071d9d39c572",
                        "glosses": [
                            "umfassende Vollmacht für alle rechtlichen Stellvertretungen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cd85ece4-6081-4899-afe2-b4db20599896",
                                "sense_id": "fe92b4f6-2a09-320f-bdcc-346fb3cdd5a0",
                                "text": "Eine Generalvollmacht eröffnet große Handlungsmöglichkeiten."
                            },
                            {
                                "example_id": "30fadd98-f08d-44ae-a6c1-1e53006b9e34",
                                "sense_id": "fe92b4f6-2a09-320f-bdcc-346fb3cdd5a0",
                                "text": "„Vor dem Abflug brachte sie ihren Freund dazu, ihr eine Generalvollmacht über sein Vermögen, Blankounterschriften, die Schlüssel für sein Auto und den Tresor in der Villa samt Zahlenkombinationen zu überlassen.“"
                            },
                            {
                                "example_id": "af049e7e-b210-4623-b9a8-a3b126b3cbcc",
                                "sense_id": "fe92b4f6-2a09-320f-bdcc-346fb3cdd5a0",
                                "text": "„Bekommt Kurz in diesem gerade angebrochenen machtpolitischen Mondfenster die Generalvollmacht nicht, kann er die Partei nicht ändern und sollte die Truppe ohne mit der Wimper zu zucken im Regen stehen lassen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
