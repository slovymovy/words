{
    "word_family": [
        "require",
        "requisite",
        "requisition"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e4a35302-be37-3256-9ed1-ac7347cb5678",
                    "sense_definition": "Something that is needed or demanded as a necessary condition or obligation.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "necessity_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A valid passport is a legal <w>requirement</w> for international travel.",
                            "target_lang_translations": {
                                "ru": "Действующий паспорт является юридическим <w>требованием</w> для международных путешествий.",
                                "zh": "有效的护照是国际旅行的一项法律<w>要求</w>。"
                            }
                        },
                        {
                            "text": "You must meet the minimum <w>requirements</w> to apply for this job.",
                            "target_lang_translations": {
                                "ru": "Вы должны соответствовать минимальным <w>требованиям</w>, чтобы подать заявку на эту работу.",
                                "zh": "你必须满足最低<w>要求</w>才能申请这份工作。"
                            }
                        }
                    ],
                    "synonyms": [
                        "necessity",
                        "prerequisite",
                        "condition",
                        "essential",
                        "need",
                        "must-have"
                    ],
                    "antonyms": [
                        "option"
                    ],
                    "common_phrases": [
                        "meet requirements",
                        "minimum requirement",
                        "legal requirement",
                        "entry requirement"
                    ],
                    "target_lang_definitions": {
                        "ru": "То, что необходимо или требуется как обязательное условие или обязанность.",
                        "zh": "作为必要条件或义务而需要或被要求的事物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "требование",
                                "target_lang_sense_clarification": "обязательное условие, правило"
                            },
                            {
                                "target_lang_word": "необходимое условие",
                                "target_lang_sense_clarification": "предпосылка"
                            },
                            {
                                "target_lang_word": "необходимость",
                                "target_lang_sense_clarification": "надобность"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "要求",
                                "target_lang_sense_clarification": "作为必要条件或规则"
                            },
                            {
                                "target_lang_word": "必要条件",
                                "target_lang_sense_clarification": "前提条件"
                            },
                            {
                                "target_lang_word": "必需品",
                                "target_lang_sense_clarification": "不可缺少的事物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b98ebd48-2452-3cbf-9bb8-1e29e2edf9b3",
                    "sense_definition": "A specific constraint, standard, or specification that a system, product, or service must meet to be accepted.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "necessity_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please check the system <w>requirements</w> before you install the software.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, проверьте системные <w>требования</w> перед установкой программного обеспечения.",
                                "zh": "安装软件前请检查系统<w>要求</w>。"
                            }
                        },
                        {
                            "text": "The engineering team is reviewing the safety <w>requirements</w> for the new bridge.",
                            "target_lang_translations": {
                                "ru": "Инженерная группа пересматривает <w>требования</w> безопасности для нового моста.",
                                "zh": "工程团队正在审查新桥梁的安全<w>要求</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "specification",
                        "spec"
                    ],
                    "common_phrases": [
                        "system requirements",
                        "software requirements",
                        "user requirements"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Конкретное ограничение, стандарт или спецификация, которым должны соответствовать система, продукт или услуга.",
                        "zh": "系统、产品或服务为被接受而必须满足的具体约束、标准或规范。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "требование",
                                "target_lang_sense_clarification": "технический стандарт"
                            },
                            {
                                "target_lang_word": "техническое условие",
                                "target_lang_sense_clarification": "спецификация"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "要求",
                                "target_lang_sense_clarification": "技术标准或规范"
                            },
                            {
                                "target_lang_word": "技术条件",
                                "target_lang_sense_clarification": "工程或系统规格"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "12c4d5e6-6ef8-3762-990f-56872162e998",
                    "sense_definition": "Something that is asked for or requested.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The manager listened to the client's specific <w>requirements</w> for the design.",
                            "target_lang_translations": {
                                "ru": "Менеджер выслушал конкретные <w>пожелания</w> клиента относительно дизайна.",
                                "zh": "经理听取了客户对设计的具体<w>需求</w>。"
                            }
                        },
                        {
                            "text": "Her only <w>requirement</w> was that we finish the project by Friday.",
                            "target_lang_translations": {
                                "ru": "Её единственным <w>требованием</w> было, чтобы мы закончили проект к пятнице.",
                                "zh": "她唯一的<w>要求</w>就是我们必须在周五前完成项目。"
                            }
                        }
                    ],
                    "synonyms": [
                        "request",
                        "demand"
                    ],
                    "target_lang_definitions": {
                        "ru": "То, что запрашивается или требуется кем-либо; пожелание или запрос.",
                        "zh": "某人所请求或要求的事物；愿望或请求。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "потребность",
                                "target_lang_sense_clarification": "нужда, запрос клиента"
                            },
                            {
                                "target_lang_word": "требование",
                                "target_lang_sense_clarification": "настойчивая просьба"
                            },
                            {
                                "target_lang_word": "пожелание",
                                "target_lang_sense_clarification": "просьба, запрос"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "需求",
                                "target_lang_sense_clarification": "客户或用户的具体请求"
                            },
                            {
                                "target_lang_word": "要求",
                                "target_lang_sense_clarification": "提出的请求或主张"
                            },
                            {
                                "target_lang_word": "愿望",
                                "target_lang_sense_clarification": "希望达到的目标或请求"
                            }
                        ]
                    }
                }
            ]
        }
    ]
