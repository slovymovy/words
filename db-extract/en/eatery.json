                "senses": [
                    {
                        "sense_id": "2016efc7-9c06-3d28-b54b-962ab8972030",
                        "entry_id": "ed5e7c1f-800d-3809-a80c-0d9840f0307d",
                        "glosses": [
                            "A restaurant or café; a place to purchase and eat food."
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "66c25e66-70c3-4d6f-a36b-51563d41019e",
                                "sense_id": "2016efc7-9c06-3d28-b54b-962ab8972030",
                                "text": "Above the concourse, the underneath of the platforms has been clad with attractive wood panelling, while the columns holding them up are surrounded with seating - for use by passengers biding their time waiting for their trains, or who have used one of the 70-or-so eateries or shops that form part of the retail developments at the station."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "65146e33-ef38-445e-996e-ee6b52367c05",
                        "source_entry_id": "ed5e7c1f-800d-3809-a80c-0d9840f0307d",
                        "source_sense_id": "2016efc7-9c06-3d28-b54b-962ab8972030",
                        "source_sense_description": "a restaurant or café",
                        "target_lang_word": "eetcafé",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "eetcafé",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "7d1d57ff-33f1-31d3-aaa7-6eedca8aa81d",
                                        "entry_id": "ceed4006-130f-311c-95d5-c803fe5916e7",
                                        "glosses": [
                                            "een café waar ook maaltijden verkregen kunnen worden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "403731d8-fa33-43ad-9f36-41d0a1d63b0f",
                                                "sense_id": "7d1d57ff-33f1-31d3-aaa7-6eedca8aa81d",
                                                "text": "Als je ook wat wil eten, gaan we naar een eetcafé."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "09c938ec-6cde-41f1-9674-1113b53d9e09",
                        "source_entry_id": "ed5e7c1f-800d-3809-a80c-0d9840f0307d",
                        "source_sense_id": "2016efc7-9c06-3d28-b54b-962ab8972030",
                        "source_sense_description": "a restaurant or café",
                        "target_lang_word": "eterij",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "eterij",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "1ad7b353-1782-3d57-8bc3-c4fcba2cf22c",
                                        "entry_id": "48c57d9c-0410-3d86-b00c-14cd0a8d11a6",
                                        "glosses": [
                                            "plaats waar je eten kunt kopen en opeten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e803fae-9c0e-4084-8738-789e33e20f25",
                                                "sense_id": "1ad7b353-1782-3d57-8bc3-c4fcba2cf22c",
                                                "text": "Een dag later, donderdag, wordt er op de openbare basisschool de Esmarke aan de Esmarkelaan (201) van 17 tot 19 uur een kerstmarkt gehouden waar onder meer door kinderen en ouders gemaakte kerststukken en - versieringen worden verkocht. Op het middenplein is buiten een eterij ingericht."
                                            },
                                            {
                                                "example_id": "758e6835-4952-43fb-8344-89998be63fc7",
                                                "sense_id": "1ad7b353-1782-3d57-8bc3-c4fcba2cf22c",
                                                "text": "Bodega's, eetsalons, bistro's en brasserieën niet te na gesproken, heb ik vooraf al een milde aversie tegen restaurants die de aanduiding 'restaurant' te gewoon vinden en zich daarom 'Eten en drinken' of 'Eterij' noemen, of zich met een ander 'kijk ons eens lekker gewoon doen'-etiket afficheren. HP de Tijd 18/02"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "75064b9d-2fa9-3c01-b0eb-e0efc2a4c4f4",
                                        "entry_id": "48c57d9c-0410-3d86-b00c-14cd0a8d11a6",
                                        "glosses": [
                                            "zaken die je kun opeten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1497c007-eeec-428b-8520-39d81e74093e",
                                                "sense_id": "75064b9d-2fa9-3c01-b0eb-e0efc2a4c4f4",
                                                "text": "Hotelketen Hyatt beraadt zich nog, maar roomservice is er al niet meer 24 uur. Steeds meer hotels reiken de bestellingen niet meer aan op een dienblad, maar zetten de eterij in een papieren zak voor de deur, las ik."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e970d2a0-5c49-4c6e-9040-52451cffa3ca",
                        "source_entry_id": "ed5e7c1f-800d-3809-a80c-0d9840f0307d",
                        "source_sense_id": "2016efc7-9c06-3d28-b54b-962ab8972030",
                        "source_sense_description": "a restaurant or café",
                        "target_lang_word": "resto",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "resto",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "47a298c8-3b58-3d35-8838-64df9df9b7ce",
                                        "entry_id": "4893029a-49d7-320f-8995-9e2d331f12c0",
                                        "glosses": [
                                            "Variante de restau pour dire restaurant."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3cc82f26-72e2-44d7-b332-84a238c63be3",
                                                "sense_id": "47a298c8-3b58-3d35-8838-64df9df9b7ce",
                                                "text": "Ses copains avaient organisé une fête dans un resto assez chic, au cœur de Paris."
                                            },
                                            {
                                                "example_id": "1d110ef3-94ed-41a7-a418-4a7b406c6c67",
                                                "sense_id": "47a298c8-3b58-3d35-8838-64df9df9b7ce",
                                                "text": "Au Bouillon Pigalle, nouveau spot apprécié du boulevard de Clichy, la star s'appelle bourguignon aux coquillettes (notre strogonoff à nous). Le lieu est d'ailleurs une moderne réincarnation des bouillons, ces restos populaires de la Belle Époque."
                                            },
                                            {
                                                "example_id": "8c869f71-f6be-46ab-8973-c57673624fca",
                                                "sense_id": "47a298c8-3b58-3d35-8838-64df9df9b7ce",
                                                "text": "Poursuivant notre flânage, nous voyons depuis la ruelle l’envers du décor: des dizaines de climatiseurs, fixés aux murs, soufflent la chaleur des restos vers l’extérieur."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bbfb5d35-f322-4dd2-acec-0a1a948fe0ac",
                        "source_entry_id": "ed5e7c1f-800d-3809-a80c-0d9840f0307d",
                        "source_sense_id": "2016efc7-9c06-3d28-b54b-962ab8972030",
