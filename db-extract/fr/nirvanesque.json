                        ],
                        "examples": [
                            {
                                "example_id": "f7ec8c4b-635f-47ac-aae2-b3de39a95279",
                                "sense_id": "6d8c969e-7104-30bc-a8c1-5f5abce98a4d",
                                "text": "Le moment où elle endort doucement ses deux petits garçons empoisonnés par elle est d'une étrange, d'une « nirvanesque » douceur."
                            },
                            {
                                "example_id": "fcf11ad5-d8d9-4f9f-b99d-a8fff2ee9a78",
                                "sense_id": "6d8c969e-7104-30bc-a8c1-5f5abce98a4d",
                                "text": "Fantasme du retour au sein maternel : nostalgie de l'état nirvanesque qui fut celui du fœtus dans le corps maternel."
                            },
                            {
                                "example_id": "19b3ca04-2e72-4a73-9fa9-6629725093dd",
                                "sense_id": "6d8c969e-7104-30bc-a8c1-5f5abce98a4d",
                                "text": "Il s'est consacré à la divinité et celle-ci généreuse ne tardera pas à lui faire connaître les suprêmes joies des grandes félicités nirvanesques."
                            }
                        ]
