                        "glosses": [
                            "État de ce qui appartient ou est propre au Maroc ou aux Marocains ; identité marocaine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cfae1ede-32b6-440e-8d55-15484ec00ef1",
                                "sense_id": "e0e08b67-8e26-3a94-9f99-e8630131773d",
                                "text": "Elle doit aussi compter avec un chauvinisme officiellement encouragé au Maroc sur tout débat portant sur cette région et des lois punissant les propos remettant en cause la marocanité du territoire."
                            },
                            {
                                "example_id": "ffd28ee6-20cd-4413-96b9-a4dcbfc54d46",
                                "sense_id": "e0e08b67-8e26-3a94-9f99-e8630131773d",
                                "text": "Au Maroc, remettre en cause la marocanité du Sahara occidental est passible de prison."
                            },
                            {
                                "example_id": "1c93f22f-e3ba-481e-ad7f-e62ee1092dc5",
                                "sense_id": "e0e08b67-8e26-3a94-9f99-e8630131773d",
                                "text": "Prenons par exemple la question de la reconnaissance de la marocanité du Sahara occidental."
