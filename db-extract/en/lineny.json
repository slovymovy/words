                        "glosses": [
                            "Resembling or characterized by linen."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a6e9e41-c8e2-42b8-ad87-5f82d0da0d8e",
                                "sense_id": "a66621c0-3974-3431-af44-6890dbfd22bb",
                                "text": "She laid herself upon the bed, regardless of her fluffy tulle and magnolia blossoms, and turned her face against the lineny coolness of the pillow."
                            },
                            {
                                "example_id": "15b84225-c287-4328-b3eb-9aebbc461b47",
                                "sense_id": "a66621c0-3974-3431-af44-6890dbfd22bb",
                                "text": "Garth sat beside the bed in the middle of the big sunny ward. […] The place was blanched and lineny with an apocalyptic impersonal light and people shaded their eyes and lowered their voices."
                            },
                            {
                                "example_id": "bef4c1af-820f-4e46-93f4-99231dbf92a9",
                                "sense_id": "a66621c0-3974-3431-af44-6890dbfd22bb",
                                "text": "I felt the material of her dress against my cheek. And smelt the clean lineny smell of her."
                            }
                        ]
                    }
