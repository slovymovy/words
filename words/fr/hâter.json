                {
                    "sense_id": "f465d6d8-b510-3d6e-b858-e3ca5e10a616",
                    "sense_definition": "Agir promptement, se dépêcher d'accomplir une action.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "vitesse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Voyant que l'orage approchait, nous nous sommes <w>hâtés</w> de rentrer à la maison."
                        },
                        {
                            "text": "Il doit se <w>hâter</w> s'il veut attraper le dernier train de la soirée."
                        }
                    ],
                    "synonyms": [
                        "empresser"
                    ],
                    "common_phrases": [
                        "se hâter de"
                    ]
                },
                {
                    "sense_id": "bd231e3b-f0bd-3794-8354-b92e81f075c6",
                    "sense_definition": "Faire avancer plus rapidement ou faire arriver plus tôt un événement.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "vitesse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le froid glacial a poussé les piétons à <w>hâter</w> le pas dans la rue."
                        },
                        {
                            "text": "Cette annonce inattendue risque de <w>hâter</w> le départ du directeur général."
                        }
                    ],
                    "common_phrases": [
                        "hâter le pas",
                        "hâter son départ"
                    ]
                },
                {
                    "sense_id": "c49cf6f0-ae7f-3899-8d4f-f681d64742c9",
                    "sense_definition": "Faire parvenir des fruits ou des végétaux à maturité plus tôt que prévu.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'usage d'une serre permet de <w>hâter</w> la récolte des premières fraises au printemps."
                        },
                        {
                            "text": "Les fortes chaleurs du mois de mai ont <w>hâté</w> les fruits du verger."
                        }
                    ],
                    "common_phrases": [
