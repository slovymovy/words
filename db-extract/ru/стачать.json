                "senses": [
                    {
                        "sense_id": "3eb4f1e8-0a7e-3e84-864d-1d2b9a462658",
                        "entry_id": "6f8a73ab-d02b-3956-b724-87088798c2a0",
                        "glosses": [
                            "швейн. соединить примерно равные по величине детали одну с другой (спинку и полочки, клинья юбки и т. д.), либо края детали (рукава, манжеты) по линиям срезов, либо участки детали по наметке (вытачки)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d7eadab-bd7d-43d1-a8ca-022780bbbfaa",
                                "sense_id": "3eb4f1e8-0a7e-3e84-864d-1d2b9a462658",
                                "text": "Верхний слой платья лицевой стороной сложить с изнаночной стороной нижнего слоя и стачать их по линии выреза спинки, переда и проймы, одновременно пришивая и концы бретелей."
                            }
                        ]
                    }
