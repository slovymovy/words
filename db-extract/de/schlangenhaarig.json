                "senses": [
                    {
                        "sense_id": "f16439e5-fced-34dd-8fbc-d337a7049c53",
                        "entry_id": "0c9ee85f-755b-3f4e-8a6d-ffacfecb548e",
                        "glosses": [
                            "Schlangenhaar habend, mit aus Schlangen bestehendem Haar"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0109cd0e-378f-48d4-8bb2-324f7895e83a",
                                "sense_id": "f16439e5-fced-34dd-8fbc-d337a7049c53",
                                "text": "„Was jedoch ein wenig beunruhigend wirkt, ist ihre Ähnlichkeit, gemessen an der Entfernung ihrer Ursprungsorte ... es liegen mehr als achttausend Meilen Ozean zwischen den Marquesas und Kambodscha ... und es erscheint rätselhaft, ja fast unvorstellbar, dass in beiden Kulturen Abbilder von schlangenhaarigen Gottheiten gefertigt worden sein sollen, die so ähnliche Namen tragen wie Z'otomogo und Z'mog.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
