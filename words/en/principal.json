{
    "word_family": [
        "principally",
        "principality"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "a2a3ce60-cf03-3447-a8db-27b1880b95dc",
                    "sense_definition": "Primary; most important; first level in importance.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>principal</w> reason for my visit is to see the manager.",
                            "target_lang_translations": {
                                "ru": "<w>Гла́вной</w> причи́ной моего́ визи́та явля́ется встре́ча с ме́неджером.",
                                "nl": "De <w>voornaamste</w> reden voor mijn bezoek is om de manager te spreken.",
                                "de": "Der <w>hauptsächliche</w> Grund für meinen Besuch ist es, den Manager zu sehen."
                            }
                        },
                        {
                            "text": "Vegetables are the <w>principal</w> ingredient in this stew.",
                            "target_lang_translations": {
                                "ru": "Овощи — <w>основно́й</w> ингредие́нт в э́том рагу́.",
                                "nl": "Groenten zijn het <w>belangrijkste</w> ingrediënt in deze stoofpot.",
                                "de": "Gemüse ist die <w>Hauptzutat</w> in diesem Eintopf."
                            }
                        },
                        {
                            "text": "Our <w>principal</w> concern is the safety of the children.",
                            "target_lang_translations": {
                                "ru": "На́ша <w>гла́вная</w> забо́та — безопа́сность дете́й.",
                                "nl": "Onze <w>voornaamste</w> zorg is de veiligheid van de kinderen.",
                                "de": "Unsere <w>Hauptsorge</w> gilt der Sicherheit der Kinder."
                            }
                        }
                    ],
                    "synonyms": [
                        "main",
                        "primary",
                        "chief",
                        "key",
                        "leading"
                    ],
                    "antonyms": [
                        "secondary",
                        "minor"
                    ],
                    "common_phrases": [
                        "principal reason",
                        "principal cause",
                        "principal objective",
                        "principal source"
                    ],
                    "target_lang_definitions": {
                        "ru": "Главный; наиболее важный; первый по значимости.",
                        "nl": "Primair; het meest belangrijk; eerste in rangorde van belang.",
                        "de": "Primär; am wichtigsten; von höchster Bedeutung."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "главный",
                                "target_lang_sense_clarification": "наиболее важный"
                            },
                            {
                                "target_lang_word": "основной",
                                "target_lang_sense_clarification": "базовый, первостепенный"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "voornaamste",
                                "target_lang_sense_clarification": "meest belangrijk of essentieel"
                            },
                            {
                                "target_lang_word": "belangrijkste",
                                "target_lang_sense_clarification": "meest cruciaal"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "hauptsächlich",
                                "target_lang_sense_clarification": "den vorwiegenden, wichtigsten Teil betreffend"
                            },
                            {
                                "target_lang_word": "wesentlich",
                                "target_lang_sense_clarification": "den Kern einer Sache betreffend"
                            },
                            {
                                "target_lang_word": "Haupt-",
                                "target_lang_sense_clarification": "Präfix zur Kennzeichnung des Wichtigsten"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2cfad753-e40e-3e3c-9f91-1d0ecdfbb86a",
                    "sense_definition": "The chief administrator of a school.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "education_admin",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>principal</w> announced the new rules during the morning assembly.",
                            "target_lang_translations": {
                                "ru": "<w>Дире́ктор</w> объяви́л о но́вых пра́вилах во вре́мя у́треннего собра́ния.",
                                "nl": "Het <w>schoolhoofd</w> kondigde de nieuwe regels aan tijdens de ochtendbijeenkomst.",
                                "de": "Der <w>Schulleiter</w> gab die neuen Regeln während der Morgenversammlung bekannt."
                            }
                        },
                        {
                            "text": "Parents must make an appointment if they wish to see the <w>principal</w>.",
                            "target_lang_translations": {
                                "ru": "Роди́тели должны́ записа́ться на приём, е́сли хотя́т уви́деть <w>дире́ктора</w>.",
                                "nl": "Ouders moeten een afspraak maken als ze het <w>schoolhoofd</w> willen spreken.",
                                "de": "Eltern müssen einen Termin vereinbaren, wenn sie den <w>Schulleiter</w> sprechen möchten."
                            }
                        }
                    ],
                    "synonyms": [
                        "headteacher",
                        "headmaster",
                        "headmistress",
                        "head",
                        "director"
                    ],
                    "common_phrases": [
                        "school principal",
                        "vice principal",
                        "principal's office"
                    ],
                    "target_lang_definitions": {
                        "ru": "Директор школы.",
                        "nl": "Het hoofd van een school.",
                        "de": "Die leitende Person einer Schule."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "директор",
                                "target_lang_sense_clarification": "школы"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "schoolhoofd",
                                "target_lang_sense_clarification": "directeur van een school"
                            },
                            {
                                "target_lang_word": "directeur",
                                "target_lang_sense_clarification": "algemene term voor schoolleider"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Schulleiter",
                                "target_lang_sense_clarification": "allgemeine Bezeichnung für die Leitung einer Schule"
                            },
                            {
                                "target_lang_word": "Rektor",
                                "target_lang_sense_clarification": "Leiter einer Schule oder Hochschule"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2e452063-32bd-3f5f-8f71-b9878797d9f7",
                    "sense_definition": "The money originally invested or loaned, on which basis interest and returns are calculated.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A portion of your monthly payment goes to reduce the <w>principal</w>.",
                            "target_lang_translations": {
                                "ru": "Часть ва́шего ежеме́сячного платежа́ идёт на погаше́ние <w>основно́го до́лга</w>.",
                                "nl": "Een deel van uw maandelijkse betaling gaat naar het aflossen van de <w>hoofdsom</w>.",
                                "de": "Ein Teil Ihrer monatlichen Zahlung dient der Tilgung der <w>Hauptsumme</w>."
                            }
                        },
                        {
                            "text": "She managed to pay off the <w>principal</w> of her loan earlier than expected.",
                            "target_lang_translations": {
                                "ru": "Ей удало́сь вы́платить <w>основну́ю су́мму</w> креди́та ра́ньше ожида́емого.",
                                "nl": "Het lukte haar om de <w>hoofdsom</w> van haar lening eerder dan verwacht af te lossen.",
                                "de": "Sie schaffte es, die <w>Hauptsumme</w> ihres Kredits früher als erwartet zurückzuzahlen."
                            }
                        }
                    ],
                    "antonyms": [
                        "interest"
                    ],
                    "common_phrases": [
                        "principal and interest",
                        "pay off the principal",
                        "principal amount",
                        "loan principal"
                    ],
                    "target_lang_definitions": {
                        "ru": "Основная сумма долга или инвестиций, на которую начисляются проценты.",
                        "nl": "Het oorspronkelijk geleende of geïnvesteerde bedrag, waarover rente wordt berekend.",
                        "de": "Das ursprünglich geliehene oder investierte Kapital, auf dessen Basis Zinsen berechnet werden."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "основной долг",
                                "target_lang_sense_clarification": "финансы"
                            },
                            {
                                "target_lang_word": "основная сумма",
                                "target_lang_sense_clarification": "кредита или займа"
                            },
                            {
                                "target_lang_word": "тело кредита",
                                "target_lang_sense_clarification": "профессиональный жаргон"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "hoofdsom",
                                "target_lang_sense_clarification": "het basisbedrag van een lening of schuld"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Hoofdsom",
                                "target_lang_sense_clarification": "Das Basisbedrag einer Schuld oder eines Kredits"
                            },
                            {
                                "target_lang_word": "Kapital",
                                "target_lang_sense_clarification": "Der ursprüngliche Anlagebetrag"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8221b958-340b-3e52-988a-292b98ffba0b",
                    "sense_definition": "A partner or owner of a business.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "business_role",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is a <w>principal</w> in a leading architectural firm in the city.",
                            "target_lang_translations": {
                                "ru": "Он — <w>веду́щий партнёр</w> в кру́пной архитекту́рной фи́рме го́рода.",
                                "nl": "Hij is <w>vennoot</w> bij een toonaangevend architectenbureau in de stad.",
                                "de": "Er ist <w>Teilhaber</w> in einem führenden Architekturbüro der Stadt."
                            }
                        },
                        {
                            "text": "The <w>principals</w> of the company met to discuss the potential merger.",
                            "target_lang_translations": {
                                "ru": "<w>Владе́льцы</w> компа́нии встре́тились, что́бы обсуди́ть возмо́жное слия́ние.",
                                "nl": "De <w>eigenaren</w> van het bedrijf kwamen samen om de mogelijke fusie te bespreken.",
                                "de": "Die <w>Eigentümer</w> des Unternehmens trafen sich, um die mögliche Fusion zu besprechen."
                            }
                        }
                    ],
                    "synonyms": [
                        "proprietor"
                    ],
                    "common_phrases": [
                        "firm principal",
                        "agency principal"
                    ],
                    "target_lang_definitions": {
                        "ru": "Партнёр или владелец бизнеса.",
                        "nl": "Een partner of eigenaar van een bedrijf.",
                        "de": "Ein Partner oder Eigentümer eines Unternehmens."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "владелец",
                                "target_lang_sense_clarification": "бизнеса"
                            },
                            {
                                "target_lang_word": "ведущий партнёр",
                                "target_lang_sense_clarification": "в фирме"
                            },
                            {
                                "target_lang_word": "принципал",
                                "target_lang_sense_clarification": "хозяин, глава (устар./офиц.)"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "eigenaar",
                                "target_lang_sense_clarification": "iemand die een bedrijf bezit"
                            },
                            {
                                "target_lang_word": "vennoot",
                                "target_lang_sense_clarification": "zakelijk partner in een firma"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Eigentümer",
                                "target_lang_sense_clarification": "Person, der ein Unternehmen gehört"
                            },
                            {
                                "target_lang_word": "Teilhaber",
                                "target_lang_sense_clarification": "Geschäftspartner in einer Firma"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e9b58412-df69-30a3-8f55-d619b81567c9",
                    "sense_definition": "A legal person that authorizes another (the agent) to act on their behalf.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "law_role",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The agent must always act in the best interest of the <w>principal</w>.",
                            "target_lang_translations": {
                                "ru": "Аге́нт до́лжен всегда́ де́йствовать в интере́сах <w>довери́теля</w>.",
                                "nl": "De agent moet altijd handelen in het belang van de <w>lastgever</w>.",
                                "de": "Der Vertreter muss immer im besten Interesse des <w>Vollmachtgebers</w> handeln."
                            }
                        },
                        {
                            "text": "The contract was signed by the attorney on behalf of the <w>principal</w>.",
                            "target_lang_translations": {
                                "ru": "Догово́р был подпи́сан адвока́том от и́мени <w>довери́теля</w>.",
                                "nl": "Het contract werd door de advocaat ondertekend namens de <w>lastgever</w>.",
                                "de": "Der Vertrag wurde vom Anwalt im Namen des <w>Vollmachtgebers</w> unterzeichnet."
                            }
                        }
                    ],
                    "synonyms": [
                        "client"
                    ],
                    "antonyms": [
                        "agent"
                    ],
                    "common_phrases": [
                        "principal and agent"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Лицо, уполномочивающее другое лицо (агента) действовать от своего имени.",
                        "nl": "Een persoon die een ander (de agent) machtigt om namens hem of haar op te treden.",
                        "de": "Eine Person, die eine andere (den Agenten) bevollmächtigt, in ihrem Namen zu handeln."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "доверитель",
                                "target_lang_sense_clarification": "юридический термин"
                            },
                            {
                                "target_lang_word": "принципал",
                                "target_lang_sense_clarification": "в агентских договорах"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "lastgever",
                                "target_lang_sense_clarification": "juridische term voor degene die een opdracht geeft"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Vollmachtgeber",
                                "target_lang_sense_clarification": "Juristischer Begriff für den Auftraggeber"
                            },
                            {
                                "target_lang_word": "Prinzipal",
                                "target_lang_sense_clarification": "Fachbegriff in der Prinzipal-Agent-Theorie"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7f8520a3-90fb-39dc-a1c2-7b77fcff3aea",
                    "sense_definition": "The chief executive and chief academic officer of a university or college.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "education_admin",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>principal</w> of the university gave a speech to the graduating class.",
                            "target_lang_translations": {
                                "ru": "<w>Ре́ктор</w> университе́та вы́ступил с ре́чью пе́ред выпускника́ми.",
                                "nl": "De <w>rector</w> van de universiteit hield een toespraak voor de afstudeerklas.",
                                "de": "Der <w>Rektor</w> der Universität hielt eine Rede vor den Absolventen."
                            }
                        },
                        {
                            "text": "She was appointed as the new <w>principal</w> of the college last year.",
                            "target_lang_translations": {
                                "ru": "В про́шлом году́ её назна́чили но́вым <w>ре́ктором</w> ко́лледжа.",
                                "nl": "Zij werd vorig jaar benoemd tot de nieuwe <w>rector</w> van de hogeschool.",
                                "de": "Sie wurde letztes Jahr zur neuen <w>Rektorin</w> des Colleges ernannt."
                            }
                        }
                    ],
                    "synonyms": [
                        "dean",
                        "rector"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "used in Scotland and Canada"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ректор университета или колледжа.",
                        "nl": "De hoogste bestuurder van een universiteit of hogeschool.",
                        "de": "Der leitende Beamte einer Universität oder Hochschule."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ректор",
