                "senses": [
                    {
                        "sense_id": "847f2405-1846-3f30-8a2b-ce9b25328d83",
                        "entry_id": "8fd35778-f8f0-3079-a093-1e6e466cd032",
                        "glosses": [
                            "разг., шутл. кошка или кот, котёнок"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "ff74dd0d-39fb-37e2-b60c-6b1ee747aa51",
                        "entry_id": "8fd35778-f8f0-3079-a093-1e6e466cd032",
                        "glosses": [
                            "разг., неодобр. или бран. используется как порицающее или бранное слово"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "70274ed2-d318-4b89-9340-0f680b731d8f",
                                "sense_id": "ff74dd0d-39fb-37e2-b60c-6b1ee747aa51",
                                "text": "Если бы он не самоустранился, то подтвердил бы, что стою я на коленях, и рожа у меня самая сокрушённая, и что я готов на любые контрибуции, только бы ты тут снова оказалась, кошатина ты вредная."
                            }
                        ]
                    }
