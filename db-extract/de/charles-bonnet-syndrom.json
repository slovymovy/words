                "senses": [
                    {
                        "sense_id": "6338171e-77c0-33a6-872e-fe7322a33fde",
                        "entry_id": "6f51a393-3bcb-393a-a521-4f82b041d59f",
                        "glosses": [
                            "neurologisches und psychiatrisches Syndrom, bei dem es aufgrund einer chronischen Sehverschlechterung bei normalem Bewusstsein zu visuellen Trugwahrnehmungen ohne Vorhandensein einer akuten psychiatrischen Erkrankung kommt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da1c6a21-7e07-4490-9599-6ac1dd7a5c8f",
                                "sense_id": "6338171e-77c0-33a6-872e-fe7322a33fde",
                                "text": "„›Man spricht vom Charles-Bonnet-Syndrom, benannt nach dem Mann, der es als erster beobachtet hat. Unter Menschen, deren Sehkraft nachlässt, ist es recht verbreitet. Alte Leute mit grauem Star zum Beispiel berichten oft, dass sie Halluzinationen haben: Menschen, Gegenstände, Gepenster.‹“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
