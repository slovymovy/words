                                    {
                                        "sense_id": "b800e814-23dd-3a61-a0a9-a3454a1b3610",
                                        "entry_id": "b8ec0fd8-a37d-333f-830f-e1de64908ac3",
                                        "glosses": [
                                            "iets tussen snel lopen en langzaam rennen in"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58ed668f-cfe4-4dc0-a4ec-85c8321ade55",
                                                "sense_id": "b800e814-23dd-3a61-a0a9-a3454a1b3610",
                                                "text": "Ik liep vriendelijk knikkend de zaal uit in de onvoorstelbare wetenschap dat het voorbij was, dat ik alleen de Christelijke Vrouwen nog te gaan had. Mijn zuster volgde op een sukkeldraf met jassen en tassen. De limousine stond voor en we stapten in."
                                            },
                                            {
                                                "example_id": "5905a4fd-f3f0-4299-a3b5-09ca9cd1219e",
                                                "sense_id": "b800e814-23dd-3a61-a0a9-a3454a1b3610",
                                                "text": "lk raapte gedachteloos het wapen op dat Caloyanni had laten vallen, alsof de welopgevoede jongen in mij aanstalten maakte om het de eigenaar na te brengen. Het was nog warm. Er steeg een geur van geketste vuursteen en ontstoken kruit uit op, die de neus prikkelde. Sara zweeg. Ze stond daar alsof ze sprakeloos, als gekwetst, haar gewezen minnaar nakeek, die nu op een sukkeldrafje overging."
                                            },
                                            {
                                                "example_id": "b4cd65f5-c302-4dc1-8255-77a1a7f59e8e",
                                                "sense_id": "b800e814-23dd-3a61-a0a9-a3454a1b3610",
                                                "text": "De Nintendo Switch verkoopt in een rapper tempo dan de lopende band bij kan houden, maar de software-releases vertonen helaas een sukkeldraf. Het aanbod wordt gedomineerd door kleine indiegames, en behalve een toptitel als Zelda: Breath of the Wild zijn er geen andere bestsellers te spelen."
                                            }
                                        ]
                                    }
