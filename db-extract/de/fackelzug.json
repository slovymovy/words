                "senses": [
                    {
                        "sense_id": "44b07a79-1530-36fc-9bc0-6f802f4d8073",
                        "entry_id": "24506c9b-5399-3f52-b536-fad43c41e4e0",
                        "glosses": [
                            "nächtlicher Umzug vieler Personen mit brennenden Fackeln"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dbe38c5a-fb07-44e5-80ad-2df0cbc0c7f0",
                                "sense_id": "44b07a79-1530-36fc-9bc0-6f802f4d8073",
                                "text": "Im Anschluss an den Gottesdienst gab es einen Fackelzug in Richtung Trainingsbergwerk."
                            },
                            {
                                "example_id": "297ae605-b22b-4092-aef7-ec560aacfa78",
                                "sense_id": "44b07a79-1530-36fc-9bc0-6f802f4d8073",
                                "text": "„Dann veranstaltete man für ihn einen riesigen Fackelzug.“"
                            },
                            {
                                "example_id": "e002cda9-9dfc-490d-b34c-cbce103d6a9c",
                                "sense_id": "44b07a79-1530-36fc-9bc0-6f802f4d8073",
                                "text": "„Der Fackelzug am Abend seiner Ernennung, die spontanen Freudenkundgebungen an vielen Orten zeigten, welchen Rückhalt er in der Bevölkerung bereits besaß.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
