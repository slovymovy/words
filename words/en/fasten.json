{
    "word_family": [
        "fastener",
        "fastening",
        "unfasten"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b608215c-c770-3f6e-b476-4c8ffc184910",
                    "sense_definition": "To attach or connect something in a secure manner.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "attach",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please <w>fasten</w> your seat belts before the plane takes off.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, <w>пристегните</w> ремни безопасности перед взлетом самолета."
                            }
                        },
                        {
                            "text": "The sailor <w>fastened</w> the boat to the dock with a strong rope.",
                            "target_lang_translations": {
                                "ru": "Моряк <w>привязал</w> лодку к причалу крепкой веревкой."
                            }
                        }
                    ],
                    "synonyms": [
                        "attach",
                        "secure",
                        "fix",
                        "tie"
                    ],
                    "antonyms": [
                        "unfasten",
                        "detach",
                        "loosen"
                    ],
                    "common_phrases": [
                        "fasten your seat belts",
                        "fasten securely",
                        "fasten together"
                    ],
                    "target_lang_definitions": {
                        "ru": "Прикреплять или соединять что-либо надежным способом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "застегивать",
                                "target_lang_sense_clarification": "одежду или ремни"
                            },
                            {
                                "target_lang_word": "закреплять",
                                "target_lang_sense_clarification": "делать неподвижным"
                            },
                            {
                                "target_lang_word": "привязывать",
                                "target_lang_sense_clarification": "с помощью веревки"
                            },
                            {
                                "target_lang_word": "скреплять",
                                "target_lang_sense_clarification": "соединять части вместе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7cfa23f7-28de-3149-9250-763cd4d1f3ff",
                    "sense_definition": "To cause something to take effect or to land a physical strike or blow.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "impact",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The boxer managed to <w>fasten</w> a blow to his opponent's chin.",
                            "target_lang_translations": {
                                "ru": "Боксеру удалось <w>нанести</w> удар в подбородок противника."
                            }
                        },
                        {
                            "text": "He tried to <w>fasten</w> a cup of wine upon his guest to make him stay.",
                            "target_lang_translations": {
                                "ru": "Он пытался <w>навязать</w> гостю чашу вина, чтобы тот остался."
                            }
                        }
                    ],
                    "synonyms": [
                        "inflict",
                        "land"
                    ],
                    "common_phrases": [
                        "fasten a blow"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used in older literature or specific idiomatic contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Наносить физический удар или заставлять что-либо подействовать (устар.)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наносить",
                                "target_lang_sense_clarification": "удар"
                            },
                            {
                                "target_lang_word": "навязывать",
                                "target_lang_sense_clarification": "предлагать что-то настойчиво"
                            }
                        ]
                    }
                }
            ]
        }
    ]
