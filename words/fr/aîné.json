            "senses": [
                {
                    "sense_id": "a67105c9-8f3b-32d6-86c2-c29e52e75eaa",
                    "sense_definition": "Qui est né avant un ou plusieurs autres enfants d'une même famille.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "famille",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mon frère <w>aîné</w> fait des études d'ingénieur dans une autre ville."
                        },
                        {
                            "text": "Sa sœur <w>aînée</w> lui prête souvent ses livres et ses vêtements."
                        }
                    ],
                    "antonyms": [
                        "cadet",
                        "puîné"
                    ],
                    "common_phrases": [
