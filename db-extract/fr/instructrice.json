                                    {
                                        "sense_id": "488d1bf7-2191-32a2-bbb1-f9e4e4545fb2",
                                        "entry_id": "dd0426a7-5057-36e4-8c40-7f0b6405652e",
                                        "glosses": [
                                            "vrouw die anderen onderwijst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c23081ff-dbf2-485a-938d-b0ef5ea707bd",
                                                "sense_id": "488d1bf7-2191-32a2-bbb1-f9e4e4545fb2",
                                                "text": "En als je er geen bezwaar tegen hebt Kamala, zou ik het bijzonder op prijs stellen als je mijn vriendin en leermeesteres zou willen worden, - omdat ik elke ervaring mis in de kunst, die jij als geen ander beheerst."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8f7c112b-9049-49ac-ac24-c81870a0d45c",
                        "source_entry_id": "a8dad1de-547f-359b-ace3-acdf8bbf4864",
