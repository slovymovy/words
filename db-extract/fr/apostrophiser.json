                "senses": [
                    {
                        "sense_id": "a9e517dc-0fe1-3b7b-a075-2fd73e963347",
                        "entry_id": "0906f444-7f45-3bb8-a4bf-c23591680765",
                        "glosses": [
                            "Ajouter une apostrophe à."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "eee80053-1689-4002-98ba-7f608ad788f7",
                                "sense_id": "a9e517dc-0fe1-3b7b-a075-2fd73e963347",
                                "text": "Moi je vire jamais les lettres. Tout au plus je les apostrophise."
                            }
                        ]
                    },
                    {
                        "sense_id": "6ba49fca-b8de-3cfc-a094-2614eb938812",
                        "entry_id": "0906f444-7f45-3bb8-a4bf-c23591680765",
                        "glosses": [
                            "Apostropher quelqu’un."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "340e090f-db01-44bb-88e6-c73b213ac590",
                                "sense_id": "6ba49fca-b8de-3cfc-a094-2614eb938812",
                                "text": "Mais c'est mal d'apostrophiser ses connes-soeurs comme fait Clotilde."
                            },
                            {
                                "example_id": "f40e941e-61dc-4653-b39c-7b07460dac99",
                                "sense_id": "6ba49fca-b8de-3cfc-a094-2614eb938812",
                                "text": "(j'aime bien les nanas qui n'ont pas peur de se faire apostrophiser)"
                            },
                            {
                                "example_id": "2cca07f4-9367-408b-a19c-a239d402d069",
                                "sense_id": "6ba49fca-b8de-3cfc-a094-2614eb938812",
                                "text": "Bon, écoute, pour prouver qu'on peut apostrophiser le lecteur sans forcément ne faire que lui parler, grimpe sur ce cheval virtuel, boucle ta ceinture et accroche-toi à la crinière, ça va te scotcher !"
                            }
                        ]
                    }
