                "translations": [
                    {
                        "translation_id": "15ad56d2-8d65-4662-b089-c3c0c9bfeaa0",
                        "source_entry_id": "86ecf889-2904-31f8-9422-526d84892b75",
                        "target_lang_word": "Trüffel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Trüffel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "40af20c4-f26c-34ff-bb47-cbee21de300b",
                                        "entry_id": "e922de40-29da-3339-9e8c-99da660a36a7",
                                        "glosses": [
                                            "ein unter der Erde wachsender, edler, knollenförmiger, zu den Schlauchpilzen zählender Speisepilz"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86d692cd-4538-428a-8b18-8cfd37e19833",
                                                "sense_id": "40af20c4-f26c-34ff-bb47-cbee21de300b",
                                                "text": "Haben Sie Trüffel auf ihrer Speisekarte?"
                                            },
                                            {
                                                "example_id": "964beebd-0da0-4abb-b072-f09b2415ca9f",
                                                "sense_id": "40af20c4-f26c-34ff-bb47-cbee21de300b",
                                                "text": "„Trüffel, so erfuhr ich nun, wachsen unterirdisch, auch andere Pilzsorten, es gebe aber auch verschiedene Trüffelsorten.“"
                                            },
                                            {
                                                "example_id": "688b41ee-92ab-481c-8c85-c94db503c81e",
                                                "sense_id": "40af20c4-f26c-34ff-bb47-cbee21de300b",
                                                "text": "„Er tischte uns weiße Trüffeln auf, Muscheln verschiedener Art, die besten Fische aus dem Adriatischen Meer, nicht moussierenden Champagner, Peralta, Jerez und Pedro Jimenez.“"
                                            },
                                            {
                                                "example_id": "ca7e6586-91d4-42a1-b1fd-8039692524d4",
                                                "sense_id": "40af20c4-f26c-34ff-bb47-cbee21de300b",
                                                "text": "„Die rosigen Scheiben der Gänseleber lagen mit den schwarzen Trüffeln in einem Kranz von zitterndem Aspik.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7ed0fb9e-04cf-3740-90a1-cfe106fccaee",
                                        "entry_id": "e922de40-29da-3339-9e8c-99da660a36a7",
                                        "glosses": [
                                            "eine kugelförmige Praline aus einer festen, dennoch aber geschmeidigen Masse"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2742786c-417e-4bca-9916-0c000d6c5b20",
                                                "sense_id": "7ed0fb9e-04cf-3740-90a1-cfe106fccaee",
                                                "text": "Trüffel werden aus edlen Zutaten zubereitet."
                                            },
                                            {
                                                "example_id": "d465c293-1be0-4349-9c25-658279a74302",
                                                "sense_id": "7ed0fb9e-04cf-3740-90a1-cfe106fccaee",
                                                "text": "„Es klingelt und ein Bote bringt mir das Tablett mit den weißen und braunen Trüffeln von Leysieffer.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "a91f011b-b5ad-327b-a581-298d89e86ee5",
                                        "entry_id": "e922de40-29da-3339-9e8c-99da660a36a7",
                                        "glosses": [
                                            "Kartoffel"
                                        ],
                                        "tags": [
                                            "ostpreußisch"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c0731f82-fa89-48b2-b92c-64a48527e369",
