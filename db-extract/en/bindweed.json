                "translations": [
                    {
                        "translation_id": "072d016a-dd63-44ca-b108-add27eca80ea",
                        "source_entry_id": "0cce4213-fba0-3feb-a6ce-1c1c62b4a551",
                        "source_sense_id": "f12005ff-d018-3c39-8c8b-464d2f416e52",
                        "source_sense_description": "Botanik: die Winde",
                        "target_lang_word": "Winde",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Winde",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3be4efe7-4d14-3cb0-9994-48e98300b3dd",
                                        "entry_id": "92795253-0cbd-3fba-af10-c862027d8956",
                                        "glosses": [
                                            "Vorrichtung, mit der man Lasten heben, senken oder heranziehen kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab94c2f0-f5c6-4035-9ae9-e77a07fc3726",
                                                "sense_id": "3be4efe7-4d14-3cb0-9994-48e98300b3dd",
                                                "text": "Wir brauchen eine Winde, um das Auto aus dem Graben zu holen."
                                            },
                                            {
                                                "example_id": "7845f77d-f06a-4da0-b35c-befa01f26406",
                                                "sense_id": "3be4efe7-4d14-3cb0-9994-48e98300b3dd",
                                                "text": "„Martin hielt die Winde an, leerte die Falle, warf einen verrotteten Gotteslachs hinein, verschloss sie und schmiss sie aufs Deck.“"
                                            },
                                            {
                                                "example_id": "2eb94f91-769d-44e2-9283-29cd41ca5737",
                                                "sense_id": "3be4efe7-4d14-3cb0-9994-48e98300b3dd",
                                                "text": "„Die Donau belebte sich jetzt, eine Menge Barkassen und Kaiks manövrierten dort, begleitet von vielstimmigen Rufen, vom Knarren der Taue und Winden.“"
                                            },
                                            {
                                                "example_id": "a55e5c41-4336-4860-96ea-bc972c4ce1ac",
                                                "sense_id": "3be4efe7-4d14-3cb0-9994-48e98300b3dd",
                                                "text": "„Bei Sichtweiten von nur wenigen Metern begann […] ein aufwendiger Einsatz von Bodenkräften, zudem kreiste ein Hubschrauber konstant über dem Berg, um die beiden bei einer Wolkenlücke sofort mit einer Winde an Bord holen zu können.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8f43455c-0f24-3c86-8997-eb7b80770731",
                                        "entry_id": "92795253-0cbd-3fba-af10-c862027d8956",
                                        "glosses": [
                                            "Vertreter der Pflanzengattung Convolvulus"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e9c793a3-e4b0-4a1a-8e2e-e5a1256d9ac4",
                                                "sense_id": "8f43455c-0f24-3c86-8997-eb7b80770731",
                                                "text": "Winden klettern mit dem gesamten Stängel an anderen Pflanzen empor."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "d572fe4a-1f7a-3cc3-97ef-8cc5c818bfbc",
                                        "entry_id": "92795253-0cbd-3fba-af10-c862027d8956",
                                        "glosses": [
                                            "Dachboden"
                                        ],
                                        "tags": [
                                            "Swiss Standard German"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "03c79151-970e-49c7-b657-854e2ea99dd3",
                                                "sense_id": "d572fe4a-1f7a-3cc3-97ef-8cc5c818bfbc",
                                                "text": "Holst du bitte den Weihnachtsschmuck von der Winde herunter."
                                            },
                                            {
                                                "example_id": "1b73b039-32e5-4ac9-b52f-98eafe1b73d7",
                                                "sense_id": "d572fe4a-1f7a-3cc3-97ef-8cc5c818bfbc",
                                                "text": "Sollen wir die Winde zu einem geräumigen Zimmer ausbauen?"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            },
