                    }
                ],
                "translations": [
                    {
                        "translation_id": "cb385778-2a76-4a53-b687-88c7f6297579",
                        "source_entry_id": "8d59cf36-7f96-34c8-aa6e-b49c89dc2e92",
                        "source_sense_id": "68ed5ef4-d26f-3615-96f5-a6bba23b2deb",
                        "source_sense_description": "Aktionär, Anteilseigner, Aktieninhaber",
                        "target_lang_word": "Aktionär",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Aktionär",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "41ff5a56-278f-3570-88ee-b3679662b07c",
                                        "entry_id": "93f4c9ec-36e5-3a48-aac9-f81c0835f31b",
                                        "glosses": [
                                            "Inhaber von Aktien, und damit Miteigentümer einer Aktiengesellschaft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04fb28b9-e8d0-4780-80e8-d4008897511b",
                                                "sense_id": "41ff5a56-278f-3570-88ee-b3679662b07c",
                                                "text": "Nach § 53a des deutschen Aktiengesetzes sind Aktionäre unter gleichen Voraussetzungen gleich zu behandeln."
                                            },
                                            {
                                                "example_id": "a3850fcb-aed5-4882-a1c1-eadadffd5216",
                                                "sense_id": "41ff5a56-278f-3570-88ee-b3679662b07c",
                                                "text": "„Der Aktionär hat zweierlei wichtige Rechte: er ist der, wo das Geld gibt, und er darf bei der Generalversammlung in die Opposition gehen und etwas zu Protokoll geben, woraus sich der Vorstand einen sog. Sonnabend macht.“"
                                            },
                                            {
                                                "example_id": "5e3ad21c-7608-4f03-829e-603136c9a592",
                                                "sense_id": "41ff5a56-278f-3570-88ee-b3679662b07c",
                                                "text": "„Als sie in See stach, waren alle vierzehn Aktionäre mit an Bord.“"
                                            },
                                            {
                                                "example_id": "9f38ff11-0759-4875-9169-4c6619940a48",
                                                "sense_id": "41ff5a56-278f-3570-88ee-b3679662b07c",
                                                "text": "„Francis Baring, dessen 1762 in London gegründete Bank im Jahr 1995 spektakulär pleiteging, fungierte bereits um 1750 als Aktionär der Company of Merchants Trading to Africa und profitierte vom Sklavenhandel.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0e9fece3-892b-4b0e-a330-39622bab3914",
                        "source_entry_id": "8d59cf36-7f96-34c8-aa6e-b49c89dc2e92",
                        "source_sense_id": "68ed5ef4-d26f-3615-96f5-a6bba23b2deb",
                        "source_sense_description": "Aktionär, Anteilseigner, Aktieninhaber",
                        "target_lang_word": "Anteilseigner",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Anteilseigner",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "02f86b59-7ba5-369f-81a8-b711af1435e3",
                                        "entry_id": "26a7a673-faa7-3acb-96b4-8f9a148841b6",
                                        "glosses": [
                                            "jemand, der einen Anteil von etwas besitzt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "26142858-ffd5-4ec3-a443-c027ef4038af",
                                                "sense_id": "02f86b59-7ba5-369f-81a8-b711af1435e3",
                                                "text": "„Doch ohne die Unterstützung anderer großer Anteilseigner wird die Beratungsgesellschaft, die nur 0,5 Prozent des Aktienkapitals der Bank vertritt, lediglich ein Signal setzen können.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5b5a44cf-5e1f-4b4d-b87c-76b0560c37b1",
                        "source_entry_id": "8d59cf36-7f96-34c8-aa6e-b49c89dc2e92",
                        "source_sense_id": "68ed5ef4-d26f-3615-96f5-a6bba23b2deb",
                        "source_sense_description": "Aktionär, Anteilseigner, Aktieninhaber",
                        "target_lang_word": "Aktieninhaber",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Aktieninhaber",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "40b354a4-bc2a-3131-89a6-248946582808",
                                        "entry_id": "7627e04a-0b61-350f-a848-b478e06c1d55",
                                        "glosses": [
                                            "jemand, der Aktien besitzt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e4be6d05-84c6-430d-b947-98016b922082",
                                                "sense_id": "40b354a4-bc2a-3131-89a6-248946582808",
                                                "text": "Alle Aktieninhaber sind zur Teilnahme an der Hauptversammlung berechtigt."
                                            },
                                            {
                                                "example_id": "37c9af31-9daf-4278-b9fd-bd4736823b61",
                                                "sense_id": "40b354a4-bc2a-3131-89a6-248946582808",
                                                "text": "„Als größter Aktieninhaber von PayPal profitierte Musk aber sehr davon, dass das Unternehmen für 1,5 Milliarden an eBay verkauft wurde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
