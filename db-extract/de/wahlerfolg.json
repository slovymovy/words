                "senses": [
                    {
                        "sense_id": "5c49d22c-f9a6-397e-bd9b-6fc73922b321",
                        "entry_id": "f65f779d-c649-39f4-8ddd-9f227511d7a1",
                        "glosses": [
                            "Erfolg bei einer Wahl"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6b3f918b-2b57-43a8-854e-5f6331f1e342",
                                "sense_id": "5c49d22c-f9a6-397e-bd9b-6fc73922b321",
                                "text": "Der große Wahlerfolg der noch jungen Partei hat alle überrascht."
                            },
                            {
                                "example_id": "d85191d2-c1a7-48a4-a4c9-dc004323a29f",
                                "sense_id": "5c49d22c-f9a6-397e-bd9b-6fc73922b321",
                                "text": "„Den großen Wahlerfolg im Rücken, sollte jetzt die Republik sturmreif geschossen werden.“"
                            },
                            {
                                "example_id": "82bcef30-cf78-4aae-822c-96bacf4e6936",
                                "sense_id": "5c49d22c-f9a6-397e-bd9b-6fc73922b321",
                                "text": "„Nehru wollte durch den Wahlerfolg beweisen, dass der Kongress und nicht die Briten das Mandat der Inder hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
