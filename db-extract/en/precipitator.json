                "senses": [
                    {
                        "sense_id": "547bf961-a31e-36b8-aa6b-0e8e506aa4ec",
                        "entry_id": "b09c2c97-34c2-3d89-9a09-34446dd480d1",
                        "glosses": [
                            "One who or that which precipitates (causes something to happen or urges it on with vehemence or rashness)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a15d696-78a5-4b18-80cc-2caf52505fb0",
                                "sense_id": "547bf961-a31e-36b8-aa6b-0e8e506aa4ec",
                                "text": "[…] those of that sect […] that call’d themselves by that name of Zealots, and withal, took upon them to be the saviours and preservers of the City, but as it prov’d, the hastners & precipitators of the destruction of that Kingdom […]"
                            },
                            {
                                "example_id": "8781bdf6-829c-4ecd-a60c-1b5e9d725132",
                                "sense_id": "547bf961-a31e-36b8-aa6b-0e8e506aa4ec",
                                "text": "Even the most wanton precipitators of war always try to give it, in the eyes of the common people, a defensive character."
                            },
                            {
                                "example_id": "babc9732-f6a8-49fb-aabe-8a9c49b58fbb",
                                "sense_id": "547bf961-a31e-36b8-aa6b-0e8e506aa4ec",
                                "text": "Wherever one looks the rate of change on the international scene has achieved dizzying proportions, often with ominous overtones for United States interests. What is frequently overlooked, however, is that American behavior may be one of the greatest precipitators of this growing instability."
                            },
                            {
                                "example_id": "f6bc563a-25bb-46ba-ba4a-365d14c602e1",
                                "sense_id": "547bf961-a31e-36b8-aa6b-0e8e506aa4ec",
                                "text": "[…] the most common precipitator of workplace violence is a layoff or firing."
                            }
                        ]
                    },
                    {
                        "sense_id": "c68fab32-d7de-3a33-92e6-b84d65eee8ed",
                        "entry_id": "b09c2c97-34c2-3d89-9a09-34446dd480d1",
                        "glosses": [
                            "A person who, or device that, carries out precipitation."
                        ],
