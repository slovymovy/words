                                "target_senses": [
                                    {
                                        "sense_id": "ef5abc4b-1615-3ef1-88ad-e6ae3afab441",
                                        "entry_id": "999fd0cb-bfaf-3d4d-aa1f-8d1c49ae4219",
                                        "glosses": [
                                            "Sammlung von Musterbriefen, als Anleitung zum Briefe schreiben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a8e08d53-f772-403e-b852-008af711740c",
                                                "sense_id": "ef5abc4b-1615-3ef1-88ad-e6ae3afab441",
                                                "text": "„Briefsteller gibt es seit dem 15. Jahrhundert; ihr Inhalt und ihre Form ändern sich mit der sich ändernden gesellschaftlichen Bedeutung des Briefs.“"
                                            },
                                            {
                                                "example_id": "7b2adae6-e4b9-4198-8e1c-f23daa1b5c0e",
                                                "sense_id": "ef5abc4b-1615-3ef1-88ad-e6ae3afab441",
                                                "text": "„Sie folgt der Diktion längst vergangener Zeiten und scheint einem alten jüdischen Briefsteller entnommen zu sein.“"
                                            },
                                            {
                                                "example_id": "9f90c749-0c0f-4b7f-a782-cdbb0621433c",
                                                "sense_id": "ef5abc4b-1615-3ef1-88ad-e6ae3afab441",
                                                "text": "„Den Wert, der auf die korrekte Form gelegt wurde, illustrieren überlieferte Briefsteller mit Musterbriefen für private und geschäftliche Korrespondenz.“"
                                            }
                                        ],
