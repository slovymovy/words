                "senses": [
                    {
                        "sense_id": "99322df0-51f2-3220-a31e-3dce1ff8e36f",
                        "entry_id": "830e56f3-91e7-34d2-bdfd-c6f65841819e",
                        "glosses": [
                            "To part, separate."
                        ],
                        "tags": [
                            "archaic",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "86da03bc-99d5-47cd-bd68-1318f8523b53",
                                "sense_id": "99322df0-51f2-3220-a31e-3dce1ff8e36f",
                                "text": "[…] that same mighty man of God, / That bloud-red billowes like a walled front / On either side disparted with his rod […]"
                            },
                            {
                                "example_id": "db706209-6887-4e22-9b59-b42fed4381a9",
                                "sense_id": "99322df0-51f2-3220-a31e-3dce1ff8e36f",
                                "text": "[…] tenderly unfringe / Your long and lustrous lashes; cluster down / The mantling glory of deep fragrant hair, / Disparted from each forehead, myrtle-wreath'd, […]"
                            },
                            {
                                "example_id": "50f89b4a-367a-484e-96e7-c78e04fcb7c8",
                                "sense_id": "99322df0-51f2-3220-a31e-3dce1ff8e36f",
                                "text": "The world will be whole, and refuses to be disparted."
                            }
                        ]
                    },
                    {
                        "sense_id": "1eecffd8-4f92-3ccc-94be-344168e6e80d",
                        "entry_id": "830e56f3-91e7-34d2-bdfd-c6f65841819e",
                        "glosses": [
                            "To divide, divide up, distribute."
                        ],
                        "tags": [
                            "intransitive",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "6e827857-1f8c-4eb0-86f1-d946c4ab0781",
                                "sense_id": "1eecffd8-4f92-3ccc-94be-344168e6e80d",
                                "text": "Them in twelue troupes their Captain did dispart / And round about in fittest steades did place […]"
                            }
                        ]
                    }
