                        "glosses": [
                            "Débarrasser de l’influence du Diable, exorciser."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94805ac7-ede1-42c2-bf4e-77ee4ed7164a",
                                "sense_id": "721a9bb5-778d-3fc9-ad10-654ae62e1586",
                                "text": "Mignon l’a fait venir pour s'en faire assister dans une grave opération : il s’agit de désendiabler des religieuses."
                            },
                            {
                                "example_id": "307f74c4-4623-40f7-a5b2-078b60d27e96",
                                "sense_id": "721a9bb5-778d-3fc9-ad10-654ae62e1586",
                                "text": "Ils conviennent que le père Fantôme arriverait le surlendemain, et qu’il serait payé rectum pour son voyage et pour sa peine, et double prix s’il arrivait à désendiabler la maison."
                            },
                            {
                                "example_id": "eff1279e-36e0-4d96-80cd-be92a3e73222",
                                "sense_id": "721a9bb5-778d-3fc9-ad10-654ae62e1586",
                                "text": "Nos écuyers de la place avaient pensé depuis longtemps déjà à donner une représentation en plein jour, c’était peut-être le moyen de se désendiabler, comme ils disent, de vaincre la mauvaise chance qui semble s’être acharnée après eux presque depuis leur arrivée."
                            }
                        ]
                    }
