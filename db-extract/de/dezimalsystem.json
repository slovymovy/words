                    },
                    {
                        "form_id": "c017a3c3-f66d-4b5d-98fc-510264697bd5",
                        "entry_id": "6a6e82d2-6a3e-34ce-aa70-a53848fb5e85",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "das Dezimalsystem"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "cb984cd4-a5d6-3370-8145-cdd19cca567b",
                        "entry_id": "6a6e82d2-6a3e-34ce-aa70-a53848fb5e85",
                        "glosses": [
                            "Stellenwertsystem zur Basis zehn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b26eeeeb-a109-4cc4-a5c2-296d38eabb41",
                                "sense_id": "cb984cd4-a5d6-3370-8145-cdd19cca567b",
                                "text": "Wir rechnen meist im Dezimalsystem."
                            },
                            {
                                "example_id": "2e4e2269-d4c6-4853-a964-de8f569ae784",
                                "sense_id": "cb984cd4-a5d6-3370-8145-cdd19cca567b",
                                "text": "„Er wandelte die ersten zwanzig Dezimalstellen von Pi in Binärziffern um, weil er glaubte, das Binärsystem sei für Thomas Gray weniger schädlich als das Dezimalsystem.“"
                            },
                            {
                                "example_id": "5d064f5d-48c0-4660-b766-e39abc5c30e9",
                                "sense_id": "cb984cd4-a5d6-3370-8145-cdd19cca567b",
                                "text": "„Da es nicht konsequent nach dem Dezimalsystem aufgebaut ist, bringt der Umgang mit ihm einen gewissen Rechenaufwand mit sich.“"
                            },
                            {
                                "example_id": "08a1386e-a91e-4595-a38c-564d5a590399",
                                "sense_id": "cb984cd4-a5d6-3370-8145-cdd19cca567b",
                                "text": "„In Indien wurde unsere Null erfunden, die zusammen mit den anderen neun Ziffern die Grundlage für das Dezimalsystem bildet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
