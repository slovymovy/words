                "translations": [
                    {
                        "translation_id": "1e96a8ec-a722-437f-93b5-c7659bc328bc",
                        "source_entry_id": "efd1f05b-dfc9-3356-8bd8-76375b9f805f",
                        "source_sense_id": "35a5a0cf-b750-3e38-a7b8-66d12879f5b5",
