                        ],
                        "examples": [
                            {
                                "example_id": "63ead548-9bb2-4a21-a355-1a112651cfd3",
                                "sense_id": "006517c7-e0ca-33cd-b8bd-2db24bdeb411",
                                "text": "Si tu fais ça, ton fils passera pour un suce-boules, la gronda mon père. C'est ça que tu cherches ?"
                            },
                            {
                                "example_id": "44d52d1b-973a-421d-bb17-2d095d6ae397",
                                "sense_id": "006517c7-e0ca-33cd-b8bd-2db24bdeb411",
                                "text": "Et là, on voit clairement les types qui font les suce-boules. Il n'y a pas d'autre mot."
                            },
                            {
                                "example_id": "9b2693c7-0100-412f-beee-c17da441b3ec",
                                "sense_id": "006517c7-e0ca-33cd-b8bd-2db24bdeb411",
                                "text": "Merci de n'avoir pas hésité à me traiter de « suce-boules » quand j'étais trop gentille et de « castratrice » quand j'étais trop dure."
                            }
                        ]
                    }
