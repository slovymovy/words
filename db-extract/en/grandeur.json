                    {
                        "translation_id": "fb430642-b256-45e1-b4d5-ddb3fc438057",
                        "source_entry_id": "b6f5140e-84f4-3518-ad89-dbb35bab470d",
                        "source_sense_description": "state of being grand or splendid; magnificence",
                        "target_lang_word": "великоле́пие",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "великоле́пие",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "77ce4f14-0266-3df5-af8f-92a39fe419b5",
                                        "entry_id": "9bd345ce-a8e1-3e45-9c61-92f10b830b72",
                                        "glosses": [
                                            "роскошь, богатое убранство, блестящая, пышная красота"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce629000-18b7-4936-9846-f4eee0ebccd1",
                                                "sense_id": "77ce4f14-0266-3df5-af8f-92a39fe419b5",
                                                "text": "Внутреннее великолепие дворца поражало всякого, кто туда ни входил: простолюдимов ослепляло золото, жемчуг и каменья, коих было более, нежели ортографических ошибок в наших новых писателях."
                                            },
                                            {
                                                "example_id": "3646b44f-e0de-43bb-a9b1-242dd01a8beb",
                                                "sense_id": "77ce4f14-0266-3df5-af8f-92a39fe419b5",
                                                "text": "Впрочем, и доселе образчики этих causeries от времени до времени появляются на сцене французских комедий в форме «proverbes», в которых девица Круазетт показывает свои наливные плечи и поражает великолепием туалетов."
                                            },
                                            {
                                                "example_id": "0f215425-d1d7-4c5b-adbd-189e311c493d",
                                                "sense_id": "77ce4f14-0266-3df5-af8f-92a39fe419b5",
                                                "text": "Вместо сияющего великолепием космоса небо планеты передавало лишь намёки на созвездия."
                                            },
                                            {
                                                "example_id": "fbdf6015-dabc-4217-a15b-e081ed81c528",
                                                "sense_id": "77ce4f14-0266-3df5-af8f-92a39fe419b5",
                                                "text": "Было совершенно ясно, что при таком великолепии в холодильнике грязь на кухне выглядит особенно неуместно."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "db0873c1-fe18-3bb8-a7a5-a8d484138a8e",
                                        "entry_id": "9bd345ce-a8e1-3e45-9c61-92f10b830b72",
                                        "glosses": [
                                            "перен. что-либо значительное, выдающееся по своим внутренним достоинствам (о душе, таланте)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "122f3c81-95e3-4c6f-b14b-76321e8c121b",
                                                "sense_id": "db0873c1-fe18-3bb8-a7a5-a8d484138a8e",
                                                "text": "Красота юношей — их сила, а великолепие стариков — седина."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
