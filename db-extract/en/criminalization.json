                                            {
                                                "example_id": "430d9750-4d2b-413b-82ae-33fc8b1eac34",
                                                "sense_id": "1a9bf8d3-b868-383a-901f-534b5980a958",
                                                "text": "La répression, la criminalisation et la marginalisation ont depuis longtemps prouvé leur inefficacité et leur non-rentabilité."
                                            },
                                            {
                                                "example_id": "3ffe70bd-ca4d-4bea-884f-26feb45735fe",
                                                "sense_id": "1a9bf8d3-b868-383a-901f-534b5980a958",
                                                "text": "Par la criminalisation du chiffrement et de pratiques répandues de sécurité informatique, la police française vise à construire un récit selon lequel les sept personnes mises en examen vivraient « dans la clandestinité »."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
