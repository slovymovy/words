                                        "entry_id": "c7e700ee-b3f0-3646-a51a-402229858aad",
                                        "glosses": [
                                            "The remote-control device used to change settings on a television set, VCR, or other electronic equipment."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "72e7cd1c-d66f-44d3-bd43-4c5432537d4c",
                                                "sense_id": "70f7dd0d-ddb1-3e9a-8f8f-910c90966090",
                                                "text": "We have a clicker for the TV, one for the VCR, one for the DVD player and another one that does it all."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f97a62d1-9f43-3fdc-9839-bbb759d84c6e",
                                        "entry_id": "c7e700ee-b3f0-3646-a51a-402229858aad",
                                        "glosses": [
