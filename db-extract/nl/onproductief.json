                    {
                        "sense_id": "5c63de42-9131-3055-a1f2-8284184a544a",
                        "entry_id": "45a91f6b-f24b-33b1-b495-9c0ec251e5e1",
                        "glosses": [
                            "zonder nuttig effect; weinig opleverend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "96c94794-b8af-4a73-affb-7801f8d0a942",
                                "sense_id": "5c63de42-9131-3055-a1f2-8284184a544a",
                                "text": "De drie veroordeelde leden van Pussy Riot moeten vrij worden gelaten. Langere gevangenisstraf voor de bandleden zou 'onproductief' zijn. Dat zegt de Russische premier Dmitri Medvedev."
                            },
                            {
                                "example_id": "925c2d12-7164-4cc9-b68b-fa5beb907f05",
                                "sense_id": "5c63de42-9131-3055-a1f2-8284184a544a",
                                "text": "Het Constitution Project bestaat uit voormalige hoge regeringsofficials die besloten om dit onderzoek uit te voeren nadat Obama in 2009 aankondigde dat zijn regering dat niet zou gaan doen. Het zou 'onproductief' zijn om 'terug te blikken in plaats van vooruit te kijken', luidde destijds het argument van de toen net aantreden president."
                            },
                            {
                                "example_id": "a5097cd6-a604-4dd7-90a6-e5743a1f6f49",
                                "sense_id": "5c63de42-9131-3055-a1f2-8284184a544a",
                                "text": "President Trump heeft niets bereikt in zijn eerste jaar, is onproductief, kent geen discipline en heeft een vorm van ADD. Dat stelde politiek verslaggever Ryan Lizza van The New Yorker en CNN zondag in de bomvolle Balie."
                            }
                        ]
                    }
