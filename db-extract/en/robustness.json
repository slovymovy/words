                        ],
                        "form": "robustnesses"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "dfb070f9-08a4-31c7-b677-fcfd37426766",
                        "entry_id": "62260745-dd86-3b46-a46a-373b36b7e8e2",
                        "glosses": [
                            "The quality of being robust."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "a5b75165-7a18-409b-b0b4-5e32c5846dba",
                                "sense_id": "dfb070f9-08a4-31c7-b677-fcfd37426766",
                                "text": "Robustness was considered to be an essential feature because of the comparatively high starting effort and the generally rough work for which the locomotives are to be used."
                            },
                            {
                                "example_id": "8bd3cd99-5bae-4b06-a79e-602b1e07f692",
                                "sense_id": "dfb070f9-08a4-31c7-b677-fcfd37426766",
                                "text": "The Inspecting Officer draws attention to the remarkable way in which the train held together after the final derailment; this was due in no small measure to the robustness of the buckeye couplings fitted to the coaches."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a9e2438d-49a7-41ff-8622-fdc4f6d33887",
                        "source_entry_id": "62260745-dd86-3b46-a46a-373b36b7e8e2",
                        "source_sense_id": "dfb070f9-08a4-31c7-b677-fcfd37426766",
                        "source_sense_description": "quality of being robust",
                        "target_lang_word": "robuustheid",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "96c3fcaa-a5c1-4841-9712-e3ddb14bc1a2",
                        "source_entry_id": "62260745-dd86-3b46-a46a-373b36b7e8e2",
                        "source_sense_id": "dfb070f9-08a4-31c7-b677-fcfd37426766",
                        "source_sense_description": "quality of being robust",
                        "target_lang_word": "robustesse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "robustesse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7ea41259-52df-318b-aa3d-78d35c15e437",
                                        "entry_id": "c085716a-4dd0-3b6c-af8d-7762ce66a582",
                                        "glosses": [
                                            "Force, vigueur, en parlant d'une personne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "25b7ca66-3bf5-40b4-8533-3b1133fda6a0",
                                                "sense_id": "7ea41259-52df-318b-aa3d-78d35c15e437",
                                                "text": "Sa robustesse a triomphé de la maladie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2f7fce02-799f-3662-850f-518b6a090b6e",
                                        "entry_id": "c085716a-4dd0-3b6c-af8d-7762ce66a582",
                                        "glosses": [
                                            "Solidité, en parlant d’une chose."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e51c7e8e-4bbd-42bc-87ea-d9eb3c857703",
                                                "sense_id": "2f7fce02-799f-3662-850f-518b6a090b6e",
                                                "text": "Des graines apportées par le vent avaient germé au hasard et se développaient avec cette robustesse vivace, particulière aux mauvaises herbes, à la place qu’avaient occupée les jolies fleurs et les plantes rares."
                                            },
                                            {
                                                "example_id": "348081b5-fab5-4e3c-8141-36d901e1982c",
                                                "sense_id": "2f7fce02-799f-3662-850f-518b6a090b6e",
                                                "text": "Selon les promoteurs des piles nucléaires multi-usages, leur robustesse serait un gage de sécurité."
                                            },
                                            {
                                                "example_id": "ccc00ade-a2b4-45f1-8f0b-63fba60b191c",
                                                "sense_id": "2f7fce02-799f-3662-850f-518b6a090b6e",
                                                "text": "Ainsi, la robustesse du protocole RSA, utilisé dans les cartes bancaires, vient du fait qu’il est facile de multiplier des nombres premiers entre eux mais qu’il est difficile de faire l’opération inverse : trouver les deux nombres connaissant leur produit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d4054c05-32b8-3eec-8b36-f728c37c8bbb",
                                        "entry_id": "c085716a-4dd0-3b6c-af8d-7762ce66a582",
                                        "glosses": [
                                            "Capacité d’un programme informatique à fonctionner dans des conditions non nominales, comme les erreurs de saisie, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12b6c4fe-c9eb-4de1-9a3f-d79d28bc2027",
                                                "sense_id": "d4054c05-32b8-3eec-8b36-f728c37c8bbb",
                                                "text": "La robustesse du programme face aux retours de ligne en trop."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3fadcf49-f63e-35b4-b2b7-b46e50072aed",
                                        "entry_id": "c085716a-4dd0-3b6c-af8d-7762ce66a582",
                                        "glosses": [
                                            "Capacité d’une installation à assurer certaines de ses fonctions de sûreté lorsqu’elle est soumise à des sollicitations plus fortes que celles qui sont prises en compte dans son référentiel de sûreté."
                                        ],
                                        "tags": [
                                            "Nucléaire"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ae282552-2a3a-48cb-b0f7-7d66fef6bce4",
                        "source_entry_id": "62260745-dd86-3b46-a46a-373b36b7e8e2",
                        "source_sense_id": "dfb070f9-08a4-31c7-b677-fcfd37426766",
