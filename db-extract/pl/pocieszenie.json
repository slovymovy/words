                "senses": [
                    {
                        "sense_id": "27622348-4a57-35ea-b35a-d7ac2b7efbc3",
                        "entry_id": "d5e1fe3f-e3b8-3567-a7b5-7a9c959a14e3",
                        "glosses": [
                            "rzecz. odczas. od pocieszyć"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eff064cc-7163-4189-a2af-81d2a38dd6e9",
                                "sense_id": "27622348-4a57-35ea-b35a-d7ac2b7efbc3",
                                "text": "Nagle lekarstwem na to staje się mgła, / a po upale rosa spadająca – pocieszeniem."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "820f7ffb-1a73-4eeb-947a-e413c644aeb2",
                        "source_entry_id": "d5e1fe3f-e3b8-3567-a7b5-7a9c959a14e3",
                        "source_sense_id": "27622348-4a57-35ea-b35a-d7ac2b7efbc3",
                        "target_lang_word": "consolation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "consolation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "be8cde30-6c19-30a2-8dfe-58ab423dc847",
                                        "entry_id": "64fa8cb1-023a-3ab2-bcef-f78a7d8c3136",
                                        "glosses": [
                                            "The act or example of consoling; the condition of being consoled."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c8ee8e56-8be0-4630-a96a-f296501e9970",
                                                "sense_id": "be8cde30-6c19-30a2-8dfe-58ab423dc847",
                                                "text": "Moreouer the perfit beleue of this article, worketh in all true chriſten people, aloue to continue in this vnitie, and afeare to be caſte out of the ſame, and it worketh in them that be ſinners and repentant, great comforte, and conſolacion, to obteine remiſſion of ſinne, by vertue of Chriſtes paſſion, and adminiſtracion of his ſacramentes at the miniſters handes, ordained for that purpoſe, [...]"
                                            },
                                            {
                                                "example_id": "6a626259-b61a-413a-a677-6dbca180145d",
                                                "sense_id": "be8cde30-6c19-30a2-8dfe-58ab423dc847",
                                                "text": "[I]f Charles is undone, He'll find half his Acquaintance ruin'd too, and that, you know, is a consolation—"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "247bc27f-3c92-3c2e-9e4a-e53ca5204dbb",
                                        "entry_id": "64fa8cb1-023a-3ab2-bcef-f78a7d8c3136",
                                        "glosses": [
                                            "The prize or benefit for the loser."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "004717e8-a9ce-3e41-8b4b-2ce487743cbc",
                                        "entry_id": "64fa8cb1-023a-3ab2-bcef-f78a7d8c3136",
                                        "glosses": [
                                            "A consolation goal."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "75a4bf54-98d4-46b5-91fc-e2d3da534d6a",
                        "source_entry_id": "d5e1fe3f-e3b8-3567-a7b5-7a9c959a14e3",
                        "source_sense_id": "27622348-4a57-35ea-b35a-d7ac2b7efbc3",
                        "target_lang_word": "consolation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "consolation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fb5885d9-cc65-3494-8f35-33ff2a21c11c",
                                        "entry_id": "fceede8c-40e3-3660-9816-74bc9751f77e",
                                        "glosses": [
                                            "Soulagement donné à l’affliction, à la douleur, au déplaisir de quelqu’un."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f7e9069-497d-417a-a278-bf50568def5e",
                                                "sense_id": "fb5885d9-cc65-3494-8f35-33ff2a21c11c",
                                                "text": "Mais c’est une consolation de penser que nous laissons derrière nous, sur la terre, des êtres qui seront misérables comme nous-mêmes l’avons été."
                                            },
                                            {
                                                "example_id": "be4d15f4-a8ea-4a90-b18f-c3ba2c7df753",
                                                "sense_id": "fb5885d9-cc65-3494-8f35-33ff2a21c11c",
                                                "text": "Ne m'ont même pas laissé ça de consolation. Rien ! Sauf de pinter, bien sûr. Et même ça, ils ont d'abord essayé de me l'enlever."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ab2e08f3-b429-35b6-b1e4-f0c237743318",
                                        "entry_id": "fceede8c-40e3-3660-9816-74bc9751f77e",
                                        "glosses": [
                                            "Véritable sujet de satisfaction et de joie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee9e302c-856f-4a15-b8b7-b9cb3c184973",
                                                "sense_id": "ab2e08f3-b429-35b6-b1e4-f0c237743318",
                                                "text": "Je me suis juré à moi-même, à ma sœur et à ma mère, d’être la consolation, le bonheur et la gloire de mon père, […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "64552925-1774-31e9-b829-71d081aea7c8",
                                        "entry_id": "fceede8c-40e3-3660-9816-74bc9751f77e",
                                        "glosses": [
                                            "Discours ou raisons que l’on emploie pour consoler quelqu’un."
                                        ],
                                        "tags": [
                                            "Souvent au pluriel"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f00be31b-9492-4641-ba3e-c384a8965ee1",
                                                "sense_id": "64552925-1774-31e9-b829-71d081aea7c8",
                                                "text": "Elle n’écouta même pas les consolations de son père et de sa mère, elle goûta je ne sais quelle sauvage volupté à se laisser aller à ses souffrances d’âme."
                                            },
                                            {
                                                "example_id": "aac01ee4-aa76-4fd9-93ad-f1d6458ee88a",
                                                "sense_id": "64552925-1774-31e9-b829-71d081aea7c8",
                                                "text": "Sans écouter les consolations que son ami lui prodiguait sans y croire lui-même, le Cœur-Loyal enfonça les éperons dans le ventre de son cheval et s’élança dans les flots."
                                            },
                                            {
                                                "example_id": "41bd8d4a-9e21-4390-99d1-528bb9152058",
                                                "sense_id": "64552925-1774-31e9-b829-71d081aea7c8",
                                                "text": "Personne n’arrivait à placer un mot ni à proférer une consolation, toute la ville avait avalé sa langue dépassée par le triste sort du jeune homme."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8e30a800-ada2-30b2-b0c4-37756fd6c63b",
                                        "entry_id": "fceede8c-40e3-3660-9816-74bc9751f77e",
                                        "glosses": [
                                            "La chose ou de la personne même qui console."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0d8ea12-52cd-41d5-888d-cb8e9441bc00",
                                                "sense_id": "8e30a800-ada2-30b2-b0c4-37756fd6c63b",
                                                "text": "Il vivait comme vivent bien des Parisiens qui ont perdu leur femme étant jeunes, c'est-à-dire qu'il ne se privait pas de s'offrir des consolations, mais il avait toujours sauvegardé les apparences."
                                            },
                                            {
                                                "example_id": "4ac37fea-7fc8-4d1f-9c15-64326f552f13",
                                                "sense_id": "8e30a800-ada2-30b2-b0c4-37756fd6c63b",
                                                "text": "Il cachait sa harpe, sa seule consolation, dans un arbre creux. Mais, quand le jour était beau, il s’empressait de la prendre et harpait pour son plaisir."
                                            },
                                            {
                                                "example_id": "ae25df27-493b-4141-b094-6d0a8b5aaecc",
                                                "sense_id": "8e30a800-ada2-30b2-b0c4-37756fd6c63b",
                                                "text": "De tout temps, en effet, la fille, héroïne de tant de vieux romans, fut la protectrice, la compagne, la consolation du grec, du voleur, du tire-laine, du filou, de l’escroc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "557f28d1-a2a1-3974-ab6d-1c214946cff8",
                                        "entry_id": "fceede8c-40e3-3660-9816-74bc9751f77e",
                                        "glosses": [
                                            "Eau-de-vie."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "17b0576e-e33d-42e2-a9ec-a7911db93386",
                                                "sense_id": "557f28d1-a2a1-3974-ab6d-1c214946cff8",
                                                "text": "Nous eûmes une bonne rincette et une petite consolation. Pour finir, je me chargeai spécialement du brûlot."
                                            },
                                            {
                                                "example_id": "2db61693-c794-45ae-b78f-cee35a792dc8",
                                                "sense_id": "557f28d1-a2a1-3974-ab6d-1c214946cff8",
                                                "text": "Si j’ai pu me faire quelques idées et les aligner en rangs d’oignons, c’est que j’ai toujours gagné assez pour boire mon litre, et prendre mon café avec la consolation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
