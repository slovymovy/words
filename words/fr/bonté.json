                {
                    "sense_id": "bf2b4413-753e-3a04-a6d7-0f565602418e",
                    "sense_definition": "Qualité morale d'une personne qui est bienveillante, généreuse et attentive au bien d'autrui.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "bienveillance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tout le village apprécie sa grande <w>bonté</w> et son écoute sincère."
                        },
                        {
                            "text": "Elle a toujours fait preuve de <w>bonté</w> envers les personnes les plus démunies."
                        }
                    ],
                    "synonyms": [
                        "clémence",
                        "indulgence",
                        "tolérance"
                    ],
                    "antonyms": [
                        "méchanceté",
                        "cruauté",
                        "malveillance"
                    ],
                    "common_phrases": [
                        "faire preuve de bonté",
                        "bonté de cœur"
                    ]
                },
                {
                    "sense_id": "3430bb5d-9f5d-348c-b981-2273af0078ea",
                    "sense_definition": "Disposition bienveillante employée dans des formules de politesse ou de déférence pour demander un service.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Auriez-vous la <w>bonté</w> de m'indiquer le chemin de la gare ?"
                        },
                        {
                            "text": "Il a eu la <w>bonté</w> de répondre immédiatement à notre message."
                        }
                    ],
                    "common_phrases": [
                        "avoir la bonté de"
                    ]
                },
                {
                    "sense_id": "cf8bc0ed-06f6-3ac6-b03b-63196fee3e67",
                    "sense_definition": "Actes, faveurs ou marques de bienveillance accordés à quelqu'un, souvent employés au pluriel.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "bienveillance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous n'oublierons jamais vos nombreuses <w>bontés</w> à notre égard."
                        },
                        {
                            "text": "Le directeur a multiplié les <w>bontés</w> pour aider ce jeune employé."
                        }
                    ]
                },
                {
                    "sense_id": "4437028c-da09-346f-b303-e6cbfacbf73f",
                    "sense_definition": "Qualité de ce qui est bon, agréable au goût ou de valeur satisfaisante.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le chef cuisinier insiste toujours sur la <w>bonté</w> des produits du terroir."
                        },
                        {
                            "text": "Les artisans vantent la <w>bonté</w> et la solidité de ce bois."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Rarement employé aujourd'hui pour qualifier des choses concrètes ou des aliments."
