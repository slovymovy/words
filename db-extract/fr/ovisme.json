                ],
                "senses": [
                    {
                        "sense_id": "037ef4ec-5ff4-35dc-a073-238592ab23b9",
                        "entry_id": "0dd61578-e8e3-31d2-8987-b942792d8247",
                        "glosses": [
                            "Hypothèse physiologique dans laquelle on prétend que les parties essentielles du nouvel individu préexistent à la fécondation dans l'œuf ou ovule."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8a61937d-b77f-4316-b64e-cdf9adb0ffe1",
                                "sense_id": "037ef4ec-5ff4-35dc-a073-238592ab23b9",
                                "text": "Pour l’ovisme, l'embryon est préformé dans la femelle. Le sperme est inutile ou il apporte une aura seminalis, une essence vitale."
                            },
                            {
                                "example_id": "6c261995-f204-4e38-b692-8ad9a1e0591f",
                                "sense_id": "037ef4ec-5ff4-35dc-a073-238592ab23b9",
                                "text": "L’ovisme n'en est pas moins prouvé, puisqu’on trouve des œufs en nombre égal à celui des corps jaunes qui les produisent."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cab8675b-a747-426a-ae65-34ce3034490e",
                        "source_entry_id": "0dd61578-e8e3-31d2-8987-b942792d8247",
                        "source_sense_id": "037ef4ec-5ff4-35dc-a073-238592ab23b9",
                        "target_lang_word": "ovism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ovism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b715b38d-d0da-3eed-9362-d690f03c38e6",
                                        "entry_id": "0e48356f-e3db-3821-b6de-60a3a16f21de",
                                        "glosses": [
                                            "The belief that the ovum holds all material needed for the development of the embryo."
                                        ],
                                        "tags": [
                                            "historical",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cde48ef1-a5d5-4f5d-bc5d-99a7d23973c8",
                                                "sense_id": "b715b38d-d0da-3eed-9362-d690f03c38e6",
                                                "text": "Above all, ovism seems to us utterly impossible: how could every human being that ever existed or ever will exist be contained, fully formed, within Eve's ovaries?"
                                            },
                                            {
                                                "example_id": "31be2910-91b1-4756-a0e5-da38ebf94053",
                                                "sense_id": "b715b38d-d0da-3eed-9362-d690f03c38e6",
                                                "text": "ovulism"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
