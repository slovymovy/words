                "senses": [
                    {
                        "sense_id": "0a212fb8-3db3-3d11-a289-ab13d6d9b262",
                        "entry_id": "7f217a03-49dd-34b0-b974-16c574a9a757",
                        "glosses": [
                            "Mustervertrag (Vorlage) für eine Auftragsdatenverarbeitung"
                        ],
                        "tags": [
                            "Vertragsrecht"
                        ],
                        "examples": [
                            {
                                "example_id": "3ee65efc-568f-4a97-ba94-3e975845802a",
                                "sense_id": "0a212fb8-3db3-3d11-a289-ab13d6d9b262",
                                "text": "„Oder Sie lassen sich einen Vertrag von einem kompetenten Anwalt erstellen. Und das ist sicher die beste Wahl. Wenn Sie dazu jedoch nicht die Zeit haben oder die Kosten hierfür sparen möchten, dann können Sie zu einem Muster-Auftragsdatenverarbeitungsvertrag greifen.“"
                            },
                            {
                                "example_id": "505d6163-1025-4483-a72f-70637ae54382",
                                "sense_id": "0a212fb8-3db3-3d11-a289-ab13d6d9b262",
                                "text": "„b) Adv-Vertrag nicht trivial, daher erstellte eine Gruppe von Mitarbeitern der Verbände BvD, bvitg, GMDS und GDD einen kommentierten ‚Muster-Auftragsdatenverarbeitungsvertrag‘“"
                            },
                            {
                                "example_id": "42004655-7e07-4e85-807a-e7e4dd81bc28",
                                "sense_id": "0a212fb8-3db3-3d11-a289-ab13d6d9b262",
                                "text": "„Da dies nicht trivial ist, erstellt eine Gruppe von Mitarbeitern von BvD, bvitg, GMDS und GDD einen kommentierten ‚Muster-Auftragsdatenverarbeitungsvertrag‘, der Apotheken, Arztpraxen, Krankenhäuser und Herstellern die Erstellung eines ADV-Vertrages erleichtert.“"
                            },
                            {
                                "example_id": "36fcef21-0537-43a2-a2d8-86f34b444a3f",
                                "sense_id": "0a212fb8-3db3-3d11-a289-ab13d6d9b262",
                                "text": "„5. Hinweise zum Umgang mit dem Muster-Auftragsdatenverarbeitungsvertrag“"
                            },
                            {
                                "example_id": "35dc3be2-8b81-4fe7-811f-97ff4f7ab19e",
                                "sense_id": "0a212fb8-3db3-3d11-a289-ab13d6d9b262",
                                "text": "„Muster-Auftragsdatenverarbeitungsvertrag – Eine AG von bvitg, BvD, GDD und GMDS“"
                            },
                            {
                                "example_id": "1aebf1f8-4a24-48af-92a7-b208c3d28168",
                                "sense_id": "0a212fb8-3db3-3d11-a289-ab13d6d9b262",
                                "text": "Den Vertrag schloss die kleine Firma mit dem Cloud-Anbieter durch ausfüllen und einreichen eines der empfohlenen Muster-Auftragsdatenverarbeitungsverträge ab."
                            }
                        ],
