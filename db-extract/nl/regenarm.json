                        "examples": [
                            {
                                "example_id": "e23fff17-006a-4d8c-84e0-14776b3c67e8",
                                "sense_id": "6bd11414-6352-3616-a81e-e536b1f55b6d",
                                "text": "Het westen van de Verenigde Staten heeft een regenarme winter achter de rug, met weinig sneeuwval. Daardoor is het risico op bosbranden groot. Door de extreme droogte en de harde wind breidt het vuur zich gemakkelijk uit."
                            }
                        ]
                    }
