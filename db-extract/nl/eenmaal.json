                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a8305601-a33b-4b63-b4cf-afd880e85b1a",
                                                "sense_id": "9ce5c896-2bf3-34d6-ae05-47c2117afe56",
                                                "text": "Il faut pourtant que nous sachions une fois à quoi nous en tenir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fcd1b670-f153-3724-ab6d-8613013ef597",
                                        "entry_id": "fab16c0d-fe14-349c-b597-1367d43f176f",
                                        "glosses": [
                                            "À une certaine époque ; dans une certaine occasion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "35312714-ef4a-454b-8012-d1e988ee1278",
                                                "sense_id": "fcd1b670-f153-3724-ab6d-8613013ef597",
                                                "text": "Une fois, entre autres, il arriva que…"
                                            },
                                            {
                                                "example_id": "f75736f0-757c-4ee9-8731-8daa349bddfb",
                                                "sense_id": "fcd1b670-f153-3724-ab6d-8613013ef597",
                                                "text": "J’étais, une fois, à me promener, lorsque…"
                                            },
                                            {
                                                "example_id": "e9d03016-fb53-492a-a29d-7044b3f44603",
                                                "sense_id": "fcd1b670-f153-3724-ab6d-8613013ef597",
                                                "text": "Si une fois je parviens à le découvrir."
                                            },
                                            {
                                                "example_id": "a2353783-571f-40fb-92d3-9f63a502d8d1",
                                                "sense_id": "fcd1b670-f153-3724-ab6d-8613013ef597",
                                                "text": "Rien ne saurait l’empêcher de faire ce qu’il a une fois résolu."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "une fois",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "33b1c7ec-ef92-39dc-a8d3-c43eb4831978",
                                        "entry_id": "53360630-c59f-3b82-8839-920c0fc762fe",
                                        "glosses": [
                                            "Une fois que."
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "beb49a6e-e032-41ca-97ee-6a6ff2e6bec5",
                                                "sense_id": "33b1c7ec-ef92-39dc-a8d3-c43eb4831978",
                                                "text": "254 kilos. C’est la quantité d’ordures ménagères produite chaque année par un Français. Soit le poids de deux réfrigérateurs américains. Une fois collectées, les poubelles grises sont envoyées en décharge ou brûlées dans des incinérateurs."
                                            },
                                            {
                                                "example_id": "296765b5-def8-4112-84e3-82291a537c94",
                                                "sense_id": "33b1c7ec-ef92-39dc-a8d3-c43eb4831978",
                                                "text": "Une fois parti, je ne reviendrai plus. — Une fois en mouvement, il ne s’arrête plus."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
