                ],
                "senses": [
                    {
                        "sense_id": "4345aaf4-e6c5-3081-8463-74c0ccdde503",
                        "entry_id": "425ace2a-4cc2-318c-855c-70b705336433",
                        "glosses": [
                            "Enlever le collodion de."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a39e388c-bedc-4a0a-bac2-78e88cabc467",
                                "sense_id": "4345aaf4-e6c5-3081-8463-74c0ccdde503",
                                "text": "Il suffit de déballer le manchon avec quelque précaution et, après l’avoir mis en place, de le décollodionner au moyen du flambage, ce qui peut se faire par l’abonné sur le bec Auer même, qu’on ouvre graduellement."
                            },
                            {
                                "example_id": "71636e63-fd4c-4b7e-bfb2-ad9582099a33",
                                "sense_id": "4345aaf4-e6c5-3081-8463-74c0ccdde503",
                                "text": "Les préparations les plus instructives sont fournies par les coupes à la celloïdine imprégnées à l’argent, puis décollodionnées et montées au baume."
                            }
                        ]
                    }
                ],
