                "senses": [
                    {
                        "sense_id": "0ef3f973-2903-3dfa-9f28-b5421ab80d32",
                        "entry_id": "dd400b95-d0ef-304c-aa8d-0ea32af55a97",
                        "glosses": [
                            "Begriff der italienischen Renaissance: Haltung, die den Anschein der Leichtigkeit/Mühelosigkeit auch bei der Bewältigung schwieriger Probleme vorgibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ebdfac1-00e1-489e-b4b4-913b86bfa2fc",
                                "sense_id": "0ef3f973-2903-3dfa-9f28-b5421ab80d32",
                                "text": "„Zur Anmut gehören Beiläufigkeit, Ungekünsteltheit, Nonchalance, Sprezzatura; und wenn sie in Begleitung ihrer Schwester, der Demut, auftritt, ist sie unbesiegbar.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f77e463d-741f-46a4-866f-14774ae37567",
                        "source_entry_id": "dd400b95-d0ef-304c-aa8d-0ea32af55a97",
                        "source_sense_id": "0ef3f973-2903-3dfa-9f28-b5421ab80d32",
                        "target_lang_word": "insouciance",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "insouciance",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0536c22a-f64b-3c88-8a9f-eb5bc89874c7",
                                        "entry_id": "9e27902b-c5f9-3999-b60c-c9021cb20c78",
                                        "glosses": [
                                            "Carelessness, heedlessness, indifference, or casual unconcern."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7cdfb9e4-7b58-4c07-b1a0-d58dc78ef5e4",
                                                "sense_id": "0536c22a-f64b-3c88-8a9f-eb5bc89874c7",
                                                "text": "So Gelernter, with an insouciance he now regrets, also chose a Lovelace as a namesake—Linda, the lead actress in \"Deep Throat.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e431d892-59bd-3bb2-a1f3-d0dd957cfca7",
                                        "entry_id": "9e27902b-c5f9-3999-b60c-c9021cb20c78",
                                        "glosses": [
                                            "Nonchalance."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "497327c8-6cfa-4348-9124-280dff3c55d4",
                                                "sense_id": "e431d892-59bd-3bb2-a1f3-d0dd957cfca7",
                                                "text": "She almost felt insulted by [the wild boar's] insouciance as it rooted in her grove."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4adbab17-6676-4231-b49b-0f60ab12e098",
                        "source_entry_id": "dd400b95-d0ef-304c-aa8d-0ea32af55a97",
                        "source_sense_id": "0ef3f973-2903-3dfa-9f28-b5421ab80d32",
                        "target_lang_word": "sprezzatura",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sprezzatura",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2b7462c8-2f3d-398c-939e-cd9594b567a2",
                                        "entry_id": "5ec6c514-35b3-3506-9a1e-f1cd280ca4dc",
                                        "glosses": [
                                            "The art of performing a difficult task so gracefully that it looks effortless; calculated nonchalance."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5935eb3e-d833-476d-b2a9-55c61d1faa54",
                                                "sense_id": "2b7462c8-2f3d-398c-939e-cd9594b567a2",
                                                "text": "[…] I have found quite a universal rule which in this matter seems to me valid above all others, and in all human affairs whether in word or deed: and that is to avoid affectation in every way possible as though it were some very rough and dangerous reef; and (to pronounce a new word perhaps) to practice in all things a certain sprezzatura [nonchalance]^([sic]), so as to conceal all art and make whatever is done or said appear to be without effort and almost without any thought about it."
                                            },
                                            {
                                                "example_id": "3c377f97-359f-42cd-8346-849376193e1f",
                                                "sense_id": "2b7462c8-2f3d-398c-939e-cd9594b567a2",
                                                "text": "Cassandra Wilson's music is the essence of sprezzatura, or calculated nonchalance, that special attitude described nearly 500 years ago by Baldassare Castiglione in “The Courtier,” his primer on how to ingratiate yourself with the aristocracy."
                                            },
                                            {
                                                "example_id": "7737b25d-e43c-4093-9a11-97c2ef890c5d",
                                                "sense_id": "2b7462c8-2f3d-398c-939e-cd9594b567a2",
                                                "text": "Mr. Mork played with soulful intensity (and impeccable intonation), and the interplay between him and Mr. Repin, with nicely coordinated gestures and phrasings, was enjoyable to watch. But Mr. Repin’s technical struggles were all too evident — the very opposite of sprezzatura."
                                            },
                                            {
                                                "example_id": "49dd72c0-8bee-4c4d-85c5-d9c1b84f4a50",
                                                "sense_id": "2b7462c8-2f3d-398c-939e-cd9594b567a2",
                                                "text": "In men's fashion the ultimate style move is sprezzatura, embracing intentional errors such as undone buttons and misaligned neckties. Gianni Agnelli, the head of Fiat, wore watches over his shirtsleeves."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bdc85790-5d9c-4a20-8b45-c5e03c6c849e",
                        "source_entry_id": "dd400b95-d0ef-304c-aa8d-0ea32af55a97",
                        "source_sense_id": "0ef3f973-2903-3dfa-9f28-b5421ab80d32",
                        "target_lang_word": "insouciance",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "insouciance",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "414b2b5c-e1a3-3546-8046-f0a3dd9e56e6",
                                        "entry_id": "a8909b6e-97ec-3b61-831a-58d762dc32b1",
                                        "glosses": [
                                            "État ou caractère de celui qui est insouciant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f0b89cc6-c0cd-4dd1-8adf-f6a772ea7c91",
                                                "sense_id": "414b2b5c-e1a3-3546-8046-f0a3dd9e56e6",
                                                "text": "Rien ne pouvait être entrepris sous la domination incontestée de Richard, […], quoiqu’il tînt les rênes du gouvernement avec une sorte d’insouciance qui tendait tantôt à l’indulgence et tantôt au despotisme."
                                            },
                                            {
                                                "example_id": "f34b06aa-e503-4983-a437-e741503988ea",
                                                "sense_id": "414b2b5c-e1a3-3546-8046-f0a3dd9e56e6",
                                                "text": "Solange, jusqu’alors, avait toujours pris les événements de sa vie avec une certaine insouciance."
                                            },
                                            {
                                                "example_id": "d45a7be3-762d-4be0-bff9-68a3013cfc80",
                                                "sense_id": "414b2b5c-e1a3-3546-8046-f0a3dd9e56e6",
                                                "text": "On leur dénie l’un des droits les plus fondamentaux de l’enfance : le droit à l’insouciance."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
