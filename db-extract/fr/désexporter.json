                ],
                "senses": [
                    {
                        "sense_id": "8f865cb6-2e25-3ee8-b87b-f464f04aa163",
                        "entry_id": "e92a6ed0-6f7f-3660-92d3-3d9a98906e51",
                        "glosses": [
                            "Cesser d’exporter."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0600ecb0-7d76-4e75-b25a-d9063f7373c7",
                                "sense_id": "8f865cb6-2e25-3ee8-b87b-f464f04aa163",
                                "text": "L'opération deallocate permet de déverrouiller et de ”désexporter” les ressources qui ne sont plus requises par les clients NIM."
                            },
                            {
                                "example_id": "a636dead-1fa8-406a-822a-f5b561e1e2e0",
                                "sense_id": "8f865cb6-2e25-3ee8-b87b-f464f04aa163",
                                "text": "Lorsqu'elle est exécutée manuellement, la commande /usr/sbin/exportfs permet au super-utilisateur d'exporter ou de désexporter sélectivement des répertoires sans redémarrer le service NFS."
                            },
                            {
                                "example_id": "92123285-c3cf-497c-badc-3a5fb27df2a4",
                                "sense_id": "8f865cb6-2e25-3ee8-b87b-f464f04aa163",
                                "text": "Pour libérer la broche, nous devons effectuer l'opération inverse, c'est-à-dire lui attribuer une valeur logique faible et la désexporter."
                            }
                        ]
                    }
                ],
