{
    "word_family": [
        "пустить",
        "пускать",
        "пускай"
    ],
    "entries": [
        {
            "pos": "article",
            "senses": [
                {
                    "sense_id": "c76109a6-af6d-3fe0-bfe2-7f6b6488fa08",
                    "sense_definition": "Служит для образования формы повелительного наклонения 3-го лица; выражает побуждение, пожелание или приказ.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "imperative",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Пусть</w> он позвонит мне завтра утром.",
                            "target_lang_translations": {
                                "en": "<w>Let</w> him call me tomorrow morning.",
                                "zh": "<w>让</w>他明天早上给我打电话。"
                            }
                        },
                        {
                            "text": "<w>Пусть</w> дети играют во дворе, пока на улице тепло.",
                            "target_lang_translations": {
                                "en": "<w>Let</w> the children play in the yard while it is warm outside.",
                                "zh": "趁外面暖和，<w>让</w>孩子们在院子里玩吧。"
                            }
                        }
                    ],
                    "synonyms": [
                        "пускай",
                        "да"
                    ],
                    "common_phrases": [
                        "пусть говорят",
                        "пусть будет"
                    ],
                    "target_lang_definitions": {
                        "en": "Used to form the third-person imperative; expresses a command, wish, or suggestion.",
                        "zh": "用于构成第三人称祈使句，表示命令、愿望或建议。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "let",
                                "target_lang_sense_clarification": "auxiliary for third-person imperative"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "让",
                                "target_lang_sense_clarification": "用于第三人称祈使句的助词"
                            },
                            {
                                "target_lang_word": "愿",
                                "target_lang_sense_clarification": "表示祝愿或希望"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b87ff55f-cda9-3ae5-b3d1-5d8cdba6ec2f",
                    "sense_definition": "Выражает согласие, разрешение или вынужденное примирение с ситуацией.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "agreement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Хорошо, <w>пусть</w> будет по-твоему!",
                            "target_lang_translations": {
                                "en": "Fine, <w>let</w> it be your way!",
                                "zh": "好吧，<w>随</w>你的便吧！"
                            }
                        },
                        {
                            "text": "Если он хочет уйти, ну и <w>пусть</w> идёт.",
                            "target_lang_translations": {
                                "en": "If he wants to leave, well, <w>let</w> him go.",
                                "zh": "如果他想走，那就<w>由</w>他去吧。"
                            }
                        }
                    ],
                    "synonyms": [
                        "пускай",
                        "ладно"
                    ],
                    "common_phrases": [
                        "ну и пусть",
                        "пусть так"
                    ],
                    "target_lang_definitions": {
                        "en": "Expresses agreement, permission, or forced acceptance of a situation.",
                        "zh": "表示同意、许可或被迫接受某种情况。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "let",
                                "target_lang_sense_clarification": "expressing permission or resignation"
                            },
                            {
                                "target_lang_word": "so be it",
                                "target_lang_sense_clarification": "phrase expressing acceptance"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "随",
                                "target_lang_sense_clarification": "表示听之任之或随他去"
                            },
                            {
                                "target_lang_word": "由",
                                "target_lang_sense_clarification": "表示听任某人或某事"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "834a0a8b-f5d3-3d38-a7c2-dbb187f146d6",
                    "sense_definition": "Используется для введения предположения или условия, часто в математических или логических задачах.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "assumption",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Пусть</w> икс будет равен десяти.",
                            "target_lang_translations": {
                                "en": "<w>Let</w> x equal ten.",
                                "zh": "<w>设</w>x等于十。"
                            }
                        },
                        {
                            "text": "<w>Пусть</w> мы опоздаем, но зато увидим красивый закат.",
                            "target_lang_translations": {
                                "en": "<w>Suppose</w> we are late, at least we will see a beautiful sunset.",
                                "zh": "<w>即使</w>我们会迟到，但至少能看到美丽的日落。"
                            }
                        }
                    ],
                    "synonyms": [
                        "пускай"
                    ],
                    "target_lang_definitions": {
                        "en": "Used to introduce an assumption or condition, often in mathematics or logic.",
                        "zh": "用于引入假设或条件，常用于数学或逻辑问题中。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "let",
                                "target_lang_sense_clarification": "mathematical or logical assumption"
                            },
                            {
                                "target_lang_word": "suppose",
                                "target_lang_sense_clarification": "introducing a hypothesis"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "设",
                                "target_lang_sense_clarification": "数学或逻辑中的假设"
                            },
                            {
                                "target_lang_word": "假设",
                                "target_lang_sense_clarification": "引入一个假设条件"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "conjunction",
            "senses": [
                {
                    "sense_id": "e832ecea-f276-396a-b510-8c40a7adff66",
                    "sense_definition": "Указывает на уступку; соответствует по значению словам «хотя», «несмотря на то что».",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "concessive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Это был полезный опыт, <w>пусть</w> и очень трудный.",
                            "target_lang_translations": {
                                "en": "It was a useful experience, <w>even if</w> very difficult.",
                                "zh": "这是一次有益的经历，<w>尽管</w>非常困难。"
                            }
                        },
                        {
                            "text": "Мы решили ехать на дачу, <w>пусть</w> даже погода испортится.",
                            "target_lang_translations": {
                                "en": "We decided to go to the dacha, <w>even if</w> the weather turns bad.",
                                "zh": "我们决定去乡间别墅，<w>即使</w>天气变坏也要去。"
                            }
                        }
                    ],
                    "synonyms": [
                        "хотя",
                        "несмотря на",
                        "хотя́ бы и",
                        "пускай"
                    ],
                    "common_phrases": [
                        "пусть и",
                        "пусть даже"
                    ],
                    "target_lang_definitions": {
                        "en": "Indicates a concession; corresponds in meaning to \"although\" or \"even if\".",
                        "zh": "表示让步，相当于“虽然”、“尽管”。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "even if",
                                "target_lang_sense_clarification": "concessive conjunction"
                            },
                            {
                                "target_lang_word": "though",
                                "target_lang_sense_clarification": "concessive conjunction"
                            },
                            {
                                "target_lang_word": "although",
                                "target_lang_sense_clarification": "concessive conjunction"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "即使",
                                "target_lang_sense_clarification": "表示让步的连词"
                            },
                            {
                                "target_lang_word": "尽管",
                                "target_lang_sense_clarification": "表示让步的连词"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}