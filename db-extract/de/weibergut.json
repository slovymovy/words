                "senses": [
                    {
                        "sense_id": "2c60c939-d053-375c-a536-1879e8f56833",
                        "entry_id": "d66f0cbb-c112-3293-b6d6-56abe95ff9a4",
                        "glosses": [
                            "Vermögen, in Form von Geld, Gütern oder Hausrat, das Eltern ihrer Tochter bei der zukünftigen Heirat mitgeben"
                        ],
                        "tags": [
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "2cfca32b-e780-43c0-98d4-bc8310470ef7",
                                "sense_id": "2c60c939-d053-375c-a536-1879e8f56833",
                                "text": "„Dann schildert er beredt und kundig den Luxus, welchen Mitgiftjäger mit erheiratetem Weibergut treiben.“"
                            },
                            {
                                "example_id": "292a6f77-91a7-4142-a475-19ebd9a059bf",
                                "sense_id": "2c60c939-d053-375c-a536-1879e8f56833",
                                "text": "„Denn die Aufzählung aller dieser Herrlichkeiten und Verrichtungen, die mit einem Weibergute verbunden sind, hatte dem dürren Hexenmeister den Mund nur noch wässeriger gemacht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
