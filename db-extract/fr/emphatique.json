        "fr-extract.jsonl": [
            {
                "entry_id": "d6e68e13-470f-3d1d-a5f0-0e32a73e1022",
                "word": "emphatique",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "70573178-e99c-42d0-97ff-23e4debc1214",
                        "entry_id": "d6e68e13-470f-3d1d-a5f0-0e32a73e1022",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "emphatiques"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6329735c-aaf1-3852-9c5e-b2b5026dd139",
                        "entry_id": "d6e68e13-470f-3d1d-a5f0-0e32a73e1022",
                        "glosses": [
                            "Qualifie ce qui donne de l’emphase, ce qui exaspère l’expression d’un sentiment, d’une idée dans l’expression écrite ou orale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ece1e90e-f006-4ac9-bcdb-b8f71565d56d",
                                "sense_id": "6329735c-aaf1-3852-9c5e-b2b5026dd139",
                                "text": "La foire est gaie d’une gaieté forcée, l’orchestre des manèges pousse des sonorités emphatiques, propres à exalter la foule, mais elle passe, veule."
                            }
                        ]
                    },
                    {
                        "sense_id": "759b1f9b-717a-3b92-b93f-370085c1846f",
                        "entry_id": "d6e68e13-470f-3d1d-a5f0-0e32a73e1022",
                        "glosses": [
                            "Qualifie ce qui est enflé et ampoulé dans l’expression écrite ou orale."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "6020b4fa-68a4-4c85-bda0-11858d4e9d48",
                                "sense_id": "759b1f9b-717a-3b92-b93f-370085c1846f",
                                "text": "Et puis, monsieur Rodolphe, l’expression de sa reconnaissance pour vous n’a rien d’exagéré, d’emphatique ; elle n’en est que plus sincère."
                            }
                        ]
                    },
                    {
                        "sense_id": "800095f8-fe58-3c8e-9bff-0e7b6594c5f4",
                        "entry_id": "d6e68e13-470f-3d1d-a5f0-0e32a73e1022",
                        "glosses": [
                            "Qualifie un discours prononcé avec exagération prétentieuse."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "60f91c78-20d6-4479-a3bb-69a1f98c7152",
                                "sense_id": "800095f8-fe58-3c8e-9bff-0e7b6594c5f4",
                                "text": "C'était un tout jeune prêtre maigre, fort petit, à la parole emphatique, et dont les yeux, cerclés de noir et caves, indiquaient une âme violente."
                            }
                        ]
                    },
                    {
                        "sense_id": "47186ba8-dd55-3f5f-ba21-bc9b2a97c663",
                        "entry_id": "d6e68e13-470f-3d1d-a5f0-0e32a73e1022",
                        "glosses": [
                            "Qui met l’accent sur un point particulier de la phrase."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3fd8a592-5d3b-4db6-b84f-d34ed35336c9",
                                "sense_id": "47186ba8-dd55-3f5f-ba21-bc9b2a97c663",
                                "text": "On leur suggérait d’employer des marqueurs emphatiques : le «ne» de négation, dans «je ne crois pas», est tout de suite plus soutenu. C’est comme si on mettait une cravate !"
                            },
                            {
                                "example_id": "990708d2-102b-4bc8-a560-cbe9a60b7874",
                                "sense_id": "47186ba8-dd55-3f5f-ba21-bc9b2a97c663",
                                "text": "Toi est la forme emphatique de tu."
                            },
                            {
                                "example_id": "00dbd469-e0a3-4331-9e64-fad64e918258",
                                "sense_id": "47186ba8-dd55-3f5f-ba21-bc9b2a97c663",
                                "text": "Moi, je est une tournure emphatique."
                            },
                            {
                                "example_id": "434c0e64-caa8-4e6a-bcee-b5e180a497fb",
                                "sense_id": "47186ba8-dd55-3f5f-ba21-bc9b2a97c663",
                                "text": "Si jamais est la forme emphatique de si."
                            }
                        ]
                    },
                    {
                        "sense_id": "e67b3c52-4293-3b60-8781-28b2344a0d80",
                        "entry_id": "d6e68e13-470f-3d1d-a5f0-0e32a73e1022",
                        "glosses": [
                            "Qualifie une consonne éjective qui est également vélaire ou pharyngale, dans les langues sémitiques comme l’arabe."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "f0212694-db3c-3cdf-83ee-0527125bf34b",
                        "entry_id": "d6e68e13-470f-3d1d-a5f0-0e32a73e1022",
                        "glosses": [
                            "Exagéré."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "594b7e74-c1f9-4392-a8b3-61f52cd5605b",
                                "sense_id": "f0212694-db3c-3cdf-83ee-0527125bf34b",
                                "text": "Ainsi avait-on renoncé aux grilles ciselées et dorées pour séparer les salons emphatiques, les Grands Appartements."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d2be5b36-f6c4-4d5b-aa6a-3b1bdc29ddb8",
