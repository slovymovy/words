                                                "sense_id": "16125975-2a10-334e-b180-b70a3cc25131",
                                                "text": "Ich bin in Pisa geboren."
                                            },
                                            {
                                                "example_id": "e4d5e161-0d29-4f2a-9657-06cb52dc7050",
                                                "sense_id": "16125975-2a10-334e-b180-b70a3cc25131",
                                                "text": "Ich habe in Pisa meinen Urlaub verbracht."
                                            },
                                            {
                                                "example_id": "3e07de17-5b86-4bde-b7c6-1c4de7fe2ff7",
                                                "sense_id": "16125975-2a10-334e-b180-b70a3cc25131",
                                                "text": "Nach Pisa führen viele Wege."
                                            },
                                            {
                                                "example_id": "0770c1d2-818e-4e03-9325-ac2acbe7d10e",
                                                "sense_id": "16125975-2a10-334e-b180-b70a3cc25131",
                                                "text": "„Im Altertum lag die Stadt Pisa unmittelbar am Meer.“"
                                            }
