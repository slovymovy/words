                                        "glosses": [
                                            "Habitant de la Valachie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb42e7c4-0e6c-4a3c-b66b-4c9741b9a977",
                                                "sense_id": "67f58b39-88f9-3e15-b155-eb24848dd72f",
                                                "text": "Les Valaques diffèrent de mœurs et de langage des Rasciens leurs voisins, quoiqu'ils professent comme eux la religion grecque."
                                            },
                                            {
                                                "example_id": "2269b0cc-7790-4d64-be1e-f79b8f4d48a4",
                                                "sense_id": "67f58b39-88f9-3e15-b155-eb24848dd72f",
                                                "text": "Des zouaves, des moblots, des francs-tireurs, des gardes forestiers, des cavaliers démontés, jusques à des gendarmes, des Espagnols et des Valaques ; il y avait de tout, et ce tout était commandé par un vieux capitaine d’habillement promu, pour la circonstance, au grade de lieutenant-colonel."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
