                    {
                        "sense_id": "148762b2-d4c3-32e1-8971-2caa13c2f4f8",
                        "entry_id": "2eb2af75-b872-365e-a3bc-709c14027ad3",
                        "glosses": [
                            "The first letter of the Proto-Canaanite alphabet, and its descendants in descended Semitic scripts, such as Phoenician 𐤀 (ʾ, ʾaleph), Aramaic 𐡀 (ʾ), Classical Syriac ܐ ('ālaph), Hebrew א (aleph) and Arabic ا (ʾalif)."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "d0d59957-8c79-316c-a750-ed9d76f55769",
                        "entry_id": "2eb2af75-b872-365e-a3bc-709c14027ad3",
                        "glosses": [
                            "The cardinality of an infinite well-ordered (or well-orderable) set."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "50ff37fd-91f6-4388-8790-eb7454ee06ec",
                                "sense_id": "d0d59957-8c79-316c-a750-ed9d76f55769",
                                "text": "The axiom of choice is equivalent to the proposition that every infinite cardinal is an aleph."
                            }
                        ]
                    }
                ],
