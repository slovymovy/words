                "senses": [
                    {
                        "sense_id": "f174d081-7098-3c67-ac78-1beb512c1e1f",
                        "entry_id": "3575202b-984c-347f-9d85-1a2008f1e81a",
                        "glosses": [
                            "Rendre tétraplégique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "97d6ce74-c28a-4d21-8645-547e09a83fea",
                                "sense_id": "f174d081-7098-3c67-ac78-1beb512c1e1f",
                                "text": "La vengeance c'est pas joli, c'est déconseillé aux moins de 18 ans, ça nuit à la santé, accélère le vieillissement de la peau et ça doit sûrement tétraplégiser les spermatozoïdes..."
                            },
                            {
                                "example_id": "e98d9b89-6ce5-4fce-8655-feea78b805ad",
                                "sense_id": "f174d081-7098-3c67-ac78-1beb512c1e1f",
                                "text": "Et un slow de Ferré qui me tétraplégise."
                            },
                            {
                                "example_id": "03044474-1ee2-43fd-8fa4-fcf163969423",
                                "sense_id": "f174d081-7098-3c67-ac78-1beb512c1e1f",
                                "text": "Nani tétraplégise Zabaleta d'un amour de crochet à l'entrée de la surface et décale Evra dans le couloir gauche."
                            },
                            {
                                "example_id": "9c92e687-6dbf-4841-a95a-6a1f182c8c6e",
                                "sense_id": "f174d081-7098-3c67-ac78-1beb512c1e1f",
                                "text": "La France est un vieux pays tétraplégisé par des fonctionnaires frileux, des intermittents du spectacle parasites et des jeunes anti-CPE inquiets."
                            }
                        ]
                    }
