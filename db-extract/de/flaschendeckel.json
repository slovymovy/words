                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6755e38e-4e03-43b3-a12a-c32d3190af16",
                                "sense_id": "611ab601-483c-3ef8-b314-7573fc011b0c",
                                "text": "„Er schraubt den Flaschendeckel ab, riecht an der Flasche, trinkt jedoch nichts.“"
                            },
                            {
                                "example_id": "81d2965b-120e-4ed4-842b-4f9117a91c94",
                                "sense_id": "611ab601-483c-3ef8-b314-7573fc011b0c",
                                "text": "„Dann stellte er zwei Gläser dazu, öffnete mit den Zähnen den Flaschendeckel und schenkte großzügig ein.“"
                            },
                            {
                                "example_id": "741c54bc-fcfe-41aa-a3e9-aa1737ad5659",
                                "sense_id": "611ab601-483c-3ef8-b314-7573fc011b0c",
                                "text": "„Er drehte den Flaschendeckel wieder auf, aber seine Hände zitterten so stark, dass er ihm aus den Fingern rutschte und zu Boden fiel.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
