                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe9ee5ec-c7e5-4e57-892f-ba7022950a8a",
                                "sense_id": "70a7f906-55d9-3c9d-8690-f9cecacf060d",
                                "text": "En argent, le tallar [d’Égypte] pèse 144 kérats [sic] à o,833 1/3 et vaut 5,1576."
                            }
                        ]
                    },
                    {
                        "sense_id": "e93c2d42-e6ac-36fc-b08b-65c59325385d",
                        "entry_id": "dbac2e8a-fdbc-3e11-b72e-11e972f00be0",
                        "glosses": [
                            "Monnaie européenne du XVIᵉ siècle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a042b3f3-6b57-4dad-8919-ae53150315a9",
                                "sense_id": "e93c2d42-e6ac-36fc-b08b-65c59325385d",
                                "text": "Le tallar fut définitivement adopté comme monnaie courante sous Charles III. Je crois devoir ajouter que quelques souverains allemands avaient, de leur coté, jugé à propos de faire frapper des testons."
                            },
                            {
                                "example_id": "7a4b682d-9771-4221-ac85-1e7ba5e2108e",
                                "sense_id": "e93c2d42-e6ac-36fc-b08b-65c59325385d",
                                "text": "Nous connaissons la série presque complète de tous les millésimes des tallars depuis 1628 jusqu’en 1650. Une ordonnance du 16 août 1638 autorisa la frappe des demi-tallars et des quarts."
                            }
                        ]
                    }
