                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "monovalence",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "59844142-55d3-3236-bec2-8c2af04b9752",
                                        "entry_id": "d6e46958-b8b9-3210-ac46-fad234994509",
                                        "glosses": [
                                            "The state of being univalent."
                                        ],
                                        "tags": [
                                            "rare",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fcad0c67-c87c-34a9-ae3f-1ca0b32610ed",
                                        "entry_id": "d6e46958-b8b9-3210-ac46-fad234994509",
                                        "glosses": [
                                            "The view, dating from Parmenides, that whatever exists must always have existed and cannot ever change or cease to exist."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7f92fae3-0016-475b-90e6-90cf73e7049b",
                                                "sense_id": "fcad0c67-c87c-34a9-ae3f-1ca0b32610ed",
                                                "text": "The mystical shell of Hegelian dialectics is ontological monovalence, manifest inter alia in the absence of the concept of determinate absence."
                                            },
                                            {
                                                "example_id": "edd398d7-2a64-4b2d-8e03-93999c6535d1",
                                                "sense_id": "fcad0c67-c87c-34a9-ae3f-1ca0b32610ed",
                                                "text": "Yet, if the critique of Dialectic is to be followed then these positive aspects of Hegel are swallowed up by his monovalence."
                                            },
                                            {
                                                "example_id": "6155c80b-05c7-44fd-ad0f-2c57d53fa3a5",
                                                "sense_id": "fcad0c67-c87c-34a9-ae3f-1ca0b32610ed",
                                                "text": "The Movement's profound embrace of “Common Sense” philosophy, with its conviction of the monovalence of truth, led to the assumption that all properly thinking people think alike."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
