            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e1db5c4e-093f-3eb0-aa0a-7fa4475b6c03",
                    "sense_definition": "Action d'éliminer, d'annuler ou de faire disparaître quelque chose.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "abolition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le gouvernement a voté la <w>suppression</w> de cette taxe pour soulager les ménages."
                        },
                        {
                            "text": "La <w>suppression</w> de cette ligne ferroviaire a provoqué le mécontentement des habitants de la région."
                        }
                    ],
                    "synonyms": [
                        "abolition",
                        "annulation",
                        "élimination"
                    ],
                    "antonyms": [
                        "création",
                        "instauration",
                        "maintien"
                    ],
                    "common_phrases": [
                        "suppression d'une taxe",
                        "suppression d'un avantage"
                    ]
                },
                {
                    "sense_id": "0177f406-da06-386b-8199-541bd5dd4763",
                    "sense_definition": "Action d'effacer un texte, un fichier ou des données enregistrées.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "effacement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La <w>suppression</w> accidentelle de ce document a effacé plusieurs heures de travail."
                        },
                        {
                            "text": "Une boîte de dialogue s'affiche pour confirmer la <w>suppression</w> définitive des photos sélectionnées."
                        }
                    ],
                    "synonyms": [
                        "effacement"
                    ],
                    "antonyms": [
                        "ajout",
                        "insertion"
                    ],
                    "common_phrases": [
