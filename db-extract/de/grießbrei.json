                "senses": [
                    {
                        "sense_id": "765e5010-664d-3084-a2f9-2950d1a7bf21",
                        "entry_id": "e0190bd6-0108-31ee-8e5a-9e93f5afd45d",
                        "glosses": [
                            "gekochter Brei, der aus Milch, Grieß, Zucker und einer Prise Salz zubereitet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "61161618-369b-437a-80e9-42ac9f156e25",
                                "sense_id": "765e5010-664d-3084-a2f9-2950d1a7bf21",
                                "text": "Grießbrei erinnert viele Menschen an glückliche Kindertage."
                            },
                            {
                                "example_id": "3d01f98f-3180-4842-a7a9-aeb77f565b75",
                                "sense_id": "765e5010-664d-3084-a2f9-2950d1a7bf21",
                                "text": "„Frau Vietzke kann nicht mehr helfen, und mit dem Grießbrei allein, so wichtig er sein mag, ist es nicht getan.“"
                            },
                            {
                                "example_id": "992c7c65-f7ba-4d1a-bf98-9fa22944b53b",
                                "sense_id": "765e5010-664d-3084-a2f9-2950d1a7bf21",
                                "text": "„Leichenblass versuchte er, den abendlichen, klebrigen Grießbrei herunterzuwürgen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
