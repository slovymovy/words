                        "zh": [
                            {
                                "target_lang_word": "安珀",
                                "target_lang_sense_clarification": "人名"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3b3e91e2-563c-3a36-a436-21aaa0dbebf5",
                    "sense_definition": "A surname.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "name_person",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Amber</w> has been teaching history at our school for ten years.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Эмбер</w> преподаёт историю в нашей школе уже десять лет.",
                                "zh": "<w>安珀</w>先生在我们学校教历史已经十年了。"
                            }
                        },
                        {
                            "text": "We received a letter addressed to the <w>Amber</w> family.",
                            "target_lang_translations": {
                                "ru": "Мы получили письмо, адресованное семье <w>Эмбер</w>.",
                                "zh": "我们收到了一封寄给<w>安珀</w>一家的信。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия.",
                        "zh": "姓氏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Эмбер",
                                "target_lang_sense_clarification": "фамилия"
                            }
