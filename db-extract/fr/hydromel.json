                                            {
                                                "example_id": "9342b124-b7d5-49fe-a8db-e28cd9db3448",
                                                "sense_id": "65fb3c45-4633-341b-8b78-5499cbf13fb4",
                                                "text": "Mede vanwege de gevolgen van Katrina is er een hernieuwde belangstelling voor het broeikaseffect."
                                            },
                                            {
                                                "example_id": "2dd97ff4-0275-4662-97ba-714897ebf8ba",
                                                "sense_id": "65fb3c45-4633-341b-8b78-5499cbf13fb4",
