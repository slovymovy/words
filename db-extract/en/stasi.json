            },
            {
                "entry_id": "8015480f-897e-3366-89f0-a51caa0ed1e1",
                "word": "Stasi",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "9bbfcdad-f49c-47bd-a17d-91ae99f590e6",
                        "entry_id": "8015480f-897e-3366-89f0-a51caa0ed1e1",
                        "tags": [
                            "plural"
                        ],
                        "form": "Stasi"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "beeeb722-2493-39b7-a355-cbb40e57c21c",
                        "entry_id": "8015480f-897e-3366-89f0-a51caa0ed1e1",
                        "glosses": [
                            "One who engages in covert surveillence or similar activities associated with secret police."
                        ],
                        "tags": [
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "929e78df-de6a-4d18-adb7-3c053e2702c8",
                                "sense_id": "beeeb722-2493-39b7-a355-cbb40e57c21c",
                                "text": "The Facebook Stasi then surreptitiously monitored the subscribers' writing to note changes in vocabulary to indicate mood swings."
                            }
                        ]
                    },
                    {
                        "sense_id": "5c04534a-6173-31c0-8b56-4f08067e0d16",
                        "entry_id": "8015480f-897e-3366-89f0-a51caa0ed1e1",
                        "glosses": [
                            "One who imposes one's views on others; one who is unfairly oppressive or needlessly strict."
                        ],
                        "tags": [
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "b17fa9a3-ef8b-4337-a449-49c0953dd057",
                                "sense_id": "5c04534a-6173-31c0-8b56-4f08067e0d16",
                                "text": "All vile and grossly insensitive certainly; but on balance I think I’m more afraid of the Twitter Stasi and their increasingly zealous police enforcers."
                            },
                            {
                                "example_id": "84578c3d-0284-40f8-a530-eddbddb1ef9e",
                                "sense_id": "5c04534a-6173-31c0-8b56-4f08067e0d16",
                                "text": "After the image was removed, Mr Harlass shared the image of the couple, writing: \"Apparently the Facebook Stasi has removed this wonderful, pure picture.\""
                            },
                            {
                                "example_id": "912fbdd6-7338-45c6-b810-6022a7b4aad1",
                                "sense_id": "5c04534a-6173-31c0-8b56-4f08067e0d16",
                                "text": "I suspect the vast majority of us, on all points of the political spectrum, don't want to live in a society where Twitter Stasi are constantly looking for wrongthink to report to one's employer[…]"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4ea982c1-f952-4a35-85df-b4e3f9415431",
                        "source_entry_id": "8015480f-897e-3366-89f0-a51caa0ed1e1",
                        "source_sense_description": "East German Ministry for State Security",
                        "target_lang_word": "Stasi",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Stasi",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "556db424-b7c8-3645-b319-4fc6e67f0ebc",
                                        "entry_id": "5590e7ae-57e5-3862-9628-335464aeae07",
                                        "glosses": [
                                            "Geheimpolizei der Deutschen Demokratischen Republik, die im In- und Ausland operierte"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "94cb46b0-08c9-451e-8a71-3e542f9b2948",
                                                "sense_id": "556db424-b7c8-3645-b319-4fc6e67f0ebc",
                                                "text": "„Als die Unruhe, die sie verbreiteten, Freya Klier zu viel wurde, rief sie ‚jetzt reicht’s aber mit dem Stasi hier im Saal‘. Der lautstarke Beifall, den sie erhielt, bewies, welcher Beliebtheit sich Krawczyk erfreute und was man über den SSD dachte.“"
                                            },
                                            {
                                                "example_id": "83f46484-d322-4414-84fe-145872bffa1a",
                                                "sense_id": "556db424-b7c8-3645-b319-4fc6e67f0ebc",
                                                "text": "„Er wand sich bei der Frage, warum er einen ‚belasteten Mann‘ an die Spitze des Stasis gestellt habe, er wand sich, als es um den Haß im Volk gegen die Aufpasser von gestern ging, er wand sich bei der Frage, warum Wolf Biermann nicht ins Land darf.“"
                                            },
                                            {
                                                "example_id": "a65850fc-f698-4b9a-9e37-534ca036cb62",
                                                "sense_id": "556db424-b7c8-3645-b319-4fc6e67f0ebc",
                                                "text": "„Die Bevölkerung der DDR hat in einer gewaltfreien, demokratischen Revolution das Machtmonopol der SED und des Stasi gebrochen.“"
                                            },
                                            {
                                                "example_id": "2ee6b498-5774-40b2-922d-00c2fc09d751",
                                                "sense_id": "556db424-b7c8-3645-b319-4fc6e67f0ebc",
                                                "text": "„Später hat die DDR den Stasi und seine Techniken zum Exportartikel gemacht - von Addis Abeba bis Havanna.“"
                                            },
                                            {
                                                "example_id": "ad95a35d-fb92-4798-89c9-e6ac8023995b",
                                                "sense_id": "556db424-b7c8-3645-b319-4fc6e67f0ebc",
                                                "text": "„‚Flächendeckend observieren‘, hieß die Mielke-Devise. Dazu paßt auch die Enthüllung des früheren Magdeburger Oberliga-Trainers Horst Krügel: ‚Obskur, doch leider wahr: in den Kabinen versteckte der Stasi Wanzen‘.“"
                                            },
                                            {
                                                "example_id": "4821608e-9a19-4605-899b-f77c4205bb11",
                                                "sense_id": "556db424-b7c8-3645-b319-4fc6e67f0ebc",
                                                "text": "„Zweifelsohne ist die Stasi eine ganz besondere Kategorie von Geheimdienst gewesen, deren oberstes Gebot es war, die gesamte Bevölkerung wie in einem Spinnennetz zu fangen und so jede ihrer Bewegungen kontrollieren zu können.“"
                                            },
                                            {
                                                "example_id": "f96f7955-aa50-4e14-be3c-97efd7c335c1",
                                                "sense_id": "556db424-b7c8-3645-b319-4fc6e67f0ebc",
                                                "text": "„Und selbst im Hause Gauck müßte man doch erkannt haben, wes Geistes Kind die Lauscher und Gucker waren, die uns da auf den Hals geschickt wurden von der Stasi – und die werden nun nachträglich zu Gewährsleuten für die Tugend, oder Untugend, bisher nicht bescholtener Bürger.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Stasi",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "05268d61-7d0a-3563-8859-511422e562e3",
                                        "entry_id": "d5ae2b06-b01d-310e-ac3e-84d5a93b3175",
                                        "glosses": [
                                            "Angehöriger, Mitarbeiter der Stasi"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "13b5cde1-2b83-4f28-9b51-8485c5f907e2",
                                                "sense_id": "05268d61-7d0a-3563-8859-511422e562e3",
                                                "text": "„Mehrstimmig und lauter als die beste DDR-Hifi-Anlage es vermöchte, schallt den Stasis immer wieder der Refrain entgegen: ‚Völker hört die Signale … die Inernationale erkämpft das Menschenrecht‘.“"
                                            },
                                            {
                                                "example_id": "41bc92e3-0583-4600-810d-3f12dc2ef525",
                                                "sense_id": "05268d61-7d0a-3563-8859-511422e562e3",
                                                "text": "„Ist CDU-Manager Martin Kirchner also kein Stasi?“"
                                            },
                                            {
                                                "example_id": "bdda622b-bb8b-41e0-8215-4d34d0e88014",
                                                "sense_id": "05268d61-7d0a-3563-8859-511422e562e3",
                                                "text": "„Wie man inzwischen weiß, galt das Mißtrauen neben dem ‚normalen Bürger‘ auch sich selbst – Stasis überwachten sich gegenseitig.“"
                                            },
                                            {
                                                "example_id": "56244598-f6d0-4270-9fa6-ed85d3074b11",
                                                "sense_id": "05268d61-7d0a-3563-8859-511422e562e3",
                                                "text": "„Ich war ein Stasi.“"
                                            },
                                            {
                                                "example_id": "10452722-65dd-4044-8375-c540e85b388f",
                                                "sense_id": "05268d61-7d0a-3563-8859-511422e562e3",
                                                "text": "„‚Das war doch nur ein Stasi‘, hörten Ost-Berliner Taxifahrer, die sich wegen des fehlenden Trauerflors beschwerten.“"
                                            },
                                            {
                                                "example_id": "dbc5cbed-be88-403d-8212-54984bd1daf7",
                                                "sense_id": "05268d61-7d0a-3563-8859-511422e562e3",
                                                "text": "„Aus Fehlern lernen, Fehler nie wiederholen, die Verbrechen der Väter ächten, «klarkriegen», ich bin klein, mein Herz ist rein, bin kein Nazi, kein Wehrmachtssoldat, kein Antikommunist, kein Deutsch-Nationaler, kein Stasi, kein Bösewicht, kein Mitläufer, ich bin anders ganz und gar.“"
                                            },
                                            {
                                                "example_id": "f94c319a-6d52-4cba-ac04-4ad4f87fc98c",
                                                "sense_id": "05268d61-7d0a-3563-8859-511422e562e3",
                                                "text": "„Die kleinen und mittleren ‚Stasis‘ wurden zurückgedrängt. Große ‚Stasis‘ wurden hingegen als Geheimdienstler respektiert und umworben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Stasi",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "158424b2-714d-3b1a-864c-9ebc3f3e4e15",
                                        "entry_id": "39d84caf-ef1c-36e3-8cba-6d3964b211ee",
                                        "glosses": [
                                            "weiblicher Vorname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "84d676b9-f0ef-44cd-b806-137108d30583",
                                                "sense_id": "158424b2-714d-3b1a-864c-9ebc3f3e4e15",
                                                "text": "Mit ihrem Lebensgefährten unternimmt die rüstige Stasi gern ausgedehnte Bergwanderungen."
                                            },
                                            {
                                                "example_id": "006a3529-d323-4148-b62a-06a57496ccc6",
                                                "sense_id": "158424b2-714d-3b1a-864c-9ebc3f3e4e15",
                                                "text": "„Ich zahle dir fünfhundert Gulden lachends baares Geld auf’s Brett hin, wenn du mit deiner Mutter und deiner Stasi nach Amerika gehst.“"
                                            },
                                            {
                                                "example_id": "1228c782-ca03-48ce-9652-68dbb26169d1",
                                                "sense_id": "158424b2-714d-3b1a-864c-9ebc3f3e4e15",
                                                "text": "„‚Die Hand darauf, herzensgute Stasi, mein allerliebster Schatz!‘ Stasi reichte ihm die Hand, und so feierten sie ihre Verlobung durch’s Fenster.“"
                                            },
                                            {
                                                "example_id": "4990b708-9efa-4f6b-88e0-c8f5b6c714b8",
                                                "sense_id": "158424b2-714d-3b1a-864c-9ebc3f3e4e15",
                                                "text": "„Frau Larseit ruhte in einem mit Bettkissen ausgepolsterten Armstuhl, und Stasi saß mit einer Handarbeit in der Nähe eines der beiden Fensterchen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
