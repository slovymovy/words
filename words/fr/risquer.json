{
    "word_family": [
        "risque",
        "risqué",
        "risquable",
        "risque-tout"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "de87e3cd-b869-39cf-9506-6a840986585a",
                    "sense_definition": "Avoir une forte probabilité de produire ou de subir un événement indésirable.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "probabilite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Prends ton parapluie car il <w>risque</w> de pleuvoir en fin de journée."
                        },
                        {
                            "text": "Si nous partons en retard, nous <w>risquons</w> de rater le début du concert."
                        }
                    ],
                    "common_phrases": [
                        "risquer de pleuvoir",
                        "risquer de perdre"
                    ]
                },
                {
                    "sense_id": "dcd95e08-fe59-307f-8e16-cadd4dc7e920",
                    "sense_definition": "Exposer délibérément quelque chose de précieux à un danger ou à une perte.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "danger",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le pompier a <w>risqué</w> sa vie pour sauver les habitants pris au piège."
                        },
                        {
                            "text": "Il refuse de <w>risquer</w> ses économies dans un investissement aussi peu fiable."
                        }
                    ],
                    "common_phrases": [
                        "risquer sa vie",
                        "risquer sa peau",
                        "risquer le tout pour le tout"
                    ]
                },
                {
                    "sense_id": "b02bb1f9-c468-38cb-a8d4-bf853c9097e2",
                    "sense_definition": "S'exposer à subir une sanction, une conséquence fâcheuse ou une peine.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "danger",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En garant votre voiture sur ce trottoir, vous <w>risquez</w> une amende importante."
                        },
                        {
                            "text": "L'accusé <w>risque</w> plusieurs années de prison ferme pour ses actes illégaux."
                        }
                    ],
                    "synonyms": [
                        "encourir"
                    ],
                    "common_phrases": [
                        "risquer une amende",
                        "risquer la prison"
                    ]
                },
                {
                    "sense_id": "c8a9be85-81c6-3a3b-813c-f33a3e429de0",
                    "sense_definition": "S'aventurer ou oser aller dans un lieu ou une situation incertaine.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "audace",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Personne n'osait se <w>risquer</w> sur le lac gelé car la glace semblait fragile."
                        },
                        {
                            "text": "Le voyageur s'est <w>risqué</w> hors des sentiers balisés malgré les avertissements du guide."
                        }
                    ],
                    "common_phrases": [
                        "se risquer sur",
                        "se risquer dehors"
                    ]
                },
                {
                    "sense_id": "68604295-2beb-363e-954f-5681ef15fb8a",
                    "sense_definition": "Avancer avec hésitation ou timidité une parole, une idée ou un geste.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "audace",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après un moment d'hésitation, elle a <w>risqué</w> une remarque polie pendant la réunion."
                        },
                        {
                            "text": "Le jeune timide a <w>risqué</w> un regard vers la personne assise en face de lui."
                        }
                    ],
                    "common_phrases": [
                        "risquer une question",
                        "risquer un regard"
                    ]
                }
            ]
        }
    ]
}