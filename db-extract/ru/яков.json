                                    },
                                    {
                                        "sense_id": "b5823bc6-458f-38a8-bdba-9641caaad94c",
                                        "entry_id": "acabe25e-e889-31e5-89c3-e7f9e3717f31",
                                        "glosses": [
                                            "A ladder."
                                        ],
                                        "tags": [
                                            "UK",
                                            "obsolete",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d67b4a1b-c8e1-4f59-94ac-3d9be09dbaaa",
                                                "sense_id": "b5823bc6-458f-38a8-bdba-9641caaad94c",
                                                "text": "Where's the Jacob? — the what, sir? — the Jacob! the ladder ye fool!"
                                            }
