                "forms": [
                    {
                        "form_id": "e6c5e8e9-e831-4e1a-b4ce-97118d983e94",
                        "entry_id": "48121134-c11a-3be0-b9f1-3d59eba6e3f7",
                        "tags": [
                            "plural"
                        ],
                        "form": "fuselages"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "733b2e37-e951-3a38-b561-57b833193c63",
                        "entry_id": "48121134-c11a-3be0-b9f1-3d59eba6e3f7",
                        "glosses": [
                            "Caisson à ossature métallique, en forme de fuseau, constituant le corps des avions et portant les ailes, les organes de stabilisation, de direction et de manœuvre, les appareils de navigation, les réservoirs, l’armement, et abritant le pilote et les passagers."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "27cc3ba5-3dbe-48df-979a-bc421f131116",
                                "sense_id": "733b2e37-e951-3a38-b561-57b833193c63",
                                "text": "Il semble que tout l'effort industriel de l'homme, tous ses calculs, toutes ses nuits de veille sur les épures, n'aboutissent, comme signes visibles, qu'à la seule simplicité, comme s'il fallait l'expérience de plusieurs générations pour dégager peu à peu la courbe d'une colonne, d'une carène, ou d'un fuselage d'avion, jusqu'à leur rendre la pureté élémentaire de la courbe d'un sein ou d'une épaule."
                            }
                        ]
                    },
                    {
                        "sense_id": "97775c45-dc83-301d-8c84-5987f69aa111",
                        "entry_id": "48121134-c11a-3be0-b9f1-3d59eba6e3f7",
                        "glosses": [
                            "Carapace métallique d’un véhicule de transport en forme de fuseau."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cd793cdd-ddcc-4e8b-a955-47770b02e4a4",
                        "source_entry_id": "48121134-c11a-3be0-b9f1-3d59eba6e3f7",
                        "target_lang_word": "Rumpf",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rumpf",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "808f8403-abab-3bc9-8a90-03b5f4276fe9",
                                        "entry_id": "82dbf02b-4b40-33dc-a21d-d60ccd49784a",
                                        "glosses": [
                                            "die Unterseite oder der untere Teil eines Schiffes, Flugzeugs oder Ähnlichem"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7a52d30d-836d-4c31-a5ad-d24f9b7706cd",
                                                "sense_id": "808f8403-abab-3bc9-8a90-03b5f4276fe9",
                                                "text": "Im Rumpf des Schiffes war nicht genug Platz für die Ladung."
                                            },
                                            {
                                                "example_id": "82165f2e-08e6-4c03-9a7d-4999fc313992",
                                                "sense_id": "808f8403-abab-3bc9-8a90-03b5f4276fe9",
                                                "text": "„Manche Quellen behaupten deshalb, der hölzerne Rumpf des Schiffes sei schon rott gewesen.“"
                                            },
                                            {
                                                "example_id": "9dc89e85-889b-4b47-90bb-f0efb9818d45",
                                                "sense_id": "808f8403-abab-3bc9-8a90-03b5f4276fe9",
                                                "text": "„Beginnend am Kiel, fügen die Handwerker nun den Rumpf zusammen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ff783df3-4273-3e14-879e-80c5f335e378",
                                        "entry_id": "82dbf02b-4b40-33dc-a21d-d60ccd49784a",
                                        "glosses": [
                                            "zentraler Abschnitt des Körpers (ohne Kopf, Hals, Gliedmaßen und Schwanz)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "efefc0d1-f154-4431-8511-3dae2c690f6b",
                                                "sense_id": "ff783df3-4273-3e14-879e-80c5f335e378",
                                                "text": "Bisher wurde nur der Rumpf der Leiche gefunden; Kopf und Gliedmaßen werden noch gesucht."
                                            },
                                            {
                                                "example_id": "847df342-69ed-4156-8786-356b75b0b954",
                                                "sense_id": "ff783df3-4273-3e14-879e-80c5f335e378",
                                                "text": "„Kutusow sass auf seinem Bett, liess das eine Bein herunterhängen und das Gewicht seines mächtigen Rumpfes auf dem andern Bein ruhen, das er untergeschlagen hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "c973d835-53a9-3cd4-a061-9e08592122e7",
                                        "entry_id": "82dbf02b-4b40-33dc-a21d-d60ccd49784a",
                                        "glosses": [
                                            "der grundlegende Teil von etwas"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5ee56492-1b6d-4df2-9204-e62960087a8e",
                                                "sense_id": "c973d835-53a9-3cd4-a061-9e08592122e7",
                                                "text": "Der Rumpf der gemeinnützigen Roosevelt Institution stand wenig später, die Gruppen schlossen sich zusammen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1a831282-a3d3-4a83-a743-ffa5bbfd4803",
                        "source_entry_id": "48121134-c11a-3be0-b9f1-3d59eba6e3f7",
                        "target_lang_word": "Flugzeugrumpf",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Flugzeugrumpf",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c2a16902-d292-3e58-a35e-db3e9c738784",
                                        "entry_id": "c6adf2ec-7d1c-34cc-9c96-109f51df6c51",
                                        "glosses": [
                                            "Bauteil eines Flugzeugs, der das Cockpit und den Raum für Passagiere und Nutzlast beinhaltet"
                                        ],
                                        "tags": [
                                            "Luftfahrt"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b701d953-7975-457b-9387-b34630419fe2",
                                                "sense_id": "c2a16902-d292-3e58-a35e-db3e9c738784",
                                                "text": "„Zehn Fans, deren Portraitfotos letztendlich auf den Flugzeugrumpf aufgeklebt wurden, wurden aus 400 Einsender ausgewählt.“"
                                            },
                                            {
                                                "example_id": "1f456915-03c1-4d91-91eb-56233db7993f",
                                                "sense_id": "c2a16902-d292-3e58-a35e-db3e9c738784",
                                                "text": "„Für die Techniker in Hamburg wiederum bedeutete die Generalüberholung vor allem eine Menge Arbeit. So wurden die beiden Tragflächen vom Flugzeugrumpf gelöst und in große, eigens dafür konstruierte Gerüste gehängt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1e165428-4d1b-4924-a95d-a9b8be156497",
                        "source_entry_id": "48121134-c11a-3be0-b9f1-3d59eba6e3f7",
                        "target_lang_word": "fuselage",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fuselage",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "776d2d3e-1588-368e-a0d0-973f593b9931",
                                        "entry_id": "76a139c1-2002-36d8-8f0b-f70d34e63e13",
                                        "glosses": [
                                            "The main body of an aerospace vehicle; the long central structure of an aircraft to which the wings (or rotors), tail, and engines are attached, and which accommodates crew and cargo."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b70e68f6-3ccf-4b69-b5d5-dd65db98adab",
                                                "sense_id": "776d2d3e-1588-368e-a0d0-973f593b9931",
                                                "text": "Federal officials examining the horrifying midflight blowout of part of an Alaska Airlines aircraft’s fuselage are testing the detached piece for clues on what led up to the plane’s “explosive decompression” after the missing piece was discovered in an Oregon backyard."
                                            },
                                            {
                                                "example_id": "f61df8d2-ab42-4ebb-beca-23f0e44b6df8",
                                                "sense_id": "776d2d3e-1588-368e-a0d0-973f593b9931",
                                                "text": "Wichita, Kansas-based Spirit AeroSystems makes major parts of several Boeing models, including the fuselages for the 737 Max."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bbe12a50-71c5-43bc-8265-9e64ecc612e3",
                        "source_entry_id": "48121134-c11a-3be0-b9f1-3d59eba6e3f7",
                        "target_lang_word": "fuselaje",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fuselaje",
