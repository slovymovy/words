                    {
                        "sense_id": "95b82824-da4b-37c1-b6c6-83b1f099c6c4",
                        "entry_id": "79632aad-641f-3488-b90b-e0c2eceeb971",
                        "glosses": [
                            "Arbre (Carya illinoinensis) de la famille des juglandacées, originaire d’Amérique du Nord et dont le noyau du fruit (drupe) contient une amande comestible, la pacane ou noix de pécan."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b7732dc8-1624-43b1-9fd6-fdaa5d1329d7",
                                "sense_id": "95b82824-da4b-37c1-b6c6-83b1f099c6c4",
                                "text": "La noix de pécan, fruit du pécanier, est une graine composée de deux cerneaux blanchâtres recouvert d’une fine membrane brunâtre."
                            },
                            {
                                "example_id": "a97b9606-78ee-4a50-bbd7-e6fd3fb6175e",
                                "sense_id": "95b82824-da4b-37c1-b6c6-83b1f099c6c4",
                                "text": "Outre les précédents, il y a le frêne, l’hyckory, l’érable, le gommier, le hêtre, le pécanier, le sycomore, l’orme, le peuplier, le cèdre, le platanier et l’hackberry."
                            }
                        ]
                    },
                    {
                        "sense_id": "1c76f4e7-d387-3684-8328-e5a380a31833",
                        "entry_id": "79632aad-641f-3488-b90b-e0c2eceeb971",
                        "glosses": [
                            "Bois de cet arbre, très apprécié en ébénisterie."
                        ],
                        "tags": [
                            "metonymically"
                        ],
                        "examples": [
                            {
                                "example_id": "3773f564-b4b9-4e18-bf9b-cd641a4762c7",
                                "sense_id": "1c76f4e7-d387-3684-8328-e5a380a31833",
                                "text": "Mobiliers en pécanier brun et ronce d’olivier découpé de noir"
                            }
                        ]
                    }
