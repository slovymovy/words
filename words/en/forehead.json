                {
                    "sense_id": "ea5a23ef-20fe-3826-9bba-283dcc2c4af3",
                    "sense_definition": "The part of the face above the eyebrows and below the hairline.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She gently kissed the sleeping child on his <w>forehead</w>.",
                            "target_lang_translations": {
                                "ru": "Она нежно поцеловала спящего ребенка в <w>лоб</w>.",
                                "zh": "她轻轻地吻了吻熟睡孩子的<w>额头</w>。"
                            }
                        },
                        {
                            "text": "He wiped the sweat from his <w>forehead</w> with a handkerchief.",
                            "target_lang_translations": {
                                "ru": "Он вытер пот со <w>лба</w> носовым платком.",
                                "zh": "他用手帕擦去了<w>额头</w>上的汗水。"
                            }
                        }
                    ],
                    "synonyms": [
                        "brow"
                    ],
                    "common_phrases": [
                        "high forehead",
                        "wipe one's forehead",
                        "kiss on the forehead",
                        "wrinkled forehead"
                    ],
                    "target_lang_definitions": {
                        "ru": "Часть лица над бровями и ниже линии роста волос.",
                        "zh": "脸部眉毛上方、发际线以下的部位。"
                    },
