{
    "word_family": [
        "tal",
        "tellen",
        "telling",
        "getal",
        "talloosheid"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "973b0244-ded1-3e41-994b-294957c27169",
                    "sense_definition": "onmogelijk om te tellen vanwege de zeer grote hoeveelheid",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "hoeveelheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hoe <w>talloos</w> de denkende wezens ook zijn, ik zal ze bevrijden.",
                            "target_lang_translations": {
                                "en": "However <w>countless</w> the thinking beings may be, I will liberate them."
                            }
                        },
                        {
                            "text": "Er zijn <w>talloze</w> redenen om dit jaar niet op vakantie te gaan.",
                            "target_lang_translations": {
                                "en": "There are <w>innumerable</w> reasons not to go on holiday this year."
                            }
                        }
                    ],
                    "synonyms": [
                        "ontelbaar",
                        "talloos veel",
                        "onnoemelijk"
                    ],
                    "antonyms": [
                        "enkel",
                        "weinig"
                    ],
                    "common_phrases": [
                        "talloze keren",
                        "talloze mogelijkheden"
                    ],
                    "target_lang_definitions": {
                        "en": "impossible to count because of the very large quantity"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "countless",
                                "target_lang_sense_clarification": "too many to be counted"
                            },
                            {
                                "target_lang_word": "innumerable",
                                "target_lang_sense_clarification": "too many to be numbered"
                            },
                            {
                                "target_lang_word": "myriad",
                                "target_lang_sense_clarification": "a great number of"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "10349de0-4b44-37e4-a254-d22f13035558",
                    "sense_definition": "op een wijze die niet te tellen is; in zeer grote mate",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "hoeveelheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er zijn <w>talloos</w> vele mensen omgekomen door de verschrikkelijke ramp.",
                            "target_lang_translations": {
                                "en": "<w>Countless</w> numbers of people perished in the terrible disaster."
                            }
                        },
                        {
                            "text": "Dit probleem is al <w>talloos</w> vaak besproken tijdens de vergadering.",
                            "target_lang_translations": {
                                "en": "This problem has already been discussed <w>countless</w> times during the meeting."
                            }
                        }
                    ],
                    "synonyms": [
                        "ontelbaar"
                    ],
                    "common_phrases": [
                        "talloos veel",
                        "talloos vaak"
                    ],
                    "target_lang_definitions": {
                        "en": "in a manner that cannot be counted; to a very great extent"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "countlessly",
                                "target_lang_sense_clarification": "in a way that is too many to count"
                            },
                            {
                                "target_lang_word": "innumerably",
                                "target_lang_sense_clarification": "in vast numbers"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "numeral",
            "senses": [
                {
                    "sense_id": "285d6d41-e749-3ffd-90a6-324cdcb113aa",
                    "sense_definition": "een onbepaald maar zeer groot aantal",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "hoeveelheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er zijn <w>talloze</w> mensen die dagelijks gebruikmaken van de trein.",
                            "target_lang_translations": {
                                "en": "There are <w>numerous</w> people who use the train daily."
                            }
                        },
                        {
                            "text": "Ik heb hem al <w>talloze</w> keren gevraagd om zijn kamer op te ruimen.",
                            "target_lang_translations": {
                                "en": "I have already asked him <w>countless</w> times to clean up his room."
                            }
                        }
                    ],
                    "synonyms": [
                        "vele",
                        "talloos veel",
                        "talrijk"
                    ],
                    "antonyms": [
                        "enkele"
                    ],
                    "common_phrases": [
                        "talloze mensen",
                        "talloze voorbeelden"
                    ],
                    "target_lang_definitions": {
                        "en": "an indefinite but very large number"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "numerous",
                                "target_lang_sense_clarification": "great in number"
                            },
                            {
                                "target_lang_word": "untold",
                                "target_lang_sense_clarification": "too many to be counted or measured"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}