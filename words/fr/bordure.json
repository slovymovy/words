                    "frequency": "VeryLow",
                    "semantic_group_id": "heraldique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le blason de la commune comporte un lion entouré d'une <w>bordure</w> d'azur."
                        },
                        {
                            "text": "Le chevalier portait un bouclier blanc orné d'une large <w>bordure</w> de gueules."
