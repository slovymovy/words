                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "215d3e49-1afb-41a7-8ea4-2d5dd4d9d0f1",
                        "entry_id": "8f59c504-9be9-3a55-b38f-ea93c9bdf5a4",
                        "tags": [
                            "plural"
