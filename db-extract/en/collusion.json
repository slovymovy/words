                                    {
                                        "sense_id": "1dc21d43-d6f6-356a-b56a-a133f14fd609",
                                        "entry_id": "c6ca3ceb-dade-3e30-96ef-292e39b2dd47",
                                        "glosses": [
                                            "Intelligence secrète entre deux ou plusieurs parties au préjudice d’un tiers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "87f85aab-5934-448a-93df-c095f2a7d272",
                                                "sense_id": "1dc21d43-d6f6-356a-b56a-a133f14fd609",
                                                "text": "La jeune fille qui m’a supposé d’ignobles sentiments est bien capable de croire à quelque collusion, à quelque stratagème."
                                            },
                                            {
                                                "example_id": "d078a011-4ebb-41cf-b1df-6dd46a2b59c7",
                                                "sense_id": "1dc21d43-d6f6-356a-b56a-a133f14fd609",
                                                "text": "Avec le grand capitalisme commence l’inévitable collusion de la richesse et de la puissance politique."
                                            },
                                            {
                                                "example_id": "eded5898-c68d-4c69-83ea-97677930ce05",
                                                "sense_id": "1dc21d43-d6f6-356a-b56a-a133f14fd609",
                                                "text": "Dès 1989, la caisse populaire de Cissin va connaître un début de détournement avec la collusion du gérant et du président de la caisse. Le gérant est licencié et les organes dirigeants suspendus."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
