                    {
                        "sense_id": "37ad2c81-f079-3119-ad67-2b1c6a98953c",
                        "entry_id": "1578a8eb-2924-31df-a279-4960490fe64a",
                        "glosses": [
                            "seitliche Kante am geneigten Dach (Sattel- oder Pultdach), die den Giebel eines Gebäudes nach oben begrenzt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4be43dd9-4309-4baa-801e-22d8bb29bbd8",
                                "sense_id": "37ad2c81-f079-3119-ad67-2b1c6a98953c",
                                "text": "Der Ortgang wird entweder mit speziellen Ziegeln gedeckt, oder mit einer Holzleiste verkleidet."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "9cd58c0a-821a-3b85-ad9a-96d38babd272",
                        "entry_id": "1578a8eb-2924-31df-a279-4960490fe64a",
                        "glosses": [
                            "Gesteinswand am Ende eines Stollens, wo der Abbau fortgesetzt wird."
                        ],
                        "tags": [
                            "Bergbau"
                        ],
                        "examples": [
                            {
                                "example_id": "21a4ed4c-b91b-4dc9-91ec-e04498cb12d9",
                                "sense_id": "9cd58c0a-821a-3b85-ad9a-96d38babd272",
                                "text": "Der Sprengmeister präpariert den Ortgang, damit der Abbau bald fortgesetzt werden kann."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
