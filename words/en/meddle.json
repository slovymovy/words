{
    "word_family": [
        "meddler",
        "meddlesome",
        "meddling"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "73c862d6-74ba-394b-8870-a816a65281a7",
                    "sense_definition": "To interfere in something that is not one's business or to concern oneself with something unnecessarily.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "interference",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I wish my neighbors would stop trying to <w>meddle</w> in my private affairs.",
                            "target_lang_translations": {
                                "ru": "Я бы хотел, чтобы мои соседи перестали пытаться <w>вмешиваться</w> в мои личные дела."
                            }
                        },
                        {
                            "text": "It is very rude to <w>meddle</w> in other people's business when they have not asked for your help.",
                            "target_lang_translations": {
                                "ru": "Очень грубо <w>лезть</w> в чужие дела, когда тебя не просили о помощи."
                            }
                        }
                    ],
                    "synonyms": [
                        "interfere",
                        "intrude",
                        "pry",
                        "stick one's nose into"
                    ],
                    "antonyms": [
                        "ignore",
                        "disregard",
                        "mind one's own business"
                    ],
                    "common_phrases": [
                        "meddle in other people's business",
                        "meddle with the settings"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вмешиваться в дела, которые вас не касаются, или проявлять излишний интерес к чему-либо без необходимости."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вмешиваться",
                                "target_lang_sense_clarification": "в чужие дела"
                            },
                            {
                                "target_lang_word": "лезть",
                                "target_lang_sense_clarification": "не в свое дело"
                            },
                            {
                                "target_lang_word": "сунуть нос",
                                "target_lang_sense_clarification": "в чужие дела"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a34cd720-7b9c-3878-a647-2a946faa477d",
                    "sense_definition": "To interest or engage oneself in a task or field of study.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "engagement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In his youth, he began to <w>meddle</w> with mathematics and logic before pursuing a career in law.",
                            "target_lang_translations": {
                                "ru": "В юности он начал <w>заниматься</w> математикой и логикой, прежде чем посвятить себя карьере в области права."
                            }
                        },
                        {
                            "text": "The scholar chose to <w>meddle</w> with ancient languages to better understand the historical texts.",
                            "target_lang_translations": {
                                "ru": "Ученый решил <w>погрузиться</w> в изучение древних языков, чтобы лучше понимать исторические тексты."
                            }
                        }
                    ],
                    "synonyms": [
                        "dabble",
                        "engage",
                        "occupy oneself"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "This positive sense of engagement is largely replaced by 'dabble' or 'study' in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Заниматься какой-либо деятельностью, наукой или задачей, часто поверхностно или в качестве хобби."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заниматься",
                                "target_lang_sense_clarification": "какой-либо областью"
                            },
                            {
                                "target_lang_word": "поверхностно увлекаться",
                                "target_lang_sense_clarification": "чем-либо"
                            },
                            {
                                "target_lang_word": "погружаться",
                                "target_lang_sense_clarification": "в изучение чего-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d8fecfc3-bf7b-3fdc-a364-d5627b843d26",
                    "sense_definition": "To mix or combine a substance with another; to blend together.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mixing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The alchemist would <w>meddle</w> various herbs with the base liquid to create the desired potion.",
                            "target_lang_translations": {
                                "ru": "Алхимик <w>смешивал</w> различные травы с базовой жидкостью, чтобы создать нужное зелье."
                            }
                        },
                        {
                            "text": "He watched as the artist began to <w>meddle</w> the colors on the palette to find the perfect shade.",
                            "target_lang_translations": {
                                "ru": "Он наблюдал, как художник начал <w>смешивать</w> цвета на палитре, чтобы найти идеальный оттенок."
                            }
                        }
                    ],
                    "synonyms": [
                        "mix",
                        "blend",
                        "commingle",
                        "intermingle"
                    ],
                    "antonyms": [
                        "separate",
                        "divide"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in older literature to describe physical mixing."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Смешивать или соединять одно вещество с другим; перемешивать."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "смешивать",
                                "target_lang_sense_clarification": "вещества или краски"
                            },
                            {
                                "target_lang_word": "перемешивать",
                                "target_lang_sense_clarification": "ингредиенты"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0d624526-df82-30f6-8e8d-15d9769d4c87",
                    "sense_definition": "To have sexual intercourse.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "sexual_relations",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old laws forbade the two groups to <w>meddle</w> with one another under any circumstances.",
                            "target_lang_translations": {
                                "ru": "Старые законы запрещали этим двум группам <w>сходиться</w> друг с другом при любых обстоятельствах."
                            }
                        },
                        {
                            "text": "In the ancient story, the gods would often <w>meddle</w> with mortals, leading to the birth of heroes.",
                            "target_lang_translations": {
                                "ru": "В древних сказаниях боги часто <w>вступали в связь</w> с простыми смертными, что приводило к рождению героев."
                            }
                        }
                    ],
                    "synonyms": [
                        "copulate",
                        "mate",
                        "have sex"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "A historical euphemism for sexual relations."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вступать в половую связь (устаревший эвфемизм)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сойтись",
                                "target_lang_sense_clarification": "вступить в связь"
                            },
                            {
                                "target_lang_word": "вступать в связь",
                                "target_lang_sense_clarification": "интимную"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}