                        ],
                        "form": "minified"
                    },
                    {
                        "form_id": "29f2733f-9746-49ae-a0c7-cf460a073693",
                        "entry_id": "2f9d49e6-de3b-317a-a4b6-50910e596466",
                        "tags": [
                            "past"
                        ],
                        "form": "minified"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ff62df79-610a-35cb-9f2d-e9561d68c085",
                        "entry_id": "2f9d49e6-de3b-317a-a4b6-50910e596466",
                        "glosses": [
                            "To make smaller."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "83d4c008-5841-48ce-8347-bed99ac0672b",
                                "sense_id": "ff62df79-610a-35cb-9f2d-e9561d68c085",
                                "text": "Schneckenburger strives to make it appear that Baur unduly minifies the Christian element in Manichæism."
                            },
                            {
                                "example_id": "078eae51-9f10-459b-91c5-5c507bf4bb78",
                                "sense_id": "ff62df79-610a-35cb-9f2d-e9561d68c085",
                                "text": "There must be something in the appeal of the Gothic that minifies one group of values leaving other considerations untouched, or actually magnifying them."
                            }
                        ]
                    },
                    {
                        "sense_id": "8e84d574-99ed-3f7e-ba72-d385481af54c",
                        "entry_id": "2f9d49e6-de3b-317a-a4b6-50910e596466",
                        "glosses": [
                            "To reduce in apparent size, as for example objects viewed through a lens or mirror shaped so as to increase the field of view, such as a convex or aspheric mirror or a Fresnel lens."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b8d2934-bdfb-4055-879f-2ed45194a2ce",
                                "sense_id": "8e84d574-99ed-3f7e-ba72-d385481af54c",
                                "text": "But, mused Parker, this theory of one's perplexities being diminished by the vastly superior height of these Gothic arches cannot have any foundation in fact, for the same inverted telescope that minifies my burdens also minifies my capacity to carry them, leaving me exactly of the same stature as before."
                            }
                        ]
                    },
                    {
                        "sense_id": "2664fccf-0752-39b5-aa8d-d03328357ddc",
                        "entry_id": "2f9d49e6-de3b-317a-a4b6-50910e596466",
                        "glosses": [
                            "To remove white space and unnecessary characters from source code in order to reduce its size."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "06f250be-e056-440e-95bd-cc99f8b60deb",
                                "sense_id": "2664fccf-0752-39b5-aa8d-d03328357ddc",
                                "text": "When code is minified, all comments are removed, as well as unneeded whitespace characters (space, newline, and tab)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7ad9f921-4ca5-4907-8d14-ddac58338a95",
                        "source_entry_id": "2f9d49e6-de3b-317a-a4b6-50910e596466",
                        "source_sense_description": "to make smaller",
                        "target_lang_word": "verkleinern",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verkleinern",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "218269a3-3648-3fd0-9243-7c3e454982c4",
                                        "entry_id": "29ce01a7-7d8d-3a81-a99d-8a73d5793d01",
                                        "glosses": [
                                            "die Größe von etwas verringern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a24529d-be6c-4fb6-866b-cf4eb5f79653",
                                                "sense_id": "218269a3-3648-3fd0-9243-7c3e454982c4",
                                                "text": "„Bei stark übergewichtigen Menschen können Chirurgen den Magen verkleinern, damit weniger Nahrung hineinpasst.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ebc67543-c748-3ed4-bf43-7d008f6ea3f7",
                                        "entry_id": "29ce01a7-7d8d-3a81-a99d-8a73d5793d01",
                                        "glosses": [
                                            "die Menge/Anzahl von etwas verringern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d22b0e69-ac41-4e1b-abf5-ed5f3d22df92",
                                                "sense_id": "ebc67543-c748-3ed4-bf43-7d008f6ea3f7",
                                                "text": "Wir mussten die Anzahl der Sitzplätze verkleinern, aber nun gibt es auch mehr Beinfreiheit."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "0eff47fe-703f-34aa-b341-3afb98a79977",
                                        "entry_id": "29ce01a7-7d8d-3a81-a99d-8a73d5793d01",
                                        "glosses": [
                                            "kleiner als das Original erscheinen lassen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6412fc51-019c-4a40-86af-7a8e07516e35",
                                                "sense_id": "0eff47fe-703f-34aa-b341-3afb98a79977",
                                                "text": "Wenn man durch diese Linse schaut, wirkt die Landschaft verkleinert."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "4c7263b6-b18e-3890-aea3-7aa64751ef10",
                                        "entry_id": "29ce01a7-7d8d-3a81-a99d-8a73d5793d01",
                                        "glosses": [
                                            "sich mit weniger Platz arrangieren"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0c558b17-14fa-4208-b878-0c3615b06b68",
                                                "sense_id": "4c7263b6-b18e-3890-aea3-7aa64751ef10",
                                                "text": "Nun, wo die Kinder aus dem Haus sind, werden wir uns wohl verkleinern."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "02d03f11-a879-3b52-b003-81c17edf28d8",
                                        "entry_id": "29ce01a7-7d8d-3a81-a99d-8a73d5793d01",
                                        "glosses": [
                                            "den Wert einer Sache/Leistung geringer erscheinen lassen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b4755ae9-5db9-4d8a-9f13-d5edae76fc20",
                                                "sense_id": "02d03f11-a879-3b52-b003-81c17edf28d8",
                                                "text": "Aus reinem Neid verkleinerst du seinen Erfolg!"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
