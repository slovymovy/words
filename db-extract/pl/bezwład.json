                        "source_entry_id": "6e6518f4-539c-36ca-b1ba-5d3806f68cf2",
                        "source_sense_id": "f9c40d70-271f-3190-b5ab-1cd645e8b8fb",
                        "target_lang_word": "inertia",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inertia",
