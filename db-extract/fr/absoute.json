                                        "entry_id": "05f06221-ce6c-3508-a46d-c1e4b72c5304",
                                        "glosses": [
                                            "een plechtigheid na een uitvaartmis waarin voor de overledene om kwijtschelding van straf wordt gebeden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
