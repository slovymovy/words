    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f38542c0-68bb-3feb-af59-ec42d54ad9e8",
                    "sense_definition": "het voortdurend of haastig rennen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dat was een heel <w>geren</w> om de trein nog op tijd te halen.",
                            "target_lang_translations": {
                                "en": "That was quite a <w>rush</w> to catch the train on time."
                            }
                        },
                        {
                            "text": "Ik word altijd een beetje moe van al dat <w>geren</w> van hot naar her.",
                            "target_lang_translations": {
                                "en": "I always get a bit tired of all that <w>running around</w> from pillar to post."
                            }
                        }
                    ],
                    "synonyms": [
                        "draven",
                        "hollen"
                    ],
                    "common_phrases": [
                        "een heel geren"
                    ],
                    "target_lang_definitions": {
                        "en": "the continuous, frantic, or hasty running and rushing about"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "running around",
                                "target_lang_sense_clarification": "hasty rushing about"
                            },
                            {
                                "target_lang_word": "rushing",
                                "target_lang_sense_clarification": "hectic movement"
                            },
                            {
                                "target_lang_word": "dashing around",
                                "target_lang_sense_clarification": "continuous hurried running"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6513cfc1-145f-333e-bb35-94b7e1500dc3",
                    "sense_definition": "meervoud van het zelfstandig naamwoord <w>geer</w>",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De naaister knipte meerdere <w>geren</w> uit de stof om de rok wijder te maken.",
                            "target_lang_translations": {
                                "en": "The seamstress cut several <w>gores</w> from the fabric to make the skirt wider."
                            }
                        },
                        {
                            "text": "Deze traditionele zeilen zijn samengesteld uit verschillende schuine <w>geren</w>.",
                            "target_lang_translations": {
                                "en": "These traditional sails are made up of several diagonal <w>cloth panels</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "meervoudsvorm"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "plural of 'geer': triangular or tapering pieces of cloth or material (gores or gussets)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "gores",
                                "target_lang_sense_clarification": "triangular pieces of fabric in sewing"
                            },
                            {
                                "target_lang_word": "gussets",
                                "target_lang_sense_clarification": "insets of cloth"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "68f4075b-2b90-3f3c-9e4f-5e033b5fe30a",
                    "sense_definition": "schuin toelopen of schuin uitlopen",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "snijden_kleding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij kocht een elegante rok die naar beneden toe mooi bleek te <w>geren</w>.",
                            "target_lang_translations": {
                                "en": "She bought an elegant skirt that turned out to <w>flare</w> nicely towards the bottom."
                            }
                        },
                        {
                            "text": "Het patroon laat het kledingstuk vanaf de taille subtiel <w>geren</w>.",
                            "target_lang_translations": {
                                "en": "The pattern makes the garment <w>flare</w> subtly from the waist."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to flare, taper, or slant diagonally (especially of clothing/fabric)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "flare",
                                "target_lang_sense_clarification": "widen gradually downwards"
                            },
                            {
                                "target_lang_word": "taper",
                                "target_lang_sense_clarification": "slant or narrow gradually"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "54d55dd2-5373-3624-a89e-da87fe527f7d",
                    "sense_definition": "spits toelopende stukken stof in een kledingstuk inzetten",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "snijden_kleding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij besloot de jurk te <w>geren</w> zodat deze aan de onderkant wijder zou vallen.",
                            "target_lang_translations": {
                                "en": "She decided to <w>gore</w> the dress so that it would drape wider at the hem."
                            }
                        },
                        {
                            "text": "De kleermaker moest het patroon <w>geren</w> om de gewenste vorm te bereiken.",
                            "target_lang_translations": {
                                "en": "The tailor had to <w>add gores to</w> the pattern to achieve the desired shape."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to insert gores or tapering pieces of fabric into a garment"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "gore",
                                "target_lang_sense_clarification": "insert triangular pieces into a garment"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "600f060b-88bc-3569-8ed2-b9ab010e8a37",
                    "sense_definition": "sterk begeren of verlangen naar",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het oude schilderij was een kunstwerk dat vele verzamelaars ten zeerste <w>geerden</w>.",
                            "target_lang_translations": {
                                "en": "The old painting was a work of art that many collectors deeply <w>desired</w>."
                            }
                        },
                        {
                            "text": "Zij kon die zeldzame boeken nauwelijks meer <w>geren</w> dan zij al deed.",
                            "target_lang_translations": {
                                "en": "She could hardly <w>covet</w> those rare books more than she already did."
                            }
                        }
                    ],
                    "synonyms": [
                        "begeren"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "verouderd woord voor begeren"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to strongly desire, crave, or covet (archaic)"
                    },
                    "translations": {
