                ],
                "senses": [
                    {
                        "sense_id": "dd814250-1afb-3660-bc45-e6b92b38e24e",
                        "entry_id": "519e399f-a863-3183-8164-ab9c86427e67",
                        "glosses": [
                            "to construct something anew, or in a different manner"
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "12eb7148-9a83-4538-9852-85754205ae18",
                                "sense_id": "dd814250-1afb-3660-bc45-e6b92b38e24e",
                                "text": "The public execution, then, has a juridico-political function. It is a ceremonial by which a momentarily injured sovereignty is reconstituted. It restores that sovereignty by manifesting it at its most spectacular."
                            }
                        ]
                    },
                    {
                        "sense_id": "f2b55795-f1c3-3579-8f3e-31416654971e",
                        "entry_id": "519e399f-a863-3183-8164-ab9c86427e67",
                        "glosses": [
                            "to add liquid to a concentrated or dehydrated food to return it to its original consistency"
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cd960369-83c2-47aa-b290-7420d6e3824b",
                        "source_entry_id": "519e399f-a863-3183-8164-ab9c86427e67",
                        "source_sense_description": "to constitute again",
                        "target_lang_word": "einweichen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "einweichen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "eeeef89b-bd21-3a09-9410-4cf2e65e9ef3",
                                        "entry_id": "c628ecec-d950-3c8b-bb63-79eb141fb028",
                                        "glosses": [
                                            "zwecks Quellung in Wasser legen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4db53d5e-cbc6-4ee7-ac4c-6f6fbba11cc0",
                                                "sense_id": "eeeef89b-bd21-3a09-9410-4cf2e65e9ef3",
                                                "text": "„Muss man Emmer einweichen?“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "caa0d104-942b-316d-9cef-f266eb0a1f09",
                                        "entry_id": "c628ecec-d950-3c8b-bb63-79eb141fb028",
                                        "glosses": [
                                            "(Wäsche) zwecks Schmutzlösung in Lauge legen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "40446e0a-0bf6-46a4-9bec-32113d914489",
                                                "sense_id": "caa0d104-942b-316d-9cef-f266eb0a1f09",
                                                "text": "„Mit der weggelaufenen [Lauge] wollte sie ja eigentlich auch die nächste Wäsche einweichen.“"
                                            },
                                            {
                                                "example_id": "965e7025-06fe-42ac-ab55-df02794faa51",
                                                "sense_id": "caa0d104-942b-316d-9cef-f266eb0a1f09",
                                                "text": "„Die zu reinigenden Gegenstände werden in lauwarmem Wasser einige Stunden eingeweicht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "f4643c16-31a9-3766-beda-b35cc79d7217",
                                        "entry_id": "c628ecec-d950-3c8b-bb63-79eb141fb028",
                                        "glosses": [
                                            "zwecks Quellung oder Schmutzlösung in Wasser liegen"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ecd011fd-e97f-4633-8f10-ff31c549a4c7",
                                                "sense_id": "f4643c16-31a9-3766-beda-b35cc79d7217",
                                                "text": "„Die Kichererbsen am Vortag gut waschen und in der doppelten Menge Wasser über Nacht einweichen lassen.“"
                                            },
                                            {
                                                "example_id": "f2d2f5ef-d4ee-4fff-b601-bdb18cb93b1b",
                                                "sense_id": "f4643c16-31a9-3766-beda-b35cc79d7217",
                                                "text": "„Wenn die Zeit knapp ist, können Sie Nüsse, Samen, Körner oder Bohnen in eine Schüssel mit kochendem Wasser geben (das Einweichgut sollte bedeckt sein) und 15–20 Minuten einweichen lassen.“"
                                            },
                                            {
                                                "example_id": "c3892a2d-1200-4066-bffc-369bd638c67c",
                                                "sense_id": "f4643c16-31a9-3766-beda-b35cc79d7217",
                                                "text": "„Tun Sie sie in einen Topf, bedecken Sie sie mindestens 2,5 cm hoch mit kaltem Wasser und kochen Sie sie auf hoher Flamme auf; nehmen Sie sie anschließend vom Feuer, decken Sie sie zu und lassen Sie sie 1 Stunde lang einweichen.“"
                                            },
                                            {
                                                "example_id": "6966f692-71db-461d-b234-986efdde3dc2",
                                                "sense_id": "f4643c16-31a9-3766-beda-b35cc79d7217",
                                                "text": "„Während er geschlafen hatte, hatte sie seine und ihre dreckige Wäsche einweichen lassen.“"
                                            },
                                            {
                                                "example_id": "9fd676c4-f077-4938-9794-d83104d8b478",
                                                "sense_id": "f4643c16-31a9-3766-beda-b35cc79d7217",
                                                "text": "„Den Topf vom Herd ziehen und die Dörrpflaumen im Sud über Nacht einweichen lassen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
