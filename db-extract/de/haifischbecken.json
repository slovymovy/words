                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "5f3da18c-dc32-429f-ada3-24448a851964",
                                "sense_id": "4c1e456a-a8d9-356f-bc68-80958029f575",
                                "text": "„Mugabe lernte früh, dass im Haifischbecken der ZANU nur überleben konnte, wer selbst Zähne im Gesicht trug.“"
                            },
                            {
                                "example_id": "43bd74ff-01e4-4ab4-811a-e1fc85cbb4ab",
                                "sense_id": "4c1e456a-a8d9-356f-bc68-80958029f575",
                                "text": "„Der Täter muss aus einem anderen Umfeld stammen. Die Musikbranche. Sie ist ein Haifischbecken. Sie werden dort nach einem Verdächtigen suchen.“"
                            }
                        ],
