                "senses": [
                    {
                        "sense_id": "9f79d7ba-c2b2-338e-9e8f-472f61a7a6c9",
                        "entry_id": "77f2b032-3aef-3e57-aa16-10bd26037f29",
                        "glosses": [
                            "A twenty-year period"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "34d60d47-4835-46f8-b534-d7b00d1d5144",
                                "sense_id": "9f79d7ba-c2b2-338e-9e8f-472f61a7a6c9",
                                "text": "The maps are presented at 20-year intervals (vicennials) because of the nature of the data, particularly for years prior to 1960 when estimation procedures were not nearly as developed as today."
                            }
                        ]
                    },
                    {
                        "sense_id": "e5cbc194-6c46-3ad4-b4a5-a74b390c12aa",
                        "entry_id": "77f2b032-3aef-3e57-aa16-10bd26037f29",
                        "glosses": [
                            "A twentieth anniversary, particularly"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb79463b-54e5-40ab-b703-c343ecce590e",
                                "sense_id": "e5cbc194-6c46-3ad4-b4a5-a74b390c12aa",
                                "text": "Among the well established anniversaries celebrated by Chautauqua classes from year to year are the vicennials. A strong sense of comradeship is developed among members who come to Chautauqua twenty years after graduation..."
                            }
                        ]
                    },
                    {
                        "sense_id": "618eb11c-a2fb-3253-bfe8-b8a288005e38",
                        "entry_id": "77f2b032-3aef-3e57-aa16-10bd26037f29",
                        "glosses": [
                            "A twentieth anniversary, particularly",
                            "Synonym of vicennalia, the festival and religious ritual held in the 20th year of a Roman emperor's reign."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "0c2c28ec-df09-4b9e-8c9b-221c84334a5f",
                                "sense_id": "618eb11c-a2fb-3253-bfe8-b8a288005e38",
                                "text": "The feast of Constantine's vicennials fell on the 25th of July this year: it was the commencement of the twentieth year of his reign. It is supposed, that to avoid interrupting affairs or greater moment, this ceremony was deferred till the end of the council, which broke up the 25th of August."
                            },
                            {
                                "example_id": "dc57164f-ddc3-4a96-912e-bd6261c6b164",
                                "sense_id": "618eb11c-a2fb-3253-bfe8-b8a288005e38",
                                "text": "Roman coins mentioning the vota publica for Macrinus are RIC IV.1 5–13; on vota publica for the decennials and vicennials of emperors in the 2nd and 3rd c. ad, see Chastagnol 1984."
                            }
                        ]
                    }
                ],
