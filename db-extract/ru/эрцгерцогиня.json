                            {
                                "example_id": "5122d54c-68d0-4d08-a3bf-cae08c9ee235",
                                "sense_id": "23212a72-1aa6-37b2-b0c2-9f59c1b25154",
                                "text": "Камергер императрицы приглашал его к её величеству. Эрцгерцогиня тоже желала его видеть."
                            }
                        ]
                    }
                ],
