                ],
                "senses": [
                    {
                        "sense_id": "e73c2f64-22b5-33a4-ad89-28bfae11c149",
                        "entry_id": "d4626d3c-428c-3771-978f-5ac22410eff8",
                        "glosses": [
                            "hochentwickelter Staat mit einer modernen und für die Wirtschaft des Landes bedeutenden Industrie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "727346bc-575b-4d02-9638-4276b4ce0d32",
                                "sense_id": "e73c2f64-22b5-33a4-ad89-28bfae11c149",
                                "text": "„Die Industriestaaten der Welt nutzen Afrika als kostengünstigen Rohstofflieferanten, lukrativen Absatzmarkt und nicht zuletzt als gigantische Müllhalde schwer zu entsorgender Wohlstandsprodukte.“"
                            },
                            {
                                "example_id": "57a49aeb-9fb4-414f-bb20-c3dfa16a407f",
                                "sense_id": "e73c2f64-22b5-33a4-ad89-28bfae11c149",
                                "text": "„Im ausgehenden 19. Jahrhundert verbreitete sich eugenisches Gedankengut in allen Industriestaaten.“"
                            },
                            {
                                "example_id": "2f5b3f5a-289e-4a33-8b8a-3bc2164f20d5",
                                "sense_id": "e73c2f64-22b5-33a4-ad89-28bfae11c149",
                                "text": "„Zum 1. Januar 1997 wurde die Vermögenssteuer zwar nicht abgeschafft, aber sie wird einfach nicht mehr erhoben. Damit steht Deutschland unter den Industriestaaten ziemlich alleine da – und schenkt Reichen geschätzte acht Milliarden Euro im Jahr.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
