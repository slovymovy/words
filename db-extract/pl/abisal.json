                "translations": [
                    {
                        "translation_id": "294dc40a-f5cf-4d68-abb3-e5b89eca1577",
                        "source_entry_id": "884a0946-a3b4-3010-ad24-6f099c33f55c",
                        "source_sense_id": "7eda66e5-66d4-32fd-b86e-8827629dd4dd",
                        "source_sense_description": "Geografie: tiefste Region eines Ozeans, Meeres; Abyssal",
                        "target_lang_word": "Abyssal",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Abyssal",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "be479867-ba7f-3f8e-8c9e-e06fc1ec3fc6",
                                        "entry_id": "b5be6b77-01db-3357-8025-3b5523e72e69",
                                        "glosses": [
                                            "die Tiefsee unterhalb der durchlichteten Stufe bis hin zum Meeresgrund"
                                        ],
                                        "tags": [
                                            "Biogeographie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6d42094a-80c5-4c37-80bd-639fb2c7cd1c",
                                                "sense_id": "be479867-ba7f-3f8e-8c9e-e06fc1ec3fc6",
                                                "text": "„Von den drei Großlebensräumen des Meeres – Litoral, Pelagial, Abyssal zeigt das Litoral …, dessen Tiere und Pflanzen eng an den Küstenbereich gebunden sind, eine dem Festland vergleichbare, biogeographische Gliederung. Dagegen ist eine solche im Pelagial und Abyssal infolge des Fehlens langdauernder Schranken kaum ausgebildet.“"
                                            },
                                            {
                                                "example_id": "c87ae9e1-0a43-4162-980c-d3f89ff6893b",
                                                "sense_id": "be479867-ba7f-3f8e-8c9e-e06fc1ec3fc6",
                                                "text": "„Das Abyssal … ist der bei weitem größte und bisher am wenigsten erforschte Lebensbereich auf der Erde. Er läßt sich durch den völligen Lichtmangel, der das Fehlen photoautotropher Pflanzen zur Folge hat, und niedrige, relativ gleichbleibende Temperaturen, schließlich durch Nahrungsarmut, tiefenwärts zunehmenden Wasserdruck gut charakterisieren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
