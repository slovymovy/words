                        ],
                        "examples": [
                            {
                                "example_id": "d19a7ac7-c96b-420e-bcfe-7d202e6f2a01",
                                "sense_id": "257318f5-24fe-339b-8338-89aca1e7e0e0",
                                "text": "„der wirt erkante den ritter rôt: er dersiufte, in derbarmt sîn nôt.“"
                            },
                            {
                                "example_id": "212684c1-0fa5-4e5a-9dc9-3413e18a06d7",
                                "sense_id": "257318f5-24fe-339b-8338-89aca1e7e0e0",
                                "text": "„ëz mehte Got derbarmen“"
                            },
                            {
                                "example_id": "237de2d7-3b01-4c84-ace3-5a684ce50d17",
                                "sense_id": "257318f5-24fe-339b-8338-89aca1e7e0e0",
                                "text": "„»Du derbarmst mir, Steffel.«“"
                            },
                            {
                                "example_id": "43193ebc-b329-4ff9-b1fb-74c9ad4dd422",
                                "sense_id": "257318f5-24fe-339b-8338-89aca1e7e0e0",
                                "text": "„Das eine Mal möcht man vor Grausen auf und davon laufen, und im nächsten Augenblick derbarmst mir wieder.“"
                            },
                            {
                                "example_id": "dffaf573-25ce-41b4-ba3c-7380651907d2",
                                "sense_id": "257318f5-24fe-339b-8338-89aca1e7e0e0",
                                "text": "„Jessas, die arme Frau, wie die mir derbarmt!“"
                            },
                            {
                                "example_id": "20cf9564-0705-4901-9932-02dcfc20415b",
                                "sense_id": "257318f5-24fe-339b-8338-89aca1e7e0e0",
                                "text": "„Do konn mi mei Belli, mei arma, mei bsuffna, nimma dabarma.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
