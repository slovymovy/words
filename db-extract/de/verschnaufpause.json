                "senses": [
                    {
                        "sense_id": "6e8a3682-5dbe-3726-895d-63a886a2acc4",
                        "entry_id": "6167f326-f359-33c5-9b38-0026a14e531b",
                        "glosses": [
                            "Pause, um sich kurz zu regenerieren und Luft zu schöpfen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0e846a1-7178-4008-9e7f-8745ec805b3c",
                                "sense_id": "6e8a3682-5dbe-3726-895d-63a886a2acc4",
                                "text": "Nach dreißig Minuten Ausdauerlauf brauchte er dringend eine Verschnaufpause."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "b405f953-2c82-3d05-aa83-1914bf535619",
                        "entry_id": "6167f326-f359-33c5-9b38-0026a14e531b",
                        "glosses": [
                            "No glosses available"
                        ],
                        "tags": [
                            "no-gloss"
                        ],
                        "examples": [
                            {
                                "example_id": "1d4f924f-76be-43e8-90d8-72dfb7e2853f",
                                "sense_id": "b405f953-2c82-3d05-aa83-1914bf535619",
                                "text": "„Jetzt, siegestrunken und mit einer Verschnaufpause bedacht, hatten die Deutschen wieder Zeit, um sich erneut mit uns zu befassen, obwohl man nicht sagen kann, daß sie uns während der Kämpfe im Westen ganz vergessen hätten.“"
                            },
                            {
                                "example_id": "805c395f-d016-4f96-9acf-896f994d0eab",
                                "sense_id": "b405f953-2c82-3d05-aa83-1914bf535619",
                                "text": "„Zum Jahresauftakt 2025 gab es eine kurze Verschnaufpause [des öffentlichen Konsums], die im Zusammenhang mit der vorläufigen Haushaltsführung des Bundes stehen dürfte.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "668c3490-9c9d-4182-ac15-5501c9e5faa4",
                        "source_entry_id": "6167f326-f359-33c5-9b38-0026a14e531b",
                        "source_sense_id": "6e8a3682-5dbe-3726-895d-63a886a2acc4",
                        "source_sense_description": "Pause, um sich kurz zu regenerieren und Luft zu schöpfen",
                        "target_lang_word": "breather",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "breather",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5aa79003-ce5b-3055-8d69-8beb1ce917a3",
                                        "entry_id": "76d44634-8755-3d78-8664-7fc2376285a0",
                                        "glosses": [
                                            "Something or someone that breathes."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "67f7697f-848f-3de6-97a8-aaf8d878eac5",
                                        "entry_id": "76d44634-8755-3d78-8664-7fc2376285a0",
                                        "glosses": [
                                            "A heavy breather."
                                        ],
                                        "tags": [
                                            "specifically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "be1f9628-8a1b-41ee-a7a2-cdd5671f9117",
                                                "sense_id": "67f7697f-848f-3de6-97a8-aaf8d878eac5",
                                                "text": "Most of us make sense of the world through talk and sight, and breathers represent that most anxiety provoking experience, nothingness with a hint of possibility."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "22527e13-f840-38d5-ad48-609c10c7b666",
                                        "entry_id": "76d44634-8755-3d78-8664-7fc2376285a0",
                                        "glosses": [
                                            "A short break; a rest or respite."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6fe9bacf-18a8-4b43-a797-e7e9b6d8592a",
                                                "sense_id": "22527e13-f840-38d5-ad48-609c10c7b666",
                                                "text": "After a short breather she was ready to continue up the hill."
                                            },
                                            {
                                                "example_id": "3ae6d589-fe28-46b9-9176-e14f0d9da151",
                                                "sense_id": "22527e13-f840-38d5-ad48-609c10c7b666",
                                                "text": "I took a breather and decided not to ruin my life"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "855648fd-96e1-3a1f-ac42-300f3506bd3b",
                                        "entry_id": "76d44634-8755-3d78-8664-7fc2376285a0",
                                        "glosses": [
                                            "A spatially localized, time-periodic excitation in a one-dimensional lattice."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f8a9bb7d-414a-30d6-975c-a831701e78b9",
                                        "entry_id": "76d44634-8755-3d78-8664-7fc2376285a0",
                                        "glosses": [
                                            "That which puts one out of breath, such as violent exercise."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "dated"
                                        ],
