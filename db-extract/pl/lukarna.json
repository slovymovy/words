                ],
                "senses": [
                    {
                        "sense_id": "775f5e84-982c-310b-b9e0-8412323047bb",
                        "entry_id": "b1bd5841-b300-387b-ab13-359bd4ea5a3e",
                        "glosses": [
                            "pionowe okienko na dachu, które doświetla poddasze"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d87bbeda-8534-45fb-a4d6-141c4fca8c51",
                                "sense_id": "775f5e84-982c-310b-b9e0-8412323047bb",
                                "text": "Ściany zdobi wapienny kamień, a lukarny ozdobione są herbami: Jana Pawła II, zakonu paulinów i znakiem maryjnym"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7ce28adb-d846-475b-b4c9-287a4a3d0650",
                        "source_entry_id": "b1bd5841-b300-387b-ab13-359bd4ea5a3e",
                        "source_sense_id": "775f5e84-982c-310b-b9e0-8412323047bb",
                        "target_lang_word": "dormer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dormer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9f9e3555-6d3e-3f6b-a63e-839f326ef87a",
                                        "entry_id": "3927414c-f736-3345-bc02-7661f2161e99",
                                        "glosses": [
                                            "A room-like, roofed projection from a sloping roof."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "97329ea4-3f96-4439-8830-d42030527a52",
                                                "sense_id": "9f9e3555-6d3e-3f6b-a63e-839f326ef87a",
                                                "text": "Then we came to a high white wall that surrounded a large garden, and within it was a long, massive building of some beauty and pretension, with a high, latticed belfry and heavy walls and with arched dormers in the sloping roof."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "050bfcac-2ae5-3235-8069-66a33a2fb9ff",
                                        "entry_id": "3927414c-f736-3345-bc02-7661f2161e99",
                                        "glosses": [
                                            "Ellipsis of dormer-window."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "ellipsis"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "dormer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bc60e3cc-e616-31c1-913a-60a164417a74",
                                        "entry_id": "713a78df-702e-33b1-928c-aa50b9c0fa30",
                                        "glosses": [
                                            "A resident of a dormitory."
                                        ],
                                        "tags": [
                                            "Philippines"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5b383b7a-02a6-4711-9a6d-ddbb53559e66",
                                                "sense_id": "bc60e3cc-e616-31c1-913a-60a164417a74",
                                                "text": "My dorm mates and I had a little get-together in our room on the second floor. We were just talking and weren't making much noise when we heard a knock on our door. It was a dormer from the room directly below us. She asked if we were cleaning and we told her that we weren't. She left but came back a little while later and asked the same question again. We asked her if our matron wants us to clean up. The dormer said no and left. But after a few minutes, she came up again and again asked if we were cleaning our room because she could hear the noise down in her room."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e2197f53-b5b0-439e-a0f1-a69cb218c54f",
                        "source_entry_id": "b1bd5841-b300-387b-ab13-359bd4ea5a3e",
                        "source_sense_id": "775f5e84-982c-310b-b9e0-8412323047bb",
                        "target_lang_word": "lucarne",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lucarne",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a9183fb3-5da3-3451-96ea-0f0f4e11a75b",
                                        "entry_id": "cc8062ed-ba09-3262-a2d9-08b48faaacde",
                                        "glosses": [
                                            "Fenêtre pratiquée dans le toit ou dans le haut d’une maison."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "361a69da-60a9-4dc4-b4f3-aee68c8dc06c",
                                                "sense_id": "a9183fb3-5da3-3451-96ea-0f0f4e11a75b",
                                                "text": "Or, il faut savoir qu’il n’y avait pas, dans toute l’hôtellerie, une seule fenêtre qui donnât sur les champs, mais uniquement une lucarne de grenier par laquelle on jetait la paille dehors."
                                            },
                                            {
                                                "example_id": "dd266d19-da81-450a-b066-82551d7d1f04",
                                                "sense_id": "a9183fb3-5da3-3451-96ea-0f0f4e11a75b",
                                                "text": "Une toute jeune fille était debout dans la porte entrebâillée. La lucarne du galetas où le jour paraissait était précisément en face de la porte et éclairait cette figure d’une lumière blafarde."
                                            },
                                            {
                                                "example_id": "a12a9233-4cd8-46d8-be56-7107be6cd8bf",
                                                "sense_id": "a9183fb3-5da3-3451-96ea-0f0f4e11a75b",
                                                "text": "L’unique lucarne du logement donnait sur la cour des Folies-Montparnasse."
                                            },
                                            {
                                                "example_id": "8b37333c-e5d1-46f6-87af-3e0b798fbdb5",
                                                "sense_id": "a9183fb3-5da3-3451-96ea-0f0f4e11a75b",
                                                "text": "D’une lucarne, dans le haut du mur, je voyais la nuit s’éclaircir. J’entendis un coq chanter."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e00fd41b-e8dc-31ac-9f9d-e1b5ca6f3861",
                                        "entry_id": "cc8062ed-ba09-3262-a2d9-08b48faaacde",
                                        "glosses": [
                                            "Chacun des deux angles supérieurs que forment les poteaux des buts avec la barre transversale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "27905434-054b-42b6-b69b-7cfa56230f87",
                                                "sense_id": "e00fd41b-e8dc-31ac-9f9d-e1b5ca6f3861",
                                                "text": "L’attaquant rennais se remet sur son pied droit, à cinq mètres de la surface et déclenche une frappe surpuissante au second poteau en pleine lucarne."
                                            },
                                            {
                                                "example_id": "8d2ca9bf-5bad-490f-a6d8-68b0cdc5c894",
                                                "sense_id": "e00fd41b-e8dc-31ac-9f9d-e1b5ca6f3861",
                                                "text": "Dimanche, son premier but, cette frappe puissante du plat du pied en plein dans la lucarne de Szczesny, n’est pas que beau."
                                            },
                                            {
                                                "example_id": "2b09b870-578c-47e0-bbb3-ad32efcffb5d",
                                                "sense_id": "e00fd41b-e8dc-31ac-9f9d-e1b5ca6f3861",
                                                "text": "Pour la photo, on préférera la praline glissée de Schär dans les arrêts de jeu, droit dans la lucarne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e7def75-5ca3-3ef1-83d3-e13444495e46",
                                        "entry_id": "cc8062ed-ba09-3262-a2d9-08b48faaacde",
                                        "glosses": [
                                            "But d’un gardien."
                                        ],
                                        "tags": [
                                            "Hockey sur glace"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "429a0415-6641-323e-9fa2-73675dd57ed3",
                                        "entry_id": "cc8062ed-ba09-3262-a2d9-08b48faaacde",
                                        "glosses": [
                                            "Dans une vidéo, petite vidéo insérée dans un coin de l’image principale, pour avoir deux vues en même temps."
                                        ],
                                        "tags": [
                                            "Audiovisuel"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7c3cb700-2401-4bb8-9e8f-fdff89038df5",
                                                "sense_id": "429a0415-6641-323e-9fa2-73675dd57ed3",
                                                "text": "Cette émission de cinéma montre un extrait de film où joue une actrice présente sur le plateau et, en lucarne, l’actrice que l’on voit réagir à son image."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": [
