                        "examples": [
                            {
                                "example_id": "db32c68d-9694-458a-b3e9-8358869031ca",
                                "sense_id": "9f09f98e-47f1-37ba-9d86-2c7e42eb776a",
                                "text": "„Der Abstand zwischen Objektivauﬂagefläche und der Bildebene, das sog. Auﬂagemaß, beträgt beim C-Mount-Objektiv 17,5 mm und beim CS-Mount-Objektiv 12,5 mm.“"
                            },
                            {
                                "example_id": "cc035079-e76c-4ff6-9c00-bf06d0c77f25",
                                "sense_id": "9f09f98e-47f1-37ba-9d86-2c7e42eb776a",
                                "text": "„Da sich durch Stöße, Temperaturänderungen etc. Abweichungen ergeben können, ist das Auflagemaß an der Kamera nach Lösen einer Arretierschraube korrigierbar.“"
                            }
                        ],
