                                        "sense_id": "a6f2b2c7-8de9-32c8-a0e8-d29fa8e4445f",
                                        "entry_id": "618b6cf1-41cf-3fcf-bc48-9b6583e20806",
                                        "glosses": [
                                            "D’une manière lugubre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca164b09-3683-4dd5-94a1-eb4aab18ad90",
                                                "sense_id": "a6f2b2c7-8de9-32c8-a0e8-d29fa8e4445f",
                                                "text": "Pierre se leva de table, sans un mot, et descendit au jardin ; le dîner s'acheva lugubrement."
                                            },
                                            {
                                                "example_id": "acd8ea03-cd4a-4567-a85d-7f7f0687cc3a",
                                                "sense_id": "a6f2b2c7-8de9-32c8-a0e8-d29fa8e4445f",
                                                "text": "Dans les airs obscurcis d’un voile de ténèbres, Pour toi l’airain sacré sonnait lugubrement."
                                            },
                                            {
                                                "example_id": "439cefcf-fd49-49c8-b1b9-5ea5b2a57ab4",
                                                "sense_id": "a6f2b2c7-8de9-32c8-a0e8-d29fa8e4445f",
                                                "text": "Un double coassement venu des palmes obscures de l’île peupla lugubrement le silence de l’équipage."
                                            },
                                            {
                                                "example_id": "280fabce-0797-441d-855e-b85b75d290e5",
                                                "sense_id": "a6f2b2c7-8de9-32c8-a0e8-d29fa8e4445f",
                                                "text": "Chanter lugubrement."
                                            },
                                            {
                                                "example_id": "391a694f-8399-4ce0-9b38-73dfe6e9b6dc",
                                                "sense_id": "a6f2b2c7-8de9-32c8-a0e8-d29fa8e4445f",
                                                "text": "Être vêtu lugubrement."
                                            }
                                        ]
                                    }
