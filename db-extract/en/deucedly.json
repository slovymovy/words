                "senses": [
                    {
                        "sense_id": "687f0ff8-f0e9-33bc-88ff-c78b0fb6bbed",
                        "entry_id": "55c5e4eb-1cbe-374d-bf6f-94976d191870",
                        "glosses": [
                            "Quite; extremely; utterly."
                        ],
                        "tags": [
                            "informal",
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "82b29b25-6845-4e8f-8dbf-c8de78346ae5",
                                "sense_id": "687f0ff8-f0e9-33bc-88ff-c78b0fb6bbed",
                                "text": "\"You know, Kaspar,\" said he, in conclusion, to the excited Almayer, \"it is deucedly awkward to have a half-caste girl in the house."
                            },
                            {
                                "example_id": "cdc1cb6d-3ae1-4519-b212-e50cd252ccb3",
                                "sense_id": "687f0ff8-f0e9-33bc-88ff-c78b0fb6bbed",
                                "text": "Then you load them deucedly badly,' said Lord Wellington."
                            },
                            {
                                "example_id": "911ff01a-d9b2-41e0-a55e-235965268c4a",
                                "sense_id": "687f0ff8-f0e9-33bc-88ff-c78b0fb6bbed",
                                "text": "Now I come to think of it, the case grows deucedly clear."
                            },
                            {
                                "example_id": "6211b5b8-f272-46fd-9f9e-2390056d2c53",
                                "sense_id": "687f0ff8-f0e9-33bc-88ff-c78b0fb6bbed",
                                "text": "\"Look above your head, Roger. Deucedly interesting, isn't it?\" \"Those insects, do you mean?\""
                            },
                            {
                                "example_id": "50f596c9-2a01-48f5-97dc-c7166634d551",
                                "sense_id": "687f0ff8-f0e9-33bc-88ff-c78b0fb6bbed",
                                "text": "“My dearest Nadja, you must be deucedly cross with me for my subterfuge. But you have Gizmo at your side, if he has not expired or drowned in his own filth during the transatlantic crossing.”"
                            }
                        ]
                    }
