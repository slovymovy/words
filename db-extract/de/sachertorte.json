                                "sense_id": "5d192acd-624d-33af-87b5-e8f8da951ca6",
                                "text": "Dies ist eine Original Sachertorte!"
                            },
                            {
                                "example_id": "26435522-12f1-4260-988b-f0bf38858ada",
                                "sense_id": "5d192acd-624d-33af-87b5-e8f8da951ca6",
                                "text": "Heute habe ich schon drei Stück Sachertorte in einer Konditorei gegessen."
                            },
                            {
                                "example_id": "630219f8-a31b-4b2c-8e01-ee87aa3a6f02",
                                "sense_id": "5d192acd-624d-33af-87b5-e8f8da951ca6",
                                "text": "„Das Hotel Sacher sei Namensgeberin nicht nur der Sachertorte, sondern auch der ‚Sacherwürstel‘.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
