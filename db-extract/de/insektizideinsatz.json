                "senses": [
                    {
                        "sense_id": "d67436c9-a203-3ce1-ac9c-d808d74eb617",
                        "entry_id": "7d37df1c-991c-3c0f-82fa-83a0fc0accf8",
                        "glosses": [
                            "Verwendung/Einsatz von Insektiziden zur Bekämpfung störender Insekten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e9e40ac8-cdc5-4195-ac0c-ea1090b82285",
                                "sense_id": "d67436c9-a203-3ce1-ac9c-d808d74eb617",
                                "text": "„Erscheinen die Tiere in den Fallen, so kann man daraus den exakten Zeitpunkt für den Insektizideinsatz bestimmen und unnötige Spritzungen vermeiden.“"
                            },
                            {
                                "example_id": "a5a95a84-22d1-4d75-bb95-8f2f24f664b4",
                                "sense_id": "d67436c9-a203-3ce1-ac9c-d808d74eb617",
                                "text": "„Seit den siebziger Jahren haben Bauern und Gärtner den Insektizideinsatz deutlich verringert.“"
                            },
                            {
                                "example_id": "fd922167-3afd-414c-9209-903ac69b9166",
                                "sense_id": "d67436c9-a203-3ce1-ac9c-d808d74eb617",
                                "text": "„Dagegen ist im tropischen Ackerbau der Insektizideinsatz beträchtlich höher, am höchsten bei Baumwolle, gefolgt von Reis.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
