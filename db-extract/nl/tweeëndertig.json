                            {
                                "example_id": "6be4b16d-ae3f-4768-8d67-50b029b0683c",
                                "sense_id": "21d269e8-2bd8-391f-92b7-2023fae92c7c",
                                "text": "Het is weer de tweeëndertig die het niet doet, kunnen we die niet simpel vervangen?"
                            },
                            {
                                "example_id": "d536b849-6da8-4a11-a48c-552a567b2a42",
                                "sense_id": "21d269e8-2bd8-391f-92b7-2023fae92c7c",
                                "text": "Haar drieëndertigste verjaardag was een belangrijk moment, want haar leven werd heel anders toen ze de tweeëndertig eenmaal voorbij was."
                            }
                        ]
                    },
                    {
                        "sense_id": "2ab67283-d22f-30b9-ab9a-3677026550d8",
