                ],
                "senses": [
                    {
                        "sense_id": "c60a179c-05fb-3506-85f8-11fcb261ea65",
                        "entry_id": "60fdc942-4982-390d-b958-ccfbf672419d",
                        "glosses": [
                            "To perform or repeat an action on each item in a set."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94bc9c35-85bb-4560-8a3b-10d41103f09c",
                                "sense_id": "c60a179c-05fb-3506-85f8-11fcb261ea65",
                                "text": "The max() function iterates through the data to find the highest value."
                            }
                        ]
                    },
                    {
                        "sense_id": "20771b66-5253-3bec-9111-2f51bd385901",
                        "entry_id": "60fdc942-4982-390d-b958-ccfbf672419d",
                        "glosses": [
                            "To perform or repeat an action on the results of each such prior action."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a0962d3-e67d-456d-b900-74ca354e2250",
                                "sense_id": "20771b66-5253-3bec-9111-2f51bd385901",
                                "text": "In mathematics, an iterated function is a function which is composed with itself, possibly ad infinitum, in a process called iteration."
                            }
                        ]
                    },
                    {
                        "sense_id": "6f32b2e6-a9f8-3a01-a075-d32e596248d3",
                        "entry_id": "60fdc942-4982-390d-b958-ccfbf672419d",
                        "glosses": [
                            "To utter or do a second time or many times; to repeat."
                        ],
                        "tags": [
                            "archaic",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "3cbd61de-3085-449e-a835-37fb941d47d5",
                                "sense_id": "6f32b2e6-a9f8-3a01-a075-d32e596248d3",
                                "text": "to iterate advice"
                            },
                            {
                                "example_id": "cdd64c0f-3ad7-4c60-b22a-dea17cebc8bb",
                                "sense_id": "6f32b2e6-a9f8-3a01-a075-d32e596248d3",
                                "text": "Nor Eve to iterate / Her former trespass feared."
                            },
                            {
                                "example_id": "5bf40528-ceb8-422e-b314-2f194ea708b8",
                                "sense_id": "6f32b2e6-a9f8-3a01-a075-d32e596248d3",
                                "text": "\"Where's your money?\" Jack exclaimed, hoarsely, in a well-feigned voice.\n\"Ah! where's the rowdy?\" iterated Clayton, in a tone it was impossible to conceal."
                            }
                        ]
                    },
                    {
                        "sense_id": "8c903129-5a6d-3e22-b7dc-95d32d823635",
                        "entry_id": "60fdc942-4982-390d-b958-ccfbf672419d",
                        "glosses": [
                            "To repeat an activity, making incremental changes each time."
                        ],
                        "tags": [
                            "ambitransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "bdcf59af-39b3-4b0b-841a-55f0acbb8526",
                                "sense_id": "8c903129-5a6d-3e22-b7dc-95d32d823635",
                                "text": "For NASA and most private aerospace companies, a single crash is a setback that can take years to recover from. SpaceX works more like a Silicon Valley startup, where the goal is to fail quickly and iterate."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5162102b-f347-442e-be26-e2ee97fb4015",
                        "source_entry_id": "60fdc942-4982-390d-b958-ccfbf672419d",
                        "source_sense_description": "To utter or do a second time",
                        "target_lang_word": "itérer",
