                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a9f1c149-24e7-4b1f-b755-699435be0092",
                                                "sense_id": "f5323ed4-bdbc-3d0a-8c89-8f531f2e9379",
                                                "text": "She was impressed by her friend's confidence to wear a thong on the crowded beach."
