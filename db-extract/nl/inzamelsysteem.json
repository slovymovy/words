                        "examples": [
                            {
                                "example_id": "593e0543-7016-493f-a334-e2cbfe190b7b",
                                "sense_id": "0371c4f9-e36b-357c-a3a6-72783bd17fdd",
                                "text": "De producenten van drankverpakkingen hoeven dat bedrag dus niet zelf in het inzamelsysteem te investeren. Hun financiële bijdrage werd per 2023 nog verlaagd met 11 procent voor grote plastic flessen en 13 procent voor kleine plastic flesjes."
                            },
                            {
                                "example_id": "460d2b32-cbec-4c2e-8575-9ff91f7594a8",
                                "sense_id": "0371c4f9-e36b-357c-a3a6-72783bd17fdd",
                                "text": "De supermarkten zeggen nog wel een nieuw, landelijk inzamelsysteem te willen opzetten. Daarmee moeten dan ook \"andere verpakkingen en producten\" ingezameld kunnen worden. Zo'n systeem is volgens het CBL nodig, omdat supermarkten niet oneindig het groeiend aantal retourverpakkingen in winkels kunnen opvangen."
                            }
                        ]
                    }
