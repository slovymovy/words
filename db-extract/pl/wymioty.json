                    {
                        "translation_id": "613202f2-ed4e-4752-856e-08be428a21aa",
                        "source_entry_id": "2bb3db94-98b1-3abf-a6a3-3ea31110b3bf",
                        "source_sense_id": "4e9a146c-a252-37c8-8ab8-ac209a7710f7",
                        "target_lang_word": "Erbrechen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Erbrechen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "175ebf9a-f89b-39a7-92ba-40e37430e57d",
                                        "entry_id": "9fae39f9-d446-3b28-8f5b-2ea1bce09106",
                                        "glosses": [
                                            "Entleerung des Magens über den Mund"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1cc4954-4c6b-43b9-a862-7dc3428657e8",
                                                "sense_id": "175ebf9a-f89b-39a7-92ba-40e37430e57d",
                                                "text": "Bei Magenbeschwerden kommt es oft auch zum Erbrechen."
                                            },
                                            {
                                                "example_id": "fc00c6ba-1e44-4eb5-94c7-62467e37777e",
                                                "sense_id": "175ebf9a-f89b-39a7-92ba-40e37430e57d",
                                                "text": "„Die ersten Anzeichen einer Vergiftung [mit Blausäure] sind Schwindelgefühl, Ohrensausen, Kopfschmerzen, Übelkeit und Erbrechen.“"
                                            },
                                            {
                                                "example_id": "f2845e44-8beb-4725-83da-d683ce187474",
                                                "sense_id": "175ebf9a-f89b-39a7-92ba-40e37430e57d",
                                                "text": "„Mir war zum Erbrechen übel.“"
                                            },
                                            {
                                                "example_id": "1f070e33-1439-4185-a81a-8af68ce26072",
                                                "sense_id": "175ebf9a-f89b-39a7-92ba-40e37430e57d",
                                                "text": "„Der Pfarrer brachte mich in das Seminar; aber auf halbem Weg ließ er die Gondel bei San Michele halten, weil mich ein solches Erbrechen befiel, daß ich zu ersticken meinte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2bba59b9-0af3-3ee0-8370-d2f679d80ba5",
                                        "entry_id": "9fae39f9-d446-3b28-8f5b-2ea1bce09106",
                                        "glosses": [
                                            "Öffnung eines verschlossenen Gegenstandes mit Gewalt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "87357c49-6d3b-46ca-be40-dd9009545b8d",
                                                "sense_id": "2bba59b9-0af3-3ee0-8370-d2f679d80ba5",
                                                "text": "„So war beispielsweise nur das Erbrechen des meisterlichen Siegels unter Strafe gestellt, doch wollten einige der Ältesten diesen Tatbestand auch auf das unbefugte Erbrechen des Siegels des Stellvertreters erweitern wegen des Schadens, der daraus entstehen konnte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a5be92b2-5e78-4285-9d24-ffb1ac5715a1",
                        "source_entry_id": "2bb3db94-98b1-3abf-a6a3-3ea31110b3bf",
                        "source_sense_id": "4e9a146c-a252-37c8-8ab8-ac209a7710f7",
                        "target_lang_word": "рвота",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "рвота",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "fc24af3b-2017-39eb-a4c8-dea634e587bb",
                                        "entry_id": "58cbbf1a-47fc-3464-93eb-7b4b20ef5fff",
                                        "glosses": [
                                            "непроизвольное извержение содержимого желудка (иногда вместе с содержимым кишечника) наружу через рот (реже и через нос)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "30e0f6cd-883a-40e7-855e-003e8d9245af",
                                                "sense_id": "fc24af3b-2017-39eb-a4c8-dea634e587bb",
                                                "text": "Он уверял, что заболел головною болью и рвотой на квартире у Гаганова, к которому забежал случайно ранним утром."
                                            },
                                            {
                                                "example_id": "b0b9581c-01a9-4f4f-b555-8734d3f72662",
                                                "sense_id": "fc24af3b-2017-39eb-a4c8-dea634e587bb",
                                                "text": "У неё сделалась головная боль, рвота, и она всё утро не могла встать с постели."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f8e4a599-c614-37cd-87ab-8f3066915f56",
                                        "entry_id": "58cbbf1a-47fc-3464-93eb-7b4b20ef5fff",
                                        "glosses": [
                                            "разг. масса, извергнутая таким образом"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "852a7cc4-8c68-4f8e-bb03-c21e87181082",
                                                "sense_id": "f8e4a599-c614-37cd-87ab-8f3066915f56",
                                                "text": "Она убрала таз со рвотой, вытерла его лицо влажным горячим полотенцем."
                                            },
                                            {
                                                "example_id": "1107b72e-376e-4a19-a53b-22baf0a9f253",
                                                "sense_id": "f8e4a599-c614-37cd-87ab-8f3066915f56",
                                                "text": "Щека, шея и подушка были запачканы рвотой."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
