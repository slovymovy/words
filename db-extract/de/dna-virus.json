                ],
                "senses": [
                    {
                        "sense_id": "bfd8281c-6746-3e21-8229-03d36bbc9b97",
                        "entry_id": "f8364353-7a65-3654-aa59-2decb1e526f4",
                        "glosses": [
                            "Krankheitserreger vom Typ Virus, dessen Erbgut/Genom aus einer DNA besteht"
                        ],
                        "tags": [
                            "Biochemie",
                            "Virologie"
                        ],
                        "examples": [
                            {
                                "example_id": "dbc56a65-81c0-406b-930c-677cb714bf70",
                                "sense_id": "bfd8281c-6746-3e21-8229-03d36bbc9b97",
                                "text": "„Viren unterscheiden sich unter anderem darin, in welcher Form ihr Erbmaterial, also die genetische Information des Virus, vorliegt. Bei DNA-Viren besteht das Erbmaterial dem Namen entsprechend aus DNA, also aus Desoxyribonukleinsäure.“"
                            },
                            {
                                "example_id": "09b54b5f-7440-4491-9f52-caf9a7ac7a69",
                                "sense_id": "bfd8281c-6746-3e21-8229-03d36bbc9b97",
                                "text": "„DNA-Viren replizieren typischerweise im Kern der Wirtszelle und RNA-Viren replizieren typischerweise im Zytoplasma.“"
                            },
                            {
                                "example_id": "d6f5bd2f-0ea1-4585-9e7b-04e6dfad38e5",
                                "sense_id": "bfd8281c-6746-3e21-8229-03d36bbc9b97",
                                "text": "„EBV ist schwer zu fassen, denn das DNA-Virus durchläuft in seinem Lebenszyklus verschiedene Phasen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
