                    "frequency": "Low",
                    "semantic_group_id": "textiel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De bruid droeg een prachtige sluier gemaakt van fijne witte <w>tul</w>.",
                            "target_lang_translations": {
