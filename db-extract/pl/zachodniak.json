                "senses": [
                    {
                        "sense_id": "c7f17a46-5bb8-3a8d-b8db-3203bfa851e5",
                        "entry_id": "d3929d40-cbb6-3ff7-97bb-a198ac4923d4",
                        "glosses": [
                            "mieszkaniec Zachodu, zachodniej części czegoś, np. Europy Zachodniej, Berlina Zachodniego itp."
                        ],
                        "tags": [
                            "colloquial",
                            "ironic"
                        ],
                        "examples": [
                            {
                                "example_id": "b9758b0e-b472-486f-a6cd-7ba5ce403a4e",
                                "sense_id": "c7f17a46-5bb8-3a8d-b8db-3203bfa851e5",
                                "text": "Owszem, zachodniacy mają więcej pieniędzy, za to wschodniacy wiedzą, jak sobie poradzić w życiowych kryzysach"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a129276b-d83f-414f-9440-00949124f776",
                        "source_entry_id": "d3929d40-cbb6-3ff7-97bb-a198ac4923d4",
                        "source_sense_id": "c7f17a46-5bb8-3a8d-b8db-3203bfa851e5",
                        "target_lang_word": "Wessi",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wessi",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "73c98c4f-30b1-3153-b144-d80a2f17afc8",
                                        "entry_id": "3e41df2d-253e-30b9-9560-9fced1b8b3cc",
                                        "glosses": [
                                            "Westdeutscher"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "derogatory",
                                            "humorous"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "de50c23e-afff-460b-b7d2-26f8a474c200",
                                                "sense_id": "73c98c4f-30b1-3153-b144-d80a2f17afc8",
                                                "text": "„Gemeint ist nicht, dass Ossis mehr jammern als andere, sondern, dass sie jammern, obwohl sie nicht – in Gegensatz zu den Wessis – das Recht dazu haben.“"
                                            },
                                            {
                                                "example_id": "4ceb60fc-51f7-47d8-884d-f23b48f95fb1",
                                                "sense_id": "73c98c4f-30b1-3153-b144-d80a2f17afc8",
                                                "text": "„Die Ossis und die Wessis sprachen dieselbe Sprache.“"
                                            },
                                            {
                                                "example_id": "de406815-37b2-42ae-9b56-f4f560d406cb",
                                                "sense_id": "73c98c4f-30b1-3153-b144-d80a2f17afc8",
                                                "text": "„Später waren sie verwundert und enttäuscht, wie bieder und prüde die Wessis waren, viel verklemmter als in Woodstock.“"
                                            },
                                            {
                                                "example_id": "75981cbc-2443-41be-a83c-be13e1a97a67",
                                                "sense_id": "73c98c4f-30b1-3153-b144-d80a2f17afc8",
                                                "text": "„An seiner Kleidung, und offenbar auch an seinem Gehabe ist zu sehen, dass er ein Wessi ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
