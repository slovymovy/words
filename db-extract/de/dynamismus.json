                            "singular"
                        ],
                        "form": "den Dynamismus"
                    },
                    {
                        "form_id": "b3772049-0d24-47a4-92c3-ce81e62e694c",
                        "entry_id": "da3fb299-87e3-325b-92b1-235a112a8c5d",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Dynamismen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a894cf58-0af1-3d73-b088-34586372f9fb",
                        "entry_id": "da3fb299-87e3-325b-92b1-235a112a8c5d",
                        "glosses": [
                            "Lehre, nach der sich alle Erscheinungsformen oder die Wirklichkeit durch die Wirkung von Kräften erklären lässt"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "ebed24cc-bfa8-44eb-8bd0-4f6383efd0a9",
                                "sense_id": "a894cf58-0af1-3d73-b088-34586372f9fb",
                                "text": "Dynamismus und Mechanismus sind zwei Theorien über die Kräfte in der Naturphilosophie des 17. und des 18. Jahrhunderts. Dynamismus sieht die Form (Idee) als vor der Materie existent an. Im Mechanismus kommt die Materie vor der Form."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "95f7c1e8-84b9-3dad-9bc3-dce98accd5f7",
                        "entry_id": "da3fb299-87e3-325b-92b1-235a112a8c5d",
                        "glosses": [
                            "Glaube an unpersönliche übernatürliche Kräfte (wie Mana), die eigenständig gedacht werden, jedoch in Dingen, Tieren oder Personen verkörpert erscheinen und übertragen werden können"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "7227c425-8e25-33e6-944f-dbeae78b565b",
                        "entry_id": "da3fb299-87e3-325b-92b1-235a112a8c5d",
                        "glosses": [
                            "Kraft, die auf Veränderung und/oder Entwicklung gerichtet ist"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "f224cd73-4f9e-421d-83ca-9c1e455b0844",
                                "sense_id": "7227c425-8e25-33e6-944f-dbeae78b565b",
                                "text": "Bei allem Dynamismus war sie doch eine Frau der Gegenwart und keine große Visionärin."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    },
                    {
                        "sense_id": "4cb9238f-5645-3697-86fd-8bd0f91b12d3",
                        "entry_id": "da3fb299-87e3-325b-92b1-235a112a8c5d",
                        "glosses": [
                            "Handlung, die von Tatkraft (Dynamik) zeugt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0cf0abfc-6e24-4057-ab26-03d2db4b76d1",
                                "sense_id": "4cb9238f-5645-3697-86fd-8bd0f91b12d3",
                                "text": "Abwehrmechanismen sind starke Dynamismen, deren Ziel allerdings in der Bewahrung des Status quo liegt."
                            }
                        ],
                        "sense_index_json": "\"4\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c996480f-320c-46fc-9457-256f2738439b",
                        "source_entry_id": "da3fb299-87e3-325b-92b1-235a112a8c5d",
                        "source_sense_id": "a894cf58-0af1-3d73-b088-34586372f9fb",
                        "source_sense_description": "Erklärung aller Erscheinungsformen oder der Wirklichkeit durch die Wirkung von Kräften",
                        "target_lang_word": "dynamism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dynamism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "40739c18-348d-36a2-8343-9e93a248c761",
                                        "entry_id": "0cfb4f7f-04b8-3142-ada8-85de9caca332",
                                        "glosses": [
                                            "Great energy, drive, force, or power; vigour of body, mind or personality; oomph or pizzazz"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f35b4528-8113-352f-85dd-ff4c395f5f1a",
                                        "entry_id": "0cfb4f7f-04b8-3142-ada8-85de9caca332",
                                        "glosses": [
                                            "Dynamic reality; active energy; continuous change, progress, or activity."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a1580c5a-ee6c-4c7d-8466-5e570fff21dc",
                                                "sense_id": "f35b4528-8113-352f-85dd-ff4c395f5f1a",
                                                "text": "The fact that the war is no longer the main issue in the election points to the dynamism of foreign affairs."
                                            },
                                            {
                                                "example_id": "a0c05c7c-65fa-4f21-9d9d-b763c9f59c67",
                                                "sense_id": "f35b4528-8113-352f-85dd-ff4c395f5f1a",
                                                "text": "But, one might ask, how can the temporal event of God in our midst be the same as God's event to himself in his eternity if so absolute a distinction is drawn between the enarrable contents of history and the \"eternal dynamism\" of God's immutability, apatheia, and perfect fullness?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bcbc57bf-a219-3072-a714-f2c97348f528",
                                        "entry_id": "0cfb4f7f-04b8-3142-ada8-85de9caca332",
                                        "glosses": [
                                            "Any of several philosophical theories that attempt to explain the universe by an immanent force."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9defbf55-1ac0-4b27-80e1-084c194a80ab",
                        "source_entry_id": "da3fb299-87e3-325b-92b1-235a112a8c5d",
                        "source_sense_id": "a894cf58-0af1-3d73-b088-34586372f9fb",
                        "source_sense_description": "Erklärung aller Erscheinungsformen oder der Wirklichkeit durch die Wirkung von Kräften",
                        "target_lang_word": "dynamisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dynamisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f6d200a9-524f-3f8d-8ab9-bc0f91cc0f1e",
                                        "entry_id": "4f95bf4f-5f11-32d2-9c40-c15974ad40af",
                                        "glosses": [
                                            "Doctrine qui attribue le mouvement de la matière à des forces immanentes et non à une action extérieure et mécanique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "641b46c5-9d47-4d78-ba6f-7793a802ef8c",
                                                "sense_id": "f6d200a9-524f-3f8d-8ab9-bc0f91cc0f1e",
                                                "text": "Le dynamisme de Leibnitz, de Newton, opposé au mécanisme de Descartes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3d7a067f-a4e8-3397-bbc0-e2214d889d9d",
                                        "entry_id": "4f95bf4f-5f11-32d2-9c40-c15974ad40af",
                                        "glosses": [
                                            "Énergie, élan, entrain, fougue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d2c27f35-8c35-46c0-90e3-931fe8c60c64",
                                                "sense_id": "3d7a067f-a4e8-3397-bbc0-e2214d889d9d",
                                                "text": "Il fait preuve de dynamisme."
                                            },
                                            {
                                                "example_id": "f0ab8aed-4a31-473a-83da-d16310522ccb",
                                                "sense_id": "3d7a067f-a4e8-3397-bbc0-e2214d889d9d",
                                                "text": "Le dynamisme des petites entreprises n’est pas une fin en soi, mais un élément du secteur des PME qui concourt à la progression globale de la productivité."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
