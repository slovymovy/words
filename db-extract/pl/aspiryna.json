                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eb48a089-31e2-471c-8061-bb7001318a61",
                                                "sense_id": "24e7fec3-e98e-376d-a616-37181580b2be",
                                                "text": "Seguro Popular, \"aspirina\" a la problemática de salud"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1464660f-7ebb-4699-8651-2f0b7d8f96c0",
                        "source_entry_id": "1df3ad98-9561-3ef0-a50f-15c3463d14ab",
                        "source_sense_id": "4bf5b6c1-9724-380e-b26a-f86a430a4edb",
                        "target_lang_word": "Aspirin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Aspirin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "431fe144-8cc6-39d6-b80c-813a25a21e30",
                                        "entry_id": "82cd25e2-52a2-3f96-b2e7-ccf902772ab2",
                                        "glosses": [
                                            "Fertigpräparat – synthetisch hergestellter Wirkstoff mit schmerzlindernden, fiebersenkenden und entzündungshemmenden Eigenschaften"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dedc64e9-71b1-46de-a7bb-b70a12a8c7f8",
                                                "sense_id": "431fe144-8cc6-39d6-b80c-813a25a21e30",
                                                "text": "Im letzten Drittel der Schwangerschaft darf Aspirin nicht eingenommen werden."
                                            },
                                            {
                                                "example_id": "c82c9169-4f46-4295-99b6-bf8e56841316",
                                                "sense_id": "431fe144-8cc6-39d6-b80c-813a25a21e30",
                                                "text": "Die schmerzhemmende Wirkung von Aspirin beruht auf der Hemmung der Bildung von Botenstoffen."
                                            },
                                            {
                                                "example_id": "1c58ce8e-70cc-455e-b948-83e86b27aec5",
                                                "sense_id": "431fe144-8cc6-39d6-b80c-813a25a21e30",
                                                "text": "„Er untersucht mich, man müsse alle Pazifisten an die Wand stellen, sagt er, dann verschreibt er Aspirin und verweigert dem Fiebernden eine zweite Decke.“"
                                            },
                                            {
                                                "example_id": "40532fc4-015e-4827-ae5f-2d79227cd053",
                                                "sense_id": "431fe144-8cc6-39d6-b80c-813a25a21e30",
                                                "text": "„Mein Vater hatte in Deutschland mit Ende vierzig angefangen, täglich eine Aspirin zu schlucken, weil er zu dickflüssiges Blut hatte, es zu zäh, breiig durch die Adern floss, es nicht bis in die letzten Winkel seines Körpers schaffte.“"
                                            },
                                            {
                                                "example_id": "2cb3eb58-46a6-4c85-8522-487b8330729b",
                                                "sense_id": "431fe144-8cc6-39d6-b80c-813a25a21e30",
                                                "text": "„Gehorsam nahm sie das Wasser und das Aspirin.“"
                                            },
                                            {
                                                "example_id": "2bf67855-a832-4ec2-8db6-ef0936d7de4d",
                                                "sense_id": "431fe144-8cc6-39d6-b80c-813a25a21e30",
                                                "text": "„Ich halte mir die Ohren zu, flüchte in die Küche und schlucke zwei Aspirin und ein Valium.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
