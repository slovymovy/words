                ],
                "senses": [
                    {
                        "sense_id": "579db635-7976-3d43-9be2-d3794e2b996d",
                        "entry_id": "46c3aea0-da6d-3490-b41d-b93c28b91355",
                        "glosses": [
                            "Familienname; Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db006cca-cb79-4111-aa3d-e9ac4aef179a",
                                "sense_id": "579db635-7976-3d43-9be2-d3794e2b996d",
                                "text": "Frau Nonn ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "63e7b504-a3e8-4d5a-8e6a-a5a71226dfda",
                                "sense_id": "579db635-7976-3d43-9be2-d3794e2b996d",
                                "text": "Herr Nonn wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "dc36391b-5358-434f-a0c1-b32323f46416",
                                "sense_id": "579db635-7976-3d43-9be2-d3794e2b996d",
                                "text": "Die Nonns fahren heute ins Saarland."
                            },
                            {
                                "example_id": "1354c336-3b5b-439b-bfc7-2743e80a45f4",
                                "sense_id": "579db635-7976-3d43-9be2-d3794e2b996d",
                                "text": "Der Nonn trägt nie die Schals, die die Nonn ihm strickt."
                            },
                            {
                                "example_id": "4181d8e5-dc4e-4315-a3f1-9c6352b56691",
                                "sense_id": "579db635-7976-3d43-9be2-d3794e2b996d",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Nonn kommt, geht der Herr Nonn.“"
                            },
                            {
                                "example_id": "096d6d8d-2370-45c4-a1f9-ff089f1789df",
                                "sense_id": "579db635-7976-3d43-9be2-d3794e2b996d",
                                "text": "Nonn kommt und geht."
                            },
                            {
                                "example_id": "4aa84dc6-790b-47ea-8ffc-3cd9be6f6949",
                                "sense_id": "579db635-7976-3d43-9be2-d3794e2b996d",
                                "text": "Nonns kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
