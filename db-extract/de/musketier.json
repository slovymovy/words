                                        "sense_id": "955e8ea3-d72f-3c82-a34f-835e859549d0",
                                        "entry_id": "fa7688d7-2c08-3a41-a616-7cc4c66cb37b",
                                        "glosses": [
                                            "A foot soldier armed with a musket."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "20374c95-1433-3784-a94c-197afc035583",
                                        "entry_id": "fa7688d7-2c08-3a41-a616-7cc4c66cb37b",
                                        "glosses": [
                                            "In 17th- and 18th-century France, a member of the royal household bodyguard."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6eb088a6-20df-38ef-b414-040798230d4d",
                                        "entry_id": "fa7688d7-2c08-3a41-a616-7cc4c66cb37b",
                                        "glosses": [
                                            "A comrade or fellow."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae57bbbe-f995-4156-b61c-5dac57c41164",
                                                "sense_id": "6eb088a6-20df-38ef-b414-040798230d4d",
                                                "text": "Reuniting the cast of Trainspotting for a new adventure 21 years on could have gone badly. The BBC’s misjudged This Life + 10, bringing the cast of the iconic 90s TV drama back together, is a case in point. But Boyle and his four musketeers give it just the right frantic, jaded energy and manic anxiety."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4ecf8250-b8ad-4b13-b884-6bf6bb3a2a82",
                        "source_entry_id": "c443eed0-12c6-3803-afc1-52f771335036",
                        "source_sense_id": "5f4a7ee4-c84a-3feb-aad1-d79bcb868d5c",
                        "target_lang_word": "mousquetaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mousquetaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1b3fb422-aef1-36bf-8bd5-c348fb99bf39",
                                        "entry_id": "7189b673-161a-303d-8cf1-6418346f5ac4",
                                        "glosses": [
                                            "Fantassin armé du mousquet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "045ec067-c09f-4520-9dc3-e165b7c9b451",
                                                "sense_id": "1b3fb422-aef1-36bf-8bd5-c348fb99bf39",
                                                "text": "Le mousquetaire a donc besoin de deux types de poudre : amorçage et propulsion : La première, fine, est contenue dans un pulvérin, sorte de fiole en métal, ou en bois, ou en corne. La seconde est renfermée dans une poire à poudre analogue à celle des arquebusiers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d0d2aabc-7dbb-33e1-997b-67f7a2ec5282",
                                        "entry_id": "7189b673-161a-303d-8cf1-6418346f5ac4",
                                        "glosses": [
                                            "Cavalier de la Maison du roi, membre d’une des deux compagnies d’élite distinguées l’une de l’autre par la robe de leurs chevaux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f40999e9-f806-4ab9-a220-c9da88433769",
                                                "sense_id": "d0d2aabc-7dbb-33e1-997b-67f7a2ec5282",
                                                "text": "Sous Louis XV, Milaud de La Baudraye de simple écuyer, devint chevalier, et eut assez de crédit pour placer son fils cornette dans les mousquetaires."
                                            },
                                            {
                                                "example_id": "18a76c6e-7454-49fc-80fa-da78d44e4d80",
                                                "sense_id": "d0d2aabc-7dbb-33e1-997b-67f7a2ec5282",
                                                "text": "Il s'avançait, précédé d'un escadron de mousquetaires Louis XIII, montés sur des chevaux de troupe, et suivi par un char monumental qui portait tous les dieux de l'Olympe, y compris le Temps, armé de la faux classique."
                                            },
                                            {
                                                "example_id": "1de866e0-ce8d-48b0-97b9-c9eab141733e",
                                                "sense_id": "d0d2aabc-7dbb-33e1-997b-67f7a2ec5282",
                                                "text": "Je dirai, pour avoir vu son brevet, que celui-ci était mousquetaire noir. Il n’y paraissait pas quand il allait à pied, car les mousquetaires noirs se distinguaient des mousquetaires gris, non par la couleur de leur habit, mais par la robe de leur cheval."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7af3d1b9-fb5a-37b6-a5c3-d71e876d10fd",
                                        "entry_id": "7189b673-161a-303d-8cf1-6418346f5ac4",
                                        "glosses": [
                                            "Participant qui a gagné ou qui est potentiellement champion."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c95907e3-bcf1-4f69-9479-d60f7cc3c770",
                                                "sense_id": "7af3d1b9-fb5a-37b6-a5c3-d71e876d10fd",
                                                "text": "Quatre comme les Lacoste, Borotra, Cochet et Brugnon, ces premiers Mousquetaires à la jointure des années 1920-1930 du siècle précédent, ceux pour qui on décida de construire un stade, en 1928, et de lui donner le nom d’un aviateur afin qu’ils y défendent cette Coupe Davis rapportée des États-Unis."
                                            },
                                            {
                                                "example_id": "bfcff78d-c8e1-49ec-8262-0a1c80941c50",
                                                "sense_id": "7af3d1b9-fb5a-37b6-a5c3-d71e876d10fd",
                                                "text": "Pilier du trio des trois mousquetaires de l’éducation, qu’elle compose avec ses consœurs Rizqy et Labrie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "edb1b857-868e-38b8-a474-d121fdcba70b",
                                        "entry_id": "7189b673-161a-303d-8cf1-6418346f5ac4",
                                        "glosses": [
                                            "Classe de dériveur habitable."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
