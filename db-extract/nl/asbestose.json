                            {
                                "example_id": "bfa194fc-8012-4d68-863e-c539d98e6591",
                                "sense_id": "a932da33-51d8-30f3-bb7b-bab2ecda5f51",
                                "text": "Mensen met asbestose, een verminderde longfunctie als gevolg van werken met asbest, kunnen een voorschot op een eventuele schadevergoeding krijgen. Dat valt op te maken uit een brief van minister Lodewijk Asscher (Sociale Zaken) aan de Tweede Kamer."
                            },
                            {
                                "example_id": "12654439-9756-40f0-9058-be3d6c8d044f",
                                "sense_id": "a932da33-51d8-30f3-bb7b-bab2ecda5f51",
                                "text": "De toename komt doordat ook asbestslachtoffers met de ziekte asbestose (stoflongen) sinds enkele jaren een beroep kunnen doen op het instituut."
                            }
                        ]
