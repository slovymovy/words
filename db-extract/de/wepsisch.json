                "senses": [
                    {
                        "sense_id": "abce3ffd-7c86-33be-af47-4916dec2a989",
                        "entry_id": "cba89880-6145-350d-abc3-3bd35f942a6c",
                        "glosses": [
                            "Sprache der Wepsen; östlich Sankt Petersburgs von wenigen Tausend Menschen gesprochene Sprache"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee7f5f45-4f7d-43a8-95be-e10fb972854c",
                                "sense_id": "abce3ffd-7c86-33be-af47-4916dec2a989",
                                "text": "„Das Wepsische verfügt mit 24 Kasus über den größten Formenreichtum innerhalb der finno-ugrischen Sprachen.“"
                            },
                            {
                                "example_id": "1d94e91f-a117-45c8-a0fd-f1bdb7df6a9a",
                                "sense_id": "abce3ffd-7c86-33be-af47-4916dec2a989",
                                "text": "„An vier Schulen in Karelien wird Wepsisch als obligatorisches Fach (200 Schüler) unterrichtet, an der Universität von Petrozavodsk wepsische Philologie gelehrt, ebenso an der dortigen Pädagogischen Hochschule Wepsisch als Zusatzbildung angeboten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
