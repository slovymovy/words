                    }
                ],
                "senses": [
                    {
                        "sense_id": "b18df443-f001-359c-8239-e085fdd0eafb",
                        "entry_id": "2e196fd5-e79a-3578-a05e-e3ad0f64ebe6",
                        "glosses": [
                            "feine metallisch glänzende Plättchen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5cd18bd8-45e9-4bd6-ae6b-7eb416d37041",
                                "sense_id": "b18df443-f001-359c-8239-e085fdd0eafb",
                                "text": "„Derzeit seien aber noch viele Kleider mit Spitze und Verzierungen wie Steinchen oder Glitzer gefragt.“"
                            },
                            {
                                "example_id": "6aceb31b-1e9f-4ce0-bfec-ad598922d252",
                                "sense_id": "b18df443-f001-359c-8239-e085fdd0eafb",
                                "text": "„Jetzt ist es komplett, das neue Outfit der 21. Gubener Apfelkönigin Jessica Sroka: Ein Mädchentraum aus Glitzer und Tüll ist die neue Robe der diesjährigen Gubener Apfelkönigin.“"
                            },
                            {
                                "example_id": "0c2b9029-fc87-4985-b112-d1c5ae81f74f",
                                "sense_id": "b18df443-f001-359c-8239-e085fdd0eafb",
                                "text": "„Wenn das Leben dich nervt, streu Glitzer drauf“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "803cb8ce-217e-32de-b019-412e189d009a",
                        "entry_id": "2e196fd5-e79a-3578-a05e-e3ad0f64ebe6",
                        "glosses": [
                            "Glanz; etwas, das glänzt"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "c6032806-49e2-402d-9816-1e75eb9427d6",
                                "sense_id": "803cb8ce-217e-32de-b019-412e189d009a",
                                "text": "„Zwischen Misthaufen und Glitzer, beim Schweinestreicheln und bei krummen Geschäften – den Wagenhofenern ist wieder einiges eingefallen.“"
                            },
                            {
                                "example_id": "6c1b6f85-2277-45db-b388-d5f60d78c697",
                                "sense_id": "803cb8ce-217e-32de-b019-412e189d009a",
                                "text": "„Ein Wahnsinn in Pink und Glitzer: Weinende Katze bekommt ihren Verlobungsring“"
                            },
                            {
                                "example_id": "e53121ee-c706-421b-9427-e06ed6779d31",
                                "sense_id": "803cb8ce-217e-32de-b019-412e189d009a",
                                "text": "„Glitzer und Glamour, bunte Kostüme und Pappnasen, die üblicherweise zur Zirkusluft dazugehören, sucht man vergebens.“"
                            },
                            {
                                "example_id": "d92f895c-e55a-4e81-b0c7-952a4b2d4ff8",
                                "sense_id": "803cb8ce-217e-32de-b019-412e189d009a",
                                "text": "„Tanzrevue mit Glitzer, Glamour und Gesang“"
                            },
                            {
                                "example_id": "de9d2ef0-b65d-4066-8e80-e780aa3e8368",
                                "sense_id": "803cb8ce-217e-32de-b019-412e189d009a",
                                "text": "„Und auch die Farben des Abends lehnten sich an die schillernde Zukunft an: Silber, Schwarz, kühles Blau und natürlich noch etwas Glitzer.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
