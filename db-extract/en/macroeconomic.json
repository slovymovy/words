                    {
                        "translation_id": "3495761f-2599-4ea5-9fe5-1909627dd559",
                        "source_entry_id": "e9d8e735-bddc-3542-9963-c4b555cfabbe",
                        "source_sense_description": "relating to macroeconomics",
                        "target_lang_word": "macroéconomique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "macroéconomique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "59688872-db54-3862-942b-65a7c51d6865",
                                        "entry_id": "fd36b243-077a-399e-a7d6-edb1a1956fa8",
                                        "glosses": [
                                            "Relatif à la macroéconomie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "032d5b0f-2f91-498b-ba96-b718da88869e",
                                                "sense_id": "59688872-db54-3862-942b-65a7c51d6865",
                                                "text": "Au niveau microéconomique, ces flux de dividendes sont encore plus visibles qu’au niveau macroéconomique."
                                            },
                                            {
                                                "example_id": "fad50117-44ab-45e9-a5fe-4c3a525a1b34",
                                                "sense_id": "59688872-db54-3862-942b-65a7c51d6865",
                                                "text": "C’est une construction purement mathématique, dont l’évaluation fait l’objet de débat entre spécialistes d’économétrie, mais qui par exemple peut être obtenu par des filtres de type Hodrick–Prescott sur des séries macroéconomiques…"
                                            },
                                            {
                                                "example_id": "c86586ab-4130-4701-8227-6001edd528c2",
                                                "sense_id": "59688872-db54-3862-942b-65a7c51d6865",
                                                "text": "« On a ce paradoxe entre une activité largement affaiblie par les chocs macroéconomiques (la guerre en Ukraine, la crise énergétique, l’inflation, la Chine fermée, etc.) et le dynamisme du marché du travail », commente Mathieu Plane, économiste à l'Observatoire français des conjonctures économiques (OFCE)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
