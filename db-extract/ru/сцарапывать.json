                        "source_entry_id": "4d7f191b-a5c8-38a3-9331-461d6e7ac77c",
                        "source_sense_id": "1ec47a40-75c3-36e3-911a-3d2aefcc9228",
                        "target_lang_word": "abkratzen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abkratzen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1c63147c-deb7-393a-b3b4-dc6c084c138d",
                                        "entry_id": "aca964b5-363c-38f4-996e-714170464042",
                                        "glosses": [
                                            "durch Schaben (Kratzen) entfernen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "863fa086-71d6-416e-8f1a-65fd40bc10c2",
                                                "sense_id": "1c63147c-deb7-393a-b3b4-dc6c084c138d",
                                                "text": "Auf einem Ceran-Kochfeld sollte man Verschmutzungen nur mit speziellen Werkzeugen abkratzen, um Beschädigungen zu vermeiden."
                                            },
                                            {
                                                "example_id": "ea9710f0-1b5f-4a0f-a115-5d81e1a96b10",
                                                "sense_id": "1c63147c-deb7-393a-b3b4-dc6c084c138d",
                                                "text": "Er hat den Schmutz schon abgekratzt."
                                            },
                                            {
                                                "example_id": "f6a36fb4-755f-4556-aa5e-c7401a0ae329",
                                                "sense_id": "1c63147c-deb7-393a-b3b4-dc6c084c138d",
                                                "text": "Wenn du das Preischild abkratzen willst, ist es besser, es vorher eine Weile einzuweichen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "eeacb508-294b-36ea-846b-f0b18d4e917e",
                                        "entry_id": "aca964b5-363c-38f4-996e-714170464042",
                                        "glosses": [
                                            "sein Leben verlieren"
                                        ],
                                        "tags": [
                                            "impolite"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "902bc8a7-5a70-48ed-bf2a-18626f0e4b65",
                                                "sense_id": "eeacb508-294b-36ea-846b-f0b18d4e917e",
                                                "text": "Im Krieg sind die Menschen reihenweise abgekratzt, nur um ein kleines Waldstück zu erobern."
                                            },
                                            {
                                                "example_id": "df342715-55f2-41e1-b91a-02ec892b886c",
                                                "sense_id": "eeacb508-294b-36ea-846b-f0b18d4e917e",
                                                "text": "Wenn da steht „Peter Meier (1935– )“, liest sich das wie „na, wann kratzt der endlich ab?“"
                                            },
                                            {
                                                "example_id": "7e0e2eac-682a-4153-8d89-34da1ef6f5cb",
                                                "sense_id": "eeacb508-294b-36ea-846b-f0b18d4e917e",
                                                "text": "„Irgendwann kratzte sie dann ab, als er noch mehr an ihr rumschnippelte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
