                                                "example_id": "0fb55ca8-ff18-422d-a2ef-11334e630dc9",
                                                "sense_id": "f8e4aefe-920d-359a-bbe4-5b5bc43e7e90",
                                                "text": "I wear boxers under trousers but for sports I usually wear a brief."
                                            }
