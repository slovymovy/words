                ],
                "senses": [
                    {
                        "sense_id": "733bbf81-5cb6-3ffa-9682-a6b1515d7a26",
                        "entry_id": "84238457-4f64-347f-9593-943235d517cc",
                        "glosses": [
                            "Modell für menschliches oder tierisches Verhalten, das Verhalten aufgrund von Reiz und Reaktion zu erklären versucht. Dieses Modell spielt auch in der Linguistik eine Rolle."
                        ],
                        "tags": [
                            "speziell Behaviorismus"
                        ],
                        "examples": [
                            {
                                "example_id": "75b26212-f139-477c-9944-e104ee468a38",
                                "sense_id": "733bbf81-5cb6-3ffa-9682-a6b1515d7a26",
                                "text": "Besonders bekannt für Untersuchungen auf der Grundlage des Stimulus-Response-Modells sind die Pawlowschen Hunde."
                            },
                            {
                                "example_id": "2a36680e-c725-4958-9a18-f43d22468e98",
                                "sense_id": "733bbf81-5cb6-3ffa-9682-a6b1515d7a26",
                                "text": "In der Linguistik wurde versucht, die Bedeutung sprachlicher Ausdrücke ausschließlich mittels der beobachtbaren Größen Stimulus (Reiz) und Response (Reaktion), also mit Hilfe eines Stimulus-Response-Modells zu beschreiben."
                            },
                            {
                                "example_id": "c9d3dd4c-4e88-4e2e-8895-7df748a42f2d",
                                "sense_id": "733bbf81-5cb6-3ffa-9682-a6b1515d7a26",
                                "text": "„Dieses modifizierte Stimulus-Response-Modell ist die Grundlage der sogenannten Mediationstheorie der Bedeutung.“ (Bußmann, Lexikon der Sprachwissenschaft, S. 656. Abkürzungen aufgelöst.)"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
