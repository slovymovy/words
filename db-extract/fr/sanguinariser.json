                "senses": [
                    {
                        "sense_id": "c61e459f-64f2-3fb7-a986-72f38d05f83e",
                        "entry_id": "d6909946-0b41-3414-bfb9-e6129b026113",
                        "glosses": [
                            "Donner un caractère sanguinaire ou sanglant à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7feb3270-f968-4f14-9bc1-254cd2cb1c6d",
                                "sense_id": "c61e459f-64f2-3fb7-a986-72f38d05f83e",
                                "text": "C'est encore plus vraie pour ces adulescents, bigots par ignorance, blonds, sanguinarisés et migrants comme d'autres migraient dans les années cinquante vers les kibboutz ou dans les Himalayas pour chercher des rites d'initiation ou de transition que l'occident ne leur transmettait plus."
                            },
                            {
                                "example_id": "aeb13243-7ec5-49ec-b4c5-709a7b68788e",
                                "sense_id": "c61e459f-64f2-3fb7-a986-72f38d05f83e",
                                "text": "Qu'il est doux de succomber au narghilé en regardant passible et paisible le coucher du soleil qui sanguinarise l'horizon."
                            },
                            {
                                "example_id": "6e1adf51-cafd-419e-a8c6-0187cf02fd24",
                                "sense_id": "c61e459f-64f2-3fb7-a986-72f38d05f83e",
                                "text": "Vain Diou !! à l'odeur des vaches, à la putain d'couenne du jambon non-jetable, aux saucisses de Morteau, aux Francs-comtoués qui savent pas chuchoter, aux cochons éventrés de Noël et aux boyaux sanguinarisés."
                            }
                        ]
                    }
                ],
