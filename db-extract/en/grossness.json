                        "sense_id": "fc776ed5-cd8f-3edd-bed2-0a6256cd60f6",
                        "entry_id": "de41845d-7303-3736-af43-118367d5f537",
                        "glosses": [
                            "Lack of refinement in character, behaviour etc.; coarseness."
