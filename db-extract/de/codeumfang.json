                "senses": [
                    {
                        "sense_id": "935581a8-0388-3d90-bdda-481d1fcbb892",
                        "entry_id": "b1b12443-31bf-3a8c-b316-bf6532e0f206",
                        "glosses": [
                            "Anzahl/Menge der Zeichen, beispielsweise in einem Programm"
                        ],
                        "tags": [
                            "EDV"
                        ],
                        "examples": [
                            {
                                "example_id": "6a6f6a59-eba1-4a4c-a9f2-9df56d23a82b",
                                "sense_id": "935581a8-0388-3d90-bdda-481d1fcbb892",
                                "text": "„Davon erhoffen sich die Entwickler einen reduzierten Codeumfang“ […]."
                            },
                            {
                                "example_id": "083bcb88-c82c-440c-91b4-54dc1ad42028",
                                "sense_id": "935581a8-0388-3d90-bdda-481d1fcbb892",
                                "text": "„Diese Ergänzung“ […] „hilft zudem, den Codeumfang zu reduzieren,“ […]."
                            },
                            {
                                "example_id": "8f44a52b-68cb-4134-9af5-6c1266224e8f",
                                "sense_id": "935581a8-0388-3d90-bdda-481d1fcbb892",
                                "text": "„Dass der Codeumfang hier reduziert wird, ist relativ belanglos.“"
                            },
                            {
                                "example_id": "b20d0b43-7af6-4d4e-b322-2c70c679d809",
                                "sense_id": "935581a8-0388-3d90-bdda-481d1fcbb892",
                                "text": "„Windows NT hatte im Jahre 2000 einen Codeumfang von ca. 29 Mio. LOC (Lines of Code). Bei Windows Vista spricht man bereits von einem Codeumfang von 50 Mio. LOC.“"
                            },
                            {
                                "example_id": "d93ece54-6d09-46f4-aec5-a86beced16cd",
                                "sense_id": "935581a8-0388-3d90-bdda-481d1fcbb892",
                                "text": "„Im Sommer 1996 erschien nach rund 100 Testversionen der 1.3er-Kernelserie Linux 2.0 mit einem Codeumfang von 800 000 Quelltextzeilen.“"
                            },
                            {
                                "example_id": "e6af26fd-37ed-4214-94d0-ae41e4045e31",
                                "sense_id": "935581a8-0388-3d90-bdda-481d1fcbb892",
                                "text": "„Der angestrebte Codeumfang von 4 Bytes bietet Platz für alle Schriftzeichen, die weltweit verwendet werden.“"
                            },
                            {
                                "example_id": "d284de18-5e76-4c79-9f51-f2a2c7d3f86d",
                                "sense_id": "935581a8-0388-3d90-bdda-481d1fcbb892",
                                "text": "„Da der Codeumfang mit der Menge implementierter Funktionen ansteigt, wurde er nicht direkt, sondern in Beziehung zur Zahl realisierter Anforderungen betrachtet.“"
                            },
                            {
                                "example_id": "f0f72e4d-c9ab-404c-9071-d927f5610bab",
                                "sense_id": "935581a8-0388-3d90-bdda-481d1fcbb892",
                                "text": "„Erkenntnis 5: Die Umsetzungen in Perl und Ruby haben eher wenig Codeumfang, die in Java eher viel.“"
                            },
                            {
                                "example_id": "946feb2f-8db2-4af1-ac28-5a10ae56b41b",
                                "sense_id": "935581a8-0388-3d90-bdda-481d1fcbb892",
                                "text": "„Die militärische Anwendung des Sekundärradarverfahrens ist heute noch eine wesentliche Aufgabe, allerdings ist der Codeumfang des IFF/SIF für eine nachahmungssichere Freund/Feind-Kennung viel zu gering.“"
                            },
                            {
                                "example_id": "f5141ce3-db87-4b39-95fb-9ca83bac7c1f",
                                "sense_id": "935581a8-0388-3d90-bdda-481d1fcbb892",
                                "text": "„Seit einiger Zeit entspricht der Codeumfang von ISO 10646 exakt dem von Unicode, da auch dort der Codebereich auf 17 Ebenen, darstellbar mit 21 Bit, beschränkt wurde.“"
                            },
                            {
                                "example_id": "43a661b8-b2b6-45f4-b0bd-db44a9b3ac73",
                                "sense_id": "935581a8-0388-3d90-bdda-481d1fcbb892",
                                "text": "„Dass der neue Treiber in einem noch unfertigen Zustand aufgenommen wurde, ist bei Linux nicht ungewöhnlich: Auch ein Basistreiber mit vielen fehlenden Features ist für manche Nutzer schon eine große Hilfe. Außerdem ist der Codeumfang dadurch kleiner, was den Kernel-Entwicklern die initiale Begutachtung erleichtert.“"
                            },
                            {
                                "example_id": "93a820e4-a4e2-4014-85be-25f082fbdf1b",
                                "sense_id": "935581a8-0388-3d90-bdda-481d1fcbb892",
                                "text": "„Tabelle 5.3-3 gibt die Blocklängen für verschiedene Codeumfänge an.“"
                            },
                            {
                                "example_id": "fc3f0638-0928-42ec-9d42-aa0bb1652583",
                                "sense_id": "935581a8-0388-3d90-bdda-481d1fcbb892",
                                "text": "„Dazu gehören […] Entwurfsmethoden und ihnen zugehörige Beschreibungsmittel, die es ermöglichen, vorauszubestimmen und nachzuvollziehen, an welcher Stelle in einem Softwaresystem welche Aufgaben gelöst werden – bei Codeumfängen von hunderttausenden oder Millionen von Zeilen unverzichtbar, um das System zu beherrschen,“ […]."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
