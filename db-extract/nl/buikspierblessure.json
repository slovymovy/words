                        "examples": [
                            {
                                "example_id": "9f85a942-88b4-4a57-928b-31a24efdfe0e",
                                "sense_id": "fd446547-44d0-3d8a-95f2-fd10055e9c9b",
                                "text": "Nadal zou het in de tweede ronde opnemen tegen zijn landgenoot Fernando Verdasco, maar een buikspierblessure gooit roet in het eten. Djokovic moest in Parijs verder komen dan Nadal om de eerste plaats over te nemen. De Serviër bereikte dinsdag al de derde ronde."
                            },
                            {
                                "example_id": "04dbd90a-c85b-48e8-9bdf-f09cf62f62bf",
                                "sense_id": "fd446547-44d0-3d8a-95f2-fd10055e9c9b",
                                "text": "Ook present in Frankfurt: Sébastien Haller. Maar niet als speler. De ex-spits van FC Utrecht kan vanwege een buikspierblessure niet meedoen."
                            }
                        ]
