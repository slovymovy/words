                "senses": [
                    {
                        "sense_id": "a918202a-1d35-3fdd-9075-75c6218e90d2",
                        "entry_id": "b9fda9f5-916f-317b-8329-59635fddb804",
                        "glosses": [
                            "Tout ce qui se mange, en particulier ce qui se met sur une tartine, se mange avec du pain."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "4b0b6341-51a3-4428-a4b4-ba91c3d2a465",
                                "sense_id": "a918202a-1d35-3fdd-9075-75c6218e90d2",
                                "text": "Dieu de Dieu ! il pleuvait drôlement sur sa mercerie, à cette belle blonde, cette cato qui tortillait tant son derrière, autrefois, dans sa belle boutique bleue. Voilà où menaient l’amour de la fripe, les lichades et les gueuletons."
                            },
                            {
                                "example_id": "f348d05b-0a2b-451d-b752-9e5796c62a75",
                                "sense_id": "a918202a-1d35-3fdd-9075-75c6218e90d2",
                                "text": "Veux-tu pas manger ta fripe sans pain."
                            },
                            {
                                "example_id": "5be3ca0a-589a-46ab-9fbc-299c30de18c5",
                                "sense_id": "a918202a-1d35-3fdd-9075-75c6218e90d2",
                                "text": "Ça lui cassait son coup avec cette Lulu qui l’y avait mené, non que les troquets où manger aient fait défaut dans Montmartre, mais il le sentait, cette bonne bandeuse et la fripe de la mère Anna, ça composait pour lui l’harmonie parfaite."
                            }
                        ]
                    },
                    {
                        "sense_id": "e9d407a0-21d6-3006-93d7-ed475d334e16",
                        "entry_id": "b9fda9f5-916f-317b-8329-59635fddb804",
                        "glosses": [
                            "Au Québec existe l'expression \\\"juste d'une fripe\\\" désignant une action très rapide sans aucune interruption, d'un seul coup!"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "12a71b6c-e9a8-41e3-91bc-fb36a48c9df9",
                        "source_entry_id": "b9fda9f5-916f-317b-8329-59635fddb804",
                        "source_sense_description": "Tout ce qui se mange",
                        "target_lang_word": "eten",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "eten",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "443edf1b-e2ce-345d-9c8b-03dbfbac529f",
                                        "entry_id": "5ae96fbc-7a64-3928-af73-6ebad7a49f1c",
                                        "glosses": [
                                            "het nuttigen van voedsel"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f07eaa14-280a-4323-83a8-0951c2f3d640",
                                                "sense_id": "443edf1b-e2ce-345d-9c8b-03dbfbac529f",
                                                "text": "We gingen met de hele klas eten bij een pizzeria."
                                            },
                                            {
                                                "example_id": "443183ac-5db1-40ee-bf9a-d663a8c5226f",
                                                "sense_id": "443edf1b-e2ce-345d-9c8b-03dbfbac529f",
                                                "text": "Met mijn 43 jaar was ik duidelijk de oudste van het stel, de rest leek ergens tussen de twintig en vijfentwintig. Sommigen gingen wat eten en anderen zaten zwijgend voor zich uit te staren."
                                            },
                                            {
                                                "example_id": "7944e2e6-6001-43df-9e72-c1270f972cbb",
                                                "sense_id": "443edf1b-e2ce-345d-9c8b-03dbfbac529f",
                                                "text": "Geef elkander van je brood, maar eet niet van hetzelfde stuk."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "db03c92e-ae37-3d84-92f7-cc11c7ffda8e",
                                        "entry_id": "5ae96fbc-7a64-3928-af73-6ebad7a49f1c",
                                        "glosses": [
                                            "meervoudige tegenwoordige tijd van eten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea42b5b1-f92c-4e6d-b752-e1884843ea99",
                                                "sense_id": "db03c92e-ae37-3d84-92f7-cc11c7ffda8e",
                                                "text": "Jullie eten te veel."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "eten",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "819761f0-40c9-3a03-a219-182139e6d935",
                                        "entry_id": "f4adab2f-4e13-3180-a570-6183c362ece9",
