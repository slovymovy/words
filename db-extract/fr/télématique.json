            {
                "entry_id": "45b30ce2-6930-3433-a34e-481e1bd448a4",
                "word": "télématique",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "aa53ee89-ac14-4882-bc15-a3aac15491e1",
                        "entry_id": "45b30ce2-6930-3433-a34e-481e1bd448a4",
                        "tags": [
                            "plural"
