                    },
                    {
                        "translation_id": "fd0a03f6-453c-4e28-a428-87dac0a7e22d",
                        "source_entry_id": "383bbcc8-f974-3d79-99bf-2a4d646cb441",
                        "source_sense_id": "a6904f38-90f3-3ae3-b2b0-c7bbea246542",
                        "source_sense_description": "one who panhandles",
                        "target_lang_word": "Bettler",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bettler",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e3962ed6-04c9-3229-9d7c-d5a3d1969263",
                                        "entry_id": "d62800d2-9e37-32a2-bd15-1cd5d96e20a2",
                                        "glosses": [
                                            "bedürftiger Mensch, der von Almosen lebt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0aa24032-a9a3-4192-af44-44edcccf1157",
                                                "sense_id": "e3962ed6-04c9-3229-9d7c-d5a3d1969263",
                                                "text": "Einen Dritteil der Einwohner machen privilegierte Bettler aus. (Johann Kaspar Riesbeck, Briefe eines reisenden Franzosen über Deutschland, Köln, z.n. Projekt Gutenberg)"
                                            },
                                            {
                                                "example_id": "cf0f0235-1bc8-4bc1-9a7f-c2618fc22f32",
                                                "sense_id": "e3962ed6-04c9-3229-9d7c-d5a3d1969263",
                                                "text": "Vor dem Eingang zum Bahnhof saß ein Bettler und reckte den Passanten sein handgeschriebenes Schild entgegen."
                                            },
                                            {
                                                "example_id": "4eaaf31b-752e-4e98-8b45-c432f1701636",
                                                "sense_id": "e3962ed6-04c9-3229-9d7c-d5a3d1969263",
                                                "text": "„Ein Bettler klingelte bei uns.“"
                                            },
                                            {
                                                "example_id": "331a6c2b-0207-439f-a3f1-02a452b209d9",
                                                "sense_id": "e3962ed6-04c9-3229-9d7c-d5a3d1969263",
                                                "text": "„Im jüdischen Viertel gaben sich die Bettler als fromme Juden aus, ließen sich Bärte wachsen, warfen sich in lange schwarze Mäntel und segneten jeden, der ihnen unterkam.“"
                                            },
                                            {
                                                "example_id": "3e65e3fd-58b8-4b45-96ee-6abbc0288f8e",
                                                "sense_id": "e3962ed6-04c9-3229-9d7c-d5a3d1969263",
                                                "text": "„Im September 1930 werden die Vorbereitungen hektischer, Maler streichen viele Fassaden neu, alte Hütten verschwinden hinter Zäunen aus Eukalyptusholz, Bettler und Leprakranke müssen die Stadt verlassen.“"
                                            },
                                            {
                                                "example_id": "addd2b6b-5489-4cf3-85f9-53d712185490",
                                                "sense_id": "e3962ed6-04c9-3229-9d7c-d5a3d1969263",
                                                "text": "„Erst jetzt gab es in der antiken Welt Pauperismus in großem Ausmaße: Besitzlose, die als Bettler das Land durchstreiften.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "aea6a890-859c-3b59-a400-d1d5a10c1d72",
                                        "entry_id": "d62800d2-9e37-32a2-bd15-1cd5d96e20a2",
                                        "glosses": [
                                            "dringlich Bittender"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e790904a-08eb-4478-9c9e-8ce5edf72d1a",
                                                "sense_id": "aea6a890-859c-3b59-a400-d1d5a10c1d72",
                                                "text": "Ich stehe hier als Bittsteller und Bettler."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1643306e-2067-4c91-b2a3-48d122676bf6",
                        "source_entry_id": "383bbcc8-f974-3d79-99bf-2a4d646cb441",
                        "source_sense_id": "a6904f38-90f3-3ae3-b2b0-c7bbea246542",
                        "source_sense_description": "one who panhandles",
                        "target_lang_word": "Bettlerin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bettlerin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b0ce55c9-3752-3a1d-8561-5c21f060f57a",
                                        "entry_id": "69af3fe7-f042-3d5e-bd87-002d98b37b64",
                                        "glosses": [
                                            "weibliche Person, die Almosen erbittet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b899504-c400-4737-86a3-d3c296f7f527",
                                                "sense_id": "b0ce55c9-3752-3a1d-8561-5c21f060f57a",
                                                "text": "Sie schämte sich anfangs, als Bettlerin aufzutreten. Aber das verging."
                                            },
                                            {
                                                "example_id": "321be53e-f763-4e59-90d6-6e83db353f05",
                                                "sense_id": "b0ce55c9-3752-3a1d-8561-5c21f060f57a",
                                                "text": "Ist eine Frau, die auf der Straße singt, eine \"aufdringliche\" Bettlerin oder doch eine \"gewerbsmäßige\", weil das Betteln ihr Hauptverdienst ist – oder gar beides?"
                                            },
                                            {
                                                "example_id": "b5f989a0-d953-48ab-b40a-47421a89ec59",
                                                "sense_id": "b0ce55c9-3752-3a1d-8561-5c21f060f57a",
                                                "text": "Am Mittwoch gegen 18 Uhr fielen vor einem Einkaufsmarkt in der Rodinger Straße in Cham zwei Bettlerinnen auf. Die zwei rumänischen Staatsangehörigen, 22 und 40 Jahre alt, […]"
                                            },
                                            {
                                                "example_id": "150fbed5-4929-476f-9797-d07ee2b0e8b8",
                                                "sense_id": "b0ce55c9-3752-3a1d-8561-5c21f060f57a",
                                                "text": "\"Danke, danke\", ruft die Bettlerin mit hoher Stimme. \"Bisher habe ich in Hamburg kein böses Wort gehört\", erzählt sie, \"fast alle Leute sind freundlich.\" Im bulgarischen Kjustendil, wo sie mit sechs Verwandten in einer kleinen Hütte am Fluss lebe, sei das anders: \"Wer bettelt, wird bespuckt und geschlagen.\""
                                            },
                                            {
                                                "example_id": "52335cd1-2acb-44cc-85a7-556b3b16c64c",
                                                "sense_id": "b0ce55c9-3752-3a1d-8561-5c21f060f57a",
                                                "text": "„Im Moslemviertel kostümierten die Bettlerinnen sich als fromme Moslems.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
