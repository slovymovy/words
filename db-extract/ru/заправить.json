                        "glosses": [
                            "to dress (with), to season (with)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee0d1a97-07a4-4fec-a74e-dce8e4e270a1",
                                "sense_id": "3fae158e-37b1-325f-a504-0bd4a17d5a31",
                                "text": "запра́вить сала́т ма́слом и у́ксусом",
                                "translation": "to dress the salad with oil and vinegar",
                                "english": "to dress the salad with oil and vinegar"
                            },
                            {
                                "example_id": "722c3124-1683-4697-a6cf-21bb45df3db1",
                                "sense_id": "3fae158e-37b1-325f-a504-0bd4a17d5a31",
                                "text": "запра́вить муко́й",
                                "translation": "to mix flour (into); thicken with flour",
                                "english": "to mix flour (into); thicken with flour"
                            },
                            {
                                "example_id": "bf5c308b-3a91-4d31-a625-4190a5978ea5",
                                "sense_id": "3fae158e-37b1-325f-a504-0bd4a17d5a31",
                                "text": "запра́вить щи смета́ной",
                                "translation": "add sour cream to the cabbage soup",
                                "english": "add sour cream to the cabbage soup"
                            },
                            {
                                "example_id": "b7c7bd28-2071-466b-a1d7-05827c7ccf90",
                                "sense_id": "3fae158e-37b1-325f-a504-0bd4a17d5a31",
                                "text": "Сва́ренные стручки́ отки́нуть на си́то и́ли дуршла́г, дать стечь воде́, по́сле чего́ переложи́ть в кастрю́лю и запра́вить ма́слом, а по жела́нию и са́харом."
                            }
                        ]
