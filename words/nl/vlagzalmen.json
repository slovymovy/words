            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c86b5110-34d9-3513-814f-5b60960552ed",
                    "sense_definition": "meervoud van het zelfstandig naamwoord <w>vlagzalm</w>",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "vlagzalm_dieren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De visser ving vandaag twee mooie <w>vlagzalmen</w> in de snelstromende beek.",
                            "target_lang_translations": {
                                "ru": "Рыбак поймал сегодня двух красивых <w>хариусов</w> в быстротекущем ручье."
                            }
                        },
                        {
                            "text": "In dit heldere bergwater zwemmen verschillende soorten forellen en <w>vlagzalmen</w>.",
                            "target_lang_translations": {
                                "ru": "В этой прозрачной горной воде плавают разные виды форели и <w>хариусов</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "meervoud"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "множественное число от существительного vlagzalm (хариус)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хариусы",
                                "target_lang_sense_clarification": "несколько рыб"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "09e23bed-18ae-333e-984f-4a25496729f0",
                    "sense_definition": "het geslacht Thymallus van zoetwatervissen uit de zalmenfamilie met een opvallend grote rugvin",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "taxonomie_vissen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Biologen bestuderen de verspreiding van de <w>vlagzalmen</w> in de koude rivieren van Noord-Europa.",
                            "target_lang_translations": {
                                "ru": "Биологи изучают распространение <w>хариусов</w> в холодных реках Северной Европы."
                            }
                        },
                        {
                            "text": "Binnen de zalmachtigen vormen de <w>vlagzalmen</w> een aparte groep met hun karakteristieke rugvin.",
                            "target_lang_translations": {
                                "ru": "Среди лососевых <w>хариусы</w> образуют отдельную группу благодаря своему характерному спинному плавнику."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "род пресноводных рыб Thymallus семейства лососевых с заметным крупным спинным плавником"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хариусы",
                                "target_lang_sense_clarification": "род рыб (Thymallus)"
                            }
                        ]
                    }
                }
            ]
        }
    ]
