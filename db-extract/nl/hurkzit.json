                "senses": [
                    {
                        "sense_id": "f598b2fc-dbb1-3509-8d90-f6abce7e9b5d",
                        "entry_id": "f75890b7-7abf-3b5a-92f2-c4f42c25f50c",
                        "glosses": [
                            "een manier van zitten waarbij de billen van de zittende persoon rusten op zijn eigen enkels"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eab16526-fc9d-48df-b35b-b09fa3b224ef",
                                "sense_id": "f598b2fc-dbb1-3509-8d90-f6abce7e9b5d",
                                "text": "De bewoners van dit deel van Zuidoost kunnen tegen een stootje, maar dit werd ook hen te gortig. Zeker toen in het park een kleine plantage met wiet werd aangetroffen, en de bewoners van de flat Geldershoofd met het bericht kwamen dat de wildkampeerders ook de onaangename gewoonte hadden om zich in en rond de flat in hurkzit te ontlasten."
                            },
                            {
                                "example_id": "de465499-cf7f-4dbd-a420-dcd889347d60",
                                "sense_id": "f598b2fc-dbb1-3509-8d90-f6abce7e9b5d",
                                "text": "Tijdens de door Nederland met 3-0 gewonnen wedstrijd had de keeper van Oranje weinig te doen en leunde hij op een gegeven moment in hurkzit tegen één van de doelpalen. Op Twitter was de hashtag #JasperCillessenSitsOnThings al snel een trend."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3d3d754c-6847-4060-9280-6bd804080bc7",
                        "source_entry_id": "f75890b7-7abf-3b5a-92f2-c4f42c25f50c",
                        "source_sense_id": "f598b2fc-dbb1-3509-8d90-f6abce7e9b5d",
                        "target_lang_word": "heel squatting position",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "ecb3928b-9c0d-4be9-9813-a61315639ef1",
                        "source_entry_id": "f75890b7-7abf-3b5a-92f2-c4f42c25f50c",
                        "source_sense_id": "f598b2fc-dbb1-3509-8d90-f6abce7e9b5d",
                        "target_lang_word": "crouch",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "crouch",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7186578e-f25f-3c0f-9a76-c234f03d0ab4",
                                        "entry_id": "b5a7c946-b3c6-32af-a84c-9734affcb6b5",
                                        "glosses": [
                                            "To bend down; to stoop low; to stand close to the ground with legs bent, like an animal when waiting for prey, or someone in fear."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b77794fb-22b9-43c9-8944-6e1ae1ae1506",
                                                "sense_id": "7186578e-f25f-3c0f-9a76-c234f03d0ab4",
                                                "text": "We crouched behind the low wall until the squad of soldiers had passed by."
                                            },
                                            {
                                                "example_id": "8401baa6-a052-4610-ac26-0ffe127261ef",
                                                "sense_id": "7186578e-f25f-3c0f-9a76-c234f03d0ab4",
                                                "text": "Archer and Jacob jumped up from behind the mound where they had been crouching with the intention of springing upon their mother unexpectedly, and they all began to walk slowly home."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4c88714f-a66c-31bd-9fad-b5aac4f03387",
                                        "entry_id": "b5a7c946-b3c6-32af-a84c-9734affcb6b5",
                                        "glosses": [
                                            "To bend servilely; to bow in reverence or humility."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "531f5102-57b7-4ffe-b571-3fd59e168a81",
                                                "sense_id": "4c88714f-a66c-31bd-9fad-b5aac4f03387",
                                                "text": "a crouching purpose"
                                            },
                                            {
                                                "example_id": "a6afc31b-1874-41a3-95a5-cea5b74a9603",
                                                "sense_id": "4c88714f-a66c-31bd-9fad-b5aac4f03387",
                                                "text": "kings ſhall crouch vnto our conquering ſwords,\nAnd hoſtes of Souldiers ſtand amazd at vs,\nWhen with their fearfull tongues they ſhall confeſſe\nTheſe are the men that al the world admires,"
                                            },
                                            {
                                                "example_id": "8a3a6ca2-4def-493d-88b4-b1e601e545ee",
                                                "sense_id": "4c88714f-a66c-31bd-9fad-b5aac4f03387",
                                                "text": "Must I stand and crouch\n Under your testy humour?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "crouch",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "67156eb2-fd01-356c-a05d-5bc3c97d3c8c",
                                        "entry_id": "4a2e8dfd-efde-3ef2-828e-e8e638d14551",
                                        "glosses": [
                                            "A bent or stooped position."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc7d98c7-d9bc-45b7-a480-9030dfb23598",
                                                "sense_id": "67156eb2-fd01-356c-a05d-5bc3c97d3c8c",
                                                "text": "The cat waited in a crouch, hidden behind the hedge."
                                            }
                                        ]
                                    }
