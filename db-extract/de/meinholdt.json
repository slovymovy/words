                "senses": [
                    {
                        "sense_id": "1eff30d8-6e66-3236-a7d9-0bd8772ff643",
                        "entry_id": "7e4ab47d-f1d5-35fc-908e-510c7d9a2202",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d3c3bf4e-7f62-4660-ab3d-86f728213440",
                                "sense_id": "1eff30d8-6e66-3236-a7d9-0bd8772ff643",
                                "text": "Frau Meinholdt ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "79252499-3e16-44eb-9e03-471477a1623c",
                                "sense_id": "1eff30d8-6e66-3236-a7d9-0bd8772ff643",
                                "text": "Herr Meinholdt wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "5dbc2b2d-df39-4351-8db6-04b11adb96cb",
                                "sense_id": "1eff30d8-6e66-3236-a7d9-0bd8772ff643",
                                "text": "Die Meinholdts fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "1fd7a1e3-4650-4635-9f4d-533b24be7650",
                                "sense_id": "1eff30d8-6e66-3236-a7d9-0bd8772ff643",
                                "text": "Der Meinholdt trägt nie die Schals, die die Meinholdt ihm strickt."
                            },
                            {
                                "example_id": "6b47ebe1-e888-4593-a640-958d494df8ef",
                                "sense_id": "1eff30d8-6e66-3236-a7d9-0bd8772ff643",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Meinholdt kommt, geht der Herr Meinholdt.“"
                            },
                            {
                                "example_id": "0df6f118-a6ee-4d6d-bc7a-0804d806932b",
                                "sense_id": "1eff30d8-6e66-3236-a7d9-0bd8772ff643",
                                "text": "Meinholdt kommt und geht."
                            },
                            {
                                "example_id": "501acf37-5266-4fad-a5ec-0370cabdd7b2",
                                "sense_id": "1eff30d8-6e66-3236-a7d9-0bd8772ff643",
                                "text": "Meinholdts kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
