                ],
                "senses": [
                    {
                        "sense_id": "e76dd950-ec2e-33fd-bdc9-f67391d98ea6",
                        "entry_id": "afddcc37-bc76-3858-8597-ac971e81208f",
                        "glosses": [
                            "Herstellung von Sitzen für Autos"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bb2eedab-6a65-45fe-9598-2ecb222faffa",
                                "sense_id": "e76dd950-ec2e-33fd-bdc9-f67391d98ea6",
                                "text": "„Die Firmen Daimler-Chrysler AG und General Motors werden hoffentlich ihr Engagement in diesem Bereich fortsetzen und auch in Zukunft die Hauptabnehmer von Qualitätsfasern für die Autositzproduktion bleiben.“"
                            },
                            {
                                "example_id": "6805822c-edd2-4a42-a7ea-6301c72a17b8",
                                "sense_id": "e76dd950-ec2e-33fd-bdc9-f67391d98ea6",
                                "text": "„Im benachbarten Newark habe ich mir den nordamerikanischen Hauptsitz der australischen Firma Futuris angesehen, die für ihre Autositzproduktion ein früheres Verteilungszentrum von Staples mit einer Fläche von eineinhalb Hektar übernommen hat.“"
                            },
                            {
                                "example_id": "2952c3f3-c3a9-49cb-9290-da930336f200",
                                "sense_id": "e76dd950-ec2e-33fd-bdc9-f67391d98ea6",
                                "text": "„Betroffen sind vorrangig arbeitsintensive, wenig automatisierbare Fertigungsbereiche, wie z.B. die Näherei der Autositzproduktion.“"
                            },
                            {
                                "example_id": "9f24fd50-8aa7-41d4-9bbc-c79fb08d77c0",
                                "sense_id": "e76dd950-ec2e-33fd-bdc9-f67391d98ea6",
                                "text": "„Auch unter weiß-blauer Herrschaft konnten die Gewerkschaften verhindern, daß Rover – wie etwa BMW in Regensburg – die Autositzproduktion nach draußen gibt.“"
                            },
                            {
                                "example_id": "22ac919b-91bc-49b1-82b0-051dec29f4e7",
                                "sense_id": "e76dd950-ec2e-33fd-bdc9-f67391d98ea6",
                                "text": "„Rund 50 Prozent der brasilianischen Lederexporte nach Europa gehen dabei in die Autositzproduktion.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
