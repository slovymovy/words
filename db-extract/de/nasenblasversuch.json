                "senses": [
                    {
                        "sense_id": "aaccfb08-1377-3cdd-8f4c-c66e4c2fb54e",
                        "entry_id": "622c51ac-741b-39e1-b9f1-e6cfc9748f2d",
                        "glosses": [
                            "routinemäßiges Diagnoseverfahren zum Ausschluss einer möglichen Mund-Antrum-Verbindung (MAV), einer Komplikation durch eine Extraktion (Zahnentfernung) von Molaren (große Backenzähne) im Oberkiefer in Form einer Eröffnung der Kieferhöhle"
                        ],
                        "tags": [
                            "Zahnmedizin"
                        ],
                        "examples": [
                            {
                                "example_id": "8e5430e7-6bd0-47cb-a3c5-fad7773fa6f1",
                                "sense_id": "aaccfb08-1377-3cdd-8f4c-c66e4c2fb54e",
                                "text": "Sollte die Extraktion eines Molaren im Oberkiefer eine offene Verbindung zur Mundhöhle bewirkt haben, weil während der Extraktion die dünne Knochenlamelle des darüberliegenden Kieferhöhlenbodens frakturiert ist, strömt beim Nasenblasversuch Luft durch die Alveole in den Mund. Dabei wird versucht, Luft bei zugehaltener Nase und offenem Mund durch die Nase zu pressen. Die Luft entweicht über die Nasen-Kieferhöhlen-Öffnung (Apertura nasomaxillaris) in die Kieferhöhle und dann über die Alveole (Zahnfach) in den Mund, was durch ein Zischen aus der Alveole deutlich hörbar ist."
                            },
                            {
                                "example_id": "6252e1a1-f42b-4a7a-8e59-bf92d7e8f247",
                                "sense_id": "aaccfb08-1377-3cdd-8f4c-c66e4c2fb54e",
                                "text": "Ein positiver Nasenblasversuch erfordert eine umgehende plastische Deckung der eröffneten Kieferhöhle, um einer Kieferhöhlenentzündung vorzubeugen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "445c7dd0-8fa8-3c09-819f-cd34781bd01c",
                        "entry_id": "622c51ac-741b-39e1-b9f1-e6cfc9748f2d",
                        "glosses": [
                            "Prüfung der Nasendurchgängigkeit, insbesondere beim Kleinkind, durch nasales Anblasenlassen eines kalten Metallspiegels"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ea5fa36-ae82-44d3-9f8a-b2d5dcce9142",
                                "sense_id": "445c7dd0-8fa8-3c09-819f-cd34781bd01c",
                                "text": "Bei einseitig behinderter Nasenatmung ist beim Nasenblasversuch ein ungleichseitiges Beschlagen eines unter die Nase gehaltenen kalten Metallspiegels festzustellen."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
