                                        "glosses": [
                                            "jeden z księżyców Saturna"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1.3\""
                                    },
                                    {
                                        "sense_id": "f6d8385d-802d-38e2-8091-b00efca77573",
