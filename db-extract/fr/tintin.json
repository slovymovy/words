            {
                "entry_id": "9c93a750-b1dc-31d2-b88e-b11e6a7088ef",
                "word": "Tintin",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "64423ff0-9f24-3796-b151-6fb0f3608041",
                        "entry_id": "9c93a750-b1dc-31d2-b88e-b11e6a7088ef",
                        "glosses": [
                            "Personnage de bande dessinée belge créé par Hergé."
                        ],
                        "tags": [
                            "Univers de Tintin"
                        ],
                        "examples": [
                            {
                                "example_id": "cfc62497-5b5c-44ba-b37f-69bfdeb36348",
                                "sense_id": "64423ff0-9f24-3796-b151-6fb0f3608041",
                                "text": "Depuis la mort d'Hergé, le succès des albums de Tintin ne se dément pas : les 24 titres se vendent encore à plus de 1 million d'exemplaires tous les ans."
                            },
                            {
                                "example_id": "b7ec53a4-c596-491e-a68a-106922f341b3",
                                "sense_id": "64423ff0-9f24-3796-b151-6fb0f3608041",
                                "text": "Le psychiatre, qui s’habille comme un personnage secondaire d’un album de Tintin, m’a expliqué que ça s’appelle du mentisme obsédant, ou de la rumination morbide."
                            }
                        ]
                    }
                ],
                "translations": [
