                "senses": [
                    {
                        "sense_id": "79743161-fc26-390e-9146-78f1092da60f",
                        "entry_id": "a71f911f-0680-3e5b-aec8-d993ab8e2d07",
                        "glosses": [
                            "waluta na Ukrainie w latach 1918–1920, 1942–1944, 1992–1996"
                        ],
