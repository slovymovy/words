        "fr-extract.jsonl": [
            {
                "entry_id": "3b273d97-b44f-3786-bfaf-ca6f46b443a6",
                "word": "récidivisme",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "3faaea45-c403-4c8a-af0c-ef0b97542e34",
                        "entry_id": "3b273d97-b44f-3786-bfaf-ca6f46b443a6",
                        "tags": [
                            "plural"
                        ],
                        "form": "récidivismes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "89e4f577-460d-3bb3-99df-5e2f56dd965b",
                        "entry_id": "3b273d97-b44f-3786-bfaf-ca6f46b443a6",
                        "glosses": [
                            "Tendance à récidiver."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a19db0a-2abd-4184-bd45-e8d29efbf305",
                                "sense_id": "89e4f577-460d-3bb3-99df-5e2f56dd965b",
                                "text": "On constate un taux de récidivisme de quatre-vingts pour cent parmi les jeunes en liberté conditionnelle ou sous probation."
                            },
                            {
                                "example_id": "873e4bd0-fc7b-4e00-9485-5c8477dc6705",
                                "sense_id": "89e4f577-460d-3bb3-99df-5e2f56dd965b",
                                "text": "Le constat est teinté de pessimisme : le criminel né est incorrigible et le récidivisme est une maladie incurable."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8039c6c0-90e5-474d-a6c3-b80b7d301611",
                        "source_entry_id": "3b273d97-b44f-3786-bfaf-ca6f46b443a6",
                        "source_sense_id": "89e4f577-460d-3bb3-99df-5e2f56dd965b",
                        "target_lang_word": "relapse",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "relapse",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "933f550f-df37-34d3-b0c3-8e1d29623460",
                                        "entry_id": "aaf1b19b-d889-3b30-9328-540a94433619",
                                        "glosses": [
                                            "To fall back again; to slide or turn back into a former state or practice."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4ada3202-51a0-4506-9b9b-c0982ae1aee1",
                                                "sense_id": "933f550f-df37-34d3-b0c3-8e1d29623460",
                                                "text": "He has improved recently but keeps relapsing into states of utter confusion."
                                            },
                                            {
                                                "example_id": "67c75978-a1d9-499f-b758-650777873674",
                                                "sense_id": "933f550f-df37-34d3-b0c3-8e1d29623460",
                                                "text": "to relapse into a stupor, into vice, or into barbarism"
                                            },
                                            {
                                                "example_id": "98c6692d-52b6-4f0e-9f96-3f7d6cef889c",
                                                "sense_id": "933f550f-df37-34d3-b0c3-8e1d29623460",
                                                "text": "to relapse into slumber after being disturbed"
                                            },
                                            {
                                                "example_id": "307996b3-ddfa-4895-86a4-3c7b13f14c10",
                                                "sense_id": "933f550f-df37-34d3-b0c3-8e1d29623460",
                                                "text": "Then we relapsed into a discomfited silence, and wished we were anywhere else. But Miss Thorn relieved the situation by laughing aloud, and with such a hearty enjoyment that instead of getting angry and more mortified we began to laugh ourselves, and instantly felt better."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "675d63fd-dcda-33dd-90ce-5c6503ab5ec6",
                                        "entry_id": "aaf1b19b-d889-3b30-9328-540a94433619",
                                        "glosses": [
                                            "To recur; to worsen, be aggravated (after a period of improvement)."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e27b8db5-dbfc-3637-b120-c0255e7691af",
                                        "entry_id": "aaf1b19b-d889-3b30-9328-540a94433619",
                                        "glosses": [
                                            "To return to a vice, especially self-harm or alcoholism, failing to maintain abstinence."
                                        ],
                                        "tags": [
                                            "informal",
                                            "intransitive",
                                            "specifically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b22ea5da-9e7f-4fcd-a342-6427c81cd0ad",
                                                "sense_id": "e27b8db5-dbfc-3637-b120-c0255e7691af",
                                                "text": "relapsed after 5 months of being clean"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "95248385-1dd6-3dd0-a3a3-72a3f084b111",
                                        "entry_id": "aaf1b19b-d889-3b30-9328-540a94433619",
                                        "glosses": [
                                            "To slip or slide back physically; to turn back."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d0bd72a4-bee6-449d-8502-c4f29a213a7e",
                                                "sense_id": "95248385-1dd6-3dd0-a3a3-72a3f084b111",
                                                "text": "You slip your hold and change your side,\nRelapsing from a necessary guide."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "relapse",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e8b2feed-b98b-37db-819c-afaad8e41052",
                                        "entry_id": "1a51389d-0810-3810-99e4-5cdf41913eca",
                                        "glosses": [
                                            "The act or situation of relapsing."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ebe749ac-cacc-4dc2-b0da-4ff2191bb158",
                                                "sense_id": "e8b2feed-b98b-37db-819c-afaad8e41052",
                                                "text": "a drug relapse"
                                            },
                                            {
                                                "example_id": "a06e43a2-dc2f-4f9c-bab6-dbde5cf05eda",
                                                "sense_id": "e8b2feed-b98b-37db-819c-afaad8e41052",
                                                "text": "Alas! from what high hope to what relapse / Unlooked for are we fallen!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "47f5ee80-e988-3c0e-a3ba-6a62e9b87884",
                                        "entry_id": "1a51389d-0810-3810-99e4-5cdf41913eca",
                                        "glosses": [
                                            "An occasion when a person becomes ill again after a period of improvement"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b1645117-2d6e-39e4-a709-ad3f309049e3",
                                        "entry_id": "1a51389d-0810-3810-99e4-5cdf41913eca",
                                        "glosses": [
                                            "One who has relapsed, or fallen back into error; a backslider."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
