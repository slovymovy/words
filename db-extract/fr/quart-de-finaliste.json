                    },
                    {
                        "sense_id": "7ec36b50-2db6-35c9-8cc9-c89052f88fd7",
                        "entry_id": "31949b6f-0429-331b-8a66-a596790942bb",
                        "glosses": [
                            "Qui a été éliminé en quart de finale."
