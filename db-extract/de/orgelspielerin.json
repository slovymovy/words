                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2aee25a4-2792-426e-af40-d7c8022152b4",
                                "sense_id": "4e650afb-5ce4-3f6e-9e55-53396e62a8de",
                                "text": "Die Orgelspielerin kam zu spät zur Chorprobe."
                            },
                            {
                                "example_id": "989078ea-f944-43a7-9d82-a69bf55d2412",
                                "sense_id": "4e650afb-5ce4-3f6e-9e55-53396e62a8de",
                                "text": "„Doch die Gemeindevertreterin fragte mitnichten nach einer Orgelerlaubnis, sondern begrüßte die Orgelspielerin bloß - und eilte dann rasch von dannen: Um die Beschallung des Marktes aus der Konserve abzuschalten.“"
                            }
                        ],
