                "senses": [
                    {
                        "sense_id": "2afc1772-eea0-3afa-92eb-0bf0c5202693",
                        "entry_id": "683bc434-8bf6-312d-9656-47dca153134d",
                        "glosses": [
                            "Verein hauptberuflicher Journalisten, deren Aufgabe darin besteht, über die Bundespolitik zu berichten, wozu sie die Bundesregierung, aber auch andere Akteure, zu politischem Geschehen einladen und befragen"
                        ],
                        "tags": [
                            "Germany",
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "da14f48e-2ccc-4de9-b70d-276677fa3bea",
                                "sense_id": "2afc1772-eea0-3afa-92eb-0bf0c5202693",
                                "text": "„Die Bundespressekonferenz hat organisatorisch weder etwas mit der Bundesregierung noch mit dem Presse- und Informationsamt der Bundesregierung zu tun. Die Bundespressekonferenz e. V. ist ein eingetragener Verein in Berlin - mit Bonner Außenstelle.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "1023a75c-64de-3c63-871b-a79616ff8b16",
                        "entry_id": "683bc434-8bf6-312d-9656-47dca153134d",
                        "glosses": [
                            "eine von den Mitgliedern des Vereins abgehaltene Pressekonferenz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "498c08fb-a9e1-440a-a3a0-d2f1d10ed747",
                                "sense_id": "1023a75c-64de-3c63-871b-a79616ff8b16",
                                "text": "„Zwei Tage nach der wieder mühseligen MPK zur Verlängerung und Verschärfung der Anti-Corona-Maßnahmen geht die Kanzlerin in die Bundespressekonferenz, um den Bürgerinnen und Bürgern die Gründe für die tiefen Einschnitte noch einmal zu erklären.“"
                            },
                            {
                                "example_id": "e760338e-2808-44bb-9e09-ad10123eb67f",
                                "sense_id": "1023a75c-64de-3c63-871b-a79616ff8b16",
                                "text": "„Wie ist die aktuelle Situation in Sachen Corona? Bundesgesundheitsminister Jens Spahn skizziert die Lage in der Bundespressekonferenz.“"
                            },
                            {
                                "example_id": "2f50daf3-4325-4d11-8e23-bf3517803e70",
                                "sense_id": "1023a75c-64de-3c63-871b-a79616ff8b16",
                                "text": "„Im Gegensatz zur Praxis in vielen anderen Staaten sind die „Hausherren“ der Bundespressekonferenzen die Journalisten selbst und nicht die Regierung, Ministerien, Parteien, Verbände, Weltanschauungsgemeinschaften oder einzelne Politiker. “"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
