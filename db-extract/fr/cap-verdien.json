                                        "sense_id": "43779432-90ff-3307-af81-633687ed043c",
                                        "entry_id": "fee9ee6b-05c8-3be3-aa67-75c9f96ef78d",
                                        "glosses": [
                                            "Of, from, or pertaining to Cape Verde, the Cape Verdean people or the Cape Verdean language."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "95d53c97-cf70-4588-ad7f-7b9399801da8",
                                                "sense_id": "43779432-90ff-3307-af81-633687ed043c",
                                                "text": "I hear [...] the surf on the Cape Verdean beaches is incredible."
                                            },
                                            {
                                                "example_id": "c0cb1d17-361c-4fa8-b785-4e714bb71192",
                                                "sense_id": "43779432-90ff-3307-af81-633687ed043c",
                                                "text": "He was a Cape Verdean boy who identified as Portuguese to differentiate himself from African Americans, despite being nearly the same shade as Davis."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Cape Verdean",
                                "target_lang_code": "en",
                                "target_senses": [
