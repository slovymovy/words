                "senses": [
                    {
                        "sense_id": "8574d28e-0160-3463-9c81-726429d89cb4",
                        "entry_id": "c1672a35-a109-3a5a-bb5a-55719a2d1c27",
                        "glosses": [
                            "Continuer à gratter une surface jusqu’à la nettoyer complètement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d793bac9-ec24-476d-9cc0-7d8b2b68c809",
                                "sense_id": "8574d28e-0160-3463-9c81-726429d89cb4",
                                "text": "[…] des larges tranches de pain raclant le bon jus et le reraclant jusqu’à parfaite asaucie de l’assiette."
                            },
                            {
                                "example_id": "c040eea2-5181-4065-8594-8803110e69be",
                                "sense_id": "8574d28e-0160-3463-9c81-726429d89cb4",
                                "text": "La bonne fécule, on la reraclait au fond, on la relavait."
                            },
                            {
                                "example_id": "002d04c7-db25-4f43-a691-def8b2bdd846",
                                "sense_id": "8574d28e-0160-3463-9c81-726429d89cb4",
                                "text": "Un palimpseste, malgré l’aspect pour nous pittoresque du mot, ce n’est pas un grimoire-gribouillis ; c’était un parchemin reraclé."
                            }
                        ]
                    }
