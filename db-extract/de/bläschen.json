                ],
                "senses": [
                    {
                        "sense_id": "47d5252e-3e1d-3b12-a194-0a57cf34ca82",
                        "entry_id": "003df887-6200-361c-b4ba-16b644639727",
                        "glosses": [
                            "kleine Blase"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "882acecc-3d82-4267-9d77-4086fd86cab2",
                                "sense_id": "47d5252e-3e1d-3b12-a194-0a57cf34ca82",
                                "text": "Hier im Wasser erkennt man viele Bläschen."
                            },
                            {
                                "example_id": "c795e30d-deba-4ac0-b8ea-7e120be3d14a",
                                "sense_id": "47d5252e-3e1d-3b12-a194-0a57cf34ca82",
                                "text": "„Wenn er mit den Armen paddelte, wurden auch sie von silbernen Bläschen nachgezeichnet.“"
                            },
                            {
                                "example_id": "3219f793-c8f7-4c36-a738-b2a7d713ec5f",
                                "sense_id": "47d5252e-3e1d-3b12-a194-0a57cf34ca82",
                                "text": "„Auf den Feldern stiegen die Lerchen trillernd auf, eine nach der andern, wie Bläschen im Wasser.“"
                            },
                            {
                                "example_id": "9f05b6fa-72d8-47d0-9094-0d928805e438",
                                "sense_id": "47d5252e-3e1d-3b12-a194-0a57cf34ca82",
                                "text": "„Ein Zittern ergreift seinen Körper, und als er den Mund öffnet, sieht man nur, wie die Speichelfäden und Bläschen sofort gefrieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
