                        "entry_id": "930c2d2d-4d4e-3db9-991a-eaa0daf2f882",
                        "glosses": [
                            "Variante de clamser (mourir)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "65742118-f2d3-4099-a2ec-7a4b3e63355f",
                                "sense_id": "0f2d95e9-1653-3efb-837b-5ecd1f691793",
                                "text": "Alors quoi, vous croyez qu'il vous empêchera de cramser s'il vous passe un camion sur le ventre ?"
                            },
                            {
                                "example_id": "f926e225-0894-4a86-b4b6-5f289d519c6a",
                                "sense_id": "0f2d95e9-1653-3efb-837b-5ecd1f691793",
                                "text": "Seulement, comme si t'attends les brancardiers t'es sûr de cramser sur l'tas, v'là comment que j'ferais."
                            }
                        ]
                    }
