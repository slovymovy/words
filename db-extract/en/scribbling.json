                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5408ba6e-012f-420a-a113-91dc7eac725b",
                                                "sense_id": "b7495e23-aa34-3a47-997c-83a9649167de",
