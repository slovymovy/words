                    {
                        "sense_id": "b3598ccc-83b7-31cb-8c73-17a1275caa97",
                        "entry_id": "dd03ad6f-6c86-3ae8-a85c-7ac791479443",
                        "glosses": [
                            "Angriffsform von Bombern, bei welcher viele Bomben gleichzeitig auf einem bestimmten Ziel explodieren sollen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8cd973c4-3178-44ef-aa5f-fc1b782955be",
                                "sense_id": "b3598ccc-83b7-31cb-8c73-17a1275caa97",
                                "text": "„Ähnliches ereignete sich 2016 in Syrien, als Russlands Armee die Rebellenhochburg Aleppo mit einem Bombenteppich überzog.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "504e66e3-ff70-47ba-aadf-46bcbdc409a3",
                        "source_entry_id": "dd03ad6f-6c86-3ae8-a85c-7ac791479443",
                        "source_sense_id": "b3598ccc-83b7-31cb-8c73-17a1275caa97",
                        "source_sense_description": "Angriffsform, bei der viele Bomben dicht nebeneinander abgeworfen werden",
                        "target_lang_word": "tapis de bombes",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tapis de bombes",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "16b3c488-9819-33a8-8f56-b5cc04389c57",
                                        "entry_id": "a9f26e89-141c-312e-b8e2-6781bd0e701b",
                                        "glosses": [
                                            "Bombardement massif d’une zone géographique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6eeea711-74c6-4265-b8d2-5333a5b6d5c9",
                                                "sense_id": "16b3c488-9819-33a8-8f56-b5cc04389c57",
                                                "text": "Le commandement américain, constatant que le tapis de bombes déversé quotidiennement sur les accès à la ligne de démarcation ne donnait pas les résultats espérés, décida de frapper plus loin."
                                            },
                                            {
                                                "example_id": "ce7995d8-aede-43d9-a778-8703db95a37f",
                                                "sense_id": "16b3c488-9819-33a8-8f56-b5cc04389c57",
                                                "text": "Sur un objectif étendu en surface, on l’a vu, un tapis de bombes est plus efficace qu’une bombe unique d’égale énergie ; mais contre un objectif ponctuel, il revient à vouloir remplir un flacon à goulot étroit avec un arrosoir, […]."
                                            },
                                            {
                                                "example_id": "16aae4bd-8d41-4a49-9fda-643378b40373",
                                                "sense_id": "16b3c488-9819-33a8-8f56-b5cc04389c57",
                                                "text": "Les B 52 qui décollaient de Diego Garcia, d’Espagne et de Grande-Bretagne ont déversé des tapis de bombes sur les troupes ennemies, opérations qui n'ont pas épargné les zones résidentielles, […]."
                                            },
                                            {
                                                "example_id": "b343adff-6019-41e7-9ca8-e8d921241d59",
                                                "sense_id": "16b3c488-9819-33a8-8f56-b5cc04389c57",
                                                "text": "« Le ressort n’est pas cassé il est en train de se tendre. Après les élections, en juillet, viendra la mise en œuvre d’une feuille de route radicale et profonde, et là ce sera le tapis de bombes », promet le député."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
