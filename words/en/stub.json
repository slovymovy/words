                            {
                                "target_lang_word": "бычок",
                                "target_lang_sense_clarification": "разговорное, окурок"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4d27dfc3-fa76-3512-ad66-0bb4ecbabb9d",
