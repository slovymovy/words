                                        "examples": [
                                            {
                                                "example_id": "6ee56509-c903-4bb3-87de-5e7e978cf83b",
                                                "sense_id": "22dc55ab-e10c-3041-9a9a-4795e7d9386e",
                                                "text": "L’agence, dont le siège est à Fort Meade, une cinquantaine de kilomètres au nord-est de Washington, emploierait plus de 35 000 agents, chargés de ce travail sisyphien de collecte et ratissage des communications du monde entier, mais dans l’opacité la plus totale."
                                            }
                                        ]
