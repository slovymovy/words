                    "frequency": "Low",
                    "semantic_group_id": "anthroponym",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Моего нового коллегу по работе зовут <w>Арарат</w>.",
                            "target_lang_translations": {
                                "en": "My new coworker's name is <w>Ararat</w>."
                            }
                        },
                        {
                            "text": "Мы долго разговаривали с <w>Араратом</w> о его родном городе.",
                            "target_lang_translations": {
                                "en": "We talked with <w>Ararat</w> for a long time about his hometown."
                            }
