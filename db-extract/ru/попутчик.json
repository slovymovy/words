                "senses": [
                    {
                        "sense_id": "caa65c3b-ec4f-3710-b8e2-173791ad4797",
                        "entry_id": "6d766b02-c975-37fe-8e8f-edd3a6e2d553",
                        "glosses": [
                            "fellow traveller"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c5fe1e3b-0541-4ea8-9254-61af2dc27b37",
                                "sense_id": "caa65c3b-ec4f-3710-b8e2-173791ad4797",
                                "text": "Переобу́лся Ива́н Лео́нтьич из ва́ленков в сапоги́, оде́л сюрту́к и сел к самова́ру, а ма́тушка ста́ла его́ спра́шивать: по како́му он тако́му церко́вному де́лу прие́хал, что да́же на пра́здничных днях побеспоко́ился, и куда́ его́ попу́тчик от на́ших воро́т де́лся?",
                                "translation": "Ivan Leontych changed his felt boots for leather ones, put on a frock coat, and sat down by the samovar, and mother began asking him what sort of church business he had come on, that he should go to the trouble even during the feast days, and where his companion by our gate had disappeared to.",
                                "english": "Ivan Leontych changed his felt boots for leather ones, put on a frock coat, and sat down by the samovar, and mother began asking him what sort of church business he had come on, that he should go to the trouble even during the feast days, and where his companion by our gate had disappeared to."
                            }
                        ]
                    }
