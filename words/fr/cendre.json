            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9dac63d8-87bb-3829-9506-c94b73978dfb",
                    "sense_definition": "Résidu pulvérulent laissé par la combustion complète ou partielle d'une matière par le feu.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "residu",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a nettoyé la <w>cendre</w> de la cheminée avant d'allumer un nouveau feu."
                        },
                        {
                            "text": "Le vent a dispersé la fine <w>cendre</w> sur toute la terrasse du jardin."
                        }
                    ],
                    "common_phrases": [
                        "cendre de bois",
                        "renaître de ses cendres",
                        "réduire en cendres"
                    ]
                },
                {
                    "sense_id": "54c12c28-c57c-39c8-aafb-0e8bf5dbcb24",
                    "sense_definition": "Restes d'un corps humain après sa crémation.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "deces",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La famille a dispersé les <w>cendres</w> du défunt dans l'océan selon ses dernières volontés."
                        },
                        {
                            "text": "Les <w>cendres</w> de ce grand écrivain ont été transférées au Panthéon."
                        }
                    ],
                    "synonyms": [
                        "restes"
                    ],
                    "common_phrases": [
                        "disperser les cendres",
                        "urne de cendres"
                    ]
                },
                {
                    "sense_id": "fdec22fd-3795-3434-a437-9cc529922ec0",
                    "sense_definition": "Poussière rituelle utilisée par l'Église pour marquer le front des croyants au début du carême.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "liturgie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les fidèles se rassemblent à l'église pour recevoir la <w>cendre</w> sur leur front."
                        },
                        {
                            "text": "Le prêtre applique un peu de <w>cendre</w> bénite en prononçant une prière traditionnelle."
                        }
                    ],
                    "common_phrases": [
                        "mercredi des Cendres"
                    ]
                },
                {
                    "sense_id": "0302a253-6d93-307f-8a9f-361b1aa46632",
                    "sense_definition": "Couleur grise et terne semblable à celle de la matière consumée.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "aspect",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le ciel d'hiver avait une triste couleur de <w>cendre</w> juste avant l'orage."
                        },
                        {
                            "text": "Elle a choisi une nuance tirant sur la <w>cendre</w> pour ses cheveux."
                        }
                    ],
                    "common_phrases": [
                        "couleur de cendre"
                    ]
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8e92e11b-0475-395b-83f0-86ca74c047f3",
                    "sense_definition": "Première personne du singulier de l'indicatif présent du verbe <w>cendrer</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "grammaire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je <w>cendre</w> soigneusement ce fromage de chèvre pour lui donner une croûte protectrice."
                        },
                        {
                            "text": "Chaque hiver, je <w>cendre</w> l'allée verglacée pour éviter que les visiteurs ne glissent."
                        }
                    ]
