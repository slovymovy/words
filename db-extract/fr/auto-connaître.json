                        "glosses": [
                            "Se connaître soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f42abda2-32b9-46df-bd14-2357f297ff52",
                                "sense_id": "ad4ad5f4-2f84-3dcb-b980-aaa8d9ea36d0",
                                "text": "Le cercle vicieux dénoncé par Kant trouve sa solution si nous admettons que la vision n’a pas besoin pour s’auto-connaître, de se voir encore elle-même."
                            },
                            {
                                "example_id": "d899c1e9-6161-4820-b9c3-216850988b52",
                                "sense_id": "ad4ad5f4-2f84-3dcb-b980-aaa8d9ea36d0",
                                "text": "D’une part, l’être humain observé est doté du computo (C) et du sentiment (S) et c’est grâce à cela qu’il est en mesure de s’auto-connaître et de s’auto-définir, C computant S, soi-même, ainsi que l’autos qui résulte de la circularité entre C et S."
                            }
                        ]
                    }
