                                    {
                                        "sense_id": "cb20f957-9e4f-378b-a080-d29a70322eac",
                                        "entry_id": "16d91543-f991-36c7-a809-752653ff535a",
                                        "glosses": [
                                            "diz-se de quem foi sentenciado como criminoso"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36248459-35be-4060-9510-0b43d18629a2",
                                                "sense_id": "cb20f957-9e4f-378b-a080-d29a70322eac",
                                                "text": "Após dez dias, no mais longo júri da Justiça Federal do País, o ex-delegado da Polícia Federal Carlos Leonel da Silva Cruz foi condenado ontem a 27 anos de prisão, por 5 votos a 2, pelo Tribunal do Júri."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9711c6a8-ae81-307b-b580-a6190d6d6fcd",
                                        "entry_id": "16d91543-f991-36c7-a809-752653ff535a",
                                        "glosses": [
                                            "diz-se de doente sem chances de recuperação"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04313827-da19-4360-b349-3ffc2d169d74",
                                                "sense_id": "9711c6a8-ae81-307b-b580-a6190d6d6fcd",
                                                "text": "Agrilhoado, condenado à imobilidade e à dor, seu verbo se sobrepõe à ação."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "899eb6f1-823a-3b13-adb0-efa20b92380c",
                                        "entry_id": "16d91543-f991-36c7-a809-752653ff535a",
                                        "glosses": [
                                            "destinado"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd0d2d46-ca2a-4270-8ead-def79c56b375",
                                                "sense_id": "899eb6f1-823a-3b13-adb0-efa20b92380c",
                                                "text": "O ser humano está condenado de antemão à derrota sem apelação, mas é preciso lutar de cara limpa e da melhor forma possível sem pedir clemência (mesmo porque não te darão), tentando cair como um valente."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "condenado",
                                "target_lang_code": "pt",
                                "target_senses": [
                                    {
                                        "sense_id": "8b390510-df76-3265-a5b8-e3d533b03dce",
                                        "entry_id": "2dc8236b-3b54-354d-8a95-0d973e0f1b65",
                                        "glosses": [
                                            "o que foi sentenciado como criminoso"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c165e1eb-6718-4862-b606-c1dd613c5d4a",
                                                "sense_id": "8b390510-df76-3265-a5b8-e3d533b03dce",
                                                "text": "Terminou ontem a operação pente-fino da Polícia Militar Ambiental e da Fundação Florestal na Estação Ecológica de Juréia, no litoral sul de São Paulo. Iniciada às 15 horas de sexta-feira, resultou em 7 autos de infração, embargo de 21 hectares, fiscalização em 12 propriedades, 15 apreensões de palmito, 1 arma apreendida e 1 prisão por tráfico de droga com um condenado recapturado."
                                            }
                                        ]
