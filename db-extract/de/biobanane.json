                "senses": [
                    {
                        "sense_id": "b90d1cde-150a-3de8-a80d-f17ff2facf8b",
                        "entry_id": "72297571-e6b1-3178-9459-96116daeb9ed",
                        "glosses": [
                            "Banane, die aus ökologischer Landwirtschaft und umweltfreundlicher Herstellung stammt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6873c484-b232-460d-8ce1-fdddba634536",
                                "sense_id": "b90d1cde-150a-3de8-a80d-f17ff2facf8b",
                                "text": "„Mein Gemüsekonsum verdreifacht sich auf fast 120 Kilo, der von – Biobananen ausgenommen – heimischem Obst verfünffacht sich sogar auf über 50 Kilo.“"
                            },
                            {
                                "example_id": "216746a1-6a15-47cc-b8df-a65729769c3f",
                                "sense_id": "b90d1cde-150a-3de8-a80d-f17ff2facf8b",
                                "text": "„Für den Bananentee benötigen Sie eine Biobanane, 300 ml Wasser, nach Belieben eine Prise Ceylon-Zimt und ein wenig Honig.“"
                            },
                            {
                                "example_id": "9c30827c-81b1-4bbf-a389-0fd3d3c0294d",
                                "sense_id": "b90d1cde-150a-3de8-a80d-f17ff2facf8b",
                                "text": "„Zukünftig ist auch der Export von fair angebauten Biobananen und die Herstellung von Kakao- und Kaffeelikör geplant.“"
                            },
                            {
                                "example_id": "17383fcc-cb24-4561-9805-d7640cc9b7d8",
                                "sense_id": "b90d1cde-150a-3de8-a80d-f17ff2facf8b",
                                "text": "„Zwei Stunden später schließt sich ein ausgiebiges Müslifrühstück mit einem frischen Apfel und einer Biobanane nahtlos an.“"
                            },
                            {
                                "example_id": "69a8130d-acf5-4304-8c9e-67df3afdeaec",
                                "sense_id": "b90d1cde-150a-3de8-a80d-f17ff2facf8b",
                                "text": "„Ungeziefer hatte seine Plantage verschont und er würde für seine Biobananen einen halbwegs vernünftigen Preis bekommen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
