                                        "entry_id": "60028b2b-682e-36dd-88f2-f5eef6df6c8b",
                                        "glosses": [
                                            "Población (grupo de personas con características en común que se usará para obtener muestras y contrastarlas con las de otros grupos diferentes)."
                                        ],
                                        "tags": [
                                            "epistemología"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "125525dd-7057-4bc6-b9cd-84cb49abe6af",
                                                "sense_id": "45918780-3e2d-35d5-9b0a-65b5186f2cf1",
                                                "text": "La mayoría de las investigaciones sobre dieta y salud se basan en estudios de cohortes en los que se compara la salud de las personas que comen de cierta manera con la salud de quienes comen de manera diferente."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
