                                "target_senses": [
                                    {
                                        "sense_id": "5fe400ed-c0ac-302c-a0b5-18918fa571c3",
                                        "entry_id": "a70ba9c1-f5b4-329a-9877-456e74e010e2",
                                        "glosses": [
                                            "The state of being unnatural."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "65b1f7a3-e527-446a-a149-f795a6e11e25",
                                                "sense_id": "5fe400ed-c0ac-302c-a0b5-18918fa571c3",
                                                "text": "However, the American sensibility was less caught up in Angst and unnaturalness; it rejected the antibeauty implication of the Europeans."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
