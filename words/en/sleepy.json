{
    "word_family": [
        "sleep",
        "sleeper",
        "sleepless",
        "sleepiness",
        "sleepily"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "83a500b8-458f-3551-ad01-5f86ba8918de",
                    "sense_definition": "Tired; feeling the need for sleep.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "physical_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>sleepy</w> child rubbed his eyes and asked for his teddy bear.",
                            "target_lang_translations": {
                                "ru": "<w>Со́нный</w> ребёнок потёр глаза и попросил своего плюшевого мишку.",
                                "zh": "那个<w>困倦</w>的孩子揉了揉眼睛，要他的泰迪熊。",
                                "es": "El niño <w>soñoliento</w> se frotó los ojos y pidió su osito de peluche."
                            }
                        },
                        {
                            "text": "I always feel <w>sleepy</w> after eating a large lunch on Sunday.",
                            "target_lang_translations": {
                                "ru": "Я всегда чувствую себя <w>со́нным</w> после плотного обеда в воскресенье.",
                                "zh": "周日吃完丰盛的午餐后，我总是感到很<w>困</w>。",
                                "es": "Siempre me siento <w>soñoliento</w> después de comer un almuerzo abundante el domingo."
                            }
                        }
                    ],
                    "synonyms": [
                        "tired",
                        "drowsy",
                        "weary",
                        "exhausted",
                        "heavy"
                    ],
                    "antonyms": [
                        "nonsleepy",
                        "unsleepy"
                    ],
                    "common_phrases": [
                        "feel sleepy",
                        "look sleepy",
                        "sleepy eyes",
                        "sleepy voice"
                    ],
                    "target_lang_definitions": {
                        "ru": "Уставший; испытывающий потребность во сне.",
                        "zh": "感到疲倦，有睡意。",
                        "es": "Cansado o con necesidad de dormir; que tiene sueño."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "со́нный",
                                "target_lang_sense_clarification": "испытывающий желание спать"
                            },
                            {
                                "target_lang_word": "сонли́вый",
                                "target_lang_sense_clarification": "склонный ко сну, вялый"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "困",
                                "target_lang_sense_clarification": "感到疲倦想睡觉"
                            },
                            {
                                "target_lang_word": "困倦",
                                "target_lang_sense_clarification": "疲倦想睡"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "somnoliento",
                                "target_lang_sense_clarification": "que tiene sueño; uso más natural y frecuente"
                            },
                            {
                                "target_lang_word": "soñoliento",
                                "target_lang_sense_clarification": "variante frecuente, algo más literaria o regional"
                            },
                            {
                                "target_lang_word": "tener sueño",
                                "target_lang_sense_clarification": "expresión verbal muy común: sentir necesidad de dormir"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "010b3d46-d727-39a3-8e1c-a72cf8ee3fc3",
                    "sense_definition": "Quiet; without bustle or activity.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "atmosphere",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We moved to a <w>sleepy</w> village where nothing exciting ever happens.",
                            "target_lang_translations": {
                                "ru": "Мы переехали в <w>со́нную</w> деревню, где никогда не происходит ничего захватывающего.",
                                "zh": "我们搬到了一个<w>宁静</w>的村庄，那里从没发生过什么刺激的事。",
                                "es": "Nos mudamos a un pueblo <w>tranquilo</w> donde nunca pasa nada emocionante."
                            }
                        },
                        {
                            "text": "The shop is located in a <w>sleepy</w> corner of the busy city.",
                            "target_lang_translations": {
                                "ru": "Магазин расположен в <w>ти́хом</w> уголке шумного города.",
                                "zh": "这家店坐落在繁华都市中一个<w>冷清</w>的角落。",
                                "es": "La tienda está situada en un rincón <w>tranquilo</w> de la bulliciosa ciudad."
                            }
                        }
                    ],
                    "synonyms": [
                        "quiet",
                        "slow",
                        "inactive"
                    ],
                    "common_phrases": [
                        "sleepy village",
                        "sleepy town",
                        "sleepy hollow",
                        "sleepy suburb"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тихий; без суеты или активности.",
                        "zh": "安静的；缺乏活力或活动的。",
                        "es": "Tranquilo, sin mucho movimiento, bullicio ni actividad."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "со́нный",
                                "target_lang_sense_clarification": "перен. тихий, замерший"
                            },
                            {
                                "target_lang_word": "ти́хий",
                                "target_lang_sense_clarification": "спокойный, безлюдный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "宁静的",
                                "target_lang_sense_clarification": "形容地方安静、少有活动"
                            },
                            {
                                "target_lang_word": "冷清的",
                                "target_lang_sense_clarification": "形容地方人少、不热闹"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "tranquilo",
                                "target_lang_sense_clarification": "calmo, con poca actividad o movimiento"
                            },
                            {
                                "target_lang_word": "apacible",
                                "target_lang_sense_clarification": "sin bullicio ni mucha vida"
                            },
                            {
                                "target_lang_word": "adormecido",
                                "target_lang_sense_clarification": "con poca actividad; algo desierto o parado"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0c3972c9-7111-3edb-a247-145e559c155f",
                    "sense_definition": "Tending to induce sleep.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "causative",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor prescribed a <w>sleepy</w> medicine to help the patient rest.",
                            "target_lang_translations": {
                                "ru": "Врач прописал <w>снотво́рное</w> лекарство, чтобы помочь пациенту отдохнуть.",
                                "zh": "医生给病人开了<w>助眠</w>药，以帮助他休息。",
                                "es": "El médico recetó un medicamento <w>somnífero</w> para ayudar al paciente a descansar."
                            }
                        },
                        {
                            "text": "The warm sun and gentle breeze had a <w>sleepy</w> effect on the picnic group.",
                            "target_lang_translations": {
                                "ru": "Тёплое солнце и лёгкий ветерок оказали <w>усыпля́ющий</w> эффект на группу на пикнике.",
                                "zh": "温暖的阳光和微风让野餐小组感到一阵<w>催眠</w>。",
                                "es": "El sol cálido y la brisa suave tuvieron un efecto <w>somnífero</w> en el grupo de picnic."
                            }
                        }
                    ],
                    "synonyms": [
                        "soporific",
                        "hypnotic",
                        "somniferous",
                        "somnific"
                    ],
                    "common_phrases": [
                        "sleepy potion",
                        "sleepy drink",
                        "sleepy effect"
                    ],
                    "target_lang_definitions": {
                        "ru": "Склонный вызывать сон.",
                        "zh": "容易引起睡意的。",
                        "es": "Que tiende a producir sueño o a provocar somnolencia."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "усыпля́ющий",
                                "target_lang_sense_clarification": "навевающий сон"
                            },
                            {
                                "target_lang_word": "снотво́рный",
                                "target_lang_sense_clarification": "о лекарствах или средствах"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "催眠的",
                                "target_lang_sense_clarification": "使人产生睡意"
                            },
                            {
                                "target_lang_word": "助眠的",
                                "target_lang_sense_clarification": "有助于睡眠的"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "somnífero",
                                "target_lang_sense_clarification": "que produce sueño; especialmente de medicamentos o sustancias"
                            },
                            {
                                "target_lang_word": "soporífero",
                                "target_lang_sense_clarification": "que da sueño o invita a dormir"
                            },
                            {
                                "target_lang_word": "sedante",
                                "target_lang_sense_clarification": "que provoca somnolencia"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9d05c477-b1ec-3845-88a1-c61d12c0c3f0",
                    "sense_definition": "Dull; lazy or inactive.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The manager complained about the <w>sleepy</w> pace of the construction work.",
                            "target_lang_translations": {
                                "ru": "Менеджер жаловался на <w>вя́лый</w> темп строительных работ.",
                                "zh": "经理抱怨施工进度太<w>迟缓</w>了。",
                                "es": "El gerente se quejó del ritmo <w>lento</w> de la obra."
                            }
                        },
                        {
                            "text": "Do not be <w>sleepy</w> in your duties if you want a promotion.",
                            "target_lang_translations": {
                                "ru": "Не будьте <w>вя́лыми</w> в своих обязанностях, если хотите повышения.",
                                "zh": "如果你想升职，工作时就不要表现得那么<w>懒散</w>。",
                                "es": "No seas <w>perezoso</w> en tus obligaciones si quieres un ascenso."
                            }
                        }
                    ],
                    "synonyms": [
                        "sluggish",
                        "inactive",
                        "dull"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "mostly found in older literature"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Скучный; ленивый или неактивный.",
                        "zh": "迟钝的；懒散或不活跃的。",
                        "es": "Lento, apagado o poco activo; perezoso o sin energía."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вя́лый",
                                "target_lang_sense_clarification": "медлительный, без энергии"
                            },
                            {
                                "target_lang_word": "медли́тельный",
                                "target_lang_sense_clarification": "неспешный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "迟缓的",
                                "target_lang_sense_clarification": "动作或反应慢"
                            },
                            {
                                "target_lang_word": "懒散的",
                                "target_lang_sense_clarification": "缺乏干劲"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "lento",
                                "target_lang_sense_clarification": "falto de energía o viveza"
                            },
                            {
                                "target_lang_word": "perezoso",
                                "target_lang_sense_clarification": "poco activo o sin iniciativa"
                            },
                            {
                                "target_lang_word": "apático",
                                "target_lang_sense_clarification": "sin fuerza ni dinamismo"
                            },
                            {
                                "target_lang_word": "somnoliento",
                                "target_lang_sense_clarification": "uso más formal; remiso o poco diligente"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "48940233-b0be-30c1-be35-fc52a4eff38a",
                    "sense_definition": "Dried mucus that accumulates in the corner of the eye during sleep.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "substance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The toddler woke up with <w>sleepies</w> in the corners of his eyes.",
                            "target_lang_translations": {
                                "ru": "Малыш проснулся с <w>кисля́чками</w> в уголках глаз.",
                                "zh": "那个幼儿醒来时，眼角还带着<w>眼屎</w>。",
                                "es": "El niño pequeño se despertó con <w>legañas</w> en las comisuras de los ojos."
                            }
                        },
                        {
                            "text": "You should wash your face to get rid of the <w>sleepies</w>.",
                            "target_lang_translations": {
                                "ru": "Тебе следует умыться, чтобы убрать <w>кисля́чки</w>.",
                                "zh": "你应该洗把脸，把<w>眼屎</w>洗掉。",
                                "es": "Deberías lavarte la cara para quitarte las <w>legañas</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "sleep"
                    ],
                    "common_phrases": [
                        "rub the sleepies out",
                        "wipe the sleepies"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in plural form 'sleepies'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Засохшие выделения в уголках глаз после сна.",
                        "zh": "睡眠后眼角积聚的干眼屎。",
                        "es": "Legañas: mucosidad seca que se acumula en las comisuras de los ojos durante el sueño."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кисля́чки",
                                "target_lang_sense_clarification": "разг. засохшие выделения глаз"
                            },
                            {
                                "target_lang_word": "ко́рочки",
                                "target_lang_sense_clarification": "нейтральное название"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "眼屎",
                                "target_lang_sense_clarification": "眼部产生的分泌物"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "legañas",
                                "target_lang_sense_clarification": "término coloquial más común para la secreción seca de los ojos al despertar"
                            },
                            {
                                "target_lang_word": "costras",
                                "target_lang_sense_clarification": "costras pequeñas en los ojos; menos específico"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e6bdcc63-48f9-36fb-8802-3b71e559b626",
                    "sense_definition": "A shingleback lizard.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "animal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We saw a <w>sleepy</w> basking on a rock in the Australian outback.",
                            "target_lang_translations": {
                                "ru": "Мы видели <w>короткохво́ста</w>, греющегося на камне в австралийской глуши.",
                                "zh": "我们在澳大利亚内陆看到一只<w>短尾蜥</w>正趴在岩石上晒太阳。",
                                "es": "Vimos un <w>escinco de cola corta</w> tomando el sol sobre una roca en el interior de Australia."
                            }
                        },
                        {
                            "text": "Be careful not to step on the <w>sleepy</w> hiding in the grass.",
                            "target_lang_translations": {
                                "ru": "Будь осторожен, не наступи на <w>короткохво́ста</w>, прячущегося в траве.",
                                "zh": "小心别踩到躲在草丛里的<w>短尾蜥</w>。",
                                "es": "Ten cuidado de no pisar al <w>escinco de cola corta</w> que se esconde en la hierba."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Australia"
                        },
                        {
                            "trait_type": "slang",
                            "comment": "common name for the lizard"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Короткохвостый сцинк (ящерица).",
                        "zh": "一种澳洲短尾蜥蜴。",
                        "es": "Un escinco de cola corta, una lagartija australiana conocida en inglés australiano como shingleback."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "короткохво́ст",
                                "target_lang_sense_clarification": "вид ящерицы"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "短尾蜥",
                                "target_lang_sense_clarification": "指代短尾石龙子"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "escinco de cola corta",
                                "target_lang_sense_clarification": "nombre común descriptivo del shingleback lizard"
                            },
                            {
                                "target_lang_word": "tilicua rugosa",
                                "target_lang_sense_clarification": "nombre zoológico de la especie"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}