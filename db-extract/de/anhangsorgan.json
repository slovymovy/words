                "senses": [
                    {
                        "sense_id": "080729a6-0859-3b7e-b33b-ebd7c90b4ae5",
                        "entry_id": "4a89e149-30e2-32d4-a86d-b77d64f40699",
                        "glosses": [
                            "einem Hauptorgan anhängende und eng zugeordnete weitere Organe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "34715449-d6aa-4c4a-b9db-b8ab6f97db9f",
                                "sense_id": "080729a6-0859-3b7e-b33b-ebd7c90b4ae5",
                                "text": "Der Tränenapparat, die Augenmuskeln, die Bindehaut, die Augenlider und die Sehbahn sind Anhangsorgane des Auges."
                            },
                            {
                                "example_id": "9d46db87-d718-4317-9f1c-d4ef8b098c01",
                                "sense_id": "080729a6-0859-3b7e-b33b-ebd7c90b4ae5",
                                "text": "Zähne, Finger- und Zehennägel sowie die Haare zählen zu den Anhangsorganen der Haut."
                            },
                            {
                                "example_id": "7aa149db-005c-4502-97f4-04f485df5c6d",
                                "sense_id": "080729a6-0859-3b7e-b33b-ebd7c90b4ae5",
                                "text": "Die Zähne sind ein Anhangsorgan der Wirbeltiere."
                            },
                            {
                                "example_id": "084e467b-f222-46b9-a376-4ea8d2781896",
                                "sense_id": "080729a6-0859-3b7e-b33b-ebd7c90b4ae5",
                                "text": "„Aus der Morula entsteht die Blastocyste, deren innere Zellen den Embryoblasten formen, der den Embryo und die extraembryonalen Anhangsorgane […] bildet.“"
                            },
                            {
                                "example_id": "4b193132-c052-4b58-8d4f-9c92d905397d",
                                "sense_id": "080729a6-0859-3b7e-b33b-ebd7c90b4ae5",
                                "text": "„An diesem ersten, als Kern erscheinenden Grundorgan bildet sich dann als Anhangsorgan das zweite, Blatt genannt. Es schiebt sich gleichsam aus dem Stengel hervor.“"
                            },
                            {
                                "example_id": "405e659b-fb8a-42c8-81fa-a14b282f1cfa",
                                "sense_id": "080729a6-0859-3b7e-b33b-ebd7c90b4ae5",
                                "text": "„Embryonale Anhangsorgane: Bei Tieren verschiedener Stämme werden während der Entwicklung embryonale Anhangsorgane gebildet, die der Ernährung, dem Gasaustausch, der Exkretion oder dem Schutz des Keimes dienen und sich beim Übergang zum freien Leben rückbilden.“"
                            },
                            {
                                "example_id": "94941a36-d764-43c7-bfbc-7e4877b97d35",
                                "sense_id": "080729a6-0859-3b7e-b33b-ebd7c90b4ae5",
                                "text": "„Die Metamorphosenlehre beruht auf dem Princip der Unterscheidung von Axen und Anhangsorganen (Stengel und Blatt) als Urformen, worauf alle Blumen- und Fruchtentwickelung reducirt wird […]. Bei den Pilzen, den Algen, den Flechten sucht man vergebens nach dem Gegensatz von Axen und Anhangsorganen […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
