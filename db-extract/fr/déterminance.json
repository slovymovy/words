                        "glosses": [
                            "Dans l’ancienne université, acte qui se composait de thèses soutenues sur plusieurs des ouvrages qui servaient de base à l’enseignement public."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b9bb28a-0141-4d5e-9f0e-01a1aa1358e6",
                                "sense_id": "ec5f319f-c644-37d0-b8ec-03eb6bf402cd",
                                "text": "La déterminance, c’est au contraire la détermination d’une question : une épreuve où l’étudiant soutient et défend un thèse en répondant aux questions des maîtres et en prouvant ainsi qu’il a quelques connaissances des autorités dont s’impose la citation."
                            }
                        ]
                    }
