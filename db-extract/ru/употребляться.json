                "senses": [
                    {
                        "sense_id": "29f18c04-09f4-369c-8fe9-cb1f685d2efa",
                        "entry_id": "a87d4d9e-311a-3f6c-9ec8-d435e91d9d2d",
                        "glosses": [
                            "страд. к употреблять"
                        ],
