        "nl-extract.jsonl": [
            {
                "entry_id": "b946dfba-3b5b-3d74-a0eb-a02bfe685c75",
                "word": "doemdenker",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "b8e1f119-d3b4-49be-9523-79f3b1bac527",
                        "entry_id": "b946dfba-3b5b-3d74-a0eb-a02bfe685c75",
                        "tags": [
                            "plural"
                        ],
                        "form": "doemdenkers"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4cc366a5-12fc-3e31-8e10-fad81135c096",
                        "entry_id": "b946dfba-3b5b-3d74-a0eb-a02bfe685c75",
                        "glosses": [
                            "iemand die voorspelt dat er rampen zullen gebeuren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "88e19c13-0441-4733-abc7-3c51fafb54fa",
                                "sense_id": "4cc366a5-12fc-3e31-8e10-fad81135c096",
                                "text": "Iedere jaarwisseling levert de nodige liters spraakwater aan zowel doem- als wensdenkers."
                            },
                            {
                                "example_id": "9c1a7c47-a3fa-4665-a64a-4c30174e199a",
                                "sense_id": "4cc366a5-12fc-3e31-8e10-fad81135c096",
                                "text": "Door diepzeemijnbouw loopt de wereld echter wel risico soorten kwijt te raken, waarschuwt Van Oevelen. „Er leven soorten in de diepzee die we nog nooit hebben gezien. Ik wil geen doemdenker zijn, maar gebieden die je leeghaalt, zijn voor langere tijd of zelfs definitief verstoord.”"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dfd0c366-56cb-4b8a-a31a-a43b3f999510",
                        "source_entry_id": "b946dfba-3b5b-3d74-a0eb-a02bfe685c75",
                        "source_sense_id": "4cc366a5-12fc-3e31-8e10-fad81135c096",
                        "target_lang_word": "pessimist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pessimist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "efbafcc5-0f9e-3356-b096-cf657be45949",
                                        "entry_id": "aa073281-4a76-3c5e-b068-8b15aa3a24d3",
                                        "glosses": [
                                            "Someone who habitually expects the worst outcome; one who looks on the dark side of things."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b15ad7f7-1dd6-462d-a699-cccfbf1b230e",
                                                "sense_id": "efbafcc5-0f9e-3356-b096-cf657be45949",
                                                "text": "I will not marry a pessimist, a born loser, a fellow who has no fight in him."
                                            },
                                            {
                                                "example_id": "6731ccf5-a131-4a56-a759-2d2deae0c888",
                                                "sense_id": "efbafcc5-0f9e-3356-b096-cf657be45949",
                                                "text": "We are becoming as a nation, as a world, indeed, atom-conscious. Many of us are already afflicted with atomphobia, though so far it has manifested itself only in a mirage of autoaeromotive discs and a war of words between chronic optimists and empirical pessimists concerning civilization’s probable future."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
