                                            {
                                                "example_id": "72ebb1ac-a20d-4eb2-9a1a-0b918a1dd4ed",
                                                "sense_id": "4e0734d6-d6e6-3e8c-99bf-a4eda4a89d0e",
                                                "text": "the acidity of lemon juice"
                                            },
                                            {
                                                "example_id": "fec03d9e-6c14-49e1-9ebb-f54379b2a533",
                                                "sense_id": "4e0734d6-d6e6-3e8c-99bf-a4eda4a89d0e",
                                                "text": "Empty stomachs lead to acidity and leave a sour taste in the mouth."
                                            }
