                ],
                "senses": [
                    {
                        "sense_id": "20472d9f-6eb5-3893-8d35-aae1aff2e050",
                        "entry_id": "6add81f9-aab6-3045-ba1b-b376ef587b38",
                        "glosses": [
                            "Person, die regelmäßig zum Gottesdienst in der Kirche geht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c25eba84-7517-4332-b7d5-12385547cb59",
                                "sense_id": "20472d9f-6eb5-3893-8d35-aae1aff2e050",
                                "text": "Am Sonntag strömen viele Kirchgänger in die Kirche."
                            },
                            {
                                "example_id": "a8177420-04da-47a8-8d5c-73f2514e954d",
                                "sense_id": "20472d9f-6eb5-3893-8d35-aae1aff2e050",
                                "text": "„Eines Sonntags machten die Kirchgänger in Krusenhagen aber große Augen; denn Hermine Beckmann kam daher, das Gesangbuch in den Händen und darauf das Taschentuch und den Rükebusch.“"
                            },
                            {
                                "example_id": "d371c446-ef47-4ef3-844d-550d933f3d13",
                                "sense_id": "20472d9f-6eb5-3893-8d35-aae1aff2e050",
                                "text": "„Als Martin zu seinen Kameraden zurückkehrte, spotteten die über den frommen Kirchgänger.“"
                            },
                            {
                                "example_id": "fca2cf35-d850-4c46-b744-48ef94c950e1",
                                "sense_id": "20472d9f-6eb5-3893-8d35-aae1aff2e050",
                                "text": "„Auch zu den sonntäglichen Kirchgängern hat er nie gezählt.“"
                            },
                            {
                                "example_id": "66162d23-4371-4cd8-99d9-cf59106c7361",
                                "sense_id": "20472d9f-6eb5-3893-8d35-aae1aff2e050",
                                "text": "„Die Kirchgänger wurden von einer Mauer verschluckt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "27a5b75e-207f-4d58-a39b-19e99a49e0b0",
                        "source_entry_id": "6add81f9-aab6-3045-ba1b-b376ef587b38",
                        "source_sense_id": "20472d9f-6eb5-3893-8d35-aae1aff2e050",
                        "source_sense_description": "Person, die regelmäßig zum Gottesdienst in der Kirche geht",
                        "target_lang_word": "churchgoer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "churchgoer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9285e084-795b-38a9-acad-dcc6e36163af",
                                        "entry_id": "2fb9e580-bf3f-3068-b4f6-5a6fe8614081",
                                        "glosses": [
                                            "One who regularly goes to church; a practicing Christian."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b062fc4-9a43-4cc0-93f3-c28967d57a03",
                                                "sense_id": "9285e084-795b-38a9-acad-dcc6e36163af",
                                                "text": "Well, one Christmas Eve, just like to-night, she thought she would go to the morning service on the Christmas Day, for she was a great church-goer, and so she left out some coffee with the girl before she went to bed, that she might get a cup next morning she was sure a cup of warm coffee would do her a great deal of good at that early hour!"
                                            },
                                            {
                                                "example_id": "d9ded6da-c997-4a62-8a1d-b3268969f671",
                                                "sense_id": "9285e084-795b-38a9-acad-dcc6e36163af",
                                                "text": "A forced churchgoer has no religion, a terrified churchgoer has no Christianity, a bribed churchgoer has no morals."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3d86b5fa-5a9f-4a44-9cb8-cb0b6c6c952c",
                        "source_entry_id": "6add81f9-aab6-3045-ba1b-b376ef587b38",
                        "source_sense_id": "20472d9f-6eb5-3893-8d35-aae1aff2e050",
                        "source_sense_description": "Person, die regelmäßig zum Gottesdienst in der Kirche geht",
                        "target_lang_word": "pratiquant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pratiquant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "109cdf14-97d4-3e9b-abc7-be73f2f09f72",
                                        "entry_id": "fd1263d8-ca29-3265-b385-f4d1f954d8ec",
                                        "glosses": [
                                            "Qui observe les pratiques de sa religion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3823b41f-9f8f-4a76-9fe6-e72f5b41fdac",
                                                "sense_id": "109cdf14-97d4-3e9b-abc7-be73f2f09f72",
                                                "text": "Mais super, super catholique pratiquante : les scouts, les rallyes, les premières communions, les jupes bleu marine, les cols Claudine, les talons plats, les madeleines confectionnées pour les vendre à la kermesse de monsieur le curé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ec7096ac-7282-3977-a71c-eea940d3c535",
                                        "entry_id": "fd1263d8-ca29-3265-b385-f4d1f954d8ec",
                                        "glosses": [
                                            "Spécialement, dans le cas du catholicisme, qui va à la messe toutes les semaines."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ebfb825-9f6a-4c6e-b24a-f0f4de2d09c8",
                                                "sense_id": "ec7096ac-7282-3977-a71c-eea940d3c535",
                                                "text": "Si, je suis pratiquant. Si, je vais à la messe, à peu près chaque dimanche."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pratiquant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c0664cb3-dcf8-36cf-b4aa-6fb31d291085",
                                        "entry_id": "358440e8-95c6-313a-a691-14f10e561a5d",
                                        "glosses": [
                                            "Personne qui pratique avec constance une activité particulière."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "630c0589-4216-4a31-8f77-f999ec0b87de",
                                                "sense_id": "c0664cb3-dcf8-36cf-b4aa-6fb31d291085",
                                                "text": "On voit que la moralité des armateurs et des gros négociants n'était pas toujours irréprochable et que l'amour ancillaire avait, à Saint-Malo, de chauds pratiquants."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "02b727df-75bf-3eac-bc88-b6910c9163e5",
                                        "entry_id": "358440e8-95c6-313a-a691-14f10e561a5d",
                                        "glosses": [
                                            "Personne qui observe les rites de sa religion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9191da28-e621-4d20-8a28-b86c7ceedb33",
                                                "sense_id": "02b727df-75bf-3eac-bc88-b6910c9163e5",
                                                "text": "Beaucoup de Nazaréens me considéraient comme un mauvais pratiquant : j'allumais mon feu le jour du Sabbat, je soignais un petit frère ou une petite sœur malade même le jour du Sabbat."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pratiquant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d38c89f0-c937-3525-9055-86c34d113815",
                                        "entry_id": "bc135f3e-1032-3d00-9214-0d331675a5c6",
                                        "glosses": [
                                            "Participe présent de pratiquer."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f05e54f1-96ec-4a19-a8f9-4b8e0d975dca",
                                                "sense_id": "d38c89f0-c937-3525-9055-86c34d113815",
                                                "text": "En 68, nous expérimentâmes la marche sudique entre le Congo et le Jean-Bart, utilisant de mini-échasses comme telles, ou comme des bâtons de skis de randonnée, pour rapidifier notre rythme : nous essuyâmes au passage gros rires et quolibets… et croisant aujourd’hui au Parc bordelais ces flopées de gens respectables pratiquant dévotement leur sacro-sainte marche nordique, je ne peux réprimer un léger ricanement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
