        "de-extract.jsonl": [
            {
                "entry_id": "96893f4a-019c-336c-81e5-f9e9177ae8a6",
                "word": "destiny",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "d0657b3e-542c-3150-bf14-b2ce420687b0",
                        "entry_id": "96893f4a-019c-336c-81e5-f9e9177ae8a6",
                        "glosses": [
                            "Schicksal"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "28cc6bd8-4141-3fe8-abe0-00f0c0a9ac56",
                        "entry_id": "96893f4a-019c-336c-81e5-f9e9177ae8a6",
                        "glosses": [
                            "Vorsehung"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a30cba30-69fe-414f-b3e6-d579f6062f8b",
                        "source_entry_id": "96893f4a-019c-336c-81e5-f9e9177ae8a6",
                        "source_sense_id": "d0657b3e-542c-3150-bf14-b2ce420687b0",
                        "source_sense_description": "Schicksal",
                        "target_lang_word": "Schicksal",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schicksal",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b4f53d54-2715-38c3-8feb-ff0cf8c66e4e",
                                        "entry_id": "282b22c1-1720-387d-aa09-d709b2562fb6",
                                        "glosses": [
                                            "höhere Macht, welche die Zukunft der/eines Menschen beliebig beeinflusst und lenkt"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f0f7f7bf-fb5f-4771-8ae6-8a3a7938cc61",
                                                "sense_id": "b4f53d54-2715-38c3-8feb-ff0cf8c66e4e",
                                                "text": "„Das Schicksal ist launisch und grausam.“"
                                            },
                                            {
                                                "example_id": "f0d0c69d-a704-411b-b68c-491fcbcfe768",
                                                "sense_id": "b4f53d54-2715-38c3-8feb-ff0cf8c66e4e",
                                                "text": "„Das Schicksal mischt die Karten und wir spielen.“"
                                            },
                                            {
                                                "example_id": "cf03affd-6ab4-45e0-b1c1-1a367f69ada0",
                                                "sense_id": "b4f53d54-2715-38c3-8feb-ff0cf8c66e4e",
                                                "text": "„Doch das Schicksal machte schon bald meiner bitteren Probezeit ein Ende.“"
                                            },
                                            {
                                                "example_id": "7741d312-2c75-4baa-8f13-91ad243796a4",
                                                "sense_id": "b4f53d54-2715-38c3-8feb-ff0cf8c66e4e",
                                                "text": "„Das Schicksal ist so alt wie die Welt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "925783cb-3ff4-3b2e-bdad-c7e3baac27df",
                                        "entry_id": "282b22c1-1720-387d-aa09-d709b2562fb6",
                                        "glosses": [
                                            "vermeintliche, sich auf eine oder mehrere Personen beziehende Folge des Schicksals ^([1])"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "967d7cc5-abb3-4a96-8000-cf18af8a5ca1",
                                                "sense_id": "925783cb-3ff4-3b2e-bdad-c7e3baac27df",
                                                "text": "Die traurigen Schicksale dieser armen Menschen berührten sie sehr."
                                            },
                                            {
                                                "example_id": "11661312-e94d-4dc0-b049-ab159153cf58",
                                                "sense_id": "925783cb-3ff4-3b2e-bdad-c7e3baac27df",
                                                "text": "„In Rückblenden erfahren wir vom Schicksal des Helden, der es zu Hause, beim spießbürgerlichen Vater vor allem, nicht mehr aushielt und hinauszog in die Welt.“"
                                            },
                                            {
                                                "example_id": "962a8363-f909-4cbf-9d9b-f04ebb5143af",
                                                "sense_id": "925783cb-3ff4-3b2e-bdad-c7e3baac27df",
                                                "text": "„Hat er genug zu leben und hat das Schicksal ihn nicht mit Krankheit geschlagen, ist er zufrieden und dankbar, und leidet er Not und Entbehrung, trägt er auch diese Schickung mit Würde.“"
                                            },
                                            {
                                                "example_id": "22ca2872-0389-41ad-9c6a-6d72993eee61",
                                                "sense_id": "925783cb-3ff4-3b2e-bdad-c7e3baac27df",
                                                "text": "„Das Schicksal Deutschlands war dem Grunde nach seit der Teheran-Konferenz von 1943 entschieden.“"
                                            },
                                            {
                                                "example_id": "f2dbe0a9-1d2c-480e-9111-18fd338463e3",
                                                "sense_id": "925783cb-3ff4-3b2e-bdad-c7e3baac27df",
                                                "text": "„Ihr Schicksal hatte sich entschieden, und es hatte sich glücklich entschieden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8be008e3-5988-45fb-b3e8-07de7d7115ae",
                        "source_entry_id": "96893f4a-019c-336c-81e5-f9e9177ae8a6",
                        "source_sense_id": "28cc6bd8-4141-3fe8-abe0-00f0c0a9ac56",
                        "source_sense_description": "Vorsehung",
                        "target_lang_word": "Vorsehung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vorsehung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "66c3b03a-12f1-3dcf-b317-5a139425bd2c",
                                        "entry_id": "15b24d24-fb2b-357b-8ed8-c505eb175425",
                                        "glosses": [
                                            "höhere Macht, die die einzelnen Ereignisse, die einem Menschen widerfahren, anordnet (meist letztlich zum Guten hin)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f752210-4e54-433d-92a0-56699ceea5ed",
                                                "sense_id": "66c3b03a-12f1-3dcf-b317-5a139425bd2c",
                                                "text": "„Alles aber, was er geschaffen hat, schützt und lenkt Gott durch seine Vorsehung, ‚sich kraftvoll von einem Ende zu anderen erstreckend und alles milde ordnend‘ (Weish 8,1). ‚Alles nämlich ist nackt und bloß vor seinen Augen‘ (Hebr 4,13), auch das, was durch die freie Tat der Geschöpfe geschehen wird.“"
                                            },
                                            {
                                                "example_id": "8dd5cf04-e835-4de4-a0cd-d53377360255",
                                                "sense_id": "66c3b03a-12f1-3dcf-b317-5a139425bd2c",
                                                "text": "„Durch das Blut jener Frommen und ihren Sühnetod rettete die göttliche Vorsehung das vorher schlimm bedrängte Israel.“"
                                            },
                                            {
                                                "example_id": "76e06a58-4f4c-4404-9cec-a67657b9225d",
                                                "sense_id": "66c3b03a-12f1-3dcf-b317-5a139425bd2c",
                                                "text": "„Ich dankte der Vorsehung, daß sie mir die Verlegenheit ersparte, das junge unverschämte Geschöpf zu sehen.“"
                                            },
                                            {
                                                "example_id": "057dc323-6d7e-43bd-a73d-08b0ffc97ea2",
                                                "sense_id": "66c3b03a-12f1-3dcf-b317-5a139425bd2c",
                                                "text": "„Beinahe scheint es, als ob die Vorsehung ihn zugleich auch dazu bestimmt hätte, den Samen der Freiheit gleich Zugvögeln über die ganze Erde zu verbreiten und so die Habsucht zu veredeln, die seinem waghalsigen Spiele zum Grunde liegt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
