                    {
                        "sense_id": "5614c3f0-c3c5-3528-aa03-7d24e2bae37f",
                        "entry_id": "9fac7a34-1acf-3aa3-8245-603ee0acd19e",
                        "glosses": [
                            "Anordnung (Weisung), die eine zuvor gegebene Anordnung außer Kraft setzt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "27397e19-4aba-41ab-804e-0771d66f082a",
                                "sense_id": "5614c3f0-c3c5-3528-aa03-7d24e2bae37f",
                                "text": "„Beide telegrafierten noch am gleichen Tag an ihre Zentralen, daß sie ihre Akten und Geheim-Codes vernichten würden, falls keine Gegenweisung erfolge.“"
                            },
                            {
                                "example_id": "c4d4389a-3aac-43e5-9cb9-c03bde2e5741",
                                "sense_id": "5614c3f0-c3c5-3528-aa03-7d24e2bae37f",
                                "text": "„Eine Weisung kann jedoch nur durch eine Gegenweisung widerrufen werden, wenn sie noch nicht weisungskonform ausgeführt wurde und der Weisungsempfänger noch nicht irreversibel disponiert hat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
