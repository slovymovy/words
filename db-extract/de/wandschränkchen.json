                        "examples": [
                            {
                                "example_id": "6cbf24f4-cd96-44c7-abea-67c6a87bdf6e",
                                "sense_id": "32bed75b-bf8d-349b-9bf8-f4087bf1d661",
                                "text": "„Im Bad stopfte sich Cao eine seiner Pistolen in den Jackenärmel, öffnete mit der freien Hand ein Wandschränkchen, holte eine Plastiktüte voller alter Handtücher heraus und tastete dann an der Schrankrückwand umher.“"
                            },
                            {
                                "example_id": "4c58e92f-142f-422d-ac62-3758bc776a40",
                                "sense_id": "32bed75b-bf8d-349b-9bf8-f4087bf1d661",
                                "text": "„Er schwenkte herum, erhob sich vom Stuhl und schloss ein Wandschränkchen hinter dem Schreibtisch auf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
