                "senses": [
                    {
                        "sense_id": "13f14cf1-5645-30ef-b695-80dae8adee60",
                        "entry_id": "0d219dfb-73e0-3b0f-8c95-f08182f53555",
                        "glosses": [
                            "auf dem Gebiet der Wirtschaftswissenschaften tätige Wissenschaftlerin"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ea64fae-0d89-463b-a264-b7798844984b",
                                "sense_id": "13f14cf1-5645-30ef-b695-80dae8adee60",
                                "text": "„Sie heißt Mariana Mazzucato und ist eine italienisch-amerikanische Wirtschaftswissenschaftlerin, die am University College in London lehrt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d39badd3-501e-40c1-a091-79b022c9b507",
                        "source_entry_id": "0d219dfb-73e0-3b0f-8c95-f08182f53555",
                        "source_sense_id": "13f14cf1-5645-30ef-b695-80dae8adee60",
                        "source_sense_description": "auf dem Gebiet der Wirtschaftswissenschaften tätige Wissenschaftlerin",
                        "target_lang_word": "economist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "economist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d4100054-759f-384d-a547-15381cf10617",
                                        "entry_id": "dc06b91a-33bd-32cf-8369-0937717942eb",
                                        "glosses": [
                                            "An expert in economics, especially one who studies economic data and extracts higher-level information or proposes theories."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e8037b17-ce0d-4850-a3da-baa914acc620",
                                                "sense_id": "d4100054-759f-384d-a547-15381cf10617",
                                                "text": "Economics is a messy discipline: too fluid to be a science, too rigorous to be an art. Perhaps it is fitting that economists’ most-used metric, gross domestic product (GDP), is a tangle too. GDP measures the total value of output in an economic territory. Its apparent simplicity explains why it is scrutinised down to tenths of a percentage point every month."
                                            },
                                            {
                                                "example_id": "fc6c1506-9a3b-4d1e-8388-581fae9e9c68",
                                                "sense_id": "d4100054-759f-384d-a547-15381cf10617",
                                                "text": "The formula, which AEI economists said had “no foundation in either economic theory or trade law,” instead wrongly incorporated the elasticity for retail prices. […] However, certainty is anything but a sure thing these days, and the bread-and-butter of the US economy might not go unscathed, said RSM economist Brusuelas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c49bdf2-e089-39d1-9552-991db9825215",
                                        "entry_id": "dc06b91a-33bd-32cf-8369-0937717942eb",
                                        "glosses": [
                                            "One concerned with political economy."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3cbd4f2b-ec54-3d05-a617-351fa3361405",
                                        "entry_id": "dc06b91a-33bd-32cf-8369-0937717942eb",
                                        "glosses": [
                                            "One who manages a household."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "57aee30f-3674-3625-ab67-323e7d93c72b",
                                        "entry_id": "dc06b91a-33bd-32cf-8369-0937717942eb",
                                        "glosses": [
                                            "One who economizes, or manages domestic or other concerns with frugality; one who expends money, time, or labor, judiciously, and without waste."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ceccf937-eec7-4181-a32f-51b696f4d3b4",
                        "source_entry_id": "0d219dfb-73e0-3b0f-8c95-f08182f53555",
                        "source_sense_id": "13f14cf1-5645-30ef-b695-80dae8adee60",
                        "source_sense_description": "auf dem Gebiet der Wirtschaftswissenschaften tätige Wissenschaftlerin",
                        "target_lang_word": "économiste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "économiste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d248716f-2432-33fc-bb14-fe692c10b348",
                                        "entry_id": "2d1d3640-8716-3ad9-838a-89f1b2124be1",
                                        "glosses": [
                                            "Personne qui s’occupe spécialement d’économie politique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c0c1dbc7-8eae-4753-935c-081a91779073",
                                                "sense_id": "d248716f-2432-33fc-bb14-fe692c10b348",
                                                "text": "L’avocat de M. Turgot s’élevait contre la prétention de soumettre au moindre règlement la liberté du commerce et de l’industrie; il répétait avec emphase l’axiome des économistes : « laissez faire, laissez passer ». Le peuple souffre, disait-il ; on le reconnaît, et l’on ne veut pas en voir là cause : ce sont les maîtrises et les corporations, ce sont les droits d’entrée, et les douanes, et toutes vos lois prohibitives, qui doublent et triplent le prix des choses les plus nécessaires à la vie."
                                            },
                                            {
                                                "example_id": "d7a52111-8f4d-497b-833d-e0cbf26a1ddf",
                                                "sense_id": "d248716f-2432-33fc-bb14-fe692c10b348",
                                                "text": "Gobenheim laissa échapper cette phrase qui, de nos jours, est la Sainte-Ampoule du génie au sens des économistes et des banquiers : ─ Il gagne un argent fou !"
                                            },
                                            {
                                                "example_id": "f52570a5-2281-40ca-99c9-794c3e0ba6ae",
                                                "sense_id": "d248716f-2432-33fc-bb14-fe692c10b348",
                                                "text": "Entre un mauvais et un bon Économiste, voici toute la différence : l’un s’en tient à l’effet visible ; l’autre tient compte et de l’effet qu’on voit et de ceux qu’il faut prévoir.\nMais cette différence est énorme, car il arrive presque toujours que, lorsque la conséquence immédiate est favorable, les conséquences ultérieures sont funestes, et vice versa. — D’où il suit que le mauvais Économiste poursuit un petit bien actuel qui sera suivi d’un grand mal à venir, tandis que le vrai Économiste poursuit un grand bien à venir, au risque d’une petit mal actuel."
                                            },
                                            {
                                                "example_id": "4cf8374a-f7fa-4774-863e-5611877aff87",
                                                "sense_id": "d248716f-2432-33fc-bb14-fe692c10b348",
                                                "text": "Il est vrai qu'il serait absurde de vouloir prédire à l'avance les faits et gestes de Pierre ou de Paul : mais cela n'a aucun intérêt pour l’économiste. Il n'est pas un diseur de bonne aventure."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0ee65a62-d129-3b26-811a-8895463cfcd0",
                                        "entry_id": "2d1d3640-8716-3ad9-838a-89f1b2124be1",
                                        "glosses": [
                                            "Physiocrate."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "90f2f305-3f51-4938-97fe-8b1196a7062a",
                                                "sense_id": "0ee65a62-d129-3b26-811a-8895463cfcd0",
                                                "text": "Vers le milieu du dix-huitième siècle, quelques principes sur la source des richesses, mis en avant par le médecin Quesnay, firent un grand nombre de prosélytes. L'enthousiasme de ceux-ci pour leur fondateur, le scrupule avec lequel ils ont toujours depuis suivi les mêmes dogmes, leur chaleur à les défendre, l'emphase de leurs écrits, les ont fait considérer comme une secte, et ils ont été appelés du nom d’économistes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "824d4a86-f3fc-3281-a39f-5eea60f924ef",
                                        "entry_id": "2d1d3640-8716-3ad9-838a-89f1b2124be1",
                                        "glosses": [
                                            "Partisan de l’économisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7515e378-a5e6-4e99-a433-ed6713acae97",
                                                "sense_id": "824d4a86-f3fc-3281-a39f-5eea60f924ef",
                                                "text": "[Le] banquier Vincent, un économiste qui arrive de Russie, plus ou moins disgracié par les Soviets."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
