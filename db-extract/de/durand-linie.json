                "senses": [
                    {
                        "sense_id": "40403393-484b-3953-9faf-e2dd32f35f75",
                        "entry_id": "d4b58d1d-386d-3aa1-90bd-95c6dbcf64a8",
                        "glosses": [
                            "als Folge der Anglo-Afghanischen Kriege gezogene Grenze zwischen Afghanistan und dem damaligen Britisch-Indien, welche heute die Staaten Afghanistan und Pakistan trennt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "00a99e33-8aa6-4c80-a81d-cb15194dd76e",
                                "sense_id": "40403393-484b-3953-9faf-e2dd32f35f75",
                                "text": "„Die Briten hatten vor mehr als 100 Jahren einen Strich über eine Landkarte gezogen und ihn nach irgendeinem aufdringlichen englischen Außenminister Durand-Linie getauft.“"
                            },
                            {
                                "example_id": "9a1ef900-9a02-4bc9-b82f-48ead34dcb01",
                                "sense_id": "40403393-484b-3953-9faf-e2dd32f35f75",
                                "text": "„Die Spaltung zwischen Britisch-Indien und Afghanistan wurde von den Briten in einer offiziellen Grenzlinie - der Durand-Linie - 1893 formell legitimiert.“"
                            },
                            {
                                "example_id": "cc5c5c2b-2d0c-45f5-b163-b1eeff793f0e",
                                "sense_id": "40403393-484b-3953-9faf-e2dd32f35f75",
                                "text": "„Die beiden Länder haben, vor allem im paschtunisch geprägten Grenzgebiet, enge kulturelle Verbindungen, liegen miteinander aber wegen der 1893 von den Briten gezogenen 2640 Kilometer langen Grenze, der sogenannten Durand-Linie, im Streit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
