                        "examples": [
                            {
                                "example_id": "c69d2366-f982-4af2-b893-2cad215d0e30",
                                "sense_id": "9032243d-6cc3-3706-80aa-d8bb43f995e4",
                                "text": "„Nach einer Broschüre der Association of Plastics Manufacturers in Europe (APME) lag der industrielle Kunststoffverbrauch in Westeuropa 1999 bei 33,575 Mio. t. Packaging machte darin 13,464 Mio. t aus (40 %).“"
                            },
                            {
                                "example_id": "8e6e921c-bf08-416e-b9d7-465a1488d0a1",
                                "sense_id": "9032243d-6cc3-3706-80aa-d8bb43f995e4",
                                "text": "„Die Wiederaufbereitung von Medizintechnikprodukten reduziert den Kunststoffverbrauch um 40 %.“"
                            },
                            {
                                "example_id": "4afc5e30-5e0a-4389-8e38-7bafb3af8499",
                                "sense_id": "9032243d-6cc3-3706-80aa-d8bb43f995e4",
                                "text": "„Der Kunststoffverbrauch für den Fahrzeugbau wächst.“"
                            },
                            {
                                "example_id": "d27dc51c-7fe4-4c59-8645-979eba43551a",
                                "sense_id": "9032243d-6cc3-3706-80aa-d8bb43f995e4",
                                "text": "„Der Kunststoffverbrauch der Spritzgießbranche ist von 2002 bis 2008 um durchschnittlich 1,5 Prozent jährlich gewachsen.“"
                            },
                            {
                                "example_id": "c753d234-d1b5-4e2c-9633-842588faa413",
                                "sense_id": "9032243d-6cc3-3706-80aa-d8bb43f995e4",
                                "text": "Die Kunststoffverbräuche werden in der APME-Studie nach Produktgruppen sowie nach Länder-Anteilen ausgewiesen."
                            }
                        ],
                        "sense_index_json": "\"1\""
