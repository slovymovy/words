                                "zh": "近<w>血亲</w>不得结婚。"
                            }
                        },
                        {
                            "text": "Badania genetyczne potwierdziły, że to mój <w>krewny</w>.",
                            "target_lang_translations": {
                                "en": "Genetic tests confirmed that he is my <w>relative</w>.",
                                "ru": "Генетические исследования подтвердили, что это мой <w>родственник</w>.",
                                "nl": "Genetisch onderzoek heeft bevestigd dat hij een <w>bloedverwant</w> van mij is.",
                                "de": "Gentests haben bestätigt, dass er mein <w>Verwandter</w> ist.",
                                "fr": "Les tests génétiques ont confirmé qu'il s'agissait de mon <w>parent</w>.",
                                "it": "I test genetici hanno confermato che è un mio <w>consanguineo</w>.",
                                "cs": "Genetické testy potvrdily, že je to můj <w>příbuzný</w>.",
                                "tr": "Genetik testler onun benim <w>akrabam</w> olduğunu doğruladı.",
                                "es": "Las pruebas genéticas confirmaron que es mi <w>pariente</w>.",
                                "zh": "基因检测证实了他是我的<w>血亲</w>。"
