                    "frequency": "Middle",
                    "semantic_group_id": "panne",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le moteur de ma vieille voiture m'a <w>lâché</w> sur l'autoroute hier matin."
                        },
                        {
                            "text": "Mes jambes ont fini par me <w>lâcher</w> après des heures de marche en montagne."
