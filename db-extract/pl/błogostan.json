                "translations": [
                    {
                        "translation_id": "19d73b5e-bef3-4d94-9bf6-c27866cb89d1",
                        "source_entry_id": "ca167f3d-57cf-385c-a507-aab916f3c2ff",
                        "source_sense_id": "826963b7-a7f6-3d58-bd40-643d2ec0edfe",
                        "target_lang_word": "blessedness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "blessedness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2142a66d-165e-31ee-be55-6106a4c656e3",
                                        "entry_id": "46cbdf9b-2b2d-3d04-9ace-c145dd273e81",
                                        "glosses": [
                                            "The condition or state of being blessed; holy."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "581ff2cb-067c-4376-8228-3f4b84da3267",
                                                "sense_id": "2142a66d-165e-31ee-be55-6106a4c656e3",
                                                "text": "But earthlyer happy is the roſe diſtild, / Then that, vvhich, vvithering on the virgin thorne, / Grovves, liues, and dies, in ſingle bleſſedneſſe."
                                            },
                                            {
                                                "example_id": "0b52f8a3-619b-44af-b105-df6af2055793",
                                                "sense_id": "2142a66d-165e-31ee-be55-6106a4c656e3",
                                                "text": "It matters little to tell you of my blessedness; but my very heart was filled with the light of those radiant eyes, which were to me what the sun is to the world."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "87cf4bc7-7592-41c5-aad3-12886cea13ad",
                        "source_entry_id": "ca167f3d-57cf-385c-a507-aab916f3c2ff",
                        "source_sense_id": "826963b7-a7f6-3d58-bd40-643d2ec0edfe",
                        "target_lang_word": "félicité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "félicité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5ea4ad09-7c9d-3564-9732-e44e9c9111d7",
                                        "entry_id": "2f678dae-0964-3ba2-9b8e-543e484084f5",
                                        "glosses": [
                                            "Béatitude ; grand bonheur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cafb2c10-dfef-4acc-bca9-203053f54bfe",
                                                "sense_id": "5ea4ad09-7c9d-3564-9732-e44e9c9111d7",
                                                "text": "Quelle fut ma félicité, lorsque je me trouvai encore une fois dans la solitude avec Atala, avec Atala ma libératrice, avec Atala qui se donnait à moi pour toujours !"
                                            },
                                            {
                                                "example_id": "a9dd4594-e6a0-4aaa-8f73-e39a1d3fd711",
                                                "sense_id": "5ea4ad09-7c9d-3564-9732-e44e9c9111d7",
                                                "text": "Charles trouva dans son premier compagnon de route un de ces cœurs si rares où il put verser tous ses chagrins en racontant ses félicités."
                                            },
                                            {
                                                "example_id": "1dab2343-2cb3-476d-bcf9-9108ee0e30a6",
                                                "sense_id": "5ea4ad09-7c9d-3564-9732-e44e9c9111d7",
                                                "text": "Et lui aussi, Jacques s’abandonnait à la félicité de l’heure…"
                                            },
                                            {
                                                "example_id": "048d34f5-dd34-4c4f-ae1c-ff0797b09078",
                                                "sense_id": "5ea4ad09-7c9d-3564-9732-e44e9c9111d7",
                                                "text": "Il s'est consacré à la divinité et celle-ci généreuse ne tardera pas à lui faire connaître les suprêmes joies des grandes félicités nirvanesques."
                                            },
                                            {
                                                "example_id": "f6ae750e-91f2-4d71-ba4a-90f0959b0d37",
                                                "sense_id": "5ea4ad09-7c9d-3564-9732-e44e9c9111d7",
                                                "text": "Le curé de Melotte […] n’était plus craint. Ses foudres de carton, ses tonnerres lointains, l’évocation des bûchers infernaux, la promesse des félicités paradisiaques dans un éden, somme toute, passablement morne et fort problématique, ne faisaient plus guère frémir que quelques vieilles dévotes et les gosses de neuf à onze ans […]"
                                            },
                                            {
                                                "example_id": "1a882b03-b07a-44e1-881d-c7338c156896",
                                                "sense_id": "5ea4ad09-7c9d-3564-9732-e44e9c9111d7",
                                                "text": "Sa langue, d’une mobilité étonnante, courait amoureusement sur ses lèvres comme si elle se promettait de goûter à toutes les félicités d’ici-bas."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "félicité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c4d2b394-313d-3514-9eb1-c813d6476f93",
                                        "entry_id": "5259af70-1bd5-3c38-bfae-a9c3f99df2b7",
                                        "glosses": [
                                            "Participe passé masculin singulier de féliciter."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6c369d58-aa40-4f1f-9142-5499d6d703fc",
                                                "sense_id": "c4d2b394-313d-3514-9eb1-c813d6476f93",
                                                "text": "Cette Joséphine, barmaid dans un bal-musette fréquenté par Riton et sa tierce, s’était presque félicité de la mise à l’ombre de Jojo-la-Musique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
