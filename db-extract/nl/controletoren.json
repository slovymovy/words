                        "glosses": [
                            "torenvormig gebouw van waaruit het (vlieg)verkeer wordt gecontroleerd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "abf39ed4-e65f-4be3-ab77-46c036886e6a",
                                "sense_id": "610fb337-26b3-31ab-914b-e7cea0db4256",
                                "text": "In de haven van de Italiaanse stad Genua zijn gisteravond zeker drie mensen omgekomen toen een schip de controletoren ramde. De toren stortte grotendeels in en er worden nog steeds zeven man vermist."
                            },
                            {
                                "example_id": "1a2645d9-cff6-42c1-9cb5-e9da8efd62fd",
                                "sense_id": "610fb337-26b3-31ab-914b-e7cea0db4256",
                                "text": "De F-16-piloot die gisteren per ongeluk een controletoren op Vlieland onder vuur nam, is zich een ongeluk geschrokken. In de toren op oefenterrein Vliehors zaten twee militairen. Zij bleven ongedeerd."
                            }
                        ]
                    }
