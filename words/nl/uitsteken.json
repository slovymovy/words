{
    "word_family": [
        "uitstekend",
        "uitsteeksel",
        "uitsteker"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4683bf2f-4b6b-39b7-a366-9d42cd794f7e",
                    "sense_definition": "Een lichaamsdeel naar buiten of in een bepaalde richting bewegen.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "beweging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Als je op de fiets links afslaat, moet je altijd je hand <w>uitsteken</w>.",
                            "target_lang_translations": {
                                "en": "When you turn left on a bicycle, you must always <w>stick out</w> your hand."
                            }
                        },
                        {
                            "text": "De hond wilde graag spelen en bleef enthousiast zijn tong <w>uitsteken</w> naar de kinderen.",
                            "target_lang_translations": {
                                "en": "The dog really wanted to play and kept enthusiastically <w>sticking out</w> its tongue at the children."
                            }
                        }
                    ],
                    "synonyms": [
                        "uitstrekken"
                    ],
                    "antonyms": [
                        "intrekken"
                    ],
                    "common_phrases": [
                        "hand uitsteken",
                        "tong uitsteken"
                    ],
                    "target_lang_definitions": {
                        "en": "To move a body part outward or in a specific direction."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stick out",
                                "target_lang_sense_clarification": "to extend a body part like a tongue or hand"
                            },
                            {
                                "target_lang_word": "stretch out",
                                "target_lang_sense_clarification": "to extend a limb"
                            },
                            {
                                "target_lang_word": "put out",
                                "target_lang_sense_clarification": "to extend a hand for signaling"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f54202cc-bd20-3afc-a586-e38c828a6d62",
                    "sense_definition": "Verder naar buiten komen dan de rest van een oppervlak of groep; opvallend zichtbaar zijn.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "positie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die ene grote boom <w>steekt</w> duidelijk boven de andere bomen in het bos <w>uit</w>.",
                            "target_lang_translations": {
                                "en": "That one large tree clearly <w>stands out</w> above the other trees in the forest."
                            }
                        },
                        {
                            "text": "Pas op voor die spijker die een stukje <w>uit</w> de muur <w>steekt</w>.",
                            "target_lang_translations": {
                                "en": "Watch out for that nail that is <w>sticking out</w> of the wall a bit."
                            }
                        }
                    ],
                    "synonyms": [
                        "uitstulpen",
                        "uitrijzen",
                        "oversteken"
                    ],
                    "common_phrases": [
                        "boven de rest uitsteken",
                        "boven het maaiveld uitsteken"
                    ],
                    "target_lang_definitions": {
                        "en": "To project further outward than the rest of a surface or group; to be conspicuously visible."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stick out",
                                "target_lang_sense_clarification": "to protrude from a surface"
                            },
                            {
                                "target_lang_word": "protrude",
                                "target_lang_sense_clarification": "to project or bulge outwards"
                            },
                            {
                                "target_lang_word": "stand out",
                                "target_lang_sense_clarification": "to be prominent or easily noticed"
                            },
                            {
                                "target_lang_word": "jut out",
                                "target_lang_sense_clarification": "to extend out over a main body"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4aa2ef02-597c-3837-982a-bd8d4ec85293",
                    "sense_definition": "Iets met een scherp voorwerp door steken verwijderen of kapotmaken.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "verwijderen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In die oude, wrede legende staken de vijanden hem de ogen <w>uit</w>.",
                            "target_lang_translations": {
                                "en": "In that old, cruel legend, the enemies <w>gouged out</w> his eyes."
                            }
                        },
                        {
                            "text": "De beeldhouwer moest voorzichtig de overtollige klei met een mesje <w>uitsteken</w>.",
                            "target_lang_translations": {
                                "en": "The sculptor had to carefully <w>cut out</w> the excess clay with a small knife."
                            }
                        }
                    ],
                    "synonyms": [
                        "verwijderen"
                    ],
                    "common_phrases": [
                        "iemand de ogen uitsteken"
                    ],
                    "target_lang_definitions": {
                        "en": "To remove or destroy something by piercing or cutting it out with a sharp object."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "gouge out",
                                "target_lang_sense_clarification": "to remove something like an eye with a sharp tool"
                            },
                            {
                                "target_lang_word": "cut out",
                                "target_lang_sense_clarification": "to remove by cutting"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}