                                        "glosses": [
                                            "jemand, der von etwas profitiert und einen Nutzen bekommt, ohne Gegenleistung zu erbringen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d3d4db39-7093-4d2e-8aee-78d212795536",
                                                "sense_id": "2be2bb4b-fa78-3c3f-a910-f666c9c804e6",
                                                "text": "Nutznießer dieser Entwicklung sind die Manager der Großkonzerne."
                                            },
                                            {
                                                "example_id": "800add6b-3796-4e29-8f46-3d4e51b6cab0",
                                                "sense_id": "2be2bb4b-fa78-3c3f-a910-f666c9c804e6",
                                                "text": "„Die Leute, die fünfzehn, zwanzig Jahre jünger waren als ich, die privilegierten Nutznießer der Revolution, konnten sich ihr hingeben, ohne weiter darüber nachzudenken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
