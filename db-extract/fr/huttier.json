                    {
                        "sense_id": "c2516248-5476-3ed6-9d9a-e95e11d2bc43",
                        "entry_id": "48964d03-4b1d-3c39-9f8a-7830b34c36bd",
                        "glosses": [
                            "Chasseur qui chasse à l’affut dans une hutte."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "961f5478-f224-4986-bd8e-cdd2203b0fc3",
                                "sense_id": "c2516248-5476-3ed6-9d9a-e95e11d2bc43",
                                "text": "Les noms qui s’y trouvent sont parfois donnés sous une forme vieillie. Littré retient hutteur alors que la forme usuelle, déjà au xixᵉ siècle, est huttier."
                            },
                            {
                                "example_id": "d84f47c6-86e2-44f3-9751-84332e99ff5d",
                                "sense_id": "c2516248-5476-3ed6-9d9a-e95e11d2bc43",
                                "text": "Ils allaient, avec une patience que les huttiers pourront seuls comprendre, guetter les amphibies sur le bord de ces trous par lesquels ils venaient respirer à la surface de l'icefield."
                            }
                        ]
                    },
                    {
                        "sense_id": "ac654087-c207-39cc-888d-135155a12788",
                        "entry_id": "48964d03-4b1d-3c39-9f8a-7830b34c36bd",
                        "glosses": [
                            "Nom donné aux habitants des parties marécageuses de Vendée."
                        ],
                        "tags": [
                            "Vendée"
                        ],
                        "examples": [
                            {
                                "example_id": "9cec82c6-bc0d-41f0-b8ab-c6db8ab33c93",
                                "sense_id": "ac654087-c207-39cc-888d-135155a12788",
                                "text": "Les huttiers forment, sur plusieurs points des marais non desséchés du bassin de la Sèvre, une espèce de peuplade..."
                            }
                        ]
                    },
