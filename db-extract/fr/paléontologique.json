        "fr-extract.jsonl": [
            {
                "entry_id": "910daed3-f69f-30be-9524-ebbc3d052744",
                "word": "paléontologique",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "38966b16-fb01-4a1f-b495-a3d605884616",
                        "entry_id": "910daed3-f69f-30be-9524-ebbc3d052744",
                        "tags": [
                            "plural",
                            "masculine",
