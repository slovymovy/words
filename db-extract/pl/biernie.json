                "translations": [
                    {
                        "translation_id": "d643cdd6-b83c-46fd-bc5c-717a565056bf",
                        "source_entry_id": "1b2e4e9f-c7ae-343e-882d-a05c3f71b039",
                        "source_sense_id": "94b724de-ef28-300a-934d-6bbbc7529752",
                        "target_lang_word": "passively",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "passively",
