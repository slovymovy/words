                    }
                ],
                "senses": [
                    {
                        "sense_id": "9601a5f1-82d2-39c0-ae8f-aa386f934027",
                        "entry_id": "6a4cb12d-4d57-3349-9e89-009c80a386ab",
                        "glosses": [
                            "Vergütung für eine geleistete Arbeit"
                        ],
                        "tags": [
                            "Austrian German",
                            "South German",
                            "Swiss Standard German",
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "8be47ac8-decc-40da-a5f6-aadb3eb56720",
                                "sense_id": "9601a5f1-82d2-39c0-ae8f-aa386f934027",
                                "text": "Er hat ein anständiges Salär."
                            },
                            {
                                "example_id": "79a9985c-50bb-4f06-8ad3-64866670f781",
                                "sense_id": "9601a5f1-82d2-39c0-ae8f-aa386f934027",
                                "text": "„Bei der Deutschen Bank liegt das Salär im Schnitt bei 5,9 Millionen.“"
                            },
                            {
                                "example_id": "18bcf39a-836d-479e-8f60-3965d923a241",
                                "sense_id": "9601a5f1-82d2-39c0-ae8f-aa386f934027",
                                "text": "„Nicht von ungefähr sind es, zumindest in Deutschland, vor allem unterbeschäftigte Postbeamte, die durch die Zusammenstellung und private Publikation von Eisenbahnkursbüchern ihr schmales Salär aufbessern.“"
                            },
                            {
                                "example_id": "393c2f56-1009-41ac-a7b1-e1861d53a756",
                                "sense_id": "9601a5f1-82d2-39c0-ae8f-aa386f934027",
                                "text": "„Der junge Kellner-Commis wurde weniger durch sein geringes Salär, als vielmehr durch seine guten Beziehungen und sein Organisationstalent für eine wichtige Stütze der Familie.“"
                            },
                            {
                                "example_id": "bf0cf6d9-e5a3-4d0d-9fd1-d5c64aef538e",
                                "sense_id": "9601a5f1-82d2-39c0-ae8f-aa386f934027",
                                "text": "„Zwei Recherchen unserer Zeitung haben in den letzten Wochen grosses Echo ausgelöst: jene über das unerwartet höhere Salär des Verwaltungsratspräsidenten des Luzerner Kantonsspitals und jene über die schlechte Stimmung in der kantonalen Dienststelle Immobilien, die im Abgang des Leiters gipfelte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e5063bc8-5540-4c74-bd8c-07cac5d24563",
                        "source_entry_id": "6a4cb12d-4d57-3349-9e89-009c80a386ab",
                        "source_sense_id": "9601a5f1-82d2-39c0-ae8f-aa386f934027",
                        "source_sense_description": "Vergütung für eine geleistete Arbeit",
                        "target_lang_word": "salary",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "salary",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f97c81f1-5382-328e-b55d-b560021242cc",
                                        "entry_id": "04522e15-6ae7-32ff-bb19-b467c7ac7dcc",
                                        "glosses": [
                                            "A fixed amount of money paid to a worker, usually calculated on a monthly or annual basis, not hourly, as wages. Implies a degree of professionalism and/or autonomy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "644ab3ca-1ae0-40a2-81b1-be20b71846c2",
                                                "sense_id": "f97c81f1-5382-328e-b55d-b560021242cc",
                                                "text": "This is hire and salary, not revenge."
                                            },
                                            {
                                                "example_id": "4de70d20-c0c7-4e2b-b9e0-daf1b89d9820",
                                                "sense_id": "f97c81f1-5382-328e-b55d-b560021242cc",
                                                "text": "Andrew Houſtoun and Adam Muſhet, being Tackſmen of the Excize, did Imploy Thomas Rue to be their Collector, and gave him a Sallary of 30. pound Sterling for a year."
                                            },
                                            {
                                                "example_id": "f7d3555e-6742-4925-b704-125b0a36075e",
                                                "sense_id": "f97c81f1-5382-328e-b55d-b560021242cc",
                                                "text": "I used to say to our audiences: “It is difficult to get a man understand something, when his salary depends upon his not understanding it!”"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "salary",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ed8e74aa-92fe-3aae-a146-e4167358d407",
                                        "entry_id": "700a4a9e-5296-35c7-8eb0-6a1a2500a1cc",
                                        "glosses": [
                                            "To pay on the basis of a period of a week or longer, especially to convert from another form of compensation."
