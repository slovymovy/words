                "senses": [
                    {
                        "sense_id": "61b8f1ed-05bc-3b40-9e54-f823ac3189b0",
                        "entry_id": "806bc66a-3a7f-3320-84c1-cedd4b3d899c",
                        "glosses": [
                            "To perfume with incense."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8d593b56-2f9d-49ef-aeba-39e6ac2be39b",
                                "sense_id": "61b8f1ed-05bc-3b40-9e54-f823ac3189b0",
                                "text": "The Salii sing and 'cense his altars round."
                            },
                            {
                                "example_id": "5d5b8494-4863-4154-8cd6-60ad094bf716",
                                "sense_id": "61b8f1ed-05bc-3b40-9e54-f823ac3189b0",
                                "text": "Alternatively he would make a pretty good deacon: tall, well built, with quite a good voice, assiduously censing every nook and cranny, endowed with a certain histrionic talent, and perhaps also a genuine devotion to the service of God."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ff01ac30-3d7e-447d-92d7-500d521c5231",
                        "source_entry_id": "806bc66a-3a7f-3320-84c1-cedd4b3d899c",
                        "source_sense_id": "61b8f1ed-05bc-3b40-9e54-f823ac3189b0",
                        "source_sense_description": "to perfume with incense",
                        "target_lang_word": "bewieroken",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bewieroken",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "2e7fbf38-d787-3654-a537-da119bf9bc31",
                                        "entry_id": "f06a66a9-0a56-395a-a258-0c3720f6da9f",
                                        "glosses": [
                                            "wierookdampen over iets of iemand aanbrengen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "51ad090c-c77f-4922-a986-92b106f5a63a",
                                                "sense_id": "2e7fbf38-d787-3654-a537-da119bf9bc31",
                                                "text": "De priester bewierookte de kist."
                                            },
                                            {
                                                "example_id": "f35f6c6b-78a1-46e5-83b5-f9675cd2bd94",
                                                "sense_id": "2e7fbf38-d787-3654-a537-da119bf9bc31",
                                                "text": "Ende alsi daer comen sijn, so hebbense wierooc ende ander dinghen, die wel rieken ende bewieroken desen afgod, recht oft die lichaem ons heren ware."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9cb477ea-f5d3-352e-b515-5633d6915373",
                                        "entry_id": "f06a66a9-0a56-395a-a258-0c3720f6da9f",
                                        "glosses": [
                                            "iemand lof toezwaaien"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c7c2cef4-555a-4e7d-93fe-977c85970784",
                                                "sense_id": "9cb477ea-f5d3-352e-b515-5633d6915373",
                                                "text": "De jubilaris werd uitgebreid bewierookt."
                                            },
                                            {
                                                "example_id": "5533130d-e692-4be7-9206-e264b1d4ff60",
                                                "sense_id": "9cb477ea-f5d3-352e-b515-5633d6915373",
                                                "text": "Het meest bewierookte team van de moderne tijd was na 79 minuten gedegradeerd tot een stelletje zeurende, struikelende toeschouwers in gele shirtjes\", zo wordt Barcelona op de plek gezet."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f67b6e41-90e9-4d6f-93fa-d80ec7b68709",
                        "source_entry_id": "806bc66a-3a7f-3320-84c1-cedd4b3d899c",
                        "source_sense_id": "61b8f1ed-05bc-3b40-9e54-f823ac3189b0",
                        "source_sense_description": "to perfume with incense",
                        "target_lang_word": "encenser",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "encenser",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c38b41ab-4015-3689-88a9-6373157b7a6e",
                                        "entry_id": "ca2384b3-e6ae-3c14-90ed-33b9592d6e39",
                                        "glosses": [
                                            "Honorer suivant un rite en brûlant de l’encens dans l'encensoir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f8cddcdf-9de6-4fd5-a7e8-94792b54a280",
                                                "sense_id": "c38b41ab-4015-3689-88a9-6373157b7a6e",
                                                "text": "Pendant l’offertoire, le roi, et en son absence la reine, était encensé immédiatement après le célébrant."
                                            },
                                            {
                                                "example_id": "6214b25e-037d-4c71-8478-6abe4b7d7f87",
                                                "sense_id": "c38b41ab-4015-3689-88a9-6373157b7a6e",
                                                "text": "On nous apprenait à servir la messe du grand et du petit côté, à chanter les antiennes, à faire des génuflexions, à encenser élégamment, ce qui est très difficile."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ec7ced1f-0fa5-3319-bdbb-b003606cafbe",
                                        "entry_id": "ca2384b3-e6ae-3c14-90ed-33b9592d6e39",
                                        "glosses": [
                                            "Faire l’éloge de, flatter par des louanges outrées."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c94e3eec-aac3-4b2f-ad59-ef7ab94c8897",
                                                "sense_id": "ec7ced1f-0fa5-3319-bdbb-b003606cafbe",
                                                "text": "M. Canning et M. De Metternich sont les dieux que ces opinons encensent ou maudissent."
                                            },
                                            {
                                                "example_id": "9173048c-8097-4fe3-965e-6564719d6e68",
                                                "sense_id": "ec7ced1f-0fa5-3319-bdbb-b003606cafbe",
                                                "text": "Encenser un jour ce que l’on a brûlé la veille, ce phénomène n’a pas épargné Cannonball Adderley."
                                            },
                                            {
                                                "example_id": "eaa6a323-5c86-482b-b72f-f0672c140101",
                                                "sense_id": "ec7ced1f-0fa5-3319-bdbb-b003606cafbe",
                                                "text": "Les gens de Fox News sont géniaux, car ils m’encensent. Les gens de Fox News sont stupides, car ils me critiquent."
                                            },
                                            {
                                                "example_id": "3d57a431-b902-4613-86a4-3d0cc77c3783",
                                                "sense_id": "ec7ced1f-0fa5-3319-bdbb-b003606cafbe",
                                                "text": "On réhabilite juridiquement, on réintègre posthumément dans les Unions d’Écrivains ou autres qui ont jadis sonné l’hallali contre les victimes aujourd’hui encensées."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "234e61aa-ce32-349c-a97d-dbd87159505d",
                                        "entry_id": "ca2384b3-e6ae-3c14-90ed-33b9592d6e39",
                                        "glosses": [
                                            "Faire un mouvement de bas en haut, en parlant de ce que certains chevaux font avec leur tête."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5a590572-5a61-4ecc-86b5-3d4f798896e5",
                                                "sense_id": "234e61aa-ce32-349c-a97d-dbd87159505d",
                                                "text": "Les chevaux de fiacre encensaient misérablement ; des ouvrières pressées débouchaient du métro par bandes et de minces voyous, postés à l'angle de la rue Lepic, sifflaient leurs femmes."
                                            },
                                            {
                                                "example_id": "0512d821-8e5d-4f3c-b350-9e7a9ea14fd2",
                                                "sense_id": "234e61aa-ce32-349c-a97d-dbd87159505d",
                                                "text": "Joséfa le dévorait des yeux ; elle encensait du chef, vieille jument réformée que réveille une musique de cirque."
                                            },
                                            {
                                                "example_id": "09f9a48c-4947-4be8-912f-8f82ef63f523",
                                                "sense_id": "234e61aa-ce32-349c-a97d-dbd87159505d",
                                                "text": "Il ne fallait pas dire : « L’alezane encensait au mitan de la sommière », mais : « La jument rouge à crinière blanche agitait la tête de haut en bas au milieu du chemin forestier. »"
                                            },
                                            {
                                                "example_id": "ab3eb6c1-136b-4fcf-8329-744503086387",
                                                "sense_id": "234e61aa-ce32-349c-a97d-dbd87159505d",
                                                "text": "Il faisait sombre et froid. Le cheval encensait, redoutant l’orage."
                                            },
                                            {
                                                "example_id": "0443f683-8b89-4896-a20c-0b1a5758da8f",
                                                "sense_id": "234e61aa-ce32-349c-a97d-dbd87159505d",
                                                "text": "Le cheval encensa une fois de plus et Rambert approuva sans passion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "65a4a045-7a0f-37c7-b70e-e5f2c3b17864",
                                        "entry_id": "ca2384b3-e6ae-3c14-90ed-33b9592d6e39",
                                        "glosses": [
                                            "Se dit d’un navire ballotté par les flots, faisant des mouvements de bas en haut, comme un cheval."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd3a1bb3-9eae-4400-938b-d6441643fd5a",
                                                "sense_id": "65a4a045-7a0f-37c7-b70e-e5f2c3b17864",
                                                "text": "Le navire se présentait par l’arrière et à chaque lame qui passait sous lui, encensait fortement et retombait dans le sillon de tout son poids."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
