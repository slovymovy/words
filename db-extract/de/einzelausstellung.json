                "senses": [
                    {
                        "sense_id": "fcc8b0d8-a368-3171-bafa-a23e084d4ef0",
                        "entry_id": "3488a99e-17ca-3479-985b-951cce114145",
                        "glosses": [
                            "Ausstellung von Werken einer einzelnen Künstlerin oder eines einzelnen Künstlers"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5aaf706-e807-44a4-883f-147818a2cdc4",
                                "sense_id": "fcc8b0d8-a368-3171-bafa-a23e084d4ef0",
                                "text": "„Er präsentierte sein Werk in zahlreichen Gruppen- und Einzelausstellungen den internationalen Kunstinteressenten.“"
                            },
                            {
                                "example_id": "a6f6ba92-55a3-4392-926a-c4df6a1fb591",
                                "sense_id": "fcc8b0d8-a368-3171-bafa-a23e084d4ef0",
                                "text": "„Neben zahlreichen internationalen Gruppenausstellungen zeigen Einzelausstellungen in Bern, Basel und Zürich 2010 und eine geplante Einzelausstellung in der Bundeskunsthalle in Bonn 2011 die aktuelle Relevanz des Werkes von Rosemarie Trockel.“"
                            },
                            {
                                "example_id": "5c777546-d6ba-409a-8f9f-b86e4ec9020c",
                                "sense_id": "fcc8b0d8-a368-3171-bafa-a23e084d4ef0",
                                "text": "„Die fünf [Künstler] … entschieden sich nicht für die naheliegende Form einer Gruppenausstellung: Sie einigten sich auf fünf Einzelausstellungen der besonderen Art, denn der Clou ihres Entscheides ist, dass die Einzelausstellungen zeitgleich im gleichen Raum stattfinden.“"
                            },
                            {
                                "example_id": "b250deee-c28f-4911-b856-9e0b4a22abb5",
                                "sense_id": "fcc8b0d8-a368-3171-bafa-a23e084d4ef0",
                                "text": "„1953 hatte Ernst Sagewka eine umfassende Einzelausstellung mit 72 Gemälden, Aquarellen und Zeichnungen im Städtischen Kunsthaus Bielefeld.“"
                            },
                            {
                                "example_id": "fe9f9518-ee85-41bb-b20a-2637aad12ebe",
                                "sense_id": "fcc8b0d8-a368-3171-bafa-a23e084d4ef0",
                                "text": "„Seine Einzelausstellung des Jahres 1955 in der Sidney Janis Gallery enthielt keine neueren Werke, so dass es sich um eine kleine Retrospektive handelte.“"
                            },
                            {
                                "example_id": "832c50a3-750c-482c-8ff5-20c12435aff6",
                                "sense_id": "fcc8b0d8-a368-3171-bafa-a23e084d4ef0",
                                "text": "„Die große Pollock-Einzelausstellung dieses Jahres fand in Betty Parsons Galerie statt und bestand aus 21 Ölbildern, die allesamt Nummerntitel trugen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
