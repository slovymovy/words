{
    "word_family": [
        "assassin",
        "assassination"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f1ecb049-cee1-320b-a9f1-cb870cbeecc3",
                    "sense_definition": "To murder someone, especially an important person, by a sudden or obscure attack, especially for ideological or political reasons.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "political murder",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The group planned to <w>assassinate</w> the president during his visit to the capital.",
                            "target_lang_translations": {
                                "ru": "Группа планировала <w>убить</w> президента во время его визита в столицу."
                            }
                        },
                        {
                            "text": "History changed forever when they managed to <w>assassinate</w> a political leader in broad daylight.",
                            "target_lang_translations": {
                                "ru": "История изменилась навсегда, когда им удалось <w>убить</w> политического лидера средь бела дня."
                            }
                        }
                    ],
                    "synonyms": [
                        "murder",
                        "liquidate",
                        "eliminate"
                    ],
                    "common_phrases": [
                        "assassinate a political leader",
                        "plot to assassinate"
                    ],
                    "target_lang_definitions": {
                        "ru": "Убить кого-либо, особенно важную персону, путем внезапного или тайного нападения, как правило, по идеологическим или политическим мотивам."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "убить",
                                "target_lang_sense_clarification": "лишить жизни важного деятеля"
                            },
                            {
                                "target_lang_word": "совершить покушение",
                                "target_lang_sense_clarification": "на жизнь политического лидера"
                            },
                            {
                                "target_lang_word": "ликвидировать",
                                "target_lang_sense_clarification": "устранить по политическим причинам"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d02e324d-bdfa-3820-99ae-2cbca4e7ab41",
                    "sense_definition": "To harm, ruin, or defame severely or destroy by treachery, slander, or libel.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "reputation damage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tabloid newspaper tried to <w>assassinate</w> his character with false accusations.",
                            "target_lang_translations": {
                                "ru": "Таблоидная газета пыталась <w>опорочить</w> его репутацию ложными обвинениями."
                            }
                        },
                        {
                            "text": "It is cruel to <w>assassinate</w> someone's reputation just to win a local election.",
                            "target_lang_translations": {
                                "ru": "Жестоко <w>уничтожать</w> чью-то репутацию только ради победы на местных выборах."
                            }
                        }
                    ],
                    "synonyms": [
                        "slander",
                        "defame",
                        "vilify"
                    ],
                    "common_phrases": [
                        "assassinate someone's character",
                        "assassinate his reputation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Нанести серьезный вред, опорочить или разрушить чью-либо репутацию с помощью клеветы или предательства."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "опорочить",
                                "target_lang_sense_clarification": "честное имя или репутацию"
                            },
                            {
                                "target_lang_word": "дискредитировать",
                                "target_lang_sense_clarification": "подорвать доверие к кому-либо"
                            },
                            {
                                "target_lang_word": "очернить",
                                "target_lang_sense_clarification": "представить в дурном свете"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "22139577-81e7-3884-8376-d1bb6ad38109",
                    "sense_definition": "The act of <w>assassination</w> or murder.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "political murder",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old text described the <w>assassinate</w> of the king by his own guards.",
                            "target_lang_translations": {
                                "ru": "В старом тексте описывалось <w>убийство</w> короля его собственной гвардией."
                            }
                        },
                        {
                            "text": "He feared an <w>assassinate</w> upon his father would lead to a civil war.",
                            "target_lang_translations": {
                                "ru": "Он боялся, что <w>покушение</w> на его отца приведет к гражданской войне."
                            }
                        }
                    ],
                    "synonyms": [
                        "assassination",
                        "murder"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used in older literature to mean assassination"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт убийства или покушения (устаревшее использование слова как существительного)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "убийство",
                                "target_lang_sense_clarification": "акт лишения жизни"
                            },
                            {
                                "target_lang_word": "покушение",
                                "target_lang_sense_clarification": "нападение на важную персону"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5667029d-83a1-3db7-ac1b-3ef5b3d1e1f2",
                    "sense_definition": "A person who commits an <w>assassination</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>assassinate</w> waited in the shadows for the target to arrive.",
                            "target_lang_translations": {
                                "ru": "<w>Убийца</w> поджидал в тени прибытия цели."
                            }
                        },
                        {
                            "text": "They were described as desperate men fit to be <w>assassinates</w> for hire.",
                            "target_lang_translations": {
                                "ru": "Их описывали как отчаянных людей, подходящих на роль наемных <w>убийц</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "assassin",
                        "killer",
                        "hitman"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used in older literature to mean assassin"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, совершающий убийство (устаревшее использование слова как существительного)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "убийца",
                                "target_lang_sense_clarification": "совершивший преступление"
                            },
                            {
                                "target_lang_word": "наемный убийца",
                                "target_lang_sense_clarification": "исполнитель заказа"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}