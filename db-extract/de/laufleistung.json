                ],
                "senses": [
                    {
                        "sense_id": "c8883d34-613a-37a2-87ae-587397928419",
                        "entry_id": "d7186175-b4c1-3f92-ba41-ef8c7d66dac1",
                        "glosses": [
                            "Leistung eines Fahrzeugs/einer Maschine im Betrieb (Betriebsdauer/Laufzeit, zurückgelegte Strecke)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7b19ee25-dae1-46cf-959b-18c725d993e2",
                                "sense_id": "c8883d34-613a-37a2-87ae-587397928419",
                                "text": "„Des Weiteren werden die jährlichen Energiekosten bei einer Laufleistung von 15.000 Kilometern sowie die aktuell zu zahlende Kfz-Steuer angegeben.“"
                            },
                            {
                                "example_id": "19bae4f0-7928-480f-8c1e-f8f9a9f7404b",
                                "sense_id": "c8883d34-613a-37a2-87ae-587397928419",
                                "text": "„Für den Akku des Torres EVX ist eine üppige Garantie von zehn Jahren oder einer Laufleistung bis zu einer Million Kilometer vorgesehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "a50e33ef-d453-345c-8055-7b7ee599012f",
                        "entry_id": "d7186175-b4c1-3f92-ba41-ef8c7d66dac1",
                        "glosses": [
                            "Leistung eines Läufers beim Laufen (zurückgelegte Strecke, Pace, Zeit und so weiter); die mit dem Laufen erbrachte Leistung eines Sportlers"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a83a3d11-03a4-42d3-abce-d06e56ad934b",
                                "sense_id": "a50e33ef-d453-345c-8055-7b7ee599012f",
                                "text": "„Meine Laufleistung war heute eher bescheiden, aber das ist zweitrangig.“"
                            },
                            {
                                "example_id": "18770b4f-2ca0-491e-9a93-7e5371d71b8a",
                                "sense_id": "a50e33ef-d453-345c-8055-7b7ee599012f",
                                "text": "„Der 28-Jährige überzeugte mit seiner Laufleistung gepaart mit jeder Menge Spielwitz.“"
                            },
                            {
                                "example_id": "a6f4be34-dc26-476f-bc29-adef3b3e73b8",
                                "sense_id": "a50e33ef-d453-345c-8055-7b7ee599012f",
                                "text": "„Seine überragende Laufleistung gepaart mit Technik und Aggressivität machen den Mittelfeldspieler zu einem begehrten Talent.“"
                            },
                            {
                                "example_id": "b8fcd4f9-a071-43ad-91ea-810e864efd7b",
                                "sense_id": "a50e33ef-d453-345c-8055-7b7ee599012f",
                                "text": "„Er hing in den letzten Spielen mehr oder weniger in der Luft und trat trotz guter Laufleistung vor dem Tor wenig in Aktion.“"
                            },
                            {
                                "example_id": "a0325928-063a-4bc8-b457-3a1f155130b5",
                                "sense_id": "a50e33ef-d453-345c-8055-7b7ee599012f",
                                "text": "„Nach der Winterpause stieg die Laufleistung der Spieler wieder.“"
                            },
                            {
                                "example_id": "06a356b0-25ef-49fc-8438-8adfb871cc57",
                                "sense_id": "a50e33ef-d453-345c-8055-7b7ee599012f",
                                "text": "„Er ist eben ein Teamplayer mit einer der höchsten Laufleistung [sic!] im Team.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "30b648d1-4c63-48d4-8c61-9d2f3a1ef95f",
                        "source_entry_id": "d7186175-b4c1-3f92-ba41-ef8c7d66dac1",
                        "source_sense_id": "c8883d34-613a-37a2-87ae-587397928419",
                        "source_sense_description": "Leistung eines Fahrzeugs/einer Maschine im Betrieb",
                        "target_lang_word": "mileage",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mileage",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3c78e632-d354-39c9-a5e8-3ddc96b7fc03",
                                        "entry_id": "95538710-a2db-31f5-bf25-a38e147c2ea9",
                                        "glosses": [
                                            "The total distance travelled in miles or in air miles."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e4a5eeee-a188-4a27-bb8c-29a5bd467a71",
                                                "sense_id": "3c78e632-d354-39c9-a5e8-3ddc96b7fc03",
                                                "text": "But beyond these cut-offs, to avoid the wholesale alteration of all mileposting and mileages—of bridges and culverts, for example—the original mileposts have remained unaltered."
                                            },
                                            {
                                                "example_id": "af245a1b-b5d7-4dcc-9204-03d1baea91ed",
                                                "sense_id": "3c78e632-d354-39c9-a5e8-3ddc96b7fc03",
                                                "text": "In June, 1950, therefore, the Railway Board prepared a tentative regrouping scheme, which contemplated the formation of six new railway systems, each serving a specific zone, and consisting of approximately 5,000 to 6,000 route-miles of line, the total mileage being 33,000."
                                            },
                                            {
                                                "example_id": "7b90df39-5523-4611-aa2c-317a44534b49",
                                                "sense_id": "3c78e632-d354-39c9-a5e8-3ddc96b7fc03",
                                                "text": "Having laid out these big-picture figures, the report then begins its analysis of traffic types against route mileage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c0617417-af36-3d99-a320-d8663bc86c0a",
                                        "entry_id": "95538710-a2db-31f5-bf25-a38e147c2ea9",
                                        "glosses": [
                                            "The number of miles travelled by a vehicle on a certain volume of fuel."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d407ae16-33a7-43df-bcbe-5f70951f201c",
                                                "sense_id": "c0617417-af36-3d99-a320-d8663bc86c0a",
                                                "text": "On the other hand, there will be widespread agreement with Sir Brian's belief that, when a British main line has been completely dieselised and the schedules have been recast to suit the new traction, much higher daily mileages than 350 are not only possible but requisite, at least in the early stages of dieselisation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "82d4da20-51de-30c1-bba0-238ca640ba9a",
                                        "entry_id": "95538710-a2db-31f5-bf25-a38e147c2ea9",
                                        "glosses": [
                                            "An allowance for travel expenses at a specified rate per mile."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e0949b67-e704-3a54-abec-0ee00e062c3f",
                                        "entry_id": "95538710-a2db-31f5-bf25-a38e147c2ea9",
                                        "glosses": [
                                            "The amount of service that something has yielded or may yield in future."
                                        ],
                                        "tags": [
                                            "countable",
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2fc44396-f213-4247-a15f-fd1fc0da9efd",
                                                "sense_id": "e0949b67-e704-3a54-abec-0ee00e062c3f",
                                                "text": "This old PC has still got plenty of mileage in it."
                                            },
                                            {
                                                "example_id": "590d3f19-b2d5-4631-8e59-5dc3c42f3a73",
                                                "sense_id": "e0949b67-e704-3a54-abec-0ee00e062c3f",
                                                "text": "There’s quite a lot of mileage in language, speech and computing, particularly in research."
                                            },
                                            {
                                                "example_id": "61fd7825-3525-45b1-8d9e-ba2985a58a4b",
                                                "sense_id": "e0949b67-e704-3a54-abec-0ee00e062c3f",
                                                "text": "Don't waste your money on a new set of speakers / You get more mileage from a cheap pair of sneakers / Next phase, new wave, dance craze, anyways / It's still rock and roll to me"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a10bceef-961f-390b-9925-885180b27ee7",
                                        "entry_id": "95538710-a2db-31f5-bf25-a38e147c2ea9",
                                        "glosses": [
                                            "Something worth taking into consideration."
                                        ],
                                        "tags": [
                                            "countable",
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "988057aa-6b30-41d4-a4b6-c1def1bc14dd",
                                                "sense_id": "a10bceef-961f-390b-9925-885180b27ee7",
                                                "text": "There’s some mileage in your argument."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ba530772-0e6f-378e-85c9-062fe25b7082",
                                        "entry_id": "95538710-a2db-31f5-bf25-a38e147c2ea9",
                                        "glosses": [
                                            "The total number of a person's past sexual encounters."
                                        ],
                                        "tags": [
                                            "countable",
                                            "slang",
