    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f77cfcc2-afce-3c10-b474-938cb47f2fc2",
                    "sense_definition": "Waves that break on an ocean shoreline.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "water_waves",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>surf</w> was too rough for us to go swimming today.",
                            "target_lang_translations": {
                                "ru": "<w>Прибой</w> был слишком сильным, чтобы мы могли сегодня купаться.",
                                "de": "Die <w>Brandung</w> war heute zu stark, als dass wir hätten schwimmen gehen können."
                            }
                        },
                        {
                            "text": "We sat on the sand and listened to the pounding <w>surf</w>.",
                            "target_lang_translations": {
                                "ru": "Мы сидели на песке и слушали грохочущий <w>прибой</w>.",
                                "de": "Wir saßen im Sand und hörten der rauschenden <w>Brandung</w> zu."
                            }
                        }
                    ],
                    "synonyms": [
                        "breakers",
                        "waves",
                        "foam"
                    ],
                    "common_phrases": [
                        "heavy surf",
                        "rough surf",
                        "surf's up",
                        "sound of the surf"
                    ],
                    "target_lang_definitions": {
                        "ru": "Волны, разбивающиеся о берег океана.",
                        "de": "Wellen, die an der Küste brechen."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прибой",
                                "target_lang_sense_clarification": "волны у берега"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Brandung",
                                "target_lang_sense_clarification": "an die Küste schlagende Wellen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1a60c878-8e23-3f84-9a30-63fd4b678f58",
                    "sense_definition": "An instance or session of riding a surfboard in the surf.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sport_session",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He woke up early to go for a <w>surf</w> before work.",
                            "target_lang_translations": {
                                "ru": "Он проснулся рано, чтобы пойти на <w>сёрфинг</w> перед работой.",
                                "de": "Er stand früh auf, um vor der Arbeit noch eine Runde zu <w>surfen</w>."
                            }
                        },
                        {
                            "text": "We had a great <w>surf</w> this morning because the waves were perfect.",
                            "target_lang_translations": {
                                "ru": "У нас был отличный <w>сёрфинг</w> сегодня утром, потому что волны были идеальными.",
                                "de": "Wir hatten heute Morgen eine tolle <w>Surfsession</w>, weil die Wellen perfekt waren."
                            }
                        }
                    ],
                    "common_phrases": [
                        "go for a surf",
                        "morning surf"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сеанс или процесс катания на сёрфборде.",
                        "de": "Eine Einheit oder ein Zeitraum des Wellenreitens."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сёрфинг",
                                "target_lang_sense_clarification": "занятие"
                            },
                            {
                                "target_lang_word": "катание",
                                "target_lang_sense_clarification": "сеанс"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Surfsession",
                                "target_lang_sense_clarification": "ein Zeitraum des Surfens"
                            },
                            {
                                "target_lang_word": "Surfen",
                                "target_lang_sense_clarification": "das Ausüben des Sports"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bdc4f57c-379f-30fc-9172-2e114e039e15",
                    "sense_definition": "A dance popular in the 1960s in which the movements of a surfboard rider are mimicked.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "dance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My grandmother showed us how to do the <w>surf</w> at the party.",
                            "target_lang_translations": {
                                "ru": "Моя бабушка показала нам, как танцевать <w>сёрф</w>, на вечеринке.",
                                "de": "Meine Großmutter zeigte uns auf der Party, wie man den <w>Surf</w> tanzt."
                            }
                        },
                        {
                            "text": "The band played old music while people danced the <w>surf</w>.",
                            "target_lang_translations": {
                                "ru": "Группа играла старую музыку, пока люди танцевали <w>сёрф</w>.",
                                "de": "Die Band spielte alte Musik, während die Leute den <w>Surf</w> tanzten."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "popular in the 1960s"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Танец, популярный в 1960-х годах, имитирующий движения сёрфера.",
                        "de": "Ein in den 1960er Jahren populärer Tanz, der die Bewegungen eines Surfers nachahmt."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сёрф",
                                "target_lang_sense_clarification": "танец"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Surf",
                                "target_lang_sense_clarification": "Tanzstil der 60er Jahre"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d9ffbaa2-7b5c-34da-8b41-07eb5824b7a9",
                    "sense_definition": "The bottom of a drain.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Water collected in the <w>surf</w> of the old ditch.",
                            "target_lang_translations": {
                                "ru": "Вода скапливалась на <w>дне</w> старой канавы.",
                                "de": "Wasser sammelte sich am Boden des alten Grabens."
                            }
                        },
                        {
                            "text": "The farmer cleared the mud from the <w>surf</w> to improve flow.",
                            "target_lang_translations": {
                                "ru": "Фермер убрал грязь со <w>дна</w>, чтобы улучшить поток.",
                                "de": "Der Landwirt entfernte den Schlamm vom Boden, um den Abfluss zu verbessern."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "regional usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Дно водостока или канавы.",
                        "de": "Der Boden eines Abflusses oder Grabens."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дно дренажа",
                                "target_lang_sense_clarification": "строит.: дно дренажной канавы или трубы"
                            }
                        ],
                        "de": []
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "aa96b51e-a201-3e28-9c17-297a07a8e869",
                    "sense_definition": "To ride a wave on a surfboard; to pursue or take part in the sport of surfing.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "sport_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She wants to learn to <w>surf</w> during her summer vacation.",
                            "target_lang_translations": {
                                "ru": "Она хочет научиться <w>кататься на сёрфе</w> во время летнего отпуска.",
                                "de": "Sie möchte in ihrem Sommerurlaub <w>surfen</w> lernen."
                            }
                        },
                        {
                            "text": "They <w>surf</w> almost every weekend at the local beach.",
                            "target_lang_translations": {
                                "ru": "Они <w>занимаются сёрфингом</w> почти каждые выходные на местном пляже.",
                                "de": "Sie <w>surfen</w> fast jedes Wochenende am örtlichen Strand."
                            }
                        }
                    ],
                    "common_phrases": [
                        "learn to surf",
                        "surf the waves"
                    ],
                    "target_lang_definitions": {
                        "ru": "Кататься на волне на сёрфборде; заниматься сёрфингом.",
                        "de": "Auf einem Surfbrett auf einer Welle reiten; den Sport des Wellenreitens ausüben."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заниматься сёрфингом",
                                "target_lang_sense_clarification": "спорт"
                            },
                            {
                                "target_lang_word": "сёрфить",
                                "target_lang_sense_clarification": "разг."
                            },
                            {
                                "target_lang_word": "кататься на сёрфе",
                                "target_lang_sense_clarification": "общее"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "surfen",
                                "target_lang_sense_clarification": "Wellenreiten"
                            },
                            {
                                "target_lang_word": "wellenreiten",
                                "target_lang_sense_clarification": "Sportart"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "03881382-4c07-34c6-9c8f-bc1314f9773c",
                    "sense_definition": "To browse the Internet, television, etc.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "digital_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I usually <w>surf</w> the web for news while I drink my coffee.",
                            "target_lang_translations": {
                                "ru": "Я обычно <w>сёрфлю</w> в интернете в поисках новостей, пока пью кофе.",
                                "de": "Ich <w>surfe</w> meistens im Internet nach Nachrichten, während ich meinen Kaffee trinke."
                            }
                        },
                        {
                            "text": "He likes to <w>surf</w> through different channels when he is bored.",
                            "target_lang_translations": {
                                "ru": "Ему нравится <w>щёлкать</w> разные каналы, когда ему скучно.",
                                "de": "Er <w>zappt</w> gerne durch die verschiedenen Kanäle, wenn ihm langweilig ist."
                            }
                        }
                    ],
                    "synonyms": [
                        "browse",
                        "navigate"
                    ],
                    "common_phrases": [
                        "surf the internet",
                        "surf the web",
                        "channel surf"
                    ],
                    "target_lang_definitions": {
                        "ru": "Просматривать страницы в интернете или переключать каналы.",
                        "de": "Im Internet surfen oder durch Fernsehkanäle schalten."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сёрфить",
                                "target_lang_sense_clarification": "интернет"
                            },
                            {
                                "target_lang_word": "сидеть в интернете",
                                "target_lang_sense_clarification": "разг."
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "surfen",
                                "target_lang_sense_clarification": "im Internet"
                            },
                            {
                                "target_lang_word": "zappen",
                                "target_lang_sense_clarification": "durch Fernsehkanäle schalten"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "02fd7798-f32f-325b-bbfe-baf1ddc6ba52",
                    "sense_definition": "To bodysurf; to swim in the surf at a beach.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sport_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We decided to <w>surf</w> without boards since the waves were small.",
                            "target_lang_translations": {
                                "ru": "Мы решили <w>покататься на волнах</w> без досок, так как волны были маленькими.",
                                "de": "Wir beschlossen, ohne Brett zu <w>bodysurfen</w>, da die Wellen klein waren."
                            }
                        },
                        {
                            "text": "He <w>surfed</w> along the shore until his skin was tanned.",
                            "target_lang_translations": {
                                "ru": "Он <w>катался на волнах</w> вдоль берега, пока не загорел.",
                                "de": "Er <w>bodysurfte</w> am Ufer entlang, bis er braungebrannt war."
                            }
                        }
                    ],
                    "synonyms": [
                        "bodysurf"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заниматься бодисёрфингом; плавать в прибое без доски.",
                        "de": "Bodysurfen; ohne Brett in der Brandung schwimmen."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кататься на волнах",
                                "target_lang_sense_clarification": "без доски"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "bodysurfen",
                                "target_lang_sense_clarification": "Wellenreiten ohne Brett"
                            }
                        ]
                    }
                }
            ]
        },
