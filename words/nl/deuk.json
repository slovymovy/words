                    "sense_definition": "De gebiedende wijs van het werkwoord <w>deuken</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "werkwoordsvorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Deuk</w> dat kartonnen doosje niet zo hard in, want het moet nog gebruikt worden.",
                            "target_lang_translations": {
                                "en": "Don't <w>crush</w> that cardboard box so hard, because it still needs to be used."
                            }
