                "senses": [
                    {
                        "sense_id": "4754af02-5541-3fbd-a652-d5cb6f736bff",
                        "entry_id": "88836d66-3506-3b26-9f23-bbc21dcf0818",
                        "glosses": [
                            "die Darreichung des konsekrierten Weines innerhalb der Eucharistiefeier"
