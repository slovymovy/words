                            "target_lang_translations": {
                                "ru": "Механик употребил несколько <w>крепких</w> выражений, когда уронил молоток.",
                                "nl": "De monteur gebruikte nogal <w>peperige</w> taal toen hij de hamer liet vallen.",
                                "pl": "Mechanik użył kilku <w>niecenzuralnych</w> słów, gdy upuścił młotek.",
                                "de": "Der Mechaniker benutzte einige <w>deftige</w> Ausdrücke, als er den Hammer fallen ließ.",
                                "fr": "Le mécanicien a utilisé des termes <w>crus</w> quand il a fait tomber le marteau.",
                                "it": "Il meccanico ha usato un linguaggio <w>colorito</w> quando ha fatto cadere il martello.",
