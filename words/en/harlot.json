                    "frequency": "Middle",
                    "semantic_group_id": "female_sexuality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The Victorian novel vividly depicted the hardships faced by every poor <w>harlot</w> living in the city slums.",
