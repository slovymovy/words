                                "example_id": "7b98079d-74b1-4f55-9fb4-b9a4ef115074",
                                "sense_id": "115e910f-810e-3235-b4db-be46fa35ecf6",
                                "text": "J’ai rencontré deux miraculées au bureau des constatations médicales de Lourdes."
                            },
                            {
                                "example_id": "92f44119-efc0-44cd-acea-a7899397073d",
                                "sense_id": "115e910f-810e-3235-b4db-be46fa35ecf6",
                                "text": "– Restez où vous êtes. Nous devons protéger la miraculée."
