                        "glosses": [
                            "Commune française, située dans le département de la Charente-Maritime."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5bf7e285-d14e-40d1-96df-e5c976dbf4c3",
                                "sense_id": "c032459c-13b1-370f-83e0-c00155f8ee84",
                                "text": "Au départ du petit port de Soubise, une randonnée vélo de 10 kilomètres fait cheminer le long de la Charente."
                            }
                        ]
                    },
                    {
                        "sense_id": "5583f144-7439-3c23-8312-f90458066496",
                        "entry_id": "8103b23d-2577-3153-bd87-255533a439fc",
                        "glosses": [
                            "Sauce accompagnant un plat de viande."
                        ],
                        "tags": [
                            "Sauces"
                        ],
                        "examples": [
                            {
                                "example_id": "931f054c-82eb-4f9c-b2c6-81511bf3f167",
                                "sense_id": "5583f144-7439-3c23-8312-f90458066496",
                                "text": "Quelques jours après, lorsque j’eus triomphé de ses indécisions, je me piquai au jeu et je lui tins parole : durant huit jours, je lui servis tour à tour des fricassées de poulet, des filets de sole, des côtelettes à la Soubise, des omelettes au rhum, et une foule d’autres plats qui la ravissaient par leur diversité."
                            }
                        ]
                    }
                ],
