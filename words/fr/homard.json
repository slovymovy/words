                    "frequency": "Middle",
                    "semantic_group_id": "crustacé",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le marin a capturé un magnifique <w>homard</w> dans son casier ce matin."
                        },
                        {
                            "text": "Pendant la marée basse, ils ont cherché un <w>homard</w> caché sous les rochers."
                        }
                    ],
                    "common_phrases": [
                        "pêche au homard",
                        "pinces de homard"
                    ]
                },
                {
                    "sense_id": "0654ccdf-1f22-32d1-93fd-a00d47911c15",
                    "sense_definition": "Chair comestible de ce crustacé, particulièrement appréciée en gastronomie.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "nourriture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le chef prépare une délicieuse bisque de <w>homard</w> pour les fêtes de fin d'année."
                        },
                        {
                            "text": "Nous avons commandé du <w>homard</w> grillé accompagné d'une sauce au beurre blanc."
                        }
                    ],
                    "common_phrases": [
                        "bisque de homard",
                        "queue de homard"
                    ]
                },
                {
                    "sense_id": "0f56f0d3-a25f-3567-aa40-6b532f62adc7",
                    "sense_definition": "Figure représentant ce crustacé dans les armoiries et les blasons.",
