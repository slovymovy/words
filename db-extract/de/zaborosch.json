                "senses": [
                    {
                        "sense_id": "5fddc2fa-079a-3f5b-83ff-b9fc109ca41c",
                        "entry_id": "06c25691-996b-3d67-8bf4-bdd2e5134f0e",
                        "glosses": [
                            "Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1191c62b-a886-4f49-bf7c-e4944aea90f2",
                                "sense_id": "5fddc2fa-079a-3f5b-83ff-b9fc109ca41c",
                                "text": "Frau Zaborosch ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "9d487cc2-91f3-4869-9c97-861372957fea",
                                "sense_id": "5fddc2fa-079a-3f5b-83ff-b9fc109ca41c",
                                "text": "Herr Zaborosch wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "1be06e9e-d061-43b5-9645-edb1dd6e929e",
                                "sense_id": "5fddc2fa-079a-3f5b-83ff-b9fc109ca41c",
                                "text": "Die Zaboroschs fliegen heute nach Irkutsk."
                            },
                            {
                                "example_id": "37a8559c-6a58-4bbf-97e6-0f6bcf28b223",
                                "sense_id": "5fddc2fa-079a-3f5b-83ff-b9fc109ca41c",
                                "text": "Der Zaborosch trägt nie die Pullover, die die Zaborosch ihm strickt."
                            },
                            {
                                "example_id": "5ebaaad4-f68e-48d8-8fc1-498fb4ff8bdd",
                                "sense_id": "5fddc2fa-079a-3f5b-83ff-b9fc109ca41c",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Zaborosch kommt, geht der Herr Zaborosch.“"
                            },
                            {
                                "example_id": "4903c549-360e-4a63-91dd-801e9e8d4258",
                                "sense_id": "5fddc2fa-079a-3f5b-83ff-b9fc109ca41c",
                                "text": "Zaborosch kommt und geht."
                            },
                            {
                                "example_id": "e1bec414-169c-421e-8f57-b3f74133e00e",
                                "sense_id": "5fddc2fa-079a-3f5b-83ff-b9fc109ca41c",
                                "text": "Zaboroschs kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
