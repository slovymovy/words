                "senses": [
                    {
                        "sense_id": "c1502294-d73f-3448-820f-d05f931fc755",
                        "entry_id": "56176b1c-7a28-33a8-b2dd-b42eb8f0fc3f",
                        "glosses": [
                            "Page, Hotelpage, Hotelboy"
                        ],
                        "tags": [],
