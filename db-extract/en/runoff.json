    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "a5566a77-3e17-3542-ab4e-4c545770f12f",
                "word": "runoff",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "b63206ca-8674-40fc-b9ca-4b65a3e4d473",
                        "entry_id": "a5566a77-3e17-3542-ab4e-4c545770f12f",
                        "tags": [
                            "plural"
                        ],
                        "form": "runoffs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6e63ec7d-b544-3694-980f-f56b8badc612",
                        "entry_id": "a5566a77-3e17-3542-ab4e-4c545770f12f",
                        "glosses": [
                            "That portion of precipitation or irrigation on an area which does not infiltrate or evaporate, but instead is discharged from the area."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "482d5d3d-3354-43e0-a529-45a6464549eb",
                                "sense_id": "6e63ec7d-b544-3694-980f-f56b8badc612",
                                "text": "The next series of high tides or large waves will tend to rebuild the berm and redam the stream. Ultimately, increased runoff due to fall or winter rains will raise the stream level to the point where it breaks through."
                            }
                        ]
                    },
                    {
                        "sense_id": "ebe74e6a-3c9a-3846-a53e-8fcc2ccfacfa",
                        "entry_id": "a5566a77-3e17-3542-ab4e-4c545770f12f",
                        "glosses": [
                            "Dissolved chemicals, etc, included in such water."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "a2f8470e-cb85-4fd9-8348-3fbd337b7c01",
                                "sense_id": "ebe74e6a-3c9a-3846-a53e-8fcc2ccfacfa",
                                "text": "The runoff of nitrates is poisoning the lake."
                            }
                        ]
                    },
                    {
                        "sense_id": "9923bc59-fe90-3da2-8895-2376b278aa94",
                        "entry_id": "a5566a77-3e17-3542-ab4e-4c545770f12f",
                        "glosses": [
                            "A second or further round of a competition, after other competitors (often all but the last two) have been eliminated."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "68bfc832-58f8-39a3-9267-73b65abe6dc6",
                        "entry_id": "a5566a77-3e17-3542-ab4e-4c545770f12f",
                        "glosses": [
                            "A second or further round of an indecisive election, after other candidates (often all but the last two) have been eliminated."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "82c9ef35-ba94-4dbc-ae0f-3e57360536cb",
                                "sense_id": "68bfc832-58f8-39a3-9267-73b65abe6dc6",
                                "text": "There will now be a runoff as neither front runner received more than 50% of the vote."
                            },
                            {
                                "example_id": "937ca253-352a-43f3-9127-4be38d84b797",
                                "sense_id": "68bfc832-58f8-39a3-9267-73b65abe6dc6",
                                "text": "It is one of the left's best ever results and will raise momentum for next month's final runoff where only the two candidates will compete against each other."
                            },
                            {
                                "example_id": "145a112b-c47e-41f2-a919-9df7510646fd",
                                "sense_id": "68bfc832-58f8-39a3-9267-73b65abe6dc6",
                                "text": "Mr. Macron was unable to command more than a small plurality of support against several opponents in the first round of voting on April 10. Ms. Le Pen, who finished second, is his opponent in the runoff election on Sunday."
                            }
                        ]
                    }
                ],
                "translations": [
