    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "55468853-5efc-338d-8459-4d59c11b8741",
                    "sense_definition": "Having or moving in a smooth, wave-like rising and falling pattern, especially of landscapes or surfaces.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "wavy_motion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cyclists struggled to maintain their pace across the <w>undulating</w> hills.",
                            "target_lang_translations": {
                                "ru": "Велосипедистам было трудно держать темп на <w>волнистых</w> холмах."
                            }
                        },
                        {
                            "text": "From the train window, we admired the <w>undulating</w> countryside stretching to the horizon.",
                            "target_lang_translations": {
                                "ru": "Из окна поезда мы любовались <w>холмистой</w> местностью, простирающейся до самого горизонта."
                            }
                        }
                    ],
                    "synonyms": [
                        "rolling",
                        "wavy"
                    ],
                    "antonyms": [
                        "flat"
                    ],
                    "common_phrases": [
                        "undulating hills",
                        "undulating landscape",
                        "undulating countryside",
                        "gently undulating"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий форму или двигающийся плавными, волнообразными подъёмами и спадами (особенно о рельефе, холмах или поверхностях)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "волнистый",
                                "target_lang_sense_clarification": "о рельефе или поверхности"
                            },
                            {
                                "target_lang_word": "волнообразный",
                                "target_lang_sense_clarification": "плавно поднимающийся и опускающийся"
                            },
                            {
                                "target_lang_word": "холмистый",
                                "target_lang_sense_clarification": "о ландшафте, местности"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "92a4f945-ad61-3618-aa7f-f971aad1195f",
                    "sense_definition": "Forming a series of regular bends, curves, or sinuous shapes.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "wavy_motion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dancer traced an <w>undulating</w> line through the air with a silk ribbon.",
                            "target_lang_translations": {
                                "ru": "Танцовщица вывела шелковой лентой в воздухе <w>волнообразную</w> линию."
                            }
                        },
                        {
                            "text": "The coast was bordered by an <w>undulating</w> ribbon of white sand.",
                            "target_lang_translations": {
                                "ru": "Побережье окаймляла <w>извилистая</w> полоса белого песка."
                            }
                        }
                    ],
                    "synonyms": [
                        "curving",
                        "sinuous"
                    ],
                    "antonyms": [
                        "straight"
                    ],
                    "common_phrases": [
                        "undulating line"
                    ],
                    "target_lang_definitions": {
                        "ru": "Образующий ряд плавных изгибов, извилин или волнообразных линий."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "извилистый",
                                "target_lang_sense_clarification": "с плавными изгибами"
                            },
                            {
                                "target_lang_word": "волнообразный",
                                "target_lang_sense_clarification": "в форме волны"
                            },
                            {
                                "target_lang_word": "волнистый",
                                "target_lang_sense_clarification": "имеющий форму волны"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ad5db3d6-a1f3-3ba9-a130-af47a20036dd",
                    "sense_definition": "Present participle of <w>undulate</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The green banner was <w>undulating</w> gently in the soft breeze.",
                            "target_lang_translations": {
                                "ru": "Зелёное знамя плавно <w>колыхалось</w> на легком ветерке."
                            }
                        },
                        {
                            "text": "We stood quietly and watched the waves <w>undulating</w> across the surface of the lake.",
                            "target_lang_translations": {
                                "ru": "Мы молча стояли и смотрели, как волны <w>перекатываются</w> по глади озера."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени от глагола undulate: колышущийся, волнующийся, колышась."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "колыхаться",
                                "target_lang_sense_clarification": "плавно двигаться волнами"
                            },
                            {
                                "target_lang_word": "волноваться",
                                "target_lang_sense_clarification": "идти волнами"
                            },
                            {
                                "target_lang_word": "колышущийся",
                                "target_lang_sense_clarification": "причастие"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c75513fe-2255-39c5-813a-b4eb95e196f6",
                    "sense_definition": "An instance of moving up and down or in waves; an <w>undulation</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He felt the subtle <w>undulating</w> of the deck beneath his feet as the ship drifted.",
                            "target_lang_translations": {
                                "ru": "Он чувствовал едва заметное <w>колыхание</w> палубы под ногами, пока корабль дрейфовал."
                            }
                        },
                        {
                            "text": "The gentle <w>undulating</w> of the field was soothing to look at in the evening light.",
                            "target_lang_translations": {
                                "ru": "На мягкую <w>волнообразность</w> поля было приятно смотреть в вечернем свете."
                            }
                        }
                    ],
                    "synonyms": [
                        "undulation"
                    ],
                    "traits": [
