                ],
                "senses": [
                    {
                        "sense_id": "37a68e52-722f-3afa-8dbc-6db16f7f4406",
                        "entry_id": "a3547166-20d6-3f08-8ef6-63352d5a0413",
                        "glosses": [
                            "von Katzen stammender Urin"
                        ],
                        "tags": [
                            "vulgar"
                        ],
                        "examples": [
                            {
                                "example_id": "9b0bfb09-ba6e-4543-b1f6-9605de7d0a67",
                                "sense_id": "37a68e52-722f-3afa-8dbc-6db16f7f4406",
                                "text": "„Es sprach für Gaysia, dass Bing hier sitzen und tiefe Züge aus einer Bong nehmen konnte in einer nach Katzenpisse stinkenden Gasse um Mitternacht.“"
                            },
                            {
                                "example_id": "462d63ce-a1b4-4b94-9448-8a8d5be633b4",
                                "sense_id": "37a68e52-722f-3afa-8dbc-6db16f7f4406",
                                "text": "„Er roch Katzenpisse.“"
                            },
                            {
                                "example_id": "65699b16-f74d-48df-a1df-b26bfe6b76dc",
                                "sense_id": "37a68e52-722f-3afa-8dbc-6db16f7f4406",
                                "text": "„Im Innern des Bungalows roch es durchdringend nach Schimmel, Katzenpisse und Pot.“"
                            },
                            {
                                "example_id": "df550c65-e651-4c19-a360-b93f3a3361b5",
                                "sense_id": "37a68e52-722f-3afa-8dbc-6db16f7f4406",
                                "text": "„Jetzt musste ich nur noch mein bescheidenes Körpergewicht auf die Spitze meines Ellbogens konzentrieren und ihr zwischen die Schulterblätter rammen, und schon sah sich Ihre Königliche Kathiheit motivierz und gezwungen, zu deklamieren: ›Sì, sì! Ich bin eine schmierige Schmierenhure und saublöde Sau und stinke wie abgestandene Katzenpisse ...‹“"
                            },
                            {
                                "example_id": "6ed08765-0fd0-4f14-9924-a235fb36b066",
                                "sense_id": "37a68e52-722f-3afa-8dbc-6db16f7f4406",
                                "text": "„Sie wandte sich rasch ab und verließ den Raum, kehrte aber Sekunden später mit einer dicken Wolldecke zurück, die nach Katzenpisse stank.“"
                            },
                            {
                                "example_id": "7711d7c4-915f-4659-a7c7-8ef6dcadeee1",
                                "sense_id": "37a68e52-722f-3afa-8dbc-6db16f7f4406",
                                "text": "„Sie forderte mich auf, mich aufs Sofa zu setzen, was ich auch tat, und sie gab mir eine selbstgemachte Limonade, die wie Katzenpisse schmeckte, nachdem man sie mit Kohlensäure versetzt und eine Zitronenscheibe hineingeworfen hat.“"
                            },
                            {
                                "example_id": "5b7b6c7a-4800-4dad-a96a-5f2c27ff02f2",
                                "sense_id": "37a68e52-722f-3afa-8dbc-6db16f7f4406",
                                "text": "„Es stank nach Katzenpisse.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
