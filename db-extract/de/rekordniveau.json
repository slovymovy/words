                "senses": [
                    {
                        "sense_id": "9c7931cb-dc89-3596-9bb7-e906750a53e5",
                        "entry_id": "335c6f36-0551-32b7-867e-ffa0e3294a96",
                        "glosses": [
                            "höchste oder niedrigste jemals erreichte Zahl/gemessener Wert oder bisher unübertroffene Bestmarke"
                        ],
                        "tags": [
                            "Umwelt"
                        ],
                        "examples": [
                            {
                                "example_id": "52d23a95-5c59-4dc3-b7cf-7482e61f0553",
                                "sense_id": "9c7931cb-dc89-3596-9bb7-e906750a53e5",
                                "text": "[Wetter:] Die Temperaturen in Europa stiegen diesen Sommer auf ein Rekordniveau von 48°C."
                            },
                            {
                                "example_id": "f1c8b152-fc7e-4a65-854d-c8a9b1ba6a32",
                                "sense_id": "9c7931cb-dc89-3596-9bb7-e906750a53e5",
                                "text": "„Der Ausstoß von Kohlendioxid aus fossilen Energieträgern ist auch dieses Jahr wieder auf Rekordniveau.“"
                            },
                            {
                                "example_id": "c5ef11fb-6d09-4962-bab3-cfdf0888f907",
                                "sense_id": "9c7931cb-dc89-3596-9bb7-e906750a53e5",
                                "text": "[Finanzen:] Der Bitcoin-Kurs erreichte am 19.01.2025 ein Rekordniveau von 105.495,00 €."
                            },
                            {
                                "example_id": "0f213b1a-4421-4b2e-839e-3454b4d3ddf5",
                                "sense_id": "9c7931cb-dc89-3596-9bb7-e906750a53e5",
                                "text": "[Arbeitsmarkt:] Die Beschäftigungsquote befindet sich auf einem Rekordniveau von 70 %."
                            },
                            {
                                "example_id": "0227d0df-065f-4d25-b2c1-e1cc1b944f95",
                                "sense_id": "9c7931cb-dc89-3596-9bb7-e906750a53e5",
                                "text": "[Schlagzeile:] „68.000 offene Stellen – Fachkräftemangel in IT-Berufen auf Rekordniveau“"
                            },
                            {
                                "example_id": "8cd6b881-becb-4d68-87c0-c266294a37cc",
                                "sense_id": "9c7931cb-dc89-3596-9bb7-e906750a53e5",
                                "text": "„Seit dem Börsencrash vom Oktober 1929 hatte sich die Wirtschaftsleistung erheblich verringert und die Arbeitslosigkeit war auf einem Rekordniveau.“"
                            },
                            {
                                "example_id": "7513445f-16d8-464d-9d0b-64ce42f1b4d8",
                                "sense_id": "9c7931cb-dc89-3596-9bb7-e906750a53e5",
                                "text": "[Siemens:] „Die Bilanz ist trotzdem sehr gut. Das zentrale industrielle Geschäft lief bei Siemens sogar auf Rekordniveau: Dort verdiente das Unternehmen nach eigenen Angaben 10,3 Milliarden Euro.“"
                            },
                            {
                                "example_id": "5d3890e5-4b1d-4d20-a1c4-1bb8d205622c",
                                "sense_id": "9c7931cb-dc89-3596-9bb7-e906750a53e5",
                                "text": "[Energiepreise:] Die Stromkosten hatten in 2022 ein Rekordniveau erreicht und belasteten Wirtschaft und Verbraucher stark."
                            },
                            {
                                "example_id": "48d8bb61-1995-4bbc-a3ee-5e5beec3b898",
                                "sense_id": "9c7931cb-dc89-3596-9bb7-e906750a53e5",
                                "text": "„Die weltweiten Rüstungsausgaben sind mit 2,2 Billionen US-Dollar auf einem neuen Rekordniveau.“"
                            },
                            {
                                "example_id": "5396d19f-49ef-4390-8e81-ef84cc2fa693",
                                "sense_id": "9c7931cb-dc89-3596-9bb7-e906750a53e5",
                                "text": "[17. Juni 1930:] „Der Smoot-Hawley Tariff Act tritt in Kraft, er erhöht die amerikanischen Zölle auf Rekordniveau.“"
                            },
                            {
                                "example_id": "8d26ab18-ce1e-4d86-8343-e42538cef39d",
                                "sense_id": "9c7931cb-dc89-3596-9bb7-e906750a53e5",
                                "text": "„Die Wohnungsnot in Baden-Württemberg spitzt sich zu und hat nach neuen Zahlen der Liga der freien Wohlfahrtspflege ein Rekordniveau erreicht.“"
                            },
                            {
                                "example_id": "98f4730b-eb0e-4187-be85-af25f6c882c9",
                                "sense_id": "9c7931cb-dc89-3596-9bb7-e906750a53e5",
                                "text": "„»Sowohl bei den Löhnen, bei den Einkommen, aber auch bei den Vermögen geht die Schere weiter auseinander und erreicht mittlerweile wirklich Rekordniveau. Und gerade auch in Deutschland. Deutschland ist das Land in der Euro-Zone mit der höchsten Ungleichheit bei den privaten Vermögen, also es trifft vor allem auf Deutschland zu.«“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
