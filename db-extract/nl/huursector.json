                        "examples": [
                            {
                                "example_id": "3f9687eb-d337-4614-8fa3-eb28959b33c6",
                                "sense_id": "8f51250b-e372-3e5b-884a-e2efc5a69c7c",
                                "text": "Amsterdam heeft nieuwbouwprojecten, maar dat zijn vaak kleine studio's gericht op starters en studenten. Niet op gezinnen met kinderen. En binnen de sociale huursector komen er in Amsterdam maar weinig gezinswoningen vrij."
                            },
                            {
                                "example_id": "8fa841b2-5fab-4f25-ba39-043515930d90",
                                "sense_id": "8f51250b-e372-3e5b-884a-e2efc5a69c7c",
                                "text": "De roep om sloop en nieuwbouw in plaats van versterking wordt ook steeds luider. Vooral de huursector ziet dit wel zitten, blijkt uit een oproep van woningcorporaties. De huurdersverenigingen staan hier vierkant achter."
                            }
                        ]
                    }
