                "senses": [
                    {
                        "sense_id": "b98076d1-ff5e-3a91-900c-010f01761718",
                        "entry_id": "d55dc35a-e939-319f-a310-8e15aa279274",
                        "glosses": [
                            "selbst gewählter Benutzername, den jemand zum Zwecke der Anonymität im Internet (beispielsweise in Foren oder Chats) nutzt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1f45f953-bc49-4f88-80ce-e2c2a62d9793",
                                "sense_id": "b98076d1-ff5e-3a91-900c-010f01761718",
                                "text": "Wie ist dein Nickname?"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d90b017b-3eeb-4e09-b6d0-f25d5f56797b",
                        "source_entry_id": "d55dc35a-e939-319f-a310-8e15aa279274",
                        "source_sense_id": "b98076d1-ff5e-3a91-900c-010f01761718",
                        "target_lang_word": "nickname",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nickname",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "74cfcdd9-a4bc-302b-9f0f-b68ec40fa120",
                                        "entry_id": "16e15482-c218-3985-bcf7-ce09ae83ff8e",
                                        "glosses": [
                                            "A familiar, invented name for a person or thing used instead of the actual name of the person or thing, often based on some noteworthy characteristic."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e1881f1-9c91-444f-a845-1b120d110f33",
                                                "sense_id": "74cfcdd9-a4bc-302b-9f0f-b68ec40fa120",
                                                "text": "\"The Big Apple\" is a common nickname for New York City."
                                            },
                                            {
                                                "example_id": "1b8613c4-f672-4cff-811a-12597d2a4bdb",
                                                "sense_id": "74cfcdd9-a4bc-302b-9f0f-b68ec40fa120",
                                                "text": "[…] Plato, who was named Aristocles after his grandfather, but received from his gymnastic master the nickname Πλάτων (from πλάτυς, broad), which practically superseded his real name."
                                            },
                                            {
                                                "example_id": "b32e620f-c06e-4673-9f41-490b3014cae5",
                                                "sense_id": "74cfcdd9-a4bc-302b-9f0f-b68ec40fa120",
                                                "text": "He excelled with the arbalest steel crossbow, winning the nickname the Arbalestier and joined Bahriyya regiment, the crack soldiers who defeated the Crusaders and became known as the Turkish Lions and the Islamic Templars."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2b202eb8-2044-3d6b-af63-a6af1acd6f8a",
                                        "entry_id": "16e15482-c218-3985-bcf7-ce09ae83ff8e",
                                        "glosses": [
                                            "A familiar, shortened or diminutive name for a person or thing."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "051ca58d-2813-4f46-9f67-8070644214b9",
                                                "sense_id": "2b202eb8-2044-3d6b-af63-a6af1acd6f8a",
                                                "text": "My name is Jonathan, but I go by my nickname, Johnny."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "nickname",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0a3e1869-6ef1-369f-8347-8f994e81f9d6",
                                        "entry_id": "84555c72-85c8-3c57-ba5d-e997e73fd10f",
                                        "glosses": [
                                            "To give a nickname to (a person or thing)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "51d4f0da-3718-4863-9b18-503780645f61",
                                                "sense_id": "0a3e1869-6ef1-369f-8347-8f994e81f9d6",
                                                "text": "Gerald, nicknamed \"Jerry\", was usually a very cheerful person."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0cce35d2-9360-4775-8632-71be31947298",
                        "source_entry_id": "d55dc35a-e939-319f-a310-8e15aa279274",
                        "source_sense_id": "b98076d1-ff5e-3a91-900c-010f01761718",
                        "target_lang_word": "pseudo",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pseudo",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "367c6f09-8371-3aee-a093-e9fe0433d57f",
                                        "entry_id": "19517b41-f6f3-303f-bfa6-d7cbfcd803f6",
                                        "glosses": [
                                            "Qui feint, qui fait semblant, qui prétend."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "44b820b6-32a3-4ac6-8e3a-0ccf0904d508",
                                                "sense_id": "367c6f09-8371-3aee-a093-e9fe0433d57f",
                                                "text": "Les chefs d’États …. Par leur apathie, ils contribuent au génocide ouïghour. Jusqu’à quand ces pseudo défenseurs des droits de la personne toléreront-ils l’intolérable ?"
                                            },
                                            {
                                                "example_id": "7a755a9f-e66d-481b-bbea-ec61747773f4",
                                                "sense_id": "367c6f09-8371-3aee-a093-e9fe0433d57f",
                                                "text": "Tous les sujets d’actualités y passèrent les uns après les autres : la nouvelle route du littoral, ainsi que les autres projets ruineux de la Région ou du Département ; la pseudo crise du tourisme due aux requins mangeurs de surfeurs…"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pseudo",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "178c3da0-39b7-3e77-a06a-1f9ab5ba3e10",
                                        "entry_id": "d0fffc7d-2193-3feb-bb52-1ca85ec5f4a6",
                                        "glosses": [
                                            "Pseudonyme, nom d’emprunt, en particulier sur internet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f6064d0-d6da-4c2f-9af2-c601b467aca5",
                                                "sense_id": "178c3da0-39b7-3e77-a06a-1f9ab5ba3e10",
                                                "text": "N’ayant jamais changé de pseudo, je commençais à être connue et je trouvais plaisant de me retrouver avec des gens que j’avais vus en chair et en os et avec d’autres qui ne me connaissaient que par mon pseudo."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
