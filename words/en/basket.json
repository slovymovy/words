                {
                    "sense_id": "ba70a8d3-c9eb-3b09-aeb2-c7a7b755d2b7",
                    "sense_definition": "The gondola or wicker container suspended from a balloon, in which the pilot and passengers travel.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tourists climbed into the wicker <w>basket</w> for their flight.",
                            "target_lang_translations": {
                                "ru": "Туристы забрались в плетеную <w>корзину</w> для полета.",
                                "zh": "游客们爬进柳条<w>吊篮</w>准备飞行。"
                            }
                        },
                        {
                            "text": "From the <w>basket</w>, we could see the entire city below us.",
                            "target_lang_translations": {
                                "ru": "Из <w>корзины</w> мы могли видеть весь город под нами.",
                                "zh": "从<w>吊篮</w>里，我们可以俯瞰脚下的整座城市。"
                            }
                        }
