                                        "sense_id": "608f13f3-5c83-3b50-afed-d9ec59013764",
                                        "entry_id": "e686aba2-29e1-3e58-8f17-7a5833f4e446",
                                        "glosses": [
                                            "Betrieb, der Schnittholz wie Balken, Bretter oder Latten mittels Gattersägen aus Baumstämmen herstellt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e63ffce0-2de3-4270-a1bd-dc17fda64a50",
                                                "sense_id": "608f13f3-5c83-3b50-afed-d9ec59013764",
                                                "text": "„Ein Großfeuer hat in einem Sägewerk bei Braunschweig einen Schaden in Millionenhöhe angerichtet. Rund 250 Feuerwehrleute waren 14 Stunden lang mit den Löscharbeiten in Broistedt beschäftigt.“"
                                            },
                                            {
                                                "example_id": "58061721-0bc3-4568-8167-eb1c254e5249",
                                                "sense_id": "608f13f3-5c83-3b50-afed-d9ec59013764",
                                                "text": "„Wir kommen an ein Sägewerk.“"
                                            },
                                            {
                                                "example_id": "f5dca1cc-f7af-4b7c-9b1c-b32a2169a1f9",
                                                "sense_id": "608f13f3-5c83-3b50-afed-d9ec59013764",
                                                "text": "„Im Sägewerk war er angestellt gewesen, und sie hatte mit dem Stück Land hinterm Haus etwas dazuverdient.“"
                                            },
                                            {
                                                "example_id": "8a8d92fe-eb8a-4be4-a94b-e9e5adce0518",
                                                "sense_id": "608f13f3-5c83-3b50-afed-d9ec59013764",
                                                "text": "„Als wir in der rue Notre-Dame-des-Champs in der obersten Etage eines Nebengebäudes auf dem Hof des Sägewerks wohnten, war die Closerie des Lilas das nächstgelegene gute Café, eines der nettesten Cafés in Paris.“"
                                            }
                                        ],
