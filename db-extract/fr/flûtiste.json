                                                "sense_id": "65a93aca-14cf-3810-aabd-4af3054d145a",
                                                "text": "„Jeden Samstagabend gab er, begleitet von zwei Flötisten, privat in kleinem Zirkel einige Chorstücke zum besten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
