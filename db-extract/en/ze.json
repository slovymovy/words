                        "sense_id": "3b5d1c65-170c-3e62-8ca0-89ef3e6a229c",
                        "entry_id": "c3444dbd-8ccf-374b-9411-acd941282e91",
                        "glosses": [
                            "Nonstandard spelling of the, usually signifying a foreign accent, often French or German."
                        ],
                        "tags": [
                            "alt-of",
