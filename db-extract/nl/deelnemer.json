                                "target_senses": [
                                    {
                                        "sense_id": "e3fd6520-4ed7-35eb-b199-3517a8281b5a",
                                        "entry_id": "ab8b85ba-d66a-3cdf-9585-37dca5cd1f4e",
                                        "glosses": [
                                            "Qui participe à quelque chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a8cab42-8184-4185-ae90-468d90939701",
                                                "sense_id": "e3fd6520-4ed7-35eb-b199-3517a8281b5a",
                                                "text": "Après la soirée moules-frites qui a rassemblé près de cent soixante-dix personnes, le foyer rural de Saint-Paul remercie les personnes participantes et s’excuse auprès de ceux qui n’ont pas pu être retenus."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "participant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cf264990-6f70-33b6-8d18-edc1de14a215",
                                        "entry_id": "cba7a36e-05b3-3281-969b-05ce24a650d1",
                                        "glosses": [
                                            "Celui qui participe à quelque chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f5595d90-ed2e-4772-ae53-c602b7569320",
                                                "sense_id": "cf264990-6f70-33b6-8d18-edc1de14a215",
                                                "text": "La reformulation d’une idée ou d’une opinion d’un participant permet une meilleure écoute, une meilleure compréhension et stimule les interactions."
                                            },
                                            {
                                                "example_id": "ea85a19c-be6f-4da1-9e2b-54bc932b967d",
                                                "sense_id": "cf264990-6f70-33b6-8d18-edc1de14a215",
                                                "text": "Les jeux érotiques commencent évidemment dès l'enfance, se poursuivent de plus belle entre adolescents ou jeunes adultes (ainsi le maraîchinage en Vendée) et tout cela tracasse beaucoup les confesseurs. En revanche, les participants s'y livrent « sans rougir »."
                                            }
                                        ]
                                    }
                                ]
                            }
