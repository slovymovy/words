                        "translation_id": "d215240a-92f2-40ac-9590-0d46edf1f142",
                        "source_entry_id": "6547894f-a735-339c-9531-849eb63757ef",
                        "source_sense_id": "76625760-f242-35b4-861d-2c4f5de47760",
