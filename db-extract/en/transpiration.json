    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "f000d8f9-0b1e-3432-adf6-cb37f15fcda9",
                "word": "transpiration",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "f1d8ecc8-83b5-47e3-b97d-a96c638d0c26",
                        "entry_id": "f000d8f9-0b1e-3432-adf6-cb37f15fcda9",
                        "tags": [
                            "plural"
                        ],
                        "form": "transpirations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d5f9df75-c677-3b6f-b1bd-6c84addc6d81",
                        "entry_id": "f000d8f9-0b1e-3432-adf6-cb37f15fcda9",
                        "glosses": [
                            "The loss of water by evaporation in terrestrial plants, especially through the stomata; accompanied by a corresponding uptake from the roots."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "5b2d1e8a-02f3-3bd9-93b4-6f2a695cf000",
                        "entry_id": "f000d8f9-0b1e-3432-adf6-cb37f15fcda9",
                        "glosses": [
                            "The process of giving off water vapour through the skin or mucous membranes."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "cce67282-7b52-38e7-b416-fffd1bf41dfb",
                        "entry_id": "f000d8f9-0b1e-3432-adf6-cb37f15fcda9",
                        "glosses": [
                            "The passage of gases through fine tubes."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "180d465b-6c05-4201-87af-4091da973ae2",
                        "source_entry_id": "f000d8f9-0b1e-3432-adf6-cb37f15fcda9",
                        "source_sense_description": "botany: the loss of water by evaporation in terrestrial plants",
                        "target_lang_word": "transpiration",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "transpiration",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6fd37f68-0d0e-377c-ac1f-eeeffa524826",
                                        "entry_id": "62fcaccb-c5f5-37bd-9761-a3fb54ae19c7",
                                        "glosses": [
                                            "Sueur ; exhalation humide à la surface de la peau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "26294ad3-09ac-4843-adc1-14c3f14ddde8",
                                                "sense_id": "6fd37f68-0d0e-377c-ac1f-eeeffa524826",
                                                "text": "— J’ai une transpiration froide qui me monte à la tête !… Ce doit être l’émotion !…"
                                            },
                                            {
                                                "example_id": "5c475cb0-6113-46e8-ab30-be87163d6624",
                                                "sense_id": "6fd37f68-0d0e-377c-ac1f-eeeffa524826",
                                                "text": "Il comprit que cette montée de transpiration était due à la peur qu’il avait eue de tomber, beaucoup plus qu’à l’effort."
                                            },
                                            {
                                                "example_id": "81fc38c1-7d5b-474c-8556-2c679f3978f6",
                                                "sense_id": "6fd37f68-0d0e-377c-ac1f-eeeffa524826",
                                                "text": "Quant à l'ambiance, elle est faite de visions terrifiantes, de hurlements de douleur, de dégueulis rosâtres, de vomissements d'injures, de transpirations gluantes, de gémissements épouvantables, de pourrissements vivants, de râles atroces, de décompositions lentes et de morts qui n'en finissent plus..."
                                            },
                                            {
                                                "example_id": "cd054cd6-6421-476d-b8fa-3f14af902fb1",
                                                "sense_id": "6fd37f68-0d0e-377c-ac1f-eeeffa524826",
                                                "text": "La promesse valait pour l'ensemble des chasseurs, dont la transpiration mêlée aux émanations alcoolisées d’après-rasage emboucanait l'atmosphère d'un suint pimenté."
                                            },
                                            {
                                                "example_id": "e1ba3551-6419-4dd4-9f9a-78ec7698b8db",
                                                "sense_id": "6fd37f68-0d0e-377c-ac1f-eeeffa524826",
                                                "text": "Il s'ensuit diverses sensations physiques (p. ex., rougissements, tremblements, transpiration) et une contre-performance des fonctions cognitives (p. ex., problèmes de concentration, trous de mémoire)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "de50d56c-76bd-31c7-b5c0-f7812a48c370",
                                        "entry_id": "62fcaccb-c5f5-37bd-9761-a3fb54ae19c7",
                                        "glosses": [
                                            "Perte d’eau sous forme de vapeur à la surface des organes végétaux, principalement par les stomates et plus rarement par la cuticule."
                                        ],
                                        "tags": [
                                            "Physiologie végétale",
                                            "Biologie végétale"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e8deb74f-989b-49c1-9bdd-61de6879c24d",
                                                "sense_id": "de50d56c-76bd-31c7-b5c0-f7812a48c370",
                                                "text": "Le plus étonnant est sans doute l’aisance avec laquelle saint Albert accepte les idées des anciens à propos de la transmutation des plantes. C’est ainsi qu’il considère le gui comme résultant de la transpiration de la sève de l’arbre qui le porte, […]."
                                            },
                                            {
                                                "example_id": "8a43f015-9ac1-4cd2-96fa-24e6a53d2382",
                                                "sense_id": "de50d56c-76bd-31c7-b5c0-f7812a48c370",
                                                "text": "Les mécanismes qui permettent aux plantes de résorber les embolies du xylème, durant la nuit notamment, lorsque la transpiration est très réduite, sont encore mal compris."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
