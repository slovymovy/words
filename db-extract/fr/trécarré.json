                ],
                "senses": [
                    {
                        "sense_id": "735d750f-f905-3a63-94ef-dc7f81bbf78c",
                        "entry_id": "c723266d-e60a-3dc5-b712-22036998e132",
                        "glosses": [
                            "Grande équerre en bois dont chaque côté mesure au moins un mètre."
                        ],
                        "tags": [
                            "Canada"
                        ],
                        "examples": [
                            {
                                "example_id": "6255a523-eae2-4841-9fe3-cb0f3efae684",
                                "sense_id": "735d750f-f905-3a63-94ef-dc7f81bbf78c",
                                "text": "Pour maintenir le trécarré, on fixe le tout avec un revêtement intermédiaire de carton fibre collé et cloué. Pare-air et fourrure sont ensuite installés. Si le mur est demandé non isolé, le tout est chargé sur une remorque et prêt à être livré."
                            }
                        ]
                    },
                    {
                        "sense_id": "775659f8-0434-310f-8030-50ed2d55869a",
                        "entry_id": "c723266d-e60a-3dc5-b712-22036998e132",
                        "glosses": [
                            "Parcelle de terrain carré déboisée ou à déboiser."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "ce98d984-b444-4f44-8de4-d12185403994",
                                "sense_id": "775659f8-0434-310f-8030-50ed2d55869a",
                                "text": "On se sert, aujourd’hui, d’arbres plaqués (blaised, en anglais) plus particulièrement pour tracer les lignes séparant les terres en bois debout et marquer le trécarré."
                            },
                            {
                                "example_id": "65830310-4d96-4c7a-aad7-4d37c9d7b7ce",
                                "sense_id": "775659f8-0434-310f-8030-50ed2d55869a",
                                "text": "Un trécarré est un carré de terre déboisé, puis abandonné à la forêt et aux vergnes, donc qui n’appartient plus à personne. Tout le monde y passe, tous les bûcherons s’y reposent, tous les chasseurs y font escale ou s’y camouflent."
                            }
                        ]
                    },
                    {
                        "sense_id": "0d03a63f-4f07-3b06-9e95-43585907f29e",
                        "entry_id": "c723266d-e60a-3dc5-b712-22036998e132",
                        "glosses": [
                            "Ligne de démarcation qui en croise une autre à angle droit, utilisée pour séparer des terrains."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "99e64fe7-a829-4bb1-acdc-761bce8e9978",
                                "sense_id": "0d03a63f-4f07-3b06-9e95-43585907f29e",
                                "text": "Le vocabulaire du rang associe également d’autres termes, dont la montée (route orienté dans le sens des terres et qui unit deux chemins de rang), le trécarré (ligne de démarcation des terres d’un rang double) et l’about (portion de terre ajoutée aux lots d’un rang après la concession initiale)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "020cb3be-02fc-4c53-9d4d-d5751921b737",
                        "source_entry_id": "c723266d-e60a-3dc5-b712-22036998e132",
