                        "glosses": [
                            "plaat of muzieknummer dat voor de eerste week in de hitparade staat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc970c99-30f9-459f-ab16-192c368341be",
                                "sense_id": "feb65189-3145-3f4f-99c8-6b210c78c3a4",
                                "text": "David Bowie is met het nummer ‘Starman’ de hoogste nieuwe binnenkomer van de Top 2000 dit jaar. Het nummer uit 1972 staat op plek 270. De dit jaar overleden Bowie staat met 26 nummers in de lijst, dat zijn er acht meer dan vorig jaar. Prince, in april overleden, staat met zeventien nummers in de lijst, zeven meer dan vorig jaar. De hoogste Nederlandse binnenkomer is ‘Sorry’ van Kensington op plaats 365. De Top 2000 begint vanaf Eerste Kerstdag."
                            }
                        ]
                    },
