                "senses": [
                    {
                        "sense_id": "86e2c794-f58e-369a-a091-00cf272c9cf2",
                        "entry_id": "e45a4032-003a-3969-be0c-4fa8463e37ad",
                        "glosses": [
                            "Person, die Fleisch unrechtmäßig umetikettiert oder mit einer nicht ausgewiesenen Fleischsorte streckt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a3f01dd5-d488-4447-83d6-96891ad7888c",
                                "sense_id": "86e2c794-f58e-369a-a091-00cf272c9cf2",
                                "text": "„Fleischfabriken in Bremen und Niedersachsen wurden von dem Cloppenburger Fleischfälscher beliefert“"
                            },
                            {
                                "example_id": "70cfcfb7-b5fa-45e7-a6aa-90319fe4765d",
                                "sense_id": "86e2c794-f58e-369a-a091-00cf272c9cf2",
                                "text": "„Die Suche nach dem Fleischfälscher geht weiter.“"
                            },
                            {
                                "example_id": "b06c1a67-b080-46fe-9236-c9d874068b1d",
                                "sense_id": "86e2c794-f58e-369a-a091-00cf272c9cf2",
                                "text": "„Vorsicht, die Fleischfälscher kommen“"
                            },
                            {
                                "example_id": "2d993a90-576d-49db-918a-ac57f119737f",
                                "sense_id": "86e2c794-f58e-369a-a091-00cf272c9cf2",
                                "text": "„Ausgehend von Großbritannien, wo die ersten falsch deklarierten Produkte bei Kontrollen im Handel entdeckt wurden, zieht sich die Spur der ‚Fleischfälscher‘ durch die gesamte EU.“"
                            },
                            {
                                "example_id": "6236efac-9e4f-46ab-ba8b-2b618b9ad8cd",
                                "sense_id": "86e2c794-f58e-369a-a091-00cf272c9cf2",
                                "text": "„Kritik äußerten dagegen die Grünen. ‚Die Lebensmittelkontrolle funktioniert so gut, dass ein seit 1987 bekannter Fleischfälscher unter den Augen der Staatsanwaltschaft beschlagnahmtes Fleisch weiter verticken kann‘, sagte Hans-Jürgen Klein, Landtagsabgeordneter der Grünen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
