                        "examples": [
                            {
                                "example_id": "abc957bf-a13c-420c-9fd1-57e50e6d7e5f",
                                "sense_id": "3820f764-02f3-307f-b662-718ce61e112a",
                                "text": "Cinema magnates preferred to bewhisker the handsome profile and contort the slender Barrymore frame to suit weird, melodramatic parts then in vogue."
                            },
