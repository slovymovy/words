                                    {
                                        "sense_id": "144da399-38bc-378a-9012-1bee57fc666e",
                                        "entry_id": "9d49095f-867e-37a5-8899-cc4bfadd1264",
                                        "glosses": [
                                            "A rumour, myth or superstition; something which is almost certainly untrue, despite acceptance by many."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7cda525d-7f4a-4845-8812-7e39cadc2412",
                                                "sense_id": "144da399-38bc-378a-9012-1bee57fc666e",
                                                "text": "According to the old wives' tales that are related about this race of genii who inhabit Iceland and its vicinity, they have a political form of government modelled after the same pattern as that which the inhabitants themselves are under."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
