                    },
                    {
                        "form_id": "6088f5ff-835b-49ae-b737-bc28db50db1e",
                        "entry_id": "9656f7dd-b11d-38bc-bc1d-5d8d80f0c401",
                        "tags": [
                            "participle",
                            "past"
                        ],
                        "form": "shimmied"
                    },
                    {
                        "form_id": "84498e7b-7eb3-45f6-bed9-e7503fbafcde",
                        "entry_id": "9656f7dd-b11d-38bc-bc1d-5d8d80f0c401",
                        "tags": [
                            "past"
                        ],
                        "form": "shimmied"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "236d3ec2-b063-38ec-89e2-82a942006766",
                        "entry_id": "9656f7dd-b11d-38bc-bc1d-5d8d80f0c401",
                        "glosses": [
                            "To perform a shimmy (dance movement involving thrusting the shoulders back and forth alternately)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b2a78ab-0cce-4a7e-b09e-f27f8f7e8aca",
                                "sense_id": "236d3ec2-b063-38ec-89e2-82a942006766",
                                "text": "She wondered would he think her awful, and try to get fresh if she shimmied. Fellows often did. But he was so cute. And a girl had to something about that, and if she didn't shimmy, she might do something worse."
                            }
                        ]
                    },
                    {
                        "sense_id": "ee277d54-57bb-3704-9d10-eca49a693b52",
                        "entry_id": "9656f7dd-b11d-38bc-bc1d-5d8d80f0c401",
                        "glosses": [
                            "To climb something (e.g. a pole) gradually (e.g. using alternately one's arms then one's legs)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc73ad30-5b8e-4139-8785-c9910f84104c",
                                "sense_id": "ee277d54-57bb-3704-9d10-eca49a693b52",
                                "text": "He shimmied up the flagpole."
                            },
                            {
                                "example_id": "a1c125f8-9ca3-43f4-94fb-271be7cb49e9",
                                "sense_id": "ee277d54-57bb-3704-9d10-eca49a693b52",
                                "text": "The static made her dress shimmy up her leg."
                            }
                        ]
                    },
                    {
                        "sense_id": "a8a53dd8-ab87-3133-a2f1-f681c8052b8a",
                        "entry_id": "9656f7dd-b11d-38bc-bc1d-5d8d80f0c401",
                        "glosses": [
                            "To vibrate abnormally, as a broken wheel."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "b9327b6d-59eb-4d65-99a0-fb15f5e843b2",
                                "sense_id": "a8a53dd8-ab87-3133-a2f1-f681c8052b8a",
                                "text": "They came in among earth-moving machines, a total absence of trees, the usual hieratic geometry, and eventually, shimmying for the sand roads, down in a helix to a sculptured body of water named Lake Inverarity."
                            }
                        ]
                    },
                    {
                        "sense_id": "f5020197-12c8-3f9f-a154-d6645d535472",
                        "entry_id": "9656f7dd-b11d-38bc-bc1d-5d8d80f0c401",
                        "glosses": [
                            "To shake the body as if dancing the shimmy."
                        ],
                        "tags": [
                            "intransitive",
                            "rare"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "0c006c81-b775-3bfa-b3cb-f0daa73cdf6d",
                        "entry_id": "9656f7dd-b11d-38bc-bc1d-5d8d80f0c401",
                        "glosses": [
                            "To move across a narrow ledge, either by hanging from it or by strafing on it along the wall."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "11406f89-abf3-4417-b84a-2c4cf6e8f333",
                                "sense_id": "0c006c81-b775-3bfa-b3cb-f0daa73cdf6d",
                                "text": "Jump up to the ledge on your right and shimmy around the corner."
                            },
                            {
                                "example_id": "7b4776e3-4186-416f-a8a7-9cf4e9c5c1c4",
                                "sense_id": "0c006c81-b775-3bfa-b3cb-f0daa73cdf6d",
                                "text": "Climb on top of the room and drop down to shimmy along its back ledge."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "424cc749-ebe9-4742-bd32-562c0a808d13",
                        "source_entry_id": "9656f7dd-b11d-38bc-bc1d-5d8d80f0c401",
                        "source_sense_description": "to climb something (e.g. a pole) gradually",
                        "target_lang_word": "grimper",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grimper",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0eee48cf-4e7b-353e-9836-bc8dbd636778",
                                        "entry_id": "0ca91e6d-23c6-39d1-b43b-8f567fdc3321",
                                        "glosses": [
                                            "Gravir, monter en s’agrippant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d6a5f141-4407-4b03-a113-96b5c5cd4488",
                                                "sense_id": "0eee48cf-4e7b-353e-9836-bc8dbd636778",
                                                "text": "Nous gagnons le haut de la ville et suivons d'abord la route de la Perdoma ; puis, obliquant à gauche, nous nous engageons dans un chemin grimpant la montagne entre une double haie d’agaves couvertes de liserons et de géraniums arborescents."
                                            },
                                            {
                                                "example_id": "ff5ab055-beed-466c-924a-f1f334079391",
                                                "sense_id": "0eee48cf-4e7b-353e-9836-bc8dbd636778",
                                                "text": "Le fossile d'une espèce disparue de kangourous a révélé d'étonnantes capacités à grimper aux arbres, il y a environ 50 000 ans dans une plaine d'Australie, aujourd'hui… dépourvue d'arbres, selon une étude parue mercredi."
                                            },
                                            {
                                                "example_id": "79e85139-d007-4826-9a41-6715d5ffc72f",
                                                "sense_id": "0eee48cf-4e7b-353e-9836-bc8dbd636778",
                                                "text": "Grimper au haut d’un arbre, à une muraille."
                                            },
                                            {
                                                "example_id": "d5fa7caf-039a-4b74-8023-7f32c51e33e4",
                                                "sense_id": "0eee48cf-4e7b-353e-9836-bc8dbd636778",
                                                "text": "Un chat qui grimpe à un arbre, le long d’un arbre."
                                            },
                                            {
                                                "example_id": "413a1f62-977d-48cf-a826-2a236aa12243",
                                                "sense_id": "0eee48cf-4e7b-353e-9836-bc8dbd636778",
                                                "text": "Les perroquets aiment à grimper."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f58a1c1d-b0aa-3c18-b572-504a423daaeb",
                                        "entry_id": "0ca91e6d-23c6-39d1-b43b-8f567fdc3321",
                                        "glosses": [
                                            "S’élever en s’accrochant aux corps voisins, en parlant de la tige d’une plante."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a5522ff-d249-4a95-be0b-3f21d36bad03",
                                                "sense_id": "f58a1c1d-b0aa-3c18-b572-504a423daaeb",
                                                "text": "Cette vigne a grimpé jusqu’au premier étage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "49f330bc-92ad-328c-b6fd-29c4a5bbc6fc",
                                        "entry_id": "0ca91e6d-23c6-39d1-b43b-8f567fdc3321",
                                        "glosses": [
                                            "Monter avec peine."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e582d81d-2aa6-4c19-986b-c02f837ba209",
                                                "sense_id": "49f330bc-92ad-328c-b6fd-29c4a5bbc6fc",
                                                "text": "[…]; des multitudes éperdues grimpèrent par d’effrayants sentiers jusqu’à ces régions si élevées que les arbres ne poussaient plus."
                                            },
                                            {
                                                "example_id": "d7430cf9-47ce-490d-8864-d2ededbbda2d",
                                                "sense_id": "49f330bc-92ad-328c-b6fd-29c4a5bbc6fc",
                                                "text": "Où, ô Hugo, cherchera-t-on ton nom ?\nJustice enfin faite que n’a-t-on ?\nQuand donc au corps qu’Académie on nomme\nGrimperas-tu, de roc en roc, rare homme ?"
                                            },
                                            {
                                                "example_id": "be8035b6-6c1c-4165-857a-1b68077c0728",
                                                "sense_id": "49f330bc-92ad-328c-b6fd-29c4a5bbc6fc",
                                                "text": "Moi je grimpe à ma chambre avec maman."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a5efeeb9-0bf6-3073-9808-ba693d6da8a6",
                                        "entry_id": "0ca91e6d-23c6-39d1-b43b-8f567fdc3321",
                                        "glosses": [
                                            "S’emballer, réagir vivement."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2724be27-1a0a-40b2-b7ac-7ab50e123530",
                                                "sense_id": "a5efeeb9-0bf6-3073-9808-ba693d6da8a6",
                                                "text": "– Tu vas trop loin, Thérèse, permets-moi de te le dire ; même en plaisantant et pour me faire grimper, tu ne dois pas toucher à la famille."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "grimper",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "32134523-c42f-3964-966d-9cfce6c95643",
                                        "entry_id": "24a52b3e-3c8f-37e0-b4bc-3d26be478f90",
                                        "glosses": [
                                            "Action consistant à grimper."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "65710fc5-46ef-40db-bcfd-3fe4d7fce7c3",
                                                "sense_id": "32134523-c42f-3964-966d-9cfce6c95643",
                                                "text": "L’extrémité du petit trochanter se trouve en dehors de l’axe mécanique du membre, et cela est d’autant plus marqué que ces animaux abductent fréquemment la hanche, particulièrement au cours du grimper."
                                            },
                                            {
                                                "example_id": "816dd82e-4177-4470-8e94-02190b5c0885",
                                                "sense_id": "32134523-c42f-3964-966d-9cfce6c95643",
                                                "text": "Vous êtes forts au grimper à la corde?... Il reste neuf secondes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
