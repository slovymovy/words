                        "glosses": [
                            "członek tybetańskiego ludu zamieszkującego Himalaje w Indiach i Nepalu"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2678bab6-6f7b-401a-a7b5-6459fa2f25df",
                                "sense_id": "7025da9b-24a7-31f2-8a47-dd70be8b9fd3",
                                "text": "Czytałem, że Szerpowie na swych poletkach uprawiają herbatę i cytrusy."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "56301649-e743-4668-b008-2995500b0baa",
                        "source_entry_id": "e76a8bd5-b50f-38b4-bae7-393eeadf95e6",
                        "source_sense_id": "7025da9b-24a7-31f2-8a47-dd70be8b9fd3",
