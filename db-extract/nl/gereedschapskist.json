                        "cross_references": [
                            {
                                "target_word": "toolkit",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a623d182-910b-361d-a3e9-a66d5cb07d43",
                                        "entry_id": "3951a089-048f-3739-9c88-e3f847285982",
                                        "glosses": [
                                            "A set of tools kept together, especially comprising all the tools suitable for some particular type of work."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "348328e8-b1eb-4f4f-b474-122cab372c1e",
                                                "sense_id": "a623d182-910b-361d-a3e9-a66d5cb07d43",
                                                "text": "The culture of Ice Age humanity expresses a steady growth in the complexity of the tool kit, and a steady growth in complexity of artistic development."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "986da674-beb4-3b6d-96f0-1e10eec736c2",
                                        "entry_id": "3951a089-048f-3739-9c88-e3f847285982",
                                        "glosses": [
                                            "A set of personal abilities, skills, or resources to draw on."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0c8628f0-4b25-41f3-a8de-f9276304c1f8",
                                                "sense_id": "986da674-beb4-3b6d-96f0-1e10eec736c2",
                                                "text": "My hope is that this book will familiarize readers with tools for analyzing historical and contemporary mechanisms of social differentiation, ethnoracial division, and symbolic structural inequality. My belief is that boundary theory offers the very best tool kit for this kind of work."
                                            },
                                            {
                                                "example_id": "fe25e0b8-02d1-46e5-a8c4-01842cd8b114",
                                                "sense_id": "986da674-beb4-3b6d-96f0-1e10eec736c2",
                                                "text": "Anthony Lambert's review of the Cycle-Rail toolkit was, to this non-cyclist, of interest - particularly the recognition of tourism support and opportunities."
                                            },
                                            {
                                                "example_id": "19f5bb01-ed66-4bc9-a745-03e8bfcad3df",
                                                "sense_id": "986da674-beb4-3b6d-96f0-1e10eec736c2",
                                                "text": "Prior to the Great Recession, active management of the long-bond portfolio was not a major feature of most central banks' toolkits, Japan being one notable exception."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7e02ed87-4c98-3b43-9846-854834803d49",
                                        "entry_id": "3951a089-048f-3739-9c88-e3f847285982",
                                        "glosses": [
                                            "A set of software tools or components."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d9d9d160-99df-493f-95e1-94764c6a9687",
                                                "sense_id": "7e02ed87-4c98-3b43-9846-854834803d49",
                                                "text": "Morgan Computing Co.'s Disk Toolkit is the perfect program for speed demons who want a more flexible way to wield DEBUG's power."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ec748cb1-d7e1-3377-83f3-6a39e8e4ccaf",
                                        "entry_id": "3951a089-048f-3739-9c88-e3f847285982",
                                        "glosses": [
                                            "A set of guidelines or instructions."
                                        ],
                                        "tags": [
                                            "India"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "459d3db6-a123-3d74-85f8-fa378234274b",
                                        "entry_id": "3951a089-048f-3739-9c88-e3f847285982",
