                "senses": [
                    {
                        "sense_id": "067e1755-84ef-3998-91a0-8c7a9e7f2d9f",
                        "entry_id": "89f40bad-fec8-3651-88c6-ee7bc7c7bc6f",
                        "glosses": [
                            "eine aus Zwiebel und Teig hergestellte Speise"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "309a8f0d-c399-4323-9f9b-6e80dcdb5b49",
                                "sense_id": "067e1755-84ef-3998-91a0-8c7a9e7f2d9f",
                                "text": "Beim „Fest des neuen Weines\" vom 13. bis 15. November in Cochem an der Mosel gibt es zum jungen Wein reichlich Zwiebelkuchen."
                            },
                            {
                                "example_id": "c5e2d65f-84da-4c94-bce0-faf0b7706020",
                                "sense_id": "067e1755-84ef-3998-91a0-8c7a9e7f2d9f",
                                "text": "Suchen Sie sich ein wackliges Holzstühlchen im Winzerhof, lassen Sie dampfenden Zwiebelkuchen bringen, einen Schoppen Federweißen."
                            },
                            {
                                "example_id": "0abc2f08-e555-4abc-ade6-521d3e5973dc",
                                "sense_id": "067e1755-84ef-3998-91a0-8c7a9e7f2d9f",
                                "text": "„Thomas schmeckte sein eigener Zwiebelkuchen auf einmal nicht mehr.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
