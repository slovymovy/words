                "senses": [
                    {
                        "sense_id": "08e73654-1f84-331e-8b3f-0f7386781585",
                        "entry_id": "a14d6af7-847e-3f5f-a309-b4dfa4568073",
                        "glosses": [
                            "thaw"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "02d7506a-159b-41ac-9247-76873d0b7e84",
                                "sense_id": "08e73654-1f84-331e-8b3f-0f7386781585",
                                "text": "В са́мую весе́ннюю ро́степель, когда́, по наро́дному выраже́нию, «лу́жа быка́ то́пит», из далёкого тётушкина име́ния прискака́л верхово́й с роковы́м изве́стием об опа́сной боле́зни де́душки.",
                                "translation": "At the height of the spring thaw, when, according to a popular expression, “a puddle can drown a bull,” a horseman came galloping from my aunt’s far-off estate with the fateful news of my grandfather’s dangerous illness.",
                                "english": "At the height of the spring thaw, when, according to a popular expression, “a puddle can drown a bull,” a horseman came galloping from my aunt’s far-off estate with the fateful news of my grandfather’s dangerous illness."
                            }
                        ]
                    }
