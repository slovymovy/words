                "senses": [
                    {
                        "sense_id": "44715852-ffea-30a7-b5a6-2246696a9279",
                        "entry_id": "9f566ab6-59b7-3cc5-af07-99d6d53fba07",
                        "glosses": [
                            "Abmessungen eines Lebewesens oder Gebildes (Körpers)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd497c18-1ca1-41be-b0d7-a13b5da18aa2",
                                "sense_id": "44715852-ffea-30a7-b5a6-2246696a9279",
                                "text": "Anthropometrie beschäftigt sich mit den Körpermaßen des Menschen."
                            },
                            {
                                "example_id": "793e8a4b-4bf9-44e4-ad5b-ad3fa9fb3d6e",
                                "sense_id": "44715852-ffea-30a7-b5a6-2246696a9279",
                                "text": "Die ausgestorbenen Saurier dieser Art wiesen erstaunliche Körpermaße auf."
                            },
                            {
                                "example_id": "1d036ebb-75a0-4ba3-aca8-40e12665ab98",
                                "sense_id": "44715852-ffea-30a7-b5a6-2246696a9279",
                                "text": "„Die Pflasterungen werden meistens nach Flächenmaß und nur ausnahmsweise nach Körpermaß berechnet, worüber die Preisliste das Nähere enthält.“ (1909)"
                            }
                        ],
