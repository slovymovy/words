                "senses": [
                    {
                        "sense_id": "d0e40a54-7f9c-388b-bc60-f2656ed95a63",
                        "entry_id": "0f99c571-d9ff-32ca-af1c-f00cf55e982a",
                        "glosses": [
                            "mehr oder minder wertloses Spielzeug, Kinderei, Kinderspiel, Kinderspielzeug, Leichtigkeit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5db9fac8-1904-452f-9040-4cefcbbf3136",
                                "sense_id": "d0e40a54-7f9c-388b-bc60-f2656ed95a63",
                                "text": "Was ihr eurem Kind für einen Kiki kauft."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "f059423e-e6bc-3eb8-9a38-1d9b42c97f89",
                        "entry_id": "0f99c571-d9ff-32ca-af1c-f00cf55e982a",
                        "glosses": [
                            "dummes Zeug, Belanglosigkeiten, Unfug, Unsinn, dumme Kindereien, dummes Gerede, Leichtigkeiten, Kinderspiel, Wertlosigkeiten, wertlose Zugaben, Zutaten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d60c5b7-7893-4ec6-b2d3-86d46099a8e1",
                                "sense_id": "f059423e-e6bc-3eb8-9a38-1d9b42c97f89",
                                "text": "Nachdem zwei Stunden vorüber waren, wurde nur noch Kiki erzählt."
                            },
                            {
                                "example_id": "a652d341-266b-4209-beaf-d0af9d716540",
                                "sense_id": "f059423e-e6bc-3eb8-9a38-1d9b42c97f89",
                                "text": "„Der Bankangestellte ist kühl und leise, ohne rote Striemen, ohne Schnappen, amerikanische Bank, hat alles schriftlich, kommt selbst auch gerade aus Amerika, mußte sich nach seiner Rückkehr erst mal wieder vertraut machen mit dem Kiki.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
