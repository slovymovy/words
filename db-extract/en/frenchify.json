                    },
                    {
                        "translation_id": "3c63ea65-cb8a-4a82-bfb1-a28c63fadbb7",
                        "source_entry_id": "7b5283ca-cce4-3046-9f14-a3204245387c",
                        "source_sense_description": "Translations",
                        "target_lang_word": "franzisieren",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "c9e78263-bdf2-4345-b789-4fc5c99175a7",
                        "source_entry_id": "7b5283ca-cce4-3046-9f14-a3204245387c",
                        "source_sense_description": "Translations",
                        "target_lang_word": "französisieren",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "französisieren",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "09170b05-952c-359d-8b33-30e9c54fdffb",
                                        "entry_id": "15089f2d-7d16-3093-acc1-58a7c9dc133e",
                                        "glosses": [
                                            "der französischen Sprache angleichen; dem französischen Geschmack anpassen; nach französischem Muster gestalten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec77bb28-e9c8-4447-9058-88542340af79",
                                                "sense_id": "09170b05-952c-359d-8b33-30e9c54fdffb",
                                                "text": "Der Hintergrund war, dass die normsetzenden Akademiker auch diesen Typ von ‚französisieren‘ wollten."
                                            },
                                            {
                                                "example_id": "e765adc2-f629-4e8a-915c-18138d8ca6d1",
                                                "sense_id": "09170b05-952c-359d-8b33-30e9c54fdffb",
                                                "text": "Das Ziel der sogenannten »Selektionskommissionen« (commissions du triage) lag darin, Feinde und potenzielle Verräter auszusondern, die nationale Zuverlässigkeit der Bevölkerung zu untersuchen und das Elsass zu französisieren."
                                            },
                                            {
                                                "example_id": "5a5bd832-a218-4eeb-8187-66c54a82fafa",
                                                "sense_id": "09170b05-952c-359d-8b33-30e9c54fdffb",
                                                "text": "Noch viel später, in den siebziger Jahren, wird sich Yvette über diese affektierten Elsässer mokieren, die ihren Familiennamen französisieren und ihre Wurzeln verleugnen."
                                            },
                                            {
                                                "example_id": "b570e787-2c2a-4f59-b3a4-bd5e7dd59ed5",
                                                "sense_id": "09170b05-952c-359d-8b33-30e9c54fdffb",
                                                "text": "Khoo ist so weit französisiert, dass sie ihren Salat als Fast Food à la française bezeichnet."
                                            },
                                            {
                                                "example_id": "6f175e03-aabf-476a-846b-d9f72fccd665",
                                                "sense_id": "09170b05-952c-359d-8b33-30e9c54fdffb",
                                                "text": "Zwei Jahre hat sie in Paris studiert; sie kommt aus einem Elternhaus, das sie als \"links, französisiert und bourgeois\" beschreibt."
                                            },
                                            {
                                                "example_id": "2b3f1d60-59ce-4ea1-9fe0-605e1c3f886e",
                                                "sense_id": "09170b05-952c-359d-8b33-30e9c54fdffb",
                                                "text": "Wir versuchen, englische Wörter möglichst englisch auszusprechen. Nicht so die Franzosen: Sie französisieren ausländlische Namen ohne mit der Wimper zu zucken."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b37d8941-9d78-42ac-8b5e-27ed79d108ca",
                        "source_entry_id": "7b5283ca-cce4-3046-9f14-a3204245387c",
                        "source_sense_description": "Translations",
                        "target_lang_word": "französieren",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "französieren",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d74985a6-b4ab-30de-80bb-64b068ba907e",
                                        "entry_id": "f0784aa9-af2c-33f3-93f2-c8b8ed84d6c9",
                                        "glosses": [
                                            "der französischen Sprache angleichen; dem französischen Geschmack anpassen; nach französischem Muster gestalten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a85df2c-366a-4329-a84c-d4bef6258da9",
                                                "sense_id": "d74985a6-b4ab-30de-80bb-64b068ba907e",
                                                "text": "Gleichzeitig bemühte er sich zusammen mit der neuen Verwaltung die Bevölkerung zu französieren, da sie als zu deutsch, zu protestantisch und zu republikanisch galt."
                                            },
                                            {
                                                "example_id": "9587c9da-d16d-4cf5-80ae-04506b76f30d",
                                                "sense_id": "d74985a6-b4ab-30de-80bb-64b068ba907e",
                                                "text": "Die Rechte warf ihm vor: „Er französierte, parisierte, vertraute pazifistischen Hoffnungen“, die Linke sah in ihm einen „konterrevolutionären Dichter“."
                                            },
                                            {
                                                "example_id": "465617b5-9f44-4612-b8b0-871ead9b7710",
                                                "sense_id": "d74985a6-b4ab-30de-80bb-64b068ba907e",
                                                "text": "Können diejenigen, die ohne Notwendigkeit die spanische Geschichte französieren wollen, noch als legitime Abkömmlinge dieser Geschichte gelten?"
                                            },
                                            {
                                                "example_id": "bc8a4d1a-c3be-4736-804b-0633db7d3f88",
                                                "sense_id": "d74985a6-b4ab-30de-80bb-64b068ba907e",
                                                "text": "Ehrhardt und Mahlmann sollen, wie ich höre, sehr französieren und bonapartisieren; …"
                                            },
                                            {
                                                "example_id": "5d885364-6dae-4940-92fb-e623a018be76",
                                                "sense_id": "d74985a6-b4ab-30de-80bb-64b068ba907e",
                                                "text": "Im Zeitalter der Klassik und der Aufklärung ging es den französischen Übersetzern in der Regel vor allem darum, den fremden Autor zu französieren', d.h. ihn dem strengen klassischen Stilideal und dem daran orientierten Publikumsgeschmack anzupassen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
