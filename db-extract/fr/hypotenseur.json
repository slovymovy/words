                "senses": [
                    {
                        "sense_id": "1c253cc6-0501-3dda-b528-23803477dfcf",
                        "entry_id": "f6470b43-7f72-3816-8a17-65a316004fcc",
                        "glosses": [
                            "Substance destinée à faire baisser la tension artérielle (ou pression artérielle)."
                        ],
                        "tags": [
                            "Pharmacie"
                        ],
                        "examples": [
                            {
                                "example_id": "5e23cbe9-f81a-4af7-9a4e-9f99b584a1a9",
                                "sense_id": "1c253cc6-0501-3dda-b528-23803477dfcf",
                                "text": "Fort heureusement j’ai eu l’intuition de remplacer l’hypotenseur par une teinture mère de Crataegus oxyantha (de l’aubépine) et, apparemment, cela produit un très bon résultat."
                            },
                            {
                                "example_id": "4e17cd61-b610-4734-9e5f-bd29695ad9bb",
                                "sense_id": "1c253cc6-0501-3dda-b528-23803477dfcf",
                                "text": "Le firibastat est un agent anti-hypertenseur et non un hypotenseur ce qui signifie qu’il peut agir sur une hypertension mais n’aura aucun effet sur une tension normale."
                            }
                        ]
                    }
                ],
