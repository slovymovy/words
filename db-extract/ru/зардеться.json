                        "glosses": [
                            "to start to blush, to start to redden (of a person or the dawn, etc.)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0bbb897b-a026-4fc2-a032-ce82ee142374",
                                "sense_id": "e6b7d809-60f5-3725-a30a-b57d5146e261",
                                "text": "Она́ поцелова́ла Са́шу в щёку, дала́ ему́ поцелова́ть ру́ку и ве́село засмея́лась, а он зарде́лся.",
                                "translation": "She kissed Sasha's cheek and gave him her hand to kiss, and again she laughed and he blushed.",
                                "english": "She kissed Sasha's cheek and gave him her hand to kiss, and again she laughed and he blushed."
                            }
                        ]
                    }
                ],
