                ],
                "senses": [
                    {
                        "sense_id": "8bd4af46-aec5-391b-b473-4035e6543b02",
                        "entry_id": "2012b3d4-8424-37d8-b909-2801f9786870",
                        "glosses": [
                            "Ort, an dem gespielt, Sport getrieben, Musik gemacht oder Theater aufgeführt wird; Räumlichkeit, die sich zum Spielen eignet und beispielsweise als Kinderspielplatz, Turnierstätte oder Theaterbühne genutzt werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef9d1124-929c-421b-81a3-5f3b9eb8ad13",
                                "sense_id": "8bd4af46-aec5-391b-b473-4035e6543b02",
                                "text": "„Die langen Wegstrecken zu einer geeigneten Spielstätte lassen die dem Augenblick erwachsende Spielfreude schwinden.“"
                            },
                            {
                                "example_id": "22facfe3-3848-4ea6-ae52-03302a38fe14",
                                "sense_id": "8bd4af46-aec5-391b-b473-4035e6543b02",
                                "text": "„Neben Homepages von Künstlern und Spielstätten sind im Internet auch zahlreiche, teils umfangreiche Informationsangebote rund um die Oper zu finden.“"
                            },
                            {
                                "example_id": "c9015765-f2dd-46cc-a991-1f1d33551c9b",
                                "sense_id": "8bd4af46-aec5-391b-b473-4035e6543b02",
                                "text": "„Was Frankfurt ausmacht, sind aber letztlich nicht die Orte und Spielstätten, die Geschäfte und Lokale, ja nicht einmal die jährliche Buchmesse […] – es sind die Menschen in ihrer für Frankfurt typischen und in der Republik einzigartigen Mischung aus Finanz, Wirtschaft, Wissenschaft und Kultur.“"
                            },
                            {
                                "example_id": "c657e3ea-1001-44eb-96a3-d3cd1b0e2cc5",
                                "sense_id": "8bd4af46-aec5-391b-b473-4035e6543b02",
                                "text": "„In Rotterdam gibt es Pläne, das geliebte Feijenoord-Stadion zu erhalten und eine neue Spielstätte daneben zu bauen.“"
                            },
                            {
                                "example_id": "5184fa20-d9d5-4435-8343-95720d5c3114",
                                "sense_id": "8bd4af46-aec5-391b-b473-4035e6543b02",
                                "text": "„Ein weiteres, wenn Kampnagel und Thalia Theater zusammen das Festival Theater der Welt organisieren, mit der Elbphilharmonie als einer Spielstätte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
