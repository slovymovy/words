                                    {
                                        "sense_id": "4c60b19f-1e4f-3685-97b5-84bef2589df6",
                                        "entry_id": "e1d30173-3b0d-331d-8f44-c3d2e7d3c0f1",
                                        "glosses": [
                                            "Sammlung von Lehrbüchern der altindischen Medizin, die aus der brahmanischen Epoche stammen"
                                        ],
                                        "tags": [
                                            "Hinduismus"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "20ae5ac8-f265-4293-b61e-1ed60ca7ba4d",
                                                "sense_id": "4c60b19f-1e4f-3685-97b5-84bef2589df6",
                                                "text": "„Upaveden: Nebenveden, zu denen auch die Schriften des Ayurveda gehören.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Ayurveda",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b717a61b-fbef-35ca-a795-60ecfd93e6ad",
                                        "entry_id": "1c8a2508-ba67-3c81-902d-354ff8ce3e95",
                                        "glosses": [
                                            "traditionelle indische Gesundheitslehre und Gesundheitspflege, die auf der Lehrbuchsammlung des Ayurveda beruht und darauf abzielt, ein Gleichgewicht zwischen Körper und Geist herzustellen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e1cd2ea-73f2-4a49-95c5-2942ee3f3ac2",
                                                "sense_id": "b717a61b-fbef-35ca-a795-60ecfd93e6ad",
                                                "text": "„Homöopathie, Akupunktur, Chiropraktik, Ayurveda oder Feng-Shui freuen sich über Zulauf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4586ccdc-b543-40ab-aee8-6d64bd212f70",
