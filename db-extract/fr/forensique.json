                "senses": [
                    {
                        "sense_id": "856afe50-c713-382d-9e2a-45336e875f37",
                        "entry_id": "dbe976d6-8b0d-371a-b939-f12dc37340b1",
                        "glosses": [
                            "Synonyme de science forensique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b958c528-a988-4fa2-8746-89565498436a",
                                "sense_id": "856afe50-c713-382d-9e2a-45336e875f37",
                                "text": "Si l’intervention d’experts au profit de la justice est bien antérieure, la forensique se constitue en tant que discipline à la fin du 19ème siècle et au début du siècle passé sur la base d’échanges entre individus aux fortes personnalités dans une période marquée par le progrès des sciences et des techniques."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cc77880f-b967-4c5b-a7bf-4266d219a720",
                        "source_entry_id": "dbe976d6-8b0d-371a-b939-f12dc37340b1",
                        "source_sense_id": "856afe50-c713-382d-9e2a-45336e875f37",
                        "target_lang_word": "Forensik",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Forensik",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ccea41f6-5f63-3282-9233-a8eddd6a20b5",
                                        "entry_id": "155d6c32-dc97-36ac-868f-56844329fd59",
                                        "glosses": [
                                            "Fachgebiet der Medizin, das sich mit gerichtsmedizinischen Fragen beschäftigt"
                                        ],
                                        "tags": [
                                            "special"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a0ae5380-b9f4-48f7-8786-88fe7b61a34c",
                                                "sense_id": "ccea41f6-5f63-3282-9233-a8eddd6a20b5",
                                                "text": "„Dabei wollen sie auch neue Scantechnik für die Anwendung in der Paläopathologie und Forensik testen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "df953af5-777e-3a6b-b4cb-0a120124232b",
                                        "entry_id": "155d6c32-dc97-36ac-868f-56844329fd59",
                                        "glosses": [
                                            "wissenschaftliche und technische Arbeitsgebiete, in denen kriminelle Handlungen systematisch untersucht werden"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1bd9773a-eb47-4ee9-baf9-a5a6e292c270",
                                                "sense_id": "df953af5-777e-3a6b-b4cb-0a120124232b",
                                                "text": "„Die Forensik ist aber eine noch relativ neue Disziplin der Informatik und erste anwendungs- und forschungsorientierte Studiengänge befinden sich noch in Entwicklung oder im Aufbau.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
