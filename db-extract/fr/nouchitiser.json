                "senses": [
                    {
                        "sense_id": "a7fa34c4-3968-3172-91e6-a0886d09439c",
                        "entry_id": "aea5cc4f-7d55-3971-a9ad-f1747dbe61da",
                        "glosses": [
                            "Transformer par l’adoption du nouchi."
                        ],
                        "tags": [
                            "Côte d’Ivoire"
                        ],
                        "examples": [
                            {
                                "example_id": "6d265d69-abe8-4407-be26-647b0c8aa1b5",
                                "sense_id": "a7fa34c4-3968-3172-91e6-a0886d09439c",
                                "text": "Toi là, 2 mois tu es parti au pays là, déjà tu t'es tropicalisé, ivoirisé, abidjanisé, nouchitisé."
                            },
                            {
                                "example_id": "32658d66-2108-4fae-91db-360304520939",
                                "sense_id": "a7fa34c4-3968-3172-91e6-a0886d09439c",
                                "text": "On appréciera pourtant le fait qu'il ait toiletté son mode d'expression télégraphique et « nouchitisé » à tout va et qu'il s'essaie à l'argumentation et à l’invective de salon, largement plus tolérable (ce que je fais ici par exemple), après avoir été expulsé d'autres sites qui n'ont pas à s'en vouloir de l'avoir fait !!"
                            },
                            {
                                "example_id": "2428fe48-cc4b-4b38-ad56-b80bfc918414",
                                "sense_id": "a7fa34c4-3968-3172-91e6-a0886d09439c",
                                "text": "Version nouchitisée !"
                            }
                        ]
                    }
