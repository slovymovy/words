    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6a625721-d451-3fb8-be23-7a388eb6dffd",
                    "sense_definition": "Personen oder Gruppen dazu bringen, sich aktiv für ein Ziel einzusetzen",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "aktivierung_menschen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die Opposition will mit einer Kampagne unentschlossene Wähler <w>mobilisieren</w>."
                        },
                        {
                            "text": "Die Umweltschützer <w>mobilisierten</w> Tausende Bürger für eine friedliche Demonstration."
                        }
                    ],
                    "synonyms": [
                        "aktivieren"
                    ],
                    "common_phrases": [
                        "Wähler mobilisieren",
                        "zum Protest mobilisieren"
                    ]
                },
                {
                    "sense_id": "0ad6319c-6d4f-380a-a591-4b2f510b52f5",
                    "sense_definition": "innere Kräfte oder Energiereserven freisetzen und gezielt einsetzen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "kraefte_nutzen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Im Finale musste der erschöpfte Läufer noch einmal alle Kräfte <w>mobilisieren</w>."
                        },
                        {
                            "text": "In stressigen Phasen <w>mobilisiert</w> der menschliche Körper zusätzliche Energiereserven."
                        }
                    ],
                    "synonyms": [
                        "aktivieren"
                    ],
                    "common_phrases": [
                        "Kräfte mobilisieren",
                        "Reserven mobilisieren"
                    ]
                },
                {
                    "sense_id": "c18b7981-3852-3bdb-8050-295d4f044583",
                    "sense_definition": "Streitkräfte oder Truppen in Kriegsbereitschaft versetzen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "militaer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die Regierung beschloss wegen der drohenden Gefahr, die Armee zu <w>mobilisieren</w>."
                        },
                        {
                            "text": "Nach Ausbruch des Konflikts wurden innerhalb weniger Tage hunderttausend Soldaten <w>mobilisiert</w>."
                        }
                    ],
                    "synonyms": [
                        "mobilmachen"
                    ],
                    "antonyms": [
                        "demobilisieren"
                    ],
                    "common_phrases": [
                        "Truppen mobilisieren",
                        "eine Armee mobilisieren"
                    ]
                },
                {
                    "sense_id": "b6181a09-09f0-31f8-9f00-94b3fe2ea3e3",
                    "sense_definition": "den Körper, Muskeln oder Gelenke beweglich machen",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "koerper_bewegung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die Physiotherapeutin half dem Patienten nach der Operation, das Knie zu <w>mobilisieren</w>."
                        },
                        {
                            "text": "Vor dem intensiven Krafttraining sollte man die Wirbelsäule gründlich <w>mobilisieren</w>."
                        }
                    ],
                    "synonyms": [
                        "aktivieren"
                    ],
                    "common_phrases": [
                        "Gelenke mobilisieren",
                        "Patienten mobilisieren"
                    ]
                },
                {
                    "sense_id": "c07e11ec-8b08-3073-ad4e-90843732601c",
                    "sense_definition": "Geldmittel oder finanzielle Ressourcen für ein Vorhaben beschaffen und verfügbar machen",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "finanzen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die Stiftung versucht, private Gelder für den Bau von Schulen zu <w>mobilisieren</w>."
                        },
                        {
                            "text": "Für die Bewältigung der Hochwasserschäden wurden rasch finanzielle Hilfen <w>mobilisiert</w>."
                        }
                    ],
                    "common_phrases": [
                        "Gelder mobilisieren",
                        "Kapital mobilisieren"
                    ]
                }
            ]
        }
    ]
