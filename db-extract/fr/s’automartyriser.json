                "senses": [
                    {
                        "sense_id": "bcc05315-ffc7-347e-a9a7-8925914789a8",
                        "entry_id": "6d39f1d9-d491-3eec-9485-c3299d6712e0",
                        "glosses": [
                            "Se martyriser soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c06850dc-b726-4af4-818c-bd32b3559e10",
                                "sense_id": "bcc05315-ffc7-347e-a9a7-8925914789a8",
                                "text": "Encore une fois nos élus, de gauche ou de droite, font en sorte de s'automartyriser pour s'attribuer la sainte vérité."
                            },
                            {
                                "example_id": "cfd4c1c2-ffd2-440f-860a-6a8111752dbd",
                                "sense_id": "bcc05315-ffc7-347e-a9a7-8925914789a8",
                                "text": "Et oui....il m'arrive de m'automartyriser...."
                            },
                            {
                                "example_id": "1138e2fd-7fc2-4b48-aca3-0bd31c13f78a",
                                "sense_id": "bcc05315-ffc7-347e-a9a7-8925914789a8",
                                "text": "Les premiers chrétiens ont été suppliciés par les pouvoirs politiques en place (contrairement aux pseudo-martyrs des attentats-suicides qui s'automartyrisent au milieu des marchés)."
                            }
                        ]
                    }
