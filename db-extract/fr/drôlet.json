                        "examples": [
                            {
                                "example_id": "8ef8c8f1-0ce7-4a82-a678-3d18db7bb5c6",
                                "sense_id": "8a6a3ea6-fc58-38de-ba3c-b4c35ad5a7b7",
                                "text": "Et il me prit le menton, disant avec un léger claquement de langue : Hé mais !... elle est drôlette, cette petite, elle est ma foi, très drôlette..."
                            },
                            {
                                "example_id": "15e68ffe-d635-4a53-824b-d54d707e0df0",
                                "sense_id": "8a6a3ea6-fc58-38de-ba3c-b4c35ad5a7b7",
                                "text": "Durant que je pleurais à fendre l’âme de qui m’eût entendu pleurer, je vis entrer dans ma chambre Rose, la petite Rose, comme nous l’appelions, et qui travaillait à la lingerie de l’établissement. Elle était drôlette, et toujours en train de rire…"
                            }
                        ]
                    }
