                                        "entry_id": "e6b85df4-2ce4-36c0-b6a7-63895fd415e8",
                                        "glosses": [
                                            "For what reason; why."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd42fb5e-8b27-4f68-8472-1ab8843c2a4f",
                                                "sense_id": "19395381-dff7-36e3-8d35-1deb6dea50fb",
                                                "text": "He wants four copies of it? What for?"
                                            },
                                            {
                                                "example_id": "cf6dfc37-90cd-4879-8f62-7341234d80fe",
                                                "sense_id": "19395381-dff7-36e3-8d35-1deb6dea50fb",
                                                "text": "Ow! What did you do that for?"
                                            },
                                            {
                                                "example_id": "7ee1cfd7-d3bc-43b9-8397-94b183e9a022",
                                                "sense_id": "19395381-dff7-36e3-8d35-1deb6dea50fb",
                                                "text": "What do you want to know for?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "what for",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "261a8c36-554f-3202-9d50-50c442d2644e",
                                        "entry_id": "6cfb05ff-40da-3646-beba-a6b089ee00b0",
                                        "glosses": [
                                            "An unspecified punishment or rebuke."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "idiomatic",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "60506268-c2fb-42c6-969c-379ce713662d",
                                                "sense_id": "261a8c36-554f-3202-9d50-50c442d2644e",
                                                "text": "When your dad gets home, he'll give you (a) what for."
                                            },
                                            {
                                                "example_id": "81a99087-b244-4df2-83ea-364072878c00",
                                                "sense_id": "261a8c36-554f-3202-9d50-50c442d2644e",
                                                "text": "- Fagin, I'm waiting.\n- Waiting, my dear? What for?\n- Bill will give you \"what for\" if you don't fork out."
                                            },
                                            {
                                                "example_id": "9a292f53-8605-494f-a546-c1a16e860688",
                                                "sense_id": "261a8c36-554f-3202-9d50-50c442d2644e",
                                                "text": "Cranky Kong: 'NOW GET OUT THERE AND GIVE THOSE LITTLE DRUM GUYS WHAT FOR. YES, I SAID \"WHAT FOR.\" I'M OLD. GET OVER IT.'"
                                            }
                                        ]
                                    }
                                ]
                            }
