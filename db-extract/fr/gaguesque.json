                        "entry_id": "4e247928-4c0b-34d2-9227-9076945d915d",
                        "glosses": [
                            "Drôle, comique, blagueur, qui relève du gag."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d1d5084-b946-4e52-8fcd-d1df6d0e5cfb",
                                "sense_id": "e047f4e0-9312-30b3-94d1-a7d1f66c556a",
                                "text": "La chanson Les Cairotes sont cuites est une espèce de création gaguesque et collective."
                            },
                            {
                                "example_id": "41f53ef6-98b7-4df4-a29e-668f3f716179",
                                "sense_id": "e047f4e0-9312-30b3-94d1-a7d1f66c556a",
                                "text": "Derrière l’aspect gaguesque de l’entreprise se révèle une formidable appréhension de la nature humaine."
                            },
                            {
                                "example_id": "80fb83a6-6ebd-4b00-9eb5-edecacf83e2d",
                                "sense_id": "e047f4e0-9312-30b3-94d1-a7d1f66c556a",
                                "text": "La fameuse vidéo de Penelope Fillon interviewée par le « Sunday Telegraph », dans laquelle l’imprudente confirmait, en mai 2007, sa condition de femme au foyer, recelait d’autres confessions gaguesques."
                            }
                        ]
