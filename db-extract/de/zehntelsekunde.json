                "senses": [
                    {
                        "sense_id": "2eac7575-bce1-326f-8b30-00d3439810e9",
                        "entry_id": "df2e97ac-868f-334c-a83d-7b113e65ca52",
                        "glosses": [
                            "zehnter Teil/ein Zehntel einer Sekunde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2120d120-ee6e-400e-9c4b-1bcebe1262ee",
                                "sense_id": "2eac7575-bce1-326f-8b30-00d3439810e9",
                                "text": "„In Tiflis (UdSSR) verbessert die sowjetische Läuferin Irina Press den Weltrekord über 80 m Hürden um eine Zehntelsekunde auf 10,3 sec.“"
                            },
                            {
                                "example_id": "4fdd2e77-cbb9-4643-9f68-73645949a35f",
                                "sense_id": "2eac7575-bce1-326f-8b30-00d3439810e9",
                                "text": "„Nach Ablauf dieser Zehntelsekunde befände sich der Sprengsatz nämlich direkt unter dem hinteren Drittel des Wagens, also dort, wo Winston Churchill mit Sicherheit saß und an seiner Zigarre zog.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
