                },
                {
                    "sense_id": "c92e078d-0383-32e3-a633-694a2a176faa",
                    "sense_definition": "Of a pregnant woman, to reach the stage where the movements of the fetus are first felt; of a fetus, to begin to move.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "pregnancy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She was nearly four months pregnant when she felt the child <w>quicken</w> for the first time.",
                            "target_lang_translations": {
                                "ru": "Она была почти на четвертом месяце беременности, когда впервые почувствовала, как ребенок <w>зашевелился</w>."
                            }
                        },
                        {
                            "text": "In historical novels, the moment a baby would <w>quicken</w> was often a significant plot point.",
                            "target_lang_translations": {
                                "ru": "В исторических романах момент, когда ребенок <w>начинал шевелиться</w>, часто был важным сюжетным поворотом."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "О беременной женщине: достичь стадии, когда впервые ощущаются движения плода; о плоде: начать двигаться."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зашевелиться",
                                "target_lang_sense_clarification": "о первом движении плода"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d873cf90-83ce-38f2-9b7a-e5edc5419836",
                    "sense_definition": "To apply quicksilver (mercury) to a surface, such as a mirror.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "technical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The craftsman used a traditional method to <w>quicken</w> the glass and create a reflective surface.",
                            "target_lang_translations": {
                                "ru": "Мастер использовал традиционный метод, чтобы <w>покрыть ртутью</w> стекло и создать зеркальную поверхность."
                            }
                        },
                        {
                            "text": "It is dangerous to <w>quicken</w> materials with mercury without proper ventilation and safety gear.",
                            "target_lang_translations": {
                                "ru": "Опасно <w>амальгамировать</w> материалы ртутью без надлежащей вентиляции и защитного снаряжения."
                            }
                        }
                    ],
                    "synonyms": [
                        "quicksilver"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "refers to an older industrial process"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Наносить ртуть (амальгаму) на поверхность, например, на зеркало."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "амальгамировать",
                                "target_lang_sense_clarification": "покрывать ртутью"
                            }
                        ]
                    }
                }
            ]
        },
        {
