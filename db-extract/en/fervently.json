                        "entry_id": "3f8ec878-c757-3e87-adb6-fd89a51bf7d0",
                        "glosses": [
                            "In a fervent manner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99e2133e-5903-441b-ac18-cdccdac58b35",
                                "sense_id": "b8e6ad7e-9049-3d38-9858-0ea4b7d60c25",
                                "text": "The Besht preached that the simple man, imbued with native faith and able to pray fervently and wholeheartedly with a sense of joy in his heart, was nearer and dearer to God than the learned but joyless formalist spending his whole life in the study of Talmud."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "277f4b66-36ff-48c4-8c35-3a6ff8898845",
                        "source_entry_id": "3f8ec878-c757-3e87-adb6-fd89a51bf7d0",
                        "source_sense_id": "b8e6ad7e-9049-3d38-9858-0ea4b7d60c25",
                        "source_sense_description": "in a fervent manner",
                        "target_lang_word": "fervemment",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fervemment",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5d0a1c71-5c02-3427-9a19-2dfcb23a0772",
                                        "entry_id": "3bcc2bcf-9baa-3c4e-861f-7d35e2ddeed4",
                                        "glosses": [
                                            "Avec ferveur."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "54dcb512-df1a-4942-8a4e-832fa22a0248",
                                                "sense_id": "5d0a1c71-5c02-3427-9a19-2dfcb23a0772",
                                                "text": "L’aspect de cette tête blanchie, abîmée dans une pose pleine de piété, ramena Godefroid à ses devoirs oubliés, il se mit à prier fervemment."
                                            },
                                            {
                                                "example_id": "0efb9d3a-a9fa-4494-918c-35d36bba9902",
                                                "sense_id": "5d0a1c71-5c02-3427-9a19-2dfcb23a0772",
                                                "text": "Sa mémoire est demeurée vivante et fervemment honorée parmi nous."
                                            },
                                            {
                                                "example_id": "401e0537-0f18-42c7-bd12-bf47af926da5",
                                                "sense_id": "5d0a1c71-5c02-3427-9a19-2dfcb23a0772",
                                                "text": "Mais, en lui-même, il priait fervemment le Seigneur de lui éviter toute rencontre ultérieure avec des mounes comme ça, qui, la nuit venue, sortent de leur peau comme d’un vêtement, l’accrochent à un clou et, mués en chauves-souris ou en insectes, s’envolent vers des occupations malfaisantes"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
