                            }
                        ]
                    },
                    {
                        "translation_id": "bd709ec0-3a8c-46ba-82e6-0e7c182d20f2",
                        "source_entry_id": "b6d3b820-98e8-37f7-9198-36be2467b0be",
                        "source_sense_id": "9482ef2c-2e0a-3cd6-b414-ded3d75352de",
                        "source_sense_description": "a person who makes or repairs timekeeping devices",
                        "target_lang_word": "horlogère",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "horlogère",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a5686c33-4268-3a71-b596-4a4879d8b15e",
                                        "entry_id": "d53aca33-0129-3ad2-b774-a577602d371e",
                                        "glosses": [
                                            "Celle qui crée, vend et répare les horloges, les pendules et les montres."
                                        ],
                                        "tags": [
                                            "Horlogerie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "671624da-a9a0-4a0e-bf37-018eb6825aea",
                                                "sense_id": "a5686c33-4268-3a71-b596-4a4879d8b15e",
                                                "text": "Puis il fait parler l’horlogère en fureur, avec les mesmes paroles que Virgile donne à Didon parlant à Enée."
                                            },
                                            {
                                                "example_id": "04986fda-8cad-44f3-b04c-653394be5589",
                                                "sense_id": "a5686c33-4268-3a71-b596-4a4879d8b15e",
                                                "text": "Il travaillait avec ses deux vieilles filles de sœurs, horlogères d'ailleurs accomplies, qui vivaient la loupe à l'orbite et ne sortaient que le samedi pour venir impasse Vandamme et passer la soirée dans les joies saugrenues d'une « banque » dont l'enjeu était de haricots blancs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "33b53331-804e-3ef2-93e4-abe60b78fb7d",
                                        "entry_id": "d53aca33-0129-3ad2-b774-a577602d371e",
                                        "glosses": [
                                            "Épouse d’un horloger."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4618aba4-98d7-484a-be48-e20c25263558",
                                                "sense_id": "33b53331-804e-3ef2-93e4-abe60b78fb7d",
                                                "text": "L’horlogère met encore son corsage d’il y a deux ans."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "horlogère",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e725b9bd-6f64-3a63-8ff8-ff8128d583e7",
                                        "entry_id": "2cd56126-74e5-361f-94e1-eeaa57eacd89",
                                        "glosses": [
                                            "Féminin singulier de horloger."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "15b8f8e9-9764-4d39-832e-0341a9401350",
                                                "sense_id": "e725b9bd-6f64-3a63-8ff8-ff8128d583e7",
                                                "text": "Un ouvrage de référence, faisant état de l’ensemble des connaissances actuelles de la discipline, s’imposait : ce Traité de construction horlogère, sans équivalent et rédigé par des spécialistes de l’enseignement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "877114b5-bf80-4dce-9923-445a1a398ce4",
                        "source_entry_id": "b6d3b820-98e8-37f7-9198-36be2467b0be",
                        "source_sense_id": "9482ef2c-2e0a-3cd6-b414-ded3d75352de",
                        "source_sense_description": "a person who makes or repairs timekeeping devices",
                        "target_lang_word": "Uhrmacher",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Uhrmacher",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "04a74f1a-acac-3b9c-a68c-f276e5d81e40",
                                        "entry_id": "a4f1c8c1-8838-3cec-a367-4d27557a0c45",
                                        "glosses": [
                                            "Handwerker, der sich mit der Herstellung, der Reparatur und/oder dem Verkauf von Uhren oder Uhrwerken beschäftigt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "73b7ea7e-e177-4784-9330-2a4b397ceee5",
                                                "sense_id": "04a74f1a-acac-3b9c-a68c-f276e5d81e40",
                                                "text": "Noch heute brachte er die kaputte Uhr zum Uhrmacher."
                                            },
                                            {
                                                "example_id": "3564b807-e1e7-4ec7-b532-86dc0342a5d7",
                                                "sense_id": "04a74f1a-acac-3b9c-a68c-f276e5d81e40",
                                                "text": "„Die Uhrmacher gaben Sie alle ratlos mir zurück; Sie wollten mit solchem Teufelsstück Gar nichts zu tun zu haben.“"
                                            },
                                            {
                                                "example_id": "be5fa564-79bb-43b9-81ab-3c03de11ef40",
                                                "sense_id": "04a74f1a-acac-3b9c-a68c-f276e5d81e40",
                                                "text": "„Meist genügt es, die Uhr zum Uhrmacher seines Vertrauens zu bringen, um sie dort entmagnetisieren zu lassen.“"
                                            },
                                            {
                                                "example_id": "c48b22aa-ef81-44ab-b44b-40d2f8ee6782",
                                                "sense_id": "04a74f1a-acac-3b9c-a68c-f276e5d81e40",
                                                "text": "„Im frühen achtzehnten Jahrhundert gab es (abgesehen von dem Autodidakten John Harrison selbst), soweit wir wissen, keinen einzigen Uhrmacher im nördlichen Lincolnshire.“"
                                            },
                                            {
                                                "example_id": "b3e2b274-addd-41f1-bef4-81f0ce0363df",
                                                "sense_id": "04a74f1a-acac-3b9c-a68c-f276e5d81e40",
                                                "text": "„Sein Vater war ein Uhrmacher, der sich geschickt in das Leben der alten Garnisonsstadt einordnete.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
