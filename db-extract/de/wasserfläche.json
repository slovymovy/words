                    }
                ],
                "senses": [
                    {
                        "sense_id": "98bdb2f3-2090-3e78-a5fc-51b7b43fa542",
                        "entry_id": "95fe9b86-9f91-3a1f-99dd-f0d4d4c3fc52",
                        "glosses": [
                            "von Wasser eingenommene Fläche"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10f4cf22-fb45-47f9-ac84-e85442f8b518",
                                "sense_id": "98bdb2f3-2090-3e78-a5fc-51b7b43fa542",
                                "text": "„Auf der dunklen Wasserfläche zuckten Forellen, die dort ausgesetzt worden waren.“"
                            },
                            {
                                "example_id": "0907fa89-ddac-4e5d-b1cb-d3b9c2443f31",
                                "sense_id": "98bdb2f3-2090-3e78-a5fc-51b7b43fa542",
                                "text": "„Der Schrei hob sich vom Schlauchboot ab, über die See hin und blieb ringsum auf der Wasserfläche kleben.“"
                            },
                            {
                                "example_id": "cc48a90d-6a58-430d-ada8-1b67b498f19f",
                                "sense_id": "98bdb2f3-2090-3e78-a5fc-51b7b43fa542",
                                "text": "„Der Rainbow-Teich ist eine kleine, offene Wasserfläche – nicht mehr als etwa fünfundvierzig bis fünfzig Morgen messend.“"
                            },
                            {
                                "example_id": "9b77214d-0ad8-49a1-ae11-e308ef95eaf6",
                                "sense_id": "98bdb2f3-2090-3e78-a5fc-51b7b43fa542",
                                "text": "„Rustschuk wird geprägt von der weiten Wasserfläche der Donau und den Uferhügeln, die in der Stadt die Straßen ansteigen lassen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
