                ],
                "senses": [
                    {
                        "sense_id": "aca0003f-b047-3bfc-91ab-185809c5149b",
                        "entry_id": "b1e289a1-84f7-324b-8945-9f90c041246a",
                        "glosses": [
                            "sehr effizient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a78c4d6-3358-48b0-9163-1d90ee9a0a94",
                                "sense_id": "aca0003f-b047-3bfc-91ab-185809c5149b",
                                "text": "„Er entwirft hocheffiziente Funktionsbauten, bei denen der Stil nebensächlich ist: Krankenhäuser, Schulen, Gefängnisse, Leichenhallen, Tierkliniken.“"
                            },
                            {
                                "example_id": "9f304f35-4f02-4c5a-bb4f-fc66aa1eab63",
                                "sense_id": "aca0003f-b047-3bfc-91ab-185809c5149b",
                                "text": "„Sie besaßen komplexe, hocheffiziente Systeme, sowohl in der Politik als auch im Handel, doch es war ihnen bewusst, dass sie auch Fehler machten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
