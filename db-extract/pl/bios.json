                                            {
                                                "example_id": "71a7c6a4-317f-4bef-a0a3-8523a80c472b",
                                                "sense_id": "38a3e2b9-562c-3fd2-b115-351510d0ff93",
                                                "text": "Toshiba manufactures the chip set and the 8- to 10-MHz bus; the BIOS, shadowable in both system and video modes, is licensed from Award."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c24702f0-a2e4-3def-84d7-327df5c9da38",
                                        "entry_id": "1f1a66f2-66d7-39f3-b763-2e406d36606e",
                                        "glosses": [
                                            "any firmware user interface that provides similar functionality as BIOS, such as UEFI."
                                        ],
