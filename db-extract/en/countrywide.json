                            {
                                "example_id": "c97c7ba1-e9c4-4a72-a4a6-ff496c6a3ade",
                                "sense_id": "1a44cd84-42a0-3bc5-a803-4a278c65691d",
                                "text": "…America, with such vital power, with a people ambitious, wealthy, great and of a noble past, has a task before it, into which it will enter with a will, since the need is felt countrywide."
                            },
                            {
                                "example_id": "dd416010-8494-45df-aa41-029be07be51f",
                                "sense_id": "1a44cd84-42a0-3bc5-a803-4a278c65691d",
                                "text": "On such a day the streets of Peking and other cities could be peaceful, as if order had been restored countrywide."
                            },
                            {
                                "example_id": "94e4299b-e859-4c5b-a5cd-ec129a9218c2",
                                "sense_id": "1a44cd84-42a0-3bc5-a803-4a278c65691d",
                                "text": "The operation lifted Mujahidin pride and morale countrywide."
                            }
                        ]
                    }
                ],
