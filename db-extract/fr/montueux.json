        "fr-extract.jsonl": [
            {
                "entry_id": "bfe8c4f7-3b3a-382f-a7be-64a1bc6c4256",
                "word": "montueux",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "2740e32a-a56c-41b3-9ffd-640dd85cbccd",
                        "entry_id": "bfe8c4f7-3b3a-382f-a7be-64a1bc6c4256",
                        "tags": [
                            "singular",
                            "feminine"
                        ],
                        "form": "montueuse"
                    },
                    {
                        "form_id": "7726fe97-4e38-462b-a340-a090e0a92919",
                        "entry_id": "bfe8c4f7-3b3a-382f-a7be-64a1bc6c4256",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "montueuses"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d26a8fdb-8f42-344c-b10f-2c838b203c5f",
                        "entry_id": "bfe8c4f7-3b3a-382f-a7be-64a1bc6c4256",
                        "glosses": [
                            "Qui comporte des montagnes, des collines."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ac081a7-5a53-4ff9-a832-6f5b8b640372",
                                "sense_id": "d26a8fdb-8f42-344c-b10f-2c838b203c5f",
                                "text": "La région était montueuse, avec des bois de sapins et des plateaux dénudés. Des fermes nombreuses parsemaient les pentes ; les collines étaient profondément tranchées par des gorges."
                            },
                            {
                                "example_id": "6d4ada2b-56c5-4612-be07-ecbde90de472",
                                "sense_id": "d26a8fdb-8f42-344c-b10f-2c838b203c5f",
                                "text": "J’avais emporté quelques provisions pour déjeuner, et je m’assis auprès d’une de ces sources minces, fréquentes dans les pays montueux, fil grêle et rond d’eau claire et glacée qui sort du roc et coule au bout d’une feuille disposée par un passant pour amener le courant menu jusqu’à sa bouche."
                            },
                            {
                                "example_id": "81082b75-837c-4b95-8085-f0b064bdd43a",
                                "sense_id": "d26a8fdb-8f42-344c-b10f-2c838b203c5f",
                                "text": "Nous apercevions de temps en temps une île montueuse, si légère en sa masse, si transparente, qu'on eût dit qu'elle était faite de la pâte sèche des nids de guêpes et qu'elle voguait sur les flots."
                            },
                            {
                                "example_id": "f9620d34-d823-4641-8f67-0e158481a687",
                                "sense_id": "d26a8fdb-8f42-344c-b10f-2c838b203c5f",
                                "text": "Il devint pour tous le peintre des sommets, des vallées, des crêtes. C’étaient sur des arrière-fonds montueux que ses rares portraits de jeunes filles se détachaient, imitant du reste leurs sévères géométries."
                            }
                        ]
                    },
                    {
                        "sense_id": "9d113f4b-4870-3e2a-8066-8f4085d07c99",
                        "entry_id": "bfe8c4f7-3b3a-382f-a7be-64a1bc6c4256",
                        "glosses": [
                            "Qui a la forme de montagnes, de collines."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "81eb43ad-9b34-4172-aeda-f5985374b1d0",
                                "sense_id": "9d113f4b-4870-3e2a-8066-8f4085d07c99",
                                "text": "L’ombre gagna le palais, et ce ne fut plus qu’un océan immobile de toits et de combles où l’on ne distinguait rien qu’une ondulation montueuse."
                            },
                            {
                                "example_id": "27ac98e6-01e1-42f1-830a-3092dac584d6",
                                "sense_id": "9d113f4b-4870-3e2a-8066-8f4085d07c99",
                                "text": "La masse entière des arbres ne formait que de longs escarpements montueux et noirs, au pied desquels on distinguait les sinuosités blanchâtres des allées."
                            },
                            {
                                "example_id": "6e39fa6b-05e6-4ac9-a40d-2a889328efb3",
                                "sense_id": "9d113f4b-4870-3e2a-8066-8f4085d07c99",
                                "text": "Sa face, maigre et allongée, semblait creusée par le coup de pouce d’un sculpteur puissant ; le front montueux, les arcades sourcilières proéminentes, le nez en bec d’aigle, le menton fait d’un large méplat, les joues accusant les pommettes et coupées de plans fuyants, donnaient à la tête un relief d’une vigueur singulière."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ead88abd-379c-4451-bf80-13fdfdab680d",
                        "source_entry_id": "bfe8c4f7-3b3a-382f-a7be-64a1bc6c4256",
                        "target_lang_word": "hilly",
                        "target_lang_code": "en",
