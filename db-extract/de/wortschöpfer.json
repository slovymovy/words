                "senses": [
                    {
                        "sense_id": "2533f06d-96e4-3980-8011-b7e55ff4bc31",
                        "entry_id": "47c2f548-9cd9-372d-87be-a662e20a61e8",
                        "glosses": [
                            "Person, die neue Wörter erfindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "40987788-5537-4802-bb3c-33fc6e23147d",
                                "sense_id": "2533f06d-96e4-3980-8011-b7e55ff4bc31",
                                "text": "„Er geht traditionell an Journalisten, die sich im abgelaufenen Jahr als besonders kreative Wortschöpfer verdient gemacht haben.“"
                            },
                            {
                                "example_id": "cab5861b-b4a8-4ce9-bc36-dcf8c6b60795",
                                "sense_id": "2533f06d-96e4-3980-8011-b7e55ff4bc31",
                                "text": "„Warum also sollte man von einem Wortschöpfer eine verständliche Anleitung zum Einkauf verlangen?“"
                            },
                            {
                                "example_id": "83bc7f12-886f-4faa-8492-75e489515110",
                                "sense_id": "2533f06d-96e4-3980-8011-b7e55ff4bc31",
                                "text": "„Sieben Journalisten wurden Ende Februar vom Bildungsverlag Klett Sprachen mit dem \"PONS PONS – Preis für kreative Wortschöpfer\" ausgezeichnet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
