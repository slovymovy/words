                                    }
                                ]
                            },
                            {
                                "target_word": "pesant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4ce9defc-7063-3bb5-849f-b5e700f5b392",
                                        "entry_id": "b0e30ff6-2f93-3b42-90bd-51db3b1b7a8d",
                                        "glosses": [
                                            "Participe présent de peser."
                                        ],
