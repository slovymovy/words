                "senses": [
                    {
                        "sense_id": "9d5a5712-4661-35ad-abcf-6ddcc782ca61",
                        "entry_id": "a733476c-5eba-3fc1-857a-373b5dc44b84",
                        "glosses": [
                            "устар. или рег. безоблачный, солнечный, ясный, сухой, погожий"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "71cbee6e-4bad-4f79-98d5-d3c4aab1221b",
                                "sense_id": "9d5a5712-4661-35ad-abcf-6ddcc782ca61",
                                "text": "Но желал бы я знать умирая, // Что стоишь ты на верном пути, // Что твой пахарь, поля засевая, // Видит ве́дренный день впереди..."
                            },
                            {
                                "example_id": "d88a30cd-d1ae-4a23-b8b2-603fb5000c90",
                                "sense_id": "9d5a5712-4661-35ad-abcf-6ddcc782ca61",
                                "text": "Лето стояло ведренное, жаркое, но не засушливое."
                            }
                        ]
                    }
