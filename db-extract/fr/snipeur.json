                        "examples": [
                            {
                                "example_id": "68892918-79f2-40b2-b271-e66548534af4",
                                "sense_id": "3383774c-793a-3f0c-b91b-c3b0f1469bbb",
                                "text": "Flifla est mort, ainsi que jambon-beurre, leur Lebel au sol, mort propre, une seule balle chaque.\nJ'ai compris, y a un snipeur super-bien placé dans une casemate, en haut du sentier."
                            },
                            {
                                "example_id": "ad30e205-2648-4b60-899e-a566e66924cf",
                                "sense_id": "3383774c-793a-3f0c-b91b-c3b0f1469bbb",
                                "text": "Les snipeurs chargés de tirer, mais aussi d'observer les faits et gestes du terroriste pour fournir des renseignements, sont positionnés. Un gros bouclier anti-balles est mis en place."
                            }
                        ]
