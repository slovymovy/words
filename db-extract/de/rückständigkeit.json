                        "glosses": [
                            "Eigenschaft, dass etwas oder jemand sich verglichen mit anderen im Hintertreffen befindet"
                        ],
                        "tags": [
                            "singular",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "60700402-07ba-42a0-be0a-65dd08b412aa",
                                "sense_id": "4b0870a5-938a-30df-8e2c-3c41294532bd",
                                "text": "„Dieser Witz ist eigentlich ein Witz über die Rückständigkeit der Sowjetunion gegenüber dem Westen.“"
                            },
                            {
                                "example_id": "8ebf8649-8678-484d-b5fd-a7ba0a2caa65",
                                "sense_id": "4b0870a5-938a-30df-8e2c-3c41294532bd",
                                "text": "„Nirgendwo betont Caesar eine Rückständigkeit oder gar Primitivismus, für ihn war eine keltische Stadt dasselbe wie eine römische Stadt, kein fremdartiges Konzept, das sich vom Gewohnten unterschied und das er seinen Lesern deshalb erst noch erklären musste.“"
                            }
                        ],
