                                        "entry_id": "60ba1b4b-7a97-3785-8548-1a60ba78ec7d",
                                        "glosses": [
                                            "One of the brightest stars in the sky, now recognised to be a binary star in the constellation Taurus (alpha (α) Tauri); an orange giant, 68 light years from Earth."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9792af04-1bc3-4914-a619-5fdee78e653f",
                                                "sense_id": "d7d78501-e367-3320-bc25-c2a32bf6953f",
                                                "text": "The kingly brilliancy of Sirius pierced the eye with a steely glitter, the star called Capella was yellow, Aldebaran and Betelgueux shone with a fiery red."
                                            },
                                            {
                                                "example_id": "4e3b7e37-97aa-41fd-a5af-68eb6778ed2f",
                                                "sense_id": "d7d78501-e367-3320-bc25-c2a32bf6953f",
                                                "text": "The brightest object depicted is Jupiter which stands near the red giant star Aldebaran in Taurus."
                                            }
                                        ]
                                    }
