                "senses": [
                    {
                        "sense_id": "d412b95b-643e-3da0-9018-7183748d33a1",
                        "entry_id": "6ca6797a-d1f5-33ad-9425-f59e416752f2",
                        "glosses": [
                            "научн. относящийся к конвергенции, основанный на конвергенции"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e9f11eb0-af18-4eaf-b96b-f5e0d41e29ec",
                                "sense_id": "d412b95b-643e-3da0-9018-7183748d33a1",
                                "text": "История языков знает и дивергентное и конвергентное развитие."
                            },
                            {
                                "example_id": "f03640c1-7e1e-4ceb-9dba-8183f6b87087",
                                "sense_id": "d412b95b-643e-3da0-9018-7183748d33a1",
                                "text": "Приводились также доводы в пользу эффекта конвергентной эволюции вирионов, построенных из единичных белков приблизительно одинаковой молекулярной массы."
                            }
                        ]
                    }
