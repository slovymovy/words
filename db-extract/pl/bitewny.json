                "senses": [
                    {
                        "sense_id": "d0d46ce0-4043-3815-8063-bfbd16be1ee2",
                        "entry_id": "7cd5e4d0-2674-3799-b2d1-5a0435742627",
                        "glosses": [
                            "dotyczący bitwy, związany z bitwą"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5079fb98-fae3-443e-8581-08f4efd68857",
                                "sense_id": "d0d46ce0-4043-3815-8063-bfbd16be1ee2",
                                "text": "Ledwo pół wieku po wojnach husyckich na polach bitewnych Europy królowała już artyleria, a popłoch budzili pikinierzy szwajcarscy i formacje lancknechtów Frundsberga – karne, zwarte, po plebejsku solidarne, wiernie naśladujące husycki styl wojowania"
                            },
                            {
                                "example_id": "688e88f3-7f5e-431b-bf00-f4d8aaccdfbb",
                                "sense_id": "d0d46ce0-4043-3815-8063-bfbd16be1ee2",
                                "text": "Na wyspie widać bitewne przygotowania. Nad brzegiem pojawiają się łucznicy i procarze. W dalszych szeregach miotacze oszczepów i ciężkozbrojni."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
