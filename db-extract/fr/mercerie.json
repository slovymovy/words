        "fr-extract.jsonl": [
            {
                "entry_id": "f333113d-e724-3e2d-a332-ed6cc5823962",
                "word": "mercerie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "48adeb19-2680-4c5e-a35e-710ec98cee43",
                        "entry_id": "f333113d-e724-3e2d-a332-ed6cc5823962",
                        "tags": [
                            "plural"
                        ],
                        "form": "merceries"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "73a67c9b-90a1-35e4-a789-ebe70d960813",
                        "entry_id": "f333113d-e724-3e2d-a332-ed6cc5823962",
                        "glosses": [
                            "Terme collectif par lequel on désigne les diverses marchandises qui servent pour l’habillement et la parure, comme le fil, les aiguilles, les épingles, les rubans, etc. Mais aussi des armes, des couteaux, des métaux, des bijoux, des parures, pièces d'ameublement, des cuirs, des étoffes…"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6fcf9acf-066a-43c8-9544-b71dc1a4938e",
                                "sense_id": "73a67c9b-90a1-35e4-a789-ebe70d960813",
                                "text": "Les produits viennent surtout naturellement des grandes régions de l’industrie textile : Mulhouse pour les tissus de coton et la mercerie, le Nord pour les lainages, Troyes pour la bonneterie."
                            },
                            {
                                "example_id": "045ba7c7-0886-4ef1-a514-e6eacec2a9e7",
                                "sense_id": "73a67c9b-90a1-35e4-a789-ebe70d960813",
                                "text": "Le naufragé de la quatre-voies de Saint-Appoline, […], redevient peu à peu Michu, Raoul Michu, un représentant en mercerie soudainement en mal de romantisme, par une belle après-midi de juin."
                            }
                        ]
                    },
                    {
                        "sense_id": "b9afbc45-01a5-31bf-a779-4cc29fded422",
                        "entry_id": "f333113d-e724-3e2d-a332-ed6cc5823962",
                        "glosses": [
                            "Échoppe, magasin ou boutique où s’exerce ce commerce."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "47283cf1-975c-4665-8b1d-74359767ee96",
                                "sense_id": "b9afbc45-01a5-31bf-a779-4cc29fded422",
                                "text": "Lorsque l'on entrait dans la mercerie d’autrefois, la bonne odeur de la satinette vous montait aux narines, magnifiée encore par l'arôme du café qui se glissait par la porte de la cuisine toujours entrouverte, […]"
                            },
                            {
                                "example_id": "378eb636-7733-4bdf-90e9-0fee5651a37b",
                                "sense_id": "b9afbc45-01a5-31bf-a779-4cc29fded422",
                                "text": "Afin de nourrir sa fascination pour les couleurs chatoyantes des pelotes de laine et des écheveaux de coton qui s'alignent sur les rayonnages de la mercerie de son village, sa mère lui enseigne le crochet."
                            }
                        ]
                    },
                    {
                        "sense_id": "91f247cf-f5c6-37c2-ab17-93b6b884bdd7",
                        "entry_id": "f333113d-e724-3e2d-a332-ed6cc5823962",
                        "glosses": [
                            "Magasin de vêtements pour hommes."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "1d2633a8-05ab-4736-8893-e37794ac95c5",
                                "sense_id": "91f247cf-f5c6-37c2-ab17-93b6b884bdd7",
                                "text": "Mon père, lui, voulut pour l’occasion me voir porter un habit neuf. Il m'emmena dans une mercerie pour hommes à prix populaires, La Maison Michel, […]."
                            },
                            {
                                "example_id": "ec37e423-e135-4be0-8615-9e905fe4b24e",
                                "sense_id": "91f247cf-f5c6-37c2-ab17-93b6b884bdd7",
                                "text": "Enfin pour monsieur, il y a de tout : la mercerie, la chemiserie, les chaussures ainsi que la chapellerie."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f21e8e76-8689-4897-96db-c065ad68647b",
                        "source_entry_id": "f333113d-e724-3e2d-a332-ed6cc5823962",
                        "source_sense_description": "Marchandises pour l’habillement",
                        "target_lang_word": "Kramware",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "da069f39-286f-4937-9929-72b0705dbe3e",
                        "source_entry_id": "f333113d-e724-3e2d-a332-ed6cc5823962",
                        "source_sense_description": "Marchandises pour l’habillement",
                        "target_lang_word": "Galanterie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Galanterie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "50e27e96-611e-3bbd-aaf8-4107854a1e39",
                                        "entry_id": "d55c646b-f9fa-3abb-a826-c561b73a5094",
                                        "glosses": [
                                            "ausgesprochen höfliches, zuvorkommendes Verhalten gegenüber Frauen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91c0b80e-3a3a-43b1-8326-419ab2202b70",
                                                "sense_id": "50e27e96-611e-3bbd-aaf8-4107854a1e39",
                                                "text": "„Es wäre nun vielleicht an der Zeit, daß Sie sich die Folgen Ihrer Galanterie gegen diese Dame klarmachen.“"
                                            },
                                            {
                                                "example_id": "1cbba07e-409f-4b00-bb54-31f62fb159af",
                                                "sense_id": "50e27e96-611e-3bbd-aaf8-4107854a1e39",
                                                "text": "„Ein solcher Ton der Galanterie herrschte in Granada, als ich die ersten Schritte in der Gesellschaft tat; doch ich verfiel nicht dieser Mode.“"
                                            },
                                            {
                                                "example_id": "4261c0a7-7cb5-4d62-bf5d-4a9e83b29ded",
                                                "sense_id": "50e27e96-611e-3bbd-aaf8-4107854a1e39",
                                                "text": "„Er tat ausgesprochen höflich und gebärdete sich wie im Caféhaus, glich ihre flach intonierte Schroffheit durch gestelzte Galanterie aus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "54799d23-6a27-3312-99dc-a69975434c7b",
                                        "entry_id": "d55c646b-f9fa-3abb-a826-c561b73a5094",
                                        "glosses": [
                                            "schmeichelndes, verbindliches Kompliment gegenüber Frauen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bef32b20-06a4-40c0-9964-41e6e7847fd8",
                                                "sense_id": "54799d23-6a27-3312-99dc-a69975434c7b",
                                                "text": "„Statt mir Handschuhe zu kaufen, beschloß ich, mich zu rächen, indem ich ihr aus dem Weg ging und sie der abgeschmackten Galanterie Sanzonios überließ, der angefaulte Zähne, eine blonde Perücke, eine unreine Haut und einen übelriechenden Atem hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
