                        "examples": [
                            {
                                "example_id": "a7eff718-d40b-4607-b339-e1377a921ad7",
                                "sense_id": "adb5ec38-b95b-32f6-a3a2-8ec9fbce6c25",
                                "text": "Ademloos staarde hij naar die glanzende, berstensvolle bloedvrucht, pulserend op zijn hartslag; verloor hij zich in die rode ring van vlees, met het verzonken gat in het midden net een kers zonder steeltje; verheugde hij zich: eenzelfde ring droeg hij aan zijn vinger, een hoepring van wild vlees, een vriendschapsring."
                            },
                            {
                                "example_id": "673de98e-91e2-401f-9bde-a20d4265c887",
                                "sense_id": "adb5ec38-b95b-32f6-a3a2-8ec9fbce6c25",
                                "text": "Er doen meer wilde verhalen de ronde over spinazie. Zo zou het je heel sterk maken omdat het berstensvol ijzer zit. Denk aan Popeye. Nou, dat valt reuze mee, of tegen. Een tomaat of rode biet bevat al meer ijzer dan een ketel vol spinazie."
                            }
                        ]
                    }
