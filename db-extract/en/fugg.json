    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "4d1601d1-58fa-3f96-b4f8-8a4fd61ea8a9",
                "word": "fugg",
                "pos": "intj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "c0404e2e-38f4-3a84-b29a-109879581c7e",
                        "entry_id": "4d1601d1-58fa-3f96-b4f8-8a4fd61ea8a9",
                        "glosses": [
                            "Alternative form of fug."
                        ],
                        "tags": [
                            "alt-of",
                            "alternative"
                        ],
                        "examples": [
                            {
                                "example_id": "bea85d14-4eb9-4758-9c5b-2d72fee2743b",
                                "sense_id": "c0404e2e-38f4-3a84-b29a-109879581c7e",
                                "text": "Have to shoot all the sequences again. Delays! Delays! Retakes! My God, the cost of retakes. Oh fugg! Fugg! Fugg!'"
                            },
                            {
                                "example_id": "55e0ecba-76dc-4b3c-ba7a-6a5b55e198fb",
                                "sense_id": "c0404e2e-38f4-3a84-b29a-109879581c7e",
                                "text": "“Oh, fugg,” she swears as she scrambles out of the sofa, “Hello.”"
                            },
                            {
                                "example_id": "71c68fda-cb22-4bae-b7eb-af0e3af9102a",
                                "sense_id": "c0404e2e-38f4-3a84-b29a-109879581c7e",
                                "text": "“Oh, fugg, man,” he says. “That's fugged up!”"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "577ee24c-0d31-33b6-ada0-22e7a2867af6",
                "word": "fugg",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "c87c57f8-7658-4fc1-81a9-ced1681e9aad",
                        "entry_id": "577ee24c-0d31-33b6-ada0-22e7a2867af6",
                        "tags": [
                            "plural"
                        ],
                        "form": "fuggs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "db9ed70e-4817-3535-af7a-29c0ba6f3561",
                        "entry_id": "577ee24c-0d31-33b6-ada0-22e7a2867af6",
                        "glosses": [
                            "Alternative form of fug.",
                            "Heavy, unpleasant atmosphere."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "856d989a-3811-41a8-9530-7c04f9ef0294",
                                "sense_id": "db9ed70e-4817-3535-af7a-29c0ba6f3561",
                                "text": "Touched by these sweet melodies, the company began to sing, and so with song and merriment came into Tatchester station, where they crawled from the fugg of the crowded carriage into the crisp October air, and found that the city had turned into a sour-smelling fog the mist which had lain like lawn on the meadows by the river."
                            },
                            {
                                "example_id": "9087128a-c460-4d39-a494-69d2cfe529fe",
                                "sense_id": "db9ed70e-4817-3535-af7a-29c0ba6f3561",
                                "text": "The place smelled of old alcohol and fried onions, but the smokers stood out onthe sidewalks these days, so they were spared the fugg."
                            },
                            {
                                "example_id": "e37aba5a-08eb-4380-b6d7-72e3b1f75709",
                                "sense_id": "db9ed70e-4817-3535-af7a-29c0ba6f3561",
                                "text": "Some of the tables were upset, and there was a faint tang, perceptible above the fugg of the place, which told him that it was here the shot had been fired."
                            }
                        ]
                    },
                    {
                        "sense_id": "367bc670-a033-32b6-8688-9f0e12779610",
                        "entry_id": "577ee24c-0d31-33b6-ada0-22e7a2867af6",
                        "glosses": [
                            "Alternative form of fug.",
                            "Daze."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "72db503a-2074-4b56-82e7-8147edb8d533",
                                "sense_id": "367bc670-a033-32b6-8688-9f0e12779610",
                                "text": "Through a fugg of drink and fatigue, a strange clarity was starting to emerge."
                            },
                            {
                                "example_id": "e72deead-a8ec-421a-ab0a-21578c52bd99",
                                "sense_id": "367bc670-a033-32b6-8688-9f0e12779610",
                                "text": "The work of art (religiously) is a door or a lift permitting a man to enter, or hoisting him mentally into, a zone of activity, and out of the fugg an inertia\"( 189-90; my emphasis)."
                            },
                            {
                                "example_id": "928eb8cc-f493-4ca8-bbe9-379d9219485e",
                                "sense_id": "367bc670-a033-32b6-8688-9f0e12779610",
                                "text": "The fugg in my mind was starting to clear a little and I began to get a little more aware of what was going on."
                            }
                        ]
                    },
                    {
                        "sense_id": "65429f8f-2b88-313f-be39-cb4b3123a4a9",
                        "entry_id": "577ee24c-0d31-33b6-ada0-22e7a2867af6",
                        "glosses": [
                            "Alternative form of fug.",
                            "Confusion"
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "b1894712-533c-4851-95b1-dcca1face9ac",
                                "sense_id": "65429f8f-2b88-313f-be39-cb4b3123a4a9",
                                "text": "It is not in group nature to distinguish very clearly between the live and the dead part of their equipment. The basket is, metaphorically, easier to handle than the cat inside the basket. Hence the fugg of universities and of academic abominations."
                            },
                            {
                                "example_id": "2fa7af19-5844-47a7-9d9e-eaf471a9e291",
                                "sense_id": "65429f8f-2b88-313f-be39-cb4b3123a4a9",
                                "text": "So dense is the fugg in that department that in my student days no senior had the faintest inkling of Dante's interest, Shakespeare's interest in living."
                            },
                            {
                                "example_id": "62a75466-2073-44e2-8346-097d4ed8c21c",
                                "sense_id": "65429f8f-2b88-313f-be39-cb4b3123a4a9",
                                "text": "She genuinely believed that the ' working classes ' had ' different blood from ours, rougher ' and that this caused the fugg in the canteen."
                            },
                            {
                                "example_id": "68e6ed3f-812e-4b2d-9bcd-dc8e63c0060d",
                                "sense_id": "65429f8f-2b88-313f-be39-cb4b3123a4a9",
                                "text": "(All so much a fugg anyhow, such damn things; would to god we could both sit clean of them. Though I have hellish aches about Cid & all; I feel pretty much an idiot, now feeling the pinch, etc. But I can't see it was wrong; I couldn't take his interference, etc., especailly being so very well intentioned, etc. Fuck it. Ann says, when will you get famous so we can get out of here???)"
                            }
                        ]
                    },
                    {
                        "sense_id": "8f779e58-d727-3fea-a41a-7819687f01a1",
                        "entry_id": "577ee24c-0d31-33b6-ada0-22e7a2867af6",
                        "glosses": [
                            "Alternative form of fug.",
                            "Euphemistic form of fuck."
                        ],
                        "tags": [
                            "countable",
                            "euphemistic",
                            "form-of",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "b9801aa9-e11e-4500-96b4-e6f75dbad673",
                                "sense_id": "8f779e58-d727-3fea-a41a-7819687f01a1",
                                "text": "\"Someone puh-leez shoot these surfer fuggs before I get out ma yacht and do some serious runnin' down! Who needs these hippy freaks?"
                            },
                            {
                                "example_id": "a57b5fd5-a292-4e77-a906-abd5761bb04c",
                                "sense_id": "8f779e58-d727-3fea-a41a-7819687f01a1",
                                "text": "The door opened. \"Surprise! It's only me!\" \"Leo! Goddamn you!\" \"Hey, Kip, ole buddy, what the fugg you doing?"
                            },
                            {
                                "example_id": "2fda6239-9e70-429a-892c-6b87fa00d98f",
                                "sense_id": "8f779e58-d727-3fea-a41a-7819687f01a1",
                                "text": "Weren't any love there; he never gave a fugg about me."
                            },
                            {
                                "example_id": "6e5e2501-96f4-4270-92ff-4bccf21b33b8",
                                "sense_id": "8f779e58-d727-3fea-a41a-7819687f01a1",
                                "text": "Santiago fired up the van, you could hear him screaming “let's go man, let's get the fugg out of here, the cops are coming!”"
                            }
                        ]
                    }
