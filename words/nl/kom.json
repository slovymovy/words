                {
                    "sense_id": "6e009724-fee2-38c8-920b-e723ba71a9e9",
                    "sense_definition": "het holle gedeelte van een gewricht waar de kop van een ander bot in past",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "anatomie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De arts stelde vast dat de schouder uit de <w>kom</w> was geschoten.",
                            "target_lang_translations": {
                                "en": "The doctor determined that the shoulder had popped out of its <w>socket</w>.",
                                "ru": "Врач установил, что плечо вылетело из <w>сустава</w>."
                            }
                        },
                        {
                            "text": "Bij een heupoperatie wordt soms ook de <w>kom</w> van het gewricht vervangen.",
                            "target_lang_translations": {
                                "en": "During hip surgery, the <w>socket</w> of the joint is sometimes also replaced.",
                                "ru": "При операции на бедре иногда заменяют и суставную <w>впадину</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "uit de kom"
                    ],
                    "target_lang_definitions": {
                        "en": "the hollow part of a joint where the head of another bone fits",
                        "ru": "полая часть сустава, в которую входит головка другой кости"
                    },
                    "translations": {
                        "en": [
