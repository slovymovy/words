                                        "sense_id": "b8740a77-fc70-3daa-a012-dd601a0128b0",
                                        "entry_id": "5a1e2eca-3151-30aa-aaf3-a9dfebec7566",
                                        "glosses": [
                                            "People of royal rank, plus their families, treated as a group."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4dd0d198-65fb-4795-a145-a4f630d281de",
                                                "sense_id": "b8740a77-fc70-3daa-a012-dd601a0128b0",
                                                "text": "Wolferton was an important station on the Kings Lynn-Hunstanton line, which closed in 1969. As the station was convenient for the Sandringham estate, it was regularly patronised by royalty, and royal retiring rooms were provided."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f37caf07-df8d-3c4d-af6e-97a3940d02c8",
                                        "entry_id": "5a1e2eca-3151-30aa-aaf3-a9dfebec7566",
                                        "glosses": [
                                            "A royal right or prerogative, such as the exploitation of a natural resource; the granting of such a right; payment received for such a right."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3272d172-cc1c-3270-9e26-2af44da135a1",
                                        "entry_id": "5a1e2eca-3151-30aa-aaf3-a9dfebec7566",
                                        "glosses": [
                                            "The payment received by an owner of real property for exploitation of mineral rights in the property."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f8a4fe1d-30d4-3185-a53b-9b9ca25efbc6",
                                        "entry_id": "5a1e2eca-3151-30aa-aaf3-a9dfebec7566",
                                        "glosses": [
                                            "Payment made to a writer, composer, inventor etc for the sale or use of intellectual property, invention etc."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "61161d6a-df82-3646-bc63-e2805eaa7b66",
                                        "entry_id": "5a1e2eca-3151-30aa-aaf3-a9dfebec7566",
                                        "glosses": [
                                            "To make more money from a book than it cost to run an advertising campaign for it; to make enough in royalties to cover the advance a book received."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b4c39323-dd70-47eb-acbb-c258b928d653",
                                                "sense_id": "61161d6a-df82-3646-bc63-e2805eaa7b66",
                                                "text": "Until the total of advances in that contract has been earned out by royalties from any or all books in that contract, the author will not receive additional royalties."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "29ccb755-321d-37d5-aafb-ce0fb51fcec1",
                                        "entry_id": "5a1e2eca-3151-30aa-aaf3-a9dfebec7566",
                                        "glosses": [
                                            "Someone in a privileged position."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd62f197-7c00-4ace-ae6e-176eadaa1ef0",
                                                "sense_id": "29ccb755-321d-37d5-aafb-ce0fb51fcec1",
                                                "text": "England will have another manager for the next World Cup, Hodgson’s reign will be defined by a result comparable to losing to the United States in the 1950 World Cup and the now-familiar inquest will begin again in a country that likes to see itself as football royalty."
                                            },
                                            {
                                                "example_id": "be37d7bc-d250-4767-b6f9-426208f807a6",
                                                "sense_id": "29ccb755-321d-37d5-aafb-ce0fb51fcec1",
                                                "text": "The Biden large-donor scene, where Mr. Katzenberg is treated as royalty himself, has been devastated since Mr. Biden’s debate performance two weeks ago."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5fd7c01a-d625-3e4c-a15e-89cc135440e6",
                                        "entry_id": "5a1e2eca-3151-30aa-aaf3-a9dfebec7566",
                                        "glosses": [
                                            "A king and a queen as a starting hand in Texas hold 'em."
                                        ],
