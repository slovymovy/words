                        "glosses": [
                            "Se dit d'un événement A d'un univers probabilisé (Ω,P) tel que P(A)=0."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "80858d47-d4fe-4dba-8627-490c4a4b2a90",
                                "sense_id": "32babe41-cb5a-3fa1-9007-b24c6140d1a8",
                                "text": "Si l’un des deux événements A ou B est quasi-impossible, alors A et B sont indépendants."
                            },
                            {
                                "example_id": "9ad76d5e-4143-43e6-8320-ba0d6caa299d",
                                "sense_id": "32babe41-cb5a-3fa1-9007-b24c6140d1a8",
                                "text": "Tout événement A tel que P(A) = 0, différent de ∅, est dit négligeable ou quasi-impossible."
                            }
                        ]
                    }
