                                            {
                                                "example_id": "537e9ccf-2259-4ebc-ab25-08e1d670b78e",
                                                "sense_id": "9da6b0ef-e005-3f9f-98a0-99ddf2c07356",
                                                "text": "The runaway delegates nominated their own candidate."
                                            }
