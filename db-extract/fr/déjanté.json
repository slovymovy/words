                    {
                        "sense_id": "ff55af90-032e-351b-b8d8-9393da38decb",
                        "entry_id": "bf68a8df-d938-3eb2-95cd-67e1b8c45967",
                        "glosses": [
                            "Fou, hors-norme, excentrique."
