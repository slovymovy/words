                    {
                        "sense_id": "7deedd27-e1ae-36c5-91dd-59a3d91e13d9",
                        "entry_id": "f68775c2-cd42-3c01-aa53-1a25c563ff25",
                        "glosses": [
                            "Qui est dénoué, déconstruit, mis dans un état inconvenable, désordonné."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "15141e59-29ab-3602-922f-3bc89f3a7a5b",
                        "entry_id": "f68775c2-cd42-3c01-aa53-1a25c563ff25",
                        "glosses": [
                            "Qui est abattu, amaigri."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "136ad688-0315-4223-8d20-cfc1f219b516",
                                "sense_id": "15141e59-29ab-3602-922f-3bc89f3a7a5b",
                                "text": "Je l’ai vu avec un visage défait."
                            },
                            {
                                "example_id": "d500c470-4e23-440d-9b27-ddcbe20fabbf",
                                "sense_id": "15141e59-29ab-3602-922f-3bc89f3a7a5b",
                                "text": "Depuis sa maladie il a l’air défait."
                            },
                            {
                                "example_id": "7872be8c-81e5-4313-8773-1e6af303c6b7",
                                "sense_id": "15141e59-29ab-3602-922f-3bc89f3a7a5b",
                                "text": "Cette femme est pâle et défaite."
                            },
                            {
                                "example_id": "b6021aa4-d645-4e56-ae23-489a76f7908e",
                                "sense_id": "15141e59-29ab-3602-922f-3bc89f3a7a5b",
                                "text": "Quand je songe au moment où il me faudra me retirer de la circulation, c’est toujours dans une maison légère de la rue Saint-Georges, de la rue La Rochefoucauld ou d’une rue analogue que je me vois installé, vieux beau pas trop défait, en compagnie de quelques femmes dont la galanterie ornera ma vieillesse."
                            }
                        ]
                    }
                ],
