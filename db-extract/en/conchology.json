                    {
                        "sense_id": "617956f7-a33e-3567-921f-d58501f02fe1",
                        "entry_id": "638a6918-be7f-345f-b523-b930bce68e4a",
                        "glosses": [
                            "The study of molluscs and their shells."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "0255235c-61cd-46ef-9826-7be0cf109df7",
                                "sense_id": "617956f7-a33e-3567-921f-d58501f02fe1",
                                "text": "\"Thank goodness, I am not a child,\" said Lady Mandeville, turning over a collection of those juvenile tomes, which are to make the rising generation so much wiser than their grandfathers or grandmothers—catechisms of conchology, geology, mathematical questions for infants, geography, astronomy; \"the child may be 'father to the man;' but the said father must have had some trouble with his offspring.\""
                            },
                            {
                                "example_id": "73a54c1b-8182-49ef-9768-5579bcc717d5",
                                "sense_id": "617956f7-a33e-3567-921f-d58501f02fe1",
                                "text": "The least dreadful among the essays stacked and waiting to be corrected would be that of young Master Jefferson Davis, who when imprisoned by Andrew Johnson in 1866 will ask his physician at Fortress Monroe to procure a few volumes of \"conchology, geology, or botany,\" he desiring to commune with the interests of more innocent days."
                            }
                        ]
                    },
                    {
                        "sense_id": "6e03275a-3123-357e-b5eb-63f78a5cd2dc",
                        "entry_id": "638a6918-be7f-345f-b523-b930bce68e4a",
                        "glosses": [
                            "The hobby of shell collecting."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
