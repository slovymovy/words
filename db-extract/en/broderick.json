                "senses": [
                    {
                        "sense_id": "6e42ea1a-8dc8-370b-98ba-3a5e433f8ac7",
                        "entry_id": "96185c56-9dcf-37c3-80ca-4ee96a8d4751",
                        "glosses": [
                            "To administer a beating to"
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "e1c9e9d4-13bf-4ad2-a7b0-4b10c1d73375",
                                "sense_id": "6e42ea1a-8dc8-370b-98ba-3a5e433f8ac7",
                                "text": "\"I brodericked him when he was alive,\" Johnny would say, \"but it is against my religion to do anything like that to the dead. [spit in corpse's eye]\""
                            },
                            {
                                "example_id": "4cf60365-4e6e-4b0c-9ba3-ecabe2e9960f",
                                "sense_id": "6e42ea1a-8dc8-370b-98ba-3a5e433f8ac7",
                                "text": "Any racketeer or Mafia chief who chose to behave quietly in public did not have to fear Broderick, although the hired hands who performed the necessary acts of violence did run the risk of being \"Brodericked.\""
                            }
                        ]
                    }
