                    {
                        "translation_id": "aa2281ac-d7e8-4861-8013-b2f1abbe5356",
                        "source_entry_id": "105f5ab4-2aab-339a-88cf-802a75f28d6a",
                        "source_sense_id": "45e8a9d8-3ea3-3530-9234-22e0775e8ab2",
                        "source_sense_description": "een groet die in de avond gebruikt wordt",
                        "target_lang_word": "bonsoir",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bonsoir",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "261624f3-9dbe-3f24-aca8-3a09c4ebc3ee",
                                        "entry_id": "95e389f1-189b-3f4e-98e8-2507789cf30f",
                                        "glosses": [
                                            "Formule de politesse amicale et souvent mot d’introduction lors d’une rencontre ou lors d’un départ en soirée pour saluer. — Note d’usage : Selon le moment de la journée, on utilisera bonjour ou bonsoir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "425f3f2a-1d44-4858-bfff-1798f962a993",
                                                "sense_id": "261624f3-9dbe-3f24-aca8-3a09c4ebc3ee",
                                                "text": "Il plongea ses yeux dans ceux de Nan.\nBonsoir, dit-il, gaiement. N'étiez-vous pas au bar, il y a quelques minutes ?"
                                            },
                                            {
                                                "example_id": "b96c36a1-8cad-44c4-ad51-c23a951ff044",
                                                "sense_id": "261624f3-9dbe-3f24-aca8-3a09c4ebc3ee",
                                                "text": "Nicolas m'adresse un petit sourire et prend la parole.\n— Bien, bonsoir à tous, je pense que nous allons pouvoir commencer tout le monde est arrivé."
                                            },
                                            {
                                                "example_id": "f8ed09cc-050f-49f0-b903-70dd51daf087",
                                                "sense_id": "261624f3-9dbe-3f24-aca8-3a09c4ebc3ee",
                                                "text": "Maman, dit-il, je viens te dire bonsoir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a1d1df74-ac32-3942-bf0f-316bc8c83f6f",
                                        "entry_id": "95e389f1-189b-3f4e-98e8-2507789cf30f",
                                        "glosses": [
                                            "L’affaire est réglée, n’en discutons plus."
                                        ],
                                        "tags": [
                                            "ironic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "55642dfb-936f-4c30-b230-2976d9e6383d",
                                                "sense_id": "a1d1df74-ac32-3942-bf0f-316bc8c83f6f",
                                                "text": "Mais si un roman est aussi embêtant qu’un bouquin scientifique, bonsoir, il n’y a plus d’Art."
                                            },
                                            {
                                                "example_id": "8677b6f0-2c43-455d-a4a9-2d6aaffd2530",
                                                "sense_id": "a1d1df74-ac32-3942-bf0f-316bc8c83f6f",
                                                "text": "J’te dis qu’c’est moi, bonsoir !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5442e285-0bea-3e6b-aa33-8584fc8cc37f",
                                        "entry_id": "95e389f1-189b-3f4e-98e8-2507789cf30f",
                                        "glosses": [
                                            "L’affaire s'avère difficile, pénible."
                                        ],
                                        "tags": [
                                            "ironic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "96303423-5ad2-411d-a764-a0c283b204b8",
                                                "sense_id": "5442e285-0bea-3e6b-aa33-8584fc8cc37f",
                                                "text": "— Bonsoir… Va falloir que je trimbale deux cordes de bois jusque là-bas, comme ça, avec la charrette !"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bonsoir",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "42db92ab-5942-3230-bc45-09fe859e18c5",
                                        "entry_id": "b4d9d076-5685-3bca-88e6-3b330ad6c26d",
                                        "glosses": [
                                            "Souhait de bonne soirée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "741c0510-e143-4d14-a121-658935ff6389",
                                                "sense_id": "42db92ab-5942-3230-bc45-09fe859e18c5",
                                                "text": "Dire bonsoir, un tendre bonsoir d’ami, un bonsoir de cœur."
                                            },
                                            {
                                                "example_id": "6aeb0de3-3d32-405f-9dee-3504583d3282",
                                                "sense_id": "42db92ab-5942-3230-bc45-09fe859e18c5",
                                                "text": "Le général après avoir fait une dernière ronde, […], souhaita le bonsoir à sa nièce, […]."
                                            },
                                            {
                                                "example_id": "a3240e7b-6998-4753-a75d-d9878737c756",
                                                "sense_id": "42db92ab-5942-3230-bc45-09fe859e18c5",
                                                "text": "Un signe amical, un bonsoir de la main répondaient toujours à leur regard et à leur sourire."
                                            },
                                            {
                                                "example_id": "63f88f61-c77d-4e93-abd6-0b7d6b923a20",
                                                "sense_id": "42db92ab-5942-3230-bc45-09fe859e18c5",
                                                "text": "[…] il était fort probablement nécessaire de me corriger lorsqu'il me passait par exemple par la tête d'aller au lit en affirmant que je ne souhaiterais le bonsoir à personne."
                                            },
                                            {
                                                "example_id": "91e6d8ba-6b2c-4f81-820e-a5e65cc91d90",
                                                "sense_id": "42db92ab-5942-3230-bc45-09fe859e18c5",
                                                "text": "Je vous souhaite le bonsoir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "340488ca-c28c-3c1a-8ea9-66b744bf962e",
                                        "entry_id": "b4d9d076-5685-3bca-88e6-3b330ad6c26d",
                                        "glosses": [
                                            "Signe de salutations."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5e701973-36df-406a-b2b4-5daeeb1e665d",
                                                "sense_id": "340488ca-c28c-3c1a-8ea9-66b744bf962e",
                                                "text": "Ils se dirent bonsoir par un mutuel sourire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
