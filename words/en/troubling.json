                    "sense_id": "3b059bc6-4cb5-3f8a-8f03-b9610e5ee6e4",
                    "sense_definition": "Causing distress, anxiety, or worry.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor gave us some deeply <w>troubling</w> news about the test results.",
                            "target_lang_translations": {
