                ],
                "senses": [
                    {
                        "sense_id": "7631889f-a92f-3d31-afcc-50155dc940e1",
                        "entry_id": "7c780fd8-c57f-3f07-acd2-d851831b1493",
                        "glosses": [
                            "Markierung, die der Schifffahrt als Orientierungshilfe dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da346c8f-17a4-4ed8-9b04-ef38526b1107",
                                "sense_id": "7631889f-a92f-3d31-afcc-50155dc940e1",
                                "text": "„Die künstlichen Hilfsmittel der Schiffahrt, die Seezeichen, schwimmende und feste, Baken, Feuerschiffe, Leucht-, Heu- und Glockentonnen sind ebenfalls in einem ihrer äusseren Erscheinung ähnlichen Bilde eingetragen.“"
                            },
                            {
                                "example_id": "e3e781d8-6c17-4f57-8bae-8cb471802ba0",
                                "sense_id": "7631889f-a92f-3d31-afcc-50155dc940e1",
                                "text": "„Leuchttürme sind meist 15 bis 40 Meter hoch und werden an wichtigen oder gefährlichen Punkten der Schifffahrt als weithin sichtbare Seezeichen errichtet.“"
                            },
                            {
                                "example_id": "0d0a629f-11f0-466f-aec3-49775f36ec87",
                                "sense_id": "7631889f-a92f-3d31-afcc-50155dc940e1",
                                "text": "„Damals existierte im Westland bereits eine Kirche, die auch als Seezeichen diente, denn in jener Zeit erhielt die Insel auch Bedeutung als Navigationspunkt für die Emsschifffahrt, da Emden derzeit eine blühende Hafenstadt war.“"
                            },
                            {
                                "example_id": "3be644f7-73fe-486a-9095-ff4a23305b8d",
                                "sense_id": "7631889f-a92f-3d31-afcc-50155dc940e1",
                                "text": "„Ich gehe an einem Lager von Seezeichen hin und dann zwischen schwarzbraunen Schuppen hindurch weiter.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
