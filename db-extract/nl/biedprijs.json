        "nl-extract.jsonl": [
            {
                "entry_id": "c4344355-5493-35b3-8152-e7fd8d41e59c",
                "word": "biedprijs",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "180c1a08-6a81-42f1-b943-871e2123b588",
                        "entry_id": "c4344355-5493-35b3-8152-e7fd8d41e59c",
                        "tags": [
                            "plural"
                        ],
                        "form": "biedprijzen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "53100a10-d76d-3e39-ba68-ffaad0cb19d3",
                        "entry_id": "c4344355-5493-35b3-8152-e7fd8d41e59c",
                        "glosses": [
                            "maximale bedrag dat een koper wenst te betalen voor een product"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "636feeb8-9ef5-4909-9cac-7bb6babb1c45",
                                "sense_id": "53100a10-d76d-3e39-ba68-ffaad0cb19d3",
                                "text": "Investeerder Gilde verhoogt zijn overnamebod op textiel- en kunstgrasproducent TenCate naar 26 euro per aandeel. In totaal komt de biedprijs daarmee op circa 714 miljoen euro. Het betreft een finaal bod, aandeelhouders hebben tot en met 21 januari de tijd om te beslissen of zij erop ingaan."
                            },
                            {
                                "example_id": "ae8cd99e-e9c3-4820-83dc-2fd6fa41e228",
                                "sense_id": "53100a10-d76d-3e39-ba68-ffaad0cb19d3",
                                "text": "Het biedingsdocument geeft een gedetailleerd overzicht van de gesprekken die KPN en AMX tussen augustus en begin oktober voerden. Daaruit blijkt dat het bestuur van KPN het niet eens was met de Mexicaanse voorstellen over het toekomstige bestuur van de onderneming en de biedprijs."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3d22fcc7-48ce-44e7-a8e7-2c0db6dd0ad9",
                        "source_entry_id": "c4344355-5493-35b3-8152-e7fd8d41e59c",
                        "source_sense_id": "53100a10-d76d-3e39-ba68-ffaad0cb19d3",
                        "target_lang_word": "bid",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bid",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "25308897-b97a-3255-8f5b-a00f411b9f08",
                                        "entry_id": "528fc2b6-bbac-3bf0-9a65-bf9a46ad836f",
                                        "glosses": [
                                            "To issue a command; to tell."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d73730a6-b827-4ce0-986d-b9f11d690de0",
                                                "sense_id": "25308897-b97a-3255-8f5b-a00f411b9f08",
                                                "text": "He bade me come in."
                                            },
                                            {
                                                "example_id": "afa708c9-ebe2-4299-8fb1-5eb838bf6b15",
                                                "sense_id": "25308897-b97a-3255-8f5b-a00f411b9f08",
                                                "text": "Shylock: [...] Why Jessica, I say!\nLauncelot: Why, Jessica!\nShylock: Who bids thee call? I do not bid thee call.\nLauncelot: Your worship was wont to tell me that I could do nothing without bidding."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8bcb92df-9cf0-3320-b4c6-e0e14a1f5c49",
                                        "entry_id": "528fc2b6-bbac-3bf0-9a65-bf9a46ad836f",
                                        "glosses": [
                                            "To invite; to summon."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a8deb497-44e8-4107-9c03-0132ba86b655",
                                                "sense_id": "8bcb92df-9cf0-3320-b4c6-e0e14a1f5c49",
                                                "text": "She was bidden to the wedding."
                                            },
                                            {
                                                "example_id": "7236fe3c-7a83-402c-a4ed-0a3732795edd",
                                                "sense_id": "8bcb92df-9cf0-3320-b4c6-e0e14a1f5c49",
                                                "text": "Jessica: Call you? What is your will?\nShylock: I am bid forth to supper, Jessica: / [...] But wherefore should I go? / I am not bid for love; they flatter me;"
                                            },
                                            {
                                                "example_id": "6c750fa1-0fe6-40ed-b399-3517a23ef556",
                                                "sense_id": "8bcb92df-9cf0-3320-b4c6-e0e14a1f5c49",
                                                "text": "In his cloak of words strode the ringmaster, / Bid me join the parade"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "da2827ad-1260-38cd-bb4b-099912b7c728",
                                        "entry_id": "528fc2b6-bbac-3bf0-9a65-bf9a46ad836f",
                                        "glosses": [
                                            "To utter a greeting or salutation."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "66a71a07-052b-42f2-9730-ebff6c099040",
                                                "sense_id": "da2827ad-1260-38cd-bb4b-099912b7c728",
                                                "text": "Portia: If I could bid the fifth welcome with so good heart as I / can bid the other four farewell, I should be glad of his / approach; […]"
                                            },
                                            {
                                                "example_id": "9a9f3ced-e406-4aed-add1-be8a3deec050",
                                                "sense_id": "da2827ad-1260-38cd-bb4b-099912b7c728",
                                                "text": "The last train—a three-coach A.E.C. unit—from Belfast to Crumlin and back, was bade farewell with fog signals as it carried a capacity crowd of last-trip travellers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "01a06c6f-2e1e-3533-80be-2e5503aa95a7",
                                        "entry_id": "528fc2b6-bbac-3bf0-9a65-bf9a46ad836f",
                                        "glosses": [
                                            "To proclaim (a bede, prayer); to pray."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8afde9b5-dd21-402f-b328-3b2fdabc8452",
                                                "sense_id": "01a06c6f-2e1e-3533-80be-2e5503aa95a7",
                                                "text": "All night she spent in bidding of her bedes, / And all the day in doing good and godly deedes."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bid",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c23234f6-4883-39a0-82ba-b4745815ce12",
                                        "entry_id": "b1f28f2a-719b-3d81-a402-aad6479b147a",
                                        "glosses": [
                                            "To make an offer to pay or accept a certain price."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5ffdd6f7-76f0-4291-8aae-943f3d0c458e",
                                                "sense_id": "c23234f6-4883-39a0-82ba-b4745815ce12",
                                                "text": "Have you ever bid in an auction?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ac391da9-37b6-3e04-821f-bb28a24067dc",
                                        "entry_id": "b1f28f2a-719b-3d81-a402-aad6479b147a",
                                        "glosses": [
                                            "To offer as a price; to tender."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "69b6f671-f2b9-42ed-9eff-3b3e101ca936",
                                                "sense_id": "ac391da9-37b6-3e04-821f-bb28a24067dc",
                                                "text": "She bid £2000 for the Persian carpet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0b71f43e-e78b-3bd1-84b9-1d9445ca1dcf",
                                        "entry_id": "b1f28f2a-719b-3d81-a402-aad6479b147a",
                                        "glosses": [
                                            "To make an attempt."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "535840e2-885f-44b6-9c65-693b6a06b324",
                                                "sense_id": "0b71f43e-e78b-3bd1-84b9-1d9445ca1dcf",
                                                "text": "He was bidding for the chance to coach his team to victory once again."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eb108d6f-697c-377b-b160-07432ee15f44",
                                        "entry_id": "b1f28f2a-719b-3d81-a402-aad6479b147a",
                                        "glosses": [
                                            "To announce (one's goal), before starting play."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bec87c65-b642-35de-b90a-32a50f43fbfc",
                                        "entry_id": "b1f28f2a-719b-3d81-a402-aad6479b147a",
                                        "glosses": [
                                            "To take a particular route regularly."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "70ddf5fb-1ccf-48cf-b27a-bdc4b3904e95",
                                                "sense_id": "bec87c65-b642-35de-b90a-32a50f43fbfc",
                                                "text": "I can’t believe he bid the Syracuse turn; that can be brutal in the winter!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7ad452c4-3733-3794-9f9f-2450d91015f3",
                                        "entry_id": "b1f28f2a-719b-3d81-a402-aad6479b147a",
                                        "glosses": [
                                            "simple past and past participle of bid"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "participle",
                                            "past"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "bid",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "edc82750-cbdc-3db8-9856-55a603e939b1",
                                        "entry_id": "65148cfc-b60c-38b9-969a-20e210419b2a",
                                        "glosses": [
                                            "An offer at an auction, or to carry out a piece of work."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc11b3e0-7570-40c3-9e5e-9e3ea3c9bc78",
                                                "sense_id": "edc82750-cbdc-3db8-9856-55a603e939b1",
                                                "text": "His bid was $35,000."
                                            },
                                            {
                                                "example_id": "ba8baaff-d237-4179-81ce-8efb3f52e57f",
                                                "sense_id": "edc82750-cbdc-3db8-9856-55a603e939b1",
                                                "text": "The company tendered a bid for a lucrative transport contract."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6c7fc6d9-809b-33ad-9517-df59ebe3f4a5",
                                        "entry_id": "65148cfc-b60c-38b9-969a-20e210419b2a",
                                        "glosses": [
                                            "A (failed) attempt to receive or intercept a pass."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d1789a16-ea88-4a40-a9e2-bb659d6dc73e",
                                                "sense_id": "6c7fc6d9-809b-33ad-9517-df59ebe3f4a5",
                                                "text": "Nice bid!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7d8fce2e-139d-35ff-96a2-136c472dda9a",
                                        "entry_id": "65148cfc-b60c-38b9-969a-20e210419b2a",
                                        "glosses": [
                                            "An attempt, effort, or pursuit (of a goal)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc690e4e-99f4-406e-ba8e-d7707b1f6077",
                                                "sense_id": "7d8fce2e-139d-35ff-96a2-136c472dda9a",
                                                "text": "Their efforts represented a sincere bid for success."
                                            },
                                            {
                                                "example_id": "f6ed0c3f-9977-4d64-9055-d4836b35a784",
                                                "sense_id": "7d8fce2e-139d-35ff-96a2-136c472dda9a",
                                                "text": "She put in her bid for the presidency."
                                            },
                                            {
                                                "example_id": "ed66c152-d6c1-4401-8805-ba34c292f1f6",
                                                "sense_id": "7d8fce2e-139d-35ff-96a2-136c472dda9a",
                                                "text": "He put in his bid for office."
                                            },
                                            {
                                                "example_id": "c8c996c6-fcb5-4dc6-bee4-25be988824db",
                                                "sense_id": "7d8fce2e-139d-35ff-96a2-136c472dda9a",
                                                "text": "Then, as the Sunderland fans' cheers bellowed around the stadium, United's title bid was over when it became apparent City had pinched a last-gasp winner to seal their first title in 44 years."
                                            },
                                            {
                                                "example_id": "0cb698da-cbe1-4f15-93d6-63a3f7dd9824",
                                                "sense_id": "7d8fce2e-139d-35ff-96a2-136c472dda9a",
                                                "text": "[Running,] Doyle had passed up a dozen chances to go underground. He was swinging east again making another bid for Arcade."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "587a93bb-92e5-3a28-a089-e405d6b45832",
                                        "entry_id": "65148cfc-b60c-38b9-969a-20e210419b2a",
                                        "glosses": [
                                            "A particular route that a driver regularly takes from their domicile."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cb175cd0-4ab2-4a73-9935-6b46a9214b36",
                                                "sense_id": "587a93bb-92e5-3a28-a089-e405d6b45832",
                                                "text": "I can’t stand this new bid I’m on, even if the mileage is better."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a3f41a8a-28a6-3833-a9cd-425e0fa023aa",
                                        "entry_id": "65148cfc-b60c-38b9-969a-20e210419b2a",
                                        "glosses": [
                                            "A prison sentence."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ceddcb7d-70d2-455a-b3ff-cd2b65a6981d",
                                                "sense_id": "a3f41a8a-28a6-3833-a9cd-425e0fa023aa",
                                                "text": "So we ‘lawyered up’. That’s how they say it in the bucket, son, where I did an eight-hour bid."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
