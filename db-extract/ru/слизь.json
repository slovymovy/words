                        "sense_id": "55a7978b-8c40-349a-abc3-c346039116b1",
                        "entry_id": "c3b90b3f-764e-3220-8db4-41e0e3d6206e",
                        "glosses": [
                            "физиол. тягучая, скользкая масса, выделяемая некоторыми клетками животных и растительных организмов"
                        ],
                        "tags": [],
