                ],
                "senses": [
                    {
                        "sense_id": "0b06a5f6-16bd-31ca-8dfa-c9c80daf68ef",
                        "entry_id": "bf8916c2-dae8-3dad-bda0-68f3d098579d",
                        "glosses": [
                            "Se promener, faire la fête... pendant la nuit."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e336ad3f-a394-4e3f-acad-732610634284",
                                "sense_id": "0b06a5f6-16bd-31ca-8dfa-c9c80daf68ef",
                                "text": "Il faut doubler les brigades de gendarmerie, et il est prudent de ne pas noctambuler seul entre Epernay et Ay, entre Rilly et Reims."
                            },
                            {
                                "example_id": "f836fd74-091a-442d-8f29-220581c5e515",
                                "sense_id": "0b06a5f6-16bd-31ca-8dfa-c9c80daf68ef",
                                "text": "Le ciel blémit, les étoiles pâlissent ; les deux amis continuent à noctambuler, Crispin toujours bavard, Gille à moitié endormi."
                            },
                            {
                                "example_id": "7efdee5c-94d7-4909-99bf-5b2ca8aefe61",
                                "sense_id": "0b06a5f6-16bd-31ca-8dfa-c9c80daf68ef",
                                "text": "Une nuit d'insomnie, le colonel Sant'Agata se mit à « noctambuler » par la ville."
                            },
                            {
                                "example_id": "35b51007-223f-4710-8b8d-52d8caebc39f",
                                "sense_id": "0b06a5f6-16bd-31ca-8dfa-c9c80daf68ef",
                                "text": "[…] je vivais comme un poète, noctambulant, rêvant, et souvent divaguant […]."
                            }
                        ]
                    }
                ],
