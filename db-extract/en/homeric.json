                        "translation_id": "51df70d5-d9b7-4cc3-bea2-488952feac97",
                        "source_entry_id": "3c21bfce-1424-39fc-8058-dee498e6d886",
                        "source_sense_description": "resembling or relating to the epic poetry of Homer",
                        "target_lang_word": "homérique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
