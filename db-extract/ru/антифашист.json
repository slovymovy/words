                        ]
                    },
                    {
                        "translation_id": "b7e722f2-b7ba-4819-bb88-91f60a991df2",
                        "source_entry_id": "acb27e67-a74b-3971-a642-7eae2f49589e",
                        "source_sense_id": "a067b57d-d082-32d4-8256-d1b525235a8e",
                        "target_lang_word": "Antifaschist",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Antifaschist",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cecb1be7-6178-39d0-8905-b51e557ca764",
                                        "entry_id": "6fa28bf3-bbc0-31d5-99d1-1d133cf9cf07",
                                        "glosses": [
                                            "Vertreter des Antifaschismus"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "deb49e06-5fe4-4eae-9bac-17a4b091780b",
                                                "sense_id": "cecb1be7-6178-39d0-8905-b51e557ca764",
                                                "text": "„ ‚Da sind sie hingerichtet worden, die Antifaschisten, nicht wahr Herr Wachtmeister?‘ Er sah mich schräg an und nickte: ‚Ja, da hat der [Johann] Reichart gehaust …‘ “"
                                            },
                                            {
                                                "example_id": "dab4561c-9168-4631-804c-3a1918e83df3",
                                                "sense_id": "cecb1be7-6178-39d0-8905-b51e557ca764",
                                                "text": "„Nehru war ein entschlossener Antifaschist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "49e0727c-e033-48b6-9167-da5c7e385b39",
                        "source_entry_id": "acb27e67-a74b-3971-a642-7eae2f49589e",
                        "source_sense_id": "a067b57d-d082-32d4-8256-d1b525235a8e",
                        "target_lang_word": "antyfaszysta",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "antyfaszysta",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "e3c82b5f-885e-3d8a-a95d-af7a56d251c1",
                                        "entry_id": "5ebd483e-e6f7-3131-b72b-e90b29ccf490",
                                        "glosses": [
                                            "przeciwnik faszyzmu"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3fa65e28-e96e-4fea-8258-905984d4d935",
                                                "sense_id": "e3c82b5f-885e-3d8a-a95d-af7a56d251c1",
                                                "text": "Wśród antyfaszystów są komuniści, socjaliści, liberałowie, konserwatyści oraz ludzie wszelkich światopoglądów i ideologii."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ed40cc90-4a58-40c6-8ad9-9d21418eb985",
                        "source_entry_id": "acb27e67-a74b-3971-a642-7eae2f49589e",
                        "source_sense_id": "a067b57d-d082-32d4-8256-d1b525235a8e",
                        "target_lang_word": "antifasciste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "antifasciste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "02d90703-9be2-30b0-932a-ad1eb9f5c4e0",
                                        "entry_id": "aaf75736-8e9c-392e-923a-d1a3f5a0f85b",
                                        "glosses": [
                                            "Opposé·e au fascisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a4bdd30-6936-4bb0-b082-be59cbe17258",
                                                "sense_id": "02d90703-9be2-30b0-932a-ad1eb9f5c4e0",
                                                "text": "Cette participation des femmes à la lutte antifasciste prit deux formes : engagement des femmes dans l’armée régulière ou les combats de guérillas, participation massive à la production de guerre."
                                            },
                                            {
                                                "example_id": "6728d595-823e-4cdf-92b2-e9a7e7f730cc",
                                                "sense_id": "02d90703-9be2-30b0-932a-ad1eb9f5c4e0",
                                                "text": "Institutrice à Mazeray, elle a milité au sein de la Ligue des droits de l’homme et adhéré en 1934 à un Comité antifasciste."
                                            },
                                            {
                                                "example_id": "e6089466-8d7a-436d-9fe4-dde8c72e9726",
                                                "sense_id": "02d90703-9be2-30b0-932a-ad1eb9f5c4e0",
                                                "text": "La lutte antifasciste doit évaluer les menaces réelles en agissant où cela est opportun : c’est à dire ni dans les contre-manifestations systématiques aux dates dictées par les fascistes (même s’il n’est pas question de leur laisser la maîtrise de la rue), ni dans des mobilisations qui n’opposent au fascisme que la démocratie bourgeoise. Nous voulons être à l’initiative."
                                            },
                                            {
                                                "example_id": "e9dc1c1f-d4a3-4105-8194-978a04d284ba",
                                                "sense_id": "02d90703-9be2-30b0-932a-ad1eb9f5c4e0",
                                                "text": "La persistance jusque dans les années 1970 des dictatures franquiste et salazariste, clairement situées dans le « champ magnétique du fascisme », de même que les coups d’État militaires en Grèce et au Chili, mais aussi en Argentine ou encore au Brésil, eurent néanmoins pour effet de maintenir vivantes la mémoire et la lutte antifascistes, du moins au sein de la gauche."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "antifasciste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9ac71cd4-0e5d-35f0-8da4-63752c03cff7",
                                        "entry_id": "55dab3e0-8b53-3a1b-a600-d9fffbcfb8de",
                                        "glosses": [
                                            "Opposant au fascisme."
                                        ],
                                        "tags": [
                                            "Antifascisme"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b15d45a8-98cd-4ddf-a4c1-7ab5b720e88e",
                                                "sense_id": "9ac71cd4-0e5d-35f0-8da4-63752c03cff7",
                                                "text": "Les antifascistes et les anarchistes ont défilé contre le régime."
                                            },
                                            {
                                                "example_id": "dd3cea31-5dd1-4c51-8499-a68a5ebd3956",
