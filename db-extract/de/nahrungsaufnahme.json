                "senses": [
                    {
                        "sense_id": "748b75a4-946b-35dc-8180-3b0fb3c4d41b",
                        "entry_id": "419efc11-5e0a-3996-944b-7cee5a03ee33",
                        "glosses": [
                            "Vorgang des Zuführens von Nahrung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a637d83-53e9-45c4-b231-9f2fd318d667",
                                "sense_id": "748b75a4-946b-35dc-8180-3b0fb3c4d41b",
                                "text": "Als die Amsel in der Früh erwachte, begann sie mit der Nahrungsaufnahme."
                            },
                            {
                                "example_id": "1370a471-418e-408a-bc59-3bd3723efc55",
                                "sense_id": "748b75a4-946b-35dc-8180-3b0fb3c4d41b",
                                "text": "Nach der mittaglichen Nahrungsaufnahme legte er sich hin und machte ein Mittagsschläfchen."
                            },
                            {
                                "example_id": "7d346f7c-92b7-4691-a1db-75ee59ec9752",
                                "sense_id": "748b75a4-946b-35dc-8180-3b0fb3c4d41b",
                                "text": "„Er kann sich nicht mehr durchgängig mitteilen, er isst immer weniger und bekommt eine Lungenentzündung, dann verweigert er die Nahrungsaufnahme.“"
                            },
                            {
                                "example_id": "bb705f32-7c29-46c6-ada8-724042786662",
                                "sense_id": "748b75a4-946b-35dc-8180-3b0fb3c4d41b",
                                "text": "„Neun Tage lang verweigerte er die Nahrungsaufnahme, er wurde in ein Lazarett gesteckt, dort spielte er so lange den Deppen, bis ein Arzt diese Diagnose übernahm.“"
                            },
                            {
                                "example_id": "ff4dffab-9a15-454b-9e49-f921a4abe73d",
                                "sense_id": "748b75a4-946b-35dc-8180-3b0fb3c4d41b",
                                "text": "„Das konnte von der Nahrungsaufnahme herrühren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
