                            {
                                "example_id": "85b2dc18-0b7e-4240-9e9c-c3bafe0e4f45",
                                "sense_id": "c0a7bd21-5fe7-369f-ae12-57b0c6e4d14a",
                                "text": "Pardonnez-moi belle Dingote\nExcusez-moi noble Dingo"
                            },
                            {
                                "example_id": "7a1a789d-34bb-4975-a259-2132b357ec95",
                                "sense_id": "c0a7bd21-5fe7-369f-ae12-57b0c6e4d14a",
                                "text": "Elle en était coiffée, et maintenant qu’elle ne pouvait plus fouiller dans son bazar à vices, parce que, révérence parlée, elle voulait à tout prix se rendre dingote, elle bouffait du charbon et s’envoyait des lampées de pétrole."
                            }
                        ]
