                    {
                        "translation_id": "a6ce0a11-5817-44b8-a026-951e578ff0fa",
                        "source_entry_id": "2de7a980-cb1d-3a76-b47c-69dfd8a953d7",
                        "source_sense_description": "Fratercula arctica",
                        "target_lang_word": "macareux",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "macareux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f9876155-7a4e-31ab-a5e7-06b1b903ee05",
                                        "entry_id": "ea5691c5-3505-3a70-b01b-8a9054460477",
                                        "glosses": [
                                            "Oiseau marin de la famille des alcidés au plumage noir et blanc et au bec coloré, vivant en colonies dans les régions tempérées fraîches de l'Atlantique et du Pacifique nord."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "14c1650d-e792-4e1f-907b-3f4cae7fe4d7",
                                                "sense_id": "f9876155-7a4e-31ab-a5e7-06b1b903ee05",
                                                "text": "L’informe macareux, qui semble la caricature d'une caricature, le perroquet lui ressemble par un gros bec, mal dégrossi, mais sans tranchant ni force, sans queue et mal équilibré, il peut toujours être emporté par le poids de sa grosse tête. Il se hasarde à voleter pourtant au risque des culbutes. Il plane noblement tout près de terre et fait l’envie peut-être des manchots et des phoques."
                                            },
                                            {
                                                "example_id": "ed4e35ad-140d-40ec-a875-11ac71f8389f",
                                                "sense_id": "f9876155-7a4e-31ab-a5e7-06b1b903ee05",
                                                "text": "L’Islande est un lieu de séjour préférentiel pour les oiseaux de mer : sternes, macareux, fous de Bassan et bien d’autres."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "34992238-967e-4aee-90a3-9941a4e166dc",
                        "source_entry_id": "2de7a980-cb1d-3a76-b47c-69dfd8a953d7",
                        "source_sense_description": "Fratercula arctica",
                        "target_lang_word": "Lund",
