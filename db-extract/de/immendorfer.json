                        "entry_id": "42ce2fbc-e8c6-3f4f-8023-819b8d02061f",
                        "glosses": [
                            "zu den verschiedenen Toponymen namens Immendorf, sich auf dieses Toponym Immendorf beziehend, in der Art und Weise dieses Ortes Immendorf, aus Immendorf kommend, stammend, Immendorf betreffend, zu Immendorf gehörend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f4bb30ef-4dc3-46b9-bb7c-b7a634606f45",
                                "sense_id": "3b91ebab-15ff-321e-a005-c69034fd28b9",
                                "text": "„Erstmals erwähnt werden die ImmendorferJuden als sich zwei von Ihnen in Arenberg 1773 taufen ließen.“"
                            },
                            {
                                "example_id": "53af0d3c-ad68-42a0-a22f-2bb3f6688cdc",
                                "sense_id": "3b91ebab-15ff-321e-a005-c69034fd28b9",
                                "text": "Eines der ältesten Strukturelemente ist die neu gefundene und neu benannte Immendorfer Störung.“"
                            },
                            {
                                "example_id": "c6e88ce7-af80-42cb-aea6-3f0003507f66",
                                "sense_id": "3b91ebab-15ff-321e-a005-c69034fd28b9",
                                "text": "„Bald fand man am Wege den Immendorfer Religionslehrer, sterbend und zwischen einer Zahl Steine liegend, die über Kopfgröße hatten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
