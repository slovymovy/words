                    },
                    {
                        "form_id": "b03e505c-4f89-4f05-ad8e-1fccf097ff2e",
                        "entry_id": "e7aa554b-eeaa-3c81-b274-32fb19c2c70e",
                        "tags": [
                            "plural"
                        ],
                        "form": "arrières-cuisines"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "dbd076c4-8df0-3bc7-b2c5-3fb772f3faac",
                        "entry_id": "e7aa554b-eeaa-3c81-b274-32fb19c2c70e",
                        "glosses": [
                            "Petite pièce située derrière la cuisine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "067af8eb-e436-4f6a-9037-085a24e55e95",
                                "sense_id": "dbd076c4-8df0-3bc7-b2c5-3fb772f3faac",
                                "text": "Madame Yearsley, un peu avant l’heure où elle s’attendoit à revoir son mari, jugea à propos de descendre dans une arrière-cuisine, pour prendre un demi-bain."
                            },
                            {
                                "example_id": "0995a25b-ec67-4fbe-a154-fa7cbdfa6064",
                                "sense_id": "dbd076c4-8df0-3bc7-b2c5-3fb772f3faac",
                                "text": "Je m’aperçus peu à peu que la douceur, la componction, les vertus de Françoise cachaient des tragédies d’arrière-cuisine, comme l’histoire découvre que le règne des Rois et des Reines qui sont représentés les mains jointes dans les vitraux des églises, furent marqués d’incidents sanglants."
                            },
                            {
                                "example_id": "10efc23f-02d9-4514-ad82-feb77fda7daa",
                                "sense_id": "dbd076c4-8df0-3bc7-b2c5-3fb772f3faac",
                                "text": "La maîtresse des Écarts distillait dans son arrière-cuisine une quantité de marc — d’eau ardente, elle appelait ça — qui dépassait largement le plafond légal concédé aux possesseurs de vigne."
                            },
                            {
                                "example_id": "792c2f01-2899-4f18-a4d0-6cb4e0afdbe1",
                                "sense_id": "dbd076c4-8df0-3bc7-b2c5-3fb772f3faac",
                                "text": "Le jour même de son retour, il dit à Joseph et à moi que nous aurions désormais a demeurer dans l’arrière-cuisine et à lui laisser la maison."
                            }
                        ]
                    },
                    {
                        "sense_id": "bab10e7c-bd35-321a-b886-ea716bd5a97a",
                        "entry_id": "e7aa554b-eeaa-3c81-b274-32fb19c2c70e",
                        "glosses": [
                            "Cuisine située en arrière d’une salle de café ou de restaurant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea6f6faf-9e58-41d5-81a8-1d3f5d68fce4",
                                "sense_id": "bab10e7c-bd35-321a-b886-ea716bd5a97a",
                                "text": "La babillerie d’Aline lui était importune et il eût aimé qu’elle enrubannât de quelques vives métaphores ces charités d’arrière-cuisine."
                            }
                        ]
                    },
                    {
                        "sense_id": "27a6f606-b952-3cb8-9110-38c60ab011a3",
                        "entry_id": "e7aa554b-eeaa-3c81-b274-32fb19c2c70e",
                        "glosses": [
                            "Lieu de fabrication."
                        ],
                        "tags": [
                            "analogy",
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "1035cd0d-8ad1-4bd8-a43d-c15b58856866",
                                "sense_id": "27a6f606-b952-3cb8-9110-38c60ab011a3",
                                "text": "Une plongée dans les arrière-cuisines de la mode où l’on croise des dizaines de travailleurs admirés pour leur position mais précaires."
                            }
                        ]
                    }
                ],
