                ],
                "senses": [
                    {
                        "sense_id": "8e552e1b-d73a-30c0-b63d-26f1dd00b7c5",
                        "entry_id": "bdea7185-1ef5-3db5-a6bf-a43d4e255477",
                        "glosses": [
                            "Gotteshaus zu Ehren des Apostels Bartholomäus ^(→ WP), das für Gottesdienste genutzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ea9c299-ae99-4a69-861d-c03f3ac09166",
                                "sense_id": "8e552e1b-d73a-30c0-b63d-26f1dd00b7c5",
                                "text": "„Seinen Ursprung hat der Schäferlauf tatsächlich bereits im Mittelalter anlässlich der Kirchweih der Bartholomäuskirche und eines damit verbundenen großen Jahrmarkts am 24. August, dem Bartholomäustag.“"
                            },
                            {
                                "example_id": "b278987a-3c2c-43ce-9d71-3b897b0ac19a",
                                "sense_id": "8e552e1b-d73a-30c0-b63d-26f1dd00b7c5",
                                "text": "„Schon die romanische Vorgängerkirche war ursprünglich dem heiligen Bartholomäus geweiht und wie andere alte Bartholomäuskirchen auf den Sonnenaufgang am 24. August ausgerichtet.“"
                            },
                            {
                                "example_id": "ff932790-6b39-4406-95b6-1252ae044e67",
                                "sense_id": "8e552e1b-d73a-30c0-b63d-26f1dd00b7c5",
                                "text": "„Die Bartholomäuskirche in Nordheim im Landkreis Heilbronn im nördlichen Baden-Württemberg ist eine evangelische Pfarrkirche.“"
                            },
                            {
                                "example_id": "3b792349-81b6-4911-a949-ec60937469dd",
                                "sense_id": "8e552e1b-d73a-30c0-b63d-26f1dd00b7c5",
                                "text": "„Dazu habe der Klerus in der Bartholomäuskirche eine Heilig-Geist-Messe gesungen“"
                            },
                            {
                                "example_id": "22d739c9-8429-4fe2-bc47-89cbd2fe21af",
                                "sense_id": "8e552e1b-d73a-30c0-b63d-26f1dd00b7c5",
                                "text": "„In einem Kriege des Grafen drangen die Feinde in die Stadt ein und steckten die Bartholomäuskirche in Brand (1275).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
