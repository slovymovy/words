                        "examples": [
                            {
                                "example_id": "48c81c34-b184-448f-8354-9def7af98afa",
                                "sense_id": "28ba2507-2df3-35ca-bc3e-c1cc65628a10",
                                "text": "Cavaliers ‘boast wonderfully and swear most hellishly’, wrote a young Roundhead, and although they prayed too, they did so less ostentatiously, like Sir Jacob Astley before the battle of Edgehill – ‘O Lord, Thou knowest how busy I must be this day: if I forget Thee, do not Thou forget me.’"
                            }
                        ]
