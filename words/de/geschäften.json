                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In vielen <w>Geschäften</w> kann man heute ganz bequem mit der Karte bezahlen.",
                            "target_lang_translations": {
                                "en": "In many <w>shops</w>, you can easily pay by card today.",
                                "ru": "Во многих <w>магазинах</w> сегодня можно очень удобно расплатиться картой.",
                                "nl": "In veel <w>winkels</w> kun je tegenwoordig heel gemakkelijk met de kaart betalen.",
                                "pl": "W wielu <w>sklepach</w> można dzisiaj bardzo wygodnie płacić kartą.",
                                "fr": "Dans de nombreux <w>magasins</w>, on peut aujourd'hui payer très facilement par carte.",
                                "it": "In molti <w>negozi</w> oggi si può pagare comodamente con la carta.",
                                "cs": "V mnoha <w>obchodech</w> se dnes dá velmi pohodlně platit kartou.",
                                "tr": "Günümüzde birçok <w>mağazada</w> kartla çok rahat bir şekilde ödeme yapılabiliyor.",
                                "es": "Hoy en día se puede pagar muy cómodamente con tarjeta en muchas <w>tiendas</w>.",
                                "zh": "如今在很多<w>商店</w>都可以非常方便地刷卡支付。"
                            }
                        },
                        {
                            "text": "Wir haben gestern in mehreren <w>Geschäften</w> nach einem passenden Geburtstagsgeschenk gesucht.",
                            "target_lang_translations": {
                                "en": "Yesterday, we looked for a suitable birthday gift in several <w>stores</w>.",
                                "ru": "Вчера мы искали подходящий подарок на день рождения в нескольких <w>магазинах</w>.",
                                "nl": "We hebben gisteren in verschillende <w>winkels</w> naar een passend verjaardagscadeau gezocht.",
                                "pl": "Szukaliśmy wczoraj w kilku <w>sklepach</w> odpowiedniego prezentu urodzinowego.",
                                "fr": "Hier, nous avons cherché un cadeau d'anniversaire approprié dans plusieurs <w>magasins</w>.",
                                "it": "Ieri abbiamo cercato un regalo di compleanno adatto in diversi <w>negozi</w>.",
                                "cs": "Včera jsme v několika <w>obchodech</w> hledali vhodný dárek k narozeninám.",
                                "tr": "Dün birkaç <w>mağazada</w> uygun bir doğum günü hediyesi aradık.",
                                "es": "Ayer buscamos un regalo de cumpleaños adecuado en varias <w>tiendas</w>.",
                                "zh": "昨天我们在好几家<w>商店</w>寻找合适的生日礼物。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "in vielen Geschäften"
                    ],
