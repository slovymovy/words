                "senses": [
                    {
                        "sense_id": "608f93ad-12da-3ca9-908c-70be2951e88a",
                        "entry_id": "01fddc01-86f6-3703-8d07-0b45c960e93b",
                        "glosses": [
                            "книжн. то же, что кал, экскременты"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f38ef314-b27e-4593-b02f-f737ec541305",
                                "sense_id": "608f93ad-12da-3ca9-908c-70be2951e88a",
                                "text": "В кишечнике человека обитают и энтерококки, они выделяются с фекалиями, хорошо сохраняются во внешней среде и поэтому могут служить индикатором фекального загрязнения среды."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3dd606af-9510-4aa7-83e5-bb39d96e7bdd",
                        "source_entry_id": "01fddc01-86f6-3703-8d07-0b45c960e93b",
                        "source_sense_id": "608f93ad-12da-3ca9-908c-70be2951e88a",
                        "target_lang_word": "faeces",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "faeces",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a757bd70-34e5-355b-a9db-f70436013eb7",
                                        "entry_id": "0676776b-bfb1-3efd-8e5c-b72240a03b22",
                                        "glosses": [
                                            "Alternative spelling of feces."
                                        ],
                                        "tags": [
                                            "Commonwealth",
                                            "alt-of",
                                            "alternative",
                                            "plural",
                                            "plural-normally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fcf0bb1f-68a7-484f-9e8f-5e923b310546",
                                                "sense_id": "a757bd70-34e5-355b-a9db-f70436013eb7",
                                                "text": "This paper reports on ingestion of soil by dairy cows using titanium analysis of faeces by the X-ray fluorescence technique, and gives the range of soil intakes of a year on both an individual and a herd basis."
                                            },
                                            {
                                                "example_id": "25706708-96f6-4d03-9f7c-dec6f49982b0",
                                                "sense_id": "a757bd70-34e5-355b-a9db-f70436013eb7",
                                                "text": "The fact that dogs have a well developed sense of smell suggests that they might be able to use the odour of faeces as a means of communicating."
                                            },
                                            {
                                                "example_id": "7b68b0b3-be42-4f4e-845c-5ae39be351e6",
                                                "sense_id": "a757bd70-34e5-355b-a9db-f70436013eb7",
                                                "text": "Urine and faeces are complete fertilizers of high quality with low levels of contaminants such as heavy metals. Urine is rich in nitrogen, while faeces are rich in phosphorous, potassium and organic matter."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
