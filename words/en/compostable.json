    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "c3ae9375-b179-3351-871d-d1f127013aef",
                    "sense_definition": "Capable of decaying biologically into compost without leaving toxic residues",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "compost_suitability",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cafe serves takeout coffee in <w>compostable</w> cups to reduce plastic waste.",
                            "target_lang_translations": {
                                "pl": "Kawiarnia serwuje kawę na wynos w <w>kompostowalnych</w> kubkach, aby ograniczyć ilość odpadów z tworzyw sztucznych."
                            }
                        },
                        {
                            "text": "Make sure to put all <w>compostable</w> materials into the green bin.",
                            "target_lang_translations": {
                                "pl": "Upewnij się, że wszystkie materiały <w>nadające się do kompostowania</w> trafiają do zielonego kosza."
                            }
                        }
                    ],
                    "synonyms": [
                        "biodegradable"
                    ],
                    "antonyms": [
                        "non-biodegradable"
                    ],
                    "common_phrases": [
                        "compostable packaging",
                        "compostable waste",
                        "compostable bags"
                    ],
                    "target_lang_definitions": {
                        "pl": "Nadający się do rozkładu biologicznego w kompostowniku bez pozostawiania toksycznych pozostałości"
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "kompostowalny",
                                "target_lang_sense_clarification": "nadający się do kompostowania"
                            },
                            {
                                "target_lang_word": "nadający się do kompostowania",
                                "target_lang_sense_clarification": "ulegający rozkładowi na kompost"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "de0279cc-9cc1-33ed-95dd-6cca61aa1571",
                    "sense_definition": "An item or material that is suitable to be turned into compost",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "compost_suitability",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Separate your plastics from the <w>compostables</w> before throwing them away.",
                            "target_lang_translations": {
                                "pl": "Oddziel plastik od <w>odpadów kompostowalnych</w> przed ich wyrzuceniem."
                            }
                        },
                        {
                            "text": "Each household was given a separate container for collecting food scraps and other <w>compostables</w>.",
                            "target_lang_translations": {
                                "pl": "Każde gospodarstwo domowe otrzymało osobny pojemnik na resztki jedzenia i inne <w>bioodpady</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Materiał lub przedmiot organiczny nadający się do przetworzenia na kompost"
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "odpady kompostowalne",
                                "target_lang_sense_clarification": "materiały nadające się do kompostu"
                            },
                            {
                                "target_lang_word": "bioodpady",
                                "target_lang_sense_clarification": "odpady organiczne ulegające biodegradacji"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}