                    "sense_id": "fc9f125a-e25e-3396-bd15-e6e9331c3cc9",
                    "sense_definition": "Multiplied by a hundred.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "multiplication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company saw a <w>hundredfold</w> increase in profits after the new product launch.",
                            "target_lang_translations": {
                                "zh": "新产品发布后，公司的利润实现了<w>百倍</w>增长。"
                            }
                        },
                        {
                            "text": "The <w>centuple</w> growth was unexpected, making the project <w>hundredfold</w> more complex than anticipated.",
                            "target_lang_translations": {
                                "zh": "这种百倍的增长出人意料，使项目的复杂程度比预期增加了<w>百倍</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "centuple"
                    ],
                    "common_phrases": [
                        "hundredfold increase"
                    ],
                    "target_lang_definitions": {
                        "zh": "增加到一百倍的；百倍的"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "百倍的",
                                "target_lang_sense_clarification": "形容数量增加到一百倍"
                            }
                        ]
                    }
                }
            ]
        },
        {
