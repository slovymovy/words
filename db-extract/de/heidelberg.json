                "senses": [
                    {
                        "sense_id": "4e552ef5-e7f5-393b-8f94-ec4aa81cf112",
                        "entry_id": "6643883a-104f-36bb-a425-76948cf90fe0",
                        "glosses": [
                            "Stadt im nordwestlichen Baden-Württemberg"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "09bc6780-72f4-42b6-9294-5ebb65ced023",
                                "sense_id": "4e552ef5-e7f5-393b-8f94-ec4aa81cf112",
                                "text": "Heidelberg liegt am Neckar."
                            },
                            {
                                "example_id": "8041066b-8df6-47bb-b50a-1441df3820cc",
                                "sense_id": "4e552ef5-e7f5-393b-8f94-ec4aa81cf112",
                                "text": "„Als traditionelle Orte der Namenforschung im deutschsprachigen Raum sind Lüneburg, Heidelberg, Mainz und Wiesbaden sowie mit Statistiken auch Zentren in Österreich und der Schweiz zu nennen.“"
                            },
                            {
                                "example_id": "7d6bcf84-c6e8-43b9-beac-2073cd914035",
                                "sense_id": "4e552ef5-e7f5-393b-8f94-ec4aa81cf112",
                                "text": "„Später wird Twain in seinem Stammgasthaus in Heidelberg bei einem Bier erzählen, Germania sei eine schöne Dame, nur leider reichlich verwirrt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "df529141-287e-3813-b2fb-1552087a4a8d",
                        "entry_id": "6643883a-104f-36bb-a425-76948cf90fe0",
                        "glosses": [
                            "Stadt in der südafrikanischen Provinz Gauteng"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "82da1364-75ba-4c18-b4a4-3b1946d6e99b",
                                "sense_id": "df529141-287e-3813-b2fb-1552087a4a8d",
                                "text": "„Kruger betonte seine guten Absichten in drei versöhnlichen Reden, am 18. März in Heidelberg, am 27. März in Rustenburg und am 1. April in Johannesburg selbst.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
