                                "target_senses": [
                                    {
                                        "sense_id": "6886b821-dac1-3c19-b6f5-06f792c091f7",
                                        "entry_id": "ed796df6-b781-39f6-ae62-1a40b1dacd4c",
                                        "glosses": [
                                            "altes, russisches Gewichtsmaß von 16,38 Kilogramm"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "302d49c7-7823-4fc0-a70a-8c130cd73288",
                                                "sense_id": "6886b821-dac1-3c19-b6f5-06f792c091f7",
                                                "text": "„Einer sagt, Napoleon sei nach Moskau gegangen, weil er es eben gewollt habe, und habe dort seinen Untergang gefunden, weil Alexander ihm eben den Untergang bereiten wollte; und ein anderer sagt, ein viele Millionen Pud schwerer Berg, der unterhöhlt wurde und schliesslich zusammenstürzte, sei nur infolge des letzten Schlages zusammengestürzt, den der letzte Arbeiter mit seiner Keilhaue geführt habe; und beide haben sie gleich recht und gleich unrecht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4dfd5a0d-245f-4ace-bcc6-78d2df776104",
                        "source_entry_id": "2967d6e3-3364-3fa8-9a51-cc05a5ea629d",
