                "senses": [
                    {
                        "sense_id": "8922694d-fcda-357e-bec4-51ea6a769aac",
                        "entry_id": "1ab8c765-7bb2-3882-95e8-72eb82f06cd4",
                        "glosses": [
                            "Produktion von Hormonen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7faffb09-edc0-4308-8e2b-d67951cc48a7",
                                "sense_id": "8922694d-fcda-357e-bec4-51ea6a769aac",
                                "text": "„Über eine Art Pfortadersystem gelangen die Hormone direkt in das Gewebe des Hypophysenvorderlappens (HVL), wo sie die weitere Hormonproduktion anstoßen.“"
                            },
                            {
                                "example_id": "bbf685be-c22f-401a-9c65-4e90bc4c167d",
                                "sense_id": "8922694d-fcda-357e-bec4-51ea6a769aac",
                                "text": "„Eine Hypothese geht davon aus, daß die Hormonproduktion durch einen kritischen Schwellenwert im Körpergewicht aktiviert wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
