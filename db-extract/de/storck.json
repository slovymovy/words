                "senses": [
                    {
                        "sense_id": "313de036-b42c-3045-a803-7cb59339c63e",
                        "entry_id": "369345fb-5d6a-3349-be90-1e455d2910d5",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9520aa4f-487c-488f-a1fa-77436cc36a2f",
                                "sense_id": "313de036-b42c-3045-a803-7cb59339c63e",
                                "text": "Frau Storck ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "4e759af8-f815-44ca-a340-0206f34b5158",
                                "sense_id": "313de036-b42c-3045-a803-7cb59339c63e",
                                "text": "Herr Storck wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "4955f4ef-b89c-4a19-9ae8-872f1d5f782e",
                                "sense_id": "313de036-b42c-3045-a803-7cb59339c63e",
                                "text": "Die Storcks fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "e29b7a74-7f92-435f-bf19-7150f7731279",
                                "sense_id": "313de036-b42c-3045-a803-7cb59339c63e",
                                "text": "Der Storck trägt nie die Schals, die die Storck ihm strickt."
                            },
                            {
                                "example_id": "f0a2c176-f10e-43cc-946d-0ca6c356bc5c",
                                "sense_id": "313de036-b42c-3045-a803-7cb59339c63e",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Storck kommt, geht der Herr Storck.“"
                            },
                            {
                                "example_id": "0fb48d02-c871-4113-9739-4a969ff13baf",
                                "sense_id": "313de036-b42c-3045-a803-7cb59339c63e",
                                "text": "Storck kommt und geht."
                            },
                            {
                                "example_id": "c07b9122-9801-4935-b4da-1f5de9ddd9f2",
                                "sense_id": "313de036-b42c-3045-a803-7cb59339c63e",
                                "text": "Storcks kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
