                        "examples": [
                            {
                                "example_id": "482cb6d3-4fe7-45e9-9d2e-b765122f1aeb",
                                "sense_id": "3653e9d0-a8aa-3bc4-b98d-d817dbc11258",
                                "text": "De thuisfavoriet dicteerde het baselineduel met Schiavone in de beginfase met haar verwoestende backhands en forehands, die ze beide dubbelhandig slaat. Het leverde haar echter geen enkele breekkans op."
                            },
                            {
                                "example_id": "78ce2fe2-967c-46e7-825b-74143c7b5a7a",
                                "sense_id": "3653e9d0-a8aa-3bc4-b98d-d817dbc11258",
                                "text": "Parra,die zowel haar forehand als haar backhand dubbelhandig slaat, mocht bogen op de mooiste punten van de partij, maar ze kon het de runner-up van 2002 maar een paar games echt lastig maken."
                            }
                        ]
