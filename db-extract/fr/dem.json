                "senses": [
                    {
                        "sense_id": "3c191c8d-7c70-31c2-af0b-5307d21c9712",
                        "entry_id": "12a96275-0392-35dd-ba2d-9606480d76e1",
                        "glosses": [
                            "Diplôme validant la fin du cycle de professionnel initial en musique (environ douze à quatorze ans de pratique instrumentale), en ayant également suivi des enseignements complémentaires de culture artistique."
                        ],
                        "tags": [
                            "France"
                        ],
                        "examples": [
                            {
                                "example_id": "d3053de0-2a6a-4d27-88f1-f7ecca0dcbcf",
                                "sense_id": "3c191c8d-7c70-31c2-af0b-5307d21c9712",
                                "text": "Il poursuit sa formation à la faculté de musicologie de Tours où il obtient sa licence et son DEM (diplôme d’études musicales) de chant."
                            },
                            {
                                "example_id": "c1a9b79c-1be7-4a61-9439-42ffa68c88ba",
                                "sense_id": "3c191c8d-7c70-31c2-af0b-5307d21c9712",
                                "text": "Le DEM est avant tout une reconnaissance individuelle d’un très haut niveau de pratique musicale."
                            },
                            {
                                "example_id": "30f59130-c6d0-4ba4-8f3f-c9c64811264f",
                                "sense_id": "3c191c8d-7c70-31c2-af0b-5307d21c9712",
                                "text": "Les inscriptions au concours d’entrée au DEM au conservatoire Issy-Vanves se déroulent du 1ᵉʳ juillet au 4 septembre 2023."
                            }
                        ]
                    }
