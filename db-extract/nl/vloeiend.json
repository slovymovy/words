                                        "sense_id": "3cd26f5b-b304-34cd-8d07-3734b5e16984",
                                        "entry_id": "c380818a-4a06-3352-9eb5-479fbf8693d3",
                                        "glosses": [
                                            "Able to use a language accurately, rapidly, and confidently."
                                        ],
