                "senses": [
                    {
                        "sense_id": "f9741cae-4f1c-3e94-afed-45185add23a7",
                        "entry_id": "4b62ed9a-611f-3c4b-8be0-6d4828f66d16",
                        "glosses": [
                            "Qui n’a pas atteint la maturité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f260eb35-f5d1-4ff2-abb2-1174769220ec",
                                "sense_id": "f9741cae-4f1c-3e94-afed-45185add23a7",
                                "text": "Les adultes sexuellement immatures se nourrissent sur les rameaux, habituellement au point de jonction entre les nouvelles pousses et celles de l’année précédente."
                            }
                        ]
                    },
                    {
                        "sense_id": "29cd4f96-1e45-3bad-a432-b55bd7a75f07",
                        "entry_id": "4b62ed9a-611f-3c4b-8be0-6d4828f66d16",
                        "glosses": [
                            "Qui fait preuve de peu de maturité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "983f4eed-5197-46a8-ad40-e2e450295d59",
                                "sense_id": "29cd4f96-1e45-3bad-a432-b55bd7a75f07",
                                "text": "Un comportement immature."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0664b22d-85f0-4d35-a030-d25be9c8b816",
                        "source_entry_id": "4b62ed9a-611f-3c4b-8be0-6d4828f66d16",
                        "target_lang_word": "immature",
