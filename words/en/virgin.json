{
    "word_family": [
        "virginity",
        "virginal"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d4b3e447-aa52-3335-beea-ee2ce136e3ed",
                    "sense_definition": "A person who has never had sexual intercourse.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "sexual_inexperience",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She decided to remain a <w>virgin</w> until she found the right partner.",
                            "target_lang_translations": {
                                "ru": "Она решила остаться <w>девственницей</w>, пока не найдет подходящего партнера.",
                                "zh": "她决定在找到合适的伴侣之前保持<w>处女</w>之身。"
                            }
                        },
                        {
                            "text": "He admitted to his friends that he was still a <w>virgin</w>.",
                            "target_lang_translations": {
                                "ru": "Он признался друзьям, что всё ещё <w>девственник</w>.",
                                "zh": "他向朋友们承认自己还是个<w>处男</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "remain a virgin",
                        "still a virgin"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который никогда не имел половых сношений.",
                        "zh": "指从未有过性行为的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "девственница",
                                "target_lang_sense_clarification": "о женщине"
                            },
                            {
                                "target_lang_word": "девственник",
                                "target_lang_sense_clarification": "о мужчине"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "处女",
                                "target_lang_sense_clarification": "指女性"
                            },
                            {
                                "target_lang_word": "处男",
                                "target_lang_sense_clarification": "指男性"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fc57bba4-f1c9-32d8-b3f4-033cc1bff1e7",
                    "sense_definition": "A person who has never experienced a particular activity or thing before.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "general_inexperience",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I am a complete <w>virgin</w> when it comes to computer programming.",
                            "target_lang_translations": {
                                "ru": "Я полный <w>новичок</w> в компьютерном программировании.",
                                "zh": "在计算机编程方面，我完全是个<w>新手</w>。"
                            }
                        },
                        {
                            "text": "As a sushi <w>virgin</w>, he was hesitant to try the raw fish for the first time.",
                            "target_lang_translations": {
                                "ru": "Будучи <w>новичком</w> в поедании суши, он не решался впервые попробовать сырую рыбу.",
                                "zh": "作为一个没吃过寿司的<w>新手</w>，他第一次尝试生鱼片时有些犹豫。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "a total virgin"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used to emphasize lack of experience in a specific field"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, не имеющий опыта в определённой сфере деятельности или никогда не пробовавший чего-либо.",
                        "zh": "指在某项活动或领域中完全没有经验的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "новичок",
                                "target_lang_sense_clarification": "человек без опыта"
                            },
                            {
                                "target_lang_word": "профан",
                                "target_lang_sense_clarification": "неосведомленный человек"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "新手",
                                "target_lang_sense_clarification": "指缺乏经验的人"
                            },
                            {
                                "target_lang_word": "门外汉",
                                "target_lang_sense_clarification": "指外行"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d7b3dcea-e1db-30d8-8143-786f9c2861b2",
                    "sense_definition": "A person, usually a woman, who has vowed to remain chaste for religious reasons, often venerated as a saint.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "religious_figure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The church features a statue of a <w>virgin</w> and martyr from the third century.",
                            "target_lang_translations": {
                                "ru": "В церкви находится статуя <w>девы</w> и мученицы третьего века.",
                                "zh": "教堂里有一尊三世纪的<w>圣女</w>殉道者雕像。"
                            }
                        },
                        {
                            "text": "She lived her life as a consecrated <w>virgin</w> dedicated to prayer and service.",
                            "target_lang_translations": {
                                "ru": "Она прожила жизнь как посвящённая <w>девственница</w>, посвятив себя молитве и служению.",
                                "zh": "她作为一名献身的<w>童贞女</w>度过了一生，致力于祈祷和服务。"
                            }
                        }
                    ],
                    "synonyms": [
                        "vestal"
                    ],
                    "common_phrases": [
                        "consecrated virgin"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "religious context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек (обычно женщина), давший обет целомудрия по религиозным причинам; часто почитается как святая.",
                        "zh": "指因宗教原因发誓保持贞洁的人，常被尊为圣徒。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дева",
                                "target_lang_sense_clarification": "религиозный контекст"
                            },
                            {
                                "target_lang_word": "девственница",
                                "target_lang_sense_clarification": "монахиня или святая"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "圣女",
                                "target_lang_sense_clarification": "宗教语境下的贞洁女性"
                            },
                            {
                                "target_lang_word": "童贞女",
                                "target_lang_sense_clarification": "指守贞的女性"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "92cd87ed-5e86-3c42-9963-1c0d263ec8c4",
                    "sense_definition": "Containing no alcohol; used to describe mixed drinks.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "non_alcoholic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She ordered a <w>virgin</w> mojito because she had to drive home later.",
                            "target_lang_translations": {
                                "ru": "Она заказала <w>безалкогольный</w> мохито, потому что ей нужно было позже вести машину.",
                                "zh": "她点了一杯<w>无酒精</w>莫吉托，因为她稍后要开车回家。"
                            }
                        },
                        {
                            "text": "The bartender can make a <w>virgin</w> version of almost any cocktail on the menu.",
                            "target_lang_translations": {
                                "ru": "Бармен может сделать <w>безалкогольную</w> версию почти любого коктейля из меню.",
                                "zh": "调酒师可以制作菜单上几乎任何鸡尾酒的<w>无酒精</w>版本。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "virgin cocktail",
                        "virgin drink"
                    ],
                    "target_lang_definitions": {
                        "ru": "Не содержащий алкоголя (используется для описания коктейлей и напитков).",
                        "zh": "指不含酒精的饮料。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "безалкогольный",
                                "target_lang_sense_clarification": "о напитках"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "无酒精",
                                "target_lang_sense_clarification": "用于描述饮料"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "de4cfe65-7474-3075-9a67-489b524226eb",
                    "sense_definition": "Used to describe olive oil that is obtained by mechanical means without chemical treatment, retaining its natural flavor.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "culinary_oil",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should use extra <w>virgin</w> olive oil for the salad dressing.",
                            "target_lang_translations": {
                                "ru": "Для заправки салата следует использовать оливковое масло экстра <w>верджин</w>.",
                                "zh": "你应该用特级<w>初榨</w>橄榄油来做沙拉酱。"
                            }
                        },
                        {
                            "text": "This high-quality <w>virgin</w> oil is perfect for dipping bread.",
                            "target_lang_translations": {
                                "ru": "Это высококачественное <w>натуральное</w> масло идеально подходит, чтобы макать в него хлеб.",
                                "zh": "这种优质的<w>初榨</w>油非常适合蘸面包吃。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "extra virgin olive oil",
                        "virgin olive oil"
                    ],
                    "target_lang_definitions": {
                        "ru": "Оливковое масло, полученное механическим способом без химической обработки, сохраняющее естественный вкус.",
                        "zh": "指通过机械方式提取、未经化学处理且保留天然风味的橄榄油。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "первого отжима",
                                "target_lang_sense_clarification": "категория масла"
                            },
                            {
                                "target_lang_word": "натуральное",
                                "target_lang_sense_clarification": "без добавок"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "初榨",
                                "target_lang_sense_clarification": "橄榄油的等级"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c34e7218-d4a1-310e-b77c-0122fee6efd4",
                    "sense_definition": "Not yet cultivated, explored, used, or touched by humans; in a natural state.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "untouched_nature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The explorers trekked through the dense <w>virgin</w> forest for days.",
                            "target_lang_translations": {
                                "ru": "Исследователи целыми днями пробирались через густой <w>девственный</w> лес.",
                                "zh": "探险家们在茂密的<w>原始</w>森林中跋涉了数日。"
                            }
                        },
                        {
                            "text": "Fresh tracks were clearly visible in the <w>virgin</w> snow.",
                            "target_lang_translations": {
                                "ru": "На <w>нетронутом</w> снегу были отчетливо видны свежие следы.",
                                "zh": "在<w>未受破坏的</w>雪地上，清晰可见新鲜的足迹。"
                            }
                        }
                    ],
                    "synonyms": [
                        "pristine",
                        "unspoilt",
                        "untouched"
                    ],
                    "common_phrases": [
                        "virgin forest",
                        "virgin snow",
                        "virgin territory",
                        "virgin wool"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ещё не возделанный, не исследованный и не тронутый человеком; в первозданном состоянии.",
                        "zh": "指尚未被人类开发、探索或触及的自然状态。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "девственный",
                                "target_lang_sense_clarification": "о природе"
                            },
                            {
                                "target_lang_word": "нетронутый",
                                "target_lang_sense_clarification": "неиспользованный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "原始的",
                                "target_lang_sense_clarification": "指自然状态"
                            },
                            {
                                "target_lang_word": "未受破坏的",
                                "target_lang_sense_clarification": "指未被触及的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ae87d751-c4e5-30d5-9b1e-23067d24708c",
                    "sense_definition": "In a state of virginity; not having had sexual intercourse.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "sexual_inexperience",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In ancient legends, only a <w>virgin</w> maiden could approach the unicorn.",
                            "target_lang_translations": {
                                "ru": "В древних легендах только <w>непорочная</w> дева могла приблизиться к единорогу.",
                                "zh": "在古代传说中，只有<w>贞洁的</w>少女才能接近独角兽。"
                            }
                        },
                        {
                            "text": "The concept of a <w>virgin</w> birth is central to the Christian faith.",
                            "target_lang_translations": {
                                "ru": "Концепция <w>непорочного</w> зачатия занимает центральное место в христианской вере.",
                                "zh": "<w>童贞</w>女受孕的概念是基督教信仰的核心。"
                            }
                        }
                    ],
                    "synonyms": [
                        "maiden",
                        "virgo intacta"
                    ],
                    "common_phrases": [
                        "virgin birth"
                    ],
                    "target_lang_definitions": {
                        "ru": "Находящийся в состоянии девственности; не имевший половых сношений.",
                        "zh": "指保持贞洁状态，未曾有过性行为的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "непорочный",
                                "target_lang_sense_clarification": "чистый, целомудренный"
                            },
                            {
                                "target_lang_word": "девственный",
                                "target_lang_sense_clarification": "сохранивший девственность"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "贞洁的",
                                "target_lang_sense_clarification": "指纯洁无瑕"
                            },
                            {
                                "target_lang_word": "童贞的",
                                "target_lang_sense_clarification": "指未曾有过性行为"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "8858e221-ffdf-3fb0-ba35-013dca8c9f05",
                    "sense_definition": "A title used for Mary, the mother of Jesus.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "religious_name",
                    "name_type": "deity_or_religious_name",
                    "examples": [
                        {
                            "text": "Many cathedrals in Europe are dedicated to the <w>Virgin</w>.",
                            "target_lang_translations": {
                                "ru": "Многие соборы в Европе посвящены <w>Деве</w>.",
                                "zh": "欧洲的许多大教堂都是献给<w>圣母</w>的。"
                            }
                        },
                        {
                            "text": "The artist painted a beautiful portrait of the <w>Virgin</w> holding the child.",
                            "target_lang_translations": {
                                "ru": "Художник написал прекрасный портрет <w>Богоматери</w> с младенцем.",
                                "zh": "艺术家画了一幅美丽的<w>圣母</w>抱子像。"
                            }
                        }
                    ],
                    "synonyms": [
                        "Virgin Mary"
                    ],
                    "common_phrases": [
                        "the Blessed Virgin"
                    ],
                    "target_lang_definitions": {
                        "ru": "Титул, используемый для Девы Марии, матери Иисуса.",
                        "zh": "指耶稣的母亲玛利亚。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Дева",
                                "target_lang_sense_clarification": "Богоматерь"
                            },
                            {
                                "target_lang_word": "Богородица",
                                "target_lang_sense_clarification": "Матерь Божья"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "圣母",
                                "target_lang_sense_clarification": "宗教尊称"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}