            "senses": [
                {
                    "sense_id": "b02faa76-9ade-3661-a4bb-0ad6f0c52286",
                    "sense_definition": "Under normal conditions or circumstances; usually; most of the time",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Normally</w>, I eat breakfast at 6am, but today I got up late.",
                            "target_lang_translations": {
                                "ru": "<w>Обычно</w> я завтракаю в 6 утра, но сегодня я встал поздно.",
                                "zh": "<w>通常</w>我早上六点吃早餐，但今天我起晚了。"
                            }
                        },
                        {
                            "text": "We <w>normally</w> go to the park on Sundays if the weather is nice.",
                            "target_lang_translations": {
                                "ru": "Мы <w>обычно</w> ходим в парк по воскресеньям, если погода хорошая.",
                                "zh": "如果天气好，我们<w>通常</w>会在周日去公园。"
                            }
                        }
                    ],
                    "synonyms": [
                        "usually",
                        "generally",
                        "typically",
                        "ordinarily",
                        "commonly",
                        "as a rule",
                        "in general",
                        "frequently"
                    ],
                    "antonyms": [
