                "senses": [
                    {
                        "sense_id": "ee10a210-ea2e-3531-8b78-0b7ad2f1a4c5",
                        "entry_id": "a0f844cb-568d-3802-8e3d-78481fda1653",
                        "glosses": [
                            "Homme fort attaché à ses intérêts et qui fait paraître son avarice jusque dans les plus petites choses."
                        ],
                        "tags": [
                            "dated",
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "2dc45f28-e51c-4086-b485-e16991422787",
                                "sense_id": "ee10a210-ea2e-3531-8b78-0b7ad2f1a4c5",
                                "text": "Un pince-maille avoit tant amassé,\nQu’il ne savoit où loger sa finance.\nL’avarice, compagne et sœur de l’ignorance,\nLe rendoit fort embarrassé\nDans le choix d’un dépositaire […]"
                            },
                            {
                                "example_id": "c2c33b12-7e4e-4a09-a5ef-8bc6cd20a5a2",
                                "sense_id": "ee10a210-ea2e-3531-8b78-0b7ad2f1a4c5",
                                "text": "Des pince-maille sont des personnes qui pincent, qui ne négligent pas une maille. Ainsi les pince-maille sont de deux ou trois degrés plus ladres, plus avides que les grippe-sou."
                            },
                            {
                                "example_id": "3c3fdf0e-942f-4e9d-bf3e-7d9e59f7a2bc",
                                "sense_id": "ee10a210-ea2e-3531-8b78-0b7ad2f1a4c5",
                                "text": "C’est un autre gaillard que le procureur et tous vos pince-maille du chef-lieu, qui regardent chaque kopek."
                            },
                            {
                                "example_id": "2606f92f-9517-45e9-b6f5-cac1e1556e06",
                                "sense_id": "ee10a210-ea2e-3531-8b78-0b7ad2f1a4c5",
                                "text": "C’est le plus grand pince-maille de Moscou. Un bourgeois, quoi !"
                            }
                        ]
                    }
                ],
