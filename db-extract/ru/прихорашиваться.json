                                "target_senses": [
                                    {
                                        "sense_id": "d58539d3-386a-3ff6-ad0c-f8dcdca525a9",
                                        "entry_id": "b9f9d6fc-b833-37e2-8305-939c50407ba2",
                                        "glosses": [
                                            "To dress or arrange smartly, elegantly, and neatly; to smarten."
