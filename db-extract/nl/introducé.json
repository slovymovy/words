                                                "example_id": "c00951ce-8bb8-4ccc-93da-3cf2d2b5f897",
                                                "sense_id": "6663b9ce-99c6-33f8-80fe-8381bb18ba05",
                                                "text": "Vous aurez remarqué que nous avons un invité particulier cette année, ajouta Lady Coalman."
                                            },
