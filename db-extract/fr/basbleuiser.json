                ],
                "senses": [
                    {
                        "sense_id": "ab0fb2c8-c66f-3357-9b74-17bfbd2a3079",
                        "entry_id": "70d8e737-51fd-30c4-a576-2e07afb3e475",
                        "glosses": [
                            "Donner un caractère bas-bleu à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cfd9e594-ce54-4597-a947-c357b312183d",
                                "sense_id": "ab0fb2c8-c66f-3357-9b74-17bfbd2a3079",
                                "text": "On n’en était encore qu’aux escarmouches, quand le Gaulois du 25 novembre insérait une chronique d’Octave Mirbeau, Fleurs et Fruits, consacrée aux lycées qu’on se proposait d’instituer, afin de déniaiser, de savantiser, de basbleuiser, de garçonniser et de viriliser les jeunes filles."
                            }
                        ]
                    },
                    {
                        "sense_id": "e1958d9d-c72c-3a93-bc52-5051e507f347",
                        "entry_id": "70d8e737-51fd-30c4-a576-2e07afb3e475",
                        "glosses": [
                            "Se montrer bas-bleu, être une femme avec des prétentions littéraires."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "4e22245b-bd70-41c9-a462-67da271b6a31",
                                "sense_id": "e1958d9d-c72c-3a93-bc52-5051e507f347",
                                "text": "C’est un péché de laver des aquarelles et de basbleuiser; c’est un crime d’assister à une course de taureaux ou à une Offenbacherie ; c’est une scélératesse de faire tourner une table."
                            }
                        ]
                    }
