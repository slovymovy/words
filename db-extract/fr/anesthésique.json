            {
                "entry_id": "5c5448ba-e225-3883-be52-fd5f2c503d8e",
                "word": "anesthésique",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "0fb42de4-771a-45fe-93fe-67731f53cb71",
                        "entry_id": "5c5448ba-e225-3883-be52-fd5f2c503d8e",
                        "tags": [
                            "plural"
                        ],
                        "form": "anesthésiques"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e2fa3cc1-7f42-38c7-a35c-25e7019a1e2b",
                        "entry_id": "5c5448ba-e225-3883-be52-fd5f2c503d8e",
                        "glosses": [
                            "Substance, produit anesthésique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c52430a9-192a-4b31-b73f-29570e4625a1",
                                "sense_id": "e2fa3cc1-7f42-38c7-a35c-25e7019a1e2b",
                                "text": "Cent mètres plus loin, ils commencèrent à sentir l'odeur des anesthésiques."
                            },
                            {
                                "example_id": "a77db3e7-e4a7-4da9-9010-bf8e828de7f1",
                                "sense_id": "e2fa3cc1-7f42-38c7-a35c-25e7019a1e2b",
                                "text": "Les anesthésiques sont des médicaments qui rendent l’animal insensible à la douleur. Les anesthésiques généraux rendent l’animal inconscient. Les techniciens expérimentés les utilisent quand ils doivent faire des opérations compliquées. En revanche, les anesthésiques locaux, n’ont un effet que sur la partie du corps qui se trouve à côté de l’endroit où ils ont été appliqués ou injectés."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7ad9098b-38cd-4795-a66d-05583ef8c4be",
                        "source_entry_id": "5c5448ba-e225-3883-be52-fd5f2c503d8e",
                        "source_sense_id": "e2fa3cc1-7f42-38c7-a35c-25e7019a1e2b",
                        "target_lang_word": "anesthetic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anesthetic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4f9ac0a7-81ca-32e8-b5e0-36bad8c6dcda",
                                        "entry_id": "03e19fa1-623c-3722-8aeb-161dbc883645",
                                        "glosses": [
                                            "Causing anesthesia; reducing pain sensitivity."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6e801dc0-c70f-394c-bca0-ef6da3ab8345",
                                        "entry_id": "03e19fa1-623c-3722-8aeb-161dbc883645",
                                        "glosses": [
                                            "Insensate: unable to feel, or unconscious."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8da0d7b2-ed7b-4a72-8465-ccba045cb4e8",
                                                "sense_id": "6e801dc0-c70f-394c-bca0-ef6da3ab8345",
                                                "text": "(I find that he is analgesic and anaesthetic; evidently he is in a state of passive somnambulism.)\nE. A. Did you feel anybody touch you?\nK. No. There's no one near me. (He continues laughing and talking. […])"
                                            },
                                            {
                                                "example_id": "343d61d7-cc98-4628-b3bb-5f13e84bdc16",
                                                "sense_id": "6e801dc0-c70f-394c-bca0-ef6da3ab8345",
                                                "text": "Though physically capable of attaining sex rewards, he is anesthetic; though capable of aggression, he is meek; though capable of affection, he is cold and unresponsive."
                                            },
                                            {
                                                "example_id": "a6e367f8-cd8f-4489-a435-0753b5b8537a",
                                                "sense_id": "6e801dc0-c70f-394c-bca0-ef6da3ab8345",
                                                "text": "He is anesthetic to their theological and political enthusiasms. He finds himself an alien at their feasts of soul."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "anesthetic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "00d8156b-4ae3-3969-b91f-87d7fea72260",
                                        "entry_id": "e1329de9-bb9f-32fc-ae22-a5217f5f3e62",
                                        "glosses": [
                                            "A substance administered to reduce the perception of pain or to induce numbness for surgery and may render the recipient unconscious."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fad39b6f-8104-4f92-9a4f-2b36b57a8029",
                                                "sense_id": "00d8156b-4ae3-3969-b91f-87d7fea72260",
                                                "text": "After a local anesthetic is applied to the eye, do not rub or wipe the eye until the anesthetic has worn off and feeling in the eye returns."
                                            },
                                            {
                                                "example_id": "7693c933-d844-4a99-990b-6db67ae35863",
                                                "sense_id": "00d8156b-4ae3-3969-b91f-87d7fea72260",
                                                "text": "Modern anesthetics can be divided into several different groups according to how and where they act to reduce pain.\nDuring premedication, the anesthetist may give a patient drugs that make him or her feel relaxed and drowsy before the actual general anesthetic is administered."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
