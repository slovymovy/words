                            {
                                "example_id": "6802bdf6-cdf2-40ee-8ddd-9afc1540dfe1",
                                "sense_id": "bf0ace66-0238-317b-8e03-7da7908a6fcc",
                                "text": "„Doch es ist trotzdem verblüffend, wenn dort, wo eben tristes, winterbraunes Garnichts war, zaghaft ein paar grüne Blättchen sprießen.“"
                            },
                            {
                                "example_id": "30fffd76-aca0-42bc-8f72-451c5605d379",
                                "sense_id": "bf0ace66-0238-317b-8e03-7da7908a6fcc",
                                "text": "„Später kam ihm der Gedanke, dass er sich schrecklich wichtigtuerisch angehört haben muss, denn genau genommen war er ja bloß ein neugieriger amerikanischer Tourist mit einem Visum und der Gebieter von Garnichts.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
