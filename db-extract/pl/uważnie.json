                                            {
                                                "example_id": "3aa4e31f-8534-40eb-9a26-949c27fe4c21",
                                                "sense_id": "09370a32-5f2c-3110-a20e-5290abfeab6a",
                                                "text": "There are some low-tech approaches to forming those good posture habits, like the Alexander Method. The Alexander Method is a process that helps realign posture mindfully. It’s often used by performers, and often involves a coach."
                                            },
                                            {
                                                "example_id": "2836d05b-2532-4c7d-90a5-736576021771",
                                                "sense_id": "09370a32-5f2c-3110-a20e-5290abfeab6a",
                                                "text": "Once you have been mindfully eating for a while, the mindset can apply to other areas of your life."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0b262db7-f969-43db-b613-3c05c99c7984",
                        "source_entry_id": "8dbe1fba-7aec-33ac-b60b-7d732d8ddaf6",
