                "senses": [
                    {
                        "sense_id": "c98b74d0-c2e0-3fc9-98ab-49db7164e3bd",
                        "entry_id": "d13a4f17-bd1a-3076-bebc-32e18c391da8",
                        "glosses": [
                            "eine ethische Haltung, die im Gegensatz zur Gesinnungsethik primär die realen Folgen oder Ergebnisse einer Handlung in Betracht zieht"
                        ],
                        "tags": [
                            "Ethik"
                        ],
                        "examples": [
                            {
                                "example_id": "b73e07ba-c211-4f86-93db-10513146ff8a",
                                "sense_id": "c98b74d0-c2e0-3fc9-98ab-49db7164e3bd",
                                "text": "„Die Unterscheidung von Verantwortungs- und Gesinnungsethik geht auf den Essay Politik als Beruf von Max Weber zurück.“"
                            },
                            {
                                "example_id": "35ae5391-049e-4b03-8cc8-36fe418e1a2e",
                                "sense_id": "c98b74d0-c2e0-3fc9-98ab-49db7164e3bd",
                                "text": "„Die Verantwortungsethik rechnet insbesondere mit den durchschnittlichen Defekten der Menschen. Es gibt kein Recht, Güte und Vollkommenheit bei Menschen vorauszusetzen.“"
                            },
                            {
                                "example_id": "535ecdd3-803d-4649-9519-f56ddcba2ad4",
                                "sense_id": "c98b74d0-c2e0-3fc9-98ab-49db7164e3bd",
                                "text": "„Mugabe sollte sich als Meister darin erweisen, Gesinnungsethik zu praktizieren, aber Verantwortungsethik vorzutäuschen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
