                "senses": [
                    {
                        "sense_id": "757f5a02-39d2-3192-bd3a-f1a428a32b5e",
                        "entry_id": "85c64ffc-b6dd-3318-967f-db1cb1618f8c",
                        "glosses": [
                            "Zeit der Kindheit"
                        ],
                        "tags": [
                            "plural-only"
                        ],
                        "examples": [
                            {
                                "example_id": "d572f0ae-ecdb-46b9-87bc-92288d4839fa",
                                "sense_id": "757f5a02-39d2-3192-bd3a-f1a428a32b5e",
                                "text": "Opa hat noch viele Erinnerungen aus/von seinen Kindertagen."
                            },
                            {
                                "example_id": "1c77afb5-f39a-4a9a-8e11-2b09f9d7a1de",
                                "sense_id": "757f5a02-39d2-3192-bd3a-f1a428a32b5e",
                                "text": "„In unseren Kindertagen strickte die Großmutter an einem schier endlosen Socken, der sommers beim Wandern in den klobigen Schuhen nicht verrutschte und winters warm hielt.“"
                            },
                            {
                                "example_id": "d172b283-a0de-4014-9cef-670fd67c1663",
                                "sense_id": "757f5a02-39d2-3192-bd3a-f1a428a32b5e",
                                "text": "„Und mit der Neugier kam der Lebenshunger aus Kindertagen zurück.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "1ac48b8d-22ca-3605-ba36-829fc169a3b9",
                        "entry_id": "85c64ffc-b6dd-3318-967f-db1cb1618f8c",
                        "glosses": [
                            "besonderer (Feier- oder Fest-)Tag für Kinder"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f7e4f2b-4c9b-42ac-bacc-8b696a8667c6",
                                "sense_id": "1ac48b8d-22ca-3605-ba36-829fc169a3b9",
                                "text": "Morgen ist bei uns im Dorf Kindertag."
                            }
                        ],
                        "sense_index_json": "\"2\""
