                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b555811d-1c2a-4377-80c1-6edd3c665e2c",
                                "sense_id": "79f5c69f-9e1d-3f1e-b51f-a29982c0f259",
                                "text": "It is, it is: hie hence, be gone, away!\nIt is the lark that sings so out of tune,\nStraining harsh discords and unpleasing sharps."
                            },
                            {
                                "example_id": "b2646941-79ed-4883-a770-60031b3c2fa4",
                                "sense_id": "79f5c69f-9e1d-3f1e-b51f-a29982c0f259",
                                "text": "‘[…] Be assured, my dear, that these were the harshest words, and to me the most unpleasing that ever escaped your lips!’"
                            },
                            {
                                "example_id": "a4da31ba-1b9d-4fca-94ea-72c1e929b5db",
                                "sense_id": "79f5c69f-9e1d-3f1e-b51f-a29982c0f259",
                                "text": "This looked peculiar at first, but not unpleasing when one gets used to it."
                            },
                            {
                                "example_id": "31b907e2-2983-445e-b890-b1a54c676167",
                                "sense_id": "79f5c69f-9e1d-3f1e-b51f-a29982c0f259",
                                "text": "Zander took out a silk handkerchief and vented some unpleasing odour from his mouth."
                            }
                        ]
                    }
