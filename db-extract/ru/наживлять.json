                            {
                                "target_word": "bait",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f35566a4-bfab-39e1-9af9-dd3953b729dd",
                                        "entry_id": "88d81707-069c-311d-b2b6-fe8198f25763",
                                        "glosses": [
                                            "To set dogs on (an animal etc.) to bite or worry; to attack with dogs, especially for sport."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1d4a1104-f5b7-4c64-b8ad-60dcf8845147",
                                                "sense_id": "f35566a4-bfab-39e1-9af9-dd3953b729dd",
                                                "text": "to bait a bear with dogs"
                                            },
                                            {
                                                "example_id": "a1ffeb1e-44cd-4834-8e28-583eb0d4c237",
                                                "sense_id": "f35566a4-bfab-39e1-9af9-dd3953b729dd",
                                                "text": "to bait a bull"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f4bdea11-4027-3167-9971-cfb4162e3056",
                                        "entry_id": "88d81707-069c-311d-b2b6-fe8198f25763",
                                        "glosses": [
                                            "To intentionally annoy, torment, or threaten by constant rebukes or threats; to harass."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "571e33c0-57dd-45bf-8fcf-33f81ab81cc4",
                                                "sense_id": "f4bdea11-4027-3167-9971-cfb4162e3056",
                                                "text": "I remember once before, a mad woman, from about Alnwick, by name baited me with letters and plans — first for charity for herself or some protégé — I gave my guinea— then she wanted to have half the profits of a novel which I was to publish under my name and auspices."
                                            },
                                            {
                                                "example_id": "87b0964d-b63c-44bf-8d17-528400d0620f",
                                                "sense_id": "f4bdea11-4027-3167-9971-cfb4162e3056",
                                                "text": "But [US Vice President J.D.] Vance, the champion of diplomacy, shouldn’t have baited a war-weary man fighting for the survival of his country in the first place."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0debf546-46a3-31b9-b1d4-0e6902ef773a",
                                        "entry_id": "88d81707-069c-311d-b2b6-fe8198f25763",
                                        "glosses": [
                                            "To feed and water (a horse or other animal), especially during a journey."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "78ab490f-ab45-4ae7-b440-bff636015ab6",
                                                "sense_id": "0debf546-46a3-31b9-b1d4-0e6902ef773a",
                                                "text": "And than they com into a lowe medow that was full of swete floures, and there thes noble knyghtes bayted her horses."
                                            },
                                            {
                                                "example_id": "f0c643a1-6cfb-4203-8b84-79bda77f94ff",
                                                "sense_id": "0debf546-46a3-31b9-b1d4-0e6902ef773a",
                                                "text": "The Sunne that measures heauen all day long, / At night doth baite his steedes the Ocean waues emong."
                                            },
                                            {
                                                "example_id": "acbd866f-2ca0-4684-9240-272ba4468a1d",
                                                "sense_id": "0debf546-46a3-31b9-b1d4-0e6902ef773a",
                                                "text": "Before I could move in it, however, I had to wait until we stopped to bait the flagging horses, which we did about noon at the head of the valley."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a7ce74dc-a4f3-3b4a-8690-df9f57a0724c",
                                        "entry_id": "88d81707-069c-311d-b2b6-fe8198f25763",
                                        "glosses": [
                                            "Of a horse or other animal: to take food, especially during a journey."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dfbe31dc-64ee-4819-a74f-a4a75bd97af6",
                                                "sense_id": "a7ce74dc-a4f3-3b4a-8690-df9f57a0724c",
                                                "text": "King Cyrus, that he might more speedily receave news from al parts of his Empire (which was of exceeding great length), would needs have it tried how far a horse could in a day goe outright without baiting, at which distance he caused stations to be set up, and men to have fresh horses ready for al such as came to him."
                                            },
                                            {
                                                "example_id": "7aca7449-aa29-4642-9a15-afa9fc2a0188",
                                                "sense_id": "a7ce74dc-a4f3-3b4a-8690-df9f57a0724c",
                                                "text": "[H]orses' playful neigh, / From rustic's whips, and plough, and waggon, free, / Baiting in careless freedom o'er the leas, / Or turn'd to knap each other at their ease."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ee7dd389-5106-398f-bf7b-ffcfa1d35936",
                                        "entry_id": "88d81707-069c-311d-b2b6-fe8198f25763",
                                        "glosses": [
                                            "(of a person) To stop to take a portion of food and drink for refreshment during a journey."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6ca533f6-9c90-405b-9262-25c767577497",
                                                "sense_id": "ee7dd389-5106-398f-bf7b-ffcfa1d35936",
                                                "text": "For evil news rides post, while good news baits."
                                            },
                                            {
                                                "example_id": "a2b22c62-762d-42bf-832e-ec4c8cafc0e3",
                                                "sense_id": "ee7dd389-5106-398f-bf7b-ffcfa1d35936",
                                                "text": "My Lord’s coach convey’d me to Bury, and thence baiting at Newmarket, stepping in at Audley End to see that house againe, I slept at Bishops Strotford, and the next day home."
                                            },
                                            {
                                                "example_id": "8037f896-0963-4f08-a8ef-8c8b2c236ce4",
                                                "sense_id": "ee7dd389-5106-398f-bf7b-ffcfa1d35936",
                                                "text": "When he [a servant's master] baits at noon, enter the inn gate before him, and call the ostler to hold your master's horse while he alights."
                                            },
                                            {
                                                "example_id": "a5dbf34e-4392-45e7-8c77-88fe55c7f909",
                                                "sense_id": "ee7dd389-5106-398f-bf7b-ffcfa1d35936",
                                                "text": "At Break of Day we arose, and after a short Repast march’d on till Noon, when we baited among some shady Trees near a Pond of Water […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bait",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3a16554d-74e1-38cc-af63-da2f78350bc2",
                                        "entry_id": "505c4abd-588e-3dd2-8da5-e2e63d9baf1c",
                                        "glosses": [
                                            "To flap the wings; to flutter as if to fly; or to hover, as a hawk when she stoops to her prey."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
