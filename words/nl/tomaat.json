                {
                    "sense_id": "095c29ac-9e57-30d4-99cb-b5e11371df85",
                    "sense_definition": "de specifieke helderrode kleur van een rijpe tomaat",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "kleuren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij droeg een jurk in de kleur van een rijpe <w>tomaat</w>.",
                            "target_lang_translations": {
                                "en": "She wore a dress in the color of a ripe <w>tomato</w>.",
                                "ru": "На ней было платье цвета спелого <w>помидора</w>."
                            }
                        },
                        {
                            "text": "Na een middag in de felle zon was zijn gezicht zo rood als een <w>tomaat</w>.",
                            "target_lang_translations": {
                                "en": "After an afternoon in the bright sun, his face was as red as a <w>tomato</w>.",
                                "ru": "После целого дня на ярком солнце его лицо было красным как <w>помидор</w>."
                            }
