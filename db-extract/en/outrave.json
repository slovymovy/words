                        "examples": [
                            {
                                "example_id": "938afaa9-c986-41ab-83ca-86d1a5298515",
                                "sense_id": "2c7320be-fa7e-3708-87cd-f317965baeaa",
                                "text": "There, like one possessed,\nOutraving and outbraving all the rest,\nOne Lycabas, from Tuscan city sent\nTo purge a deed of blood by banishment,\nAs I withstood him, struck a breakneck blow,\nAnd would have dashed me to the waves below […]"
                            },
                            {
                                "example_id": "f51d941d-ac62-4aa9-ba04-9212d8d34011",
                                "sense_id": "2c7320be-fa7e-3708-87cd-f317965baeaa",
                                "text": "In rant it outraved what Lee himself was to achieve."
                            }
                        ]
                    }
