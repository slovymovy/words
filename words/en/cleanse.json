                    "frequency": "Low",
                    "semantic_group_id": "purification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many pilgrims travel to the river hoping to <w>cleanse</w> their souls of past mistakes."
                        },
                        {
                            "text": "The ritual was intended to <w>cleanse</w> the community of its collective guilt."
                        }
                    ]
                },
                {
                    "sense_id": "702409b4-18b6-3290-b3cb-09e012850200",
                    "sense_definition": "To remove something unpleasant or unwanted from a place or group.",
