                        "examples": [
                            {
                                "example_id": "5bf1128c-a7b4-4860-85b7-d985061f828d",
                                "sense_id": "4d22e1da-b9a2-3720-849f-f543fc6f5bf6",
                                "text": "À travers la fenêtre, la traitresse lança à l’interpellatrice qu’elle se reposait, craignant d’être confrontée à ses déclarations diffamatoires."
                            },
                            {
                                "example_id": "f7451712-3f1d-4bf4-81b4-437869d66cf3",
                                "sense_id": "4d22e1da-b9a2-3720-849f-f543fc6f5bf6",
                                "text": "J’ai entendu l’une des interpellatrices dire qu’il s’agissait de revenir aux dispositions de 1951 qu’elle opposait aux dispositions actuelles."
                            }
                        ]
                    }
