                        "glosses": [
                            "Produkt, das besonders aufwendig/schön ist und weit über den Normalbedarf hinausgeht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "824de2e1-aaa0-43d2-8e80-afa481b9acc7",
                                "sense_id": "dc964958-c65b-3ae5-b36f-817df161bfa6",
                                "text": "„Der Markt für Luxusprodukte wuchs.“"
                            },
                            {
                                "example_id": "cdc650d8-afbe-4094-8d20-b518912bfcaf",
                                "sense_id": "dc964958-c65b-3ae5-b36f-817df161bfa6",
                                "text": "„Unterschiedliche Zweige des Handwerks wurden perfektioniert, um die Nachfrage an Luxusprodukten für die Oberschicht zu befriedigen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
