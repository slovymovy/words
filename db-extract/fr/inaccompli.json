                        "glosses": [
                            "Forme verbale qui envisage l’action en cours de réalisation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "90aee8ac-6d44-402a-9128-f9a04b81b4d5",
                                "sense_id": "feaa59cc-683b-359c-9b24-dfd1271695ff",
                                "text": "Tous les modes du wolof peuvent prendre le sens de l’habituel à l’inaccompli."
                            },
                            {
                                "example_id": "3d021fb7-679a-4d2b-a075-4a53d820d5ad",
                                "sense_id": "feaa59cc-683b-359c-9b24-dfd1271695ff",
                                "text": "Depuis la conférence de Bamako en 1966 et la parution du Dictionnaire élémentaire d’Alfâ Ibrâhim Sow (1971), la tendance est de lemmatiser les verbes par la troisième personne du singulier de l’inaccompli indéterminé qui est la forme verbale la plus neutre du point de vue aspectuel, […]."
                            }
                        ]
