                "senses": [
                    {
                        "sense_id": "8beaf4b8-66b5-3209-a92e-1a18757870fe",
                        "entry_id": "4884d527-d8da-383c-b2e5-76f1e81fb950",
                        "glosses": [
                            "Person, die durch tiefe Temperaturen (Kälte) gestorben/erfroren ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0aa128b0-3a5f-4c48-9f0d-6fecb96d7b7f",
                                "sense_id": "8beaf4b8-66b5-3209-a92e-1a18757870fe",
                                "text": "„Seit Dienstag gab es allein in der Ukraine 13 weitere Kältetote, die Zahl der Kälteopfer seit vergangenem Donnerstag stieg damit auf 43.“"
                            },
                            {
                                "example_id": "a9b448b5-6006-479e-9ae1-12671c1d07c0",
                                "sense_id": "8beaf4b8-66b5-3209-a92e-1a18757870fe",
                                "text": "„Nach heftigen Schneefällen und Stürmen wurden in Serbien am Donnerstag bis zu 11.000 Menschen von der Außenwelt abgeschnitten. In ganz Osteuropa stieg die Zahl der Kältetoten auf 122 an.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
