                ],
                "senses": [
                    {
                        "sense_id": "2124e694-cc46-3f10-804b-e159b847d1ce",
                        "entry_id": "8bb5aa89-96cb-3f5a-a61d-14a3d17e73f8",
                        "glosses": [
                            "angelegter Spazierweg am Ufer eines Gewässers"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ac0ab3b8-158c-4488-984b-4c6d86ae0af2",
                                "sense_id": "2124e694-cc46-3f10-804b-e159b847d1ce",
                                "text": "„Zwar gibt es hier oder dort einladende Uferpromenaden; die von Koblenz zum Beispiel läßt sich ohne Vorbehalt empfehlen.“"
                            },
                            {
                                "example_id": "642e8a3d-615b-43b2-aa19-dbf2e3c1989f",
                                "sense_id": "2124e694-cc46-3f10-804b-e159b847d1ce",
                                "text": "„Entlang der Uferpromenade gelangen Sie rheinaufwärts zur Talstation der Seilbahn über den Rhein, mit der schnell die Festung Ehrenbreitstein erreicht werden kann.“"
                            },
                            {
                                "example_id": "a0e0dfa2-3732-4a18-b43e-4be2b5aed70a",
                                "sense_id": "2124e694-cc46-3f10-804b-e159b847d1ce",
                                "text": "„Perlmann probierte verschiedene Begründungen aus, als er um ein Uhr über die menschenleere Piazza Veneto und die Uferpromenade zum Hotel ging.“"
                            },
                            {
                                "example_id": "21efb807-a584-42d5-adf5-221bf7aa418e",
                                "sense_id": "2124e694-cc46-3f10-804b-e159b847d1ce",
                                "text": "„Auf der Elbe ziehen Frachter vorbei, an der Uferpromenade residiert die Reederei von Bertram Rickmers in einem Bürowürfel.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
