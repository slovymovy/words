                        "examples": [
                            {
                                "example_id": "f5427370-bb91-4a8b-82b4-0e9f12195a6a",
                                "sense_id": "bfd06a46-0d68-3bd8-958a-453653f0eaf1",
                                "text": "De alpinist verdwaalde en werd nooit meer gevonden."
                            },
                            {
                                "example_id": "d88640b6-3fe6-48f1-b788-908539290278",
                                "sense_id": "bfd06a46-0d68-3bd8-958a-453653f0eaf1",
                                "text": "De dagen erna moesten we ons concentreren op de uitdagingen die voor ons lagen zoals Glenn Pass, Pinchot Pass, Mather Pass en Muir Pass, allemaal meer dan 3.500 m hoog. England was een ervaren alpinist."
                            }
                        ]
                    }
                ],
