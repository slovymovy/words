                                "target_senses": [
                                    {
                                        "sense_id": "d155acce-3a9a-3bc6-9924-2e419d12bbef",
                                        "entry_id": "642f75b9-eb1d-3c83-9aea-2ad0ba95cd9c",
                                        "glosses": [
                                            "Qui se fait avec le secours du microscope."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5beb7d0f-52d7-4d4b-8309-2a51b22bafe7",
                                                "sense_id": "d155acce-3a9a-3bc6-9924-2e419d12bbef",
                                                "text": "[…]: il se trouve que certains grains de pollen se sont bien conservés dans les tourbières ; or, l’étude microscopique des grains de pollen permet très souvent de reconnaître à quelle plante ils appartiennent."
                                            },
                                            {
                                                "example_id": "a713f85a-e900-4fc2-b4ea-e4f71b9d94fa",
                                                "sense_id": "d155acce-3a9a-3bc6-9924-2e419d12bbef",
                                                "text": "Le diagnostic d’otacariose est confirmé par la mise en évidence d’otodectes dans le cérumen grâce aux examens otoscopique et microscopique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c787e22d-347f-3a7e-8a27-8657334ee9f4",
                                        "entry_id": "642f75b9-eb1d-3c83-9aea-2ad0ba95cd9c",
                                        "glosses": [
                                            "Qui ne peut être vu qu’avec le microscope."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2032a970-c825-42da-bb24-b269b5b39da9",
                                                "sense_id": "c787e22d-347f-3a7e-8a27-8657334ee9f4",
                                                "text": "L'argent natif est présent sous forme microscopique dans certains cuivres gris et dans certaines galènes : il semble bien y être hypogène."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d382d596-64c0-351c-8096-81224819dd90",
                                        "entry_id": "642f75b9-eb1d-3c83-9aea-2ad0ba95cd9c",
                                        "glosses": [
                                            "Extrêmement petit."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "09628ed7-8962-4fe9-ab9e-f6f9778a361c",
                                                "sense_id": "d382d596-64c0-351c-8096-81224819dd90",
                                                "text": "Je pardonne au « moustique à collier blanc », qui provoque un jet de sang à chaque piqûre. Je subis avec patience les coups du « frappe d'abord », les impressions cautérisantes du microscopique « brûlot »; mais le culex, je le hais, […]."
                                            },
                                            {
                                                "example_id": "d58583ff-0ef0-4d36-b36c-01278f62505f",
                                                "sense_id": "d382d596-64c0-351c-8096-81224819dd90",
                                                "text": "Il nous fit monter par un escalier fort roide à une toute petite chambre éclairée par une microscopique fenêtre sur le bord de laquelle végétaient de pauvres plantes."
                                            },
                                            {
                                                "example_id": "f71f9ad9-dd44-4c24-9324-35a688a8437a",
                                                "sense_id": "d382d596-64c0-351c-8096-81224819dd90",
                                                "text": "En effet, en ce qui concerne les industries des biens de production, les Québécois francophones ne sont en bonne position que dans les scieries et dans les industries du bois d'oeuvre et de la pierre. Leur place est nulle ou microscopique partout ailleurs …."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
