                "senses": [
                    {
                        "sense_id": "1f600056-f07a-315a-8e74-3f0e5b8e9603",
                        "entry_id": "2807ac00-fccd-34d7-82dd-a628d827fd3a",
                        "glosses": [
                            "runde Metallplatte, auf der Kuchen gebacken und / oder serviert wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b52349dd-d823-489c-8967-522c031e0b81",
                                "sense_id": "1f600056-f07a-315a-8e74-3f0e5b8e9603",
                                "text": "Ich backe einen Kuchen auf einem Kuchenteller."
                            },
                            {
                                "example_id": "a3791f98-58ff-4233-919d-d7cf45f78f5f",
                                "sense_id": "1f600056-f07a-315a-8e74-3f0e5b8e9603",
                                "text": "Gib mir bitte den Kuchenteller!"
                            },
                            {
                                "example_id": "fd37d528-9fa2-4b9d-b057-76863b825e44",
                                "sense_id": "1f600056-f07a-315a-8e74-3f0e5b8e9603",
                                "text": "Back nicht mit meinen Kuchentellern."
                            },
                            {
                                "example_id": "f921cd69-06a4-4a1a-9b2f-3676bb29d40d",
                                "sense_id": "1f600056-f07a-315a-8e74-3f0e5b8e9603",
                                "text": "„Auf dem Beistelltisch stehen bereits Kaffeetassen und Kuchenteller bereit, ein Mix aus geblümtem und rein weißem Geschirr.“"
                            },
                            {
                                "example_id": "827f0ed5-d7d5-430c-bd62-282811fa60ac",
                                "sense_id": "1f600056-f07a-315a-8e74-3f0e5b8e9603",
                                "text": "„Elsa schiebt ihren Kuchenteller beiseite, beugt sich vor und senkt verschwörerisch ihre Stimme.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
