                    "sense_definition": "simple past and past participle of <w>understand</w>",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>understood</w> the question immediately and gave the correct answer.",
