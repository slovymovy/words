                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "absolute",
                                "target_lang_sense_clarification": "certain and unquestionable"
                            },
                            {
                                "target_lang_word": "definite",
                                "target_lang_sense_clarification": "clearly stated or decided"
                            },
                            {
                                "target_lang_word": "certain",
                                "target_lang_sense_clarification": "having no doubt"
                            }
