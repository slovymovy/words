                "senses": [
                    {
                        "sense_id": "66e126b9-159a-3701-bcf5-50dd613dae16",
                        "entry_id": "4ff54c35-062a-3ee4-8af1-25d29bb576e2",
                        "glosses": [
                            "Sprechstunde bei einem Arzt, in der sich vorwiegend Patienten mit Infektionen vorstellen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f72d4d8-e33a-4c0f-ab73-a8640653d795",
                                "sense_id": "66e126b9-159a-3701-bcf5-50dd613dae16",
                                "text": "„‘Infektionssprechstunden in externen Betriebsstätten’ könnten jedoch, so die Auskunft der Kassenärztlichen Vereinigung Rheinland-Pfalz, bei Bedarf auch wieder aufgenommen werden.“"
                            },
                            {
                                "example_id": "b59146ac-bc02-48e4-b63d-980578055c10",
                                "sense_id": "66e126b9-159a-3701-bcf5-50dd613dae16",
                                "text": "„Wir haben jetzt morgens eine \"normale\" Sprechstunde und nachmittags eine Infektionssprechstunde.“"
                            },
                            {
                                "example_id": "0d7d51f7-af06-4eec-b100-e222089994d8",
                                "sense_id": "66e126b9-159a-3701-bcf5-50dd613dae16",
                                "text": "„Patient für Patient geht der Nachmittag vorüber - nun zu zweit in der Praxis ist es weniger hektisch als der Vormittag mit der Infektionssprechstunde.“"
                            },
                            {
                                "example_id": "451348d6-427f-4eef-bafe-50b09f1adf5a",
                                "sense_id": "66e126b9-159a-3701-bcf5-50dd613dae16",
                                "text": "„In Dr. von Buchs Infektionssprechstunde gilt daher auch eine Maskenpflicht.“"
                            },
                            {
                                "example_id": "0280b467-1422-4095-ac8c-aabb91e6303c",
                                "sense_id": "66e126b9-159a-3701-bcf5-50dd613dae16",
                                "text": "„Allerdings bieten viele Hausärzte weiterhin eine Infektionssprechstunde zu bestimmten Zeiten an, oftmals in der Mittagszeit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
