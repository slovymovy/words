                                        "glosses": [
                                            "Joined as allies."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "523d3bdd-12a1-46c3-b23c-2c85765da500",
                                                "sense_id": "cbb71912-f75a-3df2-803c-13d3ead16bce",
                                                "text": "The two countries became allied during the war."
                                            },
                                            {
                                                "example_id": "9a0ecb54-0aea-4d46-8860-ff7506f4a88f",
                                                "sense_id": "cbb71912-f75a-3df2-803c-13d3ead16bce",
                                                "text": "Their companies are allied in a joint venture."
                                            },
                                            {
                                                "example_id": "e56c8e95-b35c-470b-bb2f-018998b7c3c7",
                                                "sense_id": "cbb71912-f75a-3df2-803c-13d3ead16bce",
                                                "text": "He felt allied with her in the fight for justice."
                                            }
