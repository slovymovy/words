            },
            {
                "entry_id": "c71d906e-9acf-3d18-981a-706041e32b26",
                "word": "réacteur",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "acc9726c-6f84-4f54-bb29-aaf7ed197512",
                        "entry_id": "c71d906e-9acf-3d18-981a-706041e32b26",
                        "tags": [
                            "plural"
                        ],
                        "form": "réacteurs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "64213454-001a-3475-8e92-110fef331e65",
                        "entry_id": "c71d906e-9acf-3d18-981a-706041e32b26",
                        "glosses": [
                            "Appareil dans lequel se produit une réaction."
                        ],
                        "tags": [
                            "Chimie physique"
                        ],
                        "examples": [
                            {
                                "example_id": "fc4eaa31-8832-4cb5-9411-090123f95214",
                                "sense_id": "64213454-001a-3475-8e92-110fef331e65",
                                "text": "Ces réacteurs peuvent être proposés dans différents matériaux de construction tels que Inox316, Hastelloy, Titane, Inconel, Monel, Zirconium, Tantale...de manière à pouvoir résister à tout milieu réactionnel allant de pH très acide à très basique."
                            },
                            {
                                "example_id": "649acf5e-b4f0-4988-bf7d-c49857ad5fdb",
                                "sense_id": "64213454-001a-3475-8e92-110fef331e65",
                                "text": "Le premier réacteur nucléaire est construit aux États-Unis en 1942, à l’Université de Chicago, par Enrico Fermi et Leó Szilárd. Il est constitué d’un empilement de 6 tonnes d’uranium métallique, 34 tonnes d’oxyde d’uranium et 400 tonnes de graphite, c’est pourquoi il porte le nom de pile atomique."
                            }
                        ]
                    },
                    {
                        "sense_id": "c45d841f-9027-3962-9e13-8b4642ed2c0d",
                        "entry_id": "c71d906e-9acf-3d18-981a-706041e32b26",
                        "glosses": [
                            "Moteur à réaction."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2def4420-962a-42e4-ae15-3dfc73b77ff1",
                                "sense_id": "c45d841f-9027-3962-9e13-8b4642ed2c0d",
                                "text": "Cependant, à cause en particulier de la difficulté de mise au point des réacteurs, peu d’avions à réaction sont réellement engagés avant la fin des combats."
                            }
                        ]
                    },
                    {
                        "sense_id": "aa4f4207-7232-335f-9463-d0c4f44bd8f4",
                        "entry_id": "c71d906e-9acf-3d18-981a-706041e32b26",
                        "glosses": [
                            "Réacteur nucléaire."
                        ],
                        "tags": [
                            "ellipsis"
                        ],
                        "examples": [
                            {
                                "example_id": "d6764eed-7baa-4331-9b29-53501bc672e0",
                                "sense_id": "aa4f4207-7232-335f-9463-d0c4f44bd8f4",
                                "text": "Le réacteur de Chooz A, arrêté définitivement en 1991, est le premier réacteur REP à faire l'objet d'un programme de déconstruction."
                            },
                            {
                                "example_id": "c300103c-f4b7-4810-835c-953ef7d03701",
                                "sense_id": "aa4f4207-7232-335f-9463-d0c4f44bd8f4",
                                "text": "Située en bordure de la Meuse, au nord du département des Ardennes, la commune de Chooz abrite l’une des trois centrales nucléaires du Grand Est en activité. De 1967 à 1991, elle accueille un premier réacteur. La centrale actuelle compte deux réacteurs mis en service en 1996."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5069261c-4769-4b12-81b9-a657eb9ae51b",
                        "source_entry_id": "c71d906e-9acf-3d18-981a-706041e32b26",
                        "source_sense_id": "64213454-001a-3475-8e92-110fef331e65",
                        "source_sense_description": "(Chimie) Appareil dans lequel se produit une réaction.",
                        "target_lang_word": "reactor",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "reactor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7ada454d-dd1b-35ce-a46e-e04e88f8bb15",
                                        "entry_id": "78e5bb5c-db63-3565-8def-8349d5db3411",
                                        "glosses": [
                                            "A person who responds to a suggestion, stimulation or other influence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c41ef7b-dfa2-457c-8909-a64e016d0e19",
                                                "sense_id": "7ada454d-dd1b-35ce-a46e-e04e88f8bb15",
                                                "text": "Altman seees his characters as total reactors; everything they do and say is in response to their environment. They do not seem to exist with lives or qualities of their own."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "05b25642-97cc-392f-89ba-84e0ee80af46",
                                        "entry_id": "78e5bb5c-db63-3565-8def-8349d5db3411",
                                        "glosses": [
                                            "A structure used to contain chemical or other reactions."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2a1e32b6-f18c-3437-b775-5a87a4e13af4",
                                        "entry_id": "78e5bb5c-db63-3565-8def-8349d5db3411",
                                        "glosses": [
                                            "A device which uses atomic energy to produce heat."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "256f739b-7260-4a51-993e-7cfd50a3c8a6",
                                                "sense_id": "2a1e32b6-f18c-3437-b775-5a87a4e13af4",
                                                "text": "It limits the rights of nonweapon countries to develop an export business in civilian reactor technology."
                                            },
                                            {
                                                "example_id": "208cdb0a-fa0f-4218-ae6d-1f9959394c13",
                                                "sense_id": "2a1e32b6-f18c-3437-b775-5a87a4e13af4",
                                                "text": "It is hoped that a competition to develop small modular reactors (SMRs) will drive billions of pounds of investment into the technology, which the government hopes will be cheaper and quicker to build than traditional large nuclear power plants."
                                            },
                                            {
                                                "example_id": "93f5c0bc-54a2-49bf-b9f2-28c8d29eac7a",
                                                "sense_id": "2a1e32b6-f18c-3437-b775-5a87a4e13af4",
                                                "text": "The second is whether the federal agency has the power to license such facilities away from reactor sites where the waste was generated. […] The 5th US Circuit Court of Appeals also ruled the NRC does not have the authority to issue licenses to store nuclear fuel away from reactors."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "10f47796-119d-3155-a59b-203c35bc706b",
                                        "entry_id": "78e5bb5c-db63-3565-8def-8349d5db3411",
                                        "glosses": [
                                            "A chemical substance which responds to the presence of, or contact with, another substance."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6d0205de-ab39-36d6-a18c-8036192375fc",
                                        "entry_id": "78e5bb5c-db63-3565-8def-8349d5db3411",
                                        "glosses": [
                                            "An electrical component with reactance"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
