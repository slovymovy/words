                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f471b3ed-e9e2-4e3c-aa01-d4f502dbcffa",
                                "sense_id": "95891d3b-9c10-3c6b-aa6c-031fe9ab2687",
                                "text": "„Draußen leuchtete die Bogenlampe durch das kahle Astwerk eines Baums.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "da9dc59f-74f4-32f3-af7b-ec5652b149f2",
