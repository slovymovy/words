                "senses": [
                    {
                        "sense_id": "3cfb3409-9067-3ceb-b35f-e80e35ced6f5",
                        "entry_id": "8874bae1-b0d9-36d8-9fdd-4f8739ded365",
                        "glosses": [
                            "het voorkomen van een gebeurtenis waarbij iemand overlijdt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b3cf2dfd-0b9c-4a4f-92a7-a2716eaaed37",
                                "sense_id": "3cfb3409-9067-3ceb-b35f-e80e35ced6f5",
                                "text": "Er waren deze week een aantal sterfgevallen door het nieuwe virus."
                            },
                            {
                                "example_id": "2ca5e831-202d-48b5-bbc9-c2df3ef8c67b",
                                "sense_id": "3cfb3409-9067-3ceb-b35f-e80e35ced6f5",
                                "text": "De strategie heeft in elk geval een negatief effect gehad op het aantal sterfgevallen van het land. Met 43 sterfgevallen per 100.000 inwoners is het sterftecijfer van Zweden wereldwijd een van de hoogste en uit een eerste Zweedse studie naar groepsimmuniteit blijkt dat slechts 7,3 procent van de Stockholmers antistoffen tegen Covid-19 heeft opgebouwd. In veel Europese landen stabiliseert het aantal doden en besmettingen, in Zweden blijft de curve doorlopen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "95b2100f-2c3e-4c42-a0d5-a92bddc51d2d",
                        "source_entry_id": "8874bae1-b0d9-36d8-9fdd-4f8739ded365",
                        "source_sense_id": "3cfb3409-9067-3ceb-b35f-e80e35ced6f5",
                        "source_sense_description": "het voorkomen van een gebeurtenis waarbij iemand overlijdt",
                        "target_lang_word": "Sterbefall",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sterbefall",
