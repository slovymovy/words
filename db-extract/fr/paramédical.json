                "senses": [
                    {
                        "sense_id": "5872f052-478d-31b2-9000-87842f76dda9",
                        "entry_id": "bdcc14e7-4707-3611-960e-de860bad84e3",
                        "glosses": [
                            "Personne travaillant dans un domaine apparenté à la médecine, par exemple masseur-kinésithérapeute, orthophoniste, etc."
                        ],
                        "tags": [
                            "Métier"
                        ],
                        "examples": [
                            {
                                "example_id": "88c8c50c-7165-4fbd-b0cd-7bdefc1d4aa3",
                                "sense_id": "5872f052-478d-31b2-9000-87842f76dda9",
                                "text": "Pour la téléréfraction, le patient est seul (ou éventuellement avec un assistant médical) dans une salle équipée et le diagnostic est établi à distance par le paramédical ou le médecin."
                            },
                            {
                                "example_id": "af3634e1-5f0d-4344-bc47-91d62af9edef",
                                "sense_id": "5872f052-478d-31b2-9000-87842f76dda9",
                                "text": "L’auteur note par ailleurs qu’à l’inverse de ce qui se passait il y a quelques années, on assiste actuellement à une tendance à hyperprofessionnaliser et hypertechniciser les paramédicaux en psychiatrie."
                            }
                        ]
                    }
