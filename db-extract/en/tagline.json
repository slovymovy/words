                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7195c1bc-23d1-45a3-b6ed-e81fa7f04e52",
                                                "sense_id": "29a5d56c-c8d0-3940-b01a-de68d667905b",
                                                "text": "Ta historia jest ciekawa, ale puenta przy niej najciekawsza."
