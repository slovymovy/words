                            {
                                "example_id": "c8441d96-50ec-41b3-b200-7822c8c60961",
                                "sense_id": "f1beffc7-b427-32b3-8d8b-00df9fbe0ca8",
                                "text": "We moesten allen een getuigenis afleggen over wat we gezien hadden."
                            }
                        ]
                    },
                    {
                        "sense_id": "69f59b37-1d43-358f-99eb-156a6319d721",
                        "entry_id": "457206f5-1785-3c3a-9ddb-bffabd5eb755",
