                                                "example_id": "7f8bc5a3-87e4-4cd0-8d0c-421af132b6c4",
                                                "sense_id": "e43cf428-6946-31c5-847f-dfe246c0f9c6",
                                                "text": "In addition to the Fortran operators that are intrinsic (built in), there may be user-defined operators in expressions."
                                            }
                                        ]
                                    }
                                ]
                            }
