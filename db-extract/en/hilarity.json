                                    {
                                        "sense_id": "1126719b-f474-3aa3-b447-6068368c6bb1",
                                        "entry_id": "0b8b4520-affd-3241-aecc-7f63aba7f027",
                                        "glosses": [
                                            "радостное, смешливое настроение"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7f8d4af-9d90-486b-80b7-a937b087e1a8",
                                                "sense_id": "1126719b-f474-3aa3-b447-6068368c6bb1",
                                                "text": "Мною овладело веселье."
                                            },
                                            {
                                                "example_id": "daa26dde-af29-4b5c-a352-f07755426fed",
                                                "sense_id": "1126719b-f474-3aa3-b447-6068368c6bb1",
                                                "text": "В коллективе царило веселье."
                                            },
                                            {
                                                "example_id": "2763f74f-f026-4788-aecd-c4deeda5bd5a",
                                                "sense_id": "1126719b-f474-3aa3-b447-6068368c6bb1",
