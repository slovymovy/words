                                    {
                                        "sense_id": "acb5e065-2b88-3f6a-836b-955a7eab7a85",
                                        "entry_id": "7a984e75-ace6-37b7-a9f0-3bb055f5eff4",
                                        "glosses": [
                                            "op aantoonbare wijze"
                                        ],
