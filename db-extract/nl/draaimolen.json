                        "entry_id": "98be9089-9bc8-35ae-b590-0bd82eb61b87",
                        "glosses": [
                            "een kermisattractie die bestaat uit een ronddraaiend geheel van een plateau met daarop zittoestellen en een overkapping"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "21c1b742-f99d-4411-bb4e-9a484b4580d6",
                                "sense_id": "01707370-22b6-3339-88aa-2fb3b0612368",
                                "text": "Een draaimolen wordt vooral leuk gevonden door jonge kinderen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b733fec6-3bfa-4d06-bfd8-ffbbe81f13ac",
                        "source_entry_id": "98be9089-9bc8-35ae-b590-0bd82eb61b87",
                        "source_sense_id": "01707370-22b6-3339-88aa-2fb3b0612368",
                        "target_lang_word": "Karussell",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Karussell",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8df53846-3346-3a64-acb2-b045566bd602",
                                        "entry_id": "ec069182-2aaf-399a-b479-1b8bc4c0bbb5",
                                        "glosses": [
                                            "Fahrgeschäft auf Volksfesten, mit einer sich drehenden Plattform, auf der Personen – insbesondere Kinder – im Kreis fahren können"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca18a57b-ebfb-4e21-b9b8-5a48f0161ff2",
                                                "sense_id": "8df53846-3346-3a64-acb2-b045566bd602",
                                                "text": "Beim Pfarrfest war in diesem Jahr sogar ein Karussell aufgebaut, was bei den Kindern großen Anklang fand."
                                            },
                                            {
                                                "example_id": "fc3b9abf-371f-4abc-ac7e-2eedce434144",
                                                "sense_id": "8df53846-3346-3a64-acb2-b045566bd602",
                                                "text": "„Dann ging das Karussell los, und ich sah ihr zu, wie sie im Kreis fuhr.“"
                                            },
                                            {
                                                "example_id": "ee267c3c-ea56-4d71-9a65-d63980d87a42",
                                                "sense_id": "8df53846-3346-3a64-acb2-b045566bd602",
                                                "text": "„Das Karussell war frei.“"
                                            },
                                            {
                                                "example_id": "e06c9983-c036-42ec-a415-a8f694b93c54",
                                                "sense_id": "8df53846-3346-3a64-acb2-b045566bd602",
                                                "text": "„Auf dem Karussell sind Löwen, Elefanten, Nashörner – und ein Kind.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6f6cb135-bcd9-4b8f-8404-716f9f50fd0f",
                        "source_entry_id": "98be9089-9bc8-35ae-b590-0bd82eb61b87",
