                    {
                        "sense_id": "ae4a4a5f-ef63-3658-8ab6-a2e6faa4d883",
                        "entry_id": "26bb455c-d41b-3bb7-afd2-2f5def8416e7",
                        "glosses": [
                            "gemakkelijk op anderen overgaand"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ac545067-5305-4a1b-8a6e-94cc7a88cba8",
                                "sense_id": "ae4a4a5f-ef63-3658-8ab6-a2e6faa4d883",
                                "text": "(bijwoord) Hij kon heel aanstekelijk lachen waardoor iedereen in de klas ook moest gaan lachten."
                            },
                            {
                                "example_id": "2aab06fe-dd13-4030-a706-9c20382925ae",
                                "sense_id": "ae4a4a5f-ef63-3658-8ab6-a2e6faa4d883",
                                "text": "(bijvoeglijk naamwoord) Hij had een aanstekelijke lach waardoor iedereen in de klas ook moest gaan lachen."
                            },
                            {
                                "example_id": "430bcf2f-9836-4bd8-9752-7884d561e1c1",
                                "sense_id": "ae4a4a5f-ef63-3658-8ab6-a2e6faa4d883",
                                "text": "Ze had een aanstekelijke energie en we spraken al snel over zaken als conventies, opvoeding en hang naar vrijheid. Deze gesprekken waren anders dan anders en gingen al snel de diepte in."
                            },
                            {
                                "example_id": "f5eb0738-aac1-4345-a5d0-eace9fd40329",
                                "sense_id": "ae4a4a5f-ef63-3658-8ab6-a2e6faa4d883",
                                "text": "Haar lach was aanstekelijk en ik moest giechelen. Het was een bespottelijke opmerking, maar het nam alle spanning bij me weg. 'Sommige mensen vinden het niet erg,' zei ik, denkend aan Cynth, en aan hoe ik haar vernederde door dit gesprek, dit vreemde spel waarvan ik de regels niet kende. 'Je moet er wel wat voor kunnen '"
                            }
                        ]
                    }
