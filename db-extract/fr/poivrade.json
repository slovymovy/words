                ],
                "senses": [
                    {
                        "sense_id": "add0568d-7693-36d3-bb38-0df32a35e040",
                        "entry_id": "d623b1c5-b73d-3ee0-b890-5f2048662b90",
                        "glosses": [
                            "Petit artichaut cueilli avant maturité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52f9d64a-21ac-4015-a166-8304d1d0304b",
                                "sense_id": "add0568d-7693-36d3-bb38-0df32a35e040",
                                "text": "Le poivrade (ou bouquet), un petit violet dépourvu de foin parce que récolté avant maturité, se consomme entier, cru sous un nuage de de tapenade ou poêlé, par exemple."
                            },
                            {
                                "example_id": "559bbd10-8224-4003-8b0e-9b5d76d3ab12",
                                "sense_id": "add0568d-7693-36d3-bb38-0df32a35e040",
                                "text": "Au marché, repérez les poivrades jeunes, aux feuilles bien serrées, aux pieds fermes et non desséchés."
                            },
                            {
                                "example_id": "35957e24-dfa2-4959-8e1a-047832cd77ba",
                                "sense_id": "add0568d-7693-36d3-bb38-0df32a35e040",
                                "text": "L’artichaut poivrade est un petit artichaut tendre qui n’a pas fini sa croissance et qui pèse entre 80 et 100 grammes."
                            }
                        ]
                    }
