                        "entry_id": "515c5d22-939a-301b-b35a-3803c413fdf9",
                        "glosses": [
                            "Système de comportements, de représentations et de discriminations favorisant l’hétérosexualité, en dépit des autres orientations sexuelles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a972bd5-6311-4eb7-bcdd-7ef5429effc3",
                                "sense_id": "bd627b0e-30e9-377f-ac81-97593efa4730",
                                "text": "Certaines remarques ne sont pas portées par des intentions homophobes, mais relèvent tout de même de l’hétérocentrisme."
                            },
                            {
                                "example_id": "4ac65151-bb34-4a5f-ba11-f69d78bd3eff",
                                "sense_id": "bd627b0e-30e9-377f-ac81-97593efa4730",
                                "text": "L’hétérocentrisme est l’ensemble des représentations et des valeurs faisant de l’hétérosexualité la norme unique à suivre en matière de pratique sexuelle et de vie affective."
                            }
                        ]
                    }
