                                        "entry_id": "eccdca02-30cb-306d-894f-ee0016d22ca9",
                                        "glosses": [
                                            "Inhabitant of Shanghai; person of Shanghainese descent."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Shanghainese",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8f87201f-499f-3b01-931c-37f7dfa226e3",
                                        "entry_id": "2a4f147e-11d4-3dba-8cf3-1c0baa748fb3",
                                        "glosses": [
                                            "A dialect of Wu spoken predominantly in Shanghai."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b4f0bf9e-816d-43d9-adbd-777f7d6ea9c2",
                                                "sense_id": "8f87201f-499f-3b01-931c-37f7dfa226e3",
                                                "text": "Maybe it was because I was hearing snatches of Shanghainese and other dialects around me in the carirage, but it didn't feel like I was even in China any more."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
