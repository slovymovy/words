                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a01a13c-aa71-4867-8174-ea0bb01104be",
                                "sense_id": "1cc96c71-a023-3402-92b3-1cd5b17cc4df",
                                "text": "Утром-то рано в церкву пойдёте? ― Я, может, и совсем ложиться не буду."
                            },
                            {
                                "example_id": "b911eba6-eda4-47e3-8c04-c3a1e73e7197",
                                "sense_id": "1cc96c71-a023-3402-92b3-1cd5b17cc4df",
                                "text": "Уж громкий колокол гудёт, // И в церкве поп с венцами ждёт."
                            }
                        ]
                    }
