{
    "word_family": [
        "плавление",
        "плавка",
        "плавильный",
        "плавкий"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "30c3790e-8581-3dbb-a255-ccbb694f67ff",
                    "sense_definition": "Переводить твердое вещество в жидкое состояние путем нагревания.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "melt",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мастер начал <w>плавить</w> металл в специальной печи для изготовления деталей.",
                            "target_lang_translations": {
                                "de": "Der Meister begann, das Metall in einem speziellen Ofen zu <w>schmelzen</w>, um Teile herzustellen."
                            }
                        },
                        {
                            "text": "Солнце так сильно греет, что начинает <w>плавить</w> асфальт на дороге.",
                            "target_lang_translations": {
                                "de": "Die Sonne brennt so stark, dass sie beginnt, den Asphalt auf der Straße zu <w>schmelzen</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "расплавлять"
                    ],
                    "antonyms": [
                        "отверждать"
                    ],
                    "common_phrases": [
                        "плавить металл",
                        "плавить воск"
                    ],
                    "target_lang_definitions": {
                        "de": "Einen festen Stoff durch Erhitzen in einen flüssigen Zustand überführen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "schmelzen",
                                "target_lang_sense_clarification": "transitiv, einen Stoff durch Hitze verflüssigen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "90adf300-f5ca-3766-8338-f1071f0309aa",
                    "sense_definition": "Получать металл или сплав из руды или сырья.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "melt",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "На заводе продолжают <w>плавить</w> сталь для нужд тяжелой промышленности.",
                            "target_lang_translations": {
                                "de": "Im Werk wird weiterhin Stahl für die Bedürfnisse der Schwerindustrie <w>geschmolzen</w>."
                            }
                        },
                        {
                            "text": "Рабочие <w>плавить</w> руду начали еще ранним утром.",
                            "target_lang_translations": {
                                "de": "Die Arbeiter begannen schon früh am Morgen damit, das Erz zu <w>schmelzen</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "выплавлять"
                    ],
                    "common_phrases": [
                        "плавить сталь",
                        "плавить руду"
                    ],
                    "target_lang_definitions": {
                        "de": "Metall oder Legierungen aus Erz oder Rohstoffen gewinnen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "schmelzen",
                                "target_lang_sense_clarification": "im industriellen Kontext zur Metallgewinnung"
                            },
                            {
                                "target_lang_word": "verhütten",
                                "target_lang_sense_clarification": "spezifisch für die Gewinnung von Metall aus Erz"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d9baa565-f10e-370d-a3a6-43814c893bce",
                    "sense_definition": "Транспортировать груз, например древесину, по течению реки.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "float",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Весной лесорубы начинают <w>плавить</w> бревна вниз по реке.",
                            "target_lang_translations": {
                                "de": "Im Frühling beginnen die Holzfäller, die Baumstämme den Fluss hinunter zu <w>flößen</w>."
                            }
                        },
                        {
                            "text": "Раньше было принято <w>плавить</w> лес по большой воде.",
                            "target_lang_translations": {
                                "de": "Früher war es üblich, Holz bei Hochwasser zu <w>flößen</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "сплавлять"
                    ],
                    "common_phrases": [
                        "плавить лес"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Используется в контексте лесной промышленности."
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Fracht, wie zum Beispiel Holz, mit der Strömung eines Flusses transportieren."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "flößen",
                                "target_lang_sense_clarification": "Holz auf dem Wasserweg transportieren"
                            },
                            {
                                "target_lang_word": "spleißen",
                                "target_lang_sense_clarification": "regionaler oder fachsprachlicher Begriff für das Flößen"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}