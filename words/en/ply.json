    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "73677c57-fcee-389c-bba4-72c7b72f53fb",
                    "sense_definition": "A layer of material, such as paper, cloth, or wood.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "layer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This brand of tissue has an extra <w>ply</w> for added softness.",
                            "target_lang_translations": {
                                "de": "Diese Papiertaschentuchmarke hat eine zusätzliche <w>Lage</w> für noch mehr Weichheit."
                            }
                        },
                        {
                            "text": "The winter blanket is made of several <w>plies</w> of woven wool.",
                            "target_lang_translations": {
                                "de": "Die Winterdecke besteht aus mehreren <w>Lagen</w> gewebter Wolle."
                            }
                        }
                    ],
                    "synonyms": [
                        "layer",
                        "sheet",
                        "thickness"
                    ],
                    "common_phrases": [
                        "two-ply"
                    ],
                    "target_lang_definitions": {
                        "de": "Eine Lage oder Schicht eines Materials wie Papier, Stoff oder Holz."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Lage",
                                "target_lang_sense_clarification": "Schicht eines Materials, z. B. bei Papier"
                            },
                            {
                                "target_lang_word": "Schicht",
                                "target_lang_sense_clarification": "Materialschicht allgemein"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "24aa25b8-ea42-37f2-9e7e-6b175183d18d",
                    "sense_definition": "Plywood.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "layer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He bought a sheet of marine <w>ply</w> to repair the floorboards of the boat.",
                            "target_lang_translations": {
                                "de": "Er kaufte eine Platte <w>Bootsbausperrholz</w>, um die Bodenbretter des Bootes zu reparieren."
                            }
                        },
                        {
                            "text": "The workshop was filled with scraps of cheap <w>ply</w> from old building projects.",
                            "target_lang_translations": {
                                "de": "Die Werkstatt war voller Reste billigen <w>Sperrholzes</w> aus alten Bauprojekten."
                            }
                        }
                    ],
                    "synonyms": [
                        "plywood"
                    ],
                    "common_phrases": [
                        "marine ply"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "shortening of plywood"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Kurzform für Sperrholz."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Sperrholz",
                                "target_lang_sense_clarification": "Holzwerkstoff aus mehreren Lagen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cac28156-a4b6-3dfc-b54d-e213e06e7488",
                    "sense_definition": "A strand of yarn or rope twisted together with other strands.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "layer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The thick sweater was knitted using a heavy four <w>ply</w> wool.",
                            "target_lang_translations": {
                                "de": "Der dicke Pullover wurde aus schwerer <w>vierfädiger</w> Wolle gestrickt."
                            }
                        },
                        {
                            "text": "If one single <w>ply</w> snaps, the entire cord becomes significantly weaker.",
                            "target_lang_translations": {
                                "de": "Wenn ein einziger <w>Faden</w> reißt, wird die gesamte Schnur erheblich geschwächt."
                            }
                        }
                    ],
                    "synonyms": [
                        "strand"
                    ],
                    "common_phrases": [
                        "four ply"
                    ],
                    "target_lang_definitions": {
                        "de": "Ein Faden oder Einzelfaden, der mit anderen zu einem Garn oder Seil verzwirnt ist."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Faden",
                                "target_lang_sense_clarification": "Einzelfaden eines Garns"
                            },
                            {
                                "target_lang_word": "Litze",
                                "target_lang_sense_clarification": "Teilstrang eines Seils oder Drahts"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "04d21526-6f70-3e1b-a1fa-eb6d125c3b71",
                    "sense_definition": "In sequential two-player games, a half-turn or single move made by one player.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The chess engine evaluated variations up to twenty <w>plies</w> into the future.",
                            "target_lang_translations": {
                                "de": "Die Schach-Engine berechnete Varianten bis zu zwanzig <w>Halbzüge</w> im Voraus."
                            }
                        },
                        {
                            "text": "Each <w>ply</w> in the game tree represents an individual decision by either player.",
                            "target_lang_translations": {
                                "de": "Jeder <w>Halbzug</w> im Spielbaum stellt eine einzelne Entscheidung eines der beiden Spieler dar."
                            }
                        }
                    ],
                    "synonyms": [
                        "half-move"
                    ],
                    "target_lang_definitions": {
                        "de": "In sequenziellen Zwei-Personen-Spielen ein einzelner Zug eines Spielers bzw. ein Halbzug."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Halbzug",
                                "target_lang_sense_clarification": "einzelner Zug eines Spielers, z. B. beim Schach"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "317cb841-e4ba-31f6-9cf1-fb2f595b35ab",
                    "sense_definition": "A condition, state, or particular disposition.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His mind was cast in a peculiar <w>ply</w> that resisted any outside influence.",
                            "target_lang_translations": {
                                "de": "Sein Geist war von einer eigentümlichen <w>Gemütsart</w>, die sich jedem Einfluss von außen widersetzte."
                            }
                        },
                        {
                            "text": "The old diary revealed the troubled <w>ply</w> of his daily thoughts.",
                            "target_lang_translations": {
                                "de": "Das alte Tagebuch offenbarte die aufgewühlte <w>Verfassung</w> seiner täglichen Gedanken."
                            }
                        }
                    ],
                    "synonyms": [
                        "state",
                        "condition"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "no longer in common use"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Ein Zustand, eine Verfassung oder geistige Gesinnung."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Gemütsart",
                                "target_lang_sense_clarification": "geistige oder emotionale Verfassung"
                            },
                            {
                                "target_lang_word": "Verfassung",
                                "target_lang_sense_clarification": "Zustand oder Gestimmtheit"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "52d03a64-ca4b-3e89-bbc2-3c3d9abecb34",
                    "sense_definition": "A directional bent or inclination.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The wood had taken a natural <w>ply</w> to the left after years of weathering.",
                            "target_lang_translations": {
                                "de": "Das Holz hatte nach jahrelanger Witterung eine natürliche <w>Biegung</w> nach links angenommen."
                            }
                        },
                        {
                            "text": "His stubborn character showed a distinct <w>ply</w> toward suspicion and isolation.",
                            "target_lang_translations": {
                                "de": "Sein eigensinniger Charakter zeigte einen deutlichen <w>Hang</w> zu Misstrauen und Isolation."
                            }
                        }
                    ],
                    "synonyms": [
                        "bent",
                        "inclination"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rare or obsolete usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Eine Krümmung, Neigung oder Tendenz in eine bestimmte Richtung."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Neigung",
                                "target_lang_sense_clarification": "Hang oder Biegung"
                            },
                            {
                                "target_lang_word": "Hang",
                                "target_lang_sense_clarification": "Tendenz oder Sinnesrichtung"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "12d16b6d-b463-3411-bbfd-0825d01046c3",
                    "sense_definition": "To work diligently at a trade, business, or activity.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "work",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Local vendors <w>ply</w> their trade every Saturday morning along the crowded street.",
                            "target_lang_translations": {
                                "de": "Einheimische Händler <w>üben</w> jeden Samstagmorgen entlang der belebten Straße ihr Gewerbe <w>aus</w>."
                            }
                        },
                        {
                            "text": "For nearly four decades, the master tailor <w>plied</w> his craft in the same small shop.",
                            "target_lang_translations": {
                                "de": "Fast vier Jahrzehnte lang <w>ging</w> der Schneidermeister in derselben kleinen Werkstatt seinem Handwerk <w>nach</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "practice",
                        "pursue"
                    ],
                    "common_phrases": [
                        "ply one's trade"
                    ],
                    "target_lang_definitions": {
                        "de": "Einem Gewerbe, Beruf oder einer Tätigkeit eifrig nachgehen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "ausüben",
                                "target_lang_sense_clarification": "einen Beruf oder ein Gewerbe betreiben"
                            },
                            {
                                "target_lang_word": "nachgehen",
                                "target_lang_sense_clarification": "einer Arbeit oder Beschäftigung nachgehen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f4f0d0e2-e7e4-36ca-bbba-ba23d82807bd",
                    "sense_definition": "To travel regularly over a route or waters.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Small passenger ferries <w>ply</w> between the islands during the busy summer season.",
                            "target_lang_translations": {
                                "de": "Kleine Passagierfähren <w>verkehren</w> während der geschäftigen Sommersaison zwischen den Inseln."
                            }
                        },
                        {
                            "text": "Huge cargo ships continuously <w>ply</w> the waters of the narrow canal.",
                            "target_lang_translations": {
                                "de": "Riesige Frachtschiffe <w>befahren</w> ununterbrochen die Gewässer des schmalen Kanals."
                            }
                        }
                    ],
                    "synonyms": [
                        "travel",
                        "navigate"
                    ],
                    "common_phrases": [
                        "ply between"
                    ],
                    "target_lang_definitions": {
                        "de": "Regelmäßig auf einer bestimmten Route oder auf Gewässern verkehren."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "verkehren",
                                "target_lang_sense_clarification": "auf einer Route hin- und herfahren"
                            },
                            {
                                "target_lang_word": "befahren",
                                "target_lang_sense_clarification": "eine Route oder Gewässer regelmäßig befahren"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4ef1b3b3-ff3e-3726-9ec3-6a82be684a12",
                    "sense_definition": "To persist in offering food, drink, or gifts to someone, especially to persuade or influence them.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "press",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The host continued to <w>ply</w> his guests with food and wine all evening.",
                            "target_lang_translations": {
                                "de": "Der Gastgeber fuhr fort, seine Gäste den ganzen Abend lang mit Speis und Trank zu <w>überhäufen</w>."
                            }
                        },
                        {
                            "text": "They tried to <w>ply</w> the visiting diplomat with expensive gifts before signing the agreement.",
                            "target_lang_translations": {
                                "de": "Sie versuchten, den angereisten Diplomaten vor der Unterzeichnung des Abkommens mit teuren Geschenken zu <w>überhäufen</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "shower",
                        "feed"
                    ],
                    "common_phrases": [
                        "ply with drink"
                    ],
                    "target_lang_definitions": {
                        "de": "Jemanden beharrlich mit Essen, Trinken oder Geschenken versorgen, oft um ihn zu überreden oder zu beeinflussen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "überhäufen",
                                "target_lang_sense_clarification": "jemanden mit Speisen, Getränken oder Geschenken überhäufen"
                            },
                            {
                                "target_lang_word": "abfüllen",
                                "target_lang_sense_clarification": "jemandem beharrlich Alkohol einschenken"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d58fbc82-26a3-3110-9087-59fa9732322b",
                    "sense_definition": "To press upon someone persistently with questions, solicitations, or demands.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "press",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Reporters gathered around the minister to <w>ply</w> her with questions about the scandal.",
                            "target_lang_translations": {
                                "de": "Reporter versammelten sich um die Ministerin, um sie mit Fragen über den Skandal zu <w>löchern</w>."
                            }
                        },
                        {
                            "text": "The detectives continued to <w>ply</w> the suspect with inquiries throughout the night.",
                            "target_lang_translations": {
                                "de": "Die Ermittler fuhren fort, den Verdächtigen die ganze Nacht hindurch mit Fragen zu <w>bombardieren</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "bombard",
                        "badger"
                    ],
                    "common_phrases": [
                        "ply with questions"
                    ],
                    "target_lang_definitions": {
                        "de": "Jemanden beharrlich mit Fragen, Bitten oder Forderungen bedrängen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "löchern",
                                "target_lang_sense_clarification": "jemanden beharrlich mit Fragen bedrängen"
                            },
                            {
                                "target_lang_word": "bombardieren",
                                "target_lang_sense_clarification": "jemanden mit Fragen überhäufen"
                            },
                            {
                                "target_lang_word": "bedrängen",
                                "target_lang_sense_clarification": "mit Bitten oder Forderungen zusetzen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0982374c-997e-337d-8516-c7e63323a32a",
                    "sense_definition": "To wield or use a tool or weapon steadily or vigorously.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "work",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The woodcutter <w>plied</w> his axe relentlessly until the tall tree came crashing down.",
                            "target_lang_translations": {
                                "de": "Der Holzfäller <w>schwang</w> unerbittlich seine Axt, bis der hohe Baum krachend umstürzte."
                            }
                        },
                        {
                            "text": "She silently <w>plied</w> her needle by the window while listening to the radio.",
                            "target_lang_translations": {
                                "de": "Sie <w>führte</w> schweigend am Fenster ihre Nadel, während sie Radio hörte."
                            }
                        }
                    ],
                    "synonyms": [
                        "wield",
                        "handle",
                        "manipulate"
                    ],
                    "target_lang_definitions": {
                        "de": "Ein Werkzeug oder eine Waffe unermüdlich oder geschickt führen bzw. handhaben."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "schwingen",
                                "target_lang_sense_clarification": "ein Werkzeug oder eine Waffe führen"
                            },
                            {
                                "target_lang_word": "handhaben",
                                "target_lang_sense_clarification": "ein Werkzeug bedienen"
                            },
                            {
                                "target_lang_word": "führen",
                                "target_lang_sense_clarification": "ein Werkzeug, z. B. eine Nadel, leiten"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8db430a5-32e9-37ab-bec7-83aaafc33935",
                    "sense_definition": "To work diligently or steadily.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "work",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The scholars had to <w>ply</w> hard every night to complete the translation on schedule.",
                            "target_lang_translations": {
                                "de": "Die Gelehrten mussten jede Nacht hart <w>schuften</w>, um die Übersetzung pünktlich fertigzustellen."
                            }
                        },
                        {
                            "text": "He spent years <w>plying</w> on the docks to support his growing family.",
                            "target_lang_translations": {
                                "de": "Er verbrachte Jahre damit, an den Docks zu <w>rackern</w>, um seine wachsende Familie zu ernähren."
                            }
                        }
                    ],
                    "synonyms": [
                        "toil",
                        "labor"
                    ],
                    "antonyms": [
                        "idle"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "uncommon intransitive use"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Fleißig, unermüdlich und stetig arbeiten."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "schuften",
                                "target_lang_sense_clarification": "hart arbeiten"
                            },
                            {
                                "target_lang_word": "rackern",
                                "target_lang_sense_clarification": "sich abmühen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bc86ec12-9f00-39a7-8d37-769e40b21dbe",
                    "sense_definition": "To bend, flex, or yield to physical force.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "bend",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The flexible branches of the willow <w>plied</w> easily beneath the furious gusts of wind.",
                            "target_lang_translations": {
                                "de": "Die biegsamen Äste der Weide <w>gaben</w> unter den heftigen Windböen leicht <w>nach</w>."
                            }
                        },
                        {
                            "text": "Rather than break against the heavy snow, the slender sapling <w>plied</w> downward.",
                            "target_lang_translations": {
                                "de": "Statt unter dem schweren Schnee zu brechen, <w>bog sich</w> das schlanke Bäumchen nach unten."
                            }
                        }
                    ],
                    "synonyms": [
                        "bend",
                        "yield",
                        "flex"
                    ],
                    "antonyms": [
                        "resist"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "mostly replaced by bend or yield"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Sich biegen, nachgeben oder elastisch auf physische Kraft reagieren."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "nachgeben",
                                "target_lang_sense_clarification": "unter Krafteinwirkung beugen oder nachgeben"
                            },
                            {
                                "target_lang_word": "sich biegen",
                                "target_lang_sense_clarification": "sich krümmen oder federn"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cbe37246-45ee-386e-b5d2-1729716d69cd",
                    "sense_definition": "To bend, fold, or shape something; to cause someone to yield or submit.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "bend",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The gardener carefully <w>plied</w> the young branches along the wooden trellis.",
                            "target_lang_translations": {
                                "de": "Der Gärtner <w>bog</w> die jungen Zweige behutsam entlang des Holzspaliers."
                            }
                        },
                        {
                            "text": "No amount of flattery could <w>ply</w> the determined judge into granting a pardon.",
                            "target_lang_translations": {
                                "de": "Keine noch so große Schmeichelei konnte den entschlossenen Richter dazu <w>erweichen</w>, eine Begnadigung zu gewähren."
                            }
                        }
                    ],
                    "synonyms": [
                        "bend",
                        "mold",
                        "sway"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "now rare in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Etwas biegen, falten oder formen; jemanden zum Nachgeben bringen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "biegen",
                                "target_lang_sense_clarification": "in eine Form bringen oder krümmen"
                            },
                            {
                                "target_lang_word": "falten",
                                "target_lang_sense_clarification": "zusammenlegen oder umknicken"
                            },
                            {
                                "target_lang_word": "erweichen",
                                "target_lang_sense_clarification": "jemanden zum Einlenken bringen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9e242008-e21b-3d55-a1c4-6de573b49968",
                    "sense_definition": "To maneuver a sailing vessel against the wind; to tack or beat to windward.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The crew had to <w>ply</w> carefully against the headwind to reach the harbor entrance.",
                            "target_lang_translations": {
                                "de": "Die Mannschaft musste vorsichtig gegen den Gegenwind <w>kreuzen</w>, um die Hafeneinfahrt zu erreichen."
                            }
