                "senses": [
                    {
                        "sense_id": "1cfca82d-6ff7-3481-9da6-da5a0a8e30ac",
                        "entry_id": "f86d56c6-8a45-30c1-967c-7b1981bb0325",
                        "glosses": [
                            "Hybride (Lavandula X intermedia) entre la lavande vraie (Lavandula angustifolia) et de l'aspic (Lavandula latifolia), cultivé pour la parfumerie."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "2c0f4d89-d564-4e48-88a8-54adec29a2b0",
                                "sense_id": "1cfca82d-6ff7-3481-9da6-da5a0a8e30ac",
                                "text": "L’essence de lavande anglaise est produite par l’hybride de lavande et d’aspic appelé lavandin en France ; la production de cette essence est de 2 à 3.000 kilos par an."
                            },
                            {
                                "example_id": "0ea38061-402f-4fc1-819e-7f250815e8de",
                                "sense_id": "1cfca82d-6ff7-3481-9da6-da5a0a8e30ac",
                                "text": "Théoriquement, on peut supposer que si on pouvait « décamphrer » l’essence de Lavandin, riche en linalol, on aurait un produit très fin, comparable à l’essence de Lavande italienne."
                            }
                        ]
                    }
