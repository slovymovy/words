{
    "word_family": [
        "scribal",
        "scriber",
        "scribble",
        "inscribe",
        "describe",
        "prescribe",
        "proscribe",
        "transcribe",
        "superscribe",
        "subscribing"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9fe8152c-2605-305f-a7dc-4d7c01ef0f0c",
                    "sense_definition": "A person who writes books or documents by hand as a profession, especially before the invention of printing.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "writer_profession",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In ancient Egypt, a professional <w>scribe</w> held a highly respected position in society.",
                            "target_lang_translations": {
                                "ru": "В Древнем Египте профессиональный <w>писец</w> занимал весьма уважаемое положение в обществе."
                            }
                        },
                        {
                            "text": "The medieval <w>scribe</w> spent many hours copying religious manuscripts by hand.",
                            "target_lang_translations": {
                                "ru": "Средневековый <w>писец</w> проводил много часов, переписывая религиозные рукописи от руки."
                            }
                        }
                    ],
                    "synonyms": [
                        "amanuensis",
                        "scrivener"
                    ],
                    "common_phrases": [
                        "ancient scribe",
                        "medieval scribe"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который профессионально переписывает книги или документы от руки, особенно до изобретения книгопечатания."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "писец",
                                "target_lang_sense_clarification": "исторический переписчик рукописей"
                            },
                            {
                                "target_lang_word": "писарь",
                                "target_lang_sense_clarification": "человек, занимающийся перепиской бумаг"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a6c556ec-5b63-3cee-8dbe-67f839410a5a",
                    "sense_definition": "A writer and doctor of the law in ancient Jewish society; one skilled in the law and traditions who read and explained them.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "religious_scholar",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The people gathered in the temple to listen to the <w>scribe</w> explain the ancient laws.",
                            "target_lang_translations": {
                                "ru": "Люди собрались в храме, чтобы послушать, как <w>книжник</w> разъясняет древние законы."
                            }
                        },
                        {
                            "text": "As a learned <w>scribe</w>, he was responsible for interpreting religious texts for the community.",
                            "target_lang_translations": {
                                "ru": "Как ученый <w>книжник</w>, он отвечал за толкование религиозных текстов для общины."
                            }
                        }
                    ],
                    "common_phrases": [
                        "jewish scribe"
                    ],
                    "target_lang_definitions": {
                        "ru": "Писатель и законоучитель в древнееврейском обществе; знаток законов и традиций, который читал и разъяснял их."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "книжник",
                                "target_lang_sense_clarification": "библейский толкователь закона"
                            },
                            {
                                "target_lang_word": "писец",
                                "target_lang_sense_clarification": "в древнеиудейском обществе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2ad0ded6-05ce-3cc1-b37b-536899caf96c",
                    "sense_definition": "A very sharp, steel drawing implement used in engraving, etching, or carpentry to mark lines; a scriber.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "tool",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The carpenter used a steel <w>scribe</w> to mark a precise line on the metal sheet.",
                            "target_lang_translations": {
                                "ru": "Плотник использовал стальную <w>чертилку</w>, чтобы наметить точную линию на металлическом листе."
                            }
                        },
                        {
                            "text": "Keep the tip of the <w>scribe</w> sharp to ensure clean and accurate engravings.",
                            "target_lang_translations": {
                                "ru": "Держите кончик <w>чертилки</w> острым, чтобы обеспечить чистую и точную гравировку."
                            }
                        }
                    ],
                    "common_phrases": [
                        "steel scribe"
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень острый стальной чертежный инструмент, используемый в гравировании, травлении или плотницком деле для разметки линий."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чертилка",
                                "target_lang_sense_clarification": "инструмент для разметки"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2e8c04a6-77ef-3548-9b57-bd1f72d4af12",
                    "sense_definition": "A journalist or writer.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "writer_profession",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The local sports <w>scribe</w> wrote a detailed report on the championship game.",
                            "target_lang_translations": {
                                "ru": "Местный спортивный <w>писака</w> написал подробный отчет о финальной игре чемпионата."
                            }
                        },
                        {
                            "text": "Several prominent <w>scribes</w> attended the press conference to ask questions.",
                            "target_lang_translations": {
                                "ru": "Несколько известных <w>журналистов</w> присутствовали на пресс-конференции, чтобы задать вопросы."
                            }
                        }
                    ],
                    "common_phrases": [
                        "sports scribe"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Sometimes used humorously or journalistically to refer to writers."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Журналист или писатель."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "писака",
                                "target_lang_sense_clarification": "разговорное или ироничное о писателе, журналисте"
                            },
                            {
                                "target_lang_word": "писатель",
                                "target_lang_sense_clarification": "автор текстов"
                            },
                            {
                                "target_lang_word": "журналист",
                                "target_lang_sense_clarification": "сотрудник СМИ"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4c457e1a-6b41-3ce7-80dc-206c3d4d8873",
                    "sense_definition": "To write, engrave, or mark upon; to inscribe.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "marking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He carefully <w>scribed</w> his initials onto the wooden box.",
                            "target_lang_translations": {
                                "ru": "Он аккуратно <w>выгравировал</w> свои инициалы на деревянной шкатулке."
                            }
                        },
                        {
                            "text": "The artist decided to <w>scribe</w> a pattern along the border of the clay pot.",
                            "target_lang_translations": {
                                "ru": "Художник решил <w>нанести</w> узор по краю глиняного горшка."
                            }
                        }
                    ],
                    "common_phrases": [
                        "scribe a line"
                    ],
                    "target_lang_definitions": {
                        "ru": "Писать, гравировать или наносить разметку; делать надпись."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вычерчивать",
                                "target_lang_sense_clarification": "наносить линии"
                            },
                            {
                                "target_lang_word": "гравировать",
                                "target_lang_sense_clarification": "вырезать надпись или рисунок"
                            },
                            {
                                "target_lang_word": "размечать",
                                "target_lang_sense_clarification": "наносить разметку чертилкой"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "65378637-a6ea-359e-8d89-7e098c21fa59",
                    "sense_definition": "To cut or shape something in order to fit it closely to an irregular surface.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "carpentry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The carpenter had to <w>scribe</w> the cabinet face to fit the uneven stone wall.",
                            "target_lang_translations": {
                                "ru": "Плотнику пришлось <w>подогнать</w> фасад шкафа под неровную каменную стену."
                            }
                        },
                        {
                            "text": "If you <w>scribe</w> the molding carefully, there will be no visible gaps against the floor.",
                            "target_lang_translations": {
                                "ru": "Если вы аккуратно <w>подгоните</w> плинтус, между ним и полом не будет видимых зазоров."
                            }
                        }
                    ],
                    "common_phrases": [
                        "scribe to fit"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Commonly used in technical carpentry and woodworking contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Подрезать или подгонять деталь, чтобы она плотно прилегала к неровной поверхности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подгонять",
                                "target_lang_sense_clarification": "точно прилаживать к неровной поверхности"
                            },
                            {
                                "target_lang_word": "припасовывать",
                                "target_lang_sense_clarification": "в столярном деле"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2357e7a4-2136-304a-b984-dc0e0734abbf",
                    "sense_definition": "To record or write down information, acting as a scribe.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "marking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She was asked to <w>scribe</w> the minutes of the meeting for the committee.",
                            "target_lang_translations": {
                                "ru": "Ее попросили <w>вести протокол</w> заседания комитета."
                            }
                        },
                        {
                            "text": "He sat quietly in the corner to <w>scribe</w> the details of the transaction.",
                            "target_lang_translations": {
                                "ru": "Он тихо сидел в углу, чтобы <w>записывать</w> детали сделки."
                            }
                        }
                    ],
                    "common_phrases": [
                        "scribe the minutes"
                    ],
                    "target_lang_definitions": {
                        "ru": "Записывать или фиксировать информацию, выполняя обязанности секретаря или писца."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вести протокол",
                                "target_lang_sense_clarification": "записывать ход собрания"
                            },
                            {
                                "target_lang_word": "записывать",
                                "target_lang_sense_clarification": "фиксировать информацию на бумаге"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}