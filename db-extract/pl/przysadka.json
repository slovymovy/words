                "senses": [
                    {
                        "sense_id": "447468f7-023e-3b46-b938-25726be46a8b",
                        "entry_id": "74accafc-ae59-3f8e-9845-fad925373b11",
                        "glosses": [
                            "mały listek wyrastający u nasady szypułki kwiatowej"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "91dba274-d04b-456a-be31-9ab8083cf24b",
                                "sense_id": "447468f7-023e-3b46-b938-25726be46a8b",
                                "text": "Kwiatek męski [wierzby] składa się z przysadki, gruczołów miodowych i czasem posiada niedorozwinięty słupek"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "0d5dfef6-7d19-3eda-ab2c-2e3aab72ce25",
                        "entry_id": "74accafc-ae59-3f8e-9845-fad925373b11",
                        "glosses": [
                            "posadzenie, dosadzenie dodatkowo czego (roślin)"
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "d6d2ed02-ebbc-4281-9bd4-8fff9060b3e1",
                                "sense_id": "0d5dfef6-7d19-3eda-ab2c-2e3aab72ce25",
                                "text": "Niezależnie od tego, dostawali komornicy w polu na przysadki tyle roli na kartofle, ile jej nawozem z pod trzody chlewnej wygnoić mogli"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "ca8d51a9-8b81-36e5-82b9-bfff3319e874",
                        "entry_id": "74accafc-ae59-3f8e-9845-fad925373b11",
                        "glosses": [
                            "nieparzysty gruczoł wydzielania wewnętrznego, leżący w jamie czaszki na trzonie kości klinowej; reguluje czynność wydzielniczą innych gruczołów dokrewnych"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "30829fae-793b-487f-938a-2405f937a765",
                                "sense_id": "ca8d51a9-8b81-36e5-82b9-bfff3319e874",
                                "text": "Przysadka zajmuje m.inn.(sic!) narządami o wewnętrznym wydzielaniu rolę nadrzędną"
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    }
                ],
