                                            "vulgar"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "lumber",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "436edbb3-a3d8-3b1d-a563-e2e51557b315",
                                        "entry_id": "fc8a27b5-58a0-3351-b5da-c2cbd366f820",
                                        "glosses": [
                                            "To move clumsily and heavily; to move slowly."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e323d862-8158-4ebd-bc95-5d550dbcd508",
                                                "sense_id": "436edbb3-a3d8-3b1d-a563-e2e51557b315",
                                                "text": "...he was only apprized of the arrival of the Monkbarns division by the gee-hupping of the postilion, as the post-chaise lumbered up behind him."
                                            },
                                            {
                                                "example_id": "ee0a81d3-0427-4e81-9ee3-69cf3b2cc262",
                                                "sense_id": "436edbb3-a3d8-3b1d-a563-e2e51557b315",
                                                "text": "The trooper climbed back on the rock and slid down to take the cadaver lowered to him by Bradly, who lumbered down to assist in carrying it."
                                            },
                                            {
                                                "example_id": "0e9f8dfd-6d1c-46ee-9ca8-b45b4646acc1",
                                                "sense_id": "436edbb3-a3d8-3b1d-a563-e2e51557b315",
                                                "text": "2002, Russell Allen, \"Incantations of the Apprentice\", on Symphony X, The Odyssey.\nThrough eerie reach of ancient woods / Where lumbering mists arise / I journey for nines moons of the year / To where a land of legend lies"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dbe4d9f4-dbce-3bb9-bc55-dd5cfe1547d0",
                                        "entry_id": "fc8a27b5-58a0-3351-b5da-c2cbd366f820",
                                        "glosses": [
                                            "To load down with things, to fill, to encumber, to impose an unwanted burden on."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "943e3048-aed6-42ba-bf11-31ad08ef7c16",
                                                "sense_id": "dbe4d9f4-dbce-3bb9-bc55-dd5cfe1547d0",
                                                "text": "They’ve lumbered me with all these suitcases."
                                            },
                                            {
                                                "example_id": "dca7ec64-5f10-4ff7-9665-fa8bcfeebd69",
                                                "sense_id": "dbe4d9f4-dbce-3bb9-bc55-dd5cfe1547d0",
                                                "text": "I got lumbered with that boring woman all afternoon."
                                            },
                                            {
                                                "example_id": "a4091127-e212-4e50-9640-048832a07046",
                                                "sense_id": "dbe4d9f4-dbce-3bb9-bc55-dd5cfe1547d0",
                                                "text": "The mean utensils, pewter measures, empty cans and casks, with which this room was lumbered, proclaimed it that of the host, who slept, surrounded by his professional implements of hospitality and stock in trade."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bc58689d-5ecf-374b-8777-3bb061e37f94",
                                        "entry_id": "fc8a27b5-58a0-3351-b5da-c2cbd366f820",
                                        "glosses": [
                                            "To heap together in disorder."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5cfa6b1e-14ae-4987-a2be-794f70eed2e7",
                                                "sense_id": "bc58689d-5ecf-374b-8777-3bb061e37f94",
                                                "text": "so much stuff lumberd together"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3f106814-c493-3ac4-9dfa-a8c89e8815f8",
                                        "entry_id": "fc8a27b5-58a0-3351-b5da-c2cbd366f820",
                                        "glosses": [
                                            "To fill or encumber with lumber."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c81b206-1ea8-4efa-8252-9b95bf7da909",
                                                "sense_id": "3f106814-c493-3ac4-9dfa-a8c89e8815f8",
                                                "text": "to lumber up a room"
                                            }
                                        ]
                                    },
