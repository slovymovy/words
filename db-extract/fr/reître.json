        "fr-extract.jsonl": [
            {
                "entry_id": "5fecdfb2-139d-33ed-ad16-f7a2bc8948b5",
                "word": "reître",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "8a115796-f562-49fe-9cfd-cc7455b0e429",
                        "entry_id": "5fecdfb2-139d-33ed-ad16-f7a2bc8948b5",
                        "tags": [
