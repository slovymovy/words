                "entry_id": "5aa8891f-ed9c-3035-8478-89080c29f0dd",
                "word": "paralipsis",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "8b3190b7-4589-46e1-9513-fe2f91b83efe",
                        "entry_id": "5aa8891f-ed9c-3035-8478-89080c29f0dd",
                        "tags": [
                            "plural"
