                "senses": [
                    {
                        "sense_id": "d02ad7e7-8a46-3057-be14-1f58ff202be4",
                        "entry_id": "bfb8c486-22d0-3d5b-aee2-b7c0221e5a0e",
                        "glosses": [
                            "elk van de delen van een in stukken gebroken object"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d81e948-7dfb-48ea-ab85-8bbdb5c0ab8c",
                                "sense_id": "d02ad7e7-8a46-3057-be14-1f58ff202be4",
                                "text": "De brokstukken liggen over honderden meters verspreid."
                            },
                            {
                                "example_id": "72d0bc43-226b-4287-9f40-250a1e670775",
                                "sense_id": "d02ad7e7-8a46-3057-be14-1f58ff202be4",
                                "text": "Bij deeltjesfysici leeft de hoop dat wanneer ze deeltjes met steeds meer energie op elkaar schieten, in de brokstukken vanzelf een keer nieuwe, nog onbekende exemplaren opduiken. Daarnaast kan een sterkere reactor de eigenschappen van het higgsdeeltje nauwkeuriger in kaart gaan brengen. Dat staat bij de bouw van de FCC bovenaan de verlanglijst."
                            }
                        ]
                    }
