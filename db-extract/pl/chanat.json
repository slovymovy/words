                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "80115083-a5fd-3b8e-8b85-7a14682897be",
                        "entry_id": "8266bc11-d432-367b-a8d8-74dbb761f4de",
                        "glosses": [
                            "państwo zarządzane przez chana"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d566a193-b6fd-4da4-94d9-f8f61d8a75b8",
                                "sense_id": "80115083-a5fd-3b8e-8b85-7a14682897be",
                                "text": "Chanat mógł być podporządkowany innym chanatom lub być częścią kaganatu lub (w erze nowożytnej) sułtanatu"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "efd97320-176b-4d5c-beeb-57795a79368f",
                        "source_entry_id": "8266bc11-d432-367b-a8d8-74dbb761f4de",
                        "source_sense_id": "80115083-a5fd-3b8e-8b85-7a14682897be",
                        "target_lang_word": "khaganate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "khaganate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c30b1da8-4c39-3390-befe-ea2717c45b62",
                                        "entry_id": "c3d904f2-53fe-3d45-9906-84647fefa743",
                                        "glosses": [
                                            "An empire comprising several khanates."
                                        ],
                                        "tags": [],
