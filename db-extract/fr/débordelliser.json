                ],
                "senses": [
                    {
                        "sense_id": "52b15f2c-1366-3444-8bd7-9fcfd738746e",
                        "entry_id": "f495d51f-7c8c-3586-a7eb-f41dea2fc2c8",
                        "glosses": [
                            "Faire perdre son caractère bordélique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ad634f7-5b5a-410b-b9c2-a47f2ea3dc2a",
                                "sense_id": "52b15f2c-1366-3444-8bd7-9fcfd738746e",
                                "text": "Mais je dois débordelliser cette semaine donc je ferai ça asap."
                            },
                            {
                                "example_id": "7cc20bab-afaa-467b-b24b-18be828a6963",
                                "sense_id": "52b15f2c-1366-3444-8bd7-9fcfd738746e",
                                "text": "Dans ce genre de soirée, je dois : débordelliser la cuisine, que les enfants ont ravagé pendant le repas, vider-remplir le lave vaisselle, vider-remplir la machine à laver, plier-ranger le linge, préparer le repas du lendemain pour Lilou et/ou Zéphir et donc finir mon travail si je n'ai pas pu assez arnaqué le client."
                            },
                            {
                                "example_id": "8afaf725-d53d-40ee-a035-3b53f9d1d267",
                                "sense_id": "52b15f2c-1366-3444-8bd7-9fcfd738746e",
                                "text": "Nous ferons cette même évaluation dans chaque pièce de la maison quand nous commencerons à la débordelliser."
                            }
                        ]
                    }
                ],
