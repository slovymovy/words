                    {
                        "sense_id": "7596c104-f564-3936-9aee-dbfc0fc9fc40",
                        "entry_id": "7a785a68-6fdc-3a22-9722-76795f27e1ad",
                        "glosses": [
                            "Stelle an einer Kartoffel, an der sich ein Trieb bildet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0fa6b25d-90e6-4811-818e-40f8f47275d2",
                                "sense_id": "7596c104-f564-3936-9aee-dbfc0fc9fc40",
                                "text": "„Die Mutter rammte das Messer in ein Kartoffelauge, das sie längst ausgestochen hatte.“"
                            },
                            {
                                "example_id": "dcacf92f-cc7e-4311-9792-ca98939f7047",
                                "sense_id": "7596c104-f564-3936-9aee-dbfc0fc9fc40",
                                "text": "„Steckt man eine Knolle mit einem Kartoffelauge in den Boden, entsteht daraus eine Staude mit Kartoffeln, deren Erbmaterial deckungsgleich mit dem der Ausgangsknolle ist.“"
                            }
                        ],
