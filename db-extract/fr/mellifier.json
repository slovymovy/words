                ],
                "senses": [
                    {
                        "sense_id": "0c72cbbe-9f07-32fa-b735-4be97fae32a2",
                        "entry_id": "077482e6-09bf-36a1-a430-f134a6e0d974",
                        "glosses": [
                            "Faire du miel, transformer en miel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e7969ea7-30d1-4238-a4e4-461d37c94c54",
                                "sense_id": "0c72cbbe-9f07-32fa-b735-4be97fae32a2",
                                "text": "Leurs paysans sont des abeilles qui mellifient silencieusement pour le collecteur d'impôt."
                            },
                            {
                                "example_id": "10b58529-1d60-4ac7-8623-87f1879fa2dd",
                                "sense_id": "0c72cbbe-9f07-32fa-b735-4be97fae32a2",
                                "text": "Parmi les arômes du Nombre sacré fixé au sommet du dôme Arcadien, comme cette cellule altière par où l'abeille commence à mellifier, il a mêlé le nom de celui qui, pour lui, fut toujours le symbole de sa foi dans la régénération du Siècle et de la Cité : Nombre ou Dieu, Axiome, Prince des hommes, synonymes éternels dans les invocations de l'Espérance !"
                            },
                            {
                                "example_id": "c8723469-5623-4ea4-bc91-991e1382ce19",
                                "sense_id": "0c72cbbe-9f07-32fa-b735-4be97fae32a2",
                                "text": "Si nous lançons des lunes d'un prix exorbitant ce n'est pas pour faire aboyer les chiens, travailler le vin nouveau, mellifier nos amours, ni même pour défier les vieilles lunes."
                            }
                        ]
                    }
                ],
