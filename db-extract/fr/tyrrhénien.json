                "senses": [
                    {
                        "sense_id": "fcaac83b-64e3-3723-b0be-1a28a1d810d2",
                        "entry_id": "9706ce8b-0fa7-3ffe-80b8-2671c285dbf9",
                        "glosses": [
                            "Qui a rapport à l'ancienne Tyrrhénie ou aux Tyrrhéniens."
                        ],
                        "tags": [
                            "Ancient"
                        ],
                        "examples": [
                            {
                                "example_id": "9703d592-a665-4c75-bac6-b630ae7bbb30",
                                "sense_id": "fcaac83b-64e3-3723-b0be-1a28a1d810d2",
                                "text": "Civilisation tyrrhénienne, vase tyrrhénien."
                            },
                            {
                                "example_id": "faa69864-a5a5-494b-a941-34b4a6cd427e",
                                "sense_id": "fcaac83b-64e3-3723-b0be-1a28a1d810d2",
                                "text": "Près de Salerne (...) le temple de la Junon argienne, fondé par Iason (...) indique peut-être que les villes voisines, Herculanum, Pompeii, Marcina, sont d'origine tyrrhénienne. (Michelet, Hist. romaine, t. 1, 1831, p. 18)"
                            },
                            {
                                "example_id": "639f8d20-9a36-4428-b0b7-fb48a7d87449",
                                "sense_id": "fcaac83b-64e3-3723-b0be-1a28a1d810d2",
                                "text": "Mer Tyrrhénienne, partie de la Méditerranée occidentale."
                            }
                        ]
                    },
                    {
                        "sense_id": "324203eb-0395-3fe1-992f-26ac6d2aeeba",
                        "entry_id": "9706ce8b-0fa7-3ffe-80b8-2671c285dbf9",
                        "glosses": [
                            "Relatif à la mer Tyrrhénienne."
                        ],
                        "tags": [
                            "Toponymie"
                        ],
                        "examples": [
                            {
                                "example_id": "6c9b0fc3-d03e-4146-92eb-d361bdca1702",
                                "sense_id": "324203eb-0395-3fe1-992f-26ac6d2aeeba",
                                "text": "Espèce subsarmatique nouvelle pour la Corse et pour tout l’archipel tyrrhénien."
                            }
                        ]
                    }
                ],
