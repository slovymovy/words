                ],
                "senses": [
                    {
                        "sense_id": "79b2328a-3c7e-3387-b1b0-c3182538cd8e",
                        "entry_id": "567469c5-9883-37ec-9939-90310af91bb7",
                        "glosses": [
                            "Paar von Primzahlen, die sich um zwei unterscheiden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "38f6310f-f57c-43c4-b3fc-684b97217792",
                                "sense_id": "79b2328a-3c7e-3387-b1b0-c3182538cd8e",
                                "text": "3 und 5 bilden einen Primzahlzwilling."
                            },
                            {
                                "example_id": "1ac7d479-8746-410c-81c2-1833da66ba63",
                                "sense_id": "79b2328a-3c7e-3387-b1b0-c3182538cd8e",
                                "text": "Nach einer veralteten Definition ist 1 prim und gehört folglich mit 3 zu einem Primzahlzwilling."
                            },
                            {
                                "example_id": "9b83d472-572f-4951-8fd0-0fe827110f5f",
                                "sense_id": "79b2328a-3c7e-3387-b1b0-c3182538cd8e",
                                "text": "Vereinzelte Primzahlen nannte Stäckel solche Primzahlen, die keinem Primzahlzwilling angehören."
                            },
                            {
                                "example_id": "ed8ddf49-cba4-43a4-9ab0-307d16e1242a",
                                "sense_id": "79b2328a-3c7e-3387-b1b0-c3182538cd8e",
                                "text": "„Elf ist Primzahl und als kleiner Bruder der Dreizehn ein Primzahlzwilling.“"
                            },
                            {
                                "example_id": "a0006c30-b17e-49ce-93d9-ee925468fb65",
                                "sense_id": "79b2328a-3c7e-3387-b1b0-c3182538cd8e",
                                "text": "„Die noch unbewiesene Primzahlzwillingsvermutung besagt, es gebe unendlich viele Primzahlzwillinge.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c3d08e3b-2128-3ea0-b113-3a474f246f09",
                        "entry_id": "567469c5-9883-37ec-9939-90310af91bb7",
                        "glosses": [
                            "Primzahl, die sich um zwei von einer anderen Primzahl unterscheidet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "57677b25-1454-4df3-bc2c-971fd8668f7b",
                                "sense_id": "c3d08e3b-2128-3ea0-b113-3a474f246f09",
                                "text": "2 996 863 034 895 · 2^(1 290 000) ± 1 sind die größten bekannten Primzahlzwillinge (Stand: September 2016)."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
