                                        "sense_id": "ea9fbc73-901f-3e26-aac5-3ce6a08d8e01",
                                        "entry_id": "41f8b48f-172e-3c79-b5ee-04eeedcf9e23",
                                        "glosses": [
                                            "relating to the antipodes, or situated at opposite sides of the Earth"
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d016a656-d177-376d-aade-f3465726f538",
                                        "entry_id": "41f8b48f-172e-3c79-b5ee-04eeedcf9e23",
                                        "glosses": [
                                            "of, or pertaining to, Australia or New Zealand"
                                        ],
                                        "tags": [
                                            "informal",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ac1e2d22-f832-4143-bdc4-cba1390255d2",
                                                "sense_id": "d016a656-d177-376d-aade-f3465726f538",
                                                "text": "So there is a certain sense of achievement just in arriving in Australia—a pleasure and satisfaction to be able to step from the airport terminal into dazzling antipodean sunshine[…]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "antipodean",
                                "target_lang_code": "en",
                                "target_senses": [
