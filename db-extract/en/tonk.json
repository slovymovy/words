                        "glosses": [
                            "Big, muscular, massive."
                        ],
                        "tags": [
                            "UK",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "1bc9dc62-1ed9-4768-afd6-c40d0ae85614",
                                "sense_id": "223e20e8-86e7-3049-9d20-4916fe58d87a",
                                "text": "In this new paradigm of masculine excellence, anyone can achieve physical perfection if they put in the hours. It is an aspirational narrative, accompanied by a specific vernacular. Men are hench, wammo or tonk. […] Whereas the vest-wearing action stars of the 80s needed physical strength to hoik themselves into lift shafts and avert terrorism, today’s uber-tonk males wear their six-packs like beautiful, pointless feathers: this is a cosmetic muscularity, rather than a functional one."
                            }
                        ]
                    }
