                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0faf34d6-7e79-471b-9393-da968442fd9d",
                                "sense_id": "5ceac790-208e-3f5d-99cb-7581aec25ecb",
                                "text": "Les derniers mois auront été très occupés pour la présidente du Conseil du trésor. Mme LeBel, que nous avons connue lors de la commission Charbonneau, a démontré son talent de négociatrice hors pair."
                            }
                        ]
                    }
                ],
