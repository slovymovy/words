                "translations": [
                    {
                        "translation_id": "62eb3b81-7744-4aa9-858a-a190b5ee6cd4",
                        "source_entry_id": "51d60a51-2e7a-3663-bd7a-adfa77373e20",
                        "source_sense_id": "21ae5ebd-4457-36fd-ba7b-0821536c7ce3",
                        "target_lang_word": "truly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "truly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "af5d81d9-34dc-35d8-b49c-058e04ba84bf",
                                        "entry_id": "cd194688-9c67-32c9-b62d-13e8e9a8c370",
                                        "glosses": [
                                            "In accordance with the facts; truthfully, accurately."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9dc5354c-d4ed-4096-ba05-4f3495fb3ba0",
                                                "sense_id": "af5d81d9-34dc-35d8-b49c-058e04ba84bf",
                                                "text": "He adds, very truly, that what was fatal to such philosophies as his was not Christianity but the Copernican theory."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b58bc59a-c623-3b8b-b7f0-b473f8b1ce2e",
                                        "entry_id": "cd194688-9c67-32c9-b62d-13e8e9a8c370",
                                        "glosses": [
                                            "Honestly, genuinely, in fact, really."
                                        ],
                                        "tags": [
                                            "modal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "27b21dcd-a0e7-4e0a-b486-12ef8e9041f7",
                                                "sense_id": "b58bc59a-c623-3b8b-b7f0-b473f8b1ce2e",
                                                "text": "That is truly all I know."
                                            },
                                            {
                                                "example_id": "0a3366fe-aec5-4d4c-a483-2e1e3882bcc0",
                                                "sense_id": "b58bc59a-c623-3b8b-b7f0-b473f8b1ce2e",
                                                "text": "Truly, that is all I know."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3b49814c-7d96-3d6b-ad4c-eeccf7fdb94a",
                                        "entry_id": "cd194688-9c67-32c9-b62d-13e8e9a8c370",
                                        "glosses": [
                                            "Very."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6ca53d8b-438e-4811-8f30-6313344a18ba",
                                                "sense_id": "3b49814c-7d96-3d6b-ad4c-eeccf7fdb94a",
                                                "text": "You are truly silly."
                                            },
                                            {
                                                "example_id": "7ad9062e-7f14-4f5b-8635-642cde38cd75",
                                                "sense_id": "3b49814c-7d96-3d6b-ad4c-eeccf7fdb94a",
                                                "text": "I’m distantly related to the truly great writer, Chaim Potok, which for a magazine editor seems like a good thing."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bab7be00-5385-4bc7-9e62-8f3b9ffd3f40",
                        "source_entry_id": "51d60a51-2e7a-3663-bd7a-adfa77373e20",
                        "source_sense_id": "21ae5ebd-4457-36fd-ba7b-0821536c7ce3",
                        "target_lang_word": "réellement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "réellement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5a0c5ece-587c-3011-b76a-4ee9f21da56a",
                                        "entry_id": "e09306cf-3e57-326b-8472-3faef433a719",
                                        "glosses": [
                                            "Effectivement, véritablement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d8f7672b-6225-4240-a9b1-ce3fe3aa1d06",
                                                "sense_id": "5a0c5ece-587c-3011-b76a-4ee9f21da56a",
                                                "text": "M. Armand de Gavinard était bien réellement un chasseur d’Afrique, ainsi que l’avait péremptoirement démontré Joseph."
                                            },
                                            {
                                                "example_id": "e6526c87-9c98-4347-8eae-0b4e6f9a952c",
                                                "sense_id": "5a0c5ece-587c-3011-b76a-4ee9f21da56a",
                                                "text": "Voilà donc toujours sans difficulté une Église très-réellement existante, très-réellement visible, où l’on prêche très-réellement la saine doctrine, et où très-réellement on administre comme il faut les sacrements : car, ajoute-t-on, le royaume e Jésus-Christ ne peut subsister qu’avec la parole et les sacrements: en sorte qu’où ils ne sont pas, il n’y a point d’Église."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7cadfd69-855c-3c3d-a788-15be0e645c97",
                                        "entry_id": "e09306cf-3e57-326b-8472-3faef433a719",
                                        "glosses": [
                                            "S’emploie pour donner plus de force à l’expression."
                                        ],
                                        "tags": [
                                            "Quelquefois"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c7362a44-94a7-4fe9-abf4-fffcb3efd438",
                                                "sense_id": "7cadfd69-855c-3c3d-a788-15be0e645c97",
                                                "text": "Ce conte est réellement plaisant."
                                            },
                                            {
                                                "example_id": "02781611-9ea4-4627-b09e-0ed2fa4e7bdf",
                                                "sense_id": "7cadfd69-855c-3c3d-a788-15be0e645c97",
                                                "text": "Réellement je ne reviens pas de l’attendriſſement qu’elle m’a cauſé…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "456a2266-ff01-3dd0-a544-6bf7d1201df1",
                                        "entry_id": "e09306cf-3e57-326b-8472-3faef433a719",
                                        "glosses": [
                                            "Par autorité de justice."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "216d1d9f-2c1e-4670-b440-0066598b75ef",
                                                "sense_id": "456a2266-ff01-3dd0-a544-6bf7d1201df1",
                                                "text": "Saisir réellement un immeuble pour le faire vendre."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "08ba14d3-0220-4f38-b4c1-1ad01e1ae839",
                        "source_entry_id": "51d60a51-2e7a-3663-bd7a-adfa77373e20",
                        "source_sense_id": "21ae5ebd-4457-36fd-ba7b-0821536c7ce3",
                        "target_lang_word": "véritablement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "véritablement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8f3c13de-672b-3ade-9261-5737c2a4b555",
                                        "entry_id": "a68045ed-83ab-3fa0-ac4a-b987907ae385",
                                        "glosses": [
                                            "Conformément à la vérité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "846bb7d3-a031-4259-abdf-860e65d351a0",
                                                "sense_id": "8f3c13de-672b-3ade-9261-5737c2a4b555",
                                                "text": "Parlez-moi véritablement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e83c0a21-5513-3b36-912e-7a00bd7e6eaa",
                                        "entry_id": "a68045ed-83ab-3fa0-ac4a-b987907ae385",
                                        "glosses": [
                                            "Réellement, de fait."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0893e8c-eb02-4718-9a73-78af18f6afc4",
                                                "sense_id": "e83c0a21-5513-3b36-912e-7a00bd7e6eaa",
                                                "text": "Ce fut Babar, petit-fils de Tamerlan, qui forma véritablement l’empire mogol,"
                                            },
                                            {
                                                "example_id": "593f953b-5c35-434c-8cb2-7faec8df3002",
                                                "sense_id": "e83c0a21-5513-3b36-912e-7a00bd7e6eaa",
                                                "text": "Ils [les rois] sont, comme nous sommes, Véritablement hommes, Et meurent comme nous,"
                                            },
                                            {
                                                "example_id": "6718326e-058e-4930-ba25-0d802eca6aa5",
                                                "sense_id": "e83c0a21-5513-3b36-912e-7a00bd7e6eaa",
                                                "text": "Le joueur sauve véritablement son équipe."
                                            },
                                            {
                                                "example_id": "d6bc13ee-d862-4727-9237-ddfb62f0c050",
                                                "sense_id": "e83c0a21-5513-3b36-912e-7a00bd7e6eaa",
                                                "text": "Le Vicaire savoyard, le seul véritablement bon ouvrage qu’ait fait. J. J. Rousseau, — (Voltaire, Philos. Instructions)"
                                            },
                                            {
                                                "example_id": "639f401d-15b2-47b8-b9d7-c9e77f0ead8f",
                                                "sense_id": "e83c0a21-5513-3b36-912e-7a00bd7e6eaa",
                                                "text": "Mais de fut le comte de Chardonnet, […], qui fut véritablement le père de ce nouveau produit industriel."
                                            },
                                            {
                                                "example_id": "fb6b2f50-8779-4a8d-a520-27022a96898a",
                                                "sense_id": "e83c0a21-5513-3b36-912e-7a00bd7e6eaa",
                                                "text": "Elle parlait pour ne pas faire l'impolie, sans que la chose l'intéressât véritablement."
                                            },
                                            {
                                                "example_id": "81039448-6eba-4a8b-8250-ce1ff904c689",
                                                "sense_id": "e83c0a21-5513-3b36-912e-7a00bd7e6eaa",
                                                "text": "— Dites-leur que nous regrettons très véritablement ce retard, souffla Koromindé du fond de la pièce.\nOn devinait à ce « très véritablement » que le français n’était pas sa langue maternelle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2dc3d5de-e6bf-3897-9845-b9e89eeaddc5",
                                        "entry_id": "a68045ed-83ab-3fa0-ac4a-b987907ae385",
                                        "glosses": [
                                            "À la vérité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3451c2fa-8e07-4be2-a82c-207366f0e65d",
                                                "sense_id": "2dc3d5de-e6bf-3897-9845-b9e89eeaddc5",
                                                "text": "Si nous promettons ces avantages, ce n'est point à quelques réflexions qui s'offrent à l’esprit véritablement, mais qui ne font aucune impression sur le cœur et qui n'ont aucune influence sur la vie,"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e2b0a919-f12a-478d-b435-524d4f8931bc",
                        "source_entry_id": "51d60a51-2e7a-3663-bd7a-adfa77373e20",
                        "source_sense_id": "21ae5ebd-4457-36fd-ba7b-0821536c7ce3",
                        "target_lang_word": "vraiment",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vraiment",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6442dcf1-d3b7-3f57-aa31-c9fa253bbc9e",
                                        "entry_id": "b7895173-bf7e-3de5-8b26-2988f8d62f7a",
                                        "glosses": [
                                            "Effectivement ; véritablement , d’une manière vraie ; réellement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a83b96c7-0732-4ab8-ad86-2186d9dbfbf2",
                                                "sense_id": "6442dcf1-d3b7-3f57-aa31-c9fa253bbc9e",
                                                "text": "Les gens se lâchaient en sa présence, parce qu'il avait toujours l'air beaucoup plus stone qu'il ne l'était vraiment."
                                            },
                                            {
                                                "example_id": "4c3780ff-81fd-4430-85c9-395df9996aa1",
                                                "sense_id": "6442dcf1-d3b7-3f57-aa31-c9fa253bbc9e",
                                                "text": "— Calvâsse! vraiment? Je croyais que les correspondants parlementaires étaient détendus comme des coqs en pâte."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "915914d8-ac64-37e0-a91f-b942cdd28bdf",
                                        "entry_id": "b7895173-bf7e-3de5-8b26-2988f8d62f7a",
                                        "glosses": [
                                            "Tout à fait, absolument."
                                        ],
                                        "tags": [],
                                        "note": "Il se prend dans ce sens, dans une expression, pour affirmer plus fortement :",
                                        "examples": [
                                            {
                                                "example_id": "90164be1-7f4f-4de4-a3ae-12c14e6ee783",
                                                "sense_id": "915914d8-ac64-37e0-a91f-b942cdd28bdf",
                                                "text": "Ce conte est vraiment plaisant."
                                            },
                                            {
                                                "example_id": "86e67c10-123f-4e5e-b2a4-2cad8067fa6b",
                                                "sense_id": "915914d8-ac64-37e0-a91f-b942cdd28bdf",
                                                "text": "— Vraiment je vous en croirai. — Vraiment vous êtes un joli monsieur."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "vraiment",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "df591960-f663-37dc-9a03-71eb9fcd5c70",
                                        "entry_id": "0c1e9623-d69c-3157-85aa-36ab76bd9d7f",
                                        "glosses": [
                                            "Marque la surprise, la déception ou l’accord avec l’interlocuteur (surtout dans les dialectes du français d’Afrique)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b55a9396-ea67-41a5-9a15-2a2200a9d9c2",
                                                "sense_id": "df591960-f663-37dc-9a03-71eb9fcd5c70",
                                                "text": "Eeeh vraiment ! Faut pas me faire ça Safi deh ! Toi aussi !"
                                            },
                                            {
                                                "example_id": "a65c2ea8-0b35-45b4-a941-79ea5525b925",
                                                "sense_id": "df591960-f663-37dc-9a03-71eb9fcd5c70",
                                                "text": "On ne s’en sortira jamais tant que notre pays sera dirigé par des voleurs et des anciens rebelles. — Vraiment !"
                                            },
                                            {
                                                "example_id": "53e4e6f4-e707-4c84-9f47-c2313e3e411a",
                                                "sense_id": "df591960-f663-37dc-9a03-71eb9fcd5c70",
                                                "text": "Le gouvernement a décrété une nouvelle hausse des impôts. — Vraiment ! Mais pour quoi faire ça encore ! Comme si on n’avait pas déjà assez souffert ! Tchrouuu…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c348747f-91f8-4f99-996c-4c473ad35f77",
                        "source_entry_id": "51d60a51-2e7a-3663-bd7a-adfa77373e20",
                        "source_sense_id": "21ae5ebd-4457-36fd-ba7b-0821536c7ce3",
                        "target_lang_word": "echt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "echt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "10b5829d-f815-34f1-b1a4-ea25e606d46c",
                                        "entry_id": "104ba265-6abb-3fba-a80a-2318f55bc33b",
                                        "glosses": [
                                            "unverfälscht"
                                        ],
                                        "tags": [
                                            "ohne Steigerung"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "711b102f-6ac3-4531-a685-b16ca27267df",
                                                "sense_id": "10b5829d-f815-34f1-b1a4-ea25e606d46c",
                                                "text": "Die Briefmarke ist echt und keine Fälschung."
                                            },
                                            {
                                                "example_id": "3ffa9923-1592-4b80-8e6e-59af36621862",
                                                "sense_id": "10b5829d-f815-34f1-b1a4-ea25e606d46c",
                                                "text": "Es handelt sich hier um die echten Dokumente."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5632347f-c199-3ba0-8691-6e89ff8e0ce1",
                                        "entry_id": "104ba265-6abb-3fba-a80a-2318f55bc33b",
                                        "glosses": [
                                            "aufrichtig, wahr"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "816628d1-c1db-41ae-b75c-99674f167fbd",
                                                "sense_id": "5632347f-c199-3ba0-8691-6e89ff8e0ce1",
                                                "text": "Er ist ein echter Freund."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "c24ccb10-e338-3b25-8d3b-10961ed11f54",
                                        "entry_id": "104ba265-6abb-3fba-a80a-2318f55bc33b",
                                        "glosses": [
                                            "typisch"
                                        ],
                                        "tags": [
                                            "ohne Steigerung"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9ba8e2bd-6606-4e0f-b7aa-2c910ac36e29",
                                                "sense_id": "c24ccb10-e338-3b25-8d3b-10961ed11f54",
                                                "text": "Das sind echte Frauen."
                                            },
                                            {
                                                "example_id": "1b4134c1-8284-492c-b5ba-6c9dc80fbfac",
                                                "sense_id": "c24ccb10-e338-3b25-8d3b-10961ed11f54",
                                                "text": "Das sind echte Rheinländer."
