                        "entry_id": "e88cc8d5-6df4-34c8-9cd3-210e505cfcf0",
                        "glosses": [
                            "An enzyme that catalyzes the hydrolysis of choline-based esters (acetylcholine or butyrylcholine)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "88351a11-174b-4218-9a8e-1579fa11a863",
                                "sense_id": "4e297b6f-3e1d-38af-b01e-3f0dd0700830",
                                "text": "The little tablets she has to take inhibit cholinesterase, an enzyme that breaks down the neurotransmitter acetylcholine."
                            }
                        ]
                    }
                ],
