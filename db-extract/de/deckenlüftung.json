                "senses": [
                    {
                        "sense_id": "4fd48abd-28fc-3d98-bd2f-31ba296e79ca",
                        "entry_id": "5e5895c7-2e05-3d40-865d-28ca6bc04784",
                        "glosses": [
                            "lüftungstechnische Zu-, Ab- und Umluftführung durch Einbauelement unter/in der Decke"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5c643c16-c5d8-4b95-a902-0d052e24d1ed",
                                "sense_id": "4fd48abd-28fc-3d98-bd2f-31ba296e79ca",
                                "text": "„Die in die Küchen-Architektur integrierbare Deckenlüftung überzeugt neben ihrem minimalistischen Design durch ihre Modularität, die eine flexible Konfiguration der einzelnen Lüftungselemente ermöglicht.“"
                            },
                            {
                                "example_id": "fe1c6cdb-56bd-4476-8883-13b9df1e2e88",
                                "sense_id": "4fd48abd-28fc-3d98-bd2f-31ba296e79ca",
                                "text": "„Mit der modularen Deckenlüftung «AC 402» für die private Küche bietet Gaggenau ein Produkt mit minimalistischem Design und hoher Konfigurierbarkeit: Sowohl Abmessungen als auch Leistungsfähigkeit können perfekt auf die jeweilige Küchensituation und die individuellen Bedürfnisse abgestimmt werden.“"
                            },
                            {
                                "example_id": "9127570d-c427-4d0b-b25c-6aae822ff1d2",
                                "sense_id": "4fd48abd-28fc-3d98-bd2f-31ba296e79ca",
                                "text": "„Weitere Neuheiten sind die Vario Kochgeräte-Serie 200 und die Deckenlüftung AC 402, die ebenso wie der Vario Side-by-Side RS 295 in den imm hit guide 2011 aufgenommen wurden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
