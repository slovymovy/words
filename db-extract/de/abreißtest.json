                ],
                "senses": [
                    {
                        "sense_id": "f02681b5-9145-3816-8dae-177d35c0db96",
                        "entry_id": "cf9663f1-16c0-3450-8e57-f5465aa3844c",
                        "glosses": [
                            "Verfahren, bei dem die Haftung, Klebkraft, Haltefestigkeit geprüft wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f91a28f-4759-4f7f-a2cc-e838d3ffe024",
                                "sense_id": "f02681b5-9145-3816-8dae-177d35c0db96",
                                "text": "„Die Haftfestigkeit von dünnen Schichten und Oberflächenüberzügen kann durch den Abreißtest nach DIN 53323 [3.104] und den Kugelaufpralltest [3.105] bestimmt werden.“"
                            },
                            {
                                "example_id": "490ac6d5-f5a3-4686-ae3c-916a702629f0",
                                "sense_id": "f02681b5-9145-3816-8dae-177d35c0db96",
                                "text": "„Allerdings wird bei diesem Abreißtest nur die mechanische Festigkeit der Bondverbindung, die für die Zuverlässigkeit der Kontakte von großer Bedeutung ist, ermittelt […].“"
                            },
                            {
                                "example_id": "b46aa014-4109-47e7-adb7-730e533e5227",
                                "sense_id": "f02681b5-9145-3816-8dae-177d35c0db96",
                                "text": "„Beim Abreißtest wird der aufgeriebene Klebebandstreifen ruckartig wieder abgezogen.“"
                            },
                            {
                                "example_id": "fb513a62-4b52-4ecf-9022-abd11b8e7fe7",
                                "sense_id": "f02681b5-9145-3816-8dae-177d35c0db96",
                                "text": "Für eine weitere Untergrundprüfung mit einem Abreißtest mischst du ca. 3-4 kg Fassaden- und Sanierungsspachtel mit sauberem Wasser entsprechend den Angaben auf der Gebinderückseite bzw. dem Technischen Merkblatt knötchenfrei an.„“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
