        "fr-extract.jsonl": [
            {
                "entry_id": "57960b74-c01a-3ad1-80a6-13fdaf9efc04",
                "word": "Volga",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "e2d7c4de-9375-3f88-a409-47d9b7724e5d",
                        "entry_id": "57960b74-c01a-3ad1-80a6-13fdaf9efc04",
                        "glosses": [
                            "Plus grand fleuve d’Europe, qui coule en Russie et se jette dans la mer Caspienne."
                        ],
                        "tags": [
                            "Cours d’eau"
                        ],
                        "examples": [
                            {
                                "example_id": "1711c082-a831-4bd7-8cf3-36d0446068bc",
                                "sense_id": "e2d7c4de-9375-3f88-a409-47d9b7724e5d",
                                "text": "Au sein de la Fédération de Russie, deux populations de langues mongoles forment des républiques : en Bouriatie, au sud-est du lac Baïkal, elles parlent bouriate (360 000 locuteurs) ; en Kalmoukie, au sud-ouest de la basse Volga, elles parlent kalmouk (150 000 locuteurs)."
                            },
                            {
                                "example_id": "a5511478-f2a0-45b6-ade9-bb219720aa2b",
                                "sense_id": "e2d7c4de-9375-3f88-a409-47d9b7724e5d",
                                "text": "Cette fois j’ai dû les oublier dans la steppe du côté de Kazan, au bord de la Volga où j’écoutais de vieilles berceuses tchouvaches."
                            },
                            {
                                "example_id": "754c3f31-a2c7-43e0-b1c4-cee8993b08f2",
                                "sense_id": "e2d7c4de-9375-3f88-a409-47d9b7724e5d",
                                "text": "Le lieu de travail qui lui avait été assigné était à l’époque le plus gros chantier jamais projeté par l’homme : l’immense canal qui devait relier la Moskova à la Volga, pour alimenter la ville en eau et relier par voie fluviale Moscou au Grand Canal blanc."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e2db6383-6c19-4770-ad7d-24082f0c930a",
                        "source_entry_id": "57960b74-c01a-3ad1-80a6-13fdaf9efc04",
                        "source_sense_id": "e2d7c4de-9375-3f88-a409-47d9b7724e5d",
                        "target_lang_word": "Wolga",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wolga",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "eab4dcdb-bab9-355d-82a7-6e368eb4d63c",
                                        "entry_id": "8ecc8ca1-d27b-3629-aad3-59b501553862",
                                        "glosses": [
                                            "Automobil; russische, vormals sowjetische Automarke"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03ebc8de-0bae-4c11-8b62-af9ffd1a6c1c",
                                                "sense_id": "eab4dcdb-bab9-355d-82a7-6e368eb4d63c",
                                                "text": "Ich hatte den Wolga 1978 gekauft."
                                            },
                                            {
                                                "example_id": "9d2ffded-a11f-4f92-afad-2404042384d4",
                                                "sense_id": "eab4dcdb-bab9-355d-82a7-6e368eb4d63c",
                                                "text": "Stoppe diesen Wolga!"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Wolga",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4b710bbe-0040-3727-a27e-e8950378494a",
                                        "entry_id": "1a4db52c-1b82-3351-b9e8-189e837eb56c",
                                        "glosses": [
                                            "ein Fluss im europäischen Teil Russlands"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71295f5c-3c4f-460d-8db5-c52c4ddb89cc",
                                                "sense_id": "4b710bbe-0040-3727-a27e-e8950378494a",
                                                "text": "Die Wolga hat etwa 200 Nebenflüsse, ihr Einzugsgebiet von 1,36 Millionen km² Fläche umfasst insgesamt 151.000 Flüsse, Bäche und zeitweilige Wasserläufe."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "dcc276a1-150a-3afb-a086-5490c584c3f1",
                                        "entry_id": "1a4db52c-1b82-3351-b9e8-189e837eb56c",
                                        "glosses": [
                                            "ein Föderationskreis in Russland"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5fe2874e-60b6-438b-b382-999998ba0287",
                                                "sense_id": "dcc276a1-150a-3afb-a086-5490c584c3f1",
                                                "text": "Verwaltungssitz des Föderationskreises Wolga ist Nischni Nowgorod."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Wolga",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7959484d-4869-3377-8206-addcf1cf7d78",
                                        "entry_id": "2ac20afc-8e24-3336-ace0-b7562780d47c",
                                        "glosses": [
                                            "eine Siedlung im Rajon Nekous der Oblast Jaroslawl in Russland"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "510eb8ab-f472-485c-85bc-7ae8f9898699",
                                                "sense_id": "7959484d-4869-3377-8206-addcf1cf7d78",
                                                "text": "Wolga entstand gegen Ende des 19. Jahrhunderts im Zusammenhang mit der Errichtung einer Wollspinnerei durch deutsche Unternehmer an der Eisenbahnstrecke Rybinsk – Bologoje."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
