        "fr-extract.jsonl": [
            {
                "entry_id": "76286455-e2f5-316d-86eb-1eb95ba51258",
                "word": "polar",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "6b025f28-0938-45d5-b732-ae61e7e9ba88",
                        "entry_id": "76286455-e2f5-316d-86eb-1eb95ba51258",
                        "tags": [
                            "plural"
                        ],
                        "form": "polars"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ad628bc8-5e49-3ae8-88a3-a2cee71b17f6",
                        "entry_id": "76286455-e2f5-316d-86eb-1eb95ba51258",
                        "glosses": [
                            "Œuvre de fiction à thème policier, et en particulier roman policier."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "a6c08fda-362f-4c23-9fa1-d52b8dd41b7e",
                                "sense_id": "ad628bc8-5e49-3ae8-88a3-a2cee71b17f6",
                                "text": "Elle avait pris l'habitude de m'inviter aux avant-premières de films d'action, de polar ou d'autres trucs qui pouvaient me plaire. Elle savait que les films intello où les acteurs se pignolent pendant deux heures sans que le spectateur comprenne rien, c'était pas mon truc."
                            },
                            {
                                "example_id": "e995424b-e22b-49f0-a5be-260d210c2763",
                                "sense_id": "ad628bc8-5e49-3ae8-88a3-a2cee71b17f6",
                                "text": "Digne d’un polar, cette affaire tragique a provoqué une onde de choc à l’échelle internationale."
                            },
                            {
                                "example_id": "4acf0ee9-fca1-4ad6-a69b-4696b124ea82",
                                "sense_id": "ad628bc8-5e49-3ae8-88a3-a2cee71b17f6",
                                "text": "Un vrai polar mystico-dingo, diront certains, mais un polar aussi."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3058f98e-446a-445e-a73b-e638268457a2",
                        "source_entry_id": "76286455-e2f5-316d-86eb-1eb95ba51258",
                        "source_sense_id": "ad628bc8-5e49-3ae8-88a3-a2cee71b17f6",
                        "target_lang_word": "Krimi",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Krimi",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "51d6c5f5-f04c-3f2e-81ea-02457731defa",
                                        "entry_id": "4665de5f-e1dd-33a3-8fe4-9ad3fc711664",
                                        "glosses": [
                                            "Geschichte eines schweren Verbrechens"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "90065bbd-7961-4811-bf8a-c99ed3c55d66",
                                                "sense_id": "51d6c5f5-f04c-3f2e-81ea-02457731defa",
                                                "text": "Wir waren heute im Kino und haben uns einen spannenden Krimi angesehen."
                                            },
                                            {
                                                "example_id": "b9df29c4-b3e2-4b4e-bfde-6f37e55cd06b",
                                                "sense_id": "51d6c5f5-f04c-3f2e-81ea-02457731defa",
                                                "text": "„Ohne Krimi geht die Mimi nie ins Bett“."
                                            },
                                            {
                                                "example_id": "b11ed8e0-279d-4ca2-8831-279b432ad754",
                                                "sense_id": "51d6c5f5-f04c-3f2e-81ea-02457731defa",
                                                "text": "„Vielleicht sehen Sie blonde Haare, Frauen mit kräftigen Beinen und einem Krimi unter dem Arm.“"
                                            },
                                            {
                                                "example_id": "8f4442a3-b9b4-4fb9-a388-9d8b46fe8603",
                                                "sense_id": "51d6c5f5-f04c-3f2e-81ea-02457731defa",
                                                "text": "„Die durchschnittliche staatlich finanzierte TV-Serie, ob Soap, Heimatfilm, Arztserie oder Krimi, strahlt ein hohes Maß an Vertrauen in den Staat aus, stellt die Gesellschaft als grundsätzlich heil dar und fordert uns nicht zum Nachdenken auf: Alles ist gut, wie es ist.“"
                                            },
                                            {
                                                "example_id": "cf7ce795-9cf8-46cf-a540-22e04f196d15",
                                                "sense_id": "51d6c5f5-f04c-3f2e-81ea-02457731defa",
                                                "text": "„Ben hatte unzählige Krimis gesammelt und bunte Paperbacks mit Covern, die nach Fantasy und Science-Fiction aussahen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d4c241ac-d650-3a51-b296-245e2f58bd36",
                                        "entry_id": "4665de5f-e1dd-33a3-8fe4-9ad3fc711664",
                                        "glosses": [
                                            "spannendes, umkämpftes Spiel"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6e59e142-3241-4bf2-83a6-82b2205f3d84",
                                                "sense_id": "d4c241ac-d650-3a51-b296-245e2f58bd36",
                                                "text": "Das Fußballspiel zwischen dem Tabellenführenden und dem Drittplatzierten war ein echter Krimi."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0579f823-9f04-4d5c-bc5a-06982350a639",
                        "source_entry_id": "76286455-e2f5-316d-86eb-1eb95ba51258",
                        "source_sense_id": "ad628bc8-5e49-3ae8-88a3-a2cee71b17f6",
                        "target_lang_word": "thriller",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "thriller",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0665b9ed-ddcd-376e-bc04-d5d9f28cc0d3",
                                        "entry_id": "70904c26-d11e-32e8-be58-dbcd3eb2eb11",
                                        "glosses": [
                                            "Something that thrills."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "56ad4dda-8aa4-40e6-8ad4-d4ad8eeb8630",
                                                "sense_id": "0665b9ed-ddcd-376e-bc04-d5d9f28cc0d3",
                                                "text": "While Arsenal had enjoyed a Boxing Day break thanks to the cancellation of their game against West Ham, Newcastle had come out of the wrong end of a thriller at Old Trafford and Pardew said that strain accounted for his side conceding four goals at the Emirates after Demba Ba had drawn Newcastle level for the third time in the 69th minute."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6a3485c3-ce79-3b93-9638-9dca8ec0d812",
                                        "entry_id": "70904c26-d11e-32e8-be58-dbcd3eb2eb11",
                                        "glosses": [
                                            "A suspenseful, sensational genre of story, book, play, film."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d4845b66-7893-40ee-b120-fcde0cd7dec7",
                                                "sense_id": "6a3485c3-ce79-3b93-9638-9dca8ec0d812",
                                                "text": "She loves to read thriller books."
                                            }
                                        ]
                                    },
