                        "form_id": "f0c1626f-643e-4ca4-820a-4d584c854565",
                        "entry_id": "ba9c58a0-b186-37d8-ab21-94f49363b25c",
                        "tags": [
                            "singular",
                            "feminine"
                        ],
                        "form": "pluripotente"
                    },
                    {
                        "form_id": "ef4d926f-647d-4f2a-911b-3dadf65c57d7",
                        "entry_id": "ba9c58a0-b186-37d8-ab21-94f49363b25c",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "pluripotentes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "28d508ac-cc3c-3a70-979a-90c2ea1bdf4a",
                        "entry_id": "ba9c58a0-b186-37d8-ab21-94f49363b25c",
                        "glosses": [
                            "Se dit d’une cellule qui a la faculté de se différencier en tous les types cellulaires d’un organisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a86da30d-ba05-483f-85d8-e712dabd8357",
                                "sense_id": "28d508ac-cc3c-3a70-979a-90c2ea1bdf4a",
                                "text": "Il est donc tel moment où l’ectoderme pluripotent va se développer en épithèle de revêtement et en épithèle glandulaire."
                            },
                            {
                                "example_id": "4642fcc7-6968-40c4-ab76-7838913de382",
                                "sense_id": "28d508ac-cc3c-3a70-979a-90c2ea1bdf4a",
                                "text": "Les cellules nerveuses issues in vitro après différenciation des cellules pluripotentes pourraient être greffées dans le cerveau du patient."
                            },
                            {
                                "example_id": "f32b7af5-628a-4b66-9cbd-e8e69057e80d",
                                "sense_id": "28d508ac-cc3c-3a70-979a-90c2ea1bdf4a",
                                "text": "Une étude effectuée sur les cheveux a montré que les kératinocytes pluripotents se trouvaient dans la partie moyenne de la région des gaines épithéliales."
                            },
                            {
                                "example_id": "4555bee8-d948-4de2-b124-a8c18c12c4c2",
                                "sense_id": "28d508ac-cc3c-3a70-979a-90c2ea1bdf4a",
                                "text": "Dans la présente étude, l'équipe a marqué des cellules souches pluripotentes humaines (cellules capables de se développer en tous les types de cellules du corps) avec une protéine fluorescente."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dd15827f-4f30-4e5a-ad35-5a17d17d9f4b",
                        "source_entry_id": "ba9c58a0-b186-37d8-ab21-94f49363b25c",
                        "source_sense_id": "28d508ac-cc3c-3a70-979a-90c2ea1bdf4a",
                        "target_lang_word": "pluripotent",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pluripotent",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "620ecf4f-f93b-32a2-80a8-be4ec4137333",
                                        "entry_id": "c450aac1-e2c7-341e-93cf-ee4490648feb",
                                        "glosses": [
                                            "viele Entwicklungsmöglichkeiten in sich tragend"
                                        ],
                                        "tags": [
                                            "von Zellen und Gewebe"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "30f51453-a8f7-4a1a-acde-350d9fa4f285",
                                                "sense_id": "620ecf4f-f93b-32a2-80a8-be4ec4137333",
                                                "text": "Pluripotente Stammzellen haben sich noch nicht spezialisiert, sich also noch nicht in Körperzellen mit einer konkreten Aufgabe wie beispielsweise Haut-, Nerven- oder Darmzellen umgewandelt."
                                            },
                                            {
                                                "example_id": "9085f4ab-d648-48dc-9581-adc49f0bd76a",
                                                "sense_id": "620ecf4f-f93b-32a2-80a8-be4ec4137333",
                                                "text": "Bei der Herstellung dieser sogenannten pluripotenten Stammzellen aus normalen Körperzellen kommt es offenbar zu genetischen Veränderungen, die sogar ein Krebsrisiko beinhalten können, sagen die Wissenschaftler."
                                            },
                                            {
                                                "example_id": "b5003500-85e5-456e-8c58-a330ca11d2e8",
                                                "sense_id": "620ecf4f-f93b-32a2-80a8-be4ec4137333",
                                                "text": "Zum anderen sogenannte induzierte pluripotente Stammzellen (iPS-Zellen), die - ethisch unbedenklicher - aus bereits ausgereiften Körperzellen gewonnen werden und sich immerhin noch in zahlreiche verschiedene Arten von Zellen ausdifferenzieren können."
                                            },
                                            {
                                                "example_id": "575164fc-217a-4851-8252-242778e19963",
                                                "sense_id": "620ecf4f-f93b-32a2-80a8-be4ec4137333",
                                                "text": "Oct4, Sox2, Klf4 und cMyc – auf den ersten Blick ein paar nichtssagende Abkürzungen, für den Stammzellenforscher jedoch eine magische Zauberformel, um somatische, differenzierte Zellen zu pluripotenten Stammzellen rück zu programmieren."
                                            },
                                            {
                                                "example_id": "1b5c0ce5-7645-4731-b52b-a7529a2d83cc",
                                                "sense_id": "620ecf4f-f93b-32a2-80a8-be4ec4137333",
                                                "text": "In Österreich ist die Forschung an importierten pluripotenten embryonalen Stammzellen nach geltendem Recht ohne Einschränkungen erlaubt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c505c35c-6e55-45c5-a5ad-132bda8bac21",
                        "source_entry_id": "ba9c58a0-b186-37d8-ab21-94f49363b25c",
                        "source_sense_id": "28d508ac-cc3c-3a70-979a-90c2ea1bdf4a",
