                        "sense_id": "4062ad61-ebc4-362b-ad5c-c37168163799",
                        "entry_id": "07e7b256-917f-3182-9475-4d373ca8b750",
                        "glosses": [
                            "to become blunt or more blunt, to become dull or more dull"
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "5824dd88-718c-4ba8-ac1e-8fb65879c449",
                                "sense_id": "4062ad61-ebc4-362b-ad5c-c37168163799",
                                "text": "Бри́тва тупе́ет.",
                                "translation": "The razor is becoming blunt.",
                                "english": "The razor is becoming blunt."
                            },
                            {
                                "example_id": "a5670a0e-b0da-4796-bdbf-076db71e8ff4",
                                "sense_id": "4062ad61-ebc4-362b-ad5c-c37168163799",
                                "text": "Боль тупе́ет.",
                                "translation": "The pain is becoming dull.",
                                "english": "The pain is becoming dull."
                            }
                        ]
                    },
                    {
                        "sense_id": "476d123b-db62-3eb7-93fb-58b567b8d4e0",
                        "entry_id": "07e7b256-917f-3182-9475-4d373ca8b750",
                        "glosses": [
                            "to become dumb or dumber"
                        ],
                        "tags": [
                            "figuratively",
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "25bbf92c-8ba5-4a03-bc57-e675dd715957",
                                "sense_id": "476d123b-db62-3eb7-93fb-58b567b8d4e0",
                                "text": "Наш ребёнок тупе́ет с ка́ждым днём.",
                                "translation": "Our child is getting dumber with every day.",
                                "english": "Our child is getting dumber with every day."
                            }
                        ]
