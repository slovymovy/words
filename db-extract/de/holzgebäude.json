                            {
                                "example_id": "ef4197e4-5b66-4192-832e-3633d2644754",
                                "sense_id": "8b9774d2-e3b8-3606-82aa-c92f61b645c7",
                                "text": "„Den größten Teil des Geländes hatte inzwischen Google gepachtet und restaurierte derzeit Hangar 1, eines der größten Holzgebäude der Welt, das in den 1930er-Jahren errichtet worden war, um Luftschiffe zu beherbergen.“"
                            },
                            {
                                "example_id": "1f7d35bd-ccf7-4809-9115-e4ec13b1377d",
                                "sense_id": "8b9774d2-e3b8-3606-82aa-c92f61b645c7",
                                "text": "„Das Blue Pines war ein Holzgebäude mit einem Blechdach.“"
                            }
                        ],
