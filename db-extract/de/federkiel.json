                "senses": [
                    {
                        "sense_id": "69e9bd7e-31e9-385e-bbc0-e97d49929190",
                        "entry_id": "7ac888ad-3458-36a2-91a3-27ce8f8df2e7",
                        "glosses": [
                            "dicker und fester Teil einer Vogelfeder"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "3d58377d-7b8a-3539-95d7-dc9bc089ccd8",
                        "entry_id": "7ac888ad-3458-36a2-91a3-27ce8f8df2e7",
                        "glosses": [
                            "aus [1] gefertigtes Schreibgerät"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a83426ca-b992-42b3-95e9-14553082fd0b",
                                "sense_id": "3d58377d-7b8a-3539-95d7-dc9bc089ccd8",
                                "text": "„Dort setzte ich ihn an seinen Tisch, drückte ihm einen Federkiel in die Hand und befahl ihm, alles aufzuschreiben, was er wußte.“"
                            },
                            {
                                "example_id": "d57b3fe6-72c6-47be-a128-fe272720abb2",
                                "sense_id": "3d58377d-7b8a-3539-95d7-dc9bc089ccd8",
                                "text": "„Mrs. Maisbrei, die Leiterin des Betriebes, saß an ihrem Tresen hinter einem Messinggitter, hielt einen Federkiel in der Hand und prüfte die Rechnungen.“"
                            },
                            {
                                "example_id": "b15ce5c9-2a61-4d49-bcd8-87aa51e5f651",
                                "sense_id": "3d58377d-7b8a-3539-95d7-dc9bc089ccd8",
                                "text": "„Sie warb ihnen Patienten – und der Steuereinnehmer, der Schreiber der Bürgermeisterei, sogar der Bürgermeister persönlich, kurz, jedermann in Chavignolles lutschte an Federkielen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
