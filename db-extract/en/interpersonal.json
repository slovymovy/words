                                    {
                                        "sense_id": "3d6d33a6-c53e-319a-82fb-61862fe4fb7f",
                                        "entry_id": "aa6a98c3-65da-34f2-8011-327bf5afe302",
                                        "glosses": [
                                            "Qui a lieu entre plusieurs personnes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "42be0e70-6696-4998-ba13-e8528d8c2a18",
                                                "sense_id": "3d6d33a6-c53e-319a-82fb-61862fe4fb7f",
                                                "text": "La situation des relations interpersonnelles au sein des écoles est souvent déplorable et questionnante."
                                            },
                                            {
                                                "example_id": "e7f7159c-e181-4aed-ad14-8f8ead07b7c7",
                                                "sense_id": "3d6d33a6-c53e-319a-82fb-61862fe4fb7f",
                                                "text": "…d’une logique d'affrontement brutal à une pratique plus feutrée de ses conflits interpersonnels."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e3e385f1-9dad-367f-921f-81a366e392f5",
                                        "entry_id": "aa6a98c3-65da-34f2-8011-327bf5afe302",
                                        "glosses": [
                                            "Qui a lieu sans intermédiaire entre deux personnes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c6dd69c2-7da6-4e91-bc72-2bb3f289dd9e",
                                                "sense_id": "e3e385f1-9dad-367f-921f-81a366e392f5",
                                                "text": "Ayant grandi immergée dans la technologie des téléphones intélligents et les réseaux sociaux, la génération Z a eu moins d’occasions de développer ses compétences interpersonnelles."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fb75f538-b7c8-4ef7-93a3-46ded450b156",
                        "source_entry_id": "c936334e-a3da-38f4-9808-f1345341f5b6",
                        "source_sense_id": "d69637b9-2367-3fc0-b435-1a009315df0f",
                        "source_sense_description": "between persons",
                        "target_lang_word": "zwischenmenschlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
