                                "sense_id": "fcaa6310-a701-3299-852b-eb377fe9ff40",
                                "text": "Ten brydżysta rzadko się myli."
                            },
                            {
                                "example_id": "64ff6f8a-5256-46d5-8523-52be012b86ba",
                                "sense_id": "fcaa6310-a701-3299-852b-eb377fe9ff40",
                                "text": "Galery były bardzo ciężką karą i skazani rzadko mogli dożyć jej końca."
                            },
                            {
                                "example_id": "aeb7cda1-3546-4da7-a3ba-ddfcd14624ef",
                                "sense_id": "fcaa6310-a701-3299-852b-eb377fe9ff40",
                                "text": "Rzadko wypożyczam książki z biblioteki."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "9697ac64-fe30-3314-8794-f2675211dff1",
