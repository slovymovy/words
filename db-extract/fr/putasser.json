                "senses": [
                    {
                        "sense_id": "4b8e7ed0-51f4-38e0-b075-2462163ce795",
                        "entry_id": "d23f308c-1fcf-3a58-879a-c49039b2ec6f",
                        "glosses": [
                            "Se comporter de façon racoleuse."
                        ],
                        "tags": [
                            "vulgar"
                        ],
                        "examples": [
                            {
                                "example_id": "c877ec20-5c47-4692-a3a5-c16acd0825ad",
                                "sense_id": "4b8e7ed0-51f4-38e0-b075-2462163ce795",
                                "text": "Qu'il putasse bien ! Qu'il sait racoler les bons gens sur les bons thèmes au bon moment !"
                            },
                            {
                                "example_id": "fab35d5b-c69c-49d7-a6f7-02cd2f48140f",
                                "sense_id": "4b8e7ed0-51f4-38e0-b075-2462163ce795",
                                "text": "Les libéraux étaient très en faveur aussi jusqu'à tout récemment, précisément jusqu'à ce que Mario Dumont soit contre, sauf que M. Dumont n'est pas vraiment contre, il putasse comme pour le reste, il flatte le peuple dans le sens du poil."
                            },
                            {
                                "example_id": "1b8919b2-8f5c-4e2c-a27c-4fec8b2e119e",
                                "sense_id": "4b8e7ed0-51f4-38e0-b075-2462163ce795",
                                "text": "Je ne crois pas en \"Cracker Jack\", il putasse trop bien..."
                            }
                        ]
                    },
                    {
                        "sense_id": "e77996ed-ef77-3377-8e7e-8ba9525891ca",
                        "entry_id": "d23f308c-1fcf-3a58-879a-c49039b2ec6f",
                        "glosses": [
                            "Faire appel aux services des prostituées."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "62fc7b28-dbd6-4451-b502-2a7be9870e54",
                                "sense_id": "e77996ed-ef77-3377-8e7e-8ba9525891ca",
                                "text": "Il est allé putasser, déclara le garçon."
                            }
                        ]
                    }
