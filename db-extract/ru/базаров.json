                "senses": [
                    {
                        "sense_id": "cf1ddab4-bdbb-364e-86ea-c18db4457699",
                        "entry_id": "6da623f4-eece-3b2c-9bc8-bf369e6065d1",
                        "glosses": [
                            "Bazarov."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ac6f3440-9d30-4998-886d-f992db9f9d91",
                                "sense_id": "cf1ddab4-bdbb-364e-86ea-c18db4457699",
                                "text": "― Главное, надо теперь поужинать и отдохнуть.\n― Поесть действительно не худо, ― заметил, потягиваясь, Базаров и опустился на диван.",
                                "translation": "- L'essentiel est maintenant de dîner et de se reposer.\n- Ce n'est vraiment pas mal à manger », remarqua Bazarov en s'étirant et en se laissant tomber sur le canapé."
                            },
                            {
                                "example_id": "237965b0-d20c-4523-93bc-a18428032f4c",
                                "sense_id": "cf1ddab4-bdbb-364e-86ea-c18db4457699",
                                "text": "Вера Евгеньевна Базарова.",
                                "translation": "Vera Bazarova."
                            },
                            {
                                "example_id": "109ec300-6c3e-4310-88b1-fe454cc0d76b",
                                "sense_id": "cf1ddab4-bdbb-364e-86ea-c18db4457699",
                                "text": "Владимир Александрович Базаров.",
                                "translation": "Vladimir Bazarov."
                            }
                        ]
                    }
                ],
