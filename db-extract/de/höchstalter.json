                "senses": [
                    {
                        "sense_id": "d22df88d-e54d-386e-8fa0-020d03fe4d4b",
                        "entry_id": "c770ae25-12f4-3496-abb8-5c2b1d47d16d",
                        "glosses": [
                            "höchstes (mögliches) Alter"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f857094-5a01-483b-aa46-520e631cb605",
                                "sense_id": "d22df88d-e54d-386e-8fa0-020d03fe4d4b",
                                "text": "„Durch das bestehende Höchstalter für die Zulassung zum Unterrichtspraktikum von 45 Jahren treten immer wieder Härtefälle (vor allem durch Kindererziehungszeiten bedingt) auf, in denen Absolventinnen und Absolventen von Lehramtsstudien den Lehrberuf nicht ausüben können.“"
                            },
                            {
                                "example_id": "f8f126a4-3712-40fa-be04-8f4683239fb4",
                                "sense_id": "d22df88d-e54d-386e-8fa0-020d03fe4d4b",
                                "text": "„Das Höchstalter für die Eingangsprüfung wurde auf 19 Jahre festgesetzt, auch wurden die Prüfungen nur in Großbritannien abgehalten.“"
                            },
                            {
                                "example_id": "b731b250-afc5-485a-81b3-0c71ee92bedc",
                                "sense_id": "d22df88d-e54d-386e-8fa0-020d03fe4d4b",
                                "text": "„Die Natur hat Lebewesen sehr unterschiedliche Höchstalter zugedacht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
