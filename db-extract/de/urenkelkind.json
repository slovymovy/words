                        "target_lang_word": "arrière-petit-fils",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "arrière-petit-fils",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2cf4cdc2-131a-3d8c-b70e-d0fba938ef25",
                                        "entry_id": "7b58d145-dfd7-37b7-9f06-76161942442a",
                                        "glosses": [
                                            "Fils du petit-fils (ou de la petite-fille) par rapport au bisaïeul."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9314bd9c-bf7a-4abc-bcf6-54eb3167c38f",
                                                "sense_id": "2cf4cdc2-131a-3d8c-b70e-d0fba938ef25",
                                                "text": "Louis XV était arrière-petit-fils de Louis XIV."
                                            },
                                            {
                                                "example_id": "36d137c0-51f3-4673-a450-aea27446a162",
                                                "sense_id": "2cf4cdc2-131a-3d8c-b70e-d0fba938ef25",
                                                "text": "Ce vieillard a vu ses arrière-petits-fils."
                                            },
                                            {
                                                "example_id": "a34db6bd-dae6-4400-9b42-ca4f07f1f00d",
                                                "sense_id": "2cf4cdc2-131a-3d8c-b70e-d0fba938ef25",
                                                "text": "De prince en prince, le trône vint au petit-fils du roi Tarsi Berderâs, c’est-à-dire à Radja Zemzoua, petit-fils de Chah Tarsi, arrière-petit-fils de Radja Dermanous, arrière-arrière-petit-fils de Radja Ardéchir Babégan, fils lui-même de Radja Koudar Zakouhon, petit-fils de Radja Amtabous, arrière-petit-fils de Radja Sabour, arrière-arrière-petit-fils de Radja Aftas, fils de Radja Arstoun-Chac, fils du roi Iskender Dhou(l-Qarneïn.",
                                                "translation": "Bibliothèque orientale Elzévirienne, 1875"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a45fd3ce-dc17-4c54-82d6-bba076a70de4",
                        "source_entry_id": "5c490a55-67b8-3283-b1dd-1be88b88c4ff",
                        "source_sense_id": "92b5306b-3725-34a8-b1b1-db8e439bb0b8",
                        "source_sense_description": "männliches oder weibliches Kind eines Enkels",
                        "target_lang_word": "arrière-petite-fille",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "arrière-petite-fille",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0df5c673-c963-39ae-b6a0-bcd86610258f",
                                        "entry_id": "dc705f3e-ba15-312e-aad6-59b448224dc5",
                                        "glosses": [
                                            "Fille du petit-fils ou de la petite-fille, par rapport au bisaïeul ou à la bisaïeule."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1080765a-b862-46ec-89fc-1fc7c3bb4783",
                                                "sense_id": "0df5c673-c963-39ae-b6a0-bcd86610258f",
                                                "text": "J'arrive à l'Espérance les Hauts, chez Marie-Ange, dite madame Gaston, qui marie aujourd'hui son arrière-petite-fille."
                                            },
                                            {
                                                "example_id": "a9e8bc8c-b32f-4ec9-b8aa-de5de317cb14",
                                                "sense_id": "0df5c673-c963-39ae-b6a0-bcd86610258f",
                                                "text": "Comment cette goton peut être l’arrière-petite-fille de la belle Ulianna, voilà encore une de ces énigmes de la filiation que je renonce à élucider."
                                            },
                                            {
                                                "example_id": "ca01ece4-f203-44b3-af27-46ec7be2fb52",
                                                "sense_id": "0df5c673-c963-39ae-b6a0-bcd86610258f",
                                                "text": "La tombe de Georges Méliès n’avait pas fière allure, au cimetière du Père-Lachaise (20ᵉ), en 2019, quand son arrière-petite-fille a entrepris de la faire restaurer."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
