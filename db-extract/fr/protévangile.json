                        "glosses": [
                            "Évangile apocryphe racontant les événements qui ont précédé la naissance de Jésus-Christ."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "751b87d7-e6b3-464a-a809-77495a926db3",
                                "sense_id": "0ef81aec-df76-3b03-9579-7c7659538080",
                                "text": "Le Protévangile de Jacques."
                            },
                            {
                                "example_id": "f427d8f0-0283-4c63-bde4-c86f0dee4127",
                                "sense_id": "0ef81aec-df76-3b03-9579-7c7659538080",
                                "text": "Le protévangile de Jacques en particulier, qui raconte l’histoire de Marie, depuis sa conception, et celle de Jésus jusqu’au massacre des Innocents, ses légendes vénérables qu’il a propagées dans l’Orient et l’Occident sont la source presque unique de toutes les vies de la Vierge."
                            }
                        ]
