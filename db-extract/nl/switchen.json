                                        "glosses": [
                                            "A variant of crazy eights where one card, such as an ace, reverses the direction of play."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "47ffc5d7-8524-3cc3-84e2-17a51c3e261b",
                                        "entry_id": "de2cc5f4-25ba-334e-a8a8-2ea7b65a6a2a",
                                        "glosses": [
                                            "Synonym of Glock switch."
                                        ],
