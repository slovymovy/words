                                            {
                                                "example_id": "a953c99c-d35c-4f6f-991a-56164f1e5c3f",
                                                "sense_id": "a51d28fc-7166-3217-9a75-ded8f1197fcb",
                                                "text": "Many packs have a sixer's council where the sixers, and sometimes the seconds, meet with Akela and some of the other leaders."
                                            },
                                            {
                                                "example_id": "9b5ba707-dc69-4c42-8261-1695d1172faf",
                                                "sense_id": "a51d28fc-7166-3217-9a75-ded8f1197fcb",
                                                "text": "The incident that cost him his licence, flying his plane too close to a Scout hut, followed the discovery that his wife was having an affair with a local Akela."
                                            }
