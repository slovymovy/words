                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "935a908e-aa2a-4c2e-a8b4-6449d08025d6",
                                                "sense_id": "37b9621d-dd0a-39f2-9b55-cd9899b73d43",
                                                "text": "Mother of mighty Rome's imperial line, / Delight of man, and of the powers divine, / Venus, all-bounteous queen! whose genial power / Diffuses beauty in unbounded store / Through seas, and fertile plains, and all that lies / Beneath the starred expansion of the skies."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e5633168-e8f9-3bcc-b7ec-3a057affbc42",
                                        "entry_id": "ab0a8845-1c3c-3277-96bc-1680bf59f587",
                                        "glosses": [
                                            "An act, process, or instance of expanding.",
                                            "The operation of steam in a cylinder after its communication with the boiler has been cut off, by which it continues to exert pressure upon the moving piston."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
