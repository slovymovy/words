                "senses": [
                    {
                        "sense_id": "98a69278-8213-3f37-a93b-6509a6a997d8",
                        "entry_id": "1e6e2bd6-bde9-31c3-ba2e-c4e0aa74bf07",
                        "glosses": [
                            "Variante de tryharder"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b51fd207-1f3d-4460-866d-a0160af7be9d",
                                "sense_id": "98a69278-8213-3f37-a93b-6509a6a997d8",
                                "text": "Aujourd’hui, j’ai découvert le verbe « traillarder », courant chez le jeune de 12-13 ans semble-t-il."
                            },
                            {
                                "example_id": "80e144ee-e0bd-466a-9a11-fcf4c85465a8",
                                "sense_id": "98a69278-8213-3f37-a93b-6509a6a997d8",
                                "text": "Les expressions changent avec l’âge, et parfois, un simple mot peut prêter à confusion. Ce qui est « ouf » pour un jeune est juste un soupir de soulagement pour un ancien. Et quand un ado dit qu’il doit « traillarder », un prof peut croire à une expression locale… alors que c'est juste une adaptation de l’anglais « try harder » !"
                            }
                        ]
                    }
