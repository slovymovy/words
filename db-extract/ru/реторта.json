                                "target_senses": [
                                    {
                                        "sense_id": "731f8d18-cde3-3d74-b38e-d97a9b39b672",
                                        "entry_id": "7dced18c-12c2-36e7-ba68-1895c1164571",
                                        "glosses": [
                                            "kuliste naczynie o wydłużonej, zakrzywionej szyjce, najczęściej wykonane ze szkła, używane do destylacji"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "25c13e36-b604-4fc7-8f76-0b7c2c5270db",
                                                "sense_id": "731f8d18-cde3-3d74-b38e-d97a9b39b672",
                                                "text": "Profesor z rozwichrzoną czupryną przelewał z retorty do retorty mętną białawą ciecz, mieszał ją z substancjami, zawartymi w szeregach probówek, przygotowując jakąś reakcję."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "e2767dfd-96b5-3b7a-b727-fa4ef58154e4",
                                        "entry_id": "7dced18c-12c2-36e7-ba68-1895c1164571",
                                        "glosses": [
                                            "duży, cylindryczny piec, w którym materiał poddawany jest wysokim temperaturom, służący do wypalania węgla drzewnego lub otrzymywania lotniejszych metali"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "45eb3cc6-634f-40f1-8b98-2fff926b3166",
                                                "sense_id": "e2767dfd-96b5-3b7a-b727-fa4ef58154e4",
                                                "text": "Kiedyś zaczynał od wypalania węgla drzewnego w retortach, o takich jak on mówiło się, że w lasach są u wrót piekieł."
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    },
                                    {
                                        "sense_id": "ebc3a89e-66f9-33dc-9b02-5f0882b0c4a4",
                                        "entry_id": "7dced18c-12c2-36e7-ba68-1895c1164571",
                                        "glosses": [
                                            "komora pieca krematoryjnego, w której spopielane są zwłoki"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48b4adb0-fff6-43ad-969c-12d94197541c",
                                                "sense_id": "ebc3a89e-66f9-33dc-9b02-5f0882b0c4a4",
                                                "text": "Członkowie Sonderkommando układali na podłodze po pięć zwłok przed każdą retortą, a resztę przenosili do magazynu koło windy."
                                            }
                                        ],
                                        "sense_index_json": "\"1.3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "50067d6f-1be0-499e-aad8-5851b26bdfff",
