    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "09062905-f881-3b10-a098-10fe9f97fac2",
                    "sense_definition": "Action de regarder attentivement et longuement quelque chose avec admiration ou intérêt.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "regard",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle passait des heures dans la <w>contemplation</w> de la mer agitée depuis sa fenêtre."
                        },
                        {
                            "text": "La <w>contemplation</w> d'un chef-d'œuvre procure souvent une vive émotion aux amateurs d'art."
                        }
                    ],
                    "synonyms": [
                        "admiration",
                        "observation"
                    ],
                    "common_phrases": [
                        "contemplation de la nature",
                        "rester en contemplation"
                    ]
                },
                {
                    "sense_id": "097d7a15-6547-3db3-aef2-659890ff0afb",
                    "sense_definition": "Méditation profonde et recueillement de l'esprit tourné vers des vérités spirituelles ou intellectuelles.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "spiritualite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les moines consacrent une grande partie de leur journée au silence et à la <w>contemplation</w>."
                        },
                        {
                            "text": "Plongé dans une <w>contemplation</w> mystique, il semblait totalement insensible aux bruits de la pièce."
                        }
                    ],
                    "synonyms": [
                        "méditation",
                        "recueillement"
                    ],
                    "common_phrases": [
                        "vie de contemplation"
                    ]
                },
                {
                    "sense_id": "d68dc379-174c-3c51-b8e0-6b78f478570f",
                    "sense_definition": "État ou disposition d'esprit porté au calme, à la rêverie et à la réflexion intérieure.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "etat_d_esprit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cet auteur solitaire a toujours préféré la <w>contemplation</w> paisible à l'agitation des villes."
                        },
                        {
                            "text": "Le repos au bord du lac favorise une douce <w>contemplation</w> propice à la créativité."
                        }
                    ],
                    "synonyms": [
                        "rêverie"
                    ],
                    "antonyms": [
                        "action"
                    ],
                    "common_phrases": [
