                        "examples": [
                            {
                                "example_id": "18568b55-e516-4371-be0f-3d88060fc84b",
                                "sense_id": "79c28f55-8e54-3605-a0f9-2ed543201bd0",
                                "text": "Toen de schuldig bevonden jongen de 23-jarige studente Fysiotherapie verkrachtte, was hij 17 jaar, dus minderjarig. Daarom duurde het even voor de rechter een uitspraak kon doen: die werd vier keer uitgesteld. Er is zelfs een botonderzoek bij de jongen gedaan, om vast te stellen of hij daadwerkelijk minderjarig was."
                            },
                            {
                                "example_id": "22a8e7fb-74d7-4988-bfdc-9e34b5a07e8b",
                                "sense_id": "79c28f55-8e54-3605-a0f9-2ed543201bd0",
                                "text": "Voor de verkrachting zijn zes mannen opgepakt, maar een van hen zou minderjarig zijn. Minderjarigen kunnen niet worden aangeklaagd voor moord. De politie laat via een botonderzoek uitzoeken of de jongen inderdaad jonger dan 18 is."
                            }
                        ]
                    }
