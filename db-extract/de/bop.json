                        "entry_id": "bfed093d-660f-3254-9816-fa7286c1af36",
                        "glosses": [
                            "Bebop; durch mehr Soli und mehr Improvisation als im Swing geprägte Musikrichtung, die der Vorläufer des Modern Jazz war"
                        ],
                        "tags": [
                            "short-form"
                        ],
                        "examples": [
                            {
                                "example_id": "a698ee6a-5efe-45bb-9f9a-67823fcecdb9",
                                "sense_id": "fb3e1783-a044-3a88-9f7b-e307120da305",
                                "text": "Die kleinen Bands, die den Bop entwickelten, galten nicht als Tanz- oder Unterhaltungskapellen, sondern als Kunstensembles."
                            }
                        ],
                        "sense_index_json": "\"1\""
