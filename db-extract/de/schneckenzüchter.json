                "senses": [
                    {
                        "sense_id": "6cffe74f-7699-3ab1-8c12-885f9d103b8a",
                        "entry_id": "d94a8ddc-955e-3fb4-8590-9ef4fb4eaf83",
                        "glosses": [
                            "jemand, der Schnecken züchtet; der eine Schneckenzucht betreibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "67747197-dfd1-4edf-9977-4cddf5300bc7",
                                "sense_id": "6cffe74f-7699-3ab1-8c12-885f9d103b8a",
                                "text": "„Ein Gutteil des Gemüses aber soll im Sommer von einem eigens angelegten Feld bei Schneckenzüchter Andreas Gugumuck vor den Toren der Stadt kommen, der Fisch von der Naturteichwirtschaft Radlberg, das Fleisch von Qualitätsfleischhauer Höllerschmid aus dem Kamptal.“"
                            },
                            {
                                "example_id": "5d9550a4-824c-4f0d-a786-a430d0cb384a",
                                "sense_id": "6cffe74f-7699-3ab1-8c12-885f9d103b8a",
                                "text": "„Im Beruf der Woche zeigen wir den Joballtag von Schneckenzüchtern.“"
                            },
                            {
                                "example_id": "05a0e6f1-c3aa-4f52-a370-63d02a43485a",
                                "sense_id": "6cffe74f-7699-3ab1-8c12-885f9d103b8a",
                                "text": "„Über den ersten und einzigen österreichischen Schneckenzüchter und sein Nischen-Business ist seit dessen Start 2006 viel berichtet worden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
