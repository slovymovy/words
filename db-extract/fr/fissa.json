                                            {
                                                "example_id": "17799a5c-b56f-4e9d-9fd2-a0afe899e44f",
                                                "sense_id": "f1c797b4-4708-3261-8d46-12139e4a386b",
                                                "text": "You're snappy this morning; did you not sleep well?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4103f6f1-c95c-38b2-b814-79a72714fa02",
                                        "entry_id": "291fec84-4ccf-3550-85c1-0c2e27bcafad",
                                        "glosses": [
                                            "Tidy; well-dressed; sharp."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7cb3b6c6-4ba5-42dc-8883-ffb6eeee7965",
                                                "sense_id": "4103f6f1-c95c-38b2-b814-79a72714fa02",
                                                "text": "Here he is, looking snappy in his brand-new suit."
                                            },
                                            {
                                                "example_id": "d0182d88-e46b-4dbe-a4fb-5be44ee3f77a",
                                                "sense_id": "4103f6f1-c95c-38b2-b814-79a72714fa02",
                                                "text": "The niftiest, snappiest slacks you ever saw!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5ea0f6db-e78b-327e-9a7a-4616916828dd",
                                        "entry_id": "291fec84-4ccf-3550-85c1-0c2e27bcafad",
                                        "glosses": [
                                            "Chilly, brisk, sharp."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6dbd38a0-b26c-4a1e-a742-62202257e7fb",
                                                "sense_id": "5ea0f6db-e78b-327e-9a7a-4616916828dd",
                                                "text": "snappy weather; snappy pace; snappy rejoinder"
                                            },
                                            {
                                                "example_id": "384566f6-c9c0-422d-816f-0aee8f4a3876",
                                                "sense_id": "5ea0f6db-e78b-327e-9a7a-4616916828dd",
                                                "text": "The day was cool and snappy for August, and the Rise all green with a lavish nature. Now we plunged into a deep shade with the boughs lacing each other overhead, and crossed dainty, rustic bridges over the cold trout-streams, the boards giving back the clatter of our horses' feet:[…]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e58f0bb1-344d-3520-8503-bb69fad3bb7e",
                                        "entry_id": "291fec84-4ccf-3550-85c1-0c2e27bcafad",
                                        "glosses": [
                                            "Tending to snap or bite."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "361a6a67-968a-47be-8177-e216339a6c18",
                                                "sense_id": "e58f0bb1-344d-3520-8503-bb69fad3bb7e",
                                                "text": "a snappy dog"
                                            },
                                            {
                                                "example_id": "2aa73f2b-fc5d-4a2e-ab38-c942ac2b3fea",
                                                "sense_id": "e58f0bb1-344d-3520-8503-bb69fad3bb7e",
                                                "text": "These spring-loaded seats are a bit harder and very snappy when you get off them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "478f60d7-b2b2-3860-842f-c08dbb05241d",
                                        "entry_id": "291fec84-4ccf-3550-85c1-0c2e27bcafad",
                                        "glosses": [
                                            "Clever, catchy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "41e3f993-a906-466e-9104-56fd07d91887",
                                                "sense_id": "478f60d7-b2b2-3860-842f-c08dbb05241d",
