                                "target_lang_sense_clarification": "靠膝盖贴地向前移动"
                            },
                            {
                                "target_lang_word": "跪着爬行",
                                "target_lang_sense_clarification": "说明移动方式"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "76c31e32-a759-3503-8c93-70613b774020",
                    "sense_definition": "To kneel in front of someone to show respect.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The subjects were expected to <w>knee</w> the throne whenever the king appeared.",
                            "target_lang_translations": {
                                "ru": "Ожидалось, что подданные будут <w>преклонять колена</w> перед троном всякий раз, когда появлялся король.",
                                "zh": "每当国王出现时，臣民都得向王座<w>屈膝</w>。"
                            }
                        },
                        {
                            "text": "I will not <w>knee</w> before a tyrant who has no right to rule.",
                            "target_lang_translations": {
                                "ru": "Я не буду <w>преклонять колена</w> перед тираном, не имеющим права на власть.",
                                "zh": "我不会向一个无权统治的暴君<w>屈膝</w>。"
                            }
                        }
                    ],
