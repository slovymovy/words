                                "target_senses": [
                                    {
                                        "sense_id": "f8054e37-a0c5-3970-8085-5277302a5c25",
                                        "entry_id": "3be3a960-604b-33ff-9405-f77fec5ba6d1",
                                        "glosses": [
                                            "Innate, inherent, inseparable from the thing itself, essential."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "749f3c49-7cac-4dae-b497-f077fe611e09",
                                                "sense_id": "f8054e37-a0c5-3970-8085-5277302a5c25",
                                                "text": "the intrinsic value of gold or silver"
                                            },
                                            {
                                                "example_id": "1153f78c-24a3-49f6-ba2b-7f63a50e0c1e",
                                                "sense_id": "f8054e37-a0c5-3970-8085-5277302a5c25",
                                                "text": "the intrinsic merit of an action"
                                            },
                                            {
                                                "example_id": "20a45a62-89bd-433d-b78a-9ee676dbdf5d",
                                                "sense_id": "f8054e37-a0c5-3970-8085-5277302a5c25",
                                                "text": "He was better qualified than they to estimate justly the intrinsic value of Grecian philosophy and refinement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "59b06641-6c7c-3fe2-a710-8276cdd6e9f7",
                                        "entry_id": "3be3a960-604b-33ff-9405-f77fec5ba6d1",
                                        "glosses": [
                                            "Situated, produced, secreted in, or coming from inside an organ, tissue, muscle or member."
                                        ],
                                        "tags": [
                                            "of a body part"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c9fecaaa-8eb6-33c7-a93f-d441a58223d2",
                                        "entry_id": "3be3a960-604b-33ff-9405-f77fec5ba6d1",
                                        "glosses": [
                                            "Built-in."
                                        ],
                                        "tags": [
                                            "of a function or operator"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fa5b6ffc-3836-40f0-a43b-efe8fa7b5253",
                                                "sense_id": "c9fecaaa-8eb6-33c7-a93f-d441a58223d2",
                                                "text": "In addition to the Fortran operators that are intrinsic (built in), there may be user-defined operators in expressions."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "intrinsic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b2209511-09e0-3a35-ba67-abaf499595a2",
                                        "entry_id": "30585496-d130-3391-ba05-b8fdf9e6886d",
                                        "glosses": [
                                            "A built-in function that is implemented directly by the compiler, without any intermediate call to a library."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "31d2eff7-c5df-48e9-bf44-f01692514297",
                                                "sense_id": "b2209511-09e0-3a35-ba67-abaf499595a2",
                                                "text": "SIMD intrinics"
                                            },
                                            {
                                                "example_id": "c658ae59-ef38-4d6b-aec8-97a7daf49bf3",
                                                "sense_id": "b2209511-09e0-3a35-ba67-abaf499595a2",
                                                "text": "Crappy loops, we got them: Use vector intrinsics¶ For troublesome loops that just don't vectorize even with hints, vector intrinsics are another option."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aaedf6f0-56bc-34ec-b53f-1fbee45dfc79",
                                        "entry_id": "30585496-d130-3391-ba05-b8fdf9e6886d",
                                        "glosses": [
                                            "An ability possessed by a character and not requiring any external equipment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "40f84626-b769-4b9a-9080-9a27b099ec6a",
                                                "sense_id": "aaedf6f0-56bc-34ec-b53f-1fbee45dfc79",
                                                "text": "You can acquire the fire-resistance intrinsic by eating dragon meat."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e04a2168-a7cd-4a0b-885d-13e627f5f24d",
                        "source_entry_id": "98c29518-55ea-35cf-ade1-cd9ff82b5653",
                        "target_lang_word": "essential",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "essential",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b9274a1c-5aaf-3d1e-8ccc-57039e5b48f7",
                                        "entry_id": "baaf789d-3aaa-3aa4-8f36-58e07b83c345",
                                        "glosses": [
                                            "Necessary."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0400433d-ca30-4c44-a52a-c81c283851a5",
                                                "sense_id": "b9274a1c-5aaf-3d1e-8ccc-57039e5b48f7",
                                                "text": "There’s canker at the root, your seed\nDenies the blessing of the sun,\nThe light essential to your need.\nYour hopes are murdered and undone."
                                            },
                                            {
                                                "example_id": "5c280d43-8fb6-44e8-965c-c5e59d207ebc",
                                                "sense_id": "b9274a1c-5aaf-3d1e-8ccc-57039e5b48f7",
                                                "text": "Thus, research-based resources with the potential to assist teachers prepare secondary students for tertiary education are essential."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e9ea2595-247b-37e3-ba87-c47a7afc7057",
                                        "entry_id": "baaf789d-3aaa-3aa4-8f36-58e07b83c345",
                                        "glosses": [
                                            "Very important; of high importance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "313fc8d4-f73a-4925-9f53-5acb851a4f7f",
                                                "sense_id": "e9ea2595-247b-37e3-ba87-c47a7afc7057",
                                                "text": "In order to grant the rich these pleasures, the social contract is reconfigured. The welfare state is dismantled. Essential public services are cut so that the rich may pay less tax. […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "51e30e97-aeaa-31c5-93de-5fde9e358b19",
                                        "entry_id": "baaf789d-3aaa-3aa4-8f36-58e07b83c345",
                                        "glosses": [
                                            "Necessary for survival but not synthesized by the organism, thus needing to be ingested."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fd46c99f-d0bd-3a87-8938-8458f877b820",
                                        "entry_id": "baaf789d-3aaa-3aa4-8f36-58e07b83c345",
                                        "glosses": [
                                            "Being in the basic form; showing its essence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c56be631-e0cb-4272-864e-bd3c439a9689",
                                                "sense_id": "fd46c99f-d0bd-3a87-8938-8458f877b820",
                                                "text": "Don’t mind him being grumpy. That’s the essential Fred."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "742dc728-f2a4-3a72-9b50-f86263537629",
                                        "entry_id": "baaf789d-3aaa-3aa4-8f36-58e07b83c345",
                                        "glosses": [
                                            "Really existing; existent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a035378-5adb-4acf-8371-679d8ed0eaca",
                                                "sense_id": "742dc728-f2a4-3a72-9b50-f86263537629",
                                                "text": "Or is it true, that thou art but a bare name, / And no eſſential thing?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "54550533-c3ef-3a32-a6bf-7abdea58ae69",
                                        "entry_id": "baaf789d-3aaa-3aa4-8f36-58e07b83c345",
                                        "glosses": [
                                            "Such that each complementary region is irreducible, the boundary of each complementary region is incompressible by disks and monogons in the complementary region, and no leaf is a sphere or a torus bounding a solid torus in the manifold."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "17fcb53f-a310-3a4c-b32f-ea59b29108a9",
                                        "entry_id": "baaf789d-3aaa-3aa4-8f36-58e07b83c345",
                                        "glosses": [
                                            "Idiopathic."
