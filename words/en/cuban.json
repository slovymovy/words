            "senses": [
                {
                    "sense_id": "6ee3846e-8510-393c-9d60-2d6748f6ec62",
                    "sense_definition": "A person from Cuba or of Cuban descent.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many <w>Cubans</w> have settled in Florida over the years.",
                            "target_lang_translations": {
                                "ru": "За эти годы во Флориде обосновалось много <w>кубинцев</w>.",
                                "zh": "多年来，许多<w>古巴人</w>在佛罗里达州定居。"
                            }
                        },
                        {
                            "text": "She is a proud <w>Cuban</w> who loves to share her heritage.",
                            "target_lang_translations": {
                                "ru": "Она гордая <w>кубинка</w>, которая любит делиться своим наследием.",
                                "zh": "她是一位自豪的<w>古巴人</w>，乐于分享她的文化遗产。"
                            }
