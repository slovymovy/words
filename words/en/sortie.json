{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0dc600dc-0ae1-3960-a5b2-8f3d1dd53b13",
                    "sense_definition": "An operational flight carried out by a single military aircraft.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pilot prepared for a dangerous combat <w>sortie</w> over enemy territory. ",
                            "target_lang_translations": {
                                "ru": "Пилот готовился к опасному боевому <w>вылету</w> над территорией противника."
                            }
                        },
                        {
                            "text": "The squad flew a successful <w>sortie</w> to gather intelligence.",
                            "target_lang_translations": {
                                "ru": "Эскадрилья совершила успешный <w>вылет</w> для сбора разведданных."
                            }
                        }
                    ],
                    "common_phrases": [
                        "combat sortie",
                        "fly a sortie"
                    ],
                    "target_lang_definitions": {
                        "ru": "Оперативный полёт, выполняемый одним военным самолётом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "боевой вылет",
                                "target_lang_sense_clarification": "авиационный"
                            },
                            {
                                "target_lang_word": "вылет",
                                "target_lang_sense_clarification": "военный полёт"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "db6e454d-44a2-3633-be9e-4954e7f3bb5b",
                    "sense_definition": "A brief trip or excursion away from one's usual base to accomplish a task.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After a quick <w>sortie</w> to the grocery store, she returned home to finish cooking.",
                            "target_lang_translations": {
                                "ru": "После быстрой <w>вылазки</w> в продуктовый магазин она вернулась домой, чтобы закончить готовку."
                            }
                        },
                        {
                            "text": "We made a brief <w>sortie</w> into the city center to buy supplies.",
                            "target_lang_translations": {
                                "ru": "Мы совершили короткую <w>поездку</w> в центр города, чтобы купить припасы."
                            }
                        }
                    ],
                    "common_phrases": [
                        "brief sortie"
                    ],
                    "target_lang_definitions": {
                        "ru": "Короткая поездка или вылазка за пределы обычного места пребывания для выполнения задачи."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вылазка",
                                "target_lang_sense_clarification": "короткая поездка или прогулка"
                            },
                            {
                                "target_lang_word": "поездка",
                                "target_lang_sense_clarification": "краткая отлучка"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bf410bc0-41a4-33da-b24c-d7dc4ae9a726",
                    "sense_definition": "An initial attempt or venture into a new area of activity or business.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company made a initial <w>sortie</w> into online retail last year.",
                            "target_lang_translations": {
                                "ru": "В прошлом году компания сделала первую <w>попытку</w> выйти на рынок онлайн-торговли."
                            }
                        },
                        {
                            "text": "This novel marks her first <w>sortie</w> into science fiction writing.",
                            "target_lang_translations": {
                                "ru": "Этот роман стал её первой <w>пробой сил</w> в жанре научной фантастики."
                            }
                        }
                    ],
                    "common_phrases": [
                        "initial sortie",
                        "first sortie"
                    ],
                    "target_lang_definitions": {
                        "ru": "Первая попытка или проба сил в новой сфере деятельности или бизнеса."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "проба сил",
                                "target_lang_sense_clarification": "в новой сфере"
                            },
                            {
                                "target_lang_word": "попытка",
                                "target_lang_sense_clarification": "первый шаг"
                            },
                            {
                                "target_lang_word": "вылазка",
                                "target_lang_sense_clarification": "первый опыт в чём-то новом"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d61645d9-e801-3b99-b2b0-c105a4b1a333",
                    "sense_definition": "A sudden attack made by troops from a defensive or besieged position.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The besieged garrison launched a bold <w>sortie</w> against the enemy lines.",
                            "target_lang_translations": {
                                "ru": "Осаждённый гарнизон предпринял дерзкую <w>вылазку</w> против позиций врага."
                            }
                        },
                        {
                            "text": "A nighttime <w>sortie</w> caught the surrounding soldiers completely off guard.",
                            "target_lang_translations": {
                                "ru": "Ночная <w>контратака</w> застала окружавших солдат врасплох."
                            }
                        }
                    ],
                    "common_phrases": [
                        "bold sortie",
                        "launch a sortie"
                    ],
                    "target_lang_definitions": {
                        "ru": "Внезапная атака войск из оборонительного или осаждённого положения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вылазка",
                                "target_lang_sense_clarification": "атака из осады"
                            },
                            {
                                "target_lang_word": "контратака",
                                "target_lang_sense_clarification": "внезапный удар"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "08ad728a-e276-3acb-b172-ca5dcf25a86a",
                    "sense_definition": "An attacking move or forward advance in a sport or game.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The winger made a quick <w>sortie</w> down the right flank before passing.",
                            "target_lang_translations": {
                                "ru": "Фланговый нападающий сделал быстрый <w>проход</w> по правому краю перед передачей."
                            }
                        },
                        {
                            "text": "Their offensive <w>sortie</w> was halted by a strong defensive tackle.",
                            "target_lang_translations": {
                                "ru": "Их атакующий <w>выпад</w> был остановлен мощным захватом в обороне."
                            }
                        }
                    ],
                    "common_phrases": [
                        "offensive sortie"
                    ],
                    "target_lang_definitions": {
                        "ru": "Атакующее движение или продвижение вперёд в спорте или игре."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вылазка",
                                "target_lang_sense_clarification": "атакующий проход в спорте"
                            },
                            {
                                "target_lang_word": "атака",
                                "target_lang_sense_clarification": "продвижение вперёд"
                            },
                            {
                                "target_lang_word": "выпад",
                                "target_lang_sense_clarification": "быстрое наступательное движение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eba975c0-48f8-3131-80ec-7631c4971870",
                    "sense_definition": "An operational mission by a spacecraft involving a return to Earth.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The space shuttle completed another successful orbital <w>sortie</w>.",
                            "target_lang_translations": {
                                "ru": "Космический шаттл завершил очередной успешный орбитальный <w>полёт</w>."
                            }
                        },
                        {
                            "text": "Scientists analyzed data gathered during the weeklong space <w>sortie</w>.",
                            "target_lang_translations": {
                                "ru": "Учёные проанализировали данные, собранные во время недельного космического <w>рейса</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "space sortie"
                    ],
                    "target_lang_definitions": {
                        "ru": "Оперативный полёт космического корабля с возвращением на Землю."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "космический полёт",
                                "target_lang_sense_clarification": "орбитальный рейс"
                            },
                            {
                                "target_lang_word": "рейс",
                                "target_lang_sense_clarification": "космическая миссия"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e960382f-9360-3834-8bc6-dc6112192114",
                    "sense_definition": "An opening or passage in a fortification used by troops to sally forth.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Defenders slipped quietly through the narrow <w>sortie</w> into the moat.",
                            "target_lang_translations": {
                                "ru": "Защитники незаметно проскользнули через узкий <w>вылаз</w> в ров."
                            }
                        },
                        {
                            "text": "The castle gate featured a heavily guarded <w>sortie</w> for quick escapes.",
                            "target_lang_translations": {
                                "ru": "В воротах замка был строго охраняемый <w>проход</w> для быстрого отхода."
                            }
                        }
                    ],
                    "synonyms": [
                        "sally port"
                    ],
                    "target_lang_definitions": {
                        "ru": "Проход или проём в укреплении, используемый войсками для совершения вылазок."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вылаз",
                                "target_lang_sense_clarification": "в фортификации"
                            },
                            {
                                "target_lang_word": "проход",
                                "target_lang_sense_clarification": "для вылазок"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6ecaf116-a7f7-3b9f-ba6a-3e54a3fd9a17",
                    "sense_definition": "A flight dedicated to aerial photography, or the series of photos taken during it.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The reconnaissance plane completed a photo <w>sortie</w> over the coastline.",
                            "target_lang_translations": {
                                "ru": "Самолёт-разведчик совершил <w>вылет на фоторазведку</w> над побережьем."
                            }
                        },
                        {
                            "text": "Images gathered during the reconnaissance <w>sortie</w> revealed new details.",
                            "target_lang_translations": {
                                "ru": "Снимки, полученные во время разведывательного <w>вылета</w>, раскрыли новые подробности."
                            }
                        }
                    ],
                    "common_phrases": [
                        "photo sortie",
                        "reconnaissance sortie"
                    ],
                    "target_lang_definitions": {
                        "ru": "Полёт, предназначенный для аэрофотосъёмки, или серия фотографий, сделанных во время него."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разведывательный вылeт",
                                "target_lang_sense_clarification": "для фотосъёмки"
                            },
                            {
                                "target_lang_word": "вылет на фоторазведку",
                                "target_lang_sense_clarification": "авиационный"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7c124c6a-d35c-3a06-85da-c3d95a86211c",
                    "sense_definition": "To issue forth or carry out a military mission or strike.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Warplanes <w>sortied</w> at dawn to target enemy positions.",
                            "target_lang_translations": {
                                "ru": "Военные самолёты <w>совершили вылет</w> на рассвете для нанесения ударов по позициям противника."
                            }
                        },
                        {
                            "text": "The fleet was ordered to <w>sortie</w> against the approaching armada.",
                            "target_lang_translations": {
                                "ru": "Флоту было приказано <w>выйти в атаку</w> против приближающейся армады."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Совершать вылет или военную операцию, выходить в атаку."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "совершать вылет",
                                "target_lang_sense_clarification": "о военной авиации"
                            },
                            {
                                "target_lang_word": "совершать вылазку",
                                "target_lang_sense_clarification": "о войсках"
                            }
                        ]
                    }
                }
            ]
        },
        {
