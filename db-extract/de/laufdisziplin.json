                "senses": [
                    {
                        "sense_id": "e8dfa539-9d2f-31a7-a712-0f046324a7a2",
                        "entry_id": "6c059542-d64a-3984-9a2b-f362cd780b29",
                        "glosses": [
                            "spezifische Form des Laufens beziehungsweise Streckenlänge, in der sportliche Laufwettkämpfe ausgetragen werden"
                        ],
                        "tags": [
                            "Laufsport"
                        ],
                        "examples": [
                            {
                                "example_id": "900009fb-8e92-4966-b07e-9a836b2df6eb",
                                "sense_id": "e8dfa539-9d2f-31a7-a712-0f046324a7a2",
                                "text": "„Also bin ich auf die längste Laufdisziplin, die olympisch ist, gewechselt: den Marathon.“"
                            },
                            {
                                "example_id": "062a35a1-9353-4b80-8a26-cffb25ef9570",
                                "sense_id": "e8dfa539-9d2f-31a7-a712-0f046324a7a2",
                                "text": "„Eisschnelllauf ist eine sportliche Laufdisziplin, die auf dem Eis und auf Schlittschuhen ausgetragen wird.“"
                            },
                            {
                                "example_id": "afb1c8ff-8a1d-45d5-bde7-a87a47a903f1",
                                "sense_id": "e8dfa539-9d2f-31a7-a712-0f046324a7a2",
                                "text": "„Er war mit diesem Erfolg der erste Deutsche, der bei Juniorenweltmeisterschaften eine Medaille in einer Laufdisziplin gewann.“"
                            },
                            {
                                "example_id": "603da387-cd20-4586-868a-a8ea9c1fa360",
                                "sense_id": "e8dfa539-9d2f-31a7-a712-0f046324a7a2",
                                "text": "„Diese Laufdisziplin ist ja mittlerweile recht populär geworden.“"
                            },
                            {
                                "example_id": "bb4e2a8a-9818-4891-b758-1a1785894b46",
                                "sense_id": "e8dfa539-9d2f-31a7-a712-0f046324a7a2",
                                "text": "„Crosslauf ist eine Laufdisziplin, bei der die Läufer abseits der Straße durch verschiedenstes Gelände laufen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
