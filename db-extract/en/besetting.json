                        "entry_id": "d5402419-0bd5-33a3-b607-49500c443b3f",
                        "glosses": [
                            "The act of one who besets or attacks."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ed3106c-e783-4074-af34-0b757b49e6d7",
                                "sense_id": "c076c623-0b33-3b6d-8e54-fa554528f40e",
                                "text": "I might also here tell you of the contests and battles that such are engaged in, wherein they find the besettings of Satan, above any other of the saints."
                            }
                        ]
