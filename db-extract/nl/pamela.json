                        "examples": [
                            {
                                "example_id": "a8a0110a-3b7f-43e4-b516-e02300bcc4bb",
                                "sense_id": "3234b40c-3036-3e83-b0c4-5f7977921566",
                                "text": "Vrijwel die hele eerste week was de enige die ik sprak een meisje dat Pamela Rudge heette."
                            },
                            {
                                "example_id": "7cbfec65-13a4-446c-ad78-a42f1b8befc8",
                                "sense_id": "3234b40c-3036-3e83-b0c4-5f7977921566",
                                "text": "Ik kwam tot de conclusie dat Pamela iemand was die haar buik rond eten met cervelaatworst op Leicester Square als een geslaagd avondje uit beschouwde."
                            },
                            {
                                "example_id": "5f366e9a-9473-4793-9e02-00db00f53f78",
                                "sense_id": "3234b40c-3036-3e83-b0c4-5f7977921566",
                                "text": "Misschien waren sommige van die gedachten van mijn gezicht af te lezen, want Pamela op haar beurt keek me iedere dag weer óf met grote ogen aan, alsof ze zich erover verbaasde dat ik het lef had steeds terug te komen, óf ze straalde een comateuze verveling uit bij het zien van mijn gezicht."
                            }
                        ]
                    }
