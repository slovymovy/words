    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4084143b-dbc5-3442-9917-f35a3e06e074",
                    "sense_definition": "Przywracać zepsuty lub uszkodzony przedmiot do stanu używalności; sprawiać, że coś znów działa.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mój tata potrafi <naprawić> prawie każde urządzenie domowe.",
                            "target_lang_translations": {
                                "ru": "Мой папа может <w>починить</w> почти любой бытовой прибор.",
                                "en": "My dad can <w>fix</w> almost any household appliance."
                            }
                        },
                        {
                            "text": "Musimy wezwać mechanika, który <naprawia> silniki samochodowe.",
                            "target_lang_translations": {
                                "ru": "Нам нужно вызвать механика, который <w>ремонтирует</w> автомобильные двигатели.",
                                "en": "We need to call a mechanic who <w>repairs</w> car engines."
                            }
                        }
                    ],
                    "synonyms": [
                        "reperować"
                    ],
                    "antonyms": [
                        "psuć",
                        "zniszczyć",
                        "uszkodzić",
                        "popsuć",
                        "złamać"
                    ],
                    "common_phrases": [
                        "naprawiać samochód",
                        "naprawiać dach",
                        "naprawiać buty",
                        "naprawiać sprzęt"
                    ],
                    "target_lang_definitions": {
                        "ru": "Приводить сломанный или поврежденный предмет в рабочее состояние; делать так, чтобы что-то снова работало.",
                        "en": "To restore a broken or damaged object to a working state; to make something function again."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чинить",
                                "target_lang_sense_clarification": "общие предметы, бытовой ремонт"
                            },
                            {
                                "target_lang_word": "ремонтировать",
                                "target_lang_sense_clarification": "технику, здания, более формально"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "repair",
                                "target_lang_sense_clarification": "general term for fixing objects, buildings, or machinery"
                            },
                            {
                                "target_lang_word": "fix",
                                "target_lang_sense_clarification": "common, slightly informal term for mending or restoring functionality"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "90326f46-bf05-3264-82a3-906d05156556",
                    "sense_definition": "Usuwać błędy, korygować pomyłki lub czynić złą sytuację lepszą.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nauczyciel poprosił ucznia, aby <naprawił> błędy w swoim wypracowaniu.",
                            "target_lang_translations": {
                                "ru": "Учитель попросил ученика <w>исправить</w> ошибки в своем сочинении.",
                                "en": "The teacher asked the student to <w>correct</w> the mistakes in his essay."
                            }
                        },
                        {
                            "text": "Próbuję <naprawić> moje relacje z bratem po naszej ostatniej kłótni.",
                            "target_lang_translations": {
                                "ru": "Я пытаюсь <w>наладить</w> свои отношения с братом после нашей последней ссоры.",
                                "en": "I am trying to <w>mend</w> my relationship with my brother after our last argument."
                            }
                        }
                    ],
                    "synonyms": [
                        "poprawiać",
                        "polepszać"
                    ],
                    "antonyms": [
                        "psuć",
                        "naruszyć"
                    ],
                    "common_phrases": [
                        "naprawiać błędy",
                        "naprawiać szkody",
                        "naprawiać świat",
                        "naprawiać krzywdy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Устранять ошибки, корректировать промахи или улучшать плохую ситуацию.",
                        "en": "To remove errors, correct mistakes, or improve a bad situation."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "исправлять",
                                "target_lang_sense_clarification": "ошибки, ситуацию"
                            },
                            {
                                "target_lang_word": "поправлять",
                                "target_lang_sense_clarification": "вносить коррективы"
                            },
                            {
                                "target_lang_word": "налаживать",
                                "target_lang_sense_clarification": "отношения, дела"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "correct",
                                "target_lang_sense_clarification": "to remove errors or mistakes"
                            },
                            {
                                "target_lang_word": "fix",
                                "target_lang_sense_clarification": "to resolve a problem or improve a situation"
                            },
                            {
                                "target_lang_word": "mend",
                                "target_lang_sense_clarification": "to improve or restore relationships or situations"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4b96778a-9b47-3d03-b095-027598727a89",
                    "sense_definition": "Stawać się lepszym, wracać do dobrego stanu (często o pogodzie, zdrowiu lub zachowaniu).",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mamy nadzieję, że pogoda <naprawi> się do jutra i pójdziemy na spacer.",
                            "target_lang_translations": {
                                "ru": "Мы надеемся, что погода <w>улучшится</w> к завтрашнему дню, и мы пойдем на прогулку.",
                                "en": "We hope the weather will <w>improve</w> by tomorrow so we can go for a walk."
                            }
                        },
                        {
                            "text": "Jego sytuacja finansowa powoli się <naprawia> dzięki nowej pracy.",
                            "target_lang_translations": {
                                "ru": "Его финансовая ситуация медленно <w>налаживается</w> благодаря новой работе.",
                                "en": "His financial situation is slowly <w>improving</w> thanks to his new job."
                            }
                        }
                    ],
                    "synonyms": [
                        "poprawiać",
                        "polepszać"
                    ],
                    "antonyms": [
                        "psuć",
                        "popsuć"
                    ],
                    "common_phrases": [
                        "pogoda się naprawia",
                        "zdrowie się naprawia"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "używane z zaimkiem zwrotnym 'się'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Становиться лучше, возвращаться в хорошее состояние (часто о погоде, здоровье или поведении).",
                        "en": "To become better or return to a good state (often used for weather, health, or situations)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "улучшаться",
                                "target_lang_sense_clarification": "о погоде, здоровье"
                            },
                            {
                                "target_lang_word": "налаживаться",
                                "target_lang_sense_clarification": "о ситуации, делах"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "improve",
                                "target_lang_sense_clarification": "to become better in quality or condition"
                            },
                            {
                                "target_lang_word": "get better",
                                "target_lang_sense_clarification": "to recover or show progress"
                            }
                        ]
                    }
                }
            ]
        }
