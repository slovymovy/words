                ],
                "senses": [
                    {
                        "sense_id": "d65374c2-fc99-3136-9352-00129e105a5b",
                        "entry_id": "558cc117-deb4-3eb4-a1f5-e5b023b01323",
                        "glosses": [
                            "heel erg warm; op een onplezierige wijze warm"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "73059758-061a-4afd-86be-83c7dfd91e89",
                                "sense_id": "d65374c2-fc99-3136-9352-00129e105a5b",
                                "text": "Aan de andere kant van de baai stond onze auto op de parkeerplaats te wachten, stikheet van al die dagen zon, ik moest tot Massapequa op mijn handen zitten omdat mijn dijbenen anders zouden verbranden door de hete, zwartleren bekleding."
                            },
                            {
                                "example_id": "963d9754-14e2-4955-9694-182bbee24c8e",
                                "sense_id": "d65374c2-fc99-3136-9352-00129e105a5b",
                                "text": "Al dagen is het stikheet in de haven, een hittegolf teistert het hele land. De Syriërs hebben hun tentjes onder afdakjes gezet waar normaal gesproken passagiers op de veerboten wachten. Of ze slapen in de passagiersterminal."
                            }
                        ]
                    }
