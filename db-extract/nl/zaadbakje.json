                                        "examples": [
                                            {
                                                "example_id": "d9ec0a3d-53ce-40a0-9eaf-68812e012c22",
                                                "sense_id": "c78014e0-dc23-3591-bb5f-3374d3ce685b",
                                                "text": "J’aurais bien mangé tout ce qui était devant moi, mais la pauvre petite me fit pitié ; elle ne touchait à rien, malgré l’envie qu’elle en avait. Je fis donc semblant d’en avoir assez, et je quittai mon auget, y laissant la moitié de l’avoine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "29d6732b-d140-309f-a641-baf9efca83cf",
                                        "entry_id": "0772c45e-8d94-323f-887b-2694820272db",
                                        "glosses": [
                                            "Sorte de petite auge où l’on met la mangeaille des oiseaux que l’on nourrit en cage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c829bb08-f6f5-4d17-937e-ea71aa43ecdd",
                                                "sense_id": "29d6732b-d140-309f-a641-baf9efca83cf",
                                                "text": "Auget de bois, de faïence."
                                            },
                                            {
                                                "example_id": "e6cf4272-2553-408a-a6bb-c5c9f225e05f",
                                                "sense_id": "29d6732b-d140-309f-a641-baf9efca83cf",
                                                "text": "Il n’y a plus rien dans l’auget."
                                            }
