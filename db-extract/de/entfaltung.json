                "senses": [
                    {
                        "sense_id": "2eb6def4-b1b1-308a-8bbe-357c69108b31",
                        "entry_id": "d78441a5-9d3c-3917-a5fa-11d5184e4397",
                        "glosses": [
                            "Vorgang, bei dem sich etwas entwickelt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb9d5c35-9ff2-432f-b9ae-f406cc57320f",
                                "sense_id": "2eb6def4-b1b1-308a-8bbe-357c69108b31",
                                "text": "Eine allseitige, freie Entfaltung der Persönlichkeit ist ein Menschenrecht und zugleich des Menschen Pflicht."
                            },
                            {
                                "example_id": "a360243c-a320-456b-8933-30e3769b0d9c",
                                "sense_id": "2eb6def4-b1b1-308a-8bbe-357c69108b31",
                                "text": "Der tiefe Sinn der Rose liegt in der Betrachtung durch den Menschen, in der Entfaltung von Pracht und Duft."
                            },
                            {
                                "example_id": "fb5104d7-88c7-444c-8197-6fcd1d05cddc",
                                "sense_id": "2eb6def4-b1b1-308a-8bbe-357c69108b31",
                                "text": "„Woolf fragt nach Shakespeares Schwester, von der wir nichts wissen, da ihr jede Möglichkeit zur Entfaltung genommen worden ist.“"
                            },
                            {
                                "example_id": "44429d92-fc92-4d4a-bebd-1c87554f93bb",
                                "sense_id": "2eb6def4-b1b1-308a-8bbe-357c69108b31",
                                "text": "„Dazu kommen oft starke Ungerechtigkeiten, hohe Kriminalität, Korruption, eine unfähige Regierung und Verwaltung, weit verbreitete Probleme im Gesundheitssektor, hoher Analphabetismus sowie eine unprofessionelle oder zensierte Presse, die das Land an seiner Entfaltung hindert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "34d4b4e9-c69d-4f1d-a029-f37fbf297157",
                        "source_entry_id": "d78441a5-9d3c-3917-a5fa-11d5184e4397",
                        "source_sense_id": "2eb6def4-b1b1-308a-8bbe-357c69108b31",
