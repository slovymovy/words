                                        "glosses": [
                                            "versuchen zwei Menschen zusammenzubringen, meist mit dem Ziel, dass sie danach ein Paar werden"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
