                                        "sense_id": "aaa46401-7256-34bf-9918-d253dca65048",
                                        "entry_id": "e8c8ce52-cc51-35f3-a951-7dc031d26f92",
                                        "glosses": [
                                            "een kleine beschermde inham"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b0ba965-e61f-49a3-b3a5-472a2e85e111",
                                                "sense_id": "aaa46401-7256-34bf-9918-d253dca65048",
                                                "text": "De rustige wateren in de kreek zijn ideaal voor een variëteit aan watersporten."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d95309ec-929c-32ae-ab90-0e7db3b0f929",
                                        "entry_id": "e8c8ce52-cc51-35f3-a951-7dc031d26f92",
                                        "glosses": [
                                            "een smal stilstaand water, vooral naar een dijkdoorbraak"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc6b6259-dfd9-4d2b-bb4d-4ff6cf03a5c9",
                                                "sense_id": "d95309ec-929c-32ae-ab90-0e7db3b0f929",
                                                "text": "Na dichting van het gat in de dijk blijft de kreek over."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0761fd63-858b-3dd2-a7c4-401af83037ac",
                                        "entry_id": "e8c8ce52-cc51-35f3-a951-7dc031d26f92",
                                        "glosses": [
                                            "een kleine, door de natuur gevormde zeearm"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "579a5f02-38ce-4b75-af4d-60829c26f518",
                                                "sense_id": "0761fd63-858b-3dd2-a7c4-401af83037ac",
                                                "text": "Wanneer een inham doordringt tot ver in het land wordt ook wel gesproken van een kreek."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bac3c586-cde7-3868-9f98-50cd433a65b8",
                                        "entry_id": "e8c8ce52-cc51-35f3-a951-7dc031d26f92",
                                        "glosses": [
                                            "een kleine watergeul; vaak zijarm van een rivier(tje)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ff475cf-e66c-4b26-880d-5516631d32ba",
                                                "sense_id": "bac3c586-cde7-3868-9f98-50cd433a65b8",
                                                "text": "Er ontstonden diepe watergeulen die na het dijkherstel als kreken in het landschap achterbleven."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2552a43a-9ba5-3a93-b141-9e15559b34a1",
                                        "entry_id": "e8c8ce52-cc51-35f3-a951-7dc031d26f92",
                                        "glosses": [
                                            "een smal vaarwater tussen ondiepten of eilanden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "310e8370-fae1-4474-8265-deac8f436c32",
                                                "sense_id": "2552a43a-9ba5-3a93-b141-9e15559b34a1",
                                                "text": "Dit was vroeger een strategische plek, men kon zien welke schepen de kreek binnenvoeren."
                                            }
