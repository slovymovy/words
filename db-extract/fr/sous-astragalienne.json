                                "sense_id": "3c9e8e0f-edfa-36df-a121-8073a646dec7",
                                "text": "La démonstration de Inman démontre que les mouvements de la sous–astragalienne influencent le tibia."
                            },
                            {
                                "example_id": "a60a0cda-a04a-4aa2-bbeb-dd96413b66a3",
                                "sense_id": "3c9e8e0f-edfa-36df-a121-8073a646dec7",
                                "text": "Il limite les mouvements de la sous-astragalienne et maintient l’encastrement osseux."
                            }
                        ]
