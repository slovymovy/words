            "senses": [
                {
                    "sense_id": "c93f198a-73b5-3e09-a774-42809243c0cd",
                    "sense_definition": "Een achtergebleven indruk, kreuk of vlek in een oppervlak.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "noun_mark",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De zware kast heeft een diepe <w>moet</w> in het tapijt achtergelaten.",
                            "target_lang_translations": {
                                "ru": "Тяжелый шкаф оставил глубокую <w>вмятину</w> на ковре.",
                                "en": "The heavy cupboard left a deep <w>impression</w> in the carpet.",
                                "de": "Der schwere Schrank hat eine tiefe <w>Druckstelle</w> im Teppich hinterlassen."
                            }
                        },
                        {
                            "text": "De strakke sokken lieten een rode <w>moet</w> achter op zijn enkels.",
                            "target_lang_translations": {
                                "ru": "Тесные носки оставили красный <w>след</w> на его лодыжках.",
                                "en": "The tight socks left a red <w>mark</w> on his ankles.",
                                "de": "Die engen Socken hinterließen eine rote <w>Strieme</w> an seinen Knöcheln."
                            }
                        }
