                "senses": [
                    {
                        "sense_id": "5ea124e8-f5e0-37e6-9a5c-010542bf9683",
                        "entry_id": "7e17ece9-c09d-3ffe-a1d4-f891be9cc33c",
                        "glosses": [
                            "unteres Augenlid"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a3c18cb-4a42-441e-9d0d-5329ba9ddd76",
                                "sense_id": "5ea124e8-f5e0-37e6-9a5c-010542bf9683",
                                "text": "„Seit acht Jahre bestand am linken Augenunterlid ein anfangs linsen-, dann erbsgroßes schwärzliches Knötchen.“"
                            },
                            {
                                "example_id": "c0937fd6-a884-4bdd-9c42-8d9dde340d49",
                                "sense_id": "5ea124e8-f5e0-37e6-9a5c-010542bf9683",
                                "text": "„Es handelt sich um Tumoren in der Stirnhöhle, am tempolaren Augenunterlid und an der Retina.“"
                            },
                            {
                                "example_id": "5b0fe58e-b48f-464f-91d9-adcb175dca64",
                                "sense_id": "5ea124e8-f5e0-37e6-9a5c-010542bf9683",
                                "text": "„Dabei zog er ein Augenunterlid herunter und grinste Ralf verschmitzt an.“"
                            },
                            {
                                "example_id": "75db30ab-f935-4767-add2-93fd70e497a6",
                                "sense_id": "5ea124e8-f5e0-37e6-9a5c-010542bf9683",
                                "text": "„Mit einer halbstündiger Verfrühung kam der süße Buz. Frau Max hat leider ein rotentzündetes Augenunterlid gehabt, so daß sie keinen vorteilhaften Anblick bot, doch ihre Wellenlänge löste einen guten Plauderschwung in Buzen 51.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
