            "pos": "noun",
            "senses": [
                {
                    "sense_id": "39043983-8582-3c25-b72c-497af429e4b3",
                    "sense_definition": "Diepe bewondering, respect of religieuze aanbidding voor iemand of iets.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "verering_algemeen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zijn blinde <w>verering</w> voor de popster grensde aan het absurde.",
                            "target_lang_translations": {
                                "en": "His blind <w>adoration</w> of the pop star bordered on the absurd."
                            }
                        },
                        {
                            "text": "De diepe <w>verering</w> van de held was in de hele stad voelbaar.",
                            "target_lang_translations": {
                                "en": "The deep <w>veneration</w> of the hero was palpable throughout the city."
                            }
                        }
                    ],
                    "synonyms": [
                        "adoratie",
                        "verheerlijking"
                    ],
                    "common_phrases": [
                        "blinde verering",
                        "diepe verering"
                    ],
                    "target_lang_definitions": {
                        "en": "Deep admiration, respect, or religious worship for someone or something."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "veneration",
                                "target_lang_sense_clarification": "deep respect or awe"
                            },
                            {
                                "target_lang_word": "adoration",
                                "target_lang_sense_clarification": "deep love and respect"
                            },
                            {
                                "target_lang_word": "worship",
                                "target_lang_sense_clarification": "intense admiration or devotion"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7f7d0514-7ded-33bf-a078-60da8e2aaf55",
                    "sense_definition": "Het religieus aanbidden of vereren van heiligen, goden of heilige voorwerpen.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "verering_religieus",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De Noormannen brachten hun <w>verering</w> voor de schutspatroon over naar Noord-Europa.",
                            "target_lang_translations": {
                                "en": "The Normans brought their <w>worship</w> of the patron saint to Northern Europe."
                            }
                        },
                        {
                            "text": "In deze oude tempel stond de <w>verering</w> van de zonnegod centraal.",
                            "target_lang_translations": {
                                "en": "In this ancient temple, the <w>worship</w> of the sun god was central."
                            }
                        }
                    ],
                    "synonyms": [
                        "cultus",
                        "eredienst"
                    ],
                    "common_phrases": [
                        "verering van heiligen"
                    ],
                    "target_lang_definitions": {
