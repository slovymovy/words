                        {
                            "text": "The <w>Went</w> family has lived in this village for generations.",
                            "target_lang_translations": {
                                "ru": "Семья <w>Уэнт</w> живет в этой деревне уже несколько поколений.",
                                "zh": "<w>温特</w>一家世世代代都住在这个村子里。"
                            }
