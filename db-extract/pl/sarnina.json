                                        "sense_id": "b4609849-d044-37b3-b46a-a90b19b64d1e",
                                        "entry_id": "bee52029-686c-316e-a032-a0f3e6afc3c4",
                                        "glosses": [
                                            "The meat of a deer, typically one that had lived in its own natural habitat."
                                        ],
