                        "entry_id": "b7d591c0-090f-3334-93c2-9814cf76df2b",
                        "glosses": [
                            "The quality of being modern or contemporary."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "9c1e33c8-e410-44a8-9f27-87e852894e61",
                                "sense_id": "14f67742-1153-3909-a993-fe112e679e85",
                                "text": "He was impressed by the architecture's modernity."
                            },
                            {
                                "example_id": "9562fefe-b243-4a33-9785-6026b313fed2",
                                "sense_id": "14f67742-1153-3909-a993-fe112e679e85",
                                "text": "While the rolling-stock lacks modernity, the line equipment, with its single catenary suspension, has a surprisingly up-to-date appearance."
                            },
                            {
                                "example_id": "db8380a5-51bf-4107-a789-1d7f865ed45d",
                                "sense_id": "14f67742-1153-3909-a993-fe112e679e85",
                                "text": "There were also particles no one had predicted that just appeared. Five of them […, i]n order of increasing modernity, […] are the neutrino, the pi meson, the antiproton, the quark and the Higgs boson."
                            }
                        ]
                    },
                    {
                        "sense_id": "8cd03dc4-87df-344f-a183-062654dd68e8",
                        "entry_id": "b7d591c0-090f-3334-93c2-9814cf76df2b",
                        "glosses": [
                            "Modern times."
                        ],
                        "tags": [
