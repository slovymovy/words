    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "087ddbe4-48cd-3d36-a27f-911326cf7bdf",
                    "sense_definition": "Groupe de personnes unies par des liens familiaux étroits et une forte solidarité.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "famille",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Toute la famille se réunit le dimanche pour entretenir l'esprit de <w>clan</w>."
                        },
                        {
                            "text": "Les membres de ce <w>clan</w> se soutiennent fidèlement dans les épreuves."
                        }
                    ],
                    "synonyms": [
                        "famille",
                        "tribu"
                    ],
                    "common_phrases": [
                        "esprit de clan"
                    ]
                },
                {
                    "sense_id": "0f2b4846-d3c1-3eb3-bccd-d4dc34bf50a0",
                    "sense_definition": "Groupe d'individus partageant des intérêts ou des opinions communes au sein d'une organisation, souvent opposé à d'autres.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "groupe",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Une véritable guerre de <w>clans</w> divise les membres de ce parti politique."
                        },
                        {
                            "text": "Chaque <w>clan</w> tente de placer ses partisans aux postes stratégiques de l'entreprise."
                        }
                    ],
                    "synonyms": [
                        "coterie",
                        "faction",
                        "clique"
                    ],
                    "common_phrases": [
                        "guerre de clans"
                    ]
                },
                {
                    "sense_id": "33f2b3e7-590f-3f1f-872b-40bf5bb7a390",
                    "sense_definition": "Tribu traditionnelle formée de plusieurs familles se réclamant d'un ancêtre commun, notamment en Écosse.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "tribu",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce château historique appartenait autrefois au plus influent <w>clan</w> des Highlands."
                        },
                        {
                            "text": "Le chef de <w>clan</w> portait les couleurs distinctives de son tartan traditionnel."
                        }
                    ],
                    "synonyms": [
                        "tribu"
                    ],
                    "common_phrases": [
                        "chef de clan"
                    ]
                },
                {
                    "sense_id": "7979edd3-9727-360d-8cb8-f2ac6872632f",
                    "sense_definition": "Équipe ou regroupement de joueurs qui coopèrent régulièrement dans des jeux vidéo en ligne.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "jeu",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mon frère a rejoint un <w>clan</w> très actif pour participer à des tournois en ligne."
                        },
                        {
                            "text": "Les membres du <w>clan</w> s'entraînent ensemble plusieurs soirs par semaine."
                        }
                    ],
                    "synonyms": [
                        "guilde"
                    ]
                }
            ]
        }
    ]
}