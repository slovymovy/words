                    {
                        "translation_id": "b71601e7-21b1-4476-bd70-88424d0c32c8",
                        "source_entry_id": "7a768696-d449-309a-963c-82507158c0ba",
                        "source_sense_id": "819d8648-8b4c-38b1-beb2-9d92d6607aa8",
