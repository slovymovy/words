                        "réellement"
                    ],
                    "common_phrases": [
                        "pas vraiment"
                    ],
                    "target_lang_definitions": {
                        "en": "In accordance with reality or truth; actually or in fact.",
                        "ru": "Соответствует действительности или истине; означает «действительно» или «на самом деле».",
                        "nl": "Zegt dat iets werkelijk zo is, in overeenstemming met de feiten; betekent 'echt' of 'in feite'.",
                        "de": "Entspricht der Wirklichkeit oder der Wahrheit; bedeutet „tatsächlich“ oder „in der Realität“.",
                        "pl": "Zgodnie z rzeczywistością lub prawdą; oznacza „rzeczywiście”, „faktycznie” lub „w istocie”.",
                        "it": "Corrisponde alla realtà o alla verità; significa «in effetti» o «realmente».",
                        "cs": "Vyjadřuje, že něco odpovídá skutečnosti nebo pravdě; znamená skutečně nebo ve skutečnosti.",
                        "tr": "Bir şeyin gerçeğe ya da doğruya uygun olduğunu belirtir; 'aslında' ya da 'gerçekte' anlamına gelir.",
                        "es": "Indica que algo se ajusta a la realidad o a la verdad, con el sentido de efectivamente o en realidad.",
                        "zh": "表示符合事实或真相，即确实、实际上如此。"
                    },
