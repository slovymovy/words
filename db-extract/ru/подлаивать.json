                "senses": [
                    {
                        "sense_id": "e88f7212-f079-34b4-99b6-91961f66a04e",
                        "entry_id": "d67dd661-f56e-32ba-838f-fe3efa8fe390",
                        "glosses": [
                            "вторить лаем"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8bfd0013-e903-4ebf-b4aa-734df3e0aaba",
                                "sense_id": "e88f7212-f079-34b4-99b6-91961f66a04e",
                                "text": "Деревня спала, только всё ещё подлаивали друг другу собаки."
                            }
                        ]
                    },
                    {
                        "sense_id": "9f5b5325-82cb-3483-952b-74a0d50648e2",
                        "entry_id": "d67dd661-f56e-32ba-838f-fe3efa8fe390",
                        "glosses": [
                            "охотн. лаем задерживать зверя или дичь на месте и наводить на неё охотника"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b792c90-9b1c-42ec-b425-7e9264d04aab",
                                "sense_id": "9f5b5325-82cb-3483-952b-74a0d50648e2",
                                "text": "Первой, увлекая за собой свору, бросилась на медведя Белка ― точнее будет сказать, в сторону медведя, ибо шагах в десяти от него она внезапно остановилась и подлаивала сзади."
                            }
                        ]
                    }
                ],
