                    },
                    {
                        "form_id": "84efd6e4-1c0a-44db-a82b-3144d1578699",
                        "entry_id": "8b870cc6-dc06-3d52-88a4-11fb04abd361",
                        "tags": [
                            "positive",
                            "predicative",
                            "plural"
                        ],
                        "form": "sie sind homoaffektiv"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9aad3402-f282-3a23-aa2b-8e19c89ec7c6",
                        "entry_id": "8b870cc6-dc06-3d52-88a4-11fb04abd361",
                        "glosses": [
                            "romantische Neigung zum gleichen Geschlecht habend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "30443e31-d421-4602-a87a-d2ad01d8687a",
                                "sense_id": "9aad3402-f282-3a23-aa2b-8e19c89ec7c6",
                                "text": "„Mit 30 beziehungsweise 40 Fotografien der Teile I und II von „Donde habita la quimera“, dokumentierte sie die Welt aus Sicht von zwei homoaffektiven Familien in Havanna.“"
                            },
                            {
                                "example_id": "e85d5d82-d0fc-423c-a90d-bedbbf703ae4",
                                "sense_id": "9aad3402-f282-3a23-aa2b-8e19c89ec7c6",
                                "text": "„Schließlich wies der Vatikan darauf hin, dass ‚es im geltenden universellen Kirchenrecht nichts gibt, was es einer homoaffektiven und in einer Lebensgemeinschaft lebenden Person verbietet, Zeuge bei einer Hochzeit zu sein‘.“"
                            },
                            {
                                "example_id": "8c7a72d0-ff33-4051-9359-3bcee7435c49",
                                "sense_id": "9aad3402-f282-3a23-aa2b-8e19c89ec7c6",
                                "text": "„Auch wenn die Realität nicht zur homoaffektiven Romanze zwischen ihnen beiträgt, gedeiht die Liebe und durchläuft einige Prüfungen.“"
                            },
                            {
                                "example_id": "6fef625e-8bab-48e4-a85c-86422b7f6f9b",
                                "sense_id": "9aad3402-f282-3a23-aa2b-8e19c89ec7c6",
                                "text": "„Er ist für die Senkung des Strafmündigkeitsalters auf 16 Jahre und gegen homoaffektive Lebensgemeinschaften, die in Brasilien seit 2013 legalisiert sind.“"
                            },
                            {
                                "example_id": "971b0f56-7f23-4a49-9bd2-c243a30561f8",
