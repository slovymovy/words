                                    {
                                        "sense_id": "e05f6c07-98cf-3fed-8f81-0c6bd8c501c8",
                                        "entry_id": "c0ca4f65-b032-3f29-b62d-ba271c2a902d",
                                        "glosses": [
                                            "Handwerker, der im Bereich der Elektronik tätig ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "513aa531-de0c-4ea7-811e-78bec0bbb29e",
                                                "sense_id": "e05f6c07-98cf-3fed-8f81-0c6bd8c501c8",
                                                "text": "Weil eine neue Stromleitung verlegt werden sollte, mussten wir den Elektriker rufen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
