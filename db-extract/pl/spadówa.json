                                    {
                                        "sense_id": "d05cb06d-01a8-3474-907b-2aaecd102492",
                                        "entry_id": "dd521e6f-e2b1-38fc-b0b1-26d5579e6850",
                                        "glosses": [
                                            "To leave with a buzzing sound."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e268124c-3057-4af0-b4c9-60f93216c209",
                                                "sense_id": "d05cb06d-01a8-3474-907b-2aaecd102492",
                                                "text": "The bee was flying around my head, but then it buzzed off."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "016c3bcc-a9a3-33fd-bf3c-4375d277e2f2",
                                        "entry_id": "dd521e6f-e2b1-38fc-b0b1-26d5579e6850",
                                        "glosses": [
                                            "To leave (especially busily), take off, go away."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dbc848f7-6c95-4edc-aae2-b719c16ec0a6",
                                                "sense_id": "016c3bcc-a9a3-33fd-bf3c-4375d277e2f2",
                                                "text": "“Where's Daddy?” Phyllis asked. “He suddenly decided to go to London,” said Bobbie. “To London?” “That's what he said.” “Why?” “He didn't tell me.” “I must go and see him,” said Phyllis, and buzzed off. [...] “He's asking for his dinner, the sweet little angel. All right, darling, Mother's coming,” she fluted, and buzzed off on the errand of mercy. [...] “That's life,” she said, and buzzed off to keep her vigil, leaving me kicking myself because I'd forgotten to say anything about the quality of mercy not being strained."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8de6b388-9ec6-38c9-b3f6-2b22e17d4fdb",
                                        "entry_id": "dd521e6f-e2b1-38fc-b0b1-26d5579e6850",
                                        "glosses": [
                                            "To interrupt and/or disqualify (someone) by means of a buzzer."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bf7de23d-ea8a-43d8-ae2b-91eeb9d43593",
                                                "sense_id": "8de6b388-9ec6-38c9-b3f6-2b22e17d4fdb",
                                                "text": "He went to this talent show, but they buzzed him off after twenty seconds."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
