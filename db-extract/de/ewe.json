                ],
                "senses": [
                    {
                        "sense_id": "75801b5f-7230-363b-9649-09df20125aac",
                        "entry_id": "f3b3c397-ff9e-331a-973f-5e3cf22f86b4",
                        "glosses": [
                            "eine Niger-Kongo-Sprache (genauer: Kwa-Sprache), die in Ghana und Togo vom gleichnamigen Volk gesprochen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "345594a1-0a97-43e9-8742-a8bbcd9e3a02",
                                "sense_id": "75801b5f-7230-363b-9649-09df20125aac",
                                "text": "„Für die Herausbildung einer Literatursprache des Ewe war das Gebiet von Keta und Waya von Bedeutung.“"
                            },
                            {
                                "example_id": "5141671b-c8ef-4798-9238-868e88254f76",
                                "sense_id": "75801b5f-7230-363b-9649-09df20125aac",
                                "text": "„Der Begriff \"Voodoo\" kommt aus der westafrikanischen Sprache Ewe und bedeutet ursprünglich \"Schutzgeist\"“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9b53823e-343e-41ed-a5ba-d6d8b0f65504",
                        "source_entry_id": "f3b3c397-ff9e-331a-973f-5e3cf22f86b4",
                        "source_sense_id": "75801b5f-7230-363b-9649-09df20125aac",
                        "target_lang_word": "Ewe",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ewe",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "919245f5-dd24-3b4f-bafe-a7fb7e2827ae",
                                        "entry_id": "10584dc7-e030-39d5-82c4-4961b3d9701b",
                                        "glosses": [
                                            "An ethnic group who inhabit southeastern Ghana, Togo, and Benin."
                                        ],
                                        "tags": [
                                            "plural",
                                            "singular"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "67edb80d-e6f5-4eb2-828b-798c02fb38a6",
                                                "sense_id": "919245f5-dd24-3b4f-bafe-a7fb7e2827ae",
                                                "text": "Most Ewes are farmers or fishermen, although a growing number are urban dwellers living in Accra, Lomé, and other cities. The Ewes are a patrilineal people, with inheritance passing from father to son."
                                            },
                                            {
                                                "example_id": "d526bc14-4191-46be-be36-e49c090963e9",
                                                "sense_id": "919245f5-dd24-3b4f-bafe-a7fb7e2827ae",
                                                "text": "A person from Ho, like all Ewes, attaches great importance to a friendly greeting."
                                            },
                                            {
                                                "example_id": "f4d781ca-b6fc-4e53-8d02-0688074c6516",
                                                "sense_id": "919245f5-dd24-3b4f-bafe-a7fb7e2827ae",
                                                "text": "Among the Ewes, and equally among other language and ethnic groups in Ghana, names form an integral part of people’s identity."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
