                "senses": [
                    {
                        "sense_id": "7905e850-7d1b-3b53-84a1-2ef94f039a26",
                        "entry_id": "ac82f2d7-f6f1-3e96-8007-69d24744cef1",
                        "glosses": [
                            "im Abfall oder Müll enthaltener Altstoff, der als Rohstoff erneut verwendet werden sollte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc71b045-fc00-443a-940e-d5773d953c10",
                                "sense_id": "7905e850-7d1b-3b53-84a1-2ef94f039a26",
                                "text": "Da Deutschland selbst über keinerlei echte Rohstoffe verfügt, außer Braunkohle vielleicht, ist es darauf angewiesen, aus den importierten und bereits in Produkten verwendeten echten Rohstoffen, über das Recycling, Wertstoffe zu gewinnen und dem Markt erneut als Rohstoff zur Verfügung zustellen."
                            },
                            {
                                "example_id": "dbc065de-811f-41a4-b7dd-bc7b52d32830",
                                "sense_id": "7905e850-7d1b-3b53-84a1-2ef94f039a26",
                                "text": "„Wenn Sie uns Ihre Wertstoffe bringen, leisten Sie einen wichtigen Beitrag zum Umwelt- und Ressourcenschutz.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
