                                            {
                                                "example_id": "b8b2ad54-c6be-4640-a339-34f4cef0985b",
                                                "sense_id": "ee707b9a-7b73-3380-8727-966240cbeb2d",
                                                "text": "Karsten Warholm s’est nettement imposé en 47 sec 12 devant Wilfried Happio (48.56) et le Turc Yasmani Copello (48.78), qui a privé le Français Ludvy Vaillant de la médaille de bronze pour un centième de seconde (4ᵉ en 48.79)."
                                            },
                                            {
                                                "example_id": "5e95e530-c506-4398-afac-a57d3e91cbab",
                                                "sense_id": "ee707b9a-7b73-3380-8727-966240cbeb2d",
                                                "text": "« On ne promet à personne l’argent facile ou la richesse, c’est uniquement le fruit d’efforts personnels », prévient Wilfried Rivière, fondateur d’Emrys, une coopérative de consommateurs qu’il qualifie de « sociale et solidaire »."
                                            }
                                        ]
