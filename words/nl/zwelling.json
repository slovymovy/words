                    "frequency": "Low",
                    "semantic_group_id": "proces",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>zwelling</w> van de rivier zorgde voor overstromingen in het gebied.",
                            "target_lang_translations": {
                                "en": "The <w>swelling</w> of the river caused flooding in the area."
                            }
                        },
                        {
                            "text": "Door de snelle <w>zwelling</w> van de knopjes konden we zien dat de lente was begonnen.",
                            "target_lang_translations": {
