                "senses": [
                    {
                        "sense_id": "9515da66-052a-305e-b3f4-ba7c25b4b4c0",
                        "entry_id": "cc8923de-070d-39e1-be90-24d70484a2fa",
                        "glosses": [
                            "oorspronkelijk Valenciaans en tegenwoordig typisch Spaans gerecht en bevat, afhankelijk van de regio, als hoofdingrediënten: rijst, zeevruchten als vis en schaaldieren, stukjes kip, konijn, tomatenbasis (tomate frito), garrofónes (speciaal soort witte bonen uit Valencia), snijbonen en saffraan"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e9f4c9b-97cd-4512-8cb0-f2a994d9ade7",
                                "sense_id": "9515da66-052a-305e-b3f4-ba7c25b4b4c0",
                                "text": "Paella is een typisch gerecht uit de Spaanse keuken. Deze paella met kip is binnen 30 minuten gemaakt en smaakt heerlijk!"
                            },
                            {
                                "example_id": "a55f3089-3c31-4658-8f8f-6ad05048f7f4",
                                "sense_id": "9515da66-052a-305e-b3f4-ba7c25b4b4c0",
                                "text": "Patrick Kluivert krijgt de lach niet meer van zijn gezicht nu hij met zijn familie en een pan paella op het water van Menorca geniet van zijn vakantie."
                            },
                            {
                                "example_id": "81e9330b-314b-4bbf-b450-81d605971c29",
                                "sense_id": "9515da66-052a-305e-b3f4-ba7c25b4b4c0",
                                "text": "Meer dan een prima paella: Afgelopen maand hielden we een kleine culinaire Vuelta hier in dit hoekje van de krant. We eindigen vandaag in Valencia, en u mag drie keer raden wat er op het menu staat. Olé! Het verschil tussen een prima paella en een paella waarvan je smaakpapillen spontaan een sprongetje maken zit hem in de details."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "85c89394-cfb1-4ecc-bdfe-f0516dff0ea1",
                        "source_entry_id": "cc8923de-070d-39e1-be90-24d70484a2fa",
                        "source_sense_id": "9515da66-052a-305e-b3f4-ba7c25b4b4c0",
