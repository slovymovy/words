                        "target_lang_word": "per così dire",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "88b71a44-43ea-4f66-8eed-fcfbc5e92403",
                        "source_entry_id": "276110db-77dc-305c-81ad-4e8480478b6d",
                        "source_sense_id": "2da66d4b-13ad-3a7e-9bab-8cdd3ce04f3a",
                        "source_sense_description": "im übertragenen Sinn, in nicht genauem oder nicht wörtlichem Sinn",
                        "target_lang_word": "in un certo senso",
