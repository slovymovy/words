                    }
                ],
                "senses": [
                    {
                        "sense_id": "aaaad8fe-da24-3f92-898f-e35a19686d4e",
                        "entry_id": "aea8bd87-f4c8-337b-971b-3140941aadbe",
                        "glosses": [
                            "Nom normalisé donné à cinq genres différents de la famille des falconidés comprenant onze espèces de rapaces diurnes exclusifs à l'écozone néotropicale et différant des faucons par leur région faciale et le haut de leur gorge qui sont dénudés et exposent une peau de rose à rouge vif, par leur vol plus lent et leurs ailes moins effilées, leur diète plus omnivore (au lieu de principalement carnivore), incluant la charogne et, souvent, un pourcentage appréciable d'arthropodes, et dont certaines espèces nichent aussi au nord que le sud des États-Unis d'Amérique et l'extrémité sud de la Terre de Feu (genres Caracara, Daptrius, Ibycter, Milvago, Phalcobaenus)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e8f6405-b176-4fb0-a0fa-8469b82e4a78",
                                "sense_id": "aaaad8fe-da24-3f92-898f-e35a19686d4e",
                                "text": "Tout cela présidé par le cri incessant du caracara, mon faucon terrestre qui n'a jamais volé mais qui, rampant sur le sol, dévore les immondices, régénérant la vie."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d5dc0baa-38a8-453d-a666-38d5088db04c",
                        "source_entry_id": "aea8bd87-f4c8-337b-971b-3140941aadbe",
                        "source_sense_id": "aaaad8fe-da24-3f92-898f-e35a19686d4e",
                        "target_lang_word": "caracara",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "caracara",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "df3fcfa5-b208-3efe-88dc-15c3990fa0f3",
                                        "entry_id": "8995e8b1-0f72-3fc2-8abc-39aeaeefbe8b",
                                        "glosses": [
                                            "Any of several South American and Central American birds of prey in the subfamily Caracarinae."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "676edd59-e115-46a6-974c-9b46831f9cc3",
                                                "sense_id": "df3fcfa5-b208-3efe-88dc-15c3990fa0f3",
                                                "text": "The caracara's flight is direct and rapid, not at all like that of the vulture, which sails and soars in spirals."
                                            },
                                            {
                                                "example_id": "50e71deb-7150-4113-9998-5d1a87b87b10",
                                                "sense_id": "df3fcfa5-b208-3efe-88dc-15c3990fa0f3",
                                                "text": "A few still live on the remote coasts of Tierra del Fuego, and though warrahs and gauchos vanished from the Falklands soon after Darwin's visit, striated caracaras still cling to life on the archipelago's outer islands, where they hunt and scavenge in colonies of penguins, seals, and albatrosses."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
