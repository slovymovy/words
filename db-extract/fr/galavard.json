                        "examples": [
                            {
                                "example_id": "e5fe6d62-a565-4aaa-8b74-1fc6e1a7e5f3",
                                "sense_id": "6e39d2f4-5239-3e4e-85b5-790b8aa81d56",
                                "text": "Il s’installe là, à la garçonnière, avec deux galavards des Pennes, de la mangeaille, et deux basses putes pour remplacer sa femme."
                            },
                            {
                                "example_id": "af541908-1f3a-48d3-b14c-dd277180cfba",
                                "sense_id": "6e39d2f4-5239-3e4e-85b5-790b8aa81d56",
                                "text": "Nous passâmes un après-midi assez dolent, au coin du feu, tandis que le petit Paul, que son hypersomnie avait préservé de nos excès, grignotait les derniers marrons glacés, et se moquait de nous, en nous appelant « galavards »."
                            }
                        ]
                    }
