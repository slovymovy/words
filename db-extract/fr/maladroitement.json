                                                "sense_id": "679dd73d-d023-3752-a382-c14bde601981",
                                                "text": "Er ist sehr ungeschickt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "abeee8ea-72e5-4ef6-a940-fbe25692cf58",
                        "source_entry_id": "29b93eff-4988-3be1-9bb4-75c80c18603f",
