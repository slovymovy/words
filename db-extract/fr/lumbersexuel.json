                "senses": [
                    {
                        "sense_id": "5b81d222-bfa5-38ba-bfac-1d3074a263e4",
                        "entry_id": "40d6ba91-55f9-36ee-90a8-f08d7d28f7aa",
                        "glosses": [
                            "Homme qui, pour se faire regarder, se donne un aspect de caricature de bûcheron canadien."
                        ],
                        "tags": [
                            "neologism"
                        ],
                        "examples": [
                            {
                                "example_id": "980fe086-0053-45ac-929c-0138ce96b0d7",
                                "sense_id": "5b81d222-bfa5-38ba-bfac-1d3074a263e4",
                                "text": "Fébrile, je cesse de tapoter mon carnet de notes pour noter à la va-vite mon idée : ce type énorme, avec sa barbe fournie et sa chemise à carreaux pourrait jouer les « lumbersexuels » dans les magazines féminins, […]."
                            },
                            {
                                "example_id": "6dd8e08a-1950-4c4f-9314-3357fa6a86ac",
                                "sense_id": "5b81d222-bfa5-38ba-bfac-1d3074a263e4",
                                "text": "Car le lumbersexuel ne passe pas ses semaines à découper du bois en s’épongeant le front avec sa chemise à carreaux roulée en boule. Il ne fait qu’emprunter l’esthétique du bûcheron, du randonneur, bref du mec abonné à la newsletter de Décathlon."
                            }
                        ]
                    }
