        "fr-extract.jsonl": [
            {
                "entry_id": "3d7c6d21-f220-392a-9552-81cd221650df",
                "word": "kif",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "167a4b98-b0ab-353e-b837-530ac0cecd76",
                        "entry_id": "3d7c6d21-f220-392a-9552-81cd221650df",
                        "glosses": [
                            "Forme courte de kif-kif."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5147a22b-9816-418a-b398-57bdc873635c",
                                "sense_id": "167a4b98-b0ab-353e-b837-530ac0cecd76",
                                "text": "Français ou Anglais, les lardons c’est tout du kif comme vermine."
                            },
                            {
                                "example_id": "6f5d080b-f826-4254-b7bf-7524f9e8686d",
                                "sense_id": "167a4b98-b0ab-353e-b837-530ac0cecd76",
                                "text": "C’est comme à la bataille navale : c’est en pilonnant que tu finis par atteindre la cible. Pour toucher ton torpilleur, il faut en balancer, en balancer de la camelote. La vie, c’est du kif : tu finis par te la faire en la pilonnant de ta tendresse."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "91dd8b65-1632-3719-b4ed-5b19775ab05a",
                "word": "kif",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "51403ce0-7944-408a-ba44-96d52e6660ef",
                        "entry_id": "91dd8b65-1632-3719-b4ed-5b19775ab05a",
                        "tags": [
                            "plural"
                        ],
                        "form": "kifs"
                    },
                    {
                        "form_id": "b9adc345-6454-4753-832f-aec861c8caff",
                        "entry_id": "91dd8b65-1632-3719-b4ed-5b19775ab05a",
                        "tags": [],
                        "form": "kiff"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "33116f7a-e6c4-3ee3-92c3-78892aa4d702",
                        "entry_id": "91dd8b65-1632-3719-b4ed-5b19775ab05a",
                        "glosses": [
                            "Mélange de sommités de fleurs femelles séchées de chanvre indien et de tabac gris finement haché en Algérie et au Maroc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b96a573b-8836-456e-8f07-c3058c74b3f8",
                                "sense_id": "33116f7a-e6c4-3ee3-92c3-78892aa4d702",
                                "text": "Hama Srir, à demi couché près de moi, tira son matoui (petit sac en filali pour le kif) et sa petite pipe. […]. Nous commençâmes à fumer."
                            },
                            {
                                "example_id": "9e51208d-da4b-4b16-bdcf-81afcff4b854",
                                "sense_id": "33116f7a-e6c4-3ee3-92c3-78892aa4d702",
                                "text": "Appartenant à la grande confrérie des conteurs et chanteurs errants, ce troubadour marocain ne possède pour toute fortune qu’un âne famélique, un vieux haïk en lambeaux, une pipe et une blague à kif et un petit instrument primitif à deux cordes, un gimbri, attribut de son état."
                            },
                            {
                                "example_id": "998b0242-e1ce-4c93-b0ef-abac194293bb",
                                "sense_id": "33116f7a-e6c4-3ee3-92c3-78892aa4d702",
                                "text": "Tout le monde fumait : du kif, du tabac, la pipe, le cigare et des herbes que je n’ai jamais pu définir."
                            },
                            {
                                "example_id": "fa2c0c58-ebee-4916-8510-11242ac77b96",
                                "sense_id": "33116f7a-e6c4-3ee3-92c3-78892aa4d702",
                                "text": "Outre la création d’emplois, le ministère de l’Intérieur estime que les revenus d’exportation générés par le marché licite du kif oscilleraient entre 4,2 et 6,3 milliards de dollars à l’horizon 2028."
                            }
                        ]
                    },
                    {
                        "sense_id": "3d997bfe-96c8-30b5-af1f-245dd6eb4403",
                        "entry_id": "91dd8b65-1632-3719-b4ed-5b19775ab05a",
                        "glosses": [
                            "Sensation de plaisir, voire d’extase."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "fa4711e3-4372-4c12-914f-164b2aac8e10",
                                "sense_id": "3d997bfe-96c8-30b5-af1f-245dd6eb4403",
                                "text": "Qu’allions-nous trouver là-haut ? On changeait de planète, et ça c’était un kif."
                            },
                            {
                                "example_id": "28be647c-9725-4255-a9b2-9281012cf29e",
                                "sense_id": "3d997bfe-96c8-30b5-af1f-245dd6eb4403",
                                "text": "Craquer pour une armoire, quelques dentelles ou un livre, mais aussi pour un kif au chocolat, une tarte à la noix ou à l’orange, tout est possible à cette délicate adresse."
                            },
                            {
                                "example_id": "5ed56b95-c228-4c29-a8b6-bc27a5525843",
                                "sense_id": "3d997bfe-96c8-30b5-af1f-245dd6eb4403",
                                "text": "Compliqué, en revanche, d’accepter une personne « dont le kif serait de partir faire des tours en 4x4. On aurait du mal à s’entendre »."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6d58ebcf-d6a8-4b15-a294-003884195097",
                        "source_entry_id": "91dd8b65-1632-3719-b4ed-5b19775ab05a",
                        "source_sense_description": "mélanges de cannabis et de tabac",
                        "target_lang_word": "kif",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kif",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "67a816f9-9305-30b5-aa75-83febe7418ed",
                                        "entry_id": "958b381c-a730-3847-858e-699e2e561eb9",
                                        "glosses": [
                                            "A kind of cannabis smoked in Morocco and Algeria, for narcotic or intoxicating effect."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9fb87f33-0ff0-43f0-886a-330f035e4f66",
                                                "sense_id": "67a816f9-9305-30b5-aa75-83febe7418ed",
                                                "text": "‘Some taxi driver, a Maghrebian…he suddenly swerved. They smoke kief, you know.’"
                                            },
                                            {
                                                "example_id": "fbb53db5-3584-4764-abeb-ffe4b7de3c6f",
                                                "sense_id": "67a816f9-9305-30b5-aa75-83febe7418ed",
                                                "text": "The kief, which is the flower and seeds of the plant, is the strongest, and a pipe of it half the size of a common English tobacco-pipe, is sufficient to intoxicate."
                                            },
                                            {
                                                "example_id": "fab19cf6-9952-4a0a-89f5-937947d32068",
                                                "sense_id": "67a816f9-9305-30b5-aa75-83febe7418ed",
                                                "text": "I perceived the odour of kif, and recognised the voices of Selam the Second, Abd-el-Rhaman, and others; it was an Arab orgie in full swing."
                                            },
                                            {
                                                "example_id": "9a5b2583-277f-4318-8146-187377285957",
                                                "sense_id": "67a816f9-9305-30b5-aa75-83febe7418ed",
                                                "text": "The trade goods – Persian rugs, salt, muskets, kif – trailed out behind them over the dunes, still lashed to the backs of rotting animals."
                                            },
                                            {
                                                "example_id": "fb37e499-56f0-4258-b465-8a09863f11b1",
                                                "sense_id": "67a816f9-9305-30b5-aa75-83febe7418ed",
                                                "text": "[…]then hung around the special Silver-Key-Members’ Lounge with the other ladies[…]smoking kif and making extremely delicate and oblique fun of their husbands’ sexual idiosyncrasies, […]"
                                            },
                                            {
                                                "example_id": "17e04401-a862-4a03-9cf4-10a30412e1cc",
                                                "sense_id": "67a816f9-9305-30b5-aa75-83febe7418ed",
                                                "text": "Kif melts the brain; dexemyl sharpens the edges. (Kif makes you drift—makes you forget what someone said a minute before–hard to follow a long story or joke, […])"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ca84c98f-63d3-3e37-831c-b032ffa44c05",
                                        "entry_id": "958b381c-a730-3847-858e-699e2e561eb9",
                                        "glosses": [
                                            "The state of relaxed stupor induced by cannabis."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "30c45ea0-b8e9-3c88-b498-843043c67248",
                                        "entry_id": "958b381c-a730-3847-858e-699e2e561eb9",
                                        "glosses": [
                                            "The trichome of marijuana, a green powdery substance that falls from dry marijuana, high in THC and other cannabinoid compounds."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "kif",
                                "target_lang_code": "en",
                                "target_senses": [
