                "senses": [
                    {
                        "sense_id": "5735f87c-9e15-39f2-851a-84daa1b629d5",
                        "entry_id": "a136d370-e099-38c8-834d-2566cd27fe48",
                        "glosses": [
                            "statek kosmiczny zdolny do wielokrotnego startu i powrotu na Ziemię"
                        ],
                        "tags": [],
