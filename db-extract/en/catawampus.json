                "senses": [
                    {
                        "sense_id": "e07d9db5-13d0-3fd2-a1a8-f802dc9588d9",
                        "entry_id": "ca7346d1-2e9e-32fe-94bc-53c74a0bb9b1",
                        "glosses": [
                            "Out of alignment, in disarray or disorder: crooked, askew."
                        ],
                        "tags": [
                            "US"
                        ],
                        "examples": [
                            {
                                "example_id": "a0c2dd5a-9971-4b37-85cc-a675f6972c84",
                                "sense_id": "e07d9db5-13d0-3fd2-a1a8-f802dc9588d9",
                                "text": "\"Waal, I noticed ez the aidge o' one o' them boards war sot sorter catawampus, ...\"."
                            },
                            {
                                "example_id": "a94ecb18-96ea-4137-b935-17f68b98d977",
                                "sense_id": "e07d9db5-13d0-3fd2-a1a8-f802dc9588d9",
                                "text": "\"Remember when Justin missed the T in the software code and tanked the reports for the client. What a catawampus that was.\"."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8f2732c4-0c7a-498a-ad11-fb0f988a4a88",
                        "source_entry_id": "ca7346d1-2e9e-32fe-94bc-53c74a0bb9b1",
                        "source_sense_id": "e07d9db5-13d0-3fd2-a1a8-f802dc9588d9",
                        "source_sense_description": "out of alignment, crooked, cater-corner",
                        "target_lang_word": "kreuz und quer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kreuz und quer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fc5f518c-1ba0-31ad-bef9-e483697005c3",
                                        "entry_id": "634d51c5-3a60-3625-ad28-461c1df7482b",
                                        "glosses": [
                                            "durcheinander, ohne feste Richtung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a462cd9-bac4-4e11-86cb-4d85c3c4c493",
                                                "sense_id": "fc5f518c-1ba0-31ad-bef9-e483697005c3",
                                                "text": "Die Menschen rannten panisch kreuz und quer durch die Straßen."
                                            },
                                            {
                                                "example_id": "8707925c-73d4-431e-b212-5efe6947f254",
                                                "sense_id": "fc5f518c-1ba0-31ad-bef9-e483697005c3",
                                                "text": "Die Unterlagen lagen kreuz und quer über den Boden verteilt."
                                            },
                                            {
                                                "example_id": "6f507516-ceb7-4236-a701-275725b585b0",
                                                "sense_id": "fc5f518c-1ba0-31ad-bef9-e483697005c3",
                                                "text": "„Das Dach ist eingestürzt, die schweren Balken liegen kreuz und quer, aber an den Wänden erkennt man noch die Kacheln, wo die Käse- oder die Fleischtheke war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
