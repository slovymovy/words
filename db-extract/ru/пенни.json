                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "21d395e5-5da4-33bc-9706-f489f8831d63",
                        "entry_id": "1b46dd62-2919-3b8c-b6b4-04951b6946b5",
                        "glosses": [
                            "истор. разменная монета Финляндии, равная одной сотой финской марки (до введения евро)"
                        ],
                        "tags": [],
