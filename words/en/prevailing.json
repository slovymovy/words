    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "09a2efb4-4e43-3d2d-9915-a81e92f5d2ef",
                    "sense_definition": "Existing or happening very commonly or in most places at a particular time.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "commonality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>prevailing</w> winds in this coastal region usually blow from the west during the winter months.",
                            "target_lang_translations": {
                                "ru": "<w>Преобладающие</w> ветры в этом прибрежном регионе обычно дуют с запада в зимние месяцы."
                            }
                        },
                        {
                            "text": "Under the <w>prevailing</w> conditions, it is difficult for small businesses to remain profitable without government support.",
                            "target_lang_translations": {
                                "ru": "В <w>сложившихся</w> условиях малому бизнесу трудно оставаться прибыльным без государственной поддержки."
                            }
                        }
                    ],
                    "synonyms": [
                        "pervasive",
                        "ubiquitous",
                        "widespread"
                    ],
                    "antonyms": [
                        "rare",
                        "uncommon",
                        "exceptional"
                    ],
                    "common_phrases": [
                        "prevailing winds",
                        "prevailing conditions",
                        "prevailing prices"
                    ],
                    "target_lang_definitions": {
                        "ru": "Существующий или происходящий повсеместно или в большинстве мест в определенное время."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "преобладающий",
                                "target_lang_sense_clarification": "наиболее распространенный в данный момент"
                            },
                            {
                                "target_lang_word": "господствующий",
                                "target_lang_sense_clarification": "о ветрах или условиях"
                            },
                            {
                                "target_lang_word": "сложившийся",
                                "target_lang_sense_clarification": "о текущей ситуации или условиях"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c92ff730-e5c0-3d15-a60f-5ffe067061e1",
                    "sense_definition": "Having the most influence or being the most frequent among several ideas or opinions.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "dominance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>prevailing</w> opinion among the board members was that the company needed a complete rebranding.",
                            "target_lang_translations": {
                                "ru": "<w>Преобладающим</w> мнением среди членов совета директоров было то, что компании необходим полный ребрендинг."
                            }
                        },
                        {
                            "text": "Despite several objections, the <w>prevailing</w> view remained that the project should proceed as scheduled.",
                            "target_lang_translations": {
                                "ru": "Несмотря на несколько возражений, <w>общепринятым</w> мнением осталось то, что проект должен продолжаться согласно графику."
                            }
                        }
                    ],
                    "synonyms": [
                        "widespread"
                    ],
                    "antonyms": [
                        "minority",
                        "unpopular"
                    ],
                    "common_phrases": [
                        "prevailing opinion",
                        "prevailing view",
                        "prevailing attitude"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий наибольшее влияние или являющийся наиболее частым среди нескольких идей или мнений."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "преобладающий",
                                "target_lang_sense_clarification": "о мнении или взглядах"
                            },
                            {
                                "target_lang_word": "общепринятый",
                                "target_lang_sense_clarification": "разделяемый большинством"
                            },
                            {
                                "target_lang_word": "доминирующий",
                                "target_lang_sense_clarification": "оказывающий наибольшее влияние"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1932ffba-3f42-3c8a-bb14-32aafa4a25a9",
                    "sense_definition": "The present participle and gerund of <w>prevail</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "By <w>prevailing</w> over his opponents in the final round, he secured the championship title.",
                            "target_lang_translations": {
                                "ru": "<w>Одержав верх</w> над своими противниками в финальном раунде, он обеспечил себе чемпионский титул."
                            }
                        },
                        {
                            "text": "The truth is finally <w>prevailing</w> after months of confusion and misinformation.",
                            "target_lang_translations": {
                                "ru": "Истина наконец-то <w>торжествует</w> после месяцев неразберихи и дезинформации."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle and gerund"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени и герундий от глагола prevail (одерживать верх, возобладать)."
                    },
