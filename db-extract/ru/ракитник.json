                            {
                                "target_word": "broom",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5a3fed4c-db9c-3df4-8a93-6004ff93f945",
                                        "entry_id": "c444861e-27ed-30e1-ba8a-5bea20384b8e",
                                        "glosses": [
                                            "A domestic utensil with fibers bound together at the end of a long handle, used for sweeping."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1ac983d1-0ebf-4658-adc1-e30e6c0a4e4c",
                                                "sense_id": "5a3fed4c-db9c-3df4-8a93-6004ff93f945",
                                                "text": "Meronyms: broomstick (handle), bavin (head)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c86f1496-5100-36f0-a8d8-dd2b475d3845",
                                        "entry_id": "c444861e-27ed-30e1-ba8a-5bea20384b8e",
                                        "glosses": [
                                            "An implement with which players sweep the ice to make a stone travel further and curl less; a sweeper."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0824c721-c8b1-3233-841c-b513f35cf8e7",
                                        "entry_id": "c444861e-27ed-30e1-ba8a-5bea20384b8e",
                                        "glosses": [
                                            "Any of several yellow-flowered shrubs of the family Fabaceae, with long, stiff, thin branches and small or few leaves used for the domestic utensil."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bf997ef5-fa39-4c74-a324-62943f58672c",
                                                "sense_id": "0824c721-c8b1-3233-841c-b513f35cf8e7",
                                                "text": "At the same time, the encroachment of vegetation proceeds apace, and broom and brambles have already made portions of the line impassable, even on foot."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3a0169da-2dc9-3f42-b93f-45ce3898fefa",
                                        "entry_id": "c444861e-27ed-30e1-ba8a-5bea20384b8e",
                                        "glosses": [
                                            "Any of several yellow-flowered shrubs of the family Fabaceae, with long, stiff, thin branches and small or few leaves used for the domestic utensil.",
                                            "Especially, of the tribe Genisteae, including genera Cytisus, Genista, and Spartium."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "076266dd-b18d-46a0-b4dd-a5f137e6594e",
                                                "sense_id": "3a0169da-2dc9-3f42-b93f-45ce3898fefa",
                                                "text": "[…] and thy broom groves,\nWhose shadow the dismissed bachelor loves,\nBeing lass-lorn […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5cc9d7b1-4395-39ad-83a5-bc2734a297b6",
                                        "entry_id": "c444861e-27ed-30e1-ba8a-5bea20384b8e",
                                        "glosses": [
                                            "Any of several yellow-flowered shrubs of the family Fabaceae, with long, stiff, thin branches and small or few leaves used for the domestic utensil.",
                                            "Of plants not closely related to those of tribe Genisteae."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "863888e4-cbf1-3976-a0fb-2523b8708f03",
                                        "entry_id": "c444861e-27ed-30e1-ba8a-5bea20384b8e",
                                        "glosses": [
                                            "A firearm; especially, a shotgun."
                                        ],
                                        "tags": [
                                            "countable",
                                            "rare",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ce226c34-ee5d-4a8a-9892-e7eadce4f91b",
                                                "sense_id": "863888e4-cbf1-3976-a0fb-2523b8708f03",
                                                "text": "Back that strap then blaze, fry man\nTell bro “make sure you twos that yute”\nRise that stick when the street needs cleaning\nThe pigs know this ain't no average broom"
                                            },
                                            {
                                                "example_id": "a642a284-2947-4f7f-bb7c-0e842892ac31",
                                                "sense_id": "863888e4-cbf1-3976-a0fb-2523b8708f03",
                                                "text": "So keep talking all that fly shit, and I’ma grab the tool\nAnd the lead will get stuck in your head like a catchy tune\nSoon as I look down on a target, bitch, your ass is doomed\nTrust exercise with Ahdi, arms out to catch a boom\nYou see this sweeper I got, it ain’t your average broom\nThis ring will wet this bitch like a happy groom"
                                            },
                                            {
                                                "example_id": "af5ff516-ea8b-49f8-aa6e-e2e0735daed8",
                                                "sense_id": "863888e4-cbf1-3976-a0fb-2523b8708f03",
                                                "text": "I just got the drop, there is an opp\nOFB step with the broom"
                                            },
                                            {
                                                "example_id": "aada3616-e9ad-481f-a42f-16b18b20a5e6",
                                                "sense_id": "863888e4-cbf1-3976-a0fb-2523b8708f03",
                                                "text": "He got forced to hold that broom, that dickhead reminds me of Cinderella"
                                            },
                                            {
                                                "example_id": "c408f024-1fb0-4799-a024-24aecc073e07",
                                                "sense_id": "863888e4-cbf1-3976-a0fb-2523b8708f03",
                                                "text": "Pull up to the 🎵 get whacked with the broom\nTT liz on my line, so you know it got moved\nDistribute, click, click, shoot\nThat's another face on frontline news"
                                            },
                                            {
                                                "example_id": "1bc607fe-6e9b-4de9-8701-9b267ea6e89b",
                                                "sense_id": "863888e4-cbf1-3976-a0fb-2523b8708f03",
                                                "text": "If F’s in the room\nstep with the broom\nfinna here a boom with a boom!"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "broom",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1c06d5f3-82d5-361f-91c9-55e7855b7321",
                                        "entry_id": "b2ceba15-ca74-35e4-bf4a-ab9709a537d6",
                                        "glosses": [
                                            "To sweep with a broom."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "59b26360-d5a5-4eef-a544-1047c70e46b9",
                                                "sense_id": "1c06d5f3-82d5-361f-91c9-55e7855b7321",
                                                "text": "[…] Sidi, I was busy in the exercise of my functions, occupied in brooming the front of the stables, when who should come but Hhamed Ould Denéï on horseback, at full gallop, as if he were going to break his neck. […]"
                                            },
                                            {
                                                "example_id": "07d1b648-d1e0-44a6-87ba-77e526b372d6",
                                                "sense_id": "1c06d5f3-82d5-361f-91c9-55e7855b7321",
                                                "text": "It was but this morning at eight, when poor Molly, was brooming the steps, and the baker paying her by no means unmerited compliments, that my landlady came whirling out of the ground-floor front, and sent the poor girl whimpering into the kitchen."
                                            },
                                            {
                                                "example_id": "7685530c-d76d-47a4-9c15-df82ddfc826a",
                                                "sense_id": "1c06d5f3-82d5-361f-91c9-55e7855b7321",
                                                "text": "After that I did take the broom from its place, and I gave the floor a good brooming. I broomed the boards up and down and cross-ways. There was not a speck of dirt on them left."
                                            },
                                            {
                                                "example_id": "17fbeeb1-c62f-422c-9458-5c4538e156a0",
                                                "sense_id": "1c06d5f3-82d5-361f-91c9-55e7855b7321",
                                                "text": "We broomed the dirt floor clean with spruce branches, brought our gear inside, and moved in."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d6d6df49-92b6-3cd7-b9f7-49c02fc73cda",
                                        "entry_id": "b2ceba15-ca74-35e4-bf4a-ab9709a537d6",
                                        "glosses": [
                                            "To improve the embedding of a membrane by using a broom or squeegee to smooth it out and ensure contact with the adhesive under the membrane."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "15f1f81d-7ea2-3734-a450-18f1da8d8955",
                                        "entry_id": "b2ceba15-ca74-35e4-bf4a-ab9709a537d6",
                                        "glosses": [
                                            "To get rid of someone, like firing an employee or breaking up with a girlfriend, to sweep another out of one's life."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "31b17d18-e654-44e3-8219-8e2c3b274cc3",
                                                "sense_id": "15f1f81d-7ea2-3734-a450-18f1da8d8955",
                                                "text": "April 2002 Willem Dafoe as Norman Osborn, speaking to his son Harry, in the film \"Spider-Man\"\nA word to the \"not-so-wise\" about your girlfriend. Do what you need to with her, then broom her fast."
                                            },
                                            {
                                                "example_id": "6f916148-2e38-4fa5-9366-41aef9cc9bbc",
                                                "sense_id": "15f1f81d-7ea2-3734-a450-18f1da8d8955",
                                                "text": "let the employee leave on his own, or the boss must broom him. If you hire, or inherit, able people, and you groom them, you won't have to broom them. Groom, broom, and watch your company zoom."
                                            },
                                            {
                                                "example_id": "96b34915-1a3e-48a7-9e44-3a1c785aeec0",
                                                "sense_id": "15f1f81d-7ea2-3734-a450-18f1da8d8955",
                                                "text": "I still was going to go with Breslin until one day he said to me, \"I got a confession to make to you. When my mother died on her deathbed I promised her I'd never drive a car and I still don't know how to drive a car.\" I figured for this picture you have to drive a car, so I just decided to broom him and go with an actor."
                                            }
                                        ]
                                    }
                                ]
                            },
