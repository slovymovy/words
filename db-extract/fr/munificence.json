        "fr-extract.jsonl": [
            {
                "entry_id": "20338ab0-3d54-3daf-bf3e-31af576cb9fe",
                "word": "munificence",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "be3537e5-1670-41c0-844c-1aad47ed3fcf",
                        "entry_id": "20338ab0-3d54-3daf-bf3e-31af576cb9fe",
                        "tags": [
                            "plural"
                        ],
                        "form": "munificences"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "216dc9ec-71a4-3a2c-9501-3acf37a4a14b",
                        "entry_id": "20338ab0-3d54-3daf-bf3e-31af576cb9fe",
                        "glosses": [
                            "Disposition qui porte à faire de grandes libéralités."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b9a5c20d-72b9-4a8c-a1fc-b101bf10ea95",
                                "sense_id": "216dc9ec-71a4-3a2c-9501-3acf37a4a14b",
                                "text": "…, ces moines, logés nourris et vêtus gratuitement dans des monastères fondés et dotés par la munificence des rois, des seigneurs de terre ou des fidèles, pouvaient donner à des prix très-modiques la publicité aux ouvrages de l’esprit."
                            },
                            {
                                "example_id": "fa3eacba-7902-49b3-9bb0-428ff2990d81",
                                "sense_id": "216dc9ec-71a4-3a2c-9501-3acf37a4a14b",
                                "text": "Ce naïf soldat, […], se crut l’homme le plus heureux du monde, en se voyant propriétaire d’une maison que la munificence de son chef garnit d’un joli mobilier, […]"
                            },
                            {
                                "example_id": "c8e3d25d-2fd0-4d9b-8835-22ad74bf5eff",
                                "sense_id": "216dc9ec-71a4-3a2c-9501-3acf37a4a14b",
                                "text": "Si l’on donne foi au bruit généralement accrédité d’une promesse de subside en hommes et en argent faite par la ville affranchie, […], on aura trouvé le secret de cette munificence."
                            },
                            {
                                "example_id": "4fa70c32-a03d-4eb0-b235-6e96350808c7",
                                "sense_id": "216dc9ec-71a4-3a2c-9501-3acf37a4a14b",
                                "text": "Melvin Phelps passait de groupe en groupe pour s’excuser que le buffet n'atteigne pas à la munificence de l’an dernier."
                            },
                            {
                                "example_id": "d9de4e56-d62f-4def-b864-971b26fa8aad",
                                "sense_id": "216dc9ec-71a4-3a2c-9501-3acf37a4a14b",
                                "text": "Marius ne possède que deux livrées qu'il doit à la misérable munificence de mon pauvre papa, et je ne crois pas qu'il ait un costume en propre."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f6778c0d-823e-45e0-83e8-20449172c651",
                        "source_entry_id": "20338ab0-3d54-3daf-bf3e-31af576cb9fe",
                        "source_sense_id": "216dc9ec-71a4-3a2c-9501-3acf37a4a14b",
                        "target_lang_word": "frankness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "frankness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2a3e18eb-0b9b-30cc-ac0d-224eb008ea35",
                                        "entry_id": "30adeb50-b3bc-334b-8b16-d2df5d0f1672",
                                        "glosses": [
                                            "The state of being frank; candour; honesty."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7f642955-fdc9-4b01-8267-fc3b4ffc71c0",
                                                "sense_id": "2a3e18eb-0b9b-30cc-ac0d-224eb008ea35",
                                                "text": "With disarming frankness, he admitted his mistakes."
                                            },
                                            {
                                                "example_id": "ce1507e6-a953-4ff6-a9bf-ccd9b358bf54",
                                                "sense_id": "2a3e18eb-0b9b-30cc-ac0d-224eb008ea35",
                                                "text": "complete frankness"
                                            },
                                            {
                                                "example_id": "0e809ae2-f632-4a7d-b628-7c42061e1168",
                                                "sense_id": "2a3e18eb-0b9b-30cc-ac0d-224eb008ea35",
                                                "text": "speak with frankness"
                                            },
                                            {
                                                "example_id": "51b06cec-370b-43c6-822c-74245df689a1",
                                                "sense_id": "2a3e18eb-0b9b-30cc-ac0d-224eb008ea35",
                                                "text": "a moment of frankness"
                                            },
                                            {
                                                "example_id": "27fd663f-4b27-4751-b127-c53b27bc12b4",
                                                "sense_id": "2a3e18eb-0b9b-30cc-ac0d-224eb008ea35",
                                                "text": "She appreciated his frankness about the situation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4710848f-cf84-4727-ba7a-5cd397c1b466",
                        "source_entry_id": "20338ab0-3d54-3daf-bf3e-31af576cb9fe",
                        "source_sense_id": "216dc9ec-71a4-3a2c-9501-3acf37a4a14b",
                        "target_lang_word": "generosity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "generosity",
