                        "examples": [
                            {
                                "example_id": "94c17cd2-5903-4b97-87e2-67a5bac21f8b",
                                "sense_id": "75868a95-72d6-3a35-9c28-b467a1366b33",
                                "text": "De retour dans cette France qui l’avait vu grandir il n’y a pas si longtemps, Joselito Adame a eu le temps de tripler sa zapopina avant de banderiller en couleurs son deuxième adversaire."
                            },
                            {
                                "example_id": "aec2019d-59eb-4b52-9666-c161916df013",
                                "sense_id": "75868a95-72d6-3a35-9c28-b467a1366b33",
                                "text": "Mais ce qui allait leur arracher le cœur fut la « zapopina », invention du Mexicain Miguel Ángel Martínez Hernández, el Zapopan."
                            },
                            {
                                "example_id": "3f740ad5-750c-41e6-9d4d-419e115e4647",
                                "sense_id": "75868a95-72d6-3a35-9c28-b467a1366b33",
                                "text": "Allègre et fleuri dans son répertoire à la cape, Alejandro Adame enthousiasme le public grâce à ses zapopinas."
                            }
                        ]
                    }
