                            {
                                "example_id": "06f6c357-a0e2-45db-8136-9d270506b375",
                                "sense_id": "5798e3a0-d8c9-3229-a1ac-7fe0468f44eb",
                                "text": "„Fünfundsechzig Kilometer südöstlich von London, inmitten der Obstgärten und Hopfenfelder der Hügellandschaft von Kent, war es von der Großstadt weit genug entfernt, um den Ausflug zum Erlebnis zu machen, doch nah genug, um schnell das Feld räumen zu können, wenn das Wetter mies wurde.“"
                            }
                        ],
