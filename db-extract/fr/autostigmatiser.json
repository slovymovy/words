                        "glosses": [
                            "Se stigmatiser soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "afed2107-085b-403a-9cb2-9f22eafa740a",
                                "sense_id": "38100c54-5a57-3ed6-9471-653fcc1f676d",
                                "text": "C’est difficile parce que d’abord le séropositif s’autostigmatise et s’interroge: est-ce que je serai embauché ?"
                            },
                            {
                                "example_id": "d2e59d61-d5b5-48cd-8f1e-701f7965c594",
                                "sense_id": "38100c54-5a57-3ed6-9471-653fcc1f676d",
                                "text": "Les proches aidants de personnes atteintes de maladie mentale vivent de la stigmatisation et s’autostigmatisent."
                            },
                            {
                                "example_id": "cf197b5a-1ef8-49f9-a1a6-876b804856e9",
                                "sense_id": "38100c54-5a57-3ed6-9471-653fcc1f676d",
                                "text": "À cela s’ajoute la tendance à s’autostigmatiser, c’est-à-dire à s’approprier les croyances, préjugés et comportements stigmatisants."
                            }
                        ]
                    }
