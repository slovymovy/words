                    "frequency": "High",
                    "semantic_group_id": "justice",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le tribunal a prononcé une lourde <w>condamnation</w> contre l'accusé à la fin du procès."
                        },
                        {
                            "text": "Sa <w>condamnation</w> à une peine d'amende a été confirmée en appel."
                        }
                    ],
                    "synonyms": [
