                                        "sense_id": "c89c6504-c3e8-3e64-b940-11d60ae2dc3c",
                                        "entry_id": "b2665ea2-07ea-3b0c-824a-3e33677cf066",
                                        "glosses": [
                                            "nicht geschlossen, zum Beispiel als Zustandsbeschreibung einer Eingangsmöglichkeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4e3478a-4b86-4c3b-adf6-9d124aaae436",
                                                "sense_id": "c89c6504-c3e8-3e64-b940-11d60ae2dc3c",
                                                "text": "Durch ein offenes Fenster konnten die Diebe leicht in die Wohnung eindringen."
                                            },
                                            {
                                                "example_id": "326a220b-5c57-46af-9da9-7ec0bbe952b2",
                                                "sense_id": "c89c6504-c3e8-3e64-b940-11d60ae2dc3c",
                                                "text": "„Offene Brandwunden sind ein idealer Nährboden für Bakterien und infizieren sich oft.“"
                                            },
                                            {
                                                "example_id": "1d7d7a2e-9781-4646-bbfd-2b742f3a2673",
                                                "sense_id": "c89c6504-c3e8-3e64-b940-11d60ae2dc3c",
                                                "text": "[Schlagzeile:] „US-Gefangenenlager auf Kuba - Guantánamo soll weitere 25 Jahre offen bleiben“"
                                            },
                                            {
                                                "example_id": "3a73e4cc-e3a1-44ba-969b-10889d668660",
                                                "sense_id": "c89c6504-c3e8-3e64-b940-11d60ae2dc3c",
                                                "text": "[Coronapandemie 2020:] „Nach den Herbstferien hat der Schulunterricht in Hamburg, Schleswig-Holstein und Mecklenburg-Vorpommern wieder begonnen. […] Bei deutlich steigenden Corona-Infektionszahlen. In allen Bundesländern. Die Schulen sollen offen bleiben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e1d928c1-28f6-3122-95a2-cb0dd83fc5bc",
                                        "entry_id": "b2665ea2-07ea-3b0c-824a-3e33677cf066",
                                        "glosses": [
                                            "nicht versperrt, weil nichts im Wege ist, zum Beispiel weder ein körperliches Hindernis noch ein Verbot"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61719b50-bd1a-42be-aaac-5f5adee49ec5",
                                                "sense_id": "e1d928c1-28f6-3122-95a2-cb0dd83fc5bc",
                                                "text": "Sie kamen sehr schnell ins offene Fahrwasser."
                                            },
                                            {
                                                "example_id": "a31dce0c-6a21-4405-bd4b-2695cf4f60bc",
                                                "sense_id": "e1d928c1-28f6-3122-95a2-cb0dd83fc5bc",
                                                "text": "Es ist ein offenes Geheimnis, dass die beiden getrennt sind."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "fcd7da52-a90d-328b-9b68-b0119ee914de",
                                        "entry_id": "b2665ea2-07ea-3b0c-824a-3e33677cf066",
                                        "glosses": [
                                            "nicht verschlossen, nicht verpackt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "798c8955-bee3-4f82-91a8-b303d9a88302",
                                                "sense_id": "fcd7da52-a90d-328b-9b68-b0119ee914de",
                                                "text": "Der Wirt bot einen sehr guten offenen Wein an."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "167bec26-fa5f-329b-94ab-86cbda2f3ae5",
                                        "entry_id": "b2665ea2-07ea-3b0c-824a-3e33677cf066",
                                        "glosses": [
                                            "noch nicht entschieden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1bee9ca-754a-433b-af9f-ae9e7e14d9a3",
                                                "sense_id": "167bec26-fa5f-329b-94ab-86cbda2f3ae5",
                                                "text": "Es blieb bis kurz vor Schluss eine noch offene Entscheidung."
                                            },
                                            {
                                                "example_id": "11f46649-37a1-4923-be58-8b8da02cf022",
                                                "sense_id": "167bec26-fa5f-329b-94ab-86cbda2f3ae5",
                                                "text": "„[Reich-Ranicki] beendete die Sendung jeweils mit dem Brecht-Zitat: ‚Und so sehen wir betroffen / Den Vorhang zu und alle Fragen offen.‘, eine Abwandlung von ‚Wir stehen selbst enttäuscht und sehn betroffen / Den Vorhang zu und alle Fragen offen.‘ (aus Der gute Mensch von Sezuan).“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "2dc4216f-7b35-3a94-9ad0-eb007e67d197",
                                        "entry_id": "b2665ea2-07ea-3b0c-824a-3e33677cf066",
                                        "glosses": [
                                            "ohne Zurückhaltung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a5b4aeec-bae6-4d1c-8d7e-70c72cd99a11",
                                                "sense_id": "2dc4216f-7b35-3a94-9ad0-eb007e67d197",
                                                "text": "Er beeindruckte alle durch sein offenes Wesen."
                                            },
                                            {
                                                "example_id": "573fadc0-7834-4845-84f0-f3114c187eea",
                                                "sense_id": "2dc4216f-7b35-3a94-9ad0-eb007e67d197",
                                                "text": "Ich bin offen für alle Schandtaten."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "006ee805-dbb4-3fbe-8486-5d683a3265b6",
                                        "entry_id": "b2665ea2-07ea-3b0c-824a-3e33677cf066",
                                        "glosses": [
                                            "ohne nötige Vorsicht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b83aa73-46f5-414d-9f8c-0b3348823f11",
                                                "sense_id": "006ee805-dbb4-3fbe-8486-5d683a3265b6",
                                                "text": "Die beiden Mannschaften lieferten sich einen offenen Kampf."
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    },
                                    {
                                        "sense_id": "e2388cb6-c278-34b0-a2cd-e6e619a83c66",
                                        "entry_id": "b2665ea2-07ea-3b0c-824a-3e33677cf066",
                                        "glosses": [
                                            "phonetisches (artikulatorisches) Merkmal der tiefen Vokale"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cab525a5-27b8-41aa-a4f7-ff90f1cce603",
                                                "sense_id": "e2388cb6-c278-34b0-a2cd-e6e619a83c66",
                                                "text": "Der Vokal [a] hat das phonetische Merkmal offen, im Gegensatz zu [ɪ] und [ʊ], die das Merkmal »geschlossen« haben."
                                            },
                                            {
                                                "example_id": "cc1cad30-f4df-4abe-9da9-69359519d267",
                                                "sense_id": "e2388cb6-c278-34b0-a2cd-e6e619a83c66",
                                                "text": "Die offenen Vokale sind zugleich die tiefen Vokale."
                                            },
                                            {
                                                "example_id": "1900dd23-a8b5-4abf-a9cc-3a0f5609f015",
                                                "sense_id": "e2388cb6-c278-34b0-a2cd-e6e619a83c66",
                                                "text": "„Für das Deutsche ist die Unterscheidung von offenen und geschlossenen Vokalen üblich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"7\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a9d1ef62-a3ae-48ec-bc8b-56d0728629fc",
                        "source_entry_id": "e5847c6a-c814-32b7-8943-5754d26b6043",
                        "source_sense_id": "84d36396-f469-3cfc-9f18-363c0d3c1704",
                        "source_sense_description": "straightforward, transparent",
                        "target_lang_word": "korrekt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "korrekt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7ebe917b-0a13-373a-9bf7-75abf1bafedb",
                                        "entry_id": "2236dfcb-2714-3ce5-8df5-66425b9a3a2d",
                                        "glosses": [
                                            "so, dass etwas richtig und nicht falsch ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6ec1743-1235-4a34-b8fa-32afe0b1ab49",
                                                "sense_id": "7ebe917b-0a13-373a-9bf7-75abf1bafedb",
                                                "text": "Deine Lösung ist korrekt."
                                            },
                                            {
                                                "example_id": "8d8c7f8b-67b6-43d1-aabf-6240ff3a188d",
                                                "sense_id": "7ebe917b-0a13-373a-9bf7-75abf1bafedb",
                                                "text": "Am korrektesten wäre es vielleicht, von einer konstitutionellen Amoralität der Griechen zu reden."
                                            },
                                            {
                                                "example_id": "c0830182-3772-4b6b-a917-bce247e7fd07",
                                                "sense_id": "7ebe917b-0a13-373a-9bf7-75abf1bafedb",
                                                "text": "Der gewaltige Ruhm, der mit seinem Namen verbunden ist, war Peter Higgs ohnehin nie geheuer: Das von ihm postulierte Elementarteilchen müsse eigentlich \"Brout-Englert-Higgs-Teilchen\" heißen; noch korrekter müsse man vom \"Anderson-Brout-Englert-Higgs-Guralnik-Hagen-Kibble-Mechanismus\" reden."
                                            },
                                            {
                                                "example_id": "4492cb0c-e893-41a0-8f03-9fdf802b5c21",
                                                "sense_id": "7ebe917b-0a13-373a-9bf7-75abf1bafedb",
                                                "text": "Die Ablehnung des Antrags war absolut korrekt, entsprach sie doch dem damaligen Verständnis von Hilfsbedürftigkeit."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ad18dc64-16c0-3e3a-a3c9-bdf54c5d38a1",
                                        "entry_id": "2236dfcb-2714-3ce5-8df5-66425b9a3a2d",
                                        "glosses": [
                                            "so, dass etwas den (herrschenden, geltenden) Regeln entspricht menschlich fair oder der Lage entsprechend angemessen ist"
                                        ],
                                        "tags": [
                                            "oder auch"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "77ddf826-453d-4049-b5e9-42df476ede1b",
                                                "sense_id": "ad18dc64-16c0-3e3a-a3c9-bdf54c5d38a1",
                                                "text": "Der gewaltige Ruhm, der mit seinem Namen verbunden ist, war Peter Higgs ohnehin nie geheuer: Das von ihm postulierte Elementarteilchen müsse eigentlich \"Brout-Englert-Higgs-Teilchen\" heißen; noch korrekter müsse man vom \"Anderson-Brout-Englert-Higgs-Guralnik-Hagen-Kibble-Mechanismus\" reden."
                                            },
                                            {
                                                "example_id": "4680b8e6-294a-4dc2-9101-24a413f84131",
                                                "sense_id": "ad18dc64-16c0-3e3a-a3c9-bdf54c5d38a1",
                                                "text": "Die Ablehnung des Antrags war absolut korrekt, entsprach sie doch dem damaligen Verständnis von Hilfsbedürftigkeit."
                                            },
                                            {
                                                "example_id": "01885f62-36d8-4873-8f48-c9ab41207f40",
                                                "sense_id": "ad18dc64-16c0-3e3a-a3c9-bdf54c5d38a1",
                                                "text": "Sein Verhalten war stets sehr korrekt, als ob er den Knigge gelesen und verstanden hätte."
                                            },
                                            {
                                                "example_id": "b4bf2bc4-2e26-4997-b042-86d7f9458208",
                                                "sense_id": "ad18dc64-16c0-3e3a-a3c9-bdf54c5d38a1",
                                                "text": "Das ist doch mal ein korrekter Vorschlag: wir bezahlen jeder die Hälfte und vergessen die Sache."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "e4f849ac-ce9e-3a40-886e-6401ad51fe84",
                                        "entry_id": "2236dfcb-2714-3ce5-8df5-66425b9a3a2d",
                                        "glosses": [
                                            "gut"
                                        ],
                                        "tags": [
                                            "Slang",
                                            "Ausdruck der Zustimmung"
                                        ],
                                        "examples": [
