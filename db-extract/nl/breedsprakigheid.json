                "senses": [
                    {
                        "sense_id": "399f939e-6e5a-3361-b086-b30967cb6758",
                        "entry_id": "70989cd0-4e34-39e9-8edb-0ca248621d3b",
                        "glosses": [
                            "het (te) veel woorden gebruiken bij het spreken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2d4538a0-9fa8-4a3e-9fb4-8302dbdb8bf8",
                                "sense_id": "399f939e-6e5a-3361-b086-b30967cb6758",
                                "text": "Hij verliet de bombastische versmaat met zijn cesuur door de regels in een viervoetig metrum te persen, zoals men in proza met breedsprakigheid strijdt."
                            },
                            {
                                "example_id": "67153b30-3306-4b73-9256-a7dcd3eece1b",
                                "sense_id": "399f939e-6e5a-3361-b086-b30967cb6758",
                                "text": "“We hebben duidelijke overeenkomsten, ja. Breedsprakigheid, graag een verhaal vertellen – ook al is het voor de vijftiende keer, creativiteit en vasthoudendheid. Ik moet het namelijk niet hebben van mijn talent, maar van heel erg m’n best doen.”"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6c9502b6-2f16-400e-8c76-c0a8b8c04023",
                        "source_entry_id": "70989cd0-4e34-39e9-8edb-0ca248621d3b",
                        "source_sense_id": "399f939e-6e5a-3361-b086-b30967cb6758",
                        "source_sense_description": "het (te) veel woorden gebruiken bij het spreken",
                        "target_lang_word": "prolixity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prolixity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d12d9186-ba15-36c5-abbe-e14486013a77",
                                        "entry_id": "4a9d11da-b795-33c4-a77f-aec4ece4f71b",
                                        "glosses": [
                                            "Long-windedness, tiresome length, excess of words."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8495fef1-5cbc-4ca4-a2d9-e8835fcc3a3f",
                                                "sense_id": "d12d9186-ba15-36c5-abbe-e14486013a77",
                                                "text": "Of Skelton's one excursion into dramatic form, Magnificence, not much need be said. [...] Its fault, a fatal one in drama, is its prolixity, but cut by at least two-thirds it might act very much better than one imagines."
                                            },
                                            {
                                                "example_id": "6ec06b17-faca-4a01-a8b6-280ab4900ace",
                                                "sense_id": "d12d9186-ba15-36c5-abbe-e14486013a77",
                                                "text": "Must I then for twenty-three mortal days endure the prolixity of that tedious woman?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
