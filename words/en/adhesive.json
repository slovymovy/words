{
    "word_family": [
        "adhere",
        "adhesion",
        "adhesiveness",
        "cohesive"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "daf70444-d52a-306b-b828-1398da694d62",
                    "sense_definition": "A substance, such as glue or paste, that is used to make things stick together.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The label wouldn’t stick to the plastic bottle without a strong <w>adhesive</w>.",
                            "target_lang_translations": {
                                "ru": "Этикетка не держалась бы на пластиковой бутылке без прочного <w>клея</w>."
                            }
                        },
                        {
                            "text": "They used a waterproof <w>adhesive</w> to repair the broken vase in the kitchen.",
                            "target_lang_translations": {
                                "ru": "Они использовали водостойкий <w>клей</w>, чтобы починить разбитую вазу на кухне."
                            }
                        }
                    ],
                    "common_phrases": [
                        "strong adhesive",
                        "waterproof adhesive"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вещество, такое как клей или паста, используемое для соединения предметов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "клей",
                                "target_lang_sense_clarification": "жидкое или пастообразное вещество для склеивания"
                            },
                            {
                                "target_lang_word": "клеящее вещество",
                                "target_lang_sense_clarification": "технический термин для адгезивов"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "5268e66a-507b-3a66-a38e-69b2bac0cde9",
                    "sense_definition": "Sticky or having the ability to adhere to surfaces.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sticky_properties",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please use <w>adhesive</w> tape to secure the poster to the classroom wall.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, используйте <w>клейкую</w> ленту, чтобы закрепить плакат на стене класса."
                            }
                        },
                        {
                            "text": "The back of the stamp is coated with an <w>adhesive</w> substance that activates when wet.",
                            "target_lang_translations": {
                                "ru": "Обратная сторона марки покрыта <w>клейким</w> веществом, которое активируется при намокании."
                            }
                        }
                    ],
                    "synonyms": [
                        "sticky",
                        "clingy",
                        "tenacious"
                    ],
                    "antonyms": [
                        "nonsticky",
                        "slippery"
                    ],
                    "common_phrases": [
                        "adhesive tape",
                        "adhesive material"
                    ],
                    "target_lang_definitions": {
                        "ru": "Липкий или обладающий способностью прилипать к поверхностям."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "клейкий",
                                "target_lang_sense_clarification": "способный прилипать"
                            },
                            {
                                "target_lang_word": "липкий",
                                "target_lang_sense_clarification": "обладающий свойством прилипания"
                            },
                            {
                                "target_lang_word": "адгезивный",
                                "target_lang_sense_clarification": "специальный термин, относящийся к сцеплению поверхностей"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "656ec297-70c3-360c-b216-15f4663be0c3",
                    "sense_definition": "Tending to cling or adhere physically to something.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sticky_properties",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The wet mud was highly <w>adhesive</w>, clinging to our boots with every step we took.",
                            "target_lang_translations": {
                                "ru": "Мокрая грязь была очень <w>липкой</w>, цепляясь за наши сапоги при каждом шаге."
                            }
                        },
                        {
                            "text": "Certain seeds have <w>adhesive</w> properties that allow them to stick to animal fur for dispersal.",
                            "target_lang_translations": {
                                "ru": "Некоторые семена обладают <w>клейкими</w> свойствами, позволяющими им цепляться за шерсть животных для распространения."
                            }
                        }
                    ],
                    "synonyms": [
                        "adherent",
                        "clingy"
                    ],
                    "antonyms": [
                        "nonadhesive"
                    ],
                    "common_phrases": [
                        "adhesive properties"
                    ],
                    "target_lang_definitions": {
                        "ru": "Склонный физически цепляться или прилипать к чему-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "липкий",
                                "target_lang_sense_clarification": "прилипающий к поверхностям"
                            },
                            {
                                "target_lang_word": "клейкий",
                                "target_lang_sense_clarification": "вязкий, пристающий к вещам"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}