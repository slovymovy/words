                "senses": [
                    {
                        "sense_id": "7314b55e-279a-35d4-93ea-ed1fe835349e",
                        "entry_id": "f2ec4a14-990e-35d4-914f-22b857c70862",
                        "glosses": [
                            "Qui est divisé en cellules, composé de cellules."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "81ec150b-ff8b-4f7d-8d87-30d8d21ab5ff",
                                "sense_id": "7314b55e-279a-35d4-93ea-ed1fe835349e",
                                "text": "Les os du métacarpe ont la structure des os longs en général, c'est-à-dire, que leur corps est compacte & que leurs extrémités sont celluleuses. Ils sont creusés par un canal médullaire prononcé."
                            },
                            {
                                "example_id": "1044482a-e600-4d14-9d05-7cae7e050d2d",
                                "sense_id": "7314b55e-279a-35d4-93ea-ed1fe835349e",
                                "text": "FLUSTRES (Zoologie). — Suivant M. Milne-Edwards, ces animaux appartiennent à l'embranchement des Mollusques, sous-embranchement des Molluscoïdes ou Tuniciers, classe des Bryozoaires; ils forment, dans tous les cas, un genre établi par Linné (Flustra), et qui avait été rangé pur Cuvier parmi les Polypes à polypiers celluleux."
                            },
                            {
                                "example_id": "291b5752-b926-40e0-849c-d33bd9dc97ee",
                                "sense_id": "7314b55e-279a-35d4-93ea-ed1fe835349e",
                                "text": "Ce sont des calcaires compactes, sub-lithographiques, dont quelques-uns ont un faux aspect de calcaire grossier marin, et d’autres qui sont celluleux, alternent avec des marnes plus ou moins argileuses."
                            }
                        ]
                    }
