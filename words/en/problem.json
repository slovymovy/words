{
    "word_family": [
        "problematic",
        "problematize",
        "problem-solver",
        "problem-solving"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "743704d0-efb2-38d3-a2a5-d52396036049",
                    "sense_definition": "A difficulty that has to be resolved or dealt with.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "difficulty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We need to find a way to solve this <w>problem</w> before the deadline.",
                            "target_lang_translations": {
                                "ru": "Нам нужно найти способ решить эту <w>проблему</w> до дедлайна."
                            }
                        },
                        {
                            "text": "The company is facing a <w>major</w> <w>problem</w> with its supply chain.",
                            "target_lang_translations": {
                                "ru": "Компания столкнулась с <w>серьезной</w> <w>проблемой</w> в цепочке поставок."
                            }
                        }
                    ],
                    "antonyms": [
                        "solution"
                    ],
                    "common_phrases": [
                        "major problem",
                        "solve a problem",
                        "cause a problem",
                        "serious problem"
                    ],
                    "target_lang_definitions": {
                        "ru": "Трудность, которую необходимо разрешить или с которой нужно справиться."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "проблема",
                                "target_lang_sense_clarification": "общая трудность"
                            },
                            {
                                "target_lang_word": "трудность",
                                "target_lang_sense_clarification": "препятствие"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7616584b-7f69-39aa-a2ed-7511bf59d970",
                    "sense_definition": "A question to be answered or a schoolwork exercise.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "exercise",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teacher asked us to complete every <w>math</w> <w>problem</w> on page ten.",
                            "target_lang_translations": {
                                "ru": "Учитель попросил нас решить каждую <w>математическую</w> <w>задачу</w> на десятой странице."
                            }
                        },
                        {
                            "text": "I spent all night trying to solve a difficult <w>math</w> <w>problem</w> for my homework.",
                            "target_lang_translations": {
                                "ru": "Я провел всю ночь, пытаясь решить сложную <w>математическую</w> <w>задачу</w> из домашнего задания."
                            }
                        }
                    ],
                    "common_phrases": [
                        "math problem",
                        "practice problem",
                        "chess problem"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вопрос, требующий ответа, или учебное упражнение."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "задача",
                                "target_lang_sense_clarification": "математическая или логическая"
                            },
                            {
                                "target_lang_word": "задание",
                                "target_lang_sense_clarification": "учебное упражнение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0f58c205-1b8e-3d21-b629-1fcf8463204b",
                    "sense_definition": "An addiction, substance use disorder, or a comparable psychological challenge.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "difficulty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He realized he had a <w>drinking</w> <w>problem</w> and decided to seek professional help.",
                            "target_lang_translations": {
                                "ru": "Он осознал, что у него <w>проблемы</w> <w>с</w> <w>алкоголем</w>, и решил обратиться за профессиональной помощью."
                            }
                        },
                        {
                            "text": "Lending him money will probably only make his <w>gambling</w> <w>problem</w> worse.",
                            "target_lang_translations": {
                                "ru": "Если дать ему денег в долг, это, вероятно, только усугубит его <w>игровую</w> <w>зависимость</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "drinking problem",
                        "gambling problem",
                        "drug problem"
                    ],
                    "target_lang_definitions": {
                        "ru": "Зависимость, расстройство, связанное с употреблением веществ, или аналогичная психологическая проблема."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "проблема",
                                "target_lang_sense_clarification": "зависимость или недуг"
                            },
                            {
                                "target_lang_word": "зависимость",
                                "target_lang_sense_clarification": "патологическое влечение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b0beb89e-0d8d-30d3-9e8d-309b973f59fd",
                    "sense_definition": "An objection or a reason for feeling annoyed or dissatisfied.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "objection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "If you <w>have</w> <w>a</w> <w>problem</w> with my decision, you should tell me now.",
                            "target_lang_translations": {
                                "ru": "Если у тебя <w>есть</w> <w>претензии</w> к моему решению, тебе стоит сказать мне об этом сейчас."
                            }
                        },
                        {
                            "text": "I don't <w>have</w> <w>a</w> <w>problem</w> with him staying here for a few days.",
                            "target_lang_translations": {
                                "ru": "Я <w>не</w> <w>против</w> того, чтобы он остался здесь на несколько дней."
                            }
                        }
                    ],
                    "common_phrases": [
                        "have a problem",
                        "no problem"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in questions like 'you got a problem?'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Возражение или причина для раздражения или недовольства."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "претензия",
                                "target_lang_sense_clarification": "недовольство кем-то"
                            },
                            {
                                "target_lang_word": "проблема",
                                "target_lang_sense_clarification": "повод для возражения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4c08fbf6-4894-3172-bf70-1942e9e77688",
                    "sense_definition": "Difficulty in accepting or understanding something, or a refusal to do so.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "objection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "If they judge you harshly for your efforts, that is <w>their</w> <w>problem</w>.",
                            "target_lang_translations": {
                                "ru": "Если они строго судят тебя за твои усилия, это <w>их</w> <w>проблема</w>."
                            }
                        },
                        {
                            "text": "She seems to have a <w>real</w> <w>problem</w> with authority figures in the workplace.",
                            "target_lang_translations": {
                                "ru": "Похоже, у нее <w>настоящие</w> <w>трудности</w> с признанием авторитетов на рабочем месте."
                            }
                        }
                    ],
                    "common_phrases": [
                        "their problem",
                        "real problem"
                    ],
                    "target_lang_definitions": {
                        "ru": "Трудность в принятии или понимании чего-либо, или отказ сделать это."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "проблема",
                                "target_lang_sense_clarification": "личное неприятие"
                            },
                            {
                                "target_lang_word": "трудность",
                                "target_lang_sense_clarification": "сложность в понимании"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "31b293cf-9b3c-3560-82ac-2ba77d3fc3b4",
                    "sense_definition": "A puzzling or mysterious circumstance.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "difficulty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden disappearance of the documents remains a <w>problem</w> for the investigators.",
                            "target_lang_translations": {
                                "ru": "Внезапное исчезновение документов остается <w>загадкой</w> для следователей."
                            }
                        },
                        {
                            "text": "How the thief entered the locked room is the main <w>problem</w> of the mystery.",
                            "target_lang_translations": {
                                "ru": "То, как вор проник в запертую комнату, является главной <w>загадкой</w> этой тайны."
                            }
                        }
                    ],
                    "synonyms": [
                        "rub"
                    ],
                    "target_lang_definitions": {
                        "ru": "Загадочное или таинственное обстоятельство."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "загадка",
                                "target_lang_sense_clarification": "необъяснимый факт"
                            },
                            {
                                "target_lang_word": "головоломка",
                                "target_lang_sense_clarification": "сложная тайна"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4edf6d27-e815-3162-9bca-967a57b96ce5",
                    "sense_definition": "In bouldering, a specific sequence of moves required to complete a climb.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "exercise",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He spent the entire afternoon trying to figure out the <w>bouldering</w> <w>problem</w>.",
                            "target_lang_translations": {
                                "ru": "Он провел весь день, пытаясь разобраться в этой <w>боулдеринговой</w> <w>трассе</w>."
                            }
                        },
                        {
                            "text": "This <w>bouldering</w> <w>problem</w> requires a lot of upper body strength and balance.",
                            "target_lang_translations": {
                                "ru": "Эта <w>боулдеринговая</w> <w>трасса</w> требует большой силы верхней части тела и равновесия."
                            }
                        }
                    ],
                    "common_phrases": [
                        "bouldering problem"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "used in the context of climbing sports"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "В боулдеринге: определенная последовательность движений, необходимых для завершения подъема."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "трасса",
                                "target_lang_sense_clarification": "маршрут в скалолазании"
                            },
                            {
                                "target_lang_word": "проблема",
                                "target_lang_sense_clarification": "боулдеринговый маршрут"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "4b8bb7eb-bdfd-3b37-86d8-66e66f7eb17b",
                    "sense_definition": "Causing a difficulty; troublesome or problematic.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "troublesome",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new software update proved to be <w>more</w> <w>problem</w> than it was worth.",
                            "target_lang_translations": {
                                "ru": "Новое обновление ПО оказалось <w>более</w> <w>проблемным</w>, чем оно того стоило."
                            }
                        },
                        {
                            "text": "Dealing with the insurance company was <w>more</w> <w>problem</w> to my family than to me.",
                            "target_lang_translations": {
                                "ru": "Общение со страховой компанией доставило <w>больше</w> <w>хлопот</w> моей семье, чем мне."
                            }
                        }
                    ],
                    "common_phrases": [
                        "more problem"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in comparative structures"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вызывающий затруднения; хлопотный или проблематичный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "проблемный",
                                "target_lang_sense_clarification": "создающий хлопоты"
                            },
                            {
                                "target_lang_word": "хлопотный",
                                "target_lang_sense_clarification": "требующий усилий"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "89900526-7f65-3fee-abcd-7c5a727c5ee2",
                    "sense_definition": "Difficult to train, guide, or control; unruly.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "troublesome",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The school has a special program for <w>problem</w> <w>children</w> who struggle in class.",
                            "target_lang_translations": {
                                "ru": "В школе есть специальная программа для <w>трудных</w> <w>детей</w>, у которых возникают сложности в классе."
                            }
                        },
                        {
                            "text": "The <w>problem</w> <w>children</w> were sent to the principal's office for their behavior.",
                            "target_lang_translations": {
                                "ru": "<w>Проблемных</w> <w>детей</w> отправили в кабинет директора за их поведение."
                            }
                        }
                    ],
                    "common_phrases": [
                        "problem children",
                        "problem area"
                    ],
                    "target_lang_definitions": {
                        "ru": "Трудный в обучении, руководстве или контроле; непослушный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "трудный",
                                "target_lang_sense_clarification": "о ребенке или поведении"
                            },
                            {
                                "target_lang_word": "проблемный",
                                "target_lang_sense_clarification": "неуправляемый"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}