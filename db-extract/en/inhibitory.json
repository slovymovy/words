    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "873f4b39-fb20-3b17-8c7c-e382760f2109",
                "word": "inhibitory",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "a88a9e8f-0280-382c-b75d-59ecb8d705cf",
                        "entry_id": "873f4b39-fb20-3b17-8c7c-e382760f2109",
                        "glosses": [
                            "That inhibits."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "233e8386-e22e-4c36-af23-1f310df5796c",
                                "sense_id": "a88a9e8f-0280-382c-b75d-59ecb8d705cf",
                                "text": "the inhibitory action of the pneumogastric on the respiratory center"
                            },
                            {
                                "example_id": "e32c3870-205a-4b6a-bf16-85e22ebb11d9",
                                "sense_id": "a88a9e8f-0280-382c-b75d-59ecb8d705cf",
                                "text": "Numerous experiments show that the brain exercises an inhibitory action over the reflex movements, and that the more active that organ, the more they are under control."
                            }
                        ]
                    },
                    {
                        "sense_id": "06959270-b627-3fe2-b4e4-b82a98eca5c4",
                        "entry_id": "873f4b39-fb20-3b17-8c7c-e382760f2109",
                        "glosses": [
                            "Of, or relating to an inhibitor."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cc6ccc73-791d-41b4-bfba-bb8b4c8f16c7",
                        "source_entry_id": "873f4b39-fb20-3b17-8c7c-e382760f2109",
                        "source_sense_description": "that inhibits",
                        "target_lang_word": "inhibiteur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inhibiteur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d869179c-eaa0-3cd1-940c-72c28e235422",
                                        "entry_id": "2b22c94a-c39d-3082-add2-c2efcc60f6bc",
                                        "glosses": [
                                            "Qui inhibe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b07c2fc8-c8b3-4bcd-bdd5-07738ac9b6bc",
                                                "sense_id": "d869179c-eaa0-3cd1-940c-72c28e235422",
                                                "text": "Ils ont tout d’abord utilisé des cultures de cellules nerveuses et ont montré qu’ils pouvaient visualiser nettement les synapses inhibitrices et excitatrices en plaçant les cellules sous une lumière bleue."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "inhibiteur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "52c02ad0-dcc6-3900-bc9b-9817e0035503",
                                        "entry_id": "8b1c3209-7e56-3018-84b1-69583f57f7b1",
                                        "glosses": [
                                            "Ce qui inhibe un processus, une réaction, un comportement, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b05580b-0921-4dd5-ae37-cf4b515afd76",
                                                "sense_id": "52c02ad0-dcc6-3900-bc9b-9817e0035503",
                                                "text": "Les inhibiteurs de métalloprotéases matricielles possèdent un potentiel thérapeutique dans la lutte contre l’invasion métastasique."
                                            },
                                            {
                                                "example_id": "c22511d0-d801-441d-9562-e51550dc286f",
                                                "sense_id": "52c02ad0-dcc6-3900-bc9b-9817e0035503",
                                                "text": "Surtout, sa substance active, autorisée sur une vingtaine de cultures, appartient à la famille des inhibiteurs de la succinate déshydrogénase, les SDHi, de leur petit nom, qui donne la chair de poule à de nombreux scientifiques."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7887a231-8661-36b8-a492-e9211870e8ea",
                                        "entry_id": "8b1c3209-7e56-3018-84b1-69583f57f7b1",
                                        "glosses": [
                                            "Produit incombustible dont on revêt une partie de la surface d’un chargement de propergol solide afin de l’empêcher de s’allumer."
                                        ],
                                        "tags": [
                                            "Nucléaire",
                                            "Matériaux énergétiques"
                                        ],
                                        "examples": []
