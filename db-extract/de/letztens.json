                "senses": [
                    {
                        "sense_id": "4e4d364e-2117-3cb0-9f22-bb16941d7292",
                        "entry_id": "034c46e3-f668-3eab-aeb5-9d4e0f97480e",
                        "glosses": [
                            "最近，不久前"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f98ce2af-2e22-4a30-ab30-55cf039445c9",
                                "sense_id": "4e4d364e-2117-3cb0-9f22-bb16941d7292",
                                "text": "Ich war letztens in Köln.",
                                "translation": "前几天我去了一趟科隆。"
                            },
                            {
                                "example_id": "f5a991d8-8158-47aa-bd58-5f10fd9002ab",
                                "sense_id": "4e4d364e-2117-3cb0-9f22-bb16941d7292",
                                "text": "Und letztens, vor einem Monat, hat er mir erklärt, er würde mir auch nicht mehr mit einem Pfennig aushelfen.",
                                "translation": "就在一个月前，他向我断言，他以后连一分钱都不会再帮我了。"
                            }
                        ]
                    },
                    {
                        "sense_id": "2470246f-172d-3330-b8d6-18440fa13580",
                        "entry_id": "034c46e3-f668-3eab-aeb5-9d4e0f97480e",
                        "glosses": [
                            "最後"
                        ],
                        "tags": [
                            "現只用於枚舉"
                        ],
                        "examples": [
                            {
                                "example_id": "6169e99a-4df2-462f-bd6e-ab77a82bd4fa",
                                "sense_id": "2470246f-172d-3330-b8d6-18440fa13580",
                                "text": "Es kamen die Mutter, der Vater, der Bruder und letztens auch noch die Schwägerin.",
                                "translation": "然后母亲、父亲、兄弟，最后还有嫂子也进来了。"
                            }
                        ]
                    }
