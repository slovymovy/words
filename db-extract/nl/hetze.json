        "nl-extract.jsonl": [
            {
                "entry_id": "9b3da690-19b1-3f27-8ef2-351b4582556a",
                "word": "hetze",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "ec342db2-32d8-4312-9780-3258a7242459",
                        "entry_id": "9b3da690-19b1-3f27-8ef2-351b4582556a",
                        "tags": [
                            "plural"
                        ],
                        "form": "hetzes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "33858071-42c0-3c9c-a9c8-5a79cc66b615",
                        "entry_id": "9b3da690-19b1-3f27-8ef2-351b4582556a",
                        "glosses": [
                            "systematisch opgezet gestook"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f5df475c-404f-42c8-a9c4-43620bfde8c9",
                                "sense_id": "33858071-42c0-3c9c-a9c8-5a79cc66b615",
                                "text": "Er werd een enorme hetze opgezet tegen de politicus in verband met een triviale verspreking."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bcfa13b1-3a9f-4a7a-8946-b682317a03bf",
                        "source_entry_id": "9b3da690-19b1-3f27-8ef2-351b4582556a",
                        "source_sense_id": "33858071-42c0-3c9c-a9c8-5a79cc66b615",
                        "target_lang_word": "Hetze",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hetze",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "43abca20-ed3d-3e41-94c2-347b3471e3c1",
                                        "entry_id": "33c0cd59-d805-3121-ae6b-06502c298190",
                                        "glosses": [
                                            "extreme Eile"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd7c2a02-545e-464b-9ab9-d9d2faf768ab",
                                                "sense_id": "43abca20-ed3d-3e41-94c2-347b3471e3c1",
                                                "text": "„Wir haben uns fest vorgenommen, dieses Erlebnis nachzuholen, dann aber nicht in Hetze, sondern in aller Ruhe.“"
                                            },
                                            {
                                                "example_id": "31f32de7-3eff-49e3-baae-8e66de237c69",
                                                "sense_id": "43abca20-ed3d-3e41-94c2-347b3471e3c1",
                                                "text": "„Zudem seien sie nun ihretwegen in einer fürchterlichen Hetze.“"
                                            },
                                            {
                                                "example_id": "228b8120-59a1-4163-b0c0-1fc4854b2878",
                                                "sense_id": "43abca20-ed3d-3e41-94c2-347b3471e3c1",
                                                "text": "„Ruhig ließ er ihm die Zügel auf dem Sattelknopf liegen und trat rasch durch die Tür, während sein Pony zuerst den schöngeformten Hals schüttelte, so daß der weiße Schaum ringsum flog, und dann mit dem rechten Vorderhuf den Boden zerscharrte und stampfte, als ob es ungeduldig auf den Herrn warte und die Hetze so schnell wie möglich fortzusetzen wünsche.“"
                                            },
                                            {
                                                "example_id": "46947778-e129-456b-a074-7a8aba30ffa0",
                                                "sense_id": "43abca20-ed3d-3e41-94c2-347b3471e3c1",
                                                "text": "„Wir brauchten nur unsere Zahnbürsten, und selbst die vergaßen wir in der Hetze des Aufbruchs, um den Zug nicht zu verpassen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "095861ee-5c13-3c8f-84a0-e0eed8708f58",
                                        "entry_id": "33c0cd59-d805-3121-ae6b-06502c298190",
                                        "glosses": [
                                            "Beförderung einer aggressiven Stimmung und/oder Aktion gegen jemanden/etwas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "57063ce7-6058-4c21-8ad3-0526a2db90b4",
                                                "sense_id": "095861ee-5c13-3c8f-84a0-e0eed8708f58",
                                                "text": "„Ein halbes Jahr später erreichte die ausländerfeindliche Hetze ihren nächsten Höhepunkt.“"
                                            },
                                            {
                                                "example_id": "cfb7f704-c2ee-4865-bf3d-1018764d2730",
                                                "sense_id": "095861ee-5c13-3c8f-84a0-e0eed8708f58",
                                                "text": "„Sie plündern und haben mit böser antijüdischer Hetze begonnen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "e024faa0-4955-3274-af5f-3b61b6343fb0",
                                        "entry_id": "33c0cd59-d805-3121-ae6b-06502c298190",
                                        "glosses": [
                                            "Jagd, bei der das Wild gehetzt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c24dc0cb-c1cc-453b-bcb9-8d8bddae54d9",
                                                "sense_id": "e024faa0-4955-3274-af5f-3b61b6343fb0",
                                                "text": "„Nicht umsonst heißt es in der Jagdliteratur »Wenn bei freier Arbeit des Hundes die Gefahr besteht, dass er sich mit der Halsung verhängen könnte, ist ihm diese vorher abzunehmen. Besonders bei Bauarbeit, Wasserarbeit, Hetze und auch beim Stöbern im schwierigen Gelände«.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "6f14f069-0dbb-3f23-8cd7-bc29e0623bc2",
                                        "entry_id": "33c0cd59-d805-3121-ae6b-06502c298190",
                                        "glosses": [
                                            "eine unbestimmt große Gruppe"
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "regional"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "245ee3ae-5a8a-40c6-9b80-964064a9111a",
                                                "sense_id": "6f14f069-0dbb-3f23-8cd7-bc29e0623bc2",
                                                "text": "Da ist vielleicht ein Trunkenbold von Vater, eine Schlumpe von Mutter, eine Hetze schmutziger, verwilderter Geschwister."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1595036b-d9b6-48f0-8354-590d3ce2b092",
                        "source_entry_id": "9b3da690-19b1-3f27-8ef2-351b4582556a",
                        "source_sense_id": "33858071-42c0-3c9c-a9c8-5a79cc66b615",
                        "target_lang_word": "acharnement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "acharnement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "630a1d56-8b5b-34ac-b904-db0f5e1b7608",
                                        "entry_id": "ab7656fb-6e2f-3fa4-9ca4-a5f16b7c9e9b",
                                        "glosses": [
                                            "Action d’un animal qui s’attache opiniâtrement à sa proie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "253ecfcb-d547-4176-b895-e39274e0cbf9",
                                                "sense_id": "630a1d56-8b5b-34ac-b904-db0f5e1b7608",
                                                "text": "L’acharnement d’un loup, d’un animal carnassier."
                                            },
                                            {
                                                "example_id": "e140f73f-f419-4e93-b687-46c7fa97198a",
                                                "sense_id": "630a1d56-8b5b-34ac-b904-db0f5e1b7608",
                                                "text": "Un jeune bouledogue, entre autres, se distinguait par son acharnement ; cramponné par les crocs à l’échine de l’ours, … il ne lâchait point."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0e1ff280-cdf6-3bd1-a6fc-f4f44e501122",
                                        "entry_id": "ab7656fb-6e2f-3fa4-9ca4-a5f16b7c9e9b",
                                        "glosses": [
                                            "Fureur opiniâtre avec laquelle des animaux, ou des hommes, se battent les uns contre les autres."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f8fc9b02-d74a-46cc-8770-803f81e0d890",
                                                "sense_id": "0e1ff280-cdf6-3bd1-a6fc-f4f44e501122",
                                                "text": "L’acharnement de deux dogues l’un contre l’autre. - Ces deux animaux, ces deux hommes se sont battus avec acharnement. - On se battit avec acharnement durant tout le jour."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0b9b4cce-79b4-3f78-b5d6-064a1c6a4dfd",
                                        "entry_id": "ab7656fb-6e2f-3fa4-9ca4-a5f16b7c9e9b",
                                        "glosses": [
                                            "Animosité opiniâtre qu’on a contre quelqu’un."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "94ab0ecb-0cb3-4005-9a17-0fb848b29e4f",
                                                "sense_id": "0b9b4cce-79b4-3f78-b5d6-064a1c6a4dfd",
                                                "text": "Le même esprit d’acharnement contre les malheureux Espagnols semblait s’être emparé de tout le pays."
                                            },
                                            {
                                                "example_id": "7b8c4742-96d4-4528-9caf-5fa126d008b0",
                                                "sense_id": "0b9b4cce-79b4-3f78-b5d6-064a1c6a4dfd",
                                                "text": "Nulle part, l’école de Clermont n’a autant de détracteurs qu’à Clermont même et l’acharnement de ceux-ci n’est pas petit."
                                            },
                                            {
                                                "example_id": "b45d2ab7-eea1-4b66-bab4-30495d814189",
                                                "sense_id": "0b9b4cce-79b4-3f78-b5d6-064a1c6a4dfd",
                                                "text": "Deux d’entre elles sont héritées du passé: une assistance, le plus souvent impuissante, et l’euthanasie d’une part, l’acharnement thérapeutique et les soins palliatifs d’autre part."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "39e7b27f-99e2-3a07-bc38-59e20a1c0b82",
                                        "entry_id": "ab7656fb-6e2f-3fa4-9ca4-a5f16b7c9e9b",
                                        "glosses": [
                                            "Opiniâtreté."
                                        ],
                                        "tags": [
                                            "hyperbole"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1b295316-6928-4317-8f5a-ab679cb3b6fb",
                                                "sense_id": "39e7b27f-99e2-3a07-bc38-59e20a1c0b82",
                                                "text": "Depuis deux heures Rabalan travaillait avec acharnement. Son casse-pierres se levait et s’abaissait en un mouvement rythmique, sur les cailloux."
                                            },
                                            {
                                                "example_id": "db76de56-3cd0-49c5-b4b4-6af9a0140fb5",
                                                "sense_id": "39e7b27f-99e2-3a07-bc38-59e20a1c0b82",
                                                "text": "Ces docteurs confondent, par un grossier sophisme, un idéal qui, en tant que non changeant, peut par pure métaphore être qualifié de mort, avec les hommes, les êtres charnels qui embrassent cet idéal, lesquels, en cet embrassement, peuvent être si peu morts qu’ils se battront avec acharnement pour le défendre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ee6bd241-372c-3a67-a2cb-421c26de074b",
                                        "entry_id": "ab7656fb-6e2f-3fa4-9ca4-a5f16b7c9e9b",
                                        "glosses": [
                                            "Éreintage."
                                        ],
                                        "tags": [
                                            "Relations internationales"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
