                        "examples": [
                            {
                                "example_id": "85015356-8fbc-4c26-a25b-378b292a062e",
                                "sense_id": "feabf03e-63c1-3ad6-a982-b321d4adff8f",
                                "text": "„Viele von ihnen tragen Cowboyhüte, Sheriffsterne, Spielzeugpistolen.“"
                            },
                            {
                                "example_id": "9294c5f6-501f-437f-b0b3-1a231725b4f0",
                                "sense_id": "feabf03e-63c1-3ad6-a982-b321d4adff8f",
                                "text": "„Vielleicht war ich einfach hungrig, einsam, eine Tontaube, die jeder mit einer Spielzeugpistole abschießen konnte.“"
                            }
