        "fr-extract.jsonl": [
            {
                "entry_id": "684229a0-03b7-34ef-bb38-7d5ffdd27967",
                "word": "antimatter",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "6682f67f-c9f4-4a1f-816d-24ce86712bc2",
                        "entry_id": "684229a0-03b7-34ef-bb38-7d5ffdd27967",
                        "tags": [
                            "plural"
                        ],
                        "form": "antimatters"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5af18d2c-ef00-3801-8046-88215f334b87",
                        "entry_id": "684229a0-03b7-34ef-bb38-7d5ffdd27967",
                        "glosses": [
                            "Antimatière."
                        ],
                        "tags": [
                            "physical"
                        ],
                        "examples": [
                            {
                                "example_id": "a82524bb-c837-4faa-be4a-2cfa0e5883eb",
                                "sense_id": "5af18d2c-ef00-3801-8046-88215f334b87",
                                "text": "Antimatter is the most powerful energy source known to man. It releases energy with 100 percent efficiency (nuclear fission is 1.5 percent efficient). Antimatter creates no pollution or radiation, and a droplet could power New York City for a full day. There is, however, one catch… Antimatter is highly unstable. It ignites when it comes in contact with obsoletely anything… even air. A single gram of antimatter contains the energy of a 20-kiloton nuclear bomb — the size of the bomb dropped on Hiroshima.",
                                "translation": "L’antimatière est la source d’énergie la plus puissante que l’on connaisse. Elle émet de l’énergie à 100% de rendement (la fission nucléaire 1,5% seulement). L’antimatière ne pollue pas, n’émet pas de radiations, et une gouttelette pourrait alimenter New York pour une journée entière. Il y a toutefois un hic : l’antimatière est particulièmement instable : elle s’enflamme au contact de tout, même de l’air. Un seul gramme d’antimatière présente autant d’énergie qu’une bombe atomique de vingt kilotonnes — comme celle qui fut larguée sur Hiroshima."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
