{
    "word": "to-do",
    "lang_code": "en",
    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "26986578-ee19-39f5-b2da-3e2bff2f2fd2",
                "word": "to-do",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "27e752ba-9c01-45bc-859d-04afa4c57a1d",
                        "entry_id": "26986578-ee19-39f5-b2da-3e2bff2f2fd2",
                        "tags": [
                            "plural"
                        ],
                        "form": "to-dos"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1fc31e27-b192-32c4-bb9f-791c4bdf0396",
                        "entry_id": "26986578-ee19-39f5-b2da-3e2bff2f2fd2",
                        "glosses": [
                            "A fuss made over something."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3bfca096-7c71-45e8-b6e6-4f41c65a79ea",
                                "sense_id": "1fc31e27-b192-32c4-bb9f-791c4bdf0396",
                                "text": "I was embarrassed that they made such a big to-do out of my birthday."
                            },
                            {
                                "example_id": "f5d02b32-9f42-4ec3-8098-f5f57bd12ebc",
                                "sense_id": "1fc31e27-b192-32c4-bb9f-791c4bdf0396",
                                "text": "Last year, Russell Brand caused another to-do. This time he wasn’t playing nasty jokes on Andrew Sachs, or boasting about the millions of people he’d slept with; he wasn’t calling George Bush a “retard”, or giving a Nazi salute at the GQ awards, or turning up to work dressed as Osama bin Laden […] No, this time he simply made a political statement."
                            }
                        ]
                    },
                    {
                        "sense_id": "063e8a5a-dfb6-3f0c-bb98-71f6f50a7642",
                        "entry_id": "26986578-ee19-39f5-b2da-3e2bff2f2fd2",
                        "glosses": [
                            "A task that has been noted as one that must be completed, especially on a list."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b56a7a4-692c-4580-a942-9e696fa876ba",
                                "sense_id": "063e8a5a-dfb6-3f0c-bb98-71f6f50a7642",
                                "text": "My to-do list has been growing longer every day."
                            },
                            {
                                "example_id": "7962f2d0-7ba8-4cbe-beab-1965265c9866",
                                "sense_id": "063e8a5a-dfb6-3f0c-bb98-71f6f50a7642",
                                "text": "I have so many to-dos, I don't know where to start."
                            }
                        ]
                    }
                ],
