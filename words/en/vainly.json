{
    "word_family": [
        "vain",
        "vanity",
        "vainglorious",
        "vainglory"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "278ae72d-9e18-385d-a8d7-aece6c5d64c4",
                    "sense_definition": "Without success or positive result; to no avail.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "futile",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She searched <w>vainly</w> for her lost keys in the dark garden.",
                            "target_lang_translations": {
                                "ru": "Она <w>тщетно</w> искала потерянные ключи в тёмном саду."
                            }
                        },
                        {
                            "text": "The doctor tried <w>vainly</w> to revive the injured patient.",
                            "target_lang_translations": {
                                "ru": "Врач <w>напрасно</w> пытался реанимировать пострадавшего пациента."
                            }
                        }
                    ],
                    "synonyms": [
                        "in vain"
                    ],
                    "antonyms": [
                        "successfully"
                    ],
                    "common_phrases": [
                        "tried vainly",
                        "struggled vainly",
                        "searched vainly"
                    ],
                    "target_lang_definitions": {
                        "ru": "Без успеха, положительного результата; напрасно, безуспешно."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тщетно",
                                "target_lang_sense_clarification": "безрезультатно, безуспешно"
                            },
                            {
                                "target_lang_word": "напрасно",
                                "target_lang_sense_clarification": "без достижения желаемого результата"
                            },
                            {
                                "target_lang_word": "безуспешно",
                                "target_lang_sense_clarification": "не увенчавшись успехом"
                            },
                            {
                                "target_lang_word": "зря",
                                "target_lang_sense_clarification": "разговорное; впустую"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f44dbb96-716a-3a97-ab57-4c6d631c49e4",
                    "sense_definition": "With excessive pride or self-satisfaction in one's appearance or abilities.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "conceited",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He stared <w>vainly</w> at his reflection in the shop window.",
                            "target_lang_translations": {
                                "ru": "Он <w>самовлюблённо</w> разглядывал своё отражение в витрине магазина."
                            }
                        },
                        {
                            "text": "She <w>vainly</w> boasted about her wealth to anyone who would listen.",
                            "target_lang_translations": {
                                "ru": "Она <w>тщеславно</w> хвасталась своим богатством перед каждым, кто был готов слушать."
                            }
                        }
                    ],
                    "antonyms": [
                        "humbly",
                        "modestly"
                    ],
                    "target_lang_definitions": {
                        "ru": "С чрезмерной гордостью или самодовольством по поводу своей внешности или способностей."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тщеславно",
                                "target_lang_sense_clarification": "высокомерно, кичливо"
                            },
                            {
                                "target_lang_word": "самовлюблённо",
                                "target_lang_sense_clarification": "с упоением собой"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}