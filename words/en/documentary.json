{
    "word_family": [
        "document",
        "documentation",
        "documentalist"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "885c35f8-6473-3506-89a8-07dba106d956",
                    "sense_definition": "A film, television program, or publication that presents a real subject in a factual and informative way.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "film_genre",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We watched a fascinating <w>documentary</w> about marine life last night.",
                            "target_lang_translations": {
                                "ru": "Вчера вечером мы смотрели увлекательный <w>документальный фильм</w> о морской жизни.",
                                "zh": "昨晚我们看了一部关于海洋生物的精彩<w>纪录片</w>。"
                            }
                        },
                        {
                            "text": "The director won an award for his latest <w>documentary</w> on climate change.",
                            "target_lang_translations": {
                                "ru": "Режиссёр получил награду за свой последний <w>документальный фильм</w> об изменении климата.",
                                "zh": "这位导演凭借他最新的气候变化<w>纪录片</w>获得了一个奖项。"
                            }
                        }
                    ],
                    "antonyms": [
                        "fiction"
                    ],
                    "common_phrases": [
                        "nature documentary",
                        "television documentary",
                        "watch a documentary",
                        "short documentary"
                    ],
                    "target_lang_definitions": {
                        "ru": "Фильм, телепередача или публикация, представляющие реальную тему в фактической и информативной манере.",
                        "zh": "以事实和信息为基础，呈现真实主题的电影、电视节目或出版物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "документальный фильм",
                                "target_lang_sense_clarification": "кинолента"
                            },
                            {
                                "target_lang_word": "документалка",
                                "target_lang_sense_clarification": "разговорное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "纪录片",
                                "target_lang_sense_clarification": "指电影或电视节目"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "91be00ec-6f50-34ad-8602-9442a64d136f",
                    "sense_definition": "The genre of films or television programs that deal with real people and events.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "film_genre",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is studying the history of <w>documentary</w> at the film academy.",
                            "target_lang_translations": {
                                "ru": "Она изучает историю <w>документалистики</w> в киноакадемии.",
                                "zh": "她正在电影学院学习<w>纪录片</w>史。"
                            }
                        },
                        {
                            "text": "This festival is dedicated entirely to the art of <w>documentary</w>.",
                            "target_lang_translations": {
                                "ru": "Этот фестиваль полностью посвящён искусству <w>документального кино</w>.",
                                "zh": "这个电影节完全致力于<w>纪录片</w>艺术。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "documentary filmmaking",
                        "documentary photographer"
                    ],
                    "target_lang_definitions": {
                        "ru": "Жанр фильмов или телепередач, рассказывающих о реальных людях и событиях.",
                        "zh": "涉及真实人物和事件的电影或电视节目类型。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "документалистика",
                                "target_lang_sense_clarification": "жанр"
                            },
                            {
                                "target_lang_word": "документальное кино",
                                "target_lang_sense_clarification": "сфера деятельности"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "纪录片制作",
                                "target_lang_sense_clarification": "指艺术或行业领域"
                            },
                            {
                                "target_lang_word": "纪录片艺术",
                                "target_lang_sense_clarification": "指作为一种艺术形式"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "323f327c-1e6f-3e76-9ca4-fc0048bea47e",
                    "sense_definition": "Presented in an objective and factual manner, without fictional elements.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The book provides a <w>documentary</w> account of the war.",
                            "target_lang_translations": {
                                "ru": "Книга представляет собой <w>документальный</w> отчёт о войне.",
                                "zh": "这本书提供了关于那场战争的<w>纪录性</w>叙述。"
                            }
                        },
                        {
                            "text": "He prefers <w>documentary</w> films over action movies.",
                            "target_lang_translations": {
                                "ru": "Он предпочитает <w>документальные</w> фильмы боевикам.",
                                "zh": "比起动作片，他更喜欢<w>纪录片</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "documentary film",
                        "documentary style",
                        "documentary series"
                    ],
                    "target_lang_definitions": {
                        "ru": "Представленный в объективной и фактической манере, без вымышленных элементов.",
                        "zh": "以客观和事实的方式呈现，不含虚构成分。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "документальный",
                                "target_lang_sense_clarification": "основанный на фактах"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "纪录性的",
                                "target_lang_sense_clarification": "形容词，描述风格或叙述"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "995422d3-2b96-3a1d-b2ec-62c44f53e336",
                    "sense_definition": "Consisting of, related to, or derived from written documents.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lawyer submitted <w>documentary</w> evidence to the court.",
                            "target_lang_translations": {
                                "ru": "Адвокат представил суду <w>документальные</w> доказательства.",
                                "zh": "律师向法庭提交了<w>书面</w>证据。"
                            }
                        },
                        {
                            "text": "Historians rely on <w>documentary</w> sources to reconstruct the past.",
                            "target_lang_translations": {
                                "ru": "Историки полагаются на <w>документальные</w> источники для реконструкции прошлого.",
                                "zh": "历史学家依靠<w>文献</w>来源来重构过去。"
                            }
                        }
                    ],
                    "synonyms": [
                        "documentational"
                    ],
                    "common_phrases": [
                        "documentary evidence",
                        "documentary proof",
                        "documentary credit"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состоящий из письменных документов, относящийся к ним или полученный из них.",
                        "zh": "由书面文件组成、与书面文件相关或源自书面文件。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "документальный",
                                "target_lang_sense_clarification": "относящийся к документам"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "书面文件的",
                                "target_lang_sense_clarification": "指证据或来源"
                            },
                            {
                                "target_lang_word": "文献的",
                                "target_lang_sense_clarification": "指学术或法律语境"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}