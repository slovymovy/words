                                        "entry_id": "f781da98-705b-35e6-a64f-4269cacb3445",
                                        "glosses": [
                                            "Gesamtwerk, Lebensleistung eines Menschen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e923655e-449f-4844-a449-13ad96db293c",
                                                "sense_id": "e41afbd9-1b31-33e1-8170-c3621adb2bfc",
                                                "text": "„Es ist eine Chance für ihn, sein Lebenswerk zu krönen.“"
                                            },
                                            {
                                                "example_id": "69e6bbb4-7ba7-4eae-a0cf-217c0ccab71a",
                                                "sense_id": "e41afbd9-1b31-33e1-8170-c3621adb2bfc",
                                                "text": "„Dieser Tag zertrümmerte Giacomo Bertinis Lebenswerk auf einen Streich.“"
                                            },
                                            {
                                                "example_id": "cd7e5564-bfd9-40d9-bb05-7faac8478e5e",
                                                "sense_id": "e41afbd9-1b31-33e1-8170-c3621adb2bfc",
                                                "text": "„Die Hauptpfeiler seines Lebenswerks waren nun vollendet und wurden der wissenschaftlichen Welt angeboten.“"
                                            },
                                            {
                                                "example_id": "ae699761-3ce0-495f-a535-7bebe0808b70",
                                                "sense_id": "e41afbd9-1b31-33e1-8170-c3621adb2bfc",
                                                "text": "„Er hatte zwei Bücher geschrieben, die an Umfang und Bedeutung beinahe ein Lebenswerk ausmachten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
