                "senses": [
                    {
                        "sense_id": "777110d2-84ef-31fb-9357-c57e10901d62",
                        "entry_id": "499b4043-5ae4-323a-b72f-1920557e7331",
                        "glosses": [
                            "Bezeichnung einer bestimmten (natürlichen) Person"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6cf7494d-01aa-4698-be97-7ae99d5743b5",
                                "sense_id": "777110d2-84ef-31fb-9357-c57e10901d62",
                                "text": "„Auf dem Gebiet der Anthroponyme dominieren mit großem Abstand die Untersuchungen zu den Personennamen und den Familiennamen.“"
                            },
                            {
                                "example_id": "e9f7bb33-33ab-4b25-bd0d-bac94cdf9355",
                                "sense_id": "777110d2-84ef-31fb-9357-c57e10901d62",
                                "text": "„In späteren Fassungen finden sich 1500 Ortsnamen und mehr als 3500 Personennamen.“"
                            },
                            {
                                "example_id": "f2f21da9-896a-4c93-bb23-7669ac476bf1",
                                "sense_id": "777110d2-84ef-31fb-9357-c57e10901d62",
                                "text": "„Die Zusammensetzung der Personennamen läßt auch ein Prinzip der germanischen Rufnamengebung erkennen.“"
                            },
                            {
                                "example_id": "c0a9b04b-b6f6-4f73-af5d-1cb5b63c9ec3",
                                "sense_id": "777110d2-84ef-31fb-9357-c57e10901d62",
                                "text": "„Eine Hervorhebung des Personennamens ist nicht zu empfehlen, wenn die Zusammensetzung zu einer Gattungsbezeichnung geworden ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "bb60ea90-95bf-3282-b0a9-d227a5449163",
                        "entry_id": "499b4043-5ae4-323a-b72f-1920557e7331",
                        "glosses": [
                            "der Teil von [1], der nicht die Familie oder einen Elternteil bezeichnet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f66147d-d6d1-43ed-bfe8-0eda64e26cf9",
                                "sense_id": "bb60ea90-95bf-3282-b0a9-d227a5449163",
                                "text": "„JJ“ ist als Personenname nicht geeignet."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "68eb9a62-0fc7-4603-81de-080726275c79",
