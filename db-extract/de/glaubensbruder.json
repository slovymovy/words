                ],
                "senses": [
                    {
                        "sense_id": "b602bdab-7ae4-3d23-8116-260fcbc2009e",
                        "entry_id": "5117130f-215e-3647-ac29-bc437c3d83e2",
                        "glosses": [
                            "jemand, der dem gleichen Glauben anhängt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "959a82ce-2445-4935-9d2e-b43a21700944",
                                "sense_id": "b602bdab-7ae4-3d23-8116-260fcbc2009e",
                                "text": "„Der konnte rechtzeitig fliehen und versammelt seine letzten Truppen nun in Marokko, nahe der Grenze zu Algerien; der dortige Sultan gewährt dem Glaubensbruder Asyl.“"
                            },
                            {
                                "example_id": "7c62d17a-3be4-492b-a34e-666b8363f59b",
                                "sense_id": "b602bdab-7ae4-3d23-8116-260fcbc2009e",
                                "text": "„Eigentlich ist es für einen seiner Glaubensbrüder gedacht, der vor ein paar Tagen gestürzt ist und sich jetzt im Krankenhaus behandeln lassen muss.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6d3122d3-e47d-430a-9197-f827db648f4d",
                        "source_entry_id": "5117130f-215e-3647-ac29-bc437c3d83e2",
                        "source_sense_id": "b602bdab-7ae4-3d23-8116-260fcbc2009e",
                        "source_sense_description": "jemand, der dem gleichen Glauben anhängt",
                        "target_lang_word": "coreligionist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "coreligionist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4640660f-09ca-353c-bdcb-865a85b7de5e",
                                        "entry_id": "c3b22583-fbe8-3b68-b2df-1a2ca9babd10",
                                        "glosses": [
                                            "Alternative spelling of co-religionist."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1edaf8ea-c6da-4897-9c4c-80f1b7c0ffe5",
                        "source_entry_id": "5117130f-215e-3647-ac29-bc437c3d83e2",
                        "source_sense_id": "b602bdab-7ae4-3d23-8116-260fcbc2009e",
                        "source_sense_description": "jemand, der dem gleichen Glauben anhängt",
                        "target_lang_word": "co-religionist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "co-religionist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bc132601-a905-3bae-829b-c813031fc927",
                                        "entry_id": "c4d53e8c-f118-310e-bcb3-ab739c92f1cf",
                                        "glosses": [
                                            "A fellow follower of one's religion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91b585bd-b2d0-4d55-91ae-fb07288919fb",
                                                "sense_id": "bc132601-a905-3bae-829b-c813031fc927",
                                                "text": "From the mid-sixteenth century, Western Christians – Protestants as well as Roman Catholics, thanks to the great split of the Reformation – interested themselves afresh in their afflicted co-religionists in the East."
                                            },
                                            {
                                                "example_id": "1f770d2a-1d35-4c23-854b-f0420ea2bfdd",
                                                "sense_id": "bc132601-a905-3bae-829b-c813031fc927",
                                                "text": "Moreover, the greater charitability of religious people in studies is accounted for by their contributing more to coreligionists, and the bulk of the charitability of highly religious people in the real world consists of charity to their own group."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ed52982b-dc17-462c-be96-48a7de7a969a",
                        "source_entry_id": "5117130f-215e-3647-ac29-bc437c3d83e2",
                        "source_sense_id": "b602bdab-7ae4-3d23-8116-260fcbc2009e",
                        "source_sense_description": "jemand, der dem gleichen Glauben anhängt",
                        "target_lang_word": "coreligionnaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "coreligionnaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "986e49d3-baf2-3668-aaf3-a7f39b9f150f",
                                        "entry_id": "b02abd28-5bbb-3aee-9b1b-f0881109370b",
                                        "glosses": [
                                            "Celui, celle qui professe la même religion que certains autres."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5093f67-a8f8-4337-b8ca-eb6780bc9034",
                                                "sense_id": "986e49d3-baf2-3668-aaf3-a7f39b9f150f",
                                                "text": "J’évitais de compromettre l’archevèque, en ne lui adressant pas directiment la parole; mais je voyais qu’il se sentait heureux d’entendre la rude philippique que je débitais contre les oppresseurs de ses coreligionnaires."
                                            },
                                            {
                                                "example_id": "568d04b2-a7e7-4c38-8464-4390b12c4b8b",
                                                "sense_id": "986e49d3-baf2-3668-aaf3-a7f39b9f150f",
                                                "text": "L’antisémitisme fait partout des progrès effrayants. En Russie, mes coréligionnaires sont chassés comme des bêtes sauvages. En France, les emplois civils et militaires se ferment aux Juifs. Ils n’ont plus accès dans les cercles aristocratiques. Mon neveu, le jeune Isaac Coblentz, a dû renoncer à la carrière diplomatique, après avoir passé brillamment l’examen d’admission."
                                            },
                                            {
                                                "example_id": "dd4a5e7b-eaea-466f-bab5-8c46cd91a8a4",
                                                "sense_id": "986e49d3-baf2-3668-aaf3-a7f39b9f150f",
                                                "text": "À l’époque, des colons radicaux étaient descendus des collines de Cisjordanie pour prêter main-forte à leurs coreligionnaires, rappelle Ariel Handel, spécialiste des colons à l’université de Tel-Aviv."
                                            },
                                            {
                                                "example_id": "8abfb081-0759-4122-9f17-aa50e735ea72",
                                                "sense_id": "986e49d3-baf2-3668-aaf3-a7f39b9f150f",
                                                "text": "Ce relaps ayant été aperçu par ses coreligionnaires dans la procession de la Fête-Dieu, fut pris à partie par eux. Il s’ensuivit une violente bagarre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f7228a62-93d6-3c89-b4ed-bb8b80385b8c",
                                        "entry_id": "b02abd28-5bbb-3aee-9b1b-f0881109370b",
                                        "glosses": [
                                            "Personne qui soutient les mêmes idées que certains autres."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0b1919a3-21ee-4d86-b4c3-f40bef0f66e9",
                                                "sense_id": "f7228a62-93d6-3c89-b4ed-bb8b80385b8c",
                                                "text": "Sous la conduite d'un passager qui connaissait le terrain, [la duchesse de Berry] se dirigea vers les montagnes boisées …. M. de Caumont accompagna ses coreligionnaires jusqu'aux limites de son domaine."
                                            },
                                            {
                                                "example_id": "c0efd860-1d96-409c-92ac-99bc19c5bd90",
                                                "sense_id": "f7228a62-93d6-3c89-b4ed-bb8b80385b8c",
                                                "text": "L’ex-président socialiste Ricardo Lagos (2001-2005) et son coreligionnaire Sergio Bitar, ministre des Travaux publics, résument le sentiment dominant au sein de la Concertation en parlant de « triomphe mêlé d’avertissement »."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
