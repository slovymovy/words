                        "source_sense_description": "специалист в области ракетостроения, ракетных технологий",
                        "target_lang_word": "missilier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "missilier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "35dde561-00f6-3d94-b217-3811e261e84b",
                                        "entry_id": "c08e28df-9ef2-3e59-ab6a-81dd1c289ad9",
                                        "glosses": [
                                            "Relatif aux missiles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad81a0ac-b863-4c06-87f7-dcb59ae0b825",
                                                "sense_id": "35dde561-00f6-3d94-b217-3811e261e84b",
                                                "text": "La récente disparition du ministre de la défense, Li Shangfu, et la mise à l’écart de généraux de la force missilière soulèvent des interrogations quant au caractère absolu du contrôle des forces armées par le président chinois."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "missilier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2bf053f7-3fd4-3c7a-b9b5-fd0bd615f8c3",
                                        "entry_id": "5effa698-d452-355b-bc0d-336e10ab4b00",
                                        "glosses": [
                                            "Fabricant ou marchand de missiles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "657ca625-6593-4fa3-8d5a-f3db70906573",
                                                "sense_id": "2bf053f7-3fd4-3c7a-b9b5-fd0bd615f8c3",
                                                "text": "Commandé à 200 exemplaires au missilier européen MBDA, ce nouvel armement apportera à la marine française une capacité de tir à longue distance."
                                            },
                                            {
                                                "example_id": "5ef88d05-dca9-4ac3-9a53-545c37d8507f",
                                                "sense_id": "2bf053f7-3fd4-3c7a-b9b5-fd0bd615f8c3",
                                                "text": "Les deux pays ont également confirmé un accord sur l’achat de missiles anti-navire léger (ANL) développé par le missilier européen MBDA, une coentreprise du britannique BAE Systems, de l’européen Airbus Group et de l’italien Finmeccanica."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
