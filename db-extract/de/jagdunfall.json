                "senses": [
                    {
                        "sense_id": "a48a01d4-1c10-3195-9601-d4af3ed9ffd8",
                        "entry_id": "a40a1c57-89cc-335f-9b9e-5448566a4643",
                        "glosses": [
                            "Vorfall während des Jagens auf Wildtiere, bei dem Personen zu Schaden kommen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1bec0173-8bcb-4196-be66-b8d2b2f937ff",
                                "sense_id": "a48a01d4-1c10-3195-9601-d4af3ed9ffd8",
                                "text": "„Er ist bei einem tragischen Jagdunfall ums Leben gekommen.«“"
                            },
                            {
                                "example_id": "d2a01764-0ced-4f2d-a77f-2a4731e6c6f8",
                                "sense_id": "a48a01d4-1c10-3195-9601-d4af3ed9ffd8",
                                "text": "„Am Nachbartisch saßen zwei einheimische Männer, die sich über den Jagdunfall am Steinbruch unterhielten.“"
                            },
                            {
                                "example_id": "edf74856-78c3-4ba0-8e18-26a0cc8b988d",
                                "sense_id": "a48a01d4-1c10-3195-9601-d4af3ed9ffd8",
                                "text": "„Wie kann das denn ein Jagdunfall sein?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
