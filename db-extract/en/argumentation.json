                                            {
                                                "example_id": "c4075b8c-1787-46fe-b7ba-094da3bbafdc",
                                                "sense_id": "1716dbd6-1828-31ec-a681-deea2ad31d3b",
                                                "text": "Omdat de leerling een goede argumentatie gaf, veranderde de leraar het cijfer voor het proefwerk van een 6 in een 7."
                                            },
                                            {
                                                "example_id": "03b6b861-034d-4b09-8c6d-573a1183cbcd",
                                                "sense_id": "1716dbd6-1828-31ec-a681-deea2ad31d3b",
                                                "text": "Met een goede argumentatie kun je mij altijd overtuigen van mijn ongelijk."
                                            },
                                            {
                                                "example_id": "28baf6e0-154c-46f9-9075-c0232f484988",
                                                "sense_id": "1716dbd6-1828-31ec-a681-deea2ad31d3b",
                                                "text": "De zinnen liepen niet en de argumentatie had meer weg van gatenkaas."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
