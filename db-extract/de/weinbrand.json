                ],
                "senses": [
                    {
                        "sense_id": "63fe5a5d-ec3c-3972-a33f-ef2991aeae56",
                        "entry_id": "c4f81e82-2d2b-3e2d-85a8-5a23fe5f89a0",
                        "glosses": [
                            "ein aus Wein durch Destillation hergestellter Branntwein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0826d82b-5b24-4e7d-a9b2-65139fd424c8",
                                "sense_id": "63fe5a5d-ec3c-3972-a33f-ef2991aeae56",
                                "text": "Weinbrand ist etwas für Genießer."
                            },
                            {
                                "example_id": "21cfac52-cdd3-41e2-ac1e-2bb5c1fb5329",
                                "sense_id": "63fe5a5d-ec3c-3972-a33f-ef2991aeae56",
                                "text": "„Den Weinbrand hat Janosch zu Hause ausgetrunken und sich sofort an die Arbeit gemacht.“"
                            },
                            {
                                "example_id": "61583794-ff33-4d24-ae50-eb6bd887d297",
                                "sense_id": "63fe5a5d-ec3c-3972-a33f-ef2991aeae56",
                                "text": "„Früher war es wohl eine große Villa mit Fabrikhof, heute ist der Betrieb ein weltweit bekanntes Unternehmen nicht nur für Weinbrand und Schnapspralinen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
