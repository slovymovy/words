                    {
                        "translation_id": "11edf1f2-0a7e-4aa2-98a6-ced5033687f0",
                        "source_entry_id": "800174d4-242e-3bee-b6f4-78069e4ca1e1",
                        "source_sense_id": "77acd194-6552-34e1-b3a0-5e6611b09875",
                        "source_sense_description": "male given name",
                        "target_lang_word": "Ulrich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ulrich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5fd266b5-fec6-362e-ab27-361c81d13d1c",
                                        "entry_id": "fb291be0-1cac-3722-99a5-d194822e469d",
                                        "glosses": [
                                            "männlicher Vorname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c74cad2b-8784-428c-ae7e-901aa78da98a",
                                                "sense_id": "5fd266b5-fec6-362e-ab27-361c81d13d1c",
                                                "text": "„Die Parallelaktion steht in Gestalt einer einflußreichen Dame von unbeschreiblicher geistiger Anmut bereit, Ulrich zu verschlingen.“ Robert Musil, Der Mann ohne Eigenschaften, Kapitelüberschrift"
                                            },
                                            {
                                                "example_id": "5b076100-615f-4a77-8020-adaa33818930",
                                                "sense_id": "5fd266b5-fec6-362e-ab27-361c81d13d1c",
                                                "text": "„Dass Audi-Entwicklungschef Ulrich Hackenberg bekennender TT-Fan ist, dürfte hinlänglich bekannt sein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Ulrich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d894edbf-6419-3bc0-808c-5626725baeb6",
                                        "entry_id": "19dbc199-21a3-328f-ab0c-95b0cd4366ce",
                                        "glosses": [
                                            "deutscher Nachname, Familienname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81e536e1-5624-4dc5-aa4d-f8b07adde3b1",
                                                "sense_id": "d894edbf-6419-3bc0-808c-5626725baeb6",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Ulrich kommt, geht der Herr Ulrich.“"
                                            },
                                            {
                                                "example_id": "60ddd4c8-50f8-4e62-8c72-76c94da5fff7",
                                                "sense_id": "d894edbf-6419-3bc0-808c-5626725baeb6",
                                                "text": "Ulrich kommt und geht."
                                            },
                                            {
                                                "example_id": "2d6d3328-fe21-46e8-bad4-bcf911737abe",
                                                "sense_id": "d894edbf-6419-3bc0-808c-5626725baeb6",
                                                "text": "Frau Ulrich ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "ebb66810-ec01-4a8a-b5b6-c7a57c03ef87",
                                                "sense_id": "d894edbf-6419-3bc0-808c-5626725baeb6",
                                                "text": "Herr Ulrich wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "62e6d002-fb4a-4769-be94-552da1ade613",
                                                "sense_id": "d894edbf-6419-3bc0-808c-5626725baeb6",
                                                "text": "Die Ulrichs fliegen heute nach La Paz."
                                            },
                                            {
                                                "example_id": "01cbbf4b-f432-4259-8b33-1183df7f9a95",
                                                "sense_id": "d894edbf-6419-3bc0-808c-5626725baeb6",
                                                "text": "Der Ulrich trägt nie die Schals, die die Ulrich ihm strickt."
                                            },
                                            {
                                                "example_id": "1b261a14-8102-44c6-bde3-450210e326d7",
                                                "sense_id": "d894edbf-6419-3bc0-808c-5626725baeb6",
                                                "text": "Ulrichs kamen, sahen und siegten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
