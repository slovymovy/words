                "senses": [
                    {
                        "sense_id": "90346778-222b-3c7d-b140-7b9e884749c6",
                        "entry_id": "3f04073f-865c-33bd-86ef-12fe855df744",
                        "glosses": [
                            "специалист в области географии"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a0d8a9f-ec38-4b8d-803e-e983e82ab5e7",
                                "sense_id": "90346778-222b-3c7d-b140-7b9e884749c6",
                                "text": "Древнегреческий географ и историк Страбон писал о Закавказье: «Равнину населяют те из иберов, которые более занимаются земледелием и склонны к мирной жизни, снаряжаясь по-армянски и по-мидийски, а горную часть занимает воинственное большинство, в образе жизни сходное со скифами и сарматами…»"
                            }
                        ]
                    },
                    {
                        "sense_id": "16cf5aac-d30d-3be6-ba3c-6832d333b234",
                        "entry_id": "3f04073f-865c-33bd-86ef-12fe855df744",
                        "glosses": [
                            "школьн. учитель географии"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "eb57f9d1-125c-4775-98d7-82c4c4e505d4",
                        "source_entry_id": "3f04073f-865c-33bd-86ef-12fe855df744",
                        "target_lang_word": "geographer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "geographer",
