                                        "glosses": [
                                            "тот, кто играет в гандбол"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8eb65c9b-e28c-4035-b2c7-f0d169bd3054",
                                                "sense_id": "04df84b6-0ce6-3fb0-a08b-aadd32523e47",
                                                "text": "Расстрелять полевого игрока в рамке два на три метра в большинстве случаев способен даже начинающий гандболист."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "35ef76c9-05cf-3a02-82c1-ea700059ddaa",
