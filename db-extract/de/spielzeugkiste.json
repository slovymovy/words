                "senses": [
                    {
                        "sense_id": "53bd19ed-4df0-312c-85c1-8f93e151435c",
                        "entry_id": "04a71cd1-c3b0-37f8-9544-3aae4242a7c6",
                        "glosses": [
                            "Kiste zur Aufbewahrung von Spielzeugen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "58defb0f-da82-4184-8f6b-870a9175f2fe",
                                "sense_id": "53bd19ed-4df0-312c-85c1-8f93e151435c",
                                "text": "„Er hatte die Bücher seiner eigenen Wahl gelesen und sie auf dem Boden einer alten Spielzeugkiste versteckt.“"
                            },
                            {
                                "example_id": "6d2124e5-dc08-4e86-90f1-e8fbaa018588",
                                "sense_id": "53bd19ed-4df0-312c-85c1-8f93e151435c",
                                "text": "„Neben dem Platz der Mutter steht für diese gut erreichbar - eine gelbe Spielzeugkiste aus Kunststoff, die die Bilderbücher und Stoffbären enthält.“"
                            },
                            {
                                "example_id": "27dc3b98-fbf9-4b0b-9ec8-b9cf1a7eaf96",
                                "sense_id": "53bd19ed-4df0-312c-85c1-8f93e151435c",
                                "text": "„Elma küsste seine dicken Backen und drückte ihn an sich, doch als Ađalheiđur die Spielzeugkiste auf den Boden stellte, fing er an zu zappeln und wollte wieder runter.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
