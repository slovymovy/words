                        "entry_id": "b30cc346-f9cd-314a-9209-4125950e64a5",
                        "glosses": [
                            "Unintentionally."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "42cdbb84-a1d5-459b-8954-46d57d6d52f8",
                                "sense_id": "20f45ce7-a0e9-3d76-b556-185c4ddfda73",
                                "text": "All unmeaningly I started a little argument that furnished you with some splendid discussions, and, though my name wasn't mentioned, I'll admit it."
                            }
