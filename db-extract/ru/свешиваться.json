                "senses": [
                    {
                        "sense_id": "3d803bff-cf5d-3dea-a06b-f9d577238372",
                        "entry_id": "5e8b1040-6009-367d-acdb-7f06b3ec1d90",
                        "glosses": [
                            "находиться в положении, при котором одна часть держится вверху, а другая свободно висит внизу; закрепившись вверху, держась на весу, опускаться книзу"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7eca74a2-1ff0-431e-baa4-504bd9a81059",
                                "sense_id": "3d803bff-cf5d-3dea-a06b-f9d577238372",
                                "text": "Свешиваться через перила."
                            },
                            {
                                "example_id": "21c7f117-0c1b-4d77-b721-0d9f4c4566b2",
                                "sense_id": "3d803bff-cf5d-3dea-a06b-f9d577238372",
                                "text": "Цветы шпалерами тянулись вдоль стен, заслоняя окна, свешивались с потолка, вились по углам, так что комната походила больше на оранжерею, чем на жилое помещение."
                            }
                        ]
                    },
                    {
                        "sense_id": "172f2a68-51e3-337b-b6ef-9ad12a6fc19c",
                        "entry_id": "5e8b1040-6009-367d-acdb-7f06b3ec1d90",
                        "glosses": [
                            "перен. низко склоняться, опускаться"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2dbd260d-5d11-4b31-8e1c-6dad63662780",
                                "sense_id": "172f2a68-51e3-337b-b6ef-9ad12a6fc19c",
                                "text": "Светильня страшно нагорела и стала свешиваться с подсвечника."
                            }
                        ]
                    },
                    {
                        "sense_id": "019abc30-88ab-3ffc-8574-332e337bc169",
                        "entry_id": "5e8b1040-6009-367d-acdb-7f06b3ec1d90",
                        "glosses": [
                            "страд. к свешивать"
                        ],
                        "tags": [],
                        "examples": []
                    }
