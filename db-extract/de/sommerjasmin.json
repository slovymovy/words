                        "sense_id": "08f4c177-cbe6-3f68-90a5-7b0f947603ac",
                        "entry_id": "91723b9a-3dda-32e4-8dc2-a8d1e11cba8b",
                        "glosses": [
                            "eine Pflanzenart aus der Familie Hortensiengewächse (Hydrangeaceae), deren Blüten stark nach Jasmin duften"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "42fd58e7-7b7f-46be-81b9-515db80cb38b",
                                "sense_id": "08f4c177-cbe6-3f68-90a5-7b0f947603ac",
                                "text": "Der Sommerjasmin wird häufig mit dem eigentlichen Jasmin verwechselt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cc36610b-50c6-4022-8356-db3f872ecfe8",
                        "source_entry_id": "91723b9a-3dda-32e4-8dc2-a8d1e11cba8b",
                        "source_sense_id": "08f4c177-cbe6-3f68-90a5-7b0f947603ac",
                        "target_lang_word": "seringa",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "seringa",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2ab1faf0-6236-3d24-9ecd-f5f94ef553c0",
                                        "entry_id": "19c8dcd7-c719-383b-bed2-8066702cd7fb",
                                        "glosses": [
                                            "Arbrisseau de la famille des Hydrangeaceae, qui porte, au printemps, des fleurs blanches dont l’odeur est très forte."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac4cf1f5-1a87-4cb9-a598-aa4a22759772",
                                                "sense_id": "2ab1faf0-6236-3d24-9ecd-f5f94ef553c0",
                                                "text": "Soudain, au bord du bassin, nous vîmes un petit chat qui buvait. Nous nous dissimulâmes derrière une touffe de seringas."
                                            },
                                            {
                                                "example_id": "fd193657-f705-4ec5-8aa8-841060656b9b",
                                                "sense_id": "2ab1faf0-6236-3d24-9ecd-f5f94ef553c0",
                                                "text": "Nous fîmes quelques pas incertains hors de la zone du clair de lune, vers le bosquet de grenadiers et de seringas."
                                            },
                                            {
                                                "example_id": "880054a7-b038-4b40-a544-201056fe912c",
                                                "sense_id": "2ab1faf0-6236-3d24-9ecd-f5f94ef553c0",
                                                "text": "Vous ne me répondrez pas, j’en ai la certitude. Mais vous saurez que dans un coin de la France, au fond d’un jardin qui, ce matin, sent bon le seringa, une amie pense à vous."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
