                    {
                        "sense_id": "695396c8-8b2d-3e1a-986b-a69e3f4757f5",
                        "entry_id": "aa4aef95-53ad-3321-aae0-6a29fa56308c",
                        "glosses": [
                            "(durch bestimmte Eigenschaften abzugrenzender/gekennzeichneter) Teil einer Straße"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "143f3237-8351-4fa0-9669-05a1acee6252",
                                "sense_id": "695396c8-8b2d-3e1a-986b-a69e3f4757f5",
                                "text": "Letzte Woche wurde die Sanierung des direkt an mein Grundstück angrenzenden Straßenstückes offiziell beendet."
                            },
                            {
                                "example_id": "9cd31051-626e-422a-8992-1f4abc6b9072",
                                "sense_id": "695396c8-8b2d-3e1a-986b-a69e3f4757f5",
                                "text": "„Beim Straßefegen kam nicht selten Trude, eine der drei Nachbarstöchter mit charmantem Blick und der Bitte zu mir, auch das Straßenstück zu reinigen, für das sie zu sorgen hatte.“"
                            }
                        ],
