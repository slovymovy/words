                "senses": [
                    {
                        "sense_id": "589237d9-4c33-3730-b785-ffbe8e1a6555",
                        "entry_id": "37237561-256e-3681-8108-ad8de1bb0b2b",
                        "glosses": [
                            "jüngerer Mensch, der ein auffälliges Konsumverhalten aufweist und an Konsumsucht leidet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e04c653e-8880-4da2-b7af-a0bd5116b947",
                                "sense_id": "589237d9-4c33-3730-b785-ffbe8e1a6555",
                                "text": "„Das haben aber die meisten Erwachsenen verlernt.« Hurrelmann schrieb über dieses Thema das Buch Konsumkinder. … »Konsumkinder sind wir heute alle«, erklärt Hurrelmann im Gespräch.“"
                            },
                            {
                                "example_id": "6cafeae0-f4d5-4b89-b14e-09f74e019a69",
                                "sense_id": "589237d9-4c33-3730-b785-ffbe8e1a6555",
                                "text": "„Von manchen gesehen, von anderen per Medien- und Konsumentenerziehung erst herzustellen ist das kritisch-kompetente Medien- und Konsumkind.“"
                            },
                            {
                                "example_id": "7074bb9f-b520-4286-8d39-8dddba0cf8b4",
                                "sense_id": "589237d9-4c33-3730-b785-ffbe8e1a6555",
                                "text": "\"Sie [die Konsumkinder …] sind lebensfroh, konsumfreudig, genußsüchtig und anspruchsvoll.\""
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
