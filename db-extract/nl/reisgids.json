                "senses": [
                    {
                        "sense_id": "e323ddfe-6c57-336f-88b2-87ed902c87c2",
                        "entry_id": "0f4001ac-1ea2-3f7a-ae35-de155ba21341",
                        "glosses": [
                            "een document met informatie gericht op een toerist of reiziger"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "65e49117-a571-49c9-b294-ad7b82624ecd",
                                "sense_id": "e323ddfe-6c57-336f-88b2-87ed902c87c2",
                                "text": "Piet kocht vlak voor zijn reis naar Rusland een reisgids waarin onder meer het Rode Plein stond beschreven."
                            },
                            {
                                "example_id": "dccbae21-8ac6-4924-87cf-8ca926387037",
                                "sense_id": "e323ddfe-6c57-336f-88b2-87ed902c87c2",
                                "text": "Ik citeer hier de Lonely Planet en hoewel het proza van deze reisgids in staat zou zijn om zelfs de Gazastrook nog op te leuken (‘the locals are very passionate’) moet gezegd worden: die Malediven zien er verdomd mooi uit."
                            }
                        ]
                    },
                    {
                        "sense_id": "93efcf42-096e-3d95-9cd5-b79cd5736e74",
                        "entry_id": "0f4001ac-1ea2-3f7a-ae35-de155ba21341",
                        "glosses": [
                            "iemand die reizigers begeleidt"
                        ],
                        "tags": [
                            "beroep"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ab0cfda4-a290-4fbe-bb67-54b21c8ff8f4",
                        "source_entry_id": "0f4001ac-1ea2-3f7a-ae35-de155ba21341",
                        "source_sense_id": "e323ddfe-6c57-336f-88b2-87ed902c87c2",
                        "source_sense_description": "een document met informatie gericht op een toerist of reiziger",
                        "target_lang_word": "Reiseführer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Reiseführer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8961b7d6-62c3-3c86-bb7f-9457694618da",
                                        "entry_id": "66e8e287-7489-3b21-bfa8-424e68811865",
                                        "glosses": [
                                            "Person, die Reisende informiert und gegebenenfalls betreut"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "06b1e227-616e-4c43-adc8-f7eb4e44318b",
                                                "sense_id": "8961b7d6-62c3-3c86-bb7f-9457694618da",
                                                "text": "Der Reiseführer war sehr kompetent und stets hilfsbereit."
                                            },
                                            {
                                                "example_id": "94543d5e-e17a-469c-997d-deee74efd1af",
                                                "sense_id": "8961b7d6-62c3-3c86-bb7f-9457694618da",
                                                "text": "„Der Reiseführer setzte unbeirrt seine Tour fort, und bald darauf betraten wir die Altstadt von Kairo mit ihren vielen Kirchen.“"
                                            },
                                            {
                                                "example_id": "6b81a520-81cf-4d6a-9c7d-c1641926541b",
                                                "sense_id": "8961b7d6-62c3-3c86-bb7f-9457694618da",
                                                "text": "„In der Botschaft in London wurde mir bestätigt, dass ich ohne Begleitung eines offiziellen algerischen Reiseführers keinen Fuß in das Land setzen würde.“"
                                            },
                                            {
                                                "example_id": "7938f6a6-9b9c-4e89-acfd-a4f60b66eb2b",
                                                "sense_id": "8961b7d6-62c3-3c86-bb7f-9457694618da",
                                                "text": "„Innen in der »Porta Nigra« wanderten Reisegruppen herum, und jede Gruppe folgte einer Reiseführerin oder einem Reiseführer.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8542422a-5760-318e-be91-efca5cf8b4c1",
                                        "entry_id": "66e8e287-7489-3b21-bfa8-424e68811865",
                                        "glosses": [
                                            "Publikation mit touristischen Informationen und Tipps für Reisende"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0c1b5e9-a00c-4737-81b9-35d91ed6a72f",
                                                "sense_id": "8542422a-5760-318e-be91-efca5cf8b4c1",
                                                "text": "Ich habe mir einen Reiseführer über Indien gekauft."
                                            },
                                            {
                                                "example_id": "ad61fb38-c263-4b86-ab92-646fe255aa6f",
                                                "sense_id": "8542422a-5760-318e-be91-efca5cf8b4c1",
                                                "text": "„Bei einem Abendessen auf dem Balkon kann ein Mann ja wer weiß was erzählen, seine Beziehungstauglichkeit beweist er erst, wenn er bei vierzig Grad Hitze Mofabenzin durch einen Gartenschlauch aus dem Kanister ansaugt und gleichzeitig zuhört, wie die Frau griechische Sagen aus dem Reiseführer vorliest.“"
                                            },
                                            {
                                                "example_id": "995255de-3f64-4208-85cc-8f711d8945ab",
                                                "sense_id": "8542422a-5760-318e-be91-efca5cf8b4c1",
                                                "text": "„In jedem Reiseführer steht, daß es die berühmteste Burg Polens ist.“"
                                            },
                                            {
                                                "example_id": "fcac05c0-b27e-45ab-9a89-761b2c24656a",
                                                "sense_id": "8542422a-5760-318e-be91-efca5cf8b4c1",
                                                "text": "„Spätestens als der Koblenzer Verleger Karl Baedeker im Jahr 1828 die »Rheinreise von Mainz bis Cöln. Handbuch für Schnellreisende« publizierte und damit die Reihe seiner Reiseführer eröffnete, war Forster widerlegt.“"
                                            },
                                            {
                                                "example_id": "bec52ce9-cf7c-4ea0-858b-80123d1fa7a5",
                                                "sense_id": "8542422a-5760-318e-be91-efca5cf8b4c1",
                                                "text": "„Touristen bewegen sich im Bekannten, in dem, was sie sorgfältig im Reiseführer und im Hotelprospekt studiert haben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "715b970a-2dc4-4eea-905d-6ec4caada39b",
                        "source_entry_id": "0f4001ac-1ea2-3f7a-ae35-de155ba21341",
                        "source_sense_id": "93efcf42-096e-3d95-9cd5-b79cd5736e74",
                        "source_sense_description": "iemand die reizigers begeleidt",
                        "target_lang_word": "Führer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Führer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0bdc7670-9b8d-3349-a6cf-0136a958985d",
                                        "entry_id": "20da6f34-fd96-3cb5-9612-0811de54f08b",
                                        "glosses": [
                                            "leitende Person in einer Organisation, Vereinigung oder Bewegung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "42293485-3b49-4359-af34-97cdca97d430",
                                                "sense_id": "0bdc7670-9b8d-3349-a6cf-0136a958985d",
                                                "text": "„Für die Gewerkschaften und ihre Führer konnte es aber nicht nur um eine wirtschaftspolitische Frage gehen.“"
                                            },
                                            {
                                                "example_id": "3afb4dd9-d8f2-49c0-b7e1-7519a0bbdc1a",
                                                "sense_id": "0bdc7670-9b8d-3349-a6cf-0136a958985d",
                                                "text": "„Als sich die Führer der arabischen Welt vorigen Mittwoch im ägyptischen Scharm-al-Scheich trafen, fehlte Tunesiens Diktator Ben Ali zum ersten Mal in dieser Runde.“"
                                            },
                                            {
                                                "example_id": "be36cada-66dd-4f79-ab30-71477be90244",
                                                "sense_id": "0bdc7670-9b8d-3349-a6cf-0136a958985d",
                                                "text": "„Leutnant Fabian war allerdings ein anderer Führer als Eger.“"
                                            },
                                            {
                                                "example_id": "08400421-5479-4b42-9d31-f1306a3c5cc5",
                                                "sense_id": "0bdc7670-9b8d-3349-a6cf-0136a958985d",
                                                "text": "„1957, vier Jahre nach dem Tod des großen sowjetischen Führers Josef Wissarionowitsch Stalin, bekam das junge Ehepaar Ben Zion Piatov und Sonja Piatova, geborene Suchmann, ihr erstes Kind, meinen Vater Michael.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3059e445-4fff-33ee-9316-de218e5dd6dc",
                                        "entry_id": "20da6f34-fd96-3cb5-9612-0811de54f08b",
                                        "glosses": [
                                            "Person, die Touristen Sehenswürdigkeiten zeigt und erklärt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c19c1ab9-f646-43b5-b603-77cd15a54bb6",
                                                "sense_id": "3059e445-4fff-33ee-9316-de218e5dd6dc",
                                                "text": "Der Führer erzählte etwas über die Geschichte der Kathedrale."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "41b1936a-35a9-39d4-87f4-12c9494fdc2a",
                                        "entry_id": "20da6f34-fd96-3cb5-9612-0811de54f08b",
                                        "glosses": [
                                            "Adolf Hitler, der ab 1934 „Führer und Reichskanzler“ war"
                                        ],
                                        "tags": [
                                            "historical",
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1c6641fb-fddd-47dc-98ee-6bb40fec9de4",
                                                "sense_id": "41b1936a-35a9-39d4-87f4-12c9494fdc2a",
                                                "text": "„»Der Führer wird’s schon schmeißen!« Aber das Schweigen derer, die nichts, gar nichts sagen, ist furchtbar.“"
                                            },
                                            {
                                                "example_id": "72fe60e7-96d2-40eb-aa94-ef3926dc6a4d",
                                                "sense_id": "41b1936a-35a9-39d4-87f4-12c9494fdc2a",
                                                "text": "„In solchen Stadien wurden die Betrunkenen oft streit- und prügelsüchtig, und Klebs war bloß ein Männchen (und ein Feigling dazu), während man es dem alten Persicke selbst jetzt im schlimmsten Verfall ansah, dass er seinem Führer zwei stattliche SS-Männer und einen Schüler der Napola geschenkt hatte.“"
                                            },
                                            {
                                                "example_id": "65935342-b171-4666-b36e-72ea35dcce98",
                                                "sense_id": "41b1936a-35a9-39d4-87f4-12c9494fdc2a",
                                                "text": "„Als der Führer die letzten Worte gesprochen hatte, entsetzte sich der Himmel, denn seine Rede war gewaltig.“"
                                            },
                                            {
                                                "example_id": "b28c41ab-ac5c-4001-8e86-51985039b626",
                                                "sense_id": "41b1936a-35a9-39d4-87f4-12c9494fdc2a",
                                                "text": "„In seinem Bunkerverließ hatte sich der Führer am 30. April gegen halb vier Uhr nachmittags erschossen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "8eba6669-2503-370b-a886-7c62e6937ee0",
                                        "entry_id": "20da6f34-fd96-3cb5-9612-0811de54f08b",
                                        "glosses": [
                                            "die Kurzform von Fahrzeugführer, dem Fahrer eines Fahrzeuges"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9093333a-014c-4194-b8e9-99ad64636443",
                                                "sense_id": "8eba6669-2503-370b-a886-7c62e6937ee0",
                                                "text": "Der Führer des blauen Autos überholte trotz Überholverbots."
                                            },
                                            {
                                                "example_id": "9feca204-ea7e-4565-8588-131b666b0ec7",
                                                "sense_id": "8eba6669-2503-370b-a886-7c62e6937ee0",
                                                "text": "„Eine angemessene Ermäßigung der Fahrgeschwindigkeit ist dem Führer unter folgenden besonderen Umständen vorgeschrieben: […]“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "2730221f-6350-3c12-bba1-49bfff9f217b",
                                        "entry_id": "20da6f34-fd96-3cb5-9612-0811de54f08b",
                                        "glosses": [
                                            "Buch, welches für Besucher eines Museums, einer Stadt, eines Landes und so weiter Hinweise und Erläuterungen enthält"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f8a6240e-1be2-42d0-ad2d-bfd232a928ee",
                                                "sense_id": "2730221f-6350-3c12-bba1-49bfff9f217b",
                                                "text": "Im Führer werden viele Sehenswürdigkeiten der Stadt beschrieben."
                                            },
                                            {
                                                "example_id": "fb6218ff-fca4-4fa6-857b-447a08d31a71",
                                                "sense_id": "2730221f-6350-3c12-bba1-49bfff9f217b",
                                                "text": "„Dem Führer ist die genußreichere Reise in der Richtung von Cöln nach Mainz (stromauf) – wie der Rhein von Norddeutschland aus meistens besucht wird – zugrunde gelegt.“"
                                            },
                                            {
                                                "example_id": "8ae058e3-b4bf-4962-8b15-dde57b5a5749",
                                                "sense_id": "2730221f-6350-3c12-bba1-49bfff9f217b",
                                                "text": "„Papa hatte sich in der Kirche einen kleinen Führer gekauft, und mit dem Führer in der Hand ging er dann die ganze Kirche ab.“"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Führer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1961c92c-cb6b-3ea5-a5c1-1eb798b2b2b6",
                                        "entry_id": "7933b538-b9db-3095-9220-2317b6a26433",
                                        "glosses": [
                                            "deutschsprachiger Nachname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8fc989a8-c2dd-4206-b52e-2efa9dabf189",
                                                "sense_id": "1961c92c-cb6b-3ea5-a5c1-1eb798b2b2b6",
                                                "text": "Herr Führer hat wirklich einen spannenden Vortrag gehalten."
                                            },
                                            {
                                                "example_id": "8368ac14-43fd-4a6e-bdca-a17825643113",
                                                "sense_id": "1961c92c-cb6b-3ea5-a5c1-1eb798b2b2b6",
                                                "text": "Die Führers kommen stets pünktlich."
                                            },
                                            {
                                                "example_id": "20f83f09-76b7-4af4-bfab-12059fe0b234",
                                                "sense_id": "1961c92c-cb6b-3ea5-a5c1-1eb798b2b2b6",
                                                "text": "Der Führer hat einen Unfall gebaut und die Führer hat den Schaden bezahlt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
