                "senses": [
                    {
                        "sense_id": "5e3e6bdd-ab07-3c55-b0e4-6aea1270408d",
                        "entry_id": "aeda0737-6f12-33aa-9914-ec83334a36ba",
                        "glosses": [
                            "Action de dénuder, de mettre à nu."
                        ],
                        "tags": [
                            "Didactique"
                        ],
                        "examples": [
                            {
                                "example_id": "799b27de-6119-42d4-9a58-f529f6941307",
                                "sense_id": "5e3e6bdd-ab07-3c55-b0e4-6aea1270408d",
                                "text": "Leur plus grand dénudage était de retrousser les manches."
                            },
                            {
                                "example_id": "eace5ddf-ff77-41b2-878a-96328b38a004",
                                "sense_id": "5e3e6bdd-ab07-3c55-b0e4-6aea1270408d",
                                "text": "Au rythme de la musique, elle glisse, s’étale et, au bout de quelques secondes, commence un dénudage — peut-on l’appeler autrement? — […] La robe, le cache-sexe, plus petits les uns que les autres, prennent le chemin des écoliers."
                            }
                        ]
                    },
                    {
                        "sense_id": "ffd66e9b-da76-3431-a2c5-b3c75e946a61",
                        "entry_id": "aeda0737-6f12-33aa-9914-ec83334a36ba",
                        "glosses": [
                            "Action d’ôter l’isolant qui recouvre un conducteur électrique."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "13c7b5ea-0ed8-4ca6-9c23-410bccbf52f8",
                                "sense_id": "ffd66e9b-da76-3431-a2c5-b3c75e946a61",
                                "text": "Description de méthodes de dénudage applicables aux cas suivants : dénudage de fils simples et multiples; dénudage des fils isolés par des isolants difficiles à couper; dénudage des conducteurs coaxiaux et blindés recouverts d’une tresse."
                            },
                            {
                                "example_id": "3a25e18b-5acd-4153-8384-5c8d1ebb01eb",
                                "sense_id": "ffd66e9b-da76-3431-a2c5-b3c75e946a61",
                                "text": "La pince à dénuder a été conçue pour rendre le dénudage plus facile et plus rapide."
                            }
                        ]
                    },
                    {
                        "sense_id": "577b3224-f6e1-322a-9fe9-40505e1e9154",
                        "entry_id": "aeda0737-6f12-33aa-9914-ec83334a36ba",
                        "glosses": [
                            "Action d’ôter la couche superficielle d’un béton hydraulique."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "f313e508-e00e-41b5-8ee3-30e5bfdf57b7",
                                "sense_id": "577b3224-f6e1-322a-9fe9-40505e1e9154",
                                "text": "Les techniques les plus couramment utilisées dans le cas des bétons de ciment consistent en un striage transversal, un dénudage du mortier superficiel, ou encore, en un cloutage de la surface de roulement à l’aide de pierrailles."
                            },
                            {
                                "example_id": "3c5a7191-47ad-493f-b2b6-371d143897be",
                                "sense_id": "577b3224-f6e1-322a-9fe9-40505e1e9154",
                                "text": "Procédé de dénudage chimique d’une dalle de béton, suivant lequel on répand à l’aide d’une rampe de pulvérisation sur la dalle de béton fraîchement mise en œuvre, un agent retardateur de prise de surface de béton, et on élimine ultérieurement par brossage avec pulvérisation d’eau sous pression, entre les granulats de surface de la dalle, une couche supérieure de mortier dont la prise a été retardée […]."
                            }
                        ]
                    }
