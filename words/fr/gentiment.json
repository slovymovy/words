                {
                    "sense_id": "719e41d9-3ee1-314b-b957-7962bcda50a3",
                    "sense_definition": "D'une manière aimable, polie et avec bienveillance.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a <w>gentiment</w> accepté de nous aider à porter ces cartons.",
                            "target_lang_translations": {
                                "en": "He <w>kindly</w> agreed to help us carry these boxes.",
                                "ru": "Он <w>любезно</w> согласился помочь нам перенести эти коробки.",
                                "de": "Er hat <w>freundlicherweise</w> zugestimmt, uns beim Tragen dieser Kartons zu helfen.",
                                "es": "Accedió <w>amablemente</w> a ayudarnos a llevar estas cajas.",
                                "zh": "他<w>好心地</w>答应帮我们搬这些纸箱。"
                            }
                        },
                        {
                            "text": "La voisine a <w>gentiment</w> proposé d'arroser nos plantes pendant les vacances.",
                            "target_lang_translations": {
                                "en": "The neighbour <w>kindly</w> offered to water our plants during the holidays.",
                                "ru": "Соседка <w>любезно</w> предложила полить наши растения на время отпуска.",
                                "de": "Die Nachbarin hat <w>freundlicherweise</w> angeboten, unsere Pflanzen während des Urlaubs zu gießen.",
                                "es": "La vecina se ofreció <w>amablemente</w> a regar nuestras plantas durante las vacaciones.",
                                "zh": "邻居<w>亲切地</w>提议假期里帮我们浇花。"
                            }
                        }
                    ],
                    "antonyms": [
                        "méchamment"
                    ],
                    "common_phrases": [
                        "demander gentiment",
                        "répondre gentiment"
                    ],
                    "target_lang_definitions": {
                        "en": "In a friendly, polite and kind way.",
                        "ru": "Дружелюбно, вежливо и с добротой.",
                        "de": "Auf freundliche, höfliche und wohlwollende Art.",
                        "es": "De manera amable, educada y con buena voluntad.",
                        "zh": "以友善、礼貌和善意的方式去做事。"
