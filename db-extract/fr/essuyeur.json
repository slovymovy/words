                                            {
                                                "example_id": "bd2c7fea-6f0a-4e0a-94e1-b680d349353a",
                                                "sense_id": "3d7cb13d-1270-3bcc-a192-2160434fabd6",
                                                "text": "So, Willy, let you and me be wipers / Of scores out with all men — especially pipers!"
                                            }
