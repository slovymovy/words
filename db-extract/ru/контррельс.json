                                            {
                                                "example_id": "f067170a-b05f-44cc-90a7-6683738d2af2",
                                                "sense_id": "5a4b035b-0aba-30e1-94bc-9d33b1815e6d",
                                                "text": "Il faut que l’espace compris entre chaque rail et son contre-rail soit constamment débarrassé des terres et pierres qui viennent s’y loger."
                                            },
                                            {
                                                "example_id": "f81e4e24-639c-4a13-89e1-b2f25d6b3307",
                                                "sense_id": "5a4b035b-0aba-30e1-94bc-9d33b1815e6d",
                                                "text": "Reste à l’équipe « voie » CFBS à poser des contre-rails aux PN ruraux, aménager les abords, reposer les plaques hectométriques et l’identification des ouvrages d’art."
                                            }
