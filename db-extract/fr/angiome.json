                        "entry_id": "7143cc85-d000-3c9c-97f4-327047116cc6",
                        "glosses": [
                            "Tumeur ou tache liée à un développement exagéré et anormal des vaisseaux sanguins au niveau de la peau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "039b4c8d-fa51-4ba5-a332-9e9b645915ea",
                                "sense_id": "68e026dd-0e02-3db4-9612-9481737c79b7",
                                "text": "Angiome caverneux, plan, tubéreux; angiome capillaire, cérébral, cutané, veineux; angiome infectieux."
                            },
                            {
                                "example_id": "84fef4bd-ced0-4fe9-adf4-4c2dac9d383c",
                                "sense_id": "68e026dd-0e02-3db4-9612-9481737c79b7",
                                "text": "Il est vrai que son angiome s'estompe sur le rouge-brun de sa peau."
                            }
                        ]
                    }
