                "entry_id": "4175e61c-3b1f-3563-85c6-ab6c62a6c5e6",
                "word": "scoop",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "1fdd80bb-8ba6-4819-bb56-d9a74e33c146",
