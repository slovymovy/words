                "senses": [
                    {
                        "sense_id": "435506aa-db81-3f6c-8c18-3e89e38449d7",
                        "entry_id": "d32f1de9-49c8-38f4-a231-77fb6d4fc229",
                        "glosses": [
                            "związany z hokejem, dotyczący hokeja"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5c1428b1-5868-4fd9-89a2-22d5ca191b98",
                                "sense_id": "435506aa-db81-3f6c-8c18-3e89e38449d7",
                                "text": "Chłopaki zaciągnęli go do kina, potem Pawełek zdobył bilety na recital Ewy Demarczyk, a potem był mecz hokejowy Polska – NRD, na który poszli całą gromadą i na przemian to wrzeszczeli, to dęli w trąbki, dopingując swojaków"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b4945166-f728-43ee-bef2-1b25c10886de",
                        "source_entry_id": "d32f1de9-49c8-38f4-a231-77fb6d4fc229",
                        "source_sense_id": "435506aa-db81-3f6c-8c18-3e89e38449d7",
                        "target_lang_word": "hockey",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hockey",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "75d37299-48a1-3ab6-8c23-6297cc9b820e",
                                        "entry_id": "a704c0c9-0ef5-30fc-8664-3420f8eef3f4",
                                        "glosses": [
                                            "Feces, excrement."
                                        ],
                                        "tags": [
                                            "US",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0333da1e-d062-465d-a37c-b9b802baada4",
                                                "sense_id": "75d37299-48a1-3ab6-8c23-6297cc9b820e",
                                                "text": "“I thought she'd just gone to pee but I reckon she must be making hockey too.”"
                                            },
                                            {
                                                "example_id": "b24bec03-e33f-4475-8727-83006cb46aa7",
                                                "sense_id": "75d37299-48a1-3ab6-8c23-6297cc9b820e",
                                                "text": "My anger surged back a pace. “Harry Boone is a lickspittle, butt kissing, hunk of horse hockey,” I said precisely."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "hockey",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "14581727-eaba-3144-9fcb-c48cf431b854",
                                        "entry_id": "dd0c7e95-bcda-3775-be20-7575c5d4c1fe",
                                        "glosses": [
                                            "Alternative form of oche."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative",
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b64a4db5-9991-4d3a-8fa5-db28a0ff9c3e",
                                                "sense_id": "14581727-eaba-3144-9fcb-c48cf431b854",
                                                "text": "As has been mentioned, Darts of to-day is essentially a \"public-house game,\" and in pretty nearly every inn, club, or institute where it has a footing (and in which has it not!) will be found minor variations in play and often games that are peculiar to the locality or even to the \"school\" itself. […] And in this domestic circle, at all events, it is thought that this set of Rules will prove a useful guide when taken in conjunction with what has already been said as regards the board, its position, the hockey-line, etc."
                                            },
                                            {
                                                "example_id": "d86b9f2c-da7f-4a3f-8d92-b2aa3da51cc0",
                                                "sense_id": "14581727-eaba-3144-9fcb-c48cf431b854",
                                                "text": "Henry Lewis's body was tense, taut, his toes against the hockey, his right arm raised, his left eye half-closed. With grim intensity, backed by years of practice and experience, he sighted along the steel point, drew his arm back—and let the dart fly."
                                            },
                                            {
                                                "example_id": "b5f37565-d349-4190-bf6c-7aaad8950497",
                                                "sense_id": "14581727-eaba-3144-9fcb-c48cf431b854",
                                                "text": "Small bars would tend to produce short hockeys; the tiny fishing pubs of Yarmouth gave rise to 6ft marks […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "hockey",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "871a16df-b20a-3c19-a24d-70f3aa06cbe0",
                                        "entry_id": "e6bba0d5-3aee-32b7-8794-bbf8cb837c54",
                                        "glosses": [
                                            "Alternative form of hawkey (“harvest supper”)."
                                        ],
