                        "entry_id": "defdb4a3-e1d4-3c83-b5cb-7ed892028569",
                        "glosses": [
                            "Faire une déclaration sociale, fiscale ou autre, à distance, déclarer à distance."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd503dad-aae8-483e-9ec9-8a2d35f7eb85",
                                "sense_id": "a062ac27-5a25-350e-931b-4842e7509a25",
                                "text": "Les entreprises étrangères ont également l'obligation de télé-déclarer et de télé-régler auprès de l'administration fiscale à condition qu'elles détiennent un établissement stable en France et possèdent un compte dans un établissement financier domicilié en France."
                            },
                            {
                                "example_id": "bcdfadc3-453a-4c99-bf7d-01059579a7a3",
                                "sense_id": "a062ac27-5a25-350e-931b-4842e7509a25",
                                "text": "A partir de janvier 2007, vous devrez également télé-déclarer et télé-régler votre TVA par voie électronique via TéléTVA."
                            }
                        ]
                    }
