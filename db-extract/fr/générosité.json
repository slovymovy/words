                                            "Großmut, Edelmut"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d031ff5f-30c6-493e-929b-c6c8c3b99081",
                                                "sense_id": "5ea9b68e-7961-3832-a2b7-01f8170a5c74",
                                                "text": "Generosität zählt leider nicht zu den hervorstechenden Eigenschaften meines Ehemannes."
                                            },
                                            {
                                                "example_id": "8f568494-6b7e-49d2-94d1-8f61ac5f21b7",
                                                "sense_id": "5ea9b68e-7961-3832-a2b7-01f8170a5c74",
                                                "text": "„Danach luden die Gutsherren, dem Brauch zufolge, zu einem Imbiß ein, und Pécuchet entkorkte eine Flasche von seinem Malaga, allerdings weniger aus Generosität als in der Hoffnung, Lobsprüche zu bekommen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
