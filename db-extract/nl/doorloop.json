                                    {
                                        "sense_id": "188ca022-dd3d-3da3-bbfa-f94d03e902cd",
                                        "entry_id": "af6d4730-14c3-3063-a497-8408ddda439d",
                                        "glosses": [
                                            "einzelne Durchführung eines Ablaufs"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6219f38c-c390-4d7b-8451-de57d11e8c0e",
                                                "sense_id": "188ca022-dd3d-3da3-bbfa-f94d03e902cd",
                                                "text": "Die Waschmaschine ist beim Spülen beim ersten Durchlauf"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ee037902-d39f-32d0-9130-30b4acce0e16",
                                        "entry_id": "af6d4730-14c3-3063-a497-8408ddda439d",
                                        "glosses": [
                                            "Stelle, an der etwas durchlaufen kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd8d0e62-4c3c-4597-ad05-834ad5cf88d9",
                                                "sense_id": "ee037902-d39f-32d0-9130-30b4acce0e16",
                                                "text": "Zwischen den beiden Seen befindet sich ein schmaler Durchlauf."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "bd9cc2e1-4c1c-35bc-9bd0-9b529441fb06",
                                        "entry_id": "af6d4730-14c3-3063-a497-8408ddda439d",
                                        "glosses": [
                                            "Zyklus eines zyklischen Prozesses"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "286004f6-531b-4e8b-82bd-29e10dc5297d",
                                                "sense_id": "bd9cc2e1-4c1c-35bc-9bd0-9b529441fb06",
                                                "text": "Der Chor sang einen Kanon und war gerade beim ersten Durchlauf."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "271caa74-336f-359e-9ae8-3c32c88178e7",
                                        "entry_id": "af6d4730-14c3-3063-a497-8408ddda439d",
                                        "glosses": [
                                            "Durchgang eines Objektes vor einem anderen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb300e70-ab46-4a9c-a424-fc45c12cf97b",
                                                "sense_id": "271caa74-336f-359e-9ae8-3c32c88178e7",
                                                "text": "Nach dem ersten Durchlauf sind sich alle einig, dass es gar nicht schlecht war."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "15f494de-f524-35b0-aa80-b1ed4fc2a575",
                                        "entry_id": "af6d4730-14c3-3063-a497-8408ddda439d",
                                        "glosses": [
                                            "eine Durchlaufprobe"
                                        ],
                                        "tags": [
                                            "darstellende Kunst"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2562cf4e-61bb-4a9b-b987-1d1c5a1ce49d",
                                                "sense_id": "15f494de-f524-35b0-aa80-b1ed4fc2a575",
                                                "text": "Beim ersten Durchlauf der Probe zeigte sich, dass man an dieser Stelle den Text anpassen muss."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "0cec26ab-1373-3f29-8ac1-972017fa1ec3",
                                        "entry_id": "af6d4730-14c3-3063-a497-8408ddda439d",
                                        "glosses": [
                                            "Ablaufen eines Programms von Anfang bis Ende"
                                        ],
                                        "tags": [
                                            "EDV"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "58a2e4d2-afd5-4077-a570-c1046702e12c",
                                                "sense_id": "0cec26ab-1373-3f29-8ac1-972017fa1ec3",
                                                "text": "Erst beim dritten Durchlauf des Belastungstest wurde man auf die unpassende Fehlermeldung aufmerksam."
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    },
                                    {
                                        "sense_id": "dd8686ed-f7f9-34b2-a697-8a1fbc7ffdea",
                                        "entry_id": "af6d4730-14c3-3063-a497-8408ddda439d",
                                        "glosses": [
                                            "Materialfluss der Arbeitsgegenstände vom Eintritt bis zum Verlassen eines Betriebes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4be294eb-2df7-4dfc-8494-c2a5701b2738",
                                                "sense_id": "dd8686ed-f7f9-34b2-a697-8a1fbc7ffdea",
                                                "text": "Die Spezialschienen für die Eisenbahn werden in mehreren Durchläufen gefertigt."
                                            }
                                        ],
                                        "sense_index_json": "\"7\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "def56dd5-7bce-429b-9fc2-606c6ec13f3d",
                        "source_entry_id": "d0ae26a5-26f4-34e5-8961-4263ee68cf30",
                        "source_sense_id": "4f090dc6-c81a-3210-a121-ae06d985cc80",
                        "source_sense_description": "(medisch) diarree",
                        "target_lang_word": "Durchfall",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Durchfall",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "407f12d9-728e-3f88-83c8-538d0ad2b1d4",
                                        "entry_id": "0b5b71c7-1f49-3205-803e-d55e7184c4c1",
                                        "glosses": [
                                            "zu schnelle Ausscheidung von breiigem bis flüssigem Stuhl"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9fbe183a-8417-4087-acdb-c3b74b2b5151",
                                                "sense_id": "407f12d9-728e-3f88-83c8-538d0ad2b1d4",
                                                "text": "Bei Magen-Darm-Grippe hat man auch Durchfall."
                                            },
                                            {
                                                "example_id": "b6d8a74c-c555-4573-bdb0-f2d79c7bf8a2",
                                                "sense_id": "407f12d9-728e-3f88-83c8-538d0ad2b1d4",
                                                "text": "„Das mit dem Durchfall störte mich weniger, aber was anderes passierte.“"
                                            },
                                            {
                                                "example_id": "cd25695b-4fea-41fa-8191-47b147860c06",
                                                "sense_id": "407f12d9-728e-3f88-83c8-538d0ad2b1d4",
                                                "text": "„Plötzlich hatte er den Eindruck, Durchfall zu bekommen, und rannte auf die Toilette.“"
                                            },
                                            {
                                                "example_id": "7ba72c70-d774-4511-a45e-3f06179bf743",
                                                "sense_id": "407f12d9-728e-3f88-83c8-538d0ad2b1d4",
                                                "text": "„Bald tritt bei der Kleinen zum Hunger noch ein hartnäckiger Durchfall hinzu.“"
                                            },
                                            {
                                                "example_id": "0487ccd0-e260-4b4b-947b-e375a3dc3643",
                                                "sense_id": "407f12d9-728e-3f88-83c8-538d0ad2b1d4",
                                                "text": "Als Allgemeinarzt kann man ein Lied singen von gehäuft auftretenden Durchfällen im Altenheim."
                                            },
                                            {
                                                "example_id": "82af62d2-e85c-414c-b367-eea6063c88f1",
                                                "sense_id": "407f12d9-728e-3f88-83c8-538d0ad2b1d4",
                                                "text": "„Schwerwiegende Infektionskrankheiten des Magen-Darm-Traktes, die mit blutigen Durchfällen und Fieberschüben einhergingen, waren zu allen Zeiten die gefürchteten Begleiter des Heeres.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b9dad6d1-5d9e-34d6-8002-81ca64953a2d",
                                        "entry_id": "0b5b71c7-1f49-3205-803e-d55e7184c4c1",
                                        "glosses": [
                                            "Misserfolg; das Scheitern beispielsweise bei einer Prüfung (das Durchfallen)"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d4426542-6325-479e-86c8-6c5aea324891",
                                                "sense_id": "b9dad6d1-5d9e-34d6-8002-81ca64953a2d",
                                                "text": "„Im Jahre 1783 wurde Lessings ‚Nathan der Weise‘ zum ersten Male in Berlin aufgeführt, erlebte aber einen vollkommenen Durchfall, und zwar infolge eines unseligen Versprechens des Darstellers des Sultans.“"
                                            },
                                            {
                                                "example_id": "829c4628-02fb-4813-9cab-e62fc0ad6c62",
                                                "sense_id": "b9dad6d1-5d9e-34d6-8002-81ca64953a2d",
                                                "text": "„So ging ihm, als der ‚Prinz von Homburg‘ von Kleist durchfiel und vom Wiener Publicum theilweise ausgelacht wurde, dieser Kleist’sche Durchfall sehr zu Herzen.“"
                                            },
                                            {
                                                "example_id": "f7331a4c-7982-4d96-9ac4-d356ed8a1b77",
                                                "sense_id": "b9dad6d1-5d9e-34d6-8002-81ca64953a2d",
                                                "text": "„Wenn, wie wieder Otto Elben erzählt, einer der prüfenden Professoren sagte, ‚M. habe die vorhandenen juristischen Kenntnisse so geschickt und vernünftig angewandt vorzutragen gewußt, daß man ihn unmöglich durchfallen lassen konnte‘, so kann sich dies unseres Erachtens unmöglich auf das ganze Examen, dessen Ergebniß die Gefahr des Durchfalls völlig ausschließt, sondern höchstens auf ein Einzelfach beziehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
