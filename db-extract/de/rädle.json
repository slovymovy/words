                "senses": [
                    {
                        "sense_id": "e66fff4b-73ce-3b54-86d0-79a0aaa502c0",
                        "entry_id": "88a47f48-f23a-31d8-a593-cf4181656ef7",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5252d435-412f-4c4a-93d1-7dcbd095da04",
                                "sense_id": "e66fff4b-73ce-3b54-86d0-79a0aaa502c0",
                                "text": "Frau Rädle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "4172948a-d564-4002-9bda-076603a75cb2",
                                "sense_id": "e66fff4b-73ce-3b54-86d0-79a0aaa502c0",
                                "text": "Herr Rädle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "998b9af4-8ac3-49cf-80eb-3b93e6480a0c",
                                "sense_id": "e66fff4b-73ce-3b54-86d0-79a0aaa502c0",
                                "text": "Die Rädles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "689d70cc-8b08-45c3-a2c2-bccb14ce84e6",
                                "sense_id": "e66fff4b-73ce-3b54-86d0-79a0aaa502c0",
                                "text": "Der Rädle trägt nie die Pullover, die die Rädle ihm strickt."
                            },
                            {
                                "example_id": "8492bf36-d583-4aee-9515-d0823ae8c6c4",
                                "sense_id": "e66fff4b-73ce-3b54-86d0-79a0aaa502c0",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Rädle kommt, geht der Herr Rädle.“"
                            },
                            {
                                "example_id": "54674ad6-2fea-42fa-a66a-389f23355952",
                                "sense_id": "e66fff4b-73ce-3b54-86d0-79a0aaa502c0",
                                "text": "Rädle kommt und geht."
                            },
                            {
                                "example_id": "a1ac7e84-c65b-4c08-9c99-22b2b1bd18e9",
                                "sense_id": "e66fff4b-73ce-3b54-86d0-79a0aaa502c0",
                                "text": "Rädles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
