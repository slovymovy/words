{
    "word_family": [
        "gril",
        "grillpan",
        "grillplaat",
        "grillworst"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "62ba8ede-739d-367c-9e17-00a2bb174d11",
                    "sense_definition": "Bruinen en braden op een open rooster (grill) boven een warmtebron.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "bereiden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Gebruik bij het <w>grillen</w> van vlees, gevogelte en vis altijd een druipschaal om uitlopend vet en vleessappen op te vangen.",
                            "target_lang_translations": {
                                "en": "When <w>grilling</w> meat, poultry, and fish, always use a drip pan to catch running fat and meat juices."
                            }
                        },
                        {
                            "text": "Bij het eerstvolgende open veldje aan het water gooiden we onze spullen neer. Ik wilde dolgraag een keer verse vis vangen en op een kampvuurtje <w>grillen</w>.",
                            "target_lang_translations": {
                                "en": "At the very next open clearing by the water, we threw down our things. I really wanted to catch fresh fish and <w>grill</w> it on a campfire."
                            }
                        }
                    ],
                    "synonyms": [
                        "grilleren",
                        "roosteren"
                    ],
                    "common_phrases": [
                        "vlees grillen",
                        "groenten grillen"
                    ],
                    "target_lang_definitions": {
                        "en": "To brown and roast food on an open grate (grill) over a heat source."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "grill",
                                "target_lang_sense_clarification": "to cook food on a grill"
                            },
                            {
                                "target_lang_word": "barbecue",
                                "target_lang_sense_clarification": "to cook outdoors on a grate over a fire"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a94fb491-a26f-3d18-8cd3-eabed8b42fa2",
                    "sense_definition": "Huiveren of rillen van kou of angst.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "lichaamsreactie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij stond te <w>grillen</w> op haar benen toen ze de koude wind voelde.",
                            "target_lang_translations": {
                                "en": "She stood there <w>shivering</w> on her legs when she felt the cold wind."
                            }
                        },
                        {
                            "text": "Bij het horen van dat vreselijke geluid begon hij over zijn hele lichaam te <w>grillen</w>.",
                            "target_lang_translations": {
                                "en": "Upon hearing that terrible sound, he began to <w>shudder</w> all over his body."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To shiver or shudder from cold or fear."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "shiver",
                                "target_lang_sense_clarification": "to shake slightly because of cold or fear"
                            },
                            {
                                "target_lang_word": "shudder",
                                "target_lang_sense_clarification": "to shake convulsively from fear or disgust"
                            },
                            {
                                "target_lang_word": "tremble",
                                "target_lang_sense_clarification": "to shake involuntarily"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8652baa7-c40b-3f1d-b358-582b2f5266e5",
                    "sense_definition": "Kwaad of geïrriteerd zijn.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "emotie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij zat de hele middag te <w>grillen</w> in de hoek na de ruzie.",
                            "target_lang_translations": {
                                "en": "He sat <w>sulking</w> in the corner all afternoon after the argument."
                            }
                        },
                        {
                            "text": "Je moet niet zo <w>grillen</w> om een klein foutje.",
                            "target_lang_translations": {
                                "en": "You shouldn't <w>fret</w> so much over a small mistake."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Voornamelijk in bepaalde dialecten gebruikt"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To be angry, irritated, or sulking."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sulk",
                                "target_lang_sense_clarification": "to be silently angry or resentful"
                            },
                            {
                                "target_lang_word": "fret",
                                "target_lang_sense_clarification": "to be visibly worried or annoyed"
                            },
                            {
                                "target_lang_word": "stew",
                                "target_lang_sense_clarification": "to be angry or worried in a quiet way"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "89e49d77-c7a6-35a3-a9fa-9a318a55234e",
                    "sense_definition": "Meervoud van het zelfstandig naamwoord <w>gril</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "meervoud",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij heeft soms vreemde <w>grillen</w> waar niemand iets van begrijpt.",
                            "target_lang_translations": {
                                "en": "She sometimes has strange <w>whims</w> that nobody understands."
                            }
                        },
                        {
                            "text": "Het weer in de lente heeft vaak onvoorspelbare <w>grillen</w>.",
                            "target_lang_translations": {
                                "en": "The weather in spring often has unpredictable <w>vagaries</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Plural of the noun 'gril' (whim, caprice, or vagary)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "whims",
                                "target_lang_sense_clarification": "sudden desires or change of mind"
                            },
                            {
                                "target_lang_word": "caprices",
                                "target_lang_sense_clarification": "sudden and unaccountable changes of mood or behavior"
                            },
                            {
                                "target_lang_word": "vagaries",
                                "target_lang_sense_clarification": "unexpected and inexplicable changes in a situation or behavior"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}