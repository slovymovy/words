                "senses": [
                    {
                        "sense_id": "1da5268d-6001-3343-84d6-13ce681a461f",
                        "entry_id": "8e397180-028d-311d-bb69-ccbeb854f011",
                        "glosses": [
                            "lattice, grid"
                        ],
                        "tags": [
                            "feminine"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "833881da-6cfe-3031-a267-56d4bff9d5ba",
                        "entry_id": "8e397180-028d-311d-bb69-ccbeb854f011",
                        "glosses": [
                            "grating"
                        ],
                        "tags": [
                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "4b7a4e38-7d8e-412c-86b1-c0719552d50f",
                                "sense_id": "833881da-6cfe-3031-a267-56d4bff9d5ba",
                                "text": "Był znacznie wyższy od swojej towarzyszki, dzięki czemu sięgnął do bolca ryglującego kratę od środka. Wspinając się na palce, chwycił kratę i pchnął ją. Żelastwo uniosło się na kilka centymetrów, po czym znów opadło.",
                                "translation": "He was significantly taller than his companion, because of which he reached the pin holding the grate up from the inside. Standing on tiptoes, he took hold of the grate and pushed on it. The piece of iron rose a few centimeters, then fell back down.",
                                "english": "He was significantly taller than his companion, because of which he reached the pin holding the grate up from the inside. Standing on tiptoes, he took hold of the grate and pushed on it. The piece of iron rose a few centimeters, then fell back down."
                            },
                            {
                                "example_id": "1ce0da67-0e88-4091-97f8-70cbde2e85f6",
                                "sense_id": "833881da-6cfe-3031-a267-56d4bff9d5ba",
                                "text": "Jego zdaniem konstrukcja krat, zainstalowanych na balkonie sąsiada z parteru, skutecznie umożliwiła złodziejowi dostanie się do lokalu i rabunek posiadanych kosztowności.",
                                "translation": "In his opinion, the structure of the metal lattices installed on the balcony of his neighbor on the ground floor effectively allowed the thief to get to his apartment and steal the valuables he owned.",
                                "english": "In his opinion, the structure of the metal lattices installed on the balcony of his neighbor on the ground floor effectively allowed the thief to get to his apartment and steal the valuables he owned."
                            }
                        ]
                    },
                    {
                        "sense_id": "09284256-adb2-3343-822e-e00ea4070039",
                        "entry_id": "8e397180-028d-311d-bb69-ccbeb854f011",
                        "glosses": [
                            "lattice"
                        ],
