                ],
                "senses": [
                    {
                        "sense_id": "4bc3d0f8-dadc-36f2-8ef3-66e833fc44a7",
                        "entry_id": "f06e92b9-32c3-3569-8e19-b2ac81ae7ec9",
                        "glosses": [
                            "Appareil permettant de donner une réponse graduée positive, neutre ou négative, lors d’une médiascopie pour l’évaluation de contenu audiovisuel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f05f3f70-871e-4cec-8726-d74af564de2a",
                                "sense_id": "4bc3d0f8-dadc-36f2-8ef3-66e833fc44a7",
                                "text": "Les réactions sont recueillies par le biais du curseur du médiascope que les téléspectateurs, interrogés « en ligne », sont invités à pousser sur leur ordinateur vers la note 10 quand ils sont d’accord ou vers la note 0 quand ils ne le sont pas."
                            },
                            {
                                "example_id": "72573f17-49f5-4411-b15d-066da954e21f",
                                "sense_id": "4bc3d0f8-dadc-36f2-8ef3-66e833fc44a7",
                                "text": "Le Laboratoire régional de Clermont-Ferrand proposait un médiascope sur l’activité de son équipe de recherche ainsi qu’une vidéo sur le véhicule Thermoroute."
                            },
                            {
                                "example_id": "8e41ea11-b245-43c0-8925-a0786f8549f7",
                                "sense_id": "4bc3d0f8-dadc-36f2-8ef3-66e833fc44a7",
                                "text": "Une petite boîte noire ultralégère - le médiascope, munie d’un curseur variant du + (en haut) au - (en bas), permet à un « échantillon » dûment équipé de noter, de 0 à 10 et à chaque seconde, l’impact d’un message publicitaire, [ou] le discours institutionnel d’une entreprise […]"
                            },
                            {
                                "example_id": "3cf59c23-82b9-4d6a-8c86-ab3990e6fff5",
                                "sense_id": "4bc3d0f8-dadc-36f2-8ef3-66e833fc44a7",
                                "text": "Inventé par Denis Muzet, le « médiascope », sorte « d’applaudimètre électronique » permet de mesurer l’écho positif ou négatif des thèmes développés et des figures rhétoriques utilisées."
                            }
                        ]
                    }
                ],
