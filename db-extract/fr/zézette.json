                            "familiar"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "41bd5543-76ae-3b54-a9ff-0716d8ac21a7",
                        "entry_id": "c9dc665b-5757-397f-93e0-cd4bf7666507",
                        "glosses": [
                            "Biscuit sablé parfumé à l'arôme de vanille, spécialité de la ville de Sète."
                        ],
