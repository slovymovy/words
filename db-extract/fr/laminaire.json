                                        ],
                                        "examples": [
                                            {
                                                "example_id": "90fdaddf-6af1-4b2b-ba0b-823015bc4c77",
                                                "sense_id": "e743d6ad-cb31-3bcf-928e-e728067d1e2c",
                                                "text": "On the wall, in an ornate fixture of darkening bronze, a gas jet burned, laminar and gently singing — adjusted to what scientists of the last century called a \"sensitive flame\": invisible at the base, as it issues from the orifice, fading upward into smooth blue light that hovers several inches above..."
                                            },
                                            {
                                                "example_id": "0d892c79-5949-4815-95e9-858cedaf826d",
                                                "sense_id": "e743d6ad-cb31-3bcf-928e-e728067d1e2c",
                                                "text": "The laminar bands of color to the west bleeding out under the hammered clouds. A sudden violet-colored hooding of the earth."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f873425f-f642-3a96-ae61-56fa9a004aec",
