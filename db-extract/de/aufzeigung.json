                ],
                "senses": [
                    {
                        "sense_id": "88b8c3a2-83d0-3488-9602-463ee52ffde9",
                        "entry_id": "a6a8384b-dbfd-355b-9b40-117634e6d98d",
                        "glosses": [
                            "Handlung, sich zu melden, auf etwas hinzuweisen oder"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "88e5d02e-fe83-4990-8028-c5e2eab4a8d4",
                                "sense_id": "88b8c3a2-83d0-3488-9602-463ee52ffde9",
                                "text": "„Die nachfolgend beschriebenen Versuche stellen nur einen Teil der Versuchsreihen dar, die zur Aufzeigung des Problems und seiner Lösung unternommen worden sind.“"
                            },
                            {
                                "example_id": "6c1a8504-7f08-4f42-9b64-1a23f604888a",
                                "sense_id": "88b8c3a2-83d0-3488-9602-463ee52ffde9",
                                "text": "„Daraus ergibt sich die wirtschaftstheoretische Grundhaltung dieser Lehren, die ihren Ausdruck in der Aufzeigung der Gesichtspunkte findet, die zu beachten sind, wenn eine solche expansive wirtschaftliche Entwicklung ablaufen soll.“"
                            },
                            {
                                "example_id": "dcce31bc-679c-47a6-9d4b-0916daa3dd43",
                                "sense_id": "88b8c3a2-83d0-3488-9602-463ee52ffde9",
                                "text": "„Die Aufzeigung der Gültigkeit in Erfahrung oder Denken kann auch indirekt geschehen.“"
                            },
                            {
                                "example_id": "7ac4c991-3c51-421e-863c-53be35d2cbaa",
                                "sense_id": "88b8c3a2-83d0-3488-9602-463ee52ffde9",
                                "text": "„Die Aufzeigung von Grenzen ermöglicht die präzise Aufzeigung sinnvoller sprachlicher Grenzüberschreitungen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e6ddd9e3-f18c-4601-8310-f14495186e01",
                        "source_entry_id": "a6a8384b-dbfd-355b-9b40-117634e6d98d",
                        "source_sense_id": "88b8c3a2-83d0-3488-9602-463ee52ffde9",
                        "source_sense_description": "Handlung, sich zu melden, auf etwas hinzuweisen oder",
                        "target_lang_word": "demonstration",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "demonstration",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a7b4eb40-e59e-3a9b-aa2e-b0c144a82647",
                                        "entry_id": "6a5b241f-897f-314d-97af-9098c5b4a0b6",
                                        "glosses": [
                                            "The act of demonstrating; showing or explaining something."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0019bf12-0b96-4547-914f-994b2e43f005",
                                                "sense_id": "a7b4eb40-e59e-3a9b-aa2e-b0c144a82647",
                                                "text": "[VV]e are able with playne demonſtration to proue, and vvith reaſon to perſvvade that in tymes paſt our fayth vvas alike, that then vve preached thinges correſpondent vnto the forme of faith already published of vs, ſo that none in this behalfe can repyne or gaynesay vs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a07431c6-9764-3b53-aa12-bfa47f674ed9",
                                        "entry_id": "6a5b241f-897f-314d-97af-9098c5b4a0b6",
                                        "glosses": [
                                            "The act of demonstrating; showing or explaining something.",
                                            "A prisoner's act of beating up another prisoner."
                                        ],
                                        "tags": [
                                            "countable",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2553862d-3124-3b01-8a1f-2a91994e72d3",
                                        "entry_id": "6a5b241f-897f-314d-97af-9098c5b4a0b6",
                                        "glosses": [
                                            "An event at which something will be demonstrated."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fb96d71b-c0d5-4da3-ad9c-1ac478f25606",
                                                "sense_id": "2553862d-3124-3b01-8a1f-2a91994e72d3",
                                                "text": "I have to give a demonstration to the class tomorrow, and I'm ill-prepared."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f95a499-fe9f-3e58-876a-11aee79f760c",
                                        "entry_id": "6a5b241f-897f-314d-97af-9098c5b4a0b6",
                                        "glosses": [
                                            "Expression of one's feelings by outward signs."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5fdbdd86-5821-3620-8912-a8a7780ec168",
                                        "entry_id": "6a5b241f-897f-314d-97af-9098c5b4a0b6",
                                        "glosses": [
                                            "A public display of group opinion, such as a protest march."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "72fb1ea2-9146-4aa6-a9e6-84206d82f517",
                                                "sense_id": "5fdbdd86-5821-3620-8912-a8a7780ec168",
                                                "text": "It's produced tremendous activism and backlash: there's been all sorts of demonstrations and mobilizations in civil society, there's been examples from the people from the Administration being heckled in a restaurant or not served in a restaurant, there's been a growing crescendo of conversation about what that means."
                                            },
                                            {
                                                "example_id": "83effb98-2fad-46fd-9f8c-030f3a93bda0",
                                                "sense_id": "5fdbdd86-5821-3620-8912-a8a7780ec168",
                                                "text": "Even when there had been hecklers, Victor and other members would focus on setting up their demonstration — signs reading “Let them go now,” and posters bearing the faces of 58 hostages still being held in Gaza."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6c57b219-81cc-3bfc-9e30-04fcd9ff64a6",
                                        "entry_id": "6a5b241f-897f-314d-97af-9098c5b4a0b6",
                                        "glosses": [
                                            "A show of military force."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "84470462-b6a2-3802-9162-b6488a4c8cc9",
                                        "entry_id": "6a5b241f-897f-314d-97af-9098c5b4a0b6",
                                        "glosses": [
                                            "A proof."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8015bac5-c6d6-461b-aec2-4d52e17fc540",
                                                "sense_id": "84470462-b6a2-3802-9162-b6488a4c8cc9",
                                                "text": "He read the proposition. […] So he reads the demonstration of it, which referred him back to such a proposition,; which proposition he read."
                                            },
                                            {
                                                "example_id": "6fea832a-0cc0-42ad-9efd-0b0f9369a1e3",
                                                "sense_id": "84470462-b6a2-3802-9162-b6488a4c8cc9",
                                                "text": "If, then, proof from the basic truth is more accurate than proof not so derived, demonstration which depends more closely on it is more accurate than demonstration which is less closely dependent."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "45541f00-339e-4ea8-978f-7cd195c45bc1",
                        "source_entry_id": "a6a8384b-dbfd-355b-9b40-117634e6d98d",
                        "source_sense_id": "88b8c3a2-83d0-3488-9602-463ee52ffde9",
                        "source_sense_description": "Handlung, sich zu melden, auf etwas hinzuweisen oder",
                        "target_lang_word": "revelation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "revelation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5040b4c6-6865-33d9-95cd-b3995f214b02",
                                        "entry_id": "457716e4-966e-362e-a1fb-8514b7055f3c",
                                        "glosses": [
                                            "The act of revealing or disclosing."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "95e0f0b9-b685-4130-a6a4-2d10a3e4ab4f",
                                                "sense_id": "5040b4c6-6865-33d9-95cd-b3995f214b02",
                                                "text": "The revelation of the culprits' identities was cathartic for the populace."
                                            },
                                            {
                                                "example_id": "45de5335-5ad8-4c74-b856-4a055285b30a",
                                                "sense_id": "5040b4c6-6865-33d9-95cd-b3995f214b02",
                                                "text": "Magicians talk about the revelation at the end of a trick."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f002721f-aa23-3787-8286-0f9f4f125a53",
                                        "entry_id": "457716e4-966e-362e-a1fb-8514b7055f3c",
                                        "glosses": [
                                            "Something that is revealed."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3390a15a-e6f4-419e-962d-3043cfdbcf36",
                                                "sense_id": "f002721f-aa23-3787-8286-0f9f4f125a53",
                                                "text": "The revelaciõ of Jeſus Chꝛiſte / which god gave vnto hĩ / foꝛto ſhewe vnto his ſervaunt[es] thyng[es] which muſte ſhoꝛtly come to paſſe."
                                            },
                                            {
                                                "example_id": "944a93c7-32cd-4287-96e3-7d21fad94932",
                                                "sense_id": "f002721f-aa23-3787-8286-0f9f4f125a53",
                                                "text": "But it was much more than a mere ship. Its systems, processes, and technology were so advanced that they dwarfed every accomplishment of the Citadel species. Its grandeur and complexity rivaled the greatest creations of the Protheans—the mass relays and the Citadel. It may have even surpassed them. And if Saren could learn and understand how it worked, he could seize all that power for himself.\nHe’d spent his entire life preparing for a moment like this. Everything he’d ever done—his military service, his career with the Spectres—was only a prelude to this revelation. Now he had found his true purpose; destiny had led him here."
                                            },
                                            {
                                                "example_id": "bdddff5f-c5ff-4726-8ebc-92e2ec4b0e29",
                                                "sense_id": "f002721f-aa23-3787-8286-0f9f4f125a53",
                                                "text": "The use of algorithms in policing is one example of their increasing influence on our lives.[…]who, if anyone, is policing their use[?] Such concerns were sharpened further by the continuing revelations about how the US National Security Agency (NSA) has been using algorithms to help it interpret the colossal amounts of data it has collected from its covert dragnet of international telecommunications."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "86d9cb59-2042-310d-b2b1-d6aa517fd404",
                                        "entry_id": "457716e4-966e-362e-a1fb-8514b7055f3c",
                                        "glosses": [
                                            "Something dramatically disclosed."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7cc34f53-42de-468a-9eff-749bce96b370",
                                                "sense_id": "86d9cb59-2042-310d-b2b1-d6aa517fd404",
                                                "text": "This invention was a revelation for farmers throughout the region, who immediately adopted it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "20a42a83-c0da-3a1f-9bec-9b1099f8f233",
                                        "entry_id": "457716e4-966e-362e-a1fb-8514b7055f3c",
                                        "glosses": [
                                            "A manifestation of divine truth."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a2d54c38-15c7-48f0-8aa5-26d762e053df",
                                                "sense_id": "20a42a83-c0da-3a1f-9bec-9b1099f8f233",
                                                "text": "This does not mean that God has difficulty overcoming obstacles; if one questions whether revelation is ‘a simple matter’, this need not refer to whether or not God has to exert himself greatly to overcome these obstacles, or whether he is grieved or suffers in some way to overcome these obstacles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3b5850cc-f763-35a9-ae76-c953634a73cd",
                                        "entry_id": "457716e4-966e-362e-a1fb-8514b7055f3c",
                                        "glosses": [
                                            "Something that turns out to be a great success."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e0ca516f-43ce-4f16-94cb-d78415708cc4",
                                                "sense_id": "3b5850cc-f763-35a9-ae76-c953634a73cd",
                                                "text": "This invention was a revelation for farming throughout the region, where it doubled crop yields."
                                            },
                                            {
                                                "example_id": "67cdd832-407b-4b34-9de6-8b3ad9a7d414",
                                                "sense_id": "3b5850cc-f763-35a9-ae76-c953634a73cd",
                                                "text": "The 26-year-old has proved a revelation since his £10m move from Freiburg, with his 11 goals in 10 matches hauling Newcastle above Spurs, who went down to Adel Taarabt's goal in Saturday's late kick-off at Loftus Road."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1c157512-621e-48f2-850c-2b123caf61eb",
                        "source_entry_id": "a6a8384b-dbfd-355b-9b40-117634e6d98d",
                        "source_sense_id": "88b8c3a2-83d0-3488-9602-463ee52ffde9",
