                        "glosses": [
                            "Extrêmement sobre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f9f77c6-2db3-4389-aaf1-de20467019a8",
                                "sense_id": "e1f082a6-9abe-3d32-b0c3-a7b4f7292c5a",
                                "text": "On sert un plantureux diner anglo-malais, que ces messieurs, en gens ultra-sobres chez eux, dévorent avec un appétit effrayant."
                            },
                            {
                                "example_id": "6a1df469-3501-444a-b8cd-4d1910fa533b",
                                "sense_id": "e1f082a6-9abe-3d32-b0c3-a7b4f7292c5a",
                                "text": "Ainsi, les promesses chimériques de maïs transgéniques capables de pousser sans eau, voire dans les déserts, sont sans doute techniquement réalisables à terme, mais ces plantes ultra-sobres et ultra-tolérantes ne produiront alors que quelques kilos de grains."
                            },
                            {
                                "example_id": "ec98f424-a06d-46e8-87b2-92debe0addc5",
                                "sense_id": "e1f082a6-9abe-3d32-b0c3-a7b4f7292c5a",
                                "text": "L’immigration des ouvriers japonais, laborieux, ultra-sobres, se contentant de salaires infimes, constitue pour l’industrie américaine en Californie un péril imminent, produit déjà un trouble profond."
                            }
                        ]
                    }
