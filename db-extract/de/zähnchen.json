                                    },
                                    {
                                        "sense_id": "267bf933-4c1d-34dd-b933-432f0a0c7c93",
                                        "entry_id": "2505f152-5ec3-3ea3-9db4-1b99ce2c0ef0",
                                        "glosses": [
                                            "Material serving as the dermis of sharks."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7fd9ca6a-739f-4c8d-8790-977663f1970b",
                                                "sense_id": "267bf933-4c1d-34dd-b933-432f0a0c7c93",
                                                "text": "Under low-power magnification, it can be seen that the denticles of different species are varied in size and shape, but they are usually comprised of one or more pointed elements, with various ridges, cusps, and furrows."
                                            }
                                        ]
                                    },
