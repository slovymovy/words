                "senses": [
                    {
                        "sense_id": "074c8465-7edd-3ac2-925b-5ac33b8fc297",
                        "entry_id": "584cd1e6-f151-365f-8a13-be13319df1a7",
                        "glosses": [
                            "устар. относящийся к брату, принадлежащий ему"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "999885e6-1bbd-42a7-b6e2-44e1c59e7c31",
                                "sense_id": "074c8465-7edd-3ac2-925b-5ac33b8fc297",
                                "text": "Из гор Ичкерии далёкой / Уже в Чечню на братний зов / Толпы стекались удальцов."
                            },
                            {
                                "example_id": "0026bff0-a5be-46fd-ae68-e10cabb7b9a6",
                                "sense_id": "074c8465-7edd-3ac2-925b-5ac33b8fc297",
                                "text": "…Мне ещё предстояло ехать за город по братнему делу."
                            }
                        ]
                    }
                ],
