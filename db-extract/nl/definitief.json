                ],
                "senses": [
                    {
                        "sense_id": "ef7eee44-6b8e-34d0-8b70-6a7a3077b9f5",
                        "entry_id": "80637f61-0181-3930-8c55-7b21d0233840",
                        "glosses": [
                            "voorgoed geldig, onherroepelijk"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d97e76e5-7721-40c3-8438-b35df86237fb",
                                "sense_id": "ef7eee44-6b8e-34d0-8b70-6a7a3077b9f5",
                                "text": "De verkiezingen van 2008 gaven een definitief en bevestigend antwoord op de vraag of iemand van Afrikaanse komaf Amerikaans president kan worden."
                            },
                            {
                                "example_id": "2324c709-12d1-43ca-9226-10f440d6bff7",
                                "sense_id": "ef7eee44-6b8e-34d0-8b70-6a7a3077b9f5",
                                "text": "De Chinese auto heeft dus definitief een plek veroverd op de Europese markt. Bovag verwacht dat het marktaandeel van Chinese autofabrikanten van 4 procent nu naar 10 procent zal groeien in Europa en wel 15 procent in Nederland. \"De Chinese merken zijn al een serieuze speler en ik denk dat ze Europese fabrikanten gaan stimuleren nog meer te steken in de elektrificering en efficiëntie van hun auto's\", zegt Brummelhuis. De EU hoopt in ieder geval binnenkort afspraken te maken China zodat Chinese automerken ook hier meer fabrieken gaan openen."
                            },
                            {
                                "example_id": "f547a603-4102-4a03-98e6-1b6d48047335",
                                "sense_id": "ef7eee44-6b8e-34d0-8b70-6a7a3077b9f5",
                                "text": "Ze vroeg hoe het met mij was, en begon me net te vertellen wat voor cadeaus ze had gekregen toen de lijn definitief wegviel. ‘Neeeee!’ Gefrustreerd belde ik weer, maar ook na de tweede en derde poging bleef het stil."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "47f4adaa-d0ff-4f6b-bff2-174e09296c47",
                        "source_entry_id": "80637f61-0181-3930-8c55-7b21d0233840",
                        "source_sense_id": "ef7eee44-6b8e-34d0-8b70-6a7a3077b9f5",
                        "target_lang_word": "définitif",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "définitif",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d34f55eb-32eb-3240-ace5-eda7aaeb0995",
                                        "entry_id": "794808b9-5a76-3eac-a10e-47c6a3d2db3a",
                                        "glosses": [
                                            "Qui est réglé, fixé de manière qu’on n’y devra plus revenir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "119b7970-89b4-474b-ac3b-21726768c6c8",
                                                "sense_id": "d34f55eb-32eb-3240-ace5-eda7aaeb0995",
                                                "text": "Il y avait, dans le son même de ce mot, quelque chose de définitif, d’inexorable et de fatal."
                                            },
                                            {
                                                "example_id": "ba81d315-be04-4b30-907d-63155912bf9b",
                                                "sense_id": "d34f55eb-32eb-3240-ace5-eda7aaeb0995",
                                                "text": "[…]; les études chimique et minéralogique assigneront une place définitive dans la systématique, à cette roche qui était une des énigmes de la lithologie."
                                            },
                                            {
                                                "example_id": "444dfce7-d9de-472c-932c-590357ad1591",
                                                "sense_id": "d34f55eb-32eb-3240-ace5-eda7aaeb0995",
                                                "text": "La vitesse de circulation de la monnaie croissait ainsi de jour en jour et sa répudiation définitive semblait devoir être prochaine."
                                            },
                                            {
                                                "example_id": "4aa2b66a-21a6-48cf-89dc-90281313fcc7",
                                                "sense_id": "d34f55eb-32eb-3240-ace5-eda7aaeb0995",
                                                "text": "[…] mais aussi à cause d'un livre de son père, qu'il avait trouvé dans ses cartons, qui se voulait une encyclopédie définitive du parler gaga – le dialecte stéphanois – et qui lui avait causé un fou rire d'une demi-heure […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "01345d4c-5b76-4407-aca1-21776168d0ac",
                        "source_entry_id": "80637f61-0181-3930-8c55-7b21d0233840",
                        "source_sense_id": "ef7eee44-6b8e-34d0-8b70-6a7a3077b9f5",
