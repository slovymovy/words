{
    "word_family": [
        "swipecard"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b9fba4c7-6731-3ce0-a00b-5487bc03e751",
                    "sense_definition": "To interact with a touch screen by drawing one's finger rapidly across it.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "touchscreen interaction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "To unlock your phone, <w>swipe</w> the slider from left to right.",
                            "target_lang_translations": {
                                "ru": "Чтобы разблокировать телефон, <w>проведите</w> ползунок слева направо."
                            }
                        },
                        {
                            "text": "You can <w>swipe</w> left to hide the toolbar on this application.",
                            "target_lang_translations": {
                                "ru": "Вы можете <w>свайпнуть</w> влево, чтобы скрыть панель инструментов в этом приложении."
                            }
                        }
                    ],
                    "common_phrases": [
                        "swipe left",
                        "swipe right",
                        "swipe the screen"
                    ],
                    "target_lang_definitions": {
                        "ru": "Взаимодействовать с сенсорным экраном, быстро проводя по нему пальцем."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "проводить",
                                "target_lang_sense_clarification": "пальцем по экрану"
                            },
                            {
                                "target_lang_word": "свайпать",
                                "target_lang_sense_clarification": "сленг, использовать жест свайпа"
                            },
                            {
                                "target_lang_word": "сделать свайп",
                                "target_lang_sense_clarification": "выполнить жест пролистывания"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "90863849-3585-3b4e-a914-8ed14befe7dd",
                    "sense_definition": "To scan or register by sliding a card through a reader.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "card reading",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>swiped</w> his card at the door to enter the office building.",
                            "target_lang_translations": {
                                "ru": "Он <w>провел</w> картой у двери, чтобы войти в офисное здание."
                            }
                        },
                        {
                            "text": "Please <w>swipe</w> your credit card to complete the payment.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, <w>прокатайте</w> вашу кредитную карту для завершения оплаты."
                            }
                        }
                    ],
                    "common_phrases": [
                        "swipe your card",
                        "swipe a badge"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сканировать или регистрировать карту, проводя ею через считывающее устройство."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "проводить",
                                "target_lang_sense_clarification": "картой через ридер"
                            },
                            {
                                "target_lang_word": "прокатывать",
                                "target_lang_sense_clarification": "банковскую или магнитную карту"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ffbc1fdd-b528-3681-88bd-e8a69983434c",
                    "sense_definition": "To steal or snatch something.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "theft",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I think someone <w>swiped</w> my lunch from the office fridge.",
                            "target_lang_translations": {
                                "ru": "Думаю, кто-то <w>стащил</w> мой обед из офисного холодильника."
                            }
                        },
                        {
                            "text": "The thief managed to <w>swipe</w> a wallet while the tourist was distracted.",
                            "target_lang_translations": {
                                "ru": "Вору удалось <w>стянуть</w> кошелек, пока турист был отвлечен."
                            }
                        }
                    ],
                    "synonyms": [
                        "pinch",
                        "steal",
                        "snatch",
                        "filch",
                        "lift",
                        "nick"
                    ],
                    "common_phrases": [
                        "swipe a wallet",
                        "swipe some food"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal usage for stealing"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Украсть или быстро схватить что-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стащить",
                                "target_lang_sense_clarification": "незаметно украсть"
                            },
                            {
                                "target_lang_word": "стянуть",
                                "target_lang_sense_clarification": "разговорное, украсть"
                            },
                            {
                                "target_lang_word": "спереть",
                                "target_lang_sense_clarification": "просторечное, украсть"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6804e125-cce6-3fea-ae93-e03bfd2e3154",
                    "sense_definition": "To grab or bat quickly with a sweeping motion.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical motion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cat <w>swiped</w> at the shoelace with its front paw.",
                            "target_lang_translations": {
                                "ru": "Кошка <w>махнула</w> лапой по шнурку."
                            }
                        },
                        {
                            "text": "He <w>swiped</w> at the fly buzzing around his head.",
                            "target_lang_translations": {
                                "ru": "Он <w>отмахнулся</w> от мухи, жужжащей над головой."
                            }
                        }
                    ],
                    "common_phrases": [
                        "swipe at something"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быстро схватить или ударить размашистым движением."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "махнуть",
                                "target_lang_sense_clarification": "рукой или лапой"
                            },
                            {
                                "target_lang_word": "ударить",
                                "target_lang_sense_clarification": "размашистым движением"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ff87c69c-110b-3d4f-b980-c99532055632",
                    "sense_definition": "To indicate interest in someone on a dating application by moving a finger across their profile.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "dating",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I was surprised when she <w>swiped</w> me on the dating app.",
                            "target_lang_translations": {
                                "ru": "Я был удивлен, когда она <w>свайпнула</w> меня в приложении для знакомств."
                            }
                        },
                        {
                            "text": "He spent the whole evening <w>swiping</w> through profiles on his phone.",
                            "target_lang_translations": {
                                "ru": "Он провел весь вечер, <w>пролистывая</w> профили в своем телефоне."
                            }
                        }
                    ],
                    "common_phrases": [
                        "swipe on Tinder"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "specific to dating app culture"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Выразить интерес к кому-либо в приложении для знакомств, проведя пальцем по профилю."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "свайпнуть",
                                "target_lang_sense_clarification": "в приложении для знакомств"
                            },
                            {
                                "target_lang_word": "лайкнуть",
                                "target_lang_sense_clarification": "выразить симпатию свайпом"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "31392ef1-2ce4-3b9b-8119-2e3b7927c5b2",
                    "sense_definition": "To strike with a strong blow in a sweeping motion.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "physical motion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The player <w>swiped</w> the ball with a powerful swing of the bat.",
                            "target_lang_translations": {
                                "ru": "Игрок <w>ударил</w> по мячу мощным взмахом биты."
                            }
                        },
                        {
                            "text": "He <w>swiped</w> the vase off the table in a fit of anger.",
                            "target_lang_translations": {
                                "ru": "В порыве гнева он <w>смахнул</w> вазу со стола."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Нанести сильный удар размашистым движением."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хлестнуть",
                                "target_lang_sense_clarification": "сильно ударить с размаху"
                            },
                            {
                                "target_lang_word": "смахнуть",
                                "target_lang_sense_clarification": "сбить резким движением"
                            }
                        ]
                    }
                }
            ]
        },
        {
