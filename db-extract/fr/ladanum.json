                    {
                        "sense_id": "570d2acb-5909-342d-8b3a-553f0ec7934d",
                        "entry_id": "dbb938a1-e53d-3987-a197-f71b12eb490f",
                        "glosses": [
                            "Gomme-résine d’une odeur agréable que l’on retire de plusieurs espèces d’arbrisseaux du genre des cistes et notamment le ciste de Crète."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "901c9931-1e93-4c51-81ce-ef95a6d697fc",
                                "sense_id": "570d2acb-5909-342d-8b3a-553f0ec7934d",
                                "text": "On récolte sur les feuilles du ciste ladanifère, Cistus ladaniferus, une résine odorante, employée comme base en parfumerie, le ladanum."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3ac97f5f-60fa-4ce8-a7da-6998e1df4413",
                        "source_entry_id": "dbb938a1-e53d-3987-a197-f71b12eb490f",
                        "source_sense_id": "570d2acb-5909-342d-8b3a-553f0ec7934d",
                        "source_sense_description": "résine tirée de la gomme du ciste",
                        "target_lang_word": "Labdanum",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
