                    "frequency": "High",
                    "semantic_group_id": "opinion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La direction a <w>jugé</w> nécessaire de reporter la réunion à la semaine suivante."
                        },
                        {
                            "text": "Elle a <w>jugé</w> bon de prévenir ses collègues avant de prendre une décision."
