                                        "entry_id": "d8fbd58f-76c7-3f91-b8d1-6e4b14d45c6e",
                                        "glosses": [
                                            "angetaute, pampige Masse aus Schnee"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ccf6057f-3503-4d2b-a35a-00df807c6269",
                                                "sense_id": "92154bd8-3c9a-3a30-94f6-9c6f4557a094",
                                                "text": "„Ich watete durch Schneematsch und kämpfte gegen den Sturm, unterdessen überschüttete mich der Verkehr auf der Nördlichen Ringstraße mit Widerwärtigkeiten.“"
                                            },
                                            {
                                                "example_id": "5066c7b7-dce4-4eaa-921e-f0cb31c0ebe3",
                                                "sense_id": "92154bd8-3c9a-3a30-94f6-9c6f4557a094",
                                                "text": "„Und nach einer Weile des Weiterbrüllens und Grölens, schließlich des Murrens, verließ die Menge mein Wohnzimmer, nicht ohne allerhand Schneematsch und sonstigen Dreck zu hinterlassen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "21126d84-e31a-4bbe-a330-52b0f99bf860",
                        "source_entry_id": "1ed18b19-4eee-3e2d-9231-0623efdcc3dd",
                        "source_sense_id": "8a7ee52f-b864-3507-93b6-8f6e26fcdbbf",
                        "target_lang_word": "Schneeschmelze",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schneeschmelze",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e74371e0-1489-360e-b5de-cdf8903df37b",
                                        "entry_id": "ac822ce2-d730-37b3-b54c-b94b086dd151",
                                        "glosses": [
                                            "das Tauen des Schnees, sobald milderes Wetter aufkommt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "74b9f446-6604-4a3b-aad9-89bc49950e01",
                                                "sense_id": "e74371e0-1489-360e-b5de-cdf8903df37b",
                                                "text": "Die einsetzende Schneeschmelze lässt die Bäche und Flüsse anschwellen."
                                            },
                                            {
                                                "example_id": "44d801e6-e7e3-449c-8f08-c2724d353f65",
                                                "sense_id": "e74371e0-1489-360e-b5de-cdf8903df37b",
                                                "text": "„Die Wanderkarte rät, früh aufzubrechen, dann sei die Schneeschmelze noch nicht im vollen Gang.“"
                                            },
                                            {
                                                "example_id": "61f82430-1d25-4f17-8bb4-019243d6dcc2",
                                                "sense_id": "e74371e0-1489-360e-b5de-cdf8903df37b",
                                                "text": "„Der Weg wird nun wilder als je zuvor, und die eisernen Dächer mehren sich: im Frühling, zur Zeit der Schneeschmelze, rasen gewiß ganz nette Lawinen über diese Dächer hinweg.“"
                                            },
                                            {
                                                "example_id": "300a191d-61f7-4ced-8dba-cd6ce648de26",
                                                "sense_id": "e74371e0-1489-360e-b5de-cdf8903df37b",
                                                "text": "„Erst nach der Schneeschmelze um Ostern 1813 werden sie auf dem Schlachtfeld von Borodino fünfunddreißigtausend Pferdekadaver zählen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
