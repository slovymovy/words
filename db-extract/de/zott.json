                ],
                "senses": [
                    {
                        "sense_id": "b60c4cbc-993e-317f-968a-1548a568b4b2",
                        "entry_id": "b0f35272-2055-38c8-b1bb-79ddcc162a07",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed716b34-f967-4e01-b31f-e8db43db60e8",
                                "sense_id": "b60c4cbc-993e-317f-968a-1548a568b4b2",
                                "text": "Frau Zott ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "446f07d3-33c1-4b8a-8de1-fc67a9d459e4",
                                "sense_id": "b60c4cbc-993e-317f-968a-1548a568b4b2",
                                "text": "Herr Zott wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "f1e2e419-78b2-4318-9392-cd28937ce318",
                                "sense_id": "b60c4cbc-993e-317f-968a-1548a568b4b2",
                                "text": "Die Zotts fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "0abf8f5c-a6be-4253-ae47-a21d6c5c307d",
                                "sense_id": "b60c4cbc-993e-317f-968a-1548a568b4b2",
                                "text": "Der Zott trägt nie die Schals, die die Zott ihm strickt."
                            },
                            {
                                "example_id": "8a7219a7-d433-4ad4-a5f1-a717f04b4722",
                                "sense_id": "b60c4cbc-993e-317f-968a-1548a568b4b2",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Zott kommt, geht der Herr Zott.“"
                            },
                            {
                                "example_id": "487b23e9-40c5-4e1c-987f-0df781eb1e76",
                                "sense_id": "b60c4cbc-993e-317f-968a-1548a568b4b2",
                                "text": "Zott kommt und geht."
                            },
                            {
                                "example_id": "950248f3-a72c-4de4-9efb-b04a789f13ed",
                                "sense_id": "b60c4cbc-993e-317f-968a-1548a568b4b2",
                                "text": "Zotts kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
