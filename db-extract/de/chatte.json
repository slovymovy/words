                "senses": [
                    {
                        "sense_id": "d79b2a24-70ac-3e69-9e00-a80bbd0ee835",
                        "entry_id": "a25ed676-cab2-3221-86de-c2026398b518",
                        "glosses": [
                            "männlicher Angehöriger des historischen germanischen Volkes der Chatten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "24261605-95aa-4f84-953a-a6adfc0f9f7c",
                                "sense_id": "d79b2a24-70ac-3e69-9e00-a80bbd0ee835",
                                "text": "„Es ist denkbar, dass die Chatten im Laufe der Völkerwanderungszeit durch andere Stämme verdrängt wurden oder in diesen aufgingen.“"
                            },
                            {
                                "example_id": "7bb89cbf-2bbe-42dd-8685-b40438b11482",
                                "sense_id": "d79b2a24-70ac-3e69-9e00-a80bbd0ee835",
                                "text": "„Weit stieß er in die germanischen Gebiet auf rechtsrheinischer Seite vor, überrollte Stammes- und Einflusszonen von Chatten und Sueben, attackierte die Cherusker.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
