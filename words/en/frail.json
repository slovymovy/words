                                "target_lang_word": "фарасола",
                                "target_lang_sense_clarification": "старинная мера веса"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6fe94a25-01de-3a3e-b246-9311fb4073cb",
                    "sense_definition": "An agricultural tool used for threshing grain, synonymous with <w>flail</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "tools",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmer used a wooden <w>frail</w> to separate the wheat from the chaff.",
                            "target_lang_translations": {
                                "ru": "Фермер использовал деревянный <w>цеп</w>, чтобы отделить пшеницу от шелухи."
