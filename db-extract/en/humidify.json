                "senses": [
                    {
                        "sense_id": "bad288e5-6551-3f1f-a8fa-13f771b345e1",
                        "entry_id": "91a0280b-4ae3-3fb9-9523-573bbb4d549b",
                        "glosses": [
                            "To increase the humidity in the air."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "399ba0b7-8be8-4565-8ba4-21782103b410",
                                "sense_id": "bad288e5-6551-3f1f-a8fa-13f771b345e1",
                                "text": "The air-handling equipment humidifies, dehumidifies, and distributes the correct amount of fresh air into every zone and eliminates all smoke, dust, and odors, with electric precipitrons."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9e7af46f-b9a5-482f-9301-9a2d8080f296",
                        "source_entry_id": "91a0280b-4ae3-3fb9-9523-573bbb4d549b",
                        "source_sense_id": "bad288e5-6551-3f1f-a8fa-13f771b345e1",
                        "source_sense_description": "To increase the humidity in the air.",
                        "target_lang_word": "humidifier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "humidifier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c66c42b0-3c16-3cb3-9690-b6d39399f1ab",
                                        "entry_id": "33b852e4-cde0-3c28-8432-c6c9ae67a1ac",
                                        "glosses": [
                                            "Rendre humide, ou plus humide."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f69490e8-d813-4a17-9fee-cfa0877c002c",
                                                "sense_id": "c66c42b0-3c16-3cb3-9690-b6d39399f1ab",
                                                "text": "Je pris l'habitude, à l'imitation des goumiers et des bellahs, d'aller pisser accroupi, à flanc de dune, pour parer au risque de m’humidifier le saroual par vent tourbillonnant et parce qu'en terre d'Islam, ce besoin est à satisfaire discrètement."
                                            },
                                            {
                                                "example_id": "dc6cc5a1-d483-409a-8c44-5845ded5bbf0",
                                                "sense_id": "c66c42b0-3c16-3cb3-9690-b6d39399f1ab",
                                                "text": "En glissant vers le sud, ces vents se tropicalisent et s’humidifient sur la mer de Chine méridionale entraînant de fortes pluies sur les côtes est et nord de l’ensemble régional."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
