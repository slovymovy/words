                            {
                                "example_id": "0497c9b1-3960-4c8c-bae6-98f62e4acdbe",
                                "sense_id": "f7b1c7d3-3e7e-37f7-a2c7-dc0af548cee7",
                                "text": "Een pacemaker is een implantaat."
