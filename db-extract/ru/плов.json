                        ]
                    },
                    {
                        "translation_id": "6d1e2e09-2074-4712-99ed-c25aae32fb00",
                        "source_entry_id": "11d64c66-5665-3b23-bb5f-f8a81a050a4c",
                        "source_sense_id": "b1bbf363-f55b-30e2-b4cc-c79b33f8d45e",
                        "target_lang_word": "pilaf",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pilaf",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cb7b0aee-fb0a-3d91-9003-f12ef7f061cc",
                                        "entry_id": "6d5e69e6-fdf7-37f6-8ed2-9ac193553257",
                                        "glosses": [
                                            "Riz cuit avec des morceaux de viande, de volaille ou de poisson et très épicé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8de7eb55-982a-4210-af66-5607b530fb9e",
                                                "sense_id": "cb7b0aee-fb0a-3d91-9003-f12ef7f061cc",
                                                "text": "Le pilaf est un mode de cuisson du riz originaire du Moyen-Orient et d’Asie Centrale."
                                            },
                                            {
                                                "example_id": "7d9f6fa5-f32b-4a4f-9ba8-27f00622b32e",
                                                "sense_id": "cb7b0aee-fb0a-3d91-9003-f12ef7f061cc",
                                                "text": "Le séjour en Turquie avait gravement attaqué ma santé ; la nourriture y était désirable et nocive. […] Les plus chanceux, les plus vigoureux d’entre les convives, guérissaient grâce à quelques journées de jeûne ; d’autres se voyaient terrassés par la qualité et l’abondance des pilafs aux pois chiches, des moules géantes, des dolmas : boulettes de riz farcies de chair de mouton et présentées dans des feuilles de vigne ; des aubergines gorgées d’huile, des pastèques glaciales."
                                            },
                                            {
                                                "example_id": "25160b59-b9b2-4df6-941e-d65a1f4a450f",
                                                "sense_id": "cb7b0aee-fb0a-3d91-9003-f12ef7f061cc",
                                                "text": "Riz pilaf."
                                            },
                                            {
                                                "example_id": "816967a5-d905-4d7d-ab25-06332512dd23",
                                                "sense_id": "cb7b0aee-fb0a-3d91-9003-f12ef7f061cc",
                                                "text": "Pilaf de poulet."
                                            },
                                            {
                                                "example_id": "7943e067-118a-4b29-ba3c-329697c19ad2",
                                                "sense_id": "cb7b0aee-fb0a-3d91-9003-f12ef7f061cc",
                                                "text": "Pilaf de homard."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "febfd0c6-468a-413b-84f8-51b5cfd59313",
                        "source_entry_id": "11d64c66-5665-3b23-bb5f-f8a81a050a4c",
                        "source_sense_id": "b1bbf363-f55b-30e2-b4cc-c79b33f8d45e",
                        "target_lang_word": "pilau",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pilau",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cf315a28-edad-3390-9695-2e24de46b6c1",
                                        "entry_id": "ef55ca02-c1ca-3a1e-820e-39d814d86cfa",
                                        "glosses": [
                                            "Variante de pilaf."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "72ca1c32-4794-4cb1-a241-31a66166afca",
                                                "sense_id": "cf315a28-edad-3390-9695-2e24de46b6c1",
                                                "text": "Le riz est le fondement de toute la cuisine des Turcs ; ils l’apprêtent de trois différentes manieres. Ce qu’ils appellent pilau, est un riz sec, moëlleux, qui se fond dans la bouche."
                                            },
                                            {
                                                "example_id": "f322bc7e-58a3-49ec-8f7e-999339053884",
                                                "sense_id": "cf315a28-edad-3390-9695-2e24de46b6c1",
                                                "text": "Assis les jambes croisées sur des tapis, des marchands turcs étaient groupés autour des feux qui servaient aux esclaves à préparer le pilau."
                                            },
                                            {
                                                "example_id": "b3d49f97-0c52-45e8-9503-b4694124d59d",
                                                "sense_id": "cf315a28-edad-3390-9695-2e24de46b6c1",
                                                "text": "Notre souper se composa de poulets démembrés étendus pêle-mêle sur une couche de riz aussi relevé de safran qu’un pilau turc, et d’une salade (ensalada) de feuillages verts nageant dans un déluge d’eau vinaigrée, étoilée çà et là de quelques flots d’huile empruntée sans doute à la lampe."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
