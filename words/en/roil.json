{
    "word_family": [
        "roily"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1e8cd81f-ed2b-34bc-b3c4-da366e8c31e2",
                    "sense_definition": "To make a liquid cloudy or muddy by stirring up sediment.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "agitate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The heavy rain began to <w>roil</w> the clear water of the small mountain stream.",
                            "target_lang_translations": {
                                "cs": "Silný déšť začal <w>rozviřovat</w> čistou vodu malého horského potoka."
                            }
                        },
                        {
                            "text": "Be careful not to <w>roil</w> the wine while moving the bottle from the cellar.",
                            "target_lang_translations": {
                                "cs": "Dávejte pozor, abyste <w>nerozvířili</w> víno, když láhev přenášíte ze sklepa."
                            }
                        }
                    ],
                    "synonyms": [
                        "stir",
                        "agitate"
                    ],
                    "target_lang_definitions": {
                        "cs": "Způsobit, že se tekutina stane zakalenou nebo znečištěnou zvířením usazenin."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "rozvířit",
                                "target_lang_sense_clarification": "způsobit pohyb usazenin v kapalině"
                            },
                            {
                                "target_lang_word": "zvířit",
                                "target_lang_sense_clarification": "způsobit náhlý pohyb částic v kapalině"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bde692e8-5a5a-3e6b-9b05-0daa5ec1dc06",
                    "sense_definition": "To cause someone to feel annoyed, angry, or confused.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "agitate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden change in company policy continued to <w>roil</w> the employees for several weeks.",
                            "target_lang_translations": {
                                "cs": "Náhlá změna firemní politiky <w>rozbouřila</w> zaměstnance na několik týdnů."
                            }
                        },
                        {
                            "text": "His constant interruptions during the meeting <w>roiled</w> the manager significantly.",
                            "target_lang_translations": {
                                "cs": "Jeho neustálé přerušování během schůzky manažera značně <w>popudilo</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "annoy",
                        "irritate",
                        "rile"
                    ],
                    "target_lang_definitions": {
                        "cs": "Způsobit, že se někdo cítí podrážděný, rozzlobený nebo zmatený."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "rozbouřit",
                                "target_lang_sense_clarification": "vyvolat neklid nebo emoce"
                            },
                            {
                                "target_lang_word": "popudit",
                                "target_lang_sense_clarification": "vyvolat hněv nebo podráždění"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f86b5d15-5868-3c8b-8edf-289c243b0513",
                    "sense_definition": "To move in a turbulent, agitated, or seething manner.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "agitate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ocean began to <w>roil</w> as the storm approached the coastline.",
                            "target_lang_translations": {
                                "cs": "Oceán začal <w>bouřit</w>, jak se bouře blížila k pobřeží."
                            }
                        },
                        {
                            "text": "Public opinion continued to <w>roil</w> following the controversial announcement by the government.",
                            "target_lang_translations": {
                                "cs": "Veřejné mínění bylo po kontroverzním vládním oznámení nadále <w>rozbouřené</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "seethe",
                        "storm"
                    ],
                    "target_lang_definitions": {
                        "cs": "Pohybovat se bouřlivým, neklidným nebo vřícím způsobem."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "vřít",
                                "target_lang_sense_clarification": "být v prudkém pohybu"
                            },
                            {
                                "target_lang_word": "bouřit",
                                "target_lang_sense_clarification": "projevovat se neklidem nebo prudkostí"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "16508368-97a1-3fba-8d6a-c3aae4be856a",
                    "sense_definition": "To move about in a playful, energetic, or chaotic way.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The energetic puppies <w>roiled</w> across the living room floor in a tangle of fur.",
                            "target_lang_translations": {
                                "cs": "Energická štěňata <w>dováděla</w> po podlaze obývacího pokoje v chumlu srsti."
                            }
                        },
                        {
                            "text": "Children <w>roiled</w> through the park during their afternoon break from school.",
                            "target_lang_translations": {
                                "cs": "Děti během odpolední přestávky ve škole <w>řádily</w> v parku."
                            }
                        }
                    ],
                    "synonyms": [
                        "romp",
                        "tumble"
                    ],
                    "target_lang_definitions": {
                        "cs": "Pohybovat se hravým, energickým nebo chaotickým způsobem."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "dovádět",
                                "target_lang_sense_clarification": "hrát si divoce a energicky"
                            },
                            {
                                "target_lang_word": "řádit",
                                "target_lang_sense_clarification": "pohybovat se chaoticky a energicky"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}