{
    "word_family": [
        "gapeworm",
        "gaper"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7d86b0b8-f7a3-369f-b05b-140a18388f5b",
                    "sense_definition": "To open the mouth wide, especially involuntarily, as in a yawn, anger, or surprise.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "gape-mouth-action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He could only <w>gape</w> in surprise when he heard the unexpected news.",
                            "target_lang_translations": {
                                "ru": "Он мог только <w>разинуть рот</w> от удивления, услышав неожиданную новость."
                            }
                        },
                        {
                            "text": "The tired child began to <w>gape</w> sleepily during the long movie.",
                            "target_lang_translations": {
                                "ru": "Уставший ребенок начал сонно <w>зевать</w> во время долгого фильма."
                            }
                        }
                    ],
                    "synonyms": [
                        "yawn"
                    ],
                    "common_phrases": [
                        "gape in surprise"
                    ],
                    "target_lang_definitions": {
                        "ru": "Широко открывать рот, особенно непроизвольно, например, при зевке, от гнева или удивления."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разевать рот",
                                "target_lang_sense_clarification": "непроизвольно открывать рот"
                            },
                            {
                                "target_lang_word": "разинуть рот",
                                "target_lang_sense_clarification": "широко открыть рот от удивления"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d8fa77f0-2bf6-3f25-8e55-15fb01fd8a10",
                    "sense_definition": "To stare in wonder or amazement.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "gape-stare",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tourists stood on the street corner to <w>gape</w> at the towering skyscrapers.",
                            "target_lang_translations": {
                                "ru": "Туристы стояли на углу улицы, чтобы <w>поглазеть</w> на возвышающиеся небоскребы."
                            }
                        },
                        {
                            "text": "Do not just stand there and <w>gape</w> at the accident; call for help.",
                            "target_lang_translations": {
                                "ru": "Не стой там просто так, <w>глазея</w> на аварию; позови на помощь."
                            }
                        }
                    ],
                    "synonyms": [
                        "gawk",
                        "stare",
                        "goggle"
                    ],
                    "common_phrases": [
                        "gape at the crowd"
                    ],
                    "target_lang_definitions": {
                        "ru": "Пристально смотреть с изумлением или удивлением."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "глазеть",
                                "target_lang_sense_clarification": "смотреть из праздного любопытства"
                            },
                            {
                                "target_lang_word": "таращиться",
                                "target_lang_sense_clarification": "смотреть широко раскрыв глаза"
                            },
                            {
                                "target_lang_word": "пялиться",
                                "target_lang_sense_clarification": "пристально смотреть"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "53bdc266-c844-3f58-bf83-04e13715e465",
                    "sense_definition": "To open wide; to display a wide gap or opening.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "gape-opening",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The deep canyon seemed to <w>gape</w> before the hikers as they reached the edge.",
                            "target_lang_translations": {
                                "ru": "Казалось, глубокий каньон <w>зиял</w> перед туристами, когда они добрались до края."
                            }
                        },
                        {
                            "text": "The large wound began to <w>gape</w> open, requiring immediate medical attention.",
                            "target_lang_translations": {
                                "ru": "Большая рана начала <w>зиять</w>, требуя немедленной медицинской помощи."
                            }
                        }
                    ],
                    "synonyms": [
                        "yawn",
                        "part"
                    ],
                    "antonyms": [
                        "close"
                    ],
                    "common_phrases": [
                        "gape open"
                    ],
                    "target_lang_definitions": {
                        "ru": "Широко раскрываться; образовывать глубокую щель или проем."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зиять",
                                "target_lang_sense_clarification": "быть широко раскрытым, обнаруживать глубину"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6826b671-cdff-30d2-a042-5fcf7f191ed6",
                    "sense_definition": "To open the passage to the vomeronasal organ, analogous to flehmening in other animals.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The snake would <w>gape</w> to better detect the chemical signals in its environment.",
                            "target_lang_translations": {
                                "ru": "Змея <w>открывала пасть</w>, чтобы лучше улавливать химические сигналы в окружающей среде."
                            }
                        },
                        {
                            "text": "Biologists observed the reptile <w>gape</w> after encountering the scent trail.",
                            "target_lang_translations": {
                                "ru": "Биологи наблюдали, как рептилия <w>открывает пасть</w>, обнаружив пахучий след."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "scientific"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Открывать проход к вомероназальному органу (у рептилий)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "открывать пасть",
                                "target_lang_sense_clarification": "для улавливания запахов рептилиями"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "244c805f-8df3-3692-98c7-fa9d66a8d217",
                    "sense_definition": "To depict a dilated anal or vaginal cavity upon penetrative sexual activity.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The adult film industry uses specific camera angles to show the body <w>gape</w> after penetration.",
                            "target_lang_translations": {
                                "ru": "В индустрии для взрослых используются определенные ракурсы камеры, чтобы показать, как тело <w>зияет</w> после проникновения."
                            }
                        },
                        {
                            "text": "Certain explicit illustrations depict the character <w>gape</w> in extreme detail.",
                            "target_lang_translations": {
                                "ru": "На некоторых откровенных иллюстрациях персонаж изображен с экстремальным <w>зиянием</w> во всех подробностях."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "vulgar"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Изображать расширенную анальную или вагинальную полость после проникновения (вульгарный сленг)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зиять",
                                "target_lang_sense_clarification": "оставаться широко раскрытым после проникновения"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3b5fcea5-b2ec-37e9-b61d-62c2c763ab14",
                    "sense_definition": "A large opening.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "gape-opening",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They peered down into the dark <w>gape</w> of the cave with caution.",
                            "target_lang_translations": {
                                "ru": "Они с осторожностью заглянули в темный <w>зев</w> пещеры."
                            }
                        },
                        {
                            "text": "The earthquake left a wide <w>gape</w> in the middle of the highway.",
                            "target_lang_translations": {
                                "ru": "Землетрясение оставило широкую <w>трещину</w> посреди шоссе."
                            }
                        }
                    ],
                    "synonyms": [
                        "chasm",
                        "gap",
                        "opening"
                    ],
                    "common_phrases": [
                        "wide gape"
                    ],
                    "target_lang_definitions": {
                        "ru": "Широкое отверстие, зев или провал."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зияние",
                                "target_lang_sense_clarification": "широкая щель или проем"
                            },
                            {
                                "target_lang_word": "зев",
                                "target_lang_sense_clarification": "вход в пещеру или глубокое отверстие"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4265e1ef-2fc7-3fb8-b6c1-8a9143bbca80",
                    "sense_definition": "An act of gaping; a yawn.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "gape-mouth-action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "With a wide <w>gape</w>, she tried to shake off her afternoon drowsiness.",
                            "target_lang_translations": {
                                "ru": "Широким <w>зевком</w> она попыталась стряхнуть послеполуденную сонливость."
                            }
                        },
                        {
                            "text": "His sudden <w>gape</w> made everyone in the meeting realize how boring the presentation was.",
                            "target_lang_translations": {
                                "ru": "Его внезапный <w>зевок</w> дал всем присутствующим на встрече понять, насколько скучной была презентация."
                            }
                        }
                    ],
                    "synonyms": [
                        "yawn"
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт широкого открывания рта; зевок."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зевок",
                                "target_lang_sense_clarification": "глубокий вдох при зевании"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "800096ae-9a83-3918-8059-046386ce287f",
                    "sense_definition": "The width of an opening.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "gape-measurement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The engineer measured the <w>gape</w> of the valve to ensure proper flow control.",
                            "target_lang_translations": {
                                "ru": "Инженер измерил <w>зазор</w> клапана, чтобы обеспечить надлежащий контроль потока."
                            }
                        },
                        {
                            "text": "Adjust the tool to match the precise <w>gape</w> of the metal clamp.",
                            "target_lang_translations": {
                                "ru": "Отрегулируйте инструмент в соответствии с точным <w>раствором</w> металлического зажима."
                            }
                        }
                    ],
                    "synonyms": [
                        "width",
                        "span"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ширина раскрытия или зазора."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "раствор",
                                "target_lang_sense_clarification": "величина раскрытия тисков, клапана"
                            },
                            {
                                "target_lang_word": "ширина раскрытия",
                                "target_lang_sense_clarification": "размер зазора"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6d9f0431-4919-3cf1-bdc0-0b568c82e271",
                    "sense_definition": "The maximum opening of the mouth (of a bird, fish, etc.) when it is open.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "gape-measurement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The chick's bright yellow <w>gape</w> targets the parent's attention for feeding.",
                            "target_lang_translations": {
                                "ru": "Ярко-желтый <w>рот</w> птенца привлекает внимание родителя для кормления."
                            }
                        },
                        {
                            "text": "Largemouth bass are known for a massive <w>gape</w> that allows them to swallow large prey.",
                            "target_lang_translations": {
                                "ru": "Большеротые окуни известны своей огромной <w>пастью</w>, которая позволяет им заглатывать крупную добычу."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "zoology"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Максимальное раскрытие рта или клюва (у птиц, рыб и т. д.)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разрез рта",
                                "target_lang_sense_clarification": "у животных или рыб"
                            },
                            {
                                "target_lang_word": "зев",
                                "target_lang_sense_clarification": "раскрытый клюв птицы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "80d0afd6-6072-3d63-8da2-8651a6a8a489",
                    "sense_definition": "A disease in poultry caused by gapeworm in the windpipe, a symptom of which is frequent gaping.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmer treated the flock immediately to prevent the spread of <w>gapes</w>.",
                            "target_lang_translations": {
                                "ru": "Фермер немедленно обработал стадо, чтобы предотвратить распространение <w>сингамоза</w>."
                            }
                        },
                        {
                            "text": "Chicks suffering from <w>gapes</w> struggle to breathe and gasp constantly.",
                            "target_lang_translations": {
                                "ru": "Цыплята, страдающие от <w>сингамоза</w>, тяжело дышат и постоянно задыхаются."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "veterinary medicine"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сингамоз; болезнь домашней птицы, вызываемая нематодами в трахее, симптомом которой является частое раскрывание клюва."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сингамоз",
                                "target_lang_sense_clarification": "глистное заболевание птиц"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}