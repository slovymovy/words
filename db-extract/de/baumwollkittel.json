                                "example_id": "1fe0e830-bf92-4cb9-915d-e2f8e6c2c0c9",
                                "sense_id": "489c4db7-72fa-3ae7-8dff-7b627789f931",
                                "text": "„Komm rein, sagte die Frau in dem dünnen Baumwollkittel.“"
                            },
                            {
                                "example_id": "7a3f83ba-43d8-4b31-a589-a488c4d1a132",
                                "sense_id": "489c4db7-72fa-3ae7-8dff-7b627789f931",
                                "text": "„Mutter Natur auf der Bühne, ihre Arme in Henna mit Ranken bemalt. Von den Fingerspitzen bis zu den Schulterträgern ihres regenbogenfarben gebatikten Baumwollkittels.“"
                            }
