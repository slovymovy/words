                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3da42ece-aa44-42dd-9093-7f91461a2625",
                                                "sense_id": "765fa291-4f5a-3fb6-8856-c7207d76e836",
                                                "text": "We were told then and there that we wouldn't be allowed on the grinder again until we could do a lot better. The grinder is what that large area was called, and it was a fitting name. They literally ground us down on it."
                                            },
                                            {
                                                "example_id": "56d5a4fd-e302-4b17-b92a-295ac3b24155",
                                                "sense_id": "765fa291-4f5a-3fb6-8856-c7207d76e836",
                                                "text": "Company formations are held on the grinder (basketball court outside the Quarterdeck)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "30e783c9-af4f-34c7-93c0-dcb1cbfd1a65",
