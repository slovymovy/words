                    {
                        "sense_id": "e50a351c-2f76-3865-a62d-fe89c4d88914",
                        "entry_id": "6d501fd5-872a-30df-af03-e04755bbc446",
                        "glosses": [
                            "een (meestal korte) reis"
                        ],
                        "tags": [
                            "meestal verkleinwoord"
                        ],
                        "examples": [
                            {
                                "example_id": "ca9f00da-afad-43ec-b054-6a81396c065f",
                                "sense_id": "e50a351c-2f76-3865-a62d-fe89c4d88914",
                                "text": "Ik maak een uitstapje naar zee vandaag."
                            },
                            {
                                "example_id": "d45a7e26-994a-4bae-b6aa-db4c04e71997",
                                "sense_id": "e50a351c-2f76-3865-a62d-fe89c4d88914",
                                "text": "Ze waren gekleed voor een uitstapje in tot de knieën reikende skibroeken, geitenwollen sokken, goed ingevette skischoenen en prachtige Noorse truien met een nawinternachtpatroon op de schouders."
                            }
                        ]
                    },
                    {
                        "sense_id": "e102a805-0b23-3beb-848f-2838de1253a4",
                        "entry_id": "6d501fd5-872a-30df-af03-e04755bbc446",
                        "glosses": [
                            "het verlaten van een verband of een voertuig"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a24a90c-fd51-4fef-ba74-446a7c58bcf2",
                                "sense_id": "e102a805-0b23-3beb-848f-2838de1253a4",
                                "text": "De in opspraak gebrachte politicus maakt een uitstap."
                            }
                        ]
                    }
