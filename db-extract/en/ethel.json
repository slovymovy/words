    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "80d62980-7c7a-3c4f-afd5-1fecc341c9c9",
                "word": "ethel",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "8e54721e-d13e-3c44-af6d-b8819419f654",
                        "entry_id": "80d62980-7c7a-3c4f-afd5-1fecc341c9c9",
                        "glosses": [
                            "Noble."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "c706c397-ee1e-4745-b73d-5c2cf74cfbae",
                                "sense_id": "8e54721e-d13e-3c44-af6d-b8819419f654",
                                "text": "\"I have come to seek your counsel in your most ethel of ethical capacities. My problem is wholly mechanical.\""
                            },
                            {
                                "example_id": "5c5f6f12-12c8-4cc6-bbc8-e48943343e77",
                                "sense_id": "8e54721e-d13e-3c44-af6d-b8819419f654",
                                "text": "The violation of an ethel born or noble woman was paid for by a higher murde than that of an un-ethel or common person. The murder of all persons was in like manner paid for by a were or were-geld, nicely adjusted to their relative rank."
                            },
                            {
                                "example_id": "664cc2b4-a790-4de4-a862-243bef814105",
                                "sense_id": "8e54721e-d13e-3c44-af6d-b8819419f654",
                                "text": "[…] that he was of a doughty and ethel stirp. His ayle and eam had both been bellipotent; […]"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "6ac38aca-2735-3b78-9e30-1ce448521e55",
                "word": "Ethel",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "e83d63fc-c649-35e4-81c1-60fac6d11253",
                        "entry_id": "6ac38aca-2735-3b78-9e30-1ce448521e55",
                        "glosses": [
                            "A female given name from Old English, popular at the turn of the 20th century."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52519aec-41c6-4082-af2c-4852604ee8af",
                                "sense_id": "e83d63fc-c649-35e4-81c1-60fac6d11253",
                                "text": "If it is so false, and base, and hollow, this great world […] why does Ethel Newcome cling to it? Will you be fairer, dear, with any other name than your own?"
                            },
                            {
                                "example_id": "b723b43a-e5f2-4d6d-9255-5fac07a8bfc2",
                                "sense_id": "e83d63fc-c649-35e4-81c1-60fac6d11253",
                                "text": "Charmian Lyle had given herself her first name at the age of sixteen, upon encountering it in an English novel. Her baptismal name was Ethel. When her husband Walter was extremely angry with her, he called her Ethel.\nCharmian, she thought, suited her much better. She didn't think she looked, felt, or sounded like Ethel. Nor like her middle name, which she really detested, Edna."
                            },
                            {
                                "example_id": "61a6f465-ecaf-4833-af2e-9eddb789660c",
                                "sense_id": "e83d63fc-c649-35e4-81c1-60fac6d11253",
                                "text": "Two of Kennedy’s sons, Robert F. Kennedy, Jr. and Douglas Kennedy, supported the release during Sirhan’s 16th appearance before the California Parole Board. But other family members, including RFK’s widow Ethel, felt Sirhan should remain imprisoned."
                            }
                        ]
                    },
