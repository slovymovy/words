                                    {
                                        "sense_id": "9673441b-5710-3770-87e6-721feb80d357",
                                        "entry_id": "5411d6ec-75af-3913-8123-3565ca64afe7",
                                        "glosses": [
                                            "Anzahl der Mitglieder eines Gremiums oder sonstiger Stimmberechtigter, welche für die Gültigkeit eines Beschlusses oder einer Abstimmung anwesend sein oder sich an ihr beteiligen muss"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1dd2331-d722-493b-a690-407d275676fe",
                                                "sense_id": "9673441b-5710-3770-87e6-721feb80d357",
                                                "text": "Das Referendum für einen Weiterbestand des Flughafens in Zentrumsnähe ist knapp am Quorum gescheitert: Statt einem Viertel der Wahlberechtigten hat nur ein Fünftel der Berliner für die Rettung Tempelhofs votiert."
                                            },
                                            {
                                                "example_id": "18b6b0bc-5171-4fcf-852c-e672885eaa3d",
                                                "sense_id": "9673441b-5710-3770-87e6-721feb80d357",
                                                "text": "Er wollte Prodi zwar nicht das Vertrauen aussprechen, nahm allerdings an der Abstimmung nicht teil und senkte damit auf diese Weise das nötige Quorum."
                                            },
                                            {
                                                "example_id": "b3bbd274-35b7-45b9-b950-1a3821fcb71b",
                                                "sense_id": "9673441b-5710-3770-87e6-721feb80d357",
                                                "text": "Zusätzlich werde noch eine Anwesenheit von zwei Drittel der Eltern vorgeschrieben, womit es äußert unwahrscheinlich sei, dass ein entsprechendes Quorum erreicht werde."
                                            },
                                            {
                                                "example_id": "9d68271d-dc7d-4a4c-a7d3-67bd0f846d56",
                                                "sense_id": "9673441b-5710-3770-87e6-721feb80d357",
                                                "text": "„Alljährlich sprach man jetzt von einer Abgeordenetenversammlung, und das Quorum war um die Hälfte reduziert worden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e61697f2-90cf-3847-9229-e9f588649142",
                                        "entry_id": "5411d6ec-75af-3913-8123-3565ca64afe7",
                                        "glosses": [
                                            "Anzahl der unter [1] erwähnten Mitglieder oder Stimmberechtigten, die für die Gültigkeit eines Beschlusses zustimmen muss"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e12a4f2b-4902-4258-afcc-629fdb2add44",
                                                "sense_id": "e61697f2-90cf-3847-9229-e9f588649142",
                                                "text": "Mit einer Stimme mehr als dem erforderlichen Quorum billigten die französischen Abgeordneten und Senatoren am Montagabend im Schloss von Versailles eine von der konservativen Regierung geplante Verfassungsreform."
                                            },
                                            {
                                                "example_id": "9296d06f-9126-462a-82be-75c16bc85fda",
                                                "sense_id": "e61697f2-90cf-3847-9229-e9f588649142",
                                                "text": "Die elf türkischen Verfassungsrichter stimmten zwar mit sechs zu fünf Stimmen für ein Parteiverbot, jedoch wurde das erforderliche Quorum von sieben Ja-Stimmen nicht erreicht."
                                            },
                                            {
                                                "example_id": "0f89d39e-c508-41de-832c-4356b4b97360",
                                                "sense_id": "e61697f2-90cf-3847-9229-e9f588649142",
                                                "text": "Nur mit einem gemeinsamen Vorgehen erreicht sie ein dafür notwendiges Quorum von einem Viertel der Abgeordneten."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
