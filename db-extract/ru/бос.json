                        "translation_id": "63a343a7-5682-4d8d-b246-4b3116d7e7b8",
                        "source_entry_id": "581249b8-5471-3de7-b43b-829230746805",
                        "source_sense_id": "d4fb154e-59d3-3f9b-971d-22ee613efd0f",
                        "target_lang_word": "Beauce",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Beauce",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5836b8c8-252c-3a70-ac2e-a6dc29f783b2",
                                        "entry_id": "3fbc7044-6a51-3b43-82ff-f70bf51eeb14",
                                        "glosses": [
                                            "Région de France, au sud-ouest de Paris."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3ad6ce2-2885-43c5-bf5e-4c274a319beb",
                                                "sense_id": "5836b8c8-252c-3a70-ac2e-a6dc29f783b2",
                                                "text": "L’année précédente, le sang de rate avait décimé les troupeaux de la Beauce."
                                            },
                                            {
                                                "example_id": "6a24dca2-91d6-443f-8f9d-78cd08972c1f",
                                                "sense_id": "5836b8c8-252c-3a70-ac2e-a6dc29f783b2",
                                                "text": "Le train filait ; il avait franchi les plaines de la Beauce, plus mélancoliques encore à regarder qu’aux jours poignants de la guerre…"
                                            },
                                            {
                                                "example_id": "8eed7a5c-5952-487f-828e-9f86185136e1",
                                                "sense_id": "5836b8c8-252c-3a70-ac2e-a6dc29f783b2",
                                                "text": "La commune peut ne comprendre qu’un chef-lieu, ainsi dans l’ouest aux abords de la Beauce, Desmonts et Courcelles, ou, un chef-lieu et une multitude d’écarts (maisons isolées, groupements élémentaires et localités autres que le chef-lieu…), dans le pays bocager aux allures de Puisaye."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f599fbac-b036-3a70-9f1a-4c7e41922635",
                                        "entry_id": "3fbc7044-6a51-3b43-82ff-f70bf51eeb14",
                                        "glosses": [
                                            "Région du Québec, vallée de la rivière Chaudière."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eae6a26c-8fff-452b-ac96-d527f621e67f",
                                                "sense_id": "f599fbac-b036-3a70-9f1a-4c7e41922635",
                                                "text": "Vendredi, les régions de l’Estrie et de la Beauce connaîtront un ennuagement et de pluie intermittente en après-midi et des températures de 5 à 6 degrés C avec refroidissement éolien."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
