                "senses": [
                    {
                        "sense_id": "0fb57b16-ecfe-376a-961e-9af3f505c805",
                        "entry_id": "7e40b0d4-b7fb-3f78-9f0e-d5c79022b9c1",
                        "glosses": [
                            "Faire un son de cloche."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f1ef08e8-1b00-4166-9fb0-9016f448b9a3",
                                "sense_id": "0fb57b16-ecfe-376a-961e-9af3f505c805",
                                "text": "Faut vous dire qu’on a trinqué une dernière chope, qu’on est quasiment sortis ensemble et que le carillon de l’église qu’est juste au-dessus de l’estaminet a diguedingué juste à c’t’ heure et que j’ lui ai collé : « Grouille-toi, tu vas te faire sonner les choches. »"
                            },
                            {
                                "example_id": "621dce7c-7e7b-4f53-b3d8-fbecd25dac8f",
                                "sense_id": "0fb57b16-ecfe-376a-961e-9af3f505c805",
                                "text": "On entend diguedinguer la cloche de La Côste, celle qu’elle est dans une cage de fine grille, pareil un oiseau précieux."
                            },
                            {
                                "example_id": "8a7cd546-5491-41ec-9c5f-0b5eece45d91",
                                "sense_id": "0fb57b16-ecfe-376a-961e-9af3f505c805",
                                "text": "Faites pas diguedinguer les casseroles !"
                            }
                        ]
                    }
                ],
