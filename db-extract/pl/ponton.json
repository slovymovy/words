                    {
                        "translation_id": "0028b240-08aa-4573-965a-8d2c082fc51e",
                        "source_entry_id": "48b6970f-3b89-3bda-a73b-29b5fd7e785a",
                        "source_sense_id": "22438aef-aaeb-3093-80eb-b6577acbd5e7",
