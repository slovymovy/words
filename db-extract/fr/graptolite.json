                "forms": [
                    {
                        "form_id": "50521865-334f-4eb0-a3b6-c46a8f01b17f",
                        "entry_id": "f2ef2eb7-a553-3410-ad7c-3338fb1b03fe",
                        "tags": [
                            "plural"
                        ],
                        "form": "graptolites"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "443fef36-b10a-352c-86c9-d7348d944dda",
                        "entry_id": "f2ef2eb7-a553-3410-ad7c-3338fb1b03fe",
                        "glosses": [
                            "Organisme animal vivant en colonies dans les mers à l’époque paléozoïque."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b0638fa-dc2c-4aae-b35c-de4fb0fe1dd4",
                                "sense_id": "443fef36-b10a-352c-86c9-d7348d944dda",
                                "text": "Les graptolites qui tapissaient comme une mousse les rochers sous-marins, peuvent compter parmi les êtres les plus remarquables de la période silurienne."
                            },
                            {
                                "example_id": "4d491263-7645-4c5f-9293-dfdb662a3a18",
                                "sense_id": "443fef36-b10a-352c-86c9-d7348d944dda",
                                "text": "Le général de la Marmora raconte, dans le voyage en Sardaigne qu’il publia en 1857, que ce n’est qu’après plusieurs années de recherches qu’il découvrit, dans les schistes, le premier fossile, se rattachant au genre graptolite, d’après lequel il classa ceux-ci dans l’étage silurien."
                            },
                            {
                                "example_id": "c1731174-36dc-485d-9d8c-ee4f857ea3ed",
                                "sense_id": "443fef36-b10a-352c-86c9-d7348d944dda",
                                "text": "À l’œil nu, les graptolites se présentent dans les archives fossiles comme des sortes de rayures sur les roches ou, parfois, comme de minuscules pétroglyphes."
                            }
                        ]
                    }
                ],
                "translations": [
