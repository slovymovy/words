                        "entry_id": "ac52fa0c-a396-3eb8-ad4b-6baac87700d0",
                        "glosses": [
                            "schijf bestaand uit sterk golvende stof rondom de hals, als versiering van bovenkleding"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25320107-a3b0-4f4b-b05c-9ab15741c8c5",
                                "sense_id": "e722f385-da47-3090-822a-f1934d890505",
                                "text": "De geportretteerden, kinderen, dragen allemaal zo’n kraag – dezelfde kraag. Het is een historische molensteenkraag, afkomstig uit het Rijksmuseum Amsterdam."
                            },
                            {
                                "example_id": "7be09c73-7ea3-4dd6-aa41-2f0f41666967",
                                "sense_id": "e722f385-da47-3090-822a-f1934d890505",
                                "text": "⧖ Onder dezen invloed wordt het plooisel binnenkort een geweldigen \"molensteenkraag\" waarop het hoofd rust \"evenals het hoofd van Johannes op den schotel van Herodias.\""
                            }
                        ]
                    }
