                                    {
                                        "sense_id": "5e2b484f-1626-3e91-80b7-ce611016334e",
                                        "entry_id": "4da9ac4f-8baf-3a9f-a433-6ef89c0ea6b1",
                                        "glosses": [
                                            "To act like a gangster; to commit street crime or run a racket."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "gangster",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "de4e0522-79c4-3842-a975-f0495cf16a8c",
                                        "entry_id": "52aef687-c52d-3102-9733-85fe1c5296ac",
                                        "glosses": [
                                            "Characteristic of a gangster; (especially) admirable and audacious."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e86657ea-dfa6-4d33-a82b-103d3b8ebca3",
                                                "sense_id": "de4e0522-79c4-3842-a975-f0495cf16a8c",
                                                "text": "I looked at my team and thought, \"Damn, now that was the most gangster move I have ever seen in my life. I think we just strong-armed a government official in Sierra Leone!\""
                                            },
                                            {
                                                "example_id": "2df5ee38-f0b9-469a-84c8-2a896f11f0a0",
                                                "sense_id": "de4e0522-79c4-3842-a975-f0495cf16a8c",
                                                "text": "Sampling is the most gangsta shit ever. Im finna steal yo life's work and make it into trap music"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "18a31d3c-4521-34f3-8e8d-4bcd6216368b",
                                        "entry_id": "52aef687-c52d-3102-9733-85fe1c5296ac",
                                        "glosses": [
                                            "On friendly terms; cool."
                                        ],
                                        "tags": [
                                            "Internet",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b2675c85-4793-451b-9dcd-bca7d4264b4e",
                                                "sense_id": "18a31d3c-4521-34f3-8e8d-4bcd6216368b",
                                                "text": "We put an end to our beef. We're all gangster now."
                                            },
                                            {
                                                "example_id": "396cb2db-b61d-40b7-a5e6-5e31ee61e498",
                                                "sense_id": "18a31d3c-4521-34f3-8e8d-4bcd6216368b",
                                                "text": "\"Oh, soft ass pretty boy, trying to act all hard for his little girlfriend. Don't he know that we gangsta over here. We don't beef over females. Share and share alike,\" Corey said, laughing."
                                            },
                                            {
                                                "example_id": "59f93e86-b38f-42cf-b638-1a8c6151415a",
                                                "sense_id": "18a31d3c-4521-34f3-8e8d-4bcd6216368b",
                                                "text": "everyone gangsta until NATO starts shipping Burger Kings onto the scene"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "44d0aea7-55e2-4544-8356-cb8302d004ad",
