                        "entry_id": "1df3672b-8b5b-33a7-b210-8a55ced3d9eb",
                        "glosses": [
                            "meist selbstständige Handwerkerin, Gewerbetreibende, Mühlenbesitzerin, aber auch Arbeiterin, die in einer Mühle das Getreide oder anderes Mahlgut, zum Beispiel ölhaltige Pflanzenteile, lagert, reinigt und mahlt; eine, die Mehl herstellt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "277fa4fa-6c89-4269-92df-cf8fe6e2c0ea",
                                "sense_id": "24c0af46-7926-3bea-8678-44031cf8089f",
                                "text": "Die Müllerin hört es nachts immer klappern, aber sie macht sich darüber keine Gedanken mehr."
                            }
                        ],
