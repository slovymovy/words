                "senses": [
                    {
                        "sense_id": "d6093ae8-b194-3d30-be1a-ecdc7c478e56",
                        "entry_id": "2c00e6ed-5f43-3544-a7bf-6f1e2fac0fdf",
                        "glosses": [
                            "Arbeitnehmer, der überwiegend körperlich hart, schwer arbeitet"
                        ],
                        "tags": [
                            "casual"
                        ],
                        "examples": [
                            {
                                "example_id": "f36d1563-29ba-4ed2-b04a-e1fe8416d822",
                                "sense_id": "d6093ae8-b194-3d30-be1a-ecdc7c478e56",
                                "text": "„Wer arbeitet, muss essen. Und weil mittags oft keine Zeit bleibt, den heimischen Herd aufzusuchen, strömen täglich zwischen elf und 14 Uhr mindestens sechs Millionen Malocher, Büroangestellte, Studenten und Manager in \"ihre\" Betriebskantine.“"
                            },
                            {
                                "example_id": "c0aa0c98-2fe2-4fae-b506-90836dc596e9",
                                "sense_id": "d6093ae8-b194-3d30-be1a-ecdc7c478e56",
                                "text": "„Bis heute fühlt sich der Sohn eines Stahlarbeiters den Malochern daheim näher als den vielen Bankern in seinem Großherzogtum Luxemburg.“"
                            },
                            {
                                "example_id": "332198ba-5be5-49fc-9944-d948211e8b4c",
                                "sense_id": "d6093ae8-b194-3d30-be1a-ecdc7c478e56",
                                "text": "„Er wohnt in der Neuköllner Gropiusstadt und war Zeit seines Lebens Malocher.“"
                            },
                            {
                                "example_id": "a0dec36a-aa84-4b7d-aaf8-2e4b101d46e3",
                                "sense_id": "d6093ae8-b194-3d30-be1a-ecdc7c478e56",
                                "text": "„Na gut, diese Malocher waren nicht so gebildet und konnten daher gewiss nicht allein für sich sprechen, sonst aber wusste man recht wenig über sie.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2187dd9f-ae39-4806-b04a-e632d72c40fb",
                        "source_entry_id": "2c00e6ed-5f43-3544-a7bf-6f1e2fac0fdf",
                        "source_sense_id": "d6093ae8-b194-3d30-be1a-ecdc7c478e56",
                        "source_sense_description": "besonders mittelwestdeutsch, salopp: Arbeitnehmer, der überwiegend körperlich hart, schwer arbeitet",
                        "target_lang_word": "labourer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "labourer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3bda8bd5-212d-3edf-a007-f1dc026fa49c",
                                        "entry_id": "686513bd-0087-3e33-8f3f-1e4b5010e897",
                                        "glosses": [
                                            "British standard spelling of laborer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "68c2f587-8786-430f-a6c6-baf52f12fca8",
                                                "sense_id": "3bda8bd5-212d-3edf-a007-f1dc026fa49c",
                                                "text": "This time was most dreadful for Lilian. Thrown on her own resources and almost penniless, she maintained herself and paid the rent of a wretched room near the hospital by working as a charwoman, sempstress, anything. In a moment she had dropped to the level of a casual labourer."
                                            },
                                            {
                                                "example_id": "aceef10b-dd1d-410a-9495-e5d34ee3d6b9",
                                                "sense_id": "3bda8bd5-212d-3edf-a007-f1dc026fa49c",
                                                "text": "By the mid-19th century, the typical village was sharply divided between the landowning class and the landless, voteless and largely illiterate labourers."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
