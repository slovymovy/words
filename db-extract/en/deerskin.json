                "senses": [
                    {
                        "sense_id": "0b9c0d7b-94a3-38f1-8651-4868c3ac81c1",
                        "entry_id": "f2681e15-81f0-357a-a7e8-a035442d2cd4",
                        "glosses": [
                            "Leather made from deer hide."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "5f71ec6d-cf61-4506-a01e-bb41ac4e1a79",
                                "sense_id": "0b9c0d7b-94a3-38f1-8651-4868c3ac81c1",
                                "text": "The moccasin maker had a pile of deerskin on the table, waiting to be cut out."
                            },
                            {
                                "example_id": "d9eada58-77ae-45cb-a7e1-078f8c55303d",
                                "sense_id": "0b9c0d7b-94a3-38f1-8651-4868c3ac81c1",
                                "text": "Nichole wore a pair of deerskin gloves because she said she could feel more through them."
                            }
                        ]
                    },
                    {
                        "sense_id": "e75bf5fc-48d5-3d13-84b4-245d2d87865d",
                        "entry_id": "f2681e15-81f0-357a-a7e8-a035442d2cd4",
                        "glosses": [
                            "The hide, whether tanned or not, of one deer."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": [
                            {
                                "example_id": "72b8ff9b-b544-4c46-bb22-c7ecb405d44d",
                                "sense_id": "e75bf5fc-48d5-3d13-84b4-245d2d87865d",
                                "text": "The hunter exchanged twenty deerskins for a bottle of whiskey at the trading post."
                            }
                        ]
                    },
                    {
                        "sense_id": "41770081-ae06-3a8f-a0d8-756e23be8eab",
                        "entry_id": "f2681e15-81f0-357a-a7e8-a035442d2cd4",
                        "glosses": [
                            "An article of clothing manufactured from deerskin. Often constructed in the plural."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": [
                            {
                                "example_id": "9e994351-fba4-4715-983e-6c1a93f40c6d",
                                "sense_id": "41770081-ae06-3a8f-a0d8-756e23be8eab",
                                "text": "The trapper wore deerskins because they were softer than cow leather garments and rustled less than canvas."
                            }
                        ]
                    }
                ],
