                "senses": [
                    {
                        "sense_id": "bf3fdd5b-0436-38b5-bff0-4af7d8367c7b",
                        "entry_id": "b3675786-a8a9-31b5-ba94-6387d5aaf0d2",
                        "glosses": [
                            "Stelle am Ende einer Sackgasse, um ein Fahrzeug zu wenden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a25deaf-2030-48ce-8074-c2cf898f4caa",
                                "sense_id": "bf3fdd5b-0436-38b5-bff0-4af7d8367c7b",
                                "text": "„Hier gehen wir geradeaus oberhalb von einem Graben weiter und gelangen so schließlich zu einem Wendeplatz am Waldweg im unteren Teil der Siedlung Susenburg.“"
                            },
                            {
                                "example_id": "2a9da2c6-5c6a-4758-b1c7-cc558f737a09",
                                "sense_id": "bf3fdd5b-0436-38b5-bff0-4af7d8367c7b",
                                "text": "„So stellte er den rostigen Omega einfach auf den gegenüberliegenden Wendeplatz, der eigentlich für die Busse gedacht war.“"
                            },
                            {
                                "example_id": "c7b16de0-1938-4a87-a113-661d602eb378",
                                "sense_id": "bf3fdd5b-0436-38b5-bff0-4af7d8367c7b",
                                "text": "„Am Ende des Flakvej suchte er sich auf dem Wendeplatz eine verborgene Ecke aus, wo Büsche sein Auto vor neugierigen Blicken schützten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
