                "translations": [
                    {
                        "translation_id": "ba3d476b-2ac6-40dc-a551-9c86373501e9",
                        "source_entry_id": "735ac9cb-88e6-3fd4-868b-9613110bdf33",
                        "source_sense_id": "0dd0ab59-51d8-36bd-b23b-62aaf37c1659",
                        "target_lang_word": "preseed",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "preseed",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "411cd0b3-465b-3649-9aed-aa9c30ceed8e",
                                        "entry_id": "3859fd2c-7042-3520-aa7a-48b46df91da1",
                                        "glosses": [
                                            "To seed in advance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e31f0ec0-690c-4d09-8465-c99f32c24662",
                                                "sense_id": "411cd0b3-465b-3649-9aed-aa9c30ceed8e",
                                                "text": "[…] I loaned them the valve that they used to seed the clouds or preseed them with liquid nitrate solution […]"
                                            },
                                            {
                                                "example_id": "4784ffc3-c73c-441e-9ccb-644fbf4f62a3",
                                                "sense_id": "411cd0b3-465b-3649-9aed-aa9c30ceed8e",
                                                "text": "Also included in the menu is the possibility to preseed the entire LSE matrix to any desired level, thus providing a base for many classes of experiment."
                                            },
                                            {
                                                "example_id": "10fbec2a-2d36-46ca-b948-1adbfcfa5b6c",
                                                "sense_id": "411cd0b3-465b-3649-9aed-aa9c30ceed8e",
                                                "text": "Under this scheme, an outbreak of influenza in one year would preseed the population to give a pattern of latent infectives from which a subsequent outbreak would arise in a later year."
                                            },
                                            {
                                                "example_id": "deb1de2e-60e7-4b6d-aa8d-5dcc972f88b7",
                                                "sense_id": "411cd0b3-465b-3649-9aed-aa9c30ceed8e",
                                                "text": "If you haven't been able to preseed the filter with bacteria from another aquarium […]"
                                            },
                                            {
                                                "example_id": "1d052cf1-f127-4e40-82d6-91be847173f8",
                                                "sense_id": "411cd0b3-465b-3649-9aed-aa9c30ceed8e",
                                                "text": "Preseed plates by spreading approximately 108 phage each of λKH54 and λKH54h80."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "preseed",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "781a3d83-da23-3728-93dc-d00245b40eac",
                                        "entry_id": "b9615ab3-324d-32b5-8c79-132de295ec48",
                                        "glosses": [
                                            "A medium specially prepared for a seeding operation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "73521aff-6014-4272-abbe-7c48620156ce",
                                                "sense_id": "781a3d83-da23-3728-93dc-d00245b40eac",
                                                "text": "The preseed is then transferred aseptically to 20-liter seed tanks [....]"
                                            },
                                            {
                                                "example_id": "4fa7c2ef-827e-40a7-b2f5-1c76cd7548ba",
                                                "sense_id": "781a3d83-da23-3728-93dc-d00245b40eac",
                                                "text": "The preseed was incubated with mild agitation at 30 \"C for 24 h."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "preseed",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5ad3d795-0150-3b4a-a892-7f2dba784afc",
                                        "entry_id": "b307fbfc-b85e-3823-bce4-2426152d05b1",
                                        "glosses": [
                                            "Before a seeding or seed stage of development."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ffde950b-4c0b-4fca-a6a1-75af14aada5e",
                                                "sense_id": "5ad3d795-0150-3b4a-a892-7f2dba784afc",
                                                "text": "Increases in one experiment ranged from 10 to 200 times the preseed rainfall from the individual clouds, [....]"
                                            },
                                            {
                                                "example_id": "cfebc2f9-0e8f-44d6-aad9-46241940201c",
                                                "sense_id": "5ad3d795-0150-3b4a-a892-7f2dba784afc",
                                                "text": "There are many traditional sources of funding, but for new spin-off company creation, gaining access to early stage (angel, preseed, and seed) [...]"
                                            },
                                            {
                                                "example_id": "4f8c8f37-489a-48a1-a5ab-0b4937c8111e",
                                                "sense_id": "5ad3d795-0150-3b4a-a892-7f2dba784afc",
                                                "text": "The totality of the preseed culture is added into the final culture composed of the same medium."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
