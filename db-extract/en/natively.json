                "senses": [
                    {
                        "sense_id": "61984ab7-945a-39cb-8deb-8625c89d80b5",
                        "entry_id": "d7ca5754-19d2-3396-9730-00705f6eb442",
                        "glosses": [
                            "In the manner of a native, especially a native speaker."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "b51ffe4c-0946-4445-b44d-575988041fb5",
                                "sense_id": "61984ab7-945a-39cb-8deb-8625c89d80b5",
                                "text": "He spoke French natively, having been born there, and English almost as well."
                            },
                            {
                                "example_id": "d214705b-e082-4006-bea1-b3c67986add0",
                                "sense_id": "61984ab7-945a-39cb-8deb-8625c89d80b5",
                                "text": "This is because by definition, a pidgin is not learned natively."
                            }
                        ]
                    },
                    {
                        "sense_id": "36a25c70-e062-3e53-8d07-9389411d50bc",
                        "entry_id": "d7ca5754-19d2-3396-9730-00705f6eb442",
                        "glosses": [
                            "Pertaining to the computer or architecture in question; without the use of emulation, etc."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "29d03e7a-9468-47e0-9148-e7d0b5f28f28",
                                "sense_id": "36a25c70-e062-3e53-8d07-9389411d50bc",
                                "text": "This is a Microsoft Windows application, so you can't run it natively on an Apple Mac."
                            }
                        ]
                    },
                    {
                        "sense_id": "f111c2d2-9087-3da2-ba22-37f03d354ad4",
                        "entry_id": "d7ca5754-19d2-3396-9730-00705f6eb442",
                        "glosses": [
                            "In the manner that occurs naturally; without intervention or training."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "f10776fd-cff1-44cc-b892-57998da49f7f",
                                "sense_id": "f111c2d2-9087-3da2-ba22-37f03d354ad4",
                                "text": "The experiment showed only what the mass must always be— natively incapable of controlling their passions, natively eager for their enjoyment, and natively envious of the original superiority of birth, affluence, and knowledge."
                            },
                            {
                                "example_id": "61c272e4-b14a-44eb-9746-8ed835dfe65f",
                                "sense_id": "f111c2d2-9087-3da2-ba22-37f03d354ad4",
                                "text": "The vines of some species are always found natively in limy soils, and varieties of such species generally succeed well in such soils.·"
                            },
                            {
                                "example_id": "74206ccb-2578-4fbf-96d4-d2fd7c8a498b",
                                "sense_id": "f111c2d2-9087-3da2-ba22-37f03d354ad4",
                                "text": "Since a transsexual is a person with natively male genitalia who nevertheless has had a lifelong sense of femaleness, the purpose of surgery should logically be to provide such a person with anatomy and sexual response as close as possible to that of any other woman."
                            },
                            {
                                "example_id": "14e1f752-ffba-4fd0-8496-77ba5bec0f0e",
                                "sense_id": "f111c2d2-9087-3da2-ba22-37f03d354ad4",
                                "text": "Several useful fetures of disordered regions are, however, discernable, and we consider them in the context of a few of the structurally and biochemically characterized biologic systems in which the function of natively unfolded proteins has been investigated."
                            },
                            {
                                "example_id": "543eb7c2-35fa-47b5-aa04-1d540c7bb1a3",
                                "sense_id": "f111c2d2-9087-3da2-ba22-37f03d354ad4",
                                "text": "The sin of Adam, by which we are brought under condemnation, is ours originally, natively, and intrinsically; and the nature which we inherit and originally possess is the very nature by which the apostasy was wrought."
                            }
                        ]
                    },
                    {
                        "sense_id": "bc909c58-8d7e-3b5a-a358-1d2fc5983c97",
                        "entry_id": "d7ca5754-19d2-3396-9730-00705f6eb442",
                        "glosses": [
                            "Inherently, innately."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "092e3e13-ba83-44ad-a1dd-4fe7c50f0758",
                                "sense_id": "bc909c58-8d7e-3b5a-a358-1d2fc5983c97",
                                "text": "On the other hand, some subjects are not natively interesting, but they become interesting when we study them extensively, that is, they have an acquired interest."
                            },
                            {
                                "example_id": "adb4d160-e7c8-4755-8d3e-c4446b17bf4b",
                                "sense_id": "bc909c58-8d7e-3b5a-a358-1d2fc5983c97",
                                "text": "In sizing up his first season with the Smart Set, Indianapolis-based columnist Will M. Lewis concluded that Dudley's portrayal of George Washington Bullion \"belongs to the Hogan class; not so natively funny, but with better judgement. […]\""
                            },
                            {
                                "example_id": "ec5cb216-0011-467b-9c6f-e6209741cfda",
                                "sense_id": "bc909c58-8d7e-3b5a-a358-1d2fc5983c97",
                                "text": "Even natively fictive characters can be used as a commentary on real-life politicians such as Donald Trump."
                            }
                        ]
                    }
