{
    "word": "standardization",
    "lang_code": "en",
    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "c3d39bdc-96a1-3e95-ac78-cb4b80a2fca2",
                "word": "standardization",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "a6de955f-4e87-401c-b7c3-a5845933892a",
                        "entry_id": "c3d39bdc-96a1-3e95-ac78-cb4b80a2fca2",
                        "tags": [
                            "plural"
                        ],
                        "form": "standardizations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "11c42732-e34c-36f5-a419-9959c20481db",
                        "entry_id": "c3d39bdc-96a1-3e95-ac78-cb4b80a2fca2",
                        "glosses": [
                            "The process of complying (or evaluate by comparing) with a standard."
                        ],
                        "tags": [
                            "British",
                            "English",
                            "Oxford",
                            "US",
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "a09f5af6-3abf-3209-88f7-fe641167fef0",
                        "entry_id": "c3d39bdc-96a1-3e95-ac78-cb4b80a2fca2",
                        "glosses": [
                            "The process of establishing a standard."
                        ],
                        "tags": [
                            "British",
                            "English",
                            "Oxford",
                            "US",
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "d5177627-7b9c-45b8-a9f2-84f69687e43b",
                                "sense_id": "a09f5af6-3abf-3209-88f7-fe641167fef0",
                                "text": "The FCC says it decided to attempt standardization of VHF receivers after getting \"thousands of complaints\" from disgruntled boatmen who found their sets brought in mostly a lot of garble and static."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ef914dbf-a90c-4d8c-ad3c-e41055c6c10f",
                        "source_entry_id": "c3d39bdc-96a1-3e95-ac78-cb4b80a2fca2",
                        "source_sense_description": "process of complying with a standard",
                        "target_lang_word": "standardisation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "standardisation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "679b3d4a-8916-35e1-b9f3-b6c13d1a5e96",
                                        "entry_id": "aaa32fd0-daf3-38af-8b3e-fd53d101024b",
                                        "glosses": [
                                            "Normalisation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ff9b9a4-2fd7-44f9-9fbe-3fe58928ece3",
                                                "sense_id": "679b3d4a-8916-35e1-b9f3-b6c13d1a5e96",
                                                "text": "Il est très important de placer les écouteurs correctement. Les recommandations faites par les organismes de standardisation disent qu'il faut appliquer une force par l'emploi d'un serre-tête ou de tout autre moyen équivalent."
                                            },
                                            {
                                                "example_id": "52cddf91-d6ad-48fe-b9cf-f044997e0ef5",
                                                "sense_id": "679b3d4a-8916-35e1-b9f3-b6c13d1a5e96",
                                                "text": "Cela risque d’engendrer « une standardisation des visages », note Michaël Stora."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7829cd08-c537-4e89-92a8-1be6bc2e8261",
                        "source_entry_id": "c3d39bdc-96a1-3e95-ac78-cb4b80a2fca2",
                        "source_sense_description": "process of complying with a standard",
                        "target_lang_word": "Standardisierung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Standardisierung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "22e1634f-664a-30ed-9979-9e65d87f57fe",
                                        "entry_id": "2e6303cb-4af2-3d3a-ae6b-5bb886b9e1d7",
                                        "glosses": [
                                            "eine Normung oder Vereinheitlichung von etwas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ddbcc594-edc0-46f4-9f0d-1aa059d3e3dc",
                                                "sense_id": "22e1634f-664a-30ed-9979-9e65d87f57fe",
                                                "text": "„Wie sich Standardisierung - und in engem Zusammenhang damit auch Verschriftung - auf eine Sprache auswirken, bleibt in Kellers Ausführungen zum Sprachwandel nach der Theorie der unsichtbaren Hand unberücksichtigt.“"
                                            },
                                            {
                                                "example_id": "d1fc6a8e-86b3-4aea-9058-755fe4d9a584",
                                                "sense_id": "22e1634f-664a-30ed-9979-9e65d87f57fe",
                                                "text": "„Der mit jeder Standardisierung notwendig verbundene Begriff einer sprachlichen Vereinheitlichung mit dem Ergebnis einer sprachlichen Norm ist in seinen neueren Ausprägungen gebrauchsorientiert.“"
                                            },
                                            {
                                                "example_id": "8ab4b46a-ec19-416c-be75-481a25d2ec0e",
                                                "sense_id": "22e1634f-664a-30ed-9979-9e65d87f57fe",
                                                "text": "„Da das Konstrukt im Vergleich zur Objektsprache immer reduktionistisch ist, weil es aus dem empirisch beobachtbaren Ausgangsmaterial nur das als usuell Nachweisbare herausdestilliert, bedeutet dies zumindestens eine Standardisierung nach dem Kriterium üblich/nicht üblich, wenn nicht gar eine Normierung nach dem Gesichtspunkt richtig/falsch.“"
                                            },
                                            {
                                                "example_id": "04a77b2c-2831-45d5-8a1d-2b4892ebd245",
                                                "sense_id": "22e1634f-664a-30ed-9979-9e65d87f57fe",
                                                "text": "„Die Einigung der Rechtschreibung und Standardisierung der Interpunktion ging in Deutschland mit der politischen Einigung einher.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "895ec5c1-ec37-4250-93ef-1c3f4ee7ea7c",
                        "source_entry_id": "c3d39bdc-96a1-3e95-ac78-cb4b80a2fca2",
