                                                "sense_id": "d42cd7b3-f2f3-3f8f-9442-fdc029b37700",
                                                "text": "Die Filme des früheren 20. Jahrhunderts gefallen mir besser."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "22771b4a-5966-3da4-9947-b34bc32e88ff",
                                        "entry_id": "94e4fc69-58c3-324f-acad-75e8a3d77d5e",
                                        "glosses": [
                                            "gewesen, zurückliegend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7bc66131-ebff-4209-a7ea-472007ca566d",
                                                "sense_id": "22771b4a-5966-3da4-9947-b34bc32e88ff",
                                                "text": "Das ist meine frühere Freundin."
                                            },
                                            {
                                                "example_id": "095ae31c-f122-4484-ae01-a4f67e73734e",
                                                "sense_id": "22771b4a-5966-3da4-9947-b34bc32e88ff",
                                                "text": "„Neben dem früheren Museum für Verkehr und Bau sowie dem Meereskundlichen Museum hatte die Deutsche Luftfahrt-Sammlung mit über 100 Motorfliegern bis dahin eine der bedeutendsten historischen Flugschauen überhaupt dargestellt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "früher",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0c77bbd5-8486-3fb3-8f15-66d87728d2e8",
                                        "entry_id": "77c8825d-5570-3dea-9e87-58abd10cdf5b",
                                        "glosses": [
                                            "eher"
                                        ],
                                        "tags": [
                                            "Komparativ von früh"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9ca53a25-f2b6-45ee-97b4-db69f64ef036",
                                                "sense_id": "0c77bbd5-8486-3fb3-8f15-66d87728d2e8",
                                                "text": "Ich habe heute früher Feierabend."
                                            },
                                            {
                                                "example_id": "afcc1df0-fa8c-43ba-90e7-743d1ac5a893",
                                                "sense_id": "0c77bbd5-8486-3fb3-8f15-66d87728d2e8",
                                                "text": "Peter kam um 12 Uhr. Maria kam früher und war schon um 10 Uhr da."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c70f15ba-98b2-3fbc-bfa5-dea9b44f35d5",
                                        "entry_id": "77c8825d-5570-3dea-9e87-58abd10cdf5b",
                                        "glosses": [
                                            "in der Vergangenheit liegend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55c37393-eb14-403e-8472-b642d19369a4",
                                                "sense_id": "c70f15ba-98b2-3fbc-bfa5-dea9b44f35d5",
                                                "text": "Früher war alles besser."
                                            },
                                            {
                                                "example_id": "50d22c92-23e3-4de4-bc4c-1ae30e39462b",
                                                "sense_id": "c70f15ba-98b2-3fbc-bfa5-dea9b44f35d5",
                                                "text": "„[…] dass mehr Menschen als früher über grundlegende naturwissenschaftliche Fakten unterrichtet sind, ist ein Segen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
