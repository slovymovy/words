                                                "sense_id": "5f51bf3f-7e63-36df-ba82-6d035d29b4c7",
                                                "text": "Lissabon ist die Hauptstadt von Portugal."
                                            },
                                            {
                                                "example_id": "8e1d6fe4-64e4-4d4b-b238-eefd061b4046",
                                                "sense_id": "5f51bf3f-7e63-36df-ba82-6d035d29b4c7",
                                                "text": "„Portugal ist Mitglied der Europäischen Union und hatte im zweiten Halbjahr 2007 den Ratsvorsitz inne.“"
                                            }
