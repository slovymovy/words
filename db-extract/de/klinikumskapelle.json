                ],
                "senses": [
                    {
                        "sense_id": "798d91f7-c202-3301-b976-f1d658fe8e0c",
                        "entry_id": "5bb0545d-d728-3d8b-9cd5-8a4fe0144a20",
                        "glosses": [
                            "einfach gestalteter Kapellenbau oder abgeteilter Bereich in einem Klinikum, der für persönliche Andachten oder auch Gottesdienste genutzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2582f330-8abc-43be-86e6-56d544a1775e",
                                "sense_id": "798d91f7-c202-3301-b976-f1d658fe8e0c",
                                "text": "„Gottesdienste finden regelmäßig in der Klinikumskapelle sowie in der benachbarten St.-Anna-Kirche statt.“"
                            },
                            {
                                "example_id": "281b0e07-aff0-4f0a-8f97-e7ef1384fd4b",
                                "sense_id": "798d91f7-c202-3301-b976-f1d658fe8e0c",
                                "text": "„Der Reliquienschrein war bis zum nächsten Morgen in der Klinikumskapelle aufgestellt.“"
                            },
                            {
                                "example_id": "aae509de-a15e-4048-a15c-d2a31fd545b5",
                                "sense_id": "798d91f7-c202-3301-b976-f1d658fe8e0c",
                                "text": "„Aber auch die kleinen Dinge lagen ihr am Herzen: Immer wieder mussten Gottesdienstbesucher feststellen, dass sich die Atmosphäre in der Klinikumskapelle verändert hat: Mit Blumen und Kerzen erzeugte sie eine meditative Stimmung.“"
                            },
                            {
                                "example_id": "c4c610d5-60d9-449f-80cc-d9c820369726",
                                "sense_id": "798d91f7-c202-3301-b976-f1d658fe8e0c",
                                "text": "„Die feierliche Eröffnung der Ausstellung beginnt am Mittwoch, den 31. August, um 19 Uhr mit einer Heiligen Messe in der Klinikumskapelle mit Diakon Herbert Mitterlehner und Mag. Heinz Purrer, Diözesandirektor.“"
                            },
                            {
                                "example_id": "1ebaddb2-1e2e-4e22-8588-8de1e0404bd1",
                                "sense_id": "798d91f7-c202-3301-b976-f1d658fe8e0c",
                                "text": "„Wesentliche Bestandteile waren zuvor in anderen Kirchen; Altar, Ambo, Taufstein und Kanzel wurden aus der geschlossenen Jakobuskirche in die Klinikumskapelle gebracht, das bunte Glasfenster war in der alten Klinikums-Kapelle.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
