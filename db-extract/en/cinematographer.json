                                "target_senses": [
                                    {
                                        "sense_id": "f19eb6bc-4c6b-3075-9e96-f73fb61d3ab2",
                                        "entry_id": "08283b80-9ee3-3476-b663-9cb5c1a14e3b",
                                        "glosses": [
                                            "weibliche Person, die beruflich filmt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f63bc93-463f-4ac5-93b0-a954cf28676d",
                                                "sense_id": "f19eb6bc-4c6b-3075-9e96-f73fb61d3ab2",
                                                "text": "Die Kamerafrau hat immer den Moderator im Blickfeld."
                                            },
                                            {
                                                "example_id": "666b83e7-47ac-4494-81de-f6876bc8b327",
                                                "sense_id": "f19eb6bc-4c6b-3075-9e96-f73fb61d3ab2",
                                                "text": "„Und jetzt, da er entwischen will, bringt ihn eine ungarische Kamerafrau zu Fall.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
