                        "sense_id": "3b675c43-2694-30ba-917c-f4e2ac317205",
                        "entry_id": "bc3719a2-925f-321f-af56-742a16a82814",
                        "glosses": [
                            "naam van de maker zoals die in een boek of andere tekst wordt vermeld"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "acf92fb8-5e15-4d93-b3da-5eb52d2fbd33",
                                "sense_id": "3b675c43-2694-30ba-917c-f4e2ac317205",
                                "text": "Als kind groeide Wiesje van Santen op aan de Plantage Middenlaan. Een intens gelukkige jeugd.\nToen ik acht was\nbracht mijn moeder\nons soms naar Artis\nals een privé-tuin\ntegenover ons huis.\nZo begint een gedicht dat ze veel later publiceerde onder haar schrijversnaam Louise van Santen."
                            }
                        ]
                    },
                    {
                        "sense_id": "9e9cbb9c-78bb-3c5a-a437-4421c176ce8b",
                        "entry_id": "bc3719a2-925f-321f-af56-742a16a82814",
                        "glosses": [
                            "aangenomen naam die een auteur gebruikt om te verbergen wie hij is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2751eb17-6794-4b8e-bae4-3622aca02050",
                                "sense_id": "9e9cbb9c-78bb-3c5a-a437-4421c176ce8b",
                                "text": "Jan Hendrik Frederik Grönloh, beter bekend onder zijn schrijversnaam Nescio, ving het verlangen naar maatschappelijke onthechting in een mooi beeld."
                            },
                            {
                                "example_id": "a43e1c43-9fcf-4566-b867-f25473fed2a2",
                                "sense_id": "9e9cbb9c-78bb-3c5a-a437-4421c176ce8b",
                                "text": "Manson , de Schrijver van den Courier de l'Europe, is zeker, bij de Hollandsche Patriotten, een even zo gehaate Schrijvers-naam als Linguet bij de Fransche Parlementen, (…)"
                            }
                        ]
                    }
