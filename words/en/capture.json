                                "target_lang_word": "ele geçirmek",
                                "target_lang_sense_clarification": "şehir, bölge veya güç kullanarak"
                            },
                            {
                                "target_lang_word": "yakalamak",
                                "target_lang_sense_clarification": "suçlu veya kaçan birini"
                            },
                            {
                                "target_lang_word": "esir almak",
                                "target_lang_sense_clarification": "düşman veya askeri"
                            },
                            {
                                "target_lang_word": "zapt etmek",
                                "target_lang_sense_clarification": "zorla kontrol altına almak"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "占领",
                                "target_lang_sense_clarification": "用于城市、基地或领土"
                            },
                            {
                                "target_lang_word": "抓获",
                                "target_lang_sense_clarification": "用于罪犯或逃犯"
                            },
                            {
                                "target_lang_word": "俘虏",
                                "target_lang_sense_clarification": "用于敌军或士兵"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ce21c2b6-6f16-33a7-9b7e-1b379e52db1e",
                    "sense_definition": "To record sound, images, or data to keep them for later use.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The photographer used a special lens to <w>capture</w> the bird in flight.",
                            "target_lang_translations": {
                                "ru": "Фотограф использовал специальный объектив, чтобы <w>запечатлеть</w> птицу в полете.",
                                "tr": "Fotoğrafçı, kuşu uçarken <w>yakalamak</w> için özel bir mercek kullandı.",
                                "zh": "摄影师用特制镜头<w>捕捉</w>到了鸟儿飞翔的瞬间。"
                            }
                        },
                        {
                            "text": "This software can <w>capture</w> audio from the microphone very clearly.",
                            "target_lang_translations": {
                                "ru": "Это программное обеспечение может очень четко <w>записывать</w> звук с микрофона.",
                                "tr": "Bu yazılım mikrofondan sesi çok net bir şekilde <w>kaydedebilir</w>.",
                                "zh": "这款软件能非常清晰地<w>录制</w>麦克风的声音。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "capture an image",
                        "capture video",
                        "capture data"
                    ],
                    "target_lang_definitions": {
                        "ru": "Записывать звук, изображения или данные для последующего использования.",
                        "tr": "Ses, görüntü veya verileri daha sonra kullanmak üzere kaydetmek.",
                        "zh": "记录声音、图像或数据以备后用。"
