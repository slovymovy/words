                ],
                "senses": [
                    {
                        "sense_id": "bc4e7a7e-dcd9-37eb-a58d-2feb0cc89bbc",
                        "entry_id": "da242fab-1f49-3392-a323-46239d6324d9",
                        "glosses": [
                            "gelatinous (jelly-like)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "87c3f121-0ac9-47ac-82b6-f5a84571a4b7",
                                "sense_id": "bc4e7a7e-dcd9-37eb-a58d-2feb0cc89bbc",
                                "text": "lekko galaretowaty",
                                "translation": "slightly gelatinous",
                                "english": "slightly gelatinous"
                            },
                            {
                                "example_id": "2e3e68ab-1995-4216-afa0-0773edfb9c87",
                                "sense_id": "bc4e7a7e-dcd9-37eb-a58d-2feb0cc89bbc",
                                "text": "galaretowate ciało",
                                "translation": "gelatinous body",
                                "english": "gelatinous body"
                            },
                            {
                                "example_id": "e709606c-4f1f-4792-b902-315dd265caf4",
                                "sense_id": "bc4e7a7e-dcd9-37eb-a58d-2feb0cc89bbc",
                                "text": "galaretowato-śluzowy",
                                "translation": "gelatinous-mucous",
                                "english": "gelatinous-mucous"
                            },
                            {
                                "example_id": "ea7b2e7e-4b3e-48fe-a5da-3158354e0ac6",
                                "sense_id": "bc4e7a7e-dcd9-37eb-a58d-2feb0cc89bbc",
                                "text": "[…]pleszki te są umieszczone na podporze ogólnéy, mieysce łodygi i liści zastępuiącey, substancyi liszaiowatéy, skorupiastéy, włóknistéy, lub galaretowatéy, nigdy zielonéy, a która plechy (thallus) nosi nazwisko.",
                                "translation": "[…] these little thalluses are placed on a géneral support, in place of the stem and leaves replacing it, a líchen-lìke, crústy, fíbrous, or gelátinous substance, never gréen, and which bears the name of the thallus (from Latin thallus).",
                                "english": "[…] these little thalluses are placed on a géneral support, in place of the stem and leaves replacing it, a líchen-lìke, crústy, fíbrous, or gelátinous substance, never gréen, and which bears the name of the thallus (from Latin thallus)."
                            },
                            {
                                "example_id": "8ae4f5cc-c475-4090-81d7-354454efc270",
                                "sense_id": "bc4e7a7e-dcd9-37eb-a58d-2feb0cc89bbc",
                                "text": "Gdy wnętrzności wieloryba ulegną podrażnieniu wydzielają materię galaretowatą koloru szarawego.",
                                "translation": "When the whale's guts become irritated they secrete a gelatinous matter of a greyish colour.",
                                "english": "When the whale's guts become irritated they secrete a gelatinous matter of a greyish colour."
                            },
                            {
                                "example_id": "223cb0a7-e53f-444b-acfa-2f12de6bb8d3",
                                "sense_id": "bc4e7a7e-dcd9-37eb-a58d-2feb0cc89bbc",
                                "text": "Dawna jędrna tusza zamieniła się teraz w galaretowatą rozlazłość.",
                                "translation": "The former firm carcass has now turned into a gelatinous sprawl.",
                                "english": "The former firm carcass has now turned into a gelatinous sprawl."
                            },
                            {
                                "example_id": "1bd28eee-1151-4ec5-9224-a127f1721bf4",
                                "sense_id": "bc4e7a7e-dcd9-37eb-a58d-2feb0cc89bbc",
                                "text": "Dobrze sporządzony majonez odznacza się galaretowatą konsystencją.",
                                "translation": "A well-made mayonnaise is characterised by its gelatinous consistency.",
                                "english": "A well-made mayonnaise is characterised by its gelatinous consistency."
                            },
                            {
                                "example_id": "a8bd61ef-9e1b-4097-9cbe-ac9805e3216b",
                                "sense_id": "bc4e7a7e-dcd9-37eb-a58d-2feb0cc89bbc",
                                "text": "Scyzorykami wierciliśmy w skorupkach małe dziurki i z zapałem wciągaliśmy w usta galaretowatą zawartość.",
                                "translation": "With pocket knives, we drilled small holes in the shells and eagerly sucked the gelatinous contents into our mouths.",
                                "english": "With pocket knives, we drilled small holes in the shells and eagerly sucked the gelatinous contents into our mouths."
                            }
                        ]
                    }
