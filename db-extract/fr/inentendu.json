                "senses": [
                    {
                        "sense_id": "24dff28b-d23d-33aa-a0de-2d54d2b0b0eb",
                        "entry_id": "9ec5ea96-03f5-3871-9270-594cc442b54f",
                        "glosses": [
                            "Qui n’a pas été entendu."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7e6ea55b-95a1-4d7c-9816-7a2d328a34f9",
                                "sense_id": "24dff28b-d23d-33aa-a0de-2d54d2b0b0eb",
                                "text": "Le jeune enfant [Hylas] de loin croit entendre la voix [d’Hercule], Et du fond des roseaux, pour adoucir sa peine, Lui répond d’une voix inentendue et vaine."
                            },
                            {
                                "example_id": "0f08b10d-6b02-4937-8a43-2454ba123ae9",
                                "sense_id": "24dff28b-d23d-33aa-a0de-2d54d2b0b0eb",
                                "text": "Je considérais ces lettres abandonnées : des cris de douleur inentendus s’élevaient de leurs plis profanés."
                            },
                            {
                                "example_id": "0fb73cc1-38f4-45e6-bdf8-54be9e367516",
                                "sense_id": "24dff28b-d23d-33aa-a0de-2d54d2b0b0eb",
                                "text": "Les cris s’étranglèrent, inentendus, perdus, envolés."
                            },
                            {
                                "example_id": "308e68df-ba13-4268-875a-01154e0e3375",
                                "sense_id": "24dff28b-d23d-33aa-a0de-2d54d2b0b0eb",
                                "text": "Tout à coup un gémissement sortit du flanc de l’épave.\nCela montait, s’arrêtait, repartait, monotone et déchirant, et rien n’était triste comme cette plainte qui passait, inentendue, sur les eaux désolées."
                            },
                            {
                                "example_id": "c66a2516-d035-4151-9b66-a4a0273a186a",
                                "sense_id": "24dff28b-d23d-33aa-a0de-2d54d2b0b0eb",
                                "text": "Mrs. O’Relly, la nouvelle passagère, ne pourrait passer nulle part inaperçue ou inentendue, car elle est vêtue d’une toilette aux couleurs éclatantes, et sa voix a les sonorités d’une trompette."
                            },
                            {
                                "example_id": "74a98e29-adab-4271-95ad-0a8722d18fea",
                                "sense_id": "24dff28b-d23d-33aa-a0de-2d54d2b0b0eb",
                                "text": "Elle parle et il aime qu’elle parle, c’est la vraie solitude, la romance profonde, inentendue, la chanson de Bérénice…"
                            }
                        ]
                    }
