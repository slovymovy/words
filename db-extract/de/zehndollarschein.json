                        "glosses": [
                            "US-amerikanische Banknote im Nennwert von zehn Dollar"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b9928ab1-41dc-40d5-9216-5f4cfe173842",
                                "sense_id": "78a58a82-3f6d-35e3-a730-9794d050a1be",
                                "text": "Er bezahlte mit einem Zehndollarschein."
                            },
                            {
                                "example_id": "911ff4ab-5686-4813-b8d5-e71961ecf09e",
                                "sense_id": "78a58a82-3f6d-35e3-a730-9794d050a1be",
                                "text": "„Silver griff in die Tasche, zog einen Zehndollarschein heraus, küßte ihn und steckte ihn in die andere Seite seines Jacketts.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "aed14f66-0fd8-43b5-92bc-03803b6cc62c",
                        "source_entry_id": "80dbcc39-36db-35ba-abcd-86efc47732c6",
                        "source_sense_id": "78a58a82-3f6d-35e3-a730-9794d050a1be",
                        "source_sense_description": "US-amerikanische Banknote im Nennwert von zehn Dollar",
                        "target_lang_word": "tenner",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tenner",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5c905728-4c9f-38ca-807c-4be8c9bfdd1c",
                                        "entry_id": "877b69f5-0843-38ac-920c-bfa0a9a8584d",
                                        "glosses": [
                                            "A monetary note (bill) whose face value is ten basic units of currency. Originally, a ten-shilling (half pound) note."
                                        ],
                                        "tags": [
                                            "Ireland",
                                            "UK",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bdeea9f7-3235-493c-94b4-fde15908b8c3",
                                                "sense_id": "5c905728-4c9f-38ca-807c-4be8c9bfdd1c",
                                                "text": "[...] or, if you're feeling brave, a tenner. Tell your child they have a chance to win the fiver if they can [...]"
                                            },
                                            {
                                                "example_id": "db291058-e7a6-473b-b19b-135cb0161d42",
                                                "sense_id": "5c905728-4c9f-38ca-807c-4be8c9bfdd1c",
                                                "text": "The more a shop looks as though it trades in farthings and ha’pennies, the more tenners and twenties you can expect to hand over at the till."
                                            },
                                            {
                                                "example_id": "82806398-7b46-4322-9fad-9d863bffc29b",
                                                "sense_id": "5c905728-4c9f-38ca-807c-4be8c9bfdd1c",
                                                "text": "I’ve visited Eton, there’s loads of places like it, and if that’s all you know, then you’ve definitely not had to worry about pulling a tenner out of the bank…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e00d5d40-0afd-360b-a836-e801d2d208bd",
                                        "entry_id": "877b69f5-0843-38ac-920c-bfa0a9a8584d",
                                        "glosses": [
                                            "A kind of 10-kilowatt lamp."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7e7a23c8-c851-49ea-93cc-7d7cf7f6d464",
                                                "sense_id": "e00d5d40-0afd-360b-a836-e801d2d208bd",
                                                "text": "The basic 10K, known as a tenner or studio 10K, has a 20-inch fresnel. The big daddy of the group is the Big Eye tenner, which has a 24-inch lens."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "21dcd1cd-b9e2-3f15-9e28-82a405c207d0",
