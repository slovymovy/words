                        "source_sense_id": "1ed5a8f1-aaea-3523-9369-f5febe0e04a0",
                        "source_sense_description": "Botanik: Pflanze, die an Trockenheit angepasst ist",
                        "target_lang_word": "xerophyte",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "xerophyte",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fb2552b1-768d-32a2-906e-04b28ca33083",
                                        "entry_id": "66c82c12-c9dc-3ab6-9252-168b4d17ad89",
                                        "glosses": [
                                            "Any plant suited for life in a habitat where water is scarce, such as in a desert or chaparral. Such plants may be succulent, have small or reduced leaves, or spines."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
