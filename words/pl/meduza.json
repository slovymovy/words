{
    "word_family": [
        "meduzowaty"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1a673c40-025f-31a2-b10b-279484acb789",
                    "sense_definition": "galaretowate zwierzę wodne o ciele w kształcie dzwonu lub parasola, unoszące się w toni morskiej",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "zwierzęta",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Podczas kąpieli w ciepłym morzu turystę nieprzyjemnie oparzyła mała <w>meduza</w>.",
                            "target_lang_translations": {
                                "ru": "Во время купания в тёплом море туриста неприятно обожгла маленькая <w>медуза</w>."
                            }
                        },
                        {
                            "text": "W płytkiej wodzie przy samej plaży unosiły się przezroczyste <w>meduzy</w>.",
                            "target_lang_translations": {
                                "ru": "На мелководье у самого пляжа плавали прозрачные <w>медузы</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "poparzenie przez meduzę",
                        "przezroczysta meduza"
                    ],
                    "target_lang_definitions": {
                        "ru": "студенистое морское животное в форме колокола или зонтика, плавающее в толще воды"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "медуза",
                                "target_lang_sense_clarification": "морское беспозвоночное животное"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fff75b1e-8ee7-3177-8475-3cd65b149d73",
                    "sense_definition": "danie z mięsa w galarecie, często podawane jako tradycyjna przekąska do wódki",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "kulinaria",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Gość zamówił w barze tradycyjną lornietę z <w>meduzą</w> i usiadł w rogu sali.",
                            "target_lang_translations": {
                                "ru": "Посетитель заказал в баре традиционную «лорнету» с <w>холодцом</w> и сел в углу зала."
                            }
                        },
                        {
                            "text": "W czasach PRL-u popularną zakąską była zimna <w>meduza</w> z octem.",
                            "target_lang_translations": {
                                "ru": "Во времена ПНР популярной закуской был холодный <w>студень</w> с уксусом."
                            }
                        }
                    ],
                    "synonyms": [
                        "galareta",
                        "tymbalik"
                    ],
                    "common_phrases": [
                        "lorneta z meduzą"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "potoczne określenie nóżek w galarecie"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "мясное блюдо в желе, часто подаваемое как традиционная закуска к водке (студень, холодец)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "холодец",
                                "target_lang_sense_clarification": "мясное заливное блюдо"
                            },
                            {
                                "target_lang_word": "студень",
                                "target_lang_sense_clarification": "мясо в желе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "858dcf83-4095-3e6f-9bfc-3ff5d6218c70",
                    "sense_definition": "gatunek motyla dziennego z rodziny rusałkowatych",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "owady",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na leśnej polanie udało nam się zaobserwować rzadki okaz motyla o nazwie <w>meduza</w>.",
                            "target_lang_translations": {
                                "ru": "На лесной поляне нам удалось наблюдать редкий экземпляр бабочки под названием <w>чернушка медуза</w>."
                            }
                        },
                        {
                            "text": "Samice <w>meduz</w> wyróżniają się charakterystycznymi plamkami ocznymi na skrzydłach.",
                            "target_lang_translations": {
                                "ru": "Самки <w>чернушек медуз</w> выделяются характерными глазчатыми пятнами на крыльях."
                            }
                        }
                    ],
                    "synonyms": [
                        "górówka meduza",
                        "górówka"
                    ],
                    "target_lang_definitions": {
                        "ru": "вид дневной бабочки из семейства нимфалид (чернушка медуза)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чернушка медуза",
                                "target_lang_sense_clarification": "вид бабочки"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "cadf5a5a-aa02-363f-9abd-3effdc4b3893",
                    "sense_definition": "w mitologii greckiej jedna z trzech gorgon o wężowych włosach, której spojrzenie zamieniało w kamień",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mitologia",
                    "name_type": "mythological_or_astrological_entity",
                    "examples": [
                        {
                            "text": "Mitologiczny Perseusz pokonał groźną <w>Meduzę</w>, używając lśniącej tarczy jako lustra.",
                            "target_lang_translations": {
                                "ru": "Мифологический Персей победил грозную <w>Медузу</w>, используя сияющий щит как зеркало."
                            }
                        },
                        {
                            "text": "Każdy człowiek, który spojrzał prosto w oczy <w>Meduzy</w>, natychmiast zamieniał się w kamień.",
                            "target_lang_translations": {
                                "ru": "Каждый человек, взглянувший прямо в глаза <w>Медузе</w>, тут же превращался в камень."
                            }
                        }
                    ],
                    "common_phrases": [
                        "spojrzenie Meduzy",
                        "głowa Meduzy"
                    ],
                    "target_lang_definitions": {
                        "ru": "в древнегреческой мифологии одна из трех горгон со змеями вместо волос, взгляд которой обращал в камень"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Медуза",
                                "target_lang_sense_clarification": "мифологическое существо, Медуза Горгона"
                            },
                            {
                                "target_lang_word": "Медуза Горгона",
                                "target_lang_sense_clarification": "чудовище с волосами-змеями"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}