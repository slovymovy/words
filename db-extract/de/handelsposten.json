                "senses": [
                    {
                        "sense_id": "34d3487e-d813-34e9-aa29-566a2b7d9242",
                        "entry_id": "decdf590-3a19-3c64-9215-2ec2eb762a3a",
                        "glosses": [
                            "Niederlassung von Händlern, vor allem im Ausland oder in Übersee"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "985891c8-ded6-491d-8970-0c120aeebc96",
                                "sense_id": "34d3487e-d813-34e9-aa29-566a2b7d9242",
                                "text": "Für viele Siedler waren die Handelsposten wichtige Stützpunkte."
                            },
                            {
                                "example_id": "a22498af-0bda-4f87-aa3e-8ffcb654c2c1",
                                "sense_id": "34d3487e-d813-34e9-aa29-566a2b7d9242",
                                "text": "„Ende 1571 erreicht die Expedition den portugiesischen Handelsposten Sena, ein Dorf aus Strohhütten in einem Dickicht am Fluss, und richtet sich ein.“"
                            },
                            {
                                "example_id": "e1a7c8f9-c961-4576-ba16-0984cd046a9e",
                                "sense_id": "34d3487e-d813-34e9-aa29-566a2b7d9242",
                                "text": "„Daraufhin lässt Hussein zwei ihrer Handelsposten an der Küste verwüsten.“"
                            },
                            {
                                "example_id": "64abe89a-a304-4b2b-aee4-b7e1314e6042",
                                "sense_id": "34d3487e-d813-34e9-aa29-566a2b7d9242",
                                "text": "„Deutsch-Südwestafrika begann, wie viele afrikanische Kolonien, als kleiner privater Handelsposten.“"
                            },
                            {
                                "example_id": "f32104fd-8174-4bb9-9417-a643c3aa19f9",
                                "sense_id": "34d3487e-d813-34e9-aa29-566a2b7d9242",
                                "text": "„Die Niederländer errichteten aber auch Handelsposten an der indischen Südostküste, wo sie indische Textilien erwarben, die sie mit großem Gewinn in anderen Teilen Asiens absetzten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
