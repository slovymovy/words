                        "glosses": [
                            "der oberste Teil des Säulenschaftes unmittelbar unterhalb des Kapitells, wo der Durchmesser der Säule am geringsten ist"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
