                ],
                "senses": [
                    {
                        "sense_id": "c0230842-2f89-3e1f-8703-39c7b9217699",
                        "entry_id": "84b3aaf9-206a-30e9-ab1d-2db1180a6c33",
                        "glosses": [
                            "Kraft, die die Masse der Erdatmosphäre auf eine Einheitsfläche ausübt"
                        ],
                        "tags": [
                            "physics"
                        ],
                        "examples": [
                            {
                                "example_id": "78518491-3050-465d-8633-41374578a1e7",
                                "sense_id": "c0230842-2f89-3e1f-8703-39c7b9217699",
                                "text": "Der Luftdruck beträgt auf Meereshöhe im Mittel 1013,25 hPa."
                            },
                            {
                                "example_id": "9147800d-2e09-4a45-b861-02119d457584",
                                "sense_id": "c0230842-2f89-3e1f-8703-39c7b9217699",
                                "text": "„Ein naher Einschlag preßt seinen Luftdruck bis tief in den Kellerhals und wirft das Eisengitter um.“"
                            },
                            {
                                "example_id": "7f4831a2-d5e9-4912-b1a9-950d4e75938b",
                                "sense_id": "c0230842-2f89-3e1f-8703-39c7b9217699",
                                "text": "„In der ersten Aprilwoche stieg der Luftdruck im Zuge eines kräftigen Westwindes an, am 16. April schifften sich die Siedler mit einigen Vorräten für eine längere Seefahrt ein.“"
                            },
                            {
                                "example_id": "329538fd-f97d-467a-87f6-85cea4464f0b",
                                "sense_id": "c0230842-2f89-3e1f-8703-39c7b9217699",
                                "text": "„Aber der Luftdruck widersprach dem Verhalten des Blutegels fast stets.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c833baa7-6861-3198-bbc5-daff4974e7ed",
                        "entry_id": "84b3aaf9-206a-30e9-ab1d-2db1180a6c33",
                        "glosses": [
                            "Unterschied zwischen Reifeninnendruck und Druck der Erdatmosphäre"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b7777668-58b2-4763-9b43-8c607f0cddeb",
                                "sense_id": "c833baa7-6861-3198-bbc5-daff4974e7ed",
                                "text": "Ich muss noch den Luftdruck beim Anhänger überprüfen und die Rückscheibe sauber machen. Dann können wir los."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "a598589a-e239-3d92-bdd0-a8b337dc71ab",
                        "entry_id": "84b3aaf9-206a-30e9-ab1d-2db1180a6c33",
                        "glosses": [
                            "durch ein explosives Ereignis entstandene Druckwelle"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6e6ce8fe-4bcb-4fc1-bcf6-cd9367198c7b",
                                "sense_id": "a598589a-e239-3d92-bdd0-a8b337dc71ab",
                                "text": "Durch den Bombenabwurf entstand ein hoher Luftdruck."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
