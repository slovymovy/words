                    },
                    {
                        "translation_id": "045a14fc-a863-4470-8d64-dfe73a3e0896",
                        "source_entry_id": "f9c97218-1643-329f-9059-525d2bcfb4a7",
                        "source_sense_id": "ec390c86-dce1-3364-97c3-0dc93a43b617",
                        "target_lang_word": "mansuetude",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mansuetude",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9a6c57ad-7cf8-3f71-979c-dbda6a92cc56",
                                        "entry_id": "71ced16d-9f5d-3fcd-b77c-4280837624b1",
                                        "glosses": [
                                            "Gentleness, tameness."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "00d7eac8-8e08-490f-8a18-b06e462c8e10",
                                                "sense_id": "9a6c57ad-7cf8-3f71-979c-dbda6a92cc56",
                                                "text": "That I use all mildness or mansuetude in admonishing; the angry passionate correption being rather apt to provoke, than to amend."
                                            },
                                            {
                                                "example_id": "b5e66879-2627-4cd5-a655-f3903d32f462",
                                                "sense_id": "9a6c57ad-7cf8-3f71-979c-dbda6a92cc56",
                                                "text": "Quo me rapis? Quo indeed. My whole conduct, meekness, mansuetude, voluntary abasement, astonishes me."
                                            },
                                            {
                                                "example_id": "893b6c23-a34b-4e51-b7e8-f9c32c25e4b5",
                                                "sense_id": "9a6c57ad-7cf8-3f71-979c-dbda6a92cc56",
                                                "text": "With mansuetude (compossible with my muliebrity), I condemn those niddering, olid morons who, in caliginosity of understanding, vilipend our English by attempting to exuviate words for which they cannot see any present custom."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
