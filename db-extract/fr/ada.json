                            {
                                "target_word": "Ada",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e49793ad-80ba-3bc7-8298-2d231389c9c6",
                                        "entry_id": "45908fa1-4aba-30d1-80a9-00ff62172b56",
                                        "glosses": [
                                            "weiblicher Vorname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63f6024b-3de1-4bb8-94dd-b4426dd137b2",
                                                "sense_id": "e49793ad-80ba-3bc7-8298-2d231389c9c6",
                                                "text": "Ich sehe Ada täglich im Bus."
                                            },
                                            {
                                                "example_id": "c6a8f330-d7ce-4c8f-8876-e38eced3401f",
                                                "sense_id": "e49793ad-80ba-3bc7-8298-2d231389c9c6",
                                                "text": "Ada singt im Chor."
                                            },
                                            {
                                                "example_id": "3efa5880-0bb3-4f5c-8bbd-089cf232eccb",
                                                "sense_id": "e49793ad-80ba-3bc7-8298-2d231389c9c6",
                                                "text": "Ada und Otto haben sieben Kinder."
                                            },
                                            {
                                                "example_id": "4098fde6-eb79-4f64-bd5f-f75364e3867b",
                                                "sense_id": "e49793ad-80ba-3bc7-8298-2d231389c9c6",
                                                "text": "Ada spielt gern."
                                            },
                                            {
                                                "example_id": "33e23deb-2d76-4c03-92c9-83f8a76d4ac0",
                                                "sense_id": "e49793ad-80ba-3bc7-8298-2d231389c9c6",
                                                "text": "Ada Müller wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "1b1704be-cdd7-4a07-9c1f-b1584cb1aaeb",
                                                "sense_id": "e49793ad-80ba-3bc7-8298-2d231389c9c6",
                                                "text": "Kennen sie den Vornamen Ada?"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Ada",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0c090193-feba-36ff-ae40-b20efd69043b",
                                        "entry_id": "cc8a3a38-ec18-393c-ba4c-1e3e2eab80ec",
                                        "glosses": [
                                            "Familienname, Nachname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "153b6480-7e43-4d24-8986-09bfe624cd4f",
                                                "sense_id": "0c090193-feba-36ff-ae40-b20efd69043b",
                                                "text": "Adas kamen, sahen und siegten."
                                            },
                                            {
                                                "example_id": "327e336f-11dd-4543-80f9-29750ddc565b",
                                                "sense_id": "0c090193-feba-36ff-ae40-b20efd69043b",
                                                "text": "Frau Ada ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "af1bb457-6553-4906-b5b5-78c1cfb4aeff",
                                                "sense_id": "0c090193-feba-36ff-ae40-b20efd69043b",
                                                "text": "Herr Ada wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "55783f77-c49e-4063-ae7f-ab9190e70fa8",
                                                "sense_id": "0c090193-feba-36ff-ae40-b20efd69043b",
                                                "text": "Die Adas kommen heute aus Neuwied."
                                            },
                                            {
                                                "example_id": "6c19f635-b0b7-431e-bed6-45b69d1104ef",
                                                "sense_id": "0c090193-feba-36ff-ae40-b20efd69043b",
                                                "text": "Der Ada trägt nie die Schals, die die Ada ihm strickt."
                                            },
                                            {
                                                "example_id": "50763557-36ca-4072-9a3a-bf0ebd806d98",
                                                "sense_id": "0c090193-feba-36ff-ae40-b20efd69043b",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Ada kommt, geht der Herr Ada.“"
                                            },
                                            {
                                                "example_id": "2d61a117-a81d-4045-9a9a-e7a0857fc31b",
                                                "sense_id": "0c090193-feba-36ff-ae40-b20efd69043b",
                                                "text": "Ada kommt und geht."
                                            },
                                            {
                                                "example_id": "60d3bf5a-aa07-4757-b1d1-a4a4f999a132",
                                                "sense_id": "0c090193-feba-36ff-ae40-b20efd69043b",
                                                "text": "An verregneten Herbsttagen ist Familie Adas liebste Beschäftigung das Bemalen von Hühnereiern."
                                            },
                                            {
                                                "example_id": "fff83c7c-b9cc-4201-b592-e115e4a23357",
                                                "sense_id": "0c090193-feba-36ff-ae40-b20efd69043b",
                                                "text": "An verschneiten Wintertagen ist die liebste Beschäftigung von Familie Ada das Schmücken von Weihnachtsbäumen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
