                "senses": [
                    {
                        "sense_id": "169d2c9a-cac8-3a6d-a36e-ad972a9c9e18",
                        "entry_id": "60a46b4b-3775-3376-973b-0d3f1694cfbe",
                        "glosses": [
                            "Qui est de la nature du schiste."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9112f7dd-d9c9-4384-8f0b-77e130ba03ba",
                                "sense_id": "169d2c9a-cac8-3a6d-a36e-ad972a9c9e18",
                                "text": "Nulle part on ne trouve la moindre trace ni des poudingues ou du granit rose de Jersey, ni de ces roches schisteuses, trappéennes ou quarzeuses, si communes à Saint-Malo."
                            },
                            {
                                "example_id": "85a66471-b04c-420f-af77-ef1eee8f8e49",
                                "sense_id": "169d2c9a-cac8-3a6d-a36e-ad972a9c9e18",
                                "text": "Le sol schisteux et argileux de la partie septentrionale des Ardennes au-delà de Charleville est entièrement privé de calcaire."
                            },
                            {
                                "example_id": "25102cb5-d53c-4c5f-8d80-670e0df0b0c5",
                                "sense_id": "169d2c9a-cac8-3a6d-a36e-ad972a9c9e18",
                                "text": "Cependant il s’agit d’une région schisteuse dont les sols, plus vite secs, peuvent être moins favorables à la détection aérienne."
                            }
                        ]
                    }
                ],
