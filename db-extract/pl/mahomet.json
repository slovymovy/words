                                                "example_id": "812aabc3-b053-49e2-a712-8412710bfe35",
                                                "sense_id": "d35441ba-b432-3433-b58c-8c5f950408b8",
                                                "text": "Shias believe that Ali succeeded the prophet Muhammad as leader of the Ummah."
                                            }
