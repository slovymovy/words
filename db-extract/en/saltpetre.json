                "senses": [
                    {
                        "sense_id": "c9bf2991-0d96-3e42-a3c0-1ab1b264c8b1",
                        "entry_id": "687d188e-a91c-3ce8-bc09-77f651b29147",
                        "glosses": [
                            "Salpeter"
                        ],
                        "tags": [],
