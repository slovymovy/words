                        "entry_id": "73289dcb-9e9b-3afa-b9d6-fe9cab20441f",
                        "glosses": [
                            "Qui déshonore ; qui tend à déshonorer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a7b15a9-66ac-4135-aee9-33c24b67d02d",
                                "sense_id": "ceeb392b-9e57-31f0-ae20-67d7bd44e9f1",
                                "text": "Plutôt la tombe de ses pères que la couche déshonorante du libertin et féroce templier !"
                            },
                            {
                                "example_id": "3edc7295-19ee-4959-bc3d-7fed06cced83",
                                "sense_id": "ceeb392b-9e57-31f0-ae20-67d7bd44e9f1",
                                "text": "Elles n’étaient pas de ces désœuvrées qui proscrivent, comme déshonorant, le saint calus du travail, et n’en rougissaient point."
                            }
                        ]
                    }
