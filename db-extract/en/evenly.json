                        "examples": [
                            {
                                "example_id": "2228be8c-35a0-40b9-afaa-c6e0e02a2835",
                                "sense_id": "6232e09c-920d-3492-ad58-18ec88fe8925",
                                "text": "To avoid arguments, he made sure that the sweets were evenly divided between his two children."
