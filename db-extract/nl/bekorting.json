                            {
                                "example_id": "3732b9b5-7c8f-4ef7-8846-0f40b6d9d8f6",
                                "sense_id": "94680797-8ebb-3516-a37c-3da547f59973",
                                "text": "Dat zou vervolgens weer tot een bekorting van de wachtlijst moeten leiden."
                            },
                            {
                                "example_id": "7e74d14d-f8c7-4806-b1e5-5c11b6d5308f",
                                "sense_id": "94680797-8ebb-3516-a37c-3da547f59973",
                                "text": "Wel wordt de invoering van al die plannen in veel gevallen op de lange baan geschoven; zo gaan de vereenvoudiging van het ontslagrecht en de bekorting van de WW-duur pas vanaf 2016, stapsgewijs, in."
                            }
                        ]
                    }
