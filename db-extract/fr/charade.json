        "fr-extract.jsonl": [
            {
                "entry_id": "095cb261-24d9-39ae-89c4-9924beeffde5",
                "word": "charade",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "a0f55e4c-be56-4045-996f-28444262b17d",
                        "entry_id": "095cb261-24d9-39ae-89c4-9924beeffde5",
                        "tags": [
                            "plural"
                        ],
                        "form": "charades"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fd9d92e3-9595-3c89-9c18-773f2cbd5b2a",
                        "entry_id": "095cb261-24d9-39ae-89c4-9924beeffde5",
                        "glosses": [
                            "Sorte d’énigme qui donne à deviner un mot de plusieurs syllabes décomposé en parties dont chacune fait un mot."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "86854031-8df3-4dd1-84cb-0c4ffd8c16a3",
                                "sense_id": "fd9d92e3-9595-3c89-9c18-773f2cbd5b2a",
                                "text": "Jouer des charades, jouer aux charades."
                            },
                            {
                                "example_id": "7262f65a-9fcb-4db4-9d94-4fb45137a571",
                                "sense_id": "fd9d92e3-9595-3c89-9c18-773f2cbd5b2a",
                                "text": "Le reste du temps, on se contentait de jouer des charades, de souper en costumes, mais entre soi, en ne mêlant aucun étranger au petit « noyau »."
                            },
                            {
                                "example_id": "5f4df0c5-f828-4036-87b0-0c270295bacf",
                                "sense_id": "fd9d92e3-9595-3c89-9c18-773f2cbd5b2a",
                                "text": "L’hypothèse la plus vraisemblable avait été qu’il s’agissait d’une série de décors pour une de ces longues « charades animées » qui faisaient fureur dans les salons parisiens aux alentours des années 1880."
                            },
                            {
                                "example_id": "17c89a1d-7b44-4eec-90ed-63361a300307",
                                "sense_id": "fd9d92e3-9595-3c89-9c18-773f2cbd5b2a",
                                "text": "Dans la villa des dunes, il accepte d’assister aux charades pour lesquelles la joyeuse baronne Folgers attife ses invités de châles et de portières de velours ; il consent même à y prendre part, ce qui leur donne un brio de plus."
                            }
                        ]
                    },
                    {
                        "sense_id": "7ab66a31-96b0-375b-9efb-b344faa19e25",
                        "entry_id": "095cb261-24d9-39ae-89c4-9924beeffde5",
                        "glosses": [
                            "Énigme."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "9f3240bd-be35-412d-af14-9f0d55ad3354",
                                "sense_id": "7ab66a31-96b0-375b-9efb-b344faa19e25",
                                "text": "Cet ouvrage est une vraie charade."
                            },
                            {
                                "example_id": "30a5fa8b-978d-436d-b4bf-a60494ea8d3b",
                                "sense_id": "7ab66a31-96b0-375b-9efb-b344faa19e25",
                                "text": "Il veut avoir trop d’esprit, il ne parle que par charades."
                            },
                            {
                                "example_id": "920292f8-e08a-4c0a-b3e9-1cc1b3a21f60",
                                "sense_id": "7ab66a31-96b0-375b-9efb-b344faa19e25",
                                "text": "Ça sent le rance, ce galimatias, il serait peut-être raisonnable de transmettre cette charade à l’inspecteur Lecacheur, je n’ai aucune envie d’avoir un fils orphelin."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5643d39d-d944-4568-afab-e27ae3d6e7f5",
                        "source_entry_id": "095cb261-24d9-39ae-89c4-9924beeffde5",
                        "source_sense_description": "Sorte d’énigme",
                        "target_lang_word": "charade",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "charade",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "345513fc-569d-3e14-a1d3-31d5ee79bd6f",
                                        "entry_id": "f9cc434b-ff20-34fd-984c-13133adb569f",
                                        "glosses": [
                                            "A genre of riddles where the clues to the answer are descriptions or puns on its syllables, with a final clue to the whole."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4600d201-2d49-4d00-b76a-a8bf6c10f134",
                                                "sense_id": "345513fc-569d-3e14-a1d3-31d5ee79bd6f",
                                                "text": "CHARADE, a trifling species of composition, or quasi-literary form of amusement, which may perhaps be best defined as a punning enigma propounded in a series of descriptions. A word is taken of two or more syllables, each forming a distinct word; each of these is described in verse or prose, as aptly and enigmatically as possible; and the same process is applied to the whole word. The neater and briefer the descriptive parts of the problem, the better the charade will be. In selecting words for charades, special attention should be paid to the absolute quality of the syllables composing them, inaccuracy in trifles of this sort depriving them of what little claim to merit they may possess. The brilliant rhythmic trifles of W. Mackworth Praed are well known. Of representative prose charades, the following specimens are perhaps as good as could be selected:—“My first, with the most rooted antipathy to a Frenchman, prides himself, whenever they meet, upon sticking close to his jacket; my second has many virtues, nor is its least that it gives its name to my first; my whole may I never catch!” “My first is company; my second shuns company; my third collects company; and my whole amuses company.” The solutions are Tar-tar and Co-nun-drum."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "69508b52-2de1-3b10-9bff-c439e295b90c",
                                        "entry_id": "f9cc434b-ff20-34fd-984c-13133adb569f",
                                        "glosses": [
                                            "A single round of the game charades, an acted form of the earlier riddles."
                                        ],
                                        "tags": [
                                            "uncommon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "93a1c0bf-2d56-4496-9470-048bbedd89b7",
                                                "sense_id": "69508b52-2de1-3b10-9bff-c439e295b90c",
                                                "text": "...The most popular form of this amusement is the acted charade, in which the meaning of the different syllables is acted out on the stage, the audience being left to guess each syllable and thus, combining the meaning of all the syllables, the whole word. A brilliant example of the acted charade is described in Thackeray’s Vanity Fair."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dc172070-af13-36c1-a0dc-2afdd1c548f0",
                                        "entry_id": "f9cc434b-ff20-34fd-984c-13133adb569f",
                                        "glosses": [
                                            "A play resembling the game charades, particularly due to poor acting."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "51c9e6c1-c544-3ca6-aef0-ee46f1673913",
                                        "entry_id": "f9cc434b-ff20-34fd-984c-13133adb569f",
                                        "glosses": [
                                            "A deception or pretense, originally an absurdly obvious one but now in general use."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86b98d2e-d2dd-493f-a812-d92ee9f55c1a",
                                                "sense_id": "51c9e6c1-c544-3ca6-aef0-ee46f1673913",
                                                "text": "This whole charade is absurd."
                                            },
                                            {
                                                "example_id": "fa3009f9-04f2-4752-b140-34d3b7a4e39b",
                                                "sense_id": "51c9e6c1-c544-3ca6-aef0-ee46f1673913",
                                                "text": "The woman lying dead in the morgue was the woman at the party. Well, Victor, maybe I'm missing something here. You call it fake, a charade… Do you mind telling me what kind of fuckin' charade ends up with somebody turning up dead?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "236265b2-efd6-3b33-9e5d-06d1e8aa2799",
                                        "entry_id": "f9cc434b-ff20-34fd-984c-13133adb569f",
                                        "glosses": [
                                            "A form of wordplay where several words are placed together to form a new word or part thereof."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fdffa613-3d43-4b50-b8b2-9f68b6c10ecb",
                                                "sense_id": "236265b2-efd6-3b33-9e5d-06d1e8aa2799",
                                                "text": "Sometimes the tricks above may be used in combination: a homophone may come in two pieces like a charade (RAINBOW sounding like REIGN + BEAU) or a charade may be reversed (TACKLE having ELK + CAT backwards)."
                                            },
                                            {
                                                "example_id": "f2d0e968-56c3-434b-83ca-92e8b8edf6a3",
                                                "sense_id": "236265b2-efd6-3b33-9e5d-06d1e8aa2799",
                                                "text": "Takes is a bit of a charade indicator here, telling you that one word takes on or adds on to another."
                                            },
                                            {
                                                "example_id": "01da1f92-b476-4724-a476-59a822ca19e6",
                                                "sense_id": "236265b2-efd6-3b33-9e5d-06d1e8aa2799",
                                                "text": "Try solving the following clues. They are all charades, some of which use link words of the types described above."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "charade",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6e988dc8-d7f7-36c7-a3a2-e95af23c7a4c",
                                        "entry_id": "c6f8cca5-9e5c-347d-aa36-b507cca04795",
                                        "glosses": [
                                            "To act out a charade (of); to gesture; to pretend."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "012390de-f47a-4d06-a366-816e2472adbc",
                                                "sense_id": "6e988dc8-d7f7-36c7-a3a2-e95af23c7a4c",
                                                "text": "I'm not trying to say: let's try to get away from power rituals because power manifestation is a very important part of sex. It is when it takes the form of charading gay punishment, punishing one of our own in order to allow him a gay contact."
                                            },
                                            {
                                                "example_id": "f8657788-2cc8-4e93-aeb7-0c841d8da29e",
                                                "sense_id": "6e988dc8-d7f7-36c7-a3a2-e95af23c7a4c",
                                                "text": "She flaps her hands and arms, eyes glaring, head shaking – charading Non, non, NON!"
                                            },
                                            {
                                                "example_id": "8485bc10-8d87-476f-847f-40b4c2e85117",
                                                "sense_id": "6e988dc8-d7f7-36c7-a3a2-e95af23c7a4c",
                                                "text": "Private, wholesome family time could no longer charade as being either private or wholly wholesome."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "39bc80f5-2475-4bee-9230-8ea53cb86aa3",
