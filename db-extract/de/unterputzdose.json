                ],
                "senses": [
                    {
                        "sense_id": "3c32e309-3bc3-311d-b43a-bd9b18832484",
                        "entry_id": "f645f9b3-387f-3040-8440-6a51a93d46b5",
                        "glosses": [
                            "Bauelement zum sicheren Verbinden von Leitungen beziehungsweise Anbringen von Steckdosen in Wänden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c1d328f8-6269-457b-8ddd-e9445961c2f2",
                                "sense_id": "3c32e309-3bc3-311d-b43a-bd9b18832484",
                                "text": "„Weiters wird vorgegeben: das Verlegen der Elektroinstallation komplett Unterputz; […] die Anordnung der Unterputzdose je Container; Anzahl und Art von Schukosteckdosen, Brüstungskanälen, Lichtschalter und –balken etc sowohl pro Container als auch im Gang je Container (vgl. Leistungverzeichnis Pkt. 1.6.10).“"
                            },
                            {
                                "example_id": "35f4d850-40f1-4500-b51b-9146ab96e3ba",
                                "sense_id": "3c32e309-3bc3-311d-b43a-bd9b18832484",
                                "text": "„Bei der mechanischen Konstruktion muss ein besonderes Augenmerk auf die Baugröße gelegt werden, um die MuSK entweder in eine Unterputzdose oder, in einer zweiten Generation, auch direkt in die Elektrogeräte einbauen zu können.“"
                            },
                            {
                                "example_id": "41198cd6-ee7b-47d3-afbf-bf01d83f3c98",
                                "sense_id": "3c32e309-3bc3-311d-b43a-bd9b18832484",
                                "text": "„Bei angestrebten Materialkosten von 100 bis 200 Euro soll das Gerät gleichzeitig klein genug bleiben, um in einer Unterputzdose Platz zu finden.“"
                            },
                            {
                                "example_id": "920cbdfe-3c58-4222-801e-b752f9ce4360",
                                "sense_id": "3c32e309-3bc3-311d-b43a-bd9b18832484",
                                "text": "„Alle Komponenten finden leicht in einer herkömmlichen Unterputzdose Platz.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
