                "senses": [
                    {
                        "sense_id": "4be6f6f4-08b4-3782-8700-02a013e5b4ff",
                        "entry_id": "74ac9a2f-e94b-338f-9aa9-1eef02c621a8",
                        "glosses": [
                            "Membre du parti qui renversa Robespierre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe693804-4d75-4dad-b08b-0cabad99dc2e",
                                "sense_id": "4be6f6f4-08b4-3782-8700-02a013e5b4ff",
                                "text": "Le thermidorien n’est plus l’incarnation de la révolution trahie et la Convention thermidorienne."
                            }
                        ]
                    },
                    {
                        "sense_id": "58e8d7e9-de14-3bcd-bbf1-7f10ddc35030",
                        "entry_id": "74ac9a2f-e94b-338f-9aa9-1eef02c621a8",
                        "glosses": [
                            "Homme qui présente les caractéristiques qu'on prête aux thermidoriens, comme la modération."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a7933029-7f89-42b5-b136-4a30f19375ad",
                                "sense_id": "58e8d7e9-de14-3bcd-bbf1-7f10ddc35030",
                                "text": "Le jugement si prophétique de Brodsky sur Clarenne dans le fumoir de Columbia : « un raffiné, un thermidorien », me revint à l’esprit."
                            }
                        ]
                    }
