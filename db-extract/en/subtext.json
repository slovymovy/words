                "senses": [
                    {
                        "sense_id": "7b523361-87e4-3afe-9495-7f6f0532a360",
                        "entry_id": "aeae9ee1-0821-3e1a-9a9e-bddac53ad85f",
                        "glosses": [
                            "The implicit meaning of a text, often a literary one, or a speech or dialogue."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "13f14ccc-22a0-4e32-af91-7ab41506715e",
                                "sense_id": "7b523361-87e4-3afe-9495-7f6f0532a360",
                                "text": "Everyone heard the announcement, but not everyone agrees on what the subtext was."
                            },
                            {
                                "example_id": "725a2e07-340a-4d2a-9344-e84e8c267708",
                                "sense_id": "7b523361-87e4-3afe-9495-7f6f0532a360",
                                "text": "The word dick has meant penis since the 1890s, but Chester Gould’s private detective “Dick Tracy” has no puerile subtext related to this word."
                            },
                            {
                                "example_id": "9a4e7a42-a9f9-4335-ad82-6cf3034ee185",
                                "sense_id": "7b523361-87e4-3afe-9495-7f6f0532a360",
                                "text": "While his major plays appear on the surface to have little plot, their subtext is full of overheated romance and melodrama."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cadae03b-2f1a-4682-9f02-a8b0a2942fe4",
                        "source_entry_id": "aeae9ee1-0821-3e1a-9a9e-bddac53ad85f",
                        "source_sense_id": "7b523361-87e4-3afe-9495-7f6f0532a360",
