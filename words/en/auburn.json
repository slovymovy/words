                            }
                        },
                        {
                            "text": "The sunlight caught the <w>auburn</w> hair of the girl sitting by the window.",
                            "target_lang_translations": {
                                "ru": "Солнечный свет заиграл в <w>каштановых</w> волосах девушки, сидевшей у окна."
                            }
                        }
                    ],
                    "synonyms": [
                        "cupreous"
                    ],
                    "common_phrases": [
                        "auburn hair",
                        "deep auburn",
                        "auburn tresses"
                    ],
                    "target_lang_definitions": {
                        "ru": "Красновато-коричневый цвет, обычно используемый для описания волос."
                    },
                    "translations": {
                        "ru": [
                            {
