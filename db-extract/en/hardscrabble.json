                                                "sense_id": "65d08a61-a20f-3d8f-bad1-44ed34a2fd19",
                                                "text": "Ich habe gar keine Lust dazu, denn das ist eine wirklich mühselige Angelegenheit."
                                            },
                                            {
                                                "example_id": "ffeabbe0-6869-4c47-8e6c-368a99f374dc",
                                                "sense_id": "65d08a61-a20f-3d8f-bad1-44ed34a2fd19",
                                                "text": "Es war ein mühseliger Aufstieg zum Gipfelkreuz."
                                            },
                                            {
                                                "example_id": "a92ac530-bcc7-4614-a2d2-2c024890b589",
                                                "sense_id": "65d08a61-a20f-3d8f-bad1-44ed34a2fd19",
                                                "text": "„Die Identifikation der sterblichen Überreste der Anschlagsopfer ist mühselig, die Untersuchungen der Gerichtsmediziner stützen sich auf knapp 20.000 sterbliche Überreste.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
