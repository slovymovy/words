                "senses": [
                    {
                        "sense_id": "ca20c05b-21bf-3db5-96ea-3cdc5e3fbbc9",
                        "entry_id": "0209d90b-454e-33e8-96be-d696fcf2f7a0",
                        "glosses": [
                            "het plaatsvinden van het weerverschijnsel van bliksem en donder"
                        ],
                        "tags": [
                            "impersonal"
                        ],
                        "examples": [
                            {
                                "example_id": "4dc01d0b-0fdf-479e-8802-97753711a7b7",
                                "sense_id": "ca20c05b-21bf-3db5-96ea-3cdc5e3fbbc9",
                                "text": "Met het onweren is de bliksem tien keer ingeslagen."
                            },
                            {
                                "example_id": "14f77888-9d0d-4073-97dd-558554ec20c3",
                                "sense_id": "ca20c05b-21bf-3db5-96ea-3cdc5e3fbbc9",
                                "text": "Het onweert vaker 's middags of 's avonds. \"Dat komt doordat de lucht gedurende de dag vaak opwarmt en het 's ochtends nog niet warm genoeg is om onweer te veroorzaken\", zegt de woordvoerder van Weerplaza. Als het 's nachts onweert komt dat vaak doordat onweersbuien overwaaien uit buurlanden als België en Frankrijk."
                            }
                        ]
                    }
