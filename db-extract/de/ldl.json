                                        "sense_id": "98efbafd-b1b2-354e-a4ca-02616738de70",
                                        "entry_id": "d5609a6b-e01a-363f-91fb-66fe6109b805",
                                        "glosses": [
                                            "Initialism of low-density lipoprotein."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "initialism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd5b93a8-0157-467b-b6a4-2753e618e312",
                                                "sense_id": "98efbafd-b1b2-354e-a4ca-02616738de70",
                                                "text": "High saturated fat intake has been tied to increased levels of LDL, or “bad,” cholesterol, which raises the risk of heart disease."
                                            },
                                            {
                                                "example_id": "f6e30f2f-6382-4d6e-a5a2-f5462c477ffd",
                                                "sense_id": "98efbafd-b1b2-354e-a4ca-02616738de70",
                                                "text": "In rare instances, however, high blood levels of the so-called bad cholesterol, LDL, result from a genetic defect called familial hypercholesterolemia (FH)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7ca12455-41d0-3637-9d61-22ce07197457",
                                        "entry_id": "d5609a6b-e01a-363f-91fb-66fe6109b805",
                                        "glosses": [
                                            "Initialism of limiting danger lines."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "initialism"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
