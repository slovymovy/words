                                        "entry_id": "b4539de8-990c-3ef9-9af2-523508c2496b",
                                        "glosses": [
                                            "Teilgebiet der Linguistik, das sich mit der Theorie und Praxis der Erstellung von Wörterbüchern beschäftigt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "84fbcad0-f333-4764-b65d-b8fffd03432b",
                                                "sense_id": "1fc8f54c-0d7c-3ee9-895f-8eba01eb4785",
                                                "text": "„Durch die Jahrhunderte hindurch entwickelte sich die Lexikographie zu einer selbständigen Wissenschaft.“"
                                            },
                                            {
                                                "example_id": "f38c90e0-cb9a-4706-ae14-38e227d4309c",
                                                "sense_id": "1fc8f54c-0d7c-3ee9-895f-8eba01eb4785",
                                                "text": "„Die Fragen nach dem Aufbau von Wörterbüchern, welche Informationen sie geben sollen, welche Wörter aufgenommen werden sollen, beschäftigen die Lexikographie schon über mehrere Jahrhunderte.“"
                                            },
                                            {
                                                "example_id": "0b5fe6cb-3243-4e8f-9532-21268a76e916",
                                                "sense_id": "1fc8f54c-0d7c-3ee9-895f-8eba01eb4785",
                                                "text": "„Helmut Heißenbüttel beklagte, daß der »Bereich der sogenannten Tabuwörter« von der Lexikographie immer noch stiefmütterlich behandelt werde…“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
