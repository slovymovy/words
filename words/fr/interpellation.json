{
    "word_family": [
        "interpeller",
        "interpellateur",
        "interpellatrice"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ebba0bb0-8d08-332b-a282-e405e37918ed",
                    "sense_definition": "Action menée par les forces de l'ordre pour appréhender une personne soupçonnée d'une infraction.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "police",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'<w>interpellation</w> du suspect s'est déroulée tôt le matin sans incident notable."
                        },
                        {
                            "text": "La police a procédé à l'<w>interpellation</w> de plusieurs individus après les dégradations dans le centre-ville."
                        }
                    ],
                    "synonyms": [
                        "arrestation",
                        "appréhension"
                    ],
                    "antonyms": [
                        "relaxe",
                        "libération"
                    ],
                    "common_phrases": [
                        "procéder à une interpellation",
                        "interpellation d'un suspect",
                        "interpellation musclée"
                    ]
                },
                {
                    "sense_id": "71ad8d13-a120-3096-8a8e-1c7e5c4a91c4",
                    "sense_definition": "Fait d'adresser la parole à quelqu'un de façon vive, soudaine ou provocatrice pour attirer son attention.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "discours",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le conférencier a été déstabilisé par une vive <w>interpellation</w> venue du fond de la salle."
                        },
                        {
                            "text": "Malgré les interpellations bruyantes des manifestants, le ministre a poursuivi son discours sans s'interrompre."
                        }
                    ],
                    "synonyms": [
                        "apostrophe"
                    ],
                    "common_phrases": [
                        "interpellation verbale",
                        "interpellation directe"
                    ]
                },
                {
                    "sense_id": "29a73a0c-2607-34ac-a1b6-8d4c2c4572b0",
                    "sense_definition": "Demande solennelle formulée par des parlementaires exigeant des explications d'un ministre ou du gouvernement.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "politique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le groupe d'opposition a déposé une demande d'<w>interpellation</w> sur la gestion de la crise économique."
                        },
                        {
                            "text": "Le Premier ministre a répondu calmement à l'<w>interpellation</w> des députés réunis en séance plénière."
                        }
                    ],
                    "common_phrases": [
                        "droit d'interpellation",
                        "demande d'interpellation"
                    ]
                },
                {
                    "sense_id": "714dc816-d905-34b0-a5cc-c0464f665617",
                    "sense_definition": "Sommation adressée en justice à un témoin ou à une partie pour qu'elle réponde sur un fait précis.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "justice",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sur l'<w>interpellation</w> du juge relative à ses déclarations contradictoires, le témoin a refusé de répondre."
                        },
                        {
                            "text": "L'avocat a exigé une <w>interpellation</w> formelle de la partie adverse pour clarifier les faits."
                        }
                    ],
                    "synonyms": [
                        "sommation"
                    ]
                }
            ]
        }
    ]
}