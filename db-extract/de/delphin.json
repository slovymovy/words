        "zh-extract.jsonl": [
            {
                "entry_id": "e4a3bea1-f5ee-350c-b55d-c1d913744821",
                "word": "Delphin",
                "pos": "noun",
                "lang_code": "de",
                "forms": [
                    {
                        "form_id": "2aa2a79d-5170-4f30-9815-7a648d6bb71e",
                        "entry_id": "e4a3bea1-f5ee-350c-b55d-c1d913744821",
                        "tags": [
                            "genitive"
                        ],
                        "form": "Delphins"
                    },
                    {
                        "form_id": "d5786083-54c3-478a-8035-ec0c8bf8e60e",
                        "entry_id": "e4a3bea1-f5ee-350c-b55d-c1d913744821",
                        "tags": [
                            "plural"
                        ],
                        "form": "Delphine"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "86cd6750-6dc2-3ab7-a1a2-c99690bd6f18",
                        "entry_id": "e4a3bea1-f5ee-350c-b55d-c1d913744821",
                        "glosses": [
                            "海豚"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b73c89de-a6c2-436a-994c-515bb44de85b",
                                "sense_id": "86cd6750-6dc2-3ab7-a1a2-c99690bd6f18",
                                "text": "Delphine sind die mit Abstand intelligentesten aller Tiere."
                            }
                        ]
                    },
                    {
                        "sense_id": "de54b329-3187-32c6-ad80-5b7fbdae2731",
                        "entry_id": "e4a3bea1-f5ee-350c-b55d-c1d913744821",
                        "glosses": [
                            "海豚座"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e28c79d6-4e39-44f2-bd69-00f8e4b9e537",
                                "sense_id": "de54b329-3187-32c6-ad80-5b7fbdae2731",
                                "text": "Delphin. Das Meerschwein. Das XXXV. Sternbild. [...] Nachdem er aber noch so viel Zeit erhalten, vorher ein bewegliches Klagelied zu spielen, und sich darauf in das Meer geworfen, ist so balden ein Delphin oder Meerschwein gekommen, hat ihn auf seinen Rucken genommen, und glücklich auf den Tenarischen Strand ans Land gesetzt, davor es nun unter den Sternen steht, wie Ovidius anzeigt;"
                            },
                            {
                                "example_id": "9b73755b-1b3f-4dd7-84cc-d5a9a1dd2f51",
                                "sense_id": "de54b329-3187-32c6-ad80-5b7fbdae2731",
                                "text": "Neben dem hellen Stern im Adler, gegen Osten, etwas aufwärts, ist an der Milchstraße der Delphin, oder das Meerschwein, ganz deutlich an fünf nahe zusammenstehenden Sternen dritter Größe zu sehen."
                            },
                            {
                                "example_id": "1ee14738-686f-4a3e-b5cc-87000f6d2580",
                                "sense_id": "de54b329-3187-32c6-ad80-5b7fbdae2731",
                                "text": "Den Namen Delphin, oder Meerschwein führet auch ein Sternbild zwischen dem Adler und Pegasus, welches vierzehn Sterne enthält, nämlich fünfe von der dritten, welche nahe bey einander stehen, zween von der fünften und sieben von der sechsten Größe."
                            },
                            {
                                "example_id": "2855867a-433b-4401-aff3-4418ac19e120",
                                "sense_id": "de54b329-3187-32c6-ad80-5b7fbdae2731",
                                "text": "Der Pfeil (Sagitta)\nZeigt sich fast ganz in der Milchstraße, nordwärts über dem Adler, südwärts unter dem Fuchs mit der Gans, westwärts beim Delphin, ostwärts beim Cerberus und Zweig."
                            },
                            {
                                "example_id": "b3c3826d-1a2d-4f33-8052-0b631b2cc9b3",
                                "sense_id": "de54b329-3187-32c6-ad80-5b7fbdae2731",
                                "text": "Das Füllen oder kleine Pferd. Von diesem wird nur der Kopf vorgestellt, er liegt zwischen dem Pegasus, Wassermann und Delphin."
                            },
                            {
                                "example_id": "ca90a34f-03c6-463e-89a0-faea39b8d3a5",
                                "sense_id": "de54b329-3187-32c6-ad80-5b7fbdae2731",
                                "text": "Die 21 schon den Alten bekannten nördlichen Sternbilder sind ... der Delphin oder das Meerschwein, delphinus."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": [
