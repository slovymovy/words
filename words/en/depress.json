            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0fe46f76-d146-3d3c-8dfc-d9c78c74cdd8",
                    "sense_definition": "To make someone feel sad or unhappy",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The gloomy weather always <w>depresses</w> me.",
                            "target_lang_translations": {
                                "ru": "Мрачная погода всегда <w>удручает</w> меня.",
                                "nl": "Het sombere weer <w>deprimeert</w> me altijd.",
                                "pl": "Ponura pogoda zawsze mnie <w>przygnębia</w>.",
                                "de": "Das trübe Wetter <w>deprimiert</w> mich immer.",
                                "fr": "Le temps maussade me <w>déprime</w> toujours.",
                                "it": "Il tempo cupo mi <w>deprime</w> sempre.",
                                "cs": "To pochmurné počasí mě vždy <w>deprimuje</w>.",
                                "tr": "Kasvetli hava beni her zaman <w>üzüyor</w>.",
                                "es": "El clima sombrío siempre me <w>deprime</w>.",
                                "zh": "阴沉的天气总是让我感到<w>沮丧</w>。"
                            }
                        },
                        {
                            "text": "It <w>depresses</w> me to see so much waste.",
                            "target_lang_translations": {
                                "ru": "Меня <w>удручает</w> видеть столько расточительства.",
                                "nl": "Het <w>maakt me neerslachtig</w> om zoveel verspilling te zien.",
                                "pl": "<w>Przygnębia</w> mnie widok tak wielkiego marnotrawstwa.",
                                "de": "Es <w>deprimiert</w> mich, so viel Verschwendung zu sehen.",
                                "fr": "Cela me <w>déprime</w> de voir autant de gaspillage.",
                                "it": "Mi <w>deprime</w> vedere così tanto spreco.",
                                "cs": "<w>Skličuje</w> mě, když vidím tolik plýtvání.",
                                "tr": "Bu kadar israf görmek beni <w>karamsarlığa sürüklüyor</w>.",
                                "es": "Me <w>deprime</w> ver tanto desperdicio.",
                                "zh": "看到这么多的浪费让我感到<w>忧郁</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "sadden",
                        "dispirit",
                        "upset"
                    ],
                    "antonyms": [
                        "cheer up"
                    ],
                    "target_lang_definitions": {
