                "senses": [
                    {
                        "sense_id": "6d6cfd0f-ddd8-3ec8-9313-068cd0543824",
                        "entry_id": "da861594-9fc2-3f4e-88ea-e99d3c9f9f58",
                        "glosses": [
                            "ein rechtlich eigenständiger, aber wirtschaftlich unselbstständiger Betrieb, der von der Hauptgesellschaft (kurz auch: Mutterunternehmen) geführt wird"
                        ],
                        "tags": [
                            "Betriebswirtschaft"
                        ],
                        "examples": [
                            {
                                "example_id": "1674fdcc-ee5f-469b-96e1-0f8dd3ca4d46",
                                "sense_id": "6d6cfd0f-ddd8-3ec8-9313-068cd0543824",
                                "text": "Das Tochterunternehmen in Madrid hat vergangenes Jahr deutlich mehr Gewinn erzielt als ein Jahr zuvor."
                            },
                            {
                                "example_id": "237ba3b0-1c98-4768-8831-fcd0a8a6ff8a",
                                "sense_id": "6d6cfd0f-ddd8-3ec8-9313-068cd0543824",
                                "text": "„Darüber hinaus war es üblich, dass deutsche Großunternehmen und Konzerne ihre Auslandsgeschäfte über teilweise oder ganz in ausländischem Besitz befindliche Tochterunternehmen abwickelten, insbesondere solche mit Sitz in den Niederlanden.“"
                            },
                            {
                                "example_id": "dcf6c160-49c2-48ca-b62e-bbf5c369083e",
                                "sense_id": "6d6cfd0f-ddd8-3ec8-9313-068cd0543824",
                                "text": "„Bei gut 3000 Vollzeitjobs im ORF selbst und fast 4000 Vollzeitstellen im ORF-Konzern samt Tochterunternehmen klingt das recht überschaubar.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
