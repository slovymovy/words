                    {
                        "sense_id": "c0e9c8ab-bb77-36cf-b32e-f7c4add91c11",
                        "entry_id": "4c860c70-09b9-3cff-a91f-fd04851a7621",
                        "glosses": [
                            "de klok die in Vlaanderen de paaseieren brengt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f90e72a6-bce9-48b1-8d09-f0544ba52a06",
                                "sense_id": "c0e9c8ab-bb77-36cf-b32e-f7c4add91c11",
                                "text": "Maken wij de kinderen wijs dat het de paashaas is die de eieren verstopt, in Frankrijk en België draait het om paasklokken. Die reizen op de avond van Witte Donderdag af naar Rome om de eieren te halen en keren in de paasnacht terug."
                            },
                            {
                                "example_id": "db305673-6446-4420-a92b-6bd850dfc4d4",
                                "sense_id": "c0e9c8ab-bb77-36cf-b32e-f7c4add91c11",
                                "text": "Als de paasklokken uw tuin schandelijk over het hoofd zouden zien, dan kunt u zondag nog altijd paaseitjes gaan rapen in Brussel. Daar wordt in tien verschillende parken een poging gewaagd om het wereldrecord paaseieren rapen te breken."
                            },
                            {
                                "example_id": "60e40bb0-195c-49be-a99b-c460814946fa",
                                "sense_id": "c0e9c8ab-bb77-36cf-b32e-f7c4add91c11",
                                "text": "Mijn ouders hebben enkele dagen geleden vanuit België een pakje opgestuurd met échte Belgische chocolade eieren en boekjes over Pasen met tekeningen, stickertjes en een verhaal over de paasklokken. Ik heb onze kindjes ook al enkele keren verteld dat de klokken eitjes brengen, maar voorlopig dringt het niet echt tot hen door. De chocolade opsmullen is voorlopig veel interessanter dan zich afvragen waar al dat lekkers vandaan komt."
                            }
                        ]
                    }
