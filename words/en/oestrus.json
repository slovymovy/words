            "senses": [
                {
                    "sense_id": "647a3e87-de53-3c06-80eb-17b6fdceea17",
                    "sense_definition": "A recurring period of sexual receptivity and fertility in female mammals; heat.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "reproduction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The veterinarian observed clear behavioral changes indicating the cow was in <w>oestrus</w>.",
                            "target_lang_translations": {
                                "ru": "Ветеринар заметил явные изменения в поведении, указывающие на то, что у коровы началась <w>течка</w>."
                            }
                        },
                        {
                            "text": "Female chimpanzees often develop prominent swelling during <w>oestrus</w> to attract potential mates.",
                            "target_lang_translations": {
                                "ru": "У самок шимпанзе во время <w>эструса</w> часто возникает заметная припухлость для привлечения потенциальных партнёров."
                            }
                        }
                    ],
                    "synonyms": [
                        "heat",
                        "estrus",
                        "rut"
                    ],
                    "antonyms": [
                        "anoestrus"
                    ],
                    "common_phrases": [
