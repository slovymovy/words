                },
                {
                    "sense_id": "4c4f517d-d9f1-3c8e-856c-bd9c8e18c766",
                    "sense_definition": "A past tense form of <w>spin</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the old tale, the woman sat by the fire and <w>span</w> wool all evening.",
                            "target_lang_translations": {
                                "ru": "В старой сказке женщина сидела у огня и весь вечер <w>пряла</w> шерсть.",
                                "zh": "在那个古老的故事里，那个女人坐在火边，整晚都在<w>纺</w>羊毛。",
                                "nl": "In het oude verhaal zat de vrouw bij het vuur en <w>spon</w> de hele avond wol."
                            }
                        },
                        {
                            "text": "The wheel <w>span</w> faster and faster until it was a blur.",
                            "target_lang_translations": {
                                "ru": "Колесо <w>крутилось</w> все быстрее и быстрее, пока не слилось в пятно.",
                                "zh": "轮子<w>旋转</w>得越来越快，直到看起来一片模糊。",
                                "nl": "Het wiel <w>draaide</w> sneller en sneller rond totdat het een waas was."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "past tense of spin"
                        },
                        {
