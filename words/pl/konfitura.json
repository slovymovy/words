{
    "word_family": [
        "konfiturowy"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f44208a4-8567-3a37-bcf3-2f669f5d6f0a",
                    "sense_definition": "owoce smażone w cukrze lub syropie cukrowym, stanowiące słodki przetwór",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "jedzenie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Moja babcia przygotowała pyszne naleśniki z domową <w>konfiturą</w> truskawkową.",
                            "target_lang_translations": {
                                "ru": "Моя бабушка приготовила вкусные блинчики с домашним клубничным <w>вареньем</w>."
                            }
                        },
                        {
                            "text": "Słodka <w>konfitura</w> z wiśni doskonale pasuje do herbaty w chłodne wieczory.",
                            "target_lang_translations": {
                                "ru": "Сладкое вишнёвое <w>варенье</w> отлично подходит к чаю холодными вечерами."
                            }
                        }
                    ],
                    "synonyms": [
                        "konfitury"
                    ],
                    "common_phrases": [
                        "słoik konfitury",
                        "domowa konfitura",
                        "konfitura wiśniowa"
                    ],
                    "target_lang_definitions": {
                        "ru": "фрукты или ягоды, сваренные в сахаре или сахарном сиропе; сладкая заготовка"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "варенье",
                                "target_lang_sense_clarification": "сваренные в сиропе ягоды или фрукты"
                            },
                            {
                                "target_lang_word": "конфитюр",
                                "target_lang_sense_clarification": "желеобразный джем или варенье"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c10e62c7-0432-3a61-9003-9b4d2088c250",
                    "sense_definition": "słoik zawierający przetwór z owoców",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "jedzenie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na najwyższej półce w spiżarni stoi jeszcze jedna <w>konfitura</w> ze śliwek.",
                            "target_lang_translations": {
                                "ru": "На самой верхней полке в кладовой стоит ещё одна <w>банка сливового варенья</w>."
                            }
                        },
                        {
                            "text": "Dostałem w prezencie dwie pyszne <w>konfitury</w> od sąsiadki z ogrodu.",
                            "target_lang_translations": {
                                "ru": "Я получил в подарок от соседки две <w>банки</w> вкуснейшего домашнего <w>варенья</w> из ягод с её огорода."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "банка с вареньем или сладкой плодовой заготовкой"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "банка варенья",
                                "target_lang_sense_clarification": "емкость с вареньем"
                            },
                            {
                                "target_lang_word": "варенье",
                                "target_lang_sense_clarification": "метонимически о банке с вареньем"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eac158b8-f2a9-3e02-b6b1-185e1d1592a4",
                    "sense_definition": "osoba donosząca na kogoś, współpracująca z policją lub wrogiem",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wszyscy na osiedlu wiedzieli, że ten chłopak to zwykła <w>konfitura</w>.",
                            "target_lang_translations": {
                                "ru": "Все на районе знали, что этот парень — обычный <w>стукач</w>."
                            }
                        },
                        {
                            "text": "Grupa natychmiast zerwała wszelkie kontakty, gdy wyszło na jaw, kto jest <w>konfiturą</w>.",
                            "target_lang_translations": {
                                "ru": "Группа немедленно разорвала все контакты, когда вскрылось, кто был <w>осведомителем</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "donosiciel",
                        "kabel",
                        "kablarz",
                        "kapuś",
                        "konfident"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "używane w slangu przestępczym i młodzieżowym"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "человек, доносящий на других, сотрудничающий с полицией; осведомитель"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стукач",
                                "target_lang_sense_clarification": "жаргонное обозначение доносчика"
                            },
                            {
                                "target_lang_word": "ябеда",
                                "target_lang_sense_clarification": "доносчик"
                            },
                            {
                                "target_lang_word": "осведомитель",
                                "target_lang_sense_clarification": "сотрудничающий с полицией или спецслужбами"
                            }
                        ]
                    }
                }
            ]
        }
    ]
