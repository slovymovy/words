                },
                {
                    "sense_id": "26f9fe4f-d670-3ef2-aebb-9c477e5eb220",
                    "sense_definition": "verouderde vorm van <w>gracht</w> in de betekenis graf",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In het oude verhaal lag de ridder in een diepe <w>graft</w> buiten de kerk.",
                            "target_lang_translations": {
                                "en": "In the old story, the knight lay in a deep <w>grave</w> outside the church."
                            }
                        },
                        {
                            "text": "De schrijver gebruikte <w>graft</w> waar wij nu meestal graf zouden zeggen.",
                            "target_lang_translations": {
                                "en": "The writer used <w>grave</w> where we would now usually say graf."
                            }
                        }
                    ],
                    "common_phrases": [
