                "senses": [
                    {
                        "sense_id": "d6ab42a2-f200-3c21-9565-a2b810cbd32e",
                        "entry_id": "f5766862-61e8-33d0-893e-d31474094fb4",
                        "glosses": [
                            "to put (next to)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f49f3fdc-e79a-4d10-8e4a-fecd4ab2f489",
                                "sense_id": "d6ab42a2-f200-3c21-9565-a2b810cbd32e",
                                "text": "приложи́ть часы́ к у́ху",
                                "translation": "to put a watch to one's ear",
                                "english": "to put a watch to one's ear"
                            },
                            {
                                "example_id": "7f96279b-e9d1-4181-b650-149edb3a7dd6",
                                "sense_id": "d6ab42a2-f200-3c21-9565-a2b810cbd32e",
                                "text": "приложи́ть ру́ку к козырьку́",
                                "translation": "to put one's hand to the peak of one's cap, salute",
                                "english": "to put one's hand to the peak of one's cap, salute"
                            },
                            {
                                "example_id": "36dca340-bd07-4058-ae6e-f2d81dcf41bb",
                                "sense_id": "d6ab42a2-f200-3c21-9565-a2b810cbd32e",
                                "text": "приложи́ть ру́ку",
                                "translation": "1) to sign, fix one's signature 2) take a hand (in), put one's hand, to have a finger in the pie",
                                "english": "1) to sign, fix one's signature 2) take a hand (in), put one's hand, to have a finger in the pie"
                            }
                        ]
                    },
                    {
                        "sense_id": "9a2974c3-ccc7-35c0-a48c-964e0bfb7e80",
                        "entry_id": "f5766862-61e8-33d0-893e-d31474094fb4",
                        "glosses": [
                            "to enclose, to join, to attach"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb23868e-bbc3-4b5e-8200-14f26c6eac8e",
                                "sense_id": "9a2974c3-ccc7-35c0-a48c-964e0bfb7e80",
                                "text": "приложи́ть печа́ть",
                                "translation": "to attach a seal",
                                "english": "to attach a seal"
                            }
                        ]
                    },
                    {
                        "sense_id": "1c7d53c1-aa77-3703-9a21-1ac32e275767",
                        "entry_id": "f5766862-61e8-33d0-893e-d31474094fb4",
                        "glosses": [
                            "to apply, to use"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d6ac0a51-5e21-4cdd-b652-d1d4a0e7cc98",
                                "sense_id": "1c7d53c1-aa77-3703-9a21-1ac32e275767",
                                "text": "приложи́ть уси́лие",
                                "translation": "to apply an effort",
                                "english": "to apply an effort"
                            },
                            {
                                "example_id": "07a91468-b3be-466a-8c1e-a50f63273efa",
                                "sense_id": "1c7d53c1-aa77-3703-9a21-1ac32e275767",
                                "text": "приложи́ть зна́ния",
                                "translation": "apply one's knowledge",
                                "english": "apply one's knowledge"
                            },
                            {
                                "example_id": "02685354-0d68-4ac5-bdba-ca2ec6802bd6",
                                "sense_id": "1c7d53c1-aa77-3703-9a21-1ac32e275767",
                                "text": "Разви́тие Рыжо́ва бы́ло уже́ соверше́нно зако́нчено, и наступа́ло вре́мя де́ятельности, в кото́рой он мог приложи́ть пра́вила, со́зданные им себе́ на библе́йском гру́нте.",
                                "translation": "Ryzhov’s development was now completely finished, and the time for action was coming, in which he could apply the rules he had created for himself on a biblical ground.",
                                "english": "Ryzhov’s development was now completely finished, and the time for action was coming, in which he could apply the rules he had created for himself on a biblical ground."
                            }
                        ]
                    },
