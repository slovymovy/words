                                        "sense_id": "d00d8f04-af2a-307b-9f84-7e26e6c6cb54",
                                        "entry_id": "0901e18d-f1a0-3601-ac13-b26ab8436eda",
                                        "glosses": [
                                            "ein Band, welches um den Hals gelegt oder gebunden ist"
