                                "target_lang_sense_clarification": "столовая утварь (собирательное)"
                            },
                            {
                                "target_lang_word": "тарелки",
                                "target_lang_sense_clarification": "конкретный вид посуды"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "餐具",
                                "target_lang_sense_clarification": "指各种进餐用的器皿，集合名词"
                            },
                            {
                                "target_lang_word": "盘子",
                                "target_lang_sense_clarification": "指具体的盛菜器皿"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "79d07b8e-7c75-3bf9-a8b8-bdc402fabe8c",
                    "sense_definition": "The dirty plates, cups, and utensils that need to be washed.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "chore",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After dinner, they had to do the <w>dishes</w> before watching TV.",
                            "target_lang_translations": {
                                "ru": "После ужина им пришлось помыть <w>посуду</w> перед просмотром телевизора.",
                                "zh": "晚饭后，他们得先<w>洗碗</w>再看电视。"
                            }
                        },
                        {
                            "text": "It is your turn to do the <w>dishes</w> tonight.",
                            "target_lang_translations": {
                                "ru": "Сегодня твоя очередь мыть <w>посуду</w>.",
                                "zh": "今晚轮到你<w>洗碗</w>了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "do the dishes"
                    ],
                    "target_lang_definitions": {
                        "ru": "Грязные тарелки, чашки и приборы, которые необходимо помыть.",
                        "zh": "指用过之后需要清洗的脏碗筷和餐具。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "посуда",
                                "target_lang_sense_clarification": "грязная, требующая мытья"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "碗筷",
                                "target_lang_sense_clarification": "指需要清洗的餐具"
                            },
                            {
                                "target_lang_word": "脏餐具",
                                "target_lang_sense_clarification": "指待洗的餐具"
                            }
                        ]
                    }
                }
            ]
        },
        {
