                                "target_senses": [
                                    {
                                        "sense_id": "aae4b3c3-0ab2-369d-a85c-2d34a641fab6",
                                        "entry_id": "b3d6b690-a006-30a6-a0df-af8e60f905a9",
                                        "glosses": [
                                            "The quality or state of being selfless."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cbdb0358-3225-4d02-8725-e31800a3cf8f",
                                                "sense_id": "aae4b3c3-0ab2-369d-a85c-2d34a641fab6",
                                                "text": "But the truth is that I came to cherish Japan’s civility and selflessness."
                                            }
                                        ]
