                                            {
                                                "example_id": "1073c724-1cfe-40d7-873f-f5a9e3387f70",
                                                "sense_id": "3862e0db-a05f-3eb7-9d34-1b0341da1c9c",
                                                "text": "Bienenwaben haben die Form von Sechsecken."
                                            },
                                            {
                                                "example_id": "e6e9c4d6-bbe3-415d-ad4b-024f85f1a1a8",
                                                "sense_id": "3862e0db-a05f-3eb7-9d34-1b0341da1c9c",
                                                "text": "„Ebenso zeichnete Archimedes ein reguläres Sechseck innerhalb des Kreises; dieses hat einen kleineren Umfang als der Kreis.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e562e104-1b01-46c5-b10c-70db72943f99",
                        "source_entry_id": "b107a73b-5286-3119-a02c-7973bd1112fd",
                        "source_sense_id": "2043035f-cbb1-32d2-8fe9-d4c70b6b2ed8",
                        "source_sense_description": "een geometrische tweedimensionale vorm, bestaande uit zes hoeken en derhalve ook zes zijden",
                        "target_lang_word": "hexagon",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hexagon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e880235b-f0a9-3709-95ad-8b1f915038ff",
                                        "entry_id": "67744b82-83be-3079-b106-9078807f1c8e",
                                        "glosses": [
                                            "A polygon with six sides and six angles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "41cf5c12-3d40-4d65-ba06-aa41b5e0e529",
                                                "sense_id": "e880235b-f0a9-3709-95ad-8b1f915038ff",
                                                "text": "The project was a huge, queen-size quilt made up of 100 hexagon pieces – 50 of them embroidered with a design for every US state and 50 stars. […] Once the designs are all stitched and the hexagons are returned to Downey, they will be assembled into the completed quilt."
                                            },
                                            {
                                                "example_id": "579c463e-6f41-483d-a73d-648727acdfbe",
                                                "sense_id": "e880235b-f0a9-3709-95ad-8b1f915038ff",
                                                "text": "If we just plopped down a dot for every observation we’d end up with an undifferentiated black blob, so the weathergami technique visualizes frequency of temperature pairs: we divide the chart area into a fine hexagonal grid, and then color each hexagon according to how many daily observations fall within it."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aa2b418f-2a6a-4791-81fd-58f241809c35",
                        "source_entry_id": "b107a73b-5286-3119-a02c-7973bd1112fd",
                        "source_sense_id": "2043035f-cbb1-32d2-8fe9-d4c70b6b2ed8",
                        "source_sense_description": "een geometrische tweedimensionale vorm, bestaande uit zes hoeken en derhalve ook zes zijden",
                        "target_lang_word": "hexagone",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hexagone",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dee6ef69-23ce-3cef-a9d7-6d7c9088dde5",
                                        "entry_id": "a86de059-214c-3339-8df6-950174ee3710",
                                        "glosses": [
                                            "Figure qui a six angles et six côtés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eda04321-babc-4c31-8f9d-ae15f0a54c9f",
                                                "sense_id": "dee6ef69-23ce-3cef-a9d7-6d7c9088dde5",
                                                "text": "Tracer un hexagone."
                                            },
                                            {
                                                "example_id": "66eea2aa-7dd9-49be-8061-975c74099dcb",
                                                "sense_id": "dee6ef69-23ce-3cef-a9d7-6d7c9088dde5",
                                                "text": "Qu'on observe les petites écailles de la peau d'une roussette, on verra qu'elles sont hexagones, parce que chaque écaille croissant en même temps se fait obstacle, et tend à occuper le plus d'espace qu'il est possible dans un espace donné : on voit ces mêmes hexagones dans le second estomac des animaux ruminants, on les trouve dans les graines, dans les capsules, dans certaines fleurs, etc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d5a41c33-7e8d-3d44-b9db-0e9a020d19af",
                                        "entry_id": "a86de059-214c-3339-8df6-950174ee3710",
                                        "glosses": [
                                            "Ouvrage composé de six bastions."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dbdac7c6-28f0-3f78-9da2-9397ac17e966",
                                        "entry_id": "a86de059-214c-3339-8df6-950174ee3710",
                                        "glosses": [
                                            "Variante orthographique de Hexagone : La France métropolitaine."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "013f43d0-1181-4ff6-92df-1373c9b47bde",
                                                "sense_id": "dbdac7c6-28f0-3f78-9da2-9397ac17e966",
                                                "text": "Il compare la transformation de l’hexagone à celle des autres grandes nations européennes, devenues petites : Grande-Bretagne, Allemagne, Italie, Suède."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "hexagone",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5e3ba520-0d3f-3ab5-b5b8-d3324e000f78",
                                        "entry_id": "6f795bba-cc44-329e-87fb-674f4d91b407",
                                        "glosses": [
                                            "Qui a six angles et six côtés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed2966fc-ab11-46e6-a9b2-d4fcb1b7705d",
                                                "sense_id": "5e3ba520-0d3f-3ab5-b5b8-d3324e000f78",
                                                "text": "Une citadelle hexagone."
                                            },
                                            {
                                                "example_id": "80e1dcd5-6735-4734-a8c3-e861498fbccb",
                                                "sense_id": "5e3ba520-0d3f-3ab5-b5b8-d3324e000f78",
                                                "text": "Un plan hexagone."
                                            },
                                            {
                                                "example_id": "2bdfec85-170b-44f0-b36b-9c18216a12a1",
                                                "sense_id": "5e3ba520-0d3f-3ab5-b5b8-d3324e000f78",
                                                "text": "Un bassin hexagone."
                                            },
                                            {
                                                "example_id": "9c53566b-1eb8-45cc-bc32-4900ffc201d1",
                                                "sense_id": "5e3ba520-0d3f-3ab5-b5b8-d3324e000f78",
                                                "text": "Une figure hexagone."
                                            },
                                            {
                                                "example_id": "efc0704e-8330-4cf7-8d36-8e2e98834d55",
                                                "sense_id": "5e3ba520-0d3f-3ab5-b5b8-d3324e000f78",
                                                "text": "L’appartement se composait d’une pièce unique, ornée d’un grabat que le gnome ne se donnait pas la peine de faire tous les jours, et de deux petites fenêtres à carreaux hexagones, où la lune avait déteint ses rayons nacrés de rose et de violet."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
