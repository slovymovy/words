                                        ]
                                    },
                                    {
                                        "sense_id": "4938fcb0-2bed-3a0b-8c3f-926aa9d531fb",
                                        "entry_id": "5a85fe63-3339-30c0-8680-162221667bd7",
                                        "glosses": [
                                            "Action de doter une grandeur d’un signe qui en modifie la valeur."
                                        ],
