        "nl-extract.jsonl": [
            {
                "entry_id": "dc1583ef-5847-327a-8f13-b00849afebe0",
                "word": "elders",
                "pos": "adv",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "08c56a74-f3c0-33ca-95aa-b5f8d2ebd170",
                        "entry_id": "dc1583ef-5847-327a-8f13-b00849afebe0",
                        "glosses": [
                            "ergens anders, in een andere plaats, op een andere plaats"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e32be4e6-a534-4ea6-a1c9-b92d13b4f897",
                                "sense_id": "08c56a74-f3c0-33ca-95aa-b5f8d2ebd170",
                                "text": "Mijn familie woont elders in Almelo"
                            },
                            {
                                "example_id": "a667eac2-96d2-46f6-9d7e-14eb69b37a6f",
                                "sense_id": "08c56a74-f3c0-33ca-95aa-b5f8d2ebd170",
                                "text": "Regeringen, in de Verenigde Staten en elders, beperken de vrijhandel, ondermijnen de onafhankelijkheid van de centrale bank, laten begrotingstekorten oplopen en schroeven het klimaatbeleid terug. Precies níét wat de meeste economen verstandig vinden."
                            },
                            {
                                "example_id": "e7d47cb5-01cd-44b2-a2ac-c90ea7392f49",
                                "sense_id": "08c56a74-f3c0-33ca-95aa-b5f8d2ebd170",
                                "text": "En ook elders in het dierenrijk slaan broers en zussen elkaar net zo vaak de hersens in als dat ze elkaar helpen, lees ik in A Natural History of Families van de Amerikaanse ornitholoog Scott Forbes."
                            },
                            {
                                "example_id": "39913dbf-a3ce-4520-96fc-2cd3f5387d38",
                                "sense_id": "08c56a74-f3c0-33ca-95aa-b5f8d2ebd170",
                                "text": "De inwoners van Bleskensgraaf hadden het advies gekregen te evacueren en waren bijna allemaal elders ondergebracht."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0e53bc56-681d-46b8-897a-9bf81c1ecea0",
                        "source_entry_id": "dc1583ef-5847-327a-8f13-b00849afebe0",
                        "source_sense_id": "08c56a74-f3c0-33ca-95aa-b5f8d2ebd170",
                        "target_lang_word": "anderswo",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anderswo",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7325f086-11d5-3b7b-9958-922c65ee3282",
                                        "entry_id": "b89621dd-3f18-3d15-a5f0-01b53f5b7622",
                                        "glosses": [
                                            "an einem anderen Ort; nicht hier; nicht anwesend, nicht vorhanden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ead87ae2-7598-4b5f-9427-13461ed35ab7",
                                                "sense_id": "7325f086-11d5-3b7b-9958-922c65ee3282",
                                                "text": "Das Buch, das du suchst, ist anderswo."
                                            },
                                            {
                                                "example_id": "700079d2-c08b-4ea2-aa82-e7578654b6fe",
                                                "sense_id": "7325f086-11d5-3b7b-9958-922c65ee3282",
                                                "text": "Anderswo spricht man anders."
                                            },
                                            {
                                                "example_id": "4430605f-b3c0-4d2d-b19b-1522a791d6f0",
                                                "sense_id": "7325f086-11d5-3b7b-9958-922c65ee3282",
                                                "text": "Martha ist anderswo zu Hause."
                                            },
                                            {
                                                "example_id": "bb8979c9-dce5-4c44-8731-61d399b0c5df",
                                                "sense_id": "7325f086-11d5-3b7b-9958-922c65ee3282",
                                                "text": "Es ist nicht so viel los wie anderswo."
                                            },
                                            {
                                                "example_id": "5bb21180-f367-4be5-b5f7-101a39ef01b4",
                                                "sense_id": "7325f086-11d5-3b7b-9958-922c65ee3282",
                                                "text": "„In Ungarn, auf dem Balkan, in Rumänien und anderswo war das genauso.“"
                                            },
                                            {
                                                "example_id": "c465f8bb-335c-444d-9ea8-3cf349fe9689",
                                                "sense_id": "7325f086-11d5-3b7b-9958-922c65ee3282",
                                                "text": "[Türkei:] „Wer hier keine Zukunft für sich sieht, sucht anderswo nach einem neuen Leben.“"
                                            },
                                            {
                                                "example_id": "2b5357f6-9294-440a-bce6-bdbb14b8407a",
                                                "sense_id": "7325f086-11d5-3b7b-9958-922c65ee3282",
                                                "text": "„Anderswo begegnen Abnehmerstaaten Chinas Übermacht, indem sie stillgelegte Lagerstätten reaktivieren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "89ddf03e-fbfd-42d7-9f2b-e38c56f50805",
                        "source_entry_id": "dc1583ef-5847-327a-8f13-b00849afebe0",
                        "source_sense_id": "08c56a74-f3c0-33ca-95aa-b5f8d2ebd170",
                        "target_lang_word": "elsewhere",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "elsewhere",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cb0b10f4-8494-3468-9c75-e8afddcb49b0",
                                        "entry_id": "4de48f43-29cc-3386-9221-bc520495bb6d",
                                        "glosses": [
                                            "Synonym of somewhere else: in, at, or to some other place."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b7ce151b-7f71-45da-a63a-e7eb39744a62",
                                                "sense_id": "cb0b10f4-8494-3468-9c75-e8afddcb49b0",
                                                "text": "If you won’t serve us, we’ll go elsewhere."
                                            },
                                            {
                                                "example_id": "33d31f54-3b16-4a65-b2bb-930020d3f068",
                                                "sense_id": "cb0b10f4-8494-3468-9c75-e8afddcb49b0",
                                                "text": "These particular trees are not to be found elsewhere."
                                            },
                                            {
                                                "example_id": "def98377-dcc0-4774-b4ef-be7c6c001060",
                                                "sense_id": "cb0b10f4-8494-3468-9c75-e8afddcb49b0",
                                                "text": "Oh, had we some bright little isle of our own, / In a blue summer ocean far off and alone; / [...] / Where simply to feel that we breathe, that we live, / Is worth the best joys that life elsewhere can give."
                                            },
                                            {
                                                "example_id": "e182a7b4-c3f2-44f1-9dc0-ab20c0cb867d",
                                                "sense_id": "cb0b10f4-8494-3468-9c75-e8afddcb49b0",
                                                "text": "He draws eclectically on studies of baboons, descriptive anthropological accounts of hunter-gatherer societies and, in a few cases, the fossil record. With this biological framework in place, Corning endeavors to show that the capitalist system as currently practiced in the United States and elsewhere is manifestly unfair."
                                            },
                                            {
                                                "example_id": "657912fc-f8bc-44a3-b3c8-2896b9273fc3",
                                                "sense_id": "cb0b10f4-8494-3468-9c75-e8afddcb49b0",
                                                "text": "Many monuments sold in the US are crafted from granite produced in China, India and elsewhere overseas, while a lot of stone-working equipment comes from Europe."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "elsewhere",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d21e4194-0c3d-3b82-8146-da9abfe4d551",
                                        "entry_id": "a3870cf0-6f7e-3c96-9222-2f8e0f6afc90",
                                        "glosses": [
                                            "Synonym of somewhere else: a place other than here."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "40dbd045-65d0-4034-a60b-3e453ab0c787",
                                                "sense_id": "d21e4194-0c3d-3b82-8146-da9abfe4d551",
                                                "text": "We are back on the Ligurian coast, from which vertigos push human beings toward all kinds of elsewheres."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "08ea1b33-44b5-473e-9a72-d3d58434c834",
                        "source_entry_id": "dc1583ef-5847-327a-8f13-b00849afebe0",
                        "source_sense_id": "08c56a74-f3c0-33ca-95aa-b5f8d2ebd170",
                        "target_lang_word": "somewhere else",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "somewhere else",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e18e8814-04b6-3dbd-8498-942d7ecc0e8a",
                                        "entry_id": "4c67aedc-eb8b-3f6e-a763-8cea4d16fd21",
                                        "glosses": [
                                            "A place other than here."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "somewhere else",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8c566fe5-a229-3ca3-b21e-0993d1c30795",
                                        "entry_id": "a2da4374-ae54-306f-9897-dd8281a2f3b7",
                                        "glosses": [
                                            "In or at some other place."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c3b46aa5-5f3b-3f70-a30a-d69a25117fbb",
                                        "entry_id": "a2da4374-ae54-306f-9897-dd8281a2f3b7",
                                        "glosses": [
                                            "To some other place."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8385d4cf-22e5-3227-9d61-40718d659120",
                                        "entry_id": "a2da4374-ae54-306f-9897-dd8281a2f3b7",
                                        "glosses": [
                                            "Distracted; in a daydream, (of the mind) unable to interact with events in the here and now"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3b8728ce-5fc0-4b5a-9012-7972e915562f",
                                                "sense_id": "8385d4cf-22e5-3227-9d61-40718d659120",
                                                "text": "But I get slightly crazy when I'm working on something. I zone out and get lost watching scenes play out in my head. That's why I won't have lunch with friends when I'm writing. My head is somewhere else and they naturally take it personally."
                                            },
                                            {
                                                "example_id": "37fbd0eb-62bf-4a4f-80f3-9c7a1281f0e2",
                                                "sense_id": "8385d4cf-22e5-3227-9d61-40718d659120",
                                                "text": "Hearing the laughter of his sons, Alf grinned. But he was somewhere else, thinking of the woman moving through the dim house behind him."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4dcba966-9147-4955-9e00-7ff58ccede9b",
                        "source_entry_id": "dc1583ef-5847-327a-8f13-b00849afebe0",
                        "source_sense_id": "08c56a74-f3c0-33ca-95aa-b5f8d2ebd170",
                        "target_lang_word": "ailleurs",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ailleurs",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "06fc70d4-9d88-31f5-8d2d-e1fc71b80cda",
                                        "entry_id": "1dd616d2-c216-316e-93a9-4835872c863d",
                                        "glosses": [
                                            "En un autre lieu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fad3c0d9-558d-4b8a-a7c0-aa16e5aa2779",
                                                "sense_id": "06fc70d4-9d88-31f5-8d2d-e1fc71b80cda",
                                                "text": "Ailleurs, elles relèvent leur châle sur leur tête, et se trouvent toutes drapées pour un peintre."
                                            },
                                            {
                                                "example_id": "f42b590f-dba2-4363-a1f7-b763e2800a59",
                                                "sense_id": "06fc70d4-9d88-31f5-8d2d-e1fc71b80cda",
                                                "text": "Sans cette hantise de retrouver ses assassins, depuis beau jour, Marcoul serait ailleurs. Il aurait obtenu sa mutation."
                                            },
                                            {
                                                "example_id": "8ff062d4-d1c1-46dc-9daa-f38cb1ac20aa",
                                                "sense_id": "06fc70d4-9d88-31f5-8d2d-e1fc71b80cda",
                                                "text": "Les fêtes de roses qui se multipliaient, surtout autour de Paris, à Brie-Comte-Robert ou Grisy-Suisnes, en Brie, à Fontenay-aux-Roses, et ailleurs, étaient plus proches de la kermesse que de la mondanité."
                                            },
                                            {
                                                "example_id": "75fe98fb-f106-4209-99d4-75aab65267b7",
                                                "sense_id": "06fc70d4-9d88-31f5-8d2d-e1fc71b80cda",
                                                "text": "— Qu’il s’agisse de sensualité ou d’expériences préconjugales, les supporters traditionnels du poujadisme ont un comportement absolument prévisible, triste et réactionnaire, là comme ailleurs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "97cf5622-7fa4-3471-94e9-300ed2261e94",
                                        "entry_id": "1dd616d2-c216-316e-93a9-4835872c863d",
                                        "glosses": [
                                            "Dans un autre passage d’un document."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d1fd18ae-674b-4f90-9b51-fb45142a4847",
                                                "sense_id": "97cf5622-7fa4-3471-94e9-300ed2261e94",
                                                "text": "Nous avons démontré ailleurs que cette hypothèse est peu plausible."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ailleurs",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7bad4b19-691e-3526-a483-281065585d7a",
                                        "entry_id": "56c8920d-e5f7-3cc1-a48e-3cf32d67bbb2",
                                        "glosses": [
                                            "Endroit se trouvant autre part."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b235d58-dad8-4c00-9eae-0ce87778922d",
                                                "sense_id": "7bad4b19-691e-3526-a483-281065585d7a",
                                                "text": "C’est « l’ailleurs » auquel tu as tant aspiré et sur quoi tu écrivais des pages et des pages redondantes sur tes cahiers secrets d’écolier."
                                            },
                                            {
                                                "example_id": "38492c50-15cf-4d81-a3c1-d3837c236249",
                                                "sense_id": "7bad4b19-691e-3526-a483-281065585d7a",
                                                "text": "Dans cet univers en dévers,\n Déshérence en plein cœur de verre,\n Je cherche un chemin de douceur\n Qui mène aux lisières de l’ailleurs."
                                            },
                                            {
                                                "example_id": "02eb83ed-1b3c-4e43-9b5e-56d951324c58",
                                                "sense_id": "7bad4b19-691e-3526-a483-281065585d7a",
                                                "text": "[…] la puissante odeur de kérosène qui devient aujourd'hui le parfum des ailleurs […]"
                                            },
                                            {
                                                "example_id": "adf8bbde-0f45-449d-a059-0cfaeb4c0364",
                                                "sense_id": "7bad4b19-691e-3526-a483-281065585d7a",
                                                "text": "Que représentaient pour moi notre tramway de banlieue, notre train à impériale ? Les voyages, l’évasion, le rêve, de grands espaces, ces ailleurs mystérieux sortis des romans de Loti."
                                            },
                                            {
                                                "example_id": "b5bf7a1b-f98a-4dbd-87db-10e3a315df71",
                                                "sense_id": "7bad4b19-691e-3526-a483-281065585d7a",
                                                "text": "Il saisit donc les traces de l'événement, il les arrache à l'accidentel, à la contingence, il les transporte dans les ailleurs du mythe"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
