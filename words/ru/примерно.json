            "senses": [
                {
                    "sense_id": "a0683785-12de-337d-a6f9-71c76632ca46",
                    "sense_definition": "Краткая форма среднего рода единственного числа прилагательного <w>примерный</w>.",
                    "learner_level": "B2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Его поведение на уроке было <w>примерно</w>.",
                            "target_lang_translations": {
                                "en": "His behavior during the lesson was <w>exemplary</w>.",
                                "zh": "他在课上的表现堪称<w>模范</w>。"
                            }
                        },
                        {
                            "text": "Это решение задачи не совсем <w>примерно</w>, но допустимо.",
                            "target_lang_translations": {
                                "en": "This solution to the problem is not quite <w>exemplary</w>, but acceptable.",
                                "zh": "这个解题方案虽然算不上<w>标准</w>，但可以接受。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "short neuter singular"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Short neuter singular form of the adjective 'exemplary'.",
                        "zh": "形容词“模范的”的短尾中性形式，表示符合标准或作为榜样。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "exemplary",
                                "target_lang_sense_clarification": "serving as a model"
                            },
                            {
                                "target_lang_word": "excellent",
                                "target_lang_sense_clarification": "of high quality"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "模范",
                                "target_lang_sense_clarification": "作为榜样的"
                            },
                            {
