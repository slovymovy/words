                        "cross_references": [
                            {
                                "target_word": "Sonate",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "041fb064-a94b-37f7-9d67-e256830fc987",
                                        "entry_id": "2aec1a24-b4d0-35c3-acc0-5a7d6e0bb8f5",
                                        "glosses": [
                                            "ein Klangstück mit mehreren Sätzen"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4d93dcf5-9eb5-45e6-8ec6-fd4730575b75",
                                                "sense_id": "041fb064-a94b-37f7-9d67-e256830fc987",
                                                "text": "„Während sie schweigend nebeneinander hergingen, hörte Thomas plötzlich in seinem Ohr die schöne Weise aus dem Andante der ersten Sonate vom Brahms, die sich seit Tagen in seinem Ohr eingewurmt hatte.“"
                                            },
                                            {
                                                "example_id": "9f7ea750-a2fe-409b-825d-f68b3969d011",
                                                "sense_id": "041fb064-a94b-37f7-9d67-e256830fc987",
                                                "text": "„Seine Schubladen stecken voller Sonaten, Lieder für Klavier und Gitarre, Messen und Ouvertüren.“"
                                            },
                                            {
                                                "example_id": "2af693f5-252c-4282-96cb-07b0e5908e96",
                                                "sense_id": "041fb064-a94b-37f7-9d67-e256830fc987",
                                                "text": "Die Sonate ist „ein Klangstück“ und ein „Formbegriff mit doppelter Bedeutung\". Die Sonate mit mehreren Sätzen ist von dem Sonaten-Satz, der Form ihres 1. Teiles, zu unterscheiden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8b5b8a50-2ff6-3c0b-a8dc-6c804a8b94df",
                                        "entry_id": "2aec1a24-b4d0-35c3-acc0-5a7d6e0bb8f5",
                                        "glosses": [
                                            "der Sonatensatz, der erste Satz einer Sonate"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cb18ac0d-d5b2-4d10-a6a6-9af14ef1130f",
                                                "sense_id": "8b5b8a50-2ff6-3c0b-a8dc-6c804a8b94df",
                                                "text": "Die Sonate ist „ein Klangstück“ und ein „Formbegriff mit doppelter Bedeutung\". Die Sonate mit mehreren Sätzen ist von dem Sonaten-Satz, der Form ihres 1. Teiles, zu unterscheiden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
