                        "tags": [],
                        "examples": [
                            {
                                "example_id": "691ae21f-a3f1-409a-86d7-7616a21ceaf8",
                                "sense_id": "2e5810c1-9b60-31be-b7f1-9366aa5c5495",
                                "text": "La contagion émotionnelle peut être intensifiée parce qu’elle opère dans un cercle affectif proche, entre amis ou au sein du couple. On l’appelle alors contagion amireuse."
                            },
                            {
                                "example_id": "a3cc950c-eb03-45d5-a6d4-3db484fe9923",
                                "sense_id": "2e5810c1-9b60-31be-b7f1-9366aa5c5495",
                                "text": "Pour ma part, j’ai évidemment été tentée de t’envoyer un message, non pas amoureux, mais plutôt amireux… parce que tu es l’Ami que j’aime profondément, en dépit des circonstances."
                            }
                        ]
                    }
