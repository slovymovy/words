                        "entry_id": "9b5e14c3-833d-35d0-a87e-b387d97a2a79",
                        "glosses": [
                            "Gebirgspass in den Alpen zwischen Damüls und Laterns im österreichischen Bundesland Vorarlberg"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "72e33c58-5c66-45d2-834d-882c7db00dca",
                                "sense_id": "23995212-596e-38bf-9537-e6a3445ca9ae",
                                "text": "„Die durch das Laternsertal führende Laternserstraße (L 51) verbindet über das Furkajoch das Tal der Frutz mit dem Tal des Argenbachs bei Damüls und damit mit dem Bregenzerwald.“"
                            },
                            {
                                "example_id": "a77a8c6c-08e2-4882-bbcd-1db05b196be3",
                                "sense_id": "23995212-596e-38bf-9537-e6a3445ca9ae",
                                "text": "„Wieder ein paar Kilometer weiter zweigt in Au die Straße zum Furkajoch ab, dessen Übergang im Winter gesperrt ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
