                "translations": [
                    {
                        "translation_id": "8a7b6446-bc7a-42a2-9713-6563c0642a4c",
                        "source_entry_id": "5872eac4-b16f-3181-9353-76a7a71ccf3e",
                        "source_sense_id": "5a1293cb-f86c-3b82-bb69-641649ec9a25",
