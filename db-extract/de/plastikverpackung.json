                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eaa0c87c-f6a1-40d8-b40d-0aea29bd3105",
                                "sense_id": "2d4077df-9b33-317c-a882-b802153cac55",
                                "text": "„Die Hamburger in der Plastikverpackung sind grau geworden.“"
                            },
                            {
                                "example_id": "7156416c-13ed-4434-a001-96d1dbc5f1b6",
                                "sense_id": "2d4077df-9b33-317c-a882-b802153cac55",
                                "text": "„Damit die Kapseln in der Größe der Plastikverpackung von Überraschungseiern im Magen bleiben, darf er nur noch Obst und Gemüse essen.“"
                            },
                            {
                                "example_id": "a3dc1e58-5c92-408c-bd14-3840cf630a0d",
                                "sense_id": "2d4077df-9b33-317c-a882-b802153cac55",
                                "text": "„Er biss die Plastikverpackung eines Kondoms auf und rollte es über seine Erektion.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
