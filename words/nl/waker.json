    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6e64bdd5-df95-3e8b-ad16-f06d7ece8f27",
                    "sense_definition": "iemand die waakt of toezicht houdt",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "bewaker",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>waker</w> hield de hele nacht de wacht bij de ingang van het gebouw.",
                            "target_lang_translations": {
                                "ru": "<w>Сторож</w> всю ночь нес вахту у входа в здание."
                            }
                        },
                        {
                            "text": "Als trouwe <w>waker</w> over het erf blafte de hond zodra er iemand aanbelde.",
                            "target_lang_translations": {
                                "ru": "Как верный <w>страж</w> двора, собака лаяла, как только кто-то звонил в дверь."
                            }
                        }
                    ],
                    "synonyms": [
                        "bewaker",
                        "wacht"
                    ],
                    "target_lang_definitions": {
                        "ru": "человек, который бодрствует или осуществляет надзор"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сторож",
                                "target_lang_sense_clarification": "человек, охраняющий объект"
                            },
                            {
                                "target_lang_word": "караульный",
                                "target_lang_sense_clarification": "человек, несущий караул или вахту"
                            },
                            {
                                "target_lang_word": "бдительный страж",
                                "target_lang_sense_clarification": "тот, кто внимательно следит за чем-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aa7107d6-134a-37bb-b4e7-0040de5da540",
                    "sense_definition": "de eerste dijk direct aan de zee",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "dijk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>waker</w> krijgt bij storm direct de volle kracht van de golven te verduren.",
                            "target_lang_translations": {
                                "ru": "<w>Морская дамба</w> во время шторма принимает на себя всю силу волн."
                            }
                        },
                        {
                            "text": "In het systeem van dijken fungeert de <w>waker</w> als de eerste verdedigingslinie tegen het zeewater.",
                            "target_lang_translations": {
                                "ru": "В системе дамб <w>береговая дамба</w> служит первой линией обороны против морской воды."
                            }
                        }
                    ],
                    "common_phrases": [
                        "waker slaper dromer"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "voornamelijk gebruikt in de context van Nederlandse waterbouw"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "первая дамба, расположенная непосредственно у моря"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "морская дамба",
                                "target_lang_sense_clarification": "дамба, принимающая на себя первый удар волн"
                            },
                            {
                                "target_lang_word": "береговая дамба",
                                "target_lang_sense_clarification": "защитное сооружение на первой линии обороны от моря"
                            }
                        ]
                    }
                }
            ]
        }
    ]
