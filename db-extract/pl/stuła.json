                                "target_senses": [
                                    {
                                        "sense_id": "b4ee3759-ebda-3365-bf6e-78e3514864d1",
                                        "entry_id": "6bbc50ff-257b-367e-9b85-dc86970a9354",
                                        "glosses": [
                                            "Kleidungsstück für Frauen, das bodenlang war und über der Tunika getragen wurde"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "fde053d0-a0fd-362f-ac3f-c9289c013004",
                                        "entry_id": "6bbc50ff-257b-367e-9b85-dc86970a9354",
                                        "glosses": [
                                            "Kleidungsstück von Geistlichen, das als Amtsabzeichen getragen wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83f59678-ddee-453f-85ea-04aa452d1583",
                                                "sense_id": "fde053d0-a0fd-362f-ac3f-c9289c013004",
                                                "text": "„Der Exorzist zog im Stehen sein Rituale aus der Tasche sowie die Stola, die er sich umhängte, und schließlich eine Reliquie, die er der Schlafenden auf die Brust legte.“"
                                            },
                                            {
                                                "example_id": "f2d9e4e8-0698-4ae6-9b31-e37fe3662609",
                                                "sense_id": "fde053d0-a0fd-362f-ac3f-c9289c013004",
                                                "text": "„Die Stola wird vom Diakon, Priester und Bischof in verschiedener Weise getragen. Der Diakon legt sie über die linke Schulter und knüpft sie unter dem rechten Arm zusammen. Wenn der Priester mit der Albe angethan ist, wirft er die Stola um den Hals und bindet sie mit dem Cingulum kreuzweise auf der Brust; […]“"
                                            },
                                            {
                                                "example_id": "e09a5743-71a4-4f37-afe3-1fa11e824c3c",
                                                "sense_id": "fde053d0-a0fd-362f-ac3f-c9289c013004",
                                                "text": "„Trommelwirbel ertönte, ein silbernes Kreuz tauchte auf; dann erschienen zwei Leuchter, von Kantoren getragen, sowie der Herr Pfarrer mit Stola, Chorhemd, Chormantel und Barett.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "05d19d6e-48f9-3d98-9960-ea2f9a6937d8",
                                        "entry_id": "6bbc50ff-257b-367e-9b85-dc86970a9354",
                                        "glosses": [
                                            "Kleidungsstück für Frauen, das wie ein Schal um die Schultern getragen wird"
                                        ],
                                        "tags": [
                                            "Mode"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5573b9a1-ec4b-4c3a-9942-60eaead61e4e",
                                                "sense_id": "05d19d6e-48f9-3d98-9960-ea2f9a6937d8",
                                                "text": "„Trotzdem hatten einige Gäste und Patienten wärmere Jacken, Stolen oder Mäntel über die Schultern gelegt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
