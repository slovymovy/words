{
    "word_family": [
        "targetable",
        "targeting",
        "untargeted"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2b25e8ec-0922-3925-9097-b9298f0b0bab",
                    "sense_definition": "A goal or objective that one intends to achieve.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "goal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They have a <w>target</w> to finish the project by November.",
                            "target_lang_translations": {
                                "ru": "У них есть <w>цель</w> завершить проект к ноябрю.",
                                "zh": "他们有一个在十一月前完成项目的<w>目标</w>。"
                            }
                        },
                        {
                            "text": "The company set ambitious growth <w>targets</w> for the next fiscal year.",
                            "target_lang_translations": {
                                "ru": "Компания установила амбициозные <w>цели</w> по росту на следующий финансовый год.",
                                "zh": "公司为下一个财年设定了雄心勃勃的增长<w>指标</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "growth target",
                        "meet a target",
                        "sales target"
                    ],
                    "target_lang_definitions": {
                        "ru": "Цель или задача, которую планируется достичь.",
                        "zh": "想要达到的目标或目的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "цель",
                                "target_lang_sense_clarification": "объект стремления"
                            },
                            {
                                "target_lang_word": "плановый показатель",
                                "target_lang_sense_clarification": "в бизнесе или производстве"
                            },
                            {
                                "target_lang_word": "задача",
                                "target_lang_sense_clarification": "конкретный ориентир"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "目标",
                                "target_lang_sense_clarification": "想要达到的境地或标准"
                            },
                            {
                                "target_lang_word": "指标",
                                "target_lang_sense_clarification": "在商业或生产中设定的量化目标"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "45985bff-280b-3ac1-9579-74db218db4f3",
                    "sense_definition": "A mark or object to shoot at, especially for practice or to test accuracy.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "mark",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Take careful aim at the <w>target</w> before pulling the trigger.",
                            "target_lang_translations": {
                                "ru": "Тщательно прицельтесь в <w>мишень</w>, прежде чем нажать на курок.",
                                "zh": "扣动扳机前，请仔细<w>瞄准</w>靶子。"
                            }
                        },
                        {
                            "text": "The archer hit the center of the <w>target</w> three times in a row.",
                            "target_lang_translations": {
                                "ru": "Лучник попал в центр <w>мишени</w> три раза подряд.",
                                "zh": "射手连续三次击中了<w>靶子</w>的中心。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "moving target",
                        "hit the target",
                        "easy target"
                    ],
                    "target_lang_definitions": {
                        "ru": "Метка или объект, в который стреляют, особенно для практики или проверки точности.",
                        "zh": "射击时瞄准的标记或物体，常用于练习或测试准确度。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мишень",
                                "target_lang_sense_clarification": "специальный объект для стрельбы"
                            },
                            {
                                "target_lang_word": "цель",
                                "target_lang_sense_clarification": "объект поражения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "靶子",
                                "target_lang_sense_clarification": "练习射击用的目标"
                            },
                            {
                                "target_lang_word": "目标",
                                "target_lang_sense_clarification": "被攻击或瞄准的对象"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8393dcbe-61c6-32be-be60-13a300e4af55",
                    "sense_definition": "A person or group of people that an organization intends to reach as customers or audience.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "audience",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The marketing team identified young professionals as their primary <w>target</w>.",
                            "target_lang_translations": {
                                "ru": "Отдел маркетинга определил молодых специалистов как свою основную <w>целевую аудиторию</w>.",
                                "zh": "营销团队将年轻专业人士确定为他们的主要<w>目标受众</w>。"
                            }
                        },
                        {
                            "text": "The new product is a <w>target</w> for tech-savvy consumers.",
                            "target_lang_translations": {
                                "ru": "Новый продукт <w>ориентирован</w> на технически подкованных потребителей.",
                                "zh": "这款新产品是<w>面向</w>精通技术的消费者的。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "target audience",
                        "target market",
                        "primary target"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек или группа людей, на которых организация ориентирует свои товары или контент.",
                        "zh": "组织意图接触的客户或受众群体。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "целевая аудитория",
                                "target_lang_sense_clarification": "в маркетинге"
                            },
                            {
                                "target_lang_word": "целевая группа",
                                "target_lang_sense_clarification": "объект воздействия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "目标受众",
                                "target_lang_sense_clarification": "营销中针对的群体"
                            },
                            {
                                "target_lang_word": "目标市场",
                                "target_lang_sense_clarification": "企业瞄准的消费群体"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c15e4b8c-9a60-372f-91a1-402c8bb5fc44",
                    "sense_definition": "A person, place, or thing that is frequently attacked, criticized, or ridiculed.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "victim",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The politician became a <w>target</w> of criticism after the scandal broke.",
                            "target_lang_translations": {
                                "ru": "Политик стал <w>мишенью</w> для критики после того, как разразился скандал.",
                                "zh": "丑闻爆发后，这位政治家成了批评的<w>靶子</w>。"
                            }
                        },
                        {
                            "text": "He was an easy <w>target</w> for the bullies at school.",
                            "target_lang_translations": {
                                "ru": "Он был легкой <w>мишенью</w> для школьных хулиганов.",
                                "zh": "在学校里，他很容易成为霸凌者的<w>目标</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "easy target",
                        "legitimate target"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, место или вещь, которые часто подвергаются нападениям, критике или насмешкам.",
                        "zh": "经常受到攻击、批评或嘲笑的人、地点或事物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мишень",
                                "target_lang_sense_clarification": "для критики или насмешек"
                            },
                            {
                                "target_lang_word": "объект",
                                "target_lang_sense_clarification": "для нападок"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "靶子",
                                "target_lang_sense_clarification": "比喻容易受攻击的对象"
                            },
                            {
                                "target_lang_word": "对象",
                                "target_lang_sense_clarification": "被针对的人或事物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "957f1005-e9ba-3060-8c83-576723314baf",
                    "sense_definition": "The language into which a document is being translated.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "linguistics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Do you charge by the source or the <w>target</w> language?",
                            "target_lang_translations": {
                                "ru": "Вы берете оплату за исходный язык или за <w>целевой</w>?",
                                "zh": "你是按源语言还是按<w>目标语言</w>收费？"
                            }
                        },
                        {
                            "text": "The translator must be a native speaker of the <w>target</w> language.",
                            "target_lang_translations": {
                                "ru": "Переводчик должен быть носителем <w>языка перевода</w>.",
                                "zh": "译者必须是<w>目标语言</w>的母语使用者。"
                            }
                        }
                    ],
                    "synonyms": [
                        "target language"
                    ],
                    "target_lang_definitions": {
                        "ru": "Язык, на который переводится документ.",
                        "zh": "文档被翻译成的语言。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "целевой язык",
                                "target_lang_sense_clarification": "язык перевода"
                            },
                            {
                                "target_lang_word": "язык перевода",
                                "target_lang_sense_clarification": "лингвистический термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "目标语言",
                                "target_lang_sense_clarification": "翻译的目的语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a63c3a02-7e3a-3117-a1ba-840f8a1b20b1",
                    "sense_definition": "A kind of small shield or buckler used as a defensive weapon.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "shield",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The warrior carried a small <w>target</w> on his left arm for protection.",
                            "target_lang_translations": {
                                "ru": "Воин нес на левой руке небольшой <w>щит</w> для защиты.",
                                "zh": "战士左臂上带着一面小<w>圆盾</w>用于防御。"
                            }
                        },
                        {
                            "text": "He took all their seven points in his <w>target</w> during the duel.",
                            "target_lang_translations": {
                                "ru": "Во время дуэли он принял все семь ударов на свой <w>щит</w>.",
                                "zh": "决斗中，他用<w>圆盾</w>挡下了对方所有的七次攻击。"
                            }
                        }
                    ],
                    "synonyms": [
                        "targe"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historical defensive weapon"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вид небольшого щита, используемого как оборонительное оружие.",
                        "zh": "一种用作防御武器的小型盾牌。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тарч",
                                "target_lang_sense_clarification": "исторический малый щит"
                            },
                            {
                                "target_lang_word": "баклер",
                                "target_lang_sense_clarification": "кулачный щит"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "圆盾",
                                "target_lang_sense_clarification": "历史上的小型防御盾牌"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "810d54ba-9b60-3c56-8680-b1c8b1d77c8a",
                    "sense_definition": "To direct an action, advertising, or information toward a specific group of people.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "directing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The advertising campaign <w>targeted</w> older women with its new skincare line.",
                            "target_lang_translations": {
                                "ru": "Рекламная кампания была <w>ориентирована</w> на пожилых женщин с новой линией средств по уходу за кожей.",
                                "zh": "该广告活动<w>针对</w>年长女性推广其新的护肤系列。"
                            }
                        },
                        {
                            "text": "We need to <w>target</w> young voters through social media platforms.",
                            "target_lang_translations": {
                                "ru": "Нам нужно <w>нацелиться</w> на молодых избирателей через социальные сети.",
                                "zh": "我们需要通过社交媒体平台<w>瞄准</w>年轻选民。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "target an audience",
                        "specifically target"
                    ],
                    "target_lang_definitions": {
                        "ru": "Направлять действие, рекламу или информацию на определенную группу людей.",
                        "zh": "将行动、广告或信息指向特定的群体。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ориентировать",
                                "target_lang_sense_clarification": "на определенную группу"
                            },
                            {
                                "target_lang_word": "таргетировать",
                                "target_lang_sense_clarification": "в рекламе"
                            },
                            {
                                "target_lang_word": "нацеливать",
                                "target_lang_sense_clarification": "на аудиторию"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "针对",
                                "target_lang_sense_clarification": "指向特定对象"
                            },
                            {
                                "target_lang_word": "瞄准",
                                "target_lang_sense_clarification": "将目标锁定在某群体上"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d5ba0d69-9f90-35bd-8c5d-12f4474d1de1",
                    "sense_definition": "To aim a weapon or an attack at a specific mark or location.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "aiming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The missile was <w>targeted</w> at the enemy's command center.",
                            "target_lang_translations": {
                                "ru": "Ракета была <w>направлена</w> на командный центр противника.",
                                "zh": "导弹被<w>瞄准</w>了敌人的指挥中心。"
                            }
                        },
                        {
                            "text": "The hunter <w>targeted</w> the deer from a distance.",
                            "target_lang_translations": {
                                "ru": "Охотник <w>выцелил</w> оленя издалека.",
                                "zh": "猎人在远处<w>瞄准</w>了那头鹿。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "target a location"
                    ],
                    "target_lang_definitions": {
                        "ru": "Наводить оружие или атаку на конкретную метку или местоположение.",
                        "zh": "将武器或攻击对准特定的标记或位置。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нацеливать",
                                "target_lang_sense_clarification": "оружие"
                            },
                            {
                                "target_lang_word": "направлять",
                                "target_lang_sense_clarification": "удар или атаку"
                            },
                            {
                                "target_lang_word": "целиться",
                                "target_lang_sense_clarification": "в объект"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "瞄准",
                                "target_lang_sense_clarification": "对准目标"
                            },
                            {
                                "target_lang_word": "对准",
                                "target_lang_sense_clarification": "将攻击指向某处"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d71b5c60-26b2-3b3c-a84b-8f3a7d30e1ad",
                    "sense_definition": "To design or produce computer code suitable for a specific processor or platform.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This cross-platform compiler can <w>target</w> any of several processors.",
                            "target_lang_translations": {
                                "ru": "Этот кроссплатформенный компилятор может быть <w>ориентирован</w> на любой из нескольких процессоров.",
                                "zh": "这个跨平台编译器可以<w>面向</w>多种处理器中的任何一种。"
                            }
                        },
                        {
                            "text": "The developers are <w>targeting</w> the latest mobile operating systems.",
                            "target_lang_translations": {
                                "ru": "Разработчики <w>ориентируются</w> на последние мобильные операционные системы.",
                                "zh": "开发人员正在<w>面向</w>最新的移动操作系统进行开发。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "target a platform"
                    ],
                    "target_lang_definitions": {
                        "ru": "Разрабатывать или создавать компьютерный код, подходящий для конкретного процессора или платформы.",
                        "zh": "设计或生产适用于特定处理器或平台的计算机代码。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ориентировать",
                                "target_lang_sense_clarification": "на платформу"
                            },
                            {
                                "target_lang_word": "предназначать",
                                "target_lang_sense_clarification": "для конкретной системы"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "面向",
                                "target_lang_sense_clarification": "针对特定平台开发"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}