                {
                    "sense_id": "f0a2bfcd-43c8-3fff-b854-27ab7ec6b2e6",
                    "sense_definition": "A freshwater fish of the family Cyprinidae, found across northern Europe and Asia.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "fish",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>ide</w> is a popular fish for garden ponds due to its active nature.",
                            "target_lang_translations": {
                                "pl": "<w>Jaź</w> jest popularną rybą do oczek wodnych ze względu na swoją aktywną naturę."
                            }
                        },
                        {
                            "text": "Anglers often catch the <w>ide</w> in slow-moving rivers throughout northern Europe.",
                            "target_lang_translations": {
                                "pl": "Wędkarze często łowią <w>jazia</w> w wolno płynących rzekach w całej północnej Europie."
                            }
                        }
                    ],
                    "synonyms": [
                        "orfe",
                        "silver orfe"
                    ],
                    "target_lang_definitions": {
                        "pl": "Słodkowodna ryba z rodziny karpiowatych, występująca w Europie i Azji."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "jaź",
                                "target_lang_sense_clarification": "gatunek ryby"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4a39c356-ce1b-38bc-a90c-003beffce23d",
                    "sense_definition": "A software application that provides comprehensive facilities to computer programmers for software development.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "technology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Modern <w>IDEs</w> include features like code completion and debugging tools.",
                            "target_lang_translations": {
                                "pl": "Nowoczesne <w>środowiska IDE</w> zawierają funkcje takie jak uzupełnianie kodu i narzędzia do debugowania."
                            }
                        },
                        {
                            "text": "Most professional developers prefer using a powerful <w>IDE</w> for large projects.",
                            "target_lang_translations": {
                                "pl": "Większość profesjonalnych programistów woli używać potężnego <w>IDE</w> do dużych projektów."
                            }
                        }
                    ],
                    "common_phrases": [
                        "use an IDE",
                        "popular IDE"
                    ],
                    "target_lang_definitions": {
                        "pl": "Zintegrowane środowisko programistyczne; oprogramowanie wspomagające tworzenie kodu."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "IDE",
                                "target_lang_sense_clarification": "zintegrowane środowisko programistyczne"
                            },
                            {
                                "target_lang_word": "środowisko programistyczne",
                                "target_lang_sense_clarification": "pełna nazwa polska"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0a9f72e9-ef24-3d53-a252-7ca5ccf0505a",
                    "sense_definition": "A standard interface for connecting storage devices like hard drives to a computer's motherboard.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "technology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Older computers often relied on <w>IDE</w> cables to connect internal hard drives.",
                            "target_lang_translations": {
                                "pl": "Starsze komputery często polegały na kablach <w>IDE</w> do podłączania wewnętrznych dysków twardych."
                            }
                        },
                        {
                            "text": "The <w>IDE</w> interface has largely been replaced by faster SATA technology.",
                            "target_lang_translations": {
                                "pl": "Interfejs <w>IDE</w> został w dużej mierze zastąpiony szybszą technologią SATA."
                            }
                        }
                    ],
                    "common_phrases": [
                        "IDE cable",
                        "IDE drive"
                    ],
                    "target_lang_definitions": {
                        "pl": "Standardowy interfejs służący do podłączania urządzeń pamięci masowej, takich jak dyski twarde, do płyty głównej komputera."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "IDE",
                                "target_lang_sense_clarification": "standard złącza dysków twardych"
                            },
                            {
                                "target_lang_word": "ATA",
                                "target_lang_sense_clarification": "synonim techniczny"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "66d696de-b769-3162-b594-cd9f1fbf8644",
                    "sense_definition": "An enzyme that breaks down insulin in the body.",
