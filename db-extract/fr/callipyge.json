                    {
                        "sense_id": "854f62fd-4d0f-39a4-be4d-a4fb87230c1d",
                        "entry_id": "b72ebe2c-dccb-3f3f-abbf-07308510e6db",
                        "glosses": [
                            "kallipygisch, met een mooi achterste"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f39fd53c-0da6-4f7d-8e14-635b5e6c3ddd",
                                "sense_id": "854f62fd-4d0f-39a4-be4d-a4fb87230c1d",
                                "text": "La Vénus callipyge est une célèbre statue.",
                                "translation": "De kallipygische Venus is een beroemd standbeeld."
                            },
                            {
                                "example_id": "b7aebea8-c289-444e-aaac-c6016a8aa243",
                                "sense_id": "854f62fd-4d0f-39a4-be4d-a4fb87230c1d",
                                "text": "Passait un’ bell’ gretchen au carrefour du château,\nEntre la rue Didot et la rue de Vanves,\nCallipyge à prétendre\nJouer les Vénus chez les Hottentots,\nEntre la rue de Vanv’s et la rue Didot.",
                                "translation": "Er passeerde een mooi Grietje op het kruispunt van het kasteel,\nTussen de rue Didot en de rue de Vanves,\nzo kallipygisch dat ze kon eisen\nVenus te spelen bij de Hottentotten,\nTussen de rue de Vanves en de rue Didot."
                            }
                        ]
                    }
                ],
