                "senses": [
                    {
                        "sense_id": "fff9adc4-646b-3bc3-8468-39dff84bee39",
                        "entry_id": "2ae09f3e-9175-3b21-ad40-8e2bbccf7554",
                        "glosses": [
                            "Recht, ein Veto einlegen zu können"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d2525c81-185e-4ec4-9fbc-8c8f66917e8c",
                                "sense_id": "fff9adc4-646b-3bc3-8468-39dff84bee39",
                                "text": "„Ohne nationales Vetorecht tauge der ganze Kompromiss nichts.“"
                            },
                            {
                                "example_id": "b052353c-dabe-41e4-9261-82e95e5ba886",
                                "sense_id": "fff9adc4-646b-3bc3-8468-39dff84bee39",
                                "text": "„Da China im Weltsicherheitsrat ein Vetorecht habe, müsse es das Vorhaben unterstützen oder zumindest tolerieren.“"
                            },
                            {
                                "example_id": "fb427600-c4a9-40f3-9583-09ede91fd704",
                                "sense_id": "fff9adc4-646b-3bc3-8468-39dff84bee39",
                                "text": "„In bestimmten Fragen hatten die Mitgliedstaaten das Vetorecht, und sie machten davon auch rege Gebrauch.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
