                        "regard ténébreux"
                    ]
                },
                {
                    "sense_id": "983ec6fa-b96f-359f-9ac5-91ffc876c0df",
                    "sense_definition": "Relatif aux enfers ou au royaume souterrain des morts dans la mythologie antique.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mythologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le poète évoque le destin des âmes égarées sur les rives du fleuve <w>ténébreux</w>."
                        },
                        {
                            "text": "Dans les récits antiques, les divinités infernales règnent sur un empire <w>ténébreux</w>."
                        }
                    ],
                    "synonyms": [
                        "infernal",
                        "stygien"
                    ],
                    "common_phrases": [
                        "empire ténébreux"
