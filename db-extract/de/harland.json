                "senses": [
                    {
                        "sense_id": "bd141c8b-3e84-3dae-ab0a-c045b9745c2b",
                        "entry_id": "5ac0cc5d-f559-319d-9e2f-7e70c563e62a",
                        "glosses": [
                            "Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0fcc0464-54fa-42af-b909-3ee744c2e4ef",
                                "sense_id": "bd141c8b-3e84-3dae-ab0a-c045b9745c2b",
                                "text": "Frau Harland ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "8fec1da1-236d-4284-84ca-c338b135be9b",
                                "sense_id": "bd141c8b-3e84-3dae-ab0a-c045b9745c2b",
                                "text": "Herr Harland wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "2d394675-3408-4aef-b128-91d7ce3a1e1f",
                                "sense_id": "bd141c8b-3e84-3dae-ab0a-c045b9745c2b",
                                "text": "Die Harlands kommen heute aus dem Harzvorland."
                            },
                            {
                                "example_id": "bdddf00d-f799-46b1-a7d3-87e5a3445dc4",
                                "sense_id": "bd141c8b-3e84-3dae-ab0a-c045b9745c2b",
                                "text": "Der Harland trägt nie die Schals, die die Harland ihm strickt."
                            },
                            {
                                "example_id": "8a287567-31ac-4ac0-8556-b0e68f3eb8d6",
                                "sense_id": "bd141c8b-3e84-3dae-ab0a-c045b9745c2b",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Harland kommt, geht der Herr Harland.“"
                            },
                            {
                                "example_id": "545a8923-3367-4def-92ce-8437ef4fdbaf",
                                "sense_id": "bd141c8b-3e84-3dae-ab0a-c045b9745c2b",
                                "text": "Harland kommt und geht."
                            },
                            {
                                "example_id": "57404f82-d458-4407-adc6-8642aac34e97",
                                "sense_id": "bd141c8b-3e84-3dae-ab0a-c045b9745c2b",
                                "text": "Harlands kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
