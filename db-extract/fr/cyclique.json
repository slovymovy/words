                                                "sense_id": "adbec6f3-737d-3854-a1dc-c139ca97da75",
                                                "text": "Die Aromaten sind ein Spezialfall zyklischer Verbindungen."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
