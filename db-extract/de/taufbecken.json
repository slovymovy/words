                                            "informal"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "04c18972-6d4a-3717-be3b-a7d79112a076",
                                        "entry_id": "2e570959-ddc8-354d-83da-7f5ed87d1805",
                                        "glosses": [
                                            "A computer file containing the code used to draw and compose the glyphs of one or more typographic fonts on a computer display or printer."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4be76a23-3be0-48f4-be04-bda4704afe3a",
                                                "sense_id": "04c18972-6d4a-3717-be3b-a7d79112a076",
                                                "text": "They bought a license for the Gulliver font and installed that font on several machines."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ade4c8c5-c7a8-3b65-a803-19378c2da828",
                                        "entry_id": "2e570959-ddc8-354d-83da-7f5ed87d1805",
                                        "glosses": [
                                            "The design of any text."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dacf32d1-f9ec-4d94-a8c3-c5da7f4679da",
                                                "sense_id": "ade4c8c5-c7a8-3b65-a803-19378c2da828",
                                                "text": "I like the font of this logo."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "font",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b7376c11-08ac-379b-bf7c-770e7a355ab4",
                                        "entry_id": "676ca778-699b-36ad-bde6-e9c8868b675f",
                                        "glosses": [
                                            "To overlay (text) on the picture."
                                        ],
                                        "tags": [
                                            "informal",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "863648b3-03c4-4d43-b77f-2d7697ee36a3",
                                                "sense_id": "b7376c11-08ac-379b-bf7c-770e7a355ab4",
                                                "text": "When figures or quotes are thought helpful to understanding a spot, they're \"fonted\" over the cover picture."
                                            },
                                            {
                                                "example_id": "a29c040e-322e-48c7-bdbc-6de9b209c1f9",
                                                "sense_id": "b7376c11-08ac-379b-bf7c-770e7a355ab4",
                                                "text": "[…] character generator instead of an easel card to create letters on camera or telephone numbers that can run across the TV screen. The process is called fonting."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d60da489-e0f7-4bfc-a23d-40c8c6dde2ab",
                        "source_entry_id": "3d24b8aa-b69c-3017-8b73-1ba2a654efe6",
                        "source_sense_id": "5fa14986-4495-3761-9de6-22a5cf607b64",
                        "source_sense_description": "Behältnis, das in christlichen Kirchen der Taufe dient und mit geweihtem Wasser gefüllt ist",
                        "target_lang_word": "fonts baptismaux",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fonts baptismaux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5e4f0770-6061-327a-b57f-b8c0ece8743f",
                                        "entry_id": "7739439b-7803-3560-91e7-c819fe0f5491",
                                        "glosses": [
                                            "Grand vaisseau de pierre, de marbre ou de bronze, où l’on conserve l’eau dont on se sert pour baptiser."
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "54d393d3-c171-4efc-9b93-da0d4155639d",
                                                "sense_id": "5e4f0770-6061-327a-b57f-b8c0ece8743f",
                                                "text": "Ces fonts baptismaux étaient faits d’une espèce de marbre rouge, marqueté de plusieurs veines de diverses couleurs; ce marbre avait été tiré d'une marbrière située au-dessus de Maxainville, […]."
                                            },
                                            {
                                                "example_id": "8a62b576-aca8-4a8c-9223-e22df8795c76",
                                                "sense_id": "5e4f0770-6061-327a-b57f-b8c0ece8743f",
                                                "text": "À Clermont, où il y avait une forte population juive, il fallut à l’évêque Avitus des années d’efforts pour arriver à conduire un juif sur les fonts baptismaux (576)."
                                            },
                                            {
                                                "example_id": "76426afd-1403-4864-bb83-b1e0b08733ec",
                                                "sense_id": "5e4f0770-6061-327a-b57f-b8c0ece8743f",
