                "entry_id": "f0a502a6-c0a8-360b-ae48-cf6a38cc1f4f",
                "word": "cochonceté",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "e5758ba2-316d-4076-9b38-9a1953feb16c",
                        "entry_id": "f0a502a6-c0a8-360b-ae48-cf6a38cc1f4f",
                        "tags": [
                            "plural"
                        ],
                        "form": "cochoncetés"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f920c7e4-6ced-3ee7-8831-f4e7356a2066",
                        "entry_id": "f0a502a6-c0a8-360b-ae48-cf6a38cc1f4f",
                        "glosses": [
                            "Paillardise, obscénité, grivoiserie, gaudriole, pornographie."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "e443b7a6-2122-4015-a597-6ca7902b1af0",
                                "sense_id": "f920c7e4-6ced-3ee7-8831-f4e7356a2066",
                                "text": "Bien sûr, il n’y pige rien et comme il croit, dur comme fer, qu’on lui débite des cochoncetés, il voudrait bien saisir."
                            },
                            {
                                "example_id": "85b83359-7176-47fa-9b48-90c6d1fa93de",
                                "sense_id": "f920c7e4-6ced-3ee7-8831-f4e7356a2066",
                                "text": "Tout occupé à façonner un décret qui lui permît de parquer les amateurs de cochoncetés dans des salles sans aération, le secrétaire d’État à la Culture, qui avait beaucoup pleuré sur la dépouille de Joséphine Baker puis sur celle de Jacques Charron, ou inversement, n’eut pas une larme pour le voyageur aux bagages de brumes."
                            },
                            {
                                "example_id": "74c81bbe-f1c7-4467-b87d-2e90ab2719a4",
                                "sense_id": "f920c7e4-6ced-3ee7-8831-f4e7356a2066",
                                "text": "Juliette a relevé l’expression, s’est étonnée de cette cochonceté qui tombait un peu hors de son cadre, et a proposé que, cochonceté pour cochonceté, nous n’avions qu’à faire un défi « zizi », consistant à faire une page utilisant ce mot."
                            }
                        ]
                    },
                    {
                        "sense_id": "34a28b86-fbed-3b29-a38f-3fd43c6a2e39",
                        "entry_id": "f0a502a6-c0a8-360b-ae48-cf6a38cc1f4f",
                        "glosses": [
                            "Cochonnerie, saloperie."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "ca658735-be21-430b-bc6c-86a5e6246aa1",
                                "sense_id": "34a28b86-fbed-3b29-a38f-3fd43c6a2e39",
                                "text": "Les phtalates, c’est des cochoncetés !"
                            },
                            {
                                "example_id": "826eafd6-9e25-4e26-8d44-34dbdbcd1890",
                                "sense_id": "34a28b86-fbed-3b29-a38f-3fd43c6a2e39",
                                "text": "Je refuse de collusionner avec les puissances occultes des majeures sur cette cochonceté sans nom qui vise à esclavagiser le consommateur !"
                            }
                        ]
                    }
