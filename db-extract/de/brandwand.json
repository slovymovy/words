                "senses": [
                    {
                        "sense_id": "1a59ba65-8713-3265-90c3-820d52fd504b",
                        "entry_id": "82a86223-1681-358c-b641-cb64dc425ebf",
                        "glosses": [
                            "Wand als bauliche Maßnahme, um das Übergreifen von Bränden zu verhindern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7cbd401c-46ca-49fa-8371-2275b940ea7c",
                                "sense_id": "1a59ba65-8713-3265-90c3-820d52fd504b",
                                "text": "„Eine Brandwand ist generell bei Gebäuden erforderlich, die näher als 2,5 m zur Nachbargrenze errichtet werden.“"
                            },
                            {
                                "example_id": "01369a4a-1e6c-40a8-a41d-66f746fd859d",
                                "sense_id": "1a59ba65-8713-3265-90c3-820d52fd504b",
                                "text": "„Ein Brandabschnitt ist der Bereich eines Gebäudes zwischen seinen Außenwänden und/oder den Wänden bzw. Decken, die als Brandwände über alle Geschosse ausgebildet sind.“"
                            },
                            {
                                "example_id": "067c6515-5c0a-4eee-9de8-90f00d626d7d",
                                "sense_id": "1a59ba65-8713-3265-90c3-820d52fd504b",
                                "text": "„Brandwände müssen feuerbeständig und so beschaffen sein, daß sie bei einem Brand ihre Standsicherheit nicht verlieren und die Ausbreitung von Feuer auf andere Gebäude oder Gebäudeabschnitte verhindern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
