    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9a639250-cfd7-3e31-99f6-5bfc1760a1d0",
                    "sense_definition": "A person who exercises with weights to build physical strength or fitness.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "fitness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Every morning, the gym is filled with dedicated <w>weightlifters</w> training hard.",
                            "target_lang_translations": {
                                "ru": "Каждое утро тренажёрный зал заполнен преданными своему делу <w>тяжелоатлетами</w>, усердно тренирующимися."
                            }
                        },
                        {
                            "text": "As an experienced <w>weightlifter</w>, she knows the importance of proper form to avoid injury.",
                            "target_lang_translations": {
                                "ru": "Как опытная <w>спортсменка-тяжелоатлетка</w>, она знает, насколько важна правильная техника во избежание травм."
                            }
                        }
                    ],
                    "common_phrases": [
                        "experienced weightlifter"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, занимающийся силовыми тренировками с отягощениями для развития силы или поддержания физической формы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "штангист",
                                "target_lang_sense_clarification": "человек, тренирующийся со штангой"
                            },
                            {
                                "target_lang_word": "силовик",
                                "target_lang_sense_clarification": "любитель силовых тренировок"
                            },
                            {
                                "target_lang_word": "тяжелоатлет",
                                "target_lang_sense_clarification": "человек, занимающийся упражнениями с отягощениями"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c1d16fbb-d8fe-3555-8261-d44ca259b9bc",
                    "sense_definition": "An athlete who competes in the sport of lifting heavy weights.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "sports",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The Olympic <w>weightlifter</w> broke the world record during the final event.",
                            "target_lang_translations": {
                                "ru": "Олимпийский <w>тяжелоатлет</w> побил мировой рекорд в финальном состязании."
                            }
                        },
                        {
                            "text": "Each <w>weightlifter</w> gets three attempts to lift the heaviest barbell possible.",
                            "target_lang_translations": {
                                "ru": "Каждому <w>штангисту</w> даётся три попытки поднять максимально возможный вес."
                            }
                        }
                    ],
                    "common_phrases": [
                        "Olympic weightlifter"
                    ],
                    "target_lang_definitions": {
                        "ru": "Спортсмен, профессионально выступающий на соревнованиях по тяжёлой атлетике."
                    },
