                                "sense_id": "3d3af202-af9b-3ffa-982a-2d1ad7285889",
                                "text": "Il était clair que je n'avais pas le droit de répondre par la négative."
                            },
                            {
                                "example_id": "fe6034c7-8f98-4ce3-b0cd-7fcdb6d2cf46",
                                "sense_id": "3d3af202-af9b-3ffa-982a-2d1ad7285889",
                                "text": "Trois fois qu’elle pose sa main en couvercle sur son verre, ongles faits, ombré rose nickel, à plat, sans trembler, mix de grâce et de fermeté, esquissant du menton la négative."
                            },
                            {
                                "example_id": "3c0a9b6d-d18d-4045-a8a4-7b1103d2d950",
                                "sense_id": "3d3af202-af9b-3ffa-982a-2d1ad7285889",
                                "text": "Demeurer, persister dans la négative, se tenir sur la négative."
                            }
                        ]
                    }
