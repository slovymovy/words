                                            {
                                                "example_id": "d58c82a0-fe8a-421b-8f4d-321e04a75ea9",
                                                "sense_id": "d4f284e4-7e6a-3ae8-ab27-1f32be235f98",
                                                "text": "Haal de vanillestok er uit en schraap het merg er uit. Doe dit schraapsel terug in de pan en roer door. Dek af met plasticfolie en laat afkoelen en stijf worden in de koelkast."
                                            },
                                            {
                                                "example_id": "c68f9cde-ce87-490f-9b45-20f972d259c8",
                                                "sense_id": "d4f284e4-7e6a-3ae8-ab27-1f32be235f98",
                                                "text": "Een deel van haar gouden medaille, een schraapsel ervan omgevormd tot ring, draagt ze sinds kort altijd bij zich. \"Ik ben er nog elke dag blij mee, dit is het beste wat ik ermee kon doen.\""
                                            }
