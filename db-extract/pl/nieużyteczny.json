                "senses": [
                    {
                        "sense_id": "4dc6648f-2654-3417-b3e1-c92f8b02e933",
                        "entry_id": "7a8977b5-9fa8-3a51-9c16-a3820c38d5d8",
                        "glosses": [
                            "nie przynoszący pożytku lub nie nadający się do użytku"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "8e42381c-c891-30d0-be07-cf4d93cfc905",
                        "entry_id": "7a8977b5-9fa8-3a51-9c16-a3820c38d5d8",
                        "glosses": [
                            "nie pomagający komuś w czymś"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9bf6f0a1-ddec-4002-b493-7d0044b2a525",
                                "sense_id": "8e42381c-c891-30d0-be07-cf4d93cfc905",
                                "text": "Siedział poza biurkiem ze swymi nieużytecznymi kikutami nóg i patrzył na nas przezroczystymi oczyma."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7a61bd2d-bbbd-4762-8ee5-3aa71caa02dc",
                        "source_entry_id": "7a8977b5-9fa8-3a51-9c16-a3820c38d5d8",
                        "source_sense_id": "4dc6648f-2654-3417-b3e1-c92f8b02e933",
                        "target_lang_word": "useless",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "useless",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fb968a3f-9046-34ab-a283-552782a5aacf",
                                        "entry_id": "ad1dff2c-f28d-30a2-97d5-1f36c9957ee2",
                                        "glosses": [
                                            "Without use or possibility to be used."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d175fa6f-2a60-45fc-a2e8-111de79cbdaa",
                                                "sense_id": "fb968a3f-9046-34ab-a283-552782a5aacf",
                                                "text": "This fork's prongs are bent. It's useless now."
                                            },
                                            {
                                                "example_id": "a4286ea4-9aa2-4365-8c8a-bc30181c9c71",
                                                "sense_id": "fb968a3f-9046-34ab-a283-552782a5aacf",
                                                "text": "I'm all for opening new stations (Transport Scotland is planning another at East Linton, about halfway between Drem and Dunbar), but they are useless without a decent service."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a515abfd-0099-3a3b-a5a9-1c3684c8c0d3",
                                        "entry_id": "ad1dff2c-f28d-30a2-97d5-1f36c9957ee2",
                                        "glosses": [
                                            "Unhelpful, not useful; pointless (of an action)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f20054cb-dfff-4314-a444-ed39adc34f8c",
                                                "sense_id": "a515abfd-0099-3a3b-a5a9-1c3684c8c0d3",
                                                "text": "I think it's useless to keep this discussion going. It's like talking to a brick wall."
                                            },
                                            {
                                                "example_id": "4c91d144-b3f0-4d4b-9751-fd698afdb7c4",
                                                "sense_id": "a515abfd-0099-3a3b-a5a9-1c3684c8c0d3",
                                                "text": "I tried my best to make him quit smoking, but my efforts were useless. He now smokes six packs a day."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "45a58518-0798-312f-9a82-5601ff931b9c",
                                        "entry_id": "ad1dff2c-f28d-30a2-97d5-1f36c9957ee2",
                                        "glosses": [
                                            "Good-for-nothing; not dependable."
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b5e7ffd5-78c9-4edf-8e3d-b659f4630d37",
                                                "sense_id": "45a58518-0798-312f-9a82-5601ff931b9c",
                                                "text": "Bill never mows the lawn, takes out the trash or anything. He's useless, but I love him anyways."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "604ec8ea-7fe2-36f4-a0a8-982a244e3e7c",
                                        "entry_id": "ad1dff2c-f28d-30a2-97d5-1f36c9957ee2",
                                        "glosses": [
                                            "Unable to do well at a particular task or thing. Useless is mildly insulting."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dd42613c-721a-4d51-8927-6d02a9d9ff19",
                                                "sense_id": "604ec8ea-7fe2-36f4-a0a8-982a244e3e7c",
                                                "text": "My brother is useless at most computer games, but he is an awesome PS2 player."
                                            },
                                            {
                                                "example_id": "4c07a921-0837-4a35-adbf-28318b15deba",
                                                "sense_id": "604ec8ea-7fe2-36f4-a0a8-982a244e3e7c",
                                                "text": "Why do you keep trying? You're obviously useless at it."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
