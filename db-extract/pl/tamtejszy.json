                "senses": [
                    {
                        "sense_id": "4aefaa68-e621-30c3-9d06-48c8fd6a9487",
                        "entry_id": "64cf2b95-2137-36e6-8fca-c9c97068f123",
                        "glosses": [
                            "znajdujący się we wcześniej wspomnianym miejscu (w którym rozmówcy się nie znajdują)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed28a073-fccd-4d4a-bb13-1e360791a1cc",
                                "sense_id": "4aefaa68-e621-30c3-9d06-48c8fd6a9487",
                                "text": "Kiedy jesteś w Wiedniu, musisz odwiedzić tamtejsze muzeum sztuki."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "79a5e51a-1ac3-3241-8460-02f5e1be67ab",
                        "entry_id": "64cf2b95-2137-36e6-8fca-c9c97068f123",
                        "glosses": [
                            "dotyczący wcześniej wspomnianego miejsca (w którym rozmówcy się nie znajdują)"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3afd35e0-aafb-4d04-8aa6-d51f0714c5d6",
                        "source_entry_id": "64cf2b95-2137-36e6-8fca-c9c97068f123",
                        "source_sense_id": "4aefaa68-e621-30c3-9d06-48c8fd6a9487",
                        "target_lang_word": "тамошний",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "тамошний",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "14045177-2ea1-361d-b52f-6b7700627a65",
                                        "entry_id": "d7e4b1b2-f162-3d39-a9d6-c7194a2bc707",
                                        "glosses": [
                                            "разг. находящийся, имеющийся там, в том месте, той местности (о которых говорится)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4eb7b3be-fb8b-4a15-bbf2-032f41b00012",
                                                "sense_id": "14045177-2ea1-361d-b52f-6b7700627a65",
                                                "text": "Тамошние обычаи совершенно чужды культуре нашей страны."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "762cf31a-78e5-351e-916a-218258c9f57d",
                                        "entry_id": "d7e4b1b2-f162-3d39-a9d6-c7194a2bc707",
                                        "glosses": [
                                            "разг. живущий там, занимающийся чем-либо в тех местах, происходящий оттуда, из тех мест"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "201c8bcb-ad63-4629-8aab-fef984ccc57f",
                                                "sense_id": "762cf31a-78e5-351e-916a-218258c9f57d",
                                                "text": "В городе N произошло некоторое оживление: тамошний мэр объявил конкурс на самый чистый двор."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "99d8dded-2761-42fe-a5c0-e2456fe9faf9",
                        "source_entry_id": "64cf2b95-2137-36e6-8fca-c9c97068f123",
                        "target_lang_word": "dortig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dortig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7c5288b0-a8d4-345e-b69b-45f77a864293",
                                        "entry_id": "2b9c6aa3-e90c-3047-b456-a5294fdce8b6",
                                        "glosses": [
                                            "an entfernter Stelle befindlich, vorhanden oder stattfindend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1d35fc9-e789-4893-88e5-ec8fafcd4505",
                                                "sense_id": "7c5288b0-a8d4-345e-b69b-45f77a864293",
                                                "text": "So betont er, dass die indische Schmuckindustrie negative Folgen des Goldpreisanstiegs für die dortige Schmucknachfrage befürchte."
                                            },
                                            {
                                                "example_id": "6149599c-3f32-412e-bab9-4367d4bf2bee",
                                                "sense_id": "7c5288b0-a8d4-345e-b69b-45f77a864293",
                                                "text": "Wer also vor dem Rückflug aus Los Angeles am dortigen Flughafen eine Flasche kalifornischen Rotweins gekauft hat, muss diesen in den USA zurücklassen."
                                            },
                                            {
                                                "example_id": "a38d8efe-4206-4611-bb66-7cec198f987d",
                                                "sense_id": "7c5288b0-a8d4-345e-b69b-45f77a864293",
                                                "text": "Der Bruder des Stars der dortigen Politik besitzt 4000 Hektar Land."
                                            },
                                            {
                                                "example_id": "a65a3fa6-467e-4a1c-a0f3-4fa9ca085ac0",
                                                "sense_id": "7c5288b0-a8d4-345e-b69b-45f77a864293",
                                                "text": "Aus Afghanistan war der dortige Oberbefehlshaber der US- und NATO-Truppen, Stanley McChrystal, per Videokonferenz zugeschaltet."
                                            },
                                            {
                                                "example_id": "e301611a-e3e9-425b-9f15-ad59c944f027",
                                                "sense_id": "7c5288b0-a8d4-345e-b69b-45f77a864293",
                                                "text": "Man hat um dem Bedürfnis zu genügen flektierbare Wörter geschaffen. Einerseits durch sekundäre Ableitungen, die nur attributiv, nicht prädikativ verwendet werden, vgl. alleinig, hiesig, dortig, obig, jetzig, vorig, nachherig, sofortig, alsbaldig, vormalig, diesseitig; seltener solche, die auch prädikativ verwendet werden wie niedrig, übrig (auch alleinig in oberdeutschen Mundarten)."
                                            },
                                            {
                                                "example_id": "892c45a8-f294-4bb6-a738-29733f132149",
                                                "sense_id": "7c5288b0-a8d4-345e-b69b-45f77a864293",
                                                "text": "„Haben die Niederlande ihren moralischen Kompass oder hat der dortige Premierminister ein saftiges Wahlkampfthema entdeckt?“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
