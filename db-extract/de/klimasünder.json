                        "sense_id": "d5b08f2f-5be6-32a9-992b-a27f944ea543",
                        "entry_id": "cc3376ac-f544-34d8-aa58-cd51f7465dcd",
                        "glosses": [
                            "climate offender (a person who violates laws and/or principles pertaining to mitigating the climate emergency)"
                        ],
                        "tags": [
                            "colloquial",
                            "derogatory",
                            "masculine",
