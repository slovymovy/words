                        "examples": [
                            {
                                "example_id": "69f1b647-286e-4255-9ed4-3043232edaf9",
                                "sense_id": "d492dfa6-458f-3c91-8acb-83ca37bf8cc9",
                                "text": "In Rotterdam zijn vele honderden fans van de overleden acteur Paul Walker zondagavond naar een herdenkingsbijeenkomst gegaan. Walker is bekend van zijn hoofdrol in de filmserie The Fast and the Furious."
                            },
                            {
                                "example_id": "68bcfa21-b4cd-4b10-9134-c4fe5ed08f50",
                                "sense_id": "d492dfa6-458f-3c91-8acb-83ca37bf8cc9",
                                "text": "\"Pity. Clearly, fame isn't everything, is it, Mr. Potter?\" Zeven boeken lang was Sneep de sinistere, valse docent en plaaggeest van Harry Potter op Zweinstein. Een echte slechterik, maar Alan Rickman wist wel beter. Hij wist vanaf het begin van een van de grootste plottwists in de filmserie:"
                            },
                            {
                                "example_id": "4fcbbcd6-c155-4a2c-9f3f-9a896cdda7e3",
                                "sense_id": "d492dfa6-458f-3c91-8acb-83ca37bf8cc9",
                                "text": "De Engelse acteur en stuntman Richard Brooker is overleden. Hij was vooral bekend van zijn rol als de griezel Jason Voorhees in het derde deel van de filmserie Friday the 13th."
                            },
                            {
                                "example_id": "004b570c-0f3c-4bf3-b3db-43a1568bcbe0",
                                "sense_id": "d492dfa6-458f-3c91-8acb-83ca37bf8cc9",
                                "text": "Sylvia Kristel werd internationaal bekend door haar rollen in de soft-erotische filmserie Emmanuelle. Ook speelde ze mee in tal van andere films; zo'n vijftig in totaal."
                            }
                        ]
                    }
