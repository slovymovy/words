                                        "examples": [
                                            {
                                                "example_id": "ab913428-a348-4668-a130-b29543bb06f9",
                                                "sense_id": "7ad54abc-8fd0-3ec1-97bc-853bbd925330",
                                                "text": "Die Expressionisten malten oft sehr farbige Bilder."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "88b28521-91fe-3b3c-aae0-7ea65f15c90f",
                                        "entry_id": "5c363595-7fec-37b1-83aa-6397a526e22c",
                                        "glosses": [
                                            "den Zuhörer ansprechend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "32bafbbb-4924-4113-b72d-f5df2efb4780",
                                                "sense_id": "88b28521-91fe-3b3c-aae0-7ea65f15c90f",
                                                "text": "Sein Vortrag war sehr farbig und hat uns kein bisschen gelangweilt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "3df254aa-fae2-3fa1-b493-a9689309a47b",
                                        "entry_id": "5c363595-7fec-37b1-83aa-6397a526e22c",
                                        "glosses": [
                                            "nicht weißhäutig"
                                        ],
                                        "tags": [
                                            "auf Menschen bezogen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cf3aa387-5b52-487f-96dd-f2e6c7ff26bd",
                                                "sense_id": "3df254aa-fae2-3fa1-b493-a9689309a47b",
                                                "text": "In vielen Ländern der Erde ist die Bevölkerung überwiegend farbig."
                                            },
                                            {
                                                "example_id": "8d3c4959-0625-4734-b9c3-5d18e05ee4c7",
                                                "sense_id": "3df254aa-fae2-3fa1-b493-a9689309a47b",
                                                "text": "„Der farbige Butler verbeugte sich stumm und ging. Seine Verbeugung war mehr freundschaftlich als servil und erfolgte auch nur, weil Johnny Besuch zum Dinner hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
