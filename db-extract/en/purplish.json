                                        "sense_id": "71383885-0cc3-3fe4-9e54-9c3e324be50c",
                                        "entry_id": "d8363a2c-7b4b-3cff-a07d-a46c9f7cdb70",
                                        "glosses": [
                                            "De color púrpura, o que tiene un tono púrpura."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e67beef3-e708-4ff1-b514-080d6c9348c7",
                                                "sense_id": "71383885-0cc3-3fe4-9e54-9c3e324be50c",
                                                "text": "Temo hijo, que tus súplicas sean vanas. Porque de nuevo me gotea la purpúrea sangre del fondo de la herida, y sospecho algo terrible."
                                            }
