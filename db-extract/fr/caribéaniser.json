                "senses": [
                    {
                        "sense_id": "57495b92-14f7-334c-afcb-c0361b662f29",
                        "entry_id": "e98479fa-c373-39fb-8bf5-48692218a531",
                        "glosses": [
                            "Donner un caractère caribéen à quelque chose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d2f4e68d-993d-4911-a93e-900cd13c6c85",
                                "sense_id": "57495b92-14f7-334c-afcb-c0361b662f29",
                                "text": "Autre point étonnant, mis à part l’affrontement à froid avec le pouvoir français : la volonté d’antillaniser, de caribéaniser le combat."
                            },
                            {
                                "example_id": "f86e1ec0-d788-4eb2-bd72-5c55f205a679",
                                "sense_id": "57495b92-14f7-334c-afcb-c0361b662f29",
                                "text": "Pour événementialiser son lancement global en 2011 après le succès rencontré au Canada, Malibu Winter Edition a décidé de « caribéaniser » les vœux de fin d’année : une activation digitale proposait aux fans de la marque de revisiter à leur manière et dans le style Malibu les vœux classiques en souhaitant une bonne année à leurs proches sur Facebook."
                            },
                            {
                                "example_id": "18d39ccc-2573-4999-9484-b3b77723fab4",
                                "sense_id": "57495b92-14f7-334c-afcb-c0361b662f29",
                                "text": "Parce que ça nous met la banane, c'est reparti pour un été au rythme des AfterWorks La Caribéenne sur la Péniche Concorde Atlantique tous les mardis viens te caribéaniser!"
                            }
                        ]
                    }
                ],
