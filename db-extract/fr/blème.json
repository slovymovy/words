                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "9099333b-944a-32eb-b005-d3e42f3b5e8a",
                        "entry_id": "2d193522-e5a8-3eba-8508-7c28398e3a63",
                        "glosses": [
                            "Problem, Schwierigkeit"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "4d0745b1-d751-499d-9da9-8ba642b06dae",
                                "sense_id": "9099333b-944a-32eb-b005-d3e42f3b5e8a",
                                "text": "Y a un blème.",
                                "translation": "Es gibt ein Problem."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "34629a19-fd4a-4935-9e24-2ec3beae0ba8",
                        "source_entry_id": "2d193522-e5a8-3eba-8508-7c28398e3a63",
                        "source_sense_id": "9099333b-944a-32eb-b005-d3e42f3b5e8a",
                        "source_sense_description": "umgangssprachlich, Jargon: Problem, Schwierigkeit",
                        "target_lang_word": "Problem",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Problem",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "18abe1ab-4a31-35ae-ab3f-28b066d635d7",
                                        "entry_id": "c658b3e8-4f8b-3c31-adbf-f7719c2421f6",
                                        "glosses": [
                                            "schwierige, noch ungelöste Aufgabe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c5b61f33-0ba7-4c36-86eb-526de88bd05d",
                                                "sense_id": "18abe1ab-4a31-35ae-ab3f-28b066d635d7",
                                                "text": "„Es handelt sich um einen leidenschaftlichen Segelflieger, der sich wegen zwischenmenschlicher Probleme in die Behandlung begeben hat.“"
                                            },
                                            {
                                                "example_id": "aa79e30f-105c-4e15-8543-71d6fe31e5ed",
                                                "sense_id": "18abe1ab-4a31-35ae-ab3f-28b066d635d7",
                                                "text": "Wir haben ein schwerwiegendes Problem!"
                                            },
                                            {
                                                "example_id": "e8b4b6ee-e864-4258-9120-68a7988f60a6",
                                                "sense_id": "18abe1ab-4a31-35ae-ab3f-28b066d635d7",
                                                "text": "„Je weniger sich das Problem lösen ließ, desto verbissener rechnete und theoretisierte Barbicane daran herum.“"
                                            },
                                            {
                                                "example_id": "9b1a0c95-e0d1-4237-bc5b-a6cb0462825d",
                                                "sense_id": "18abe1ab-4a31-35ae-ab3f-28b066d635d7",
                                                "text": "„Harrison dürfte früh vom Problem der Längengradbestimmung gewußt haben – so wie jeder aufgeweckte Junge heute weiß, daß Krebs noch immer unheibar ist und es keine vernünftige Lösung zur Beseitigung von Atommüll gibt.“"
                                            },
                                            {
                                                "example_id": "5ed81191-67eb-49ea-9335-94f428eb5e01",
                                                "sense_id": "18abe1ab-4a31-35ae-ab3f-28b066d635d7",
                                                "text": "„Wenn die Entfernung zur Immobilie gering ist, minimieren sie auch so ihren zeitlichen Aufwand bei einem Mieterwechsel und können im Bedarfsfall Probleme persönlich klären.“"
                                            },
                                            {
                                                "example_id": "5af2c8a9-aa63-4de6-9e4c-73569875cff6",
                                                "sense_id": "18abe1ab-4a31-35ae-ab3f-28b066d635d7",
                                                "text": "„Die harsche Kritik an seinem Papier zeige ihm, dass die eigentliche Dimension des Problemes nicht mehr gesehen würde: \"Viele sind nur noch daran interessiert, dass die Telekom ihre Vorleistungen zu niedrigen Preisen abgeben muss.\"“"
                                            },
                                            {
                                                "example_id": "d0f020da-7ca6-4bb1-a2aa-bd474a78d1ec",
                                                "sense_id": "18abe1ab-4a31-35ae-ab3f-28b066d635d7",
                                                "text": "„Gipfelsammler der Sächsischen Schweiz haben mit mehreren Problemen zu kämpfen.“"
                                            },
                                            {
                                                "example_id": "af1a8fbc-b4a5-4b4c-bd4e-92ca46ccaa5a",
                                                "sense_id": "18abe1ab-4a31-35ae-ab3f-28b066d635d7",
                                                "text": "„Schon die ältere Forschung … war sich einer gewissen Randständigkeit in Fragen der chronikalischen und literarischen Quellen als Problem bewusst.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a4ec3798-1de1-3972-9bee-813f072299c2",
                                        "entry_id": "c658b3e8-4f8b-3c31-adbf-f7719c2421f6",
                                        "glosses": [
                                            "etwas, was sich für einen bei einem Vorhaben als Hindernis herausstellt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "708d3f54-51a9-486f-a136-aa9359ad384b",
                                                "sense_id": "a4ec3798-1de1-3972-9bee-813f072299c2",
                                                "text": "„Gipfelsammler der Sächsischen Schweiz haben mit mehreren Problemen zu kämpfen.“"
                                            },
                                            {
                                                "example_id": "6c68d827-73eb-4647-95da-6d7eee638a78",
                                                "sense_id": "a4ec3798-1de1-3972-9bee-813f072299c2",
                                                "text": "„Schon die ältere Forschung … war sich einer gewissen Randständigkeit in Fragen der chronikalischen und literarischen Quellen als Problem bewusst.“"
                                            },
                                            {
                                                "example_id": "697b63b4-923c-458c-a7c9-4cf499badee6",
                                                "sense_id": "a4ec3798-1de1-3972-9bee-813f072299c2",
                                                "text": "„Er hat eigentlich wirklich kein Problem gehabt, kein Krebs, keine Familie, kein Chef, kein gar nichts. Aber zwischen vier und fünf Uhr früh können sich die Gedanken ganz sonderbar umdrehen, und du bildest dir plötzlich ein: Mit Problem hätte ich weniger Probleme als so ganz ohne Problem.“"
                                            },
                                            {
                                                "example_id": "329e6998-c499-4607-b403-ac887a362172",
                                                "sense_id": "a4ec3798-1de1-3972-9bee-813f072299c2",
                                                "text": "„Am 17. April 1374 traf sich der Braunschweiger Stadtrat in der Brüdernkirche mit den Gildemeistern, um unter anderem über die finanziellen Probleme der Stadt zu beraten.“"
                                            },
                                            {
                                                "example_id": "f6311a2a-74ae-46e4-9dba-f4031c1493a1",
                                                "sense_id": "a4ec3798-1de1-3972-9bee-813f072299c2",
                                                "text": "„Bella Figura machen ist mein kleinstes Problem.“"
                                            },
                                            {
                                                "example_id": "1f834e83-5ae7-4066-bb81-30f000d484c8",
                                                "sense_id": "a4ec3798-1de1-3972-9bee-813f072299c2",
                                                "text": "„Viele Garten- und Naturliebhaber wissen um das Problem [des Insektensterbens] und pflanzen Blumen, die beispielsweise für Bienen oder Schmetterlinge interessant sind.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9c8adcb8-322a-406a-8115-572a4a4e88ef",
                        "source_entry_id": "2d193522-e5a8-3eba-8508-7c28398e3a63",
                        "source_sense_id": "9099333b-944a-32eb-b005-d3e42f3b5e8a",
                        "source_sense_description": "umgangssprachlich, Jargon: Problem, Schwierigkeit",
                        "target_lang_word": "Schwierigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schwierigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "79cd08e1-b3c7-3a1a-a5c7-54dc68568aaf",
                                        "entry_id": "d4b304f8-b9f0-3ebb-843e-83b58652cd6c",
                                        "glosses": [
                                            "Aufgabe, Eigenschaft, Lage oder Situation, die Ärger machen oder ein Problem darstellen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d65bbccb-2b8c-4b3d-98b0-f06f28b07e5c",
                                                "sense_id": "79cd08e1-b3c7-3a1a-a5c7-54dc68568aaf",
                                                "text": "Mit der Aufgabe hatte er große Schwierigkeiten."
                                            },
                                            {
                                                "example_id": "38d800d4-3d6f-4ebd-ab97-572d17943958",
                                                "sense_id": "79cd08e1-b3c7-3a1a-a5c7-54dc68568aaf",
                                                "text": "Die Deutsche Bank ist ja seit Jahren in Schwierigkeiten und es wird wahrscheinlich in der nächsten Zeit auch nicht deutlich besser werden."
                                            },
                                            {
                                                "example_id": "e0d2563a-845e-4598-8956-5568e1d5ece5",
                                                "sense_id": "79cd08e1-b3c7-3a1a-a5c7-54dc68568aaf",
                                                "text": "„Die haben mir auch keine Schwierigkeiten gemacht.“"
                                            },
                                            {
                                                "example_id": "7a8f0466-07fe-46b7-aa60-ac637945969e",
                                                "sense_id": "79cd08e1-b3c7-3a1a-a5c7-54dc68568aaf",
                                                "text": "„Lange hatten große Markenhersteller eher Schwierigkeiten, sich modisch gegen massiv expandierende Filialisten wie Zara und H&M zu behaupten, deren Produkte ohne prominentes Logo auskommen.“"
                                            },
                                            {
                                                "example_id": "fe090e63-2bd3-472c-b863-3efbae121f03",
                                                "sense_id": "79cd08e1-b3c7-3a1a-a5c7-54dc68568aaf",
                                                "text": "„In Wirklichkeit hat man nur die erste Schwierigkeit überstanden, einen schwachen Vorgeschmack von dem, was unbedingt nachkommen wird.“"
                                            },
                                            {
                                                "example_id": "822ca438-6b4c-40ba-9729-611cd598d645",
                                                "sense_id": "79cd08e1-b3c7-3a1a-a5c7-54dc68568aaf",
                                                "text": "„Besondere Schwierigkeiten bereiten Brände von Benzin, öl oder Fett.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
