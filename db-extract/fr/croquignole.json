        "fr-extract.jsonl": [
            {
                "entry_id": "df368c7c-d420-3e06-a262-48a35d016c47",
                "word": "croquignole",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "3abeeb05-8d93-45a5-b015-5517e3328e26",
                        "entry_id": "df368c7c-d420-3e06-a262-48a35d016c47",
                        "tags": [
                            "plural"
                        ],
                        "form": "croquignoles"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6be055cf-185e-3ead-aaa2-0798a61fbf76",
                        "entry_id": "df368c7c-d420-3e06-a262-48a35d016c47",
                        "glosses": [
                            "Espèce de petit gâteau sec très dur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ff51f89-80ba-4c6f-a2ee-8cdd9d5cfaf6",
                                "sense_id": "6be055cf-185e-3ead-aaa2-0798a61fbf76",
                                "text": "Elle profitait des gelées, de croquignoles, de la mousse qu’on lui faisait humer au bord des verres"
                            },
                            {
                                "example_id": "941fb19e-41bb-4c1f-b2cf-49ce650b1c58",
                                "sense_id": "6be055cf-185e-3ead-aaa2-0798a61fbf76",
                                "text": "Les uns le voient encore au fond de leurs yeux tel qu'il était, moyen de taille mais carré comme une porte d'étable, velu comme un singe, barbu comme un docteur, chevelu comme un ermite, plus fort qu'un jeune taureau, capable de pulvériser une noix corne entre le pouce et le petit doigt (essayez donc d'en faire autant), de casser une pièce de cent sous entre ses dents. comme une croquignole ou de rompre ainsi qu'une badine de coudrier un baliveau de pêche sur son genou."
                            }
                        ]
                    },
                    {
                        "sense_id": "ee2596d7-184c-3552-8345-84a28778265d",
                        "entry_id": "df368c7c-d420-3e06-a262-48a35d016c47",
                        "glosses": [
                            "Chose futile et de moindre importance."
                        ],
                        "tags": [
                            "analogy"
                        ],
                        "examples": [
                            {
                                "example_id": "afc84e15-6845-4b25-8dfc-4181a22a3607",
                                "sense_id": "ee2596d7-184c-3552-8345-84a28778265d",
                                "text": "Vieilles verdures, vieux galons !\n Ô croquignoles végétales !\nFleurs fantasques des vieux salons !"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": [
                    {
                        "linkage_id": "9ef0b7e9-bf1f-4a4b-b204-681aa0d23c92",
                        "source_entry_id": "df368c7c-d420-3e06-a262-48a35d016c47",
                        "source_sense_ids": [],
                        "source_sense_description": "Petit gâteau sec très dur :",
                        "linkage_type": "synonyms",
                        "word": "croquignolet"
                    }
                ]
            },
            {
                "entry_id": "d27ed933-2b32-3fe3-9f13-2bd5b76c7dac",
                "word": "croquignole",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "a7352381-7080-4ec8-a3a3-bac7f286dc68",
                        "entry_id": "d27ed933-2b32-3fe3-9f13-2bd5b76c7dac",
                        "tags": [
                            "plural"
                        ],
                        "form": "croquignoles"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e228aae2-5cf9-3fac-ba4b-b848f8cb8c85",
                        "entry_id": "d27ed933-2b32-3fe3-9f13-2bd5b76c7dac",
                        "glosses": [
                            "Chiquenaude."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c4ffed9-bf12-4b02-8e11-6947af236f19",
                                "sense_id": "e228aae2-5cf9-3fac-ba4b-b848f8cb8c85",
                                "text": "Offrez-lui une croquignole sur le bout du nez, et il la recevra en douceur."
                            },
                            {
                                "example_id": "ce30083a-08ae-440a-8a1c-abf1fb05a3ae",
                                "sense_id": "e228aae2-5cf9-3fac-ba4b-b848f8cb8c85",
                                "text": "Mille croquignoles sur votre gros nez rouge."
                            },
                            {
                                "example_id": "7eb61af2-7c00-4c6d-ae27-d9cd00ddba99",
                                "sense_id": "e228aae2-5cf9-3fac-ba4b-b848f8cb8c85",
                                "text": "« Tu dois être contente, Fortune adverse, je suis assez humilié, assez profondément enfoncé dans l’abjection, pensait-il tout en recevant les nasardes, croquignoles et coups de pied ; tu m’avais fait misérable ! tu me rends ridicule ! tu me forces par un lâche tour à me déshonorer devant cette fière personne ! Que te faut-il de plus ? »"
                            },
                            {
                                "example_id": "b6fa1b78-887b-4c10-8083-f1b6d9a90fe7",
                                "sense_id": "e228aae2-5cf9-3fac-ba4b-b848f8cb8c85",
                                "text": "Au défaut de six pistoles,\nChoisissez donc sans façon\nD'avoir trente croquignoles,\nOu douze coups de bâton."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "716dbb1e-9644-40cf-9f5d-96d3fc20f112",
                        "source_entry_id": "d27ed933-2b32-3fe3-9f13-2bd5b76c7dac",
                        "source_sense_id": "e228aae2-5cf9-3fac-ba4b-b848f8cb8c85",
                        "target_lang_word": "flick",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "flick",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a5081539-5e81-3838-a8c1-fc6b949c81f6",
                                        "entry_id": "85779af0-7173-378c-834e-eebcdb4c0d16",
                                        "glosses": [
                                            "A short, quick movement, especially a brush, sweep, or flip."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1378383a-25e0-4155-8636-b26835aa16cb",
                                                "sense_id": "a5081539-5e81-3838-a8c1-fc6b949c81f6",
                                                "text": "He removed the speck of dust with a flick of his finger."
                                            },
                                            {
                                                "example_id": "ab0bef04-cefa-42c5-ae7c-4dc8e014d47b",
                                                "sense_id": "a5081539-5e81-3838-a8c1-fc6b949c81f6",
                                                "text": "She gave a disdainful flick of her hair and marched out of the room."
                                            },
                                            {
                                                "example_id": "20ac598a-fec7-4809-942e-6c59734071c7",
                                                "sense_id": "a5081539-5e81-3838-a8c1-fc6b949c81f6",
                                                "text": "On this occasion it was Nolan's deft flick that fooled West Ham's sleepy defenders Danny Gabbidon and Tomkins. The ball found its way to Best, who smashed in with confidence from the edge of the area."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7e698de1-645d-36a1-86cf-d51403fc7d8e",
                                        "entry_id": "85779af0-7173-378c-834e-eebcdb4c0d16",
                                        "glosses": [
                                            "A motion picture, movie, film; (in plural, usually preceded by \\\"the\\\") movie theater, cinema."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e8b1df2c-6734-403c-a5d3-128edd5dbf17",
                                                "sense_id": "7e698de1-645d-36a1-86cf-d51403fc7d8e",
                                                "text": "My all-time favorite flick is \"Gone with the Wind.\""
                                            },
                                            {
                                                "example_id": "7adf0638-75ba-4e87-8908-9d488bc535e0",
                                                "sense_id": "7e698de1-645d-36a1-86cf-d51403fc7d8e",
                                                "text": "Want to go to the flicks tonight?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b930fa3-c718-3142-af7e-83fdba6f6223",
                                        "entry_id": "85779af0-7173-378c-834e-eebcdb4c0d16",
                                        "glosses": [
                                            "A cut that lands with the point, often involving a whip of the foible of the blade to strike at a concealed target."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "92abe9d3-681b-388b-be0a-ec40162606bc",
                                        "entry_id": "85779af0-7173-378c-834e-eebcdb4c0d16",
                                        "glosses": [
                                            "A powerful underarm volley shot."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d4b574c-5831-4b6a-b872-3fe719f05ce3",
                                                "sense_id": "92abe9d3-681b-388b-be0a-ec40162606bc",
                                                "text": "The fourth seed was dominating her 20-year-old opponent with a series of stinging groundstrokes and athletic drive-volleys, striking again in game five when Paszek flicked a forehand pick-up into the tramlines."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "47591ba2-40f0-3381-836b-08fa2717cfe4",
                                        "entry_id": "85779af0-7173-378c-834e-eebcdb4c0d16",
