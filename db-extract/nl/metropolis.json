                    },
                    {
                        "translation_id": "f75f3bfa-9af7-43cc-b538-4f3cd3de8bc7",
                        "source_entry_id": "2abb9a12-0be5-399c-9f4d-1db7264832df",
                        "target_lang_word": "metrópoli",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "metrópoli",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "e68915f0-bd31-31ac-ad0b-3001efacb73f",
                                        "entry_id": "68bb7950-88e6-3688-9a29-cf619386cdc2",
                                        "glosses": [
                                            "Ciudad de gran tamaño y población que actúa como centro político, económico o administrativo de un área mayor."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55b36785-1474-4e5c-af4a-6f2602271e9a",
                                                "sense_id": "e68915f0-bd31-31ac-ad0b-3001efacb73f",
                                                "text": "Generalmente, una metrópolis es altamente poblada y ofrece una amplia gama de servicios, infraestructuras y oportunidades en comparación con otras áreas urbanas. Es común que una metrópolis sea el epicentro de la actividad económica y la toma de decisiones de una nación o región. Ejemplos de metrópolis incluyen ciudades como Nueva York, Londres, Tokio y París. Anthropos ISBN 84-7658-220-X."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "54012879-3633-3c6c-adc4-8d37f48bb8d8",
                                        "entry_id": "68bb7950-88e6-3688-9a29-cf619386cdc2",
                                        "glosses": [
                                            "En un imperio colonial, nación colonizadora respecto a los territorios colonizados."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
