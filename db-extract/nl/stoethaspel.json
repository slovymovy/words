                ],
                "senses": [
                    {
                        "sense_id": "569b7e79-52bb-32e5-a399-9090eea4ca22",
                        "entry_id": "5548f793-3ad7-3f76-a361-1f73f574b03e",
                        "glosses": [
                            "een onhandig en/of lomp persoon die veel brokken maakt"
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "585a5497-c420-42a9-a8c5-b468b91c750b",
                                "sense_id": "569b7e79-52bb-32e5-a399-9090eea4ca22",
                                "text": "Federer speelde gretig, bliksemsnel, geïnspireerd en vooral zéér effectief. Met 8 aces, 40 winners, 20 op 23 gewonnen punten aan het net en geen enkele weggegeven breakkans reduceerde hij Berdych, toch niet de eerste de beste, tot een stoethaspel."
                            },
                            {
                                "example_id": "1a2fe87e-3d74-4c4f-95b5-ca4f51038410",
                                "sense_id": "569b7e79-52bb-32e5-a399-9090eea4ca22",
                                "text": "\"Als de stoethaspelende Karen Richards was Krijgsman dé verrassing van de DeLaMar-muziektheaterproductie In de ban van Broadway\", aldus de jury."
                            },
                            {
                                "example_id": "bc6d62c8-4d41-46b6-9eab-565a6984ea17",
                                "sense_id": "569b7e79-52bb-32e5-a399-9090eea4ca22",
                                "text": "Wij kunnen een veel leukere woordverkiezing organiseren dan Van Dale en het Genootschap Onze Taal, dacht de Donald Duck. En dus riep het weekblad lezers op te stemmen op het leukste Donald Duck-woord in hun grote Duck-tee-nummer in december. En de winnaar is maandag bekendgemaakt: ‘Verweggistan’. Het haalde het voor ‘schorriemorrie’ en ‘stoethaspel’, met 35 procent van de 5500 stemmen."
                            }
                        ]
                    }
                ],
