                "senses": [
                    {
                        "sense_id": "794ca676-3a64-3a65-a72b-98b68f9a785f",
                        "entry_id": "59037d10-e8dd-353a-bbd5-5a3b37bcdd98",
                        "glosses": [
                            "Attribut, das im Genitiv steht"
                        ],
                        "tags": [
                            "Linguistik/Sprachwissenschaft"
                        ],
                        "examples": [
                            {
                                "example_id": "6654b5f4-4cf1-4300-8fe4-a02c0f56ab82",
                                "sense_id": "794ca676-3a64-3a65-a72b-98b68f9a785f",
                                "text": "Im Satzglied „Das Haus meines Vaters“ ist „meines Vaters“ Genitivattribut."
                            },
                            {
                                "example_id": "040c7995-70b1-473c-b0bd-008a72382d22",
                                "sense_id": "794ca676-3a64-3a65-a72b-98b68f9a785f",
                                "text": "„Jedes Substantiv kann ein Genitivattribut zu sich nehmen…“"
                            },
                            {
                                "example_id": "bcad9cb5-95f6-481e-a2c9-66af939152eb",
                                "sense_id": "794ca676-3a64-3a65-a72b-98b68f9a785f",
                                "text": "„Das Genitivattribut erlaubt auf sehr ökonomische Weise Präzisierungen von Nominalgruppen.“"
                            },
                            {
                                "example_id": "5f67aa0a-74a7-4583-bfeb-0bbe366f4b29",
                                "sense_id": "794ca676-3a64-3a65-a72b-98b68f9a785f",
                                "text": "„Dabei hatten wir uns auf eine Art Interviewform im Zeitungsstil festgelegt, um die drei Genitivarten, das Genitivattribut, den präpositionalen Genitiv und das Genitivobjekt, die wir in unserer Facharbeit untersucht hatten, vorzustellen.“"
                            },
                            {
                                "example_id": "5a847fc9-bd7b-4f69-9c3e-7d9018d7297e",
                                "sense_id": "794ca676-3a64-3a65-a72b-98b68f9a785f",
                                "text": "„Worin zeigt sich nun außer bei Formulierungen mit »von« an Stelle eines Genitivattributs der generelle Wandel vom synthetischen zum analytischen Sprachbau?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
