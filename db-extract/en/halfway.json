                "pos": "adv",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "34ba7709-3541-3b33-ac09-50dfcbc283a7",
                        "entry_id": "0afa55ea-8a3e-320c-b8b5-53780cd882b3",
                        "glosses": [
                            "Half of the way between two points"
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "c886fc01-478e-42ab-be87-b17f250c9a4f",
                                "sense_id": "34ba7709-3541-3b33-ac09-50dfcbc283a7",
                                "text": "I was already halfway home when I missed my keyring."
                            },
                            {
                                "example_id": "4f796d06-666f-45a8-b8bc-adc2e8ce0f14",
                                "sense_id": "34ba7709-3541-3b33-ac09-50dfcbc283a7",
                                "text": "One day has gone by and she's already halfway through the book."
                            },
                            {
                                "example_id": "5e9b8c16-14b5-4038-a4e5-bff19cce70cf",
                                "sense_id": "34ba7709-3541-3b33-ac09-50dfcbc283a7",
                                "text": "It's July 1st, so this year is halfway over."
                            },
                            {
                                "example_id": "12d27bc1-d161-447e-bcad-a2e2f803d0a5",
                                "sense_id": "34ba7709-3541-3b33-ac09-50dfcbc283a7",
                                "text": "Just over halfway up, we reached the Human settlement with its houses of stone and wood and thatch."
                            },
                            {
                                "example_id": "24044bf9-d732-4cd8-985f-30c6407d088e",
                                "sense_id": "34ba7709-3541-3b33-ac09-50dfcbc283a7",
                                "text": "\"He comes halfway and I come halfway,\" said Mr. Korson, 56."
                            },
                            {
                                "example_id": "f4e208e1-6816-483a-879f-4463adc55bb4",
                                "sense_id": "34ba7709-3541-3b33-ac09-50dfcbc283a7",
                                "text": "For Super Bowl visitors, Hard Rock Stadium in Miami Gardens lies about halfway between the Miami and Fort Lauderdale airports."
                            }
                        ]
                    },
                    {
                        "sense_id": "daa79214-4187-3fa3-95b3-7b93278b646c",
                        "entry_id": "0afa55ea-8a3e-320c-b8b5-53780cd882b3",
