                ],
                "senses": [
                    {
                        "sense_id": "2d05620d-87d3-3258-b020-c840324b9969",
                        "entry_id": "3e5ec7bd-6fa6-3839-8c8e-ec5d28d0f73c",
                        "glosses": [
                            "Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f97b8ce-8953-47b6-bdcb-7e0036be5916",
                                "sense_id": "2d05620d-87d3-3258-b020-c840324b9969",
                                "text": "Frau Jechiel ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "04420d01-93dc-4a29-a1f7-eadce33fa19d",
                                "sense_id": "2d05620d-87d3-3258-b020-c840324b9969",
                                "text": "Herr Jechiel wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "eccea728-0aa2-4dc9-8e6a-a3fd01ecceda",
                                "sense_id": "2d05620d-87d3-3258-b020-c840324b9969",
                                "text": "Die Jechiels fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "e2fdee6e-ed3a-4508-ac06-42bd3caa1c5a",
                                "sense_id": "2d05620d-87d3-3258-b020-c840324b9969",
                                "text": "Der Jechiel trägt nie die Schals, die die Jechiel ihm strickt."
                            },
                            {
                                "example_id": "185c708f-ec26-43ff-bfe9-3d979279a1ef",
                                "sense_id": "2d05620d-87d3-3258-b020-c840324b9969",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Jechiel kommt, geht der Herr Jechiel.“"
                            },
                            {
                                "example_id": "f7684589-2b99-47f2-aaa8-d168daf86b45",
                                "sense_id": "2d05620d-87d3-3258-b020-c840324b9969",
                                "text": "Jechiel kommt und geht."
                            },
                            {
                                "example_id": "12727291-9e41-44cd-baa6-2a56c12fddc9",
                                "sense_id": "2d05620d-87d3-3258-b020-c840324b9969",
                                "text": "Jechiels kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
