                "senses": [
                    {
                        "sense_id": "25945574-baee-3272-b7cd-9c7fe4b0828e",
                        "entry_id": "39c581b5-21ab-35bc-b98a-cca91fb3a1bd",
                        "glosses": [
                            "Genre de la famille des indridés, comprenant de grands lémuriens de Madagascar à longue queue, diurnes et sauteurs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec4a976b-afff-445c-94c5-08a8cfac2d2c",
                                "sense_id": "25945574-baee-3272-b7cd-9c7fe4b0828e",
                                "text": "Il s’interrogeait encore lorsqu’un propithèque s’approcha de lui, le fixant de ses petits yeux ronds malveillants."
                            },
                            {
                                "example_id": "82c97661-7ccd-4456-bab2-f7fee2343054",
                                "sense_id": "25945574-baee-3272-b7cd-9c7fe4b0828e",
                                "text": "Les Propithèques , le matin, grimpent sur un arbre élevé et s’y assoient, les bras levés, la face en direction de l’est, de sorte que les rayons solaires réchauffent la poitrine. C’est pourquoi, les Propithèques, de façon similaire aux Makis varis, passaient jadis auprès des Malgaches pour des « adorateurs sacrés du soleil »."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "21c1539c-0ad3-4671-8a56-109e37c657f2",
                        "source_entry_id": "39c581b5-21ab-35bc-b98a-cca91fb3a1bd",
                        "source_sense_id": "25945574-baee-3272-b7cd-9c7fe4b0828e",
                        "target_lang_word": "sifaka",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sifaka",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a22378ce-835b-3beb-a1e7-3901ad3e7011",
                                        "entry_id": "56e7d73a-d1b5-336b-82e0-c2aaf014bbe4",
                                        "glosses": [
                                            "Any of several endangered medium-sized lemurs that comprise genus Propithecus."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "50258298-a0b3-49da-a442-0b6f3c27e297",
                                                "sense_id": "a22378ce-835b-3beb-a1e7-3901ad3e7011",
                                                "text": "Sifakas have single births, and infants ride first on their mother's front until they are about 3 months of age, then move to the mother's back, and they usually become totally independent at an age of about 6 months (Jolly 1996)."
                                            },
                                            {
                                                "example_id": "c903d109-82ef-47d7-b3ce-c9d0df6693af",
                                                "sense_id": "a22378ce-835b-3beb-a1e7-3901ad3e7011",
                                                "text": "Coquerel's sifaka (P. coquereli) is easily seen in the northwestern regions. Its chestnut-coloured arms and thighs, and piercing yellow eyes, make it particularly handsome. Like all sifakas, the young are born in June and July."
                                            },
                                            {
                                                "example_id": "f38899f7-7f77-4b41-a986-e01e05fad7db",
                                                "sense_id": "a22378ce-835b-3beb-a1e7-3901ad3e7011",
                                                "text": "Sifakas can jump about ten metres (thirty-three feet) – a little further than the human long-jump world record – which is not bad given that they are less than two foot high."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
