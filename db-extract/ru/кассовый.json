                                "target_senses": [
                                    {
                                        "sense_id": "eaa97eff-1834-3e94-892f-eb8433a072fa",
                                        "entry_id": "59e532b5-55ed-38a3-ba1e-16f5d7f9668e",
                                        "glosses": [
                                            "The low-denomination coin of southern India until 1818."
                                        ],
                                        "tags": [
