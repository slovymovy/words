                        "examples": [
                            {
                                "example_id": "7886d6e9-14eb-43d9-82e6-4857fb0c2087",
                                "sense_id": "a8bf0a97-7488-3f3d-aec9-e9ec77cca771",
                                "text": "In Rome is vandaag Paus Paulus de zesde zaligverklaard [sic!]. Hij leidde de Rooms-katholieke kerk van 1963 tot 1978. Paus Franciscus leidden de plechtigheid, op de slotdag van de bisschoppensynode."
                            },
                            {
                                "example_id": "aaebe688-6d4d-4dec-961e-2a494c6dc68e",
                                "sense_id": "a8bf0a97-7488-3f3d-aec9-e9ec77cca771",
                                "text": "Het Vaticaan blijft gekant tegen het homohuwelijk, maar lijkt wel van plan een veel mildere en radicaal andere houding tegen homo's aan te nemen. Dat blijkt uit een tussenrapport van de bisschoppensynode in Rome."
                            },
                            {
                                "example_id": "6de229f4-eec4-4c32-a634-5d985539dd42",
                                "sense_id": "a8bf0a97-7488-3f3d-aec9-e9ec77cca771",
                                "text": "De lijst met vragen is bedoeld als voorbereiding op een buitengewone bisschoppensynode over het gezin, die volgend jaar oktober wordt gehouden."
                            }
                        ]
                    }
