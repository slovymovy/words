                "senses": [
                    {
                        "sense_id": "55d03982-f126-353a-b72d-c24f1706d1b8",
                        "entry_id": "2a55bc4d-8ac5-3051-b86d-dbd4cf8b54cc",
                        "glosses": [
                            "Auffangbecken für Wasser in einem Atrium"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f1c0d09c-b0cc-421f-8d27-03f14cb2fc32",
                                "sense_id": "55d03982-f126-353a-b72d-c24f1706d1b8",
                                "text": "„Von dort gelangte man in ein erstes Atrium, das durch eine rechteckige Öffnung im Dach Tageslicht erhielt. In der Mitte des Raumes war ein Impluvium zum Auffangen des Regenwassers angelegt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
