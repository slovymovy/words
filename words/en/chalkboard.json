{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f96936e6-767a-3c62-b46d-082126b07f9b",
                    "sense_definition": "A dark, smooth surface used in classrooms and other places for writing or drawing on with chalk.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "classroom_equipment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teacher wrote the math problem on the <w>chalkboard</w>.",
                            "target_lang_translations": {
                                "zh": "老师把数学题写在了<w>黑板</w>上。"
                            }
                        },
                        {
                            "text": "She erased the notes on the <w>chalkboard</w> at the end of class.",
                            "target_lang_translations": {
                                "zh": "下课时，她擦掉了<w>黑板</w>上的笔记。"
                            }
                        }
                    ],
                    "synonyms": [
                        "blackboard"
                    ],
                    "common_phrases": [
                        "on the chalkboard",
                        "erase the chalkboard",
                        "classroom chalkboard"
                    ],
                    "target_lang_definitions": {
                        "zh": "用于教室等场所、供用粉笔在其上书写或绘画的深色平整表面。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "黑板",
                                "target_lang_sense_clarification": "最常用称呼，指用粉笔书写的板"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8ee6d4de-56db-3bc7-ae67-228fefea1860",
                    "sense_definition": "To write, draw, or decorate using chalk on a chalkboard surface.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "classroom_equipment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist spent the afternoon <w>chalkboarding</w> the daily specials outside the cafe.",
                            "target_lang_translations": {
                                "zh": "那位艺术家花了一下午时间在咖啡馆外<w>用粉笔把今日特价写在黑板上</w>。"
                            }
                        },
                        {
                            "text": "She <w>chalkboarded</w> a cheerful greeting for the students arriving on Monday morning.",
                            "target_lang_translations": {
                                "zh": "她<w>在黑板上写下</w>了热情的问候语，迎接周一早晨到校的学生。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "用粉笔在黑板上书写、绘画或装饰。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "用粉笔写在黑板上",
                                "target_lang_sense_clarification": "动词动作，指在黑板上用粉笔书写或绘制"
                            },
                            {
                                "target_lang_word": "在黑板上画",
                                "target_lang_sense_clarification": "指用粉笔在黑板上进行板报绘制或装饰"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}