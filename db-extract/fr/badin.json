                    },
                    {
                        "form_id": "60dd02bd-b8d4-442c-86e4-3dba2cc8b314",
                        "entry_id": "fe4f2b51-9d4d-3acc-905d-dc71f0900426",
                        "tags": [
                            "singular",
                            "feminine"
                        ],
                        "form": "badine"
                    },
                    {
                        "form_id": "5ce3d81d-842a-4e75-89ec-2325b3de7751",
                        "entry_id": "fe4f2b51-9d4d-3acc-905d-dc71f0900426",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "badines"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e2be14ca-ac39-32ed-befa-de3aa170fb15",
                        "entry_id": "fe4f2b51-9d4d-3acc-905d-dc71f0900426",
                        "glosses": [
                            "Qui aime à badiner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a4417ed0-236b-46da-87f7-e86922cf63ba",
                                "sense_id": "e2be14ca-ac39-32ed-befa-de3aa170fb15",
                                "text": "Manon, qui était badine, fut sur le point, plusieurs fois, de gâter tout par ses éclats de rire."
                            },
                            {
                                "example_id": "67c2d6a9-6b32-4089-ba8c-33630abcbd31",
                                "sense_id": "e2be14ca-ac39-32ed-befa-de3aa170fb15",
                                "text": "Akaki Akakiévitch avançait plein d’une humeur badine, il voulut même courir, d’un coup, Dieu seul savait pourquoi, après une dame qui, tel un éclair, passa devant lui et dont toutes les parties du corps étaient animées d’un mouvement extraordinaire."
                            },
                            {
                                "example_id": "44a6e4cf-de3a-42ad-af1a-c4bac4e4035d",
                                "sense_id": "e2be14ca-ac39-32ed-befa-de3aa170fb15",
                                "text": "Cet homme est badin."
                            },
                            {
                                "example_id": "bb4874a2-d0f2-4845-8b2f-bec59d6d579f",
                                "sense_id": "e2be14ca-ac39-32ed-befa-de3aa170fb15",
                                "text": "Esprit badin."
                            },
                            {
                                "example_id": "b17d4f27-ac9a-42dc-a6cd-b6c4477a551e",
                                "sense_id": "e2be14ca-ac39-32ed-befa-de3aa170fb15",
                                "text": "Il a l’humeur badine."
                            }
                        ]
                    },
                    {
                        "sense_id": "3a71cfc9-3586-3293-8806-08caaa81128c",
                        "entry_id": "fe4f2b51-9d4d-3acc-905d-dc71f0900426",
                        "glosses": [
                            "Qualifie le ton, les manières, le style, etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "016190b1-345d-4794-b2f5-c9803772a568",
                                "sense_id": "3a71cfc9-3586-3293-8806-08caaa81128c",
                                "text": "Air badin."
                            },
                            {
                                "example_id": "e8742314-246a-499a-b36d-973eccd65913",
                                "sense_id": "3a71cfc9-3586-3293-8806-08caaa81128c",
                                "text": "Ton badin."
                            },
                            {
                                "example_id": "cc2221bc-02e0-4921-af43-0a156481f211",
                                "sense_id": "3a71cfc9-3586-3293-8806-08caaa81128c",
                                "text": "Épître badine."
                            },
                            {
                                "example_id": "066bbde6-85a7-4268-83a4-79c187512ca8",
                                "sense_id": "3a71cfc9-3586-3293-8806-08caaa81128c",
                                "text": "Des vers badins."
                            },
                            {
                                "example_id": "29853020-55e3-4436-ab04-a5916bdb53f8",
                                "sense_id": "3a71cfc9-3586-3293-8806-08caaa81128c",
                                "text": "Trait badin",
                                "translation": "trait facile, léger."
                            },
                            {
                                "example_id": "06dd8211-cfc9-4898-9e6b-f9cc40c7b6c7",
                                "sense_id": "3a71cfc9-3586-3293-8806-08caaa81128c",
                                "text": "Jeune Aurore, il est déjà dans les boucles de vos beaux cheveux ; comme il s’y joue avec un souffle badin d’une épaule à l’autre !"
                            },
                            {
                                "example_id": "f956fb48-fd46-45b9-b44a-7ef761054d71",
                                "sense_id": "3a71cfc9-3586-3293-8806-08caaa81128c",
                                "text": "Le capitaine badin jusqu’au bout de sa badine passa son doigt ganté de chevreau blanc sur la culasse luisante de graisse de son pistolet-mitrailleur démonté et le considéra souillé en demandant d’un ton où l’insolence le disputait à la perplexité : « C’est ça que vous appeler un pistolet-mitrailleur propre ? »"
                            },
                            {
                                "example_id": "2274a844-2d7d-4e4f-b457-62c7d1192501",
                                "sense_id": "3a71cfc9-3586-3293-8806-08caaa81128c",
                                "text": "La question était posée sur un ton trop badin pour être totalement innocente"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
