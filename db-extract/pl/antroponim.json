                "translations": [
                    {
                        "translation_id": "0ec095b1-fcc6-434f-8d5d-18c03c6d2d88",
                        "source_entry_id": "de469877-4fdf-3b14-aa9b-d997a01fbd71",
                        "source_sense_id": "40a1a77b-4544-3a6f-9547-bff920014e5a",
