                                        "entry_id": "de24e956-1a8d-320b-86c6-76d414d9357f",
                                        "glosses": [
                                            "bestrebt, so viel Geld und Güter wie möglich anzuhäufen"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
