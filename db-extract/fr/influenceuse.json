                    },
                    {
                        "form_id": "5a97ae0d-2458-4718-85fe-773e367c93d6",
                        "entry_id": "2baf6804-16dd-31f9-982e-3da828740568",
                        "tags": [
                            "masculine"
                        ],
                        "form": "influenceur"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "84197bc7-5f9b-39a2-84bb-c90898c4b0a8",
                        "entry_id": "2baf6804-16dd-31f9-982e-3da828740568",
                        "glosses": [
                            "Femme qui, grâce à son exposition médiatique, exerce une influence sur un public."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ff71098-a2af-4a8b-bed2-c158baad6e02",
                                "sense_id": "84197bc7-5f9b-39a2-84bb-c90898c4b0a8",
                                "text": "La story publiée sur Instagram le 18 novembre par une influenceuse dénonçant le refus qui lui aurait été fait d’entrer au Louvre à cause de sa tenue est l’occasion de rappeler que cette institution est le musée européen le plus « hashtaggé »"
                            },
                            {
                                "example_id": "b7bac001-06ae-4a61-a477-ac69db381abd",
                                "sense_id": "84197bc7-5f9b-39a2-84bb-c90898c4b0a8",
                                "text": "Dernièrement, c’est l’influenceuse allemande Julia Lassner, suivie par plus de 50 000 personnes sur Instagram, qui a été choisie pour cibler « les jeunes actifs qui voyagent de façon responsable »."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d8a8fdb6-2b2b-45ec-af41-44323b2a6504",
                        "source_entry_id": "2baf6804-16dd-31f9-982e-3da828740568",
                        "source_sense_id": "84197bc7-5f9b-39a2-84bb-c90898c4b0a8",
                        "target_lang_word": "Influencerin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Influencerin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "78c8e83a-bea3-3486-987a-c915f86ef17f",
                                        "entry_id": "cd00c16d-b035-3413-ad60-390ec1cfd5bd",
                                        "glosses": [
                                            "weibliche Person, die aufgrund ihres häufigen Auftretens und ihrer guten Reputation in ihrem sozialen Netzwerk als marktwirtschaftlich interessante Person, also als Werbeträgerin, in Frage kommt und so gegen Entgelt eingesetzt werden kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "25d1fd41-2ac6-4a9f-8e72-0746621cb963",
                                                "sense_id": "78c8e83a-bea3-3486-987a-c915f86ef17f",
                                                "text": "„Mit 94.000 Followern ist die Influencerin Gabi Abrao auf Instagram ziemlich erfolgreich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "73a28b1f-bd01-4891-b522-46d5d4eb2041",
                        "source_entry_id": "2baf6804-16dd-31f9-982e-3da828740568",
                        "source_sense_id": "84197bc7-5f9b-39a2-84bb-c90898c4b0a8",
                        "target_lang_word": "influencer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "influencer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9903a128-60da-3842-8f8b-ffd813487398",
                                        "entry_id": "a176dab6-3dfa-32ec-8f80-fdead534d262",
                                        "glosses": [
                                            "A person who or a thing which influences."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cb9da03a-1fa3-3ec2-a9d6-4d646f216185",
                                        "entry_id": "a176dab6-3dfa-32ec-8f80-fdead534d262",
                                        "glosses": [
                                            "A person who is able to influence consumption, lifestyle, or political preferences of their online audience by creating or engaging social media content, often as a part of a marketing campaign."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "05898493-e0d7-4269-9e08-0b1cb12c53ba",
                                                "sense_id": "cb9da03a-1fa3-3ec2-a9d6-4d646f216185",
                                                "text": "By now you have probably heard of influencers, that group of internet-famous people who have more than a million social media followers and can make big money by plugging various brands. And you may have even heard of microinfluencers, who do the same thing for a still sizable but somewhat smaller social media audience — from the tens to low hundreds of thousands."
                                            },
                                            {
                                                "example_id": "96900ca8-194e-4404-8131-b277421b45ef",
                                                "sense_id": "cb9da03a-1fa3-3ec2-a9d6-4d646f216185",
                                                "text": "The idea of an influencer economy or streaming economy might have caused eyes to roll just a couple years ago, but the reality is that this segment of the economy is growing fast. More importantly, it is the part of the economy (and type of engagement) that is most appealing to the increasingly important millennial and Gen-Z cohorts."
                                            },
                                            {
                                                "example_id": "20b35877-f1f7-46e0-9986-167c741996cb",
                                                "sense_id": "cb9da03a-1fa3-3ec2-a9d6-4d646f216185",
                                                "text": "Over the past year, mansions full of young influencers have proliferated across the United States (in Los Angeles, Dallas and Las Vegas) and around the world (France, the U.K., Mexico, Spain and Russia)."
                                            },
                                            {
                                                "example_id": "4daac016-16e8-4c97-95aa-89234be59bd3",
                                                "sense_id": "cb9da03a-1fa3-3ec2-a9d6-4d646f216185",
                                                "text": "The idea of an alleged Epstein \"list\" was turbocharged by Trump's own inner circle, most notably by Bondi herself. In a February interview with Fox News, she claimed, \"The list of Jeffrey Epstein's clients is sitting on my desk.\" Her remark, quickly amplified by right-wing influencers, fueled weeks of speculation online and in MAGA circles."
                                            },
                                            {
                                                "example_id": "290b77f7-2774-4d86-bd2a-a9dd3930c815",
                                                "sense_id": "cb9da03a-1fa3-3ec2-a9d6-4d646f216185",
                                                "text": "Acutis, the London-born Italian who on Sunday will become the Catholic church’s first millennial saint, built websites to spread Catholic teaching, earning him the nickname “God’s Influencer” after his death, aged 15, from leukaemia."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
