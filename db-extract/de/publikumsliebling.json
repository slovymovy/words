                    {
                        "sense_id": "b7626068-7567-33a9-b156-97a991568a32",
                        "entry_id": "c0dfc33d-f898-3b6c-9b07-c4e97073ea57",
                        "glosses": [
                            "Person, die vom Publikum sehr gemocht wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "acd67a0f-f128-4966-8d37-e459f8837f72",
                                "sense_id": "b7626068-7567-33a9-b156-97a991568a32",
                                "text": "Durch seinen lockeren Humor wurde er zum Publikumsliebling."
                            },
                            {
                                "example_id": "616f0d20-42fe-405a-b031-7b64e6ee1ae2",
                                "sense_id": "b7626068-7567-33a9-b156-97a991568a32",
                                "text": "„Die Mitwirkung der Gesangsgruppe »Comedian Harmonists« wurde gestrichen, drei ihrer sechs Mitglieder sind Juden, aber die Publikumslieblinge Hermann Thimig, Hertha Thiele, Viktor de Kowa, Ida Wüst, Paul Henckels, Blandine Ebinger und Theo Lingen lassen auf einen guten Erfolg hoffen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bbe2e4ea-822a-4de1-9268-705cc5528bcc",
                        "source_entry_id": "c0dfc33d-f898-3b6c-9b07-c4e97073ea57",
                        "source_sense_id": "b7626068-7567-33a9-b156-97a991568a32",
