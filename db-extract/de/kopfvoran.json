        "de-extract.jsonl": [
            {
                "entry_id": "9f827585-dcaf-3a74-9818-29493a2a2396",
                "word": "kopfvoran",
                "pos": "adv",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "1a3361ef-565d-360e-bf15-ac9a983e0dfe",
                        "entry_id": "9f827585-dcaf-3a74-9818-29493a2a2396",
                        "glosses": [
                            "mit dem Kopf voran, mit dem Kopf zuerst"
                        ],
                        "tags": [
                            "Germany",
                            "Swiss Standard German",
                            "figurative",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "ccd831d6-4abb-40f6-adfc-3d9523020d1a",
                                "sense_id": "1a3361ef-565d-360e-bf15-ac9a983e0dfe",
                                "text": "„Aber Sicherheit und glaubwürdiger Schaden ließen sich von dort herab nicht verbinden. Wieder hinauf, zu hoch hinauf auf die zehnte Stufe, und endlich von der neunten Stufe hinab stürzte ich mich, ein Regal voller Flaschen mit Himbeersirup mitreißend, kopfvoran auf den Zementboden unseres Lagerkellers.“"
                            },
                            {
                                "example_id": "84ce20fe-ff7d-4a6d-bcf7-67e08c43304f",
                                "sense_id": "1a3361ef-565d-360e-bf15-ac9a983e0dfe",
                                "text": "„Er rast an mir vorbei, erwischt die Kante im unteren Teil des Hanges schlecht, stürzt kopfvoran auf die plattgewalzte, eisharte Piste und bleibt liegen. Schwere Kopfverletzungen durch Skiunfälle nehmen seit Jahren zu.“"
                            },
                            {
                                "example_id": "2b775c2c-0786-499e-8030-2d496167d647",
                                "sense_id": "1a3361ef-565d-360e-bf15-ac9a983e0dfe",
                                "text": "„Das Karussell ist 40 Meter hoch und kann eine Geschwindigkeit von bis zu 110 Stundenkilometern erreichen. Dabei kribbelt es im Bauch und das Adrenalin schießt durch den Körper, wenn man mit einem Affenzahn kopfvoran in die Tiefe stürzt.“"
                            },
                            {
                                "example_id": "6a8cca94-788e-4f5f-95f5-142602c3cc52",
                                "sense_id": "1a3361ef-565d-360e-bf15-ac9a983e0dfe",
                                "text": "„Wie die Stadtpolizei meldet, sprang der Mann von einem Holzsteg kopfvoran in den Fluss.“"
                            },
                            {
                                "example_id": "77b8cfb3-baf5-415f-a8ba-9572528bf236",
                                "sense_id": "1a3361ef-565d-360e-bf15-ac9a983e0dfe",
                                "text": "„Der Radfahrer konnte nicht mehr ausweichen und prallte nach dem Zusammenstoß kopfvoran gegen den Bordstein.“"
                            },
                            {
                                "example_id": "78fc640c-2cbe-4196-bd59-9fd6023b8c79",
                                "sense_id": "1a3361ef-565d-360e-bf15-ac9a983e0dfe",
                                "text": "„Die in Giesingen erlittenen Sturzblessuren sollten keine Probleme machen: ‚Da bin kopfvoran gegen ein Auto gefahren. Ohne Helm hätte ich jetzt andere Probleme…‘“"
                            },
                            {
                                "example_id": "8c45c4f1-0557-45e1-b820-580fe5285ea4",
                                "sense_id": "1a3361ef-565d-360e-bf15-ac9a983e0dfe",
                                "text": "„Die beiden Leichen waren am vergangenen Samstag am südlichen Rand des Lungernsees entdeckt und anschließend geborgen worden. Sie steckten kopfvoran einbetoniert in zwei Fässern, wie das Verhöramt Obwalden bestätigte.“"
                            },
                            {
                                "example_id": "02d26c23-cd56-48d9-94f8-696eac80701c",
                                "sense_id": "1a3361ef-565d-360e-bf15-ac9a983e0dfe",
                                "text": "übertragen: „Sowohl in den einsamen Buchten als auch dort, wo die Sommerfrischler Volleyball spielen und in realsozialistischer Sommerhüttenarchitektur Discos abhalten, landen die wenigen Baikalschiffe kopfvoran im flachen Sand und werfen ihre steilen Stege kopfüber an Land.“"
                            },
                            {
                                "example_id": "c51e7f5b-b005-4268-b536-9e11f15a800e",
                                "sense_id": "1a3361ef-565d-360e-bf15-ac9a983e0dfe",
                                "text": "„Es ist ein lieb gewonnenes Ritual, den Athleten rund um den Neujahrstag dabei zuzuschauen, wie sie sich mit 100 km/h kopfvoran von einem meterhohen Schanzentisch stürzen und auf einem unsichtbaren Luftpolster bis zu 140 Meter weit fliegen.“"
                            },
                            {
                                "example_id": "310ae7c4-e564-4810-84c5-4bbc75af2462",
                                "sense_id": "1a3361ef-565d-360e-bf15-ac9a983e0dfe",
                                "text": "„Eine müde Leichtigkeit ist im Schorsch, als er übers Feuer pinkelt, in unruhigen Spritzern, aber es kommt, kein Zeck am Pimmel, ein leichtes Lüftchen nur, und es ist nicht dieses Lüftchen, das ihn umbläst, nicht der Wein im Kopf, es ist der kleine Stolperstein am Bord, über den es ihn schlägt, kopfvoran auf den Boden knallt, dass es ihm den Schnauf nimmt.“"
                            },
                            {
                                "example_id": "f1e52cd1-e2c7-4816-a75a-307fa61b0105",
                                "sense_id": "1a3361ef-565d-360e-bf15-ac9a983e0dfe",
                                "text": "übertragen: „Ich werfe mein süsses Kleidchen von mir, ziehe mein aufregendstes Kleid an und stürze mich kopfvoran ins Nachtleben.“"
                            },
                            {
                                "example_id": "6f583c9b-37be-4875-a6ab-13dea96e2f75",
                                "sense_id": "1a3361ef-565d-360e-bf15-ac9a983e0dfe",
                                "text": "„Der Verschüttete befand sich kopfvoran einen halben Meter unter der Schneedecke und hatte noch das Snowboard an den Füssen.“"
                            },
                            {
                                "example_id": "583cf6f9-594f-4b08-9e4c-f2c43701ea9c",
                                "sense_id": "1a3361ef-565d-360e-bf15-ac9a983e0dfe",
                                "text": "„«Die Polizistin raste mit Blaulicht durch die Strassen, riss eine Vollbremsung, und einige Verhaftete prallten kopfvoran in eine Metallwand», protokollierte Rothen.“"
                            },
                            {
                                "example_id": "626f31ac-a317-458d-82c2-75e9e6a627e1",
                                "sense_id": "1a3361ef-565d-360e-bf15-ac9a983e0dfe",
                                "text": "„Keiner weiss, weshalb der 17-jährige Victor am 29. Mai 2005 am Ende der gelben Rutschbahn im Aquapark von Renens bei Lausanne plötzlich stoppte, aufstand und mit einem kräftigen Satz kopfvoran ins Wasser sprang.“"
                            },
                            {
                                "example_id": "348a1059-afe6-483f-a6fc-d8cf2308387e",
                                "sense_id": "1a3361ef-565d-360e-bf15-ac9a983e0dfe",
                                "text": "„Es flogen reihenweise Fahrer über die Zielkurve hinaus. Und der Spanier Andoni Aranaga blieb kopfvoran in der Abschrankung stecken.“"
                            },
                            {
                                "example_id": "6abde759-1525-44d0-9d82-55c87de3b637",
                                "sense_id": "1a3361ef-565d-360e-bf15-ac9a983e0dfe",
                                "text": "„Im Ortsteil Berg stürzte er kopfvoran eine Böschung hinunter und musste in der Folge mit einer Ambulanz ins Spital verbracht werden.“"
                            },
                            {
                                "example_id": "d5ebc59c-fb2b-4ae3-8893-3900ddb61f96",
                                "sense_id": "1a3361ef-565d-360e-bf15-ac9a983e0dfe",
                                "text": "„Bereits beim Abgang vom Stufenbarren war Tschussowitina nach einer eineinhalbfachen Drehung kopfvoran auf der Matte gelandet.“"
                            },
                            {
                                "example_id": "8649640f-cacb-4f91-834c-1b5f54c1b95f",
                                "sense_id": "1a3361ef-565d-360e-bf15-ac9a983e0dfe",
                                "text": "„Die Kollision ist heftig: Der Biker prallt mit der Brust gegen die Tür, fliegt darüber hinaus und landet kopfvoran auf der Fahrbahn.“"
                            },
                            {
                                "example_id": "218b02ce-d260-4ca1-b494-0bd1e72c547e",
                                "sense_id": "1a3361ef-565d-360e-bf15-ac9a983e0dfe",
                                "text": "„Die Polizei geht indes von Suizid aus: Wanjiru habe sich selbst kopfvoran in die Tiefe gestürzt.“"
                            },
                            {
                                "example_id": "5cecd027-a294-4e0e-950d-6664709c3692",
                                "sense_id": "1a3361ef-565d-360e-bf15-ac9a983e0dfe",
                                "text": "„Es ist Zeit für den 12.20-Uhr-Kurs, wie die Badehungrigen die Fahrt stromaufwärts zum Tinguely-Museum nennen, wo sie später alle vom Boot aus kopfvoran in den Fluss springen werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
