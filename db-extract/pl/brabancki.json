                                        "entry_id": "e3d75839-b3fa-3fa5-8e19-cfc396f2d27b",
                                        "glosses": [
                                            "Dialecte du néerlandais, parlé dans le Brabant."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
