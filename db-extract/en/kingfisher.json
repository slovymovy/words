                        "source_entry_id": "08f9c824-67f4-3f52-af17-f122b414eba2",
                        "source_sense_description": "any of various birds of the suborder Alcedines",
                        "target_lang_word": "зиморо́док",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
