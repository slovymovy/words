{
    "word": "drawcard",
    "lang_code": "en",
    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "26fc348a-8c54-391e-9392-97b55862bb8d",
                "word": "drawcard",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "85c2703b-36ef-494c-b82d-8881cb080c2b",
                        "entry_id": "26fc348a-8c54-391e-9392-97b55862bb8d",
                        "tags": [
                            "plural"
                        ],
                        "form": "drawcards"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9d0c1475-edab-3335-9b7d-97453f4b434d",
                        "entry_id": "26fc348a-8c54-391e-9392-97b55862bb8d",
                        "glosses": [
                            "Something that attracts customers, visitors, spectators, etc. to a place or an event."
                        ],
                        "tags": [
                            "UK"
                        ],
                        "examples": [
                            {
                                "example_id": "adaabca9-6a9e-4baf-9d43-8153154647af",
                                "sense_id": "9d0c1475-edab-3335-9b7d-97453f4b434d",
                                "text": "I remember once in the professional theatre in Addis Ababa a certain actor had become a popular drawcard."
                            },
                            {
                                "example_id": "cf977be3-c2e0-43c9-ad2e-8c359a6450bb",
                                "sense_id": "9d0c1475-edab-3335-9b7d-97453f4b434d",
                                "text": "1998, The Bulletin, Issues 6138-6146, page 62,\nFalconry is another big drawcard at Hever and at other historical sites."
                            },
                            {
                                "example_id": "8a6f06eb-9276-4c5b-af9c-b2189170bde2",
                                "sense_id": "9d0c1475-edab-3335-9b7d-97453f4b434d",
                                "text": "The drawcard was a two-act comic revue written for the occasion, “Quatsch” (German, “Nonsense”)."
                            },
                            {
                                "example_id": "6a67e4ea-d96a-4fdb-8973-145f0ebba807",
                                "sense_id": "9d0c1475-edab-3335-9b7d-97453f4b434d",
                                "text": "A single trip might not seem particularly environmentally significant, but Norway′s environment remains one of its main drawcards and one that millions of travellers who visit Norway every year have a responsibility to protect."
                            },
                            {
                                "example_id": "f2dee617-f4ec-4914-89ba-4384af9db64e",
                                "sense_id": "9d0c1475-edab-3335-9b7d-97453f4b434d",
                                "text": "He was the defending champion, a proven drawcard and a player of the future."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ecae7a44-7302-4b14-8e6b-921d3ec9485d",
                        "source_entry_id": "26fc348a-8c54-391e-9392-97b55862bb8d",
                        "source_sense_id": "9d0c1475-edab-3335-9b7d-97453f4b434d",
                        "source_sense_description": "attraction to attend a place or an event",
                        "target_lang_word": "Attraktion",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Attraktion",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ab3cc3fd-0f3e-3b09-86f5-8232748589eb",
                                        "entry_id": "2d8e9d8a-8dcd-360d-add3-efcbf59c41f5",
                                        "glosses": [
                                            "besondere, anziehende Wirkung auf jemanden oder etwas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e7804fa-32f5-4894-ab40-554e0464b1ef",
                                                "sense_id": "ab3cc3fd-0f3e-3b09-86f5-8232748589eb",
                                                "text": "Die Attraktion der Gemeinde Unislaw dürfte die Skiliftanlage sein, die in die Steilböschung zur Weichsel hineingebaut wurde."
                                            },
                                            {
                                                "example_id": "cc2da313-539a-4905-b089-597a3b900ab9",
                                                "sense_id": "ab3cc3fd-0f3e-3b09-86f5-8232748589eb",
                                                "text": "„Wäre morgen die Sonne erkaltet, so bliebe die Attraktion auf der Erde bei sonst gleichbleibenden Umständen, was sie heute ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4c0bc6db-7038-39b1-a3be-57dea10b87aa",
                                        "entry_id": "2d8e9d8a-8dcd-360d-add3-efcbf59c41f5",
                                        "glosses": [
                                            "Stück, das auf Zuschauer eine besondere Anziehungskraft entfaltet"
                                        ],
                                        "tags": [
                                            "Theater"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "745f58c6-bc6c-482c-b3b0-7653378588fd",
                                                "sense_id": "4c0bc6db-7038-39b1-a3be-57dea10b87aa",
                                                "text": "Die Neuinszenierung erwies sich als eine ausgesprochene Attraktion."
                                            },
                                            {
                                                "example_id": "526625ba-c807-41f6-b184-f3085fa65537",
                                                "sense_id": "4c0bc6db-7038-39b1-a3be-57dea10b87aa",
                                                "text": "„Die künstlerischen Auftritte auf dieser Vagantenbühne, Exekutionen genannt, bei denen den Scharfrichtern Henkersknechte assistierten, zählten zu den unbestrittenen Attraktionen Münchens kurz nach der Jahrhundertwende.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "7ca09aa2-7adf-3bff-8139-51c152bd1807",
                                        "entry_id": "2d8e9d8a-8dcd-360d-add3-efcbf59c41f5",
                                        "glosses": [
                                            "besonders gut gehende Ware/eine besonders gut verkäufliche Ware"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b110ad4-c8ad-4eaf-87f3-826f73e3a9a7",
                                                "sense_id": "7ca09aa2-7adf-3bff-8139-51c152bd1807",
                                                "text": "Das Angebot von xy ist voller Attraktionen."
                                            },
                                            {
                                                "example_id": "bdad0f15-84e7-47fd-8ebb-2793c80107c0",
                                                "sense_id": "7ca09aa2-7adf-3bff-8139-51c152bd1807",
                                                "text": "„Nun sind touristische Attraktionen auf Lanzarote nicht eben zahlreich: ihre Zahl beläuft sich auf zwei.“"
                                            },
                                            {
                                                "example_id": "e7cc83ba-8a85-47a4-a0f8-5fa667fe0e6b",
                                                "sense_id": "7ca09aa2-7adf-3bff-8139-51c152bd1807",
                                                "text": "„Die große Attraktion des Eilands sind die heißen Quellen und das erfolgreich verbreitete Gerücht, dass diese eine ganz besondere Wirkung hätten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Attraktion",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f114d18e-dfe8-328f-be0a-049893391f80",
                                        "entry_id": "423838b1-3541-38a6-baf5-0442a9351760",
                                        "glosses": [
                                            "Anpassung untergeordneter („dominierter“) Laute, Bedeutungen oder grammatischer Formen an übergeordnete („dominierende“)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af02d23f-7fe7-4a15-afdf-335001ae2583",
                                                "sense_id": "f114d18e-dfe8-328f-be0a-049893391f80",
                                                "text": "Die Attraktion zeigt sich gelegentlich in Äußerungen wie „am stärksten betroffensten“, wobei der Superlativ „betroffensten“ als eine Anpassung an das vorhergehende „am stärksten“ interpretiert wird."
                                            },
                                            {
                                                "example_id": "721cb1f0-42de-47a2-82df-53f0e65ad89d",
                                                "sense_id": "f114d18e-dfe8-328f-be0a-049893391f80",
                                                "text": "Ähnliche Formen von Attraktion kommen auch innerhalb eines Wortes vor, etwa, wenn „nächstliegendst“ oder „schnellstmöglichst“ gebildet werden."
                                            },
                                            {
                                                "example_id": "51aa8ee9-3c07-433c-87fc-5afdb6d2a2f3",
                                                "sense_id": "f114d18e-dfe8-328f-be0a-049893391f80",
                                                "text": "„Oft tritt ein Relativpronomen, wenn es im A k k u s a t i v stehen sollte und sich auf einen Genitiv oder Dativ bezieht, ebenfalls in den G e n e t i v oder D a t i v (Attraktion oder Assimilation des R e l a t i v p r o n o m e n s.)“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "801adea7-ec88-49eb-aa33-54efd84d335b",
                        "source_entry_id": "26fc348a-8c54-391e-9392-97b55862bb8d",
                        "source_sense_id": "9d0c1475-edab-3335-9b7d-97453f4b434d",
                        "source_sense_description": "attraction to attend a place or an event",
                        "target_lang_word": "Vorzug",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vorzug",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "502a1e35-9f24-3616-ba6f-00c97f4d57c3",
                                        "entry_id": "10fe7d89-8d20-334c-883f-37b1a1ff9ea3",
                                        "glosses": [
                                            "eine Sache oder Person hat einen Vorrang"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7c909a3-ae6a-4322-9c7f-c48261075c26",
                                                "sense_id": "502a1e35-9f24-3616-ba6f-00c97f4d57c3",
                                                "text": "Im Einzelfall wird man jedoch entscheiden müssen, ob man der Allgemeinbetäubung oder der örtlichen Betäubung den Vorzug geben will."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "fcbc838f-5c7b-3bdd-9d34-4f8b66200ce2",
                                        "entry_id": "10fe7d89-8d20-334c-883f-37b1a1ff9ea3",
                                        "glosses": [
                                            "gute Eigenschaft einer Sache oder Person, die jene im Vergleich zu anderen besonders auszeichnet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "066bb7b0-f8bd-4f29-814c-e9b1350f6fc6",
                                                "sense_id": "fcbc838f-5c7b-3bdd-9d34-4f8b66200ce2",
                                                "text": "Und die Erzählung eines Einzelfalles hat den bedeutenden Vorzug der Anschaulichkeit."
                                            },
                                            {
                                                "example_id": "c86e3696-489c-49b8-b134-d1214b14ff11",
                                                "sense_id": "fcbc838f-5c7b-3bdd-9d34-4f8b66200ce2",
                                                "text": "„Eine Parteifreundin will einen alten Mann mit Krückstock von den Vorzügen der Sozialdemokratie überzeugen.“"
                                            },
                                            {
                                                "example_id": "eb106306-299e-48a5-bedf-4fb2eb2d87cd",
                                                "sense_id": "fcbc838f-5c7b-3bdd-9d34-4f8b66200ce2",
                                                "text": "„Wie schon Juliette, hält sie Justine eine Rede, um ihr die Vorzüge des Lasters auseinanderzusetzen.“"
                                            },
                                            {
                                                "example_id": "3b46b79d-389e-4378-858d-c35bf66ab294",
                                                "sense_id": "fcbc838f-5c7b-3bdd-9d34-4f8b66200ce2",
                                                "text": "„Bouvards Zimmer war gut gebohnert, hatte Vorhänge aus Perkal sowie Mahagonimöbel und besaß den Vorzug eines Balkons mit Blick auf den Fluß.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "9db184ff-2638-347a-aa46-7a43906d2c9a",
                                        "entry_id": "10fe7d89-8d20-334c-883f-37b1a1ff9ea3",
                                        "glosses": [
                                            "ein Vorrecht oder eine Vergünstigung besitzen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "95d48488-80cf-4c7a-b024-31692b00ddf7",
                                                "sense_id": "9db184ff-2638-347a-aa46-7a43906d2c9a",
                                                "text": "Vorzugsaktien beinhalten dagegen einen Vorzug gegenüber Stammaktien hinsichtlich der Ansprüche auf Dividende, Stimmrecht, Bezugsrecht oder Liquidationserlös."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "ea0e71d7-1bca-31f2-8f80-0193389a6a5d",
                                        "entry_id": "10fe7d89-8d20-334c-883f-37b1a1ff9ea3",
                                        "glosses": [
                                            "Auszeichnung, die jemand bei sehr guten Noten im Zeugnis erhält"
                                        ],
                                        "tags": [
                                            "Austrian German"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "ab2070f9-174e-3a4b-a081-9e6e78859471",
                                        "entry_id": "10fe7d89-8d20-334c-883f-37b1a1ff9ea3",
                                        "glosses": [
                                            "Zug, der vor dem fahrplanmäßigen Zug eingesetzt wird, um diesen zu entlasten"
                                        ],
                                        "tags": [
                                            "Eisenbahn"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1c7515e6-df60-48a8-95e4-62738b63bec5",
                                                "sense_id": "ab2070f9-174e-3a4b-a081-9e6e78859471",
                                                "text": "Der Vorzug fährt um 7.45 ab Hauptbahnhof."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "a6be38e9-8fe9-3fc3-a911-32149508e4c5",
                                        "entry_id": "10fe7d89-8d20-334c-883f-37b1a1ff9ea3",
                                        "glosses": [
                                            "der Weg, den das Abzugszüngel bis zum Erreichen des Druckpunktes zurücklegt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e94de5ac-2f3b-4ea8-bc69-c58aafcb1288",
                                                "sense_id": "a6be38e9-8fe9-3fc3-a911-32149508e4c5",
                                                "text": "Dieser Abzug bietet Vorteile für Sportschützen, da erst ein leichter Vorzug bis zum Druckpunkt erfolgt, so das sich der Abzugsfinger am Züngel anlehnen kann und erst nach Überwinden des Druckpunktes, mit seinem genau definierbarem Abzugswiderstand, der Schuß bricht."
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "da7dc623-2334-4fe5-9cd9-8d5d71db9f5a",
