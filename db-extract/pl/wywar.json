                "senses": [
                    {
                        "sense_id": "1b8e05a8-12a5-3a3e-a179-001229113dd5",
                        "entry_id": "b092f5a9-c0e0-396c-aa2b-aedecdc5995b",
                        "glosses": [
                            "ciecz powstała po ugotowaniu warzyw, mięsa lub ryb"
                        ],
                        "tags": [],
