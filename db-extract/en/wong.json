                        "sense_id": "761d913c-e333-3a0e-aa3b-ebc39ee2964c",
                        "entry_id": "1f42554a-13eb-37b9-b171-06a1a2bb7afa",
                        "glosses": [
                            "A Chinese surname from Cantonese."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "829baf2c-bffe-433c-8bdb-1eb8cdf8e8b7",
                                "sense_id": "761d913c-e333-3a0e-aa3b-ebc39ee2964c",
                                "text": "Would Mr. Kim prefer that our biracial protagonists leave Master Wong to die? Is he ignoring the fact they save him with skills the master taught them?"
                            },
                            {
                                "example_id": "f30ada78-819d-4bd5-b007-e09d034c2219",
                                "sense_id": "761d913c-e333-3a0e-aa3b-ebc39ee2964c",
                                "text": "But Hong Kong-based cross-media artist Victor Wong didn’t think the painting — which looks like a blurry oil painting of a man — was anything that revolutionary."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
