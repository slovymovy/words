            {
                "entry_id": "902648fa-a413-33c7-8c34-db8caef78059",
                "word": "spake",
                "pos": "verb",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "796a5477-2409-3ada-8fba-fa17f021188c",
                        "entry_id": "902648fa-a413-33c7-8c34-db8caef78059",
                        "glosses": [
                            "simple past of speak"
                        ],
                        "tags": [
                            "archaic",
                            "form-of",
                            "past"
                        ],
                        "examples": [
                            {
                                "example_id": "210f9c5c-2bd6-4d23-b492-9de97ab939dc",
                                "sense_id": "796a5477-2409-3ada-8fba-fa17f021188c",
                                "text": "But at last his heart changed,—and rising one morning with the rosy dawn, he went before the sun, and spake thus unto it: Thou great star! What would be thy happiness if thou hadst not those for whom thou shinest!"
                            },
                            {
                                "example_id": "92a46763-2575-4ac3-98f8-d6666adb1264",
                                "sense_id": "796a5477-2409-3ada-8fba-fa17f021188c",
                                "text": "And God ſpake vnto Noah, ſaying, / Goe foorth of the Arke, thou, and thy wife, and thy ſonnes, and thy ſonnes wiues with thee:[…]"
                            },
                            {
                                "example_id": "dab13de6-ed3f-4c4f-b5c6-70cdfa59d333",
                                "sense_id": "796a5477-2409-3ada-8fba-fa17f021188c",
                                "text": "He answered me with pleasure and surprise; / And there was, while he spake, a fire about his eyes."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
