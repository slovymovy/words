                "senses": [
                    {
                        "sense_id": "5dda96d0-f568-3776-939a-2944d348f9a5",
                        "entry_id": "88210ac6-61ba-3715-986b-0b8c7376590e",
                        "glosses": [
                            "Qui a le comportement d’un homme de guerre brutal et grossier."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "882e164a-312b-46f7-b1e1-7d93998c60bc",
                                "sense_id": "5dda96d0-f568-3776-939a-2944d348f9a5",
                                "text": "Leurs franchises soudardes cachaient un délicieux trouble de cœur ; et c’était, en même temps qu’un regret, une espérance."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "6f239ce2-7cbb-3ebc-a3f7-8c9b0670855b",
                "word": "soudard",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "297b44f4-150e-49fe-96ff-65ab9856cf80",
                        "entry_id": "6f239ce2-7cbb-3ebc-a3f7-8c9b0670855b",
                        "tags": [
                            "plural"
                        ],
                        "form": "soudards"
                    },
                    {
                        "form_id": "58ecc7e3-1aff-4580-932f-56ffc3381958",
                        "entry_id": "6f239ce2-7cbb-3ebc-a3f7-8c9b0670855b",
                        "tags": [
                            "feminine"
                        ],
                        "form": "soudarde"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a03b01f6-7708-31b6-b0d7-68dadcb5a17a",
                        "entry_id": "6f239ce2-7cbb-3ebc-a3f7-8c9b0670855b",
                        "glosses": [
                            "Homme qui a longtemps servi à la guerre et qui est brutal, grossier."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "45a5b768-c368-478c-a813-aba825310daf",
                                "sense_id": "a03b01f6-7708-31b6-b0d7-68dadcb5a17a",
                                "text": "Peu s’en fallut que ne pleurassent\nLes soudards et les écoliers\nEnfants, voici les bœufs qui passent,\nCachez vos rouges tabliers ;"
                            },
                            {
                                "example_id": "890f7683-7095-4fde-bfc8-4f24831be490",
                                "sense_id": "a03b01f6-7708-31b6-b0d7-68dadcb5a17a",
                                "text": "— D’ailleurs, cette petite, hé ! bien, nous la verrons, dit le colonel d’un air goguenard et profondément scélérat qui montrait à un homme de la trempe de Vinet combien une petite fille était peu de chose aux yeux de ce soudard."
                            },
                            {
                                "example_id": "dbcd617b-9a7f-4973-966f-5005df8df921",
                                "sense_id": "a03b01f6-7708-31b6-b0d7-68dadcb5a17a",
                                "text": "Ce qu’il voit encore, ce sont des soudards qui, […], criblent de coups d’arquebuse un oiseau de bois fiché à la pointe d’un mai."
                            },
                            {
                                "example_id": "7b9c273d-5c3f-42ea-bb90-3dc0c81589a1",
                                "sense_id": "a03b01f6-7708-31b6-b0d7-68dadcb5a17a",
                                "text": "Gnassingbé Eyadema : champion de lutte, puis soudard de la coloniale en Algérie (où il mania la gégène)."
                            }
                        ]
                    },
                    {
                        "sense_id": "b6951c8a-058f-32d3-837a-e02d808327c7",
                        "entry_id": "6f239ce2-7cbb-3ebc-a3f7-8c9b0670855b",
                        "glosses": [
                            "Soldat, mercenaire, homme de troupe rémunéré."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "9fc14a1d-3c40-487e-8cfd-f9762e2d1b10",
                                "sense_id": "b6951c8a-058f-32d3-837a-e02d808327c7",
                                "text": "Et puis donna à chasque bende force moutons pour sacrifier, et cinquante drachmes d'argent à chaque soudard."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "939c6cbe-a06e-4499-9ce1-b98d571b9574",
                        "source_entry_id": "6f239ce2-7cbb-3ebc-a3f7-8c9b0670855b",
                        "target_lang_word": "roughneck",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "roughneck",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8025ae92-81eb-3564-bad2-4084f4116ad6",
                                        "entry_id": "26ec127b-a362-3290-a50e-505eebf90a75",
                                        "glosses": [
                                            "Someone with rough manners; a rowdy or uncouth person."
                                        ],
                                        "tags": [
                                            "US",
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9a681681-ea4c-4b38-9e65-784c44f3864a",
                                                "sense_id": "8025ae92-81eb-3564-bad2-4084f4116ad6",
                                                "text": "LaTisha has long wanted to show Carole sheʼs not the roughneck she used to be, the roughneck who wasnʼt good enough to be her friend."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5d67fc06-ae11-37ae-8795-645365eff893",
                                        "entry_id": "26ec127b-a362-3290-a50e-505eebf90a75",
                                        "glosses": [
                                            "An ironworker; a dirty or low-paid worker, a labourer."
                                        ],
                                        "tags": [
                                            "US",
                                            "colloquial"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "76186293-8ce2-3ced-9fc3-7ac1109ad9e9",
                                        "entry_id": "26ec127b-a362-3290-a50e-505eebf90a75",
                                        "glosses": [
                                            "A labourer on an oil rig."
                                        ],
                                        "tags": [
                                            "US",
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "026e553b-70d3-4d57-8f7c-acc57b3d2cb0",
                                                "sense_id": "76186293-8ce2-3ced-9fc3-7ac1109ad9e9",
                                                "text": "This first ship had a small geophysical-type drilling rig mounted over the side of the ship with a steel grid runround for the roughnecks, who stood in knee-deep water while making connections or pulling the drill string."
                                            },
                                            {
                                                "example_id": "33637872-ad17-429b-aeb6-bca760bd778c",
                                                "sense_id": "76186293-8ce2-3ced-9fc3-7ac1109ad9e9",
                                                "text": "As for the minerals, there has been a good deal of drilling along the big river; trucks and roughnecks no longer garner any notice."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "roughneck",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0443e8a7-4666-364a-b674-bc95391e3bd1",
                                        "entry_id": "cf1019db-806a-3602-8615-7c3c9a4e6192",
                                        "glosses": [
                                            "To work as a laborer on an oil rig."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b59f497-11bc-4778-8548-ce73e6fd07cb",
                                                "sense_id": "0443e8a7-4666-364a-b674-bc95391e3bd1",
                                                "text": "There was a time not long ago when this region appeared as some enduring mystification, its citizenry best known for roughnecking on the North Slope […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
