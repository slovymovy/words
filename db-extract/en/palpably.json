                                "sense_id": "0d024743-8f70-3d08-b751-f2a0dbb287ed",
                                "text": "God was palpably present in the country, and the devil had gone with the world to town."
                            },
                            {
                                "example_id": "77298c8d-f8fc-489c-a5fd-cb185936ca22",
                                "sense_id": "0d024743-8f70-3d08-b751-f2a0dbb287ed",
                                "text": "In the case of senior police or government officials who were palpably guilty of serving Nazi interests via the puppet regimes that employed them, this defence was at best disingenuous."
                            }
                        ]
                    }
