                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5362eb87-6097-43e9-ad70-96c02066cdd5",
                                                "sense_id": "56514c75-996d-3731-9b78-a6cfde2b35db",
                                                "text": "Manny had a coronary last week, followed by a triple bypass."
                                            },
                                            {
                                                "example_id": "15499b31-af93-4530-a68b-2a20a5ca2973",
                                                "sense_id": "56514c75-996d-3731-9b78-a6cfde2b35db",
                                                "text": "Before each crisis I mentioned, we first experienced what could be called a “mild” heart attack, alerting us that we had gone to extremes and stripped away buffers that had protected us from catastrophic failure. In each case, though, we did not take that warning seriously enough — and in each case the result was a full global coronary."
                                            }
                                        ]
                                    },
