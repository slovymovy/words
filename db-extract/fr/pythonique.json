                                    {
                                        "sense_id": "07878258-8334-36c8-8598-d78389891ec1",
                                        "entry_id": "0eef0563-334b-3a2e-9f41-40c8059a25e7",
                                        "glosses": [
                                            "Enormous; also, monstrous."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8d205c55-30cd-37bd-a39c-961653fd7564",
                                        "entry_id": "0eef0563-334b-3a2e-9f41-40c8059a25e7",
                                        "glosses": [
                                            "Using the idioms of the Python programming language."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b19b02a0-8dae-4a0a-b5f1-7af75a61e616",
                                                "sense_id": "8d205c55-30cd-37bd-a39c-961653fd7564",
                                                "text": "The Pythonic style isn't regimented or enforced by the compiler. It has emerged over time through experience using the language and working with others."
                                            },
                                            {
                                                "example_id": "03422243-6c4f-477c-81ec-2eacb6bca1b7",
                                                "sense_id": "8d205c55-30cd-37bd-a39c-961653fd7564",
                                                "text": "Pythonic code—when you first hear of it, you might think it is a programming paradigm, similar to object-oriented or functional programming. While some of it could be considered as such, it is actually more of a design philosophy."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
