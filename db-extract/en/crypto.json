                    {
                        "sense_id": "e396a60c-03ef-30bc-b5e0-a22aea5a99c2",
                        "entry_id": "b8345a06-84a1-3416-b923-2aa4e97fa42a",
                        "glosses": [
                            "Technologie de crypto-jeton ou de cryptomonnaie."
                        ],
