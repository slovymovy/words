                "senses": [
                    {
                        "sense_id": "2f2def10-104c-352c-ab10-acbe18ac7cac",
                        "entry_id": "09091787-0430-39e5-a206-15422850eff6",
                        "glosses": [
                            "Ph.D.; doutorado"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd03232a-26a6-4a04-85ba-4be517e9690a",
                                "sense_id": "2f2def10-104c-352c-ab10-acbe18ac7cac",
                                "text": "At the start of the 20th century, U.S. universities were held in low regard internationally, and many American students were still traveling to Europe for PhDs.",
                                "translation": "No começo do século XX, as universidades norte-americanas tinham pouco prestígio internacionalmente, e muitos estudantes ainda viajavam para a Europa para obter doutorados."
                            },
                            {
                                "example_id": "03c692b2-e4ea-42b2-acc7-5f9cf03b508e",
                                "sense_id": "2f2def10-104c-352c-ab10-acbe18ac7cac",
                                "text": "He received his PhD in Economics at Harvard University.",
                                "translation": "Ele recebeu seu doutorado em economia na Universidade de Harvard."
                            }
                        ]
                    },
                    {
                        "sense_id": "ccb35cdc-54fd-365d-9573-8983bb94827e",
                        "entry_id": "09091787-0430-39e5-a206-15422850eff6",
                        "glosses": [
                            "doutor; pessoa que possui um título de doutorado"
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "08f163d3-5593-4323-a3ef-d2b7f3d32633",
                                "sense_id": "ccb35cdc-54fd-365d-9573-8983bb94827e",
                                "text": "She's a PhD in genetic engineering.",
                                "translation": "Ela tem doutorado em engenharia genética."
                            }
                        ]
                    }
