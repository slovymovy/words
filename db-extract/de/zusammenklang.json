                "senses": [
                    {
                        "sense_id": "f0ca5057-7566-3fc7-8bb0-cb72fddd49b4",
                        "entry_id": "70e3f6e2-c8de-31f0-9483-d8f9f9f0daf0",
                        "glosses": [
                            "gleichzeitiges, harmonisches Erklingen mehrerer Töne; Akkord"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "770210bc-8c66-4d5b-bac9-7554133c7675",
                                "sense_id": "f0ca5057-7566-3fc7-8bb0-cb72fddd49b4",
                                "text": "„Für die musikalische Komposition sind harmonische Regeln zu beachten, damit der Zusammenklang stimmig ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "5626668e-aaf3-38ee-b683-b6f13f1e2da1",
                        "entry_id": "70e3f6e2-c8de-31f0-9483-d8f9f9f0daf0",
                        "glosses": [
                            "Einklang, Übereinstimmung mit etwas"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "02cac429-fb5c-449e-a26f-a032167462ce",
                                "sense_id": "5626668e-aaf3-38ee-b683-b6f13f1e2da1",
                                "text": "„Den Anfangspunkt beim Lieben, den seelisch-körperlichen Zusammenklang, kann ich nicht beschreiben.“"
                            },
                            {
                                "example_id": "e86e2b3c-eab2-4c03-98a3-060341f64636",
                                "sense_id": "5626668e-aaf3-38ee-b683-b6f13f1e2da1",
                                "text": "„Aber unsere Welt ist nicht ungestört, sie wird in ihrem Zusammenklang beeinträchtigt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
