                                "target_senses": [
                                    {
                                        "sense_id": "0a613a4e-2bf1-3510-af3c-42d9d7998b66",
                                        "entry_id": "fc667377-859f-3c07-aaac-926e1438aebb",
                                        "glosses": [
                                            "Prénom féminin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b43c1298-46ba-4d60-a997-3c38448bc207",
                                                "sense_id": "0a613a4e-2bf1-3510-af3c-42d9d7998b66",
                                                "text": "Je suis très étonnée que la nouvelle — elle s'appelle Océane, pas Arielle, mais au moins ma mère restait dans le thème marin ! — soit assise à côté de moi."
                                            },
                                            {
                                                "example_id": "89bf6607-4d26-4354-b553-fc8d1037166a",
                                                "sense_id": "0a613a4e-2bf1-3510-af3c-42d9d7998b66",
                                                "text": "Océane Dodin a connu le même sort face à la Tunisienne Ons Jabeur, nᵒ 7 mondiale (6-2, 6-3)."
                                            },
                                            {
                                                "example_id": "c6dce1be-d299-4d65-9ddf-5629878db39e",
                                                "sense_id": "0a613a4e-2bf1-3510-af3c-42d9d7998b66",
                                                "text": "La jeune Royannaise a eu la préférence du jury, devant deux autres jeunes filles de 17 ans, Talia Gilson, de Saujon, 1ʳᵉ dauphine, et Océane Tardy, de Royan, 2ᵉ dauphine."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Océane",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5889cb28-c4d8-3847-aefe-0e70f0a4b5b4",
                                        "entry_id": "65f94957-5aad-36bf-885b-5d4fbf6661cc",
                                        "glosses": [
                                            "Nom donné par la marque automobile Simca à un modèle de cabriolet produit de 1956 à 1962."
                                        ],
                                        "tags": [
                                            "Marque commerciale"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "21b8e8a7-daee-465d-9956-e5fedb30f67b",
                                                "sense_id": "5889cb28-c4d8-3847-aefe-0e70f0a4b5b4",
                                                "text": "Je suis monté dans ma voiture, une Simca Océane décapotable verte. J’ai abaissé la capote, pensant me précipiter dans la Seine. J’ai fini la nuit sous leurs fenêtres, garé sur le parking de leur HLM de banlieue."
                                            },
                                            {
                                                "example_id": "7d2a2dba-929d-4307-8d77-56d402190c5a",
                                                "sense_id": "5889cb28-c4d8-3847-aefe-0e70f0a4b5b4",
                                                "text": "Durant plusieurs mois, j’ai sillonné la France et j’ai vu sept Océane avant de dénicher, à Aurillac, celle que je possède. J’adore sa forme, elle est très agréable à conduire et lorsque je me balade à son volant, elle attire beaucoup les regards."
                                            },
                                            {
                                                "example_id": "90601c95-22ca-4971-953c-8db85a9f7e32",
                                                "sense_id": "5889cb28-c4d8-3847-aefe-0e70f0a4b5b4",
                                                "text": "Au Salon 1956, une jeune actrice, Anne-Marie Persen pose sur le stand habillée en sirène. Sa tenue est même dessinée avec des petites Océane et Plein Ciel."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
