                                    {
                                        "sense_id": "f8453497-d99d-3580-8f60-f97ba2fffa2f",
                                        "entry_id": "25441a3a-c789-3f5f-8179-78f8a88343d9",
                                        "glosses": [
                                            "With a sweet taste or aroma."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0677ee9e-3127-34a3-8ace-9d4d315fd7d7",
                                        "entry_id": "25441a3a-c789-3f5f-8179-78f8a88343d9",
                                        "glosses": [
                                            "In a sweet or pleasant manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "26ca52ae-1735-4262-ab6d-f9c26571689f",
                                                "sense_id": "0677ee9e-3127-34a3-8ace-9d4d315fd7d7",
                                                "text": "\"No, Auntie,\" said Hardman, sweetly, seriously."
                                            },
                                            {
                                                "example_id": "69b6ef63-b713-456e-b00a-14fd3ea4ef0d",
                                                "sense_id": "0677ee9e-3127-34a3-8ace-9d4d315fd7d7",
                                                "text": "\"Hey, Sis, do yah want a Hertz Donut?\" one of them sweetly said as the other one held out a donut bag. She reached for it. Her step-sister snatched the bag away and socked her hard in the arm instead.\n\"Hurts, Don't it?\" they chime, laughing at her pain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea674bfc-6fb9-36ba-ba08-2c5496ff67fd",
                                        "entry_id": "25441a3a-c789-3f5f-8179-78f8a88343d9",
                                        "glosses": [
                                            "Nicely; finely; excellently."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "39bec685-8dba-49fd-8cde-a1b3c239415f",
                                                "sense_id": "ea674bfc-6fb9-36ba-ba08-2c5496ff67fd",
                                                "text": "Sitting in the seat with the engine off before that day, the gears slid in so sweetly, and double de-clutching was so easy, I had done it a million times."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
