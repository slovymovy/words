                "senses": [
                    {
                        "sense_id": "c9c4b84f-bc81-3c76-bb20-aedf6a8b72e9",
                        "entry_id": "c605859c-8420-38ed-b123-94779fb1b33c",
                        "glosses": [
                            "wissenschaftliches Experiment, mit dem der Welle-Teilchen-Dualismus gezeigt werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "449a0a93-0c90-4881-8490-c74178723928",
                                "sense_id": "c9c4b84f-bc81-3c76-bb20-aedf6a8b72e9",
                                "text": "Thomas Young führte im Jahr 1802 erstmals das Doppelspaltexperiment durch."
                            },
                            {
                                "example_id": "97eb0683-602e-4105-969f-182c766aeaa1",
                                "sense_id": "c9c4b84f-bc81-3c76-bb20-aedf6a8b72e9",
                                "text": "„Korrekterweise müsse es heissen, die Photonen im Doppelspaltexperiment verhielten sich im Mittel so, als folgten sie den rekonstruierten Pfaden, so Kofler.“"
                            },
                            {
                                "example_id": "99b44586-c51f-4a49-9a8b-5893d4654e80",
                                "sense_id": "c9c4b84f-bc81-3c76-bb20-aedf6a8b72e9",
                                "text": "„Silvia Arroyo Camejo nahm das als Ermunterung. Frohgemut spaziert sie vom berühmten Doppelspaltexperiment zum Compton-Effekt und weiter zu Schrödingers Katze, die zugleich lebendig und tot ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
