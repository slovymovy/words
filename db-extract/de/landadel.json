                        "examples": [
                            {
                                "example_id": "8f74bc30-bac5-4b99-9fdf-9eab1f32db15",
                                "sense_id": "946c40a7-bcda-3f3a-9cb1-e05f1074eb98",
                                "text": "„Die Biografie über die sechs schrägen Mitford-Schwestern aus dem englischen Landadel ist absolut lesenswert: ein rasanter Familienroman und gleichzeitig ein Zeitzeugnis des 20. Jahrhunderts.“"
                            },
                            {
                                "example_id": "83e49371-7236-4223-abe8-e6ca18a1f36b",
                                "sense_id": "946c40a7-bcda-3f3a-9cb1-e05f1074eb98",
                                "text": "„Dieser Salon ist ein Bijou sondergleichen – ein unbezifferbar wertvolles Zeugnis feinster Wohnkultur wohlhabenden Landadels am Übergang von der Renaissance zum Barock.“"
                            }
                        ],
