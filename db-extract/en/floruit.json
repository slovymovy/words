                                                "sense_id": "f1cf59f2-e0f4-3f20-8000-3ff8c29c8f27",
                                                "text": "In augustus hebben de paardenbloemen een tweede bloei."
                                            },
                                            {
                                                "example_id": "b1527276-8a04-4e45-b7f8-67f61a3df26a",
                                                "sense_id": "f1cf59f2-e0f4-3f20-8000-3ff8c29c8f27",
                                                "text": "Nee, het pluis is afkomstig van populieren en komt pas vrij na de bloei van deze bomen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f925669f-cbed-3f2e-8cac-4ae08091d359",
                                        "entry_id": "52b75575-15df-3204-b197-7253f1b0b2e4",
                                        "glosses": [
