        "nl-extract.jsonl": [
            {
                "entry_id": "b3f04e79-9c43-3b69-bdbb-e69c282baea5",
                "word": "bedriegerij",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "c9104b13-eec2-4b62-a45b-b254a2cfdfb1",
                        "entry_id": "b3f04e79-9c43-3b69-bdbb-e69c282baea5",
                        "tags": [
                            "plural"
                        ],
                        "form": "bedriegerijen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9e15537a-e0ce-3c9c-a255-debddf673ba7",
                        "entry_id": "b3f04e79-9c43-3b69-bdbb-e69c282baea5",
                        "glosses": [
                            "het iemand met kwade bedoelingen in de waan brengen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "479503da-5e6f-447a-8c30-c183f7fca3d9",
                                "sense_id": "9e15537a-e0ce-3c9c-a255-debddf673ba7",
                                "text": "Het stopzetten van de zogenoemde Fondsen ter ondersteuning van de coalitie maakt deel uit van een bredere opschorting van de hulp aan Pakistan die president Donald Trump begin dit jaar aankondigde, toen hij Pakistan ervan beschuldigde eerdere hulp te belonen met „niets dan leugens en bedriegerij.”"
                            },
                            {
                                "example_id": "c4597bdd-b796-44bd-8ee5-ef590e3a49dd",
                                "sense_id": "9e15537a-e0ce-3c9c-a255-debddf673ba7",
                                "text": "Er werd geen reden gegeven voor het opschorten van de onderhandelingen, die inmiddels al drie dagen duren. Eerder op de avond stormde Giorgos Karatzaferis, leider van een kleine rechtse partij, de vergaderzaal uit en beschuldigde de leiders van de twee grootste partijen van 'bedriegerij'."
                            },
                            {
                                "example_id": "a7d4ee4f-97ac-45ff-957d-212d2c36ba3f",
                                "sense_id": "9e15537a-e0ce-3c9c-a255-debddf673ba7",
                                "text": ",,Dit is bedriegerij. Het maakt dan niet uit of de keeper de bal wel of niet oppakt. Hij heeft ongepaste manieren gebruikt om de spelregels te omzeilen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "82d66257-fd3c-4300-ae56-e8895b1d681a",
                        "source_entry_id": "b3f04e79-9c43-3b69-bdbb-e69c282baea5",
                        "source_sense_id": "9e15537a-e0ce-3c9c-a255-debddf673ba7",
                        "target_lang_word": "trickery",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "trickery",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "325a3bfc-3b18-338b-9f3e-7f930ebe3a14",
                                        "entry_id": "b1b463da-bb13-3283-8f90-fb0185249771",
                                        "glosses": [
                                            "Deception, deceit or underhanded behavior."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "871907d6-e92c-4c39-8de2-45e79bdc6b6d",
                                                "sense_id": "325a3bfc-3b18-338b-9f3e-7f930ebe3a14",
                                                "text": "[H]e did not wrap his rugged subject in silks and ermines, and other sickly trickeries of phrase."
                                            },
                                            {
                                                "example_id": "e9436b22-cc9b-4f75-9b0e-c58ed05a1925",
                                                "sense_id": "325a3bfc-3b18-338b-9f3e-7f930ebe3a14",
                                                "text": "In trickery, evasion, procrastination, spoliation, botheration, under false pretences of all sorts, there are influences that can never come to good."
                                            },
                                            {
                                                "example_id": "0615eac1-3a39-4bec-b197-27e7e4e05478",
                                                "sense_id": "325a3bfc-3b18-338b-9f3e-7f930ebe3a14",
                                                "text": "The miners found diversions even in his alleged frauds and trickeries . . . and were fond of relating with great gusto his evasion of the Foreign Miners' Tax."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "66879016-362f-3471-a02f-535f32de41aa",
                                        "entry_id": "b1b463da-bb13-3283-8f90-fb0185249771",
                                        "glosses": [
                                            "The art of dressing up; imposture, pretense."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dcd77d8c-a31a-3e6b-9db1-225598845646",
                                        "entry_id": "b1b463da-bb13-3283-8f90-fb0185249771",
                                        "glosses": [
                                            "Artifice; the use of one or more stratagems."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b1336742-b3e2-4753-b71c-f427588189a1",
                                                "sense_id": "dcd77d8c-a31a-3e6b-9db1-225598845646",
                                                "text": "French winger Hatem Ben Arfa has also taken plenty of plaudits recently and he was the architect of the opening goal with some superb trickery on the left touchline."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "12d96a60-4410-4439-8d4b-5ed765461485",
                        "source_entry_id": "b3f04e79-9c43-3b69-bdbb-e69c282baea5",
                        "source_sense_id": "9e15537a-e0ce-3c9c-a255-debddf673ba7",
                        "target_lang_word": "swindling",
