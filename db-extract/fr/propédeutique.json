            {
                "entry_id": "4bb57236-de7b-3f6e-b8fd-172d40095a88",
                "word": "propédeutique",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "b9b4a64b-aa4e-48b1-81e3-62a4a67ce48c",
                        "entry_id": "4bb57236-de7b-3f6e-b8fd-172d40095a88",
                        "tags": [
