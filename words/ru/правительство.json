            "pos": "noun",
            "senses": [
                {
                    "sense_id": "199e73d0-fa46-3bc3-8e18-7d3ce4e3db2c",
                    "sense_definition": "Высший исполнительный и распорядительный орган государственной власти в стране.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Новое <w>правительство</w> обещало снизить налоги для малого бизнеса.",
                            "target_lang_translations": {
                                "en": "The new <w>government</w> promised to lower taxes for small businesses.",
                                "zh": "新<w>政府</w>承诺为小企业减税。"
                            }
                        },
                        {
                            "text": "Глава <w>правительства</w> выступил с важным заявлением по телевидению.",
                            "target_lang_translations": {
                                "en": "The head of <w>government</w> made an important statement on television.",
                                "zh": "<w>政府</w>首脑在电视上发表了重要声明。"
                            }
                        }
                    ],
                    "synonyms": [
                        "власть",
                        "кабинет"
                    ],
                    "antonyms": [
                        "оппозиция"
                    ],
                    "common_phrases": [
                        "глава правительства",
                        "члены правительства",
                        "сформировать правительство",
                        "отставка правительства",
                        "заседание правительства"
                    ],
                    "target_lang_definitions": {
                        "en": "The highest executive and administrative body of state power in a country.",
                        "zh": "国家最高行政机关，负责执行法律和管理国家事务。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "government",
                                "target_lang_sense_clarification": "political authority"
                            },
                            {
                                "target_lang_word": "administration",
                                "target_lang_sense_clarification": "executive body"
                            },
                            {
                                "target_lang_word": "cabinet",
                                "target_lang_sense_clarification": "council of ministers"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "政府",
                                "target_lang_sense_clarification": "国家行政机关"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6b04e60d-ee6b-3824-89dc-89453bd62eb6",
                    "sense_definition": "Время правления или царствования кого-либо.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В <w>правительство</w> Бориса Годунова в стране начался голод.",
                            "target_lang_translations": {
                                "en": "During the <w>reign</w> of Boris Godunov, a famine began in the country.",
                                "zh": "在鲍里斯·戈杜诺夫的<w>统治时期</w>，国内发生了饥荒。"
                            }
                        },
                        {
                            "text": "Многие важные реформы были проведены в <w>правительство</w> этого императора.",
                            "target_lang_translations": {
                                "en": "Many important reforms were carried out during the <w>rule</w> of this emperor.",
                                "zh": "许多重要的改革都是在这位皇帝的<w>统治时期</w>进行的。"
                            }
                        }
                    ],
                    "synonyms": [
                        "власть"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The period of time during which a specific person rules or reigns (archaic).",
                        "zh": "指某人统治或在位的时期（古语）。"
                    },
