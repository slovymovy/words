                        "entry_id": "e6b3b952-e9c4-3d49-b6f8-a9a3013e9298",
                        "glosses": [
                            "Titre de courtoisie anglais donné aux descendants par primogéniture de chevaliers (knight)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "58419a33-e830-4302-98e1-bbdf3967a311",
                                "sense_id": "1ab24039-95ae-3958-92f8-8e7c6fcc5fea",
                                "text": "« Vous êtes Phileas Fogg, esquire ? demanda-t-il. Oui, monsieur, répondit le gentleman. »"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "afd29016-2714-4d51-84da-a16b941953cb",
                        "source_entry_id": "e6b3b952-e9c4-3d49-b6f8-a9a3013e9298",
                        "target_lang_word": "esquire",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "esquire",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "47ff8148-e651-35c2-b785-f97daf6c5efa",
                                        "entry_id": "ca6beb16-e664-335b-9bb0-db64db1c3da2",
                                        "glosses": [
                                            "A lawyer."
                                        ],
                                        "tags": [
                                            "US",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "75ca66ef-da62-3953-addd-816056cb423a",
                                        "entry_id": "ca6beb16-e664-335b-9bb0-db64db1c3da2",
                                        "glosses": [
                                            "A male member of the gentry ranking below a knight."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5db0ec95-68c6-4143-924c-b370f5ccd28d",
                                                "sense_id": "75ca66ef-da62-3953-addd-816056cb423a",
                                                "text": "I am Robert Shallow, sir; a poor esquire of the county, and one of the king's justices of the peace."
                                            },
                                            {
                                                "example_id": "089f884f-8256-4e01-9360-288a14202d77",
                                                "sense_id": "75ca66ef-da62-3953-addd-816056cb423a",
                                                "text": "Esquires and gentlemen are confounded together by Sir Edward Coke, who observes that every esquire is a gentleman, and a gentleman is defined to be one qui arma gerit, who bears coat-armour, the grant of which was thought to add gentility to a man's family. It is indeed a matter somewhat unsettled what constitutes the distinction, or who is a real esquire; for no estate, however large, per se confers this rank upon its owner."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c10d0403-98db-38de-9904-77ad23dd4363",
                                        "entry_id": "ca6beb16-e664-335b-9bb0-db64db1c3da2",
                                        "glosses": [
                                            "An honorific sometimes placed after a man's name."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fd7ad5f7-3ac4-3d1c-abde-82323b196a66",
                                        "entry_id": "ca6beb16-e664-335b-9bb0-db64db1c3da2",
                                        "glosses": [
                                            "A gentleman who attends or escorts a lady in public."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "52075ca3-badc-3308-b70d-e9f0e136e713",
                                        "entry_id": "ca6beb16-e664-335b-9bb0-db64db1c3da2",
                                        "glosses": [
                                            "A squire; a youth who in the hopes of becoming a knight attended upon a knight"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ab1428f3-e38c-3f43-a482-ca09875f0453",
                                        "entry_id": "ca6beb16-e664-335b-9bb0-db64db1c3da2",
                                        "glosses": [
                                            "A shield-bearer, but also applied to other attendants."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "852fbf15-a195-40b5-b662-d1dab8b1a629",
                                                "sense_id": "ab1428f3-e38c-3f43-a482-ca09875f0453",
                                                "text": "The office of the esquire consisted of several departments; the esquire for the body, the esquire of the chamber, the esquire of the stable, and the carving esquire; the latter stood in the hall at dinner, carved the different dishes, and distributed them to the guests."
                                            }
                                        ]
                                    }
                                ]
                            },
