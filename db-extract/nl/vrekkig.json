                ],
                "senses": [
                    {
                        "sense_id": "45785e16-131c-3e0b-9e3d-6e05ecca5902",
                        "entry_id": "30afe4af-d34a-3165-87fb-b057a320afa0",
                        "glosses": [
                            "miserly, avaricious"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c5135d6-764e-45ce-bbfb-a45c6db3f896",
                                "sense_id": "45785e16-131c-3e0b-9e3d-6e05ecca5902",
                                "text": "Hij staat bekend als een vrekkige man die nooit geld uitgeeft.",
                                "translation": "He is known as a miserly man who never spends money.",
                                "english": "He is known as a miserly man who never spends money."
                            },
                            {
                                "example_id": "993a7906-71e6-4dcb-84d0-9c73fad011f0",
                                "sense_id": "45785e16-131c-3e0b-9e3d-6e05ecca5902",
                                "text": "De vrekkige buurman weigert zijn geld uit te lenen aan anderen.",
                                "translation": "The avaricious neighbor refuses to lend his money to others.",
                                "english": "The avaricious neighbor refuses to lend his money to others."
                            },
                            {
                                "example_id": "fdb11185-c9ce-4efe-9279-d33e866ed925",
                                "sense_id": "45785e16-131c-3e0b-9e3d-6e05ecca5902",
                                "text": "Ze heeft een vrekkige houding als het gaat om het delen van haar bezittingen.",
                                "translation": "She has a miserly attitude when it comes to sharing her belongings.",
                                "english": "She has a miserly attitude when it comes to sharing her belongings."
                            }
                        ]
                    }
                ],
