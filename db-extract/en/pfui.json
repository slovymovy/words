    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "d5cafd45-4d50-322a-9dc2-5b56a1085303",
                "word": "pfui",
                "pos": "intj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "e964c28c-d86f-302e-b875-9e5c841ec9e9",
                        "entry_id": "d5cafd45-4d50-322a-9dc2-5b56a1085303",
                        "glosses": [
                            "an exclamation indicating disagreement or rejection of an argument; contempt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a443b1d6-1a86-4568-827a-f8ffb600dcbc",
                                "sense_id": "e964c28c-d86f-302e-b875-9e5c841ec9e9",
                                "text": "'Pfui!' The captain spat. 'I've never met such a dumb sailor as you. So where do you think the old moon goes?'"
                            },
                            {
                                "example_id": "23f71f95-82bf-4ea8-acc5-389295b71231",
                                "sense_id": "e964c28c-d86f-302e-b875-9e5c841ec9e9",
                                "text": "She liked Arschlochweh and adored Improvisation; but the Anatomiestunde and the bending and stretching she did not like. \"Pfui!\" she was disgusted, lifting her shoulders and spreading her hands like the Mandarin, \"pfui! the old body!'"
                            },
                            {
                                "example_id": "ea5ba87e-2f91-4fcd-b454-3172d4a701bf",
                                "sense_id": "e964c28c-d86f-302e-b875-9e5c841ec9e9",
                                "text": "He comes barging in here as if the place belonged to him. And intoxicated . . . pfui! . . . the disgusting pig!"
                            }
                        ]
                    }
                ],
                "translations": [],
