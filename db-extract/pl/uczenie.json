                                            {
                                                "example_id": "94e43686-e2b6-4df4-bc1d-6f89dd47ac36",
                                                "sense_id": "fb060ea9-81ed-3546-801f-33f11cdb1c5f",
                                                "text": "„Er soll ja nicht bloßer Fachmensch, oder wie der Student das so treffend nennt: kein Fachsimpel sein; das gibt später im Leben die bornierten Spezialisten, die einseitigen Juristen oder Oberlehrer, aber keine allgemein gebildete, keine wirklich wissenschaftliche, überhaupt keine gebildete Menschen.“"
                                            },
                                            {
                                                "example_id": "82a8dbc6-289a-43fc-80bf-5a1339e55b9a",
                                                "sense_id": "fb060ea9-81ed-3546-801f-33f11cdb1c5f",
                                                "text": "„Alle öffentlichen und privaten Bauverwaltungen, welche von Juristen oder Unternehmern geleitet sind, stützen sich auf fachbeschränkt gebildete Techniker, […]“"
                                            },
                                            {
                                                "example_id": "e98a3a5d-38fd-4514-a28d-474f7fc59656",
                                                "sense_id": "fb060ea9-81ed-3546-801f-33f11cdb1c5f",
                                                "text": "Mein Gesprächspartner war sehr gebildet."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
