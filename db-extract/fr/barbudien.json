                "senses": [
                    {
                        "sense_id": "1ac131ec-95f8-3dbf-87a8-4720c687ba83",
                        "entry_id": "30479aeb-7ce5-3c77-a18c-d88eb7769fad",
                        "glosses": [
                            "Habitant ou originaire de l’île de Barbuda."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "77b690a9-d913-4e10-b10b-9eafb387133b",
                                "sense_id": "1ac131ec-95f8-3dbf-87a8-4720c687ba83",
                                "text": "Ainsi, les réticences des habitants de l’île minuscule de Barbuda pour partager leur indépendance avec Antigua sont profondément ancrées dans le passé esclavagiste, durant lequel les Barbudiens, malgré ou plutôt à cause de la pauvreté naturelle de l’île, ont « joui » d’un traitement plus favorable que les esclaves d’Antigua qui a permis la constitution d’une profonde identité communautaire."
                            },
                            {
                                "example_id": "10d33756-ad6a-4ed7-af07-5dfdc6f8bbe7",
                                "sense_id": "1ac131ec-95f8-3dbf-87a8-4720c687ba83",
                                "text": "Les Barbudiens sont devenus des réfugiés climatiques, condamnés à rester sur l'île voisine d'Antigua."
                            }
                        ]
                    },
                    {
                        "sense_id": "5588cc67-89de-3b4a-9879-94490c59eca0",
