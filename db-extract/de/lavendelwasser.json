                        "form": "die Lavendelwässer"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0e74e205-83e4-30c9-9002-1fb32f85559c",
                        "entry_id": "9219a069-e9f7-37d8-8004-8fb51ff538b2",
                        "glosses": [
                            "Parfüm mit Lavendelöl als Duftstoff"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "052007aa-9045-47b3-96ae-0ab573523cf5",
                                "sense_id": "0e74e205-83e4-30c9-9002-1fb32f85559c",
                                "text": "„Wenn man für eine Reise packt, lohnt es sich, Taschen und Koffer von innen und außen mit ein wenig Lavendelwasser zu besprühen.“"
                            },
                            {
                                "example_id": "8c3de024-1bef-496e-9d06-1e5f671d2499",
                                "sense_id": "0e74e205-83e4-30c9-9002-1fb32f85559c",
                                "text": "„Sie kehrte mit einem sauberen Handtuch zurück und stellte eine Waschschüssel und eine kleine Schüssel mit Lavendelwasser vor ihm auf den Tisch.“"
                            },
                            {
                                "example_id": "bed648a0-aa6c-46bd-bb3b-e0712a990d4b",
                                "sense_id": "0e74e205-83e4-30c9-9002-1fb32f85559c",
                                "text": "„Und ich fragte mich, ob das Lavendelwasser, nach dem es immer noch duftete, dich ebenso beruhigte wie mich.“"
                            },
                            {
                                "example_id": "f71465cf-95e9-40ce-8b22-ef47cbfbdf9a",
                                "sense_id": "0e74e205-83e4-30c9-9002-1fb32f85559c",
                                "text": "„Anna goß Lavendelwasser in das Waschbecken, es war ein angenehmer, frischer Geruch.“"
                            },
                            {
                                "example_id": "75d39d0f-615f-4f6a-946e-f801bade8b5b",
                                "sense_id": "0e74e205-83e4-30c9-9002-1fb32f85559c",
                                "text": "„Allenthalben hingen hier Käfige mit Kanarienvögeln darin, sodass die Luft gleichermaßen von Vogelgesang wie von dem Geruch von Kohlenrauch und Lavendelwasser erfüllt war.“"
                            },
                            {
                                "example_id": "16bb0d63-9d09-4db5-ba27-b02d62c8e6f9",
                                "sense_id": "0e74e205-83e4-30c9-9002-1fb32f85559c",
                                "text": "„Seit dieser Zeit finden sich Nachweise für erste Lavendelwässer in London.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
