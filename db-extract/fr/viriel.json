                                        "entry_id": "ead405d7-9e7c-357a-ba33-45dfc8c178fe",
                                        "glosses": [
                                            "One-half of the product of the stress of attraction or repulsion with the distance between two particles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "45d07629-b228-4141-96af-ad7d80f9fd93",
                                                "sense_id": "2b8cdfce-418b-38c7-a7bc-d4c065680a72",
                                                "text": "The quantity 1/2 Rr, or half the product of the attraction into the distance across which the attraction is exerted, is defined by Clausis [Prof. Clausis of Bonn] as the virial of the attraction. (In the case of pressure or repulsion, the virial is negative.)"
                                            }
