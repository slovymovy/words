            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3858d52f-eab2-3ea4-a5f1-95cfc68279a0",
                    "sense_definition": "iets traag doen of tijd verspillen; langzaam zijn met handelen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "traagheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Als je blijft <w>treuzelen</w>, gaan we de bus naar school missen.",
                            "target_lang_translations": {
                                "de": "Wenn du weiter <w>trödelst</w>, verpassen wir den Schulbus."
                            }
                        },
                        {
                            "text": "De kinderen <w>treuzelden</w> met het aantrekken van hun schoenen en jassen.",
                            "target_lang_translations": {
                                "de": "Die Kinder <w>trödelten</w> beim Anziehen ihrer Schuhe und Jacken."
                            }
                        }
                    ],
                    "synonyms": [
                        "dralen",
                        "talmen",
                        "dreutelen",
                        "lanterfanten"
                    ],
                    "antonyms": [
                        "opschieten",
                        "haasten"
                    ],
                    "common_phrases": [
                        "niet treuzelen"
                    ],
                    "target_lang_definitions": {
                        "de": "etwas sehr langsam tun oder Zeit vertrödeln; langsam handeln"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "trödeln",
                                "target_lang_sense_clarification": "allgemein für langsam machen, Zeit verlieren"
                            },
                            {
                                "target_lang_word": "bummeln",
                                "target_lang_sense_clarification": "nicht vorankommen, sich viel Zeit lassen"
                            },
                            {
                                "target_lang_word": "trödeln/bummeln",
                                "target_lang_sense_clarification": "umgangssprachlich für Zeit verschwenden"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ecad81ef-4ccf-30f8-8f02-47a8db8cd1b1",
                    "sense_definition": "aarzelen om actie te ondernemen of een beslissing uitstellen",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "traagheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De regering mag niet langer <w>treuzelen</w> met het nemen van maatregelen.",
                            "target_lang_translations": {
                                "de": "Die Regierung darf nicht länger damit <w>zögern</w>, Maßnahmen zu ergreifen."
                            }
                        },
                        {
                            "text": "Hij bleef bij de deur <w>treuzelen</w> omdat hij niet naar binnen durfde te gaan.",
                            "target_lang_translations": {
                                "de": "Er <w>zögerte</w> an der Tür, weil er sich nicht hineintraute."
                            }
                        }
                    ],
                    "synonyms": [
                        "aarzelen",
                        "dralen",
                        "talmen"
                    ],
                    "common_phrases": [
                        "blijven treuzelen"
                    ],
                    "target_lang_definitions": {
                        "de": "zögern, tätig zu werden, oder eine Entscheidung aufschieben"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "zögern",
                                "target_lang_sense_clarification": "eine Handlung oder Entscheidung hinausschieben"
                            },
                            {
                                "target_lang_word": "zaudern",
                                "target_lang_sense_clarification": "gehoben für unentschlossen abwarten"
                            },
                            {
                                "target_lang_word": "hinauszögern",
                                "target_lang_sense_clarification": "eine Aktion verzögern"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cfeb0221-7038-3714-9f11-88c3af4256d7",
                    "sense_definition": "zeer nauwgezet maar traag en tijdrovend werken aan details",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij <w>treuzelde</w> urenlang over een minuscuul detail in de tekening.",
                            "target_lang_translations": {
                                "de": "Er <w>hielt sich</w> stundenlang an einem winzigen Detail in der Zeichnung <w>auf</w>."
                            }
                        },
                        {
                            "text": "Door al dat <w>treuzelen</w> raakte het project ver achter op schema.",
                            "target_lang_translations": {
                                "de": "Durch all die <w>Trödelei</w> geriet das Projekt weit in Verzug."
                            }
                        }
                    ],
                    "synonyms": [
                        "beuzelen",
                        "teuten",
                        "klungelen"
                    ],
                    "target_lang_definitions": {
                        "de": "sich mit zeitraubenden Kleinigkeiten oder Details aufhalten"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "sich aufhalten",
                                "target_lang_sense_clarification": "an Details hängenbleiben und Zeit verlieren"
                            },
                            {
                                "target_lang_word": "herumtrödeln",
                                "target_lang_sense_clarification": "unproduktiv an Kleinigkeiten arbeiten"
                            },
                            {
                                "target_lang_word": "fieseln",
                                "target_lang_sense_clarification": "umgangssprachlich für zeitraubend an Details basteln"
                            }
                        ]
                    }
                }
            ]
        }
    ]
