                "senses": [
                    {
                        "sense_id": "9fa2b75d-0e55-37ac-9af1-1960fa9b1093",
                        "entry_id": "4e3482c6-14d0-3dc9-bd3d-3b3e25c7ac75",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a331e6ef-a7e4-418c-ba16-b4308999dc76",
                                "sense_id": "9fa2b75d-0e55-37ac-9af1-1960fa9b1093",
                                "text": "Frau Elkan ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "132ff268-c3f4-446f-9bda-567a53baf760",
                                "sense_id": "9fa2b75d-0e55-37ac-9af1-1960fa9b1093",
                                "text": "Herr Elkan wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "6e25953d-57b9-4c43-8988-3fe63ea064b2",
                                "sense_id": "9fa2b75d-0e55-37ac-9af1-1960fa9b1093",
                                "text": "Die Elkans fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "b186951b-4e86-4070-929e-c7400fd61338",
                                "sense_id": "9fa2b75d-0e55-37ac-9af1-1960fa9b1093",
                                "text": "Der Elkan trägt nie die Schals, die die Elkan ihm strickt."
                            },
                            {
                                "example_id": "7e835536-c2de-4349-a51f-12507a8fdb51",
                                "sense_id": "9fa2b75d-0e55-37ac-9af1-1960fa9b1093",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Elkan kommt, geht der Herr Elkan.“"
                            },
                            {
                                "example_id": "33b54167-feac-48e6-a535-aef8429f2142",
                                "sense_id": "9fa2b75d-0e55-37ac-9af1-1960fa9b1093",
                                "text": "Elkan kommt und geht."
                            },
                            {
                                "example_id": "95947565-4b6d-4d06-9e36-7033d649309e",
                                "sense_id": "9fa2b75d-0e55-37ac-9af1-1960fa9b1093",
                                "text": "Elkans kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
