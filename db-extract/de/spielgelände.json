                "senses": [
                    {
                        "sense_id": "a18b83bb-a861-36c6-9c87-d8ed2c7d5cd3",
                        "entry_id": "2f561df8-09db-3718-9b9a-63ce5d9bb500",
                        "glosses": [
                            "Räumlichkeit oder Fläche, die zum Spielen geeignet oder speziell hergerichtet ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "de59b65e-8b5d-4d63-a7f5-f39b87defbb9",
                                "sense_id": "a18b83bb-a861-36c6-9c87-d8ed2c7d5cd3",
                                "text": "„Durch die Verwendung variabler und transportabler Geräte, wie […] in Verbindung mit der vorhandenen Ausstattung kann hier Spielmonotonie aufgebrochen und die Attraktivität dieser Spielgelände für Bewegungen und Aktionen erhöht werden.“"
                            },
                            {
                                "example_id": "d85ded95-c304-4cce-8fdc-e8585930bf74",
                                "sense_id": "a18b83bb-a861-36c6-9c87-d8ed2c7d5cd3",
                                "text": "„Die Spielbeschreibungen gehen von sechs Grundsituationen aus, die sich durch ihre räumlich-materiellen Gegebenheiten unterscheiden in Spielobjekte, Spielfläche, Musik, Spielgelände, Eis und Schnee, Wasser.“"
                            },
                            {
                                "example_id": "1e69a5a5-7a3d-4b2f-8d67-cb56879c951c",
                                "sense_id": "a18b83bb-a861-36c6-9c87-d8ed2c7d5cd3",
                                "text": "„Hof, Garten, Wiese, Wald bieten ansprechende Spielgelände.“"
                            },
                            {
                                "example_id": "db5c357d-a9d2-437f-a2d3-8a7d7385c77b",
                                "sense_id": "a18b83bb-a861-36c6-9c87-d8ed2c7d5cd3",
                                "text": "„Die mehr als zwanzig Kinderheime und Privatschulen sind von Gärten und Spielgelände umgeben.“"
                            },
                            {
                                "example_id": "5ea9f32c-7ca8-4774-a429-ec77000cae59",
                                "sense_id": "a18b83bb-a861-36c6-9c87-d8ed2c7d5cd3",
                                "text": "„Im Frühjahr soll das Spielgelände am Heinzegraben fertig sein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
