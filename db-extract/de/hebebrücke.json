                "senses": [
                    {
                        "sense_id": "03d18d62-7abf-3ddf-a06f-fd69f956d897",
                        "entry_id": "c0e3434b-84de-3a87-8ca7-486e3baec5d1",
                        "glosses": [
                            "bewegliche Brücke, die durch waagrechtes Anheben bei Bedarf eine größere Durchfahrtshöhe für Schiffe schafft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d5e5fa74-9e18-4657-ae49-ab0f04538db9",
                                "sense_id": "03d18d62-7abf-3ddf-a06f-fd69f956d897",
                                "text": "„Als triebe sie Frühsport, stemmt die alte Hebebrücke bei Lindaunis schläfrig ihr gewaltiges Gegengewicht in die Höhe.“"
                            },
                            {
                                "example_id": "d1705821-b1a6-4413-9736-c661d2ca56d8",
                                "sense_id": "03d18d62-7abf-3ddf-a06f-fd69f956d897",
                                "text": "„Die Brücke ist eine von fünf Straßenbrücken über die Hunte, die im Bereich der Stadt Oldenburg den teilweise kanalisierten Fluss überqueren, und die einzige Hebebrücke in Oldenburg.“"
                            }
                        ],
