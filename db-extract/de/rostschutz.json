                        ],
                        "form": "dem Rostschutz"
                    },
                    {
                        "form_id": "6006dec8-c5fa-49f6-9dad-91fd0bd76e6c",
                        "entry_id": "8ac9fc70-613a-34b6-8495-da2ac527bc27",
                        "tags": [
                            "accusative",
