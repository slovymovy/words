                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "28d83437-03b0-39ff-8a55-b34d157b4dd6",
                                        "entry_id": "352dd874-e51c-3be5-9085-383b05b42458",
                                        "glosses": [
                                            "De gran dimensión o impacto; extraordinario."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "45c3a3f8-127a-4e6d-abdf-55e2a47fcb36",
                                                "sense_id": "28d83437-03b0-39ff-8a55-b34d157b4dd6",
                                                "text": "El clamoroso éxito y popularidad que alcanzó Plauto con sus comedias contrastan con los escasísimos datos que tenemos sobre su biografía."
                                            }
                                        ],
