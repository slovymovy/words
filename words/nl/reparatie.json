    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d2ac4c88-df16-36dc-b5d4-21e94b383b54",
                    "sense_definition": "Het herstellen van iets dat kapot of beschadigd is zodat het weer werkt.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "herstel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>reparatie</w> van mijn fiets duurde langer dan ik had verwacht.",
                            "target_lang_translations": {
                                "en": "The <w>repair</w> of my bike took longer than I had expected.",
                                "ru": "<w>Ремонт</w> моего велосипеда занял больше времени, чем я ожидал.",
                                "zh": "我自行车的<w>修理</w>花的时间比我预想的要长。"
                            }
                        },
                        {
                            "text": "Hij bracht zijn auto naar de garage voor een noodzakelijke <w>reparatie</w>.",
                            "target_lang_translations": {
                                "en": "He brought his car to the garage for a necessary <w>repair</w>.",
                                "ru": "Он отвез свою машину в автосервис для необходимого <w>ремонта</w>.",
                                "zh": "他把车送到修车厂进行必要的<w>维修</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "herstelling"
                    ],
                    "common_phrases": [
                        "in reparatie",
                        "kleine reparatie",
                        "reparatie uitvoeren"
                    ],
                    "target_lang_definitions": {
                        "en": "The act of restoring something broken or damaged so that it works again.",
                        "ru": "Восстановление чего-либо сломанного или поврежденного до рабочего состояния.",
                        "zh": "将损坏或出故障的物品修复，使其恢复正常功能。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "repair",
                                "target_lang_sense_clarification": "act of fixing something"
                            },
                            {
                                "target_lang_word": "fix",
                                "target_lang_sense_clarification": "informal repair"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "ремонт",
                                "target_lang_sense_clarification": "восстановление исправности"
                            },
                            {
                                "target_lang_word": "починка",
                                "target_lang_sense_clarification": "устранение поломки"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "修理",
                                "target_lang_sense_clarification": "使破损或故障物体恢复原状或功能"
                            },
                            {
                                "target_lang_word": "维修",
                                "target_lang_sense_clarification": "维护与修理"
                            },
                            {
                                "target_lang_word": "修补",
                                "target_lang_sense_clarification": "修理破损之处"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8d1399b7-1004-3937-b0b2-7254c4e8b6be",
                    "sense_definition": "Een vergoeding of compensatie voor geleden schade of onrecht.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "vergoeding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het land moest na de oorlog een aanzienlijke financiële <w>reparatie</w> betalen.",
                            "target_lang_translations": {
                                "en": "The country had to pay significant financial <w>reparations</w> after the war.",
                                "ru": "После войны страна должна была выплатить значительную финансовую <w>репарацию</w>.",
                                "zh": "战后该国必须支付巨额的经济<w>赔偿</w>。"
                            }
                        },
                        {
                            "text": "De slachtoffers vroegen om een passende <w>reparatie</w> voor het aangedane leed.",
                            "target_lang_translations": {
                                "en": "The victims asked for appropriate <w>reparation</w> for the suffering caused.",
                                "ru": "Жертвы требовали соответствующей <w>компенсации</w> за причиненные страдания.",
                                "zh": "受害者要求对所遭受的痛苦给予适当的<w>赔偿</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A reimbursement or compensation for damage suffered or injustice.",
                        "ru": "Возмещение или компенсация за понесенный ущерб или несправедливость.",
                        "zh": "对所受损失或不公对待的赔偿或补偿。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "reparation",
                                "target_lang_sense_clarification": "amends for wrong or injury"
                            },
                            {
                                "target_lang_word": "compensation",
                                "target_lang_sense_clarification": "payment for loss or damage"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "репарация",
                                "target_lang_sense_clarification": "возмещение ущерба государством"
                            },
                            {
                                "target_lang_word": "компенсация",
                                "target_lang_sense_clarification": "возмещение убытков"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "赔偿",
                                "target_lang_sense_clarification": "对损失或损害的补偿"
                            },
                            {
                                "target_lang_word": "赔款",
                                "target_lang_sense_clarification": "尤指战败国向战胜国支付的钱财"
                            },
                            {
                                "target_lang_word": "弥补",
                                "target_lang_sense_clarification": "补偿或补救过失与损害"
                            }
                        ]
                    }
                }
            ]
        }
    ]
