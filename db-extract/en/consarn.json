                        "examples": [
                            {
                                "example_id": "3467755c-09a9-44fe-8aeb-e6b9cee41a18",
                                "sense_id": "191af8d0-15f6-377e-88d3-c6df18efdb71",
                                "text": "Consarn it, Jarius, you are a hog, and no mistake."
                            },
                            {
                                "example_id": "0b3fdbab-348b-4179-b790-9a22a3200079",
                                "sense_id": "191af8d0-15f6-377e-88d3-c6df18efdb71",
                                "text": "Consarn ye, take thet ! \" And he banged each of the inoffensive animals in the sides with the stock of his gun"
                            },
                            {
                                "example_id": "a06d2ba3-8470-4ff8-b9c7-ef5d3e995367",
                                "sense_id": "191af8d0-15f6-377e-88d3-c6df18efdb71",
                                "text": "\"Leggo my whiskers, consarn ye!\" it shouted."
                            },
                            {
                                "example_id": "94943c93-394b-4462-83bc-a514c030ae96",
                                "sense_id": "191af8d0-15f6-377e-88d3-c6df18efdb71",
                                "text": "He came to camp follerin' this cat and a holloring, 'Here kitty-kitty-kitty' all over the consarned place."
                            },
                            {
                                "example_id": "4502e50f-2cdc-46ac-b443-871bf50f3914",
                                "sense_id": "191af8d0-15f6-377e-88d3-c6df18efdb71",
                                "text": "Why, consarn you, Anderson Crow, I didn't have any spare children to leave around on doorsteps."
                            }
                        ]
                    }
