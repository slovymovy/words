                ],
                "senses": [
                    {
                        "sense_id": "840afe8f-7a1f-375d-a31e-c7c1bde80280",
                        "entry_id": "5e0a9207-fa39-37d0-b878-d4e7a5943c2f",
                        "glosses": [
                            "die Zisterne einer Burg"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f3fd57b4-1b5c-4629-891d-d825a0cdf66a",
                                "sense_id": "840afe8f-7a1f-375d-a31e-c7c1bde80280",
                                "text": "„Vorbei an der Burgzisterne, die selbst in trocken-heißen Hochsommern Wasser führt, geht es auf schmalen Pfaden zum Hauptkamm.“"
                            },
                            {
                                "example_id": "9ddbc80a-18e4-4e42-b63c-c8d26816edad",
                                "sense_id": "840afe8f-7a1f-375d-a31e-c7c1bde80280",
                                "text": "„Auch die Burgzisterne hat's ihnen angetan, die zweifache Metallabdeckung verführt zum Draufklettern und Runterspickeln.“"
                            },
                            {
                                "example_id": "8603f503-6915-4144-a00f-75a5614046aa",
                                "sense_id": "840afe8f-7a1f-375d-a31e-c7c1bde80280",
                                "text": "„Kunstvolle Modelle der Anlagen Streithausen, Dorndorf, Molsberg, Neuerburg, Greifenstein, Hermannstein, Hachenburg, Montabaur und einer Burgzisterne, machen die Ausstellung besonders anschaulich.“"
                            },
                            {
                                "example_id": "0c574db3-07d5-42f9-a038-466af17ddf21",
                                "sense_id": "840afe8f-7a1f-375d-a31e-c7c1bde80280",
                                "text": "„In diesem Jahr hat sich der Initiativkreis \"Schloss Hartenfels\" die Wiederherstellung der mittelalterlichen Burgzisterne im Flügel C auf die Fahne geschrieben.“"
                            },
                            {
                                "example_id": "4d2859c5-6ddc-4a5e-8812-e5bada33f470",
                                "sense_id": "840afe8f-7a1f-375d-a31e-c7c1bde80280",
                                "text": "„Die Büchse wurde 1849 während der unter Jakob von Hefner-Alteneck und Johann Wilhelm Wolf im Auftrag Ludwigs III. durchgeführten Ausgrabung der Burg Tannenberg bei Darmstadt aufgefunden. Sie lag auf dem Grund der ehemaligen Burgzisterne und war unter den Trümmern des gesprengten Bergfriedes verschüttet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
