                    }
                ],
                "senses": [
                    {
                        "sense_id": "e45fab28-a69a-3773-82de-3c0db14b0f89",
                        "entry_id": "4ab7d722-b83c-30e9-8d35-280dd1009ec8",
                        "glosses": [
                            "громкий смех"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "20a2ce69-db04-4b63-8e1b-dc3e5434f42f",
                                "sense_id": "e45fab28-a69a-3773-82de-3c0db14b0f89",
                                "text": "В это время среди оставшихся у окон женщин раздался раскат хохота."
                            },
                            {
                                "example_id": "79bdaf77-fff6-4e11-8a23-e501e9cb86d1",
                                "sense_id": "e45fab28-a69a-3773-82de-3c0db14b0f89",
                                "text": "Женечка не могла слышать этого хохота, зажала уши руками и выбежала в соседнюю комнату."
                            }
                        ]
                    },
                    {
                        "sense_id": "a5e94f9a-a4a2-37ea-8d3f-8ed4ee69ba64",
                        "entry_id": "4ab7d722-b83c-30e9-8d35-280dd1009ec8",
                        "glosses": [
                            "крик некоторых птиц, животных (филина, куропатки, шакала и др.), похожий на громкий смех"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f77bc753-f039-4d1d-9eba-47196eb72ec5",
                                "sense_id": "a5e94f9a-a4a2-37ea-8d3f-8ed4ee69ba64",
                                "text": "Вдруг из-за этого неперестающего тихого шелеста послышался вой, визг, плач, хохот шакалов."
                            },
                            {
                                "example_id": "9a746fc8-5300-4480-97f2-0f23ff4374cd",
                                "sense_id": "a5e94f9a-a4a2-37ea-8d3f-8ed4ee69ba64",
                                "text": "Резкий крик птицы, треск сучьев под ногами дикой козы, хриплый хохот кукушки и сумеречное уханье филина — всё гулко отдавалось в лесах."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f53e428f-089d-4f21-b669-9798e38a9ee3",
                        "source_entry_id": "4ab7d722-b83c-30e9-8d35-280dd1009ec8",
                        "target_lang_word": "loud",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "loud",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "aef09838-4704-31b9-b535-1d5cff085af0",
                                        "entry_id": "0780379b-3621-3469-afd3-53f17cbe29b4",
                                        "glosses": [
                                            "Loudly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28ae66f8-e961-4418-870b-a896350246b8",
                                                "sense_id": "aef09838-4704-31b9-b535-1d5cff085af0",
                                                "text": "Who knocks so loud at door?"
                                            },
                                            {
                                                "example_id": "833a646a-6d5d-4674-97a9-c12623c98535",
                                                "sense_id": "aef09838-4704-31b9-b535-1d5cff085af0",
                                                "text": "Unluckily that worthy Officer having, in a literal Sense, taken his Fill of Liquor, had been some Time retired to his Bolster, where he was snoaring so loud, that it was not easy to convey a Noise in at his Ears capable of drowning that which issued from his Nostrils."
                                            },
                                            {
                                                "example_id": "ab0118dc-43dc-40b1-8a8c-68657523c859",
                                                "sense_id": "aef09838-4704-31b9-b535-1d5cff085af0",
                                                "text": "Money still talks — indeed, thanks in part to the Roberts court, it talks louder than ever. Still, ideas matter too, shaping both how we talk about society and, eventually, what we do."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "loud",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e9bd0492-625b-33c3-ba38-fea238c13101",
                                        "entry_id": "8e960d23-c6c6-3019-859d-1d0f07d63007",
                                        "glosses": [
                                            "Of great intensity."
                                        ],
                                        "tags": [
                                            "of a sound"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b6394e5a-ddd8-4fab-9147-dd8066251fa2",
                                                "sense_id": "e9bd0492-625b-33c3-ba38-fea238c13101",
                                                "text": "Turn that music down; it's too loud."
                                            },
                                            {
                                                "example_id": "9587004a-bda8-48a0-9e6f-41cd8139249d",
                                                "sense_id": "e9bd0492-625b-33c3-ba38-fea238c13101",
                                                "text": "What was that? It sounded like a really loud sneeze."
                                            },
                                            {
                                                "example_id": "c9054f37-ff74-4557-bd91-2f723ab05be1",
                                                "sense_id": "e9bd0492-625b-33c3-ba38-fea238c13101",
                                                "text": "Mr. Cooke at once began a tirade against the residents of Asquith for permitting a sandy and generally disgraceful condition of the roads. So roundly did he vituperate the inn management in particular, and with such a loud flow of words, that I trembled lest he should be heard on the veranda."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "968d22a4-ce36-3769-8ebb-bde61a024fac",
                                        "entry_id": "8e960d23-c6c6-3019-859d-1d0f07d63007",
                                        "glosses": [
                                            "Noisy."
                                        ],
                                        "tags": [
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9355af62-a752-481f-b195-13dd29d66cb9",
                                                "sense_id": "968d22a4-ce36-3769-8ebb-bde61a024fac",
                                                "text": "a loud party that went on all night"
                                            },
                                            {
                                                "example_id": "bd6473f6-a111-4736-8885-34ebd1ed9d61",
                                                "sense_id": "968d22a4-ce36-3769-8ebb-bde61a024fac",
                                                "text": "She is loud and stubborn."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e0c367cb-dc52-3345-9800-3e85164b4ea0",
                                        "entry_id": "8e960d23-c6c6-3019-859d-1d0f07d63007",
                                        "glosses": [
                                            "Not subtle or reserved, brash."
                                        ],
                                        "tags": [
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "950c741d-b50f-4f85-9ae3-878914172567",
                                                "sense_id": "e0c367cb-dc52-3345-9800-3e85164b4ea0",
                                                "text": "Some of the loudest blubberers are developers who, having made enormous profits as a result of local, state, and federal subsidies, complain that government doesn't do enough for them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cc3700c5-1609-3cdd-8e4f-f2057136a782",
                                        "entry_id": "8e960d23-c6c6-3019-859d-1d0f07d63007",
                                        "glosses": [
                                            "Having unpleasantly and tastelessly contrasting colours or patterns; gaudy."
                                        ],
                                        "tags": [
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "36e527c4-4572-46a9-909b-9cef5ef8a629",
                                                "sense_id": "cc3700c5-1609-3cdd-8e4f-f2057136a782",
                                                "text": "a loud style of dress; loud colors"
                                            },
                                            {
                                                "example_id": "970231f6-e715-475b-a3b4-415b6af675d3",
                                                "sense_id": "cc3700c5-1609-3cdd-8e4f-f2057136a782",
                                                "text": "In comparison with the loud Portrait of E.C. Ricart (ill. p. 13) two years earlier, Miró has captured a soft, hushed atmosphere here."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c4a7e38c-7b5a-3e61-a5fe-6a09bfa2186f",
                                        "entry_id": "8e960d23-c6c6-3019-859d-1d0f07d63007",
                                        "glosses": [
                                            "High-quality; premium; (by extension) having a strong or pungent odour indicating good quality."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "loud",
