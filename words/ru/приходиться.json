    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c3f9599f-efef-3f96-b9d1-d33db54bac3e",
                    "sense_definition": "быть вынужденным что-либо сделать",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "necessity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Нам <w>приходится</w> уходить очень быстро."
                        },
                        {
                            "text": "Если я это скажу, мне <w>придётся</w> тебя убить."
                        }
                    ]
                },
                {
                    "sense_id": "be8f03b0-b123-3463-878d-3f1136a6434e",
                    "sense_definition": "состоять в родственных отношениях с кем-либо",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "relation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он <w>приходится</w> мне двоюродным братом."
                        },
                        {
                            "text": "Кем она тебе <w>приходится</w>?"
                        }
                    ]
                },
                {
