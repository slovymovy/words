                "senses": [
                    {
                        "sense_id": "d1e73bac-1c4d-32fe-8899-a2d48fe9bba2",
                        "entry_id": "965ea61b-79ae-3f17-9c7d-c26fe2d93b51",
                        "glosses": [
                            "разг. широко улыбнуться, показав зубы"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6e3fdb2f-cfd2-45a8-a75c-586e43782e7f",
                                "sense_id": "d1e73bac-1c4d-32fe-8899-a2d48fe9bba2",
                                "text": "Как нарочно, Стебельков хитро и гадко осклабился и украдкой кивнул мне на князя."
                            },
                            {
                                "example_id": "638808fa-f5aa-41d2-a94f-62702bf1acae",
                                "sense_id": "d1e73bac-1c4d-32fe-8899-a2d48fe9bba2",
                                "text": "Гедеоновский осклабился, поклонился, взял двумя пальцами свою шляпу с аккуратно положенными на одном из ее полей перчатками и удалился вместе с Марьей Дмитриевной."
                            }
                        ]
                    }
