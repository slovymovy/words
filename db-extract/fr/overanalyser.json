                "senses": [
                    {
                        "sense_id": "4a16f017-96da-3080-a325-c6e397c71a7b",
                        "entry_id": "b3601c5c-df4b-38c1-a06e-b798513f2bd1",
                        "glosses": [
                            "Trop analyser, analyser avec excès."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f8db3101-2a3c-4b92-909d-9fdf7c74e713",
                                "sense_id": "4a16f017-96da-3080-a325-c6e397c71a7b",
                                "text": "Voir Fader overanalyser une chaine de shitpost me fait questionner l'humanité à nouveau"
                            },
                            {
                                "example_id": "d8ea2b0a-06d4-4259-85c0-dbd86455ba7c",
                                "sense_id": "4a16f017-96da-3080-a325-c6e397c71a7b",
                                "text": "Parler pour deconner pas pour overanalyser tel des critiques d'art de musée"
                            },
                            {
                                "example_id": "0781c16e-9bdc-4e46-b181-1af94e935cac",
                                "sense_id": "4a16f017-96da-3080-a325-c6e397c71a7b",
                                "text": "Moi aussi je prefere qu'on utilise mon prénom + que les pronoms neutres. Nan mais c'est clair jpp du genre >_< j'suis obligé de tout overanalyser et c'est fatiguant."
                            },
                            {
                                "example_id": "57065337-f36b-47c9-8415-19f8dcb6ecaa",
                                "sense_id": "4a16f017-96da-3080-a325-c6e397c71a7b",
                                "text": "@Guillaumeful La mienne aussi. En train d’overanalyser une pseudo-non conversation dans ma tete....issssssshhhhh"
                            }
                        ]
                    }
