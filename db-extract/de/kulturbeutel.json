                ],
                "senses": [
                    {
                        "sense_id": "4ad48249-3277-361f-a473-35058d4b00de",
                        "entry_id": "dd15ad8b-c634-3bfb-8fbb-7a3074bb3e36",
                        "glosses": [
                            "Tasche für Hygieneartikel (beispielsweise für einen Kamm, Deo, Seife, Rasierer)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "70db1428-f672-477b-9497-0a47f5f401b2",
                                "sense_id": "4ad48249-3277-361f-a473-35058d4b00de",
                                "text": "„In seinem Kulturbeutel war neben einer Flasche Shampoo ein kleiner elektronischer Zähler mit einem Druckknopf. Dieser Zähler kann als Ersatz für die Gebetskette verwendet werden.“"
                            },
                            {
                                "example_id": "1c8d5290-4c4b-4bdf-aec7-1e186548af57",
                                "sense_id": "4ad48249-3277-361f-a473-35058d4b00de",
                                "text": "„Es ist so sauber und rein, dass der Gast sogleich den Zahnpasta-Fleck auf seinem Kulturbeutel entfernt, bevor er ihn neben die Waschbecken stellt.“"
                            },
                            {
                                "example_id": "6eed3dde-ae10-4623-a5ee-5ce850bab2b9",
                                "sense_id": "4ad48249-3277-361f-a473-35058d4b00de",
                                "text": "„Einmal fanden sie in einem Hartschalenkoffer eine Katze, Grämmel sieht das Bild auf dem Schirm noch vor sich, als wäre es gestern gewesen: ein Kulturbeutel, ein paar Kleider, in der Ecke oben links zusammengerollt das Tier.“"
                            },
                            {
                                "example_id": "663c3799-e2e7-4dd8-a644-e3d3b6f02801",
                                "sense_id": "4ad48249-3277-361f-a473-35058d4b00de",
                                "text": "„Den sogenannten ‚Kulturbeutel‘ haben wir wohl den deutschen Parfumerieketten zu verdanken, die es sich auf dem heimischen Markt bequem machen.“"
                            },
                            {
                                "example_id": "0e81dd2d-975b-447a-84e9-5763df0a5d92",
                                "sense_id": "4ad48249-3277-361f-a473-35058d4b00de",
                                "text": "„Manche [Fußballspieler] haben in ihrem Kulturbeutel mehr Pillen und Tablettenpäckchen dabei als Deo und Parfüm.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
