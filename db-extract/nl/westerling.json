                                        "entry_id": "20af6eac-dc90-33dc-916b-a9360327d5c5",
                                        "glosses": [
                                            "Person aus Westdeutschland"
                                        ],
                                        "tags": [
                                            "umgangssprachlich, oft abwertend",
                                            "meist historisch"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9c08d313-2163-471d-a2be-464ff3738b9a",
                                                "sense_id": "cd2eb5b5-0b5e-363a-ab42-88a44408a6cc",
                                                "text": "Der Westler stieg in den Zug, der Ostler stieg aus."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "31108d81-cff1-38c8-b06c-e8c4f8704efd",
                                        "entry_id": "20af6eac-dc90-33dc-916b-a9360327d5c5",
                                        "glosses": [
                                            "Person der westlichen Welt (insbesondere Westeuropa und Nordamerika)"
                                        ],
                                        "tags": [
                                            "umgangssprachlich, oft abwertend"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f3029a94-40a6-492e-9bd0-63a40cb4f89d",
                                                "sense_id": "31108d81-cff1-38c8-b06c-e8c4f8704efd",
                                                "text": "„Weitere Westler würde man nicht entführen, und man würde auch definitiv nicht mehr mit Kapitalisten oder Faschisten oder beiden feilschen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7351faa9-bf5a-4256-8782-25d09e104a15",
                        "source_entry_id": "051cf2ba-91fd-3f2b-b2f4-3e89ea260aaa",
                        "source_sense_id": "119dcf78-9afd-3d8f-93f1-f19979237479",
