                        "glosses": [
                            "Celui qui fait ou vend des fouaces."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c08fb0cf-7415-47a9-829d-09a00932e751",
                                "sense_id": "45c036b5-c5c5-3870-aeca-8291b946ef6a",
                                "text": "En régression, le dernier fouacier de La Haye-Fouassière a cessé son activité fin 1992. Néanmoins, les artisans boulangers-pâtissiers de la région nantaise de La Haye-Fouassière et de Bouaye continuent à en fabriquer, préférentiellement à l'automne et en hiver."
                            },
                            {
                                "example_id": "6a682a78-200d-42aa-bdde-6763f8317363",
                                "sense_id": "45c036b5-c5c5-3870-aeca-8291b946ef6a",
                                "text": "Peut-être un règlement de comptes entre un meunier et un fouacier qui remonte, pour moi, pour ma famille, à la nuit des temps."
                            }
                        ]
                    }
