                ],
                "senses": [
                    {
                        "sense_id": "e71dacbf-012f-3b40-8bfc-fcf1cd056873",
                        "entry_id": "942bca3c-9cd9-355e-9283-5b79067f6f65",
                        "glosses": [
                            "Qui est fidèle à l’observance religieuse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf914f76-ff52-4bf9-b9b8-bd632abad0de",
                                "sense_id": "e71dacbf-012f-3b40-8bfc-fcf1cd056873",
                                "text": "Elle était d'ailleurs devenue assez insensible, un peu inflexible, avec cette vie toute spirituelle qui s'ajoutait à sa nature froide, matée depuis des générations observantes."
                            },
                            {
                                "example_id": "04749438-faef-4fac-a69a-79064ddde0af",
                                "sense_id": "e71dacbf-012f-3b40-8bfc-fcf1cd056873",
                                "text": "Il y avait dehors un orage épouvantable, l’électricité fut coupée à plusieurs reprises, c’était la fin d’un après-midi de début du shabbat et Francine, Juive très observante, voulait rentrer chez elle avant le commencement de la fête."
                            },
                            {
                                "example_id": "a9e8739b-cfbb-44fa-9a7e-0dae032c2833",
                                "sense_id": "e71dacbf-012f-3b40-8bfc-fcf1cd056873",
                                "text": "Bref, les frontières entre catholiques « observants », « traditionalistes » et « intégristes » semblent poreuses dans l’entre-soi versaillais."
                            }
                        ]
                    },
                    {
                        "sense_id": "6c0e1ae0-88c3-381f-9058-3e289a1af736",
                        "entry_id": "942bca3c-9cd9-355e-9283-5b79067f6f65",
                        "glosses": [
                            "Qui entend pratiquer le strict respect de la règle religieuse primitive."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d7a85e75-3d05-45a2-9e6b-e4e876bf1770",
                                "sense_id": "6c0e1ae0-88c3-381f-9058-3e289a1af736",
                                "text": "Mineurs observants."
                            },
                            {
                                "example_id": "9bdcb98e-eb34-49c0-8d9e-827c7f559525",
                                "sense_id": "6c0e1ae0-88c3-381f-9058-3e289a1af736",
                                "text": "Ainsi apparurent au XIVᵉ siècle une observance et des frères observants dominicains et franciscains."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1816b019-eeef-4254-b811-6d7e5ce6ded5",
                        "source_entry_id": "942bca3c-9cd9-355e-9283-5b79067f6f65",
                        "target_lang_word": "observant",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "observant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4ce4fdb7-da92-3ece-b43c-96466a7cced7",
                                        "entry_id": "9fd326ff-58c1-3596-adf2-44c41ca68157",
                                        "glosses": [
                                            "Alert and paying close attention; watchful."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea197723-0097-463e-b6c9-e0ff1a1cea94",
                                                "sense_id": "4ce4fdb7-da92-3ece-b43c-96466a7cced7",
                                                "text": "The observant police officer noticed that my tax disk was out-of-date."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a419a0d6-16e6-3603-83ff-5ff92068d64f",
                                        "entry_id": "9fd326ff-58c1-3596-adf2-44c41ca68157",
                                        "glosses": [
                                            "Diligently attentive in observing a law, custom, duty or principle; regardful; mindful."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9f8b700-d75a-4b95-9446-08c0ca46e61b",
                                                "sense_id": "a419a0d6-16e6-3603-83ff-5ff92068d64f",
                                                "text": "I was normally observant of the local parking restrictions."
                                            },
                                            {
                                                "example_id": "dc82bbc7-658f-4a5f-85c1-deca393b18b1",
                                                "sense_id": "a419a0d6-16e6-3603-83ff-5ff92068d64f",
                                                "text": "We are told how observant Alexander was of his master Aristotle."
                                            },
                                            {
                                                "example_id": "f4ed88f1-1d7c-42b6-b3c8-4df166acf343",
                                                "sense_id": "a419a0d6-16e6-3603-83ff-5ff92068d64f",
                                                "text": "They also profess Buddhism, but are not so observant of its customs, nor are there so many monasteries and Lamas to be met with as in the other part of Bhutan."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "293d08be-8e74-3d60-8287-692531d754a5",
                                        "entry_id": "9fd326ff-58c1-3596-adf2-44c41ca68157",
                                        "glosses": [
                                            "Practicing a religion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e03faf73-e252-4f94-a49e-855adff60c4d",
                                                "sense_id": "293d08be-8e74-3d60-8287-692531d754a5",
                                                "text": "She is an observant Catholic who goes to church regularly."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
