            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d9b24062-af90-305b-923f-e1c73f22f927",
                    "sense_definition": "De aftrap nemen om een voetbalwedstrijd te beginnen, of figuurlijk een activiteit of evenement starten.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "starten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Toen de scheidsrechter floot en de tegenpartij <w>aftrapte</w>, nam zij zich voor om de bal geen seconde meer uit het oog te verliezen.",
                            "target_lang_translations": {
                                "en": "When the referee blew the whistle and the opposing team <w>kicked off</w>, she resolved not to lose sight of the ball for a single second."
                            }
                        },
                        {
                            "text": "De burgemeester zal vanavond de feestelijke campagne officieel <w>aftrappen</w>.",
                            "target_lang_translations": {
                                "en": "The mayor will officially <w>kick off</w> the festive campaign tonight."
                            }
                        }
                    ],
                    "synonyms": [
                        "beginnen",
                        "starten",
                        "openen"
                    ],
                    "antonyms": [
                        "afsluiten",
                        "beëindigen"
                    ],
                    "common_phrases": [
                        "de wedstrijd aftrappen",
                        "de campagne aftrappen"
                    ],
                    "target_lang_definitions": {
                        "en": "To take the kickoff to start a football match, or figuratively to start an activity or event."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "kick off",
                                "target_lang_sense_clarification": "to start a game or an event"
                            },
                            {
                                "target_lang_word": "start",
                                "target_lang_sense_clarification": "to begin an activity"
                            },
                            {
                                "target_lang_word": "launch",
                                "target_lang_sense_clarification": "to officially start a campaign or project"
                            }
                        ]
                    }
                }
            ]
        },
        {
