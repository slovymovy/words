                        ],
                        "examples": [
                            {
                                "example_id": "8795dd09-b7c9-4318-920e-7728ad643115",
                                "sense_id": "a9826962-becf-3f26-bcb8-4530a43af5d0",
                                "text": "Despite James’ cool display, she is feeling the heat from the Trump Department of Justice, which opened a criminal investigation into the AG after receiving a complaint from the Federal Housing Finance Agency last month."
                            }
                        ]
                    },
                    {
                        "sense_id": "2633dfba-ecbd-3401-9f80-dc8d33056edf",
                        "entry_id": "04e06fcd-bee8-3203-8fbd-5a2352b41dc2",
                        "glosses": [
