                "translations": [
                    {
                        "translation_id": "63b649d1-4bf4-4d78-81f0-a63d345680e5",
                        "source_entry_id": "5fce756c-8921-3c74-abb2-68f6820fe749",
                        "source_sense_id": "4ef234bc-2d56-343f-ab71-5843e3659ef7",
