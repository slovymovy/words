                                "target_senses": [
                                    {
                                        "sense_id": "f24b7516-045f-3ae5-8754-f1ea27a56b18",
                                        "entry_id": "9d6e6c0b-9780-373d-be00-d329fb9b1663",
                                        "glosses": [
                                            "The sum of the various techniques used by modern nation-states to control not individual subjects but their entire populations, as contrasted with traditional modes of power based on the threat of death from a sovereign."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9876735d-4aee-47f2-a5a6-fd70cdab7fdf",
                                                "sense_id": "f24b7516-045f-3ae5-8754-f1ea27a56b18",
                                                "text": "The third type of power, biopower, emerges from the eighteenth century onward, and is directed toward populations rather than individual bodies."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b5913f90-9b47-30cd-a387-3dedf9446e15",
