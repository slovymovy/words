                        "examples": [
                            {
                                "example_id": "ebf4f681-1e5b-49da-8a2e-efaaea17120e",
                                "sense_id": "ae2a0f4d-3694-325c-bf80-d2e8b5efafce",
                                "text": "„Schals, Mützen, Trikots oder Fahnen der bereits ausgeschiedenen Turniermannschaften kosten oft nur noch die Hälfte - nur bei den Trikots mit Schwarz-Rot-Gold setzen die Geschäftsinhaber trotz der Niederlage gegen Italien den Rotstift nicht an.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "5d4cd75b-3a50-33ad-916c-6c9c4265f980",
                        "entry_id": "f49000e7-d7b3-3810-b4b7-da75d5696df7",
                        "glosses": [
                            "Mannschaft, die bei Testspielen oftmals enttäuscht, aber gewöhnlich im Verlaufe eines Turniers/eines Wettkampfes zunehmend besser wird"
                        ],
                        "tags": [
                            "meist Singular"
                        ],
                        "examples": [
                            {
                                "example_id": "09bd2163-c9b6-4a9e-bf89-105457e10007",
                                "sense_id": "5d4cd75b-3a50-33ad-916c-6c9c4265f980",
                                "text": "„Das deutsche Fußball-Nationalteam gilt als Turniermannschaft. Von Spiel zu Spiel steigert sich die Auswahl des Deutschen Fußball-Bundes (DFB) und kommt auch in der K.-o.-Runde weit.“"
                            }
                        ],
