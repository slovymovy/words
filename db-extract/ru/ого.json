                        "glosses": [
                            "whoa; oh, ho!; wow!; oh, my goodness!; oh, oh! (expresses surprise, admiration, approval, etc.)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b8812bb5-1516-4bf0-82dd-8589f96346e5",
                                "sense_id": "fdcfa332-9873-301c-8444-ad0ea0662b85",
                                "text": "Ого́, как ты вы́рос!",
                                "translation": "Wow, how you’ve grown!",
                                "english": "Wow, how you’ve grown!"
                            },
                            {
                                "example_id": "1fd1d5fd-7b87-49f5-813c-e42c5e32c259",
                                "sense_id": "fdcfa332-9873-301c-8444-ad0ea0662b85",
                                "text": "Наро́ду там — ого́!",
                                "translation": "The people there—oh, oh, oh!",
                                "english": "The people there—oh, oh, oh!"
                            },
                            {
                                "example_id": "3642a502-0edd-4f10-835f-7b9445e76ea6",
                                "sense_id": "fdcfa332-9873-301c-8444-ad0ea0662b85",
                                "text": "Ого́, ско́лько грибо́в ты собра́л!",
                                "translation": "Wow, so many mushrooms you collected!",
                                "english": "Wow, so many mushrooms you collected!"
                            }
                        ]
                    }
                ],
