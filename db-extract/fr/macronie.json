                    {
                        "sense_id": "a537547d-7457-3567-8870-bd98dca664bb",
                        "entry_id": "87328ec7-ff61-3f6d-9596-c11ca3791b2f",
                        "glosses": [
                            "Clique, entourage proche d'Emmanuel Macron."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "65996551-6a7c-4ea1-b55d-8cb89b6696a0",
                                "sense_id": "a537547d-7457-3567-8870-bd98dca664bb",
                                "text": "La Macronie, une galaxie protéiforme."
                            },
                            {
                                "example_id": "d64b2e2c-4aa2-4c7b-94f0-ca9a149e3792",
                                "sense_id": "a537547d-7457-3567-8870-bd98dca664bb",
                                "text": "Quatre arguments — pardon, quatre « éléments de langage » — sont diffusés par la Macronie : 1) l’opération est légale ; 2) elle est morale ; 3) il n’y a pas d’argent public ; et 4) les Mutuelles ont finalement fait une bonne affaire."
                            },
                            {
                                "example_id": "d5d5c5da-b72c-40f2-beb8-16296b910fbf",
                                "sense_id": "a537547d-7457-3567-8870-bd98dca664bb",
                                "text": "Si la Macronie ou la droite veulent gagner en 2026, le changement de mode de scrutin ne sera toutefois pas suffisant."
                            }
                        ]
                    },
                    {
                        "sense_id": "ad317b36-b5c7-3588-84ce-3fa399dbbf9f",
                        "entry_id": "87328ec7-ff61-3f6d-9596-c11ca3791b2f",
