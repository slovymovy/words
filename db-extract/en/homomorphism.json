                "word": "homomorphism",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "0801c27b-50e5-452f-b71f-62c516cfabce",
                        "entry_id": "130d664e-0ad0-38b5-83ea-6f7283b1029c",
                        "tags": [
                            "plural"
                        ],
                        "form": "homomorphisms"
