                ],
                "senses": [
                    {
                        "sense_id": "7c6d49b4-28a5-3239-b938-f28a58c88b8f",
                        "entry_id": "ae2eca4b-2c10-3da9-bc3f-3910fef7f0de",
                        "glosses": [
                            "imię męskie od: Jan"
                        ],
                        "tags": [
                            "diminutive"
                        ],
                        "examples": [
                            {
                                "example_id": "15bcaf9f-e7a6-4e5b-bd4d-2fc617b9855a",
                                "sense_id": "7c6d49b4-28a5-3239-b938-f28a58c88b8f",
                                "text": "Śliczne córki nauczyciela śpiewały do wtóru ojcowskim skrzypkom. Starszej, Pelagii, przelotnej sympatii (bo czołową adresatką „tęsknot” gimnazjalistów była panna Olimpia Drwęska, o iście olimpijskiej urodzie), wpisał 19-letni Janek w imionnik dwa wiersze „Bądź silną i mężną”, „Bądź Polką”."
                            },
                            {
                                "example_id": "13b03fcb-5729-4ad7-8611-34e958a09822",
                                "sense_id": "7c6d49b4-28a5-3239-b938-f28a58c88b8f",
                                "text": "Intryga Janka miała opłakane skutki."
                            },
                            {
                                "example_id": "99ca9de6-00ad-4552-a1af-0a7609752508",
                                "sense_id": "7c6d49b4-28a5-3239-b938-f28a58c88b8f",
                                "text": "Panie Janku, proszę naprawić faks! Znów zaciął się papier."
                            },
                            {
                                "example_id": "24ff59ff-f335-4d79-981e-ef83385a934f",
                                "sense_id": "7c6d49b4-28a5-3239-b938-f28a58c88b8f",
                                "text": "Jankowi się nie przelewa; oszczędza prawie na wszystkim i za każdym razem kontroluje swoje wydatki."
                            },
                            {
                                "example_id": "032099c5-262b-4b50-992f-73ca71b7864e",
                                "sense_id": "7c6d49b4-28a5-3239-b938-f28a58c88b8f",
                                "text": "Anka z Jankiem kompromitowali się przy swoich znajomych."
                            },
                            {
                                "example_id": "d7a8d822-6a0e-450e-84cc-46404175850c",
                                "sense_id": "7c6d49b4-28a5-3239-b938-f28a58c88b8f",
                                "text": "Jankowi nieźle się powodzi, ostatnio kupił nową willę z basenem."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
