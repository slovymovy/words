                    {
                        "sense_id": "752d4906-a0b6-38c6-9b42-53710a241f97",
                        "entry_id": "aac228a8-a746-3044-81b1-c558e535baa5",
                        "glosses": [
                            "größere Menge Geldes, die erfreut entgegengenommen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec4cab90-3515-47d2-8a67-a992ed4f7794",
                                "sense_id": "752d4906-a0b6-38c6-9b42-53710a241f97",
                                "text": "„Der Geldsegen, der auf den Autor niederregnet, läßt die ausbleibenden Gehaltszahlungen verschmerzen.“"
                            },
                            {
                                "example_id": "70cbbda7-86b2-4f14-80be-f138f9126015",
                                "sense_id": "752d4906-a0b6-38c6-9b42-53710a241f97",
                                "text": "„Er konnte es sich gar nicht leisten, den zu erwartenden warmen Geldsegen auszuschlagen.“"
                            },
                            {
                                "example_id": "8b1c4e61-2d9f-4601-8c5a-63559e6c4837",
                                "sense_id": "752d4906-a0b6-38c6-9b42-53710a241f97",
                                "text": "„Ostern musste einen wahren Geldsegen für Siglufjörđur bedeuten, und das, obwohl einige Besucher schon wieder abgereist waren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
