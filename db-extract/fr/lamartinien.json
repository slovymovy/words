                "senses": [
                    {
                        "sense_id": "5154d5a2-4661-3f99-b292-47a198a76688",
                        "entry_id": "228dd3b2-d35d-3709-bdec-b9344bd5401a",
                        "glosses": [
                            "Relatif à Alphonse de Lamartine ou à son œuvre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f3682c7-a2f2-4e92-9fe8-1f9060a0c087",
                                "sense_id": "5154d5a2-4661-3f99-b292-47a198a76688",
                                "text": "Pour n’être point lamartinienne, cette poésie n’en avait pas moins un merveilleux effet de gaieté sur l’heureuse famille."
                            },
                            {
                                "example_id": "9c98a1ba-d4f8-4a03-b83c-2612ef08247e",
                                "sense_id": "5154d5a2-4661-3f99-b292-47a198a76688",
                                "text": "Bien qu’accompagné d’un camarade, je suis arrivé, avec la complicité de l’ambiance, à me hausser à l’état d’âme que je recherchais. Pardonnez ces égarements lamartiniens."
                            },
                            {
                                "example_id": "f7f4d825-f374-4fa2-87e1-ef266b9f640c",
                                "sense_id": "5154d5a2-4661-3f99-b292-47a198a76688",
                                "text": "Nous finîmes par arriver à un lac immense entouré de collines et de tori pittoresques. On venait y faire de petites excursions en bateau ou en pédalo. Ce dernier détail me donna envie de rire. Hakone était la promenade des Tokyoïtes lamartiniens."
                            }
                        ]
                    }
                ],
