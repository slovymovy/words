                ],
                "senses": [
                    {
                        "sense_id": "3af2f622-7e62-326e-a8b9-c88c37efcbf8",
                        "entry_id": "d4cb9f2d-7aa4-3785-9e9a-b66d1ba019f6",
                        "glosses": [
                            "книжн. разрушение"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9e95136-82e4-4038-8b1f-ccb13ab0abe5",
                                "sense_id": "3af2f622-7e62-326e-a8b9-c88c37efcbf8",
                                "text": "В этой группе больных указывают на нецелесообразность выполнения лазерной деструкции при распространении опухоли на комиссуральный отдел."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "15ec762a-9468-4375-a62b-b0fc66270d45",
                        "source_entry_id": "d4cb9f2d-7aa4-3785-9e9a-b66d1ba019f6",
                        "source_sense_id": "3af2f622-7e62-326e-a8b9-c88c37efcbf8",
                        "target_lang_word": "destruction",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "destruction",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c1655afd-3fba-3942-8b7b-575cccedac61",
                                        "entry_id": "3260a78f-e26e-3b49-9506-2a1ed0b9375e",
                                        "glosses": [
                                            "The act of destroying."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd2840b9-f2af-4db7-9ced-a7d5699dc729",
                                                "sense_id": "c1655afd-3fba-3942-8b7b-575cccedac61",
                                                "text": "The destruction of the condemned building will take place at noon."
                                            },
                                            {
                                                "example_id": "aa3fc8a7-592f-4aa6-971b-02f7ed67f191",
                                                "sense_id": "c1655afd-3fba-3942-8b7b-575cccedac61",
                                                "text": "It may be that a free society as we have known it carries in itself the forces of its own destruction, that once freedom has been achieved it is taken for granted and ceases to be valued, and that the free growth of ideas which is the essence of a free society will bring about the destruction of the foundations on which it depends."
                                            },
                                            {
                                                "example_id": "919585b2-bf88-4745-91ca-c6a9ed067ab1",
                                                "sense_id": "c1655afd-3fba-3942-8b7b-575cccedac61",
                                                "text": "About 1500 B.C., however, a powerful earthquake caused widespread destruction, and thereafter there were major changes. An earlier script, undeciphered, but known as Linear A, was replaced by the Greek Linear B."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "63ddea86-b825-30dd-a211-227c5fe5ec06",
                                        "entry_id": "3260a78f-e26e-3b49-9506-2a1ed0b9375e",
                                        "glosses": [
                                            "The results of a destructive event."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "78fd7c37-1092-48a2-b733-b4ce19fe90f7",
                                                "sense_id": "63ddea86-b825-30dd-a211-227c5fe5ec06",
                                                "text": "Amid the seemingly endless destruction, a single flower bloomed."
                                            },
                                            {
                                                "example_id": "68cf2d12-32a8-44fe-956d-2fc339b69457",
                                                "sense_id": "63ddea86-b825-30dd-a211-227c5fe5ec06",
                                                "text": "If destruction be our lot we must ourselves be its author and finisher. As a nation of freemen we must live through all time or die by suicide."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f064b243-3a36-3f7d-87f9-e688d741fc2a",
                                        "entry_id": "3260a78f-e26e-3b49-9506-2a1ed0b9375e",
                                        "glosses": [
                                            "A group of feral cats."
                                        ],
                                        "tags": [
                                            "collective",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bb69c659-442b-40db-b854-1989f309279f",
                                                "sense_id": "f064b243-3a36-3f7d-87f9-e688d741fc2a",
                                                "text": "A group of wild cats is called a destruction."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4d8b24ab-c5f8-486c-aa8b-c213d84274fd",
                        "source_entry_id": "d4cb9f2d-7aa4-3785-9e9a-b66d1ba019f6",
                        "source_sense_id": "3af2f622-7e62-326e-a8b9-c88c37efcbf8",
                        "target_lang_word": "degradation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "degradation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2e83143b-72ab-3d4c-820b-bb26dd97e0bb",
                                        "entry_id": "2c673f46-9ffb-3af2-8933-6150d7b31120",
                                        "glosses": [
                                            "The act of reducing in rank, character, or reputation, or of abasing; a lowering from one's standing or rank in office or society"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dd115710-1ff8-4f38-b396-93b385ceba82",
                                                "sense_id": "2e83143b-72ab-3d4c-820b-bb26dd97e0bb",
                                                "text": "This feature of good organization, the conferring of definite local superior rank, and the protection of the incumbent from unnecessary degradation, was discovered centuries ago by another effective institution, the Catholic church."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b37c2658-b966-3985-be0c-b263b9597908",
                                        "entry_id": "2c673f46-9ffb-3af2-8933-6150d7b31120",
                                        "glosses": [
                                            "The state of being reduced in rank, character, or reputation; baseness; moral, physical, or intellectual degeneracy; disgrace; abasement; debasement."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aa1bc810-3a6b-413a-a654-2b9530a551c5",
                                                "sense_id": "b37c2658-b966-3985-be0c-b263b9597908",
                                                "text": "There will be no poverty. All work will be done by living machines. Everybody will be free from worry and liberated from the degradation of labor. Everybody will live only to perfect himself."
                                            },
                                            {
                                                "example_id": "658b05c5-1ea0-4780-a32b-6025aba84868",
                                                "sense_id": "b37c2658-b966-3985-be0c-b263b9597908",
                                                "text": "Money is the great breaker-up of love and friendship; and this is, I believe, the reason of the common saying, that \"large families get on best in the world,\" because they can receive from each other assistance without degradation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2314db2a-b65a-3b2b-b211-8868c9b6943a",
                                        "entry_id": "2c673f46-9ffb-3af2-8933-6150d7b31120",
                                        "glosses": [
                                            "Diminution or reduction of strength, efficacy, or value; degeneration; deterioration."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "47e85a14-f498-46a1-9682-757350db2a3d",
                                                "sense_id": "2314db2a-b65a-3b2b-b211-8868c9b6943a",
                                                "text": "The extent of the damage to the military is still unclear and disputed, but the repeated bombings of the army and revolutionary guard bases and installations suggests substantial degradation of Iran's military power. Militarisation had long consumed a vast amount of the nation's resources."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c167cc4e-8511-3d3a-9ce8-ac9f3f07ce29",
                                        "entry_id": "2c673f46-9ffb-3af2-8933-6150d7b31120",
                                        "glosses": [
                                            "A gradual wearing down or wasting, as of rocks and banks, by the action of water, frost etc."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "55893d4d-0f8b-49ed-9e89-8fcdf2d583ad",
                                                "sense_id": "c167cc4e-8511-3d3a-9ce8-ac9f3f07ce29",
                                                "text": "Overexploitation of land for fuelwood is a further cause of soil degradation in Africa, Asia and South America"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "57c9fdc9-ca76-3612-a854-ef51c3fd343a",
                                        "entry_id": "2c673f46-9ffb-3af2-8933-6150d7b31120",
                                        "glosses": [
                                            "A deleterious change in the chemical structure, physical properties or appearance of a material from natural or artificial exposure."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bc922cee-4ac1-333a-87b8-68e9455034ec",
                                        "entry_id": "2c673f46-9ffb-3af2-8933-6150d7b31120",
                                        "glosses": [
                                            "The state or condition of a species or group which exhibits degraded forms; degeneration."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "660948d7-b3e0-3c2b-9e88-20f66d5190fd",
                                        "entry_id": "2c673f46-9ffb-3af2-8933-6150d7b31120",
                                        "glosses": [
                                            "Arrest of development, or degeneration of any organ, or of the body as a whole."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c68d649b-ac6c-4112-ba76-190c467df58b",
                                                "sense_id": "660948d7-b3e0-3c2b-9e88-20f66d5190fd",
                                                "text": "muscle degradation"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fc9d1ada-4a9e-303a-89d5-9929f8a98584",
                                        "entry_id": "2c673f46-9ffb-3af2-8933-6150d7b31120",
                                        "glosses": [
                                            "The gradual breakdown of components of a material, as a result of a natural element, i.e.: heat, cold and wind."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "add0e4e0-7a75-411c-bae5-ef3337f5611c",
                        "source_entry_id": "d4cb9f2d-7aa4-3785-9e9a-b66d1ba019f6",
