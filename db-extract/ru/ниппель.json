                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb86f141-5d79-43cf-aad1-7b79903a723c",
                                                "sense_id": "21a83dd0-262c-3c3d-87c4-e70da05dcad7",
                                                "text": "Turn the nipples on to the bicycle spokes only one turn, for each spoke on the new wheel all the way around until they are all snug, then check alignment."
                                            },
                                            {
                                                "example_id": "44f87516-f129-4fa9-a5b7-2a0f7ea682d6",
                                                "sense_id": "21a83dd0-262c-3c3d-87c4-e70da05dcad7",
                                                "text": "These were first constructed by heading the spokes, threading them through a steel felloe or rim and inserting them into screwed nipples which were in their turn screwed into the flanges of the hub."
