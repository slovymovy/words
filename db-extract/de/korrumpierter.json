                "senses": [
                    {
                        "sense_id": "909b0b9d-c26d-3c54-b5c2-ce3a3beb339d",
                        "entry_id": "431fbde3-8e08-3215-92eb-d08d2ad86dd1",
                        "glosses": [
                            "jemand, der seine Aufgaben gegen Bestechung wahrnimmt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa012465-cae2-4ff2-b2e4-397eddf6d53f",
                                "sense_id": "909b0b9d-c26d-3c54-b5c2-ce3a3beb339d",
                                "text": "„Hier amtshandeln – in Amt und Würden – Korrumpierte, die sich mit keinem Lächeln kaufen lassen, nur immer mit Banknoten.“"
                            },
                            {
                                "example_id": "cf0cee79-39b5-43e2-9fba-4395ee0ed60b",
                                "sense_id": "909b0b9d-c26d-3c54-b5c2-ce3a3beb339d",
                                "text": "„Die „Korrumpierten“ sind eine Mischung aus „Grineer“ und „Corpus“, die sich hauptsächlich im Void befinden und dieses beschützen, bzw. belagern.“"
                            },
                            {
                                "example_id": "fa7a2bad-8e9b-404c-8580-a5920733e4b9",
                                "sense_id": "909b0b9d-c26d-3c54-b5c2-ce3a3beb339d",
                                "text": "„Der Vorteil des Korrumpierten ist meist nur ein Bruchteil des Schadens an der Organisation, die ihn beschäftigt oder beauftragt hat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
