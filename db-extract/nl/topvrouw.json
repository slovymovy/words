                        "examples": [
                            {
                                "example_id": "1d3203a6-5847-4882-8d73-d88524aa1cb8",
                                "sense_id": "1ade996e-7942-3ca1-b537-d8230f85d67a",
                                "text": "Een ander veelgehoord argument is het vaste personeelsbestand: met topmannen die lang blijven hangen, ontstaat er geen plek voor topvrouwen."
                            },
                            {
                                "example_id": "9598d0ef-67f7-4dbc-8865-92b45fb3aee1",
                                "sense_id": "1ade996e-7942-3ca1-b537-d8230f85d67a",
                                "text": "Van de winkels in Azië en Europa zal het grootste deel sluiten, zegt de topvrouw, zonder specifieke vestigingen te noemen."
                            }
                        ]
                    }
