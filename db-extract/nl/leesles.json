                        "tags": [],
                        "examples": [
                            {
                                "example_id": "20edfc4f-0b91-4fbd-85d6-f6a85354cbac",
                                "sense_id": "756013e2-463f-38df-8122-bffed3e2ea31",
                                "text": "Van alle Afghanen die zich aanmelden voor de politie of het leger, kan maar een op de tien lezen en schrijven. Veel rekruten kunnen niet eens hun eigen naam schrijven. Om het analfabetisme te bestrijden, krijgen de agenten en militairen tijdens hun opleiding twee uur per dag leesles."
                            },
                            {
                                "example_id": "7c5eea29-8243-412a-814f-01b0af466444",
                                "sense_id": "756013e2-463f-38df-8122-bffed3e2ea31",
                                "text": "Floortje schreef de brief tijdens de leesles en juffrouw Ine vond hem zo goed dat ze zei dat Floortje hem maar moest opsturen."
                            },
                            {
                                "example_id": "8b711bce-c46d-4333-944d-ac84e6a9f774",
                                "sense_id": "756013e2-463f-38df-8122-bffed3e2ea31",
                                "text": "Prinses Laurentien hurkt neer bij een man die een leesles doet op de computer. Hij biedt de prinses haastig zijn zitplaats aan: ,,U mag hier wel zitten hoor. Maar Laurentien gebaart ,,Nee, nee, en legt haar hand op de getatoeëerde arm van de man. Ze leest met hem mee wat op het scherm staat."
                            }
                        ]
                    }
