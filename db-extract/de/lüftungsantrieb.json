                "senses": [
                    {
                        "sense_id": "f5c7c5ef-bd70-35bf-99fc-8e49153dc732",
                        "entry_id": "925f6a85-1ee3-32cd-8b0a-e6e877b9637f",
                        "glosses": [
                            "technische Vorrichtung, die Lüftung antreibt, die Luft in Bewegung versetzt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "910340e1-0ade-45b2-9a09-624593b5d782",
                                "sense_id": "f5c7c5ef-bd70-35bf-99fc-8e49153dc732",
                                "text": "„Die Nachrüstung der Lüftungsfunktion ist durch Austausch des EVB gegen einen Lüftungsantrieb mit Set-L3 (siehe unten) möglich.“"
                            },
                            {
                                "example_id": "75dac1b1-7594-4a8a-b684-f671d4b6b72e",
                                "sense_id": "f5c7c5ef-bd70-35bf-99fc-8e49153dc732",
                                "text": "„Ausgestattet mit innovativer Technik öffnen und schließen Lüftungsantriebe die Fenster manuell oder automatisch über spezielle Steuerungen, Timer und Sensorikelemente.“"
                            },
                            {
                                "example_id": "6a09644a-2aaa-49a5-ac7d-8247cef11fd0",
                                "sense_id": "f5c7c5ef-bd70-35bf-99fc-8e49153dc732",
                                "text": "„Wo also bei der Midor AG in der Vergangenheit die Antriebsriemen in den Lüftungsantrieben jährlich ausgewechselt und in kürzeren Intervallen nachgespannt werden mussten, meistert nun der optibelt RED POWER 3 Keilriemen seine Aufgabe ohne Wartungsaufwand problemlos über mehrere Jahre – auch bei Antrieben mit Rückenrollen.“"
                            },
                            {
                                "example_id": "80120598-9c27-429e-8bd0-dae923d90dec",
                                "sense_id": "f5c7c5ef-bd70-35bf-99fc-8e49153dc732",
                                "text": "„Der Lüftungsantrieb ECchain ist das Einsteigermodell, z.B. für das zu Hause.“"
                            },
                            {
                                "example_id": "9324d7cb-dd7d-4b14-96ad-addbff8d3a85",
                                "sense_id": "f5c7c5ef-bd70-35bf-99fc-8e49153dc732",
                                "text": "„Die Steuerung von solchen Lüftungsantrieben erfolgt zentral, wobei die Wind- und Regensteuerung, Raumfeuchte und Raumtemperatur seine Berücksichtigung finden muss.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
