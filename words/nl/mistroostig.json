{
    "word_family": [
        "mistroostigheid",
        "troost",
        "troosteloos",
        "troosten"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "98db9f3d-d77d-3882-a3a3-c2c32fb941d3",
                    "sense_definition": "een sombere indruk makend of neerslachtig van gemoed, vaak op een manier die moeilijk op te vrolijken is",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "gemoedstoestand",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na het horen van het slechte nieuws keek hij met een <w>mistroostige</w> blik uit het raam naar de regen.",
                            "target_lang_translations": {
                                "en": "After hearing the bad news, he looked out the window at the rain with a <w>gloomy</w> expression."
                            }
                        },
                        {
                            "text": "De aanblik van het verlaten en vervallen fabrieksgebouw was een uiterst <w>mistroostig</w> gezicht voor de buurtbewoners.",
                            "target_lang_translations": {
                                "en": "The sight of the abandoned and dilapidated factory building was an extremely <w>desolate</w> sight for the local residents."
                            }
                        }
                    ],
                    "synonyms": [
                        "neerslachtig",
                        "moedeloos",
                        "somber",
                        "troosteloos",
                        "bedrukt"
                    ],
                    "antonyms": [
                        "opgewekt",
                        "vrolijk",
                        "blijmoedig"
                    ],
                    "common_phrases": [
                        "mistroostig gezicht",
                        "mistroostige aanblik",
                        "mistroostig stemmen"
                    ],
                    "target_lang_definitions": {
                        "en": "making a somber impression or being dejected in spirit, often in a way that is difficult to cheer up"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "gloomy",
                                "target_lang_sense_clarification": "dark or poorly lit, especially so as to appear depressing"
                            },
                            {
                                "target_lang_word": "desolate",
                                "target_lang_sense_clarification": "feeling or showing great unhappiness or loneliness"
                            },
                            {
                                "target_lang_word": "dreary",
                                "target_lang_sense_clarification": "dull, bleak, and lifeless; depressing"
                            },
                            {
                                "target_lang_word": "dejected",
                                "target_lang_sense_clarification": "sad and depressed; dispirited"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "47e48ddd-8701-3fc7-82ef-0f4af7b781a2",
                    "sense_definition": "op een <w>mistroostig</w> wijze, gekenmerkt door somberheid of moedeloosheid",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "gemoedstoestand",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De oude man staarde <w>mistroostig</w> voor zich uit terwijl hij aan zijn overleden vrouw dacht.",
                            "target_lang_translations": {
                                "en": "The old man stared <w>gloomily</w> ahead while thinking of his deceased wife."
                            }
                        },
                        {
                            "text": "Toen de vakantie door de storm werd geannuleerd, zaten de kinderen <w>mistroostig</w> bij de pakken neer.",
                            "target_lang_translations": {
                                "en": "When the holiday was cancelled due to the storm, the children sat there <w>dejectedly</w>, having given up hope."
                            }
                        }
                    ],
                    "synonyms": [
                        "somber",
                        "moedeloos",
                        "neerslachtig"
                    ],
                    "antonyms": [
                        "vrolijk",
                        "opgewekt"
                    ],
                    "common_phrases": [
                        "mistroostig voor zich uit staren"
                    ],
                    "target_lang_definitions": {
                        "en": "in a gloomy or dejected manner, characterized by somberness or despondency"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "gloomily",
                                "target_lang_sense_clarification": "in a way that expresses great sadness or lack of hope"
                            },
                            {
                                "target_lang_word": "disconsolately",
                                "target_lang_sense_clarification": "in a way that shows you are very unhappy and cannot be comforted"
                            },
                            {
                                "target_lang_word": "dejectedly",
                                "target_lang_sense_clarification": "in a low-spirited or depressed manner"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}