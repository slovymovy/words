                    {
                        "translation_id": "90402882-aacb-42c7-8f61-553fdf381141",
                        "source_entry_id": "c9f07776-b708-30c1-9b03-ccbab457fc0e",
                        "source_sense_id": "4e4cd9dc-38c7-3db3-99e1-8cfa7fd38f3a",
                        "target_lang_word": "implanter",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "implanter",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c2bb4ec6-4247-3258-b221-47c0571d31dc",
                                        "entry_id": "4ce1b96f-3e87-33df-a054-630ac2376938",
                                        "glosses": [
                                            "Planter, insérer une chose dans une autre."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "648f6858-8ecf-4b6b-a362-26725891e7c8",
                                                "sense_id": "c2bb4ec6-4247-3258-b221-47c0571d31dc",
                                                "text": "Implanter une idée."
                                            },
                                            {
                                                "example_id": "0baa502e-3250-45a5-86e2-bb1488b7e3f4",
                                                "sense_id": "c2bb4ec6-4247-3258-b221-47c0571d31dc",
                                                "text": "Une idée profondément implantée."
                                            },
                                            {
                                                "example_id": "32266e82-7d43-40ff-a9fd-918db8850287",
                                                "sense_id": "c2bb4ec6-4247-3258-b221-47c0571d31dc",
                                                "text": "Sur le boulevard, la fraîcheur du matin rasséréna le baron, mais une idée fixe et presque douloureuse lui resta implantée au cerveau comme une pointe de couteau au milieu du front : […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6fe3df53-5461-362d-8042-2bb399a35261",
                                        "entry_id": "4ce1b96f-3e87-33df-a054-630ac2376938",
                                        "glosses": [
                                            "déterminer l’emplacement d'une construction, insérer une construction, un projet dans l'espace."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9d5322ed-a788-4713-a631-539c223d3f76",
                                                "sense_id": "6fe3df53-5461-362d-8042-2bb399a35261",
                                                "text": "Implanter la maison sur le terrain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ecc9ea7a-890d-3ed3-a3eb-76c8aa7ad583",
                                        "entry_id": "4ce1b96f-3e87-33df-a054-630ac2376938",
                                        "glosses": [
                                            "Installer un logiciel ou un sous-système donné en réalisant les adaptations nécessaires à leur fonctionnement dans un environnement défini."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "24d9ae34-fd31-4ec7-81c3-a48b0371804e",
                                                "sense_id": "ecc9ea7a-890d-3ed3-a3eb-76c8aa7ad583",
                                                "text": "De nouvelles fonctionnalités seront développées puis implantées au sein de la plateforme pour améliorer son utilisation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "10871792-88db-318f-bfc5-f3c4c8ed6f09",
                                        "entry_id": "4ce1b96f-3e87-33df-a054-630ac2376938",
                                        "glosses": [
                                            "Se dit des corps qui adhèrent spontanément à un autre corps sans en faire essentiellement partie, comme des excroissances et des boutures naturelles, des cheveux de l’homme, du poil des animaux."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "890b2de4-b007-4bac-8446-8f4ff75f40ee",
                                                "sense_id": "10871792-88db-318f-bfc5-f3c4c8ed6f09",
                                                "text": "Les poils sont implantés dans la peau."
                                            },
                                            {
                                                "example_id": "943c8bef-2f2f-4e01-9a1b-6aad4454efff",
                                                "sense_id": "10871792-88db-318f-bfc5-f3c4c8ed6f09",
                                                "text": "Les longues branches de quelques arbres retombent et s’implantent dans la terre par leur extrémité."
                                            },
                                            {
                                                "example_id": "ef3f893a-93b0-42b9-8149-7b7988500f49",
                                                "sense_id": "10871792-88db-318f-bfc5-f3c4c8ed6f09",
                                                "text": "Le gui s’implante sur le chêne."
                                            },
                                            {
                                                "example_id": "626da546-d102-4503-9489-4a58c66e58aa",
                                                "sense_id": "10871792-88db-318f-bfc5-f3c4c8ed6f09",
                                                "text": "Le lichen s’implante jusque dans les pores du rocher."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "371d53ab-7ed6-458f-8d17-ee4cc75ea669",
                        "source_entry_id": "c9f07776-b708-30c1-9b03-ccbab457fc0e",
                        "source_sense_id": "4e4cd9dc-38c7-3db3-99e1-8cfa7fd38f3a",
                        "target_lang_word": "greffer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "greffer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9d01b35b-bc12-3ae3-bb8a-9adfebf656e0",
                                        "entry_id": "d2ed5721-0788-34cd-a9e7-e229188bac31",
                                        "glosses": [
                                            "Faire une greffe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "45627803-e341-41e9-a46e-565795c08b09",
                                                "sense_id": "9d01b35b-bc12-3ae3-bb8a-9adfebf656e0",
                                                "text": "Il en fut de lui comme d’un arbre, sur lequel on grefferait successivement diverses espèces de fruits."
                                            },
                                            {
                                                "example_id": "1ce331ff-6e5e-4867-b787-9da5f288c0f5",
                                                "sense_id": "9d01b35b-bc12-3ae3-bb8a-9adfebf656e0",
                                                "text": "Greffer sur franc, sur sauvageon, sur paradis."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d671ed1-8bfa-311b-8f20-e878418bdf07",
                                        "entry_id": "d2ed5721-0788-34cd-a9e7-e229188bac31",
                                        "glosses": [
                                            "Faire une greffe, introduire dans le corps un nouvel organe en remplacement de celui qui manquait ou était défaillant."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "94482fab-935a-35e3-a517-2664c8101e1f",
                                        "entry_id": "d2ed5721-0788-34cd-a9e7-e229188bac31",
                                        "glosses": [
                                            "Insérer ; ajouter."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4058ec3a-28a1-451b-a57c-8c3b2b563e9c",
                                                "sense_id": "94482fab-935a-35e3-a517-2664c8101e1f",
                                                "text": "[…] sur ces sentiments de basse vanité, se greffait encore l’orgueil d’une vertu qu’il n’avait même pas conquise au prix d’efforts."
                                            },
                                            {
                                                "example_id": "ead49dd9-8b93-42b1-b49d-77033a6a9910",
                                                "sense_id": "94482fab-935a-35e3-a517-2664c8101e1f",
                                                "text": "Et, comme cela n'était pas suffisant, Vallese a augmenté la dose du Twin Cam en y greffant des pistons Wiseco portant la cylindrée à 1 550 cc (au lieu de 1 450 cc) et en retravaillant l’embiellage, les arbres à cames, la cartographie d'injection ou l'embrayage (via un kit Barnett)."
                                            },
                                            {
                                                "example_id": "f3752cd0-0a3e-4810-b307-a83c0fa78e76",
                                                "sense_id": "94482fab-935a-35e3-a517-2664c8101e1f",
                                                "text": "Dans Malhação par exemple, comme d'ailleurs dans toute télénovela, il y a une famille centrale autour de laquelle se greffent des intrigues amoureuses, mêlant tour à tour les thèmes de la santé, la jeunesse, la joie et la sexualité, et surtout l’adultère."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
