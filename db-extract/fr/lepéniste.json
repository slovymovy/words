                        "glosses": [
                            "Partisane, partisan de la politique de Jean-Marie Le Pen ou de Marine Le Pen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb4800c9-29a1-48d0-97cd-9341f0d0abf5",
                                "sense_id": "3010da21-fa5a-371b-8295-75dde412e36c",
                                "text": "Très tôt, elle a été lepéniste."
                            },
                            {
                                "example_id": "d3cddb9f-823d-4386-aed0-6270367d1d67",
                                "sense_id": "3010da21-fa5a-371b-8295-75dde412e36c",
                                "text": "Il y a des moments qui permettent aux masques de tomber. Celui qui nous réunit cet après-midi en est un. Une nouvelle fois, dans une chorégraphie désormais bien huilée, NUPES et Rassemblement national, les mélenchonistes et les lepénistes, agissent de concert, dans un pas de deux que nous connaissons bien désormais."
                            }
                        ]
                    }
