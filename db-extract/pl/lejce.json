                        "entry_id": "04a5e736-6dd3-3ee0-afe4-7b45434b886d",
                        "glosses": [
                            "rzemienne pasy służące do kierowania koniem"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "c06cee44-b78d-3c1a-b732-09a103cbb630",
                        "entry_id": "04a5e736-6dd3-3ee0-afe4-7b45434b886d",
                        "glosses": [
                            "prawo jazdy"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "07b3f6fc-778a-482d-93cb-83414edd22da",
                                "sense_id": "c06cee44-b78d-3c1a-b732-09a103cbb630",
                                "text": "Od kiedy straciłem lejce za przekroczenie prędkości w zabudowanym, muszę jeździć do pracy autobusem."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a46181ef-c171-4e64-91b9-2c08128057c7",
                        "source_entry_id": "04a5e736-6dd3-3ee0-afe4-7b45434b886d",
                        "source_sense_id": "d4ba8f40-739d-384f-b721-17e0c4fba59b",
                        "target_lang_word": "Zügel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zügel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5bc7c514-f83c-3365-bba7-b1b8844c6fbe",
                                        "entry_id": "87424f25-3817-3b57-9414-c9f2a027ed88",
                                        "glosses": [
                                            "Riemen oder Seil, der/das an einer Trense oder Kandare befestigt ist und mit dem man Reittiere lenkt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1d2408f-e35d-4558-9dc0-cb96209a2339",
                                                "sense_id": "5bc7c514-f83c-3365-bba7-b1b8844c6fbe",
                                                "text": "Herr Meyer hielt vor dem Stall ein schwitzendes Pferd am Zügel, als Werner im Stechschritt das Gutshaus verließ."
                                            },
                                            {
                                                "example_id": "3165f984-86e2-46a1-8f06-65c30c02360b",
                                                "sense_id": "5bc7c514-f83c-3365-bba7-b1b8844c6fbe",
                                                "text": "„Und die Pferde, die den Leichenwagen ziehen, welcher plötzlich vor ihm ist, haben goldene Zügel und schwarzweiße Federbüsche.“"
                                            },
                                            {
                                                "example_id": "62a93fd4-26a7-4b87-8df1-05dc2e606804",
                                                "sense_id": "5bc7c514-f83c-3365-bba7-b1b8844c6fbe",
                                                "text": "„Ich reichte ihm eine von Mifflins kleinen Karten, die in einer am Wagen befestigten Tasche steckten, und griff nach den Zügeln.“"
                                            },
                                            {
                                                "example_id": "8ccace57-db9e-43cb-9ac9-e1bf241f21b5",
                                                "sense_id": "5bc7c514-f83c-3365-bba7-b1b8844c6fbe",
                                                "text": "„Das Tier hatte sich mit dem linken Vorderfuß in dem herabhängenden Zügel verfangen.“"
                                            },
                                            {
                                                "example_id": "afc343a9-5356-4758-8db9-7e2c0a51f829",
                                                "sense_id": "5bc7c514-f83c-3365-bba7-b1b8844c6fbe",
                                                "text": "„Er gab dem Groom die Zügel und sprang ab, um den Damen beim Aussteigen behilflich zu sein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "02cc6141-84dc-3a17-a9a1-1183e0a76c80",
                                        "entry_id": "87424f25-3817-3b57-9414-c9f2a027ed88",
                                        "glosses": [
                                            "Bereich zwischen Schnabel und Auge des Vogelgefieders"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e3f59f1-5d52-40f2-9bf5-d6f76052c713",
                                                "sense_id": "02cc6141-84dc-3a17-a9a1-1183e0a76c80",
                                                "text": "Stirn und Zügel der Goldzügelamazone (Amazona xantholora) sind gelb."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "70de5be9-fe12-33b7-aae3-80102d60db69",
                                        "entry_id": "87424f25-3817-3b57-9414-c9f2a027ed88",
                                        "glosses": [
                                            "Zugwirkung auf Knochen vermittelndes Gewebe, etwa eine Sehne oder ein Teil eines Bandes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ec628fd-1ae7-413b-b17d-f5277e2601b4",
                                                "sense_id": "70de5be9-fe12-33b7-aae3-80102d60db69",
                                                "text": "„Gemeinsam verhindern beide Zügel [des Darmbeinschenkelbandes] ein Nach-hinten-Kippen des Beckens und stabilisieren somit die Standbeinphase, also die Streckung. Der obere Zügel hemmt zusätzlich die Auswärtsdrehung (Außenrotation), der untere Zügel hemmt die Innenwärtsdrehung (Innenrotation).“"
                                            },
                                            {
                                                "example_id": "89e8408b-d9ff-4568-b11f-4eca3f7bfadf",
                                                "sense_id": "70de5be9-fe12-33b7-aae3-80102d60db69",
                                                "text": "„Der mittlere Zügel wird von der Sehne des M. extensor digitorum gebildet, die seitlichen Zügel von den Mm. interossei und von palmar strahlen die Sehnen der Mm. lumbricales in die Interosseuszügel ein.“"
                                            },
                                            {
                                                "example_id": "b1bf03a6-20ac-41f2-845d-cdbd72dab9a8",
                                                "sense_id": "70de5be9-fe12-33b7-aae3-80102d60db69",
                                                "text": "„Das Bandsystem wird durch zwei Zügel repräsentiert, die am Ulnaschaft und an den beiden Enden der Windenachse befestigt sind.“"
                                            },
                                            {
                                                "example_id": "31bf6ad4-8803-4337-9b69-79f4d427a874",
                                                "sense_id": "70de5be9-fe12-33b7-aae3-80102d60db69",
                                                "text": "„Die lateralen Zügel der Strecksehne verbinden sich, um an der Grundgliedbasis anzusetzen.“"
                                            },
                                            {
                                                "example_id": "17b06aa9-075e-4098-8fde-9ab99ca513c1",
                                                "sense_id": "70de5be9-fe12-33b7-aae3-80102d60db69",
                                                "text": "„Der eine Zügel inseriert alleine über die mediale Aufhängung […] am Sehnenmittelzügel, der andere Zügel verbindet sich zunächst mit dem gleichseitigen Interosseuszügel, um dann über die laterale Aufhängung […] am radialen Seitenzügel zu enden […].“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "fa26f5eb-1214-39d9-9045-ade8ba6bc433",
                                        "entry_id": "87424f25-3817-3b57-9414-c9f2a027ed88",
                                        "glosses": [
                                            "Mittel zum Aufrechterhalten von etwas, zum Beispiel Kontrolle, Ordnung oder Disziplin; Mittel zum Herrschen/Beherrschen"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a6b62e36-31d6-4560-bb5c-eb66f70ad924",
                                                "sense_id": "fa26f5eb-1214-39d9-9045-ade8ba6bc433",
                                                "text": "In ihrer Schreinerei hält Undine die Zügel fest in der Hand."
                                            },
                                            {
                                                "example_id": "baac7246-250d-41f6-a5d0-e5e857963620",
                                                "sense_id": "fa26f5eb-1214-39d9-9045-ade8ba6bc433",
                                                "text": "Hedda hat sich ihre Chefposition erkämpft und will nun die Zügel nicht mehr aus der Hand geben."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "123ea5af-7bf6-3010-9078-c7cb6a79c4a1",
                                        "entry_id": "87424f25-3817-3b57-9414-c9f2a027ed88",
                                        "glosses": [
                                            "farblich abweichender Streifen, der sich bei manchen Vögeln vom Schnabelwinkel bis zum Hinterkopf erstreckt und sich auch beiderseits des Hauptes beim Gamswild sowie beiderseits am Kopf des Dachses findet"
                                        ],
                                        "tags": [
                                            "Jägersprache"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8de41152-72fc-4187-9165-5342c14717fa",
                                                "sense_id": "123ea5af-7bf6-3010-9078-c7cb6a79c4a1",
                                                "text": "„Die Zügel werden, je älter die Gams ist, umso verwaschener gegenüber dem hellen Haupt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "9c076b67-0481-3e7a-b1f1-b5e9b9366f2a",
                                        "entry_id": "87424f25-3817-3b57-9414-c9f2a027ed88",
                                        "glosses": [
                                            "kleine Schleimhautfalte, Schleimhautbändchen"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"6\""
                                    }
                                ]
                            }
                        ]
                    },
