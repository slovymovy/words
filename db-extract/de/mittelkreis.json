                    },
                    {
                        "sense_id": "5d7fcb07-3331-3c6d-b730-c2cc8c739549",
                        "entry_id": "a4caa56b-4018-3edc-8c8e-3a9235dcdf2e",
                        "glosses": [
                            "im Mittelpunkt des Spielfeldes befindlicher markierter Kreis"
                        ],
                        "tags": [
                            "vor allem beim",
                            "Handball",
                            "Basketball",
                            "Eishockey"
                        ],
                        "examples": [
                            {
                                "example_id": "33d7e49a-446b-475d-b7bc-7f1fdbffb5fc",
                                "sense_id": "5d7fcb07-3331-3c6d-b730-c2cc8c739549",
                                "text": "„Kalle legt den Ball auf den Punkt im Mittelkreis und führt mit einem zweiten Spieler den Anstoß durch.“"
                            },
                            {
                                "example_id": "5b6df871-65a4-4218-b0d7-9cd80fd58a19",
                                "sense_id": "5d7fcb07-3331-3c6d-b730-c2cc8c739549",
                                "text": "„Einsam zog der deutsche Stürmer Keita seine Kreise im Mittelkreis, während seine zehn Mitspieler verteidigten.“"
                            },
                            {
                                "example_id": "c1cfe63f-a59b-4542-b0d9-f4368f6b0448",
                                "sense_id": "5d7fcb07-3331-3c6d-b730-c2cc8c739549",
                                "text": "„Die Defensivspieler haben die Aufgabe, in den Mittelkreis zu dribbeln und die Konterspieler greifen nach einer Balleroberung auf das Tor an.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
