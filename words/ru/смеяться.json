                                "nl": "Wees niet boos op hem, hij <maakt maar een grapje>.",
                                "pl": "Nie obrażaj się na niego, on tylko <w>żartuje</w>.",
                                "fr": "Ne t'en veux pas, il <rigole> juste.",
                                "de": "Sei ihm nicht böse, er <macht> nur <Spaß>.",
                                "es": "No te ofendas con él, solo <está bromeando>.",
                                "it": "Non prendertela con lui, sta solo <scherzando>.",
                                "tr": "Ona kırılma, sadece <şaka yapıyor>.",
                                "cs": "Nezlob se na něj, on jenom <žertuje>."
                            }
                        }
