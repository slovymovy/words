                        "entry_id": "aabb9cd5-fb1f-3ebc-acf6-2e97208ee1a9",
                        "glosses": [
                            "Oxygéner beaucoup plus que la normale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6022d927-3049-47c6-b53d-97b564290257",
                                "sense_id": "45a5d7c4-7460-3ab5-9474-8fc70ad1e1a7",
                                "text": "Il faut hyperoxygéner la personne avant et après l’aspiration."
                            },
                            {
                                "example_id": "9ea41b7d-7dad-4503-8c3e-4e27742451cd",
                                "sense_id": "45a5d7c4-7460-3ab5-9474-8fc70ad1e1a7",
                                "text": "Il faut dire que, dans la caverne, je suis resté presque immobile, et n’ai fait que chanter et m’hyperoxygéner."
                            }
                        ]
