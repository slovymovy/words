                        "glosses": [
                            "Personne qui parle habituellement le romanche."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e2d22bd-58d2-4e77-9d1b-c977806fa906",
                                "sense_id": "5025c04f-d562-37c4-a9cd-81eab3f0dec1",
                                "text": "Mais elle me dit qu’ici les 4 premières années d’école se font exclusivement en romanche, et qu’il est assez difficile pour un romanchophone qui suit ce parcours de bien parler allemand."
                            },
                            {
                                "example_id": "a49ab820-afe4-4665-80b9-2a9842adec57",
                                "sense_id": "5025c04f-d562-37c4-a9cd-81eab3f0dec1",
                                "text": "En général, un romanchophone passe automatiquement à l’allemand, souvent le suisse alémanique (ou Schwizerdütsch), dès qu’il se trouve devant un non-romanchophone."
                            }
                        ]
