            {
                "entry_id": "4ec0c34e-fc8c-3c79-97a8-129ea971f6d0",
                "word": "boustrophedon",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "582f8c79-2500-4c63-9d99-3464f3653804",
                        "entry_id": "4ec0c34e-fc8c-3c79-97a8-129ea971f6d0",
