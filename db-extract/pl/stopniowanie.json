                                    },
                                    {
                                        "sense_id": "61982b81-d387-3d2e-9c25-0ee3571c6b9f",
                                        "entry_id": "f9130bde-40d5-37f0-ad99-0261720df690",
                                        "glosses": [
                                            "A passing by small degrees from one tone or shade, as of color, to another."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "78e182d2-dae8-496f-b727-82190cc439b7",
                                                "sense_id": "61982b81-d387-3d2e-9c25-0ee3571c6b9f",
                                                "text": "A decade ago, the British department-store chain John Lewis built itself a long warehouse, painted in gradations of sky blue."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "08581472-2063-39ac-9b46-8dd0dda02d60",
                                        "entry_id": "f9130bde-40d5-37f0-ad99-0261720df690",
                                        "glosses": [
                                            "The act of gradating or arranging in grades."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "45c1fd47-5c94-3e12-b3c7-3bc11174fa5c",
                                        "entry_id": "f9130bde-40d5-37f0-ad99-0261720df690",
                                        "glosses": [
                                            "Any degree or relative position in an order or series."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2217652a-b382-4916-9b8c-89cc39f899ee",
                                                "sense_id": "45c1fd47-5c94-3e12-b3c7-3bc11174fa5c",
                                                "text": "the several gradations of the intelligent universe"
                                            },
                                            {
                                                "example_id": "7d8b2c58-f524-43f0-a0cb-9bf026bcdc7d",
                                                "sense_id": "45c1fd47-5c94-3e12-b3c7-3bc11174fa5c",
                                                "text": "Two distinct types of lupus erythematosus are recognized: [1] chronic or discoid, which is essentially a skin lesion, and [2] severe systemic, designated as acute. Between the two types are many gradations to which the term subacute has been applied."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "913d32c5-d636-3396-974f-e0317436552f",
                                        "entry_id": "f9130bde-40d5-37f0-ad99-0261720df690",
                                        "glosses": [
                                            "A calibration marking."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cacae63f-d6d2-3d7e-a516-5139203ba8f6",
                                        "entry_id": "f9130bde-40d5-37f0-ad99-0261720df690",
