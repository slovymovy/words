                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c6851b4-e83f-496d-8152-2dd6f0b98abe",
                                "sense_id": "1525258e-bff3-305e-a933-d1c85ba61223",
                                "text": "„Ja, räumt er ein, Lena habe in ihrer Wohnung in der Gilmor Street öfter Kokain für ihn aufbewahrt. In dem Kleiderschrank, in einem Beutel, der in einer Reistüte versteckt war.“"
                            },
                            {
                                "example_id": "484aea09-9e58-4216-af0d-dc4a6cb77b94",
                                "sense_id": "1525258e-bff3-305e-a933-d1c85ba61223",
                                "text": "„Das Regal voller Gewürzdosen, Reistüten, Speisefettkartons und anderer schwerer Lebensmittelpackungen blockierte nun die Tür, jedenfalls fürs Erste.“"
                            }
                        ],
