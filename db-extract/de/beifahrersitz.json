                        "source_sense_description": "Sitz neben dem Fahrzeugführer, bei Motorrad oder Motorroller hinter dem Fahrzeugführer",
                        "target_lang_word": "place du mort",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "place du mort",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ca5a4362-4d6d-3c93-851b-11ba6d46f578",
                                        "entry_id": "44c65f52-2ea9-3942-9e6d-c7a6fafb55d8",
                                        "glosses": [
                                            "Siège passager avant, place supposée être la plus exposée en cas d’accident."
                                        ],
                                        "tags": [
                                            "hyperbole"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f42ce04-1971-4fb9-a0ca-41eb26868771",
                                                "sense_id": "ca5a4362-4d6d-3c93-851b-11ba6d46f578",
                                                "text": "Lui, il est à ma droite, qui va une fois de plus mériter son nom de place du mort."
                                            },
                                            {
                                                "example_id": "b00ccc12-0a48-4aa1-98d4-d38bb2265b8b",
                                                "sense_id": "ca5a4362-4d6d-3c93-851b-11ba6d46f578",
                                                "text": "— Oui, mais pourquoi c’est pas moi qui conduis ?\n— Parce que je suis malade en voiture quand je suis bourrée et à la place du mort…"
                                            },
                                            {
                                                "example_id": "6d3f2e0a-62bd-4426-8eb2-130e866ad558",
                                                "sense_id": "ca5a4362-4d6d-3c93-851b-11ba6d46f578",
                                                "text": "Au comble de l’excitation, Dominique s’assit au volant. Reine, à la place du mort, lui tendit les clefs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
