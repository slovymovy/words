                        ],
                        "examples": [
                            {
                                "example_id": "cad84e64-50ea-4df8-b58b-367454e68e68",
                                "sense_id": "b98bf210-31fb-355f-b35d-dd75df423709",
                                "text": "Cet appartement, poursuivit-elle, je l’ai toujours connu plus ou moins inoccupé. Je crois que le probloc se l’est réservé. Pas pour lui personnellement, mais pour rendre service, pour dépanner des sans-abris momentanés, quoi !"
                            },
                            {
                                "example_id": "a54ad8bb-cd4a-4a95-8271-1ac49ec32791",
                                "sense_id": "b98bf210-31fb-355f-b35d-dd75df423709",
                                "text": "Si je ne passais pas à la télé de temps en temps – cultivé, spirituel et malgré ça “pas la grosse tête”, un genre très au point – le probloc m’aurait sûrement sacqué."
                            },
                            {
                                "example_id": "bbac559d-3783-4b14-93af-c9a0fc2f290b",
                                "sense_id": "b98bf210-31fb-355f-b35d-dd75df423709",
                                "text": "Frédéric Langlat. Le peintre. L’ancien et premier probloc de cet hôtel."
                            }
                        ]
                    }
