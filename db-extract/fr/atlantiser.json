                ],
                "senses": [
                    {
                        "sense_id": "302c5f3e-01e2-3af5-bd63-7cb77dc38db5",
                        "entry_id": "4b3fe360-c3cf-30e3-bcfe-b9720637e78d",
                        "glosses": [
                            "Donner un caractère atlantique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d396895-55c8-4cf1-afec-89fcbc3e2b71",
                                "sense_id": "302c5f3e-01e2-3af5-bd63-7cb77dc38db5",
                                "text": "Cependant, l’idée, à confirmer grâce à la mise en place d’un suivi météo continu dans la cuvette, que le climat s’est atlantisé est avancée."
                            }
                        ]
                    },
                    {
                        "sense_id": "0c5ed688-6e61-3b9a-9356-90a04ac0c98c",
                        "entry_id": "4b3fe360-c3cf-30e3-bcfe-b9720637e78d",
                        "glosses": [
                            "Associer à l’Alliance atlantique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8a9e829a-ec32-4b79-a491-2bc7e8c844e0",
                                "sense_id": "0c5ed688-6e61-3b9a-9356-90a04ac0c98c",
                                "text": "Washington propose d’atlantiser Chypre, les Etats-Unis cherchant des points d’appui pour une intervention dans la région."
                            },
                            {
                                "example_id": "c0e9b67c-0fdf-45a0-a6d1-85da9efa9486",
                                "sense_id": "0c5ed688-6e61-3b9a-9356-90a04ac0c98c",
                                "text": "Le moment est venu pour les Américains de stopper court ces initiatives et « d’atlantiser la Méditerranée »."
                            }
                        ]
                    }
                ],
