                    {
                        "sense_id": "3358d4c5-2ac7-3b2e-ab8b-aa9d9f948229",
                        "entry_id": "2064a918-8bc5-3adc-b149-b102aecd1360",
                        "glosses": [
                            "Femme ou jeune fille."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "0e53e124-94fe-48a5-8893-df52e7589642",
                                "sense_id": "3358d4c5-2ac7-3b2e-ab8b-aa9d9f948229",
                                "text": "Oui, Théodore Calvi morfile (mange) sa dernière bouchée, dit le Biffon. Ah ! ses largues doivent joliment chigner des yeux, car il était aimé, le petit gueux !' — (Honoré de Balzac, Splendeurs et misères des courtisanes, 1838-1847, quatrième partie)"
                            },
                            {
                                "example_id": "b88727b6-4330-4336-a2e6-93a293e0de81",
                                "sense_id": "3358d4c5-2ac7-3b2e-ab8b-aa9d9f948229",
                                "text": "Une femme est une largue."
                            },
                            {
                                "example_id": "8336e845-7f35-401f-834a-71b184916cd3",
                                "sense_id": "3358d4c5-2ac7-3b2e-ab8b-aa9d9f948229",
                                "text": "...voilà justement le Maître d'école et sa largue."
                            },
                            {
                                "example_id": "1eda5613-ba2f-4863-a2a6-7aa66b1b5b4e",
                                "sense_id": "3358d4c5-2ac7-3b2e-ab8b-aa9d9f948229",
                                "text": "Voilà bientôt l'heure où on va raccourcir les deux largues."
                            }
                        ]
