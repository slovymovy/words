                    {
                        "sense_id": "c9421967-7677-3bbb-89ed-daf308bb374d",
                        "entry_id": "6d96ade2-2bf8-307d-bbf7-0de1a933c7ad",
                        "glosses": [
                            "een huis buiten de stad, meestal als tweede huis voor een welvarende stadsbewoner"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c15e9721-4f6e-48aa-99ae-b7ae4a8a02c7",
                                "sense_id": "c9421967-7677-3bbb-89ed-daf308bb374d",
                                "text": "Langs de Hollandse Vecht staan prachtige 17de-eeuwse buitenhuizen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3f2e32e3-99de-4763-8f60-8eb9c56aab64",
                        "source_entry_id": "6d96ade2-2bf8-307d-bbf7-0de1a933c7ad",
                        "source_sense_id": "c9421967-7677-3bbb-89ed-daf308bb374d",
                        "source_sense_description": "een tweede woning in een landelijke of natuurrijke omgeving",
                        "target_lang_word": "Landhaus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Landhaus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "83f3e343-c9ae-3460-a226-86b5c930682b",
                                        "entry_id": "2ab88812-0f76-3a32-a1a3-349205557733",
                                        "glosses": [
                                            "Haus auf dem Land"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3137d1c8-8295-4209-9b9d-f9713d9f5ba5",
                                                "sense_id": "83f3e343-c9ae-3460-a226-86b5c930682b",
                                                "text": "„Der Wahlmünchner weilte noch in der Sommerfrische in seinem Landhaus in Bad Tölz.“"
                                            },
                                            {
                                                "example_id": "2b7452e1-e1dd-475b-958a-6028020470f0",
                                                "sense_id": "83f3e343-c9ae-3460-a226-86b5c930682b",
                                                "text": "„Je mehr U-Boote für die Kriegsflotte vom Stapel laufen und zum Einsatz gelangen, desto mehr Platz wird benötigt, und schon bald werden noch weitere Hotels und Landhäuser beschlagnahmt.“"
                                            },
                                            {
                                                "example_id": "e48eb28d-c5ad-4365-8a13-cc1866995f8d",
                                                "sense_id": "83f3e343-c9ae-3460-a226-86b5c930682b",
                                                "text": "„Graf Rastoptschin nahm noch rasch im Wagen Platz und befahl dem Kutscher, nach Sokolniki zu seinem Landhause zu fahren.“"
                                            },
                                            {
                                                "example_id": "1c4833aa-e2f4-4c57-a2cb-ca533d92f078",
                                                "sense_id": "83f3e343-c9ae-3460-a226-86b5c930682b",
                                                "text": "„Schon damals, das ist vor fünfundzwanzig bis dreißig Jahen, waren die Ufer des Mississippi mehrere hundert Meilen entlang mit herrlichen Pflanzungen bedeckt, aus denen prachtvolle Landhäuser hervorragten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1b1c5e6c-cc24-33be-9f10-33613df4ac9d",
                                        "entry_id": "2ab88812-0f76-3a32-a1a3-349205557733",
                                        "glosses": [
                                            "Amtssitz von Regierung und Landtag (eines österreichischen Bundeslandes)"
                                        ],
                                        "tags": [
                                            "Austrian German"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b488b488-3ffa-479b-b1af-797aa9390af9",
                                                "sense_id": "1b1c5e6c-cc24-33be-9f10-33613df4ac9d",
                                                "text": "Später zog das Landesverkehrsamt als Abteilung IIc ins Tiroler Landhaus um."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "699f926a-beb8-38a1-b261-2405a39349c0",
                                        "entry_id": "2ab88812-0f76-3a32-a1a3-349205557733",
                                        "glosses": [
                                            "Versammlungshaus für Landstände"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "42ed2686-2613-4d62-89d0-e31606191e76",
                                                "sense_id": "699f926a-beb8-38a1-b261-2405a39349c0",
                                                "text": "Rechts sehen Sie das ehemalige Landhaus, in dem zeitweise die Landstände tagten."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "123fa2a7-3211-4c51-9d0f-a5e4c20a2e6b",
                        "source_entry_id": "6d96ade2-2bf8-307d-bbf7-0de1a933c7ad",
                        "source_sense_id": "c9421967-7677-3bbb-89ed-daf308bb374d",
                        "source_sense_description": "een tweede woning in een landelijke of natuurrijke omgeving",
                        "target_lang_word": "Landsitz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Landsitz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1b6ec2e8-e82f-3bca-b961-79f7539dfa7c",
                                        "entry_id": "fe4dff54-2d36-3d08-9ab1-f5f647555aa1",
                                        "glosses": [
                                            "größeres Anwesen auf dem Land"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fed3f7f0-eb9c-48af-b577-577513b8b4d2",
                                                "sense_id": "1b6ec2e8-e82f-3bca-b961-79f7539dfa7c",
                                                "text": "„Cecilienhof war erst 1917, ein Jahr vor dem Ende des Ersten Weltkriegs, fertig gestellt worden, ein Landsitz mit 176 Räumen im überladenen Tudor-Stil: lauter Erker, ein Wald von Schornsteinen, efeuumschlungene Fachwerkfassaden.“"
                                            },
                                            {
                                                "example_id": "ab747ba7-75ad-47c3-bb1b-3b3d7679a8aa",
                                                "sense_id": "1b6ec2e8-e82f-3bca-b961-79f7539dfa7c",
                                                "text": "„Eine andere trifft den Sohn einer reichen Witwe, die vor den Unruhen im Zarenreich auf einen Landsitz nahe bei Tewjes Dorf geflohen ist.“"
                                            },
                                            {
                                                "example_id": "2029c9df-d257-4836-98a4-6b97c47a9bf5",
                                                "sense_id": "1b6ec2e8-e82f-3bca-b961-79f7539dfa7c",
                                                "text": "„Der Landsitz, in dem unser Squire es sich so bequem gemacht und zu Hause schien, gehörte zu einer der vielen Mississippi-Pflanzungen, die weniger durch äußere Großartigkeit als durch innere Pracht die glänzenden Reichtümer zur Schau tragen, die dieser Erwerb seinen Beflissenen beinahe immer sichert.“"
                                            },
                                            {
                                                "example_id": "deb6869a-47b4-4f87-9e71-66a48322c811",
                                                "sense_id": "1b6ec2e8-e82f-3bca-b961-79f7539dfa7c",
                                                "text": "„Außerdem hatte ich den Namen des Landsitzes notiert, der jetzt zum Hotel geworden war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2b6d3b64-116e-4ff5-b490-2d2bc77e9e53",
                        "source_entry_id": "6d96ade2-2bf8-307d-bbf7-0de1a933c7ad",
                        "source_sense_id": "c9421967-7677-3bbb-89ed-daf308bb374d",
                        "source_sense_description": "een tweede woning in een landelijke of natuurrijke omgeving",
                        "target_lang_word": "Zweitwohnung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zweitwohnung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2961fe2b-5281-33a2-9572-e65f01ff9c3e",
                                        "entry_id": "1b51df71-1ac6-384b-8784-02a61ecafdc9",
                                        "glosses": [
                                            "eine zweite Wohnung an einem anderen Ort als dem Erstwohnsitz, die heute oft aus beruflichen gehalten werden muss"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ae0eb5f-b8c5-4e58-b634-d495519a1f8f",
                                                "sense_id": "2961fe2b-5281-33a2-9572-e65f01ff9c3e",
                                                "text": "Eine Zweitwohnung ist im Rahmen der doppelten Haushaltsführung steuerlich absetzbar."
                                            },
                                            {
                                                "example_id": "2029afbe-a087-4360-9895-9e50d4aa2e6e",
                                                "sense_id": "2961fe2b-5281-33a2-9572-e65f01ff9c3e",
                                                "text": "„In der DDR leistete sich, wer es konnte, eine Zweitwohnung auf dem Lande.“"
                                            },
                                            {
                                                "example_id": "025977ec-8451-4b8c-a85d-b64cddeef2e0",
                                                "sense_id": "2961fe2b-5281-33a2-9572-e65f01ff9c3e",
                                                "text": "„Bess vermisste ihre alten Freundinnen, und bald kauften die beiden eine kleine Zweitwohnung in der Elizabeth Avenue in Weequahic und unternahmen die zweistündige Fahrt dorthin an jedem Wochenende und an Feiertagen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2d3640af-27f1-43c0-93b1-0ea4c870fa47",
                        "source_entry_id": "6d96ade2-2bf8-307d-bbf7-0de1a933c7ad",
                        "source_sense_id": "c9421967-7677-3bbb-89ed-daf308bb374d",
                        "source_sense_description": "een tweede woning in een landelijke of natuurrijke omgeving",
                        "target_lang_word": "country house",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "country house",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9b10001a-05ad-3d87-ad32-340e7b274655",
                                        "entry_id": "59924929-4eab-31aa-b114-35763fc8ecb2",
                                        "glosses": [
                                            "A house serving as a weekend and holiday residence, used as a retreat from city life; traditionally and archetypically in the country, and especially of wealthy owners."
                                        ],
                                        "tags": [
                                            "British",
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9df1eff4-4eef-4e1e-92ea-c10e36fc759b",
                                                "sense_id": "9b10001a-05ad-3d87-ad32-340e7b274655",
                                                "text": "Near-synonym: country seat"
                                            },
                                            {
                                                "example_id": "0d45cd47-028f-48df-93c6-f5f523183ec5",
                                                "sense_id": "9b10001a-05ad-3d87-ad32-340e7b274655",
                                                "text": "One of those utterly tedious amusements one only finds at an English country house on an English country Sunday. I don't think any one at all morally responsible for what he or she does at an English country house."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c6c56a3f-3d36-3666-a80f-19bcb5e47b5d",
                                        "entry_id": "59924929-4eab-31aa-b114-35763fc8ecb2",
                                        "glosses": [
                                            "Such a house, even as a primary residence and even in an area that is no longer rural, but with an aesthetic in keeping with that traditional distinction of country ways."
                                        ],
                                        "tags": [
                                            "British",
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6abbf9b7-6e49-4292-a941-5be160be4df1",
                                                "sense_id": "c6c56a3f-3d36-3666-a80f-19bcb5e47b5d",
                                                "text": "a country house look"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8dee6aa9-57ee-3545-8283-305f8d29a5fa",
                                        "entry_id": "59924929-4eab-31aa-b114-35763fc8ecb2",
                                        "glosses": [
                                            "Used other than figuratively or idiomatically: see country, house: a house in the country: one not in town."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6e23da16-4f6f-4ec1-97fe-f1bd48beb8f8",
                        "source_entry_id": "6d96ade2-2bf8-307d-bbf7-0de1a933c7ad",
                        "source_sense_id": "c9421967-7677-3bbb-89ed-daf308bb374d",
                        "source_sense_description": "een tweede woning in een landelijke of natuurrijke omgeving",
                        "target_lang_word": "maison de campagne",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "maison de campagne",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "15e6e8f0-c214-3186-afa6-350bb0bd596f",
                                        "entry_id": "98ceddbc-2272-3f2e-9e43-dafee23e4620",
                                        "glosses": [
                                            "Résidence de repos ou de loisir, en zone rurale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df22f40d-3c9c-4421-affc-08586b5122c1",
                                                "sense_id": "15e6e8f0-c214-3186-afa6-350bb0bd596f",
                                                "text": "Nous avons notre petite ferme-modèle, absolument comme le gouvernement, c’est notre maison de campagne, elle est à trois lieues d’ici, sur la route d’Italie, près de Villeneuve-Saint-Georges."
                                            },
                                            {
                                                "example_id": "4edb9e0f-ba8c-4fb9-b4af-f42c7355becc",
                                                "sense_id": "15e6e8f0-c214-3186-afa6-350bb0bd596f",
                                                "text": "Son épouse, avertie de cet accident, étant venue le prendre dans une basterne pour le conduire dans une maison de campagne, il recouvra son bon sens."
                                            },
                                            {
                                                "example_id": "8d9d85f9-7e19-4736-be7b-ae9d4445d92f",
                                                "sense_id": "15e6e8f0-c214-3186-afa6-350bb0bd596f",
                                                "text": "Il n'y a de sécurité nulle part. Jean Oudin de Verpel, abbé de Mouzon, s'était retiré au Petit-Remilly, où les Bénédictins avaient une maison de campagne, avec une chapelle qui subsista jusqu'au XVIIIᵉ siècle."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
