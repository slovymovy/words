                    "sense_id": "9e07aa28-a548-3757-a9d5-0e5a142ca1c5",
                    "sense_definition": "In spite of the fact that; even though.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "concession",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Although</w> it was raining heavily, we decided to go for a walk.",
                            "target_lang_translations": {
                                "ru": "<w>Хотя</w> шёл сильный дождь, мы решили пойти на прогулку.",
                                "nl": "<w>Hoewel</w> het hard regende, besloten we toch te gaan wandelen.",
                                "pl": "<w>Chociaż</w> mocno padało, zdecydowaliśmy się pójść na spacer.",
                                "de": "<w>Obwohl</w> es stark regnete, beschlossen wir, spazieren zu gehen.",
                                "fr": "<w>Bien qu'</w>il plût à verse, nous avons décidé de faire une promenade.",
                                "it": "<w>Sebbene</w> piovesse a dirotto, decidemmo di fare una passeggiata.",
                                "cs": "<w>Ačkoliv</w> silně pršelo, rozhodli jsme se jít na procházku.",
                                "tr": "Şiddetli yağmur yağmasına <w>rağmen</w> yürüyüşe çıkmaya karar verdik.",
                                "es": "<w>Aunque</w> llovía fuertemente, decidimos salir a caminar.",
                                "zh": "<w>虽然</w>雨下得很大，我们还是决定去散步。"
                            }
                        },
                        {
                            "text": "She finished the race <w>although</w> she was very tired.",
                            "target_lang_translations": {
                                "ru": "Она закончила гонку, <w>хотя</w> очень устала.",
                                "nl": "Ze finishte de race, <w>hoewel</w> ze erg moe was.",
                                "pl": "Ukończyła bieg, <w>mimo że</w> była bardzo zmęczona.",
                                "de": "Sie beendete das Rennen, <w>obwohl</w> sie sehr müde war.",
                                "fr": "Elle a terminé la course <w>bien qu'</w>elle fût très fatiguée.",
                                "it": "Ha terminato la gara <w>anche se</w> era molto stanca.",
                                "cs": "Dokončila závod, <w>přestože</w> byla velmi unavená.",
                                "tr": "Çok yorgun olmasına <w>rağmen</w> yarışı bitirdi.",
                                "es": "Ella terminó la carrera <w>aunque</w> estaba muy cansada.",
                                "zh": "她跑完了全程，<w>尽管</w>她当时非常累。"
                            }
                        }
                    ],
                    "synonyms": [
