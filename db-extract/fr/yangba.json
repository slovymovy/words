                        "examples": [
                            {
                                "example_id": "b48ac250-86ea-4218-b702-50093421ea43",
                                "sense_id": "a1fa1625-9841-3239-8456-c27b7d3f87d3",
                                "text": "Cette dernière danse appelée yangba est très en honneur."
                            },
                            {
                                "example_id": "09679512-62f7-44a0-ab21-9453fea1c87b",
                                "sense_id": "a1fa1625-9841-3239-8456-c27b7d3f87d3",
                                "text": "Non pas une yangba. Mais toutes les yangbas. Non seulement le pas de l’éléphant, la danse des sagaies et celle des guerriers, - mais encore, mais aussi, mais surtout la danse de l’amour, que dansent si bien les sabangas."
                            },
                            {
                                "example_id": "99c9e22e-460b-4b6a-a2cb-3ab641965fc0",
                                "sense_id": "a1fa1625-9841-3239-8456-c27b7d3f87d3",
                                "text": "… quelques bêtes agonisantes sont achevées dans cette vision de cataclysme où les ombres noires des hommes dansent la yangba du feu à travers la fumée."
                            }
                        ]
                    }
