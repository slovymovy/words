                "senses": [
                    {
                        "sense_id": "d6ac4615-d693-32ed-99ac-c0b727bf4955",
                        "entry_id": "73acfafc-85ea-3c29-82f8-b0cc30bac721",
                        "glosses": [
                            "Werkzeug oder Hilfsmittel welches im wesentlichen aus Kunststoff besteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0097bc7e-12cc-46dc-a653-44a1097c9113",
                                "sense_id": "d6ac4615-d693-32ed-99ac-c0b727bf4955",
                                "text": "„Ausserdem bieten wir Ihnen ein großes Sortiment an Ionenaustauschern. Vom drucklosen Kunststoffgerät mit 700 Litern Basiskapazität bis zum hochwertigen druckfesten Edelstahlsystem mit bis zu 15000 Litern Basiskapazität.“"
                            },
                            {
                                "example_id": "791af2d9-150a-48c6-869b-ed99c9dbfc21",
                                "sense_id": "d6ac4615-d693-32ed-99ac-c0b727bf4955",
                                "text": "„Im Ultraschallbad dürfen sowohl Glas- als auch Kunststoffgeräte gereinigt werden.“"
                            },
                            {
                                "example_id": "d04e546c-6af7-4aa0-8ab6-b708e6da8eec",
                                "sense_id": "d6ac4615-d693-32ed-99ac-c0b727bf4955",
                                "text": "„Das Kunststoffgerät können Sie bei Bedarf während der Pausen an Ihrem Arbeitsplatz benutzen, die Schüssel zu Hause.“"
                            },
                            {
                                "example_id": "26313f88-ab94-47bf-81df-cb91f9460f7b",
                                "sense_id": "d6ac4615-d693-32ed-99ac-c0b727bf4955",
                                "text": "„Das Kunststoffgerät von Kernpower wird in Schwingung versetzt und trainiert je nach Anwendung die Muskeln, unterstützt den Gleichgewichtssinn oder verbessert die Haltung.“"
                            },
                            {
                                "example_id": "a7ee0c15-a852-4104-926c-4a313d36f0e0",
                                "sense_id": "d6ac4615-d693-32ed-99ac-c0b727bf4955",
                                "text": "„In der Verbindung steckt ein kleines Kunststoffgerät, eine Stimmprothese.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
