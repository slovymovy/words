                "senses": [
                    {
                        "sense_id": "2139cb50-b777-3eb0-9978-296d7688544c",
                        "entry_id": "47dd37ec-b99d-3a75-96a4-60f4d70c31d8",
                        "glosses": [
                            "Attaché für militärische Angelegenheiten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4dec538a-8eed-4e41-8d6c-84c0d646276e",
                                "sense_id": "2139cb50-b777-3eb0-9978-296d7688544c",
                                "text": "„Das letzte Mal, als George für Taylor tätig gewesen war, hatte er ein winziges Mikrophon im Lauf einer antiken, osmanischen Duellpistole versteckt, die ein türkischer Geschäftsmann anschließend in Taylors Auftrag dem bulgarischen Militärattaché in Istanbul zum Geschenk gemacht hatte.“"
                            },
                            {
                                "example_id": "d7d0f3e1-286b-4e1e-a5f7-135b89387bb3",
                                "sense_id": "2139cb50-b777-3eb0-9978-296d7688544c",
                                "text": "„Ein junger Militärattaché legte dem Präsidenten ein Dokument vor, das dieser unterzeichnete.“"
                            },
                            {
                                "example_id": "d2ecb9af-14bc-47b3-a804-a8dddd7dd669",
                                "sense_id": "2139cb50-b777-3eb0-9978-296d7688544c",
                                "text": "„Ein französischer General habe den israelischen Militärattaché in Paris angerufen, um ihn zu beglückwünschen, berichtete Ma'ariv, weil die israelische Luftwaffe französische Mirage-Bomber benutzt habe.“"
                            },
                            {
                                "example_id": "937820e0-b351-420d-b3d4-b0b4d176ff7c",
                                "sense_id": "2139cb50-b777-3eb0-9978-296d7688544c",
                                "text": "„›Irgendwann wurde Papa dann undercover nach London geschickt, als Militärattaché der russischen Botschaft, und da hat er sich dann nebenbei alles Mögliche angeeignet, was eben zu einem echten Engländer gehört.‹“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
