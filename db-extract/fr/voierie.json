                                    },
                                    {
                                        "sense_id": "002c7af1-9388-3b8d-8414-b4bfc71ffd45",
                                        "entry_id": "61d46d5b-d533-3c18-8ca0-411f41d7ec59",
                                        "glosses": [
                                            "cova onde são enterrados de uma vez vários cadáveres de vítimas de doenças, guerras, massacres etc."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "11e3035b-5eff-3f52-ae65-f13e7ff77f2a",
                                        "entry_id": "61d46d5b-d533-3c18-8ca0-411f41d7ec59",
                                        "glosses": [
                                            "condição daquele ou daquilo que perde certo privilégio ou posição favorável, em relação a um determinado grupo tido como inferior"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cdec255e-a41e-4bd0-ac0e-dcb10175908b",
                                                "sense_id": "11e3035b-5eff-3f52-ae65-f13e7ff77f2a",
                                                "text": "Vale dizer, qualquer ingestão, mesmo insignificante, sujeitará o motorista à prisão. Assim, tanto o licor num bombom ou uma única taça de champanhe quanto uma elevada dose de ingestão de bebida conduzirão da mesma forma ao cárcere. Irão todos para a vala comum dos criminosos, tendo ou não provocado acidente."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b5e87e49-afd2-495c-a687-0f2230a299d7",
                        "source_entry_id": "84fa6f9a-973b-33ab-a6cf-491d70b2d46a",
                        "source_sense_description": "Lieu où l’on dépose les charognes ou les cadavres (Sens 1)",
                        "target_lang_word": "братская могила",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "братская могила",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "90b24f49-fa74-3adb-a395-1c1416e91af6",
                                        "entry_id": "63d66370-f0ab-354d-8d70-3357739ff9c2",
                                        "glosses": [
                                            "групповое захоронение людей, массово умерших (погибших) примерно в одно время в результате стихийного бедствия, голода, эпидемий, сражения, какой-либо катастрофы и т. п."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d8619cbb-3016-422e-8bf4-1b2cfc8af613",
                                                "sense_id": "90b24f49-fa74-3adb-a395-1c1416e91af6",
                                                "text": "Под ним оказалась огромная братская могила, где были похоронены 28 молодых мужчин, погибших около 3500 лет назад в жестоком бою ― их тела были буквально истерзаны врагами."
                                            },
                                            {
                                                "example_id": "7c405ff6-baa1-4b9b-8f00-b5db4fd465b4",
                                                "sense_id": "90b24f49-fa74-3adb-a395-1c1416e91af6",
                                                "text": "Маленькое кладбище с участком ровных каменных протестантских крестов над братской могилой немцев, погибших в конце первой мировой войны."
                                            },
                                            {
                                                "example_id": "3f204b4d-c297-459b-9ce1-eff2175abb3d",
                                                "sense_id": "90b24f49-fa74-3adb-a395-1c1416e91af6",
                                                "text": "Также там [в документе «Захоронение срочное трупов в военное и мирное время»] содержится инструкция для организации братских могил. В качестве примера приводится ситуация: захоронение 1000 погибших в течение трёх суток «с момента нанесения ядерного удара»."
