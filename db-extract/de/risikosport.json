                ],
                "senses": [
                    {
                        "sense_id": "3e812d23-1622-3057-8ea9-8dd5ab3e5296",
                        "entry_id": "5ddbe4ae-6063-3792-b0b2-ac0e33e3b8c8",
                        "glosses": [
                            "mit hohem objektivem (von der Kompetenz des einzelnen Sportlers unabhängigen) Gefährdungspotenzial behaftete Sportart"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f03e8e2-6539-4236-937a-9f13b5efd030",
                                "sense_id": "3e812d23-1622-3057-8ea9-8dd5ab3e5296",
                                "text": "„Hinter dieser Gegebenheit verbirgt sich das Geheimnis, warum Risikosport und Grenzgang, aber auch zahlreiche Sportformen und Hobbies im mittleren Gefahrenbereich, Außenstehenden keinen inneren Zugang gewähren.“"
                            },
                            {
                                "example_id": "006d8167-2c9d-4130-b4ed-63d9ef53c38a",
                                "sense_id": "3e812d23-1622-3057-8ea9-8dd5ab3e5296",
                                "text": "„Heute sind die Schirme und ihre dreifachen Bremssysteme so ausgetüftelt, dass die Versicherungen das Snowkiten nicht mehr als Risikosport einstufen, sondern nur noch als Wagnis.“"
                            },
                            {
                                "example_id": "d095ecef-fbb6-46d4-bbbd-b55e6a1e893c",
                                "sense_id": "3e812d23-1622-3057-8ea9-8dd5ab3e5296",
                                "text": "„Risikosport zählt seit alters zur militärischen Ausbildung.“"
                            },
                            {
                                "example_id": "46a781f2-b316-4243-801b-bd2a7c319839",
                                "sense_id": "3e812d23-1622-3057-8ea9-8dd5ab3e5296",
                                "text": "„Da hilft kein Risikosport und kein Erlebnistourismus im Himalaya mehr.“"
                            },
                            {
                                "example_id": "6e41cdfc-90d2-41a1-bf32-5497d4d36f7f",
                                "sense_id": "3e812d23-1622-3057-8ea9-8dd5ab3e5296",
                                "text": "„Doch selbst für mutige Spitzenreiter wie ihn wird einmal die Zeit kommen, vom Risikosport Abschied zu nehmen.“"
                            },
                            {
                                "example_id": "ade03f3f-19ac-4ee4-8e4c-0db597df5b8d",
                                "sense_id": "3e812d23-1622-3057-8ea9-8dd5ab3e5296",
                                "text": "„So entziehen sich ausgereifte Sports wie das Bungeespringen, Reiten, Tauchen oder Drachenfliegen dieser Subsumierung als Risikosport, sobald objektivierende Beweisforderungen und wissenschaftliche Maßstäbe an die Zuordnung gelegt werden.“"
                            },
                            {
                                "example_id": "7c7d6468-3175-4d4f-90fd-d27f08a454b8",
                                "sense_id": "3e812d23-1622-3057-8ea9-8dd5ab3e5296",
                                "text": "„Im Risikosport verschaffen wir uns schon zu Lebzeiten einen Unsterblichkeitskick.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
