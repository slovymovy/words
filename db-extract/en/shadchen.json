                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schadchen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "08a7f8d2-74b9-3847-9e6d-e13d843213d6",
                                        "entry_id": "cbfc0f3c-d658-3024-83b2-79458439ffea",
                                        "glosses": [
                                            "jüdisch , , eine (jüdische) Person, die (gewerbsmäßig) Ehen vermittelt beziehungsweise Kuppelei betreibt"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "regional"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a53ef779-4045-4f0c-95d7-63975819eab4",
                                                "sense_id": "08a7f8d2-74b9-3847-9e6d-e13d843213d6",
                                                "text": "„Ihr wisst ja, wie es bei uns zugeht – wir werden verheiratet, wobei man die Mädchen kaum fragt, und meinen Eltern laufen die „Schadchen“, unsere gewerbsmäßigen Heiratsvermittler, fast das Haus ein und schlagen ihnen geeignete Partien für mich vor.“"
                                            },
                                            {
                                                "example_id": "8c194a67-ab2b-4936-b85c-469f9317004e",
                                                "sense_id": "08a7f8d2-74b9-3847-9e6d-e13d843213d6",
                                                "text": "„Als der König von Spanien nach Wien kam, wurden außer den Schadchen auch sämtliche Kupplerinnen Wiens mobilisiert.“"
                                            },
                                            {
                                                "example_id": "375cbd6d-ada6-41d2-858a-240e4d159f6c",
                                                "sense_id": "08a7f8d2-74b9-3847-9e6d-e13d843213d6",
                                                "text": "„Ein ‚Schadchen‘ gebraucht mancherlei Mittel, um ein schwieriges Geschäft zustande zu bringen oder ein bedrohtes zu retten, aber einem ehrbaren Manne listig eine Entehrte als Braut zuzuführen, mit solcher Schuld belastet kein Mann dieser Zunft sein Gewissen.“"
                                            },
                                            {
                                                "example_id": "28b4e523-316a-40d2-bec2-acac24bb7ebb",
                                                "sense_id": "08a7f8d2-74b9-3847-9e6d-e13d843213d6",
                                                "text": "„Seine Reime können sich aber auch auf das Brautpaar selbst beziehen, wobei er bisweilen in die Rolle des Schmusers, also des Ehevermittlers, schlüpft, wie ein Beispiel von Louis Böhm (1910) zeigt: »Ja, der Schadchen denkt sich heute, Mühe hat’s genug gemacht, eh’ ich diese beiden Leute glücklich hab zusamm’n gebracht.«“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
