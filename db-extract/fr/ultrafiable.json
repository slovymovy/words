                        "examples": [
                            {
                                "example_id": "539206c7-1f03-480a-a940-ff16a6196961",
                                "sense_id": "289020ee-4581-3f4a-9f35-ca28f9259614",
                                "text": "Aujourd’hui les données, aussi appelées « data », sont stockées dans des centres de données (data centers) contenant des rangées entières de disques durs ultrafiables."
                            },
                            {
                                "example_id": "12b97269-e911-40e1-ae8d-3b7f63fa710d",
                                "sense_id": "289020ee-4581-3f4a-9f35-ca28f9259614",
                                "text": "Pour ce faire, il requiert une connectivité réseau ultrafiable et ultraréactive, capable de fournir les valeurs de fiabilité et de latence généralement requises pour les interactions physiques en temps réel."
                            },
                            {
                                "example_id": "08bf96ca-c73f-49e1-9bfd-017fdd0a4ec0",
                                "sense_id": "289020ee-4581-3f4a-9f35-ca28f9259614",
                                "text": "En faisant reposer la confiance sur le réseau décentralisé et sur un système cryptographique, la blockchain a introduit un nouveau concept, ultrafiable, que l’on peut appliquer à des domaines très divers."
                            }
                        ]
                    }
