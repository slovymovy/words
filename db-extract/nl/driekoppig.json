                        "entry_id": "55fcde08-4161-326e-8db5-c3107e9e0bfe",
                        "glosses": [
                            "met drie (bemannings)leden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "422769aa-85f1-4e31-a78a-6d085b6b6c62",
                                "sense_id": "5d69116a-1fe8-34a6-a846-a2204152d2ff",
                                "text": "De Apollovluchten hadden een driekoppige bemanning."
                            },
                            {
                                "example_id": "3deb5f37-5122-468f-942d-969a185ce3fb",
                                "sense_id": "5d69116a-1fe8-34a6-a846-a2204152d2ff",
                                "text": "Een driekoppige jury bestaande uit Maarten van Rossem, hoogleraar geschiedenis in Utrecht, Annemarie Terhell, jeugdboekenrecensent van Kidsweek en Marchien den Hertog, eindredacteur van Historisch Nieuwsblad, koos de nominaties."
                            }
                        ]
                    },
                    {
                        "sense_id": "7de44648-4115-3c8f-8bcc-4d835d870d82",
                        "entry_id": "55fcde08-4161-326e-8db5-c3107e9e0bfe",
                        "glosses": [
                            "met drie koppen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f371436e-3ccd-466f-9a1a-b72162d5e370",
                                "sense_id": "7de44648-4115-3c8f-8bcc-4d835d870d82",
                                "text": "Het driekoppige monster werd verslagen door de koene ridder."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
