                "senses": [
                    {
                        "sense_id": "d74e0d57-bed4-3ce2-b029-2b9e0f4ff607",
                        "entry_id": "fff19321-85cc-3197-845b-3c8ffe746eb5",
                        "glosses": [
                            "Geruchswahrnehmung, der von Chili stammt oder diesem ähnelt, zum Beispiel von der Pflanze und dann besonders in deren Blütezeit, von der Frucht, der Chilischote, oder vom gewonnenen Gewürzpulver, dem Chilipulver"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "84b196e6-aa5b-4493-a3ba-94f52661a565",
                                "sense_id": "d74e0d57-bed4-3ce2-b029-2b9e0f4ff607",
                                "text": "„Für den Chiligeruch bedeutsam sind Alkylmethoxypyrazine, etwa das \"erdig\" riechende 3-Isobutyl-2-methoxypyrazin.“"
                            },
                            {
                                "example_id": "4ca50fb2-a6b2-47c8-beb8-997230549d9e",
                                "sense_id": "d74e0d57-bed4-3ce2-b029-2b9e0f4ff607",
                                "text": "„Aus dem Foyer nebenan mit seiner stattlichen Küchennische zieht Chiligeruch herüber.“"
                            },
                            {
                                "example_id": "938b459f-e040-4cb4-b9a1-fa6864a4c94d",
                                "sense_id": "d74e0d57-bed4-3ce2-b029-2b9e0f4ff607",
                                "text": "„Getrocknete Chilis bei niedriger Hitze braten, bis Ihnen der Chiligeruch in die Nase steigt.“"
                            },
                            {
                                "example_id": "8d091650-d4d2-45af-9aba-b52be4aedc2a",
                                "sense_id": "d74e0d57-bed4-3ce2-b029-2b9e0f4ff607",
                                "text": "„Chiles in Wasser kochen, bis sie gar sind und kein starker Chiligeruch mehr da ist.“"
                            },
                            {
                                "example_id": "f2b3b7af-6ea6-4e74-88c2-bd71a7bbdd56",
                                "sense_id": "d74e0d57-bed4-3ce2-b029-2b9e0f4ff607",
                                "text": "„Scharfer Chiligeruch biss ihn in die Nase.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
