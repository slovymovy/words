                                            {
                                                "example_id": "a3e27d8b-9e46-498e-a2ba-038aa0d4b5f2",
                                                "sense_id": "0bcd8972-6294-3bba-9e53-cc0189b31dbe",
                                                "text": "Во время празднества постоянно крутили «Подмосковные вечера», а после еды нам устроили дискотеку плюс караоке."
                                            },
                                            {
                                                "example_id": "4bc11b81-991a-4f53-b120-3d9c44125991",
                                                "sense_id": "0bcd8972-6294-3bba-9e53-cc0189b31dbe",
                                                "text": "Это типичное «дорожное кино» о трёх парочках, которые едут по дорогам Омахи на конкурс караоке в надежде выиграть 5 тысяч."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0fac8a46-a257-31be-9b8f-891e5bebb8b8",
                                        "entry_id": "79db13f4-0866-3ee7-a0a7-dc7027caa03a",
                                        "glosses": [
                                            "электронно-музыкальное устройство, предназначенное для такого развлечения"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4e638bbe-e727-3c6f-91bf-d3c93182e576",
                                        "entry_id": "79db13f4-0866-3ee7-a0a7-dc7027caa03a",
                                        "glosses": [
                                            "аттракцион, специально оборудованный для караоке [1]"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "680a542d-df3e-453a-b785-b946680e19f5",
                                                "sense_id": "4e638bbe-e727-3c6f-91bf-d3c93182e576",
                                                "text": "— Пойдём в караоке!"
                                            }
                                        ]
