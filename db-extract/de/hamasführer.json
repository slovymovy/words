                "senses": [
                    {
                        "sense_id": "9bbdc39e-03e5-3cac-967d-76373b9f828c",
                        "entry_id": "c7a506e1-6498-3d09-bb9a-c3229b290c1c",
                        "glosses": [
                            "ein Anführer der islamistischen Organisation Hamas"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7452b114-bc11-4fab-b25a-0a80f9b99bfd",
                                "sense_id": "9bbdc39e-03e5-3cac-967d-76373b9f828c",
                                "text": "„Der Hamasführer Ismael Hanija gibt sich kompromissbereit – Israel und die Fatah sind dennoch skeptisch […].“"
                            },
                            {
                                "example_id": "7cef6f2c-17e9-4aa7-b477-cdc96220b485",
                                "sense_id": "9bbdc39e-03e5-3cac-967d-76373b9f828c",
                                "text": "„Der exilierte Hamasführer Mashaal lebt seit mehr als zwei Jahren in Doha, nachdem er seinen früheren Stützpunkt Damaskus wegen des Bürgerkriegs in Syrien verließ.“"
                            },
                            {
                                "example_id": "17f3e6f5-5e21-4808-ab47-28544362062d",
                                "sense_id": "9bbdc39e-03e5-3cac-967d-76373b9f828c",
                                "text": "„Erstmals seit sie die Aussöhnung ihrer verfeindeten Palästinenserbewegungen vereinbart haben, haben der palästinensische Präsident Mahmoud Abbas und Hamasführer Khaled Mashaal ein Treffen für Montag in Katar verabredet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
