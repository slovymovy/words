    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "9d7522ea-8cb1-3ecc-88e0-2a014bf34e04",
                "word": "overflush",
                "pos": "adj",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "a0ba0584-90ef-4b84-8848-e8a447146372",
                        "entry_id": "9d7522ea-8cb1-3ecc-88e0-2a014bf34e04",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more overflush"
                    },
                    {
                        "form_id": "3e1ce922-6669-4cee-9c79-efa6a4a25621",
                        "entry_id": "9d7522ea-8cb1-3ecc-88e0-2a014bf34e04",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most overflush"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ccd615e7-ad30-337e-b515-9a0e34ee1939",
                        "entry_id": "9d7522ea-8cb1-3ecc-88e0-2a014bf34e04",
                        "glosses": [
                            "Too flush; having an excess of something (too much money if nothing else is specified)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "077be3d4-6473-4251-895f-2a4142b86e4d",
                                "sense_id": "ccd615e7-ad30-337e-b515-9a0e34ee1939",
                                "text": "You're a poor man, I dare say. You don't look as if you were overflush of money."
                            },
                            {
                                "example_id": "484b2957-d9bf-43f3-9daa-8a73c712fdfb",
                                "sense_id": "ccd615e7-ad30-337e-b515-9a0e34ee1939",
                                "text": "He rode into town from the Brazos, and Meekly called for his supper and bed; A dark-eyed gent with a nervous hand And a belt overflush with cold lead."
                            },
                            {
                                "example_id": "15308c6d-9e6e-4924-87fa-ae1f93dbfdea",
                                "sense_id": "ccd615e7-ad30-337e-b515-9a0e34ee1939",
                                "text": "It would raise the permit from its nominal $6 an acre for the reclamation of orphan lands to what we considered a reasonable permit but not an overflush one, of $60 an acre."
                            },
                            {
                                "example_id": "02cab9ca-06f0-488c-bfdb-8a9f34c6269c",
                                "sense_id": "ccd615e7-ad30-337e-b515-9a0e34ee1939",
                                "text": "From what you've told me,he wasn't overflush."
                            },
                            {
                                "example_id": "f68a1869-79c5-4623-9bc2-15f59a565748",
                                "sense_id": "ccd615e7-ad30-337e-b515-9a0e34ee1939",
                                "text": "You can imagine we were not overflush just then, and what puzzled us was what to give the chief as a present when he would accord us an interview."
                            }
                        ]
                    },
                    {
                        "sense_id": "2d6f52b9-207c-3548-a400-951daa438fb4",
                        "entry_id": "9d7522ea-8cb1-3ecc-88e0-2a014bf34e04",
                        "glosses": [
                            "Protruding or sticking out rather than flush and smooth."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1404ab77-dc00-490e-81db-d319507bb674",
                                "sense_id": "2d6f52b9-207c-3548-a400-951daa438fb4",
                                "text": "That is probably an overflush allusion ."
                            },
                            {
                                "example_id": "c99d5671-6c5b-4fd4-8ac9-9b51f559272d",
                                "sense_id": "2d6f52b9-207c-3548-a400-951daa438fb4",
                                "text": "Head lamp mounting surface shallow —head lamp bezel will be overflush to fender causing appearance and fit problems."
                            },
                            {
                                "example_id": "3d66bd31-0982-44ea-abb5-675b1c0e1987",
                                "sense_id": "2d6f52b9-207c-3548-a400-951daa438fb4",
                                "text": "The A-pillar, roof-rail, and C-pillar trim panels can be ordered in varying colors and styles — colorblind folks are even allowed to select silver on gold — but they look tacked on, overflush, and by design they do not align with other character lines and the hood and trunk shut-lines."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "a92ca3ff-45eb-35c1-8372-9c46120677e4",
                "word": "overflush",
                "pos": "adv",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "5d774882-cc84-4983-8329-a6bdda5733ca",
                        "entry_id": "a92ca3ff-45eb-35c1-8372-9c46120677e4",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more overflush"
                    },
                    {
                        "form_id": "4a8259cd-cb6a-4394-ae6d-df818d862680",
                        "entry_id": "a92ca3ff-45eb-35c1-8372-9c46120677e4",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most overflush"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c56e0a84-8949-3ec3-9c30-d59cc69e15df",
                        "entry_id": "a92ca3ff-45eb-35c1-8372-9c46120677e4",
                        "glosses": [
                            "Beyond the level that is flush and smooth."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a42cb97c-41ad-4664-b0ac-c15be21d9135",
                                "sense_id": "c56e0a84-8949-3ec3-9c30-d59cc69e15df",
                                "text": "The last two to three layers or 14 in. of the groove is filled up slightly overflush using 316-in. hard rod."
                            },
                            {
                                "example_id": "bbd50552-a8e3-4657-94fc-f4255f06a0b6",
                                "sense_id": "c56e0a84-8949-3ec3-9c30-d59cc69e15df",
                                "text": "Minor imperfections (such as gasket frets and corrosion on the edges of water jacket holes,) should be brazed slightly overflush before the head is milled."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "40ba857f-5568-39de-9411-c878ce5577e4",
                "word": "overflush",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "0e8babc6-209e-427f-b229-14839c9ea6e7",
                        "entry_id": "40ba857f-5568-39de-9411-c878ce5577e4",
                        "tags": [
                            "plural"
                        ],
                        "form": "overflushes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2fe5e189-b109-3fcb-8638-a84c6d3a3abd",
                        "entry_id": "40ba857f-5568-39de-9411-c878ce5577e4",
                        "glosses": [
                            "Surplus assets."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f2cc9c3-b5cf-4964-81f4-7155ef17daf5",
                                "sense_id": "2fe5e189-b109-3fcb-8638-a84c6d3a3abd",
                                "text": "In his judgment in this case, the vice Chancellor Wigram refers to my decision in Woods v. Woods, in which I held, that under a gift of \"all overflush to my wife towards her support and her family,\" the widow took the property subject to a trust for the family."
                            },
                            {
                                "example_id": "760f6355-c201-4701-a2f3-491db4666398",
                                "sense_id": "2fe5e189-b109-3fcb-8638-a84c6d3a3abd",
                                "text": "Every day there is an overflush that would be wasted but for the blessed tin can or the glass jar."
                            },
                            {
                                "example_id": "a9db78ee-4d54-4286-9387-b920dd98f335",
                                "sense_id": "2fe5e189-b109-3fcb-8638-a84c6d3a3abd",
                                "text": "We have an overflush of money at present, but I hope to show the honourable member who is interesting himself in my affairs that the influence of money will dwindle rapidly."
                            },
                            {
                                "example_id": "86a12560-35cb-461f-9ff5-41946cb61328",
                                "sense_id": "2fe5e189-b109-3fcb-8638-a84c6d3a3abd",
                                "text": "[…] if my wife should marry then my will is that two thirds of my property not disposed of be sold and thirty pounds paid to each of my grand daughters Margaret Allen and Ivea Fox as they come of age and the other third to be sold at my wife's decease if the first sail amounts to sixty pound and any overflush of both sails to be equally divided between my four grand Children above named […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "c7e75e74-3d52-3990-bf96-cf4e113177e7",
                        "entry_id": "40ba857f-5568-39de-9411-c878ce5577e4",
                        "glosses": [
                            "An excess of something."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59ca126d-3ec7-469f-a6c2-a20cbf10eb0a",
                                "sense_id": "c7e75e74-3d52-3990-bf96-cf4e113177e7",
                                "text": "This is attributed to too wet a season and consequent overflush of feed ."
                            },
                            {
                                "example_id": "565481a4-c26e-48c7-b016-87f2750bc096",
                                "sense_id": "c7e75e74-3d52-3990-bf96-cf4e113177e7",
                                "text": "Caution is necessary, for an overflush of imaginative enthusiasm can produce a situation in which the activity becomes an end in its own right rather than the means to an end."
                            },
                            {
                                "example_id": "48e7868e-7e28-4219-bb1d-7b8af2b9efc6",
                                "sense_id": "c7e75e74-3d52-3990-bf96-cf4e113177e7",
                                "text": "Lady Albinia was allowed by all who knew her, to be one of the most admirable correctives to an overflush of youth ."
                            },
                            {
                                "example_id": "4839b25e-0254-490b-801a-c79e7f4f33e5",
                                "sense_id": "c7e75e74-3d52-3990-bf96-cf4e113177e7",
                                "text": "Of life and life's significant loveliness, Be reconcilement for the easy loss Of tendril graces that climb about the heart, And smother it with overflush of bloom."
                            },
                            {
                                "example_id": "5aedf8d8-1af6-49fb-8d56-1a3134cf58ae",
                                "sense_id": "c7e75e74-3d52-3990-bf96-cf4e113177e7",
                                "text": "Margit , you've an overflush of sense in your composition. You put two thoughts where common folk such as me can only crush in one ."
                            },
                            {
                                "example_id": "f238a88d-5b4d-49ed-b026-67a03e8065d1",
                                "sense_id": "c7e75e74-3d52-3990-bf96-cf4e113177e7",
                                "text": "We were also so close together there, and if someone grew something and they got a flush of something, or an overflush of it, they'd call the next person and say, 'Would you want this or can you use some of this?"
                            }
                        ]
                    },
                    {
                        "sense_id": "43b48524-c2ed-3071-9f7d-ebcfa629053e",
                        "entry_id": "40ba857f-5568-39de-9411-c878ce5577e4",
                        "glosses": [
                            "A flush that appears over something.",
                            "A flush or tinge of color that appears over the base color."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b34f2b41-d9c6-4fc5-b96c-a1052dcce40e",
                                "sense_id": "43b48524-c2ed-3071-9f7d-ebcfa629053e",
                                "text": "If the bright ground be moved to and fro, this overflush of color may be, sometimes beautifully, shown, following the line or edge of the moving mass of strong color; and most distinct near the edge."
                            },
                            {
                                "example_id": "0b4d8d4c-3fa0-4994-a2ac-ddab3d1d0316",
                                "sense_id": "43b48524-c2ed-3071-9f7d-ebcfa629053e",
                                "text": "Sepals: Pale brown largely covered with maroon overflush."
                            },
                            {
                                "example_id": "fbf2faa7-3109-4716-9832-f5965141649c",
                                "sense_id": "43b48524-c2ed-3071-9f7d-ebcfa629053e",
                                "text": "Persian Princess— Petals deep velvety red with overflush of purple."
                            },
                            {
                                "example_id": "f1126c4d-6fce-4a3f-8a86-4efb9ec605e5",
                                "sense_id": "43b48524-c2ed-3071-9f7d-ebcfa629053e",
                                "text": "Pale greenish brown with heavy overflush of dark maroon-red at the base."
                            }
                        ]
                    },
                    {
                        "sense_id": "0b2f64a0-2d28-3f0b-9d8a-bb8ee6fe3139",
                        "entry_id": "40ba857f-5568-39de-9411-c878ce5577e4",
                        "glosses": [
                            "A flush that appears over something.",
                            "A sudden rush of feeling that appears expressed in the face."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a10059f-9515-45d3-b414-d1fc94bcc81d",
                                "sense_id": "0b2f64a0-2d28-3f0b-9d8a-bb8ee6fe3139",
                                "text": "While an overflush of marvellous grace Would master, a-sudden, all his face, Till the delicate nostril curved and swelled, and the glance an eloquent sparkle held, And a sense of song would come and go, Such as dreamers watched by Ariel know."
                            }
                        ]
                    },
                    {
                        "sense_id": "3f623216-f51b-327d-84d8-65b12cad8166",
                        "entry_id": "40ba857f-5568-39de-9411-c878ce5577e4",
                        "glosses": [
                            "A flush that appears over something.",
                            "A flush (series of obstacles to ski between) that covers a slope"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a9ca7d51-b1c5-466d-8e03-0a92435fef03",
                                "sense_id": "3f623216-f51b-327d-84d8-65b12cad8166",
                                "text": "There was an overflush and I tried to run straight into it. Most racers set up before a flush and turn into it."
                            }
                        ]
                    },
                    {
                        "sense_id": "be11bc4a-748b-304b-b07f-969da2ab6be8",
                        "entry_id": "40ba857f-5568-39de-9411-c878ce5577e4",
                        "glosses": [
                            "The act of overflushing."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c5fd47f-7ad6-44b5-86f3-569e57e168ed",
                                "sense_id": "be11bc4a-748b-304b-b07f-969da2ab6be8",
                                "text": "This increase of typhoid fever was attributed to an overflush of the intercepting sewer in November, 1897, in consequence of which sewage was discharged into the Schuylkill river near the intake of the Queen Lane Pumping Station."
                            },
                            {
                                "example_id": "efea6947-918c-42f8-80a6-b4aeb87b5e7f",
                                "sense_id": "be11bc4a-748b-304b-b07f-969da2ab6be8",
                                "text": "Every now and then the outpouring of a house, or the overflush of a drain, sent a richly laden river flowing by , and then the children were busy and happy."
                            }
                        ]
                    },
                    {
                        "sense_id": "7d0c1db9-378d-387d-85a2-7e49c81d3ad9",
                        "entry_id": "40ba857f-5568-39de-9411-c878ce5577e4",
                        "glosses": [
                            "A displacement fluid that is forced into a system in order to clear out active fluids that are used in a treatment, such as fracking, desalinization, etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5057a40b-7513-4234-a179-19e7b9bf5860",
                                "sense_id": "7d0c1db9-378d-387d-85a2-7e49c81d3ad9",
                                "text": "A treatment volume, in field usage is currently 1100 gals of chemical plus 10,000 bbls. of the aquifer water as an overflush."
                            },
                            {
                                "example_id": "c28ee384-3249-4008-808e-a2e1f0611bf1",
                                "sense_id": "7d0c1db9-378d-387d-85a2-7e49c81d3ad9",
                                "text": "The overflush consisted of 100 bbls of uncrosslinked 3000 ppm polymer, followed by one wellbore volume (~150 bbls) plus 450 bbls crude behind pipe."
                            },
                            {
                                "example_id": "f99e764a-81aa-46b5-9ce8-483dca3dbbc5",
                                "sense_id": "7d0c1db9-378d-387d-85a2-7e49c81d3ad9",
                                "text": "The first stage was 21.4 m³ crude oil preflush containing 2800-ppm paraffin dispersant, followed by 11.1 m³ treating mixture split into ten intervals with 0.5-m³ gelled oil pads followed by 19-m³ overflush containing 4000-ppm paraffin dispersant."
                            }
                        ]
                    },
                    {
                        "sense_id": "aefe0f0f-4701-3a7d-a6cc-435e7d38e3ea",
                        "entry_id": "40ba857f-5568-39de-9411-c878ce5577e4",
                        "glosses": [
                            "The act or process of forcing overflush into a system in order to clear out active fluids."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b631f656-9b58-486a-ae05-61a7054e54bf",
                                "sense_id": "aefe0f0f-4701-3a7d-a6cc-435e7d38e3ea",
                                "text": "With this type of proppant transport, the proppant bank will not be destroyed during the overflush of the diverter."
                            },
                            {
                                "example_id": "c77b4ea4-2384-447e-ae7a-f98ed316899e",
                                "sense_id": "aefe0f0f-4701-3a7d-a6cc-435e7d38e3ea",
                                "text": "On the other hand, overflush systems contain a high percentage of active resin, and an overflush is required to push the excess resin away from the wellbore area to reestablish permeability. Only a residual amount of resin saturation, which should be concentrated at the sand contact points, should remain following the overflush."
                            },
                            {
                                "example_id": "22c7c14e-c06b-426a-a49e-cc290e3a5452",
                                "sense_id": "aefe0f0f-4701-3a7d-a6cc-435e7d38e3ea",
                                "text": "This method is also carried out in three main steps namely, preflush, main flush, and overflush."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "137c4c02-819d-3fa1-a9f2-e539d4874c8c",
