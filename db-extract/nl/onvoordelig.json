                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fffbca5c-2250-3039-b535-86ab0e4d10a4",
                                        "entry_id": "7533ca1e-e4d0-3378-8ba0-19c9534319cf",
                                        "glosses": [
                                            "Serving to hinder or oppose; adverse, disadvantageous, inconducive, unsuitable."
                                        ],
                                        "tags": [
                                            "UK"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "feb90c45-e60b-4075-aaab-e0fe86d4b15f",
                                                "sense_id": "fffbca5c-2250-3039-b535-86ab0e4d10a4",
                                                "text": "The shade of a dense pine wood, is more unfavorable to the springing up of pines of the same species than of oaks within it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c6344fdd-3ff2-3d2d-9cb4-e68073b763a7",
                                        "entry_id": "7533ca1e-e4d0-3378-8ba0-19c9534319cf",
                                        "glosses": [
                                            "Not auspicious; ill-boding."
                                        ],
                                        "tags": [
                                            "UK"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "80502305-b3dd-47c6-9a07-41f126be829b",
                                                "sense_id": "c6344fdd-3ff2-3d2d-9cb4-e68073b763a7",
                                                "text": "Elizabeth was now most heartily sorry that she had, from the distress of the moment, been led to make Mr. Darcy acquainted with their fears for her sister; for since her marriage would so shortly give the proper termination to the elopement, they might hope to conceal its unfavourable beginning from all those who were not immediately on the spot."
                                            },
                                            {
                                                "example_id": "da1d131a-0f57-4d1d-a8b6-8cb5bfdf6110",
                                                "sense_id": "c6344fdd-3ff2-3d2d-9cb4-e68073b763a7",
                                                "text": "The fact that the bride went through the ceremony without her bridal bouquet is looked upon by many as an unfavorable omen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "35347143-a525-3d32-aa74-67d1b32d0bb7",
                                        "entry_id": "7533ca1e-e4d0-3378-8ba0-19c9534319cf",
                                        "glosses": [
                                            "Of a belief, state of mind, etc.: not favourable; disapproving."
                                        ],
                                        "tags": [
                                            "UK"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4563e78f-67bc-4504-9093-ac57ca4ca9a6",
                                                "sense_id": "35347143-a525-3d32-aa74-67d1b32d0bb7",
                                                "text": "[Y]et the thing she most dreaded was to offend the gypsies, by betraying her extremely unfavourable opinion of them, [...]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ef76669c-2e74-38f5-a6d8-845f607ae43e",
                                        "entry_id": "7533ca1e-e4d0-3378-8ba0-19c9534319cf",
                                        "glosses": [
                                            "Of wind or weather: causing delay or obstacles; not conducive to travel or work; inclement."
                                        ],
                                        "tags": [
                                            "UK"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b3c37f3e-8877-4a05-bf64-816f92dcb94a",
                                                "sense_id": "ef76669c-2e74-38f5-a6d8-845f607ae43e",
                                                "text": "The wind was right under the land, the tide unfavorable."
                                            }
                                        ]
                                    }
                                ]
                            },
