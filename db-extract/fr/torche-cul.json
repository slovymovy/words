        "fr-extract.jsonl": [
            {
                "entry_id": "c7e28dad-0ba9-3bbd-82b3-713acd59d18e",
                "word": "torche-cul",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "981cd537-0040-488a-8a91-ccde16d68bf3",
                        "entry_id": "c7e28dad-0ba9-3bbd-82b3-713acd59d18e",
                        "tags": [
                            "plural"
                        ],
                        "form": "torche-culs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "90f7fdd4-44c9-3325-b6e2-ae41cbaf5747",
                        "entry_id": "c7e28dad-0ba9-3bbd-82b3-713acd59d18e",
                        "glosses": [
                            "Ce dont on se sert pour s’essuyer le derrière après être allé à la selle."
                        ],
                        "tags": [
                            "slang",
                            "vulgar"
                        ],
                        "examples": [
                            {
                                "example_id": "a1103fd1-a585-4554-93b9-b0561c1b3de0",
                                "sense_id": "90f7fdd4-44c9-3325-b6e2-ae41cbaf5747",
                                "text": "Partout de vieilles boîtes de fer-blanc, […] des papiers graisseux, des étrons, des torche-culs, des tessons. L’image partout de l’égoïsme, du sans-gêne."
                            },
                            {
                                "example_id": "a02087a3-d2f6-4db7-9bfc-dc81dcf37a1b",
                                "sense_id": "90f7fdd4-44c9-3325-b6e2-ae41cbaf5747",
                                "text": "« Je me torchay après (dist Gargantua) d’un couvre chief, d’un aureiller, d’ugne pantophle, d’ugne gibbessiere, d’un panier mais ô le mal plaisant torchecul ! puis d’un chappeau. Et notez que des chappeaulx, les uns sont ras, les aultres à poil, les aultres veloutez, les aultres taffetassez, les aultres satinizez. Le meilleur de tous est celluy de poil, car il faict très bonne abstersion de la matiere fecale. »"
                            }
                        ]
                    },
                    {
                        "sense_id": "12af6e89-0aa6-3a5e-bd6f-d7029eb0c440",
                        "entry_id": "c7e28dad-0ba9-3bbd-82b3-713acd59d18e",
                        "glosses": [
                            "Périodique qui a l’habitude de publier des informations ayant peu de valeur ou mensongères."
                        ],
                        "tags": [
                            "slang",
                            "vulgar"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "711463e7-da59-4227-814e-a52fded55e7c",
                        "source_entry_id": "c7e28dad-0ba9-3bbd-82b3-713acd59d18e",
                        "source_sense_description": "Ce dont on se sert pour se torcher le cul",
                        "target_lang_word": "asswipe",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "asswipe",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "48c8d105-de1c-3a47-bdbb-25d504e11311",
                                        "entry_id": "4d15a260-9e3b-3d42-823c-37b0371a7204",
                                        "glosses": [
                                            "An annoying, contemptible, or worthless person."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US",
                                            "countable",
                                            "derogatory",
                                            "informal",
                                            "mildly",
                                            "offensive",
                                            "uncountable",
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7ae76893-5142-446f-8fd1-6686c9abba95",
                                                "sense_id": "48c8d105-de1c-3a47-bdbb-25d504e11311",
                                                "text": "He is such an asswipe!"
                                            },
                                            {
                                                "example_id": "ea9cb614-a736-4336-a70f-cafb8ce41c72",
                                                "sense_id": "48c8d105-de1c-3a47-bdbb-25d504e11311",
                                                "text": "...they have been exchanging insults in writing: \"dickhead,\" \"dillweed,\" \"fuzzbutt,\" \"dorkwad,\" \"asswipe,\" and so forth."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a5dc8ce5-812f-3331-9855-f1a81a945db0",
                                        "entry_id": "4d15a260-9e3b-3d42-823c-37b0371a7204",
                                        "glosses": [
                                            "Toilet paper."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US",
                                            "informal",
                                            "mildly",
                                            "uncountable",
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f8eacef1-4c12-45ca-b234-07f0e9f94a79",
                                                "sense_id": "a5dc8ce5-812f-3331-9855-f1a81a945db0",
                                                "text": "I rapidly expended my own and everyone else’s supply of tiny C-ration rolls of asswipe and was reduced to wiping my nasty behind with leaves and grass."
                                            },
                                            {
                                                "example_id": "b9e4f11e-7dc9-483f-83cf-026f47d9d0f0",
                                                "sense_id": "a5dc8ce5-812f-3331-9855-f1a81a945db0",
                                                "text": "“[…] Into your packs you put your toilet articles, mess kits, extra socks, and skivvies and longjohns if you have them. If you have a roll of asswipe, put that in, too. […]”"
                                            },
                                            {
                                                "example_id": "4ed1f0b8-ddbd-4dbf-a936-7b079923853e",
                                                "sense_id": "a5dc8ce5-812f-3331-9855-f1a81a945db0",
                                                "text": "I doubt a dime would buy a single square of asswipe in this city, […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
