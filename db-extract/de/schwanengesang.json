                "senses": [
                    {
                        "sense_id": "11a7ed53-646a-330f-8481-8a400d500e8a",
                        "entry_id": "65fa7ce0-10de-3282-b6ad-2de8ced43092",
                        "glosses": [
                            "ein letztes künstlerisches Werk, bedeutendes Werk am Ende einer Periode"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9ac15d67-d410-4486-98cf-903abc52ff04",
                                "sense_id": "11a7ed53-646a-330f-8481-8a400d500e8a",
                                "text": "„Spektakulärer hätte der Schwanengesang des Futurismus nicht ausfallen können.“"
                            },
                            {
                                "example_id": "fbc2c32a-9f69-4127-9daa-53659e481488",
                                "sense_id": "11a7ed53-646a-330f-8481-8a400d500e8a",
                                "text": "„Schwanengesänge währen ewig.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c644e5f8-d8de-4145-80e7-a490a1f4a62e",
                        "source_entry_id": "65fa7ce0-10de-3282-b6ad-2de8ced43092",
                        "source_sense_id": "11a7ed53-646a-330f-8481-8a400d500e8a",
                        "source_sense_description": "ein letztes künstlerisches Werk, bedeutendes Werk am Ende einer Periode",
                        "target_lang_word": "swan song",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "swan song",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cdf7b218-2f04-33fe-b615-9ba1860e3b78",
                                        "entry_id": "1175996f-bfe1-3294-afec-698767be0173",
                                        "glosses": [
                                            "A final performance or accomplishment, especially one before retirement."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3024442c-d0b0-4dec-a684-ff4067ff2d67",
                                                "sense_id": "cdf7b218-2f04-33fe-b615-9ba1860e3b78",
                                                "text": "Yet, on the whole, our good Saint-Pierre is musical, poetical though most morbid: we will call his Book the swan-song of old dying France."
                                            },
                                            {
                                                "example_id": "6d41fecc-2f5e-4672-84b5-b20eadb8dc01",
                                                "sense_id": "cdf7b218-2f04-33fe-b615-9ba1860e3b78",
                                                "text": "In no other way can be explained our sacrifices and martyrdoms. For no other reason did Rudolph Mendenhall flame out his soul for the Cause and sing his wild swan-song that last night of life."
                                            },
                                            {
                                                "example_id": "5c798159-ed85-4de5-9173-41a1ebe60782",
                                                "sense_id": "cdf7b218-2f04-33fe-b615-9ba1860e3b78",
                                                "text": "\"A Connecticut Yankee in King Arthur's Court\"[…]—a pretentious volume which Mark Twain really considered his last. \"It's my swan-song, my retirement from literature permanently,\" he wrote Howells, though certainly he was young, fifty-four, to have reached this conclusion."
                                            },
                                            {
                                                "example_id": "e119154f-4b02-473b-9eba-4415d6fc58a0",
                                                "sense_id": "cdf7b218-2f04-33fe-b615-9ba1860e3b78",
                                                "text": "Je ne parle pas français. That was her swan song for me."
                                            },
                                            {
                                                "example_id": "b55ffa71-b3fe-4925-96e6-03c3104faadc",
                                                "sense_id": "cdf7b218-2f04-33fe-b615-9ba1860e3b78",
                                                "text": "[…]McCartney III could mark the end of his recording career. For a musician as continually prolific as McCartney (this is his 18th solo record), that seems unlikely. But if it is indeed a swan song, McCartney III will stand as a proper coda for the singer-songwriter we’ve been listening to for fifty-odd years: sentimental yet strong, a bit wistful, but as always, looking ahead."
                                            },
                                            {
                                                "example_id": "a878a008-63e2-47ff-bfb2-19ee8b185a89",
                                                "sense_id": "cdf7b218-2f04-33fe-b615-9ba1860e3b78",
                                                "text": "Merkel’s political and scientific sides slug it out in swan song presser [title]"
                                            },
                                            {
                                                "example_id": "9441ef4d-4503-4946-883e-2ebbfc3dd68d",
                                                "sense_id": "cdf7b218-2f04-33fe-b615-9ba1860e3b78",
                                                "text": "[S]pielberg was keen to stress that The Fabelmans is not a full stop: “It is not because I decided to retire, and this is my swan song, don’t believe that.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e9621f00-dded-4d4c-ba8e-87ac6750483b",
                        "source_entry_id": "65fa7ce0-10de-3282-b6ad-2de8ced43092",
                        "source_sense_id": "11a7ed53-646a-330f-8481-8a400d500e8a",
                        "source_sense_description": "ein letztes künstlerisches Werk, bedeutendes Werk am Ende einer Periode",
                        "target_lang_word": "chant du cygne",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chant du cygne",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5f6f6930-71ff-33f0-aed8-3713887d6f7e",
                                        "entry_id": "bc671424-4f02-3573-9761-d158272bcf87",
                                        "glosses": [
                                            "Chant mélodieux que des poètes attribuent au cygne mourant."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f5ef55f1-e945-3e31-9517-8a3887476d5c",
                                        "entry_id": "bc671424-4f02-3573-9761-d158272bcf87",
                                        "glosses": [
                                            "Voix des poètes."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1ec247b5-899a-3633-9705-899a77901cda",
                                        "entry_id": "bc671424-4f02-3573-9761-d158272bcf87",
                                        "glosses": [
                                            "Dernière œuvre marquante ou remarquable qu’un artiste, qu’un homme éloquent… a terminé ou produit peu de temps avant de quitter la vie publique ou avant sa mort."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b8d6d8be-985c-4432-891b-4f808acea778",
                                                "sense_id": "1ec247b5-899a-3633-9705-899a77901cda",
                                                "text": "Douze ans après, le discours aux Nations unies de Dominique de Villepin tentant de conjurer le déclenchement de la guerre en Irak résonne encore ; ce fut à sa façon, un chant du cygne, « ultime morceau de bravoure et dernier écho d’une tradition universaliste fière d’elle même » […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b140aaa4-1db9-317c-99d5-1547eb64e4e6",
                                        "entry_id": "bc671424-4f02-3573-9761-d158272bcf87",
                                        "glosses": [
                                            "Dernière action vraiment importante et notable avant la fin d’une entreprise, d’une époque, d'une action."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "972ef22e-c299-4701-b7cc-5a8479860609",
                                                "sense_id": "b140aaa4-1db9-317c-99d5-1547eb64e4e6",
                                                "text": "[…] la navigation à vapeur sauve alors la France de la disette en transportant, à partir de Marseille, les énormes quantités de céréales dont le besoin se faisait cruellement sentir. Triomphe alors de Bonnardel, mais les autres entrepreneurs ne se faisaient pas d’illusion et comprenaient que ce n’était là que le chant du cygne."
                                            },
                                            {
                                                "example_id": "7a80e965-019d-40f3-ad38-98296e8a94e0",
                                                "sense_id": "b140aaa4-1db9-317c-99d5-1547eb64e4e6",
                                                "text": "Si des mouvements sectoriels perdurent, notamment chez les avocats, dans les ports ou le secteur de l’énergie, et que des coups d’éclat sont menés çà et là – comme des coupures d’électricité sauvages –, ce serait, à en croire le gouvernement, le chant du cygne de la contestation sociale."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6b28b751-6a47-421b-80a8-0cb84a7c6c71",
                        "source_entry_id": "65fa7ce0-10de-3282-b6ad-2de8ced43092",
