                "senses": [
                    {
                        "sense_id": "bacf64e0-1a72-39f2-b472-f100fad9151f",
                        "entry_id": "07c36b26-e70e-3877-802f-cad2fb1eea8e",
                        "glosses": [
                            "Aufbau eines haltbaren Impfschutzes; Verabreichung einer empfohlenen Anzahl von Impfungen in einem vorgegebenen Zeitraster, um gegen Krankheit geschützt zu sein, die durch einen entsprechenden Erreger ausgelöst werden kann, gegen den geimpft/immunisiert wird"
                        ],
                        "tags": [
                            "Immunologie"
                        ],
                        "examples": [
                            {
                                "example_id": "0229eec7-e210-4bcf-b47c-9e522110c700",
                                "sense_id": "bacf64e0-1a72-39f2-b472-f100fad9151f",
                                "text": "Bei Tetanus gelten die übliche Grundimmunisierung und Auffrischungsimpfungen gemäß Impfkalender."
                            },
                            {
                                "example_id": "d615043c-92ef-4799-aa0b-a2e04e2f0623",
                                "sense_id": "bacf64e0-1a72-39f2-b472-f100fad9151f",
                                "text": "„In aller Regel wird für die erste Grundimmunisierung im Säuglingsalter ein Sechsfach-Impfstoff verwendet: Er immunisiert gegen Diphtherie, Hepatitis B, Hib (Haemophilus influenzae), Keuchhusten, Kinderlähmung (Polio) und Wundstarrkrampf (Tetanus).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
