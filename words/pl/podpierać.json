{
    "word_family": [
        "podparcie",
        "podpórka",
        "podpora",
        "odpierać",
        "opierać",
        "wspierać",
        "zapierać"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3769b369-7317-363c-ba92-d5f50cbf6278",
                    "sense_definition": "dawać czemuś fizyczne oparcie, aby nie runęło, nie przewróciło się lub nie opadło",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "fizyczne podparcie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Robotnicy <w>podpierają</w> drewnianymi belkami starą ścianę, która grozi zawaleniem.",
                            "target_lang_translations": {
                                "en": "The workers are <w>propping up</w> the old wall that is in danger of collapsing with wooden beams."
                            }
                        },
                        {
                            "text": "Siedział przy biurku przez wiele godzin, w zamyśleniu <w>podpierając</w> głowę rękami.",
                            "target_lang_translations": {
                                "en": "He sat at the desk for many hours, pensively <w>resting</w> his head in his hands."
                            }
                        }
                    ],
                    "synonyms": [
                        "podtrzymywać"
                    ],
                    "common_phrases": [
                        "podpierać głowę",
                        "podpierać brodę",
                        "podpierać belkami"
                    ],
                    "target_lang_definitions": {
                        "en": "to provide physical support to something to prevent it from collapsing, falling, or drooping"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "prop up",
                                "target_lang_sense_clarification": "to physically support something from falling or sagging"
                            },
                            {
                                "target_lang_word": "support",
                                "target_lang_sense_clarification": "to hold up physically"
                            },
                            {
                                "target_lang_word": "shore up",
                                "target_lang_sense_clarification": "with beams or struts"
                            },
                            {
                                "target_lang_word": "rest",
                                "target_lang_sense_clarification": "e.g., resting one's head on hands"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dee6a198-d53f-31e5-be65-5ec563d5f51b",
                    "sense_definition": "używać czegoś jako oparcia dla własnego ciała podczas stania lub poruszania się",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "fizyczne podparcie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Starszy pan <w>podpierał</w> się drewnianą laską podczas spaceru po parku.",
                            "target_lang_translations": {
                                "en": "The elderly gentleman was <w>supporting himself with</w> a wooden cane while walking through the park."
                            }
                        },
                        {
                            "text": "Po wyczerpującym treningu zawodnik ledwo stał i musiał <w>podpierać</w> się o ścianę.",
                            "target_lang_translations": {
                                "en": "After the exhausting workout, the athlete could barely stand and had to <w>lean</w> against the wall."
                            }
                        }
                    ],
                    "synonyms": [
                        "opierać się"
                    ],
                    "common_phrases": [
                        "podpierać się laską",
                        "podpierać się o ścianę",
                        "podpierać się pod boki"
                    ],
                    "target_lang_definitions": {
                        "en": "to use something as support for one's body when standing or moving (podpierać się)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "lean on",
                                "target_lang_sense_clarification": "using a cane, wall, or object for physical balance"
                            },
                            {
                                "target_lang_word": "support oneself with",
                                "target_lang_sense_clarification": "using an object like a stick or crutch"
                            },
                            {
                                "target_lang_word": "rest on",
                                "target_lang_sense_clarification": "resting one's weight against"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "56656a3f-5de3-337c-98f0-f09355cf3916",
                    "sense_definition": "być fizyczną podstawą lub oparciem dla czegoś, przenosząc jego ciężar",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fizyczne podparcie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Masywne marmurowe kolumny <w>podpierają</w> całe sklepienie tej zabytkowej świątyni.",
                            "target_lang_translations": {
                                "en": "Massive marble columns <w>support</w> the entire vault of this historic temple."
                            }
                        },
                        {
                            "text": "Dwa grube filary <w>podpierały</w> strop w piwnicy.",
                            "target_lang_translations": {
                                "en": "Two thick pillars <w>held up</w> the ceiling in the basement."
                            }
                        }
                    ],
                    "synonyms": [
                        "dźwigać",
                        "podtrzymywać"
                    ],
                    "common_phrases": [
                        "podpierać strop",
                        "podpierać sklepienie"
                    ],
                    "target_lang_definitions": {
                        "en": "to be the structural base or support carrying the weight of something"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "support",
                                "target_lang_sense_clarification": "carry the weight of an architectural structure"
                            },
                            {
                                "target_lang_word": "hold up",
                                "target_lang_sense_clarification": "bear structural weight"
                            },
                            {
                                "target_lang_word": "prop up",
                                "target_lang_sense_clarification": "keep a ceiling or structure up"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "98cf535e-c32d-3ae7-9fc9-8084a1c19f9b",
                    "sense_definition": "uzasadniać lub wzmacniać jakieś twierdzenie faktami, dowodami lub argumentami",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "argumentacja",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Naukowiec zawsze chętnie <w>podpiera</w> swoje teorie wynikami rzetelnych badań.",
                            "target_lang_translations": {
                                "en": "The scientist is always keen to <w>back up</w> his theories with reliable research findings."
                            }
                        },
                        {
                            "text": "Autor książki <w>podpierał</w> kontrowersyjne tezy licznymi cytatami ze źródeł historycznych.",
                            "target_lang_translations": {
                                "en": "The author of the book <w>supported</w> controversial claims with numerous quotes from historical sources."
                            }
                        }
                    ],
                    "synonyms": [
                        "popierać",
                        "uzasadniać",
                        "wzmacniać"
                    ],
                    "antonyms": [
                        "podważać"
                    ],
                    "common_phrases": [
                        "podpierać tezę",
                        "podpierać argumentami"
                    ],
                    "target_lang_definitions": {
                        "en": "to back up or substantiate a claim, theory, or statement with facts, evidence, or arguments"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "support",
                                "target_lang_sense_clarification": "substantiate an argument or theory"
                            },
                            {
                                "target_lang_word": "back up",
                                "target_lang_sense_clarification": "provide evidence for a claim"
                            },
                            {
                                "target_lang_word": "substantiate",
                                "target_lang_sense_clarification": "prove with evidence"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "afc84848-c3f6-32cb-8e21-ea2e5d3cc24a",
                    "sense_definition": "powoływać się na autorytety, przepisy lub źródła w celu uzasadnienia swojego zdania",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "argumentacja",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Prawnik <w>podpierał</w> się w sądzie najnowszymi wyrokami Trybunału Konstytucyjnego.",
                            "target_lang_translations": {
                                "en": "In court, the lawyer <w>relied on</w> the latest rulings of the Constitutional Tribunal."
                            }
                        },
                        {
                            "text": "Podczas burzliwej dyskusji często <w>podpierała</w> się opiniami znanych ekspertów.",
                            "target_lang_translations": {
                                "en": "During the heated discussion, she often <w>drew upon</w> the opinions of renowned experts."
                            }
                        }
                    ],
                    "synonyms": [
                        "powoływać się"
                    ],
                    "common_phrases": [
                        "podpierać się przepisami",
                        "podpierać się autorytetem"
                    ],
                    "target_lang_definitions": {
                        "en": "to cite authorities, regulations, or sources to justify one's stance (podpierać się)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "invoke",
                                "target_lang_sense_clarification": "cite regulations or authority"
                            },
                            {
                                "target_lang_word": "draw upon",
                                "target_lang_sense_clarification": "rely on expert opinions or facts"
                            },
                            {
                                "target_lang_word": "rely on",
                                "target_lang_sense_clarification": "base arguments on authorities or rules"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c98e1374-c88b-30bd-a059-8e441142a8f9",
                    "sense_definition": "dawać sobie nawzajem oparcie lub pomoc, trzymając się razem",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "fizyczne podparcie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ranni turyści powoli schodzili ze szlaku, <w>podpierając</w> się nawzajem ramionami.",
                            "target_lang_translations": {
                                "en": "The injured hikers were slowly making their way down the trail, <w>supporting each other</w> by the shoulders."
                            }
                        },
                        {
                            "text": "Zmęczeni wędrowcy szli pod wiatr i <w>podpierali</w> się wzajemnie, by nie upaść.",
                            "target_lang_translations": {
                                "en": "Tired travelers walked against the wind and <w>leaned on each other</w> so as not to fall."
                            }
                        }
                    ],
                    "common_phrases": [
                        "podpierać się wzajemnie",
                        "podpierać się nawzajem"
                    ],
                    "target_lang_definitions": {
                        "en": "to give each other physical support or assistance by holding onto one another"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "support each other",
                                "target_lang_sense_clarification": "physically holding each other up"
                            },
                            {
                                "target_lang_word": "lean on each other",
                                "target_lang_sense_clarification": "using one another for balance"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d104f777-ed82-35d0-9e55-c8e4033b302d",
                    "sense_definition": "robić drobne pranie lub prać odzież na bieżąco, po trochu",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Gdy zepsuła się pralka, gospodyni każdego wieczoru ręcznie <w>podpierała</w> brudne ubrania.",
                            "target_lang_translations": {
                                "en": "When the washing machine broke down, the landlady <w>washed</w> dirty clothes by hand every evening."
                            }
                        },
                        {
                            "text": "W akademiku często <w>podpierał</w> pojedyncze koszule w umywalce.",
                            "target_lang_translations": {
                                "en": "In the dormitory, he often <w>rinsed out</w> single shirts in the sink."
                            }
                        }
                    ],
                    "synonyms": [
                        "przepierać"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "używane potocznie w odniesieniu do prania pojedynczych rzeczy"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to do a small wash or wash a few items of clothing by hand as you go"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "wash by hand",
                                "target_lang_sense_clarification": "wash a few clothes individually"
                            },
                            {
                                "target_lang_word": "rinse out",
                                "target_lang_sense_clarification": "wash a garment quickly"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}