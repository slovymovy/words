                        "form": "numeracies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6663e6a2-91de-3555-8143-f3c0ad16e12b",
                        "entry_id": "d67b824a-cc3f-392b-a52e-f5349c562ba5",
                        "glosses": [
                            "Numerical skill.",
                            "Competence with mathematics and with how to apply it to practical applications; sufficient ability to think critically in a quantitative way."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "7630f527-e9d0-4021-9a27-72f9a2517d9c",
                                "sense_id": "6663e6a2-91de-3555-8143-f3c0ad16e12b",
                                "text": "John Allen Paulos and others have asked our society to consider numeracy and innumeracy in a way closer to how we view literacy and illiteracy."
                            },
                            {
                                "example_id": "18162f36-ae40-431e-8f32-6c31275d5a44",
                                "sense_id": "6663e6a2-91de-3555-8143-f3c0ad16e12b",
                                "text": "Numeracy includes such things as comprehending intuitively that a mean can sometimes be vastly different from a median and thus does not always represent a typical specimen, even despite being called \"average\"."
                            }
                        ]
                    },
                    {
                        "sense_id": "c02026a8-96be-3abc-9949-2acab9ca4373",
                        "entry_id": "d67b824a-cc3f-392b-a52e-f5349c562ba5",
                        "glosses": [
                            "Numerical skill.",
                            "Ability to manipulate numbers at all, even for the simplest of arithmetic, such as adding two and two."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "95c6a873-3e1b-40d0-ab70-a4e36b5ee13a",
                                "sense_id": "c02026a8-96be-3abc-9949-2acab9ca4373",
                                "text": "The man lost all numeracy when he had a stroke, so he now depended on his wife for even the simplest financial matters, such as making change or paying a cashier."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
