                        "examples": [
                            {
                                "example_id": "6811a591-4c6b-4104-a2aa-56f00bf35ebe",
                                "sense_id": "8c84f0bb-3129-3172-828b-9aa849be8608",
                                "text": "What spanless oceans of unselfish, loving service, what spanless seas of victories, gilded and garnished by unvoiced sufferings!"
                            },
                            {
                                "example_id": "bf6d9190-ec23-46ac-b359-c18005656dcf",
                                "sense_id": "8c84f0bb-3129-3172-828b-9aa849be8608",
                                "text": "\"As king,\" comes rining from every side of the shrouded summits, which catch the words and bear them from hollow, spanless depths to wild, yawning gorges among the black cliffs, down which green waters pour from the gloomy precincts of the cave where rest the remains of Onesinda."
                            }
                        ]
