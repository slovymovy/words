                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "12324ef3-d3c1-439a-ba39-5c0643125bff",
                                                "sense_id": "2a425b45-4ff0-352b-b857-08d72dae8e61",
                                                "text": "Hij haalt soms de flauwste grappen uit."
                                            },
                                            {
                                                "example_id": "1b1a31fb-3781-48d6-9e56-ddb2c962eb30",
                                                "sense_id": "2a425b45-4ff0-352b-b857-08d72dae8e61",
                                                "text": "' 'Wat zeg je?' 'Ik was dronken en maakte een flauw grapje."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a5c02039-d9e3-367a-807b-1c075c6d6ab1",
                                        "entry_id": "c0d4c9b8-35a1-3a75-8dc4-8a02071269f7",
                                        "glosses": [
                                            "weinig enthousiast"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f8e613d-3bc6-45d8-940e-ad9c82650f05",
                                                "sense_id": "a5c02039-d9e3-367a-807b-1c075c6d6ab1",
                                                "text": "Met een flauw lachje zei ze: 'Ik hoop voor u dat het het eerste is."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5fcedd72-6454-3112-92e2-c6214c612714",
                                        "entry_id": "c0d4c9b8-35a1-3a75-8dc4-8a02071269f7",
                                        "glosses": [
                                            "zwak"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "533c60e4-ec6a-4ddc-8fb7-9e75b0f9a0c4",
                                                "sense_id": "5fcedd72-6454-3112-92e2-c6214c612714",
                                                "text": "Ze vond het een flauw verweer."
                                            },
                                            {
                                                "example_id": "4f5f4060-51c7-4df3-a5f7-9edd41d50290",
                                                "sense_id": "5fcedd72-6454-3112-92e2-c6214c612714",
                                                "text": "Ik wilde die duisternis niet in, ook al ging er een flauw licht aan op het plankier als je er iets verder op liep."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "41a9da5d-d3af-3383-ac8b-084df7b587d9",
                                        "entry_id": "c0d4c9b8-35a1-3a75-8dc4-8a02071269f7",
                                        "glosses": [
                                            "slap zonder kracht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "77b0692e-836a-4e79-bfd2-c2b312aa0530",
                                                "sense_id": "41a9da5d-d3af-3383-ac8b-084df7b587d9",
                                                "text": "Wij waren die ochtend helemaal flauw van de honger en dorst, er was geen brood meer en bijna geen water."
                                            },
                                            {
                                                "example_id": "f9bd2787-80a6-470e-bbb5-f40ff36b46d1",
                                                "sense_id": "41a9da5d-d3af-3383-ac8b-084df7b587d9",
                                                "text": "De pa van Milan ging net zo lang door tot zijn zoon flauw was gevallen en slap aan het touw hing en zijn rug droop van het bloed."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
