                ],
                "senses": [
                    {
                        "sense_id": "80e8e704-8d6c-3f5e-b5bf-30734f3e5c54",
                        "entry_id": "152c6ac3-6875-3892-8731-bbf2e452cb9f",
                        "glosses": [
                            "Auswirkung, Wirkung durch eine gezielte Luftführung"
                        ],
                        "tags": [
                            "physics"
                        ],
                        "examples": [
                            {
                                "example_id": "f088d61c-20eb-4d4e-9c71-d0f5660bfe59",
                                "sense_id": "80e8e704-8d6c-3f5e-b5bf-30734f3e5c54",
                                "text": "„Die Querlüftung bewirkt die schnellsten Lüftungseffekte, ist aber in den meisten Fällen kaum in den Arbeitsalltag zu integrieren.“"
                            },
                            {
                                "example_id": "72fe90ba-d8c8-4ed4-b173-1c5145505b9d",
                                "sense_id": "80e8e704-8d6c-3f5e-b5bf-30734f3e5c54",
                                "text": "„Der entsprechend niedrige Ruhedruck gewährleistet dabei einen guten Lüftungseffekt, so dass der Blutumlauf in den nutritiven Gefäßen, insbesondere bei Stagnation infolge mangelnder Abschöpfung durch die tiefen Leitvenen, gefördert wird.“"
                            },
                            {
                                "example_id": "603c46a7-7ac6-40fe-873e-3117f47a50a5",
                                "sense_id": "80e8e704-8d6c-3f5e-b5bf-30734f3e5c54",
                                "text": "„Durch die Auswertung der Anlagenlaufzeiten und des Luftvolumenstroms von Bestandsanlagen konnten direkte Rückschlüsse auf den erzielten Lüftungseffekt gezogen werden.“"
                            },
                            {
                                "example_id": "16b9dc5b-26ea-4776-9454-373641b120db",
                                "sense_id": "80e8e704-8d6c-3f5e-b5bf-30734f3e5c54",
                                "text": "„Gekippte Fenster haben fast keinen Lüftungseffekt, sondern kühlen die Wände aus und können dadurch zu Schimmelbildung führen.“"
                            },
                            {
                                "example_id": "98046101-f2e0-446f-a189-ceb774d8f06c",
                                "sense_id": "80e8e704-8d6c-3f5e-b5bf-30734f3e5c54",
                                "text": "„Der Lüftungseffekt ist am größten, wenn alle Räume gleichzeitig gelüftet werden und währenddessen auch die Innentüren geöffnet sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
