                                                "sense_id": "7af49ff1-6496-38eb-9105-b91caa3cf687",
                                                "text": "Er hat ein starkes Durchsetzungsvermögen."
                                            },
                                            {
                                                "example_id": "3785eef2-9e92-4ac7-a18c-df10068da1aa",
                                                "sense_id": "7af49ff1-6496-38eb-9105-b91caa3cf687",
                                                "text": "Letztlich war es ihr Durchsetzungsvermögen, das zum Erfolg führte."
                                            },
                                            {
                                                "example_id": "bdcc2ec7-d9a1-4648-be56-091d9a44eba2",
                                                "sense_id": "7af49ff1-6496-38eb-9105-b91caa3cf687",
                                                "text": "„Das Fähnlein verlor um diese Zeit sein Durchsetzungsvermögen.“"
                                            }
                                        ],
