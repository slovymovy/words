                                                "example_id": "c003b091-f291-480e-851e-ff178d9ce98f",
                                                "sense_id": "408dca03-c871-347a-b4ed-8afa44edeb81",
                                                "text": "Конная ярмарка."
                                            },
                                            {
                                                "example_id": "db1b61df-8eda-472c-af26-ebfbaf0ebc06",
                                                "sense_id": "408dca03-c871-347a-b4ed-8afa44edeb81",
                                                "text": "Конный номер в цирке."
                                            },
                                            {
                                                "example_id": "66932b83-1fe2-4db8-a718-617e42c80183",
                                                "sense_id": "408dca03-c871-347a-b4ed-8afa44edeb81",
                                                "text": "[Я] увидел цепь конных городовых."
                                            },
                                            {
                                                "example_id": "5defce83-1701-4b4a-b0e4-b2b2d952bae9",
                                                "sense_id": "408dca03-c871-347a-b4ed-8afa44edeb81",
                                                "text": "В России колокольчик под дугой был частью конной у́пряжи, однако далеко не каждый хозяин мог себе позволить купить дорогое литое изделие."
                                            }
                                        ]
                                    },
