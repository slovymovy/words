                        "source_sense_id": "bf6ee949-5a75-3268-bcd4-94ee1a9faef1",
                        "source_sense_description": "een beeldscherm dat ook als invoerapparaat voor een computer kan worden gebruikt door het scherm aan te raken.",
                        "target_lang_word": "Touchscreen",
                        "target_lang_code": "de",
