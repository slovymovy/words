                ],
                "senses": [
                    {
                        "sense_id": "1907b1ec-beed-36eb-b1ec-6921b39aa5d6",
                        "entry_id": "a5badca2-348f-32e1-8cf0-482948881f79",
                        "glosses": [
                            "Milieu, vor allem der Künstler, das sich nicht an bürgerliche Konventionen gebunden fühlt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "554e60f4-6760-4ffc-b0b2-5785d3dc2e00",
                                "sense_id": "1907b1ec-beed-36eb-b1ec-6921b39aa5d6",
                                "text": "„Soll ich sie alle nennen, diese merkwürdigen, interessanten oder lustigen Erscheinungen der Künstlerschaft und Bohème?“"
                            },
                            {
                                "example_id": "d89d8f41-2d96-4d6a-8a8a-5ee837f6a6d5",
                                "sense_id": "1907b1ec-beed-36eb-b1ec-6921b39aa5d6",
                                "text": "„Als ich zum ersten Male in das Berliner »Café Größenwahn« kam, verließ ich das Preußentum für immer und betrat das Hoheitsgebiet der Bohème, wo man in fremden Zungen sprach und schrieb…“"
                            },
                            {
                                "example_id": "16425126-fbe3-4ce5-8c78-cbc2c94b0fd4",
                                "sense_id": "1907b1ec-beed-36eb-b1ec-6921b39aa5d6",
                                "text": "„Das war gar nicht schön von ihm, denn an der armen Bohème hatte er ja all sein Geld verdient und konnte auch weiterhin viel Geld verdienen.“"
                            },
                            {
                                "example_id": "07995f78-97c4-4e04-b115-7d4d1db69684",
                                "sense_id": "1907b1ec-beed-36eb-b1ec-6921b39aa5d6",
                                "text": "„Er hätte in Paris bei Frauen Erfolg haben können, die junge Künstler protegieren, oder hätte in den Kreisen der damaligen Berliner Bohème untertauchen können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
