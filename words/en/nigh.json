                    "synonyms": [
                        "close"
                    ],
                    "antonyms": [
                        "distant"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rare and archaic"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Ściśle powiązany naturą, relacją lub okolicznościami; bliski, intymny.",
                        "ru": "Тесно связанный по духу, происхождению или обстоятельствам; близкий."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "bliski",
