                        "target_lang_word": "zijden",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zijden",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "66bf5a0e-6101-3cf6-83b2-1f89a460f8ad",
                                        "entry_id": "5aff4956-8989-344a-afa9-7140b1575ee4",
                                        "glosses": [
                                            "van zijde, van zijdegaren vervaardigd"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a13ab44a-2448-48f0-8e81-0c08f8c22ea7",
                                                "sense_id": "66bf5a0e-6101-3cf6-83b2-1f89a460f8ad",
                                                "text": "Die zijden sjaal voelt enorm zacht aan."
                                            },
                                            {
                                                "example_id": "b32501bd-7b4e-4d66-a23a-b0a21f4bd643",
                                                "sense_id": "66bf5a0e-6101-3cf6-83b2-1f89a460f8ad",
                                                "text": "Een lichtroze zijden blouse waar ze losjes een grijze satijnen stropdas in had gestopt."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5d463e04-442e-3df4-a834-bc68a82928cd",
                                        "entry_id": "5aff4956-8989-344a-afa9-7140b1575ee4",
                                        "glosses": [
                                            "op zijde gelijkend, als van zijde, zacht en glanzend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db916f34-f402-4168-bc3e-fe385347d452",
                                                "sense_id": "5d463e04-442e-3df4-a834-bc68a82928cd",
                                                "text": "Ik streelde haar zijden huid."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "zijden",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "ad5d61e4-3dce-396b-9555-2a3b3d98c1a9",
                                        "entry_id": "c8c03fcd-653b-3290-a54e-173b78c9e78a",
                                        "glosses": [
                                            "meervoud van het zelfstandig naamwoord zijde"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d3d43bf1-5d88-4a62-b8b7-483206296fcb",
                                                "sense_id": "ad5d61e4-3dce-396b-9555-2a3b3d98c1a9",
                                                "text": "Als ze het huisje draait, ziet ze aan alle zijden ramen zitten."
                                            },
                                            {
                                                "example_id": "fae3e861-d718-48df-a22d-5977403e4b79",
                                                "sense_id": "ad5d61e4-3dce-396b-9555-2a3b3d98c1a9",
                                                "text": "Het had ooit als primitieve bus dienstgedaan om de boeren uit de omgeving naar de markt in Dordrecht te vervoeren: een houten huisje dat achter op een vrachtwagen kon worden gezet met binnenin langs beide zijden lange houten banken en aan drie kanten ramen."
                                            },
                                            {
                                                "example_id": "b54f0dae-3464-4573-8e49-a3593d94ddf7",
                                                "sense_id": "ad5d61e4-3dce-396b-9555-2a3b3d98c1a9",
                                                "text": "De groentetuin grenst aan de bleek, het grasveld dat aan twee zijden wordt omzoomd door het water van de sloten."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "794f41eb-0204-34f6-874f-557895db865d",
                                        "entry_id": "c8c03fcd-653b-3290-a54e-173b78c9e78a",
                                        "glosses": [
                                            "meervoud van het zelfstandig naamwoord zij"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "plural"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
