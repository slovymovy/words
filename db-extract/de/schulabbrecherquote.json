                "senses": [
                    {
                        "sense_id": "9c6d83b3-387b-35eb-8fee-1fe81d0e5736",
                        "entry_id": "90ed2008-efb9-3b6d-9fe9-222d8f14b445",
                        "glosses": [
                            "Anteil derjenigen, die ihre Schullaufbahn vorzeitig ohne Abschluss beenden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e9b994c-9443-415c-8949-ed905dc6ce25",
                                "sense_id": "9c6d83b3-387b-35eb-8fee-1fe81d0e5736",
                                "text": "„Während die Schulabbrecherquote bei männlichen Jugendlichen ohne Migrationshintergrund bei sechs Prozent lag, war sie bei bei männlichen Jugendlichen mit Migrationshintergrund bei 22,4 Prozent.“"
                            },
                            {
                                "example_id": "f8f1dca2-ca92-41ce-9aea-eb7a25d5392f",
                                "sense_id": "9c6d83b3-387b-35eb-8fee-1fe81d0e5736",
                                "text": "„Beispielsweise zeigt sich das in der höheren Schulabbrecherquote von Jungen auf Sekundarstufe II.“"
                            },
                            {
                                "example_id": "c2e33d27-324e-4d66-86e6-04841927e771",
                                "sense_id": "9c6d83b3-387b-35eb-8fee-1fe81d0e5736",
                                "text": "„2008 lag die Schulabbrecherquote bei sieben Prozent, wie eine Auswertung von Daten der statistischen Landesämter durch die Nachrichtenagentur dpa ergab.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
