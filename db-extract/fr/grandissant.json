                "senses": [
                    {
                        "sense_id": "43db49dd-ca2d-3183-9a27-17deb0fdc87e",
                        "entry_id": "c2789466-ac25-33d1-b6d0-00f62eed29f6",
                        "glosses": [
                            "Qui grandit, qui croît peu à peu."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "139bdc5f-d3c5-4d35-a6ca-b574d3e3bd63",
                                "sense_id": "43db49dd-ca2d-3183-9a27-17deb0fdc87e",
                                "text": "Malgré ces avancées, Claire Hédon, la Défenseure des droits, dénonce « le nombre grandissant d’enfants dont les besoins sont très largement non ou mal couverts »."
                            },
                            {
                                "example_id": "ee2007cb-bf7f-464a-8bf2-ab81208e533a",
                                "sense_id": "43db49dd-ca2d-3183-9a27-17deb0fdc87e",
                                "text": "Le garde-chiourme parlait à une voisine. Son képi à visière carrée, son ceinturon, son dolman noir et son pantalon bleu, à passepoil jonquille, provoquaient dans la rue une grandissante curiosité."
                            },
                            {
                                "example_id": "4fbf963f-be0c-4d41-919d-856b0d8dcf41",
                                "sense_id": "43db49dd-ca2d-3183-9a27-17deb0fdc87e",
                                "text": "Sur les réseaux sociaux, la « vanlife » (vie en van), regroupe une communauté grandissante, partageant expériences et bons plans."
                            },
                            {
                                "example_id": "3aaf05d2-7930-47b4-b089-a287691d3acd",
                                "sense_id": "43db49dd-ca2d-3183-9a27-17deb0fdc87e",
                                "text": "Des hommes poussaient, une armée noire, vengeresse, qui germait lentement dans les sillons, grandissant pour les récoltes du siècle futur, et dont la germination allait faire bientôt éclater la terre."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "56f76f5b-a690-4876-8970-f5304e813680",
                        "source_entry_id": "c2789466-ac25-33d1-b6d0-00f62eed29f6",
                        "source_sense_id": "43db49dd-ca2d-3183-9a27-17deb0fdc87e",
