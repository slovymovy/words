                                                "example_id": "0a50fe7b-e9d4-47d1-bfee-9d85b6e6ac28",
                                                "sense_id": "ec7f3c56-ddb7-30c0-81ca-50b7df93b3d5",
                                                "text": "„Wenn wir gutes Wetter haben, möchte ich im Garten eine Kaffeetafel decken.“"
                                            },
                                            {
                                                "example_id": "7079f945-b63a-474e-9be4-561b85cbc5a2",
                                                "sense_id": "ec7f3c56-ddb7-30c0-81ca-50b7df93b3d5",
                                                "text": "„Gestalten Sie deshalb eine Kaffeetafel mit weißer, möglichst gestärkter Tischdecke.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
