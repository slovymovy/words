                                        "entry_id": "77e95c11-686a-3ebf-943d-92fc4fb49e37",
                                        "glosses": [
                                            "mechanizm umożliwiający zmianę przełożenia mocy wytwarzanej przez silnik napędzający pojazd lub inną maszynę"
                                        ],
                                        "tags": [],
