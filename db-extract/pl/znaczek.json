                                            {
                                                "example_id": "71d651de-b0f9-421c-8048-7b6906abb489",
                                                "sense_id": "29ff3457-b7fe-3ad5-a3b5-cb49c3c33555",
                                                "text": "Немецкая марка."
                                            },
                                            {
                                                "example_id": "937dcf65-5a85-4ed6-8f4d-84b89e2da4d4",
                                                "sense_id": "29ff3457-b7fe-3ad5-a3b5-cb49c3c33555",
                                                "text": "Финская марка."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ad45402c-02b1-3736-9adf-3f08dceec7ab",
                                        "entry_id": "922d6193-499d-3955-8b3e-66fb3d9eac31",
                                        "glosses": [
                                            "истор. единица веса серебра или золота в средневековой Западной Европе"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e4e97eda-b093-41b2-8906-616ca5b0dae8",
                                                "sense_id": "ad45402c-02b1-3736-9adf-3f08dceec7ab",
                                                "text": "Марка содержит 8 унций, или как еще ее делят, 16 полуунций."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "марка",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "9a8792d9-3e53-3ada-89bb-a18fd3c8af24",
                                        "entry_id": "77906e90-f869-305d-b2e1-879708629146",
                                        "glosses": [
                                            "истор. административно-территориальная единица в ряде феодальных государств, во главе которой стоял маркграф"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f5e6ee0-9b5b-4a1b-8d8f-41392a0d95bf",
                                                "sense_id": "9a8792d9-3e53-3ada-89bb-a18fd3c8af24",
                                                "text": "Герой «Песни о Роланде» — маркграф Бретонской марки."
                                            },
                                            {
                                                "example_id": "3476f3d9-8e01-47b1-a14e-fd517690c2f8",
                                                "sense_id": "9a8792d9-3e53-3ada-89bb-a18fd3c8af24",
                                                "text": "Здесь немецкая колонизация снова завоевала Бранденбургские марки и Силезию, потом немецкий меч покорил Прусские земли"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
