                        "glosses": [
                            "Que l’on ne peut pas surveiller."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b15d941d-5bae-4d49-ba62-1da7db539c6b",
                                "sense_id": "470d8c31-018c-3635-bd52-bbfb43956ae4",
                                "text": "- Oh ! j’admire ma nièce plus que vous, mais cette nièce admirable est indomptable, insurveillable, indisciplinable ; attribuez-lui toutes les terminaisons « able », vous n’exprimerez pas encore cette nature de rébellion que j’ai élevée à désobéir."
                            },
                            {
                                "example_id": "aad3eeab-1403-456f-8262-4148f2a068f4",
                                "sense_id": "470d8c31-018c-3635-bd52-bbfb43956ae4",
                                "text": "L’ennemi était chez lui, maître de la position, insurveillable."
                            },
                            {
                                "example_id": "294f8a27-6319-4f17-9ca2-c1390429dcb6",
                                "sense_id": "470d8c31-018c-3635-bd52-bbfb43956ae4",
                                "text": "Le cabaret devient un lieu surveillé et pourtant insurveillable. C’est là que les mendiantes, les filles ou les voleurs revendent leurs marchandises, que les artisans jouent quelques écus, discutent et finissent, le vin aidant, par s’entre-tuer."
                            }
                        ]
                    }
