                    {
                        "sense_id": "8ae41459-dc55-309c-8820-24ccb9efd3b0",
                        "entry_id": "c14cf374-92aa-392a-87cd-2f7471f95eb3",
                        "glosses": [
                            "Féminin singulier de breton."
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "40ab752f-4481-4b37-bf7c-4726fe4756db",
                                "sense_id": "8ae41459-dc55-309c-8820-24ccb9efd3b0",
                                "text": "L’Angleterre, bretonne sous Uther Pendragon, romaine sous César, saxonne sous l’heptarchie, danoise sous Harold, normande après Guillaume, devient, grâce aux lords, anglaise."
                            },
                            {
                                "example_id": "845908df-1079-4502-9424-de4416fafbbb",
                                "sense_id": "8ae41459-dc55-309c-8820-24ccb9efd3b0",
                                "text": "Maintenant elle a une correspondante bretonne, à qui elle rendra visite après ses examens."
                            }
                        ]
                    }
                ],
