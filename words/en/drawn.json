            "senses": [
                {
                    "sense_id": "6b2385cf-b3f5-3941-8220-d1214b44ffc2",
                    "sense_definition": "Appearing tired, stressed, or unwell, often with the skin of the face looking tight.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She looked pale and <drawn> after working for three days without sleep.",
                            "target_lang_translations": {
                                "ru": "Она выглядела бледной и <изможденной> после трех дней работы без сна.",
                                "pl": "Wyglądała blado i na <wymizerowaną> po trzech dniach pracy bez snu.",
                                "es": "Ella se veía pálida y <demacrada> después de trabajar tres días sin dormir."
                            }
                        },
                        {
                            "text": "His face was <drawn> and grey when he heard the bad news.",
                            "target_lang_translations": {
                                "ru": "Его лицо было <осунувшимся> и серым, когда он услышал плохие новости.",
                                "pl": "Jego twarz była <ściągnięta> i szara, gdy usłyszał złe wieści.",
                                "es": "Su rostro estaba <demacrado> y gris cuando escuchó las malas noticias."
                            }
                        }
                    ],
                    "antonyms": [
                        "fresh",
                        "healthy"
                    ],
                    "common_phrases": [
                        "look drawn",
                        "drawn face"
                    ],
                    "target_lang_definitions": {
