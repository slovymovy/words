    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "551623f9-81f3-3ea1-aa3e-41b79c351917",
                    "sense_definition": "Couvrir une personne ou une chose d'un voile ou d'une étoffe pour la dissimuler.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "couvrir",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La mariée a choisi de <w>voiler</w> son visage avant d'entrer dans l'église."
                        },
                        {
                            "text": "Pour protéger le meuble de la poussière, elle a <w>voilé</w> le miroir d'un grand tissu blanc."
                        }
                    ],
                    "synonyms": [
                        "envelopper",
                        "masquer"
                    ],
                    "antonyms": [
                        "découvrir",
                        "dévoiler"
                    ],
                    "common_phrases": [
                        "voiler son visage"
                    ]
                },
                {
                    "sense_id": "0584511b-14fa-32de-9e21-7a302680c0f1",
                    "sense_definition": "Masquer ou obscurcir partiellement la vue ou la clarté de quelque chose.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "obscurcir",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De légers nuages <w>voilent</w> le soleil sans empêcher la lumière de passer."
                        },
                        {
                            "text": "Une brume matinale <w>voilait</w> complètement le sommet de la colline."
                        }
                    ],
                    "synonyms": [
                        "assombrir",
                        "embrumer",
                        "obscurcir"
                    ],
                    "antonyms": [
                        "dégager",
                        "éclairer"
                    ],
                    "common_phrases": [
                        "voiler le soleil"
                    ]
                },
                {
                    "sense_id": "59f88408-1b91-322c-8d0e-5e00a5e5efdf",
                    "sense_definition": "Dissimuler ou déguiser des sentiments, des intentions ou une vérité.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "dissimuler",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il tente de <w>voiler</w> la vérité en racontant des histoires confuses à ses amis."
                        },
                        {
                            "text": "Elle esquisse un sourire poli pour <w>voiler</w> sa tristesse et son inquiétude."
                        }
                    ],
                    "synonyms": [
                        "cacher",
                        "dissimuler",
                        "masquer"
                    ],
                    "antonyms": [
                        "dévoiler",
                        "révéler"
                    ],
                    "common_phrases": [
                        "voiler la vérité"
                    ]
                },
                {
                    "sense_id": "1abf530a-3932-3a70-ace9-d041e9c671c0",
                    "sense_definition": "Devenir trouble, brumeux ou perdre de sa netteté.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "obscurcir",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ses yeux ont commencé à se <w>voiler</w> sous le coup d'une vive émotion."
                        },
                        {
                            "text": "Au fil des heures, le ciel limpide s'est <w>voilé</w> avant l'arrivée de la pluie."
                        }
                    ],
                    "synonyms": [
                        "s'embrumer",
                        "se troubler"
                    ],
                    "antonyms": [
                        "s'éclaircir"
                    ],
                    "common_phrases": [
                        "se voiler de larmes"
                    ]
                },
                {
                    "sense_id": "4b49c2ea-6884-3b35-b081-d8895f7f3c94",
                    "sense_definition": "Déformer ou courber anormalement une pièce mécanique ou une surface plane.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "deformer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En heurtant violemment le trottoir, le cycliste a réussi à <w>voiler</w> sa roue avant."
                        },
                        {
                            "text": "L'humidité excessive risque de <w>voiler</w> les planches de bois entreposées dehors."
                        }
                    ],
                    "synonyms": [
                        "déformer",
                        "gauchir"
                    ],
                    "antonyms": [
                        "redresser"
                    ],
                    "common_phrases": [
                        "voiler une roue"
                    ]
                }
            ]
        }
    ]
}