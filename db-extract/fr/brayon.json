                        "glosses": [
                            "Habitant du pays de Bray."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5dd3d2c1-cde8-4319-91dc-4daf55cdbe42",
                                "sense_id": "3359024a-8080-37de-9380-b66a9c88ffac",
                                "text": "Je ne conteste pas qu’aux époques passées le Bray ait pu mériter de sévère reproches et d’ailleurs les infortunés Brayons sont un peu considérés par le « Nordiques », comme des Normands de seconde zone, de tristes « Gallo-Romains », sorte d’hybrides de sang picard."
                            }
                        ]
                    },
                    {
                        "sense_id": "0724b0b7-1530-3330-b45c-2aa47f736f44",
                        "entry_id": "58fd10ad-3f69-3f12-b039-5c0fab00725f",
                        "glosses": [
                            "Habitant de la région de Madawaska à cheval entre la Gaspésie (Québec) et le Nouveau-Brunswick."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "57a2516a-b111-40f6-992a-03c65a101512",
                                "sense_id": "0724b0b7-1530-3330-b45c-2aa47f736f44",
                                "text": "En roulant de Saint-Quentin, au Nouveau-Brunswick, à Restigouche, au Québec, sur cette route déserte bordée d'épinettes, avons-nous une bonne pensée pour les Acadiens des bois, les Brayons, et pour leurs grands amis de jadis, les Migmags …?"
                            }
                        ]
                    }
