{
    "word_family": [
        "dompelen",
        "onderdompeling",
        "dompelaar"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "edd6892b-7c60-3da7-91f0-557aaab64daa",
                    "sense_definition": "Iets of iemand volledig onder het oppervlak van een vloeistof brengen.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "fysiek_onderdompelen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je moet de groenten eerst kort in kokend water <w>onderdompelen</w>.",
                            "target_lang_translations": {
                                "en": "You must first briefly <w>submerge</w> the vegetables in boiling water."
                            }
                        },
                        {
                            "text": "De priester besloot het kind volledig in het doopvont te <w>onderdompelen</w>.",
                            "target_lang_translations": {
                                "en": "The priest decided to completely <w>immerse</w> the child in the baptismal font."
                            }
                        }
                    ],
                    "synonyms": [
                        "dompelen",
                        "indompelen",
                        "onderwateren"
                    ],
                    "antonyms": [
                        "bovenhalen",
                        "opduiken"
                    ],
                    "common_phrases": [
                        "in water onderdompelen",
                        "volledig onderdompelen"
                    ],
                    "target_lang_definitions": {
                        "en": "To bring something or someone completely under the surface of a liquid."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "immerse",
                                "target_lang_sense_clarification": "to place completely in a liquid"
                            },
                            {
                                "target_lang_word": "submerge",
                                "target_lang_sense_clarification": "to put under water"
                            },
                            {
                                "target_lang_word": "dip",
                                "target_lang_sense_clarification": "to plunge briefly into a liquid"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5b912ae8-3455-3530-94c8-65e0add72f3e",
                    "sense_definition": "Zichzelf of iemand anders intensief en volledig overgeven aan een bepaalde sfeer, cultuur of activiteit.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "figuurlijk_onderdompelen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tijdens haar vakantie wilde ze zich helemaal in de lokale cultuur <w>onderdompelen</w>.",
                            "target_lang_translations": {
                                "en": "During her holiday, she wanted to completely <w>immerse</w> herself in the local culture."
                            }
                        },
                        {
                            "text": "Hij besloot zich een weekend lang in de wereld van de klassieke muziek te <w>onderdompelen</w>.",
                            "target_lang_translations": {
                                "en": "He decided to <w>immerse</w> himself in the world of classical music for a weekend."
                            }
                        }
                    ],
                    "synonyms": [
                        "verdiepen",
                        "inleven",
                        "absorberen"
                    ],
                    "common_phrases": [
                        "zich onderdompelen in"
                    ],
                    "target_lang_definitions": {
                        "en": "To intensively and completely surrender oneself or someone else to a certain atmosphere, culture, or activity."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "immerse",
                                "target_lang_sense_clarification": "to involve deeply in an activity or culture"
                            },
                            {
                                "target_lang_word": "submerge",
                                "target_lang_sense_clarification": "to lose oneself in something"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}