                "senses": [
                    {
                        "sense_id": "608d214a-25f3-39bc-a53e-a5f9bb2745b2",
                        "entry_id": "41b5d42a-d6e9-360d-9aa7-1ef0866871ad",
                        "glosses": [
                            "Variante de olla."
                        ],
                        "tags": [
                            "alt-of"
                        ],
                        "examples": [
                            {
                                "example_id": "961655fa-52f2-47e1-9158-d0c557333c1b",
                                "sense_id": "608d214a-25f3-39bc-a53e-a5f9bb2745b2",
                                "text": "Il vous suffit de le remplir d’eau et de le recouvrir avec la soucoupe à l’envers en guise de couvercle et de recouvrir le tout de paille si vous en avez à disposition afin de conserver l’humidité de l’oya au maximum !"
                            },
                            {
                                "example_id": "882a0933-b398-466c-9863-8645cc76f420",
                                "sense_id": "608d214a-25f3-39bc-a53e-a5f9bb2745b2",
                                "text": "Les oyas ne sont donc pas des nouvelles-venues au jardin, loin s’en faut."
                            },
                            {
                                "example_id": "70ac7bcb-2b02-4a21-afa1-542fcac9c560",
                                "sense_id": "608d214a-25f3-39bc-a53e-a5f9bb2745b2",
                                "text": "Le problème , c’est que si l’on veut se doter d’un oya par pot , cela peut revenir extrêmement cher."
                            }
                        ]
                    }
