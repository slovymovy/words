                    {
                        "sense_id": "75344db7-5615-309f-b4f9-3786d83a6e52",
                        "entry_id": "d870b928-85a4-352b-9e17-9e025281048c",
                        "glosses": [
                            "Nom vernaculaire de nombreuses espèces de petits poissons d’eau douce, élevés en aquariophilie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "05d05c6a-9c05-4a91-96c3-c7345207485d",
                                "sense_id": "75344db7-5615-309f-b4f9-3786d83a6e52",
                                "text": "Ce tétra, très populaire depuis son importation en 1910, provient lui aussi du bassin de l’Amazone."
                            },
                            {
                                "example_id": "47eab59e-7bd0-4dfd-be3b-2cac799af10f",
                                "sense_id": "75344db7-5615-309f-b4f9-3786d83a6e52",
                                "text": "Ce petit tétra de 4 cm fréquente les ruisseaux lents du cours inférieur de l’Amazone et de Guyane."
                            },
                            {
                                "example_id": "3054f400-53dc-485a-8c00-5f7874047e6e",
                                "sense_id": "75344db7-5615-309f-b4f9-3786d83a6e52",
                                "text": "Le garçon essaie de sortir de l’aquarium un tétra - ces poissons à la con rouge et bleu que la terre entière a dans son aquarium …."
                            }
                        ]
                    }
                ],
                "translations": [
