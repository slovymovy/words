                        "examples": [
                            {
                                "example_id": "7343d624-35d2-4bd7-83a3-b11f52c0d074",
                                "sense_id": "a8f1cb6c-d2df-3d4f-afcf-27c40e1051df",
                                "text": "Volgens de legende verscheen er een wonderteken aan de hemel, wat als een voorteken werd beschouwd.",
                                "translation": "According to the legend, a miraculous sign appeared in the sky, which was considered as an omen.",
                                "english": "According to the legend, a miraculous sign appeared in the sky, which was considered as an omen."
                            },
                            {
                                "example_id": "ff2d9e51-58c1-45db-a69f-0bb813024250",
                                "sense_id": "a8f1cb6c-d2df-3d4f-afcf-27c40e1051df",
                                "text": "Het verhaal vertelt over een heilige die vele wondertekenen verrichtte.",
                                "translation": "The story tells about a saint who performed many miraculous signs.",
                                "english": "The story tells about a saint who performed many miraculous signs."
                            },
                            {
                                "example_id": "d8dd04c0-22df-4f64-81d1-65c3ef0f915b",
                                "sense_id": "a8f1cb6c-d2df-3d4f-afcf-27c40e1051df",
                                "text": "De gelovigen beschouwden de genezing van de zieke als een wonderteken van God.",
                                "translation": "The believers considered the healing of the sick as a miraculous sign from God.",
                                "english": "The believers considered the healing of the sick as a miraculous sign from God."
                            }
                        ]
                    }
