                        "cross_references": [
                            {
                                "target_word": "Leibeigener",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2183418c-4f87-3517-af15-fe57ca0a396d",
                                        "entry_id": "2361f8bc-3182-32c6-b8be-3af3322cddf2",
                                        "glosses": [
                                            "unfreie Person, die in einem feudalistischen System einem Grundherren zu Frondiensten verpflichtet ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df056da1-7fae-43ac-bb4d-00b2c1ba02c8",
                                                "sense_id": "2183418c-4f87-3517-af15-fe57ca0a396d",
                                                "text": "im Bauernkrieg erhoben sich die Leibeigenen gegen ihre Grundherren."
                                            },
                                            {
                                                "example_id": "89984a50-df7f-41b1-be2c-81c0aeaaa6de",
                                                "sense_id": "2183418c-4f87-3517-af15-fe57ca0a396d",
                                                "text": "„Und zumindest auf dem Papier hat es Veränderungen am umstrittenen Kafala-System gegeben, das die Arbeiter quasi zu Leibeigenen der Firmen machte, für die sie schuften.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "18829432-fcd0-4abd-9df1-832829bd4fa1",
                        "source_entry_id": "2527d5bb-f674-3581-b90b-1d811885bca4",
                        "source_sense_id": "b1d90842-1885-34be-a09a-b3e095c382c9",
                        "target_lang_word": "челядь",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "челядь",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "8e06e86c-bb9f-31aa-b8c1-f8ee42a2efb0",
                                        "entry_id": "873c385d-55fb-3a3a-96a3-eb7720fed240",
                                        "glosses": [
                                            "истор. дворовые слуги помещика (в Российском государстве до отмены крепостного права)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2893899c-f345-47e7-aac2-c1c185aeb959",
                                                "sense_id": "8e06e86c-bb9f-31aa-b8c1-f8ee42a2efb0",
                                                "text": "— Прощайте, батюшка Александр Михайлович! Прощайте! — кричала мне в дорогу вся дворовая челядь."
                                            },
                                            {
                                                "example_id": "2d8facec-bf54-43ed-a4db-f594d57ac273",
                                                "sense_id": "8e06e86c-bb9f-31aa-b8c1-f8ee42a2efb0",
                                                "text": "Стол, уставленный множеством блюд, был окружён суетливой и многочисленной челядью, между которою отличался дворецкой строгим взором, толстым брюхом и величавой неподвижностию."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e975b89e-40c5-3566-a70f-ceb6a170e94c",
                                        "entry_id": "873c385d-55fb-3a3a-96a3-eb7720fed240",
                                        "glosses": [
                                            "собир. любые слуги"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7fb107e8-74ca-47bc-bb1b-d666f4d12034",
                                                "sense_id": "e975b89e-40c5-3566-a70f-ceb6a170e94c",
                                                "text": "…на лестнице беготня и толкотня ливрейных лакеев и трактирной челяди…"
                                            }
                                        ]
