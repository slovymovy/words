                        "glosses": [
                            "A person who lacks good sense; one who is foolish and reckless."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "23e2006d-467a-43d4-ad33-e37cbf04bdba",
                                "sense_id": "5c061c3b-b7c0-38ea-ab12-0806ab930ef5",
                                "text": "...rash harebrain treating matters that require age and gravity;"
                            },
                            {
                                "example_id": "6af27aaf-412d-4378-8b54-cfe1fc523eed",
                                "sense_id": "5c061c3b-b7c0-38ea-ab12-0806ab930ef5",
                                "text": "At the moment she was watching something behind my back, undoubtedly that harebrain who was hanging over the street."
                            },
                            {
                                "example_id": "5d947af6-bb6a-4366-b8a3-2e32eb305914",
                                "sense_id": "5c061c3b-b7c0-38ea-ab12-0806ab930ef5",
                                "text": "He smiled uncontrollably while driving; and then, thought that other drivers looking at his face would conclude there goes an unhinged harebrain."
                            }
                        ]
                    }
