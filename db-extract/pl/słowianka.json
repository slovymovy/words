                    {
                        "translation_id": "6253d852-ef4a-491a-89d5-21a4a4b86e35",
                        "source_entry_id": "5d48dd63-12f1-3358-92aa-e8f16a7bcb9b",
                        "source_sense_id": "d0dc7e90-908f-34cf-aa8c-18414e373566",
                        "target_lang_word": "славянка",
