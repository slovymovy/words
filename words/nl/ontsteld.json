                                "target_lang_sense_clarification": "emotionally disturbed or agitated"
                            },
                            {
                                "target_lang_word": "dismayed",
                                "target_lang_sense_clarification": "feeling concern and distress"
                            },
                            {
                                "target_lang_word": "appalled",
                                "target_lang_sense_clarification": "greatly dismayed or horrified"
                            }
                        ]
                    }
                }
            ]
