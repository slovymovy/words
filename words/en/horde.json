                    "sense_definition": "To move or travel together in a large group.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tourists began to <w>horde</w> toward the main entrance as soon as the gates opened.",
                            "target_lang_translations": {
                                "fr": "Les touristes ont commencé à <w>affluer</w> vers l'entrée principale dès l'ouverture des portes.",
                                "zh": "大门一开，游客们便开始<w>成群涌向</w>主入口。"
                            }
                        },
                        {
                            "text": "Birds often <w>horde</w> in the sky before migrating south for the winter.",
                            "target_lang_translations": {
                                "fr": "Les oiseaux se <w>rassemblent</w> souvent dans le ciel avant de migrer vers le sud pour l'hiver.",
                                "zh": "鸟类在南飞过冬前，常常在天空中<w>成群聚集</w>。"
                            }
