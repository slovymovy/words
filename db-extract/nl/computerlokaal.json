                        "glosses": [
                            "ruimte in een (school)gebouw waarin computers staan opgesteld"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "64386aa4-2c2a-4c1f-90d9-d0d7027914ac",
                                "sense_id": "74d645f1-8b2a-3d7d-9904-cd01ae7254a0",
                                "text": "Allen en Bill Gates leerden elkaar kennen op de middelbare school in Seattle, in het computerlokaal. Beiden hadden al vroeg de betekenis van informatietechnologie door: ze voorzagen dat er ooit in elk huis een computer zou staan."
                            },
                            {
                                "example_id": "b76be05f-a16d-4eee-bfc8-c6978422688a",
                                "sense_id": "74d645f1-8b2a-3d7d-9904-cd01ae7254a0",
                                "text": "Een scholier had op straat een granaat gevonden en nam het explosief mee naar school. In het computerlokaal zou hij er onvoorzichtig mee zijn omgegaan, zegt het Dagestaanse ministerie van Binnenlandse Zaken. De jongen is aangehouden."
                            }
                        ]
                    }
