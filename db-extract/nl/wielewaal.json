        "nl-extract.jsonl": [
            {
                "entry_id": "b1da161b-444f-3151-b8f0-3d0599ecd943",
                "word": "wielewaal",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "793d19c0-ffb6-44a8-b564-60c85348604f",
                        "entry_id": "b1da161b-444f-3151-b8f0-3d0599ecd943",
                        "tags": [
                            "plural"
                        ],
                        "form": "wielewalen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b30a5898-ee27-3a7b-83b4-c0cd885f173e",
                        "entry_id": "b1da161b-444f-3151-b8f0-3d0599ecd943",
                        "glosses": [
                            "zwart-gele zangvogel, m.n. de Europese Oriolus oriolus van de familie van Wielewalen en vijgvogels (Oriolidae)"
                        ],
                        "tags": [
                            "zangvogels"
                        ],
                        "examples": [
                            {
                                "example_id": "75beddba-bc37-43fe-9c56-9bdb071fdffc",
                                "sense_id": "b30a5898-ee27-3a7b-83b4-c0cd885f173e",
                                "text": "De politie trof donderdagochtend buiten het bedrijfspand 395 dode vogels aan, voornamelijk tjiftjaffen en wielewalen. Tussen de honderden overleden dieren lagen ook drie vogels die de botsing hadden overleefd. Zij zijn overgebracht naar een opvangcentrum. De zwerm vogels had een reis van bijna duizend kilometer achter de rug."
                            },
                            {
                                "example_id": "d463e1e1-f929-45dd-9174-a8e9f266e1f8",
                                "sense_id": "b30a5898-ee27-3a7b-83b4-c0cd885f173e",
                                "text": "Vanuit het ondoordringbare groene riet piept er iets. Schril, heel schril. Voer voor vogelaars, het moet hier wemelen van de wielewalen. Lichtblauwe libellen scheren in een sierlijke pas de deux over het wateroppervlak, een reiger klapwiekt met trage vleugels over. De lucht oogt vals-blauw, de zon brandt hard. Buienradar belooft dat de bakken regen nog even uitblijven."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0ac64c72-47e2-461d-b376-ebb2b63e7dd5",
                        "source_entry_id": "b1da161b-444f-3151-b8f0-3d0599ecd943",
                        "source_sense_id": "b30a5898-ee27-3a7b-83b4-c0cd885f173e",
                        "source_sense_description": "zwart-gele zangvogel",
                        "target_lang_word": "Pirol",
