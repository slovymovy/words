                    "sense_definition": "Message ou annonce publicitaire ; publicité.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pendant le film, il y a eu une longue coupure pour la <w>pub</w>.",
