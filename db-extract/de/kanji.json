                        "glosses": [
                            "ein zum Schriftsystem [1] gehörendes Zeichen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fabc8f4b-42f1-455f-9436-dc9f314a827c",
                                "sense_id": "16e291ea-c6c2-3f6d-93c9-ef3eaa405d63",
                                "text": "父, 水 und 家 sind Kanji."
                            }
                        ],
                        "sense_index_json": "\"2\""
