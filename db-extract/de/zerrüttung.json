                "senses": [
                    {
                        "sense_id": "d7386916-5726-3b85-98bd-f7bab49fa6e7",
                        "entry_id": "c8c3875d-041c-38bd-bd4e-615db8d805f0",
                        "glosses": [
                            "Aktion, etwas erheblich/massiv zu beeinträchtigen, und Ergebnis dieser Aktion"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b34951b-1b18-4e3d-8c3e-b514564dd66c",
                                "sense_id": "d7386916-5726-3b85-98bd-f7bab49fa6e7",
                                "text": "„So suchte die Gräfin denn von sich aus nach Mitteln, dieser Zerrüttung Einhalt zu tun.“"
                            },
                            {
                                "example_id": "f60ec7d1-aebf-4b85-a663-12d95a5f5a62",
                                "sense_id": "d7386916-5726-3b85-98bd-f7bab49fa6e7",
                                "text": "„Sie fürchtete die Zerrüttung des Vermögens.“"
                            },
                            {
                                "example_id": "0414d396-f295-4ca8-ae7f-cddf7bf7d444",
                                "sense_id": "d7386916-5726-3b85-98bd-f7bab49fa6e7",
                                "text": "„Obwohl dies die Zerrüttung der Sozialstrukturen zur Folge hatte, blieb bei der städtischen Bevölkerung eine starke Bindung an die ländlichen Regionen erhalten, zumal die Weißen sich weigerten, die Afrikaner als permanente Stadtbevölkerung anzuerkennen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
