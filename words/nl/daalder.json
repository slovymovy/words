                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Verwijst naar een historische munt en munteenheid die niet meer in omloop is."
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Ancienne pièce de monnaie ou unité de compte néerlandaise valant un florin et demi (1,50 florin)."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "daldre",
