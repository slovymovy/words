                                        "entry_id": "68ddd3b4-c173-32a2-b006-20a74323f3a2",
                                        "glosses": [
                                            "A divine calling to establish one's lifestyle."
                                        ],
                                        "tags": [
                                            "Ecclesiastical",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "23a99b8e-085e-45f9-8cd5-e2f7a796931e",
                                                "sense_id": "45ad47b5-00ee-32b0-85c6-e331483149de",
                                                "text": "The Catholic Church supports and teaches us that there are three vocations: the single life, married life, and the religious life or priesthood."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c02f7f0f-6443-3880-818d-2994701e6c5e",
                                        "entry_id": "68ddd3b4-c173-32a2-b006-20a74323f3a2",
                                        "glosses": [
                                            "An occupation for which a person is suited, trained or qualified."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b3182aa9-2f09-457a-b8c9-aa347b69410f",
                                                "sense_id": "c02f7f0f-6443-3880-818d-2994701e6c5e",
                                                "text": "Nursing is a vocation that many people find horrendous."
