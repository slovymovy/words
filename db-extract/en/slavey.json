                        "entry_id": "f1ce6b7d-cd3d-389e-a344-1f53612f507e",
                        "glosses": [
                            "A male servant."
                        ],
                        "tags": [
                            "colloquial",
                            "historical"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "ea88dff6-9b3d-3852-b9d7-3ad67f24fd39",
                        "entry_id": "f1ce6b7d-cd3d-389e-a344-1f53612f507e",
                        "glosses": [
                            "A female domestic servant; a maid or maidservant."
                        ],
                        "tags": [
                            "colloquial",
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "16ab6ed5-be5d-4afd-af80-df2c3ab4b9d8",
                                "sense_id": "ea88dff6-9b3d-3852-b9d7-3ad67f24fd39",
                                "text": "I told a man on the links yesterday that I'd been a slavey for nine months. I was trying to explain why I was a suffragette […]"
                            },
                            {
                                "example_id": "acd092e1-3947-4525-ad30-6320eee0c14a",
                                "sense_id": "ea88dff6-9b3d-3852-b9d7-3ad67f24fd39",
                                "text": "\"Doing? Not a Dam' thing. I mean, I was sitting on the bed lighting a cigarette. We'd just come upstairs. Everything was all right; old Peabody in Sydney and the slavey given a night off to go to the pictures.\""
                            },
                            {
                                "example_id": "dfc86fdb-3624-4e6c-8a98-42816665f214",
                                "sense_id": "ea88dff6-9b3d-3852-b9d7-3ad67f24fd39",
                                "text": "\"The short-haired slavey who had opened the door now put in an appearance as waiter.\""
                            }
                        ]
                    }
                ],
