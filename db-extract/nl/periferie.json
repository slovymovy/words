                                "example_id": "4de66594-ccc0-4b59-8763-f7bb1273fc43",
                                "sense_id": "40e686a7-3515-30e7-b9ad-fe54678785ed",
                                "text": "In de periferie van de wereld heerst er grote armoede."
                            },
                            {
                                "example_id": "6dd82413-8528-4a16-a75d-62a43de978fc",
                                "sense_id": "40e686a7-3515-30e7-b9ad-fe54678785ed",
                                "text": "Impulsiviteit, wreedheid en bruut machtsvertoon zijn het nieuwe normaal. Waar voorheen autocratische regimes in de periferie van de wereldpolitiek lippendienst bewezen aan de geloofsartikelen van de liberale democratie, die door het Westen werd uitgedragen, daar zijn de rollen nu omgedraaid."
                            }
                        ]
                    }
