                "senses": [
                    {
                        "sense_id": "34af5801-c8e3-351b-9bda-46a1e650f1c3",
                        "entry_id": "56ad32c3-9df7-3b11-ae7f-26fca1913eed",
                        "glosses": [
                            "een tabaksblad dat aan de buitenkant van een sigaar is gerold"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a22a38e8-6b8a-4203-9009-3af69be8db25",
                                "sense_id": "34af5801-c8e3-351b-9bda-46a1e650f1c3",
                                "text": "Cuba heeft in het recente verleden wat mindere oogstjaren achter de rug, waardoor er een tekort aan vooral dekbladeren voor de grote, dure sigaren is ontstaan en toplijnen als Behike en Siglo VI van Cohiba amper te koop waren."
                            },
                            {
                                "example_id": "ed23308e-11b2-455a-ac86-d76a582d55eb",
                                "sense_id": "34af5801-c8e3-351b-9bda-46a1e650f1c3",
                                "text": "Top mikt met de ‘Oale Groond’ op wat hij noemt het ‘hogere segment’ van sigarenrokers die bereid zijn om voor een kwalitatief uitzonderlijke sigaar meer te betalen. \"Wij gebruiken de originele Sumatratabak als dekblad. De meeste fabrikanten doen dat niet, omdat dat te duur is.\""
                            }
                        ]
                    },
                    {
                        "sense_id": "cd30af04-ef97-3350-8037-6442e18b3020",
                        "entry_id": "56ad32c3-9df7-3b11-ae7f-26fca1913eed",
                        "glosses": [
                            "deel van de knie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9fa77ee6-56d8-4d13-b8d7-b739bde03398",
                                "sense_id": "cd30af04-ef97-3350-8037-6442e18b3020",
                                "text": "Van der Poel ging afgelopen vrijdag naar de een dokter en die besloot onmiddellijk in te grijpen. Hij is aan beide knieën operatief behandeld. In de rechterknie werd een scheurtje in het dekblad verholpen. Aan de linkerkant veroorzaakte wrijving tussen een pees en het kraakbeen een lichte ontsteking."
                            }
                        ]
                    },
                    {
                        "sense_id": "4c134d6c-848d-320f-ac77-93af69943e49",
                        "entry_id": "56ad32c3-9df7-3b11-ae7f-26fca1913eed",
                        "glosses": [
                            "een term in de strukturele geologie, waarmee de tektonische eenheid van de hanging wall bij een overschuiving wordt bedoeld"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3c4f1ab3-85ee-4d35-bd06-e03903d83b74",
                        "source_entry_id": "56ad32c3-9df7-3b11-ae7f-26fca1913eed",
                        "source_sense_id": "34af5801-c8e3-351b-9bda-46a1e650f1c3",
                        "source_sense_description": "buitenste blad van een sigaar",
                        "target_lang_word": "wrapper",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wrapper",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "598c2abd-ec00-30ae-b8a6-37759cb75c7e",
                                        "entry_id": "686aef1e-3c97-3909-8982-a57e56b0d172",
                                        "glosses": [
                                            "Something that is wrapped around something else as a cover or protection: a wrapping."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2455b02b-d7bb-4da9-9602-6d4c60f3e361",
                                                "sense_id": "598c2abd-ec00-30ae-b8a6-37759cb75c7e",
                                                "text": "Messy trains are horrible, but you can sort of understand passengers leaving their sandwich wrappers and paper cups if there is nowhere to dispose of them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1aafbd0c-0803-3193-85f6-10dfa237f271",
                                        "entry_id": "686aef1e-3c97-3909-8982-a57e56b0d172",
                                        "glosses": [
                                            "An outer garment; a loose robe or dressing gown."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c38ab36-308a-4eb4-bbac-13c9070cd6aa",
                                                "sense_id": "1aafbd0c-0803-3193-85f6-10dfa237f271",
                                                "text": "Please to examine, at your leisure, the inner linings of the cuff of his left sleeve, and the several little packages which may be found in the somewhat capacious pockets of his embroidered morning wrapper."
                                            },
                                            {
                                                "example_id": "ad1bf8c5-e59c-4a45-bd35-42cab4187ede",
                                                "sense_id": "1aafbd0c-0803-3193-85f6-10dfa237f271",
                                                "text": "It was eight o'clock to-morrow evening when I buckled up my travelling writing-desk in its leather case, paid my Bill, and got on my warm coats and wrappers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "32574a50-0488-3cc6-964a-231844acf1b3",
                                        "entry_id": "686aef1e-3c97-3909-8982-a57e56b0d172",
                                        "glosses": [
                                            "One who, or that which, wraps."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e552a768-ae46-4f62-a498-a942e5a78a77",
                                                "sense_id": "32574a50-0488-3cc6-964a-231844acf1b3",
                                                "text": "He proved to be a remarkably efficient wrapper of parcels."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b4d67b18-d494-3494-ba45-de207fbb0a89",
                                        "entry_id": "686aef1e-3c97-3909-8982-a57e56b0d172",
                                        "glosses": [
                                            "A construct, such as a class or module, that serves to mediate access to another."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "77bf60ab-10de-40e9-88bf-5110ad92e6de",
                                                "sense_id": "b4d67b18-d494-3494-ba45-de207fbb0a89",
                                                "text": "We need a Perl wrapper for this C++ library."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d6f16575-a126-32cf-8a4d-374c82e7655d",
                                        "entry_id": "686aef1e-3c97-3909-8982-a57e56b0d172",
                                        "glosses": [
                                            "A startup company that sells technology that it largely does not make."
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b9ec90c2-608c-4a4f-868f-8cc3351a3cd1",
