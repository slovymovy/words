                        "examples": [
                            {
                                "example_id": "97f2b24f-4cbf-4a11-ac4e-1c476db54d3a",
                                "sense_id": "89e083f3-2629-3152-9352-f225b7357d1f",
                                "text": "In the picture Miss Elizabeth showed me the croc had little piggy eyes, not huge owly ones."
                            }
                        ]
                    },
                    {
                        "sense_id": "79edb6f2-9754-310a-b637-486b21bba224",
                        "entry_id": "df8b6978-b58c-3afa-b86f-1a5f80915a73",
                        "glosses": [
                            "In a bad mood; cranky."
                        ],
                        "tags": [
                            "Atlantic-Canada"
                        ],
                        "examples": [
                            {
                                "example_id": "25ee22fc-fd8c-48bf-8228-ce493379b542",
                                "sense_id": "79edb6f2-9754-310a-b637-486b21bba224",
                                "text": "I had no right to be owly and disagreeable with Willie."
                            }
                        ]
                    },
                    {
                        "sense_id": "d19e8cd7-e0d1-3ae9-bee3-1378f3aac901",
