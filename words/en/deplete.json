{
    "word_family": [
        "depletion",
        "depletable",
        "depletive"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f9710edb-9e51-3833-8be5-40c93b2ee94f",
                    "sense_definition": "To reduce the amount of something valuable or necessary until there is little or none left.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "exhaustion of resources",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The long drought began to <w>deplete</w> the city's water reserves during the hot summer months.",
                            "target_lang_translations": {
                                "ru": "Длительная засуха начала <w>истощать</w> запасы воды в городе в жаркие летние месяцы."
                            }
                        },
                        {
                            "text": "Years of intensive farming can <w>deplete</w> natural resources and leave the soil poor in nutrients.",
                            "target_lang_translations": {
                                "ru": "Годы интенсивного земледелия могут <w>исчерпать</w> природные ресурсы и сделать почву бедной питательными веществами."
                            }
                        }
                    ],
                    "synonyms": [
                        "exhaust",
                        "drain",
                        "consume",
                        "empty"
                    ],
                    "antonyms": [
                        "replenish"
                    ],
                    "common_phrases": [
                        "deplete natural resources",
                        "deplete the ozone layer",
                        "deplete financial reserves"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сокращать количество чего-либо ценного или необходимого до тех пор, пока почти ничего не останется."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "истощать",
                                "target_lang_sense_clarification": "о запасах, ресурсах или почве"
                            },
                            {
                                "target_lang_word": "исчерпывать",
                                "target_lang_sense_clarification": "полностью использовать имеющиеся ресурсы"
                            },
                            {
                                "target_lang_word": "сокращать",
                                "target_lang_sense_clarification": "уменьшать количество резервов"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bfd9b97f-96d0-378a-b40e-cac2bc86dd80",
                    "sense_definition": "To decrease the quantity of a specific substance within a system, such as a battery or the human body.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "reduction of substance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Running too many apps at once will <w>deplete</w> the battery much faster than usual.",
                            "target_lang_translations": {
                                "ru": "Запуск слишком большого количества приложений одновременно будет <w>разряжать</w> аккумулятор гораздо быстрее, чем обычно."
                            }
                        },
                        {
                            "text": "Certain medications can <w>deplete</w> the body of essential vitamins if taken for a long time.",
                            "target_lang_translations": {
                                "ru": "Определенные лекарства могут <w>лишать</w> организм необходимых витаминов, если принимать их в течение длительного времени."
                            }
                        }
                    ],
                    "synonyms": [
                        "diminish",
                        "sap",
                        "use up"
                    ],
                    "antonyms": [
                        "replenish"
                    ],
                    "common_phrases": [
                        "deplete the battery",
                        "deplete the body of"
                    ],
                    "target_lang_definitions": {
                        "ru": "Уменьшать количество определенного вещества в системе, например, в аккумуляторе или организме человека."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разряжать",
                                "target_lang_sense_clarification": "об аккумуляторе или батарее"
                            },
                            {
                                "target_lang_word": "истощать",
                                "target_lang_sense_clarification": "о запасе витаминов или сил в организме"
                            },
                            {
                                "target_lang_word": "выкачивать",
                                "target_lang_sense_clarification": "забирать энергию или ресурсы из системы"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}