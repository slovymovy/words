                                        "sense_id": "a5c607a1-8a4e-31fa-8470-a74d626962c8",
                                        "entry_id": "47fb735e-c532-3148-84fe-f95b78542d66",
                                        "glosses": [
                                            "gebak gemaakt met bladerdeeg"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d8ff8882-514b-41ec-b364-35a99d18fe7d",
                                                "sense_id": "a5c607a1-8a4e-31fa-8470-a74d626962c8",
                                                "text": "Jan Siebelink, schrijver van het Boekenweekgeschenk, komt eind deze maand signeren bij Waanders In de Broeren. Ook Liesbeth Willemars - bekend van Heel Holland Bakt - komt naar Zwolle. Zij deelt strudel uit aan bezoekers van de 'boekenkerk'."
                                            },
                                            {
                                                "example_id": "ec7d30c5-6f4c-4db5-97a9-ced3d401118d",
                                                "sense_id": "a5c607a1-8a4e-31fa-8470-a74d626962c8",
                                                "text": "Het record moet nog worden erkend, maar bakker Heindl denkt dat dit geen probleem zal zijn: de vorige record–strudel was maar 239 meter lang, die van hem meet wel 366 meter."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
