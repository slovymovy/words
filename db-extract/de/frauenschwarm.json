                ],
                "senses": [
                    {
                        "sense_id": "69462f51-c8ff-384a-baab-081c8e5979b9",
                        "entry_id": "c946e48a-8712-33d4-8451-a15696781930",
                        "glosses": [
                            "Mann (oft ein bekannter Schauspieler oder Musiker), den sehr viele Frauen als attraktiv empfinden und für den manche schwärmen"
                        ],
                        "tags": [
                            "Plural selten"
                        ],
                        "examples": [
                            {
                                "example_id": "fb2855a9-e1b1-42f6-89f4-5678c86ebe1e",
                                "sense_id": "69462f51-c8ff-384a-baab-081c8e5979b9",
                                "text": "„Hugh Grant ist der Frauenschwarm, der perfekte Schwiegersohn, der smarte Mann, den sich jede Frau an ihre Seite wünscht.“"
                            },
                            {
                                "example_id": "30c0b0c8-92d9-4629-8cb5-0e99feb43f71",
                                "sense_id": "69462f51-c8ff-384a-baab-081c8e5979b9",
                                "text": "„Frontman Samu Haber ist eindeutig der Frauenschwarm der Band: Der Sunnyboy erobert mit seinem verschmitzten Blick, gutem Humor und coolem Sound Mädchenherzen aller Altersklassen im Sturm.“"
                            },
                            {
                                "example_id": "66471632-5dd8-4faf-b50e-38c83c05d60e",
                                "sense_id": "69462f51-c8ff-384a-baab-081c8e5979b9",
                                "text": "„Spätestens mit diesem Film avanciert auch Robert Redford zum Superstar und Frauenschwarm.“"
                            },
                            {
                                "example_id": "7247371c-69ec-452e-8828-2a1897716924",
                                "sense_id": "69462f51-c8ff-384a-baab-081c8e5979b9",
                                "text": "„Zum Star – und zum Frauenschwarm – wird Udo Jürgens erst durch den Grand Prix, den heutigen \"Eurovision Song Contest\".“"
                            },
                            {
                                "example_id": "afc7bd7a-6c1e-4297-85e8-9481b4bc6709",
                                "sense_id": "69462f51-c8ff-384a-baab-081c8e5979b9",
                                "text": "„Detlef Bierstedt kann mit seiner Stimme jonglieren. Der Schauspieler und Hörspielsprecher wurde durch seine Synchronisation des amerikanischen Frauenschwarms George Clooney bekannt.“"
                            },
                            {
                                "example_id": "da937f7e-005b-48f6-9afb-3929a6cf6b02",
                                "sense_id": "69462f51-c8ff-384a-baab-081c8e5979b9",
                                "text": "„Als er dann in den 1970ern in einer Teenager-Liebesgeschichte erstmals die männliche Hauptrolle übernahm, wurde er dem indischen Publikum als Frauenschwarm bekannt. In den kommenden 20 Jahren verkörperte er in Dutzenden weiteren Filmen den romantischen Helden.“"
                            },
                            {
                                "example_id": "e735f783-1d62-402c-b584-fbbcd670cbad",
                                "sense_id": "69462f51-c8ff-384a-baab-081c8e5979b9",
                                "text": "„Wer das möchte, der kann auch die vielen Liebschaften des Frauenschwarms Warren Beatty als Erfolgsgeschichte verbuchen.“"
                            },
                            {
                                "example_id": "d0f5a9ef-b4c6-4dc5-91b1-c823a0d5e26b",
                                "sense_id": "69462f51-c8ff-384a-baab-081c8e5979b9",
                                "text": "[Romy Schneider:] „Während der Dreharbeiten zu \"Christine\" (1958) hatte sie den französischen Nachwuchsschauspieler Alain Delon kennengelernt und sich in den Frauenschwarm verliebt.“"
                            },
                            {
                                "example_id": "0b4828f7-e62d-48de-8bef-a1391d81193c",
                                "sense_id": "69462f51-c8ff-384a-baab-081c8e5979b9",
                                "text": "„Es war der Beginn seiner Hollywood-Karriere. Eine seiner Paraderollen als eleganter Frauenschwarm hatte er in dem mit neun Oscars ausgezeichneten Liebesfilm \"Gigi\" von Vincente Minnelli aus dem Jahr 1958.“"
                            },
                            {
                                "example_id": "12ac73d1-1a72-45bc-830e-5d778b6e73f9",
                                "sense_id": "69462f51-c8ff-384a-baab-081c8e5979b9",
                                "text": "[Alvaro Soler, Musiker:] „Der 30-jährige Frauenschwarm ist bis zu seinem zehnten Lebensjahr in Barcelona aufgewachsen“ […]."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
