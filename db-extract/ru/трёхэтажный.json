                        ],
                        "examples": [
                            {
                                "example_id": "be0bd187-b0d2-49ae-9010-67a6cb18999a",
                                "sense_id": "a36f3125-b41d-33ff-88b1-7561e0eea326",
                                "text": "Он выража́ется трёхэта́жным ма́том.",
                                "translation": "He uses \"four-letter words\".",
                                "english": "He uses \"four-letter words\"."
                            },
                            {
                                "example_id": "f1869e91-8ed8-41fe-9cde-f718392be91f",
                                "sense_id": "a36f3125-b41d-33ff-88b1-7561e0eea326",
                                "text": "Наро́дный ю́мор... в карти́нках обраща́лся в остроу́мие са́мого гру́бого первобы́тного сво́йства, зачасту́ю выража́вшееся то́лько в заве́тных трёхэта́жных слове́чках.",
                                "translation": "People's humor ... turned in pictures to a wit of the most crude and primitive property, often expressed only in the treasured \"three-story\" words.",
                                "english": "People's humor ... turned in pictures to a wit of the most crude and primitive property, often expressed only in the treasured \"three-story\" words."
                            }
                        ]
                    }
