{
    "word_family": [
        "uitroep",
        "roepen",
        "roep"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e70c63a0-7d04-3079-9764-d61ebf3d75f7",
                    "sense_definition": "Met luide stem of plotselinge emotie iets zeggen of uiten.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "stemgeluid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "\"Wat een onzin!\", <w>roept</w> hij geërgerd <w>uit</w>.",
                            "target_lang_translations": {
                                "en": "\"What nonsense!\", he <w>exclaims</w> in annoyance."
                            }
                        },
                        {
                            "text": "Toen ze het goede nieuws hoorde, kon ze niet anders dan van vreugde <w>uitroepen</w>.",
                            "target_lang_translations": {
                                "en": "When she heard the good news, she couldn't help but <w>cry out</w> with joy."
                            }
                        }
                    ],
                    "common_phrases": [
                        "van vreugde uitroepen",
                        "verbaasd uitroepen"
                    ],
                    "target_lang_definitions": {
                        "en": "To say or utter something with a loud voice or sudden emotion."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "exclaim",
                                "target_lang_sense_clarification": "to cry out suddenly from strong emotion"
                            },
                            {
                                "target_lang_word": "cry out",
                                "target_lang_sense_clarification": "to shout or call out loudly"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "679944fe-63e8-3433-88b6-c9c93dca3174",
                    "sense_definition": "Iets of iemand officieel en in het openbaar tot iets verklaren.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "verklaren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hendrik VIII <w>riep</w> zichzelf <w>uit</w> tot hoofd van de Engelse kerk.",
                            "target_lang_translations": {
                                "en": "Henry VIII <w>proclaimed</w> himself head of the Church of England."
                            }
                        },
                        {
                            "text": "De republiek werd na de revolutie officieel <w>uitgeroepen</w> door de nieuwe leiders.",
                            "target_lang_translations": {
                                "en": "The republic was officially <w>proclaimed</w> by the new leaders after the revolution."
                            }
                        }
                    ],
                    "synonyms": [
                        "proclameren"
                    ],
                    "common_phrases": [
                        "tot koning uitroepen",
                        "de republiek uitroepen",
                        "tot winnaar uitroepen"
                    ],
                    "target_lang_definitions": {
                        "en": "To officially and publicly declare someone or something to be a certain status."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "proclaim",
                                "target_lang_sense_clarification": "to officially declare or announce"
                            },
                            {
                                "target_lang_word": "declare",
                                "target_lang_sense_clarification": "to state publicly or officially"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "501ce702-a9df-3847-a390-e507827cd2f9",
                    "sense_definition": "Het formeel aankondigen of oproepen van een rechtszaak bij de aanvang van een zitting.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "rechtspraak",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In kort gedingen vindt het <w>uitroepen</w> van de zaak pas plaats bij aanvang van de eerste terechtzitting.",
                            "target_lang_translations": {
                                "en": "In summary proceedings, the <w>calling</w> of the case only takes place at the start of the first hearing."
                            }
                        },
                        {
                            "text": "De advocaat wachtte in de gang tot de bode de zaak formeel zou <w>uitroepen</w>.",
                            "target_lang_translations": {
                                "en": "The lawyer waited in the hallway until the usher would formally <w>call</w> the case."
                            }
                        }
                    ],
                    "common_phrases": [
                        "de zaak uitroepen"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Juridisch jargon"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To formally announce or call out a court case at the start of a hearing."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "call",
                                "target_lang_sense_clarification": "to announce a court case formally"
                            },
                            {
                                "target_lang_word": "call out",
                                "target_lang_sense_clarification": "to summon or announce a case in court"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "41320fb2-3673-3b13-943d-31aa88edf9ca",
                    "sense_definition": "Het meervoud van het zelfstandig naamwoord <w>uitroep</w>.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er klonken luide <w>uitroepen</w> van verbazing toen de goochelaar zijn truc liet zien.",
                            "target_lang_translations": {
                                "en": "There were loud <w>exclamations</w> of surprise when the magician showed his trick."
                            }
                        },
                        {
                            "text": "De schrik zat er goed in, getuige de vele angstige <w>uitroepen</w> in het publiek.",
                            "target_lang_translations": {
                                "en": "The fright was real, as evidenced by the many anxious <w>cries</w> in the audience."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Meervoudsvorm"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The plural form of the noun 'uitroep' (exclamation, outcry)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "exclamations",
                                "target_lang_sense_clarification": "plural of exclamation"
                            },
                            {
                                "target_lang_word": "outcries",
                                "target_lang_sense_clarification": "plural of outcry"
                            },
                            {
                                "target_lang_word": "cries",
                                "target_lang_sense_clarification": "plural of cry"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}