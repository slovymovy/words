                "senses": [
                    {
                        "sense_id": "41ebf581-75f7-32a5-ba31-a9d600bfb8ca",
                        "entry_id": "2121301d-fcda-3104-8cd1-8b6700ed42e8",
                        "glosses": [
                            "Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "65985f23-4dd6-4c36-a929-5a2700d587fc",
                                "sense_id": "41ebf581-75f7-32a5-ba31-a9d600bfb8ca",
                                "text": "Frau Scholem ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "3a10d267-6fd4-414e-9ac4-55b474343c3d",
                                "sense_id": "41ebf581-75f7-32a5-ba31-a9d600bfb8ca",
                                "text": "Herr Scholem wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "34e681f4-10e7-4b50-8d10-bde774cbcf49",
                                "sense_id": "41ebf581-75f7-32a5-ba31-a9d600bfb8ca",
                                "text": "Die Scholems fahren heute nach Rotterdam."
                            },
                            {
                                "example_id": "ed019db0-8239-48d0-9155-c53c5a3ffcf1",
                                "sense_id": "41ebf581-75f7-32a5-ba31-a9d600bfb8ca",
                                "text": "Der Scholem trägt nie die Pullover, die die Scholem ihm strickt."
                            },
                            {
                                "example_id": "aa43f96f-9ebc-42cb-ae1c-fb7a485ac3cd",
                                "sense_id": "41ebf581-75f7-32a5-ba31-a9d600bfb8ca",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Scholem kommt, geht der Herr Scholem.“"
                            },
                            {
                                "example_id": "0b21361d-fbed-4150-a60b-cce4168d4404",
                                "sense_id": "41ebf581-75f7-32a5-ba31-a9d600bfb8ca",
                                "text": "Scholem kommt und geht."
                            },
                            {
                                "example_id": "6b98171a-80e7-497b-876b-b87e321f6bf9",
                                "sense_id": "41ebf581-75f7-32a5-ba31-a9d600bfb8ca",
                                "text": "Scholems kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
