                        "cross_references": []
                    },
                    {
                        "translation_id": "bc761348-6e1b-43a1-b68f-8d806624f8c2",
                        "source_entry_id": "25f4ef23-1e15-3d6e-aab3-2d9b0ae316c2",
                        "source_sense_id": "dfda5eff-722f-3cbf-b987-db3cc25dd4f1",
                        "target_lang_word": "Nazi",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nazi",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "323fded0-fb27-3765-a329-792655fc8fd9",
                                        "entry_id": "f3b5b5d6-4f6b-3e8e-871e-ffbbde54e04e",
                                        "glosses": [
                                            "Anhänger des Nationalsozialismus, Anhänger Adolf Hitlers oder Mitglied der Nazipartei (NSDAP)"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d6d0ec9f-a102-4e8d-bdc3-4393899a0415",
                                                "sense_id": "323fded0-fb27-3765-a329-792655fc8fd9",
                                                "text": "1933 verboten die Nazis die „Weltbühne“, verbrannten Tucholskys Bücher und bürgerten ihn aus."
                                            },
                                            {
                                                "example_id": "735f2c06-086c-4eb8-b9da-8369b6c734e1",
                                                "sense_id": "323fded0-fb27-3765-a329-792655fc8fd9",
                                                "text": "Die Polizei greift scharf durch, es wird ja in der letzten Zeit wieder kolossal durchgegriffen, da haben sie bei den Nazis eine Haussuchung gemacht, das Haus haben sie gefunden, aber sonst haben sie leider nichts gefunden."
                                            },
                                            {
                                                "example_id": "3a9ec5b5-d242-4aa8-9f97-376deb3e2a63",
                                                "sense_id": "323fded0-fb27-3765-a329-792655fc8fd9",
                                                "text": "„Im westlichen Österreich 2000 Nazi hinter Schloß und Riegel.“"
                                            },
                                            {
                                                "example_id": "a19df272-610a-43f2-8654-f1b94daecb75",
                                                "sense_id": "323fded0-fb27-3765-a329-792655fc8fd9",
                                                "text": "„Hunderttausende mußten Deutschland verlassen, als die Nazis 1933 ihre blutige Jagd begannen.“"
                                            },
                                            {
                                                "example_id": "fdd0d706-965d-4e64-89b5-e258bbdd3bfe",
                                                "sense_id": "323fded0-fb27-3765-a329-792655fc8fd9",
                                                "text": "„Jedenfalls wurde ausgeblendet, dass traumatisierte deutsche Kinder genauso zu den Opfern der Nazis gehörten.“"
                                            },
                                            {
                                                "example_id": "65da8646-379f-4164-8d32-66dd5c415469",
                                                "sense_id": "323fded0-fb27-3765-a329-792655fc8fd9",
                                                "text": "[…] „Vor 75 Jahren ermordeten die Nazis Dietrich Bonhoeffer.“"
                                            },
                                            {
                                                "example_id": "88fcc8cf-8718-4edf-83b0-13c8b95f8fb1",
                                                "sense_id": "323fded0-fb27-3765-a329-792655fc8fd9",
                                                "text": "„Die Weimarer Republik gilt als eine krisengeschüttelte, politisch umkämpfte Episode, an deren Ende die Schreckensherrschaft der Nazis steht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a77ecddd-3340-3e74-977e-3f6cd79c8eae",
                                        "entry_id": "f3b5b5d6-4f6b-3e8e-871e-ffbbde54e04e",
                                        "glosses": [
                                            "Schimpfwort, Beleidigung, zum Beispiel mit Betonung auf Ausländerfeindlichkeit, Rechtsextremismus oder extrem autoritärem, undemokratischem Auftreten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c77c6d71-d9cc-4a20-bfb6-0570c64c3c0d",
                                                "sense_id": "a77ecddd-3340-3e74-977e-3f6cd79c8eae",
                                                "text": "„Das Wort Nazi löste sich allmählich von seiner ursprünglichen Bedeutung, heftete sich an alle möglichen, dem Anschein nach parallelen Phänomene, und wenn man nun »Nazi« sagte, meinte man nicht mehr den historischen, sondern einen anderen, einen Nazi der Gegenwart. […] Ehrlich gesagt eignet sich das Wort »Nazi« auch schlicht hervorragend als Schimpfwort - wenn man flucht, will man schließlich Grenzen niederreißen.“"
                                            },
                                            {
                                                "example_id": "815ce19d-2b8d-49ca-b4cb-b5e337b5e37a",
                                                "sense_id": "a77ecddd-3340-3e74-977e-3f6cd79c8eae",
                                                "text": "„Das Wort „Nazi\" kann aber auch als bloßes Schimpfwort gebraucht werden; in diesem Fall wäre es unsinnig, den Wahrheitsgehalt der Aussage zu ermitteln.“"
                                            },
                                            {
                                                "example_id": "6fe017fd-1f50-4adb-9349-db16281e5aec",
                                                "sense_id": "a77ecddd-3340-3e74-977e-3f6cd79c8eae",
                                                "text": "„Du bist ein Nazi! Du bist ein Nazi! Du Nazi! Du missbrauchst die Armut und das Elend der Menschen für deine Zwecke, du verlogener Nazi!“"
                                            },
                                            {
                                                "example_id": "236daa00-8178-4eaa-9e72-1fb70baca9d4",
                                                "sense_id": "a77ecddd-3340-3e74-977e-3f6cd79c8eae",
                                                "text": "„Ich glaube, viele wissen gar nicht, was ein ‚Nazi‘ wirklich ist, sondern benützen den Ausdruck ‚Nazi‘ einfach als Schimpfwort, so wie ‚Depp‘ oder ‚Trottel‘.“"
                                            },
                                            {
                                                "example_id": "312eef68-2511-445d-88fa-ab8f4a8989a5",
                                                "sense_id": "a77ecddd-3340-3e74-977e-3f6cd79c8eae",
                                                "text": "„Fällt die Bezeichnung „Nazi“, schaffen es die „Deutschen“, die Empörung darüber so für sich zu beanspruchen, wie wenn dieser Ausdruck DAS rassistische Schimpfwort im Dritten Reich gewesen wäre.“"
                                            },
                                            {
                                                "example_id": "a097566f-ef36-44ef-aa85-b88eb938c7a6",
                                                "sense_id": "a77ecddd-3340-3e74-977e-3f6cd79c8eae",
                                                "text": "„Zuallererst hat das denunziatorische Schimpfwort »Nazi« seinen Sinn und seine Schärfe vollkommen verloren, nachdem Deutschland von Sinnen gezeigt hat, daß »Nazi« in Wahrheit nie als Bezeichnung eines echten Rechtsradikalen oder Nationalsozialisten gedacht war, sondern vom links-grünen Mainstream immer als eine die gesellschaftliche Ächtung provozierende Waffe benutzt wurde, um den Gegner mundtot zu machen.“"
                                            },
                                            {
                                                "example_id": "ce878032-5047-40a1-973b-3025f8276a0b",
                                                "sense_id": "a77ecddd-3340-3e74-977e-3f6cd79c8eae",
                                                "text": "„Ein Nazi! Es musste ein Nazi sein, wer sonst hatte in Deutschland schon eine Glatze?“"
                                            },
                                            {
                                                "example_id": "a6a5e0ff-151f-4e44-ba80-1f44a3b3db95",
                                                "sense_id": "a77ecddd-3340-3e74-977e-3f6cd79c8eae",
                                                "text": "„Wir sind in einer Stadt aufgewachsen, in der das mit den Nazis schon immer ein großes Thema war.“ [der Musiker Felix Kummer über seine Heimatstadt Chemnitz]"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Nazi",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a1ec42fa-dc55-38a8-a826-c66178c927fe",
                                        "entry_id": "1602e4ce-c83b-3467-8ee4-521dfbfa1a41",
                                        "glosses": [
                                            "männlicher Vorname"
                                        ],
                                        "tags": [
                                            "ab Mitte des 20. Jahrhunderts selten gebräuchlich"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d555de2b-472b-480d-81e6-c76eace2dc32",
                                                "sense_id": "a1ec42fa-dc55-38a8-a826-c66178c927fe",
                                                "text": "„Ja, da war der Hirschenwirtsohn Johann Kehrer, ein glatter, bleicher Schlingel, der mit grausamem Lippenzucken den verzweifelten Blick des Nazi (Ignaz) Imfeld auffing und spöttisch erwiderte.“"
                                            },
                                            {
                                                "example_id": "7239bce5-aa68-4694-b531-f78bd47eb207",
                                                "sense_id": "a1ec42fa-dc55-38a8-a826-c66178c927fe",
                                                "text": "„Nachhero, weil ich dich einfach Sepp nenne, weil dein Vorname Joseph ist, so kannst mir auch die Lieb' und Güt' erweisen, mich Nazi, oder Naz, zu heißen, was bedeutend kürzer ist als Ignatius, mit vier Silben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            },
