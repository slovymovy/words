                "senses": [
                    {
                        "sense_id": "0d16f7d5-82f3-34ea-86f5-609464db00fe",
                        "entry_id": "160be2e7-daf7-3032-8872-5936706c068e",
                        "glosses": [
                            "Person, die Testflüge mit neu entwickelten Fluggeräten durchführt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c25927db-2cc1-4a6c-be93-73d809526215",
                                "sense_id": "0d16f7d5-82f3-34ea-86f5-609464db00fe",
                                "text": "„Viele Testpiloten haben vor ihrem speziellen Training eine Karriere als Militärpilot absolviert.“"
                            },
                            {
                                "example_id": "3bb7a887-296d-4a58-9e00-cd3d00cad687",
                                "sense_id": "0d16f7d5-82f3-34ea-86f5-609464db00fe",
                                "text": "„Von nun an kann er das erlernte Wissen in den Forschungsflugzeugen des Deutschen Zentrums für Luft- und Raumfahrt (DLR) anwenden und darauf freut sich der 31-jährige frisch gebackene Testpilot schon sehr.“"
                            },
                            {
                                "example_id": "7e3a5ece-36a5-4313-817e-0daad854eedf",
                                "sense_id": "0d16f7d5-82f3-34ea-86f5-609464db00fe",
                                "text": "„Erwacht der Testpilot aus der daraus folgenden kurzen Ohnmacht, dann beschreibt er, seinen Körper verlassen zu haben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
