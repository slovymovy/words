                    "frequency": "Low",
                    "semantic_group_id": "structure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The team decided to move away from their <w>monolithic</w> architecture to improve scalability."
                        },
                        {
                            "text": "Maintaining a <w>monolithic</w> codebase becomes difficult as the application grows in complexity."
