                    {
                        "sense_id": "c11dfd05-bb90-3518-a1fc-1157f48e0c74",
                        "entry_id": "4bc0b096-82fb-3d0d-8379-026e69deaf56",
                        "glosses": [
                            "Initialism of average frustrated chump."
                        ],
                        "tags": [
                            "abbreviation",
