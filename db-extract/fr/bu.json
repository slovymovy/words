                "senses": [
                    {
                        "sense_id": "10c4783e-3629-3038-b1f6-33af14df47a0",
                        "entry_id": "c1b81148-e805-3e1a-ae7b-9f525bfcd4df",
                        "glosses": [
                            "Absorbé, en parlant d’un liquide ou de sentiment (les sentiments étaient autrefois considérés comme des humeurs, au sens propre de quelque chose d’humide)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e78ce7c6-8c3a-4167-977f-14c288bf4417",
                                "sense_id": "10c4783e-3629-3038-b1f6-33af14df47a0",
                                "text": "Avoir ses hontes bues, c’est-à-dire ravalées."
                            }
                        ]
                    },
                    {
                        "sense_id": "122461e4-2841-3f3f-b885-00a4b5156bd7",
                        "entry_id": "c1b81148-e805-3e1a-ae7b-9f525bfcd4df",
                        "glosses": [
                            "Ivre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d615fca8-2023-4fdd-bfa0-e1d558972fd7",
                                "sense_id": "122461e4-2841-3f3f-b885-00a4b5156bd7",
                                "text": "Il est bu."
                            },
                            {
                                "example_id": "e416d507-2ab5-4991-8ac4-58f10438076a",
                                "sense_id": "122461e4-2841-3f3f-b885-00a4b5156bd7",
                                "text": "Ceux que l’on rencontrait maintenant étaient trop « bus », pour que l’on pût penser encore à discuter […] On tâchait seulement de les asseoir par terre, sans trop les abîmer : un soulard, c’est sacré !"
                            },
                            {
                                "example_id": "5435ed08-3e1f-4cc5-90cf-d9abbb05770a",
                                "sense_id": "122461e4-2841-3f3f-b885-00a4b5156bd7",
                                "text": "Au retour, je n’avais pas une chance sur dix de rencontrer en route ce facteur un peu bu qui m’a crié, trop content d’éviter le crochet de la Fouve où il ne lampe jamais le moindre godet : « Tiens donc, Isa ! Prends-moi le courrier d’en bas. »"
                            },
                            {
                                "example_id": "4c98cbaa-f3d1-46d1-a5c6-3d1cd0c94425",
                                "sense_id": "122461e4-2841-3f3f-b885-00a4b5156bd7",
                                "text": "On fait taire gentiment Lemarié, un peu bu, qui fredonne des gaudrioles."
                            }
                        ]
                    }
