                "senses": [
                    {
                        "sense_id": "7f9f3740-4131-3aeb-9845-c6e41e946b12",
                        "entry_id": "aa0b4f24-6351-3870-afb9-cd28d5f5e9d3",
                        "glosses": [
                            "Qui ne peut pas communier au vin, par répulsion naturelle."
                        ],
                        "tags": [
                            "Liturgie"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "4156c61f-cf6a-30e6-b086-84160254f4a4",
                        "entry_id": "aa0b4f24-6351-3870-afb9-cd28d5f5e9d3",
                        "glosses": [
                            "Qui ne consomme pas d’alcool, qui est lié à la non-consommation d’alcool."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "c1015071-6db2-4733-82a8-2e6d1873c715",
                                "sense_id": "4156c61f-cf6a-30e6-b086-84160254f4a4",
                                "text": "Il était une fois, il y a moult années, un homme abstème qui ne le savait pas encore."
                            },
                            {
                                "example_id": "866cfc32-477d-47e4-a463-065b215158d0",
                                "sense_id": "4156c61f-cf6a-30e6-b086-84160254f4a4",
                                "text": "Alors, quand il a contemplé dans ce monde-là, belles d’une beauté incomparable, les formes exemplaires et idéales des objets sensibles qu’il avait vus ici-bas, ivre d’une ivresse abstème, il est saisi de transports divins comme les gens qui sont pris de fureur corybantique."
                            },
                            {
                                "example_id": "b1f7d418-f770-4905-beb1-88b62422db8a",
                                "sense_id": "4156c61f-cf6a-30e6-b086-84160254f4a4",
                                "text": "Même quand il se blessait légèrement, quand il s'égratignait, il refusait, en bon abstème, de se désinfecter avec de l'alcool à soixante-dix degrés"
                            }
                        ]
                    }
                ],
