                        "examples": [
                            {
                                "example_id": "ad9a0924-eecf-421e-b13b-f28ea2dcf533",
                                "sense_id": "8633a251-9858-3f3d-8af5-444051301cbc",
                                "text": "„Ein positionelles Qualitätsopfer stellte Karjakin am Ende vor nicht mehr lösbare Probleme.“"
                            },
                            {
                                "example_id": "a5f7d73d-10fa-4837-bb57-c47df0d255aa",
                                "sense_id": "8633a251-9858-3f3d-8af5-444051301cbc",
                                "text": "„Einig ist man sich allenfalls darüber, daß Adorjan das angebotene Qualitätsopfer nicht annehmen darf. Tut er auch nicht. Er holt sich lieber den geopferten Bauern zurück und tauscht die Damen.“"
                            },
                            {
                                "example_id": "17911e0e-1fdb-435f-bbb2-2d0f2080b1d7",
                                "sense_id": "8633a251-9858-3f3d-8af5-444051301cbc",
                                "text": "„Das Qualitätsopfer 1.Txc6+! beraubte den Schwarzen des wichtigen Verteidigungsspringers.“"
                            }
                        ],
