                ],
                "senses": [
                    {
                        "sense_id": "d90a0509-11b2-3db5-a0c7-b6c49f4f9973",
                        "entry_id": "1384ce4c-ded7-3f44-8545-f2dfbbc20f76",
                        "glosses": [
                            "Bouquet de roses."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94f209cc-ce1f-43ca-97e4-de69a24b7743",
                                "sense_id": "d90a0509-11b2-3db5-a0c7-b6c49f4f9973",
                                "text": "Mein Freund hat mir zum Geburtstag einen schönen Rosenstrauß geschenkt.",
                                "translation": "Mon copain m’a offert un joli bouquet de roses pour mon anniversaire."
                            },
                            {
                                "example_id": "25217848-46bd-4ddf-8363-0d9dfe7274dd",
                                "sense_id": "d90a0509-11b2-3db5-a0c7-b6c49f4f9973",
                                "text": "Die Studenten nähern sich ihren Lehrern auf Knien und überreichen jedem von ihnen einen Rosenstrauß.",
                                "translation": "Les étudiants se rapprochent vers leur professeur, s’agenouillent devant lui et lui remettent chacun un bouquet de roses."
                            },
                            {
                                "example_id": "799105ef-98da-487b-8ccd-233f4a80217f",
                                "sense_id": "d90a0509-11b2-3db5-a0c7-b6c49f4f9973",
                                "text": "Mit einem großen Rosenstrauß kam Herr Schulze ins Krankenhaus, wo seine Frau eben von einem Kinde entbunden worden war.",
                                "translation": "Monsieur Schulze se rendit avec un gros bouquet de roses à l’hôpital, où sa femme venait juste d’accoucher d’un enfant."
                            }
                        ]
                    }
                ],
