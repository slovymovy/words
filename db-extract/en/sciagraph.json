                "senses": [
                    {
                        "sense_id": "8db6cd09-d906-349c-8092-5975b1bad071",
                        "entry_id": "a14e20ae-c2eb-3649-a7ff-2490909aa068",
                        "glosses": [
                            "To create a sciagraph (radiograph) of; to look inside by this or a similar technique."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "85fff437-4d39-4867-af52-e900e59d7126",
                                "sense_id": "8db6cd09-d906-349c-8092-5975b1bad071",
                                "text": "The lighting from above also had a specific function: providing an even legibility to those \"shaded\" or sciagraphed areas treated with the technique known as schiacciato as to those of high relief."
                            },
                            {
                                "example_id": "3b58778c-295a-4200-8522-a2205595470a",
                                "sense_id": "8db6cd09-d906-349c-8092-5975b1bad071",
                                "text": "This is a text centrally about a girl who is herself an illusionistic artwork: her white skin is the canvas upon which a wholly misleading cultural portrait is sciagraphed."
                            },
                            {
                                "example_id": "03781cda-d81a-4bc9-9c47-916e9a46556a",
                                "sense_id": "8db6cd09-d906-349c-8092-5975b1bad071",
                                "text": "Compared with the prior arts, the remote exposure control device of an embodiment can remotely control and monitor an FPD, facilitating realizing sciagraphing by one key and improving the work efficiency of users."
                            }
                        ]
                    }
                ],
