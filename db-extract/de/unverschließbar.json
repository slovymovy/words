                                                "sense_id": "62ef8dc6-33cb-3a2d-b885-9ee4f0916e61",
                                                "text": "The facilities at Harvard Law School included lockable and unlockable carrels and lockable rooms. The lockable carrels and rooms were limited in number and were assigned to students by priority based on age."
                                            },
                                            {
                                                "example_id": "8e66b060-b0a4-4250-8153-44c0929562d4",
                                                "sense_id": "62ef8dc6-33cb-3a2d-b885-9ee4f0916e61",
                                                "text": "Casters can be swivel, rigid, lockable, or unlockable."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "unlockable",
                                "target_lang_code": "en",
