                ],
                "senses": [
                    {
                        "sense_id": "90acbe6b-384b-38a9-9edb-bbd5570f1fd0",
                        "entry_id": "ecaba84d-0d7c-3e23-a1d7-a614d40b22f5",
                        "glosses": [
                            "een plan om iets te bereiken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "18b3d77a-5638-4367-b99d-c36304c74735",
                                "sense_id": "90acbe6b-384b-38a9-9edb-bbd5570f1fd0",
                                "text": "De strategie van die handelaar werkt erg goed."
                            },
                            {
                                "example_id": "665c60c1-7145-460c-a1b8-ac0cb74d81d0",
                                "sense_id": "90acbe6b-384b-38a9-9edb-bbd5570f1fd0",
                                "text": "Hij zag het probleem niet zozeer en maakte aanstalten om verder te lopen, waardoor ik overging op een andere strategie."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f5f4ba21-0712-4dcf-97c5-6afc6590c4cc",
                        "source_entry_id": "ecaba84d-0d7c-3e23-a1d7-a614d40b22f5",
                        "source_sense_id": "90acbe6b-384b-38a9-9edb-bbd5570f1fd0",
                        "source_sense_description": "een plan om iets te bereiken",
                        "target_lang_word": "Strategie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Strategie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d0412911-c430-3225-b5f3-8f21710f232e",
                                        "entry_id": "79bab78e-cafd-32bb-bf00-8b6095e42d75",
                                        "glosses": [
                                            "Plan zur Durchführung eines Vorhabens oder Verhinderung von Nachteilen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "716d15a2-32da-472b-952e-ec5de5d23e54",
                                                "sense_id": "d0412911-c430-3225-b5f3-8f21710f232e",
                                                "text": "Leider haben wir für diese Auseinandersetzung noch keine überzeugende Strategie."
                                            },
                                            {
                                                "example_id": "d5de898f-eab7-4903-9115-c270cff9078e",
                                                "sense_id": "d0412911-c430-3225-b5f3-8f21710f232e",
                                                "text": "Eine der Strategien der AfD ist es, mit Aussagen zu provozieren und im nächsten Moment zu erklären, es sei alles nicht so gemeint gewesen. Eine andere ist, ahnungslos zu tun."
                                            },
                                            {
                                                "example_id": "4ac4d8d1-9f46-4b3c-a692-dea701f7c0bc",
                                                "sense_id": "d0412911-c430-3225-b5f3-8f21710f232e",
                                                "text": "„Die Strategie der Kolonialherren geht auf; im Oktober 1956 nehmen die Briten den wichtigsten Anführer der Rebellen fest.“"
                                            },
                                            {
                                                "example_id": "09745f9e-6579-4a89-ad5b-eddcc0d96727",
                                                "sense_id": "d0412911-c430-3225-b5f3-8f21710f232e",
                                                "text": "„Diese Strategie ist erst einmal ganz clever, schätzt der Spieleexperte Stephan Freundorfer. Doch es mache Spieleentwicklern die Entscheidung schwer, auf die Technologie zu setzen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3d0e38f4-5e47-4bf3-838e-ad0c4a062c49",
                        "source_entry_id": "ecaba84d-0d7c-3e23-a1d7-a614d40b22f5",
                        "source_sense_id": "90acbe6b-384b-38a9-9edb-bbd5570f1fd0",
                        "source_sense_description": "een plan om iets te bereiken",
                        "target_lang_word": "strategy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "strategy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8292da5c-72c3-3313-b670-d74a2a29292f",
                                        "entry_id": "d7cb389e-9c87-3a58-99a7-6b15f752c378",
                                        "glosses": [
                                            "The science and art of military command as applied to the overall planning and conduct of warfare."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e0e30cd-8f30-434e-b20d-183ae7d136b6",
                                                "sense_id": "8292da5c-72c3-3313-b670-d74a2a29292f",
                                                "text": "“I came down like a wolf on the fold, didn’t I ? Why didn’t I telephone ? Strategy, my dear boy, strategy. This is a surprise attack, and I’d no wish that the garrison, forewarned, should escape. …”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "461e5025-9934-373d-a986-5dce2a60f198",
                                        "entry_id": "d7cb389e-9c87-3a58-99a7-6b15f752c378",
                                        "glosses": [
                                            "A plan of action intended to accomplish a specific goal."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cf0640c3-28cf-4dd3-9990-8ae23eaa823f",
                                                "sense_id": "461e5025-9934-373d-a986-5dce2a60f198",
                                                "text": "Oftentimes, the very simple strategies pay very great dividends."
                                            },
                                            {
                                                "example_id": "eaba09bb-afc2-47a0-9c55-478d99055abb",
                                                "sense_id": "461e5025-9934-373d-a986-5dce2a60f198",
                                                "text": "Earless ghost swift moths become “invisible” to echolocating bats by forming mating clusters close[…]above vegetation and effectively blending into the clutter of echoes that the bat receives from the leaves and stems around them. Many insects probably use this strategy, which is a close analogy to crypsis in the visible world—camouflage and other methods for blending into one’s visual background."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "805c59a2-8d6c-38e1-836b-2386c61a675d",
                                        "entry_id": "d7cb389e-9c87-3a58-99a7-6b15f752c378",
                                        "glosses": [
                                            "The act of strategizing; the development of effective strategies."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
