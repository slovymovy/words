                "senses": [
                    {
                        "sense_id": "a1b46bda-fbe7-3686-8043-f24b4f38f957",
                        "entry_id": "14329bc1-ba3d-3717-8b40-c6b2040a2dcc",
                        "glosses": [
                            "junge Frau aus dem Schwarzwald, durch Operette und Verfilmungen mit gleichem Titel in den Nachkriegsjahren zum Bild für eine „liebliche Unschuld vom Lande“ geworden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb0e9eed-9421-42e5-b6cd-6a0813272405",
                                "sense_id": "a1b46bda-fbe7-3686-8043-f24b4f38f957",
                                "text": "In Deutschland verdrängte, wie Sichtermann [30] schreibt, das liebliche „Schwarzwaldmädel“ die zupackende „Trümmerfrau“ nur allzu rasch."
                            },
                            {
                                "example_id": "13a295b2-bdd9-42a5-8709-465cf6721086",
                                "sense_id": "a1b46bda-fbe7-3686-8043-f24b4f38f957",
                                "text": "Es war ein Aufstand gegen das spießige Kino der 50er-Jahre, gegen Schwarzwaldmädel- und Sissi- Kitsch."
                            },
                            {
                                "example_id": "a6a2bc62-97ef-488b-839e-aa168407b1c6",
                                "sense_id": "a1b46bda-fbe7-3686-8043-f24b4f38f957",
                                "text": "Das Etikett ziert ein Schwarzwaldmädel und bei dieser Betrachtung werden sofort nostalgische Gefühle geweckt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
