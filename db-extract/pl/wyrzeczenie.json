                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b7603736-7a94-4a9e-81c3-c03e50e6c748",
                        "source_entry_id": "f665c165-4096-3dd4-bc4c-a73ab0027c21",
                        "source_sense_id": "c37ced1c-2763-3be5-93ba-40c6367744ba",
                        "target_lang_word": "abnegation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abnegation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "db957d6d-cecc-389a-b933-324f1b29c1bf",
                                        "entry_id": "af3495d5-eb5a-3e62-b438-92e2a300b27d",
                                        "glosses": [
                                            "A denial; a renunciation; denial of desire or self-interest."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "19308f5a-e2d3-4761-9a5f-78af699e4eb4",
                                                "sense_id": "db957d6d-cecc-389a-b933-324f1b29c1bf",
                                                "text": "With abnegation of God, of his honor, and of religion, they may retain the friendship of the court."
                                            },
                                            {
                                                "example_id": "b9afd4d4-d9d6-49ba-977d-46a492fad771",
                                                "sense_id": "db957d6d-cecc-389a-b933-324f1b29c1bf",
                                                "text": "Tony's face expressed relief, and Nettie sat silent for a moment until the vicar said “It was a generous impulse, but it may have been a momentary one, while in the case of monk and crusader there must have been a sustaining purpose, and possibly a great abnegation, a leaving of lands and possessions.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b763d310-da74-4c69-8bb9-fbbe2ea3cc85",
                        "source_entry_id": "f665c165-4096-3dd4-bc4c-a73ab0027c21",
                        "source_sense_id": "c37ced1c-2763-3be5-93ba-40c6367744ba",
                        "target_lang_word": "renoncement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "renoncement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "659533fb-4466-3a87-8760-1ec5fb0da0e4",
                                        "entry_id": "25a71a17-d61f-3971-b736-bb321c048552",
                                        "glosses": [
                                            "Action de renoncer."
                                        ],
                                        "tags": [],
                                        "note": "Se dit surtout dans les sujets de morale et particulièrement de morale religieuse",
                                        "examples": [
                                            {
                                                "example_id": "ec78164d-dfd6-498b-9d9f-aefde5a49ae5",
                                                "sense_id": "659533fb-4466-3a87-8760-1ec5fb0da0e4",
                                                "text": "« Tout homme porte en lui un ou plusieurs morts », m’avait dit sentencieusement le docteur, qui soupçonnait aussi des renoncements dans la vie du campagnard des Trembles."
                                            },
                                            {
                                                "example_id": "b459616a-a77a-43f7-bead-068e256e4540",
                                                "sense_id": "659533fb-4466-3a87-8760-1ec5fb0da0e4",
                                                "text": "Sous le coup, la vieille servante chancela. Un déchirement, une douleur affreuse blêmit sa pauvre face usée, d’un renoncement de nonne, dans la blancheur de sa coiffe."
                                            },
                                            {
                                                "example_id": "28e94f7c-c142-40cd-b7e9-7c8acbc845ac",
                                                "sense_id": "659533fb-4466-3a87-8760-1ec5fb0da0e4",
                                                "text": "La tristesse indéfinissable, douce comme le renoncement définitif, des soirs d'or et de carmin, préparant au mystère menaçant des nuits obscures et pleines d'inconnu, …"
                                            },
                                            {
                                                "example_id": "0d31ca75-3dcc-4086-aa93-076adebf3e65",
                                                "sense_id": "659533fb-4466-3a87-8760-1ec5fb0da0e4",
                                                "text": "Le renoncement à soi-même, à l’existence, à tout, le renoncement des religieux qui tentent de commencer dès ce monde la vie surnaturelle, si vous saviez comme il me tente."
                                            },
                                            {
                                                "example_id": "1e9b2d7c-546a-4caf-999a-54e1ae8b07d7",
                                                "sense_id": "659533fb-4466-3a87-8760-1ec5fb0da0e4",
                                                "text": "Le renoncement à soi-même n'est pas la destruction de soi-même mais le renoncement à garder la vie pour soi."
                                            },
                                            {
                                                "example_id": "dde89af4-5757-4ff5-adba-29ec7f9c79b3",
                                                "sense_id": "659533fb-4466-3a87-8760-1ec5fb0da0e4",
                                                "text": "Bouddha a encouragé de nombreuses vertus positives comme la bonté, le don, le détachement, le renoncement, l'équanimité, la patience, le pardon, la chasteté, etc."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "621b9511-87ae-4691-a576-699c8471c43a",
                        "source_entry_id": "f665c165-4096-3dd4-bc4c-a73ab0027c21",
                        "source_sense_id": "c37ced1c-2763-3be5-93ba-40c6367744ba",
                        "target_lang_word": "privation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "privation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "63373b21-31cf-3a45-9ea4-8b919c003bd4",
                                        "entry_id": "e796350d-4176-33ac-96d6-39b3aacadff8",
                                        "glosses": [
                                            "Perte, absence, manque d’un bien ou d’un avantage qu’on avait, ou qu’on devait ou qu’on pouvait avoir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c7b086f6-9748-434b-a0ef-523eb0a82f58",
                                                "sense_id": "63373b21-31cf-3a45-9ea4-8b919c003bd4",
                                                "text": "La privation de la vue, de l’ouïe."
                                            },
                                            {
                                                "example_id": "81896c40-7e91-4a93-9e2b-30e51d5b90da",
                                                "sense_id": "63373b21-31cf-3a45-9ea4-8b919c003bd4",
                                                "text": "C’est un homme qui est dans la privation de toutes choses."
                                            },
                                            {
                                                "example_id": "e4ad263f-289c-4538-b4ad-4728f1a3678a",
                                                "sense_id": "63373b21-31cf-3a45-9ea4-8b919c003bd4",
                                                "text": "On châtia cette ville par la privation de ses privilèges."
                                            },
                                            {
                                                "example_id": "ff04b705-79d0-41c1-9164-bc1d7ce056e7",
                                                "sense_id": "63373b21-31cf-3a45-9ea4-8b919c003bd4",
                                                "text": "La privation des droits civils."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d89d3720-12f8-39e4-a7a4-18a8bbe5333b",
                                        "entry_id": "e796350d-4176-33ac-96d6-39b3aacadff8",
                                        "glosses": [
                                            "Manque de beaucoup de choses nécessaires à la vie."
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c7d1dd4a-68cc-4dc8-8c31-bbe5240e177b",
                                                "sense_id": "d89d3720-12f8-39e4-a7a4-18a8bbe5333b",
                                                "text": "Il l'avait saisie avec une sorte de frénésie, doué de l’appétit brutal de l'homme qui a dû accumuler trop de privations."
                                            },
                                            {
                                                "example_id": "6c52e7d3-1360-463a-bfc8-aab79990a42b",
                                                "sense_id": "d89d3720-12f8-39e4-a7a4-18a8bbe5333b",
                                                "text": "Les intempéries et les privations ne sont rien."
                                            },
                                            {
                                                "example_id": "4d306f55-3681-4988-81d9-e3355fd4d224",
                                                "sense_id": "d89d3720-12f8-39e4-a7a4-18a8bbe5333b",
                                                "text": "Ce n'était pas tous les jours que le butin se composait de plusieurs centaines de chrétiennes toutes plus vierges les unes que les autres. De tels moments effaçaient les souvenirs de longs mois de guerre, de privations et de souffrances..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "857dbceb-9a47-3d01-bc39-59e03a0f2143",
                                        "entry_id": "e796350d-4176-33ac-96d6-39b3aacadff8",
                                        "glosses": [
                                            "Action de se priver volontairement, de s’abstenir de quelque chose dont on pourrait jouir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff3d7271-467f-48e4-bfb4-a50cc1a39c36",
                                                "sense_id": "857dbceb-9a47-3d01-bc39-59e03a0f2143",
                                                "text": "S’imposer des privations."
                                            },
                                            {
                                                "example_id": "cd667125-0609-4212-9184-5ea9219c9673",
                                                "sense_id": "857dbceb-9a47-3d01-bc39-59e03a0f2143",
                                                "text": "À force de privations, il a amassé un petit pécule."
                                            },
                                            {
                                                "example_id": "44de1b58-c567-47eb-a39b-352eeb812fb2",
                                                "sense_id": "857dbceb-9a47-3d01-bc39-59e03a0f2143",
                                                "text": "Privation volontaire."
                                            },
                                            {
                                                "example_id": "9ec91cf5-2d5d-4348-b20f-e45a2a682e06",
                                                "sense_id": "857dbceb-9a47-3d01-bc39-59e03a0f2143",
                                                "text": "S’exercer, s’habituer aux privations."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "82fe5c21-43fe-4ce9-9c25-ed1682e3cf91",
                        "source_entry_id": "f665c165-4096-3dd4-bc4c-a73ab0027c21",
