                                        "sense_id": "ee606dc5-714a-3874-9bf2-c63c728d64f2",
                                        "entry_id": "ea7856b8-7b01-33d1-a2de-3ac744ba12f9",
                                        "glosses": [
                                            "to cheat, trick or swindle somebody; to misrepresent something"
                                        ],
