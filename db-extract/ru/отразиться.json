                            "past"
                        ],
                        "form": "отрази́вшийся"
                    },
                    {
                        "form_id": "60082663-1b60-4790-9753-5724bfbd75b3",
                        "entry_id": "74d97ff5-7c3b-3be8-917a-c0b98e537ef8",
                        "tags": [
                            "adverbial",
                            "participle",
                            "past"
                        ],
                        "form": "отрази́вшись"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "aac51417-d466-3ab2-bfbc-3b2f712cbdba",
                        "entry_id": "74d97ff5-7c3b-3be8-917a-c0b98e537ef8",
                        "glosses": [
                            "дать своё изображение на какой-нибудь гладкой, полированной, блестящей поверхности"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e9db879-ec24-4404-9de4-1b77169cdfab",
                                "sense_id": "aac51417-d466-3ab2-bfbc-3b2f712cbdba",
                                "text": "Младая ива… отразилася в кристалле зыбких вод."
                            },
                            {
                                "example_id": "4e7e69b1-a2c0-4c00-b911-ea134136f26c",
                                "sense_id": "aac51417-d466-3ab2-bfbc-3b2f712cbdba",
                                "text": "В широко открытых глазах мертво отразился холодный свет лампы."
                            }
                        ]
                    },
                    {
                        "sense_id": "eaa53925-0621-3fa4-bf29-e39a383e5e8d",
                        "entry_id": "74d97ff5-7c3b-3be8-917a-c0b98e537ef8",
                        "glosses": [
                            "оказать заметное влияние, воздействие на кого-что-нибудь"
                        ],
                        "tags": [
                            "на ком-чём"
                        ],
                        "examples": [
                            {
                                "example_id": "8764b74d-fb43-436e-ab96-54498c0b62b8",
                                "sense_id": "eaa53925-0621-3fa4-bf29-e39a383e5e8d",
                                "text": "Поездка благотворно отразилась на его самочувствии."
                            },
                            {
                                "example_id": "58cd87a6-760d-420c-b152-7f9a83d15978",
                                "sense_id": "eaa53925-0621-3fa4-bf29-e39a383e5e8d",
                                "text": "Вайс понимал, что допустил не только служебную ошибку, которая, возможно, отразится на всей операции, но человечески ошибся, и эта ошибка оставит след в его душе."
                            },
                            {
                                "example_id": "dc4598b6-7fad-4a1d-a71b-51782d813681",
                                "sense_id": "eaa53925-0621-3fa4-bf29-e39a383e5e8d",
                                "text": "Я полагаю, что лекарь где-то поблизости, скорее всего в Веселой Башне, и я надеюсь, что странная неприязнь дона Рэбы к лекарям еще не отразилась роковым образом на судьбе доктора Будаха."
                            }
                        ]
                    },
                    {
                        "sense_id": "2641fa2e-7cd6-3b4d-b5e0-4b15b63f336c",
                        "entry_id": "74d97ff5-7c3b-3be8-917a-c0b98e537ef8",
                        "glosses": [
                            "перен. обнаружиться, показаться, о проявлении чувств, эмоций на лице, в поведении человека"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b32f8877-3af8-4b81-815d-2827c3d00b1b",
                                "sense_id": "2641fa2e-7cd6-3b4d-b5e0-4b15b63f336c",
                                "text": "И на челе его высоком не отразилось ничего."
                            },
                            {
                                "example_id": "53fa172c-68e1-4489-a1ac-6d8c90cb7b6a",
                                "sense_id": "2641fa2e-7cd6-3b4d-b5e0-4b15b63f336c",
                                "text": "Теряя свои владения одно за другим, теснимый со всех сторон врагами, видя внутреннее расстройство государства, Иоанн был жестоко поражён в своей гордости, и это мучительное чувство отразилось на его приёмах и наружности."
                            },
                            {
                                "example_id": "763ff2f5-9a3a-4d05-ba5d-9bf672c08ce5",
                                "sense_id": "2641fa2e-7cd6-3b4d-b5e0-4b15b63f336c",
                                "text": "У неё дрогнули губы, и сразу несколько чувств отразилось на лице."
                            },
                            {
                                "example_id": "579b4caf-7faf-4728-8d93-1f60b3464939",
                                "sense_id": "2641fa2e-7cd6-3b4d-b5e0-4b15b63f336c",
                                "text": "На Бернардито она посмотрела пристально, и такое сильное волнение отразилось в её лице, что старый корсар испытал некоторое смущение."
                            },
                            {
                                "example_id": "a7117380-1019-4164-9fd9-e89ed976a385",
                                "sense_id": "2641fa2e-7cd6-3b4d-b5e0-4b15b63f336c",
                                "text": "На лице Булай, когда она брала из моих рук журнальчик, отражалось такое отчаяние, словно все вокруг неё рушилось."
                            }
                        ]
                    },
                    {
                        "sense_id": "fa5dd77b-e17f-3d2a-8e40-dd6097b68491",
                        "entry_id": "74d97ff5-7c3b-3be8-917a-c0b98e537ef8",
                        "glosses": [
                            "перен. быть представленным, описанным, рассказанным"
                        ],
                        "tags": [
                            "где-либо, в чём-либо"
                        ],
                        "examples": [
                            {
                                "example_id": "10e8468f-5022-45d4-a700-1381d8d5918a",
                                "sense_id": "fa5dd77b-e17f-3d2a-8e40-dd6097b68491",
                                "text": "Преподобный пастырь Критский, посвятивший дни своей юности изучению Священного Писания и трудов святых Отцов, наряду с опытным знанием инока и возможностью руководства к основам духовной жизни, был одновременно и вдумчивым богословом, что не могло не отразиться в строках Великого канона, где он исповедывал дела своей жизни перед Богом."
                            },
                            {
                                "example_id": "d8b4c2ef-4ea3-46c6-b795-d6671348eb04",
                                "sense_id": "fa5dd77b-e17f-3d2a-8e40-dd6097b68491",
                                "text": "Замечательно, что лживость, составляющая черту века, отразилась сильно и в современных русских источниках той эпохи до того, что, руководствуясь ими и доверяя им, легко можно впасть в заблуждения и неправильные выводы; к счастью, явные противоречия и несообразности, в которые они впадают, обличают их неверности."
                            },
                            {
                                "example_id": "f715ed9a-77cb-49e8-b092-b7f38bfa7960",
                                "sense_id": "fa5dd77b-e17f-3d2a-8e40-dd6097b68491",
                                "text": "Поэтому вся эта история отразилась в потоке массовой информации на нашей планете лишь в виде коротенького сообщения, впоследствии не подтвердившегося и потому почти не привлёкшего внимания."
                            }
                        ]
                    },
                    {
                        "sense_id": "62474e77-75be-3355-96a1-a442297ac290",
                        "entry_id": "74d97ff5-7c3b-3be8-917a-c0b98e537ef8",
                        "glosses": [
                            "перен. отбиваться, обороняться, парировать удары, нападения; изменение направления движения на противоположное"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7337f7dd-0560-40dd-a2ad-e1d418293884",
                                "sense_id": "62474e77-75be-3355-96a1-a442297ac290",
                                "text": "Слишком поздно: луч багровым фонтанчиком отразился от захлопывающейся двери."
                            }
                        ]
