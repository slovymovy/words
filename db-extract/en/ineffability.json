                                                "sense_id": "49938c9e-e49d-39a1-99ba-6245756ac0bc",
                                                "text": "In manchen Religionen gilt die Unaussprechlichkeit des Namens Gottes."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "7210a757-cf2b-33f4-a349-e7e0816fdd29",
                                        "entry_id": "ca694ec1-ce72-3dd4-90ef-59c10c9ea8ce",
                                        "glosses": [
                                            "Eigenschaft eines Sachverhalts, für jemanden nicht darstellbar zu sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b640956f-d1d9-492a-b29a-fdc56aaf010d",
                                                "sense_id": "7210a757-cf2b-33f4-a349-e7e0816fdd29",
                                                "text": "Viele teilen den Eindruck der Unaussprechlichkeit der Verbrechen, die mit Völkermord einhergehen."
