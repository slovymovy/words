                                                "example_id": "1b06302b-1663-428c-a01b-a95cda504fab",
                                                "sense_id": "b1361835-fb57-3da1-b712-6848cb363b0e",
                                                "text": "In the engine room, the changing angle dropped the melted core to the deck. The hot mass attacked the steel deck first, burning through that, then the titanium of the hull. Five seconds later the engine room was vented to the sea."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c2210068-f950-3b70-b57a-3184eafb8fc2",
                                        "entry_id": "838f8f76-048b-362f-93cc-3f33fc21cd36",
