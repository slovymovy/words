                ],
                "senses": [
                    {
                        "sense_id": "0b846cfd-fc1d-34d8-92df-1e0c49d24472",
                        "entry_id": "f557b94f-aa88-3234-8bcd-c717e22d5028",
                        "glosses": [
                            "ein Stab als Teil eines Gitters"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f70cec71-803b-43a8-b190-917bf3aa36d9",
                                "sense_id": "0b846cfd-fc1d-34d8-92df-1e0c49d24472",
                                "text": "„Durch die Gitterstäbe des kleinen Fensters sah ich, wie es langsam hell wurde.“"
                            },
                            {
                                "example_id": "b4c18362-9829-4cca-a4d7-5add206182dd",
                                "sense_id": "0b846cfd-fc1d-34d8-92df-1e0c49d24472",
                                "text": "„Ein Hund lugte durch die Gitterstäbe in einem Tor.“"
                            },
                            {
                                "example_id": "d7f166bd-6c96-4042-a811-56f31ae6f046",
                                "sense_id": "0b846cfd-fc1d-34d8-92df-1e0c49d24472",
                                "text": "„Während sie in diesen Anblick vertieft waren, ging ein Mann mit graumeliertem Haar in einem schwarzen Paletot den Pfad entlang und fuhr dabei mit seinem Spazierstock rasselnd über sämtliche Gitterstäbe.“"
                            },
                            {
                                "example_id": "12f127de-02e9-4a61-99c1-7d729ad7a897",
                                "sense_id": "0b846cfd-fc1d-34d8-92df-1e0c49d24472",
                                "text": "„Anton greift in seine Tasche und reicht ihm durch die Gitterstäbe wortlos eine Porzellanscherbe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
