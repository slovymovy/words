                "senses": [
                    {
                        "sense_id": "2f9f5693-a16a-3682-8a58-98b0fa624588",
                        "entry_id": "4f48f7ab-9d83-3d75-8c52-3aaefa34f21a",
                        "glosses": [
                            "Tumulus funéraire chez d'anciens peuples amérindiens."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "b000bd72-0248-49d4-aff5-d2eb20f3fe50",
                                "sense_id": "2f9f5693-a16a-3682-8a58-98b0fa624588",
                                "text": "Les mounds sont en général des dômes ou pyramides en terre, de hauteur et de dimensions très-variables."
                            },
                            {
                                "example_id": "7b012554-d56d-4f08-a8b5-f45ada39ddf5",
                                "sense_id": "2f9f5693-a16a-3682-8a58-98b0fa624588",
                                "text": "Deux ouvertures y donnaient accès; celle du nord était protégée par des levées en terre renfermant un mound de faibles dimensions ; celle de l'est par un mound de neuf pieds de hauteur. Ni l'un, ni l'autre de ces mounds n'ont encore été fouillés."
                            },
                            {
                                "example_id": "2a43b2aa-d98e-44b9-9329-0f685313b0f8",
                                "sense_id": "2f9f5693-a16a-3682-8a58-98b0fa624588",
                                "text": "De quelle époque datent ces tumulus ? Certains auteurs ont voulu les attribuer aux Toltèques, alors qu'ils habitaient les vallées du Nord, […]. Mais d'autres savants n'hésitent pas à considérer les mounds comme l’œuvre des Indiens eux-mêmes."
                            }
                        ]
                    }
