                    }
                ],
                "senses": [
                    {
                        "sense_id": "bcb47301-1fff-3a0e-bdf7-1c2dc13cf0ba",
                        "entry_id": "d891802c-735c-3d95-84ee-40d59eb773a2",
                        "glosses": [
                            "удобство, благоустроенность в домашней обстановке, в быту"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "599c297a-021f-42d7-b17d-e49cfef93160",
                                "sense_id": "bcb47301-1fff-3a0e-bdf7-1c2dc13cf0ba",
                                "text": "Мы осмотрелись: просторная чистая квартира — тишь, запах ладана и целебных трав, мирный обывательский уют."
                            },
                            {
                                "example_id": "773a0b9d-18d0-4643-bdff-ea8aa73be369",
                                "sense_id": "bcb47301-1fff-3a0e-bdf7-1c2dc13cf0ba",
                                "text": "Есть особенный простодушный уют в таких комнатах с висячей лампой над обеденным столом, с её белым матовым абажуром, с оленьими рогами над картиной."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "782485d7-d0f0-46f1-962d-7a3c59737942",
                        "source_entry_id": "d891802c-735c-3d95-84ee-40d59eb773a2",
                        "source_sense_id": "bcb47301-1fff-3a0e-bdf7-1c2dc13cf0ba",
                        "target_lang_word": "cosiness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cosiness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "51e07301-4a86-399b-bbed-ea2acc9f657c",
                                        "entry_id": "20c8794a-acd7-3eb7-b3b9-a82b40c05510",
                                        "glosses": [
                                            "The state or quality of being cosy."
                                        ],
                                        "tags": [
                                            "UK",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8e98788d-3942-447e-8f42-b84c7ef53317",
                        "source_entry_id": "d891802c-735c-3d95-84ee-40d59eb773a2",
                        "source_sense_id": "bcb47301-1fff-3a0e-bdf7-1c2dc13cf0ba",
                        "target_lang_word": "comfort",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "comfort",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ac4ac4b0-e022-3d91-8455-c7ff0b521dc6",
                                        "entry_id": "eb654a7f-933f-31fa-941a-1b4c5584bfeb",
                                        "glosses": [
                                            "Contentment, ease."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "67ba6da0-9cdf-4454-afb1-08ce9af2a8f6",
                                                "sense_id": "ac4ac4b0-e022-3d91-8455-c7ff0b521dc6",
                                                "text": "Sleep in comfort with our new mattress."
                                            },
                                            {
                                                "example_id": "f096a95f-a91f-43c4-a221-4478e96b25db",
                                                "sense_id": "ac4ac4b0-e022-3d91-8455-c7ff0b521dc6",
                                                "text": "But all was in vain: For having ranged up and down the Woods for ſome days, without finding the leaſt comfort to their hungry deſires, they were forced to return again unto the River. […] At laſt they arrived at the Coaſt of the Sea, where they found ſome comfort and relief to their former miſeries, and alſo means to ſeek more."
                                            },
                                            {
                                                "example_id": "b12b7759-1c30-40b4-b2a2-e203c3f37f1c",
                                                "sense_id": "ac4ac4b0-e022-3d91-8455-c7ff0b521dc6",
                                                "text": "How often is the comfort of a whole family abridged by some trifling circumstance, that ought not to have made a visible impression!"
                                            },
                                            {
                                                "example_id": "6277940d-74d4-4d2b-a02d-cc5d1ee23bfd",
                                                "sense_id": "ac4ac4b0-e022-3d91-8455-c7ff0b521dc6",
                                                "text": "In a hole in the ground there lived a hobbit. Not a nasty, dirty, wet hole, filled with the ends of worms and an oozy smell, nor yet a dry, bare, sandy hole with nothing in it to sit down on or to eat: it was a hobbit-hole, and that means comfort."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f578e6e7-61cf-32a1-98de-b35ad9726c04",
                                        "entry_id": "eb654a7f-933f-31fa-941a-1b4c5584bfeb",
                                        "glosses": [
                                            "Something that offers comfort."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dec5c482-f43b-4576-b4c9-5b21d542a44f",
                                                "sense_id": "f578e6e7-61cf-32a1-98de-b35ad9726c04",
                                                "text": "the comforts of home"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3fff75c8-aad7-339a-8a89-7abdd8d5f16c",
                                        "entry_id": "eb654a7f-933f-31fa-941a-1b4c5584bfeb",
                                        "glosses": [
                                            "A consolation; something relieving suffering or worry."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b8b6956d-da19-41c3-bca1-1511d36523e3",
                                                "sense_id": "3fff75c8-aad7-339a-8a89-7abdd8d5f16c",
                                                "text": "We still have the spare tire? That's a comfort at least."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "457a5416-6c79-36ee-b4f3-96d6b028b9da",
                                        "entry_id": "eb654a7f-933f-31fa-941a-1b4c5584bfeb",
                                        "glosses": [
                                            "A cause of relief or satisfaction."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eec34e29-0375-4ca6-8c7f-06b6a0a5fdf9",
                                                "sense_id": "457a5416-6c79-36ee-b4f3-96d6b028b9da",
                                                "text": "The outcome of the peace negotiations in Moscow in 1940 was a heavy blow to the young nation, but in the same time a great comfort: at least the independency was preserved."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "comfort",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8c22aaab-c094-390e-90e2-bd2a2a9996bd",
                                        "entry_id": "f34c54e9-9dc1-35d3-82dd-eb47633965e5",
                                        "glosses": [
                                            "To relieve the distress or suffering of; to provide comfort to."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "723626b3-f0f5-413f-8f66-7f61a4088b44",
                                                "sense_id": "8c22aaab-c094-390e-90e2-bd2a2a9996bd",
                                                "text": "Rob comforted Aaron because he was lost and very sad."
                                            },
                                            {
                                                "example_id": "5fdf40ef-9d60-4817-bf92-ec5e7f482c5f",
                                                "sense_id": "8c22aaab-c094-390e-90e2-bd2a2a9996bd",
                                                "text": "Shew me a token foꝛ good, that they which hate me may ſee it, and bee aſhamed: becauſe thou, Lord, hast holpen me, and comfoꝛted me."
                                            },
                                            {
                                                "example_id": "dbd77268-90e0-4d48-91fa-4ed4fc71306d",
                                                "sense_id": "8c22aaab-c094-390e-90e2-bd2a2a9996bd",
                                                "text": "Light, above all things, excelleth in comforting the spirits of men."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d41f1b2e-7dd0-3657-93bc-7bc1465e07d0",
                                        "entry_id": "f34c54e9-9dc1-35d3-82dd-eb47633965e5",
                                        "glosses": [
                                            "To make strong; to invigorate; to fortify; to corroborate."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "620e1633-f609-4162-861a-db2383c7afd2",
                                                "sense_id": "d41f1b2e-7dd0-3657-93bc-7bc1465e07d0",
                                                "text": "God's own testimony […] doth not a little comfort and confirm the same."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "69cf8bed-aaa7-3367-9894-bec0a3dd019b",
                                        "entry_id": "f34c54e9-9dc1-35d3-82dd-eb47633965e5",
                                        "glosses": [
                                            "To assist or help; to aid."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9aae4e1b-05d5-4d52-ac18-28c2c33185f7",
                                                "sense_id": "69cf8bed-aaa7-3367-9894-bec0a3dd019b",
                                                "text": "I […] cannot help the noble chevalier: / God comfort him in this necessity!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d531fade-8c5c-4b33-a34e-932ade9b25fc",
                        "source_entry_id": "d891802c-735c-3d95-84ee-40d59eb773a2",
                        "source_sense_id": "bcb47301-1fff-3a0e-bdf7-1c2dc13cf0ba",
                        "target_lang_word": "Gemütlichkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gemütlichkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6cc3f282-0ae5-38d9-8030-ac106383940a",
                                        "entry_id": "b2b99b03-83b7-3623-b744-3fc99095bcba",
                                        "glosses": [
                                            "Gefühl der Geborgenheit, Vertrautheit und Sicherheit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e451dc97-c2fa-4b74-b3a3-fc239aec6171",
                                                "sense_id": "6cc3f282-0ae5-38d9-8030-ac106383940a",
                                                "text": "„Gemütlichkeit ist Ausdruck und spezifische Färbung des deutschen Rückzugs ins Private.“"
                                            },
                                            {
                                                "example_id": "aa988f12-5788-48b2-b94f-cb90b3549c19",
                                                "sense_id": "6cc3f282-0ae5-38d9-8030-ac106383940a",
                                                "text": "„Die allermeisten finden die Gemütlichkeit in ihren eigenen vier Wänden, aber sie lässt sich nicht einschließen.“"
                                            },
                                            {
                                                "example_id": "2d59d453-fff7-4113-a102-218a266a951b",
                                                "sense_id": "6cc3f282-0ae5-38d9-8030-ac106383940a",
                                                "text": "„Am nächsten Morgen ist es vorbei mit der Gemütlichkeit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "83beaeb4-079e-369d-8327-cf3b0c31a54c",
                                        "entry_id": "b2b99b03-83b7-3623-b744-3fc99095bcba",
                                        "glosses": [
                                            "ruhige, unehrgeizige Herangehensweise"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43ab1b50-8b43-4373-b1e3-54f10cd2ca04",
                                                "sense_id": "83beaeb4-079e-369d-8327-cf3b0c31a54c",
                                                "text": "Probier's mal mit Gemütlichkeit."
                                            },
                                            {
                                                "example_id": "b885b816-c5f8-4529-aa29-b095229b3c80",
                                                "sense_id": "83beaeb4-079e-369d-8327-cf3b0c31a54c",
                                                "text": "Wenn der Chef kommt, ist die Gemütlichkeit flöten."
                                            },
                                            {
                                                "example_id": "cd8d68cf-6254-4724-a0dd-d0da00680e9c",
                                                "sense_id": "83beaeb4-079e-369d-8327-cf3b0c31a54c",
                                                "text": "„Es gibt Deutsche, die den Kampf ums Dasein mit einem Gedrängel hinter sich bringen, das der Gemütlichkeit ins Gesicht schlägt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "d16b3082-ae30-3fed-bad0-767c3b308e62",
                                        "entry_id": "b2b99b03-83b7-3623-b744-3fc99095bcba",
                                        "glosses": [
                                            "Situationen und besonders Gespräche, die auf das Gemüt einwirken"
                                        ],
                                        "tags": [
                                            "laut E. T. A. Hoffmann"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4bda6ee7-7199-4ea0-aa7d-b590402bf917",
                                                "sense_id": "d16b3082-ae30-3fed-bad0-767c3b308e62",
                                                "text": "„Unerachtet der strengen Ordensregel waren die Andachtsübungen dem Prior Leonardus mehr Bedürfnis des … Geistes, als asketische Buße für Sünde, und er wußte diesen Sinn der Andacht so in den Brüdern zu entzünden, dass sich über alles, was sie tun mussten, um der Regel zu genügen, eine Heiterkeit und Gemütlichkeit ergoß, die in der Tat ein höheres Sein in der irdischen Beengtheit erzeugte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "53f8e671-eb69-42e1-9652-7493cfd88d08",
                        "source_entry_id": "d891802c-735c-3d95-84ee-40d59eb773a2",
                        "source_sense_id": "bcb47301-1fff-3a0e-bdf7-1c2dc13cf0ba",
                        "target_lang_word": "Behaglichkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Behaglichkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cd015ed6-d987-3890-a6b6-ef1aee97c52d",
                                        "entry_id": "b975f5f0-48a3-3665-a4b4-e4b56fabbc9c",
                                        "glosses": [
                                            "wohliges Gefühl der Zufriedenheit, stilles Vergnügen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4f469e4-efa8-4827-beb6-c66fdd70faac",
                                                "sense_id": "cd015ed6-d987-3890-a6b6-ef1aee97c52d",
                                                "text": "die Stunde der Behaglichkeit - (aus einem Werbespot)"
                                            },
                                            {
                                                "example_id": "3dbab162-7228-4be1-ae42-f301c6b4375a",
                                                "sense_id": "cd015ed6-d987-3890-a6b6-ef1aee97c52d",
                                                "text": "„Ich suhlte mich in der Behaglichkeit und Mühelosigkeit des Ganzen.“"
                                            },
                                            {
                                                "example_id": "8d36aafe-0629-41a6-b4a2-22ebcb63d258",
                                                "sense_id": "cd015ed6-d987-3890-a6b6-ef1aee97c52d",
                                                "text": "„Allerdings hatten wir diesmal keine Indianer, die für Behaglichkeit und Nahrung sorgten.“"
                                            },
                                            {
                                                "example_id": "87ecb728-395f-43f0-912f-c81020dca323",
                                                "sense_id": "cd015ed6-d987-3890-a6b6-ef1aee97c52d",
                                                "text": "„Ihre Fähigkeit, eine Art von kleinbürgerlicher Behaglichkeit um sich zu verbreiten, war erstaunlich; ebenso ihre unerschütterliche gute Laune.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "73bf0e4e-e3fe-4b2e-a2f7-ed0589b42634",
                        "source_entry_id": "d891802c-735c-3d95-84ee-40d59eb773a2",
                        "source_sense_id": "bcb47301-1fff-3a0e-bdf7-1c2dc13cf0ba",
                        "target_lang_word": "confort",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "confort",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "70cf7cda-8132-3fcf-a3b6-f08be86b648a",
                                        "entry_id": "5913069d-87ca-3fcf-aae1-e4e534717fbe",
                                        "glosses": [
                                            "Assistance matérielle ou morale."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7b85fe05-49a5-415b-a29b-f05ecb6df157",
                                                "sense_id": "70cf7cda-8132-3fcf-a3b6-f08be86b648a",
                                                "text": "Donner aide et confort."
                                            },
                                            {
                                                "example_id": "3b6f5ea9-ce86-4049-9187-e4d93cc06d84",
                                                "sense_id": "70cf7cda-8132-3fcf-a3b6-f08be86b648a",
                                                "text": "Dans cette affliction il ne reçut de confort de personne."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "confort",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d00c0a62-fe23-3a73-bce3-19eb14d5b032",
                                        "entry_id": "27190b40-b13a-3773-b1e0-7fc4e5c9bf9d",
                                        "glosses": [
                                            "Bien-être matériel et moral."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "277e15d7-a163-4790-bb4f-1a8766b2e215",
                                                "sense_id": "d00c0a62-fe23-3a73-bce3-19eb14d5b032",
                                                "text": "Mais je conseille peu l’Islande aux malades, aux invalides et à quiconque est habitué au confort des hôtels et des wagons-lits."
                                            },
                                            {
                                                "example_id": "179bfdb9-be4c-40cb-8cfa-93662911835d",
                                                "sense_id": "d00c0a62-fe23-3a73-bce3-19eb14d5b032",
                                                "text": "Comparé à la libéralité et au confort de la vie ordinaire de l’époque, l’ordre de l’Empire romain, sous les Antonins, apparaît local et limité."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
