                "senses": [
                    {
                        "sense_id": "2012b35f-0bcb-3f40-8b82-d799a206398b",
                        "entry_id": "3bb5b5ca-2be1-307b-a5f3-46acdbf003c3",
                        "glosses": [
                            "staatliche Kontrolle darüber, ob Kommunen (Gemeinden, Städte) geltende Rechtsvorschriften einhalten und sachlich zweckmäßig handeln"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "11335114-6a30-4b99-a9bb-504a75a83a95",
                                "sense_id": "2012b35f-0bcb-3f40-8b82-d799a206398b",
                                "text": "„Die Bezirksregierung mit Sitz in Köln übt als Landesmittelbehörde die Kommunalaufsicht u. a. über den Haushalt der Stadt Bonn aus.“"
                            },
                            {
                                "example_id": "462a79d6-c14d-4fb2-bbc9-31bdfe8c9110",
                                "sense_id": "2012b35f-0bcb-3f40-8b82-d799a206398b",
                                "text": "„Der sonst für die Kommunalaufsicht zuständige Landkreis ist lediglich für die Rechtsaufsicht zuständig.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "805b9a82-f438-38f2-bca1-d8723675679c",
                        "entry_id": "3bb5b5ca-2be1-307b-a5f3-46acdbf003c3",
                        "glosses": [
                            "Behörde, die die Fach- und Rechtsaufsicht für Kommunalverwaltungen wahrnimmt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd0e8753-6a0e-4f7a-a6e0-ca0645fdeaf1",
                                "sense_id": "805b9a82-f438-38f2-bca1-d8723675679c",
                                "text": "„Gegen den Bescheid der Kommunalaufsicht kann Klage beim Verwaltungsgericht Mainz erhoben werden.“"
                            },
                            {
                                "example_id": "42cdc44f-8d01-401b-b3d5-83332dd8039c",
                                "sense_id": "805b9a82-f438-38f2-bca1-d8723675679c",
                                "text": "„Wie ein verirrter Kompass weist die Kommunalaufsicht ständig in nur eine Richtung: Steuererhöhungen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
