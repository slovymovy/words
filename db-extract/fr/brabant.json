                ],
                "senses": [
                    {
                        "sense_id": "f71c3831-ab5f-3818-9865-70b2cf48ada4",
                        "entry_id": "e959cba9-d4d0-3148-bf91-00682bfa5fac",
                        "glosses": [
                            "Ancien duché du Saint-Empire romain germanique, correspondant à peu près à la province néerlandaise du Brabant-Septentrional et en Belgique aux provinces d’Anvers, du Brabant flamand et du Brabant wallon et à la Région de Bruxelles-Capitale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "32a86bb3-379d-425b-9d92-7ef66f00f366",
                                "sense_id": "f71c3831-ab5f-3818-9865-70b2cf48ada4",
                                "text": "La duchesse de Marlborough exerçait la charge de grande maîtresse de la reine Anne à Londres tandis que son époux faisait dans les campagnes de Brabant une double moisson de lauriers et de richesses."
                            }
                        ]
                    },
                    {
                        "sense_id": "2cf0a88b-73b8-36e1-b524-9cd7baf95c26",
                        "entry_id": "e959cba9-d4d0-3148-bf91-00682bfa5fac",
                        "glosses": [
                            "Ancienne province et région géographique à cheval sur la Flandre, Bruxelles et la Wallonie, scindée en Brabant flamand, Brabant wallon et Région de Bruxelles-Capitale."
                        ],
                        "tags": [
                            "toponymic"
                        ],
                        "examples": [
                            {
                                "example_id": "aadf0177-03b0-412f-8807-148d1db30aa7",
                                "sense_id": "2cf0a88b-73b8-36e1-b524-9cd7baf95c26",
                                "text": "Il habite dans le Brabant."
                            },
                            {
                                "example_id": "360353f1-3975-4030-8b5a-c698c0370eee",
                                "sense_id": "2cf0a88b-73b8-36e1-b524-9cd7baf95c26",
                                "text": "Perturbations à Bruxelles et dans les Brabants."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f7efa93f-176b-4ba9-bfa2-26a7b66dd04f",
                        "source_entry_id": "e959cba9-d4d0-3148-bf91-00682bfa5fac",
                        "target_lang_word": "Brabant",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Brabant",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3167a719-c385-3473-8e1a-3dc615b860b9",
                                        "entry_id": "5ce6b113-1dc7-3a36-8c7a-3d352eac98c7",
                                        "glosses": [
                                            "ehemalige belgische Provinz mit der Hauptstadt Brüssel; das von ihr erfasste Gebiet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b2d8cf1-d9d8-44f9-aa61-dcf32f186812",
                                                "sense_id": "3167a719-c385-3473-8e1a-3dc615b860b9",
                                                "text": "„Wenn etwas im Herzen des Königreichs Belgien liegt, dann ist es Brabant.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "af498e97-8e8a-3110-9954-f42420825963",
                                        "entry_id": "5ce6b113-1dc7-3a36-8c7a-3d352eac98c7",
                                        "glosses": [
                                            "Herzogtum, das annähernd das Gebiet der niederländischen Provinz Nord-Brabant, der belgischen Provinzen Antwerpen, Flämisch-Brabant und Wallonisch-Brabant und der Region Brüssel-Hauptstadt abdeckte"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "21cc5afe-7e07-4505-a669-ace70e51059f",
                                                "sense_id": "af498e97-8e8a-3110-9954-f42420825963",
                                                "text": "„Da 1427 und 1430 beide Söhne Antons kinderlos verstorben waren, war im Jahre 1430 das Herzogtum Brabant jedoch erneut vakant.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
