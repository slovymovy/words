                    "sense_id": "4eb20f00-7931-316f-aad6-38af16451b7e",
                    "sense_definition": "een fluitend of huilend geluid maken, vaak door de wind of een krachtige ademhaling",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "geluid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Buiten <w>giert</w> de wind door de takken van de oude bomen.",
                            "target_lang_translations": {
                                "en": "Outside the wind <w>howls</w> through the branches of the old trees.",
                                "fr": "Dehors, le vent <w>hurle</w> à travers les branches des vieux arbres."
                            }
                        },
                        {
                            "text": "De koude wind <w>gierde</w> om het huis tijdens de storm.",
                            "target_lang_translations": {
                                "en": "The cold wind <w>whistled</w> around the house during the storm.",
                                "fr": "Le vent froid <w>sifflait</w> autour de la maison pendant la tempête."
                            }
                        }
                    ],
                    "synonyms": [
                        "huilen",
                        "fluiten",
                        "loeien"
                    ],
                    "common_phrases": [
                        "gierende wind"
                    ],
                    "target_lang_definitions": {
                        "en": "To make a whistling or howling sound, often caused by wind or powerful breathing.",
                        "fr": "Produire un son sifflant ou hurlant, souvent causé par le vent ou une respiration forte."
                    },
                    "translations": {
