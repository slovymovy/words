                ],
                "senses": [
                    {
                        "sense_id": "3ab43a4b-a4b8-32d6-985d-10c217d3c491",
                        "entry_id": "6cda4bb2-c17c-3a9a-9c3b-5d00eb8b4e5a",
                        "glosses": [
                            "Manger du couscous."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5dd16522-ddf2-442b-8e74-041eb1de1065",
                                "sense_id": "3ab43a4b-a4b8-32d6-985d-10c217d3c491",
                                "text": "Ce bon marocain à prix doux est idéal pour “couscousser ou tajiner” entre amis."
                            },
                            {
                                "example_id": "2f8b1e50-832c-4364-9c0e-6925ab2b0c4f",
                                "sense_id": "3ab43a4b-a4b8-32d6-985d-10c217d3c491",
                                "text": "Viens couscousser, comme à Oran où nous étions petits enfants."
                            },
                            {
                                "example_id": "6c35e368-34d4-4693-8a73-744696c3fd4e",
                                "sense_id": "3ab43a4b-a4b8-32d6-985d-10c217d3c491",
                                "text": "Vous pouvez donc aller \"couscousser\" les yeux fermés ;)."
                            },
                            {
                                "example_id": "483a43e9-ae51-480a-a8e2-a4c3ee912d1c",
                                "sense_id": "3ab43a4b-a4b8-32d6-985d-10c217d3c491",
                                "text": "On peut couscousser et merghezer dans la salle à côté."
                            }
                        ]
                    },
                    {
                        "sense_id": "faf1b9a9-0d11-3739-8da3-9149df114196",
                        "entry_id": "6cda4bb2-c17c-3a9a-9c3b-5d00eb8b4e5a",
                        "glosses": [
                            "Plaisanter."
                        ],
                        "tags": [
                            "définition à préciser ou à vérifier"
                        ],
                        "examples": [
                            {
                                "example_id": "463a819d-fdb8-448a-b78d-6c5b270a636c",
                                "sense_id": "faf1b9a9-0d11-3739-8da3-9149df114196",
                                "text": "D’ailleurs, j’ai fini de couscousser."
                            },
                            {
                                "example_id": "fab11bbc-8f7f-4ce3-b328-03b049eb2606",
                                "sense_id": "faf1b9a9-0d11-3739-8da3-9149df114196",
                                "text": "Il avait beau savoir cela et avoir trente-deux ans, il ne pouvait s’empêcher de surnommer, de vanner et de couscousser tout et tous sans tenir compte des positions, qui sont tout ce que Paris respecte."
                            }
                        ]
                    }
