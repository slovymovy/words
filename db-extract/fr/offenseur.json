                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2439a711-c6e6-439f-929a-370d3d097315",
                                "sense_id": "b936dd47-8440-3c1e-8331-f21b0c6097ef",
                                "text": "Plus l’offenseur est cher, et plus grande est l’offense."
                            },
                            {
                                "example_id": "38c8b4a0-b78f-4a28-9714-71ed2334d21b",
                                "sense_id": "b936dd47-8440-3c1e-8331-f21b0c6097ef",
                                "text": "Ils ont senti que l'esprit public de l'offensé tournerait à sa ruine ou sauverait l'offenseur."
                            }
                        ]
                    }
                ],
