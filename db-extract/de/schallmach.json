                "senses": [
                    {
                        "sense_id": "a0e4aad5-7803-3b9c-8289-1a7152c4d7c8",
                        "entry_id": "0239f1a6-a290-32b9-bdbc-80a47931d3f3",
                        "glosses": [
                            "seltener, deutschsprachiger Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9976c385-7f2b-43de-a93b-62a03fdca8f9",
                                "sense_id": "a0e4aad5-7803-3b9c-8289-1a7152c4d7c8",
                                "text": "Frau Schallmach ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "858726e6-44ba-4b0c-8f17-927904391ddf",
                                "sense_id": "a0e4aad5-7803-3b9c-8289-1a7152c4d7c8",
                                "text": "Herr Schallmach wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "a3c7da7b-520d-40f5-a336-9b9d012d5897",
                                "sense_id": "a0e4aad5-7803-3b9c-8289-1a7152c4d7c8",
                                "text": "Die Schallmachs fliegen heute nach Liverpool."
                            },
                            {
                                "example_id": "76023d73-e197-4907-ae55-5ed88254dfef",
                                "sense_id": "a0e4aad5-7803-3b9c-8289-1a7152c4d7c8",
                                "text": "Der Schallmach trägt nie die Pullover, die die Schallmach ihm strickt."
                            },
                            {
                                "example_id": "00c01612-66f5-4f4c-936e-485b2a5bd9c9",
                                "sense_id": "a0e4aad5-7803-3b9c-8289-1a7152c4d7c8",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Schallmach kommt, geht der Herr Schallmach.“"
                            },
                            {
                                "example_id": "b352fe22-0def-4181-b9b2-11dec6f0fdc3",
                                "sense_id": "a0e4aad5-7803-3b9c-8289-1a7152c4d7c8",
                                "text": "Schallmach kommt und geht."
                            },
                            {
                                "example_id": "0ada6aef-383a-416e-b391-8f3379805df4",
                                "sense_id": "a0e4aad5-7803-3b9c-8289-1a7152c4d7c8",
                                "text": "Schallmachs kamen, sahen und siegten."
                            }
                        ],
