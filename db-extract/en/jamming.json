                    {
                        "sense_id": "0002cf1a-74ca-395b-bf53-f52ef01f0c3d",
                        "entry_id": "c8f7a8d7-cccc-3bf1-b59f-c1dc01f967ac",
                        "glosses": [
                            "The playing of improvisational music."
                        ],
                        "tags": [
