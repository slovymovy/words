                                        "entry_id": "36ca654e-b13a-3010-80e3-795554de116f",
                                        "glosses": [
                                            "To activate (an item on the screen) by right-clicking while the pointer is over it."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
