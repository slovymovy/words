                                "target_senses": [
                                    {
                                        "sense_id": "a7c1c4e4-9b3d-3e35-9a5a-abab2378ebea",
                                        "entry_id": "5cc2323a-7eae-3127-a415-d7bfa3c4c420",
                                        "glosses": [
                                            "organizzazione criminale formata da associazioni rette dalla legge dell'omertà e della segretezza, che controllano attività economiche illecite e di governo parallelo, diffusa in origine in Sicilia"
                                        ],
                                        "tags": [
                                            "diritto"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6b5796b4-be02-489b-919a-d7b603c736b5",
                                                "sense_id": "a7c1c4e4-9b3d-3e35-9a5a-abab2378ebea",
                                                "text": "la mafia è stata quasi sconfitta in tutto il mondo"
                                            },
                                            {
                                                "example_id": "c54ca32f-6b7e-43ce-a9a8-82d1a7cd4f62",
                                                "sense_id": "a7c1c4e4-9b3d-3e35-9a5a-abab2378ebea",
                                                "text": "esiste una sorta di casata di mafia i cui giovani adepti sono quasi naturalmente attirati dal male radicato nelle forme della materialità più oscura"
                                            },
                                            {
                                                "example_id": "13d29d36-4e03-4527-97f8-e014459006f8",
                                                "sense_id": "a7c1c4e4-9b3d-3e35-9a5a-abab2378ebea",
                                                "text": "per sua natura la mafia è mendace ed iniqua"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c91c7ad-a537-3e4e-9309-63d26422d027",
                                        "entry_id": "5cc2323a-7eae-3127-a415-d7bfa3c4c420",
                                        "glosses": [
                                            "l'insieme della criminalità organizzata quali n'drangheta, camorra, la stessa mafia, in Italia e nel mondo"
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f7ae8b77-1ad3-4c6e-adc9-870d4ad47083",
                                                "sense_id": "7c91c7ad-a537-3e4e-9309-63d26422d027",
                                                "text": "sono stati commessi molti omicidi dalle mafie ormai da molto tempo"
                                            },
                                            {
                                                "example_id": "7c6c958d-f8fe-4d2f-9c50-c9f7f581d0c4",
                                                "sense_id": "7c91c7ad-a537-3e4e-9309-63d26422d027",
                                                "text": "visto e considerato il tipo di \"affari\" in cui è \"immischiata\", sinceramente non so a chi convenga dire che la mafia è \"una sorta di impero super-organizzato\" quando in realtà è il peggiore caos criminale"
                                            },
                                            {
                                                "example_id": "04ebe858-6467-4fec-b40b-2ae95544940b",
                                                "sense_id": "7c91c7ad-a537-3e4e-9309-63d26422d027",
                                                "text": "”Ci sono tante aziende destinate a fallire già quando vengono create, sia per un errore nell’amministrazione, per personale incompetente o per un prodotto di scarsa qualità, ma mai come la mafia che “gestisce” appunto il peggior “mercato” che possa esistere, eppure…”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
