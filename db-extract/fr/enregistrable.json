                    }
                ],
                "senses": [
                    {
                        "sense_id": "c730b366-f53c-3047-8088-f635bece4c12",
                        "entry_id": "b3deac6f-c0e1-3358-82bd-71c1ac08f346",
                        "glosses": [
                            "Que l'on peut enregistrer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d4904044-fe69-47bb-bcd0-50f39acbf996",
                                "sense_id": "c730b366-f53c-3047-8088-f635bece4c12",
                                "text": "C'est le cas du son de la voix, on l'a noté, enregistrable par le sonagraphe, retraçable par un sonagramme où les fréquences sont portées en ordonnée et le temps en abscisse, […]."
                            },
                            {
                                "example_id": "ef62b45b-0270-47ed-a8a1-df05b672b2ae",
                                "sense_id": "c730b366-f53c-3047-8088-f635bece4c12",
                                "text": "Malheureusement, le temps réel – toujours enregistrable sur machine – et le temps subjectif – souvent remémorable et restituable après réveil – du rêve sont deux chronologies neurophysiologique et psychologique que nous ne pouvons pas encore discerner objectivement et convenablement par voie expérimentale."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4314f6d1-de08-41ac-b41c-2b78ab4e6db7",
                        "source_entry_id": "b3deac6f-c0e1-3358-82bd-71c1ac08f346",
                        "source_sense_id": "c730b366-f53c-3047-8088-f635bece4c12",
                        "target_lang_word": "recordable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "recordable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "41125da3-1846-3251-bc5c-7601e2161680",
                                        "entry_id": "efe52307-e4d5-3ba7-a15c-e4296f8ac3c5",
                                        "glosses": [
                                            "That can be recorded; capturable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c310d913-b6e9-41ad-b690-965140827fd3",
                                                "sense_id": "41125da3-1846-3251-bc5c-7601e2161680",
                                                "text": "Sound and movement are recordable by means of microphones and cameras."
                                            },
                                            {
                                                "example_id": "32a46e48-ba79-43b8-829c-d7ee3652d23f",
                                                "sense_id": "41125da3-1846-3251-bc5c-7601e2161680",
                                                "text": "User actions are recordable in a macro for playback at a later time."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "043b1654-5b1a-369d-baf7-5318f3f4bedc",
                                        "entry_id": "efe52307-e4d5-3ba7-a15c-e4296f8ac3c5",
                                        "glosses": [
                                            "Able to be used to record something."
                                        ],
                                        "tags": [
                                            "of a CD"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3cb27c0a-6b01-3743-9107-bfa8ba9a89f9",
                                        "entry_id": "efe52307-e4d5-3ba7-a15c-e4296f8ac3c5",
                                        "glosses": [
                                            "Liable to be retained on someone's criminal record."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "75bf2b04-7587-4df7-baed-d89ea249e7f5",
                                                "sense_id": "3cb27c0a-6b01-3743-9107-bfa8ba9a89f9",
                                                "text": "Marper, who was 38 years of age and of good character, was arrested and charged with harassment of his partner. The police took his fingerprints and DNA samples. His partner became reconciled with him and decided not to press the charges, and the case was formally discontinued. The police refused to destroy the fingerprints and samples. In both cases the police relied on the Criminal Justice and Police Act 2001, which allows the police to take and to retain indefinitely, without consent, fingerprints and DNA samples from a person of any age who has been arrested in connection with a “recordable” offence."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
