                                        "entry_id": "6c8af0d2-8762-3305-8057-151b216de7e9",
                                        "glosses": [
                                            "bez słyszalnego głosu; bez żadnego dźwięku lub na granicy słyszalności"
                                        ],
                                        "tags": [],
