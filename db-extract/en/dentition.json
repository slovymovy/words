                "senses": [
                    {
                        "sense_id": "32885a66-ab08-3f06-9ae1-4ca32cf06efd",
                        "entry_id": "2c984807-e1b6-3e84-9c0b-355d623e18dc",
                        "glosses": [
                            "The set of natural teeth of an individual"
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "188292e2-df11-3d15-87b0-479df19df4d4",
                        "entry_id": "2c984807-e1b6-3e84-9c0b-355d623e18dc",
                        "glosses": [
                            "The type, number and arrangement of the normal teeth of an organism or of the actual teeth of an individual"
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "6dab4a48-d26d-47b3-9bf7-72efab058d58",
                                "sense_id": "188292e2-df11-3d15-87b0-479df19df4d4",
                                "text": "Can a medical man say just exactly from the necessarily hurried examination he must give of the mouth, and without a special dental knowledge, what constitutes a good dentition?"
                            }
                        ]
                    },
                    {
                        "sense_id": "e5c2f0e9-45b2-3fbb-9d2d-97fee9cfc9ef",
                        "entry_id": "2c984807-e1b6-3e84-9c0b-355d623e18dc",
                        "glosses": [
                            "An arrangement in an organism or object of projections that resemble teeth"
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "6658e15a-42bf-470e-bdce-612086f2b024",
                                "sense_id": "e5c2f0e9-45b2-3fbb-9d2d-97fee9cfc9ef",
                                "text": "As mentioned dentition of bivalves, i.e. teeth and sockets, occur on the vertical portion of the hinge plates of the two valves, which are in contact with each other when the shell is closed."
                            }
                        ]
                    },
                    {
                        "sense_id": "9a19d4aa-d6b1-3791-b0f7-caaebb01835e",
                        "entry_id": "2c984807-e1b6-3e84-9c0b-355d623e18dc",
                        "glosses": [
                            "The process of growing teeth; teething"
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
