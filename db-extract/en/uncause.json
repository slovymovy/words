                    {
                        "sense_id": "c9e8b6f4-80bc-3c97-a313-dbd5f85801db",
                        "entry_id": "7dc01a4a-3ded-39fa-9845-7cf5db000ce0",
                        "glosses": [
                            "To revert or undo the causing of an act or action"
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "f9612261-6e40-4fa9-89aa-57aa59bf05c4",
                                "sense_id": "c9e8b6f4-80bc-3c97-a313-dbd5f85801db",
                                "text": "The truth is simply this: that which causes marriage also uncauses it."
                            },
                            {
                                "example_id": "8c6f7c7c-0171-4fb1-8557-3e17617c3e83",
                                "sense_id": "c9e8b6f4-80bc-3c97-a313-dbd5f85801db",
                                "text": "Does the new soul, by itself, “cause” the conception? Can I then not uncause it?"
                            }
                        ]
                    }
                ],
