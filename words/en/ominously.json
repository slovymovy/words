                    "semantic_group_id": "foreboding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dark clouds gathered <w>ominously</w> over the valley before the storm began.",
                            "target_lang_translations": {
                                "nl": "Donkere wolken pakten zich <w>onheilspellend</w> samen boven de vallei voordat de storm begon."
                            }
                        },
                        {
                            "text": "The engine started making an <w>ominously</w> loud noise as we drove up the hill.",
                            "target_lang_translations": {
                                "nl": "De motor begon <w>onheilspellend</w> veel lawaai te maken toen we de heuvel op reden."
                            }
