                        "target_lang_word": "fart",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fart",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b4e1bd76-e9ec-32a9-8d9a-eca85ad12469",
                                        "entry_id": "a32269d1-02a9-35ca-a196-ccdb8c77d6d3",
                                        "glosses": [
                                            "To emit digestive gases from the anus; to flatulate."
                                        ],
                                        "tags": [
                                            "informal",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "173ee93e-e6e7-4fb2-affd-f587a8080874",
                                                "sense_id": "b4e1bd76-e9ec-32a9-8d9a-eca85ad12469",
                                                "text": "I fart with twenty ladies by; / They call me beast; and what care I?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9805976f-034e-3afe-b812-1c087440c675",
                                        "entry_id": "a32269d1-02a9-35ca-a196-ccdb8c77d6d3",
                                        "glosses": [
                                            "To emit (fumes, gases, etc.)."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "informal",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0aae834e-4129-4014-9dc7-e0f4b25447b5",
                                                "sense_id": "9805976f-034e-3afe-b812-1c087440c675",
                                                "text": "Above his head the funnel farted black soot into the sky."
                                            },
                                            {
                                                "example_id": "e7ed5b9d-c064-4e7b-96cb-3f30a9a56731",
                                                "sense_id": "9805976f-034e-3afe-b812-1c087440c675",
                                                "text": "We’ve been stuck behind a Ford Escort farting black smoke for ten minutes."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fart",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ad15495e-fae4-3f66-971b-b148b3eeb874",
                                        "entry_id": "ab8561c7-d3ac-32c2-9e23-7c17c4d0b03c",
                                        "glosses": [
                                            "An emission of digestive gases from the anus; a flatus."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6976440e-608d-4f75-9025-f5ff6d76e89d",
                                                "sense_id": "ad15495e-fae4-3f66-971b-b148b3eeb874",
                                                "text": "I think I heard a fart. Was it you, Nigel?"
                                            },
                                            {
                                                "example_id": "64ef0aef-64fe-4db4-bc87-1fe0cf55afed",
                                                "sense_id": "ad15495e-fae4-3f66-971b-b148b3eeb874",
                                                "text": "Silent farts are often the smelliest."
                                            },
                                            {
                                                "example_id": "3af4a0ab-1e27-480c-84c5-3c06e0e653ee",
                                                "sense_id": "ad15495e-fae4-3f66-971b-b148b3eeb874",
                                                "text": "Metrocles somewhat indiscreetly, as he was disputing in his Schole, in presence of his auditory, let a fart, for shame whereof he afterwards kept his house and could not be drawen abroad[…]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8b698314-c445-30fe-b1c0-e048b780c7f8",
                                        "entry_id": "ab8561c7-d3ac-32c2-9e23-7c17c4d0b03c",
                                        "glosses": [
                                            "An irritating person; a fool."
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fbb36c17-dd69-3692-a8c0-71be0101f5a9",
                                        "entry_id": "ab8561c7-d3ac-32c2-9e23-7c17c4d0b03c",
                                        "glosses": [
                                            "One who is inflexibly meticulous."
                                        ],
                                        "tags": [
                                            "Maine"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cb7fc474-d199-4a30-b67f-307c3efcb3de",
                        "source_entry_id": "dfc71e52-af62-3bae-aae8-63ae9d9039ec",
                        "source_sense_id": "6698772c-8451-397b-a141-de3325ddd682",
                        "source_sense_description": "Vorgang des Furzens",
                        "target_lang_word": "flatus",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "flatus",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "80c17d40-e68b-3ba0-8b56-20e808a7b4c8",
                                        "entry_id": "6c23d889-4bdb-3a73-8c08-88b2bedd9737",
                                        "glosses": [
                                            "Gas generated in the digestive tract."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3f2371b7-ec5a-39ae-8dc4-bed879de8e9e",
                                        "entry_id": "6c23d889-4bdb-3a73-8c08-88b2bedd9737",
                                        "glosses": [
                                            "Expulsion of such gas through the anus."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7bcb372e-23e5-4dd8-9de2-32baa804abf4",
                                                "sense_id": "3f2371b7-ec5a-39ae-8dc4-bed879de8e9e",
                                                "text": "The point of quoque with illos is that those flatus, which have the right to be called winds, are also subject to laws like the winds themselves."
                                            },
                                            {
                                                "example_id": "2aad1b60-9695-4353-a929-cef43533beca",
                                                "sense_id": "3f2371b7-ec5a-39ae-8dc4-bed879de8e9e",
                                                "text": "And as they perceived in her sundry natures, and divers properties, so they ascribed unto her divers and several names, and erected Statues and Altars unto her, according to those names, under which they then so worshipped and adored her, who (as I have already written) was with many taken and understood for Juno: and those flatus and images which were dedicated unto her, were made also many times of many other goddesses: whose properties signified them to be in nature the same as the earth, as first Lagran Madre, la Madre de i dei, Ope (Ops), Phes, Cibelle, Vesta, Ceres, Proserpina, and many others which of their places and habitations where they then remained, had their names accordingly, all signifying one & the same thing, being as I have said, the Earth, for which indeed, & from whose fruits, all things here in the world seem to receive their life and being, and are nourished & conserved by these fertileness thereof, and in this respect she was called the mother of the gods, insomuch, as all those gods of the Ancients, which were so superstitiously adored and held in that respective regardance, lived here once on the earth, and were fed and maintained by the increases, fruits, & suppeditaments thereof."
                                            },
                                            {
                                                "example_id": "d3a86eae-0f65-409c-af8d-cab5b4d42a16",
                                                "sense_id": "3f2371b7-ec5a-39ae-8dc4-bed879de8e9e",
                                                "text": "A long summary of the work quickly appeared in the Royal Society’s Philosophical Transactions, which began with the theory Ten Rhijne’s had adapted from his Japanese colleagues: “This Author treating of the Gout, … asserts Flatus or Wind included between the Periosteum and the bone to be the genuine producer of those intolerable Pains … and that all the method of cure ought to tend toward the dispelling those Flatus”.¹⁵⁶"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8d840481-eabf-3c5f-a691-083bcb0a7947",
                                        "entry_id": "6c23d889-4bdb-3a73-8c08-88b2bedd9737",
                                        "glosses": [
                                            "Morbid inflation or swelling."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "18210195-ff7e-42bc-b0e8-ca8e604def7a",
                                                "sense_id": "8d840481-eabf-3c5f-a691-083bcb0a7947",
                                                "text": "1730 April, Jonathan Swift, \"A Vindication of the Lord Carteret\", in Thomas Sheridan and John Nichols (Eds.), The Works of the Rev. Jonathan Swift, D.D., Dean of St. Patrick’s, Dublin, Volume IX, J. Johnson &c. (1801), page 226,\n[…] an incensed political surgeon, who is not in much renown for his mercy, upon great provocations: who, without waiting for his death, will flay and dissect him alive; and to the view of mankind lay open all the disordered cells of his brain, the venom of his tongue, the corruption of his heart, and spots and flatuses of his spleen: and all this for threepence."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
