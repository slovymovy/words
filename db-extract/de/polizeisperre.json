                    {
                        "sense_id": "6f3f28de-e519-38f8-82fa-3627ef7a4dc5",
                        "entry_id": "a18fed02-f13a-3cf6-80fd-87ad0f662f8d",
                        "glosses": [
                            "von der Polizei aufgestellte Straßensperre"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "07f758b4-540a-4b04-904c-17a9256eeb96",
                                "sense_id": "6f3f28de-e519-38f8-82fa-3627ef7a4dc5",
                                "text": "„Heute morgen fuhr ich zur Arbeit, und zwischen dem Gebäude und dem Parkplatz waren drei Reihen Polizeisperren, und Polizisten standen an den Eingangstüren und befragten die Leute, mit denen ich arbeite.“"
                            },
                            {
                                "example_id": "9b5b360b-76d3-4672-93b5-bd863e617ecd",
                                "sense_id": "6f3f28de-e519-38f8-82fa-3627ef7a4dc5",
                                "text": "„Lange stehen wir in einem durch eine Polizeisperre verursachten Stau, während ein Konvoi schwarzer Limousinen vorbeikriecht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
