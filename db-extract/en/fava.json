                    {
                        "sense_id": "61f39c5a-f125-36b0-84ac-82438ffff7be",
                        "entry_id": "307c75f5-ad9d-32c3-899d-b9faeff827ee",
                        "glosses": [
                            "A fava bean; a bean (seed or seed pod) of plants of species Vicia faba or the plant itself."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e01968ff-b0fd-439d-b52a-a1a989f25733",
                                "sense_id": "61f39c5a-f125-36b0-84ac-82438ffff7be",
                                "text": "1976, I. I. Gottesman, J. Shields, Rejoinder: Toward optimal arousal and away from original din, Schizophrenia Buletin, 2: 447-453, quoted in 2004, Jay Joseph, The Gene Illusion, page 269,\nFavism, a hemolytic anemia that follows the eating of fava or broadbeans, provides a textbook example of a genotype X environment interaction."
                            },
                            {
                                "example_id": "e4d36dbf-bd30-4923-b1f6-6c278040e0bf",
                                "sense_id": "61f39c5a-f125-36b0-84ac-82438ffff7be",
                                "text": "When spring arrives the fava arrives and everyone in the Mediterranean can dream up a way of cooking it."
                            },
                            {
                                "example_id": "a8f3b03c-f085-45d0-abc5-35f5b3b31eda",
                                "sense_id": "61f39c5a-f125-36b0-84ac-82438ffff7be",
                                "text": "Add the favas and cook for 1 minute."
                            },
                            {
                                "example_id": "30052509-a5fe-43a3-9f13-e82e0978a6a6",
                                "sense_id": "61f39c5a-f125-36b0-84ac-82438ffff7be",
                                "text": "In cool temperate zones favas are planted early in the growing season, several weeks before the last frost, and grown as a summer annual, much like other vegetable crops of the Fabaceae."
                            }
                        ]
                    }
                ],
