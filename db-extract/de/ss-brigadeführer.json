                "senses": [
                    {
                        "sense_id": "e09cca1d-0385-3e31-8a0c-25bbb76e5564",
                        "entry_id": "3c93a205-0e3b-3041-8c4a-58bcb25936a8",
                        "glosses": [
                            "niedrigster Generalsdienstgrad, zwischen dem SS-Oberführer und dem SS-Gruppenführer"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "aaeec616-b13d-31e9-937e-a12031321403",
                        "entry_id": "3c93a205-0e3b-3041-8c4a-58bcb25936a8",
                        "glosses": [
                            "General im Range eines SS-Brigadeführers (Anrede: „Brigadeführer“)"
                        ],
                        "tags": [
                            "Schutzstaffel"
                        ],
                        "examples": [
                            {
                                "example_id": "ab5e4650-0e2b-4133-aacf-b91d33cbec16",
                                "sense_id": "aaeec616-b13d-31e9-937e-a12031321403",
                                "text": "„Sie treffen dort zunächst SS-Brigadeführer Schellenberg und später Himmler, um über die Freilassung jüdischer KZ-Häftlinge zu verhandeln.“"
                            },
                            {
                                "example_id": "53e22f2b-28e4-413c-b227-ac867f0d6dfe",
                                "sense_id": "aaeec616-b13d-31e9-937e-a12031321403",
                                "text": "„Nervös, launisch, kontaktarm, fast krankhaft ehrgeizig, schonunglos fleißig, hochgebildet - so charakterisieren die wenigen Freunde und zahlreichen Feinde den SS-Brigadeführer Franz Alfred Six.“"
                            },
                            {
                                "example_id": "8612ead7-8554-4f04-89af-d103777fc4e3",
                                "sense_id": "aaeec616-b13d-31e9-937e-a12031321403",
                                "text": "„Danach ist nicht zu bezweifeln, dass die Offiziere frühzeitig über die Mordaktionen der Einsatzgruppe B unter SS-Brigadeführer Arthur Nebe informiert waren, dagegen aber in der Anfangsphase des Unternehmens Barbarossa ebenso wenig einzuwenden hatten wie gegen die Ausführung des Befehls, alle Kommissare der Roten Armee bei Gefangennahme zu ermorden.“"
                            },
                            {
                                "example_id": "4c893f27-0874-4c90-93f2-dfd55c1a8d3a",
                                "sense_id": "aaeec616-b13d-31e9-937e-a12031321403",
                                "text": "„Leiter der gesamten Polizei wird Staatssekretär SS-Brigadeführer Ernst Kaltenbrunner.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
