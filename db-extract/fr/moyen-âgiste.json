                        ],
                        "examples": [
                            {
                                "example_id": "ab6bed08-a4e2-4b4c-8895-afbead65993e",
                                "sense_id": "578e9064-0c19-33cf-8918-b60bdf37d515",
                                "text": "Durant dix années, le drame moyen-âgiste a passé du théâtre et de l'in-octavo sur la grande scène du monde ; …. — (Georges Touchard-Lafosse, Histoire de Paris ses révolutions, ses gouvernements et ses événements, éd. Dion et Lambert, 1853 (réédition, 1^(ère) édition 1837))"
                            },
                            {
                                "example_id": "f8f8b67d-07fb-42f1-8032-0035b48330c9",
                                "sense_id": "578e9064-0c19-33cf-8918-b60bdf37d515",
                                "text": "Le nouveau style imagé, moyen-âgiste, artistique, indéfini, nébuleux, crépusculaire."
                            }
                        ]
                    }
