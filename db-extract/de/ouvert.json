                                                "example_id": "435b7df3-78fe-4e98-8980-286272d993a9",
                                                "sense_id": "a3ce11af-83cb-3e6d-a244-2062cb676dcf",
                                                "text": "Physionomie ouverte."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "99b72bd4-f649-354b-9427-40d834734da3",
                                        "entry_id": "43924013-813a-332b-ae3a-97320dd4c4cf",
                                        "glosses": [
