        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "d756ee9e-843e-3a6d-9237-1add36d59d59",
                "word": "nitrocellulose",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "e2e0b5fa-4642-49a0-b5f4-d57fe5e9249d",
                        "entry_id": "d756ee9e-843e-3a6d-9237-1add36d59d59",
                        "tags": [
                            "plural"
                        ],
                        "form": "nitrocelluloses"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4b2c4a05-f0db-3f88-9270-005068428e6e",
                        "entry_id": "d756ee9e-843e-3a6d-9237-1add36d59d59",
                        "glosses": [
                            "A cotton-like material, made from cellulose by the action of nitric and sulphuric acids, used in the manufacture of explosives, collodion etc."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "720afd92-334c-423a-8d17-6c6f86a7f9aa",
                        "source_entry_id": "d756ee9e-843e-3a6d-9237-1add36d59d59",
                        "source_sense_id": "4b2c4a05-f0db-3f88-9270-005068428e6e",
                        "source_sense_description": "the chemical nitrocellulose",
                        "target_lang_word": "nitrocellulose",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nitrocellulose",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "802b649d-14e1-3a1d-a439-76762e8f446e",
                                        "entry_id": "ffafec29-10b6-323a-bd1c-43c86c2684ff",
                                        "glosses": [
                                            "Explosif obtenu par l’action de l’acide nitrique sur la cellulose. (note : elle n’explose que si elle est comprimée, à l’air libre elle brûle.)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "101a91d9-533b-48a0-894c-8985b0c8ade1",
                                                "sense_id": "802b649d-14e1-3a1d-a439-76762e8f446e",
                                                "text": "Il met au point la soie artificielle en 1884 et, en 1880, il est fait chevalier de la Légion d’honneur à titre civil, pour son travail sur le pyroxyle, produit explosif appelé aussi nitrocellulose, qui entre dans la fabrication des munitions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "74da0cb4-9823-3acc-82fa-77b7b31f4c7b",
                                        "entry_id": "ffafec29-10b6-323a-bd1c-43c86c2684ff",
                                        "glosses": [
                                            "Substance utilisée sous forme de collodion pour les premières pellicules photographiques."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71a79727-5843-451f-8256-71770da32097",
                                                "sense_id": "74da0cb4-9823-3acc-82fa-77b7b31f4c7b",
                                                "text": "Près de quatre mille boîtiers, cinq mille plaques, et quatre-vingt-cinq kilomètres de pellicule de nitrocellulose furent détruits avant que les autorités puissent intervenir."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "75212743-5226-4a02-9234-cb3a3c90c1f9",
                        "source_entry_id": "d756ee9e-843e-3a6d-9237-1add36d59d59",
                        "source_sense_id": "4b2c4a05-f0db-3f88-9270-005068428e6e",
                        "source_sense_description": "the chemical nitrocellulose",
                        "target_lang_word": "fulmi-coton",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fulmi-coton",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "39b84cb9-9297-3938-93b4-0e771546864e",
                                        "entry_id": "cc55a6ca-751d-3f86-8265-ca00e90dd248",
                                        "glosses": [
                                            "Coton, ou plus généralement cellulose rendue explosive par l’action directe de l’acide nitrique. (note : il n'explose que s'il est comprimé, à l'air libre il brûle.)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "51152957-f862-4be7-8912-cccbd192c953",
                                                "sense_id": "39b84cb9-9297-3938-93b4-0e771546864e",
                                                "text": "Or le coton, combiné avec l’acide azotique (acide nitrique) à froid, se transforme en une substance éminemment insoluble, éminemment combustible, éminemment explosive. Il y a quelques années, en 1832, un chimiste français, Braconnot, découvrit cette substance, qu’il appela xyloïdine… en 1846, Shonbein, professeur de chimie à Bâle, la proposa comme poudre de guerre. Cette poudre, c’est le coton azotique… - Ou pyroxyle, répondit Elphiston. – Ou fulmi-coton répliqua Morgan."
                                            },
                                            {
                                                "example_id": "91724ba8-1c96-4230-b545-362818b0badf",
                                                "sense_id": "39b84cb9-9297-3938-93b4-0e771546864e",
                                                "text": "La poudre à gros grains a fait son temps. Celle dont je me sers est le fulmi-coton, dont la puissance expansive est quatre fois supérieure à celle de la poudre ordinaire, puissance que je quintuple encore en y mêlant les huit dixièmes de son poids de nitrate de potasse !"
                                            },
                                            {
                                                "example_id": "5b6984e5-d2be-4f26-ad72-8865f97ed8f4",
                                                "sense_id": "39b84cb9-9297-3938-93b4-0e771546864e",
                                                "text": "Un morceau de ouate trempé quelques minutes dans l’acide concentré, puis lavé et desséché, se transforme en un corps de même apparence, mais extrêmement inflammable. C’est le coton-poudre ou fulmi-coton, qui brûle très rapidement en ne donnant que des gaz ; on le comprime en cartouches et on l’emploie dans les mines à la place de la poudre."
                                            },
                                            {
                                                "example_id": "8931b7da-f593-4beb-9028-ce0a0fe02503",
                                                "sense_id": "39b84cb9-9297-3938-93b4-0e771546864e",
                                                "text": "Une bien dangereuse ouate, en vérité ! Non, mon cher, c'est du fulmi-coton ! Une simple claque amicale sur votre épaule et vous sautiez en l'air ! Revêtu de cet uniforme infernal, vous étiez un véritable homme-bombe."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "36d200cc-e236-4387-a49d-aed5abb62ced",
                        "source_entry_id": "d756ee9e-843e-3a6d-9237-1add36d59d59",
