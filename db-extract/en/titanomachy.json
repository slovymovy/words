                    {
                        "translation_id": "beca25e2-ec75-4720-a4b6-8bf503f6e92a",
                        "source_entry_id": "f94283ea-1045-382f-8779-3bf5ffc829b9",
                        "source_sense_id": "d34a8dcb-46a8-380e-bc18-7eca215b1772",
                        "source_sense_description": "mythological war between Titans and Olympian gods",
