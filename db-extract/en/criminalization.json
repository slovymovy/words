                        "sense_id": "abe15356-44c1-3619-8aeb-4e68a9cba660",
                        "entry_id": "cc0a416c-98da-39b8-8115-beb2c619db81",
                        "glosses": [
                            "The act of turning someone into a criminal by making their activities illegal."
