                "senses": [
                    {
                        "sense_id": "32484ab4-4121-3e86-8e12-1b4b3ef73b8c",
                        "entry_id": "f9402386-26c4-35c2-980b-549fbb2e18b5",
                        "glosses": [
                            "To fish for whitefish."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e850ce75-6a9c-401b-983e-ab844f0335ad",
                                "sense_id": "32484ab4-4121-3e86-8e12-1b4b3ef73b8c",
                                "text": "“Perhaps he went whitefishing after he had his supper.”"
                            },
                            {
                                "example_id": "1c3db0a7-d188-44af-b936-36aae1aee55f",
                                "sense_id": "32484ab4-4121-3e86-8e12-1b4b3ef73b8c",
                                "text": "“Bill” is said to have whitefished on the lake since Paul Bunyan and his big blue ox first plowed it out."
                            },
                            {
                                "example_id": "bb1dd93a-c60b-4c18-9a48-4e4dd47040b2",
                                "sense_id": "32484ab4-4121-3e86-8e12-1b4b3ef73b8c",
                                "text": "Beth and I whitefished in the broken ice along the banks of the Clark, a fire of driftwood roaring in the wind with the coffeepot set among the coals."
                            }
                        ]
                    }
                ],
