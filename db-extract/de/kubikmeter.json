                        ],
                        "form": "die Kubikmeter"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c154969c-6e2b-38f2-99e5-462177253ea0",
                        "entry_id": "f87e407d-dcc8-3e52-a4e1-398d6305bff1",
                        "glosses": [
                            "Raummaß, das dem Volumen (Rauminhalt) eines Würfels mit 1 Meter Kantenlänge entspricht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "88dee60a-6d0f-4842-8fa0-b75c49b5a462",
                                "sense_id": "c154969c-6e2b-38f2-99e5-462177253ea0",
                                "text": "Bei der Entrümpelung kamen 10 Kubikmeter Müll zusammen, die wir nun entsorgen müssen."
                            },
                            {
                                "example_id": "35ccc1a0-8212-47a9-bff0-a47890604830",
                                "sense_id": "c154969c-6e2b-38f2-99e5-462177253ea0",
                                "text": "„2000 Kubikmeter Rhein pro Sekunde fließen an Köln vorbei; bei Niedrigwasser um die 700, bei dem Hochwasser von 1995 wurden gar 11000 gemessen.“"
                            },
                            {
                                "example_id": "4484ce6d-2306-4ae4-a185-2c67673ec51d",
                                "sense_id": "c154969c-6e2b-38f2-99e5-462177253ea0",
                                "text": "„Eine gute Nachricht gibt es für alle Städte, die nur noch knapp über dem Schadstoffgrenzwert von 40 Mikrogramm Stickoxide pro Kubikmeter Luft liegen.“"
                            },
                            {
                                "example_id": "9d4b420d-8a94-471b-a71d-05a0fd59f224",
                                "sense_id": "c154969c-6e2b-38f2-99e5-462177253ea0",
                                "text": "„Schutt war das Einzige, was es mehr als reichlich gab in der Trümmerwelt, die der Krieg hinterlassen hatte: rund 400 Millionen Kubikmeter.“"
                            },
                            {
                                "example_id": "26ce2702-8b86-4168-bb58-05cab421ce92",
                                "sense_id": "c154969c-6e2b-38f2-99e5-462177253ea0",
                                "text": "„90000 Kubikmeter Erdreich und Gestein füllten Zwischenräume, 100000 Kubikmeter mussten zusätzlich herangekarrt werden, um eine Rampe hinter der Mauer aufzuschütten, die das Bauwerk stabilisierte.“"
                            },
                            {
                                "example_id": "0784942e-b4ab-480c-a5e7-9e9acca62fc9",
                                "sense_id": "c154969c-6e2b-38f2-99e5-462177253ea0",
                                "text": "[Deutschland:] „2023 wurden gut 73 Millionen Kubikmeter Holz geerntet. Davon wurden knapp 50 Millionen Kubikmeter stofflich genutzt (Bauholz, Papierindustrie, Chemieindustrie, Möbel), der Rest energetisch.“"
                            },
                            {
                                "example_id": "9a28296b-6024-4546-9ee7-a144b541f00b",
                                "sense_id": "c154969c-6e2b-38f2-99e5-462177253ea0",
                                "text": "„[…] Deutschland hatte […] im Jahr 2023 einen Jahresverbrauch von rund 76 Milliarden Kubikmeter Erdgas.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
