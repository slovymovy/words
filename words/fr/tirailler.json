{
    "word_family": [
        "tiraillement",
        "tirailleur"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d1afeb5d-5070-307f-b431-b61d3b8c90e6",
                    "sense_definition": "Tourmenter quelqu'un en le faisant hésiter entre deux choix, partis ou sentiments opposés.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "hesitation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il est constamment <w>tiraillé</w> entre ses ambitions professionnelles et sa vie de famille."
                        },
                        {
                            "text": "Ce choix cornélien a fini par <w>tirailler</w> la jeune femme pendant plusieurs semaines."
                        }
                    ],
                    "synonyms": [
                        "déchirer",
                        "partager"
                    ],
                    "common_phrases": [
                        "être tiraillé entre"
                    ]
                },
                {
                    "sense_id": "288b00cf-9a8f-318f-b0a1-3fee3b793e69",
                    "sense_definition": "Tirer sur quelque chose ou quelqu'un à plusieurs reprises ou par petits coups répétés.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "tirer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le petit garçon ne cesse de <w>tirailler</w> la manche de son père pour attirer son attention."
                        },
                        {
                            "text": "Quand elle est stressée, elle a la manie de <w>tirailler</w> nerveusement une mèche de cheveux."
                        }
                    ],
                    "synonyms": [
                        "secouer"
                    ],
                    "common_phrases": [
                        "tirailler la manche"
                    ]
                },
                {
                    "sense_id": "d003d624-bf3a-351a-80be-5d08277b54b9",
                    "sense_definition": "Importuner quelqu'un de façon répétée en le sollicitant ou le harcelant continuellement.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "importuner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Des journalistes insistants sont venus le <w>tirailler</w> dès sa sortie de la réunion."
                        },
                        {
                            "text": "Ses créanciers n'ont pas tardé à le <w>tirailler</w> de tous les côtés."
                        }
                    ],
                    "synonyms": [
                        "harceler",
                        "importuner"
                    ]
                },
                {
                    "sense_id": "3eb31eab-1c40-3a0e-9490-6ebc8c9fb93c",
                    "sense_definition": "Tirer avec une arme à feu à diverses reprises, de façon irrégulière ou désordonnée.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "tir_arme",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "On entendait les soldats <w>tirailler</w> au loin sans ordre précis."
                        },
                        {
                            "text": "Les avant-postes ont commencé à <w>tirailler</w> dès que la nuit est tombée."
                        }
                    ]
                }
            ]
        }
    ]
}