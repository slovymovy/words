                "senses": [
                    {
                        "sense_id": "84aa34d8-ff40-3c18-a81a-521b44dcf96d",
                        "entry_id": "a5e201c8-14be-3b05-851e-e7ca1b9c21e4",
                        "glosses": [
                            "Dienststelle der Polizei"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "933d85c6-1a1d-4ffb-b38b-91b4136c1f06",
                                "sense_id": "84aa34d8-ff40-3c18-a81a-521b44dcf96d",
                                "text": "„Allerdings gelang es ihm, auf dem Gemeindebüro und dem Polizeirevier ein paar Informationen über seine norwegische Herkunft zu bekommen.“"
                            },
                            {
                                "example_id": "ad01012f-188b-43dd-83e8-04afada39f1e",
                                "sense_id": "84aa34d8-ff40-3c18-a81a-521b44dcf96d",
                                "text": "„Sie entschieden, ihn beim nächstgelegenen Polizeirevier abzugeben.“"
                            },
                            {
                                "example_id": "98fd1bda-19bc-4f4d-a784-9bf9eec81d30",
                                "sense_id": "84aa34d8-ff40-3c18-a81a-521b44dcf96d",
                                "text": "„Vom Fenster aus sah man direkt auf das Polizeirevier 220.“"
                            },
                            {
                                "example_id": "fe1e2e5c-b8ac-409a-9696-c8d84ddd4120",
                                "sense_id": "84aa34d8-ff40-3c18-a81a-521b44dcf96d",
                                "text": "„Der zuständige Beamte im Polizeirevier hatte schweigend dem Gendarmen und dem Polizisten , der das Protokoll aufnahm, zugehört.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "a99a865d-9df4-3412-a6ce-8a2cffd87558",
                        "entry_id": "a5e201c8-14be-3b05-851e-e7ca1b9c21e4",
                        "glosses": [
                            "Zuständigkeitsbereich von [1]"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7740c45e-7a3a-419c-8f8f-b421b2a16121",
                                "sense_id": "a99a865d-9df4-3412-a6ce-8a2cffd87558",
                                "text": "Der Unfall ereignete sich nicht in unserem Polizeirevier."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "eea7bb5e-2485-446c-9d37-17a3112a4a9d",
                        "source_entry_id": "a5e201c8-14be-3b05-851e-e7ca1b9c21e4",
                        "source_sense_id": "84aa34d8-ff40-3c18-a81a-521b44dcf96d",
                        "source_sense_description": "Dienststelle der Polizei",
                        "target_lang_word": "police station",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "police station",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fa8a0fc2-7ec8-32f3-8857-bdc078e302f2",
                                        "entry_id": "11cb6928-dd57-3fcc-8a58-3071692449d2",
                                        "glosses": [
                                            "A building serving as the headquarters of a branch of the police force, and sometimes as a temporary place of confinement for offenders."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e86f4f2-9ec9-4b6e-a57b-80f1dd9e657c",
                                                "sense_id": "fa8a0fc2-7ec8-32f3-8857-bdc078e302f2",
                                                "text": "When the ballots were opened on 19 November, Hsu Hsin-liang’s supporters at a polling station in Chungli City suspected fraud. As the crowd swelled to approximately a thousand, rioting erupted. One protester was killed and the Chungli police station was burned."
                                            },
                                            {
                                                "example_id": "eddfb0b7-c85e-4ece-9e99-11c327fc2a01",
                                                "sense_id": "fa8a0fc2-7ec8-32f3-8857-bdc078e302f2",
                                                "text": "In trying to stop him from exploiting more children, I was ensuring my parents and my siblings would be ostracised. She begged me not to go to the police station."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5b12ee12-b3f6-4eff-9390-c39bc6decd87",
                        "source_entry_id": "a5e201c8-14be-3b05-851e-e7ca1b9c21e4",
                        "source_sense_id": "84aa34d8-ff40-3c18-a81a-521b44dcf96d",
                        "source_sense_description": "Dienststelle der Polizei",
                        "target_lang_word": "precinct",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "precinct",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "07310e7d-5ec3-388b-a691-94f120309119",
                                        "entry_id": "a6236e22-6906-31ea-8f07-5dbc3d7f8162",
                                        "glosses": [
                                            "An enclosed space having defined limits, normally marked by walls."
                                        ],
                                        "tags": [
                                            "in-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "16fcc231-0f19-4c58-9437-f4760725d342",
                                                "sense_id": "07310e7d-5ec3-388b-a691-94f120309119",
                                                "text": "For, by the fundamental Laws of the Realm, it is Capital in any Perſon, of what Quality ſoever, to make water within the Precincts of the Palace."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d1c221e-f67d-37bb-bf1c-c02e6d0d55dd",
                                        "entry_id": "a6236e22-6906-31ea-8f07-5dbc3d7f8162",
                                        "glosses": [
                                            "The general area surrounding a place, environs."
                                        ],
                                        "tags": [
