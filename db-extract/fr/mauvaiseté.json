            {
                "entry_id": "d79eb3b0-af85-3307-b92a-8bb9e3abf356",
                "word": "mauvaiseté",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "a007076a-108b-463d-9770-5c4520cdd877",
                        "entry_id": "d79eb3b0-af85-3307-b92a-8bb9e3abf356",
                        "tags": [
                            "plural"
                        ],
                        "form": "mauvaisetés"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d5b1218d-761e-3da3-a984-32b8de732d11",
                        "entry_id": "d79eb3b0-af85-3307-b92a-8bb9e3abf356",
                        "glosses": [
                            "Caractère mauvais d’une chose ou d’une personne."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "fb5ece25-1a95-44d0-b4ea-0969231ff356",
                                "sense_id": "d5b1218d-761e-3da3-a984-32b8de732d11",
                                "text": "Cette mauvaiseté d’enfant chagrina beaucoup Landry."
                            },
                            {
                                "example_id": "17cd1a0a-af94-4dc2-99ef-5b94d56f5c63",
                                "sense_id": "d5b1218d-761e-3da3-a984-32b8de732d11",
                                "text": "Je meurs, je me décompose dans la platitude, dans la mauvaiseté, dans la grisaille."
                            },
                            {
                                "example_id": "f2106b32-90b1-4abe-83a2-59c5aa91863d",
                                "sense_id": "d5b1218d-761e-3da3-a984-32b8de732d11",
                                "text": "Des fois que ça serait des menteries, comme y en a qui disent toujours, par mauvaiseté de langue."
                            },
                            {
                                "example_id": "46630195-87d8-4e10-9320-7bce8118b3b3",
                                "sense_id": "d5b1218d-761e-3da3-a984-32b8de732d11",
                                "text": "Si l’imagerie admirative de Signe de piste rejoint pourtant sur un point celle de Tintin, c’est dans la laideur, la bêtise et la mauvaiseté des adultes."
                            },
                            {
                                "example_id": "9efa141b-a4e8-4dfc-87b5-993c51b55419",
                                "sense_id": "d5b1218d-761e-3da3-a984-32b8de732d11",
                                "text": "Un héritage sur les photos qui, par-delà les dissemblances individuelles, l’écart entre la bonté des uns et la mauvaiseté des autres, unissait les membres de la famille, les habitants du quartier et tous ceux dont il était dit ce sont des gens comme nous."
                            },
                            {
                                "example_id": "001e0f29-3a89-449f-bef3-20b215b70242",
                                "sense_id": "d5b1218d-761e-3da3-a984-32b8de732d11",
                                "text": "La classe s’est levée. Par mauvaiseté, je reste assise, de sorte que Dutertre, quand il se retourne vers nous, me remarque tout de suite."
                            }
                        ]
                    },
                    {
                        "sense_id": "dbb8e5d0-3d89-3694-a9cc-88c0003e0778",
                        "entry_id": "d79eb3b0-af85-3307-b92a-8bb9e3abf356",
                        "glosses": [
                            "Acte ou parole ayant pour but de nuire, de blesser. → voir méchanceté"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "440117fd-365f-44fc-bf5a-d4fa2a55cad0",
                                "sense_id": "dbb8e5d0-3d89-3694-a9cc-88c0003e0778",
                                "text": "Pauvre ange, Macumer et moi nous t’avons pardonné tes mauvaisetés en apprenant combien tu as été tourmentée."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9d1dcb2a-73da-4279-87cb-fabd3ed3dccc",
                        "source_entry_id": "d79eb3b0-af85-3307-b92a-8bb9e3abf356",
                        "target_lang_word": "Schlechtigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schlechtigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2ad97c51-dd05-37cc-986d-867ea5ad3f34",
                                        "entry_id": "a7bf7f56-91c0-3f8e-9653-08cd55243548",
                                        "glosses": [
                                            "Denkweise, Eigenschaft, Handlung, die Schlechtes/Übles beinhaltet, realisiert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e6b96c7-6394-4e28-965b-c71383ff04bf",
                                                "sense_id": "2ad97c51-dd05-37cc-986d-867ea5ad3f34",
                                                "text": "„Dennoch habe die Schlechtigkeit dieser Mönchen derart zugenommen, dass sie alle über das Klostervermögen völlig eigenmächtig verfügt hätten und das Kloster infolgedessen fast zur Einöde geworden sei.“"
                                            },
                                            {
                                                "example_id": "510eba3d-3e89-40b2-b00e-060a4edb5cc9",
                                                "sense_id": "2ad97c51-dd05-37cc-986d-867ea5ad3f34",
                                                "text": "„In seinen Augen gab es kein Arbeitsgebiet, das nicht mit Schlechtigkeit und Trug durchsetzt war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
