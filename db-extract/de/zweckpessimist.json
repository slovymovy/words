                "senses": [
                    {
                        "sense_id": "cca9dafe-01a2-33d0-9e85-b284f66d0ad7",
                        "entry_id": "b6b10489-e23e-38e5-af1a-585a68233372",
                        "glosses": [
                            "Person, die Pessimismus demonstrativ zur Schau trägt, um eine bestimmte Wirkung zu erzielen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "de4b5db4-d346-44fe-b49a-b296f1d09603",
                                "sense_id": "cca9dafe-01a2-33d0-9e85-b284f66d0ad7",
                                "text": "Du rechnest immer mit dem Schlimmsten und wunderst dich dann, dass es nicht eingetroffen ist – du bist ein Zweckpessimist."
                            },
                            {
                                "example_id": "4e30b4ac-43e8-457f-9da9-b364903fe3db",
                                "sense_id": "cca9dafe-01a2-33d0-9e85-b284f66d0ad7",
                                "text": "Wahrscheinlich werden die Brücken zwischen den Kulturen [..] schon deshalb viel leichter und wirksamer zu bewerkstelligen sein als mancher Zweckpessimist uns glauben machen will."
                            },
                            {
                                "example_id": "71be3851-b7f4-4c21-aa57-a7eed3fae24d",
                                "sense_id": "cca9dafe-01a2-33d0-9e85-b284f66d0ad7",
                                "text": "Was den Verlauf der Geschichte anbetrifft, so bin ich immer ein Zweckpessimist gewesen, wenn ausnahmsweise doch mal was gutgeht, kann ich mich hinterher doppelt freuen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
