                "senses": [
                    {
                        "sense_id": "25c54b7a-953e-3074-aad6-695da1cea466",
                        "entry_id": "aa4d439b-aae4-3e18-9e0a-9928333c778d",
                        "glosses": [
                            "Langue probablement indo-européenne qui était parlée dans la Sicile antique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "40565bc0-4a23-4fd6-98cb-b8ed5f2aeb53",
                                "sense_id": "25c54b7a-953e-3074-aad6-695da1cea466",
                                "text": "Mais plus personne ne croit ni à l’identité ethno-linguistique des Sicules et des Sicanes (pour ces derniers difficilement indoeuropéenne), ni à l’unité latino-sicule ni à des affinités du « sicule » (et encore moins de l’élyme) avec des langues italiques."
                            }
                        ]
                    }
