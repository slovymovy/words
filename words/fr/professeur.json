                },
                {
                    "sense_id": "742041bb-688e-316e-8ad0-cd51c3d62a20",
                    "sense_definition": "Titre universitaire le plus élevé permettant d'enseigner dans l'enseignement supérieur ou de diriger des recherches académiques.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "titre",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le <w>professeur</w> dirige une équipe de chercheurs renommés au sein du laboratoire."
                        },
                        {
                            "text": "Elle a enfin obtenu le titre officiel de <w>professeur</w> après des années de recherche."
