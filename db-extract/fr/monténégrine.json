                ],
                "translations": [
                    {
                        "translation_id": "6de9d38b-df5d-4e2b-8304-db00b5205d7f",
                        "source_entry_id": "0276d214-2f9d-34e5-af8b-4c0a65da2484",
                        "source_sense_id": "fcacef38-df48-31b2-bb02-9d7160a68d92",
                        "target_lang_word": "Montenegrinerin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Montenegrinerin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6950d291-f311-33e9-a3e9-bed569911649",
                                        "entry_id": "8e6407ea-c9bd-32fa-88df-f0f632c3c5f1",
                                        "glosses": [
                                            "eine Staatsbürgerin Montenegros"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a52bb2c1-72cb-4c24-9360-135c85d90e56",
                                                "sense_id": "6950d291-f311-33e9-a3e9-bed569911649",
                                                "text": "„Den Holocaust überlebte der 1935 als Sohn eines ungarischen Juden und einer Montenegrinerin geborene Jugoslawe Danilo Kiš nur, weil seine Eltem ihn taufen ließen, als er vier Jahre alt war.“"
                                            },
                                            {
                                                "example_id": "235de5fb-6704-42f0-a92d-d73faaed6c58",
                                                "sense_id": "6950d291-f311-33e9-a3e9-bed569911649",
                                                "text": "„Solange sich die MontenegrinerInnen [sic] nicht entscheiden, welche Richtung ihre Sprachpolitik im neu entstandenen unabhängigen Staat einschlagen wird, muss sich die Prosodie in einer Block-Position gefangen sehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0f1e2db7-57eb-3ed0-9e3d-19fbffb3985b",
                                        "entry_id": "8e6407ea-c9bd-32fa-88df-f0f632c3c5f1",
                                        "glosses": [
                                            "eine Angehörige des Volkes, das vom Balkan stammt und Montenegrinisch spricht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "837d7cc8-fcc7-456c-9b40-1476e1700f98",
                                                "sense_id": "0f1e2db7-57eb-3ed0-9e3d-19fbffb3985b",
                                                "text": "„Selbst heute noch können die meisten Montenegriner und Montenegrinerinnen darüber Auskunft geben, welchem Stamm und welcher Sippe sie angehören.“"
                                            },
                                            {
                                                "example_id": "d5b94a63-1174-4163-b5eb-0c14ca78692a",
                                                "sense_id": "0f1e2db7-57eb-3ed0-9e3d-19fbffb3985b",
                                                "text": "„Man sagte damals, ihre Mutter sei Montenegrinerin; somit schien sie auch der serbischen Seite als ›annehmbar‹.“"
                                            },
                                            {
                                                "example_id": "63beb2ea-69de-4b7d-9925-809693174b14",
                                                "sense_id": "0f1e2db7-57eb-3ed0-9e3d-19fbffb3985b",
                                                "text": "„Im sozialen Leben der Albaner interessiert die Betrachter wie bei den meisten anderen Balkanländern hauptsächlich die Rolle der Frau in der Familie. Es ergibt sich ein Bild, das dem der Montenegrinerin sehr ähnlich ist.“"
                                            },
                                            {
                                                "example_id": "d16fecc5-2133-4436-a33e-91ac705f57d2",
                                                "sense_id": "0f1e2db7-57eb-3ed0-9e3d-19fbffb3985b",
                                                "text": "„Sie sind halb Serbin, halb Montenegrinerin. Spielen diese unterschiedlichen Wurzeln in Ihrem Leben eine Rolle?“"
                                            },
                                            {
                                                "example_id": "df3b8f50-a883-454e-871e-bc8e91298154",
                                                "sense_id": "0f1e2db7-57eb-3ed0-9e3d-19fbffb3985b",
                                                "text": "„Und sie ist Ausdruck reservierter Nachbarschaftsbeziehungen, die von einer Montenegrinerin mit der Schweizer Mentalität in Verbindung gebracht wird.“"
                                            },
                                            {
                                                "example_id": "b9acd640-4d72-4d76-a9b0-dce49e9dc333",
                                                "sense_id": "0f1e2db7-57eb-3ed0-9e3d-19fbffb3985b",
                                                "text": "„Die vornehmen Dalmatiner und die Montenegrinerin für den Fall zu interessieren, daran dachte der Sohn nicht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
