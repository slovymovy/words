                "translations": [
                    {
                        "translation_id": "39841597-ca12-4ffa-83ce-87a711b45eb4",
                        "source_entry_id": "102a6df4-fead-3078-9553-68f5f7a59e7c",
                        "target_lang_word": "revanchistisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "783eeddb-1985-45f7-96bc-e8968eb8ff38",
                        "source_entry_id": "102a6df4-fead-3078-9553-68f5f7a59e7c",
                        "target_lang_word": "revanchist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "revanchist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9e864091-ec3c-3409-87c9-ab2043b8b70f",
                                        "entry_id": "51808c75-9328-3692-ba1a-e050ddfa9bff",
                                        "glosses": [
                                            "A revanchist person; occasionally, anyone seeking vengeance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc328b43-6dcf-4802-b909-23d424175efd",
                                                "sense_id": "9e864091-ec3c-3409-87c9-ab2043b8b70f",
                                                "text": "The next day, newspapers across the political spectrum will express varying degrees of outrage at the president's discourtesy, ignorance, and lack of style; one will accuse him of being a revanchist."
                                            },
                                            {
                                                "example_id": "9b9af6c5-0c92-4f11-b5c0-7b4137a67ebb",
                                                "sense_id": "9e864091-ec3c-3409-87c9-ab2043b8b70f",
                                                "text": "Mr. Murphy tracks shifts in Justice Scalia's approach and what differentiates it from those of other textual revanchists, whether Justice Clarence Thomas or the legal scholar Robert Bork."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "revanchist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4c425a6d-46ff-312d-a73f-17c830286a89",
                                        "entry_id": "bf59dd8a-6089-39d9-91c4-4c2f25fb856e",
                                        "glosses": [
                                            "Seeking revenge or otherwise advocating retaliation, especially against a nation which has previously defeated and humiliated the revanchist party in war. Originally referred to the French indignation over losing Alsace-Lorraine to Germany in the Franco-Prussian War."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cf3d6c65-d6cf-4ced-965b-398d7e46a070",
                                                "sense_id": "4c425a6d-46ff-312d-a73f-17c830286a89",
                                                "text": "No longer did young German tourists in France or Holland have to pretend that they were Swedes, and no longer did the governments of Eastern Europe blame all their problems on the “revanchist West Germans”."
                                            },
                                            {
                                                "example_id": "4ff5ba96-9035-4ed8-b4bc-b92aaa1583cb",
                                                "sense_id": "4c425a6d-46ff-312d-a73f-17c830286a89",
                                                "text": "What remains is an elegant brief history of the modern conservative movement, as unsparing in its critique of liberal hubris as of revanchist resentment."
                                            },
                                            {
                                                "example_id": "debd5d5b-6aba-4f36-a1d8-c1f8cb60cb02",
                                                "sense_id": "4c425a6d-46ff-312d-a73f-17c830286a89",
                                                "text": "Bannon, they proclaimed, was Trumpism in its distilled essence: revanchist, ahistorical, racially inflected, and consumed with an imaginary war on the media and America’s broader society."
                                            },
                                            {
                                                "example_id": "fb31b9bb-a50a-4652-a068-bf1dd2f6cc19",
                                                "sense_id": "4c425a6d-46ff-312d-a73f-17c830286a89",
                                                "text": "As execrable as the Supreme Court’s decisions have been, they are of a piece with the conservative rulings from lower court judges who see no issue with laundering a revanchist policy agenda through contorted rulings."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c91b9aff-4bf7-4320-91c2-7f5db563ff7a",
                        "source_entry_id": "102a6df4-fead-3078-9553-68f5f7a59e7c",
                        "target_lang_word": "реваншистский",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "реваншистский",
