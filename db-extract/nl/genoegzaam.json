                    {
                        "translation_id": "95851b69-a619-449e-9c9f-86d3fd80beef",
                        "source_entry_id": "68fbb4e4-57b3-319e-bb35-b289d898d544",
                        "source_sense_id": "7c317cb9-7da5-305e-9b2b-26d36878bc68",
                        "target_lang_word": "sufficient",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sufficient",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3eb6631e-e863-3cca-9c64-dc65bcae6186",
                                        "entry_id": "8d8f6a29-4ee7-3475-b1fe-97b20df04851",
                                        "glosses": [
                                            "An adequate quantity of; enough."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe1fd2ed-f7a7-4bb3-be19-8b452a3b56aa",
                                                "sense_id": "3eb6631e-e863-3cca-9c64-dc65bcae6186",
                                                "text": "We have sufficient supplies to last the winter."
                                            },
                                            {
                                                "example_id": "194935f7-80ab-4ac9-a779-667dcea9dec3",
                                                "sense_id": "3eb6631e-e863-3cca-9c64-dc65bcae6186",
                                                "text": "There is not sufficient access to the Internet in many small rural villages."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dbd7316e-a649-35ff-aa8d-b0bfc9a5e2f8",
                                        "entry_id": "8d8f6a29-4ee7-3475-b1fe-97b20df04851",
                                        "glosses": [
                                            "A quantity (of something) that is as large as is needed."
                                        ],
                                        "tags": [
                                            "as pronoun"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "23761ac8-988e-46cb-8d3b-07a7b9cd6fbd",
                                                "sense_id": "dbd7316e-a649-35ff-aa8d-b0bfc9a5e2f8",
                                                "text": "We don't need any more; we already have sufficient."
                                            },
                                            {
                                                "example_id": "b66b60bf-63fa-4861-95a4-a863029ad794",
                                                "sense_id": "dbd7316e-a649-35ff-aa8d-b0bfc9a5e2f8",
                                                "text": "Sufficient of us are against this idea that we should stop now."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sufficient",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "68c661c7-063d-33ec-8f8f-96fde262f455",
                                        "entry_id": "849f6456-c8bf-319a-b80d-098f6e6afb31",
                                        "glosses": [
                                            "Of a type or kind that suffices, that satisfies requirements or needs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46f9d784-2ce8-48ef-a3a8-3cd9cfca0b31",
                                                "sense_id": "68c661c7-063d-33ec-8f8f-96fde262f455",
                                                "text": "This is a necessary condition but not a sufficient one."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "219388f3-53d1-309d-9760-3658e2211943",
                                        "entry_id": "849f6456-c8bf-319a-b80d-098f6e6afb31",
                                        "glosses": [
                                            "Possessing adequate talents or accomplishments; of competent power or ability; qualified; fit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "198c6149-717b-474f-b6d1-56ea22e2b301",
                                                "sense_id": "219388f3-53d1-309d-9760-3658e2211943",
                                                "text": "They felt sufficient to maintain their present prosperity and independence."
                                            },
                                            {
                                                "example_id": "525b7747-805a-4cce-bdec-3902d35233ab",
                                                "sense_id": "219388f3-53d1-309d-9760-3658e2211943",
                                                "text": "I have never yet felt adequate. I have never yet felt sufficient."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "991d9d0e-7dda-39ea-8037-4ce13e51dae8",
                                        "entry_id": "849f6456-c8bf-319a-b80d-098f6e6afb31",
                                        "glosses": [
                                            "Capable of meeting obligations; responsible."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e4adc6e3-b5aa-47f1-83f5-f13be4423d66",
                                                "sense_id": "991d9d0e-7dda-39ea-8037-4ce13e51dae8",
                                                "text": "...to take the best ways we can, to make it known to the Duke of York; for, till Sir J. Minnes be removed, and a sufficient man brought into W. Pen's place, when he is gone, it is impossible for this Office ever to support itself."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "472a4bd4-3bcb-3bd4-8795-b5b04e6cd462",
                                        "entry_id": "849f6456-c8bf-319a-b80d-098f6e6afb31",
                                        "glosses": [
                                            "Having enough money to meet obligations and live comfortably."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8babf62a-2c63-428f-b7c5-aad4d50c769b",
                                                "sense_id": "472a4bd4-3bcb-3bd4-8795-b5b04e6cd462",
                                                "text": "I shall in this place only mention that qualification by wealth; the rather, being applyed to the deputies of towns and citties, where they use to say of a rich man, he is a very sufficient man : and the other sufficiencies and qualifications are mentioned on other occasions."
                                            },
                                            {
                                                "example_id": "771e6d4c-96f4-4e69-8813-72ddd585040f",
                                                "sense_id": "472a4bd4-3bcb-3bd4-8795-b5b04e6cd462",
                                                "text": "Some persons have been called, who have proved (it is true) that he was insufficient at that time, and could not pay more than 3 or 4,000l.; but the same witnesses give an account, that his ill circumstances were then known but to four or five persons of his acquaintance, and that by all other people, who had any knowledge of him at that time, he was looked upon to be very sufficient ; he had left off his business upon having raised an estate; he was of good reputation: he lived at Hackne in a house making a good appearance, with good furniture, and a great quantity of plate, till the last, till the time of his being put in prison, which was not till last year, that he surrendered himself in discharge of his bail."
                                            },
                                            {
                                                "example_id": "dbbd5b80-0a49-4649-8f86-cd6e12fcba58",
                                                "sense_id": "472a4bd4-3bcb-3bd4-8795-b5b04e6cd462",
                                                "text": "The second in the Hong, Mowgua, has been a man of large property, but he is of more questionable property now ; I consider him still to be a very sufficient merchant."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "065e829c-eca7-4866-9d73-a5ebaddf6bfa",
                        "source_entry_id": "68fbb4e4-57b3-319e-bb35-b289d898d544",
                        "source_sense_id": "7c317cb9-7da5-305e-9b2b-26d36878bc68",
                        "target_lang_word": "suffisant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "suffisant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "726c272e-b9a2-3ccb-a591-e7f9ce2508b1",
                                        "entry_id": "48e6050f-fd4f-3738-bd16-b5cf826570fb",
                                        "glosses": [
                                            "Qui suffit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81f29bff-b575-4741-aebb-5cdc152b616e",
                                                "sense_id": "726c272e-b9a2-3ccb-a591-e7f9ce2508b1",
                                                "text": "Comme le tarif était peu élevé (1 fr. 25 par verso ou par 72 mots ), les solicitors allongèrent leurs actes en y insérant des clauses redondantes, afin de rendre suffisant le montant de leurs honoraires."
                                            },
                                            {
                                                "example_id": "f17f48b0-4e89-4176-b665-e1ba4bd13683",
                                                "sense_id": "726c272e-b9a2-3ccb-a591-e7f9ce2508b1",
                                                "text": "Ayant une suffisante connaissance des taudis de Marseille, je m’imaginais que leur misère n’était guère dépassable."
                                            },
                                            {
                                                "example_id": "69454779-673f-4690-8de4-b11106c4114b",
                                                "sense_id": "726c272e-b9a2-3ccb-a591-e7f9ce2508b1",
                                                "text": "Il a marqué les esprits durant son deuxième passage au pouvoir, beaucoup plus long (2012-2020) avec sa politique économique audacieuse surnommée les « Abenomics », combinant des relances budgétaires massives avec une politique monétaire ultra-accommodante, une stratégie qui perdure encore au Japon, malgré des résultats inégaux faute de réformes structurelles suffisantes."
                                            },
                                            {
                                                "example_id": "fb577974-bc48-4706-ab46-7b130f1c2b82",
                                                "sense_id": "726c272e-b9a2-3ccb-a591-e7f9ce2508b1",
                                                "text": "Cette grange est suffisante pour contenir tant de milliers de gerbes. — Bonne et suffisante caution. — Il ne faut point faire de changements dans une loi sans une raison suffisante."
                                            },
                                            {
                                                "example_id": "2fd6efbf-26a2-4751-8c95-b319a2e15dac",
                                                "sense_id": "726c272e-b9a2-3ccb-a591-e7f9ce2508b1",
                                                "text": "Condition suffisante : Condition qui garantit la véracité de sa conséquence. → voir nécessaire"
                                            },
                                            {
                                                "example_id": "1117999e-67a6-48f9-9a8d-7ad26f49d38d",
                                                "sense_id": "726c272e-b9a2-3ccb-a591-e7f9ce2508b1",
                                                "text": "Principe de raison suffisante : Principe suivant lequel tout phénomène doit avoir une cause. — La baïonnette fut aussi la raison suffisante de la mort de quelques milliers d'hommes."
                                            },
                                            {
                                                "example_id": "9cd2b94d-ac79-468b-b29d-d7087209500d",
                                                "sense_id": "726c272e-b9a2-3ccb-a591-e7f9ce2508b1",
                                                "text": "Grâce suffisante : Grâce qui suffit strictement à l’être humain, s’il y répond."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2b5ebed5-51c0-3961-91c2-3bb17b7a7424",
                                        "entry_id": "48e6050f-fd4f-3738-bd16-b5cf826570fb",
                                        "glosses": [
                                            "Qui est vain, fat, présomptueux, satisfait de sa personne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3bfb2c33-77be-4ea2-be23-6244221a1e8b",
                                                "sense_id": "2b5ebed5-51c0-3961-91c2-3bb17b7a7424",
                                                "text": "Suffisant comme un paon, Eugène Duthoit va vers ces dames, qui le reçoivent en défaillant."
                                            },
                                            {
                                                "example_id": "bca655fd-644f-4321-8069-b048e6c0814a",
                                                "sense_id": "2b5ebed5-51c0-3961-91c2-3bb17b7a7424",
                                                "text": "Ça me dépasse de voir François Legault confier à un ex-homme d'affaires aussi suffisant que Pierre Fitzgibbon autant de responsabilité ministérielles."
                                            },
                                            {
                                                "example_id": "4507d04f-e4c7-413e-b86a-566457f837d2",
                                                "sense_id": "2b5ebed5-51c0-3961-91c2-3bb17b7a7424",
                                                "text": "Je vous trouve bien suffisant, bien suffisante."
                                            },
                                            {
                                                "example_id": "e5ba73e3-7cb6-4cae-9dd0-a35e4d95b761",
                                                "sense_id": "2b5ebed5-51c0-3961-91c2-3bb17b7a7424",
                                                "text": "Cet homme est vaniteux et suffisant."
                                            },
                                            {
                                                "example_id": "41d0e91b-2c74-4f40-becb-8aa5c94e8b60",
                                                "sense_id": "2b5ebed5-51c0-3961-91c2-3bb17b7a7424",
                                                "text": "Le suffisant personnage ! Se dit aussi en parlant des choses."
                                            },
                                            {
                                                "example_id": "44695f76-6286-48d0-a17f-89c8d31ad72b",
                                                "sense_id": "2b5ebed5-51c0-3961-91c2-3bb17b7a7424",
                                                "text": "Il a l’air suffisant."
                                            },
                                            {
                                                "example_id": "b750cdfb-1b93-49a8-9750-97341010913e",
                                                "sense_id": "2b5ebed5-51c0-3961-91c2-3bb17b7a7424",
                                                "text": "Une mine suffisante."
                                            },
                                            {
                                                "example_id": "a37ecb42-f19b-4ed7-9456-7c1f11b7a88b",
                                                "sense_id": "2b5ebed5-51c0-3961-91c2-3bb17b7a7424",
                                                "text": "Un ton suffisant."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
