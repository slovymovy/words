                                        "entry_id": "3344b0d5-0e55-376c-bb96-bf5eb67987f9",
                                        "glosses": [
                                            "A country in Southern Africa. Official name: Republic of Zimbabwe. Formerly called Southern Rhodesia or Rhodesia."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d2e73a9-54ca-445d-ac2f-5da416e3e407",
                                                "sense_id": "d3771b94-dd30-36b1-8d56-8a110a8ce82c",
                                                "text": "According to Ncube, the MDC believed, from 2000, that Britain's interest in Zimbabwe had more to do with concern for white farmers than black Zimbabweans."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "80071a57-0ded-49b5-9191-15e2694f9cff",
                        "source_entry_id": "8975ae4d-e534-3d2b-ae97-076a29d34228",
