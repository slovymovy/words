            "pos": "verb",
            "senses": [
                {
                    "sense_id": "bd8f0abb-da1e-370e-9ee5-99a2268716be",
                    "sense_definition": "Administrer, organiser ou diriger une entreprise, des affaires ou des ressources.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "administration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle <w>gère</w> son budget avec beaucoup d'attention chaque mois pour faire des économies."
                        },
                        {
                            "text": "Le nouveau directeur <w>gère</w> une entreprise de plus de cinquante salariés depuis trois ans."
                        }
                    ],
                    "synonyms": [
                        "administrer",
                        "diriger",
                        "manager"
                    ],
                    "common_phrases": [
                        "gérer une entreprise",
                        "gérer son budget"
                    ]
                },
                {
                    "sense_id": "300574bc-37ff-30e4-b2bf-522dd80d4f1a",
                    "sense_definition": "Faire face à une situation difficile, un problème ou un imprévu, et chercher à le maîtriser.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "resolution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Notre équipe a su <w>gérer</w> la crise avec un calme remarquable face aux imprévus."
                        },
                        {
                            "text": "Il fait des exercices de respiration pour mieux <w>gérer</w> le stress avant ses examens."
                        }
                    ],
                    "synonyms": [
                        "résoudre",
                        "solutionner"
                    ],
                    "common_phrases": [
                        "gérer la crise",
                        "gérer le stress"
                    ]
                },
                {
                    "sense_id": "b7bcba76-cb5f-39bb-9a36-77202f796184",
                    "sense_definition": "Se débrouiller, maîtriser la situation ou s'en sortir par ses propres moyens.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "debrouille",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ne t'inquiète pas pour les préparatifs du dîner, je <w>gère</w> tout parfaitement."
                        },
                        {
                            "text": "Sa mère s'inquiétait pour son déménagement, mais il lui a assuré qu'il <w>gérait</w>."
                        }
                    ],
                    "synonyms": [
                        "se débrouiller",
                        "s'en sortir",
                        "y arriver"
                    ],
                    "common_phrases": [
                        "gérer la situation"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "registre familier"
                        }
                    ]
                },
                {
                    "sense_id": "6b71e745-c838-36af-85de-f5c5cf19f09f",
                    "sense_definition": "Être particulièrement doué dans un domaine ou accomplir une action avec un grand succès.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "talent",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ton frère <w>gère</w> vraiment bien à la guitare, il a impressionné tout le public hier soir."
                        },
                        {
                            "text": "Tu as obtenu la note maximale au contrôle difficile de mathématiques, tu <w>gères</w> !"
                        }
                    ],
                    "synonyms": [
                        "assurer",
                        "déchirer"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "langage familier et jeune"
                        }
                    ]
                },
                {
                    "sense_id": "46c65736-899a-3a51-aa9e-41ccd41d368d",
                    "sense_definition": "Administrer des biens ou des intérêts pour le compte d'une autre personne.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "administration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce notaire expérimenté <w>gère</w> la succession de la famille depuis le décès des propriétaires."
                        },
                        {
                            "text": "Le tuteur légal a pour mission principale de <w>gérer</w> les biens de l'enfant mineur."
                        }
                    ],
                    "synonyms": [
                        "administrer",
                        "régenter"
                    ],
                    "common_phrases": [
                        "gérer les biens",
                        "gérer une tutelle"
                    ]
                }
            ]
        }
    ]
