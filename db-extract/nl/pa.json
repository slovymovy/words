                "senses": [
                    {
                        "sense_id": "5a6384fc-b560-371b-8d94-090997988e67",
                        "entry_id": "589c6338-5622-3945-b533-1a493f7a773d",
                        "glosses": [
                            "papa, vader"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "548c6513-7fbc-4bda-afd4-289636137bd5",
                                "sense_id": "5a6384fc-b560-371b-8d94-090997988e67",
                                "text": "Mijn pa komt morgen op bezoek bij mij."
                            },
                            {
                                "example_id": "6418946e-f14f-4a73-a517-91cc86322363",
                                "sense_id": "5a6384fc-b560-371b-8d94-090997988e67",
                                "text": "De inzet was een nieuw pornoblaadje dat Emil een dag eerder tussen het oud papier van zijn vader had gevonden en dat hij nog had kunnen redden van de open haard, toen zijn pa even naar het toilet was."
                            },
                            {
                                "example_id": "1dce527f-a933-4cbd-81d7-a857e20952d3",
                                "sense_id": "5a6384fc-b560-371b-8d94-090997988e67",
                                "text": "Mijn pa die elke dag doodmoe thuiskwam van zijn werk als vrachtwagenchauffeur en onmiddellijk in de skaileren leunstoel in slaap kukelde, pijpje bier nog in zijn hand."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a0160423-e30f-425d-b432-5c9d80c01b87",
                        "source_entry_id": "589c6338-5622-3945-b533-1a493f7a773d",
                        "source_sense_id": "5a6384fc-b560-371b-8d94-090997988e67",
                        "source_sense_description": "vader",
                        "target_lang_word": "Papa",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Papa",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ede62bd5-7374-38a6-a016-25e186691a96",
                                        "entry_id": "f48fc359-ce68-35b3-a560-53dd3ef8fcda",
                                        "glosses": [
                                            "Kosewort zu Vater (als Anrede nur für den eigenen Vater)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "39527a6d-9106-41ea-bf2d-2c291ca01410",
                                                "sense_id": "ede62bd5-7374-38a6-a016-25e186691a96",
                                                "text": "Mein Papa hat immer recht."
                                            },
                                            {
                                                "example_id": "27a73e47-6cfc-491f-82ca-e6fc89cb41d5",
                                                "sense_id": "ede62bd5-7374-38a6-a016-25e186691a96",
                                                "text": "„Er schaute Papa an, als müsste er erst lange begreifen, was Papa gerade gesagt hatte.“"
                                            },
                                            {
                                                "example_id": "3b6cb0e9-f092-4a32-86c8-688148fe6c2f",
                                                "sense_id": "ede62bd5-7374-38a6-a016-25e186691a96",
                                                "text": "„Mir Fünfjährigem war erzählt worden, ich dürfe eine lange Zugfahrt mit meinem Vater unternehmen, und was sollte sich ein Junge mehr wünschen, als endlich einmal mit seinem Papa, den er so selten sah, zu verreisen?“"
                                            },
                                            {
                                                "example_id": "c8169659-7f08-4bae-b392-484c7783dfc2",
                                                "sense_id": "ede62bd5-7374-38a6-a016-25e186691a96",
                                                "text": "„Papa wäre damals bei den Nazis auch mal fast dran gewesen.“"
                                            },
                                            {
                                                "example_id": "f9bb781a-ca26-4528-ac9b-7062886f7306",
                                                "sense_id": "ede62bd5-7374-38a6-a016-25e186691a96",
                                                "text": "„Kaum daß die Mama und der Papa vom Campingurlaub aus Südfrankreich zurück sind, freuen sie sich schon auf ihren nächsten Campingurlaub in Südfrankreich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Papa",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6ba1adae-59c5-3a2b-bb6b-2e9251e2bea4",
                                        "entry_id": "be12d3a2-7cb2-3ce8-af40-6e582f65dbd9",
                                        "glosses": [
                                            "der Papst"
                                        ],
                                        "tags": [
                                            "katholische Kirche"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bc5da35f-be3c-4eae-afc9-b0b9a35f15aa",
                                                "sense_id": "6ba1adae-59c5-3a2b-bb6b-2e9251e2bea4",
                                                "text": "Schon in der frühen Kirche wurden Bischöfe und vor allem Äbte mit Papa angeredet. In den Anfängen der Kirche war dies der Titel für alle Patriarchen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a4033e3a-01d5-30e2-a4ba-3036c49622b7",
                                        "entry_id": "be12d3a2-7cb2-3ce8-af40-6e582f65dbd9",
                                        "glosses": [
                                            "höherer Geistlicher"
                                        ],
                                        "tags": [
                                            "orthodoxe Kirche"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f3998558-5cf3-470a-862c-003999b48454",
                                                "sense_id": "a4033e3a-01d5-30e2-a4ba-3036c49622b7",
                                                "text": "Papa gilt seit dem 3. Jahrhundert als Anrede und Bezeichnung auch für höhere Geistliche der orthodoxen und orientalisch-orthodoxen Kirchen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Papa",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9b4cea02-eb4a-39d4-955e-ed56022efd45",
                                        "entry_id": "aec8c65c-bd7c-3264-afa8-7d24e1cd1fd5",
                                        "glosses": [
                                            "eine polynesische Gottheit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f418e777-5516-4be6-9b2c-0677307aaa17",
                                                "sense_id": "9b4cea02-eb4a-39d4-955e-ed56022efd45",
                                                "text": "Wakea und Papa stehen für Himmel und Erde."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
