                "senses": [
                    {
                        "sense_id": "e46a836b-d589-3443-b592-ad2637c7bf39",
                        "entry_id": "4ccf7a54-3f7d-3c81-a29a-cb8c78ee910a",
                        "glosses": [
                            "gericht op het werkzamer worden"
