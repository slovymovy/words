                                                "sense_id": "bc16d1d1-5d28-3d9b-ba60-925e0859d143",
                                                "text": "—¡Idos de aquí! —le gritó— ¡Idos y dejadme en paz! ¡No quiero volver a veros jamás!"
                                            }
