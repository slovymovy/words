                                "target_senses": [
                                    {
                                        "sense_id": "4ebe13e6-ade7-348f-928d-363c82a56e62",
                                        "entry_id": "c65e3bcf-78e4-334f-8437-513b1cec955c",
                                        "glosses": [
                                            "An underground room or cavern (also used figuratively)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46b58742-ef5f-494a-9a32-8c4330ba290c",
                                                "sense_id": "4ebe13e6-ade7-348f-928d-363c82a56e62",
                                                "text": "Contour: the unique parameters of Karen’s body – beckoning vents of mouth and vulva, the soft hypogeum of the anus."
                                            },
                                            {
                                                "example_id": "9ba39846-df0b-483d-94d8-431e66e1f389",
                                                "sense_id": "4ebe13e6-ade7-348f-928d-363c82a56e62",
                                                "text": "There may in fact be a Punic graffiti, in the Roman alphabet, on a hypogeum in San Salvatore di Cabras dated to the era of the Constantinian imperial dynasty."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
