                "senses": [
                    {
                        "sense_id": "627d4215-3220-3e47-9b1b-54d9fd69542a",
                        "entry_id": "7baee533-bcde-38f3-a4b1-010097788d93",
                        "glosses": [
                            "Störung des Gehörsinns"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2d25090b-510b-432d-a9bf-b72f4f4a064d",
                                "sense_id": "627d4215-3220-3e47-9b1b-54d9fd69542a",
                                "text": "„Es sei nun weiterhin mit einigen Worten auf die Dysakusis, also Klangentstellung bei Schwerhörigkeit eingegangen.“"
                            },
                            {
                                "example_id": "7ebeb461-1ad3-4d59-baf9-99269c90b1bf",
                                "sense_id": "627d4215-3220-3e47-9b1b-54d9fd69542a",
                                "text": "„Häufig kommt zu einer Schwerhörigkeit (Hypakusis) auch eine Fehlhörigkeit (Dysakusis) hinzu. Die Betroffenen verstehen nicht mehr richtig oder sogar falsch, was ihr Gesprächspartner sagt. Wörter und Sätze kommen nur verzerrt an.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e0b31386-8ce1-3d6b-b8d7-0350682f089f",
                        "entry_id": "7baee533-bcde-38f3-a4b1-010097788d93",
                        "glosses": [
                            "Überempfindlichkeit gegenüber bestimmen Lauten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "519d14e9-d651-4c72-9998-a041f62a6b1d",
                                "sense_id": "e0b31386-8ce1-3d6b-b8d7-0350682f089f",
                                "text": "„Bei der Dysakusis besteht eine Überempfindlichkeit des Ohres.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
