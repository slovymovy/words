                    {
                        "translation_id": "7cc1e525-7930-44c5-b5e4-95e9a54eda9c",
                        "source_entry_id": "04990d57-fd11-38cf-a30e-837a31184614",
                        "source_sense_id": "f78732a7-c0f0-356d-9b7b-35172890af64",
