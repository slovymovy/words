                "senses": [
                    {
                        "sense_id": "85d14053-29c5-3e84-9b66-d5db3ed229d3",
                        "entry_id": "e5f4ffcf-a277-3251-b57a-d021c14d5b54",
                        "glosses": [
                            "aufgeben, verlassen"
                        ],
                        "tags": [
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "424126df-2c32-406b-9980-0d275ce6ccc9",
                                "sense_id": "85d14053-29c5-3e84-9b66-d5db3ed229d3",
                                "text": "He was forced to aband his kingdom.",
                                "translation": "Er war gezwungen, sein Königreich zu verlassen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ab91d7cd-041d-4bf8-93df-8da8696e5561",
                        "source_entry_id": "e5f4ffcf-a277-3251-b57a-d021c14d5b54",
                        "source_sense_id": "85d14053-29c5-3e84-9b66-d5db3ed229d3",
                        "source_sense_description": "aufgeben, verlassen",
                        "target_lang_word": "aufgeben",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aufgeben",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f2cea48d-3459-31d8-a5e9-b0207c3e635d",
                                        "entry_id": "3a6ab183-44f6-3cfe-a1ca-867dffb32c88",
                                        "glosses": [
                                            "etwas Sinnloses beenden, aufhören, einstellen; etwas beenden, obwohl der Sinn im Weitermachen besteht"
                                        ],
                                        "tags": [
                                            "auch intransitiv"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ddbbf4d9-8410-4f74-af65-6436ac533a12",
                                                "sense_id": "f2cea48d-3459-31d8-a5e9-b0207c3e635d",
                                                "text": "Der Läufer gab nach einem Sturz auf."
                                            },
                                            {
                                                "example_id": "8e1324eb-a2fb-4754-884b-8509e64f648c",
                                                "sense_id": "f2cea48d-3459-31d8-a5e9-b0207c3e635d",
                                                "text": "Verneinung: Obwohl sie seit drei Jahren verschwunden ist, haben Meiers ihre kleine Tochter noch nicht aufgegeben."
                                            },
                                            {
                                                "example_id": "d2339fa9-e25a-42c5-8a17-b7dfcdd52348",
                                                "sense_id": "f2cea48d-3459-31d8-a5e9-b0207c3e635d",
                                                "text": "„[…] die Brexit-Gegner werden nicht einfach aufgeben, nur weil es jetzt einen neuen Premierminister [B. Johnson] gibt.“"
                                            },
                                            {
                                                "example_id": "449fad34-cb48-4cd5-b986-f8ca0ec76a81",
                                                "sense_id": "f2cea48d-3459-31d8-a5e9-b0207c3e635d",
                                                "text": "Die Mannschaft gab das sinkende Schiff auf."
                                            },
                                            {
                                                "example_id": "ad867060-8588-4459-b8b4-160140595932",
                                                "sense_id": "f2cea48d-3459-31d8-a5e9-b0207c3e635d",
                                                "text": "Wegen mangelnder Aufträge musste ich meinen Betrieb aufgeben, nachdem die Bank meine Kreditlinie nicht weiter erhöhen wollte."
                                            },
                                            {
                                                "example_id": "c922114d-a226-4314-b0ad-ba7e02633367",
                                                "sense_id": "f2cea48d-3459-31d8-a5e9-b0207c3e635d",
                                                "text": "Diese Mühle wurde schon vor Jahren aufgegeben."
                                            },
                                            {
                                                "example_id": "613c8a01-96a7-4834-82a7-c077f3c65602",
                                                "sense_id": "f2cea48d-3459-31d8-a5e9-b0207c3e635d",
                                                "text": "„Sie war eine der wenigen, die noch nicht aufgegeben hatten. Sie würde nie aufgeben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d6983e6a-8222-3346-80ba-9632577baaa1",
                                        "entry_id": "3a6ab183-44f6-3cfe-a1ca-867dffb32c88",
                                        "glosses": [
                                            "jemandem (etwas) aufgeben: etwas zur Erledigung auftragen, zur Aufgabe machen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "886fa2d7-25ff-4336-8afd-67423aefdf61",
                                                "sense_id": "d6983e6a-8222-3346-80ba-9632577baaa1",
                                                "text": "Ich hatte Ihnen doch aufgegeben, den Rasen zu mähen!"
                                            },
                                            {
                                                "example_id": "4b1895b0-1c9c-41b9-863c-9e6ba3aecad1",
                                                "sense_id": "d6983e6a-8222-3346-80ba-9632577baaa1",
                                                "text": "Ab Morgen sind Ferien, deswegen gebe ich euch keine Hausaufgaben auf."
                                            },
                                            {
                                                "example_id": "fefa65c2-461a-4218-a536-fa5c74c5935c",
                                                "sense_id": "d6983e6a-8222-3346-80ba-9632577baaa1",
                                                "text": "Die Mathelehrerin gibt den Kindern viel zu viel auf."
                                            },
                                            {
                                                "example_id": "586a1834-8571-4de4-ac5d-4f7884c322b0",
                                                "sense_id": "d6983e6a-8222-3346-80ba-9632577baaa1",
                                                "text": "Ihr Verschwinden gab uns viele Rätsel auf."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "1cd6280d-d24a-3eab-97ef-a2329b344b16",
                                        "entry_id": "3a6ab183-44f6-3cfe-a1ca-867dffb32c88",
                                        "glosses": [
                                            "jemandem etwas zur Beförderung oder Bearbeitung übergeben"
                                        ],
                                        "tags": [
                                            "etwas bei jemandem aufgeben"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "29bda046-7634-476b-8820-12bd88fa8e88",
                                                "sense_id": "1cd6280d-d24a-3eab-97ef-a2329b344b16",
                                                "text": "Ich werde zur Zeitung gehen und ein Inserat aufgeben."
                                            },
                                            {
                                                "example_id": "124acc7f-7895-49f8-99e6-c5c657adcdfe",
                                                "sense_id": "1cd6280d-d24a-3eab-97ef-a2329b344b16",
                                                "text": "Bitte geben Sie diesen Brief noch bei der Post auf."
                                            },
                                            {
                                                "example_id": "c8f409c7-4dfb-4bf9-9ede-b5e289d4b6b5",
                                                "sense_id": "1cd6280d-d24a-3eab-97ef-a2329b344b16",
                                                "text": "Nachdem wir unsere Bestellungen aufgegeben hatten, konnten wir uns in Ruhe unterhalten."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "a8f7c929-cbdb-3bcd-a79e-4e759dcb929a",
                                        "entry_id": "3a6ab183-44f6-3cfe-a1ca-867dffb32c88",
                                        "glosses": [
                                            "keine Hoffnung mehr auf Genesung/Rettung von jemandem haben, jemanden als tot/verloren betrachten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "668fdedd-0607-4c06-81b5-24ae4bc9a7a8",
                                                "sense_id": "a8f7c929-cbdb-3bcd-a79e-4e759dcb929a",
                                                "text": "„Am Aschermittwoch erhielt ich in der Frühe einen Brief von C. C., daß der Arzt ihre Freundin aufgegeben hätte; diese könne höchstens noch etwa vierzehn Tage leben. “"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1d3867a5-7625-4d26-80bb-8abf9ace9c6c",
                        "source_entry_id": "e5f4ffcf-a277-3251-b57a-d021c14d5b54",
                        "source_sense_id": "85d14053-29c5-3e84-9b66-d5db3ed229d3",
                        "source_sense_description": "aufgeben, verlassen",
                        "target_lang_word": "verlassen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verlassen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2cee2c5e-180c-3559-a08d-249199965eb2",
                                        "entry_id": "4e4e6193-3063-3667-a56e-b7bd49e0d139",
                                        "glosses": [
                                            "weggehen, sich entfernen"
                                        ],
                                        "tags": [
                                            "einen Ort verlassen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f011bd9c-8b89-4fad-a49f-c48a624d47d8",
                                                "sense_id": "2cee2c5e-180c-3559-a08d-249199965eb2",
                                                "text": "Er verließ das Haus wie jeden Werktag um sieben Uhr."
                                            },
                                            {
                                                "example_id": "47744c5e-327c-4cef-9701-67c55d042217",
                                                "sense_id": "2cee2c5e-180c-3559-a08d-249199965eb2",
                                                "text": "„Junge Frauen verlassen Ostdeutschland in Scharen.“"
                                            },
                                            {
                                                "example_id": "bd473c98-3d52-411e-bb8a-4319c8c73448",
                                                "sense_id": "2cee2c5e-180c-3559-a08d-249199965eb2",
                                                "text": "„In Portugal ist eine unblutige Form des Stierspiels populär, bei der alle Kämpfer die Arena lebend verlassen.“"
                                            },
                                            {
                                                "example_id": "e84b28f0-b123-4991-a243-1b41df65e98e",
                                                "sense_id": "2cee2c5e-180c-3559-a08d-249199965eb2",
                                                "text": "„Roland hatte mir zugeflüstert, auf den Färöern wohnten jene, die die Wikingerschiffe wegen Seekrankheit verlassen mussten, als sie auf dem Weg nach Island waren.“"
                                            },
                                            {
                                                "example_id": "c0169ad5-7e7b-4bda-84ca-be67e7804098",
                                                "sense_id": "2cee2c5e-180c-3559-a08d-249199965eb2",
                                                "text": "„Im Juli 1943 wurde sie [Anm.: die jüdische Ärztin Lilli Jahn] gezwungen, mit ihren Kindern Immenhausen zu verlassen und in das von schweren Bombenangriffen heimgesuchte Kassel umzuziehen.“"
                                            },
                                            {
                                                "example_id": "e726e8fd-66b5-4b8e-a0c1-985ee6fbd3b3",
                                                "sense_id": "2cee2c5e-180c-3559-a08d-249199965eb2",
                                                "text": "[Coronapandemie in der Türkei:] „Bis auf Notfälle dürfen wir rund achtzehn Tage lang das Haus nicht mehr verlassen.“"
                                            },
                                            {
                                                "example_id": "c086b185-599c-4a24-84dc-59b7d251e27e",
                                                "sense_id": "2cee2c5e-180c-3559-a08d-249199965eb2",
                                                "text": "„Schließlich wird auch der wagemutigste und versierteste Kletterer zur Umkehr und Rückkehr in die Tiefe gezwungen, die er verlassen hat.“"
                                            },
                                            {
                                                "example_id": "1a543cf1-e4a6-4207-8dad-d904f6f7d886",
                                                "sense_id": "2cee2c5e-180c-3559-a08d-249199965eb2",
                                                "text": "[DDR:] „Zwischen 1945 und 1961 verließen fast drei Millionen Menschen das Land Richtung Westen.“"
                                            },
                                            {
                                                "example_id": "a9c5247f-568d-4d75-adc4-cde99c5056ba",
                                                "sense_id": "2cee2c5e-180c-3559-a08d-249199965eb2",
                                                "text": "„»Für mich ist mit dieser Bundestagswahl eine rote Linie überschritten, und mein Entschluss steht fest: Ich werde Deutschland verlassen.«“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "30475fd9-7c12-354d-a5b7-772d8769a5aa",
                                        "entry_id": "4e4e6193-3063-3667-a56e-b7bd49e0d139",
                                        "glosses": [
                                            "die Beziehung beenden; jemanden alleine lassen"
                                        ],
                                        "tags": [
                                            "eine Person verlassen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bf5754dd-4991-4110-a6ca-4e0354fbdd2c",
                                                "sense_id": "30475fd9-7c12-354d-a5b7-772d8769a5aa",
                                                "text": "Nach fünfjähriger Beziehung hat sie ihn verlassen."
                                            },
                                            {
                                                "example_id": "4971d73d-807c-49f3-a8ea-c7b14b460ace",
                                                "sense_id": "30475fd9-7c12-354d-a5b7-772d8769a5aa",
                                                "text": "„Als er zwei Mal mit seiner Pistole betrunken herumgeballert hatte, drohte seine Frau, ihn auf der Stelle zu verlassen.“"
                                            },
                                            {
                                                "example_id": "cebdacf2-326d-4488-9bee-ed1ef41a1051",
                                                "sense_id": "30475fd9-7c12-354d-a5b7-772d8769a5aa",
                                                "text": "[Kreuzigung Jesus Christus:] „Und um die neunte Stunde schrie Jesus laut: Eli, Eli, lama asabtani? Das heißt: Mein Gott, mein Gott, warum hast du mich verlassen?“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
