                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "highness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5a1c03c0-358c-3ac5-9f10-bcc485b0388e",
                                        "entry_id": "9231d8b0-6dd0-3d86-8f79-44e75d15398d",
                                        "glosses": [
                                            "The state of being high."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8f340039-9d16-4716-8571-813ebb89ed37",
                                                "sense_id": "5a1c03c0-358c-3ac5-9f10-bcc485b0388e",
                                                "text": "'It is as high as heaven, what canst thou do?' It is as the highnesses of heaven: take all the heights and elevations, all the spheres and altitudes of heaven, and try if thou canst reach them with thy short arm; yea, climb up the highest storeys, the loftiest pinnacles, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7770c1ec-9a6a-3eaa-b3a3-f6e895f41b46",
                                        "entry_id": "9231d8b0-6dd0-3d86-8f79-44e75d15398d",
                                        "glosses": [
                                            "A title of respect when referring to a prince or princess."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
