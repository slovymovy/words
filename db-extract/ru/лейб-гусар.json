                "senses": [
                    {
                        "sense_id": "d3eb0669-c3d9-368a-8d59-6604f4faa729",
                        "entry_id": "b9dec217-d36c-3420-8704-5b1336ef4c0b",
                        "glosses": [
                            "воен., истор. состоящий при монархе, придворный гусар"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94042fbb-2e52-4060-93c9-eba3b07bb6ee",
                                "sense_id": "d3eb0669-c3d9-368a-8d59-6604f4faa729",
                                "text": "Вечером в тот же день чествовали меня лейб-гусары, где служили мой зять и младший брат."
                            },
                            {
                                "example_id": "6deba935-0479-40fa-88a2-057538c29434",
                                "sense_id": "d3eb0669-c3d9-368a-8d59-6604f4faa729",
                                "text": "Чтобы дать место загородным полкам, наш полк сейчас же после смотра походом шел в Царское Село в гости к лейб-гусарам."
                            }
                        ]
                    }
