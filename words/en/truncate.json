                    "frequency": "VeryLow",
                    "semantic_group_id": "geometry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The architect decided to <w>truncate</w> the sharp corners of the building design."
                        },
                        {
                            "text": "The crystal structure was <w>truncated</w> during the growth process."
                        }
                    ]
                }
            ]
        },
