                    {
                        "sense_id": "4bb58264-902c-363b-aa93-5a72e3ff6b53",
                        "entry_id": "109bf4f3-1285-3a61-ab0f-b5fc7abb71e1",
                        "glosses": [
                            "Klub, dessen Mitglieder sich zur gemeinsamen Ausübung des Rudersports treffen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54adb64f-3149-450f-a3d1-2387862d5b7c",
                                "sense_id": "4bb58264-902c-363b-aa93-5a72e3ff6b53",
                                "text": "„Bis zur 1500-Meter-Marke lieferte sich Taupe-Traer vom Ruderklub Nautilus Klagenfurt mit der Britin Ruth Walczak und der Griechin Aikaterini Nikolaidou ein enges Rennen, alle drei Athleten führten abwechselnd.“"
                            },
                            {
                                "example_id": "eb0c9a30-b314-4e21-9ddd-9e5a593f3c9d",
                                "sense_id": "4bb58264-902c-363b-aa93-5a72e3ff6b53",
                                "text": "„Mehr als 30 Jahre zuvor hatte sich in Hamburg der erste Ruderklub Deutschlands gegründet, auch der Frankfurter Ruderverein bestand schon vor der Gründung der Germania.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
