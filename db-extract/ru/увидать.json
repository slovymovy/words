                "senses": [
                    {
                        "sense_id": "117943ab-3128-3717-bcde-b1e314b047a5",
                        "entry_id": "2be76031-9772-37dd-9f0a-3afb412a5eae",
                        "glosses": [
                            "разг. то же, что увидеть"
