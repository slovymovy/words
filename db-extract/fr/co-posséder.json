                        "glosses": [
                            "Posséder en commun avec d’autres."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2442e220-79d0-4eb5-a9d1-6ff2bd180e57",
                                "sense_id": "73b1a456-ca33-3c87-a6d0-527d8fef6e8e",
                                "text": "D'autant qu'il s'agit de co-posséder un animal vivant, avec tous les aléas que cela implique."
                            },
                            {
                                "example_id": "3a9ea5b4-3739-4a64-a2f8-ea92952e3c6c",
                                "sense_id": "73b1a456-ca33-3c87-a6d0-527d8fef6e8e",
                                "text": "De ce fait, les Stroelyns sont parmi les seuls barbares à co-posséder une grande cité (au sens civilisé): Dilanovia."
                            },
                            {
                                "example_id": "9cede0b4-4d75-4f44-9aae-eea716a71267",
                                "sense_id": "73b1a456-ca33-3c87-a6d0-527d8fef6e8e",
                                "text": "Il co-possède depuis peu \"Le Monde\"."
                            }
                        ]
