        "nl-extract.jsonl": [
            {
                "entry_id": "7ff472d4-c1cc-3c18-aa02-b9e39e491a00",
                "word": "uiteenlopend",
                "pos": "adj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "f7dc324b-c8e2-324d-a1f3-ca3605fbba08",
                        "entry_id": "7ff472d4-c1cc-3c18-aa02-b9e39e491a00",
                        "glosses": [
                            "van allerlei soorten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f73422e7-d7c1-42ba-b6d7-3a27d25c7452",
                                "sense_id": "f7dc324b-c8e2-324d-a1f3-ca3605fbba08",
                                "text": "Dit probleem heeft uiteenlopende oorzaken."
                            },
                            {
                                "example_id": "3de887f4-35d4-4ade-962f-b11467474430",
                                "sense_id": "f7dc324b-c8e2-324d-a1f3-ca3605fbba08",
                                "text": "Een vertaling uit het Noors die uit één lange zin bestaat, een uit het Tsjechisch die het derde deel is van een trilogie, en drie vertalingen uit het Engels van nogal uiteenlopende aard. Dat zijn de boeken die kans maken op de Filter Vertaalprijs 2020, zo maakt Stichting Filter vandaag bekend."
                            },
                            {
                                "example_id": "f133912f-4ade-4428-9b4f-eddbcf0512d4",
                                "sense_id": "f7dc324b-c8e2-324d-a1f3-ca3605fbba08",
                                "text": "De mannenrok, bodypaint en een jurk van Marilyn Monroe: op het Met Gala van het Metropolitan Museum of Art in New York probeerden aanwezige beroemdheden gisteravond niet alleen de dresscode eer aan te doen. Ze maakten met hun outfits ook uiteenlopende statements."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "adb8636f-074b-4f0f-961f-f62a2a6af66b",
                        "source_entry_id": "7ff472d4-c1cc-3c18-aa02-b9e39e491a00",
                        "source_sense_id": "f7dc324b-c8e2-324d-a1f3-ca3605fbba08",
                        "source_sense_description": "van allerlei soorten",
                        "target_lang_word": "unterschiedlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unterschiedlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a2eea9a4-6c90-3182-9a9a-61ba81fff03f",
                                        "entry_id": "c7ce3887-529d-373c-9b60-980c87335f65",
                                        "glosses": [
                                            "nach verschiedener Art, auf verschiedene Weise"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "24768e7c-ac9e-4e6a-bf5d-94eb4a144852",
                                                "sense_id": "a2eea9a4-6c90-3182-9a9a-61ba81fff03f",
                                                "text": "Unter meinen Freunden gibt es ganz unterschiedliche Temperamente."
                                            },
                                            {
                                                "example_id": "2f238476-7df7-40da-b1da-aa65cc2a800c",
                                                "sense_id": "a2eea9a4-6c90-3182-9a9a-61ba81fff03f",
                                                "text": "„In seiner Zeit bei den Vereinten Nationen hat er die Kunst perfektioniert, die unterschiedlichsten Menschen zum Konsens zu bringen und Gegner einzubinden.“"
                                            },
                                            {
                                                "example_id": "a2399997-89f4-498b-a4e7-c6d59bf33ee3",
                                                "sense_id": "a2eea9a4-6c90-3182-9a9a-61ba81fff03f",
                                                "text": "„Während der langen Entstehungsgeschichte des Lebens haben sich Millionen unterschiedlicher Spezies entwickelt.“"
                                            },
                                            {
                                                "example_id": "a04da2f3-234f-4a90-9a5b-e2c1681ffb0f",
                                                "sense_id": "a2eea9a4-6c90-3182-9a9a-61ba81fff03f",
                                                "text": "„Der Vorteil einer progressiven Kapitalsteuer liegt darin, mit den unterschiedlichsten Situationen auf flexible, konsistente, vorhersehbare Weise umgehen zu können, […].“"
                                            },
                                            {
                                                "example_id": "8f2ae793-d08f-4b07-b02a-6ee8a13fa614",
                                                "sense_id": "a2eea9a4-6c90-3182-9a9a-61ba81fff03f",
                                                "text": "„So unterschiedlich das jeweilige Krisenmanagement auch ist - gemeinsam ist doch allen die Erkenntnis, dass es so jedenfalls keinesfalls weitergehen kann.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
