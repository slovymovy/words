{
    "word_family": [
        "imbuement"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a9e54ae9-24bc-3d52-9f2d-82a4f032a93e",
                    "sense_definition": "To fill or inspire someone or something with a particular quality, feeling, or idea.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "influence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The entire text is <w>imbued</w> with a sense of melancholy and hopelessness.",
                            "target_lang_translations": {
                                "es": "Todo el texto está <w>imbuido</w> de una sensación de melancolía y desesperanza."
                            }
                        },
                        {
                            "text": "Her speeches are <w>imbued</w> with a deep passion for social justice.",
                            "target_lang_translations": {
                                "es": "Sus discursos están <w>impregnados</w> de una profunda pasión por la justicia social."
                            }
                        }
                    ],
                    "synonyms": [
                        "infuse",
                        "permeate",
                        "inspire",
                        "instill"
                    ],
                    "target_lang_definitions": {
                        "es": "Infundir o llenar a alguien o algo de una determinada cualidad, sentimiento o idea."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "imbuir",
                                "target_lang_sense_clarification": "infundir ideas o sentimientos"
                            },
                            {
                                "target_lang_word": "impregnar",
                                "target_lang_sense_clarification": "dejar una fuerte huella o influencia espiritual"
                            },
                            {
                                "target_lang_word": "inculcar",
                                "target_lang_sense_clarification": "transmitir valores o principios"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ff6526f9-84c3-31eb-afa0-a00c58cad879",
                    "sense_definition": "To soak or stain something completely with a physical substance or quality.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "influence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old shirt was <w>imbued</w> with the strong scent of woodsmoke.",
                            "target_lang_translations": {
                                "es": "La camisa vieja estaba <w>impregnada</w> del fuerte olor a humo de leña."
                            }
                        },
                        {
                            "text": "The fabric was <w>imbued</w> with a deep blue dye during the process.",
                            "target_lang_translations": {
                                "es": "La tela fue <w>empapada</w> con un tinte azul oscuro durante el proceso."
                            }
                        }
                    ],
                    "synonyms": [
                        "saturate",
                        "soak",
                        "impregnate"
                    ],
                    "target_lang_definitions": {
                        "es": "Empapar o impregnar completamente algo con una sustancia física, olor o color."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "impregnar",
                                "target_lang_sense_clarification": "penetrar completamente un líquido u olor"
                            },
                            {
                                "target_lang_word": "empapar",
                                "target_lang_sense_clarification": "mojar por completo"
                            },
                            {
                                "target_lang_word": "permear",
                                "target_lang_sense_clarification": "atravesar o penetrar un material"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}