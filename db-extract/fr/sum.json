                ],
                "translations": [
                    {
                        "translation_id": "32ba84b6-f5ee-40a2-90b7-f3153d91225a",
                        "source_entry_id": "aaef2cc8-afb0-302a-a10c-a12c1de194bc",
                        "source_sense_id": "c1f60a91-ce70-3c6b-878e-15ad701358c9",
                        "target_lang_word": "sum",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sum",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2148a616-be7a-383c-a9f5-39e1bb81cf08",
                                        "entry_id": "b8b6858c-9c3b-3b33-8471-134246196434",
                                        "glosses": [
                                            "A quantity obtained by addition or aggregation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "84a34feb-cfca-461c-8761-e8fd81fdeaa1",
                                                "sense_id": "2148a616-be7a-383c-a9f5-39e1bb81cf08",
                                                "text": "The sum of 3 and 4 is 7."
                                            },
                                            {
                                                "example_id": "9e0907e1-8ec9-4964-904e-b00d66e0df64",
                                                "sense_id": "2148a616-be7a-383c-a9f5-39e1bb81cf08",
                                                "text": "Take yee the ſumme of all the Congregation of the children of Iſrael,[…]"
                                            },
                                            {
                                                "example_id": "7ddb605e-8ecc-4c3c-a125-8241e9ebc8bd",
                                                "sense_id": "2148a616-be7a-383c-a9f5-39e1bb81cf08",
                                                "text": "\"Imagine a world in which every single person on the planet is given free access to the sum of all human knowledge. That's what we're doing.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1ac97e30-e8b4-3854-a26f-2b4abc30930f",
                                        "entry_id": "b8b6858c-9c3b-3b33-8471-134246196434",
                                        "glosses": [
                                            "An arithmetic computation, especially one posed to a student as an exercise (not necessarily limited to addition)."
                                        ],
                                        "tags": [
                                            "often",
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1d4fc758-2b76-4b60-9da8-7a50f9977fb2",
                                                "sense_id": "1ac97e30-e8b4-3854-a26f-2b4abc30930f",
                                                "text": "We're learning about division, and the sums are tricky."
                                            },
                                            {
                                                "example_id": "cf7b994e-5597-45a0-b7e2-607dd5098f56",
                                                "sense_id": "1ac97e30-e8b4-3854-a26f-2b4abc30930f",
                                                "text": "[…] a large sheet of paper […] covered with long sums […]"
                                            },
                                            {
                                                "example_id": "df85b129-e47c-43a7-bb42-3df1135ed026",
                                                "sense_id": "1ac97e30-e8b4-3854-a26f-2b4abc30930f",
                                                "text": "\"I think it was a disgraceful performance from a captain that got his sums wrong today, and I think it should never be permitted to happen again.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "47d06b65-5f76-3884-8c4f-845bc1ce03df",
                                        "entry_id": "b8b6858c-9c3b-3b33-8471-134246196434",
                                        "glosses": [
                                            "A quantity of money."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f596c1e6-9340-4dde-8637-7a1cf9800a11",
                                                "sense_id": "47d06b65-5f76-3884-8c4f-845bc1ce03df",
                                                "text": "a tidy sum"
                                            },
                                            {
                                                "example_id": "adf6b02d-6749-4a43-846c-76549a191b98",
                                                "sense_id": "47d06b65-5f76-3884-8c4f-845bc1ce03df",
                                                "text": "the sum of forty pounds"
                                            },
                                            {
                                                "example_id": "4c8fae1c-81a1-465c-a65c-d47a49af441c",
                                                "sense_id": "47d06b65-5f76-3884-8c4f-845bc1ce03df",
                                                "text": "[…]With a great ſumme obteined I this freedome."
                                            },
                                            {
                                                "example_id": "864b4ff9-3a3f-4b78-9395-24b59983a7f2",
                                                "sense_id": "47d06b65-5f76-3884-8c4f-845bc1ce03df",
                                                "text": "Merchant Opold: This one promised compensation for services rendered. It humbly suggests that a sum of 250 credits would be most appropriate.\nShepard: Would you have had any chance of getting this past customs without me? You can be a bit more generous.\nMerchant Opold: The other's words possess the discomforting ring of truth.\nMerchant Opold: This one could raise the sum to 500 credits. That is half this one's profit taken by the other. It can offer no more."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e6418a78-902e-30df-ba3f-1116bf2da57d",
                                        "entry_id": "b8b6858c-9c3b-3b33-8471-134246196434",
                                        "glosses": [
                                            "A summary; the principal points or thoughts when viewed together; the substance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "800881ab-e261-4e73-8f43-c4bd4b725b08",
                                                "sense_id": "e6418a78-902e-30df-ba3f-1116bf2da57d",
                                                "text": "This is the sum of all the evidence in the case."
                                            },
                                            {
                                                "example_id": "201f6728-1922-496d-8bbc-66c27a6a7e10",
                                                "sense_id": "e6418a78-902e-30df-ba3f-1116bf2da57d",
                                                "text": "This is the sum and substance of his objections."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cc5367db-8e31-3851-939e-a7fe711e65fa",
                                        "entry_id": "b8b6858c-9c3b-3b33-8471-134246196434",
                                        "glosses": [
                                            "A central idea or point; gist."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2ccb52a3-32cd-362f-a591-ba554fad50c7",
                                        "entry_id": "b8b6858c-9c3b-3b33-8471-134246196434",
                                        "glosses": [
                                            "The utmost degree; the greatest or most perfect realization (of some concept)."
                                        ],
                                        "tags": [
                                            "literary",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "45ff412f-a6c7-410e-9267-b4e1dfa06a72",
                                                "sense_id": "2ccb52a3-32cd-362f-a591-ba554fad50c7",
                                                "text": "Thus I have told thee all my State, and brought / My Storie to the ſum of earthly bliſs[…]"
                                            },
                                            {
                                                "example_id": "ac69b53b-dc5b-4850-a295-2ac856aa86c1",
                                                "sense_id": "2ccb52a3-32cd-362f-a591-ba554fad50c7",
                                                "text": "Our wisdom and skill cannot save us from accidents, pains, and from that sum of all fears and distresses—death."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "720a9307-15dd-39ab-bcc6-f7b849485a25",
                                        "entry_id": "b8b6858c-9c3b-3b33-8471-134246196434",
                                        "glosses": [
                                            "An old English measure of corn equal to the quarter."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b92d7c73-92ce-4f0b-954e-dd4875d4c6ea",
                                                "sense_id": "720a9307-15dd-39ab-bcc6-f7b849485a25",
                                                "text": "The sum is also used for the quarter, and the strike for the bushel."
                                            }
                                        ]
                                    }
                                ]
                            },
