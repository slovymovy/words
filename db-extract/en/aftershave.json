    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "fe6478b5-20e4-3705-ad2a-7d3400532141",
                "word": "aftershave",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "0aaf45f5-1f57-4fff-b127-ab33829a8835",
                        "entry_id": "fe6478b5-20e4-3705-ad2a-7d3400532141",
                        "tags": [
                            "plural"
                        ],
                        "form": "aftershaves"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2e53c888-f82b-39c5-8bf0-6566e961d6a8",
                        "entry_id": "fe6478b5-20e4-3705-ad2a-7d3400532141",
                        "glosses": [
                            "a lotion, gel, or liquid used after finishing shaving"
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "24ad4adc-026d-488b-a698-8edf678b47f6",
                                "sense_id": "2e53c888-f82b-39c5-8bf0-6566e961d6a8",
                                "text": "The box was jam packed full o' gifts for each manjack of us: razors, aftershave, toothbrushes, an' books."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "330be64e-8ef6-4ab2-b73b-b871762231a3",
                        "source_entry_id": "fe6478b5-20e4-3705-ad2a-7d3400532141",
                        "source_sense_id": "2e53c888-f82b-39c5-8bf0-6566e961d6a8",
                        "source_sense_description": "lotion, gel or liquid",
                        "target_lang_word": "aftershave",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aftershave",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "b68d32fe-2b0f-3be7-bd2a-8b53cbf83358",
                                        "entry_id": "2df0d43f-7d00-308d-8d40-9518b17cd256",
                                        "glosses": [
                                            "een alcohol en parfum bevattend toiletartikel om na het scheren de huid te verfrissen en te ontsmetten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "530b7ae7-f1d2-49fe-a673-a3a3d984af3b",
                                                "sense_id": "b68d32fe-2b0f-3be7-bd2a-8b53cbf83358",
                                                "text": "Je moet echt wat minder aftershave gebruiken, hoor."
                                            },
                                            {
                                                "example_id": "7a082c87-15c4-4e3d-aa6e-9d6c38b3cf80",
                                                "sense_id": "b68d32fe-2b0f-3be7-bd2a-8b53cbf83358",
                                                "text": "De vluchtige geur van zijn aftershave, een vlaag van zijn lichaamswarmte die vanuit zijn stoere jack ontsnapte en haar wang streelde."
                                            },
                                            {
                                                "example_id": "296a78af-ace0-4edf-87d0-d20c6f595f92",
                                                "sense_id": "b68d32fe-2b0f-3be7-bd2a-8b53cbf83358",
                                                "text": "Hij had zijn hoofd heel dicht bij het mijne, en ik kon zijn huid ruiken, een vleugje aftershave waar ik kippenvel van kreeg."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "35f41dfc-d2bc-446b-b752-30bda9235034",
                        "source_entry_id": "fe6478b5-20e4-3705-ad2a-7d3400532141",
                        "source_sense_id": "2e53c888-f82b-39c5-8bf0-6566e961d6a8",
                        "source_sense_description": "lotion, gel or liquid",
                        "target_lang_word": "après-rasage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "après-rasage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a65b26c4-31bf-3bd8-97cd-fd6587fca96f",
                                        "entry_id": "a86d6213-941f-3492-92f9-bcc22799b635",
                                        "glosses": [
                                            "Baume qui calme le feu du rasoir après qu’on a fini de se raser."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19253467-6ad7-49a1-b3f8-7fab44b5157c",
                                                "sense_id": "a65b26c4-31bf-3bd8-97cd-fd6587fca96f",
                                                "text": "La promesse valait pour l’ensemble des chasseurs, dont la transpiration mêlée aux émanations alcoolisées d’après-rasage emboucanait l’atmosphère d’un suint pimenté."
                                            },
                                            {
                                                "example_id": "30446553-0cc4-475d-b98a-13855a24fbf6",
                                                "sense_id": "a65b26c4-31bf-3bd8-97cd-fd6587fca96f",
                                                "text": "Si on a tendance à avoir des boutons de rasage, on applique une crème hydratante ou un après-rasage adapté, quelle que soit la technique de rasage utilisée."
                                            },
                                            {
                                                "example_id": "04f6aa83-48ce-44ce-a71a-fef051a2f320",
                                                "sense_id": "a65b26c4-31bf-3bd8-97cd-fd6587fca96f",
                                                "text": "Un après-midi, alors qu’il fait ses courses au centre commercial Leclerc, Georges dont l’attention est portée sur des après-rasages, tout en poussant son caddy, heurte une vendeuse accroupie qui range une étagère."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "39e7d4c8-24b9-4c61-9486-64ab2068e7ac",
                        "source_entry_id": "fe6478b5-20e4-3705-ad2a-7d3400532141",
                        "source_sense_id": "2e53c888-f82b-39c5-8bf0-6566e961d6a8",
                        "source_sense_description": "lotion, gel or liquid",
                        "target_lang_word": "Aftershave",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Aftershave",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "52dd1532-6818-357e-b6e2-ad332b709c4c",
                                        "entry_id": "8947e04d-7ed4-3196-a1d6-301c9a8d4ee0",
                                        "glosses": [
                                            "Lotion, Gel oder Flüssigkeit, die nach der Rasur auf die Haut aufgetragen wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83f5a924-a18c-47c3-9fbd-bb55daaf3c2b",
                                                "sense_id": "52dd1532-6818-357e-b6e2-ad332b709c4c",
                                                "text": "Er verzog das Gesicht, weil das Aftershave in seinem Gesicht brannte."
                                            },
                                            {
                                                "example_id": "13a9c5ac-0835-4e1e-b5ad-3c2b721ed1ce",
                                                "sense_id": "52dd1532-6818-357e-b6e2-ad332b709c4c",
                                                "text": "„Mr. Lane besah sich die Schachtel Aftershave auf der Theke.“"
                                            },
                                            {
                                                "example_id": "c65df13e-b0a5-4247-940f-87274d7b4358",
                                                "sense_id": "52dd1532-6818-357e-b6e2-ad332b709c4c",
                                                "text": "„Der Typ ist aufdringlicher als sein Aftershave.“"
                                            },
                                            {
                                                "example_id": "9929a483-caf4-462e-83c3-1b3421a495ed",
                                                "sense_id": "52dd1532-6818-357e-b6e2-ad332b709c4c",
                                                "text": "„Er lehnte sich im Sofa nach vorne, und Elma roch seinen Schweiß, den das Aftershave nicht verdecken konnte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "710735d8-288f-4107-b933-54c0c2a82dfb",
                        "source_entry_id": "fe6478b5-20e4-3705-ad2a-7d3400532141",
                        "source_sense_id": "2e53c888-f82b-39c5-8bf0-6566e961d6a8",
                        "source_sense_description": "lotion, gel or liquid",
                        "target_lang_word": "Rasierwasser",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rasierwasser",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9b7b3568-df44-3871-a374-18b879926732",
                                        "entry_id": "2cbfe858-8795-38c7-bb0d-937f27a36e6d",
                                        "glosses": [
                                            "flüssiges Hautpflegemittel, das vor oder nach der Rasur im Gesicht aufgetragen wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b8be3d8-3398-42a8-a042-ca438c29eeb3",
                                                "sense_id": "9b7b3568-df44-3871-a374-18b879926732",
                                                "text": "„Er duftete frisch nach Rasierwasser, und dass er sich auf das Treffen gefreut hatte, zeigte sein geradezu feuriges Benehmen.“"
                                            },
                                            {
                                                "example_id": "0637a87e-1ad5-491c-a066-61ab41aca898",
                                                "sense_id": "9b7b3568-df44-3871-a374-18b879926732",
                                                "text": "„Schefold benützte kein Rasierwasser, rauchte keine Zigarren, erst neuerdings amerikanische Zigaretten.“"
                                            },
                                            {
                                                "example_id": "ab0619ec-952d-4ec1-a209-0b692f9eba7b",
                                                "sense_id": "9b7b3568-df44-3871-a374-18b879926732",
                                                "text": "„Sie schloss die Augen und ließ sich vom Duft seines Rasierwassers davontragen.“"
                                            },
                                            {
                                                "example_id": "82b20df6-dcf1-4d61-822e-248a479c5f67",
                                                "sense_id": "9b7b3568-df44-3871-a374-18b879926732",
                                                "text": "„Das Zimmer ist vom Duft seines Rasierwassers erfüllt, Zizanie, das in kühlen Aluminiumflaschen verkauft wird.“"
                                            },
                                            {
                                                "example_id": "865edb59-4ec1-4e58-909e-298408612bb2",
                                                "sense_id": "9b7b3568-df44-3871-a374-18b879926732",
                                                "text": "„Das Rasierwasser, das sie an ihm roch, und den kalten Zigarettenrauch in seinen Kleidern mochte sie nicht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d43c796f-f7a7-454b-b399-4ca3ca643838",
                        "source_entry_id": "fe6478b5-20e4-3705-ad2a-7d3400532141",
