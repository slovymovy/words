                                                "sense_id": "4b26bd4b-f4c5-3099-b728-9a32b98b5f3f",
                                                "text": "state legislature"
                                            },
                                            {
                                                "example_id": "9cf1d4c6-47b5-47a2-9eb4-4b7f949f2c67",
                                                "sense_id": "4b26bd4b-f4c5-3099-b728-9a32b98b5f3f",
                                                "text": "bicameral legislature"
                                            },
                                            {
                                                "example_id": "6f3008b3-25cf-4921-9c9b-d175cecf54bb",
                                                "sense_id": "4b26bd4b-f4c5-3099-b728-9a32b98b5f3f",
                                                "text": "colonial legislature"
                                            },
                                            {
                                                "example_id": "a8d4bda0-d6d9-454d-b46f-3e302c68ad59",
                                                "sense_id": "4b26bd4b-f4c5-3099-b728-9a32b98b5f3f",
                                                "text": "members of the legislature"
                                            },
                                            {
                                                "example_id": "4f3f88e6-4454-42d7-be5b-7138e97be951",
                                                "sense_id": "4b26bd4b-f4c5-3099-b728-9a32b98b5f3f",
                                                "text": "The state legislature passed a new education bill."
                                            },
                                            {
                                                "example_id": "3d952c70-b753-426b-8924-7e2114cc5697",
                                                "sense_id": "4b26bd4b-f4c5-3099-b728-9a32b98b5f3f",
                                                "text": "Members of the legislature debated late into the night."
                                            },
                                            {
                                                "example_id": "4485c478-bdb6-4255-a5e3-56153e689b34",
                                                "sense_id": "4b26bd4b-f4c5-3099-b728-9a32b98b5f3f",
                                                "text": "The law cannot take effect until approved by the legislature."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "13d47c42-4446-3264-8c96-d1fe23afaa53",
                                        "entry_id": "9696e1ff-e2f4-312e-9bf9-db249669c139",
                                        "glosses": [
