                                    },
                                    {
                                        "sense_id": "5a8bcedd-40c5-3e59-8612-b96ee52fd989",
                                        "entry_id": "5e6bc5f3-4be8-3fbc-a43a-384a8be6a094",
                                        "glosses": [
                                            "Relatif à la lutte des classes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96787a5d-494f-4f2a-a76b-80b7bbc07293",
                                                "sense_id": "5a8bcedd-40c5-3e59-8612-b96ee52fd989",
                                                "text": "La lutte contre le trotskysme passe avant tout par une pratique dirigée par l’idéologie du prolétariat, une politique classiste, combative et anti-opportuniste."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "403bcbdc-355d-41af-b3af-ec7eea861eb2",
                        "source_entry_id": "c138f0a9-2fe7-37d4-b6f6-e992c6d5e12d",
                        "source_sense_id": "241b4da2-2e2f-3cac-aee3-c356c38036c8",
                        "source_sense_description": "pertaining to classism",
                        "target_lang_word": "klassistisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "klassistisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "693366f8-6d6f-3541-9f37-79ea2f884558",
                                        "entry_id": "2fee48aa-7658-3479-a6ca-8cae85be185a",
                                        "glosses": [
                                            "die Benachteiligung aufgrund der sozialen Herkunft (= den Klassismus) betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d392b827-6633-42f7-98a2-998c21bdd65d",
                                                "sense_id": "693366f8-6d6f-3541-9f37-79ea2f884558",
                                                "text": "Wer sich wegen seiner armen Herkunft schämt, denkt ähnlich klassistisch, wie der reiche Schnösel, der sich überlegen wegen Papas Geld fühlt."
                                            },
                                            {
                                                "example_id": "efbc74ad-90b6-4c2e-931a-1110de576f3f",
                                                "sense_id": "693366f8-6d6f-3541-9f37-79ea2f884558",
                                                "text": "„»Das ist eine klassistische Perspektive.«“"
                                            },
                                            {
                                                "example_id": "566e7f8f-6ed4-4937-9dab-f05ecc259388",
                                                "sense_id": "693366f8-6d6f-3541-9f37-79ea2f884558",
                                                "text": "„»Wir sind alle in einer Gesellschaft aufgewachsen, die durchzogen ist von klassistischen Vorurteilen und sozialdarwinistischen Vorstellungen«, sagt Seeck. »Es geht um verinnerlichte Vorurteile.«“"
                                            },
                                            {
                                                "example_id": "e30b2424-179b-4201-bde9-65344fbd1812",
                                                "sense_id": "693366f8-6d6f-3541-9f37-79ea2f884558",
                                                "text": "„Unter #Chavcheck amüsiert sich das Internet über Stereotype, die meistens mit Armut in Verbindung gebracht werden. Was nach harmlosem Spaß klingt, offenbart sich bei näherem Hinsehen als strukturell klassistisches Problem, sagt Caren Miesenberger.“"
                                            },
                                            {
                                                "example_id": "db828713-85e5-410c-99ee-fc17b8346672",
                                                "sense_id": "693366f8-6d6f-3541-9f37-79ea2f884558",
                                                "text": "[Coronaimpfung:] „Denn geimpft werden sollte nicht von den Bemühungen darum abhängen – dann bleibt es klassistisch. Global gesehen ist es das ja eh schon.“"
                                            },
                                            {
                                                "example_id": "07f20c2d-bda9-418b-aed7-1496f4480a5b",
                                                "sense_id": "693366f8-6d6f-3541-9f37-79ea2f884558",
                                                "text": "„Die Unterschiede in der Rechtschreibekompetenz können inzwischen sogar als klassistisches Unterscheidungsmerkmal gelten: Während die Kinder der Bildungsschicht durch das Engagement der Eltern auch mit offenen Methoden meist immer noch solide Rechtschreibfähigkeiten erwerben, haben insbesondere Kinder aus bildungsfernen Familien oft gravierende Rechtschreibschwächen.“"
                                            },
                                            {
                                                "example_id": "d7e266b1-4261-4885-bde9-2ab587f72076",
                                                "sense_id": "693366f8-6d6f-3541-9f37-79ea2f884558",
                                                "text": "„Die vermeintliche Fürsorglichkeit staatlicher Maßnahmen hat eine klassistische und rassistische Schieflage, denn sie gilt nicht für alle gleich. Sie gilt beispielsweise nicht in Niedriglohnbereichen, nicht für Obdachlose oder Geflüchtete.“"
                                            },
                                            {
                                                "example_id": "73e6be89-b4c5-448b-9b77-2531861da3da",
                                                "sense_id": "693366f8-6d6f-3541-9f37-79ea2f884558",
                                                "text": "„Erster großer Streit einer ersten großen Liebe: Er, Oliver Barrett (Ryan O’Neal), Harvardstudent aus bestem East-Coast-Hause, schaut voller Hass auf seine reichen, konservativen Eltern, weil diese sie, seine frisch Vermählte, Jenny Cavilleri (Ali MacGraw), musikalisch hochbegabte, bettelarme Radcliffe-Studentin, aus klassistischen Gründen ablehnen.“"
                                            },
                                            {
                                                "example_id": "b2cdfeb0-d23c-4992-9639-0a1ae83c454c",
                                                "sense_id": "693366f8-6d6f-3541-9f37-79ea2f884558",
                                                "text": "„Jede achte Person in einem deutschen Gefängnis – über 6000 Inhaftierte – sitzt dort wegen eines Verstoßes gegen das Betäubungsmittelgesetz. Was den Menschen hinter all diesen Zahlen widerfährt, ist zu großen Teilen eine rassistische und klassistische Polizeipraxis. Drug Policing, analysiert Soziologe Vitale in seinem Buch, wird überwiegend in armen, nicht-weißen Communities durchgeführt, wo Polizist*innen [sic] während vermeintlich neutraler Kontrollroutinen „überraschend“ vor allem auf arme, nicht-weiße Drogenkonsument*innen [sic] und Dealer*innen [sic] treffen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
