                "senses": [
                    {
                        "sense_id": "f7b5a7e5-9316-39bc-9f5c-7ea320f5be84",
                        "entry_id": "8b0a5aaf-9625-33a5-943d-4e06f477e4f2",
                        "glosses": [
                            "Variante orthographique de redéménager (déménager à nouveau)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d48bdb7-f765-4601-834a-26f812630843",
                                "sense_id": "f7b5a7e5-9316-39bc-9f5c-7ea320f5be84",
                                "text": "J’ai navigué, j’ai monté à cheval, j’ai déménagé et re-déménagé je ne sais combien de fois, j’ai dansé dans des endroits plus ou moins différents, j’ai beaucoup fait l’amour, chaque fois que j’en avais l’occasion, comme si, enfin, un vrai contact allait s’établir."
                            },
                            {
                                "example_id": "9362bcf4-5183-49c4-8461-36165af136b0",
                                "sense_id": "f7b5a7e5-9316-39bc-9f5c-7ea320f5be84",
                                "text": "On habite ici depuis six mois, on a failli re-déménager."
                            }
                        ]
                    }
