                                "target_lang_word": "to fill up",
                                "target_lang_sense_clarification": "to become full"
                            },
                            {
                                "target_lang_word": "to become full",
                                "target_lang_sense_clarification": "to reach capacity"
                            }
                        ],
                        "fr": [
