                    {
                        "sense_id": "6e816b47-1ac5-3038-85ce-69132bca61c4",
                        "entry_id": "132a66b7-e80a-3362-bd97-b3cceede318c",
                        "glosses": [
                            "Any of the order †Plesiosauria of extinct marine reptiles, from the Jurassic and Cretaceous periods."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b027c720-0180-48d1-ad2e-6c9e78ac5384",
                                "sense_id": "6e816b47-1ac5-3038-85ce-69132bca61c4",
                                "text": "\"Look!\" cried Olson. \"Would you look at the giraffe comin' up out o' the bottom of the say?\" We looked in the direction he pointed and saw a long, glossy neck surmounted by a small head rising above the surface of the river. Presently the back of the creature was exposed, brown and glossy as the water dripped from it. It turned its eyes upon us, opened its lizard-like mouth, emitted a shrill hiss and came for us. The thing must have been sixteen or eighteen feet in length and closely resembled pictures I had seen of restored plesiosaurs of the lower Jurassic."
                            },
                            {
                                "example_id": "de2c13a3-9153-4168-88cf-92c1fa1f3558",
                                "sense_id": "6e816b47-1ac5-3038-85ce-69132bca61c4",
                                "text": "It is the first time in Australia the head and body of an elasmosaur, a type of plesiosaur, has been found in one piece."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3c62b12d-34a6-4ae2-be17-af3a999c97f3",
                        "source_entry_id": "132a66b7-e80a-3362-bd97-b3cceede318c",
                        "source_sense_id": "6e816b47-1ac5-3038-85ce-69132bca61c4",
                        "source_sense_description": "extinct marine reptile",
                        "target_lang_word": "plésiosaure",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "plésiosaure",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "647b71cb-d4b0-3ee9-9028-5b3abe2c52c3",
                                        "entry_id": "4564b45c-658a-30eb-8bd3-86b67f89b7cf",
                                        "glosses": [
                                            "Grand reptile carnivore aquatique qu’on ne trouve qu’à l’état fossile, du sous-ordre Plesiosauroidea, de l’ordre Plesiosauria."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8deac44c-572e-4089-a288-18830734f2d7",
                                                "sense_id": "647b71cb-d4b0-3ee9-9028-5b3abe2c52c3",
                                                "text": "Bichette Cournot courait à travers le siècle comme un pauvre plésiosaure, échappé d’un muséum. Elle était de feu, mais les hommes fuyaient ses étreintes démesurées. De là, grande neurasthénie."
                                            },
                                            {
                                                "example_id": "5a80bf04-02d7-4953-8b0d-e0eecef1c875",
                                                "sense_id": "647b71cb-d4b0-3ee9-9028-5b3abe2c52c3",
                                                "text": "Aux côtés des nombreux restes de poissons littoraux, les tétrapodes sont représentés par des chéloniens, crocodiliens, ophidiens, plésiosaures, ptérosaures et dinosaures."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
