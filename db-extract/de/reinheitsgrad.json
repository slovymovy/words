                "senses": [
                    {
                        "sense_id": "ee4c0631-e557-37cd-b139-60f45ab75d14",
                        "entry_id": "32fbe560-481a-3aff-8749-45ad74a28a04",
                        "glosses": [
                            "Grad der Reinheit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b1f7d26d-5c5c-4330-82b9-645d5dc0880f",
                                "sense_id": "ee4c0631-e557-37cd-b139-60f45ab75d14",
                                "text": "„In den Jahren 1989 und 1990 waren die Großhandelspreise für Kokain in New York um vierzig Prozent gestiegen, und der Reinheitsgrad war um acht Prozent gefallen - ein sicheres Indiz dafür, dass die Nachfrage das Angebot überstieg.“"
                            },
                            {
                                "example_id": "03c0e5f6-d229-43c6-b5a0-d4fe69119e3b",
                                "sense_id": "ee4c0631-e557-37cd-b139-60f45ab75d14",
                                "text": "„Der Kenner meint die teuerste Ware mit einem Reinheitsgrad von fünfundneunzig Prozent oder mehr.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
