        "fr-extract.jsonl": [
            {
                "entry_id": "ceeb0eb3-78f8-3ae1-a8ff-47fb5a4b66d5",
                "word": "agaric",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "50dcb281-73cf-4394-8b8d-00f5b45884c2",
                        "entry_id": "ceeb0eb3-78f8-3ae1-a8ff-47fb5a4b66d5",
                        "tags": [
                            "plural"
                        ],
                        "form": "agarics"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7d805f7a-1e1c-3cee-8ff2-1a4a1b43a92c",
                        "entry_id": "ceeb0eb3-78f8-3ae1-a8ff-47fb5a4b66d5",
                        "glosses": [
                            "Champignon basidiomycète de la famille des agaricacées, à lamelles libres, d’abord roses puis brun foncé, à chapeau généralement charnu, blanc à brun, et à pied blanchâtre avec anneau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "58029f5a-b982-4503-9789-5de12d09650b",
                                "sense_id": "7d805f7a-1e1c-3cee-8ff2-1a4a1b43a92c",
                                "text": "Je peux citer l’exemple des agarics aux lamelles roses, qui ne sont pas forcément des rosés-des-prés, ou des lépiotes, dont les formes toxiques se confondent très facilement avec des coulemelles."
                            },
                            {
                                "example_id": "acb9e97c-576b-41da-861f-d42c58eab0b4",
                                "sense_id": "7d805f7a-1e1c-3cee-8ff2-1a4a1b43a92c",
                                "text": "Deux nonnes du monastère qui cueillaient des agarics verts dans la forêt nous ont indiqué le chemin."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "716a20c1-8efe-47ec-9c20-a66f0f28b444",
                        "source_entry_id": "ceeb0eb3-78f8-3ae1-a8ff-47fb5a4b66d5",
                        "source_sense_id": "7d805f7a-1e1c-3cee-8ff2-1a4a1b43a92c",
                        "target_lang_word": "Champignon",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Champignon",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3909abb2-e1c3-3555-8a0d-ef27fa6b78f8",
                                        "entry_id": "aa5b4e4c-3188-39b7-b668-cf336688ff96",
                                        "glosses": [
                                            "Pilz aus der Gattung der Blätterpilze; Speisepilz"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "57ebfe1b-8e3a-449f-b366-a86a3e11d17c",
                                                "sense_id": "3909abb2-e1c3-3555-8a0d-ef27fa6b78f8",
                                                "text": "„In asiatischen Ländern werden Shiitake am häufigsten verzehrt und in westlichen Ländern sind Champignons mit Abstand am beliebtesten.“"
                                            },
                                            {
                                                "example_id": "284f89d1-c75a-4df3-8a7a-0a306089e02e",
                                                "sense_id": "3909abb2-e1c3-3555-8a0d-ef27fa6b78f8",
                                                "text": "„Die Champignons putzen, trocken abreiben und in Scheiben schneiden. In einer Pfanne 20 g (= 2 EL) Butter erhitzen und die Champignons darin ca. 5 Min. bei mittlerer Hitze braten, dann salzen und pfeffern.“"
                                            },
                                            {
                                                "example_id": "bbc5d245-49ee-4b6e-9165-dfa08c6b5cc9",
                                                "sense_id": "3909abb2-e1c3-3555-8a0d-ef27fa6b78f8",
                                                "text": "„Viel Vitamin D haben Hering, Lachs, Hühnereigelb und Pilze wie Pfifferlinge und Champignons.“"
                                            },
                                            {
                                                "example_id": "b93ea16f-e58a-4e92-a194-713b251f909c",
                                                "sense_id": "3909abb2-e1c3-3555-8a0d-ef27fa6b78f8",
                                                "text": "„Nun, ich esse ganz gern Champignons und Austernpilze, aber Ahnung von Pilzen habe ich wirklich nicht. Wahrscheinlich würde ich mich sofort vergiften, wenn ich Pilze sammeln gehen würde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "60faa952-32ea-4674-80ad-7d8ca1a521f9",
                        "source_entry_id": "ceeb0eb3-78f8-3ae1-a8ff-47fb5a4b66d5",
                        "source_sense_id": "7d805f7a-1e1c-3cee-8ff2-1a4a1b43a92c",
                        "target_lang_word": "agaric",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "agaric",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "99840668-702e-3deb-b21c-a0045f4de903",
                                        "entry_id": "b6ca6dd1-1130-3c85-a123-d20bd0709581",
                                        "glosses": [
                                            "Any of various fungi, principally of the order Agaricales, having fruiting bodies consisting of umbrella-like caps, on stalks, with numerous gills beneath."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2b9270c-f0e8-4b46-b5f3-df92654421ee",
                                                "sense_id": "99840668-702e-3deb-b21c-a0045f4de903",
                                                "text": "[…] these [commentators] were slight excrescences, mushrooms, champignons, that perished as the smoke of the dunghil evaporated, which reared them. A modern editor of Shakespeare is, on the contrary, a fungus attached to an oak; a male agaric of the most astringent kind, that, while it disfigures its form, may last for ages to disgrace the parent of its being."
                                            },
                                            {
                                                "example_id": "1d6069c6-fa40-4151-aa2d-45502bf919fd",
                                                "sense_id": "99840668-702e-3deb-b21c-a0045f4de903",
                                                "text": "Nobody cares for planting the poor fungus: so she shakes down from the gills of one agaric countless spores, any one of which, being preserved, transmits new billions of spores to-morrow or next day."
                                            },
                                            {
                                                "example_id": "cd825aaa-46d6-4c72-83d5-a22f5f7ee63c",
                                                "sense_id": "99840668-702e-3deb-b21c-a0045f4de903",
                                                "text": "1872, Alfred, Lord Tennyson, Idylls of the King, “Gareth and Lynette” in Gareth and Lynette, Etc. London: Strahan & Co., p. 47,\nShe thereat, as one / That smells a foul-flesh’d agaric in the holt, / And deems it carrion of some woodland thing, / Or shrew, or weasel, nipt her slender nose / With petulant thumb and finger,"
                                            },
                                            {
                                                "example_id": "0542fc32-a667-424b-bd53-2551b779945f",
                                                "sense_id": "99840668-702e-3deb-b21c-a0045f4de903",
                                                "text": "[…] I came to / Under a rainy ridge, in a goblin clump / Of agaric."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "98b15849-e08b-3bf9-a303-b1c96784ea3e",
                                        "entry_id": "b6ca6dd1-1130-3c85-a123-d20bd0709581",
                                        "glosses": [
                                            "A dried fruiting body of a fungus formerly used in medicine (now Laricifomes officinalis, formerly Fomitopsis officinalis, Fomes officinalis, Polyporus officinalis)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da6a0832-36aa-4308-98c7-ea920d595c0e",
                                                "sense_id": "98b15849-e08b-3bf9-a303-b1c96784ea3e",
                                                "text": "Agarick to purge his flegme, lest he be too drowsie"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a42088f5-3fb4-4179-9f5f-fe6326ce8c06",
                        "source_entry_id": "ceeb0eb3-78f8-3ae1-a8ff-47fb5a4b66d5",
                        "source_sense_id": "7d805f7a-1e1c-3cee-8ff2-1a4a1b43a92c",
                        "target_lang_word": "agárico",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "agárico",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "feba350c-b902-3dd6-b6b1-6c4d01e80b77",
                                        "entry_id": "81340745-62ab-3f7b-b7f1-75e6057db345",
                                        "glosses": [
                                            "Se dice de setas y hongos agaricáceos del género Agaricus como el champiñón y la oronja, que tienden a vivir más en la tierra que en los árboles."
                                        ],
                                        "tags": [
                                            "noun"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bef31b9b-6e9f-4f70-93a1-dc8eb22618f3",
                                                "sense_id": "feba350c-b902-3dd6-b6b1-6c4d01e80b77",
                                                "text": "(adjetivo) \"Alcaloide muy venenoso contenido en algunas setas, como las agáricas\"."
                                            },
                                            {
                                                "example_id": "30a7f57d-bcd6-4601-974c-273c167829f8",
                                                "sense_id": "feba350c-b902-3dd6-b6b1-6c4d01e80b77",
                                                "text": "(sustantivo) \"Estas dos especies de agáricos pueden distinguirse fácilmente echándolos sobre las ascuas\"."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
