                ],
                "senses": [
                    {
                        "sense_id": "c7696228-2fc7-31a2-b8df-a3d9237bfa7a",
                        "entry_id": "a95b1e33-9a98-39e4-a2dc-daf75b17980d",
                        "glosses": [
                            "mit Juwelen besetzt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "77a8340f-3431-45fd-81b9-9b0bc4a0a098",
                                "sense_id": "c7696228-2fc7-31a2-b8df-a3d9237bfa7a",
                                "text": "„Ich ließ ihm zehn Minuten, um zu verschwinden, und folgte ihm dann, wobei ich die juwelenbesetzte Krone und das mit dem Gelben Zeichen bestickte Seidengewand mit mir nahm.“"
                            },
                            {
                                "example_id": "20389312-e83c-43ae-938b-a36558133d59",
                                "sense_id": "c7696228-2fc7-31a2-b8df-a3d9237bfa7a",
                                "text": "„Wiederholt stach sie mit ihrem juwelenbesetzten Daumen auf den Knopf ein, als sende sie ein Notsignal im Morsecode.“"
                            },
                            {
                                "example_id": "3cd1b8a6-57db-4cd9-89b2-6db40ea4305e",
                                "sense_id": "c7696228-2fc7-31a2-b8df-a3d9237bfa7a",
                                "text": "„Das flüchtige, durchscheinende Gold der rot versinkenden Sonne durchwob den Raum in schrägen Strahlen, die durch ein Kristallglasfenster brachen, eine Spirale farbenprächtiger Funken in der juwelenbesetzten, von Kupferketten gehaltenen Lampe entzündeten und die verschlungenen Fäden aus gesponnenem Silber und Blattgold in den dunklen Wandbehängen durch ihre Berührung zu feurigem Leben erweckten.“"
                            },
                            {
                                "example_id": "5886efcc-dd16-4816-9d32-4fc19a92b42f",
                                "sense_id": "c7696228-2fc7-31a2-b8df-a3d9237bfa7a",
                                "text": "„Ein juwelenbesetztes Kruzifix hing ihm um den Hals.“"
                            },
                            {
                                "example_id": "839e7925-87bc-4236-b625-d7b75ca5491d",
                                "sense_id": "c7696228-2fc7-31a2-b8df-a3d9237bfa7a",
                                "text": "„Jeder der Männer trug einen juwelenbesetzten Umhang, und in ihrer Mitte schritt Moctezuma, der Tlatoani, der Sprecher seines Volkes.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
