                    {
                        "sense_id": "acc77c27-62dd-3176-aeec-94486b28f510",
                        "entry_id": "6d590a90-f8e1-3a8a-8cb3-d89acc103780",
                        "glosses": [
                            "to cram, to cover (to fill something by putting things on it)"
                        ],
                        "tags": [
                            "perfective",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "cafe8633-4078-410f-bddd-76d17214b2be",
                                "sense_id": "acc77c27-62dd-3176-aeec-94486b28f510",
                                "text": "Wprowadził ich do swego domu, zastawił przed nimi stół i weselił się, uwierzywszy Bogu z całym swoim domem.",
                                "translation": "He led them into his house, covered the table [with food] in front of them, and was happy, having begun to believe in God along with all his house.",
                                "english": "He led them into his house, covered the table [with food] in front of them, and was happy, having begun to believe in God along with all his house."
                            },
                            {
                                "example_id": "db608d19-f3b2-440c-a1fe-7252f4abfa5f",
                                "sense_id": "acc77c27-62dd-3176-aeec-94486b28f510",
                                "text": "Wkrótce chłopaka zawołała mama, bo przecież trzeba było rozpakować wszystkie rzeczy. I tak resztę dnia Radek spędził na układaniu swoich ubrań, zabawek, książek i innych przedmiotów, którymi szybko zastawił cały pokój.",
                                "translation": "Soon the boy was called by his mother, because, of course, he had to unpack everything. And thus Radek spent the rest of the day putting his clothes, toys, books, and other possessions in order, with which he quickly filled the whole room.",
                                "english": "Soon the boy was called by his mother, because, of course, he had to unpack everything. And thus Radek spent the rest of the day putting his clothes, toys, books, and other possessions in order, with which he quickly filled the whole room."
                            }
                        ]
