                                ]
                            },
                            {
                                "target_word": "leather",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8dc08ac8-61a0-3f0f-a63d-480bdee91e17",
                                        "entry_id": "aeb113c3-eca7-3efa-adb4-6c67ff5f1806",
                                        "glosses": [
                                            "Made of leather."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0632a72b-fc69-435e-8745-1e1980cc9cbb",
                                                "sense_id": "8dc08ac8-61a0-3f0f-a63d-480bdee91e17",
                                                "text": "Sunning himself on the board steps, I saw for the first time Mr. Farquhar Fenelon Cooke.[…]A silver snaffle on a heavy leather watch guard which connected the pockets of his corduroy waistcoat, together with a huge gold stirrup in his Ascot tie, sufficiently proclaimed his tastes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "db1020df-614b-3965-80b9-fa681e21aa04",
                                        "entry_id": "aeb113c3-eca7-3efa-adb4-6c67ff5f1806",
                                        "glosses": [
                                            "Referring to one who wears leather clothing (motorcycle jacket, chaps over 501 jeans, boots), especially as a sign of sadomasochistic homosexuality."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e2626cf1-8a49-3e5c-ad0c-c8c97b831514",
                                        "entry_id": "aeb113c3-eca7-3efa-adb4-6c67ff5f1806",
                                        "glosses": [
                                            "Referring to an establishment of familial relations through agreed sexual or romantic deviance."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c08791ef-aa96-4905-822d-1a528244e482",
                                                "sense_id": "e2626cf1-8a49-3e5c-ad0c-c8c97b831514",
                                                "text": "Some research has documented the phenomenon of leather families as a form of intentional, chosen families created by members of sexual and gender minority groups, often in the face of biological family rejection and marginalization in society (Bauer, 2010; Hammack et al., 2019; Murphy & Bjorngaard, 2019; Pitagora, 2016). Leather families are a network of people that acknowledge and practice ongoing supportive relationships “while sharing the commonalities of the leather and kink scene” (Bannon, 2016). […] Very few studies have examined how many people are members of leather or other “chosen” families."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "leather",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b27dfcad-0cf8-3951-9e2d-7973e9a0158a",
                                        "entry_id": "34dc82b4-6329-3517-9bd8-6ac84913afdf",
                                        "glosses": [
                                            "To cover with leather."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "43ee4e90-1d33-4d7f-a546-a402aec14987",
                                                "sense_id": "b27dfcad-0cf8-3951-9e2d-7973e9a0158a",
                                                "text": "He rose and leathered his Colt as his father came to stand beside him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "596cbf1c-5d35-313a-9af2-73a17b3032c9",
                                        "entry_id": "34dc82b4-6329-3517-9bd8-6ac84913afdf",
                                        "glosses": [
                                            "To form a leathery surface (on)."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "475cabdf-a2e8-45e2-a77b-8a6c2bc5a5d3",
                                                "sense_id": "596cbf1c-5d35-313a-9af2-73a17b3032c9",
                                                "text": "By the appearance of his deep suntan, which had leathered his skin, and the calluses that covered his hands, Sheriff Anderson figured the man to be one of the area ranchers."
                                            },
                                            {
                                                "example_id": "d641ba41-7a7e-4398-abc5-6fa3093f57dd",
                                                "sense_id": "596cbf1c-5d35-313a-9af2-73a17b3032c9",
                                                "text": "Some leather and droop like bat wings, others, as the poet Brenda Hillman writes, are 'hung in hashtags'."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "58e9844e-4238-348b-91ff-778f6d27954b",
                                        "entry_id": "34dc82b4-6329-3517-9bd8-6ac84913afdf",
                                        "glosses": [
                                            "To strike forcefully."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f4b02718-77e4-4611-9977-7409f0fa0aa5",
                                                "sense_id": "58e9844e-4238-348b-91ff-778f6d27954b",
                                                "text": "He leathered the ball all the way down the street."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a2854382-4475-3e8f-a09d-a95ba89aa867",
                                        "entry_id": "34dc82b4-6329-3517-9bd8-6ac84913afdf",
                                        "glosses": [
                                            "To spank or beat with a leather belt or strap."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ee2785e4-7be2-40cb-802a-4215727a7319",
                                                "sense_id": "a2854382-4475-3e8f-a09d-a95ba89aa867",
                                                "text": "My father was very angry with me— -he took and leathered ( beat) me, because I ran away from my school ; for I did run away from my school ; he took and tied me up on a Sunday morning, leathered me a Friday night, and Saturday night : I was stripped naked when he leathered me on Friday night, and Saturday; my father told me to strip myself, and he leathered me, it was with a whip; but I do not know where he got the whip; he tied me with my arms extended so -- (spreading out her arms to their extremity, as if they were to be nailed upon a cross) -- My legs were tied too -- I was at the bottom of the dresser."
                                            },
                                            {
                                                "example_id": "1513a008-75e4-4301-8a35-31f841d912b5",
                                                "sense_id": "a2854382-4475-3e8f-a09d-a95ba89aa867",
                                                "text": "My father was furious with me and reached for the strap. He brutally leathered me with it before sending me to bed for the night."
                                            },
                                            {
                                                "example_id": "1781793d-bbff-40c5-a746-66c79b5a437d",
                                                "sense_id": "a2854382-4475-3e8f-a09d-a95ba89aa867",
                                                "text": "Anyway, bums were always on view in our family, getting leathered with a heavy belt."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e7e878a0-de16-4268-b8b0-fab7fd74d60d",
                        "source_entry_id": "51215b47-4a34-3c54-a0f9-18b3d64e3563",
                        "source_sense_id": "c424d13f-b98d-3e27-8d05-8160c6caf31c",
                        "target_lang_word": "skaï",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "skaï",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0c63d389-a06d-3011-b732-d072412e6dad",
                                        "entry_id": "6d312b08-0d39-3f84-935a-bd1137de6ceb",
                                        "glosses": [
                                            "Tissu enduit qui imite le cuir, même s’il n’est pas de la marque Skaï®/Skai®."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d0a1a477-1089-4a9c-9868-1f3c4ec9ed55",
                                                "sense_id": "0c63d389-a06d-3011-b732-d072412e6dad",
                                                "text": "Un bustier en skaï."
                                            },
                                            {
                                                "example_id": "379efe48-611b-4846-a3ca-26b19b4aeabf",
                                                "sense_id": "0c63d389-a06d-3011-b732-d072412e6dad",
                                                "text": "Elle m’a fait penser à une fleur étrange, munie d’antennes translucides et d’un cœur en skaï mauve…"
                                            },
                                            {
                                                "example_id": "cbaef321-b8e1-4922-86c6-a11b02e2ec59",
                                                "sense_id": "0c63d389-a06d-3011-b732-d072412e6dad",
                                                "text": "Devant l’entrée d’Auchan au niveau 1, au bas du grand tapis roulant central à double sens, il y a un espace agencé comme un petit salon d’attente, avec des sièges en skaï marron, inversés comme des causeuses. Ils sont rarement vides, occupés souvent le matin par des chibanis."
                                            },
                                            {
                                                "example_id": "e21ae7da-8c09-4b49-9f85-2ad88c3618c3",
                                                "sense_id": "0c63d389-a06d-3011-b732-d072412e6dad",
                                                "text": "C'était une Honda Twin TII 125 cm3 bicylindre d’occasion, achetée 4 500 francs (700 €) à un boucher de la rue Pierre Legrand à Fives. Elle me servait jusque-là pour aller au lycée, et je m'étais équipé pour le voyage avec ce qui existait de moins cher : une sacoche de réservoir en skaï noir, deux sacoches arrières en skaï noir munies d'une structure rigide, mi-carton, mi-métal et un blouson - en skaï noir, pardi !"
                                            },
                                            {
                                                "example_id": "4493bc05-0c9e-4acc-b297-d8f47306e3e7",
                                                "sense_id": "0c63d389-a06d-3011-b732-d072412e6dad",
                                                "text": "Il soupait à 18h30 & s’affaissait dans le fauteuil en skaï marron clair, enchaînait le jeu avec le journal, s’endormait devant le film."
                                            },
                                            {
                                                "example_id": "3dd97096-c3b9-447e-921f-e7cb221af6d4",
                                                "sense_id": "0c63d389-a06d-3011-b732-d072412e6dad",
                                                "text": "La jeune femme frappait méthodiquement les pattes d'ours de skaï rouge que le jeune homme brandissait à hauteur d'épaule. Jambes ﬂéchies il accueillait les coups. chocs brefs et sans écho, skaï contre skaï […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3526c138-3d81-428a-9c97-f5f06b1b0a8f",
                        "source_entry_id": "51215b47-4a34-3c54-a0f9-18b3d64e3563",
                        "source_sense_id": "c424d13f-b98d-3e27-8d05-8160c6caf31c",
                        "target_lang_word": "similicuir",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "similicuir",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7eb0353c-6eb6-3e32-9dcc-991005acf0f3",
                                        "entry_id": "e64d9594-f210-3778-87e9-756d5a9a001b",
                                        "glosses": [
                                            "Variante orthographique de simili-cuir."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6df2658b-6428-4613-ad47-95a9ddf4fd40",
                                                "sense_id": "7eb0353c-6eb6-3e32-9dcc-991005acf0f3",
                                                "text": "J’ai attendu cinq minutes de plus, l’imaginant en train de prendre congé de ses étudiants, d’échanger quelques mots avec les retardataires, de ranger ses cours et tout son barda dans un vieux cartable en similicuir."
                                            },
                                            {
                                                "example_id": "02ac5bfc-1aaf-42e5-b9a4-b34465eb6d94",
                                                "sense_id": "7eb0353c-6eb6-3e32-9dcc-991005acf0f3",
                                                "text": "Sous le similicuir, la mousse s’émiette..."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
