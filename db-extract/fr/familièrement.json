        "fr-extract.jsonl": [
            {
                "entry_id": "63a31d08-2f21-3682-9d83-ce0279ec6b97",
                "word": "familièrement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "60bf6b1b-06e8-301c-a6ee-4ff6198cb0ab",
                        "entry_id": "63a31d08-2f21-3682-9d83-ce0279ec6b97",
                        "glosses": [
                            "D’une manière familière."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "76e6fd6e-e1f1-4017-b405-3021b84ed4e7",
                                "sense_id": "60bf6b1b-06e8-301c-a6ee-4ff6198cb0ab",
                                "text": "Je n'oublierai pas même plusieurs petites circonstances qu’un historien omettrait sans doute, mais qu’un ami, ce me semble, peut dire familièrement à son ami."
                            },
                            {
                                "example_id": "510f1c33-00e9-4b0c-8e86-33cfcb53a02e",
                                "sense_id": "60bf6b1b-06e8-301c-a6ee-4ff6198cb0ab",
                                "text": "Suétone rapporte ce que les premiers empereurs de Rome avaient fait de plus secret ; mais avait-il vécu familièrement avec douze Césars ?"
                            },
                            {
                                "example_id": "30f2ed0c-41be-474e-a199-8e9f9117ea97",
                                "sense_id": "60bf6b1b-06e8-301c-a6ee-4ff6198cb0ab",
                                "text": "J'ai vu, ces jours-ci, le roi de Prusse, et je l’ai vu comme on ne voit guère les rois, fort à mon aise, dans ma chambre, au coin de mon feu, où ce même homme qui a gagné deux batailles venait causer familièrement comme Scipion avec Térence."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9a0f0544-82cb-4154-9cef-2b90e9776e09",
                        "source_entry_id": "63a31d08-2f21-3682-9d83-ce0279ec6b97",
                        "source_sense_id": "60bf6b1b-06e8-301c-a6ee-4ff6198cb0ab",
                        "target_lang_word": "colloquially",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "colloquially",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "31fee554-e5b9-37cb-8c06-e9482d7a5301",
                                        "entry_id": "0b2152fc-b259-372e-8ab7-dc352ecdd0c8",
                                        "glosses": [
                                            "In a colloquial manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86ce24d7-6819-46c0-84b6-196ecd68cac8",
                                                "sense_id": "31fee554-e5b9-37cb-8c06-e9482d7a5301",
                                                "text": "Known colloquially as the \"El,\" the elevated lines constituted the earliest attempt to remove urban passenger traffic from the streets."
                                            },
                                            {
                                                "example_id": "ce84bd65-618a-4eeb-91a5-ddaaa1dd98c3",
                                                "sense_id": "31fee554-e5b9-37cb-8c06-e9482d7a5301",
                                                "text": "Cattle, colloquially referred to as cows, are domesticated ungulates."
                                            },
                                            {
                                                "example_id": "6f08880c-2e88-4a0f-becc-5c51c9eace88",
                                                "sense_id": "31fee554-e5b9-37cb-8c06-e9482d7a5301",
                                                "text": "The technical term for the event is “coupling,” but it is known colloquially as the “Shinkansen kiss.” For Japanese rail fans, it’s a big deal. For foreigners, it is a unique insight into the quintessentially Japanese experience of trainspotting."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d2a6b91d-9e5e-454d-a212-5e2e4b0e8600",
                        "source_entry_id": "63a31d08-2f21-3682-9d83-ce0279ec6b97",
                        "source_sense_id": "60bf6b1b-06e8-301c-a6ee-4ff6198cb0ab",
