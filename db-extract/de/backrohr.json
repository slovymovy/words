                "senses": [
                    {
                        "sense_id": "804ea406-d32d-3e74-af03-9b5f517e5400",
                        "entry_id": "4dc2b4a9-4ff3-3a2c-a19e-571de94a92ae",
                        "glosses": [
                            "großes Haushaltsgerät, in dem starke Hitze erzeugt wird, um Essen zu erhitzen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e88debd4-51c4-4e56-a006-f876c2b3c35e",
                                "sense_id": "804ea406-d32d-3e74-af03-9b5f517e5400",
                                "text": "„[Anita Painhofer:] Oder schneiden Sie Kartoffeln in ganz dünne Scheiben, geben Sie sie mit einem Löffel Olivenöl und getrockneten oder frischen Kräutern ins Backrohr, zum Schluss noch ein paar Salzkörner drauf – und Sie haben ganz köstliche gesunde Chips.“"
                            },
                            {
                                "example_id": "622cec2a-97c6-4a71-93f4-81dda6532ee2",
                                "sense_id": "804ea406-d32d-3e74-af03-9b5f517e5400",
                                "text": "„Er trank den wässerigen Rest des Cocktails aus und ging in die Küche, schloß Tür und Fenster und öffnete das Backrohr des Gasherds.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
