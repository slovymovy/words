{
    "word_family": [
        "liquefy",
        "liquefaction",
        "liquidity",
        "liquidize",
        "liquidly"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8f26804c-3906-387a-9a2f-fb5db06e1901",
                    "sense_definition": "A substance that flows freely and has no fixed shape, like water or oil.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "physical_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Water is the most common <w>liquid</w> found on our planet.",
                            "target_lang_translations": {
                                "ru": "Вода — самая распространенная <w>жидкость</w> на нашей планете.",
                                "zh": "水是我们星球上最常见的<w>液体</w>。"
                            }
                        },
                        {
                            "text": "The doctor advised him to drink plenty of <w>liquids</w> while he was sick.",
                            "target_lang_translations": {
                                "ru": "Врач посоветовал ему пить много <w>жидкости</w>, пока он болел.",
                                "zh": "医生建议他在生病期间多喝<w>流质</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "fluid"
                    ],
                    "antonyms": [
                        "solid"
                    ],
                    "common_phrases": [
                        "drink plenty of liquids",
                        "flammable liquid",
                        "hot liquid"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вещество, которое свободно течет и не имеет фиксированной формы, как вода или масло.",
                        "zh": "一种可以自由流动且没有固定形状的物质，如水或油。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жи́дкость",
                                "target_lang_sense_clarification": "вещество"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "液体",
                                "target_lang_sense_clarification": "物质状态"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c4b6ed4d-1df5-36d8-85dc-a3e83c6a19f1",
                    "sense_definition": "A type of consonant sound, such as 'l' or 'r', that is produced without friction.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "linguistics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In phonetics, a <w>liquid</w> is a sound that flows smoothly compared to other consonants.",
                            "target_lang_translations": {
                                "ru": "В фонетике <w>плавный звук</w> — это звук, который течет плавно по сравнению с другими согласными.",
                                "zh": "在语音学中，<w>流音</w>是一种与其他辅音相比发音更平滑的声音。"
                            }
                        },
                        {
                            "text": "The student struggled to pronounce the <w>liquid</w> at the end of the word correctly.",
                            "target_lang_translations": {
                                "ru": "Студенту было трудно правильно произнести <w>плавный звук</w> в конце слова.",
                                "zh": "学生很难正确发出单词末尾的那个<w>流音</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "technical (linguistics)"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Тип согласного звука, такого как 'л' или 'р', который произносится без трения.",
                        "zh": "一种辅音类型，如“l”或“r”，发音时没有摩擦。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пла́вный звук",
                                "target_lang_sense_clarification": "лингвистика"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "流音",
                                "target_lang_sense_clarification": "语言学"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "6030e4bc-cd5e-3836-b1d1-42a0369c3541",
                    "sense_definition": "In a form that flows easily and is neither solid nor gas.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "physical_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ice melted quickly and turned into <w>liquid</w> water.",
                            "target_lang_translations": {
                                "ru": "Лед быстро растаял и превратился в <w>жидкую</w> воду.",
                                "zh": "冰很快融化并变成了<w>液态</w>水。"
                            }
                        },
                        {
                            "text": "We need to refill the dispenser with <w>liquid</w> soap before the guests arrive.",
                            "target_lang_translations": {
                                "ru": "Нам нужно наполнить дозатор <w>жидким</w> мылом до прихода гостей.",
                                "zh": "客人到达之前，我们需要往分配器里补充<w>液体</w>肥皂。"
                            }
                        }
                    ],
                    "synonyms": [
                        "fluid",
                        "runny"
                    ],
                    "antonyms": [
                        "solid",
                        "gaseous"
                    ],
                    "common_phrases": [
                        "liquid soap",
                        "liquid nitrogen",
                        "liquid state"
                    ],
                    "target_lang_definitions": {
                        "ru": "В форме, которая легко течет; не твердый и не газообразный.",
                        "zh": "处于容易流动的状态，既不是固体也不是气体。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жи́дкий",
                                "target_lang_sense_clarification": "текучий"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "液态的",
                                "target_lang_sense_clarification": "物理状态"
                            },
                            {
                                "target_lang_word": "液体的",
                                "target_lang_sense_clarification": "形容词"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0afd1cd0-d97a-3291-8eb4-5a85082a5af4",
                    "sense_definition": "Relating to assets that can be easily converted into cash without losing value.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "financial",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company keeps some <w>liquid</w> assets available to pay for unexpected expenses.",
                            "target_lang_translations": {
                                "ru": "Компания держит некоторые <w>ликвидные</w> активы доступными для оплаты непредвиденных расходов.",
                                "zh": "公司保留了一些<w>流动</w>资产以支付意外开支。"
                            }
                        },
                        {
                            "text": "Real estate is generally not considered a very <w>liquid</w> investment compared to stocks.",
                            "target_lang_translations": {
                                "ru": "Недвижимость обычно не считается очень <w>ликвидной</w> инвестицией по сравнению с акциями.",
                                "zh": "与股票相比，房地产通常不被认为是一种<w>流动性</w>很高的投资。"
                            }
                        }
                    ],
                    "antonyms": [
                        "illiquid"
                    ],
                    "common_phrases": [
                        "liquid assets",
                        "liquid market",
                        "stay liquid"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "business/finance"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к активам, которые можно легко превратить в наличные без потери стоимости.",
                        "zh": "指可以轻松转换为现金而不损失价值的资产。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ликви́дный",
                                "target_lang_sense_clarification": "финансы"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "流动性强的",
                                "target_lang_sense_clarification": "金融"
                            },
                            {
                                "target_lang_word": "变现能力强的",
                                "target_lang_sense_clarification": "金融"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "77d88f1e-2787-3f9a-80a3-84528efb03a1",
                    "sense_definition": "Clear, smooth, and flowing gracefully, often describing sounds or eyes.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "literary_description",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bird sang a beautiful, <w>liquid</w> melody from the high branch of the tree.",
                            "target_lang_translations": {
                                "ru": "Птица пела красивую, <w>мелодичную</w> мелодию с высокой ветки дерева.",
                                "zh": "鸟儿在树的高枝上唱出了一段优美、<w>圆润</w>的旋律。"
                            }
                        },
                        {
                            "text": "She looked at him with large, <w>liquid</w> eyes full of deep emotion.",
                            "target_lang_translations": {
                                "ru": "Она смотрела на него большими <w>влажными</w> глазами, полными глубоких эмоций.",
                                "zh": "她用那双充满深情、<w>清澈</w>的大眼睛看着他。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "liquid eyes",
                        "liquid notes"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "literary"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Чистый, гладкий и грациозно текущий; часто описывает звуки или глаза.",
                        "zh": "清晰、平滑且优雅地流动，常用于描述声音或眼睛。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вла́жный",
                                "target_lang_sense_clarification": "о глазах"
                            },
                            {
                                "target_lang_word": "мелоди́чный",
                                "target_lang_sense_clarification": "о звуках"
                            },
                            {
                                "target_lang_word": "прозра́чный",
                                "target_lang_sense_clarification": "чистый"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "清澈的",
                                "target_lang_sense_clarification": "形容眼睛"
                            },
                            {
                                "target_lang_word": "圆润的",
                                "target_lang_sense_clarification": "形容声音"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a160f8e9-cc5d-38c8-b526-06c820d7bdfe",
                    "sense_definition": "Belonging to a class of consonants, such as 'l' and 'r', that flow without friction.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "linguistics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In English, the sounds /l/ and /r/ are classified as <w>liquid</w> consonants.",
                            "target_lang_translations": {
                                "ru": "В английском языке звуки /l/ и /r/ классифицируются как <w>плавные</w> согласные.",
                                "zh": "在英语中，/l/ 和 /r/ 音被归类为<w>流音</w>辅音。"
                            }
                        },
                        {
                            "text": "The linguist explained how <w>liquid</w> sounds behave differently in various languages.",
                            "target_lang_translations": {
                                "ru": "Лингвист объяснил, как <w>плавные</w> звуки ведут себя по-разному в различных языках.",
                                "zh": "语言学家解释了<w>流音</w>在不同语言中是如何表现出不同特征的。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "liquid consonants"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "technical (linguistics)"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к классу согласных, таких как 'л' и 'р', которые текут без трения.",
                        "zh": "属于一类辅音，如“l”和“r”，发音时气流无摩擦。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пла́вный",
                                "target_lang_sense_clarification": "лингвистика"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "流音的",
                                "target_lang_sense_clarification": "语言学"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}