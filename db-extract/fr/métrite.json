        "fr-extract.jsonl": [
            {
                "entry_id": "4c9c41f4-5a40-37a2-9665-5b84c2053ce6",
                "word": "métrite",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "4ec53eb3-f02e-4a7f-98ae-66937e9551c0",
                        "entry_id": "4c9c41f4-5a40-37a2-9665-5b84c2053ce6",
                        "tags": [
                            "plural"
                        ],
                        "form": "métrites"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "bf4a7010-2258-3161-b98b-7c10087f0b2d",
                        "entry_id": "4c9c41f4-5a40-37a2-9665-5b84c2053ce6",
                        "glosses": [
                            "Inflammation de la matrice ou utérus."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "79263a91-fc25-4785-99b0-f6eeee524248",
                                "sense_id": "bf4a7010-2258-3161-b98b-7c10087f0b2d",
                                "text": "Le lendemain, le médecin vint, l’examina ; c’était une métrite, et sérieuse ; il fallait lui faire un curetage."
                            },
                            {
                                "example_id": "58866be8-b4ca-4586-aaba-ed40ea3d0df9",
                                "sense_id": "bf4a7010-2258-3161-b98b-7c10087f0b2d",
                                "text": "Les métrites sont des inflammations de l'utérus dues à la multiplication de germes. Elles se caractérisent par un écoulement de pus au niveau de la vulve. Une vache atteinte de métrite ne peut évidemment pas être fécondée. Le plus souvent, les métrites se traitent par instillation locale d’antibiotiques ou de sulfamides. Il importe surtout que l’éleveur prévienne l’apparition des métrites."
                            },
                            {
                                "example_id": "7065bb2e-16f1-431f-8ead-8eecddd1a875",
                                "sense_id": "bf4a7010-2258-3161-b98b-7c10087f0b2d",
                                "text": "L’infection de l’utérus, ou métrite. Après la mise bas d’un petit en bonne santé, un liquide clair ou contenant du sang, qui ne sent pas mauvais, s’écoule souvent du vagin. Mais un écoulement blanc-jaunâtre ou qui sent mauvais est un signe d’infection de l’utérus. C’est une métrite ; les animaux l’ont souvent peu après la mise bas. La transmission a lieu à l’utérus par la vulve et le vagin, surtout quand la mise bas a eu lieu dans un endroit sale. Les animaux ont souvent une métrite quand le placenta n’a pas été éliminé."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7abb7f62-189f-43dd-959b-485bd4846871",
                        "source_entry_id": "4c9c41f4-5a40-37a2-9665-5b84c2053ce6",
                        "source_sense_id": "bf4a7010-2258-3161-b98b-7c10087f0b2d",
                        "target_lang_word": "metritis",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "metritis",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d6122543-be50-37ec-ad29-359abf06ca8d",
                                        "entry_id": "2546c20f-54e6-367f-be68-4bc23d2e7441",
                                        "glosses": [
                                            "Inflammation of the uterus."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b85091b7-adb1-4d07-8d26-8b91db88c6e0",
                                                "sense_id": "d6122543-be50-37ec-ad29-359abf06ca8d",
                                                "text": "The conjunctive tissue, young and succulent, then becomes hard and fibrous, and the uterus, on section, is pale, indurated and devoid of blood; that is chronic metritis which has reached the second period, or period of induration."
                                            },
                                            {
                                                "example_id": "ddbb868a-68a7-495e-a7c3-a3722632d383",
                                                "sense_id": "d6122543-be50-37ec-ad29-359abf06ca8d",
                                                "text": "The use of systemic antibiotics is justified and often required for metritis that causes systemic illness."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
