                "senses": [
                    {
                        "sense_id": "49769250-c125-3af2-9a57-bf148b24d699",
                        "entry_id": "3e7c6767-6368-353c-9407-4632eae2ce52",
                        "glosses": [
                            "Nahrung für Säuglinge und Kleinkinder in Form einer feinen Masse"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2cdf0dd5-312b-4ab2-b137-bd3c00103d90",
                                "sense_id": "49769250-c125-3af2-9a57-bf148b24d699",
                                "text": "„Dort gab es alles, was Menschen zwischen null und neunundneunzig Jahren benötigten: von Babybrei über Windeln bis hin zu Zigaretten und Alkohol.“"
                            },
                            {
                                "example_id": "49e48eae-916c-41ea-aa85-995c67b55390",
                                "sense_id": "49769250-c125-3af2-9a57-bf148b24d699",
                                "text": "„Nach und nach werden dann weitere Lebensmittel zum glatt pürierten Babybrei hinzugefügt.“"
                            },
                            {
                                "example_id": "acdbd235-507d-4610-9b11-66357656aac3",
                                "sense_id": "49769250-c125-3af2-9a57-bf148b24d699",
                                "text": "„Allyson kratzte den nächsten Löffel Babybrei zusammen und versuchte, ein Lächeln zu unterdrücken.“"
                            },
                            {
                                "example_id": "d489d82a-aba7-4d17-9067-38b507b3a6ce",
                                "sense_id": "49769250-c125-3af2-9a57-bf148b24d699",
                                "text": "„In einem Supermarkt einige Blocks westlich des Burger King ergänzte er den Vorrat an Wasser, Windeln, Babybrei in Gläsern und Eistee.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
