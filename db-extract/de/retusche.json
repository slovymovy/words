                    {
                        "translation_id": "5d57ab85-3dc1-45ef-9129-e6db839a1728",
                        "source_entry_id": "9cb1eddc-97d4-37a2-8de9-2355c1d578a6",
                        "source_sense_id": "037c03c1-6f46-3284-8977-e2f691157387",
                        "source_sense_description": "das nachträgliche Verändern einer Fotografie oder eines Bildes",
