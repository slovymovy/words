                "senses": [
                    {
                        "sense_id": "325cd598-74a1-3820-9f9a-f0913efa1952",
                        "entry_id": "1a9471c2-9983-3e2e-8863-f7902156cd25",
                        "glosses": [
                            "Procédé d'improvisation consistant en l'adjonction de deux voix parallèles à une mélodie préexistante, souvent grégorienne, formant un accord de sixte se déplaçant sur les différents degrés de l'échelle musicale."
                        ],
                        "tags": [
                            "Musique médiévale"
                        ],
                        "examples": [
                            {
                                "example_id": "be1cd5b0-deb1-458d-9f3e-610a822eae77",
                                "sense_id": "325cd598-74a1-3820-9f9a-f0913efa1952",
                                "text": "Chanter en faux-bourdon."
                            },
                            {
                                "example_id": "8704577b-72ed-4e99-8f76-7260db93d848",
                                "sense_id": "325cd598-74a1-3820-9f9a-f0913efa1952",
                                "text": "Je l’accordais avec assez de justesse d’oreille, et le bon père qui, autrefois, avait été renommé à Notre-Dame pour chanter et enseigner le faux-bourdon, me faisait apprendre un vieux solfège."
                            },
                            {
                                "example_id": "4e2860dc-6b36-4c70-8569-5b6ec4f40286",
                                "sense_id": "325cd598-74a1-3820-9f9a-f0913efa1952",
                                "text": "Quelle musique, si ample ou si douloureuse ou si tendre qu’elle fût, valait le De profundis chanté en faux-bourdon […] ?"
                            }
                        ]
                    }
