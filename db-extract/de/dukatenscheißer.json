                "senses": [
                    {
                        "sense_id": "b9e4154a-0ad2-3433-921e-9549ba82a9a1",
                        "entry_id": "1abda809-6525-329b-89b8-823b2f177d25",
                        "glosses": [
                            "jemand, der unbegrenzt Geld erschafft/erarbeitet oder auch jemand, der sich gut mit Finanzen und Geldangelegenheiten auskennt; jemand, der weiß, wie man Geld vermehrt"
                        ],
                        "tags": [
                            "colloquial",
                            "humorous"
                        ],
                        "examples": [
                            {
                                "example_id": "e5a1d936-0aad-40e4-8348-dc7b1380766f",
                                "sense_id": "b9e4154a-0ad2-3433-921e-9549ba82a9a1",
                                "text": "„Betriebsleiter Wuttke von links; im Eingang mehrere Bauarbeiter. Wuttke zu Arbeitern: Bin ich dran schuld? Erster Arbeiter: Du und der Dukatenscheißer! Wuttke: Es fallen öfters Leute vom Gerüst. Zweiter Arbeiter: Nich drei in einer Nacht!“"
                            },
                            {
                                "example_id": "0d429438-fa56-407b-8d9a-b2688bab3f6a",
                                "sense_id": "b9e4154a-0ad2-3433-921e-9549ba82a9a1",
                                "text": "„Darüber hinaus werden auch verschiedene Kuriositäten wie z. B. der Dukatenscheißer, das Ungeheuer und die Völlerei von der Trunksucht befördert gezeigt, die als Gefäße und Behälter dienten.“"
                            },
                            {
                                "example_id": "c11e7d5e-b281-4dd0-9dda-fe37dcaf68fe",
                                "sense_id": "b9e4154a-0ad2-3433-921e-9549ba82a9a1",
                                "text": "Ich bin doch kein Dukatenscheißer!"
                            },
                            {
                                "example_id": "0d2aaf36-b40f-45f5-ab42-5c325e798269",
                                "sense_id": "b9e4154a-0ad2-3433-921e-9549ba82a9a1",
                                "text": "Ich hab doch keinen Dukatenscheißer in der Ecke stehen!"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
