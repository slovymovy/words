                    "sense_id": "a63648e5-aed7-37fa-8c26-fa9c08adff7e",
                    "sense_definition": "eerste persoon enkelvoud tegenwoordige tijd van <w>duisteren</w>",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>duister</w> de kamer wanneer ik ga slapen.",
                            "target_lang_translations": {
                                "en": "I <w>darken</w> the room when I go to sleep."
                            }
                        },
                        {
                            "text": "Als ik de gordijnen sluit, <w>duister</w> ik de hele ruimte.",
                            "target_lang_translations": {
                                "en": "When I close the curtains, I <w>black out</w> the entire space."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "verb form"
                        }
                    ],
                    "target_lang_definitions": {
