                        "examples": [
                            {
                                "example_id": "00f6b35f-b51c-47fd-8737-4b971cac41d8",
                                "sense_id": "cb67f2a8-7c97-3b5c-814b-eac4ce3953a0",
                                "text": "A better and more straightforward appeal, though less cool, was made to him by Hugh Kelly, - - - The play was so successful, and Garrick said so much of it that Lord Pembroke was eager to be back from Paris to see it, though he said, with true aristocratic pride, that he could expect very little from such a name as \"Kelly\", especially if there be an \"O'\" before it."
                            }
                        ]
                    },
                    {
                        "sense_id": "a0481acd-ad3f-32c8-8a15-a1dc723b64e2",
                        "entry_id": "f1f43774-36d2-3857-96e3-9549250826c2",
                        "glosses": [
                            "A unisex given name transferred from the surname.",
                            "A male given name transferred from the surname."
