            {
                "entry_id": "3cba4698-3f62-30e1-828b-076e3c918ead",
                "word": "gracilité",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "4fafd550-4d47-4779-919a-fd8626d76620",
                        "entry_id": "3cba4698-3f62-30e1-828b-076e3c918ead",
                        "tags": [
