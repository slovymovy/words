                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bc1731be-bf92-3684-a054-c87e17764807",
                                        "entry_id": "6dc9fdff-67f3-3eea-89ca-947c9bc7ee1b",
                                        "glosses": [
                                            "Matelote spécialisée qui se trouve à la barre ou à tout autre appareil agissant sur le gouvernail."
                                        ],
                                        "tags": [
                                            "Navigation"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "57059b21-55b5-4d5d-8087-0d088c402050",
                                                "sense_id": "bc1731be-bf92-3684-a054-c87e17764807",
                                                "text": "Hardie navigatrice, notre timonière préfère personnellement la solution maritime à la solution fluviale, mais, amoureuse, elle est soucieuse du bien être de son tendre époux de tabellion, qui n’a pas le pied marin et qui a une horreur consommée des coups de chien."
                                            },
                                            {
                                                "example_id": "6d33020c-2357-475a-8556-2c90c92d1660",
                                                "sense_id": "bc1731be-bf92-3684-a054-c87e17764807",
                                                "text": "La timonière, la tête haute, le front droit, tient la barre de gouvernail avec assurance."
                                            },
                                            {
                                                "example_id": "2f23ae2c-6168-4a74-b01e-a2637222139c",
                                                "sense_id": "bc1731be-bf92-3684-a054-c87e17764807",
                                                "text": "A Hongkong, une timonière en eaux troubles"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3e891ef3-e984-32c7-ac6b-074f55c12cee",
                                        "entry_id": "6dc9fdff-67f3-3eea-89ca-947c9bc7ee1b",
                                        "glosses": [
                                            "Conductrice, guide."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5e9222c2-dca9-4e5f-8123-01a0201e0d99",
                                                "sense_id": "3e891ef3-e984-32c7-ac6b-074f55c12cee",
                                                "text": "Sept personnes de tous âges, de toutes provenances, tant du grand Montréal que d’ailleurs au Québec, « réfléchiront » ensemble sous la conduite de notre timonière"
                                            },
                                            {
                                                "example_id": "affc5a43-91bd-4008-996d-87d2bfebd23e",
                                                "sense_id": "3e891ef3-e984-32c7-ac6b-074f55c12cee",
                                                "text": "L’Université de Fribourg a sa timonière. Astrid Epiney, rectrice"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ef08aff5-1022-4d8d-be5c-f53a15a97152",
                        "source_entry_id": "22ca4a68-d7d4-351e-9724-33cdadd917cb",
