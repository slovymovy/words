                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "das Gesundheitswesen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "70aa691d-b5e3-3942-b27a-2d88c96eeec9",
                        "entry_id": "25ac3b71-d67b-30c1-b75f-3f735be807b8",
                        "glosses": [
                            "die Gesamtheit aller Einrichtungen, Personen, Regelungen und Prozesse, die mit der Förderung und Erhaltung der Gesundheit des Menschen zu tun haben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e46d3b3d-3b9d-4a09-badb-20a8d06313df",
                                "sense_id": "70aa691d-b5e3-3942-b27a-2d88c96eeec9",
                                "text": "„Dem deutschen Gesundheitswesen fehlt es nicht an Geld, aber das Geld ist häufig nicht dort, wo es gebraucht wird.“"
                            },
                            {
                                "example_id": "f9e3ac02-d5cd-4dc6-9ea2-d34967a1ec97",
                                "sense_id": "70aa691d-b5e3-3942-b27a-2d88c96eeec9",
                                "text": "„Was die soziale Wirklichkeit der DDR in ihren späten Jahren vor allem kennzeichnete, waren häufige Altersarmut und grassierende Wohnungsnot, wachsender Pflegenotstand und die zunehmende Überforderung des Gesundheitswesens.“"
                            },
                            {
                                "example_id": "66bc060c-7c08-4f8f-a447-1bc9a83e9ba6",
                                "sense_id": "70aa691d-b5e3-3942-b27a-2d88c96eeec9",
                                "text": "„Zu dieser Zeit der Karageorgewitsch war das ganze öffentliche Gesundheitswesen auf die Feldschere angewiesen…“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
