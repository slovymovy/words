                {
                    "sense_id": "605589a0-479b-35fe-8107-f95e9866fe6c",
                    "sense_definition": "A very large amount of money.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "wealth",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "That vintage car must be worth a <w>fortune</w> in today's market.",
                            "target_lang_translations": {
                                "ru": "Этот ретро-автомобиль, должно быть, стоит <w>целое состояние</w> на сегодняшнем рынке.",
                                "de": "Dieser Oldtimer muss auf dem heutigen Markt ein <w>Vermögen</w> wert sein.",
                                "zh": "在今天的市场上，那辆老爷车一定值<w>一大笔钱</w>。",
                                "es": "Ese coche clásico debe valer una <w>fortuna</w> en el mercado actual."
                            }
                        },
                        {
                            "text": "He spent a small <w>fortune</w> on renovations for his new house.",
                            "target_lang_translations": {
                                "ru": "Он потратил небольшое <w>состояние</w> на ремонт своего нового дома.",
                                "de": "Er hat ein kleines <w>Vermögen</w> für die Renovierung seines neuen Hauses ausgegeben.",
                                "zh": "他为新房装修花了<w>一大笔钱</w>。",
                                "es": "Gastó una pequeña <w>fortuna</w> en las reformas de su nueva casa."
                            }
                        }
                    ],
                    "synonyms": [
                        "bundle",
                        "pile",
                        "wealth",
                        "a lot of money"
                    ],
                    "common_phrases": [
