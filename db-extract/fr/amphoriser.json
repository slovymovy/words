                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dbd2ccd0-1f8f-4b78-84c8-c5e44535e606",
                                "sense_id": "825e6557-ff31-37ad-9679-55a9fc549aed",
                                "text": "L'aquarium de ses yeux amphorise un bruit de bulles bleutées."
