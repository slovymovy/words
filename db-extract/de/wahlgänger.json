                "senses": [
                    {
                        "sense_id": "4922c16f-2d71-313a-bd00-4b20f4c3a306",
                        "entry_id": "d1111d55-6b0d-3d1b-887a-a7118e156982",
                        "glosses": [
                            "Person, die an einer Wahl teilnimmt/teilnahm"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7263beb6-8e8f-4dd0-b298-8f238312df4c",
                                "sense_id": "4922c16f-2d71-313a-bd00-4b20f4c3a306",
                                "text": "„Tatsächlich aber sind die Mormonen Romneys treueste Truppe. Sie machen in Nevada zwar nur knapp acht Prozent der Bevölkerung aus, gelten aber als motivierte Wahlgänger.“"
                            },
                            {
                                "example_id": "3b569d8f-8a43-459a-b54b-b7e391299aef",
                                "sense_id": "4922c16f-2d71-313a-bd00-4b20f4c3a306",
                                "text": "„Gleichzeitig zeichnet sich kein Rückgang der regelmäßigen Wahlgänger ab (55 % im Jahr 1995, 47% im Jahr 2002).“"
                            },
                            {
                                "example_id": "6aabbc65-7e5f-4010-90b7-6531e2f4835f",
                                "sense_id": "4922c16f-2d71-313a-bd00-4b20f4c3a306",
                                "text": "„Ohne eine weitere Information über die Aufteilung der Wahlgänger nach Geschlechtern, die man - genauso wie das Resultat - erst nach der Wahl weiß, lässt sich diese Frage nicht wirklich beantworten.“"
                            },
                            {
                                "example_id": "533e46da-18db-45e4-908c-69ff8d9fe7f2",
                                "sense_id": "4922c16f-2d71-313a-bd00-4b20f4c3a306",
                                "text": "„Auch viele Wahlgänger trauen den politischen Botschaften immer weniger.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
