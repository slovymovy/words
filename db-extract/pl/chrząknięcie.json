                        "translation_id": "7818157a-9f0b-4212-8310-85bed9685e04",
                        "source_entry_id": "b4192030-54ec-3316-b987-cc101f02e51a",
                        "source_sense_id": "01ec8bdf-ff66-36c1-8b68-0fd1d1f7f139",
                        "target_lang_word": "grunt",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grunt",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "df77bb73-d1c7-3a84-8ebc-83aafe81896e",
                                        "entry_id": "38e855be-a345-3873-99b8-6355015d5a2c",
                                        "glosses": [
                                            "A short snorting sound, often to show disapproval, or used as a reply when one is reluctant to speak."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "245bf46c-879e-4cdc-b1d2-1161cb4c51f5",
                                                "sense_id": "df77bb73-d1c7-3a84-8ebc-83aafe81896e",
                                                "text": "The stranger, with a comfortable kind of grunt over his pipe, put his legs up on the settle that he had to himself."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5969f0b6-d99c-32f5-8d97-c88e89d103f6",
                                        "entry_id": "38e855be-a345-3873-99b8-6355015d5a2c",
                                        "glosses": [
                                            "The snorting cry of a pig."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9e8e52f3-c255-3d6d-9e1c-55f95c03d5ad",
                                        "entry_id": "38e855be-a345-3873-99b8-6355015d5a2c",
                                        "glosses": [
                                            "Any fish of the perciform family Haemulidae."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "49087457-306d-36e9-a0c3-17e15bc36406",
                                        "entry_id": "38e855be-a345-3873-99b8-6355015d5a2c",
                                        "glosses": [
                                            "A person who does ordinary and boring work."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1d01ef6f-3492-3a42-b898-823876acbd33",
                                        "entry_id": "38e855be-a345-3873-99b8-6355015d5a2c",
                                        "glosses": [
                                            "An infantry soldier."
                                        ],
                                        "tags": [
                                            "US",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4cff89bd-5354-4e12-9c9a-f61b65ac8d46",
                                                "sense_id": "1d01ef6f-3492-3a42-b898-823876acbd33",
                                                "text": "The poges stare at the grunts as though the grunts were Hell's Angels at the ballet."
                                            },
                                            {
                                                "example_id": "fdfcb7b5-2648-4a54-802d-54d61ae8b56d",
                                                "sense_id": "1d01ef6f-3492-3a42-b898-823876acbd33",
                                                "text": "The events described are those encountered by only 160 men, though the adversity recounted is representative of that experienced by all grunts in Vietnam."
                                            },
                                            {
                                                "example_id": "6a8bd7e1-b51b-490a-a36f-1c8f50ee413c",
                                                "sense_id": "1d01ef6f-3492-3a42-b898-823876acbd33",
                                                "text": "He can't make that kind of decision. He's just a grunt!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5708502c-ceea-3f17-8585-b40ae77460c8",
                                        "entry_id": "38e855be-a345-3873-99b8-6355015d5a2c",
                                        "glosses": [
                                            "The amount of power of which a vehicle is capable."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "68312426-ce91-4c16-bb27-cfccb09c8a76",
                                                "sense_id": "5708502c-ceea-3f17-8585-b40ae77460c8",
                                                "text": "The engine might not possess quite as much grunt as the later 24v six, but it delivers invigorating performance […]"
                                            },
                                            {
                                                "example_id": "61defeee-0acd-4f29-9266-fd86e2e2b9e7",
                                                "sense_id": "5708502c-ceea-3f17-8585-b40ae77460c8",
                                                "text": "With this much grunt, it is surprising that the engine is relatively quiet."
                                            },
                                            {
                                                "example_id": "a0630712-d5f7-46d2-b995-0982baa8ad66",
                                                "sense_id": "5708502c-ceea-3f17-8585-b40ae77460c8",
                                                "text": "The lack of bottom-end grunt presents as a particular problem in hilly terrain where the five-speed manual gearbox really earns its keep."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a1e39632-0467-3b7c-8137-f6af42520620",
                                        "entry_id": "38e855be-a345-3873-99b8-6355015d5a2c",
                                        "glosses": [
                                            "A dessert of steamed berries and dough, usually blueberries; blueberry grunt."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "grunt",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cfa56807-3130-3c85-af2a-8e0101397aff",
                                        "entry_id": "409dc349-e37d-307a-91ac-a1f4f980ed4c",
                                        "glosses": [
                                            "To make a grunt or grunts."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3249992b-73c7-4ad4-aa8f-fc4efeed9e00",
                                                "sense_id": "cfa56807-3130-3c85-af2a-8e0101397aff",
                                                "text": "to grunt and sweat under a weary life"
                                            },
                                            {
                                                "example_id": "dcb13267-56ca-446f-9261-611476a39843",
                                                "sense_id": "cfa56807-3130-3c85-af2a-8e0101397aff",
                                                "text": "The silhouette sharpens and fades as the carving is moved before the flames of the hearth, its maker grunts in perfect imitation of the ancestor - a human-lioness in oestrus."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "297caa6c-de5d-3437-bc98-0b543cb0efc1",
                                        "entry_id": "409dc349-e37d-307a-91ac-a1f4f980ed4c",
                                        "glosses": [
                                            "To make a grunt or grunts."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cd2af984-de59-3dc7-8cde-5938f84356df",
                                        "entry_id": "409dc349-e37d-307a-91ac-a1f4f980ed4c",
                                        "glosses": [
                                            "To break wind; to fart."
                                        ],
                                        "tags": [
                                            "UK",
                                            "intransitive",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fbf15b86-ae4d-4e70-983d-8504f6165d9e",
                                                "sense_id": "cd2af984-de59-3dc7-8cde-5938f84356df",
                                                "text": "Who just grunted?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
