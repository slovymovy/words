                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "form",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>goods</w> the soil to prepare it for the next season.",
                            "target_lang_translations": {
                                "ru": "Он <w>удобряет</w> почву, чтобы подготовить её к следующему сезону.",
                                "cs": "On <w>hnojí</w> půdu, aby ji připravil na další sezónu.",
                                "tr": "Gelecek sezona hazırlamak için toprağı <w>gübreler</w>."
                            }
                        },
                        {
                            "text": "The farmer <w>goods</w> his fields with manure every spring.",
                            "target_lang_translations": {
                                "ru": "Фермер <w>удобряет</w> свои поля навозом каждую весну.",
                                "cs": "Farmář každé jaro <w>hnojí</w> svá pole hnojem.",
                                "tr": "Çiftçi her bahar tarlalarını gübre ile <w>zenginleştirir</w>."
                            }
                        }
