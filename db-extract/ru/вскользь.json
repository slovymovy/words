                        "source_sense_id": "16e2ef93-737f-33cd-8865-715b5afa7277",
                        "target_lang_word": "flüchtig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "flüchtig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c5cbdd7c-d53e-3a68-b90d-21b40c8d06a9",
                                        "entry_id": "d7cd7396-d088-3be9-b4b9-1f09d53fc3f8",
                                        "glosses": [
                                            "auf der Flucht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5363828e-eb72-4845-a680-cb3b6102dc1a",
                                                "sense_id": "c5cbdd7c-d53e-3a68-b90d-21b40c8d06a9",
                                                "text": "Die beiden flüchtigen Verbrecher müssen so schnell wie möglich gefasst werden."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "24f108b9-acaf-391b-a12e-254cc27711a8",
                                        "entry_id": "d7cd7396-d088-3be9-b4b9-1f09d53fc3f8",
                                        "glosses": [
                                            "ohne große Konzentration, nicht genau"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53b2b341-22db-4d16-a290-1450c04199df",
                                                "sense_id": "24f108b9-acaf-391b-a12e-254cc27711a8",
                                                "text": "Sie gab ihm nur einen flüchtigen Kuss auf die Wange."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "05fa7625-f229-38b5-8c19-371d8140e122",
                                        "entry_id": "d7cd7396-d088-3be9-b4b9-1f09d53fc3f8",
                                        "glosses": [
                                            "kurzlebig, nicht beständig; leicht verdunstend; im Arbeitsspeicher und nicht auf Festplatte oder Magnetband"
                                        ],
                                        "tags": [
                                            "chemisch"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c212b660-ff43-47e7-abf0-93e88f987baa",
                                                "sense_id": "05fa7625-f229-38b5-8c19-371d8140e122",
                                                "text": "Es gibt auch Lösungsmittel, die bei Zimmertemperatur nur relativ langsam flüchtig werden."
                                            },
                                            {
                                                "example_id": "8ce7a5bb-3f0e-4564-948e-aa41c43fbb50",
                                                "sense_id": "05fa7625-f229-38b5-8c19-371d8140e122",
                                                "text": "Der Arbeitsspeicher wird als flüchtig angesehen, da mit Beenden des Programmablaufs die Informationen entfallen."
                                            },
                                            {
                                                "example_id": "ae4a1dba-302f-4ba6-aae2-c67df51770bc",
                                                "sense_id": "05fa7625-f229-38b5-8c19-371d8140e122",
                                                "text": "„Ach wie flüchtig, ach wie nichtig, ist der Menschen Leben!“"
                                            },
                                            {
                                                "example_id": "f2ba11e7-821f-427b-a230-df11270985c3",
                                                "sense_id": "05fa7625-f229-38b5-8c19-371d8140e122",
                                                "text": "„Oder speichert Whatsapp doch beides zusammen – und wenn, dann flüchtig oder dauerhaft, als Klarname oder verschlüsselt?“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "3fd430fa-9fb1-39c4-bc25-987b973478dd",
                                        "entry_id": "d7cd7396-d088-3be9-b4b9-1f09d53fc3f8",
                                        "glosses": [
                                            "nicht greifbar, immateriell"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d06704b-f9e5-46a0-8aa2-9a270d27925d",
                                                "sense_id": "3fd430fa-9fb1-39c4-bc25-987b973478dd",
                                                "text": "Es war nur ein flüchtiger Gedanke, nicht beachtenswert."
                                            },
                                            {
                                                "example_id": "b885732f-317f-402d-80d6-2a9b741d899d",
                                                "sense_id": "3fd430fa-9fb1-39c4-bc25-987b973478dd",
                                                "text": "Eine flüchtige Erscheinung, kaum mehr als ein Streiflicht."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
