                        "sense_id": "f406ac9a-eb75-3b69-945b-f5a757e7b091",
                        "entry_id": "956fc043-f3fb-3156-b936-90eb16252b55",
                        "glosses": [
                            "The acting of a play or plays; the occupation of an actor; dramatic performance."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "79075039-e22a-4b9b-b35f-07dce583fc59",
                                "sense_id": "f406ac9a-eb75-3b69-945b-f5a757e7b091",
                                "text": "Despite growing Puritan disapproval of play-acting, vehemently expressed in sermons and pamphlets, Charles's court was famous for its amateur theatricals."
                            }
                        ]
                    },
                    {
                        "sense_id": "7f73ac52-dd34-3945-acde-cb2b69d83f0a",
                        "entry_id": "956fc043-f3fb-3156-b936-90eb16252b55",
                        "glosses": [
                            "The act of engaging in pretence or insincere behavior, often in order to mislead someone or gain an advantage."
                        ],
                        "tags": [
                            "figuratively",
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "9d911312-79b2-48b8-b1f0-11a4fb09575b",
                                "sense_id": "7f73ac52-dd34-3945-acde-cb2b69d83f0a",
                                "text": "Children's games are often play-actings of adult roles and thus inculcate the values and customs of the culture in a way that formal schooling might neglect."
                            },
                            {
                                "example_id": "3cb59332-43fc-428e-b3e8-e4a4efec921c",
                                "sense_id": "7f73ac52-dd34-3945-acde-cb2b69d83f0a",
                                "text": "Yes, child care means that the days are longer, working hours broken up and scattered between intervals of dinosaur play-acting. It also means there is almost no time alone."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "12e70083-8253-454a-8902-a7b9cb4b36a4",
                        "source_entry_id": "956fc043-f3fb-3156-b936-90eb16252b55",
                        "source_sense_description": "act of engaging in pretence or insincere behavior",
                        "target_lang_word": "Schauspielerei",
                        "target_lang_code": "de",
