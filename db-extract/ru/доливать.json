                    }
                ],
                "translations": [
                    {
                        "translation_id": "60b3f261-6587-437e-82e9-47ec06ec94ae",
                        "source_entry_id": "a6313774-0e92-3dae-952b-c7178420f815",
                        "source_sense_id": "7d7de200-ba6a-3695-b98d-e4fbe5fb2885",
                        "target_lang_word": "nachgießen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nachgießen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "833699c4-01a1-32ff-8bb5-350905b5654f",
                                        "entry_id": "d00c1b15-09c2-3c2b-bf99-c90a52908c4b",
                                        "glosses": [
                                            "etwas in ein (fast oder teils) geleertes Gefäß gießen (um es erneut zu füllen)"
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4d1e2e89-5d8f-475a-9e89-b7aa7ea7e706",
                                                "sense_id": "833699c4-01a1-32ff-8bb5-350905b5654f",
                                                "text": "„Tante hat als erste den Zwirn von der Roulade gewickelt (das hätte Sophie doch in der Küche tun müssen!), ‚der Wein ist köstlich temperiert‘, sagt Tante; eilig gieße ich nach.“"
                                            },
                                            {
                                                "example_id": "96f18e6b-9151-4fe0-89dc-deea643adb4e",
                                                "sense_id": "833699c4-01a1-32ff-8bb5-350905b5654f",
                                                "text": "„‚Die Frauen werden die größte Last zu tragen haben, sie fliegen als erste aus ihren Jobs‘, sagt Ulrike und gießt Tee nach.“"
                                            },
                                            {
                                                "example_id": "2ef69330-d7a9-4d40-8283-7d08ccf7bae8",
                                                "sense_id": "833699c4-01a1-32ff-8bb5-350905b5654f",
                                                "text": "„Sie trank ihre Tasse leer und schob sie, als die Bäuerin aufstand, um der Mutter Kaffee nachzugießen, schnell zu Minna hinüber und zog deren volle Tasse zu sich.“"
                                            },
                                            {
                                                "example_id": "bb8d7c24-f608-4d3d-97aa-7ee54c28e77e",
                                                "sense_id": "833699c4-01a1-32ff-8bb5-350905b5654f",
                                                "text": "„Die Sängerin schwenkte die Weinflasche von Ida zu Ernst und goss ihm nach.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f3a5ddc5-235a-37da-ae39-08f34a6b1463",
                                        "entry_id": "d00c1b15-09c2-3c2b-bf99-c90a52908c4b",
                                        "glosses": [
                                            "ein (fast oder teils) geleertes Gefäß erneut mit etwas gießend füllen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "31a5167e-f4a6-44e8-8d1c-1575d11dcb54",
                                                "sense_id": "f3a5ddc5-235a-37da-ae39-08f34a6b1463",
                                                "text": "„Sie nahm nur einen kleinen Schluck, während er sein Glas fast in einem Zug leerte und sich ein zweites nachgoß.“"
                                            },
                                            {
                                                "example_id": "7ad394bf-f022-4325-b843-558df8932d68",
                                                "sense_id": "f3a5ddc5-235a-37da-ae39-08f34a6b1463",
                                                "text": "„Hofhaltend betrachtet er heiter die Scherben des Lebens und gießt ungefragt die Gläser seiner Besucherinnen nach.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "bf78e9a2-a72a-377b-a599-b15fb73c82a2",
                                        "entry_id": "d00c1b15-09c2-3c2b-bf99-c90a52908c4b",
                                        "glosses": [
                                            "etwas nach einer Vorlage im Gussverfahren erneut herstellen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "df72c0de-bcb3-47d8-8242-2658688ae175",
                                                "sense_id": "bf78e9a2-a72a-377b-a599-b15fb73c82a2",
                                                "text": "„Ebenfalls wieder gezeigt werden soll die Plastik ‚Mädchen mit Papagei‘, die jetzt in Bronze nachgegossen wurde.“"
                                            },
                                            {
                                                "example_id": "c9f966bf-bdce-431b-b4f4-4a118cd507d5",
                                                "sense_id": "bf78e9a2-a72a-377b-a599-b15fb73c82a2",
                                                "text": "„‚Wir gießen hier keine Putten in Beton nach‘, beteuert Boddien.“"
                                            },
                                            {
                                                "example_id": "1ab46c4c-7009-481f-acc7-b9c7a832b00f",
                                                "sense_id": "bf78e9a2-a72a-377b-a599-b15fb73c82a2",
                                                "text": "„Die Rheinländer ließen Lederers bezaubernde Statue nachgießen: Die Replik nach einem erhalten gebliebenen Werkstattmodell steht heute vor der Universitätsbibliothek in Heines Geburtsstadt Düsseldorf.“"
                                            },
                                            {
                                                "example_id": "f48ccad1-89ab-4179-8871-362e6076959c",
                                                "sense_id": "bf78e9a2-a72a-377b-a599-b15fb73c82a2",
                                                "text": "„Als Geschenk dafür hat er eine in Wachs geformte Frauenfigur von August Macke in Bronze nachgießen lassen.“"
                                            },
                                            {
                                                "example_id": "85ea30bc-4845-4683-b51b-288ae7355e47",
                                                "sense_id": "bf78e9a2-a72a-377b-a599-b15fb73c82a2",
                                                "text": "„Der Autodidakt kann zu einer österreichischen Form der ‚Arte Povera‘ gezählt werden, seine Objekte und Installationen bestanden aus gefundenen Materialien, aus Karton, Erde, Lehm, die er weiter dachte, weiter bearbeitete, indem er sie u. a. auch in Bronze, Eisen oder Aluminium nachgoss.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
