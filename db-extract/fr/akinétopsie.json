                        "glosses": [
                            "Incapacité de la perception du mouvement. Agnosie visuelle du mouvement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "037030a8-15cb-49e3-b2af-8f8d6ba55199",
                                "sense_id": "3d7efd6c-3cc1-351e-9ba7-e6dbe5f2b627",
                                "text": "Alors que ce cas a été abondamment cité depuis des années, le fait qu'aucun autre patient du même type n'ait été identifié laisse penser que l’akinétopsie ne résulte que de lésions bilatérales."
                            },
                            {
                                "example_id": "a1816517-865d-4763-8c72-7c89aeb6b0c6",
                                "sense_id": "3d7efd6c-3cc1-351e-9ba7-e6dbe5f2b627",
                                "text": "(L’akinétopsie) est un trouble neuropsychologique rarissime (qui) empêche le patient de percevoir le mouvement, alors qu'il voit sans peine tout ce qui est immobile."
                            }
                        ]
                    }
