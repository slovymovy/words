                {
                    "sense_id": "78e76c4b-6cab-3050-901b-95a6795492a3",
                    "sense_definition": "To officially sign up or register for a course, school, or organization.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I decided to <w>enroll</w> in a local language course to improve my Spanish skills. ",
                            "target_lang_translations": {
                                "ru": "Я решил <w>записаться</w> на местные языковые курсы, чтобы улучшить свой испанский."
                            }
                        },
                        {
                            "text": "If you want to <w>enroll</w> in a course, you must complete the application before Friday.",
                            "target_lang_translations": {
                                "ru": "Если вы хотите <w>записаться</w> на курс, вы должны заполнить заявку до пятницы."
                            }
