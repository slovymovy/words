    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "145d0c45-100f-348a-83dd-7a1c039b4938",
                "word": "savageness",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "39981e07-5aa0-4245-bda5-52e46d4030df",
