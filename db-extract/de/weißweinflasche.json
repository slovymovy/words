                "senses": [
                    {
                        "sense_id": "6691694e-7510-3978-9760-7354b9e4c3ec",
                        "entry_id": "00c7c50f-af2f-3b0f-8daa-a81948ce3d58",
                        "glosses": [
                            "Flasche, in der Weißwein ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6da4cdef-bb47-4ad8-8d3e-74e9a547bab0",
                                "sense_id": "6691694e-7510-3978-9760-7354b9e4c3ec",
                                "text": "„In der gehobenen Gastronomie ist es üblich, Weißweinflaschen erst am Tisch zu öffnen und den Gast zunächst degustieren zu lassen.“"
                            },
                            {
                                "example_id": "73897955-b737-4a66-af57-b9f01f272f1b",
                                "sense_id": "6691694e-7510-3978-9760-7354b9e4c3ec",
                                "text": "„Als Reaktion hat man sich mit dem Jahrgang 2004 auf eine einheitliche Form verständigt, die einen Kompromiss zwischen der kürzeren Rotwein- und der schlankeren Weißweinflasche darstellt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
