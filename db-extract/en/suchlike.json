                                    {
                                        "sense_id": "1ce1e866-f564-38b6-8081-00a6db61172d",
                                        "entry_id": "630c270d-3dfc-3d73-abbf-67b9347b05e5",
                                        "glosses": [
                                            "auf eine im Zusammenhang geschilderte Eigenart oder Beschaffenheit hinweisend: so geartet; so beschaffen; solch"
                                        ],
                                        "tags": [],
