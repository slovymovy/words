{
    "word_family": [
        "schelen",
        "scheling"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "a40fd14d-7fe1-3760-a7a2-0f34ac95fb7c",
                    "sense_definition": "Met de ogen niet op hetzelfde punt gericht kunnen kijken.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "oogafwijking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De man moet een bril dragen doordat hij <w>schele</w> ogen heeft.",
                            "target_lang_translations": {
                                "en": "The man has to wear glasses because he has <w>cross-eyed</w> vision."
                            }
                        },
                        {
                            "text": "Hij kijkt een beetje <w>scheel</w> als hij moe is.",
                            "target_lang_translations": {
                                "en": "He looks a bit <w>cross-eyed</w> when he is tired."
                            }
                        }
                    ],
                    "synonyms": [
                        "scheelogig"
                    ],
                    "common_phrases": [
                        "scheel kijken"
                    ],
                    "target_lang_definitions": {
                        "en": "Having eyes that are not directed at the same point; cross-eyed."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "cross-eyed",
                                "target_lang_sense_clarification": "Having eyes that look inward or are misaligned."
                            },
                            {
                                "target_lang_word": "squinting",
                                "target_lang_sense_clarification": "Looking with eyes partly closed or misaligned."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1c3113cd-94ca-3445-8e6c-2779c685aea4",
                    "sense_definition": "Niet recht of in de juiste vorm.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "vorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het schilderij hangt een beetje <w>scheel</w> aan de muur.",
                            "target_lang_translations": {
                                "en": "The painting is hanging a bit <w>crooked</w> on the wall."
                            }
                        },
                        {
                            "text": "De plank is door de vochtigheid helemaal <w>scheel</w> getrokken.",
                            "target_lang_translations": {
                                "en": "The board has <w>warped</w> completely due to the humidity."
                            }
                        }
                    ],
                    "synonyms": [
                        "krom",
                        "scheef",
                        "schuin"
                    ],
                    "target_lang_definitions": {
                        "en": "Not straight, level, or in the correct shape; warped or crooked."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "crooked",
                                "target_lang_sense_clarification": "Not straight or level."
                            },
                            {
                                "target_lang_word": "warped",
                                "target_lang_sense_clarification": "Bent or twisted out of shape, often due to moisture."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "51e75cd1-d1b7-305d-9003-7011e5bda1d5",
                    "sense_definition": "Het punt waarop twee zaken van elkaar afwijken.",
                    "learner_level": "C1",
                    "frequency": "Very Low",
                    "semantic_group_id": "verschil",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er was een grote <w>scheel</w> tussen de twee bedragen.",
                            "target_lang_translations": {
                                "en": "There was a large <w>difference</w> between the two amounts."
                            }
                        },
                        {
                            "text": "De koopman berekende de <w>scheel</w> tussen inkoop en verkoop.",
                            "target_lang_translations": {
                                "en": "The merchant calculated the <w>difference</w> between purchase and sale."
                            }
                        }
                    ],
                    "synonyms": [
                        "verschil"
                    ],
                    "target_lang_definitions": {
                        "en": "The point at which two things differ or the state of being different."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "difference",
                                "target_lang_sense_clarification": "The way in which two or more things are not the same."
                            }
                        ]
                    },
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ]
                },
                {
                    "sense_id": "66031c53-df7c-3dc6-9229-f873a25be2b2",
                    "sense_definition": "Een meningsverschil of ruzie tussen personen.",
                    "learner_level": "C1",
                    "frequency": "Very Low",
                    "semantic_group_id": "verschil",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tussen de twee families bestond al jaren een <w>scheel</w>.",
                            "target_lang_translations": {
                                "en": "There had been a <w>dispute</w> between the two families for years."
                            }
                        },
                        {
                            "text": "De pastoor probeerde de <w>scheel</w> tussen de buren bij te leggen.",
                            "target_lang_translations": {
                                "en": "The priest tried to settle the <w>dispute</w> between the neighbours."
                            }
                        }
                    ],
                    "synonyms": [
                        "geschil",
                        "conflict",
                        "dispuut"
                    ],
                    "target_lang_definitions": {
                        "en": "A disagreement, dispute, or conflict between people."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "dispute",
                                "target_lang_sense_clarification": "A disagreement or argument."
                            },
                            {
                                "target_lang_word": "conflict",
                                "target_lang_sense_clarification": "A serious disagreement or argument."
                            }
                        ]
                    },
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ]
                },
                {
                    "sense_id": "b79ecb9f-a8e2-38cb-ba07-28d9f15c8d88",
                    "sense_definition": "Een lijn in het haar waar het naar twee kanten wordt gekamd.",
                    "learner_level": "C1",
                    "frequency": "Very Low",
                    "semantic_group_id": "haar",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zijn haar was gekamd met een strakke <w>scheel</w> in het midden.",
                            "target_lang_translations": {
                                "en": "His hair was combed with a tight <w>part</w> down the middle."
                            }
                        },
                        {
                            "text": "De kapper maakte een nette <w>scheel</w> aan de zijkant.",
                            "target_lang_translations": {
                                "en": "The barber made a neat <w>part</w> at the side."
                            }
                        }
                    ],
                    "synonyms": [
                        "scheiding"
                    ],
                    "target_lang_definitions": {
                        "en": "A line in the hair where it is combed in two different directions."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "part",
                                "target_lang_sense_clarification": "A line in the hair where it is parted."
                            },
                            {
                                "target_lang_word": "parting",
                                "target_lang_sense_clarification": "The line where hair is divided (British English)."
                            }
                        ]
                    },
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ]
                }
            ]
        }
    ]
