                                        "entry_id": "5951f7ca-2fba-3670-8394-28e6f85740ae",
                                        "glosses": [
                                            "„Rechnungsbuch, in das die Schluss- oder Jahresbilanz eingetragen wird“"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f9055bc-5ddf-4195-a3f9-f3ec3e978003",
                                                "sense_id": "b3babff6-f111-3723-af26-38591ad40d72",
                                                "text": "„Hauptbuch heißt eines der im Rahmen der Buchführung geführten Bücher.“"
                                            }
