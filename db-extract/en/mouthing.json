                        "entry_id": "ab828f93-0848-3e05-a6ab-72fbbb854c8b",
                        "glosses": [
                            "The act of forming a shape with the mouth, especially as part of sign language."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b1177730-80d8-4b06-8601-4875e912bdf1",
                                "sense_id": "5f8e288e-13c8-3994-b4ed-9e4a39aa2432",
                                "text": "Mouthings tend to occur most often when signers are manually articulating nouns, open-class items, and morphologically simpler signs (see Crasborn et al. 2008)."
                            }
                        ]
                    },
                    {
                        "sense_id": "6d66b10c-7720-3e4a-b001-3785958e10b3",
                        "entry_id": "ab828f93-0848-3e05-a6ab-72fbbb854c8b",
                        "glosses": [
                            "Ranting; passionate speech devoid of meaning."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c376748-81d2-4c22-a61e-fb7b61afafe0",
                                "sense_id": "6d66b10c-7720-3e4a-b001-3785958e10b3",
                                "text": "Kearn did not rant, he did not deafen you with heroics and empty mouthings."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "aa37bb2d-12be-4944-bb26-b0a150cb1265",
                        "source_entry_id": "ab828f93-0848-3e05-a6ab-72fbbb854c8b",
                        "source_sense_description": "in sign languages",
                        "target_lang_word": "labialisation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "labialisation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c07ddc79-0d12-339a-96dc-78f0979cf1d1",
                                        "entry_id": "be12aa66-5400-3e60-b184-fcf98ef57699",
                                        "glosses": [
                                            "Action de labialiser, utilisation des lèvres comme dispositif secondaire d’articulation, pendant que le reste de la bouche produit un autre phonème."
                                        ],
                                        "tags": [
                                            "Phonétique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "492ac738-d33c-4379-b5f9-fd70008362c1",
                                                "sense_id": "c07ddc79-0d12-339a-96dc-78f0979cf1d1",
                                                "text": "Bien que la labialisation ne soit en aucune façon universelle parmi les langues du monde, elle est cependant extrêmement répandue."
                                            },
                                            {
                                                "example_id": "1df9aa66-2030-4284-96e7-100f76e22c62",
                                                "sense_id": "c07ddc79-0d12-339a-96dc-78f0979cf1d1",
                                                "text": "En effet, le traducteur peut être influencé par la labialisation du correspondant direct en français d’un signe en particulier."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
