                                            {
                                                "example_id": "e132fc21-a794-45b2-9053-d3d7e59da779",
                                                "sense_id": "2c3c9488-8f19-37ac-bdff-d1b81693cfef",
                                                "text": "„[Der Stadtstaat] Mari ([heute] Tell Hariri) ist u. a. vertreten mit alabasternen Beterfiguren (die anstelle des Dargestellten im ständigen Gebet vor der Gottheit verharren sollten), der gedrungenen Statuette des Königs Lamgi-Mari (um 2600 v. Chr.) im typischen Zottenrock, der schwarzen Diorit-Skulptur des bärtigen Statthalters Ischtup-Ilum (18. Jh. v. Chr.) aus dem Thronraum von Mari; …“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "523d2806-9013-3600-ba03-9796c23bde92",
                                        "entry_id": "b018fd42-9a31-364d-a54c-d9ae0e44d977",
                                        "glosses": [
                                            "durchscheinend/weiß (wie Alabaster)"
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0e215394-e053-46d4-b11a-debde33505e9",
                                                "sense_id": "523d2806-9013-3600-ba03-9796c23bde92",
                                                "text": "„Jenseit des wassers der mattrot- und goldene saal//Herbergt den Fürsten und seine verschlossene qual.//Bleich alabasterne stirn ziert ein schwer diadem·//Freude und trost des gefolges ist ihm nicht genehm.//Jung und in welke so streckt er die arme ins blau//Schluchzend vom söller herab in die duftige au·//Der nicht der eigenen würde bekrönung gewahrt//Die jedes nahen verbietet vertraulicher art …“"
                                            }
                                        ],
