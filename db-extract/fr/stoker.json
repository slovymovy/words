                "senses": [
                    {
                        "sense_id": "8bea90de-d1d3-32ac-8ac8-1148164b3be4",
                        "entry_id": "f044a41d-bc5f-3f1d-be5c-2aa0e3f3e0ad",
                        "glosses": [
                            "Dispositif servant à approvisionner automatiquement en charbon, depuis le tender, une locomotive à vapeur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d7e27460-2179-4dfc-9359-972557de4e80",
                                "sense_id": "8bea90de-d1d3-32ac-8ac8-1148164b3be4",
                                "text": "[La 240P] bénéficiait surtout de la charge mécanique communément appelée chauffe au « stoker ». Une vis sans fin partant du fond du tender amenait directement le charbon sur la table d’entrée du foyer où il était cueilli par un jet de vapeur qui le projetait sur toute la longueur du feu où il brûlait avant même de tomber sur la grille."
                            },
                            {
                                "example_id": "58d2b8fd-a2ff-48ae-ac80-68438ad5e58a",
                                "sense_id": "8bea90de-d1d3-32ac-8ac8-1148164b3be4",
                                "text": "Il ne faut pas non plus oublier la vis sans fin du stoker. C’est elle qui apporte le charbon du tender vers le foyer de la machine grâce à un moteur à vapeur dans le tender."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "44634fe4-d53f-42b4-99cc-c1cf28143632",
                        "source_entry_id": "f044a41d-bc5f-3f1d-be5c-2aa0e3f3e0ad",
                        "source_sense_id": "8bea90de-d1d3-32ac-8ac8-1148164b3be4",
                        "target_lang_word": "stoker",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stoker",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "88f4cf4b-d16e-3902-9b64-408de2a9f2db",
                                        "entry_id": "2de7b3ae-b287-3a4e-a51e-d65fb17f5e88",
                                        "glosses": [
                                            "A person who stokes, especially one on a steamship or steam train, who stokes coal in the boilers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d4117660-582f-4ff4-bd19-e29f713a2732",
                                                "sense_id": "88f4cf4b-d16e-3902-9b64-408de2a9f2db",
                                                "text": "For this was a line so little frequented, especially at this hour, when the driver, the stoker, the guard and the station staffs all along the line, were anhelating towards their wives, after the long hours of continence, that the train would hardly draw up, when it would be off again, like a bouncing ball."
                                            },
                                            {
                                                "example_id": "495df430-e422-4940-a3b3-83504ffe2217",
                                                "sense_id": "88f4cf4b-d16e-3902-9b64-408de2a9f2db",
                                                "text": "He held strongly to the black-ganger's philosophy - what is the use of all the radar and guns and torpedoes if you don't have the engineers and stokers to put them in the right position?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "72ce27a0-0be9-3cf1-8aab-c5392077e6d3",
                                        "entry_id": "2de7b3ae-b287-3a4e-a51e-d65fb17f5e88",
                                        "glosses": [
                                            "A device for stoking a fire; a poker."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "79bfb7f4-02d5-3c62-86a8-e162fe1ae1c1",
                                        "entry_id": "2de7b3ae-b287-3a4e-a51e-d65fb17f5e88",
                                        "glosses": [
                                            "A device that feeds coal into a furnace, etc., automatically."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2db9a45f-2063-478b-b669-0294ca4da604",
                                                "sense_id": "79bfb7f4-02d5-3c62-86a8-e162fe1ae1c1",
                                                "text": "As we reported was to occur, two of Saltley's stoker-fitted 2-10-0s, Nos. 92165/7, have been stripped of their stokers at Crewe works."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bf8eaa8d-9bb8-34e1-9b8e-19906924e0bd",
                                        "entry_id": "2de7b3ae-b287-3a4e-a51e-d65fb17f5e88",
                                        "glosses": [
                                            "A person who pedals on the back of a tandem bicycle."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
