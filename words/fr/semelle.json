    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a2226ced-5813-341e-b2e0-524f2185e1f0",
                    "sense_definition": "Partie inférieure d'une chaussure qui entre en contact direct avec le sol.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "chaussure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le cordonnier répare la <w>semelle</w> trouée de ma chaussure préférée."
                        },
                        {
                            "text": "Ces bottes d'hiver possèdent une <w>semelle</w> épaisse pour bien isoler du froid."
                        }
                    ],
                    "common_phrases": [
                        "semelle en caoutchouc",
                        "semelle compensée"
                    ]
                },
                {
                    "sense_id": "42d39ee0-37ad-3684-a137-1dd1950c7704",
                    "sense_definition": "Pièce amovible que l'on place à l'intérieur d'une chaussure pour assurer le confort ou corriger la posture.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "chaussure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mon médecin m'a conseillé de porter une <w>semelle</w> orthopédique pour soulager mon dos."
                        },
                        {
                            "text": "J'ai acheté une fine <w>semelle</w> de feutre pour garder mes pieds bien au chaud."
                        }
                    ],
                    "common_phrases": [
                        "semelle orthopédique",
                        "semelle intérieure"
                    ]
                },
                {
                    "sense_id": "1a3a1574-0a64-3ebd-ba9a-5dd44bcf7fcf",
                    "sense_definition": "Longueur correspondant à celle d'un pas ou d'un pied, prise au sens figuré pour marquer une distance minime.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mesure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les manifestants ont fermement tenu leurs positions sans reculer d'une <w>semelle</w>."
                        },
                        {
                            "text": "Le garde du corps a surveillé l'homme toute la journée sans le lâcher d'une <w>semelle</w>."
                        }
                    ],
                    "synonyms": [
                        "pouce"
                    ],
                    "common_phrases": [
                        "ne pas reculer d'une semelle",
                        "ne pas lâcher d'une semelle"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Employé principalement dans des locutions figurées"
                        }
                    ]
                },
                {
                    "sense_id": "a14a211d-67e6-340a-a424-4b358fb9de4e",
                    "sense_definition": "Morceau de viande particulièrement dur, coriace et difficile à mâcher en raison d'une mauvaise qualité ou d'une surcuisson.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "nourriture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le cuisinier a oublié la viande sur le gril et m'a servi une vraie <w>semelle</w>."
                        },
                        {
                            "text": "Ce morceau de bœuf était tellement dur qu'on aurait dit de la <w>semelle</w>."
                        }
                    ],
                    "common_phrases": [
                        "dur comme une semelle"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Sens métaphorique familier"
                        }
                    ]
                },
                {
                    "sense_id": "d257c681-632a-31d7-88f6-16eb95f9a921",
                    "sense_definition": "Face inférieure et lisse d'un ski ou d'une planche à neige conçue pour assurer le glissement sur la neige.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "glisse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il faut nettoyer régulièrement la <w>semelle</w> de ses skis pour éviter d'abîmer le revêtement."
                        },
                        {
                            "text": "Une couche de fart liquide sur la <w>semelle</w> permet de grandement améliorer la vitesse."
                        }
                    ],
                    "common_phrases": [
                        "farter la semelle",
                        "semelle de ski"
                    ]
                },
                {
                    "sense_id": "aae54b90-75fe-3647-805e-9c178ee65d44",
                    "sense_definition": "Pièce horizontale de bois, de métal ou de béton servant de base d'appui pour répartir une charge lourde.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "construction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les ouvriers coulent une <w>semelle</w> en béton afin d'assurer la solidité des fondations."
                        },
                        {
                            "text": "Il est indispensable de placer une solide <w>semelle</w> de bois sous chaque étai de soutènement."
                        }
                    ],
                    "common_phrases": [
