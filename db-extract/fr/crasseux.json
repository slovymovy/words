                    {
                        "form_id": "5ca7c0e7-72d1-4c16-80c5-fccb567adc15",
                        "entry_id": "19d49c83-cb3b-3879-8b3c-da7f06503ef3",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "crasseuses"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "199a9f51-4b67-3805-acb1-0a54632cfedc",
                        "entry_id": "19d49c83-cb3b-3879-8b3c-da7f06503ef3",
                        "glosses": [
                            "Qui est couvert de crasse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "914bfbb0-b1cb-4f42-9dce-e0107d183ba0",
                                "sense_id": "199a9f51-4b67-3805-acb1-0a54632cfedc",
                                "text": "La toute petite fille était une gaminette de trois ou quatre ans à peine, très crasseuse et très déguenillée, aussi large que haute, et fagotée on ne sait comment, à la je m'en moque."
                            },
                            {
                                "example_id": "859b0b3f-0787-4a08-88cb-42e041f9ea91",
                                "sense_id": "199a9f51-4b67-3805-acb1-0a54632cfedc",
                                "text": "Ce fut une époque de beuveries à décarcasser un veau, parmi les vapeurs des pipes et les proclamations d’esthètes crasseux, toutes lavallières dehors."
                            },
                            {
                                "example_id": "3738297a-f9a9-4f65-b6b7-cad448f4ebd0",
                                "sense_id": "199a9f51-4b67-3805-acb1-0a54632cfedc",
                                "text": "Quand cette image de la mort en turban crasseux, en casaquin sinistre, regarda les grains de millet que la poule noire piquait, et appela son crapaud Astaroth pour qu’il se promenât sur les cartes étalées, Mme Cibot eut froid dans le dos, elle tressaillit."
                            },
                            {
                                "example_id": "22c57e45-6105-4d1f-967d-b706f1f90e32",
                                "sense_id": "199a9f51-4b67-3805-acb1-0a54632cfedc",
                                "text": "En ouvrant la porte, Patrick vit un homme de taille moyenne, vêtu d’un pantalon de velours bleu, d’un pull à col roulé, et d’une paire de basquettes crasseuses."
                            }
                        ]
                    },
                    {
                        "sense_id": "c29baa91-5a69-354e-ba21-d0fe0425dbc7",
                        "entry_id": "19d49c83-cb3b-3879-8b3c-da7f06503ef3",
                        "glosses": [
                            "Qui vit dans une avarice sordide."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "a99b04d2-85ba-45b7-844f-bac292454263",
                                "sense_id": "c29baa91-5a69-354e-ba21-d0fe0425dbc7",
                                "text": "Il vit en crasseux."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c61ee3cd-7194-4fdc-9ca8-4f6ec58e5436",
                        "source_entry_id": "19d49c83-cb3b-3879-8b3c-da7f06503ef3",
                        "target_lang_word": "grimy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
