                                "target_lang_sense_clarification": "willing to help or cooperate"
                            },
                            {
                                "target_lang_word": "compliant",
                                "target_lang_sense_clarification": "yielding or submissive to others' wishes"
                            },
                            {
                                "target_lang_word": "easygoing",
                                "target_lang_sense_clarification": "relaxed and adaptable"
                            },
                            {
                                "target_lang_word": "yielding",
                                "target_lang_sense_clarification": "ready to give way or concede"
                            }
                        ]
                    }
                }
            ]
        },
