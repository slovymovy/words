                ],
                "senses": [
                    {
                        "sense_id": "a174d2e0-3aa1-35b3-b6ce-655cd607c07a",
                        "entry_id": "1f5c0398-c380-3004-b21b-f4083ec5ecd6",
                        "glosses": [
                            "имеющий форму жёлоба"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "ad01ba0e-81c9-3b9d-b008-aff38edbd043",
                        "entry_id": "1f5c0398-c380-3004-b21b-f4083ec5ecd6",
                        "glosses": [
                            "содержащий в себе жёлоб или желоба, изобилующий желобами"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ad8ce26-e106-4cc2-a09c-4af6a19fb313",
                                "sense_id": "ad01ba0e-81c9-3b9d-b008-aff38edbd043",
                                "text": "А позади вздымались и твердели // Желобчатые желтые стволы // Могучей колоннады Парфенона, // Направленные в пламенный простор."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c7067ee3-5a9b-49ff-afe0-b1354dfc4861",
                        "source_entry_id": "1f5c0398-c380-3004-b21b-f4083ec5ecd6",
                        "target_lang_word": "cannelé",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cannelé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f367823a-e498-30c1-8842-750f4696d6d3",
                                        "entry_id": "ffbf1e54-4f22-3566-a06a-259f3a7b7ed1",
                                        "glosses": [
                                            "Qui offre des cannelures, des sillons, des stries profondes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee34b310-5413-4395-ab31-38637fd2d450",
                                                "sense_id": "f367823a-e498-30c1-8842-750f4696d6d3",
                                                "text": "À l’intérieur, quatre colonnes corinthiennes et les colonnettes cannelées du chancel supportent le jubé de bois, orné de panneaux en bas-relief polychrome."
                                            },
                                            {
                                                "example_id": "b657a447-f86e-417d-821b-b9596ccae3aa",
                                                "sense_id": "f367823a-e498-30c1-8842-750f4696d6d3",
                                                "text": "Les colonnes du péristyle et du portique reposaient immédiatement sur les degrés du temple ; elles étaient sans base, cannelées et d’ordre dorique s’étaient écoulé."
                                            },
                                            {
                                                "example_id": "4d4049f8-1d6e-4ab5-9833-0fe83e89b5ed",
                                                "sense_id": "f367823a-e498-30c1-8842-750f4696d6d3",
                                                "text": "La semaine suivante, Masson apporta un numéro de journal, et de son ongle dur et cannelé désigna trois lignes de la Correspondance privée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "790dd89a-1d3a-3614-b1d7-2b7e01c09cad",
                                        "entry_id": "ffbf1e54-4f22-3566-a06a-259f3a7b7ed1",
                                        "glosses": [
                                            "Se dit des bordures des pièces présentant des cannelures."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "baa72011-1ffe-48cc-a82e-89a82998097e",
                                                "sense_id": "790dd89a-1d3a-3614-b1d7-2b7e01c09cad",
                                                "text": "De sinople à la barre d’argent courbée et abaissée en chef, le trait supérieur cannelé et le trait inférieur engrelé, accompagnée en chef de deux bars adossés d’or et en pointe d’une roue de moulin du même, qui est de Roche-les-Clerval (cf. illustration)"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "cannelé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e96154ac-d0b8-3926-8195-146f5cd29079",
                                        "entry_id": "09a337fd-c457-3e04-9c7c-bd26eaf7d3c6",
                                        "glosses": [
                                            "Cylindre cannelé."
                                        ],
                                        "tags": [
                                            "Industrie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "99528884-5b9c-47fd-9ee5-547db018e7ce",
                                                "sense_id": "e96154ac-d0b8-3926-8195-146f5cd29079",
                                                "text": "Le chariot c est un organe mobile, d’une longueur égale à celle du métier qui s’éloigne et se rapproche des cannelés."
                                            },
                                            {
                                                "example_id": "5cd28b73-fc1e-4cc2-be0a-eced4496ba5b",
                                                "sense_id": "e96154ac-d0b8-3926-8195-146f5cd29079",
                                                "text": "C’est-à-dire qu’il faut multiplier le numéro que l’on veut obtenir par le nombre de dents de la roue sur le cannelé de derrière, et diviser le produit par le numéro obtenu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ffa7eb9d-ca22-3e10-b884-7efbf472c54d",
                                        "entry_id": "09a337fd-c457-3e04-9c7c-bd26eaf7d3c6",
                                        "glosses": [
                                            "Petite pâtisserie au rhum, aux bords cannelés."
                                        ],
                                        "tags": [
                                            "Pâtisserie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5dcb6d14-01df-440a-97f7-ca1b83371e61",
                                                "sense_id": "ffa7eb9d-ca22-3e10-b884-7efbf472c54d",
                                                "text": "Un moule à cannelé."
                                            },
                                            {
                                                "example_id": "f6dd91cf-0c22-48a7-99ac-f03b6d5f08f1",
                                                "sense_id": "ffa7eb9d-ca22-3e10-b884-7efbf472c54d",
                                                "text": "Des cannelés bordelais."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "daf56db7-3e3a-3d6c-88bd-c6c862bcec06",
                                        "entry_id": "09a337fd-c457-3e04-9c7c-bd26eaf7d3c6",
                                        "glosses": [
                                            "Étoffe de soie tissue comme du taffetas."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "cannelé",
