                                        "sense_id": "cd35ffac-6677-36b0-9c80-2baa4c5668eb",
                                        "entry_id": "64cbbee1-5edd-3e89-bf0d-ff56851b43e8",
                                        "glosses": [
                                            "Of or pertaining to the Moors or their culture."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2fffcfd-5ed7-41fe-8ecd-1acb4798a9f2",
                                                "sense_id": "cd35ffac-6677-36b0-9c80-2baa4c5668eb",
                                                "text": "I joy to see you wear around your neck the holy relic I bestowed on you; — but what Moorish charmlet is that you wear beside it?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bff85fda-9854-3918-b251-ca15afc51a73",
                                        "entry_id": "64cbbee1-5edd-3e89-bf0d-ff56851b43e8",
                                        "glosses": [
                                            "Of or pertaining to a style of Spanish and Portuguese architecture from the time of the Moors, characterized by the horseshoe arch and ornate, geometric decoration."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2008053-7543-4f47-99ab-5855a2eaa592",
                                                "sense_id": "bff85fda-9854-3918-b251-ca15afc51a73",
                                                "text": "Mar-a-Lago was quiet three days before Thanksgiving. Donald Trump’s Moorish palace seemed all but deserted late that morning, the seaside estate’s cavernous living room traversed intermittently by a junior staffer or silent aide."
                                            }
                                        ]
                                    }
