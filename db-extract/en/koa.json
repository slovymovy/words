                        "sense_id": "1d23cda0-067d-35db-aeb4-89a6b6bb8c17",
                        "entry_id": "bbb19fe7-f25d-3a86-884a-80cf7afead0a",
                        "glosses": [
                            "A large tree of species Acacia koa (family Fabaceae) which is endemic to and common on the islands of Hawaii; or the wood of this tree."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "76e0cb04-4fca-4047-a4e2-238b7ad88ad3",
                                "sense_id": "1d23cda0-067d-35db-aeb4-89a6b6bb8c17",
                                "text": "As you get higher, native vegetation takes over, so a prospect might be framed by the dangling leaves of the beautiful koa tree, each leaf a gently curved, trembling sickle."
                            },
                            {
                                "example_id": "63594fa6-3b0d-433d-b7f4-87df58e21fa6",
                                "sense_id": "1d23cda0-067d-35db-aeb4-89a6b6bb8c17",
                                "text": "The outer frame is made of koa and maple."
                            },
                            {
                                "example_id": "0cf68577-f80a-4d24-a7d9-fc80bfb71a3c",
                                "sense_id": "1d23cda0-067d-35db-aeb4-89a6b6bb8c17",
                                "text": "At her funeral, Likelike's body was placed in a polished koa coffin, adorned with sprays of gardenia […]."
                            }
                        ]
                    }
