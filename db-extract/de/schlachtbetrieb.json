                                "example_id": "cc7b207f-cc89-4efe-b7ba-002e64c06a36",
                                "sense_id": "c2168c7d-0c65-3b94-af5e-192cbec49ae9",
                                "text": "„Jetzt war ich mitten im Schlachtbetrieb. Von morgens sechs Uhr bis abends um sechs, zwölf Stunden rot-weißes Fleisch vor meiner Nase.“"
                            },
                            {
                                "example_id": "70f19ad2-1946-4f38-a307-8a4ccd54ea8a",
                                "sense_id": "c2168c7d-0c65-3b94-af5e-192cbec49ae9",
                                "text": "Tessa hatte den Schlachtbetrieb von ihrem Vater übernommen."
                            }
                        ],
