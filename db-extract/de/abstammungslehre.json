                        "form": "die Abstammungslehre"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "27c3157f-0ca3-34f2-9e29-6a7c1c4b1589",
                        "entry_id": "0b68779c-b71f-38a5-8686-8459d2257b0a",
                        "glosses": [
                            "die Lehre von der Veränderlichkeit der Organismen und ihrer evolutiven Entfaltung in Zeit und Raum"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "02d07e5c-63fd-4bfd-9554-decf725aa156",
                                "sense_id": "27c3157f-0ca3-34f2-9e29-6a7c1c4b1589",
                                "text": "„Die Ergebnisse der Phylogenie beruhen in erster Linie auf der Abstammungslehre und sind in ihrer Konsequenz Beleg für die Evolution.“"
                            },
                            {
                                "example_id": "c620db60-19db-4ac5-9281-f7f88b450430",
                                "sense_id": "27c3157f-0ca3-34f2-9e29-6a7c1c4b1589",
                                "text": "„Die Möglichkeit, alle Lebewesen in ein natürliches System zu ordnen, ist ein Beweis für die Abstammungslehre, nach der das heutige Organismenreich einen Querschnitt durch den Prozess der Stammesentwicklung darstellt.“"
                            },
                            {
                                "example_id": "0939fa3b-69da-4f3e-98c6-1de014bc8676",
                                "sense_id": "27c3157f-0ca3-34f2-9e29-6a7c1c4b1589",
                                "text": "„Durch die Begründung der Abstammungslehre (Deszendenztheorie) durch C. R. Darwin 1859 wurde die Systematik auf eine neue Grundlage gestellt, indem jetzt ein natürliches System Ausdruck der verwandtschaftlichen Beziehungen sein soll.“"
                            },
                            {
                                "example_id": "d1758a5d-197a-4880-b01c-b7b7d9ae0167",
                                "sense_id": "27c3157f-0ca3-34f2-9e29-6a7c1c4b1589",
                                "text": "„Die Abstammungslehre von der graduellen Transformation der Arten fand er schlicht grotesk.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
