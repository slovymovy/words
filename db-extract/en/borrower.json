                    }
                ],
                "senses": [
                    {
                        "sense_id": "05f06e7e-e5fe-3488-9845-ef5ab4ab1723",
                        "entry_id": "f80610fa-e43f-3806-aad9-7bab991ad874",
                        "glosses": [
                            "One who borrows."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9441e978-0339-4403-9d96-0c8ba4f35df7",
                                "sense_id": "05f06e7e-e5fe-3488-9845-ef5ab4ab1723",
                                "text": "a library borrower’s card"
                            },
                            {
                                "example_id": "077e3006-438d-4cc6-a192-32c96f867c91",
                                "sense_id": "05f06e7e-e5fe-3488-9845-ef5ab4ab1723",
                                "text": "But if other negative factors are operating simultaneously, or if the borrower's financial status is weak to start with, then one extra adverse development is more likely to affect returns on the loan."
                            },
                            {
                                "example_id": "2b1ebe92-3191-43e1-a654-ced0ab38a8a6",
                                "sense_id": "05f06e7e-e5fe-3488-9845-ef5ab4ab1723",
                                "text": "This term became popular from the late 1960s onwards, languages being neatly divided between borrowers and calquers."
                            },
                            {
                                "example_id": "492c84b1-8fe3-4486-ab90-1fdc166b4281",
                                "sense_id": "05f06e7e-e5fe-3488-9845-ef5ab4ab1723",
                                "text": "For most student loan issues, borrowers work with loan servicers hired by the department rather than directly with FSA staff."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "16a339ce-850f-4be5-b82a-199c459452f1",
                        "source_entry_id": "f80610fa-e43f-3806-aad9-7bab991ad874",
                        "source_sense_id": "05f06e7e-e5fe-3488-9845-ef5ab4ab1723",
                        "source_sense_description": "one who borrows",
                        "target_lang_word": "emprunteur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "emprunteur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "28bdb906-b218-388a-9282-bbc298edac2e",
                                        "entry_id": "97ec137a-babd-336e-ab87-19760662b795",
                                        "glosses": [
                                            "Celui qui emprunte."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe505fda-c287-4c39-8b7b-7ebef13aeff5",
                                                "sense_id": "28bdb906-b218-388a-9282-bbc298edac2e",
                                                "text": "Le prêteur et l’emprunteur."
                                            },
                                            {
                                                "example_id": "36586a78-11dd-4d48-bcf5-ad1cdff15083",
                                                "sense_id": "28bdb906-b218-388a-9282-bbc298edac2e",
                                                "text": "Lorsqu’une agence spécialisée évalue la qualité d’un emprunteur, elle donne à celui-ci une note qu’elle rend publique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c7a36aa7-0da8-311b-9f0c-777a03e835c7",
                                        "entry_id": "97ec137a-babd-336e-ab87-19760662b795",
                                        "glosses": [
                                            "Celui qui a l’habitude d’emprunter."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "emprunteur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2309c881-d1f2-3225-811c-1b081f333a3a",
                                        "entry_id": "fec0f4f2-e946-3d15-8c7a-f104f170aa23",
                                        "glosses": [
                                            "Qui a recours à l’emprunt, qui emprunte."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fee2870b-c45a-460b-a857-9f7e499b19a5",
                                                "sense_id": "2309c881-d1f2-3225-811c-1b081f333a3a",
                                                "text": "Toutes les régions de la planète, toutes les catégories de pays et d’acteurs économiques sont victimes de cette folie emprunteuse."
                                            },
                                            {
                                                "example_id": "c2175f98-ed3f-4942-b726-60aef522a95a",
                                                "sense_id": "2309c881-d1f2-3225-811c-1b081f333a3a",
                                                "text": "L’entreprise emprunteuse doit rembourser les sommes prévues aux dates prévues dans l’accord."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dbc914c1-748d-38ce-9db5-1e2fa3c5aa7f",
                                        "entry_id": "fec0f4f2-e946-3d15-8c7a-f104f170aa23",
                                        "glosses": [
                                            "Se dit d’une langue qui emprunte un ou des termes à une autre langue (dite donneuse)."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5465a903-622f-4ae2-8d0e-9b5e93b70bf9",
                                                "sense_id": "dbc914c1-748d-38ce-9db5-1e2fa3c5aa7f",
                                                "text": "L’emprunt intégré peut prendre dans la langue emprunteuse des sens qu’il n’a pas dans la langue donneuse et se différencier ainsi du xénisme."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
