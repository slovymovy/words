    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "be98713e-26c4-31ce-8035-68ed472b3149",
                    "sense_definition": "showing a lack of proper concern or being dismissive of important matters",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "attitude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The manager's <w>cavalier</w> attitude toward safety regulations worried the factory workers.",
                            "target_lang_translations": {
                                "ru": "<w>Беспечное</w> отношение менеджера к правилам техники безопасности беспокоило рабочих завода."
                            }
                        },
                        {
                            "text": "He dismissed my serious concerns with a <w>cavalier</w> shrug of his shoulders.",
                            "target_lang_translations": {
                                "ru": "Он отмахнулся от моих серьезных опасений <w>пренебрежительным</w> пожиманием плеч."
                            }
                        }
                    ],
                    "synonyms": [
                        "disdainful",
                        "curt",
                        "brusque"
                    ],
                    "common_phrases": [
                        "cavalier attitude",
                        "cavalier fashion",
                        "cavalier disregard"
                    ],
                    "target_lang_definitions": {
                        "ru": "проявляющий отсутствие должной заботы или пренебрежительное отношение к важным вопросам"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "беспечный",
                                "target_lang_sense_clarification": "не проявляющий должной серьезности"
                            },
                            {
                                "target_lang_word": "пренебрежительный",
                                "target_lang_sense_clarification": "выражающий неуважение или безразличие"
                            },
                            {
                                "target_lang_word": "легкомысленный",
                                "target_lang_sense_clarification": "необдуманный и поверхностный"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1189940c-6b3b-3aa9-8973-9e4a2debb3ac",
                    "sense_definition": "behaving in a haughty or supercilious manner, as if superior to others",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "attitude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The nobleman treated the servants with a <w>cavalier</w> arrogance that was hard to ignore.",
                            "target_lang_translations": {
                                "ru": "Дворянин относился к слугам с таким <w>высокомерным</w> высокомерием, которое трудно было игнорировать."
                            }
                        },
                        {
                            "text": "She was known for her <w>cavalier</w> manners when dealing with people she considered beneath her.",
                            "target_lang_translations": {
                                "ru": "Она была известна своими <w>надменными</w> манерами в общении с людьми, которых считала ниже себя."
                            }
                        }
                    ],
                    "synonyms": [
                        "haughty",
                        "disdainful"
                    ],
                    "antonyms": [
                        "stiff"
                    ],
                    "common_phrases": [
                        "cavalier manners"
                    ],
                    "target_lang_definitions": {
                        "ru": "ведущий себя надменно или высокомерно, как если бы вы были выше других"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "высокомерный",
                                "target_lang_sense_clarification": "считающий себя выше других"
                            },
                            {
                                "target_lang_word": "надменный",
                                "target_lang_sense_clarification": "полный гордости и пренебрежения"
                            },
                            {
                                "target_lang_word": "заносчивый",
                                "target_lang_sense_clarification": "дерзко-высокомерный"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "88d4cf98-881a-3b93-ace8-af99850d2f12",
                    "sense_definition": "free and easy in manner; unconcerned with strict formalities",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "attitude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He walked with a <w>cavalier</w> grace that suggested he was comfortable in any social setting.",
                            "target_lang_translations": {
                                "ru": "Он шел с <w>непринужденным</w> изяществом, которое говорило о том, что он чувствует себя комфортно в любой обстановке."
                            }
                        },
                        {
                            "text": "The artist lived a <w>cavalier</w> lifestyle, ignoring the rigid expectations of high society.",
                            "target_lang_translations": {
                                "ru": "Художник вел <w>беспечный</w> образ жизни, игнорируя жесткие ожидания высшего общества."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "свободный и непринужденный в манерах; не обремененный строгими формальностями"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "непринужденный",
                                "target_lang_sense_clarification": "свободный от условностей"
                            },
                            {
                                "target_lang_word": "беспечный",
                                "target_lang_sense_clarification": "легкий и беззаботный"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "583ca0c4-6a07-3e72-8847-f71699a3aa13",
                    "sense_definition": "relating to the supporters of King Charles I during the English Civil War",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "historical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>cavalier</w> forces were eventually defeated by the disciplined New Model Army.",
                            "target_lang_translations": {
                                "ru": "<w>Кавалерские</w> войска в конечном итоге были разбиты дисциплинированной Армией нового образца."
                            }
                        },
                        {
                            "text": "Historians often contrast <w>cavalier</w> poetry with the more somber works of the Puritans.",
                            "target_lang_translations": {
                                "ru": "Историки часто противопоставляют <w>кавалерскую</w> поэзию более мрачным произведениям пуритан."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "British history"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "относящийся к сторонникам короля Карла I во время Английской гражданской войны"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кавалерский",
                                "target_lang_sense_clarification": "относящийся к роялистам"
                            },
                            {
                                "target_lang_word": "роялистский",
                                "target_lang_sense_clarification": "поддерживающий монархию"
                            }
                        ]
                    }
                }
            ]
        },
        {
