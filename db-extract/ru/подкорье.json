                                "target_senses": [
                                    {
                                        "sense_id": "9520a600-6254-35fd-aa30-1296dba82c5f",
                                        "entry_id": "4d853923-1036-3c55-9383-081cb6d484b8",
                                        "glosses": [
                                            "The sound of something relatively heavy splashing or squelching into water."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6f8d6f7c-65f9-4ec4-8935-1f95d521332f",
                                                "sense_id": "9520a600-6254-35fd-aa30-1296dba82c5f",
                                                "text": "[…] rain, too, had lately fallen, and had decidedly not evaporated, since, at every step, I went squash! squash! up to the tops of my boots, and many times very extent, stretching to the eastward, […]"
                                            },
                                            {
                                                "example_id": "979c1169-6d6b-41ff-8abc-5a2e8099f737",
                                                "sense_id": "9520a600-6254-35fd-aa30-1296dba82c5f",
                                                "text": "[…] to catch all the rain […]; my boots went squash, squash, as I turned on to the high road, […]"
                                            },
                                            {
                                                "example_id": "f9586db8-a851-494a-84cf-c51a3b126a3a",
                                                "sense_id": "9520a600-6254-35fd-aa30-1296dba82c5f",
                                                "text": "1883, May 5 […] The words had only left his mouth when his feet slipped from under him, and with a dull, sickening thud, he went squash! into the water, waist-deep. We made our way to bed in a silence that was painful."
                                            }
                                        ]
                                    }
                                ]
