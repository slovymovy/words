    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "af844065-c0fd-3856-b968-db23ca1f4680",
                "word": "Billy",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "30bfeae6-d702-3cbd-95af-14dd3f4790c2",
                        "entry_id": "af844065-c0fd-3856-b968-db23ca1f4680",
                        "glosses": [
                            "A diminutive of the male given name William."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3bb3e754-bd45-40be-ac02-8f0443daf7bc",
                                "sense_id": "30bfeae6-d702-3cbd-95af-14dd3f4790c2",
                                "text": "“By the way,” Jessamy went on, “what’s your other name? You never told me.” “Stubbs,” said Billy, “William Stubbs!”."
                            },
                            {
                                "example_id": "82077948-e009-4aa4-b3e1-2c79dfb7a3b3",
                                "sense_id": "30bfeae6-d702-3cbd-95af-14dd3f4790c2",
                                "text": "Then there’s Billy Long, a former auctioneer and Republican congressman who Trump nominated and was confirmed less than two months ago to head the Internal Revenue Service, with “little background in tax policy beyond promoting a fraud-riddled tax credit”. Long has already been fired after clashing with the treasury secretary, Scott Bessent. Long was the sixth person to head the IRS this year."
                            }
                        ]
                    },
                    {
                        "sense_id": "f3735a1f-a9b5-362e-9974-1d0ed90c4e9c",
                        "entry_id": "af844065-c0fd-3856-b968-db23ca1f4680",
                        "glosses": [
                            "The B-25 twin-engine bomber aircraft used during World War Two, commonly called the \\\"B-25 Mitchell\\\" in honor of U.S. Army General William \\\"Billy\\\" Mitchell."
                        ],
                        "tags": [
                            "US"
                        ],
                        "examples": [
                            {
                                "example_id": "b08515d1-c6ac-4397-995e-cb5035a032de",
                                "sense_id": "f3735a1f-a9b5-362e-9974-1d0ed90c4e9c",
                                "text": "Just then a squadron of \"Billys\" -- twin-engined B-25 Mitchell land-based bombers -- flew overhead …."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "64f09759-f98a-4259-baa6-49842ecc71c1",
                        "source_entry_id": "af844065-c0fd-3856-b968-db23ca1f4680",
                        "source_sense_description": "a diminutive of the male given name William — see also Bill",
