                ],
                "senses": [
                    {
                        "sense_id": "7cc6fafa-cbae-312d-9b35-d4d779a1def7",
                        "entry_id": "a01d0863-2713-396b-a7fa-22a306133e21",
                        "glosses": [
                            "(ursprünglich im tropischen und subtropischen Südamerika vorkommender, artenreicher) zu den Wunderblumen gehörender Strauch oder kleiner Baum, dessen rosa, gelbliche oder weiße Blütenhülle an einem roten, violetten oder weißen Hochblatt wächst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f22fec38-a7f0-4806-b7c2-8c73c0aaacc5",
                                "sense_id": "7cc6fafa-cbae-312d-9b35-d4d779a1def7",
                                "text": "„Auch die üppig blühenden Bougainvillee und Azaleen vor dem Portal mussten mit aufs Foto.“"
                            },
                            {
                                "example_id": "f79fac0d-7034-46f9-b9ca-ddea9ac913c1",
                                "sense_id": "7cc6fafa-cbae-312d-9b35-d4d779a1def7",
                                "text": "„Die Gattung Bougainvillee umfasst 18 Arten, welche alle in Südamerika beheimatet sind.“"
                            },
                            {
                                "example_id": "7aca01e7-dd70-41f7-a3b9-9ff106cf3872",
                                "sense_id": "7cc6fafa-cbae-312d-9b35-d4d779a1def7",
                                "text": "„Unter dem Vordach des Hauses, das mindestens doppelt so groß ist wie die Nachbarhäuser, wachsen in dekorativen Pflanzkübeln Engelstrompete, Bougainvillee und Keulenlilie wahrscheinlich zu stattlichen Prachtexemplaren heran.“"
                            },
                            {
                                "example_id": "15952a05-90df-4741-aaa1-c7e97ed5630b",
                                "sense_id": "7cc6fafa-cbae-312d-9b35-d4d779a1def7",
                                "text": "„So schön Strauchmargerite, Bougainvillee, Lorbeerbaum und Engelstrompete auch sind: Die Überwinterung kann einem immer wieder Kopfzerbrechen bereiten, erst recht, wenn die Pflanzen größer werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
