                ],
                "senses": [
                    {
                        "sense_id": "60f79e5a-f741-3df0-9d3f-71272c2c11f0",
                        "entry_id": "4d3a8e3e-5258-32ff-9cd0-b346326a6a46",
                        "glosses": [
                            "mechanisches Geduldsspiel in Form eines Würfels, das durch Drehen einzelner Ebenen des Würfels verändert werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b346cdbc-2cc6-4b50-8dfd-41b632c3c9c6",
                                "sense_id": "60f79e5a-f741-3df0-9d3f-71272c2c11f0",
                                "text": "Einige lösen den Zauberwürfel in weniger als einer Minute."
                            },
                            {
                                "example_id": "110371ba-8c1a-4982-bf10-b2408be7177b",
                                "sense_id": "60f79e5a-f741-3df0-9d3f-71272c2c11f0",
                                "text": "Als ich den Zauberwürfel das erste Mal geschafft hatte, brauchte ich eine halbe Stunde."
                            },
                            {
                                "example_id": "769555a8-5431-4385-8a5e-9e9894680609",
                                "sense_id": "60f79e5a-f741-3df0-9d3f-71272c2c11f0",
                                "text": "Nachdem er den Zauberwürfel gelöst hatte, mischte er ihn sofort wieder."
                            },
                            {
                                "example_id": "83f18d6c-5af8-444a-9882-3813e8aa7933",
                                "sense_id": "60f79e5a-f741-3df0-9d3f-71272c2c11f0",
                                "text": "„Rubik und seine britischen Geschäftspartner wollen, dass der weltweit jährlich zehn Millionen Mal verkaufte Zauberwürfel in der Europäischen Union weiterhin als dreidimensionale Marke geschützt bleibt - wogegen die deutsche Spielzeugfirma Simba Toys geklagt hat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5d303297-5da5-4f8b-a1cc-c1df388f52d2",
                        "source_entry_id": "4d3a8e3e-5258-32ff-9cd0-b346326a6a46",
                        "source_sense_id": "60f79e5a-f741-3df0-9d3f-71272c2c11f0",
