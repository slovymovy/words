            "senses": [
                {
                    "sense_id": "361a0a03-8840-31e0-9d90-b95b69cc6a1c",
                    "sense_definition": "Informal short form of <w>university</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She plans to go to <w>uni</w> to study law next year.",
                            "target_lang_translations": {
                                "ru": "В следующем году она планирует поступить в <w>универ</w>, чтобы изучать право.",
                                "zh": "她打算明年上<w>大学</w>学法律。"
                            }
                        },
                        {
                            "text": "Most of my friends live in student housing near the <w>uni</w>.",
                            "target_lang_translations": {
                                "ru": "Большинство моих друзей живут в студенческом общежитии рядом с <w>универом</w>.",
                                "zh": "我大部分朋友都住在<w>大学</w>附近的学生宿舍。"
                            }
                        }
                    ],
                    "synonyms": [
                        "college",
                        "varsity",
                        "university"
                    ],
                    "common_phrases": [
                        "go to uni",
                        "at uni",
                        "uni student"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "common in British, Australian, and New Zealand English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Разговорное сокращение от слова «университет».",
                        "zh": "“university”（大学）的口语简称"
                    },
