                                                "sense_id": "c5b4cf02-d7f3-3f52-a7e4-38bc80570391",
                                                "text": "Keiner darf die teure Vase antasten. Nur ansehen ist erlaubt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "afdefae3-56fc-3de0-9391-b9e88a6bd8d5",
                                        "entry_id": "3e21a528-24f9-3e67-b940-4defd48d1cff",
                                        "glosses": [
                                            "an den Verbrauch bestimmter Waren/Rücklagen gehen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "65bccc99-222d-4528-a060-14c6e5c38b54",
                                                "sense_id": "afdefae3-56fc-3de0-9391-b9e88a6bd8d5",
                                                "text": "Wir sollten die Reserven wirklich noch nicht antasten."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "47ec44ef-976c-374d-ac0d-39d6b112dc40",
