                ],
                "senses": [
                    {
                        "sense_id": "32acd892-7c0f-39de-a77c-2e8fd4c6081b",
                        "entry_id": "b0ddd6d3-7173-31d5-bd47-aa9a28f45720",
                        "glosses": [
                            "geringere Distanz, die mühelos zu Fuß zurückgelegt werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8a4131a4-a8af-481b-9f2b-5761f4bd7dee",
                                "sense_id": "32acd892-7c0f-39de-a77c-2e8fd4c6081b",
                                "text": "„In einigen Städten, so in Berlin, Frankfurt oder Bremen, haben sich bereits sogenannte Car-sharing-Gruppen gegründet: Mit einer Kapitaleinlage von zumeist 1000 Mark teilen sich bis zu 10 Leute ein Gemeinschaftsauto; der Wagen ist jeweils in Fußnähe deponiert, pro Fahrkilometer werden 25 bis 35 Pfennig berechnet.“"
                            },
                            {
                                "example_id": "c6f68b96-a0ff-4800-ae68-d25ea74a4995",
                                "sense_id": "32acd892-7c0f-39de-a77c-2e8fd4c6081b",
                                "text": "„Da in Fußnähe zur Kita kein geeignetes Gelände liegt, fährt ein Zivildienstleistender des Umweltamtes die Gruppe an den Paddelteich.“"
                            },
                            {
                                "example_id": "eda5e26e-821a-478b-adfb-4be5a40961d0",
                                "sense_id": "32acd892-7c0f-39de-a77c-2e8fd4c6081b",
                                "text": "„Auch in Berlin sollte der Platz nicht allzu weit vom Arbeitsplatz Reichstag entfernt sein, möglichst nicht mehr als zwei Kilometer, Fußnähe Regierungsviertel, hieß es im Amtsdeutsch.“"
                            },
                            {
                                "example_id": "dd658cb3-2a10-4ab6-a335-f7afeccf6063",
                                "sense_id": "32acd892-7c0f-39de-a77c-2e8fd4c6081b",
                                "text": "„‚Die Fußnähe zum Reichstag war für mich entscheidend‘, sagt der stellvertretende FDP-Fraktionsvorsitzende Rainer Brüderle.“"
                            },
                            {
                                "example_id": "8deb7002-d000-40ea-a85c-02f445adf9b2",
                                "sense_id": "32acd892-7c0f-39de-a77c-2e8fd4c6081b",
                                "text": "„Ein weiterer Vorteil ist die Fußnähe zu meiner Wohnung, in der ich mein Büro für Illustration, Buchführung und Marketing eingerichtet habe.“"
                            },
                            {
                                "example_id": "c19a0c46-7533-4df2-8ced-e59c55cabef3",
                                "sense_id": "32acd892-7c0f-39de-a77c-2e8fd4c6081b",
                                "text": "„Der Ettelbrücker Bahnhof befindet sich in bequemer Fußnähe der Ausstellung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "31f61be6-51ae-486f-a485-53a6db092953",
                        "source_entry_id": "b0ddd6d3-7173-31d5-bd47-aa9a28f45720",
                        "source_sense_id": "32acd892-7c0f-39de-a77c-2e8fd4c6081b",
                        "source_sense_description": "geringere Distanz, die mühelos zu Fuß zurückgelegt werden kann",
                        "target_lang_word": "walking distance",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "walking distance",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ab2f11cb-c95d-3736-8b26-24f382581023",
                                        "entry_id": "e693122b-4e5d-3d73-b86c-0fcbc7b7a360",
                                        "glosses": [
                                            "A distance that a person can reasonably walk."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0c842bc7-f147-44b4-9f9d-1184df10f44d",
                                                "sense_id": "ab2f11cb-c95d-3736-8b26-24f382581023",
                                                "text": "Measuring the Walkable Community The Charter of the New Urbanism states that “many activities of daily living should occur within walking distance,\n allowing independence to those who do not drive, especially the elderly and the young.[...”]"
                                            },
                                            {
                                                "example_id": "f5c5c073-4080-4de3-8bbb-8afbb1b8769a",
                                                "sense_id": "ab2f11cb-c95d-3736-8b26-24f382581023",
                                                "text": "The lower the population density, the lower the risk of herd mentality running amok.\nThe greater the quantity of food grown within walking distance, the lower the risk of starvation."
                                            },
                                            {
                                                "example_id": "ef385fd3-8c75-4be7-bb8e-eade5db494ac",
                                                "sense_id": "ab2f11cb-c95d-3736-8b26-24f382581023",
                                                "text": "Today is match day, Grimsby Town are at home, and the ground is walking distance from New Clee station. So, visiting football supporters coming by train have to change at Grimsby Town [station]. That's a real pain."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a7975807-a461-43e3-9627-56ca15cfdfd9",
                        "source_entry_id": "b0ddd6d3-7173-31d5-bd47-aa9a28f45720",
                        "source_sense_id": "32acd892-7c0f-39de-a77c-2e8fd4c6081b",
