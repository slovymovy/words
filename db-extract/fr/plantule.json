                ],
                "senses": [
                    {
                        "sense_id": "b3de1410-e1f5-3162-878f-06cbf709f0c9",
                        "entry_id": "2c2b10f2-a211-3fb9-89d9-3434cee67352",
                        "glosses": [
                            "Embryon végétal qui commence à se développer par la germination."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "fb16c92f-bbaf-364b-9f23-f5c9709851a0",
                        "entry_id": "2c2b10f2-a211-3fb9-89d9-3434cee67352",
                        "glosses": [
                            "Jeune plante, ne comportant que quelques feuilles, obtenue peu de temps après la germination de la graine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "743280bf-13db-4c31-87d9-a2199891c7a4",
                                "sense_id": "fb16c92f-bbaf-364b-9f23-f5c9709851a0",
                                "text": "Chez une plantule sensible, le parasite pénètre au niveau du collet, développe du mycélium et des haustoria qui envahissent tous les parenchymes."
                            },
                            {
                                "example_id": "f687737a-d19d-43cf-9758-d2ab7568ac22",
                                "sense_id": "fb16c92f-bbaf-364b-9f23-f5c9709851a0",
                                "text": "Dans les taillis âgés (25-30 ans) peu éclairés, la strate herbacée, particulièrement pauvre et monotone, est réduite aux plantules de Quercus qui tapissent le sol sous le couvert des arbres réservés."
                            },
                            {
                                "example_id": "a9e11565-dc20-49ec-af93-e56327d7b7b5",
                                "sense_id": "fb16c92f-bbaf-364b-9f23-f5c9709851a0",
                                "text": "Cependant, les associations à base de MCPP sont encore actives sur des adventices déjà développées, alors que l'association à base de dinoterbe n'est efficace que sur des plantules, ce qui incite à réaliser des traitements précoces avec cette association."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "832c31e9-2782-441e-9964-371e54aefabb",
                        "source_entry_id": "2c2b10f2-a211-3fb9-89d9-3434cee67352",
                        "source_sense_description": "Jeune plante",
                        "target_lang_word": "Sämling",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sämling",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7b72e364-e7b1-3708-a4e3-96e4463a14be",
                                        "entry_id": "7e9328c2-41c9-30bf-9020-90b87bb3becf",
                                        "glosses": [
                                            "junge, aus Samen durch Keimung selbstständig hervorgegangene oder vom Menschen gezogene Pflanze"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "375bee3b-5abd-4231-8601-3a18c476d8a2",
                                                "sense_id": "7b72e364-e7b1-3708-a4e3-96e4463a14be",
                                                "text": "Fast 40.000 Sämlinge zieht Klaus Olbricht in Dresden jährlich aus Kreuzungen heran."
                                            },
                                            {
                                                "example_id": "d0c5a7bb-855b-4d7c-bd6c-8fbbb47aad7f",
                                                "sense_id": "7b72e364-e7b1-3708-a4e3-96e4463a14be",
                                                "text": "Vor der Haustür war aus einem Sämling ein Vogelbeerbaum gewachsen, die Beeren hatten die gleiche Farbe wie die roten Ziegel auf dem Dach."
                                            },
                                            {
                                                "example_id": "e59dd2fe-9ca4-4415-8ff2-9fcd21e3902b",
                                                "sense_id": "7b72e364-e7b1-3708-a4e3-96e4463a14be",
                                                "text": "Silbrig glitzernde Schleimspuren auf Wegen und Tischen, erschreckende Fraßbilder an zarten Gewächsen, spurlos verschwundene Sämlinge, und die neue Mandragora, von der wir eine zauberkräftige Alraunwurzel zu gewinnen hofften, ist rettungslos dahin: Alle reden wieder von den Schnecken."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ee2248c6-acd9-358c-89bd-4f0e35c376c2",
                                        "entry_id": "7e9328c2-41c9-30bf-9020-90b87bb3becf",
                                        "glosses": [
                                            "Kurzform für die Rebsorte Sämling 88"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab7d34aa-9212-4c7f-90f8-240cc10068c6",
                                                "sense_id": "ee2248c6-acd9-358c-89bd-4f0e35c376c2",
                                                "text": "Sämling, der österreichische Begriff für die klassische Scheurebe, hat als typische Aromen tropische Früchte und Pfirsich im Gepäck."
                                            },
                                            {
                                                "example_id": "55b41d1c-e9f3-419c-a058-a8fed7dec3bf",
                                                "sense_id": "ee2248c6-acd9-358c-89bd-4f0e35c376c2",
                                                "text": "Die 2006er Auslese von Tschida vom Neusiedlersee, eine Cuvée aus Sämling, Chardonnay und Weißburgunder, passt trotz ihrer Lieblichkeit mit feinen Säure perfekt zu den Früchten des Nachtischs."
                                            },
                                            {
                                                "example_id": "ed92c1ec-460d-4a1d-966f-9b795f2eb469",
                                                "sense_id": "ee2248c6-acd9-358c-89bd-4f0e35c376c2",
                                                "text": "Dieser besteht aus Sämling und Sauvignon Blanc, hat eine absolut spannenden exotischen Duft, Zitrus-Töne, ist spritzig und leicht am Gaumen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
