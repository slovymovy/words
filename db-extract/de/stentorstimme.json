                                "example_id": "18b91696-c483-47ad-b1ca-0793f7c0deb4",
                                "sense_id": "27924659-236b-39c0-b31a-9fb4c7c5a171",
                                "text": "„Wer war dem Manne mit der Stentorstimme gewachsen, der fünfzig Menschen mit Leichtigkeit überschrie?“"
                            },
                            {
                                "example_id": "ecfeb890-7906-46ab-a1a0-07e6b91b745f",
                                "sense_id": "27924659-236b-39c0-b31a-9fb4c7c5a171",
                                "text": "„„Die lateinische Grammatik steht auch über dem Kaiser!“, donnerte Plazentius mit Stentorstimme in die Runde.“"
                            }
                        ],
