                "senses": [
                    {
                        "sense_id": "f753c1c1-1383-368a-b006-7ba1c3271117",
                        "entry_id": "abc92940-709a-3bb1-971d-71a0d7c1d119",
                        "glosses": [
                            "rezitatives Singen in einer Art Sprechgesang"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "891cae62-aa68-43af-a48b-2cd2568315b3",
                                "sense_id": "f753c1c1-1383-368a-b006-7ba1c3271117",
                                "text": "„Der betonte Subjektivismus spätgriechischer Musik unterscheidet sich jedoch grundsätzlich von der einfachen Objektivität der Psalmodie.“"
                            },
                            {
                                "example_id": "b780bbf5-79f3-4ebd-9758-04b5526c4c0f",
                                "sense_id": "f753c1c1-1383-368a-b006-7ba1c3271117",
                                "text": "„Damit liegt eigentlich schon das Prinzip der Psalmodie vor.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d626ccc0-c807-4db7-b601-55d973d84c56",
                        "source_entry_id": "abc92940-709a-3bb1-971d-71a0d7c1d119",
