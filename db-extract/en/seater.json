                "senses": [
                    {
                        "sense_id": "091b1d0d-3df1-390a-abe6-251e6004e981",
                        "entry_id": "f5d2e7c5-8842-3818-aaa8-87093e4bbf6d",
                        "glosses": [
                            "A vehicle or item of furniture that has a specified seating capacity."
                        ],
                        "tags": [
                            "attributive",
                            "in-compounds",
                            "often"
                        ],
                        "examples": [
                            {
                                "example_id": "1d292d59-b4ac-4c66-ada6-a690c7eff26b",
                                "sense_id": "091b1d0d-3df1-390a-abe6-251e6004e981",
                                "text": "a single-seater aircraft"
                            },
                            {
                                "example_id": "0cfadae5-fc5d-481e-8cc3-66d5526eb4f7",
                                "sense_id": "091b1d0d-3df1-390a-abe6-251e6004e981",
                                "text": "Our new sofa is a three-seater."
                            },
                            {
                                "example_id": "68e9f36d-8d51-4bf0-9c66-dac1db6ec3c8",
                                "sense_id": "091b1d0d-3df1-390a-abe6-251e6004e981",
                                "text": "The Cub is a two-place tandem-seating craft, while the Luscombe and Cessna 120/140 are two-place side-by-side seaters."
                            },
                            {
                                "example_id": "c262a24a-66a4-4c9f-8cd8-fbbbe3e0070c",
                                "sense_id": "091b1d0d-3df1-390a-abe6-251e6004e981",
                                "text": "The four-seater i-oniq concept has a 1.0-litre, 3-cylinder petrol engine which is mated, via a generator, to a lithium ion electric motor which produces 109 PS."
                            },
                            {
                                "example_id": "01d23a19-f575-44e2-8a4b-157ee678ba33",
                                "sense_id": "091b1d0d-3df1-390a-abe6-251e6004e981",
                                "text": "Toyota is developing a hydrogen fuel cell car, but the research and development costs are eye-watering. By contrast, a British firm, Riversimple, is producing a cheap, compact two-seater, which will probably come to dominate the small car market, particularly for drivers who cannot plug in a car at home."
                            },
                            {
                                "example_id": "4f347047-5133-446e-9c10-bb1dbda89bdc",
                                "sense_id": "091b1d0d-3df1-390a-abe6-251e6004e981",
                                "text": "“I started to think about it. He’s coming in on a two-seater experimental plane to pitch me to go on a five-seater experimental sub that he has built down to the ocean floor to see the Titanic,” Jay said."
                            },
                            {
                                "example_id": "a469f942-1853-4025-a4bf-f4ca10460c3f",
                                "sense_id": "091b1d0d-3df1-390a-abe6-251e6004e981",
                                "text": "I've heard it's a one-seater, and I really need my privacy when I go."
                            }
                        ]
                    },
