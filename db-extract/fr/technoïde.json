                    }
                ],
                "senses": [
                    {
                        "sense_id": "a8461f72-01aa-3672-a35c-1111baf0974d",
                        "entry_id": "460f4f49-cfe7-3548-acc1-b73b3028cdd5",
                        "glosses": [
                            "Relatif à la techno."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "71a6f5c5-afa4-4104-933e-ab70e3887141",
                                "sense_id": "a8461f72-01aa-3672-a35c-1111baf0974d",
                                "text": "Outre-Manche, on a baptisé \"dubstep\" cette adaptation technoïde du dub (genre musical étant lui-même la version instrumentale et expérimentale du reggae) devenue un des courants de musiques électroniques les plus aventureux et influents de ces dix dernières années."
                            }
                        ]
                    },
                    {
                        "sense_id": "d400f6d1-10b8-38ce-8328-075faec59c54",
                        "entry_id": "460f4f49-cfe7-3548-acc1-b73b3028cdd5",
                        "glosses": [
                            "Technique, technologique."
                        ],
                        "tags": [
                            "Nuance négative"
                        ],
                        "examples": [
                            {
                                "example_id": "67edc29e-692a-47c9-8ede-f4a5f4ff9fae",
                                "sense_id": "d400f6d1-10b8-38ce-8328-075faec59c54",
                                "text": "Pour quelques jours, l'un des quartiers les plus pauvres de Manaus se transforme en résurgence lointaine de mégalopoles technoïdes et lumineuses, façon mini-Séoul ou micro-Tokyo."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2357d9d0-4123-4beb-9cdc-60f4c5be0fb2",
                        "source_entry_id": "460f4f49-cfe7-3548-acc1-b73b3028cdd5",
                        "target_lang_word": "technoid",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "technoid",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "519a4268-b1d3-347c-877b-0ae71910b5bf",
                                        "entry_id": "3cbe1d16-4f9c-37d9-aa41-b55a365325cf",
                                        "glosses": [
                                            "Pertaining to the functionality or operation of a technology; technical."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c364e22-ffbd-4aac-8924-bf60127ca1cb",
                                                "sense_id": "519a4268-b1d3-347c-877b-0ae71910b5bf",
                                                "text": "DLL is VB's runtime library, which allows VB programs to interact with Windows and do other low-level, behind-the-screens, technoid stuff."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "54af1799-6382-3195-9892-5085513f1c75",
                                        "entry_id": "3cbe1d16-4f9c-37d9-aa41-b55a365325cf",
                                        "glosses": [
                                            "Exhibiting, requiring, or characteristic of an interest in and/or proficiency with technology."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e4da2c65-ea66-41da-8497-4e20af760b74",
                                                "sense_id": "54af1799-6382-3195-9892-5085513f1c75",
                                                "text": "Some folks are put off by the technoid aura of the hard-core BBS network, but the fact is that laser printing — and desktop publishing in general — is rapidly evolving, cutting-edge territory."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "92be5e8f-6e94-3cef-aabc-427e218780d2",
                                        "entry_id": "3cbe1d16-4f9c-37d9-aa41-b55a365325cf",
                                        "glosses": [
                                            "Electronic or electronic-sounding; resembling techno music."
                                        ],
                                        "tags": [
                                            "of music"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "08b1cb45-bf13-43e4-afa5-b36543b00cd5",
                                                "sense_id": "92be5e8f-6e94-3cef-aabc-427e218780d2",
                                                "text": "She hinted at this strategy on 2001's Vespertine, where her vocals pulsed along with music seemingly keyed to her own internal rhythms instead of getting lost in technoid tangles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cdca5361-8085-359c-a814-718cc7de2a4b",
                                        "entry_id": "3cbe1d16-4f9c-37d9-aa41-b55a365325cf",
                                        "glosses": [
                                            "Of or pertaining to an aesthetic style which uses industrial or technological forms, materials, and themes."
                                        ],
                                        "tags": [
                                            "of art or design"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8ab4101f-1d2e-422f-a67c-3e377e1307c1",
                                                "sense_id": "cdca5361-8085-359c-a814-718cc7de2a4b",
                                                "text": "We are looking into an area in which biomorphic and technoid objects seem to exist in a Utopian atmosphere."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "technoid",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "af9a2e3b-cbde-37bc-8412-35fa474d2d3b",
                                        "entry_id": "72c5ed7b-412b-3751-ada9-d8007dc8fad1",
                                        "glosses": [
                                            "A person interested in or skilled with technology."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "98982f4b-fd6b-4494-aa6d-15583fb69daf",
                                                "sense_id": "af9a2e3b-cbde-37bc-8412-35fa474d2d3b",
                                                "text": "Says Gates in his characteristic computerspeak: \"I was a hard-core technoid.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f20a81bf-e262-45b0-aa2e-879c280b251c",
                        "source_entry_id": "460f4f49-cfe7-3548-acc1-b73b3028cdd5",
                        "target_lang_word": "geeky",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
