                ],
                "senses": [
                    {
                        "sense_id": "b8c711b1-be33-378b-8dfa-62491473e2a8",
                        "entry_id": "aa852631-9f01-3f54-8919-e1de0ce7c693",
                        "glosses": [
                            "regelmatig regenend of neigend naar regen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "84cf7152-3a13-49b9-b627-df9b29779388",
                                "sense_id": "b8c711b1-be33-378b-8dfa-62491473e2a8",
                                "text": "Vandaag wordt het een regenachtige dag."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "35b29e91-2f0b-4800-bd08-1eddf6d3e17f",
                        "source_entry_id": "aa852631-9f01-3f54-8919-e1de0ce7c693",
                        "source_sense_id": "b8c711b1-be33-378b-8dfa-62491473e2a8",
                        "source_sense_description": "regelmatig regenend of neigend naar regen",
                        "target_lang_word": "regnerisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "regnerisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e678e4e6-6037-36a6-ab01-eceda7dc56a2",
                                        "entry_id": "7fd960ff-3308-346d-a63d-b303a22e6113",
                                        "glosses": [
                                            "immer wieder von Regenfällen betroffen, zu häufigem Regen neigend; von tief hängenden, regenschweren Wolken bedeckt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb962564-fd40-4b18-84c0-0eb4e1d6a61a",
                                                "sense_id": "e678e4e6-6037-36a6-ab01-eceda7dc56a2",
                                                "text": "Während der nächsten Wochen ist mit regnerischem Wetter zu rechnen."
                                            },
                                            {
                                                "example_id": "3cf86231-9dce-4c30-bba1-2bbbe2f1867d",
                                                "sense_id": "e678e4e6-6037-36a6-ab01-eceda7dc56a2",
                                                "text": "„Aus diesem Grunde nahm er solche Aufträge scheinbar gleichmütig hin und verschwieg sogar, als er eine anstrengende zweitägige Geschäftsreise machen sollte, eine ernstliche Verkühlung, um sich nur nicht der Gefahr auszusetzen, mit Berufung auf das gerade herrschende regnerische Herbstwetter von der Reise abgehalten zu werden.“"
                                            },
                                            {
                                                "example_id": "f70e6377-756c-4f5e-a4e5-73fea34ff08d",
                                                "sense_id": "e678e4e6-6037-36a6-ab01-eceda7dc56a2",
                                                "text": "„Das Wetter bleibt warm und regneriſch.“"
                                            },
                                            {
                                                "example_id": "f666c68d-e7e7-442e-bf82-5953785fccbd",
                                                "sense_id": "e678e4e6-6037-36a6-ab01-eceda7dc56a2",
                                                "text": "„Es war ein kühler, regnerischer Morgen, und sie blieb allein.“"
                                            },
                                            {
                                                "example_id": "0f7b89f1-05ed-4bc3-b90f-dcd635414bd5",
                                                "sense_id": "e678e4e6-6037-36a6-ab01-eceda7dc56a2",
                                                "text": "„In die Turnhalle fällt das fahle, trübe Licht eines regneriſchen Oktobertages.“"
                                            },
                                            {
                                                "example_id": "5b7f4298-39ef-490a-a507-2900d60f785b",
                                                "sense_id": "e678e4e6-6037-36a6-ab01-eceda7dc56a2",
                                                "text": "„Ich habe die regnerische Nacht nicht draussen verbringen mögen.“"
                                            },
                                            {
                                                "example_id": "e3b6c202-a4f1-4d5f-af70-9434ed866894",
                                                "sense_id": "e678e4e6-6037-36a6-ab01-eceda7dc56a2",
                                                "text": "„An einem regnerischen Sonntagvormittag brütete ich über meinem Roman.“"
                                            },
                                            {
                                                "example_id": "87f6f3e7-070f-4e8d-a9c3-5b026aa33e57",
                                                "sense_id": "e678e4e6-6037-36a6-ab01-eceda7dc56a2",
                                                "text": "„Die zahlreichen Passagen laden besonders bei regnerischem Wetter zum Bummeln ein, in einer, wir verraten nicht, in welcher, läutet regelmäßig ein Glockenspiel aus Meißner Porzellan.“"
                                            },
                                            {
                                                "example_id": "70542c8a-2297-40a8-bdc4-81eca6c1f13c",
                                                "sense_id": "e678e4e6-6037-36a6-ab01-eceda7dc56a2",
                                                "text": "„An einem fast schon hochsommerlichen Nachmittag in diesem sonst kühlen und regnerischen Mai war das Unvermeidliche passiert: Myrtha und David waren sich begegnet.“"
                                            },
                                            {
                                                "example_id": "bb2e5ab6-2866-4ca0-b8ec-31f19dcc2dfd",
                                                "sense_id": "e678e4e6-6037-36a6-ab01-eceda7dc56a2",
                                                "text": "„Geschrieben in einem schattenreichen Zimmer, in dem von den 24 Stunden zwei beleuchtet sind, denn ein dunkler, regnerischer Sommer nimmt zusätzlich der Stadt die letzte Chance eines kurzen Glücks und legt seit dem Frühjahr einen Herbst über ihre Trümmer.“"
                                            },
                                            {
                                                "example_id": "8d7e81de-5bbe-4eb3-9d22-46f12e8cb21c",
                                                "sense_id": "e678e4e6-6037-36a6-ab01-eceda7dc56a2",
                                                "text": "„Der November ist regnerisch und eisig.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "55f42f31-2b6a-41a3-ad71-32304a13997b",
                        "source_entry_id": "aa852631-9f01-3f54-8919-e1de0ce7c693",
                        "source_sense_id": "b8c711b1-be33-378b-8dfa-62491473e2a8",
                        "source_sense_description": "regelmatig regenend of neigend naar regen",
                        "target_lang_word": "rainy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rainy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "141a5c4f-7d7b-339c-aaf1-5f9b7ab99636",
                                        "entry_id": "f53549df-8636-36fc-90d5-3b51ab75496c",
                                        "glosses": [
                                            "Pouring with rain; wet; showery"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf3b6c4e-05b5-48b5-be27-8c1d6ebb3902",
                                                "sense_id": "141a5c4f-7d7b-339c-aaf1-5f9b7ab99636",
                                                "text": "Due to the rainy weather, we decided not to play in the park."
                                            },
                                            {
                                                "example_id": "8cc1fdba-ef06-4bd2-b147-e226a16a31f7",
                                                "sense_id": "141a5c4f-7d7b-339c-aaf1-5f9b7ab99636",
                                                "text": "It's a very rainy day, so let's stay indoors."
                                            },
                                            {
                                                "example_id": "2a764338-0e85-4488-9e4c-e9307e02bb4f",
                                                "sense_id": "141a5c4f-7d7b-339c-aaf1-5f9b7ab99636",
                                                "text": "This is itself a cheerless spot, particularly on a rainy day, when, overshadowed by the great massif of rock that towers in the background, and surrounded by the grey and cheerless quarries, it has a depressing character much in contrast with the green verdure encountered on the northern end of this interesting branch line."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "61ada92a-4fe7-487c-8253-0094ffba43d2",
                        "source_entry_id": "aa852631-9f01-3f54-8919-e1de0ce7c693",
                        "source_sense_id": "b8c711b1-be33-378b-8dfa-62491473e2a8",
                        "source_sense_description": "regelmatig regenend of neigend naar regen",
                        "target_lang_word": "pluvieux",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pluvieux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5c7cdc2f-01ac-39d0-9411-b99ef80e3834",
                                        "entry_id": "c2fca855-87da-3c39-be3f-0719dbe0c7e6",
                                        "glosses": [
                                            "Se dit du temps et de la saison, lorsqu’ils sont abondants en pluie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c5a8a0ba-4264-49ea-84b6-9870d9519559",
                                                "sense_id": "5c7cdc2f-01ac-39d0-9411-b99ef80e3834",
                                                "text": "De tous les passagers, le plus amusant est sans contredit un bon bourgeois de Glasgow qui cherche dans les voyages un remède au spleen que lui cause le climat pluvieux de son pays."
                                            },
                                            {
                                                "example_id": "2d06fb77-d9bd-463f-ae4f-fa13b04f3bf4",
                                                "sense_id": "5c7cdc2f-01ac-39d0-9411-b99ef80e3834",
                                                "text": "L’un des rescapés, le père Lannuzel, évoque un « trou pluvieux » et pour qu’un Breton se plaigne de la pluie, c’est que les précipitations devaient être conséquentes !"
                                            },
                                            {
                                                "example_id": "8fddfec1-10fe-4e5e-a688-aeb913219105",
                                                "sense_id": "5c7cdc2f-01ac-39d0-9411-b99ef80e3834",
                                                "text": "En une station pluviométrique donnée, sera considéré comme pluvieux un jour où la hauteur de pluie relevée est supérieure à une valeur prédéterminée, appelée seuil."
                                            },
                                            {
                                                "example_id": "27883413-e9c6-4c07-a630-ed9d5f433639",
                                                "sense_id": "5c7cdc2f-01ac-39d0-9411-b99ef80e3834",
                                                "text": "Si le percepteur n'était pas arrivé dans la région avant le début de la saison pluvieuse, les villageois étaient sûrs d'échapper pour un an au prélèvement fiscal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5cf0adb2-da75-3242-8a6e-4fe29bfb6de8",
                                        "entry_id": "c2fca855-87da-3c39-be3f-0719dbe0c7e6",
                                        "glosses": [
                                            "Qui amène la pluie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53deff15-b911-46d3-b7e1-dc07e8a85d69",
                                                "sense_id": "5cf0adb2-da75-3242-8a6e-4fe29bfb6de8",
                                                "text": "Un vent pluvieux."
                                            },
                                            {
                                                "example_id": "48769d4b-1657-4f64-be2a-28a24ab7e821",
                                                "sense_id": "5cf0adb2-da75-3242-8a6e-4fe29bfb6de8",
                                                "text": "C’est pourquoi la meilleure part de notre mémoire est hors de nous, dans un souffle pluvieux, dans l’odeur de renfermé d’une chambre ou dans l’odeur d’une première flambée, partout où nous retrouvons de nous-même ce que notre intelligence, n’en ayant pas l’emploi, avait dédaigné, la dernière réserve du passé, la meilleure, celle qui, quand toutes nos larmes semblent taries, sait nous faire pleurer encore."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bf2adda3-b4de-33ad-91eb-ec03b499195f",
                                        "entry_id": "c2fca855-87da-3c39-be3f-0719dbe0c7e6",
                                        "glosses": [
                                            "Relatif à, ou évocateur de la pluie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "640f80a9-3cf9-4bfd-b5d0-ed218faa3397",
                                                "sense_id": "bf2adda3-b4de-33ad-91eb-ec03b499195f",
                                                "text": "Je garde encore assez de hardiesse pour gagner le haut des rochers où je m’attarde, soit à considérer les nuages sauvages et inquiets, soit à voir venir de l’horizon les hyades pluvieuses, les pléiades ou le grand Orion ; […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
