                        ],
                        "examples": [
                            {
                                "example_id": "ee7e82c7-6dfc-4085-9b00-29b6a31428bf",
                                "sense_id": "4f35537a-eab8-3a96-81ba-6474e4162390",
                                "text": "Lieve pa, van harte, je zou vandaag tachtig jaar zijn geworden."
                            },
                            {
                                "example_id": "cb057464-c8de-426b-9b2a-9fa999ba9d58",
                                "sense_id": "4f35537a-eab8-3a96-81ba-6474e4162390",
                                "text": "Die lieve kleine rolmops in mijn nek, die op haar manier zo'n onnavolgbaar begrip en inlevingsvermogen heeft."
                            },
                            {
                                "example_id": "2417fd49-b884-4369-a91d-030ee184dc8c",
                                "sense_id": "4f35537a-eab8-3a96-81ba-6474e4162390",
                                "text": "Hoe vaak heb ik dat niet gehoord? Mijn lieve moeder die met iedereen kon opschieten, ze was zo flegmatisch."
                            }
                        ]
                    }
                ],
