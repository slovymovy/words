                        "target_lang_word": "Steinmetz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Steinmetz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "74117e18-68fb-3b34-add7-32bc6d35c40b",
                                        "entry_id": "872619fe-1b11-3765-94fe-0efe949ecf49",
                                        "glosses": [
                                            "Handwerker, der Stein bearbeitet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6469fd1d-15af-4bae-a7bc-77566e9ea79f",
                                                "sense_id": "74117e18-68fb-3b34-add7-32bc6d35c40b",
                                                "text": "Der Steinmetz haut den Stein mit Knüppel und Eisen."
                                            },
                                            {
                                                "example_id": "1480d27b-d97a-4f75-8efd-b30282727c35",
                                                "sense_id": "74117e18-68fb-3b34-add7-32bc6d35c40b",
                                                "text": "Der Steinmetz nutzt Knüppel und Eisen, um den Stein zu hauen."
                                            },
                                            {
                                                "example_id": "b5b779ad-c74e-4fa0-9cf9-dcc730b3408b",
                                                "sense_id": "74117e18-68fb-3b34-add7-32bc6d35c40b",
                                                "text": "„Das mächtige Kreuz vor der Kirche, von Steinmetzen aus heimischem Basalt gehauen, imponiert durch seine monumentale Größe ebenso wie durch seine Aussagekraft als Mahnmal für die Toten der beiden Weltkriege des 20. Jahrhunderts (…).“"
                                            },
                                            {
                                                "example_id": "e054b6ab-2e67-444b-80f1-1fbeaac72df9",
                                                "sense_id": "74117e18-68fb-3b34-add7-32bc6d35c40b",
                                                "text": "„Obwohl es erfahrene Steinmetze auf den Färöern gab, würde es dennoch schwierig werden, eine tüchtige Schar Handwerker zu finden, die ein Steinhaus bauen konnten.“"
                                            },
                                            {
                                                "example_id": "c7625ed7-811a-4946-a4c5-b7f4174e7855",
                                                "sense_id": "74117e18-68fb-3b34-add7-32bc6d35c40b",
                                                "text": "„Dann brauchte man allerdings Steinmetze, die unterwegs die Sache rund machten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Steinmetz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "76aa317e-a300-3b9c-a917-9b3d88eafda5",
                                        "entry_id": "27d982a8-7173-3067-b140-124ad8637190",
                                        "glosses": [
                                            "deutscher Nachname, Familienname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee5c55ee-020f-4dca-9051-409966b86924",
                                                "sense_id": "76aa317e-a300-3b9c-a917-9b3d88eafda5",
                                                "text": "Herr Steinmetz ist als Kaninchenzüchter erfolgreich."
                                            },
                                            {
                                                "example_id": "3a6d694d-d993-4421-aa59-b1e8a155da50",
                                                "sense_id": "76aa317e-a300-3b9c-a917-9b3d88eafda5",
                                                "text": "Herr Steinmetz heiratet im September auf Hawaii."
                                            },
                                            {
                                                "example_id": "e65e0575-d3db-4fc8-a871-974975ec5012",
                                                "sense_id": "76aa317e-a300-3b9c-a917-9b3d88eafda5",
                                                "text": "Frau Steinmetz liebt es, an Weihnachten Plätzchen zu backen."
                                            },
                                            {
                                                "example_id": "ae92e811-58dd-4a29-898b-9e80dac1ad0d",
                                                "sense_id": "76aa317e-a300-3b9c-a917-9b3d88eafda5",
                                                "text": "Die Steinmetzes lieben die Natur und die Tiere."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
