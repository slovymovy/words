                        "entry_id": "f7215715-a43d-350c-8c29-515405efb8d4",
                        "glosses": [
                            "The process by which an apparent association between an exposure and an outcome is actually explained by another factor."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7796c2e4-f814-4a4c-a97b-f07569d39f56",
                                "sense_id": "72b99f9b-c93c-368a-a999-73e08bc6c9a9",
                                "text": "Confounding is defined as the confusion or distortion of measures of association between exposure and outcome as a result of third (or more) variable(s)."
                            }
                        ]
                    }
