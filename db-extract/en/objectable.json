                        "glosses": [
                            "Capable of being put forward as an objection."
                        ],
                        "tags": [
                            "archaic",
                            "possibly",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "49a3f5dc-a898-4f5e-912e-d1ce6b0ce4ac",
                                "sense_id": "cc2978b9-3379-3922-8248-3e2556d4a1fb",
                                "text": "It is as objectable against all those things which either native beauty or art affords."
                            },
                            {
                                "example_id": "c0e1a3fb-0081-477f-ba27-f02d3b91f2ea",
                                "sense_id": "cc2978b9-3379-3922-8248-3e2556d4a1fb",
                                "text": "Whether any thing truly objectable against any Bishop or Minister of England (as scandalously weak, wicked and unworthy) may not with as much more truth be objected against their severest enemies."
                            },
                            {
                                "example_id": "d2f89af7-0129-4790-802c-d8e2e5cf6c17",
                                "sense_id": "cc2978b9-3379-3922-8248-3e2556d4a1fb",
                                "text": "The Commission granted to Kidd had nothing in it objectable in point of Law, [...]"
                            }
                        ]
                    },
                    {
                        "sense_id": "7e0c2b2e-bccd-3d49-9cc6-816e5bb50986",
                        "entry_id": "82111c49-f7b1-3710-8b2c-667aa13f0c32",
                        "glosses": [
                            "Capable of being made into or treated as an object (especially by a computer program or programming language)."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "a74d6271-279b-4b93-8c41-059be4703edb",
                                "sense_id": "7e0c2b2e-bccd-3d49-9cc6-816e5bb50986",
                                "text": "Here we use the position of each region inside the image, its size, structure and adjacency relations to the other prominent regions or to the background. First we apply a so-called preprocessing step, in which we separate objectable images from non-objectable ones with the meaning of whether or not the given image contains prominent regions."
                            }
                        ]
                    },
