                "senses": [
                    {
                        "sense_id": "a5ef4fa2-594d-369d-82ed-e47db3e0b8b2",
                        "entry_id": "452eb864-4784-3408-87ee-402869d15379",
                        "glosses": [
                            "Épier pour épier, sans objectif propre."
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "d71bdb1b-8638-4d4d-9f6c-94087c3ec433",
                                "sense_id": "a5ef4fa2-594d-369d-82ed-e47db3e0b8b2",
                                "text": "Je scénais par la fenêtre à matin, les nouveaux voisins ont l’air assez arrogants !"
                            },
                            {
                                "example_id": "c1a98f99-52da-4dbf-a209-9dfac46e987d",
                                "sense_id": "a5ef4fa2-594d-369d-82ed-e47db3e0b8b2",
                                "text": "Y'a préféré scèner // Au salon étudiant // Plutôt que de s'faire chier // D'vant un prof emmerdant",
                                "translation": "Les Cowboys Fringants, \"Ti-Cul\" (La Grand-Messe, 2005)"
                            },
                            {
                                "example_id": "d60ba572-e7d2-46d8-bdd8-132805d18f34",
                                "sense_id": "a5ef4fa2-594d-369d-82ed-e47db3e0b8b2",
                                "text": "«Scéner» chez le voisin, comme dirait l’autre, c’est drôle, mais ça peut finir par devenir déprimant à la longue, particulièrement dans les univers numériques."
                            }
                        ]
                    }
                ],
