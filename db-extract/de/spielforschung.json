                "senses": [
                    {
                        "sense_id": "2c670ddc-6bcc-39d1-bc3c-19f683a29a97",
                        "entry_id": "7548b6ce-eee0-3014-9106-b987e30df80c",
                        "glosses": [
                            "wissenschaftliche Aufarbeitung und systematische Dokumentation des Phänomens Spiel, seiner historischen, psychologischen, pädagogischen, gesellschaftlichen, kulturanthropologischen Bedeutung und seines entsprechenden Problemfeldes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cfce7ce6-f7f5-4abb-a7d1-cb2b2abae5b6",
                                "sense_id": "2c670ddc-6bcc-39d1-bc3c-19f683a29a97",
                                "text": "„Wie soll die Spielforschung die neuen Spielformen bewerten - als Zeichen der Selbstinfantilisierung der Gesellschaft?“"
                            },
                            {
                                "example_id": "ed8cc4f1-84dc-4692-a1f9-0da788a93214",
                                "sense_id": "2c670ddc-6bcc-39d1-bc3c-19f683a29a97",
                                "text": "„Mit den jüngeren Entwicklungen der Spielforschung und der Literatur über das Kinderspiel Schritt zu halten, ist kaum noch möglich.“"
                            },
                            {
                                "example_id": "f9ffcbdf-fa14-48c0-84b0-65eae871c677",
                                "sense_id": "2c670ddc-6bcc-39d1-bc3c-19f683a29a97",
                                "text": "„Der nachfolgende Merkmalskatalog unternimmt es, die Eigenart des menschlichen Spielens entsprechend dem Stand der Spielforschung über ihre wesentlichen Aspekte zu charakterisieren.“"
                            },
                            {
                                "example_id": "ec4f181e-64e4-4e24-905a-125a2cc73723",
                                "sense_id": "2c670ddc-6bcc-39d1-bc3c-19f683a29a97",
                                "text": "„Es bedeutet aber, dass sorgfältige Beobachtung zu einer unerlässlichen Bedingung jeder kinderpsychologischen Forschung und damit auch der Spielforschung gehört.“"
                            },
                            {
                                "example_id": "43f4bac9-ad9c-47fa-87b8-c416d0a195c3",
                                "sense_id": "2c670ddc-6bcc-39d1-bc3c-19f683a29a97",
                                "text": "„Die neuere Spielforschung hat gewissermaßen Piaget nunmehr auf seiner eigenen Ebene widersprochen und dabei das Spiel als Forschungsgegenstand erst wieder freigelegt.“"
                            },
                            {
                                "example_id": "0b0b413f-744d-40e9-8a61-e37624ef5a21",
                                "sense_id": "2c670ddc-6bcc-39d1-bc3c-19f683a29a97",
                                "text": "„Angesichts der Ergebnisse der neueren Spielforschung […] ist es erforderlich, noch stärker die Spielanregungsmethoden herauszustellen, die den Kindern helfen, die kognitiven, emotionalen und sozialen Lernmöglichkeiten im Spiel zu nutzen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
