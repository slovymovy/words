                    ]
                },
                {
                    "sense_id": "ab34b790-9a97-303b-8100-545db9acb4b2",
                    "sense_definition": "Held or lifted up; prevented from proceeding.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "interruption",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mechanical arms remained <w>suspense</w> until the safety sequence was completed."
                        },
                        {
                            "text": "He watched the great light remain <w>suspense</w> in the sky above the darkening hills."
                        }
                    ],
                    "synonyms": [
