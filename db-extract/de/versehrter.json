                            {
                                "example_id": "a3691e1c-2cd2-492f-a6e8-d7761a609a6f",
                                "sense_id": "0885297b-6784-3640-a6b1-06f62b2295c6",
                                "text": "„Viele andere Frauen mussten dagegen ganz konkret um das Leben ihrer Gatten, Söhne, Brüder oder Väter fürchten, die bereits im Einsatz waren; oft hatten sie auch schon Verwandte verloren und mussten sich auf die Rückkehr von Versehrten und Invaliden einstellen.“"
                            },
                            {
                                "example_id": "158c631b-a8d5-43d0-9cfe-f9b0fae45040",
                                "sense_id": "0885297b-6784-3640-a6b1-06f62b2295c6",
                                "text": "„An manchen Tagen gelangt ein schier nicht endender Strom an Versehrten durch die Glastüren in die Garmischer Nothilfe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
