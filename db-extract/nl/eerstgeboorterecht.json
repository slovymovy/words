                "senses": [
                    {
                        "sense_id": "a0da355a-70a2-3a82-889d-c9f864d4c15a",
                        "entry_id": "b85c8ca4-6691-33ab-9827-c33473d96935",
                        "glosses": [
                            "de rechten van het oudste kind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "384ad4f5-7232-46c8-b482-7f4ab8fe5021",
                                "sense_id": "a0da355a-70a2-3a82-889d-c9f864d4c15a",
                                "text": "Dat Amalia de titel nu wel mag gebruiken, is te danken aan de grondwetswijziging van 1983. Daarin werd vastgelegd dat de sekse van de troonopvolger voortaan geen invloed meer had. Zo ging voortaan ook het eerstgeboorterecht gelden: tot die tijd zou een jongere broer van Amalia voorrang hebben gehad bij de opvolging."
                            },
                            {
                                "example_id": "a7fa03d0-49ba-4304-a962-10e1f3101cea",
                                "sense_id": "a0da355a-70a2-3a82-889d-c9f864d4c15a",
                                "text": "Toch was Groot-Brittannië niet de enige monarchie met de ouderwetse regel. Er zijn veel landen die het pas laat hebben ingevoerd. In Denemarken mag de eerstgeborene pas sinds 2009 de troon op en Nepal wijzigde de regel pas in 2006. Ook in Noorwegen en Luxemburg geldt het eerstgeboorterecht pas sinds een paar jaar."
                            }
                        ]
                    }
