{
    "word_family": [
        "кнопочка",
        "кнопочный"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "75a3008d-8e0d-3a3e-a134-5c4c451be8f8",
                    "sense_definition": "Механическое устройство, на которое нажимают пальцем для включения, выключения или управления чем-либо",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "control_device",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Нажмите красную <w>кнопку</w>, чтобы остановить машину.",
                            "target_lang_translations": {
                                "en": "Press the red <w>button</w> to stop the car.",
                                "de": "Drücken Sie den roten <w>Knopf</w>, um die Maschine anzuhalten."
                            }
                        },
                        {
                            "text": "Я долго искал <w>кнопку</w> звонка у входной двери.",
                            "target_lang_translations": {
                                "en": "I looked for the doorbell <w>button</w> at the front door for a long time.",
                                "de": "Ich habe lange nach dem <w>Klingelknopf</w> an der Eingangstür gesucht."
                            }
                        }
                    ],
                    "common_phrases": [
                        "нажать кнопку",
                        "кнопка вызова",
                        "красная кнопка"
                    ],
                    "target_lang_definitions": {
                        "en": "A mechanical device pressed with a finger to switch something on, off, or control it",
                        "de": "Ein mechanisches Bedienelement, das man mit dem Finger drückt, um etwas ein-, aus- oder umzuschalten oder zu steuern."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "button",
                                "target_lang_sense_clarification": "mechanical device"
                            },
                            {
                                "target_lang_word": "push button",
                                "target_lang_sense_clarification": "specific type"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Knopf",
                                "target_lang_sense_clarification": "mechanischer Bedienknopf an einem Gerät"
                            },
                            {
                                "target_lang_word": "Druckknopf",
                                "target_lang_sense_clarification": "Drückknopf, besonders zum Betätigen durch Drücken"
                            },
                            {
                                "target_lang_word": "Taster",
                                "target_lang_sense_clarification": "bei Klingeln oder ähnlichen Vorrichtungen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "49b8a30a-d411-380c-99f6-19763494835e",
                    "sense_definition": "Элемент интерфейса в компьютерной программе или на сайте, на который можно нажать курсором или пальцем для выполнения действия",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "control_device",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Наведите курсор на <w>кнопку</w> «ОК» и щёлкните по ней.",
                            "target_lang_translations": {
                                "en": "Hover the cursor over the 'OK' <w>button</w> and click on it.",
                                "de": "Bewegen Sie den Cursor auf die <w>Schaltfläche</w> „OK“ und klicken Sie darauf."
                            }
                        },
                        {
                            "text": "Эта <w>кнопка</w> позволяет сохранить документ на диск.",
                            "target_lang_translations": {
                                "en": "This <w>button</w> allows you to save the document to disk.",
                                "de": "Diese <w>Schaltfläche</w> ermöglicht es, das Dokument auf der Festplatte zu speichern."
                            }
                        }
                    ],
                    "common_phrases": [
                        "кнопка мыши",
                        "кнопка меню",
                        "сенсорная кнопка"
                    ],
                    "target_lang_definitions": {
                        "en": "An interface element in a computer program or website that can be clicked with a cursor or finger to perform an action",
                        "de": "Ein Bedienelement in einem Computerprogramm oder auf einer Website, das man mit dem Cursor oder dem Finger anklicken oder antippen kann, um eine Aktion auszuführen."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "button",
                                "target_lang_sense_clarification": "interface element"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Schaltfläche",
                                "target_lang_sense_clarification": "allgemein in Programmen und auf Websites"
                            },
                            {
                                "target_lang_word": "Button",
                                "target_lang_sense_clarification": "sehr häufig im Computerkontext"
                            },
                            {
                                "target_lang_word": "Knopf",
                                "target_lang_sense_clarification": "umgangssprachlich für ein klickbares Bedienelement"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "94f17dfb-99ae-3070-9d92-33a4295a3ef4",
                    "sense_definition": "Канцелярский предмет в виде короткого острия с широкой шляпкой для прикрепления бумаги к поверхности",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "fastener",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Учитель прикрепил расписание к доске с помощью <w>кнопки</w>.",
                            "target_lang_translations": {
                                "en": "The teacher attached the schedule to the board using a <w>thumbtack</w>.",
                                "de": "Der Lehrer befestigte den Stundenplan mit einer <w>Reißzwecke</w> an der Tafel."
                            }
                        },
                        {
                            "text": "Осторожно, на полу валяется острая канцелярская <w>кнопка</w>.",
                            "target_lang_translations": {
                                "en": "Careful, there is a sharp <w>thumbtack</w> lying on the floor.",
                                "de": "Vorsicht, auf dem Boden liegt eine spitze <w>Reißzwecke</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "канцелярская кнопка",
                        "приколоть кнопкой"
                    ],
                    "target_lang_definitions": {
                        "en": "A stationery item in the form of a short point with a wide head for attaching paper to a surface",
                        "de": "Ein kurzer spitzer Gegenstand mit breitem Kopf, mit dem man Papier an einer Oberfläche befestigt."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "thumbtack",
                                "target_lang_sense_clarification": "stationery (US)"
                            },
                            {
                                "target_lang_word": "drawing pin",
                                "target_lang_sense_clarification": "stationery (UK)"
                            },
                            {
                                "target_lang_word": "pushpin",
                                "target_lang_sense_clarification": "variant with plastic head"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Reißzwecke",
                                "target_lang_sense_clarification": "kanzleilicher Gegenstand zum Befestigen von Papier"
                            },
                            {
                                "target_lang_word": "Heftzwecke",
                                "target_lang_sense_clarification": "allgemein, regional ebenfalls gebräuchlich"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d20bc1ea-631f-3be1-a09e-bc0190687413",
                    "sense_definition": "Вид застёжки на одежде, состоящей из двух металлических или пластиковых частей, которые входят одна в другую",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "fastener",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Она быстро застегнула <w>кнопки</w> на своём плаще.",
                            "target_lang_translations": {
                                "en": "She quickly fastened the <w>snaps</w> on her raincoat.",
                                "de": "Sie machte schnell die <w>Druckknöpfe</w> an ihrem Mantel zu."
                            }
                        },
                        {
                            "text": "На детской одежде <w>кнопки</w> удобнее, чем пуговицы.",
                            "target_lang_translations": {
                                "en": "On children's clothes, <w>snaps</w> are more convenient than buttons.",
                                "de": "Bei Kinderkleidung sind <w>Druckknöpfe</w> praktischer als normale Knöpfe."
                            }
                        }
                    ],
                    "common_phrases": [
                        "застегнуть кнопку",
                        "куртка на кнопках"
                    ],
                    "target_lang_definitions": {
                        "en": "A type of fastener on clothing consisting of two metal or plastic parts that fit into each other",
                        "de": "Eine Art Verschluss an Kleidung aus zwei Metall- oder Kunststoffteilen, die ineinandergedrückt werden."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "snap",
                                "target_lang_sense_clarification": "clothing fastener"
                            },
                            {
                                "target_lang_word": "press stud",
                                "target_lang_sense_clarification": "clothing fastener (UK)"
                            },
                            {
                                "target_lang_word": "popper",
                                "target_lang_sense_clarification": "informal"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Druckknopf",
                                "target_lang_sense_clarification": "Kleidungsverschluss aus zwei zusammendrückbaren Teilen"
                            },
                            {
                                "target_lang_word": "Druckverschluss",
                                "target_lang_sense_clarification": "allgemein für diesen Verschlusstyp"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d7da9b43-590a-3a72-992d-9ef683e7343d",
                    "sense_definition": "Телевизионный канал",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "tv_channel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Этот популярный сериал показывают на первой <w>кнопке</w>.",
                            "target_lang_translations": {
                                "en": "This popular series is shown on the first <w>channel</w>.",
                                "de": "Diese beliebte Serie läuft auf dem ersten <w>Fernsehkanal</w>."
                            }
                        },
                        {
                            "text": "Чтобы получить право вещать на этой <w>кнопке</w>, нужна лицензия.",
                            "target_lang_translations": {
                                "en": "To get the right to broadcast on this <w>channel</w>, a license is needed.",
                                "de": "Um auf diesem <w>Fernsehkanal</w> senden zu dürfen, braucht man eine Lizenz."
                            }
                        }
                    ],
                    "synonyms": [
                        "канал"
                    ],
                    "common_phrases": [
                        "первая кнопка",
                        "шестая кнопка"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A television channel",
                        "de": "Ein Fernsehsender beziehungsweise Fernsehkanal."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "channel",
                                "target_lang_sense_clarification": "TV broadcast"
                            },
                            {
                                "target_lang_word": "button",
                                "target_lang_sense_clarification": "metonymy for channel number"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Fernsehkanal",
                                "target_lang_sense_clarification": "Fernsehsender oder TV-Kanal; passend zur eigentlichen Bedeutung"
                            },
                            {
                                "target_lang_word": "Sender",
                                "target_lang_sense_clarification": "im Alltag oft einfacher für den ausgestrahlten Kanal"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e68f9114-0d7c-3c93-8092-42b6acf2c1bf",
                    "sense_definition": "Человек очень маленького роста или маленький ребёнок",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "small_person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Посмотри, какая забавная <w>кнопка</w> играет в песочнице!",
                            "target_lang_translations": {
                                "en": "Look what a funny <w>peanut</w> is playing in the sandbox!",
                                "de": "Schau, was für ein lustiger kleiner <w>Knirps</w> im Sandkasten spielt!"
                            }
                        },
                        {
                            "text": "Я думал, она высокая, а она на самом деле такая <w>кнопка</w>.",
                            "target_lang_translations": {
                                "en": "I thought she was tall, but she's actually such a <w>shrimp</w>.",
                                "de": "Ich dachte, sie sei groß, aber in Wirklichkeit ist sie so ein <w>Zwerg</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "карлик",
                        "лилипут",
                        "клоп"
                    ],
                    "antonyms": [
                        "великан"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        },
                        {
                            "trait_type": "slang",
                            "comment": "шутливое"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A person of very short stature or a small child",
                        "de": "Eine sehr kleine Person oder ein kleines Kind; meist umgangssprachlich und oft scherzhaft oder liebevoll."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "shrimp",
                                "target_lang_sense_clarification": "colloquial, short person"
                            },
                            {
                                "target_lang_word": "peanut",
                                "target_lang_sense_clarification": "affectionate, small child"
                            },
                            {
                                "target_lang_word": "tiny thing",
                                "target_lang_sense_clarification": "colloquial"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Knirps",
                                "target_lang_sense_clarification": "umgangssprachlich und oft liebevoll für ein kleines Kind"
                            },
                            {
                                "target_lang_word": "Zwerg",
                                "target_lang_sense_clarification": "umgangssprachlich für eine sehr kleine Person"
                            },
                            {
                                "target_lang_word": "Knopf",
                                "target_lang_sense_clarification": "auch im Deutschen umgangssprachlich für ein kleines Kind"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "14fea60f-3c53-3761-b279-72a793df24f3",
                    "sense_definition": "Маленький или курносый нос",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "nose",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он в шутку нажал пальцем на её нос-<w>кнопку</w>.",
                            "target_lang_translations": {
                                "en": "He jokingly pressed her <w>button nose</w> with his finger.",
                                "de": "Er drückte ihr scherzhaft mit dem Finger auf die <w>Knopfnase</w>."
                            }
                        },
                        {
                            "text": "У этой девушки милое лицо и смешная <w>кнопка</w> вместо носа.",
                            "target_lang_translations": {
                                "en": "This girl has a cute face and a funny <w>button</w> for a nose.",
                                "de": "Dieses Mädchen hat ein süßes Gesicht und eine komische <w>Knopfnase</w> statt einer normalen Nase."
                            }
                        }
                    ],
                    "synonyms": [
                        "нос"
                    ],
                    "common_phrases": [
                        "нос кнопкой"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        },
                        {
                            "trait_type": "slang",
                            "comment": "шутливое"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A small or snub nose",
                        "de": "Eine kleine oder stupsige Nase; umgangssprachlich und oft scherzhaft."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "button nose",
                                "target_lang_sense_clarification": "nose shape"
                            },
                            {
                                "target_lang_word": "button",
                                "target_lang_sense_clarification": "metaphor"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Knopfnase",
                                "target_lang_sense_clarification": "kleine oder leicht nach oben gebogene Nase"
                            },
                            {
                                "target_lang_word": "Stupsnase",
                                "target_lang_sense_clarification": "besonders betont als kurze, leicht aufgeworfene Nase"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}