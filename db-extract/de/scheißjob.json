                "senses": [
                    {
                        "sense_id": "b47c8b13-7461-36f0-95ff-58d6bc6426c3",
                        "entry_id": "8c33ee52-984f-3473-8603-f3d61b3a27e3",
                        "glosses": [
                            "schlechter, unsinniger Job"
                        ],
                        "tags": [
                            "vulgar"
                        ],
                        "examples": [
                            {
                                "example_id": "bb2938a7-6e5b-4e9e-9d26-13fb4194c4c8",
                                "sense_id": "b47c8b13-7461-36f0-95ff-58d6bc6426c3",
                                "text": "„Ich bin dumm, und alles, was ich tue, ist, Dinge zu wollen und zu brauchen. Mein winziges Leben. Mein kleiner Scheißjob. Meine schwedischen Möbel.“"
                            },
                            {
                                "example_id": "7c50565e-376f-434e-be5d-745ae44d70a9",
                                "sense_id": "b47c8b13-7461-36f0-95ff-58d6bc6426c3",
                                "text": "„Sie führen sie in eines der russischen Schiffe hinunter und geben ihr einen der größten Scheißjobs aller Zeiten: Fische zerlegen.“"
                            },
                            {
                                "example_id": "cacb0257-ac94-4889-8e98-bfa115ea01f7",
                                "sense_id": "b47c8b13-7461-36f0-95ff-58d6bc6426c3",
                                "text": "„Und sein Job war Scheiße. Und er hasste sich dafür, dass er an einem solchen Scheißjob festhielt.“"
                            },
                            {
                                "example_id": "bd7649ba-0250-4cdb-9608-dca4f24aa1f0",
                                "sense_id": "b47c8b13-7461-36f0-95ff-58d6bc6426c3",
                                "text": "„Was für ein Scheißjob, diese armen Mäuse zu rasieren.“"
                            },
                            {
                                "example_id": "5d5f067b-f4c7-4772-a78d-41a8fc92797e",
                                "sense_id": "b47c8b13-7461-36f0-95ff-58d6bc6426c3",
                                "text": "„›Gott verdammt‹, sagte der Mann von der Rechtsmedizin, lässt die Beine des Toten fallen, dreht sich um und würgt. ›Gottverdammter Scheißjob, Gott verdammter.‹“"
                            },
                            {
                                "example_id": "a90c14ec-5498-4d30-8ff0-13e65f120788",
                                "sense_id": "b47c8b13-7461-36f0-95ff-58d6bc6426c3",
                                "text": "„Rant sagte: ›Du hast heute deinen Job verloren, stimmt's?‹ Mein blöder Scheißjob, Scheißhandys verkaufen.“"
                            },
                            {
                                "example_id": "0d4a6d66-61ae-44ab-a91c-d16f345cd1ed",
                                "sense_id": "b47c8b13-7461-36f0-95ff-58d6bc6426c3",
                                "text": "„›Es ist ein Scheißjob.‹“"
                            },
                            {
                                "example_id": "f6778230-9ca3-4e13-bce5-d13132803d1b",
                                "sense_id": "b47c8b13-7461-36f0-95ff-58d6bc6426c3",
                                "text": "„›Dann wird er uns den Befehl geben, ihn auszuknipsen - oder er wird's uns büßen lassen, gibt uns nur noch lauter Scheißjobs.‹“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
