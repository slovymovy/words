                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c61e7cfe-336d-398a-b68e-c3a97c89ce26",
                                        "entry_id": "3f7e9e44-b2a8-3f0d-a2d6-209ce2360114",
                                        "glosses": [
                                            "Voice over Internet Protocol, a telecommunications system that uses the Internet or other Internet Protocol network to transmit telephone calls."
                                        ],
                                        "tags": [
                                            "Internet"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "17ea752c-dcf3-4bfa-a543-e59c38bdeff1",
                                                "sense_id": "c61e7cfe-336d-398a-b68e-c3a97c89ce26",
                                                "text": "The VoIP Forum is dedicated to enabling and promoting industry-wide interoperability between products that send telephony over the Internet and private IP enterprise networks. This interoperability will allow seamless transmission of Internet phone calls regardless of the telephony application used by callers and call recipients. At present, applications from different vendors are incompatible due to fundamental differences in voice coding, silence suppression, addressing and dialing plans, call management and other related functions."
                                            },
                                            {
                                                "example_id": "c5d6d77c-60c9-4a79-8b07-57245fb6c732",
                                                "sense_id": "c61e7cfe-336d-398a-b68e-c3a97c89ce26",
                                                "text": "VoIP \"represents a group of competing companies who've gotten together to agree on standards,\" Pulver says. \"It's very important,\" and is good news for users, because their co-operation will move Internet telephony forward, he says."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
