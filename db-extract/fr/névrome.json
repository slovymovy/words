                                "sense_id": "65cac8c0-110d-3bfc-9de2-79fb897f85c3",
                                "text": "Le névrome de Morton est une formation pseudo-tumorale siégeant sur un trajet nerveux à la face plantaire du pied."
                            },
                            {
                                "example_id": "448bbfb5-1a2e-49bd-90f4-566576c980aa",
                                "sense_id": "65cac8c0-110d-3bfc-9de2-79fb897f85c3",
                                "text": "Le névrome de Morton est l’inflammation et le gonflement du nerf plantaire qui surviennent à la suite d’une compression d’une de ses ramifications."
                            }
                        ]
                    }
