                        "examples": [
                            {
                                "example_id": "8157039e-e458-4eb0-abf1-c6ba2412e3ec",
                                "sense_id": "cee313d7-903e-3598-ae7c-9d863e6d108e",
                                "text": "„Wie in Trance war sie zu ihrem Putzeimer gegangen und hatte den Aufnehmer ins Wasser getaucht, um die Gaststube fertig zu putzen.“"
                            },
                            {
                                "example_id": "63861fbb-790b-438b-8188-2d726da54087",
                                "sense_id": "cee313d7-903e-3598-ae7c-9d863e6d108e",
                                "text": "„Ich warf den Aufnehmer über die Kaffeepfütze, die leeren Büchsen und die Eierschalen in den Eimer.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "092993fe-ab9d-3f8a-a208-bbb55f8b1831",
                        "entry_id": "1458eb1e-a022-3555-b2cf-6c65e10e0b74",
