                        "examples": [
                            {
                                "example_id": "f3670bb4-085f-4f23-8e6c-c13e26c127b8",
                                "sense_id": "119de356-dc99-3e96-820f-55b5ea616e6b",
                                "text": "She likes it up the pooper."
                            }
                        ]
                    },
                    {
                        "sense_id": "835f143c-73fa-37cc-a2a7-3b486e355dc4",
                        "entry_id": "1696509f-9937-31e3-9418-23a7fba532c2",
                        "glosses": [
                            "One who poops out on an activity; one who dampens the mood by lack of participation or negative attitude. Mostly used in the phrase party pooper."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "57cfd14c-04a6-4445-9a49-d00bb9efe2a7",
                                "sense_id": "835f143c-73fa-37cc-a2a7-3b486e355dc4",
                                "text": "I wanted us to have fun today. You're such a pooper cleaning the house now!"
                            }
                        ]
                    },
                    {
                        "sense_id": "ccda360c-e5a5-3265-9d8e-2d991bcec497",
                        "entry_id": "1696509f-9937-31e3-9418-23a7fba532c2",
                        "glosses": [
                            "A selection in a slot machine game that ends the picking bonus."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "f8fa0060-9ac2-3b28-bce3-773ac09c21e7",
                        "entry_id": "1696509f-9937-31e3-9418-23a7fba532c2",
                        "glosses": [
                            "One who poops; or, poops well."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "9f94999e-67cb-4d44-9e05-c47419a99231",
                                "sense_id": "f8fa0060-9ac2-3b28-bce3-773ac09c21e7",
                                "text": "Jimmy's toilet training is finally over; he's becoming a good little pooper."
                            }
                        ]
                    },
                    {
                        "sense_id": "43ca296f-6514-3fef-9a97-7edf8c8a6a31",
                        "entry_id": "1696509f-9937-31e3-9418-23a7fba532c2",
                        "glosses": [
