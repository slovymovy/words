                        "examples": [
                            {
                                "example_id": "64a84687-1ff1-4cc6-86de-69a823108d18",
                                "sense_id": "ffa2c16c-fe3d-3704-a029-f17c1ca4545f",
                                "text": "Bouclard entreprit donc à nouveau une réflexion tranquille, encore que ronchonnante, au coin de son poêle en fonte dont les ronronnements essoufflés répondaient en écho à ses soupirs agacés."
                            },
                            {
                                "example_id": "f900f8bc-6c6b-44b8-8bf3-db2586102624",
                                "sense_id": "ffa2c16c-fe3d-3704-a029-f17c1ca4545f",
                                "text": "Qui n’a pas rencontré, dans la rue, de ces passants absorbés et ronchonnants ?"
                            }
                        ]
                    }
