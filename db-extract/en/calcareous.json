                                    {
                                        "sense_id": "b803fc69-ab3f-35df-916f-fa6994a6d5e2",
                                        "entry_id": "baa74d2c-3c7e-3fee-bc6f-6b8b53b96689",
                                        "glosses": [
                                            "lijkend op of eigenschappen hebbend van kalk"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "364b6b13-6701-4a89-9924-d34942fe4616",
                                                "sense_id": "b803fc69-ab3f-35df-916f-fa6994a6d5e2",
                                                "text": "Door het harde water dat bij ons uit de leiding komt zitten er op verschillende plekken in ons huis kalkachtige aanslagen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4a502d4c-9a87-41cc-9b67-e9d6f4cd1c8f",
                        "source_entry_id": "6cbfed49-831d-33ac-8f5a-6bf8ccb0d150",
                        "source_sense_description": "resembling or containing limestone",
                        "target_lang_word": "kalkhoudend",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kalkhoudend",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "5ba3de0c-7dd7-386f-9dc5-e83a68ac42f0",
                                        "entry_id": "0e911873-e906-34f7-b306-ea7603a6317d",
                                        "glosses": [
                                            "kalk bevattende, CaCO3 bevattend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af0b85cf-208a-409c-89c2-9f855b7fa755",
                                                "sense_id": "5ba3de0c-7dd7-386f-9dc5-e83a68ac42f0",
                                                "text": "Het lijkt eigenlijk wel mee te vallen. Er zijn onmiskenbaar verontrustende trends, de snelle ophoping van broeikasgassen in de atmosfeer is sinister, als er opeens veel methaan uit diepzee en toendra vrijkomt kan de opwarming dramatisch versnellen, oceaanverzuring is een serieuze bedreiging voor kalkhoudende organismen en ‘extreme weather events’ (hittegolven, overstromingen) slaan verraderlijk onverwacht toe. Maar of ze vaker voorkomen dan vroeger is nog helemaal niet zo zeker. De vraag moet maar eens gesteld worden: hoeveel klimaatrampen bedreigen ons werkelijk, hoe snel bereiken ze ons en zijn ze echt van bijbelse proporties?"
                                            },
                                            {
                                                "example_id": "a7bb5c40-1518-4a51-9e13-58bc49e97a63",
                                                "sense_id": "5ba3de0c-7dd7-386f-9dc5-e83a68ac42f0",
                                                "text": "Kalkhoudend water noemen we hard water."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a41b9bc9-9921-4102-b510-d6bfe7ed21ed",
