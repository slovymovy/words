                                                "sense_id": "7e6748c1-bcb5-3a1f-a373-5623dde2c266",
                                                "text": "Das Fahren mit dem Fahrrad auf der linken Straßenseite stellt eine Ordnungswidrigkeit dar und kann mit einem Bußgeld geahndet werden."
                                            },
                                            {
                                                "example_id": "1c4c7a10-5d20-49b0-86a9-3a677ba0ab34",
                                                "sense_id": "7e6748c1-bcb5-3a1f-a373-5623dde2c266",
                                                "text": "„Die Bundesnetzagentur ermittelt wegen einer Ordnungswidrigkeit und verhängt ein Bußgeld wegen unerlaubter Frequenznutzung.“"
                                            },
                                            {
                                                "example_id": "a995965b-0f8d-4c38-b563-b4871fcde721",
                                                "sense_id": "7e6748c1-bcb5-3a1f-a373-5623dde2c266",
                                                "text": "„Solch ein Verhalten sollte mit einer Ordnungswidrigkeit geahndet werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
