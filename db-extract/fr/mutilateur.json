                    {
                        "sense_id": "75ecbc3b-b67e-33f5-aca7-2b9f818f1b56",
                        "entry_id": "69a42d37-ca47-3410-98f2-ee98bf5d482d",
                        "glosses": [
                            "Celui qui mutile."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10e52090-33ef-4542-ae2d-edde794f5fdc",
                                "sense_id": "75ecbc3b-b67e-33f5-aca7-2b9f818f1b56",
                                "text": "Horrifiée, la bouche entrouverte, je m’attendais à chaque instant à voir la foudre s’abattre sur le mutilateur en punition d’un si effroyable sacrilège."
                            },
                            {
                                "example_id": "959f8f34-344e-4e70-b955-b96eddf9ce9f",
                                "sense_id": "75ecbc3b-b67e-33f5-aca7-2b9f818f1b56",
                                "text": "La terreur de l’invasion, l’irruption horrible de ces bandes de mutilateurs [les troupes irrégulières de l’armée autrichienne], l’effroyable récit de ce qu’ils faisaient en Alsace."
                            }
                        ]
                    }
                ],
