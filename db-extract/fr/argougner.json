                        "examples": [
                            {
                                "example_id": "15f0a894-c156-4813-af66-6c830584c049",
                                "sense_id": "60707e9b-d5df-30d7-b0eb-f57fc36f5d38",
                                "text": "Le soir, je me fais argougner par le chef d’un village qui me boucle dans une grange avant d’alerter la gendarmerie."
                            },
                            {
                                "example_id": "222e92a0-404b-4dba-9b76-a3b089beb172",
                                "sense_id": "60707e9b-d5df-30d7-b0eb-f57fc36f5d38",
                                "text": "Celui qui se faisait argougner, au commissariat, Double mètre Popincourt le déculottait... d’une paluche, il se le tenait sur ses genoux, de l’autre la fessée fabuleuse avec une raquette de ping-pong !"
                            }
                        ]
                    }
