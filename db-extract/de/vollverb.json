                ],
                "senses": [
                    {
                        "sense_id": "4e76c0d2-5a95-3f43-a7da-284082ed414c",
                        "entry_id": "10e34cc3-9b7a-38d9-ad96-f98c8b3ef7bc",
                        "glosses": [
                            "Verb, das die Funktion des Prädikats in einem Satz alleine übernehmen kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ccff37b-a0ea-44a0-90bc-baf73f2f6cf0",
                                "sense_id": "4e76c0d2-5a95-3f43-a7da-284082ed414c",
                                "text": "In dem Satz „Peter kommt zu spät“ gibt es im Prädikat nur das Vollverb „kommt“."
                            },
                            {
                                "example_id": "a269dc8f-c848-454e-b2db-9d959a1da84e",
                                "sense_id": "4e76c0d2-5a95-3f43-a7da-284082ed414c",
                                "text": "In dem Satz „Peter soll nicht wieder zu spät kommen“ besteht das Prädikat aus dem Vollverb „kommen“ und dem Modalverb „soll“; dabei trägt das Vollverb die lexikalische Bedeutung, während das Hilfsverb weitgehend die Flexion übernimmt."
                            },
                            {
                                "example_id": "f58bf22b-4a71-426e-9729-79ba7a987b71",
                                "sense_id": "4e76c0d2-5a95-3f43-a7da-284082ed414c",
                                "text": "„Als Funktionsverben verlieren die Vollverben ihre eigentliche konkrete Bedeutung, bekommen den Status von Hilfsverben (»zur Entscheidung bringen«) und eine bloß formale Funktion im Satz.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
