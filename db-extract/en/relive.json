                                "target_senses": [
                                    {
                                        "sense_id": "5b264357-eb2c-38cc-99e4-43afa312f490",
                                        "entry_id": "45fdeba4-fd49-3abc-b2f5-2818ad031ed0",
                                        "glosses": [
                                            "tornare in vita, tornare a vivere (per lo più in senso figurato, oppure in ambito religioso)"
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "492798e1-6015-4393-852c-355597ea1218",
                                                "sense_id": "5b264357-eb2c-38cc-99e4-43afa312f490",
                                                "text": "i cristiani credono che i morti rivivranno dopo il giudizio universale"
                                            },
                                            {
                                                "example_id": "bcaf032d-9539-4799-a624-94357129c8fe",
                                                "sense_id": "5b264357-eb2c-38cc-99e4-43afa312f490",
                                                "text": "i nostri cari defunti rivivono nei nostri cuori, finché li ricordiamo"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "264e4a54-921e-3ee5-83dd-8c4037f6a230",
                                        "entry_id": "45fdeba4-fd49-3abc-b2f5-2818ad031ed0",
                                        "glosses": [
                                            "di persone, tornare ad essere vigorosi, in forze o comunque in buona salute fisica e mentale"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "631d2ece-8d87-495a-a2b7-63d15d235bd5",
                                                "sense_id": "264e4a54-921e-3ee5-83dd-8c4037f6a230",
                                                "text": "non sopportavo più il mio lavoro, da quando mi sono licenziato mi sento rivivere"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9f5c2136-7f5a-37af-98c9-c16e20bf3763",
                                        "entry_id": "45fdeba4-fd49-3abc-b2f5-2818ad031ed0",
                                        "glosses": [
                                            "di cose inanimate, tornare in attività, tornare ad essere attivi, animati e funzionali"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7c5efd1c-4baf-40a6-854e-0f1daf174881",
                                                "sense_id": "9f5c2136-7f5a-37af-98c9-c16e20bf3763",
                                                "text": "il nostro paese ha sperimentato una grave recessione economica, ma rivivrà grazie al turismo"
                                            },
                                            {
                                                "example_id": "bf710408-d6e2-4388-a78c-a4c223a9154d",
                                                "sense_id": "9f5c2136-7f5a-37af-98c9-c16e20bf3763",
                                                "text": "la nostra associazione langue, ma con le mie idee la farò rivivere"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "rivivere",
