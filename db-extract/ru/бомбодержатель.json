                        "cross_references": [
                            {
                                "target_word": "lance-bombes",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "99837080-3173-39ca-9e00-9aacd1bbb7df",
                                        "entry_id": "ea839294-917e-3d24-b82e-1e09987be234",
                                        "glosses": [
                                            "Canon de tranchée lançant des bombes."
                                        ],
                                        "tags": [
                                            "Armement"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4997e652-6839-4db6-b7eb-bbcb6288296f",
                                                "sense_id": "99837080-3173-39ca-9e00-9aacd1bbb7df",
                                                "text": "Tout de suite après mon départ, il avait commandé des feux de salve sur les créneaux d’en face, mis en batterie tous nos canons, tous nos lance-bombes."
                                            },
                                            {
                                                "example_id": "acdcdcc1-db5c-45f0-9be0-c39e79a53f1a",
                                                "sense_id": "99837080-3173-39ca-9e00-9aacd1bbb7df",
                                                "text": "Certains de ces lance-bombes, qu’on eût crus relégués à jamais dans les poussiéreuses casemates de nos arsenaux, ont été expédiés dans les tranchées, où un surnom les a rajeunis à jamais, celui des crapouillauds."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a30d4a1e-22a1-3323-ba19-2fb9a023e2f1",
                                        "entry_id": "ea839294-917e-3d24-b82e-1e09987be234",
                                        "glosses": [
                                            "Dispositif permettant à un avion de jeter des bombes de petite taille."
                                        ],
                                        "tags": [
                                            "Armement"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "df46e53e-c109-4586-8fa1-61216eccd8a8",
                                                "sense_id": "a30d4a1e-22a1-3323-ba19-2fb9a023e2f1",
                                                "text": "Ils se procurent un petit avion de tourisme Nord Ecrin, le font équiper à Cognac6 d'un tube lance-bombes grâce à des complicités dans un atelier de mécanique, récupèrent à Tarbes un stock de bombes incendiaires volées à la Luftwaffe."
                                            }
                                        ]
                                    }
                                ]
                            },
