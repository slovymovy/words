                    },
                    {
                        "translation_id": "01ef947c-61fd-454f-af69-ec4b6d1318f7",
                        "source_entry_id": "b60ac8da-d963-3027-9b78-87f3353daab8",
                        "target_lang_word": "Zigarre",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zigarre",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d2eb5f83-d09e-34be-9c5f-8d95736d0fb6",
                                        "entry_id": "0b159b8a-f05c-38c5-8b1d-8281c55c99c7",
                                        "glosses": [
                                            "Tabak, der in ein Tabakblatt eingerollt ist und geraucht wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91993c19-28fe-49bd-9dc2-f74d5076b5ab",
                                                "sense_id": "d2eb5f83-d09e-34be-9c5f-8d95736d0fb6",
                                                "text": "Durch den Geruch einer brennenden Zigarre fühlen sich viele Menschen belästigt."
                                            },
                                            {
                                                "example_id": "0c59349e-0803-40c5-971d-3a4efb142e08",
                                                "sense_id": "d2eb5f83-d09e-34be-9c5f-8d95736d0fb6",
                                                "text": "Handgefertigte Zigarren aus Kuba gelten als die besten und sind teuer."
                                            },
                                            {
                                                "example_id": "2944c0c8-129b-43cd-83b2-0240614c9d89",
                                                "sense_id": "d2eb5f83-d09e-34be-9c5f-8d95736d0fb6",
                                                "text": "Die französische Schriftstellerin George Sand (1804-1876) war eine der ersten Frauen, die in Europa öffentlich Zigarren rauchten[.]"
                                            },
                                            {
                                                "example_id": "986ae2c5-c990-4564-82cf-68a375e18272",
                                                "sense_id": "d2eb5f83-d09e-34be-9c5f-8d95736d0fb6",
                                                "text": "„Für jeden zehn Zigarren, zwanzig Zigaretten und zwei Stück Kautabak, das ist sehr anständig.“"
                                            },
                                            {
                                                "example_id": "70c6f007-b095-4805-ac9d-5b3bba0073fc",
                                                "sense_id": "d2eb5f83-d09e-34be-9c5f-8d95736d0fb6",
                                                "text": "„Allein Ardan gab sich locker und gelöst, führte den Begleitern seine ledernen Gamaschen mit einem von ihm erdachten Schnellknöpfmechanismus vor, suchte sich eine Zigarre aus der Innentasche seines weiten Cordanzugs und steckte sie sich an, ohne daß ihm die Hand dabei zitterte.“"
                                            },
                                            {
                                                "example_id": "dfcb9583-c9a7-4626-a8ab-fe0ef12df960",
                                                "sense_id": "d2eb5f83-d09e-34be-9c5f-8d95736d0fb6",
                                                "text": "„Der Mann rauchte eine Zigarre, deren rotglühendes Ende in der Dunkelheit wie ein Glühwürmchen leuchtete.“"
                                            },
                                            {
                                                "example_id": "fc4412d3-de1d-4a8e-91c0-bcc5cbf3cbf1",
                                                "sense_id": "d2eb5f83-d09e-34be-9c5f-8d95736d0fb6",
                                                "text": "„Treecastle zog ein paarmal kräftig an seiner Zigarre und wurde etwas ruhiger.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7ba89102-6ec8-3ac6-b135-262206b20d23",
                                        "entry_id": "0b159b8a-f05c-38c5-8b1d-8281c55c99c7",
                                        "glosses": [
                                            "Zurechtweisung; Tadel"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "47964c9b-fe5a-4662-8ccd-7f3789eb937f",
                                                "sense_id": "7ba89102-6ec8-3ac6-b135-262206b20d23",
                                                "text": "Da hat mir mein Chef aber heute eine Zigarre verpasst!"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8eec7041-367d-4bc0-ad8f-1160b9399de7",
                        "source_entry_id": "b60ac8da-d963-3027-9b78-87f3353daab8",
                        "target_lang_word": "cigar",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cigar",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "245b5ff9-49cb-33d3-bf16-4073208d13d1",
                                        "entry_id": "b3b28950-f7a6-3aad-b055-1505e5df5ca9",
                                        "glosses": [
                                            "A cylinder of tobacco rolled and wrapped with an outer covering of tobacco leaves, intended to be smoked."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c45b264-1c07-4001-a74e-9bfb87eb5add",
                                                "sense_id": "245b5ff9-49cb-33d3-bf16-4073208d13d1",
                                                "text": "Long after his cigar burnt bitter, he sat with eyes fixed on the blaze. When the flames at last began to flicker and subside, his lids fluttered, then drooped ; but he had lost all reckoning of time when he opened them again to find Miss Erroll in furs and ball-gown kneeling on the hearth[…]."
                                            },
                                            {
                                                "example_id": "8650b1e2-75a2-43b8-a833-f77251231c6b",
                                                "sense_id": "245b5ff9-49cb-33d3-bf16-4073208d13d1",
                                                "text": "A waiter brought his aperitif, which was a small scotch and soda, and as he sipped it gratefully he sighed. ¶ ‘Civilized,’ he said to Mr. Campion. ‘Humanizing.’ […] ‘Cigars and summer days and women in big hats with swansdown face-powder, that's what it reminds me of.’"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "06552437-267c-39ca-aea6-f47f9fc3495d",
                                        "entry_id": "b3b28950-f7a6-3aad-b055-1505e5df5ca9",
                                        "glosses": [
                                            "The penis."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9fa625c7-e7b6-4a15-b717-cf2a30821cdf",
                        "source_entry_id": "b60ac8da-d963-3027-9b78-87f3353daab8",
                        "target_lang_word": "cigare",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cigare",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "00fdc4af-9ddc-3792-b227-5e6848b0ab55",
                                        "entry_id": "004e1bbe-30fe-3f42-a97f-7227b2e22b67",
                                        "glosses": [
                                            "Petit rouleau de feuilles de tabac préparé pour être fumé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9db7fe44-cd59-475f-96c9-31bd3e25c3be",
                                                "sense_id": "00fdc4af-9ddc-3792-b227-5e6848b0ab55",
                                                "text": "On ne fume plus que le cigare par tous les pays que nous avons parcourus. Il est vrai qu’en général on l’implante perpendiculairement dans une espèce de pipe bâtarde à bout d’ambre, avec laquelle il fait un angle aigu d’un aspect drolatique. La fumée monte ainsi par-dessus la tête du tabacolâtre et semble s’exhaler du tuyau d’une locomotive en miniature. Nous notons ce détail, insignifiant sans doute ; mais l’on continue si longtemps à décrire des mœurs disparues, qu’on nous le pardonnera."
                                            },
                                            {
                                                "example_id": "e9e1cafb-bbd4-4aaa-a1bc-6dc5f9f3f22f",
                                                "sense_id": "00fdc4af-9ddc-3792-b227-5e6848b0ab55",
                                                "text": "Hurtaud alluma un cigare à la flamme d’une bougie qu’on lui tendit, et se rassit lourdement."
                                            },
                                            {
                                                "example_id": "53596133-3030-4686-b976-828e67ad342d",
                                                "sense_id": "00fdc4af-9ddc-3792-b227-5e6848b0ab55",
                                                "text": "De mon cigare il ne me restait plus qu’un bout entre les lèvres, et, après en avoir aspiré les dernières bouffées, je le jette par-dessus le bord."
                                            },
                                            {
                                                "example_id": "926ae190-df9c-4b02-b860-afcf866c9799",
                                                "sense_id": "00fdc4af-9ddc-3792-b227-5e6848b0ab55",
                                                "text": "Choulette alluma un de ces longs et tortueux cigares italiens, traversés par une paille. Il en tira quelques bouffées d’une vapeur infecte, […]"
                                            },
                                            {
                                                "example_id": "7653e79a-b2a0-4015-b058-7256646b1a1b",
                                                "sense_id": "00fdc4af-9ddc-3792-b227-5e6848b0ab55",
                                                "text": "– Voilà pourquoi ces Virginias, si appréciés de certains fumeurs, ne s’allument jamais qu’à la flamme d’une bougie, après qu’on a retiré de leur intérieur cette fine paille qui a pour but de réserver à travers le cigare un petit conduit par où puisse circuler la fumée. Un Virginia qui ne tire pas bien n’est bon qu’à jeter. J’ai vu des fumeurs délicats en allumer, Monsieur, jusqu’à six avant d’en trouver un à leur convenance…"
                                            },
                                            {
                                                "example_id": "e80740c2-1d22-4c02-8a0c-1783f0587ec0",
                                                "sense_id": "00fdc4af-9ddc-3792-b227-5e6848b0ab55",
                                                "text": "Il siégeait, au fond, sur une banquette, et fumait un cigare. Une indéniable sérénité se reflétait sur ses traits. Peut-être était-ce l’apaisante influence du cigare dont la bague rouge, ornée d'un somptueux écu gaufré d'or, indiquait sans discrétion le prix."
                                            },
                                            {
                                                "example_id": "7fca717f-e567-4e6b-bb59-725e4cb8d95f",
                                                "sense_id": "00fdc4af-9ddc-3792-b227-5e6848b0ab55",
                                                "text": "Mais elle ne se plaisait ni au fond des placards, ni dans la funèbre poudre du camphre, qu'elle remplaçait d'ailleurs par quelques cigares coupés en berlingots, les culots des pipes d'écume de mon père, et de grosses araignées qu'elle enfermait dans l'armoire giboyeuse, refuge des mites d'argent."
                                            },
                                            {
                                                "example_id": "d0f30253-e3dd-4b92-88df-786cc3ef33b5",
                                                "sense_id": "00fdc4af-9ddc-3792-b227-5e6848b0ab55",
                                                "text": "À New-York, les banquiers étaient réunis. « Grand était leur trouble et longues les cendres de leurs cigares, » écrit \"Time\", revue jeune, impertinente, brillante."
                                            },
                                            {
                                                "example_id": "8550c37b-6c9a-4ca9-9a92-39ea7c078355",
                                                "sense_id": "00fdc4af-9ddc-3792-b227-5e6848b0ab55",
                                                "text": "Dit autrement, le gueuleton bien arrosé du bon vivant, amateur de viande et de cigare, n'a pas son équivalent chez l'adepte de la graine germée et du tofu mariné à la sauce soja."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b5647333-ba03-3949-9fb7-357d7d5ac5d6",
                                        "entry_id": "004e1bbe-30fe-3f42-a97f-7227b2e22b67",
                                        "glosses": [
                                            "Réprimande ; engueulade."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "75d5b724-2673-4912-9bac-8f28ad4ff7e8",
                                                "sense_id": "b5647333-ba03-3949-9fb7-357d7d5ac5d6",
                                                "text": "Il m’a passé une espèce de cigare…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d72ff685-559a-3f10-8311-be36fe19f356",
                                        "entry_id": "004e1bbe-30fe-3f42-a97f-7227b2e22b67",
                                        "glosses": [
                                            "Tête."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "108df1c9-4c28-437f-8113-444d97a32500",
                                                "sense_id": "d72ff685-559a-3f10-8311-be36fe19f356",
                                                "text": "Troublé par cette constatation, je mets une table sur le large bureau de Thibaudin, une chaise sur cette table, et j’escalade le tout au risque de me défoncer le cigare..."
                                            },
                                            {
                                                "example_id": "84ce379a-c1b5-4870-b6a1-e0d959d1bdca",
                                                "sense_id": "d72ff685-559a-3f10-8311-be36fe19f356",
                                                "text": "Hey, la pétasse à gros nichons, t’as de l’air dans le cigare ?"
                                            }
                                        ]
                                    }
                                ]
                            },
