                ],
                "senses": [
                    {
                        "sense_id": "ce9a1ee1-111b-3e7a-a686-e14cbc06c023",
                        "entry_id": "319e03f9-7429-3bec-b660-e6b802bfd422",
                        "glosses": [
                            "Anwärterin, die sich im Kloster auf das Leben als Ordensfrau vorbereitet, aber noch keine zeitlichen oder ewigen Gelübde abgelegt hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ce998916-443d-4daa-b09a-570e2c5b5a37",
                                "sense_id": "ce9a1ee1-111b-3e7a-a686-e14cbc06c023",
                                "text": "Die neu in die Gemeinschaft Aufgenommenewird als Novize, beziehungsweise Novizin bezeichnet."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "28b8936e-6eab-33c3-adec-b178a4d6e289",
                        "entry_id": "319e03f9-7429-3bec-b660-e6b802bfd422",
                        "glosses": [
                            "weibliche Person, die neu in einem bestimmten Gebiet ist und noch keine besonderen Erfahrungen gesammelt hat"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "004cb860-c461-40c1-ac18-631d698cfa3b",
                                "sense_id": "28b8936e-6eab-33c3-adec-b178a4d6e289",
                                "text": "Als Novizin im Wissenschaftsbetrieb musste ich meine Rolle erst noch finden."
                            },
                            {
                                "example_id": "8b7f05e5-0d36-41b9-a0ab-6410662e1614",
                                "sense_id": "28b8936e-6eab-33c3-adec-b178a4d6e289",
                                "text": "„Nun trat sie ans Bett, und als sie die verehrungswürdigen Anzeichen erblickte, umarmte sie meine reizende Novizin und beglückwünschte sie ob ihrer Sittsamkeit.“"
                            },
                            {
                                "example_id": "26c6a389-3735-434e-95a1-f276f8c84b06",
                                "sense_id": "28b8936e-6eab-33c3-adec-b178a4d6e289",
                                "text": "„Die Novizinnen unterwarfen sich einer strengen Ausbildung, die anderthalb bis fünf Monate dauerte.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
