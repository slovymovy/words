                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het is belangrijk dat ik een goede voorraad <w>aanleg</w> voor de winter.",
                            "target_lang_translations": {
                                "ru": "Важно, чтобы я <w>сделал</w> хороший запас на зиму.",
                                "en": "It is important that I <w>build up</w> a good stock for the winter.",
                                "pl": "To ważne, żebym <w>zrobił</w> porządne zapasy na zimę."
                            }
                        },
                        {
                            "text": "Wacht even tot ik de boot <w>aanleg</w> voordat je aan wal stapt.",
                            "target_lang_translations": {
