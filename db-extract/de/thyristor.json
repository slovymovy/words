                                        "glosses": [
                                            "A semiconductor diode having an extra \\\"gate\\\" terminal to switch it on."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46bbef03-188f-4236-b96a-cb4bc9f8cca9",
                                                "sense_id": "e5498cb9-8255-37c2-a431-31199f33cea7",
                                                "text": "In calling it a \"Thyristor\", Mr. Warder was following a growing practice which takes account of the fact that in years to come the controlled rectifier may be made of other materials than silicon."
                                            },
                                            {
                                                "example_id": "4d9b0cc2-77f7-477f-b430-2d28a0fcece9",
                                                "sense_id": "e5498cb9-8255-37c2-a431-31199f33cea7",
                                                "text": "Figure 1.4 shows a modern thyristor encapsulated in a presspack housing and Figure 1.5 illustrates a typical interdigitated gate geometry in a high-power thyristor; the black areas indicate silicon ( Si0₂ ) and the white areas the Al metallisation."
                                            }
                                        ]
                                    }
