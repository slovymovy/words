                                        "entry_id": "d90e4bff-9d09-3b9f-bd04-361752986d82",
                                        "glosses": [
                                            "σαλάτα με μορφή πολτού, από ρεβίθια και ταχίνι, πιάτο προέλευσης από την Μέση Ανατολή"
                                        ],
                                        "tags": [
