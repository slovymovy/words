                        ],
                        "examples": [
                            {
                                "example_id": "2afb2d23-4d24-4e67-8814-ccbe8e5c96ac",
                                "sense_id": "0e0649ad-cddc-33f9-ab83-2341828f6925",
                                "text": "Me dis pas que t’as les flubes d’être viré de la police, tu sais très bien que c’est ton dernier jour de fonctionnaire …."
                            },
                            {
                                "example_id": "ff548018-99c7-42d6-85f1-e6356d199ecf",
                                "sense_id": "0e0649ad-cddc-33f9-ab83-2341828f6925",
                                "text": "J’aime mieux aller dans un dépôt d’éclopés, parce qu’on n’ m’enverra pas au Kef. J’ai les flubes d’aller au Kef. J’ peux pas blairer ce patelin-là."
                            },
                            {
                                "example_id": "c37ac91e-6b10-457a-a478-f59e0191460c",
                                "sense_id": "0e0649ad-cddc-33f9-ab83-2341828f6925",
                                "text": "Tu m’as foutu les flubes ce soir, mais tu ne me verras plus de sitôt ici."
                            },
                            {
                                "example_id": "84a27c93-36e5-424e-b30c-87eef1f66510",
                                "sense_id": "0e0649ad-cddc-33f9-ab83-2341828f6925",
                                "text": "Tu parles, c’est du voyou à la mie de pain, collé à la gomina, on n’a pas les flubes."
                            }
                        ]
                    }
                ],
