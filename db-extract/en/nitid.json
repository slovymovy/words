                        "examples": [
                            {
                                "example_id": "998f6377-db42-409a-82e7-5c4f1554c5a5",
                                "sense_id": "2b69db0c-94ce-39ca-8b1c-4eee550c67f7",
                                "text": "yet amongst these doth the nitid spark spend out his time: this is the Gallant's day!"
                            },
                            {
                                "example_id": "776743d4-2ac4-416f-b12c-a6de878773b2",
                                "sense_id": "2b69db0c-94ce-39ca-8b1c-4eee550c67f7",
                                "text": "My sable friend, for he was an eccclesiastic, was, however, not nitid as usual. There was a looseness of trousers, and a sloppiness of shoe, that savoured no longer of St. James's-street."
                            }
