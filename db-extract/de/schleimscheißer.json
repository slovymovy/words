                "senses": [
                    {
                        "sense_id": "6889f804-c23b-341f-b5a6-465a778090f3",
                        "entry_id": "2dfcbe59-6c01-3577-b0c7-fc33b032b617",
                        "glosses": [
                            "anbiedernde verlogene, hinterhältige Person"
                        ],
                        "tags": [
                            "derogatory",
                            "impolite"
                        ],
                        "examples": [
                            {
                                "example_id": "1aaa456e-7466-48f2-a514-58e670f4afab",
                                "sense_id": "6889f804-c23b-341f-b5a6-465a778090f3",
                                "text": "„Wahrscheinlich ist Marla immer noch in unserem Haus, schmeißt Zeitschriften an die Wand und schreit, was für ein Arschloch und falscher, kapitalistischer Schleimscheißer ich bin.“"
                            },
                            {
                                "example_id": "211d9b67-6d07-4b19-a980-0304a4db82d7",
                                "sense_id": "6889f804-c23b-341f-b5a6-465a778090f3",
                                "text": "„Neal verstand kein Wort, erkannte aber einen Schleimscheißer, wenn er einen vor sich hatte, und dieser Junge hier quatschte um sein Leben.“"
                            },
                            {
                                "example_id": "b478ff3d-d250-4d62-8dbf-56ef8fd6f743",
                                "sense_id": "6889f804-c23b-341f-b5a6-465a778090f3",
                                "text": "„Die beiden Schleimscheißer müssen zusammengearbeitet haben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
