    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "18156412-572e-3729-9e8a-bb16c99beddd",
                    "sense_definition": "To crush or damage something by walking heavily on it.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_destruction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The crowd began to <w>trample</w> the flowers in the garden during the festival."
                        },
                        {
                            "text": "Be careful not to <w>trample</w> the grass while you are walking through the park."
                        }
                    ],
                    "synonyms": [
                        "tread"
                    ],
                    "common_phrases": [
                        "trample underfoot"
                    ]
                },
                {
                    "sense_id": "3e1b680f-877c-388c-b28b-cc78a938a02f",
                    "sense_definition": "To walk with heavy, noisy, or destructive steps.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The angry protesters continued to <w>trample</w> through the streets shouting slogans."
                        },
                        {
                            "text": "Heavy boots <w>trample</w> across the wooden floorboards every morning."
                        }
                    ]
                },
                {
                    "sense_id": "cb1d07ec-0b01-39e0-b7fb-519e98b0cbb8",
                    "sense_definition": "To ignore or violate someone's rights or feelings in a cruel way.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "emotional_harm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new policy seems to <w>trample</w> on the basic rights of the employees."
                        },
                        {
                            "text": "It is wrong to <w>trample</w> on the dignity of others for personal gain."
                        }
                    ],
                    "common_phrases": [
                        "trample on rights"
                    ]
                },
                {
                    "sense_id": "05a4934d-48a3-386a-a971-0954fd3fb16a",
                    "sense_definition": "To treat someone with extreme harshness or lack of respect.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "emotional_harm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dictator continued to <w>trample</w> his political opponents without mercy."
                        },
                        {
                            "text": "They felt the company would <w>trample</w> anyone who stood in its way."
                        }
                    ]
                }
            ]
        },
