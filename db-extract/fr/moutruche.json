                "word": "moutruche",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "d31f3a14-1a0d-40b1-b744-f963e20476df",
                        "entry_id": "a4d3c5e3-65da-3c97-82fe-7f4303ed7cf6",
                        "tags": [
                            "plural"
                        ],
                        "form": "moutruches"
