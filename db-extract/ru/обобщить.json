                                "target_senses": [
                                    {
                                        "sense_id": "973d887e-daf6-3789-b87c-2ddcee596557",
                                        "entry_id": "9ca36455-f5e6-3be1-a1e1-87883c58bee0",
                                        "glosses": [
                                            "Resserrer et rendre en peu de paroles ce qu’il y a de plus important dans une discussion, dans un discours, dans un argument."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd109d1f-00eb-4bcf-b0bf-c3dd20965092",
                                                "sense_id": "973d887e-daf6-3789-b87c-2ddcee596557",
                                                "text": "Il a fort bien résumé ce long discours, cette discussion, cette leçon."
                                            },
                                            {
                                                "example_id": "1d514e84-335c-4f8c-a383-a1968f0392cb",
                                                "sense_id": "973d887e-daf6-3789-b87c-2ddcee596557",
                                                "text": "Le président résuma tous les avis avant de dire le sien."
                                            },
                                            {
                                                "example_id": "2e2f904c-8e46-4cad-86d5-4fe07617abb8",
                                                "sense_id": "973d887e-daf6-3789-b87c-2ddcee596557",
                                                "text": "Résumer les débats d’un procès criminel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f728af54-f7bf-38d9-ad13-36f2708e76ff",
                                        "entry_id": "9ca36455-f5e6-3be1-a1e1-87883c58bee0",
                                        "glosses": [
                                            "Rendre en peu de choses un ensemble plus vaste ou plus complexe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b87dca8f-ec3b-4dd5-801a-a3f97a7d590e",
                                                "sense_id": "f728af54-f7bf-38d9-ad13-36f2708e76ff",
                                                "text": "Il existe en Hollande depuis quelques années un parti rationaliste, qui grandit de jour en jour. Ce parti ne proclame aucun système, puisqu'il les résume tous."
                                            },
                                            {
                                                "example_id": "59150dad-4c9d-45c0-87b6-803d8efeef65",
                                                "sense_id": "f728af54-f7bf-38d9-ad13-36f2708e76ff",
                                                "text": "Celui-ci résumait par sa fausse élégance tout le poisseux vernis qui constitue l'élégance vestimentaire de ces messieurs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5b80a81e-ddfb-3550-a5b5-969670e5008a",
                                        "entry_id": "9ca36455-f5e6-3be1-a1e1-87883c58bee0",
                                        "glosses": [
                                            "Reprendre en peu de mots ce qu’on a dit."
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
