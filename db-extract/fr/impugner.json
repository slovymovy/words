                        "cross_references": [
                            {
                                "target_word": "anfechten",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "766a0453-64ca-38b3-b558-49559cd70fe1",
                                        "entry_id": "978a6aab-8a3b-3c37-9a94-b6b95a809e9e",
                                        "glosses": [
                                            "die Gültigkeit/Rechtmäßigkeit einer Entscheidung anzweifeln und dann dagegen vorgehen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "748ffb9a-1839-46b9-aaea-de16bacd8f4d",
                                                "sense_id": "766a0453-64ca-38b3-b558-49559cd70fe1",
                                                "text": "„Hunderte Händler des unter Gläubigerschutz arbeitenden US-Autobauers Chrysler wollen ihre Vertragsauflösung anfechten.“"
                                            },
                                            {
                                                "example_id": "eec66f69-f6d9-463d-a02d-2558e9f0b96e",
                                                "sense_id": "766a0453-64ca-38b3-b558-49559cd70fe1",
                                                "text": "„Haben Sie am Telefon in einen Vertrag für eine kostenpflichtige Werbesperre eingewilligt, so können Sie diesen anfechten.“"
                                            },
                                            {
                                                "example_id": "a63e8589-4ad2-4737-891f-6caa99a2e870",
                                                "sense_id": "766a0453-64ca-38b3-b558-49559cd70fe1",
                                                "text": "„Wegen eines rassistischen Tweets hat ein Gericht Noah Becker 15.000 Euro Schmerzensgeld zugesprochen. Der AfD-Bundestagsabgeordnete Jens Maier will das Urteil anfechten.“"
                                            },
                                            {
                                                "example_id": "8ed5749b-9a3b-490e-930f-85d1f2daeabd",
                                                "sense_id": "766a0453-64ca-38b3-b558-49559cd70fe1",
                                                "text": "„[Ex-König] Albert [II. von Belgien] bestreitet weiter die Vaterschaft und lässt nun prüfen, ob er die Entscheidung vor dem obersten Gerichtshof des Landes anfechten wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4af9abeb-aa69-331c-85e3-30ad75352041",
                                        "entry_id": "978a6aab-8a3b-3c37-9a94-b6b95a809e9e",
                                        "glosses": [
                                            "jemandem Kummer, Sorge bereiten"
                                        ],
                                        "tags": [
                                            "figurative",
                                            "gehoben",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7f2a5c29-fe44-4c81-8c0f-45758ae4315c",
                                                "sense_id": "4af9abeb-aa69-331c-85e3-30ad75352041",
                                                "text": "Das ficht mich nicht an."
                                            },
                                            {
                                                "example_id": "9557fec6-0d5c-4e4c-80ee-bb39f7cfed13",
