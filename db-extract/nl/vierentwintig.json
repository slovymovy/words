                "senses": [
                    {
                        "sense_id": "22b7e4c4-32db-36df-b92e-8966eb3e8921",
                        "entry_id": "87550047-3d1c-3acf-9ecf-2ed1864c535b",
                        "glosses": [
                            "dat wat in een (rang)ordening met 24 is aangeduid"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e7a9e5f2-8b0d-4c9b-8bfa-d07ecdcd8709",
                                "sense_id": "22b7e4c4-32db-36df-b92e-8966eb3e8921",
                                "text": "Het is weer de vierentwintig die het niet doet, kunnen we die niet simpel vervangen?"
                            },
                            {
                                "example_id": "b0cf02b4-55ac-4ac9-93c9-ecc90e473919",
                                "sense_id": "22b7e4c4-32db-36df-b92e-8966eb3e8921",
                                "text": "Haar vijfentwintigste verjaardag was een belangrijk moment, want haar leven werd heel anders toen ze de vierentwintig eenmaal voorbij was."
                            }
                        ]
                    },
                    {
                        "sense_id": "eac18f8f-41e6-3013-8f68-5b9203420341",
                        "entry_id": "87550047-3d1c-3acf-9ecf-2ed1864c535b",
                        "glosses": [
                            "groep van 24 eenheden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e4a6d0a6-34e3-4bd7-ab23-44277bb3d208",
                                "sense_id": "eac18f8f-41e6-3013-8f68-5b9203420341",
                                "text": "De vierentwintig zijn natuurlijk blij, maar laten we ook denken aan het verdriet van de vier die zijn afgewezen."
                            }
                        ]
                    }
                ],
