                                        "entry_id": "524fae53-979a-3c13-ac1a-38e6a788d405",
                                        "glosses": [
                                            "The study of the internal politics of the high members of the government of the USSR."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b8039f4d-4db8-465e-88a6-6569e72fc580",
                                                "sense_id": "593402da-1054-3850-b4e1-18c82479dcd1",
                                                "text": "Like the Kremlinology of the cold war, the unpacking of Nasrallah’s careful ambiguities is as much art as science. Was he smiling more, some asked last week, as others sought to identify the audiences for different parts of his messaging."
                                            }
                                        ]
                                    },
