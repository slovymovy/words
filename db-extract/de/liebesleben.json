                "senses": [
                    {
                        "sense_id": "a3ade967-08df-3f27-9478-f5cfd626d154",
                        "entry_id": "8cad5cdc-1e35-3090-b34e-084e4cb2ff72",
                        "glosses": [
                            "Gesamtheit sexueller Aktivität und Vorstellungen von jemandem"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e5fb4e6-a9ea-47e2-bb15-853918ef2aee",
                                "sense_id": "a3ade967-08df-3f27-9478-f5cfd626d154",
                                "text": "Er führte ein ausschweifendes Liebesleben."
                            },
                            {
                                "example_id": "139c85e0-bde4-4e29-b532-ed4e2eef45bf",
                                "sense_id": "a3ade967-08df-3f27-9478-f5cfd626d154",
                                "text": "„Der Lack war eingetrocknet wie ihr Liebesleben, in dem sie mit seiner Hilfe Akzente hatte setzen wollen.“"
                            },
                            {
                                "example_id": "e41e87a5-ce65-43e0-91d0-9048d38a685e",
                                "sense_id": "a3ade967-08df-3f27-9478-f5cfd626d154",
                                "text": "„Nie in ihrem kurzen Liebesleben war sie mit einem so reich geschmückten und verzierten Mann ins Bett gegangen.“"
                            },
                            {
                                "example_id": "3fbafcac-e2af-4b25-bb70-e6cf485d2ecb",
                                "sense_id": "a3ade967-08df-3f27-9478-f5cfd626d154",
                                "text": "„Das unruhige Reise- und Liebesleben befriedigt ihn nicht, löst vielmehr eine Krisenstimmung aus.“"
                            },
                            {
                                "example_id": "a2e5ef66-8784-46bf-96fe-aa693224b4db",
                                "sense_id": "a3ade967-08df-3f27-9478-f5cfd626d154",
                                "text": "„Roth wollte fort, er wollte auf einem richtigen Campus leben, unter anderem, weil dort ein weniger verstohlenes Liebesleben winkte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
