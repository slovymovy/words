    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "437bc955-0f5c-3835-b7e8-21cbcb1e35cc",
                    "sense_definition": "een medische behandeling die een bepaalde tijd duurt om te genezen of aan te sterken",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "medisch",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De dokter schreef een <w>kuur</w> van tien dagen voor om de infectie te bestrijden.",
                            "target_lang_translations": {
                                "en": "The doctor prescribed a ten-day <w>course</w> to fight the infection."
                            }
                        },
                        {
                            "text": "Na zijn operatie moest hij een lange <w>kuur</w> ondergaan in een revalidatiecentrum.",
                            "target_lang_translations": {
                                "en": "After his surgery, he had to undergo a long <w>treatment</w> in a rehabilitation center."
                            }
                        }
                    ],
                    "common_phrases": [
                        "antibiotica kuur",
                        "kuur volgen",
                        "kuur afmaken"
                    ],
                    "target_lang_definitions": {
                        "en": "a medical treatment lasting a specific period intended to cure or strengthen the body"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "course",
                                "target_lang_sense_clarification": "of treatment or medication"
                            },
                            {
                                "target_lang_word": "treatment",
                                "target_lang_sense_clarification": "medical care for an illness"
                            },
                            {
                                "target_lang_word": "cure",
                                "target_lang_sense_clarification": "a course of therapy"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "47b6376d-659c-3b11-8620-9cff9435a441",
                    "sense_definition": "onverwacht of vreemd gedrag, vaak van een persoon of een apparaat",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "gedrag",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mijn oude auto begint weer <w>kuren</w> te vertonen nu het kouder wordt.",
                            "target_lang_translations": {
                                "en": "My old car is starting to show <w>quirks</w> again now that it's getting colder."
                            }
                        },
                        {
                            "text": "Zij heeft soms last van vreemde <w>kuren</w> als ze haar zin niet krijgt.",
                            "target_lang_translations": {
                                "en": "She sometimes suffers from strange <w>whims</w> when she doesn't get her way."
                            }
                        }
                    ],
                    "synonyms": [
                        "bevlieging",
                        "gril"
                    ],
                    "common_phrases": [
                        "kuren vertonen",
                        "rare kuren"
                    ],
                    "target_lang_definitions": {
                        "en": "unexpected or strange behavior, often of a person or a device"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "quirk",
                                "target_lang_sense_clarification": "an idiosyncrasy or slight glitch"
                            },
                            {
                                "target_lang_word": "whim",
                                "target_lang_sense_clarification": "a fanciful impulse"
                            },
                            {
                                "target_lang_word": "caprice",
                                "target_lang_sense_clarification": "an impulsive action or change of mind"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "36e09bed-89c6-3096-975b-c477ba26edaa",
                    "sense_definition": "de eerste persoon enkelvoud tegenwoordige tijd van <w>kuren</w>",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>kuur</w> elk jaar een weekje in de bergen voor mijn gezondheid.",
                            "target_lang_translations": {
                                "en": "I <w>take a cure</w> for a week in the mountains every year for my health."
                            }
                        },
                        {
                            "text": "Als ik <w>kuur</w> in dat kuuroord, voel ik me daarna weer als herboren.",
                            "target_lang_translations": {
                                "en": "When I <w>undergo treatment</w> at that spa, I feel like I'm reborn afterwards."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "the first person singular present tense of 'to take a cure' or 'to undergo treatment'"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "take a cure",
                                "target_lang_sense_clarification": "undergo a health treatment"
                            },
                            {
                                "target_lang_word": "undergo treatment",
                                "target_lang_sense_clarification": "receive medical therapy"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}