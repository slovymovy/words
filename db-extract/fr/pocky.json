                    {
                        "sense_id": "fcd8455e-6d02-32ca-9922-f1004a5c2722",
                        "entry_id": "f71bebbc-0f1e-3f58-a438-bbf420489203",
                        "glosses": [
                            "(Par antonomase) Bâtonnet de biscuit enrobé de chocolat ou d’une autre saveur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9068e764-3881-4de0-9667-c4aab67ee312",
                                "sense_id": "fcd8455e-6d02-32ca-9922-f1004a5c2722",
                                "text": "Si tu me mens je te ferais manger des pocky par le nez"
                            },
                            {
                                "example_id": "4c3583c3-f21c-4b10-9ef1-876c644b2ffd",
                                "sense_id": "fcd8455e-6d02-32ca-9922-f1004a5c2722",
                                "text": "C'est un bon jour pour manger des pocky 😊💖😊"
                            },
                            {
                                "example_id": "24e745e5-3f32-481c-b9f8-91b95a6852a0",
                                "sense_id": "fcd8455e-6d02-32ca-9922-f1004a5c2722",
                                "text": "J’ose pas manger les pocky par peur de pas les manger au meilleur moment mdr mais ça va bien avec ma tenue, c’est aesthetic ✨"
                            },
                            {
                                "example_id": "a7fc234c-b087-47b7-a94f-b8f974274101",
                                "sense_id": "fcd8455e-6d02-32ca-9922-f1004a5c2722",
                                "text": "Mais non! Faut manger le pocky ensemble! UwU"
                            },
                            {
                                "example_id": "82b57d85-82f7-44f0-bb96-9ac42b4e54ec",
                                "sense_id": "fcd8455e-6d02-32ca-9922-f1004a5c2722",
                                "text": "• Aguero mit ses lèvres sur l’autre extrémité du pocky, un gros sourire sur le visage avant de commencer à manger petit à petit le pocky tout en le dégustant. •\n•— Plus vite Finny !"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
