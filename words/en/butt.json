                },
                {
                    "sense_id": "836528ff-f0cc-367e-8d32-8a9560c9cbce",
                    "sense_definition": "A large wooden cask for storing wine or beer, or a specific measure of volume.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "container",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The winery stored its finest vintage in a large oak <w>butt</w>.",
                            "target_lang_translations": {
                                "ru": "Винодельня хранила свое лучшее вино в большой дубовой <w>бочке</w>.",
                                "es": "La bodega almacenó su mejor cosecha en un gran <w>tonel</w> de roble.",
                                "zh": "酒庄把最好的陈年佳酿储存在一个巨大的橡木<w>桶</w>里。"
                            }
                        },
                        {
                            "text": "Historically, a <w>butt</w> of wine contained about 126 gallons.",
                            "target_lang_translations": {
                                "ru": "Исторически <w>бочка</w> вина вмещала около 126 галлонов.",
                                "es": "Históricamente, una <w>bota</w> de vino contenía unos 126 galones.",
                                "zh": "历史上，一<w>桶</w>酒大约能装126加仑。"
                            }
                        }
                    ],
                    "synonyms": [
                        "pipe"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Большая деревянная бочка для хранения вина или пива.",
                        "es": "Un gran barril de madera para almacenar vino o cerveza, o una medida específica de volumen.",
                        "zh": "用于储存酒或啤酒的大木桶。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бочка",
                                "target_lang_sense_clarification": "емкость"
                            }
                        ],
                        "es": [
                            {
