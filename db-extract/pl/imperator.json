                                "example_id": "813c8c5d-b088-424d-bf3f-c662e92db235",
                                "sense_id": "0933ed02-a9df-3251-9aa8-36577019ee92",
                                "text": "Imperator nie zamierzał ulec Umbrom w tej sprawie."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "612024cf-eb75-3d13-b004-4f03fbf6880f",
                        "entry_id": "6b665337-1e39-300a-8b10-aaf6e7d80bb3",
                        "glosses": [
                            "w starożytnym Rzymie w okresie republiki: zwycięski wódz, tytuł cesarza"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "9651b281-fd1a-3e24-8da3-bbbd69e4a438",
                        "entry_id": "6b665337-1e39-300a-8b10-aaf6e7d80bb3",
                        "glosses": [
                            "tytuł władcy w niektórych monarchiach"
                        ],
                        "tags": [],
