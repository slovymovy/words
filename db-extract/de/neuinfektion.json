                "senses": [
                    {
                        "sense_id": "344cbd56-c604-3d72-80f6-af17f0715224",
                        "entry_id": "012ae2d2-6877-3fb8-b6d2-343198877f15",
                        "glosses": [
                            "erstmalige (neu gemeldete und erfasste) Ansteckung mit einem Krankheitserreger"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "608abbe9-b5e7-47d5-ad86-0e0cd98aae98",
                                "sense_id": "344cbd56-c604-3d72-80f6-af17f0715224",
                                "text": "„Expertenschätzungen gehen von einer Zahl von 12.000 bis 15.000 Infizierten aus. Seit 1997, als mit 297 Neuinfektionen ein Tiefstand zu verzeichnen war, bewegen sich die Zahlen der jährlich festgestellten Neuinfektionen zwischen 313 (1998) und 398 im Jahre 2001.“"
                            },
                            {
                                "example_id": "7bda6193-b1b9-4016-aebb-4f7ed85156bf",
                                "sense_id": "344cbd56-c604-3d72-80f6-af17f0715224",
                                "text": "„Der Syphiliskranke ist gefeit gegen eine Neuinfektion, und bei der Tuberkulose läßt sich diese durch die Erstinfektion hervorgerufene Veränderung des Organismus bekanntlich im Tierversuch deutlich vor Augen führen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
