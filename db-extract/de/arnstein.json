                    }
                ],
                "senses": [
                    {
                        "sense_id": "d6c27a32-7e13-37f6-a70d-d5244282eb4e",
                        "entry_id": "46e144bc-ae87-3f57-a40d-8c6c1ea6e585",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "999ae119-b374-49ea-93fa-2ecda49abf10",
                                "sense_id": "d6c27a32-7e13-37f6-a70d-d5244282eb4e",
                                "text": "Frau Arnstein ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "797d84a2-88da-48a9-907e-7b85678c335e",
                                "sense_id": "d6c27a32-7e13-37f6-a70d-d5244282eb4e",
                                "text": "Herr Arnstein wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "96c942ca-6c6e-45d2-a2e9-c4b1942d3f20",
                                "sense_id": "d6c27a32-7e13-37f6-a70d-d5244282eb4e",
                                "text": "Die Arnsteins fahren heute nach Rotterdam."
                            },
                            {
                                "example_id": "7ce1de34-2736-46f2-a969-975d1b5a2cb4",
                                "sense_id": "d6c27a32-7e13-37f6-a70d-d5244282eb4e",
                                "text": "Der Arnstein trägt nie die Pullover, die die Arnstein ihm strickt."
                            },
                            {
                                "example_id": "d34cb50b-aa1b-4995-8d48-903cf1793c90",
                                "sense_id": "d6c27a32-7e13-37f6-a70d-d5244282eb4e",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Arnstein kommt, geht der Herr Arnstein.“"
                            },
                            {
                                "example_id": "e50ecb81-c0f7-41d1-8583-8cfc37891117",
                                "sense_id": "d6c27a32-7e13-37f6-a70d-d5244282eb4e",
                                "text": "Arnstein kommt und geht."
                            },
                            {
                                "example_id": "14ccbef8-2a0c-4237-963b-b8d726437b7f",
                                "sense_id": "d6c27a32-7e13-37f6-a70d-d5244282eb4e",
                                "text": "Arnsteins kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
