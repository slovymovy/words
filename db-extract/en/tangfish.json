                                "example_id": "1e52a644-b300-4e22-908c-b98a5af6f9a6",
                                "sense_id": "b6ed2a88-d9bc-3d9e-a4bf-04c257116d81",
                                "text": "a noted retreat of seals or selkies, or tangfish, as they are vernacularly called in Zetland"
                            },
                            {
