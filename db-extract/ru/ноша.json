                                                "sense_id": "2a6479e8-2f44-3446-8d00-4934c7beebdf",
                                                "text": "A burden of gad steel is 120 pounds."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7d4a272e-676a-3ab0-888c-754cc799d299",
