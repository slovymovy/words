                                "target_senses": [
                                    {
                                        "sense_id": "e90f0445-1a12-354d-968f-158447b2d30b",
                                        "entry_id": "962a64ee-77e2-3b81-91a6-11be416a9fd8",
                                        "glosses": [
                                            "nicht zu erfüllen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "732dbeed-9ff2-4eeb-94b1-9414925c2bfe",
                                                "sense_id": "e90f0445-1a12-354d-968f-158447b2d30b",
                                                "text": "Leider ist dieser besonders große Wunsch unerfüllbar."
                                            },
                                            {
                                                "example_id": "5d35fad5-e8ad-4cfd-9a72-7c2f54b40e15",
                                                "sense_id": "e90f0445-1a12-354d-968f-158447b2d30b",
                                                "text": "Wenn aber Wünsche, die als unerfüllbar anerkannt sind, dauernd wiederkehren, so können wir nicht Jahr für Jahr dieselbe Antwort geben."
                                            },
                                            {
                                                "example_id": "a3f1f712-f6fb-4136-a064-f3330dee655b",
                                                "sense_id": "e90f0445-1a12-354d-968f-158447b2d30b",
                                                "text": "„In einem Rachefeldzug sollte er verlorenes Terrain für Rom zurückgewinnen - eine unerfüllbare Mission.“"
                                            }
