                    ]
                },
                {
                    "sense_id": "f45c2a08-282c-3dda-abe1-918bddb6744e",
                    "sense_definition": "An involuntary shaking or trembling of the body, often caused by extreme fear.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "fear",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His hands shook with <w>trepidation</w> as he held the cold metal handle."
