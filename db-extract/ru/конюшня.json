                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "221a93aa-5fb6-42e6-a3c2-e5dbc4b5e833",
                        "source_entry_id": "15d204e3-a370-344d-b7d8-0dd8304ed41f",
                        "source_sense_description": "помещение, здание для содержания лошадей",
                        "target_lang_word": "Pferdestall",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pferdestall",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e8549656-abb1-379b-8cb3-bc5e94e5fba4",
                                        "entry_id": "de364f1c-0a79-33e2-8930-2f346c309ce8",
                                        "glosses": [
                                            "Gebäude einer Farm, eines landwirtschaftlichen Betriebs, das zur Unterbringung von Pferden dient"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58c98d7e-5a9c-48f7-80d4-8d5191f534d6",
                                                "sense_id": "e8549656-abb1-379b-8cb3-bc5e94e5fba4",
                                                "text": "Am Abend bringen wir die Pferde wieder in den Pferdestall."
                                            },
                                            {
                                                "example_id": "bb069a71-647b-4101-8bdc-fcda38509efa",
                                                "sense_id": "e8549656-abb1-379b-8cb3-bc5e94e5fba4",
                                                "text": "„Der Pferdestall war ein Ort, zu dem er Zuneigung empfand.“"
                                            },
                                            {
                                                "example_id": "6875e1fe-390d-482c-86ae-ee43f4123d5b",
                                                "sense_id": "e8549656-abb1-379b-8cb3-bc5e94e5fba4",
                                                "text": "„Sie traten aus dem Hause hinaus und gingen in den Pferdestall.“"
                                            },
                                            {
                                                "example_id": "c83ed4b0-f919-4905-8d63-b2a25292b54a",
                                                "sense_id": "e8549656-abb1-379b-8cb3-bc5e94e5fba4",
                                                "text": "„Er fand keinen anderen Ausweg, als einen Pferdestall oder einen Heuboden in irgendeinem Gasthof als Unterkunft zu finden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8b597e99-92da-460b-871a-8909420a5b0f",
                        "source_entry_id": "15d204e3-a370-344d-b7d8-0dd8304ed41f",
                        "source_sense_description": "помещение, здание для содержания лошадей",
                        "target_lang_word": "écurie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "écurie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1ba4b6fb-7b95-3cc4-9536-aa9f51e623a1",
                                        "entry_id": "48b8f258-0a1a-3ac1-a8fa-c7d21125f685",
                                        "glosses": [
                                            "Bâtiment destiné à loger des chevaux, des mulets, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "77915b82-3180-42f4-86f3-ef0c833e1ed5",
                                                "sense_id": "1ba4b6fb-7b95-3cc4-9536-aa9f51e623a1",
                                                "text": "Les écuries du roi et l'hôtel des gardes-du-corps devinrent pour eux un nouveau sujet de désordre; ils s’y précipitèrent en foule et jetèrent l’effroi parmi les valets d'écurie et les palefreniers."
                                            },
                                            {
                                                "example_id": "64576ec7-ccb6-402c-9573-4df04dff8e51",
                                                "sense_id": "1ba4b6fb-7b95-3cc4-9536-aa9f51e623a1",
                                                "text": "Il faut, autant que possible élever les chevaux à l’écurie, l’élevage en liberté n’est pas, tant s’en faut, aussi économique que l’élevage à l’écurie."
                                            },
                                            {
                                                "example_id": "5982f733-2f7c-4758-bad0-04b315f38e4d",
                                                "sense_id": "1ba4b6fb-7b95-3cc4-9536-aa9f51e623a1",
                                                "text": "Il y avait quarante chevaux dans les écuries, sept éléphants sous une tente spéciale et les roulottes-cages de deux groupes de fauves –tigres et lions– abritées sous la tente ménagerie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "893627dc-b471-3519-ab6f-54756f0ba856",
                                        "entry_id": "48b8f258-0a1a-3ac1-a8fa-c7d21125f685",
                                        "glosses": [
                                            "Ensemble des chevaux de course d’un même propriétaire."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1ee03836-5ed9-3f10-ae73-62e53772085d",
                                        "entry_id": "48b8f258-0a1a-3ac1-a8fa-c7d21125f685",
                                        "glosses": [
                                            "Ensemble de personnes importantes qui dépendent d’une organisation et lui permettent de réussir."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "87e343d5-4baf-4922-991c-57ce54f90379",
                                                "sense_id": "1ee03836-5ed9-3f10-ae73-62e53772085d",
                                                "text": "À l’inverse, la Metro Goldwyn Mayer revendique le luxe étincelant dans des décors de rêve, mettant en valeur son écurie de stars ultra-glamour."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9b12cb29-99f2-32ce-9204-cf99e8811b0d",
                                        "entry_id": "48b8f258-0a1a-3ac1-a8fa-c7d21125f685",
                                        "glosses": [
                                            "Étable, lieu où l’on loge des vaches et autres bestiaux."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d9e56cd5-7b3a-4ffc-9ab9-ed170fdc1120",
                                                "sense_id": "9b12cb29-99f2-32ce-9204-cf99e8811b0d",
                                                "text": "Un cas de fièvre charbonneuse s’est déclaré samedi dans une écurie du village d’Arnicourt. Une vache est morte après une journée de maladie. […]. Un arrêté va être pris relativement à l’espèce bovine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2fe7aa0d-5b6d-3660-ab33-77d67bc13ab2",
                                        "entry_id": "48b8f258-0a1a-3ac1-a8fa-c7d21125f685",
                                        "glosses": [
                                            "Maison mal entretenue, malpropre."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "pejorative"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "13fbfa35-dd2b-36bd-9662-7a7fb23b3c83",
                                        "entry_id": "48b8f258-0a1a-3ac1-a8fa-c7d21125f685",
                                        "glosses": [
                                            "Train, équipage qui comprenait écuyers, pages, carrosses, chevaux, mulets d’un prince, d’un grand seigneur."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a23f7bfd-1777-4058-848f-73a0be8d8620",
                                                "sense_id": "13fbfa35-dd2b-36bd-9662-7a7fb23b3c83",
                                                "text": "L’écurie du prince est partie. - La grande écurie, la petite écurie du roi."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "33e49e58-1846-3cfc-9f13-eb66d8c3d488",
                                        "entry_id": "48b8f258-0a1a-3ac1-a8fa-c7d21125f685",
                                        "glosses": [
                                            "Ensemble des chevaux que l’on dresse pour les courses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4eddb0e5-4df3-4c1f-b069-cc0fe2fcac1c",
                                                "sense_id": "33e49e58-1846-3cfc-9f13-eb66d8c3d488",
                                                "text": "C’est l’écurie de M. X… qui a gagné le prix. — Cette écurie lui coûte très cher."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "86df945b-d28d-3916-9ac0-4230aa40949f",
                                        "entry_id": "48b8f258-0a1a-3ac1-a8fa-c7d21125f685",
                                        "glosses": [
                                            "Ensemble des véhicules de course, de leurs mécaniciens, d'un constructeur d'automobiles."
                                        ],
                                        "tags": [
                                            "Aujourd'hui"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3e910c85-3246-470d-aa6e-e489dc3dca2a",
                                                "sense_id": "86df945b-d28d-3916-9ac0-4230aa40949f",
                                                "text": "Aucune victoire et que trois présences de ses pilotes sur le podium: l’écurie Ferrari a connu une saison 2020 particulièrement difficile, […]."
                                            }
                                        ]
                                    }
