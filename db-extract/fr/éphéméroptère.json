                ],
                "translations": [
                    {
                        "translation_id": "3b9d626e-c051-46ef-aca3-65e52a1fcb36",
                        "source_entry_id": "d74973f7-d8ef-3547-ba6c-50f45e892b15",
                        "source_sense_id": "aec305c2-9e24-3b71-9a38-82a2eae5c0e3",
                        "target_lang_word": "Eintagsfliege",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Eintagsfliege",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "11dfece7-39b4-3479-9731-7f72ea4d285c",
                                        "entry_id": "dc999145-b27b-3fbd-a7f8-2990f35b8794",
                                        "glosses": [
                                            "Ordnung der Insekten mit rund 2800 Arten"
                                        ],
                                        "tags": [
                                            "zoologisch"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5ce7ded8-2aeb-43ca-b9d1-f2fa89a021a2",
                                                "sense_id": "11dfece7-39b4-3479-9731-7f72ea4d285c",
                                                "text": "Die Eintagsfliegen besitzen große Flügel, wobei der Vorderflügel deutlich größer ist als der Hinterflügel."
                                            },
                                            {
                                                "example_id": "8ca4a86c-f2ef-4122-9df7-eb76765a26da",
                                                "sense_id": "11dfece7-39b4-3479-9731-7f72ea4d285c",
                                                "text": "[Schlagzeile:] „Lebt eine Eintagsfliege auch mal drei Tage?“"
                                            },
                                            {
                                                "example_id": "eb302163-1eb3-4075-984d-a24a9b6a4b17",
                                                "sense_id": "11dfece7-39b4-3479-9731-7f72ea4d285c",
                                                "text": "„Es ist ein nur kurzes, aber umso spektakuläreres Naturschauspiel, das sich jedes Jahr in Schwandorf wiederholt: Millionen von Eintagsfliegen schlüpfen, paaren sich und sterben. In diesem Jahr waren sie besonders früh dran.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f69a79a5-e01a-3f08-9d39-bed2f42786c3",
                                        "entry_id": "dc999145-b27b-3fbd-a7f8-2990f35b8794",
                                        "glosses": [
                                            "etwas oder jemand, der nur kurze Zeit oder ein einziges Mal einen Erfolg hat und dann nicht mehr beachtet wird"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f93b41d7-f783-4673-962d-ca70d546b83a",
                                                "sense_id": "f69a79a5-e01a-3f08-9d39-bed2f42786c3",
                                                "text": "„[…] ich überlege mir öfters mal, ob es sich überhaupt lohnt, sich zu engagieren. Bringt das was oder ist es nur eine Eintagsfliege?“"
                                            },
                                            {
                                                "example_id": "47527395-69a9-46c0-8e51-ac7671004e7d",
                                                "sense_id": "f69a79a5-e01a-3f08-9d39-bed2f42786c3",
                                                "text": "„[Das Theaterstück] \"König Charles III\" war keine Eintagsfliege – wir sollten uns Mike Bartlett als Autor merken.“"
                                            },
                                            {
                                                "example_id": "934007e2-f095-4bb7-964a-2d0375cb3fa4",
                                                "sense_id": "f69a79a5-e01a-3f08-9d39-bed2f42786c3",
                                                "text": "„Im Juli 1983 erscheint das erste Album von Madonna. […] Kaum jemand hatte Madonna damals ernst genommen […]. Sie […] könne nicht singen, sei dumm und eine musikalische Eintagsfliege, muss sie sich anhören.“"
                                            },
                                            {
                                                "example_id": "9a624414-6fdb-43f5-ba7d-b8af037ef398",
                                                "sense_id": "f69a79a5-e01a-3f08-9d39-bed2f42786c3",
                                                "text": "„Die beste Mühe und Arbeit ist nur zu oft an eine musikalische oder dramatische Eintagsfliege vergeudet, alle Mühen der Ausstattung sind dann im Requisitenkasten begraben.“"
                                            },
                                            {
                                                "example_id": "5290c629-4d28-4305-a759-b94d2e46cd25",
                                                "sense_id": "f69a79a5-e01a-3f08-9d39-bed2f42786c3",
                                                "text": "„In den 90er Jahren verpasst [Bill] Gates ausgerechnet den wichtigsten Zukunftstrend: Er hält das Internet für eine Eintagsfliege.“"
                                            },
                                            {
                                                "example_id": "6688b5ba-e3d0-4890-ae3c-c48dccd65cd6",
                                                "sense_id": "f69a79a5-e01a-3f08-9d39-bed2f42786c3",
                                                "text": "„Aber auch bei Lexemen, die quasi über Nacht allgemeine Verbreitung finden, muss sich jeweils erweisen, dass es sich nicht nur um Eintagsfliegen handelt.“"
                                            },
                                            {
                                                "example_id": "4ff595be-7842-49e6-9b35-b16ae94f87b1",
                                                "sense_id": "f69a79a5-e01a-3f08-9d39-bed2f42786c3",
                                                "text": "„[Von den Denkzettel- oder Protestwählern] profitierten Parteien am rechten oder gar rechtsextremen Rand. In den Parlamenten etabliert hat sich keine - weder Republikaner noch DVU und NPD oder die Hamburger Eintagsfliege Partei Rechtsstaatlicher Offensive.“"
                                            },
                                            {
                                                "example_id": "9a3688e5-04a9-4426-9532-fce83429f4a3",
                                                "sense_id": "f69a79a5-e01a-3f08-9d39-bed2f42786c3",
                                                "text": "„[Die Jahresgutachten des Sachverständigenrats] sollten mehr sein als nur eine Eintagsfliege im Berliner Politikbetrieb.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "15bd29a1-febe-4551-a868-8ef8c82a5e49",
                        "source_entry_id": "d74973f7-d8ef-3547-ba6c-50f45e892b15",
                        "source_sense_id": "aec305c2-9e24-3b71-9a38-82a2eae5c0e3",
                        "target_lang_word": "mayfly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mayfly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1c5cd412-333e-3d82-a9c8-049707f78541",
                                        "entry_id": "58aaa366-a266-3b82-ae7c-da4687b1c5bd",
                                        "glosses": [
                                            "Any of the many fragile insects of the order Ephemeroptera that develop in fresh water and live very briefly as winged adults."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43b1f4ce-f88e-45f3-80c3-e2282f64b5c5",
                                                "sense_id": "1c5cd412-333e-3d82-a9c8-049707f78541",
                                                "text": "While some animals take months to reproduce, mayfly need just one perfect day."
                                            },
                                            {
                                                "example_id": "d49bfe4d-3f74-47ad-ba55-40338e319c03",
                                                "sense_id": "1c5cd412-333e-3d82-a9c8-049707f78541",
                                                "text": "[A] silver fish clooped a lazy arc downstream, not really caring that the mayfly were out of reach; […]"
                                            },
                                            {
                                                "example_id": "6965cb6b-2cbb-48af-8402-dd9258f40061",
                                                "sense_id": "1c5cd412-333e-3d82-a9c8-049707f78541",
                                                "text": "Adult mayflies have large compound eyes and most have two pairs of wings.[…]Mayfly nymphs are distinguished by their three tails (two cerci and a terminal filament) and the set of gills on each side of their abdomen."
                                            },
                                            {
                                                "example_id": "063b090d-2b34-4d4b-92b8-fe3bc5054960",
                                                "sense_id": "1c5cd412-333e-3d82-a9c8-049707f78541",
                                                "text": "Mayflies are fragile, gossamer-winged insects that arise from bodies of water and often swarm in great numbers."
                                            },
                                            {
                                                "example_id": "f0b278f3-d6f7-402d-9287-87eea1e12014",
                                                "sense_id": "1c5cd412-333e-3d82-a9c8-049707f78541",
                                                "text": "Stoneflies have negligible consumptive (thin solid line) and behavioral effects (thin dashed line) on mayfly abundance. Consumption by trout decreases the abundance of mayflies (solid line), but trout suppress mayfly emigration (drift) and thereby increase their abundance (thick dashed line)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5737c7ee-f202-32f8-94d2-04cdd5173481",
                                        "entry_id": "58aaa366-a266-3b82-ae7c-da4687b1c5bd",
                                        "glosses": [
                                            "Characterized by a short duration; short-lived."
                                        ],
                                        "tags": [
                                            "attributive",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3be1a387-4782-403b-bd7b-63353c50aeb6",
                                                "sense_id": "5737c7ee-f202-32f8-94d2-04cdd5173481",
                                                "text": "Dipping a French fry in her tomato ketchup, she admits that her name recognition could be higher. But it did spike a year ago during the mayfly premiership of Liz Truss."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
