                "senses": [
                    {
                        "sense_id": "acdbe01f-c9e0-3b8d-a78d-af34f40746e7",
                        "entry_id": "08b8fb17-faf7-3f7b-8ff7-6357d52af081",
                        "glosses": [
                            "Anwendungsprogramm, das Clientanwendungen Dienstleistungen zur Verfügung stellt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5c0d3e15-9c55-4523-91e7-b1fa5d4a2a43",
                                "sense_id": "acdbe01f-c9e0-3b8d-a78d-af34f40746e7",
                                "text": "Als nun seine Serveranwendung nicht nur abstürzte, sondern auch den Server abstürzen ließ, grinsten wieder alle recht bestialisch."
                            },
                            {
                                "example_id": "ea43f4f3-11b2-43e4-890f-2b48409eb2e2",
                                "sense_id": "acdbe01f-c9e0-3b8d-a78d-af34f40746e7",
                                "text": "„Die Serveranwendung lädt den privaten RSA-Schlüssel des Distributors und den öffentlichen RSA-Schlüssel des Clients aus […]“"
                            },
                            {
                                "example_id": "1816520f-ba0a-461a-be09-286919caf798",
                                "sense_id": "acdbe01f-c9e0-3b8d-a78d-af34f40746e7",
                                "text": "„In den folgenden Abschnitten werden die verbleibenden Schritte zum Erstellen einer Winsock-Serveranwendung beschrieben. Es folgt ein allgemeines Modell zum Erstellen eines Streaming-TCP/IP-Servers.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
