        "fr-extract.jsonl": [
            {
                "entry_id": "d81a1b2d-d5f3-3878-afd3-c8ed3e372810",
                "word": "prouesse",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "3cb0949e-45e5-4a59-82b4-5118d8ec0883",
                        "entry_id": "d81a1b2d-d5f3-3878-afd3-c8ed3e372810",
                        "tags": [
                            "plural"
                        ],
                        "form": "prouesses"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4624ae52-0a2d-38b4-bdb8-f4981a3ea21d",
                        "entry_id": "d81a1b2d-d5f3-3878-afd3-c8ed3e372810",
                        "glosses": [
                            "Action de preux, vaillance."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "53a03f8e-805d-44e2-983f-2466ec27fec8",
                                "sense_id": "4624ae52-0a2d-38b4-bdb8-f4981a3ea21d",
                                "text": "Or combien que Basle fut délivrée de l’assaut de l’armée Françoise, par la prouesse des Suisses, toutesfois parmi ces tumultes les ambassadeurs des Rois & Princes deslogèrent les uns après les autres."
                            },
                            {
                                "example_id": "a49287dc-ce68-4622-8d73-6d7f3f951988",
                                "sense_id": "4624ae52-0a2d-38b4-bdb8-f4981a3ea21d",
                                "text": "Le Lion, terreur des forêts,\nChargé d’ans et pleurant son antique prouesse,\nFut enfin attaqué par ses propres sujets,\nDevenus forts pas sa faiblesse."
                            }
                        ]
                    },
                    {
                        "sense_id": "c3033a29-1343-3902-8587-9fab62382a8f",
                        "entry_id": "d81a1b2d-d5f3-3878-afd3-c8ed3e372810",
                        "glosses": [
                            "Action admirable, tour de force."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "925b1306-d068-4ffc-9175-c28a2a2d4aa3",
                                "sense_id": "c3033a29-1343-3902-8587-9fab62382a8f",
                                "text": "- Il est certain, madame, que le furtif accouplement auquel nous venons de nous abandonner, ne peut être considéré comme une prouesse amoureuse."
                            },
                            {
                                "example_id": "f8ff7cf3-e4ba-4634-bf3c-62f99785f522",
                                "sense_id": "c3033a29-1343-3902-8587-9fab62382a8f",
                                "text": "Parallèlement, je me faisande dans mon box, le doigt dans le nez, peu attentif aux prouesses d’un cancrelat aux prises avec les lacets de ma chaussure."
                            },
                            {
                                "example_id": "a97544e1-bf7d-44a3-99a6-7ca160081e65",
                                "sense_id": "c3033a29-1343-3902-8587-9fab62382a8f",
                                "text": "Si la construction des obélisques représente une prouesse technique indéniable, elle n’est que le point d’aboutissement d’une maîtrise technique acquise au fil d’une expérience multiséculaire […]"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a37ed95a-9413-4e6d-aee1-dba00d5b3c5d",
                        "source_entry_id": "d81a1b2d-d5f3-3878-afd3-c8ed3e372810",
                        "target_lang_word": "prowess",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prowess",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "167df5e8-543a-3212-9cc1-5ca61680c9af",
                                        "entry_id": "746055fd-2329-38f0-817d-b4ba61187747",
                                        "glosses": [
                                            "Skillfulness or extraordinary ability in a particular area of expertise; dexterity, mastery, or proficiency."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e1bf92f6-f728-46f7-8d66-667af39367cd",
                                                "sense_id": "167df5e8-543a-3212-9cc1-5ca61680c9af",
                                                "text": "When in liquor he would make foolish wagers. On one of these too frequent occasions he was boasting of his prowess as a pedestrian and athlete, and the outcome was a match against nature. For a stake of one sovereign he undertook to run all the way to Coventry and back, a distance of something more than forty miles."
                                            },
                                            {
                                                "example_id": "cd25034e-4e40-4f93-9868-a57cac722262",
                                                "sense_id": "167df5e8-543a-3212-9cc1-5ca61680c9af",
                                                "text": "There is such a sense of inferiority sometimes when it comes to facing Germany, with all their World Cups, their penalty prowess and easy sophistication, it might come as a surprise to learn that, in head-to-head encounters, England actually match their opponents."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3c350d5b-bc6d-391e-91ea-68cefbb7b515",
                                        "entry_id": "746055fd-2329-38f0-817d-b4ba61187747",
                                        "glosses": [
                                            "Distinguished bravery or courage, especially in battle; heroism."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "23f973e7-c853-4586-8bbb-fde71d454f45",
                                                "sense_id": "3c350d5b-bc6d-391e-91ea-68cefbb7b515",
                                                "text": "That libertie Poets of late in their invectives have exceeded: they have borne their ſword up where it is not lawfull for a poynado, that is but the page of proweſſe, to intermeddle."
                                            },
                                            {
                                                "example_id": "138ff1b6-ab84-41e8-abcb-3035b43076b5",
                                                "sense_id": "3c350d5b-bc6d-391e-91ea-68cefbb7b515",
                                                "text": "[…] But, wroth because this man in full assembly, / Came and reviled thee, thou wouldst shew thy prowess, / The prowess that attends thee, that henceforth / Not e'er a man might think to scorn thy prowess, […]"
                                            },
                                            {
                                                "example_id": "c51e8427-20d6-4276-97a4-91862d7d5478",
                                                "sense_id": "3c350d5b-bc6d-391e-91ea-68cefbb7b515",
                                                "text": "A beautiful great lady, past her prime, / Behold her dreaming in her easy chair; / Grey robed, and veiled, in laces old and rare, / Her smiling eyes see but the vanished time / Of splendid prowess, and of deeds sublime."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ad7a80f6-dba6-307e-8208-ebb6d9afec19",
                                        "entry_id": "746055fd-2329-38f0-817d-b4ba61187747",
                                        "glosses": [
                                            "An act of prowess.",
                                            "An act of adroitness or dexterity."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7e0f5058-d274-4878-929c-f21986dee343",
                                                "sense_id": "ad7a80f6-dba6-307e-8208-ebb6d9afec19",
                                                "text": "I recollect hearing […] of his [Sir William Hamilton's] simple, independent, meditative habits, ruggedly athletic modes of exercise, fondness for his big dog, etc. etc.: […] I did not witness, much less share in, any of the swimming or other athletic prowesses."
                                            },
                                            {
                                                "example_id": "8b2f58b1-547b-4076-a82d-3922451d6497",
                                                "sense_id": "ad7a80f6-dba6-307e-8208-ebb6d9afec19",
                                                "text": "As the Middle Ages drew to a close and the Renaissance rose like a new sun, knowledge of philosophy and the sciences became objects of interest to a nobility that had once held only skill in battle as a prowess worth attaining."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cfec8747-5e77-336b-8636-3b1368439912",
                                        "entry_id": "746055fd-2329-38f0-817d-b4ba61187747",
                                        "glosses": [
                                            "An act of prowess.",
                                            "An act of distinguished bravery or courage; a heroic deed."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "10e058dd-eacb-43e6-9be8-ade0a7df9488",
                                                "sense_id": "cfec8747-5e77-336b-8636-3b1368439912",
                                                "text": "Thenne the batails approuched and ſhoue and ſhowted on bothe ſydes / many men ouerthrowen / hurte / & ſlayn and grete valyaunces / proweſſes and appertyces of werre were that day ſhewed […]"
                                            },
                                            {
                                                "example_id": "444ac6d1-9f88-43c1-a0a0-60a2a9632498",
                                                "sense_id": "cfec8747-5e77-336b-8636-3b1368439912",
                                                "text": "If it is deemed of so much importance, why has no attention been paid to the effects of general friendship, such as certain military prowesses, in which you see a portion of a regiment sacrifice itself in support of another portion?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "795ce248-3c0c-40b4-a1d1-faf7b5c1e59a",
                        "source_entry_id": "d81a1b2d-d5f3-3878-afd3-c8ed3e372810",
                        "target_lang_word": "derring-do",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "derring-do",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1092d06c-2ef3-302d-919d-61d3fab7e903",
                                        "entry_id": "8173c38c-5342-3703-84b5-42139b5786f3",
                                        "glosses": [
                                            "Valiant deeds in desperate times."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "568a3a96-df87-4310-ac4e-d5af1022412f",
                                                "sense_id": "1092d06c-2ef3-302d-919d-61d3fab7e903",
                                                "text": "With a cry of sheer derring-do, the climber leapt across the chasm."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "681a9d0a-3fa3-397c-9dd8-e77989c4af45",
                                        "entry_id": "8173c38c-5342-3703-84b5-42139b5786f3",
                                        "glosses": [
                                            "Brave and adventurous (albeit often reckless) actions."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e058400e-5577-4487-a9e9-67deb249748b",
                        "source_entry_id": "d81a1b2d-d5f3-3878-afd3-c8ed3e372810",
                        "target_lang_word": "feat",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "feat",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0f1025b3-ffc9-3bf8-8664-b442c2ea4c9c",
                                        "entry_id": "a5fde5a8-114e-3228-9b8e-20a36a0d9e60",
                                        "glosses": [
                                            "A relatively rare or difficult accomplishment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3fe7a126-901a-469b-8910-f094943eaf8a",
                                                "sense_id": "0f1025b3-ffc9-3bf8-8664-b442c2ea4c9c",
                                                "text": "I consider scaling Mount Blanc the greatest physical feat of my life."
                                            },
                                            {
                                                "example_id": "afb23f3c-903e-405f-90d0-246f38a43b04",
                                                "sense_id": "0f1025b3-ffc9-3bf8-8664-b442c2ea4c9c",
                                                "text": "Raising six children who all went on to be doctors was a tough feat for us."
                                            },
                                            {
                                                "example_id": "385b56ee-7451-49eb-902d-f83416ef3791",
                                                "sense_id": "0f1025b3-ffc9-3bf8-8664-b442c2ea4c9c",
                                                "text": "Bradford may have lost on the night but they stubbornly protected a 3-1 first-leg advantage to emulate a feat last achieved by Rochdale in 1962."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "feat",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "18937a30-5b72-3773-aeb2-76f3398b3179",
                                        "entry_id": "91dd2971-90d8-3ed2-a673-67770847a7b5",
                                        "glosses": [
                                            "Dexterous in movements or service; skilful; neat; pretty."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4ba5884a-bed4-4827-bf72-27c87df15189",
                                                "sense_id": "18937a30-5b72-3773-aeb2-76f3398b3179",
                                                "text": "[…] she set downe her period on the face of Alexis, thinking he was the fairest, and the featest swaine of all the rest."
                                            },
                                            {
                                                "example_id": "a65bc74b-0edd-43ce-8244-ac413e18d7be",
                                                "sense_id": "18937a30-5b72-3773-aeb2-76f3398b3179",
                                                "text": "Oh you high sp’rited Paragons of witte,\nThat flye to fame beyond our earthly pitch,\nWhose sence is sound, whose words are feat and fitte,\nAble to make the coyest eare to itch:\nShroud with your mighty wings that mount so well,\nThese little loues, new crept from out the shell."
                                            },
                                            {
                                                "example_id": "fcd7d5c1-e700-4403-860b-1ed6dda26dad",
                                                "sense_id": "18937a30-5b72-3773-aeb2-76f3398b3179",
                                                "text": "[…] never master had\nA page so kind, so duteous, diligent,\nSo tender over his occasions, true,\nSo feat, so nurse-like:"
                                            },
                                            {
                                                "example_id": "600d944b-fbca-4bd4-a976-0e9c61b609d0",
                                                "sense_id": "18937a30-5b72-3773-aeb2-76f3398b3179",
                                                "text": "And look how well my garments sit upon me;\nMuch feater than before:"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "feat",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8f11ec64-b204-386b-97f4-61889d819544",
                                        "entry_id": "8fb525d7-9cf2-3df7-8b7d-0e85f0517106",
                                        "glosses": [
                                            "To form; to fashion."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bf34bee2-ceee-4d78-8377-005b8bcc07e2",
                                                "sense_id": "8f11ec64-b204-386b-97f4-61889d819544",
                                                "text": "[…] most praised, most loved,\nA sample to the youngest, to the more mature\nA glass that feated them, and to the graver\nA child that guided dotards;"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "feat",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fba9bb37-395e-323b-b4af-6f9bfd04d63a",
                                        "entry_id": "c7b6447f-259b-3509-9297-cad6fdc84be0",
                                        "glosses": [
                                            "To feature."
                                        ],
                                        "tags": [
                                            "informal",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "917e2feb-2840-49aa-aba4-26654c6ac058",
                                                "sense_id": "fba9bb37-395e-323b-b4af-6f9bfd04d63a",
                                                "text": "A new team suite will also be added feating new team locker rooms, a nutrition station, team meeting room, a team lounge and coaches’ offices and conference room."
                                            },
                                            {
                                                "example_id": "30211bb5-9701-4a49-b7c4-5484353f4011",
                                                "sense_id": "fba9bb37-395e-323b-b4af-6f9bfd04d63a",
                                                "text": "Two films by John and Yoko, ‘Imagine’ and ‘Gimme Some Truth’ will also be re-released on October 5 feating new footage, “raw” studio mixes and a new insight into a photo shoot the couple did with iconic British photographer David Bailey."
                                            },
                                            {
                                                "example_id": "f9a8e267-e606-4d80-a14d-48c24ef40e29",
                                                "sense_id": "fba9bb37-395e-323b-b4af-6f9bfd04d63a",
                                                "text": "This could also be the match in which we see the highly-anticipated debut of an attacking triumvirate feating Nicolas Pepe, Pierre-Emerick Aubameyang and Alexandre Lacazette."
                                            },
                                            {
                                                "example_id": "d16f971e-3f8b-4fbb-a1c3-149bf3db0117",
                                                "sense_id": "fba9bb37-395e-323b-b4af-6f9bfd04d63a",
                                                "text": "Last year, the rapper had a number of hit singles, including Fefe, with Nicki Minaj, and Stoopid, feating imprisoned rapper Bobby Shmurda."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "302d592a-6e1c-4e39-88a1-d8c89eb5146d",
                        "source_entry_id": "d81a1b2d-d5f3-3878-afd3-c8ed3e372810",
                        "target_lang_word": "achievement",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "achievement",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f06d6edd-02c2-387c-a700-e32804d25afe",
                                        "entry_id": "9d2969ef-c77a-3045-b5c5-680e06d11c87",
                                        "glosses": [
                                            "The act of achieving or performing; a successful performance; accomplishment."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "10afc28b-de83-446a-ba88-ef491952d1c8",
                                                "sense_id": "f06d6edd-02c2-387c-a700-e32804d25afe",
                                                "text": "The original family who had begun to build a palace to rival Nonesuch had died out before they had put up little more than the gateway, so that the actual structure which had come down to posterity retained the secret magic of a promise rather than the overpowering splendour of a great architectural achievement."
                                            },
                                            {
                                                "example_id": "616da912-7e63-4f67-8d57-692b2721e0f1",
                                                "sense_id": "f06d6edd-02c2-387c-a700-e32804d25afe",
                                                "text": "As to the type of seat preferred, the views were so varied that it was considered wisely that the ideal design was beyond achievement!"
                                            },
                                            {
                                                "example_id": "d10ae649-00be-4a52-844c-f2a5f390097f",
                                                "sense_id": "f06d6edd-02c2-387c-a700-e32804d25afe",
                                                "text": "Creating a complete map of the human connectome would therefore be a monumental milestone but not the end of the journey to understanding how our brains work. The achievement will transform neuroscience and serve as the starting point for asking questions we could not otherwise have answered, […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d7891bc7-be28-30e7-8a3a-46c2a4effa91",
                                        "entry_id": "9d2969ef-c77a-3045-b5c5-680e06d11c87",
                                        "glosses": [
                                            "A great or heroic deed or feat; something accomplished by valor or boldness."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "38003b6d-3580-4206-8516-561c3845811f",
                                                "sense_id": "d7891bc7-be28-30e7-8a3a-46c2a4effa91",
                                                "text": "[…]the English genius was effecting in science a revolution which will, to the end of time, be reckoned among the highest achievements of the human intellect."
                                            },
                                            {
                                                "example_id": "0104ed78-acc4-4032-9b10-960f107a1f78",
                                                "sense_id": "d7891bc7-be28-30e7-8a3a-46c2a4effa91",
                                                "text": "[The exploits] of the ancient saints ; they do far surpass the most famous achievements of pagan heroes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d81fd037-491c-308d-9029-5bf298da729c",
                                        "entry_id": "9d2969ef-c77a-3045-b5c5-680e06d11c87",
                                        "glosses": [
                                            "An escutcheon or ensign armorial; a full display or depiction of all the heraldic components to which the bearer of a coat of arms is entitled; (now especially) a funeral shield: the hatchment."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "37f1e993-a034-4b2e-94ed-69626751f7d4",
                                                "sense_id": "d81fd037-491c-308d-9029-5bf298da729c",
                                                "text": "The narrow Gothic windows were filled, not with glass that admitted the light, but with glass painted with the achievements of the family […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e7c07f7f-3ee5-3158-8b6d-583c96ab5b11",
                                        "entry_id": "9d2969ef-c77a-3045-b5c5-680e06d11c87",
                                        "glosses": [
                                            "An award for completing a particular task or meeting an objective in a video game."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3ab2f359-db12-44c5-abfb-66e5aa321a0b",
                                                "sense_id": "e7c07f7f-3ee5-3158-8b6d-583c96ab5b11",
                                                "text": "Finishing the game does not give you a 100% score until you have unlocked all of the achievements."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6a435614-6056-3fac-967e-2142bd0cb9a8",
                                        "entry_id": "9d2969ef-c77a-3045-b5c5-680e06d11c87",
                                        "glosses": [
                                            "The lexical aspect (aktionsart) of verbs or predicates that change in an instant."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba2ee612-27a2-4ce5-bfd6-148a4fe3dd4d",
                                                "sense_id": "6a435614-6056-3fac-967e-2142bd0cb9a8",
                                                "text": "[…]distinctions among states of affairs are reflected to a striking degree in distinctions among Aktionsart types. That is, situations are expressed by state verbs or predicates, events by achievement verbs or predicates, and actions by activity verbs or predicates."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "87942f4c-8d91-32b5-ba59-1df4ab07a172",
                                        "entry_id": "9d2969ef-c77a-3045-b5c5-680e06d11c87",
                                        "glosses": [
                                            "The successful completion of a socially defined goal or task, highlighting individual or group accomplishment."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
