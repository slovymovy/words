                "senses": [
                    {
                        "sense_id": "4bf37c24-3137-3bea-8402-462f5bfbb1ba",
                        "entry_id": "cf89df9f-8e6c-3466-bf5d-451f069f4458",
                        "glosses": [
                            "A green chalcedony that is sprinkled with red spots or veins of hematite."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d95ab47-c74d-4f18-b0c4-f7e99f99839f",
                                "sense_id": "4bf37c24-3137-3bea-8402-462f5bfbb1ba",
                                "text": "These following bodies do not draw: smaragd, achates, corneolus, pearl, jaspis, chalcedonius, alabaster, porphyry, coral, marble, touchstone, haematites, or bloodstone […]"
                            },
                            {
                                "example_id": "75c8da3a-2cf2-40ec-a6bb-bc429127e29d",
                                "sense_id": "4bf37c24-3137-3bea-8402-462f5bfbb1ba",
                                "text": "The magician wore a blood-stone ring […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "2a46acc5-d937-3992-a730-1968178f8887",
                        "entry_id": "cf89df9f-8e6c-3466-bf5d-451f069f4458",
                        "glosses": [
                            "Hematite."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0dbd8587-4fcd-4177-adb6-6dedd6a61782",
                        "source_entry_id": "cf89df9f-8e6c-3466-bf5d-451f069f4458",
                        "source_sense_description": "green chalcedony sprinkled with red spots or veins of hematite",
                        "target_lang_word": "pierre de sang",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "271bc19b-f04d-4287-9e3c-420b5aebdcc4",
                        "source_entry_id": "cf89df9f-8e6c-3466-bf5d-451f069f4458",
                        "source_sense_description": "green chalcedony sprinkled with red spots or veins of hematite",
                        "target_lang_word": "héliotrope",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "héliotrope",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "23fc4bdc-6f8a-38e0-a205-69f2c745952d",
                                        "entry_id": "b77fdc88-6de0-3d59-8461-c0901f9ec587",
                                        "glosses": [
                                            "Plante de la famille des Boraginacées, à espèces très nombreuses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "069b898c-4b0e-4023-926c-d0a06a26a62a",
                                                "sense_id": "23fc4bdc-6f8a-38e0-a205-69f2c745952d",
                                                "text": "On distingue deux sortes d’Héliotropes. L’Héliotrope proprement dit , se trouve dans les terrains incultes ; il croît le long des chemins et au pied des édifices. Sa tige est d’un vert blanchâtre. L’autre espèce d’Héliotrope est celui du Pérou , apporté en France par M. Joseph Jussieu. Ses fleurs sont bleuâtres. L’Héliotrope, placé dans de beaux vases, parfume les appartemens; il est si chargé de rosée pendant la plus grande ardeur du soleil, qu’en une demi-heure on peut en tirer deux onces d’une seule fleur."
                                            },
                                            {
                                                "example_id": "231118c4-79b5-4169-b4e5-f8dc05d2d967",
                                                "sense_id": "23fc4bdc-6f8a-38e0-a205-69f2c745952d",
                                                "text": "Aux côtés des fiers palmiers se dévoilent quantités de parfums : bouquets d’agrumes, géraniums flamboyants, senteurs de pain d’épices et de miel de l’héliotrope, effluves d’ananas et de sauge, odeurs de fleurs d’oranger, de citronnier, de mandarinier, de verveine citronnée."
                                            },
                                            {
                                                "example_id": "a1aed072-74a4-46a8-9d57-d67756a759b7",
                                                "sense_id": "23fc4bdc-6f8a-38e0-a205-69f2c745952d",
                                                "text": "Elle ne subissait plus l’influence de la nuit, elle n’entendait plus la musique monotone des pins, elle ne sentait plus le parfum des verveines et des héliotropes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0af9265c-e405-3dbd-88a6-cffc4c3475e1",
                                        "entry_id": "b77fdc88-6de0-3d59-8461-c0901f9ec587",
                                        "glosses": [
                                            "Plante dont la fleur suit le cours du soleil (ex. : tournesol)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c413071f-f561-4161-97a6-309fe2136b89",
                                                "sense_id": "0af9265c-e405-3dbd-88a6-cffc4c3475e1",
                                                "text": "Vancouver, l’embrassant. – Bonjour ma fille... ma fleur, mon héliotrope ! (Au public.) Je vous présente mon héliotrope."
                                            },
                                            {
                                                "example_id": "d26d9d6a-b033-46ef-8fe5-8a856ae7f21b",
                                                "sense_id": "0af9265c-e405-3dbd-88a6-cffc4c3475e1",
                                                "text": "Sur le bord des fenêtres, à tous les étages, dans un pot d’argile peinte, un basilic ou un héliotrope s’épanouissait."
                                            },
                                            {
                                                "example_id": "767ccd81-5fc8-423c-9c80-7f32714304e9",
                                                "sense_id": "0af9265c-e405-3dbd-88a6-cffc4c3475e1",
                                                "text": "Ce jeune être souffrant, étroitement surveillé par une famille, cherchait mon regard aussi inconsciemment qu'un héliotrope se tourne vers le soleil."
                                            },
                                            {
                                                "example_id": "7b9dfb3d-f48b-4583-8fab-bb0ed2f745e3",
                                                "sense_id": "0af9265c-e405-3dbd-88a6-cffc4c3475e1",
                                                "text": "Alexandre fut agacé de la tendresse qui se glissait en lui et le rendait suave et mou à l’intérieur, orienté vers la bienveillance comme un héliotrope vers le soleil."
                                            },
                                            {
                                                "example_id": "e936fd0f-3512-421c-874d-a8c745eecb46",
                                                "sense_id": "0af9265c-e405-3dbd-88a6-cffc4c3475e1",
                                                "text": "Des dégénérés itinérants qui se répandaient vers l'ouest comme un troupeau d'héliotropes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "31f8b9e1-331f-3a34-b7d0-7f38cc9433c9",
                                        "entry_id": "b77fdc88-6de0-3d59-8461-c0901f9ec587",
                                        "glosses": [
                                            "Pierre semi-précieuse qui est une espèce de jaspe verdâtre et rayée de veines rouges."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a8a77362-43b0-4d4d-b523-716d20ef1bec",
                                                "sense_id": "31f8b9e1-331f-3a34-b7d0-7f38cc9433c9",
                                                "text": "Quand [l’agathe] affecte la belle nuance du rouge cerise et même en décroissant, on l’appelle cornaline ; — la couleur plus ou moins orangée lui fait donner le nom de sardoine ; — est-elle colorée en vert tendre par l’oxyde de nickel, elle devient chrysoprase ; — est-elle d’un vert obscur ponctuée de rouge, elle constitue l’héliotrope ou agate ponctuée."
                                            },
                                            {
                                                "example_id": "f0e50d60-58cf-4957-ab41-028b07341603",
                                                "sense_id": "31f8b9e1-331f-3a34-b7d0-7f38cc9433c9",
                                                "text": "L’héliotrope se trouve en Ethiopie, en Afrique, en Chypre; il est de couleur porracée, de veiné de rouge. Il a été nommé ainsi parce que mis dans un vase d’eau il donne un reflet couleur de sang aux rayons du soleil qui y tombent. L’héliotrope d’Ethiopie surtout produit ce phénomène. Cette pierre hors de l’eau reçoit comme un miroir l’image du soleil, et lorsque cet astre s’éclipse montre la lune qui passe au-devant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "562f6147-c5b2-3b34-8877-dc5278822e0a",
                                        "entry_id": "b77fdc88-6de0-3d59-8461-c0901f9ec587",
                                        "glosses": [
                                            "Instrument de géodésie inventé en 1821 par Carl Friedrich Gauss, composé d'un télescope et d'un miroir qui réfléchit les rayons du soleil sur de longues distances."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "62ae119c-3318-4c41-b8f3-c6fc54f9fe64",
                                                "sense_id": "562f6147-c5b2-3b34-8877-dc5278822e0a",
                                                "text": "Héliotrope de Gauss"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "43c09520-6302-3ad4-9106-c2c26c8b9062",
                                        "entry_id": "b77fdc88-6de0-3d59-8461-c0901f9ec587",
                                        "glosses": [
                                            "Couleur violette. #DF73FF"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "33dfa2c8-02c7-4e97-98ed-74426dba5f5a",
                                                "sense_id": "43c09520-6302-3ad4-9106-c2c26c8b9062",
                                                "text": "— La mode est aux plumes d’oiseaux. Pour les couleurs, si vous le souhaitez, la mode est à présent à l’héliotrope ou canaque, autrement dit bordeaux mêlé de jaune."
                                            },
                                            {
                                                "example_id": "55cc480e-a708-4363-bb45-fa2a2ab7f2ab",
                                                "sense_id": "43c09520-6302-3ad4-9106-c2c26c8b9062",
                                                "text": "Le canapé semblait neuf sous sa parure de velours frappé, héliotrope sur fond indigo."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "héliotrope",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "22786edd-8fb6-31b7-b30c-be79164e3c2c",
                                        "entry_id": "8156cd10-15f1-338b-b597-720077dedfb3",
                                        "glosses": [
                                            "Dont la fleur suit le cours du soleil"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2bbaf0cb-daa9-49b4-92b0-2bdd25763d29",
                                                "sense_id": "22786edd-8fb6-31b7-b30c-be79164e3c2c",
                                                "text": "Plantes héliotropes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c73886ed-4f18-30da-ac90-b49b80365ded",
                                        "entry_id": "8156cd10-15f1-338b-b597-720077dedfb3",
                                        "glosses": [
                                            "Installation qui s’oriente vers le Soleil."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8cdbb846-c281-475a-9652-8844c563ceb9",
                                                "sense_id": "c73886ed-4f18-30da-ac90-b49b80365ded",
                                                "text": "Maison climatique héliotrope."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4aa41af7-9be5-33cc-baef-021cede41685",
                                        "entry_id": "8156cd10-15f1-338b-b597-720077dedfb3",
                                        "glosses": [
                                            "De couleur héliotrope."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e60bb0d7-f92e-4106-9e6b-743781d25789",
                                                "sense_id": "4aa41af7-9be5-33cc-baef-021cede41685",
                                                "text": "Attentif aux mille petits épisodes de la rue, Vincent se réjouissait de tout: […], noces bourgeoises avec la jeune épouse rougissante, le mari bien frisé, le papa sanguin, la grosse maman en soie noire, la demoiselle d'honneur héliotrope, le garçon d'honneur mal à l'aise en son inhabituelle redingote, […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "770d67e0-be87-404c-997b-776a6cac6b89",
