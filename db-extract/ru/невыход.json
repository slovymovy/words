                "translations": [
                    {
                        "translation_id": "1525eead-612a-4104-b6eb-dd92df614665",
                        "source_entry_id": "4d0ead64-a13d-394e-b812-416f1bfdf03c",
                        "source_sense_description": "неявка на работу",
                        "target_lang_word": "absence",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "absence",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e27b44fd-2c29-3b0a-947c-529217bc8f20",
                                        "entry_id": "3135aec2-6047-3a17-84c3-b516247c2f17",
                                        "glosses": [
                                            "Inexistence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee7109c5-74a8-4220-8e23-82644bcc3c38",
                                                "sense_id": "e27b44fd-2c29-3b0a-947c-529217bc8f20",
                                                "text": "Ripartites helomorphus se distingue de ses congénères par le chapeau gibbeux et charnu, beaucoup plus épais que la largeur des lamelles, par l’absence de cils marginaux et par ses spores très petites à verrues basses et arrondies."
                                            },
                                            {
                                                "example_id": "83e51f14-1837-40a9-8b53-3ca012b2db5f",
                                                "sense_id": "e27b44fd-2c29-3b0a-947c-529217bc8f20",
                                                "text": "Il est probable qu’aucune preuve de vie ne soit trouvée sur Mars, et la question restera sans réponse (l’absence de preuve n’est pas une preuve d’absence)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3f91dd54-0665-3025-af14-49e11ddb43e4",
                                        "entry_id": "3135aec2-6047-3a17-84c3-b516247c2f17",
                                        "glosses": [
                                            "Fait d’être absent, éloignement géographique et temporel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab8424a0-69cd-4de6-a7c7-e177e94c1791",
                                                "sense_id": "3f91dd54-0665-3025-af14-49e11ddb43e4",
                                                "text": "L’absence a des effets singuliers. J’en fis l’épreuve pendant cette première année d’éloignement qui me sépara de M. Dominique, sans qu’aucun souvenir direct parût nous rappeler l’un à l’autre. L’absence unit et désunit, elle rapproche aussi bien qu’elle divise, elle fait se souvenir, elle fait oublier ; elle relâche certains liens très-solides, elle les tend et les éprouve au point de les briser ; il y a des liaisons soi-disant indestructibles dans lesquelles elle fait d’irrémédiables avaries ; elle accumule des mondes d’indifférence sur des promesses de souvenirs éternels."
                                            },
                                            {
                                                "example_id": "282aee16-d4bc-4220-b67b-c3bf89c094f8",
                                                "sense_id": "3f91dd54-0665-3025-af14-49e11ddb43e4",
                                                "text": "Son absence durait un an, deux ans. Et puis, un beau soir, sans que personne de son entourage fût prévenu, il reparaissait soudainement."
                                            },
                                            {
                                                "example_id": "b27b67e8-af1f-4c54-b50d-69255f9a0004",
                                                "sense_id": "3f91dd54-0665-3025-af14-49e11ddb43e4",
                                                "text": "Après deux jours d'absence, nous revenions à Rockall ramenant une nuée de mouettes qui avaient quitté leur îlot pour nous accompagner."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "80e8acb2-bf32-3daf-82c0-363fca119ca0",
                                        "entry_id": "3135aec2-6047-3a17-84c3-b516247c2f17",
                                        "glosses": [
                                            "Défaut de présence à une réunion, à une assignation, à un appel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb6edec4-ddf1-4c1d-b449-2af85f4b6bdb",
                                                "sense_id": "80e8acb2-bf32-3daf-82c0-363fca119ca0",
                                                "text": "On n’a pas laissé de se divertir en votre absence."
                                            },
                                            {
                                                "example_id": "9845bb46-9553-41d8-8078-38c9e5e82c32",
                                                "sense_id": "80e8acb2-bf32-3daf-82c0-363fca119ca0",
                                                "text": "Il fut ordonné qu’on procéderait tant en présence qu’en absence de l’accusé, ou des parties."
                                            },
                                            {
                                                "example_id": "bc857e0c-1351-45c3-a8a4-8e114ddbc8a1",
                                                "sense_id": "80e8acb2-bf32-3daf-82c0-363fca119ca0",
                                                "text": "On a fait constater son absence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7b9a2040-587c-3d11-9ac8-f8ca84de9d53",
                                        "entry_id": "3135aec2-6047-3a17-84c3-b516247c2f17",
                                        "glosses": [
                                            "Situation d’une personne dont on n’a pas reçu de nouvelles depuis une certaine époque et dont la résidence actuelle n’est pas connue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e26db8b-8bd6-4a39-8e73-e4345d0d9d78",
                                                "sense_id": "7b9a2040-587c-3d11-9ac8-f8ca84de9d53",
                                                "text": "Tant que l’absence n’a pas été déclarée par un jugement, elle n’est que présumée."
                                            },
                                            {
                                                "example_id": "cb50fefd-1f76-406a-802c-8889ab59e143",
                                                "sense_id": "7b9a2040-587c-3d11-9ac8-f8ca84de9d53",
                                                "text": "Présomption d’absence."
                                            },
                                            {
                                                "example_id": "b28052e7-ca60-4586-b1d9-3cd4024ff098",
                                                "sense_id": "7b9a2040-587c-3d11-9ac8-f8ca84de9d53",
                                                "text": "Les effets de l’absence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "38e5640b-0fcf-3265-a8ef-f4edd73a8ca2",
                                        "entry_id": "3135aec2-6047-3a17-84c3-b516247c2f17",
                                        "glosses": [
                                            "Perte passagère de la mémoire voire arrêt momentané de la conscience. Il s’agit d’une manifestation mineure de l’épilepsie généralisée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "22f0295f-dd3e-47e4-a0dd-e61684969b7a",
                                                "sense_id": "38e5640b-0fcf-3265-a8ef-f4edd73a8ca2",
                                                "text": "On dit parfois d’un enfant qui a le regard dans le vide qu’il “rêve”, rêve dont il ne peut décrocher pendant quelques secondes. Il est alerte et attentif sur ce qu’il fait, puis soudainement il arrête ce qu’il fait, semble absent, n’est pas réceptif aux paroles qui lui sont adressées. Puis, au bout de quelques secondes, l’enfant redevient alerte et reprend son activité comme si aucune interruption n’avait eu lieu et aucun souvenir des dernières secondes. Ces différents symptômes sont caractéristiques de l’absence épileptique, appelée aussi “crise de petit mal”."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eca4b406-dd1f-3aad-8983-aac9ec391a84",
                                        "entry_id": "3135aec2-6047-3a17-84c3-b516247c2f17",
                                        "glosses": [
                                            "Au sens moral."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6680d37d-ab9e-4768-bc0b-2092becdfe88",
                                                "sense_id": "eca4b406-dd1f-3aad-8983-aac9ec391a84",
                                                "text": "L’intégrité journalistique repose largement sur l’absence de conflits de loyautés, et même sur l’absence d’apparence de tels conflits."
                                            },
                                            {
                                                "example_id": "3efb88ad-17c0-4d4b-b2ae-af7242709ca5",
                                                "sense_id": "eca4b406-dd1f-3aad-8983-aac9ec391a84",
                                                "text": "Il y a dans cet ouvrage une absence totale d’esprit, de goût, de logique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "89f82d0f-d8ac-327a-a8d3-f0d3f9576f0a",
                                        "entry_id": "3135aec2-6047-3a17-84c3-b516247c2f17",
                                        "glosses": [
                                            "Distraction, manque d’attention."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a9c68462-91fd-407f-8240-09b6d0b33fe5",
                                                "sense_id": "89f82d0f-d8ac-327a-a8d3-f0d3f9576f0a",
                                                "text": "Absence d’esprit,"
                                            },
                                            {
                                                "example_id": "1680b978-fb9c-4a05-aa54-025f5c6ec712",
                                                "sense_id": "89f82d0f-d8ac-327a-a8d3-f0d3f9576f0a",
                                                "text": "Il est sujet à des absences d’esprit."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0e8aba81-7e17-460e-a3bb-0766a9ab18d2",
                        "source_entry_id": "4d0ead64-a13d-394e-b812-416f1bfdf03c",
                        "source_sense_description": "неявка на работу",
                        "target_lang_word": "arrêt",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "arrêt",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6d403340-dd7a-3ec2-afe8-23a0fe09df11",
                                        "entry_id": "96562353-f7db-3a83-91b9-780fcfa216d5",
                                        "glosses": [
                                            "Action de s’arrêter ou état d’être arrêté."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eba20286-c4f9-442d-9c93-ebbb10b0468d",
                                                "sense_id": "6d403340-dd7a-3ec2-afe8-23a0fe09df11",
                                                "text": "Les arrêts sont en effet plus fréquents au renvideur par suite des réparations, remplacements de cordes et de câbles et nettoyages plus difficultueux."
                                            },
                                            {
                                                "example_id": "e721303e-363a-44bc-9afa-4c8683f591f3",
                                                "sense_id": "6d403340-dd7a-3ec2-afe8-23a0fe09df11",
                                                "text": "- Votre type a fait un arrêt cardiaque.\n - Grave ?\n - Plus maintenant : il est mort !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d9d8b172-7688-3067-aea6-5528090e7827",
                                        "entry_id": "96562353-f7db-3a83-91b9-780fcfa216d5",
                                        "glosses": [
                                            "Action de s’arrêter ou état d’être arrêté.",
                                            "Situation d'un réacteur nucléaire dans lequel il n'y a plus de réaction de fission entretenue."
                                        ],
                                        "tags": [
                                            "Nucléaire"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "502ce4da-9fd1-4f32-8171-d475b1e9e224",
                                                "sense_id": "d9d8b172-7688-3067-aea6-5528090e7827",
                                                "text": "Il est important de noter que l’arrêt de la réaction en chaîne ne conduit pas à l’arrêt de la production d'énergie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "51a46503-87a2-320d-b99c-80b8800ad207",
                                        "entry_id": "96562353-f7db-3a83-91b9-780fcfa216d5",
                                        "glosses": [
                                            "Action de s’arrêter ou état d’être arrêté.",
                                            "Opérations aboutissant à l'arrêt d'un réacteur nucléaire."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2ad8819e-7c88-4b4b-8c5f-4a6b6964fb41",
                                                "sense_id": "51a46503-87a2-320d-b99c-80b8800ad207",
                                                "text": "Une augmentation de pression a provoqué l’ouverture d’une soupape de décharge du pressuriseur et l’arrêt automatique du réacteur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f9b8e225-6197-37ad-8e1f-79765ffb65dc",
                                        "entry_id": "96562353-f7db-3a83-91b9-780fcfa216d5",
                                        "glosses": [
                                            "Jugement d’une cour souveraine, par lequel une question de fait ou de droit est décidée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "33754aed-331f-4186-9797-69aa37b393e4",
                                                "sense_id": "f9b8e225-6197-37ad-8e1f-79765ffb65dc",
                                                "text": "La cour de cassation ayant rejeté le pourvoi d’Étienne Baud, de Masméjan , commune de Saint-Étienne-de-Lugdarez (Ardèche), condamné à la peine capitale par arrêt de la cour d'assises de la Lozère du 4 juin dernier, pour crime d'homicide volontaire avec préméditation de guet-à-pens, ce malheureux, […], a été exécuté le 13 sur la place d’Angiran à Mende."
                                            },
                                            {
                                                "example_id": "6e26b768-1823-400e-82a5-0b1f7440b3b0",
                                                "sense_id": "f9b8e225-6197-37ad-8e1f-79765ffb65dc",
                                                "text": "En cas d'infraction aux lois réglementaires, les bénéficiers étaient condamnés par les archidiacres à aumôner de grosses sommes à la boete des pauvres, expression souvent employée dans les ordonnances des rois de France et les arrêts du parlement."
                                            },
                                            {
                                                "example_id": "812dc7fd-7d1d-46d8-b1ef-cdf17cb8b31a",
                                                "sense_id": "f9b8e225-6197-37ad-8e1f-79765ffb65dc",
                                                "text": "Je le répète, il n’entre pas dans ma pensée, ni dans mon sujet, d’insister particulièrement sur ce personnage […] qui, d’ailleurs, vient d’être frappé durement par un rigoureux arrêt de cour d’assises."
                                            },
                                            {
                                                "example_id": "72c37e21-dec4-4bd0-8aae-65be11ed1c4c",
                                                "sense_id": "f9b8e225-6197-37ad-8e1f-79765ffb65dc",
                                                "text": "Rendre un arrêt."
                                            },
                                            {
                                                "example_id": "f9c752c6-4772-42ea-87a6-3f758018346a",
                                                "sense_id": "f9b8e225-6197-37ad-8e1f-79765ffb65dc",
                                                "text": "Lever un arrêt."
                                            },
                                            {
                                                "example_id": "e3710512-3369-47d9-bf84-8768421882b1",
                                                "sense_id": "f9b8e225-6197-37ad-8e1f-79765ffb65dc",
                                                "text": "Casser un arrêt."
                                            },
                                            {
                                                "example_id": "9a4fd3c8-98b5-401c-8ead-184096f2514f",
                                                "sense_id": "f9b8e225-6197-37ad-8e1f-79765ffb65dc",
                                                "text": "Se pourvoir contre un arrêt."
                                            },
                                            {
                                                "example_id": "7d5b11a0-891d-433d-9a90-788fa5ed98c4",
                                                "sense_id": "f9b8e225-6197-37ad-8e1f-79765ffb65dc",
                                                "text": "En cassation d’arrêt."
                                            },
                                            {
                                                "example_id": "4dea9ab3-d019-4947-9f3b-2984b5257506",
                                                "sense_id": "f9b8e225-6197-37ad-8e1f-79765ffb65dc",
                                                "text": "Exécuter un arrêt."
                                            },
                                            {
                                                "example_id": "c1acea9b-4b8c-46b1-90e0-2428065b89fe",
                                                "sense_id": "f9b8e225-6197-37ad-8e1f-79765ffb65dc",
                                                "text": "En exécution de l’arrêt."
                                            },
                                            {
                                                "example_id": "8ba2e12f-51ed-4ebe-ad1b-fd74f5023a9e",
                                                "sense_id": "f9b8e225-6197-37ad-8e1f-79765ffb65dc",
                                                "text": "Un recueil d’arrêts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9e5d6d43-8b2f-393d-a264-e91b79b1c1b6",
                                        "entry_id": "96562353-f7db-3a83-91b9-780fcfa216d5",
                                        "glosses": [
                                            "Lieu aménagé pour qu’un véhicule de transport s’arrête et que des passagers puissent monter ou descendre."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8e886367-71f8-3741-9ae6-77deeddcddc7",
                                        "entry_id": "96562353-f7db-3a83-91b9-780fcfa216d5",
                                        "glosses": [
                                            "Jugement de Dieu ou des personnes qui ont ou croient avoir quelque autorité."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "292f756e-0851-4eea-ba6e-3889ab4c8578",
                                                "sense_id": "8e886367-71f8-3741-9ae6-77deeddcddc7",
                                                "text": "Les arrêts de Dieu."
                                            },
                                            {
                                                "example_id": "32948461-4bad-4ee3-8e38-06aa397a1594",
                                                "sense_id": "8e886367-71f8-3741-9ae6-77deeddcddc7",
                                                "text": "Les arrêts du destin, de la Providence."
                                            },
                                            {
                                                "example_id": "18ab46ac-90ea-43b1-8493-0995c0343d54",
                                                "sense_id": "8e886367-71f8-3741-9ae6-77deeddcddc7",
                                                "text": "J’attends de vous mon arrêt."
                                            },
                                            {
                                                "example_id": "988cddf9-3b73-4318-955a-d19cf09b691f",
                                                "sense_id": "8e886367-71f8-3741-9ae6-77deeddcddc7",
                                                "text": "Je n’appellerai point de votre arrêt."
                                            },
                                            {
                                                "example_id": "9db3793c-aaf7-4c32-a7ee-9b11595e751d",
                                                "sense_id": "8e886367-71f8-3741-9ae6-77deeddcddc7",
                                                "text": "Il faut se défier quelquefois des arrêts de ce critique."
                                            },
                                            {
                                                "example_id": "07b43bab-1902-465b-ac68-fb7f1b065f19",
                                                "sense_id": "8e886367-71f8-3741-9ae6-77deeddcddc7",
                                                "text": "Louis Lambert naquit, en 1797, à Montoire, petite ville du Vendômois, où son père exploitait une tannerie de médiocre importance et comptait faire de lui son successeur ; mais les dispositions qu’il manifesta prématurément pour l’étude modifièrent l’arrêt paternel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "55c0b3b9-fd5c-3388-969f-df7e65a5c9ce",
                                        "entry_id": "96562353-f7db-3a83-91b9-780fcfa216d5",
                                        "glosses": [
                                            "Saisie, soit de la personne, soit des biens."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d035b219-13ec-4e90-8030-f356689520b6",
                                                "sense_id": "55c0b3b9-fd5c-3388-969f-df7e65a5c9ce",
                                                "text": "On a fait arrêt sur sa personne et sur ses biens."
                                            },
                                            {
                                                "example_id": "ced1834f-e75f-4447-aab9-a697bf918def",
                                                "sense_id": "55c0b3b9-fd5c-3388-969f-df7e65a5c9ce",
                                                "text": "Il a fait arrêt sur de l’argent qui revient à son débiteur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "78a42e5e-a144-3c98-aaaa-56f39456ce88",
                                        "entry_id": "96562353-f7db-3a83-91b9-780fcfa216d5",
                                        "glosses": [
                                            "Action du cheval, quand il s’arrête."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12db7971-e4f6-43a7-a607-92bedad32404",
                                                "sense_id": "78a42e5e-a144-3c98-aaaa-56f39456ce88",
                                                "text": "Ce cheval a l’arrêt bon, mauvais, l’arrêt sûr et léger."
                                            },
                                            {
                                                "example_id": "dc5ea36a-5ebc-4b40-9f30-2b5483962b92",
                                                "sense_id": "78a42e5e-a144-3c98-aaaa-56f39456ce88",
                                                "text": "Il est ferme sur l’arrêt."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cb1f4936-6e4d-3ece-9679-aece1dbc2320",
                                        "entry_id": "96562353-f7db-3a83-91b9-780fcfa216d5",
                                        "glosses": [
                                            "Action de la main pour arrêter le cheval."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc591529-3798-43fc-beee-79b50bcec994",
                                                "sense_id": "cb1f4936-6e4d-3ece-9679-aece1dbc2320",
                                                "text": "Faire des arrêts, des temps d’arrêt, des demi-arrêts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a2d2d0cc-9222-3e59-9931-c2523800ed46",
                                        "entry_id": "96562353-f7db-3a83-91b9-780fcfa216d5",
                                        "glosses": [
                                            "Action du chien couchant, lorsqu’il arrête le gibier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d6264b00-e898-42ab-8ab4-035f0c91950e",
                                                "sense_id": "a2d2d0cc-9222-3e59-9931-c2523800ed46",
                                                "text": "Ce chien est à l’arrêt. - Il a fait un bel arrêt."
                                            },
                                            {
                                                "example_id": "d2409d04-6129-4b6b-8b39-bd9c71f69cd2",
                                                "sense_id": "a2d2d0cc-9222-3e59-9931-c2523800ed46",
                                                "text": "Tout à coup les chiens tombèrent silencieusement en arrêt. Les braves animaux paraissaient comprendre le prix du silence dans ces lieux […]."
                                            },
                                            {
                                                "example_id": "caaf3f9e-1751-470a-a3a5-2638fc528afe",
                                                "sense_id": "a2d2d0cc-9222-3e59-9931-c2523800ed46",
                                                "text": "Tenir le gibier en arrêt, être en arrêt devant le gibier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9b26b52e-464b-354b-a83d-d2e7c0b7498c",
                                        "entry_id": "96562353-f7db-3a83-91b9-780fcfa216d5",
                                        "glosses": [
                                            "Pièce du harnois où un chevalier appuyait et arrêtait sa lance (appelé aussi arrêt de lance ou encore faucre)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "79ba8c65-829d-43d1-b297-f9a4f89c0c6a",
                                                "sense_id": "9b26b52e-464b-354b-a83d-d2e7c0b7498c",
                                                "text": "Mettre la lance en arrêt."
                                            },
                                            {
                                                "example_id": "1617bb64-310a-41d7-88fe-0da5525ad2d9",
                                                "sense_id": "9b26b52e-464b-354b-a83d-d2e7c0b7498c",
                                                "text": "Au figuré : être la lance en arrêt, c'est être sur le qui-vive."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a156f80a-4f27-377b-8b57-ebceb9273eea",
                                        "entry_id": "96562353-f7db-3a83-91b9-780fcfa216d5",
                                        "glosses": [
                                            "Petite pièce qui empêche que le mouvement d’une horloge n’aille trop vite."
                                        ],
                                        "tags": [
                                            "Horlogerie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5311a079-4b58-4a9c-acd6-54698b449974",
                                                "sense_id": "a156f80a-4f27-377b-8b57-ebceb9273eea",
                                                "text": "L’arrêt d’une horloge."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "65f4b07e-82fd-3c59-a28c-96e60ba61284",
                                        "entry_id": "96562353-f7db-3a83-91b9-780fcfa216d5",
                                        "glosses": [
                                            "Tout ce qu’on met à l’extrémité des ouvertures, pour empêcher que le linge ou l’étoffe ne se déchire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81cd3601-dd5a-47cf-ae91-3ce9a7f3f504",
                                                "sense_id": "65f4b07e-82fd-3c59-a28c-96e60ba61284",
                                                "text": "On a oublié de faire un arrêt à l’ouverture de cette chemise."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "10b8f3a0-64d9-3dc2-9c7b-5a1c5f9497d7",
                                        "entry_id": "96562353-f7db-3a83-91b9-780fcfa216d5",
                                        "glosses": [
                                            "Signalisation routière composée d’un panneau octogonal rouge, indiquant aux automobilistes qu’ils doivent s’arrêter (pour laisser passer d’autres véhicules…)."
                                        ],
                                        "tags": [
                                            "Canada"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8177b657-e5d9-4fd9-830a-54ed3e024bad",
                                                "sense_id": "10b8f3a0-64d9-3dc2-9c7b-5a1c5f9497d7",
                                                "text": "Les panneaux d’arrêt ne portent plus la mention « stop » au Québec."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ebf85420-da9e-3aa3-a1da-ba9ea7d120f6",
                                        "entry_id": "96562353-f7db-3a83-91b9-780fcfa216d5",
                                        "glosses": [
                                            "Défense qui est faite à un officier de sortir de chez lui, ou de s’éloigner d’un lieu déterminé."
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b2a804fb-b7fb-4c66-abfa-11b4ff0f5381",
                                                "sense_id": "ebf85420-da9e-3aa3-a1da-ba9ea7d120f6",
                                                "text": "On l’a mis aux arrêts."
                                            },
                                            {
                                                "example_id": "8627f8a7-c91b-4299-a785-4778b5cdf219",
                                                "sense_id": "ebf85420-da9e-3aa3-a1da-ba9ea7d120f6",
                                                "text": "Il est aux arrêts dans sa chambre."
                                            },
                                            {
                                                "example_id": "9602be19-bc8c-4914-bd56-e9c691dae110",
                                                "sense_id": "ebf85420-da9e-3aa3-a1da-ba9ea7d120f6",
                                                "text": "Il sera puni pour n’avoir pas gardé ses arrêts, pour avoir rompu les arrêts."
                                            }
                                        ]
                                    }
                                ]
                            }
