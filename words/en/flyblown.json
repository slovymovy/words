{
    "word_family": [
        "fly",
        "blow"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "c2f315d3-1bb8-3935-8436-e36b2632a804",
                    "sense_definition": "Contaminated with fly eggs or larvae.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "decay",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>flyblown</w> meat was quickly discarded by the butcher.",
                            "target_lang_translations": {
                                "ru": "<w>Заси́женное му́хами</w> мясо было быстро выброшено мясником."
                            }
                        },
                        {
                            "text": "He found the <w>flyblown</w> carcass lying in the tall grass.",
                            "target_lang_translations": {
                                "ru": "Он нашел <w>заси́женную му́хами</w> тушу, лежащую в высокой траве."
                            }
                        }
                    ],
                    "synonyms": [
                        "tainted",
                        "rotten"
                    ],
                    "common_phrases": [
                        "flyblown meat"
                    ],
                    "target_lang_definitions": {
                        "ru": "Зараженный яйцами или личинками мух; испорченный из-за насекомых."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заси́женный му́хами",
                                "target_lang_sense_clarification": "буквальное значение, указывающее на присутствие мух и их личинок"
                            },
                            {
                                "target_lang_word": "испо́рченный",
                                "target_lang_sense_clarification": "общий термин для продуктов, ставших непригодными в пищу"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f2fcedf5-3d0b-3b68-b5e4-5bad3c80503f",
                    "sense_definition": "Morally or physically tainted or corrupted.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "decay",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The politician's <w>flyblown</w> reputation made it impossible for him to win.",
                            "target_lang_translations": {
                                "ru": "<w>Запятнанная</w> репутация политика сделала его победу невозможной."
                            }
                        },
                        {
                            "text": "They lived in a <w>flyblown</w> environment of corruption and lies.",
                            "target_lang_translations": {
                                "ru": "Они жили в <w>разложившейся</w> атмосфере коррупции и лжи."
                            }
                        }
                    ],
                    "synonyms": [
                        "corrupt",
                        "tainted"
                    ],
                    "antonyms": [
                        "pure",
                        "pristine"
                    ],
                    "target_lang_definitions": {
                        "ru": "Морально разложившийся, коррумпированный или запятнанный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "запятнанный",
                                "target_lang_sense_clarification": "о репутации или чести, которые были испорчены"
                            },
                            {
                                "target_lang_word": "разложившийся",
                                "target_lang_sense_clarification": "о моральном состоянии общества или человека"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b5527b59-dbeb-35fe-97a9-f5b1c99f2d24",
                    "sense_definition": "Extremely dirty, unpleasant, or squalid.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "decay",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They stayed in a <w>flyblown</w> motel on the edge of town.",
                            "target_lang_translations": {
                                "ru": "Они остановились в <w>гря́зном</w> мотеле на окраине города."
                            }
                        },
                        {
                            "text": "The <w>flyblown</w> alleyway was filled with trash and debris.",
                            "target_lang_translations": {
                                "ru": "<w>Гря́зный</w> переулок был завален мусором и обломками."
                            }
                        }
                    ],
                    "synonyms": [
                        "squalid",
                        "sordid",
                        "filthy"
                    ],
                    "antonyms": [
                        "clean"
                    ],
                    "target_lang_definitions": {
                        "ru": "Крайне грязный, неприятный или убогий."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гря́зный",
                                "target_lang_sense_clarification": "общее описание антисанитарного или неопрятного места"
                            },
                            {
                                "target_lang_word": "убо́гий",
                                "target_lang_sense_clarification": "о месте, которое выглядит крайне запущенным и неприятным"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}