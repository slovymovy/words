                                            {
                                                "example_id": "57ec8e83-940e-4619-9e8d-a2d197ebf910",
                                                "sense_id": "b32940db-cd3c-3c9d-b7b1-b58cc6f07a8e",
                                                "text": "„Falls das stimmt, bedeutet Michael Jacksons Tod mit 50 den letzten Erdbrocken, der die 80er ein für alle Mal unter sich begräbt », schrieb Goebel. Dieser These vom späten Ende der 1980er steht aber zumindest das derzeitige Mode-Revival dieses Jahrzehnts mit Schulterpolstern und Dauerwelle entgegen. Und außerdem: Was ist mit der Auffassung mancher Historiker, die sagen, dass das ganze 20. Jahrhundert bereits mit dem Mauerfall 1989 endete, und spätestens mit den Terroranschlägen vom 11. September 2001 eine neue Zeit begann?“"
                                            },
                                            {
                                                "example_id": "6ac47a0a-ec8c-419c-a0ae-976ef63a1081",
                                                "sense_id": "b32940db-cd3c-3c9d-b7b1-b58cc6f07a8e",
                                                "text": "„Mit Dauerwelle und wuchtiger Stimme begeisterte Maria Theresa Ullrich als Rocksängerin.“"
                                            },
                                            {
                                                "example_id": "7f68910c-a7c4-4019-8f89-1eb3e941a1f9",
                                                "sense_id": "b32940db-cd3c-3c9d-b7b1-b58cc6f07a8e",
                                                "text": "„Kurz vor Ostern kam Mama mit einer abartigen Dauerwelle vom Friseur zurück.“"
                                            },
                                            {
                                                "example_id": "14ebc787-ba10-4296-84f9-a192c7fb49e5",
                                                "sense_id": "b32940db-cd3c-3c9d-b7b1-b58cc6f07a8e",
                                                "text": "„Chisom ließ sich gerade im Friseursalon in der Adeniran Ogunsanyastraße die Dauerwelle auffrischen, als ein ungaublich dicker Mann in Begleitung einer jungen Frau eintrat.“"
                                            }
                                        ],
