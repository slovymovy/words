                                "example_id": "de97f6eb-011b-4a9f-80bb-0a0cc0b2e9c1",
                                "sense_id": "3a1837c8-56c3-3ea2-9cb9-d5a95f547b7f",
                                "text": "Das Hüpfen mit dem Springstock ist gar nicht mal so einfach."
