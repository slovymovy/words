    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "7efc38d2-cc71-3993-bc12-1746b51302a4",
                    "sense_definition": "Of the physical senses or sensation.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The garden was designed to provide a rich <w>sensory</w> experience with fragrant flowers and trickling water.",
                            "target_lang_translations": {
                                "ru": "Сад был спроектирован так, чтобы обеспечить богатый <w>сенсорный</w> опыт благодаря ароматным цветам и журчащей воде.",
                                "zh": "花园的设计旨在通过芳香的花朵和潺潺的流水提供丰富的<w>感官</w>体验。"
                            }
                        },
                        {
                            "text": "Children often learn best through <w>sensory</w> play involving sand, water, and textured objects.",
                            "target_lang_translations": {
                                "ru": "Дети часто лучше всего учатся через <w>сенсорные</w> игры с песком, водой и фактурными предметами.",
                                "zh": "儿童通常通过涉及沙子、水和有质感物体的<w>感觉</w>游戏学得最好。"
                            }
                        }
                    ],
                    "synonyms": [
                        "sensorial"
                    ],
                    "common_phrases": [
                        "sensory perception",
                        "sensory input",
                        "sensory overload",
                        "sensory experience",
                        "sensory details"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к физическим чувствам или ощущениям.",
                        "zh": "肉体感觉或感官的"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сенсорный",
                                "target_lang_sense_clarification": "относящийся к восприятию"
                            },
                            {
                                "target_lang_word": "чувственный",
                                "target_lang_sense_clarification": "относящийся к ощущениям"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "感官的",
                                "target_lang_sense_clarification": "关于视觉、听觉、嗅觉等器官"
                            },
                            {
                                "target_lang_word": "感觉的",
                                "target_lang_sense_clarification": "关于身体感官知觉"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2cffab92-8516-3ec1-8367-0e415ef8dc12",
                    "sense_definition": "Conveying nerve impulses from the sense organs to the nerve centers.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A <w>sensory</w> neuron transmits information from the skin to the spinal cord.",
                            "target_lang_translations": {
                                "ru": "<w>Сенсорный</w> нейрон передает информацию от кожи к спинному мозгу.",
                                "zh": "<w>感觉</w>神经元将信息从皮肤传递到脊髓。"
                            }
                        },
                        {
                            "text": "Damage to the <w>sensory</w> nerves can result in numbness or loss of feeling in the extremities.",
                            "target_lang_translations": {
                                "ru": "Повреждение <w>чувствительных</w> нервов может привести к онемению или потере чувствительности в конечностях.",
                                "zh": "<w>感觉</w>神经受损可能导致四肢麻木或丧失知觉。"
                            }
                        }
                    ],
                    "synonyms": [
                        "afferent"
                    ],
                    "common_phrases": [
                        "sensory neuron",
                        "sensory nerve",
                        "sensory system"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Передающий нервные импульсы от органов чувств к нервным центрам.",
                        "zh": "（神经学）将神经冲动从感受器官传送到神经中枢的；感觉的，传入的"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чувствительный",
                                "target_lang_sense_clarification": "о нервах"
                            },
                            {
                                "target_lang_word": "сенсорный",
                                "target_lang_sense_clarification": "физиологический термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "感觉",
                                "target_lang_sense_clarification": "生理学，如感觉神经元、感觉神经"
                            },
                            {
                                "target_lang_word": "感官",
                                "target_lang_sense_clarification": "生理学，如感官系统"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2966abe2-72c3-35d0-b27d-a9a6196c2018",
                    "sense_definition": "An organ or faculty of sense.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "noun_archaic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The eye is a complex <w>sensory</w> that captures light and transmits images to the mind.",
                            "target_lang_translations": {
                                "ru": "Глаз — это сложный <w>орган чувств</w>, который улавливает свет и передает изображения в мозг.",
                                "zh": "眼睛是一个复杂的<w>感觉器官</w>，能捕捉光线并将图像传递给大脑。"
                            }
                        },
                        {
                            "text": "He believed that every <w>sensory</w> of the body was connected to a central soul.",
                            "target_lang_translations": {
                                "ru": "Он верил, что каждый <w>орган чувств</w> тела связан с центральной душой.",
                                "zh": "他认为身体的每一个<w>感官</w>都与核心的灵魂相连。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Орган или способность чувствовать.",
                        "zh": "（古旧）感觉器官；官能"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "орган чувств",
                                "target_lang_sense_clarification": "устаревшее значение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "感觉器官",
                                "target_lang_sense_clarification": "眼、耳等器官"
                            },
                            {
                                "target_lang_word": "感官",
                                "target_lang_sense_clarification": "感觉器官"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cdd8eea1-3aeb-3264-87de-b57646c5623c",
                    "sense_definition": "The sensorium.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "noun_archaic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ancient philosophers debated whether the heart or the brain was the primary <w>sensory</w>.",
                            "target_lang_translations": {
                                "ru": "Древние философы спорили о том, является ли сердце или мозг основным <w>сенсорием</w>.",
                                "zh": "古代哲学家曾争论心脏还是大脑才是主要的<w>感觉中枢</w>。"
                            }
                        },
                        {
                            "text": "The entire universe was described poetically as the <w>sensory</w> of the divine creator.",
                            "target_lang_translations": {
                                "ru": "Вся вселенная поэтически описывалась как <w>сенсорий</w> божественного творца.",
                                "zh": "整个宇宙被诗意地描述为神圣造物主的<w>感觉总枢</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сенсорий; средоточие чувств.",
                        "zh": "（古旧）感觉中枢；感觉总枢"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сенсорий",
                                "target_lang_sense_clarification": "философский термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "感觉中枢",
                                "target_lang_sense_clarification": "感知与意识汇聚的器官或中枢"
                            },
                            {
                                "target_lang_word": "感觉总枢",
                                "target_lang_sense_clarification": "哲学与解剖学概念"
                            }
                        ]
                    }
                }
            ]
        }
