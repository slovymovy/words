                            {
                                "target_lang_word": "начальный",
                                "target_lang_sense_clarification": "о ступени образования"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "小学",
                                "target_lang_sense_clarification": "指教育阶段"
                            }
                        ]
                    }
                }
