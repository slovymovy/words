                "senses": [
                    {
                        "sense_id": "65652902-5522-3758-992b-6a58ce82fb96",
                        "entry_id": "1a824e69-ae4f-32c2-93f6-adc2bdaa3593",
                        "glosses": [
                            "Stamm von Angehörigen eines Turkvolks"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f455cbd-d60b-48e9-b31b-6bd618374ea3",
                                "sense_id": "65652902-5522-3758-992b-6a58ce82fb96",
                                "text": "„Bei den Qizilbasch handelt es sich um die Nachkommen von Turkstämmen aus Aserbaidschan, die im 18. Jahrhundert vom persischen Herrscher Nader Schah als Besatzungstruppen in afghanischen Städten eingesetzt wurden.“"
                            },
                            {
                                "example_id": "d3e50fba-4ff1-498f-9430-fcd06c86f283",
                                "sense_id": "65652902-5522-3758-992b-6a58ce82fb96",
                                "text": "„Weitere Tadschiken leben über die anderen Staaten Zentralasiens verstreut, 200 000 von ihnen in der chinesischen Provinz Xinjiang. Sie sind die einzige ethnische Gruppe in Zentralasien, die nicht von den Turkstämmen abstammt, sondern von den ersten persischen Stämmen, die Zentralasien zwischen 1500 und 1000 v. Chr. bewohnten, wurden später aber von einer Reihe Turk-Invasoren aus der Mongolei an den Rand gedrängt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
