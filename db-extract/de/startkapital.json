                "senses": [
                    {
                        "sense_id": "7d02e7d1-7a39-37d8-8e0f-0e2155013e35",
                        "entry_id": "134544c9-0bc4-3ae9-abe2-1b5b3201bcc1",
                        "glosses": [
                            "die Gesamtheit von Geld und Sachvermögen, die für ein Vorhaben (wie zum Beispiel eine Unternehmensgründung) zur Verfügung steht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b87f328-9fa4-4fa7-999e-a938f03a4720",
                                "sense_id": "7d02e7d1-7a39-37d8-8e0f-0e2155013e35",
                                "text": "Der Vorteil meiner Geschäftsidee ist, dass sie sich auch mit einem geringen Startkapital realisieren lässt."
                            },
                            {
                                "example_id": "fb7a9953-213c-43b3-b198-68a84742ab99",
                                "sense_id": "7d02e7d1-7a39-37d8-8e0f-0e2155013e35",
                                "text": "„Dies war das Startkapital zu einer der abenteuerlichsten Entdeckungsreisen auf dem afrikanischen Kontinent, denn Park sollte das jahrtausendealte Rätsel des Niger lösen, von dem man seinerzeit weder wusste, wo er entsprang, noch, wo er mündete.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
