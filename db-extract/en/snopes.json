                "senses": [
                    {
                        "sense_id": "43e08a08-4297-3804-a206-9993c1b1f7d7",
                        "entry_id": "5bdbd2f4-130b-3e25-8bb4-5752e130be7e",
                        "glosses": [
                            "To check (information) on the Web site snopes.com for accuracy."
                        ],
                        "tags": [
                            "rare",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "b3b41e09-8dda-4f86-843f-24518e3fbc8a",
                                "sense_id": "43e08a08-4297-3804-a206-9993c1b1f7d7",
                                "text": "Heh heh you got me.\nNo, I didn't Snopes it before replying.\nDamn. Shame on me."
                            },
                            {
                                "example_id": "a86bb500-92bb-4796-80e2-67ab7883e574",
                                "sense_id": "43e08a08-4297-3804-a206-9993c1b1f7d7",
                                "text": "Why do people insist on \"re-SNOPESing\" things that have been proven time and time again are urban legends?"
                            },
                            {
                                "example_id": "2951063a-e506-4921-af94-67b640d9928d",
                                "sense_id": "43e08a08-4297-3804-a206-9993c1b1f7d7",
                                "text": "I remember the same doubt, and it's understandable that people would be skeptical about an amazing story like that. I had some spare time, hence the Googling and Snopesing."
                            },
                            {
                                "example_id": "0854c138-0e6d-4d00-8774-34b3a0293186",
                                "sense_id": "43e08a08-4297-3804-a206-9993c1b1f7d7",
                                "text": "Now some of these are bogus, or semi-bogus... Check 'em out if you need to (I'm not gonna do your snopesing for you :-) - but why spoil a good story with some factuality? If some of these aren't true, they ought to be :-)"
                            },
                            {
                                "example_id": "72e878aa-389e-4441-a04b-82ca74fa28b4",
                                "sense_id": "43e08a08-4297-3804-a206-9993c1b1f7d7",
                                "text": "Seriously why does he call himself an intelligent person when all he has to do is snopes stuff before sending out"
                            }
                        ]
                    }
                ],
