                ],
                "senses": [
                    {
                        "sense_id": "29edf348-b8d0-39fc-9f78-23147a462c02",
                        "entry_id": "d59cf528-b298-37e4-a959-c96380b8bb80",
                        "glosses": [
                            "Se dit de pièces qui en ont d’autres près d’elles, principalement de pièces placées au centre de l’écu."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "70b2da84-049f-4d70-9e9e-e2ad1e93d459",
                                "sense_id": "29edf348-b8d0-39fc-9f78-23147a462c02",
                                "text": "Perrachon marquis de Senozan — Lyonnais (M. ét. [Maison éteinte]). De gu. à la fasce d’arg., acc. [accompagnée] de trois étoiles d’or."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ced8e367-4a8c-4946-bccf-094e3c0c65f1",
                        "source_entry_id": "d59cf528-b298-37e4-a959-c96380b8bb80",
                        "source_sense_id": "29edf348-b8d0-39fc-9f78-23147a462c02",
                        "target_lang_word": "between",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "between",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "62d8dbc6-e27a-3ae8-8ecc-a0daf4b00e4d",
                                        "entry_id": "83ef26d5-a6ed-325b-b5c3-344902243bfd",
                                        "glosses": [
                                            "In the position or interval that separates (two things), or intermediate in quantity or degree. (See Usage notes below.)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61683d62-bc53-499a-8900-f7f3c3d5b72a",
                                                "sense_id": "62d8dbc6-e27a-3ae8-8ecc-a0daf4b00e4d",
                                                "text": "John stood between Amy and Mary.    Let’s meet between two and three."
                                            },
                                            {
                                                "example_id": "3b236c0a-b7b8-40cb-84c8-883f975845d9",
                                                "sense_id": "62d8dbc6-e27a-3ae8-8ecc-a0daf4b00e4d",
                                                "text": "I want to buy one that costs somewhere between forty and fifty dollars."
                                            },
                                            {
                                                "example_id": "8f0bb6d7-e92a-4d14-9c82-8eebd140a353",
                                                "sense_id": "62d8dbc6-e27a-3ae8-8ecc-a0daf4b00e4d",
                                                "text": "The prince is here at hand, pleaſeth your Lordſhip / To meet his grace iuſt diſtance tvveene our armies."
                                            },
                                            {
                                                "example_id": "09e447a6-0b38-4b53-9bb7-240d51463c91",
                                                "sense_id": "62d8dbc6-e27a-3ae8-8ecc-a0daf4b00e4d",
                                                "text": "Thus, when he drew up instructions in lawyer language, he expressed the important words by an initial, a medial, or a final consonant, and made scratches for all the words between; his clerks, however, understood him very well."
                                            },
                                            {
                                                "example_id": "07e743f2-b13f-4771-a977-70c9d150c99e",
                                                "sense_id": "62d8dbc6-e27a-3ae8-8ecc-a0daf4b00e4d",
                                                "text": "Energy has seldom been found where we need it when we want it. Ancient nomads, wishing to ward off the evening chill and enjoy a meal around a campfire, had to collect wood and then spend time and effort coaxing the heat of friction out from between sticks to kindle a flame."
                                            },
                                            {
                                                "example_id": "87d3a0ff-2c0b-4c80-bfb0-ed52b0637203",
                                                "sense_id": "62d8dbc6-e27a-3ae8-8ecc-a0daf4b00e4d",
                                                "text": "Accounts with between fifty thousand and two hundred thousand followers are considered “microinfluencers,” and tend to have higher engagement rates—that is, a larger share of their followers like, favorite, or comment on their posts—than those with millions of followers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a6487b35-e180-30c2-bda0-639b2b767252",
                                        "entry_id": "83ef26d5-a6ed-325b-b5c3-344902243bfd",
                                        "glosses": [
                                            "Done together or reciprocally."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6048f860-e8b4-4535-bbfe-c03e713be6b8",
                                                "sense_id": "a6487b35-e180-30c2-bda0-639b2b767252",
                                                "text": "conversation between friends"
                                            },
                                            {
                                                "example_id": "57770856-20c9-45bb-a84a-ed16209298e4",
                                                "sense_id": "a6487b35-e180-30c2-bda0-639b2b767252",
                                                "text": "She mixed furniture with the same fatal profligacy as she mixed drinks, and this outrageous contact between things which were intended by Nature to be kept poles apart gave her an inexpressible thrill."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a47939d0-2bdc-3d74-9113-8b41c1a87776",
                                        "entry_id": "83ef26d5-a6ed-325b-b5c3-344902243bfd",
                                        "glosses": [
                                            "Shared in confidence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13f78241-9175-47fa-99ff-151a7f5544f4",
                                                "sense_id": "a47939d0-2bdc-3d74-9113-8b41c1a87776",
                                                "text": "Between you and me, I think the boss is crazy.  Let's keep this between ourselves."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "02b0de76-94c3-3c14-b454-8395580689cb",
                                        "entry_id": "83ef26d5-a6ed-325b-b5c3-344902243bfd",
                                        "glosses": [
                                            "In transit from (one to the other, or connecting places)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b539e3b-6f28-4b23-baf9-4fa099042223",
                                                "sense_id": "02b0de76-94c3-3c14-b454-8395580689cb",
                                                "text": "He's between jobs right now.  The shuttle runs between the town and the airport."
                                            },
                                            {
                                                "example_id": "ab1bf055-fcc8-46cd-a02b-575d1b2534b6",
                                                "sense_id": "02b0de76-94c3-3c14-b454-8395580689cb",
                                                "text": "[If] you don’t want to flip the channels between Biden and Trump, join [the] live chat, [which is covering] both town halls."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e5f38ec9-3bc9-37cf-ac40-6019cbc316f3",
                                        "entry_id": "83ef26d5-a6ed-325b-b5c3-344902243bfd",
                                        "glosses": [
                                            "Combined (by effort or ownership)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b8fa2c29-7faf-4202-9949-df73c3bfa441",
                                                "sense_id": "e5f38ec9-3bc9-37cf-ac40-6019cbc316f3",
                                                "text": "Between us all, we shall succeed.  We've only got £5 between us."
                                            },
                                            {
                                                "example_id": "28ac61b7-b558-4df0-a0bd-b6c1675cc274",
                                                "sense_id": "e5f38ec9-3bc9-37cf-ac40-6019cbc316f3",
                                                "text": "Between the leaky taps and the peeling wallpaper, there isn't much about this house to appeal to a buyer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eb674b0a-93df-3c4f-b738-229db8f638a4",
                                        "entry_id": "83ef26d5-a6ed-325b-b5c3-344902243bfd",
                                        "glosses": [
                                            "One of (representing a choice)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "56df1a33-cbfd-4cb8-8c12-500936041096",
                                                "sense_id": "eb674b0a-93df-3c4f-b738-229db8f638a4",
                                                "text": "You must choose between him and me."
                                            },
                                            {
                                                "example_id": "351019f9-e5e7-4963-9b14-9c0a32944b1c",
                                                "sense_id": "eb674b0a-93df-3c4f-b738-229db8f638a4",
                                                "text": "Some colour-blind people can't distinguish between red and green."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ed6a7876-b949-3d01-a367-557f5e31f63e",
                                        "entry_id": "83ef26d5-a6ed-325b-b5c3-344902243bfd",
                                        "glosses": [
                                            "Taking together the combined effect of."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "08724d7a-377e-4041-8c6d-28553f7f2018",
                                                "sense_id": "ed6a7876-b949-3d01-a367-557f5e31f63e",
                                                "text": "Between the food and the card games, this proved to be the best birthday party I have ever had."
                                            }
                                        ]
                                    }
                                ]
