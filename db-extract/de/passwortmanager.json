                        "examples": [
                            {
                                "example_id": "8611c43a-8009-44a2-8117-9d16b668808e",
                                "sense_id": "fbddd8fc-5dbf-3640-b6fe-49c2e6c0f194",
                                "text": "Seine Passwörter sollte man nicht in einer Textdatei auf dem Computer speichern, sondern einen Passwortmanager dafür verwenden."
                            },
                            {
                                "example_id": "50e7d699-6b32-4b66-9227-f360291bd4d8",
                                "sense_id": "fbddd8fc-5dbf-3640-b6fe-49c2e6c0f194",
                                "text": "Cyberduck enthält eine Lesezeichenfunktion und unterstützt den Netzwerkstandard Bonjour sowie den Passwortmanager Schlüsselbund."
                            },
                            {
                                "example_id": "b82bc019-8e4a-4fd8-bf00-5f9fca9acaa0",
                                "sense_id": "fbddd8fc-5dbf-3640-b6fe-49c2e6c0f194",
                                "text": "„Vor allen Dingen legen wir großen Wert auf die sogenannte Zwei-Faktor-Authentifizierung. Das soll ein Passwortmanager haben. …“"
                            }
                        ],
