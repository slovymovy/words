{
    "word_family": [
        "fermentation",
        "fermentable",
        "fermentative"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f72275f5-2522-37e8-bea6-afd86a16290d",
                    "sense_definition": "A substance such as yeast that causes fermentation",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "chemical_agent",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The baker added a natural <w>ferment</w> to the dough to help it rise.",
                            "target_lang_translations": {
                                "zh": "面包师在面团中加入了天然<w>酵母</w>以帮助其发酵膨胀。"
                            }
                        },
                        {
                            "text": "Ancient brewers used a wild <w>ferment</w> to create their traditional ale.",
                            "target_lang_translations": {
                                "zh": "古代酿酒师使用野生<w>发酵剂</w>来制作传统的麦芽酒。"
                            }
                        }
                    ],
                    "synonyms": [
                        "leaven"
                    ],
                    "target_lang_definitions": {
                        "zh": "引起发酵的物质，如酵母"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "酵母",
                                "target_lang_sense_clarification": "指用于发酵的真菌或发酵剂"
                            },
                            {
                                "target_lang_word": "发酵剂",
                                "target_lang_sense_clarification": "指任何能引发发酵过程的物质"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0e24e2b2-9e59-3989-833d-085fe45fc08a",
                    "sense_definition": "A state of agitation or turbulent change",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "social_unrest",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The entire country was in a <w>ferment</w> following the unexpected election results.",
                            "target_lang_translations": {
                                "zh": "选举结果出人意料，整个国家陷入了一片<w>动荡</w>。"
                            }
                        },
                        {
                            "text": "The city's artistic <w>ferment</w> attracted many young painters and writers.",
                            "target_lang_translations": {
                                "zh": "这座城市活跃的艺术<w>骚动</w>吸引了许多年轻的画家和作家。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "in a ferment"
                    ],
                    "target_lang_definitions": {
                        "zh": "动荡或骚乱的状态"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "动荡",
                                "target_lang_sense_clarification": "指社会或局势的不稳定状态"
                            },
                            {
                                "target_lang_word": "骚动",
                                "target_lang_sense_clarification": "指人群或思想的混乱与不安"
                            }
                        ]
                    },
                    "synonyms": [
                        "turmoil",
                        "unrest"
                    ]
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6ee282e8-17ca-3b5d-b721-b6fae31d0535",
                    "sense_definition": "To undergo a chemical change, especially to produce alcohol from sugar",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "chemical_process",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The grapes must <w>ferment</w> for several weeks to become wine.",
                            "target_lang_translations": {
                                "zh": "葡萄必须<w>发酵</w>几周才能变成葡萄酒。"
                            }
                        },
                        {
                            "text": "We let the mixture <w>ferment</w> in a cool, dark place.",
                            "target_lang_translations": {
                                "zh": "我们将混合物放在阴凉黑暗的地方进行<w>发酵</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "发生化学变化，尤指糖分转化为酒精"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "发酵",
                                "target_lang_sense_clarification": "指有机物在微生物作用下的化学分解过程"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2f4de54a-26d6-3502-9ad7-fa716cde2828",
                    "sense_definition": "To stir up or cause unrest and excitement",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "social_unrest",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Agitators tried to <w>ferment</w> unrest among the factory workers.",
                            "target_lang_translations": {
                                "zh": "鼓动者试图在工厂工人中<w>煽动</w>不满情绪。"
                            }
                        },
                        {
                            "text": "Rumours of corruption helped to <w>ferment</w> anger against the government.",
                            "target_lang_translations": {
                                "zh": "有关腐败的传闻<w>煽动</w>了民众对政府的愤怒。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "煽动或引起骚乱与兴奋"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "煽动",
                                "target_lang_sense_clarification": "指挑动他人情绪或引起骚乱"
                            },
                            {
                                "target_lang_word": "酝酿",
                                "target_lang_sense_clarification": "指思想或情绪在内部逐渐形成和发展"
                            }
                        ]
                    },
                    "synonyms": [
                        "foment",
                        "stir up"
                    ]
                }
            ]
        }
    ]
}