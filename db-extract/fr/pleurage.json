                    }
                ],
                "senses": [
                    {
                        "sense_id": "11014dee-e231-37a7-b50a-cb6de1f85db3",
                        "entry_id": "dace71f0-bacb-3388-8c92-81d660421ee5",
                        "glosses": [
                            "Fluctuation de la vitesse relative entre un support d'enregistrement et la tête d'enregistrement ou de lecture, dont la fréquence est comprise entre 0,1 et 10 hertz."
                        ],
                        "tags": [
                            "Acoustique"
                        ],
                        "examples": [
                            {
                                "example_id": "8ed956aa-7aa0-4965-8373-0c5ad99022bb",
                                "sense_id": "11014dee-e231-37a7-b50a-cb6de1f85db3",
                                "text": "La principale qualité d'un bon magnétophone réside dans son absence de pleurage, c'est à dire une vitesse de bande constante. A cette très faible vitesse, ce pleurage peut être très important."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f172e3e3-f213-4b4f-8d95-adb2e4054856",
                        "source_entry_id": "dace71f0-bacb-3388-8c92-81d660421ee5",
                        "source_sense_id": "11014dee-e231-37a7-b50a-cb6de1f85db3",
                        "target_lang_word": "wow",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wow",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5d45f8f9-ce63-382b-9c88-d50d53095dcc",
                                        "entry_id": "16f3624f-c24e-31ca-8181-4164d66cbe5e",
                                        "glosses": [
                                            "An indication of excitement, surprise, astonishment, or pleasure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf7b373b-1978-4e8f-85c0-6215bed54376",
                                                "sense_id": "5d45f8f9-ce63-382b-9c88-d50d53095dcc",
                                                "text": "Wow, I sure was surprised!"
                                            },
                                            {
                                                "example_id": "a96a0863-4d6e-4538-b634-ed482a2e49fd",
                                                "sense_id": "5d45f8f9-ce63-382b-9c88-d50d53095dcc",
                                                "text": "Out on thir wanderand spiritis, wow! thow cryis."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "139fcae6-9079-3a45-a299-716fb6261a8d",
                                        "entry_id": "16f3624f-c24e-31ca-8181-4164d66cbe5e",
                                        "glosses": [
                                            "An expression of amazement, awe, or admiration."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c6687b4-d443-4d7f-b6ed-0c57f210142e",
                                                "sense_id": "139fcae6-9079-3a45-a299-716fb6261a8d",
                                                "text": "Wow! How do they do that?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "db161641-d54f-37ad-9b0f-64ef23537c46",
                                        "entry_id": "16f3624f-c24e-31ca-8181-4164d66cbe5e",
                                        "glosses": [
                                            "Used sarcastically to express disapproval of something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15710177-5206-4a15-8809-41a8d3db2997",
                                                "sense_id": "db161641-d54f-37ad-9b0f-64ef23537c46",
                                                "text": "Wow… good job using all of our supplies on the first day."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "wow",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5c14ec33-9af5-3f45-af1f-076af1498e84",
                                        "entry_id": "47cf5d82-501a-3430-9d11-37d3fd3a07d0",
                                        "glosses": [
                                            "To amaze or awe."
                                        ],
                                        "tags": [
                                            "informal",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "772c566d-b465-4127-b018-c2866b52b614",
                                                "sense_id": "5c14ec33-9af5-3f45-af1f-076af1498e84",
                                                "text": "He really wowed the audience."
                                            },
                                            {
                                                "example_id": "d1b0cc25-c10e-44bb-bf41-27176b3f0eb0",
                                                "sense_id": "5c14ec33-9af5-3f45-af1f-076af1498e84",
                                                "text": "If all of us can remember how great it felt to be wowed, why don't we make it a habit to do it more often for others? People remember you when you wow them, so to differentiate yourself with your clients and customers, think of doing something that would make them remember you."
                                            },
                                            {
                                                "example_id": "012f63a9-5d23-44b8-9f59-510354055885",
                                                "sense_id": "5c14ec33-9af5-3f45-af1f-076af1498e84",
                                                "text": "We have the worst of both worlds: the royal family gives us nothing, and we in turn legitimise it, give it meaning and audience and pay, through subsidies and tax exemptions, for its ability to wow us."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "wow",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0dd3b3d1-ba16-3546-a187-7bdc4d286b87",
                                        "entry_id": "35dcada5-2923-367d-8d7f-59a226d85ab5",
                                        "glosses": [
                                            "Anything exceptionally surprising, unbelievable, outstanding, etc."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba2e4c4a-5cf3-4e5e-af67-5fc570dcd298",
                                                "sense_id": "0dd3b3d1-ba16-3546-a187-7bdc4d286b87",
                                                "text": "‘And say, Jimmy, wait till you see me in my new outfit...It’s a wow, kid.’"
                                            },
                                            {
                                                "example_id": "4aea2ab9-12b1-49c2-84fe-8981d3fe2fb5",
                                                "sense_id": "0dd3b3d1-ba16-3546-a187-7bdc4d286b87",
                                                "text": "‘Jesus suffering fuck,’ said Adrian. ‘It’s not half a thought.’\n‘Face it, it’s a wow.’"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a3f53f72-f89d-31d3-a852-3c92689337c1",
                                        "entry_id": "35dcada5-2923-367d-8d7f-59a226d85ab5",
                                        "glosses": [
                                            "An utterance of \\\"wow\\\"."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8238a368-d336-426b-bc56-f79a01e32054",
                                                "sense_id": "a3f53f72-f89d-31d3-a852-3c92689337c1",
                                                "text": "On this trip, we talked with fellow cruisers about their travels and boats, and many were curious about the Beneteau Swift Trawler. Gow graciously gave tours, during which we heard many wows, oohs and aahs."
                                            },
                                            {
                                                "example_id": "426825f3-5964-48a1-9162-34d7e7277494",
                                                "sense_id": "a3f53f72-f89d-31d3-a852-3c92689337c1",
                                                "text": "One woman took a seat nearer the front for a closer look at my maps. Several people exhaled loudly. I heard a wow now and then."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "wow",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8d702502-7dba-3e98-b792-8c3de7e909a8",
                                        "entry_id": "16fcde9e-aac7-3df0-958b-25eec4c377fb",
                                        "glosses": [
                                            "A relatively slow form of flutter (pitch variation) which can affect both gramophone records and tape recorders."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a0c886c2-5abf-4d68-9353-3f64693ac364",
                                                "sense_id": "8d702502-7dba-3e98-b792-8c3de7e909a8",
                                                "text": "Sound films have to be loaded so that the sound is 5 seconds before the sound drum so a wow does not result when the film is punched up on the air."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
