                ],
                "senses": [
                    {
                        "sense_id": "06ad80c4-50fb-36c5-9e02-f4e080c30ef1",
                        "entry_id": "facdb860-92b1-3ee5-81f1-1f501fb6ec0c",
                        "glosses": [
                            "Qui émigre d’un pays à un autre, d’un climat à un autre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a5b3982-af0b-4227-bf47-533f815f5a29",
                                "sense_id": "06ad80c4-50fb-36c5-9e02-f4e080c30ef1",
                                "text": "Le Tchad est doté d’une faune variée : lions, rhinocéros, girafes… toute la panoplie des grands animaux, jusqu’aux gazelles et fénecs du désert en passant par tous les oiseaux migrateurs ou non."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dfe2add1-d0b8-42f1-9d6a-07b98e303d3a",
                        "source_entry_id": "facdb860-92b1-3ee5-81f1-1f501fb6ec0c",
                        "source_sense_id": "06ad80c4-50fb-36c5-9e02-f4e080c30ef1",
                        "target_lang_word": "migratory",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "migratory",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2c61f2b4-40fa-3e35-a5d8-d196eb98183e",
                                        "entry_id": "3a92eafd-ef9b-30ed-9830-929755cc33bd",
                                        "glosses": [
                                            "Migrating."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6398e8e7-877e-40dc-abee-1f318087fc12",
                                                "sense_id": "2c61f2b4-40fa-3e35-a5d8-d196eb98183e",
                                                "text": "To cope with daily variation of environmental parameters, talitrids evolved a migratory behaviour, synchronized with tidal and nictemeral cycles, that enable them to locate the suitable patches of habitat on the shore (Pardi and Ercolini 1986)."
                                            },
                                            {
                                                "example_id": "b11a1ec2-3d41-4e93-97eb-31b5dbe5f72f",
                                                "sense_id": "2c61f2b4-40fa-3e35-a5d8-d196eb98183e",
                                                "text": "Even among migratory species, only a few (Aglaura hemistoma, Abylopsis tetragona eudoxids, Beroe sp., Thalia democratica, Salpa fusiformis) crossed the thermocline and reached the bottom layer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "207bb6bd-d89a-3712-a01f-6299857aa054",
                                        "entry_id": "3a92eafd-ef9b-30ed-9830-929755cc33bd",
                                        "glosses": [
                                            "Roving; wandering; nomadic."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c3a7dc5e-6364-4566-b2b3-39a189c2ad6b",
                                                "sense_id": "207bb6bd-d89a-3712-a01f-6299857aa054",
                                                "text": "migratory habits; a migratory life"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fd5d0c8f-4410-4fb6-a059-d9fc032f0180",
                        "source_entry_id": "facdb860-92b1-3ee5-81f1-1f501fb6ec0c",
                        "source_sense_id": "06ad80c4-50fb-36c5-9e02-f4e080c30ef1",
                        "target_lang_word": "itinerant",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "itinerant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b7d8c565-e7f0-3a54-9028-226dc10f6b80",
                                        "entry_id": "4deaa3ef-5f17-3e61-86d0-4c81f6171c72",
                                        "glosses": [
                                            "Habitually travelling from place to place."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d38e9d5d-0463-4d40-86d4-f13dc38eb85f",
                                                "sense_id": "b7d8c565-e7f0-3a54-9028-226dc10f6b80",
                                                "text": "an itinerant preacher or peddler"
                                            },
                                            {
                                                "example_id": "e1d62bbf-39f3-415d-a126-30f01aa02fb2",
                                                "sense_id": "b7d8c565-e7f0-3a54-9028-226dc10f6b80",
                                                "text": "The king's own courts were then itinerant, being kept in the king's palace, and removing with his household in those royal progresses which he continually made."
                                            },
                                            {
                                                "example_id": "e4429ee1-307c-4af0-9d8c-877cc5a067ff",
                                                "sense_id": "b7d8c565-e7f0-3a54-9028-226dc10f6b80",
                                                "text": "most children in trouble were placed in detention homes, in institutions for the retarded, on wards with psychotic adults, or were left at home to fester there, occasionally seen by an itinerant teacher."
                                            },
                                            {
                                                "example_id": "58972df6-3adc-407c-88b2-be6faa0ab7c5",
                                                "sense_id": "b7d8c565-e7f0-3a54-9028-226dc10f6b80",
                                                "text": "The Greek term translated as “apostle” derives from the concept of being sent, thus underlining the missionary and more itinerant nature of the ministry."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "itinerant",
