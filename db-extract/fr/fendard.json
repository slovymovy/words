                "senses": [
                    {
                        "sense_id": "4c3ce5aa-a717-344e-b18c-eee279b327f0",
                        "entry_id": "931ef79c-6257-3f2c-b4ef-3310bc9595bc",
                        "glosses": [
                            "Pantalon."
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "03615b44-d01d-418e-94c8-a3b0ce5a6ecb",
                                "sense_id": "4c3ce5aa-a717-344e-b18c-eee279b327f0",
                                "text": "Elles durent le remarquer car avec une douceur surprenante, la nonne aux biscottos m’enfila une limace grise à col raide et un fendard marron qui m’arrivait jusqu’aux genoux, puis une paire de bas dont les talons et les bouts de panard étaient renforcés avec des bouts de tissu pour éviter l’usure."
                            },
                            {
                                "example_id": "87d3fe37-638f-4bc6-953c-2712416d1459",
                                "sense_id": "4c3ce5aa-a717-344e-b18c-eee279b327f0",
                                "text": "Baisse ton fendard !"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3c752bcd-658f-47f3-8b52-2c4e22c61aa0",
                        "source_entry_id": "931ef79c-6257-3f2c-b4ef-3310bc9595bc",
