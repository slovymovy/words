    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "84d8cd90-5da0-3b2a-8e2e-007d488e5d10",
                "word": "subhuman",
                "pos": "adj",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "e78e3563-2aef-46b4-a399-920361c506ae",
                        "entry_id": "84d8cd90-5da0-3b2a-8e2e-007d488e5d10",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more subhuman"
                    },
                    {
                        "form_id": "47e8e4f3-b557-4593-9dd9-0fbc3049cf70",
                        "entry_id": "84d8cd90-5da0-3b2a-8e2e-007d488e5d10",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most subhuman"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fb8311a7-eead-354e-9632-7b9f7738b6da",
                        "entry_id": "84d8cd90-5da0-3b2a-8e2e-007d488e5d10",
                        "glosses": [
                            "Lacking characteristics of a human in a way judged to be less than human by some value judgment, opinion, or belief system (as for example an anthropocentric view of nonhuman primates or a Nazi view of various human outgroups).",
                            "As tendentiously asserted of humans."
                        ],
                        "tags": [
                            "offensive",
                            "often"
                        ],
                        "examples": [
                            {
                                "example_id": "56a1485c-a6e6-439c-bd33-2a844e1fb990",
                                "sense_id": "fb8311a7-eead-354e-9632-7b9f7738b6da",
                                "text": "A secret to Nazi power was that anyone from the ingroup could be turned upon and labeled as subhuman scum when some alleged Jewish ancestry was suddenly \"discovered\"."
                            }
                        ]
                    },
                    {
                        "sense_id": "bc8757a6-b67d-3f73-be22-4a6074d11272",
                        "entry_id": "84d8cd90-5da0-3b2a-8e2e-007d488e5d10",
                        "glosses": [
                            "Lacking characteristics of a human in a way judged to be less than human by some value judgment, opinion, or belief system (as for example an anthropocentric view of nonhuman primates or a Nazi view of various human outgroups).",
                            "As anthropocentrically asserted of nonhuman animals, especially in centuries past."
                        ],
                        "tags": [
                            "offensive",
                            "often"
                        ],
                        "examples": [
                            {
                                "example_id": "ff5a9120-7bcc-4dbf-b02c-f899059cdeb5",
                                "sense_id": "bc8757a6-b67d-3f73-be22-4a6074d11272",
                                "text": "We say dolphin intelligence is subhuman; I suspect dolphins say our intelligence is subdolphin."
                            },
                            {
                                "example_id": "c55b738c-b8e8-4c32-bedd-5a9b7b79d816",
                                "sense_id": "bc8757a6-b67d-3f73-be22-4a6074d11272",
                                "text": "In the belief system of his day, chimpanzees were described as subhuman and asserted to be incapable of feeling pain."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1e753f48-1902-4d21-8226-a2a07163cc39",
                        "source_entry_id": "84d8cd90-5da0-3b2a-8e2e-007d488e5d10",
